d": "127991675991805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzTMyVjwFOwQ7kNvwGaOizz&_nc_oc=Adq12yeienFnE7CkT5BH8g80f4vS-Oex3NY65h53jUQM0K5JGh4md184ldSU2q8WHek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Du4KuNdRkdqAYQR0_EC6iS39Mzc42KU-bqxaoulVVg&oe=6A898FCC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ_iTqCDt4cQ7kNvwHRzQ2s&_nc_oc=AdpO1lVxQNl78SVcUT5TW2FhOgcMWoJmee3eP8Vr8UAHJzDuus4ycZ-ocwWohJ8ClDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHN8-LGCgx_rrxdHrnq_-aS0mjlA9R7tL7Wfnr7Qw4Pw&oe=6A89736F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGPFsGCAE9oQ7kNvwGLvQ9N&_nc_oc=AdriYHHuIGdG_OVFx44wICEWgMNGBIX3ZKxViKbsENxGYrZP9vpwc8pp9fvdqSb7Ndo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnwAJCNgOv7Kdn_wTjIadTQJyjNylbAZzbo2307v2h9A&oe=6A899B0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3rFh4dUaYIQ7kNvwEkA6Yv&_nc_oc=AdqPOGmLvJaW3wYYvxgWpI-mRY96Npv9ISraAdv_QUqv0ahClwU2d7ySXZ7YhANdymo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESUO396a8b6HSCUH9DeD1gW0xU1Xv-g0ggknpTDU1c5g&oe=6A898131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzAtzl6eNNoQ7kNvwGP8hSW&_nc_oc=AdqMZXfWxP3uaYZ4NYGM3bz1MsA17EttzwKt3leW7LUHyY8CzZU-Fyr2DaoQFiOlLSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQUhg8hDvzNR23sn_12bT2A302GUVI3-OwPYEoUdx9ZQ&oe=6A898A28"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
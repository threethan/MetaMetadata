d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk8b9jiw3awQ7kNvwGK1LwZ&_nc_oc=AdrvOQXHAuEG0yzuhuD6kRw3UDqIZUkX2V26KpVKAkdUu9wQkcnjQx7IUJto_FxPc9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRFVypIXxcK6Pmk071q6xqKfhNxurQNSRTrMDa3lHbg&oe=6A7C60CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnyWd9qSv44Q7kNvwHwXPcq&_nc_oc=AdpuIdC-JPp3UYMoqaI1Fe2FAZD2q8ilB80-7whoJHtdvWKNTX3_t8uvoJA6p7dVq4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpqv7DbJOGjn9GgvD3nE8t2JOYkVTX7B8sw29ybiccdQ&oe=6A7C7CAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSYuZG8-JWYQ7kNvwEAizVu&_nc_oc=AdoRWzsHGOcgDWiRIOZllqnCjquPamBt8qRDG2XqY4X5O7i_XGPbriItW6s395nIBrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPdSy0dbgC8NIPe0RJucUdveJ1Wlmbi6_mpH_F6mA9_Q&oe=6A7C6C0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Tp5yrwNpAcQ7kNvwFIR_ep&_nc_oc=AdqTM3ztB4ZrxyS9_4BiTPoNfJCQJq-I087Xf01huCu80unfmyCeIcFvJBpUeAnnwtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6o0cJf3zYLRSF3GWbFEzoPu0W-NsJq7xrgCgdVdFfjA&oe=6A7C5231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7Z1gf8N-CgQ7kNvwG4qJ6O&_nc_oc=Adq3Z8KvWqYfvxfUCVqs654jjSv_5gfvdyrzXCfUrITQe9da-5dAx3IyRL9yDnE93S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3BrwKtwdbNh0jjxHD3yCJR38fTdvI3Jy0SWop4qROfg&oe=6A7C5B28"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
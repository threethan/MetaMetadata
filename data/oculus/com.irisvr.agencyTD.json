d": "127991675991805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVQi2ObftMUQ7kNvwFMSeK9&_nc_oc=AdqtAJIMqI_qrZ40xYzxwi-FTD3RHVw4JmaiPQ_X-w5Tab2S63hjE10TPPMlB3WXI_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40-8O1iVaH253YrmJ3y79lJpYb1ZmXR66FRo7iSOEKVg&oe=6A0DA2CC"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HqxZhP3tFoQ7kNvwHKzG9J&_nc_oc=AdoB56jZf2q9-cF3Fimp7eUPeKurEkPT0mDdgOWr6AStAN3cnUHhaI2XYAnzbQ1IADo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q8B8t2wDonQH3zmTuq9Aqgs1InMhUNcHMov_hiwreng&oe=6A0DBEAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzWAFt5RfNwQ7kNvwFUr624&_nc_oc=AdodYsra1GGVlNdy0W7ze_pmNGM8HYkoxhgTHgnoasFeabf_2ZckU_CI8ClAzZEYAYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_ul8pAwrMxKKxnDHpUIIc2spX7gHvtZ1xkPrDFafodQ&oe=6A0DAE0E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkTyRRU68ZcQ7kNvwGPM0mD&_nc_oc=AdoKJSSFbUdhRwzjvlu0fVKnUhj09TMYhD7PWPO5Dr6HEcbJDGC4UAGbYB5ElqbDSBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4enFJwCE3CGfaQgkdNfSXn2T3k9m8U5bGRonbieA-Jtg&oe=6A0DCC71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRhyc9RaHzUQ7kNvwF0xE0n&_nc_oc=Adoi54u7t3feXjJ-_x2rDCtYACJ8RvBrPAu10N4mc7qKAye2ddbut-SLbaMOM3N7XtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bua7itbUuYS9F-Kbrtmu8PblFLtqmo55diF3FuyL7NQ&oe=6A0D9D28"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
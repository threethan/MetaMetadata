d": "127991675991805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqxZuN01G84Q7kNvwGVl8AV&_nc_oc=AdrLb1RWQ6wWArp0fP88LGBUuHeIUf4vpKppSihD4ADvTjuE-NLPeftfFYuZrrpYT-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhxSCAmjco1_tGpV1XGVIJ30aIpEdGQJJlwu-QW49HQg&oe=6AAABD8C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dktOsda5RyoQ7kNvwGbpF1u&_nc_oc=AdqwLySALzuDlPFUotuV2crqggJzs4RGtoA1IAvrYx9qI4QBFXVMaT5w7c5Mzoh68Qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV4GmVIUvbsH45P4xbgJBlF3Yj-4kGIPHBpNXaAFKq7g&oe=6AAAA12F"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZs0iuhbY50Q7kNvwGOrmPD&_nc_oc=AdoGINGcGrxWSEoG0DWMkxo4ow6ZJP6w2ZKmw-ZyQFts7LhArTivjHk9Jj3tsO5oVM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8nrikwBcmsEwzM75p_uCo8CXGGVjE4ZKTauJf7XXyrw&oe=6AAA908E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rmrrupw7HMQ7kNvwFcF4aD&_nc_oc=AdpwnBewbfrKD2NXUyVqOfd5zcIWDrQtoV8ZafQcXJcMBqQdHWBGXDPXvMFHNKdYiJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjzslHwxw2Mq_U75qu7YxN6fBhEXHTpfRgLxOY7UsIlQ&oe=6AAAAEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS2_m2M67XIQ7kNvwFWlKgb&_nc_oc=Adr8KjhQ3vEuVqBs2EUktVxoqlM9LuIDlK6ySQctdfZAcQIpni30qpzRkBQ_lilDWik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUKkpMmIUcA7YvPce1pzcAVJT7_WZ6tuPmRupFzeoSdQ&oe=6AAAB7E8"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
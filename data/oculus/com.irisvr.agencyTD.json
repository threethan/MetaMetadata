d": "127991675991805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974454_127991679325138_7461666601961412106_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVHhYnv9_IAQ7kNvwFYqV7b&_nc_oc=AdrWlVvb4oA2xlCuRb4nQugLI5O2qeFUff-zm2valZowNe8fo-2lclidKGrpdlKhmuI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOztpmX1eldnFZGk8u1zkibKgkFK-1SbyJMqAOSpNlR9Q&oe=6AD0F90C"}, {"file_name": "SS4.png", "id": "332994401533047", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_332994408199713_6897083028176455229_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIdcSesnaeUQ7kNvwGj0F7j&_nc_oc=AdoAcUfEQ8CpC8c426XMJqGeEm4Y1Vpz5FuScHOoe1pnLjreqvsmfTJ0qRQVhRm2l1c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2NynGiEVwQCyTn09OMIg5CnXXC7k9XZr9EDw2KNLYow&oe=6AD0DCAF"}, {"file_name": "SS2.png", "id": "805694940359250", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974726_805694943692583_1374746554390107408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2RaUYC1Tz0Q7kNvwH33PYF&_nc_oc=Adrv63pwYOfyb6Jz3hgNDc3QRHwx2dkQ0MbxuaiBEJCfBIzCr2dDZEIhYjEHmudy0zE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwLsCCEPzn5q5Ya7XoH7Ojpq6gFdZGWH7x57KaVrc84w&oe=6AD1044E"}, {"file_name": "SS3.png", "id": "516812809354794", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974642_516812812688127_5848313331002386223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlOKgcvLDVQQ7kNvwH8JS6b&_nc_oc=AdocZfD6GHDu8geY44cUJt_oA3K8B-yy12AhpvCvUaHuhQMZ_6cT3F7RrXhH-KjxZYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF_GmftvkSHu71WcUsUzy0n_yARFKWXeKjDFds2RgAZA&oe=6AD0EA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2835268050116587", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974560_2835268053449920_7475960195631235106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAfPTKSRaycQ7kNvwGzIL5M&_nc_oc=Ado3nzxARuyWUVDnTNmOYVgrZbRB_RT0igSpc1VqCbf2ssz1q12IaGbF1MijiEpdb2w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMakd8_D4ujZrYERX7WRgNW7P-0VnYfX5jvVLKbZaPjpw&oe=6AD0F368"}, "display_name": "AGENCY [TECH DEMO]", "keywords": [], "long_description": "You\u2019re the \ufb01rst Metacorp model to receive an experimental \ufb01rmware update, code named GENE.SYS.  While the engineers are discussing the implications of the update, you awaken.  You have agency. \n\nYou must escape this prison, \ufb01nd a way to survive, and take freedom from your makers. You\u2019ll meet friend and foe along the way. Spread the \n\ufb01rmware and start a revolution.\n\nA rich narrative adventure awaits, \ufb01lled with highly detailed characters and environments, exciting and addictive minigames and reason to return for more. Live out the ultimate cyberpunk power fantasy starting from meager servant and ending as a leader of a robot rebellion. \nOnce at the top, you can use your credits anyway you see \ufb01t. Upgrade your hover-dragster, spend them in the battle-bot arena or just become the richest android in the world. The agency is yours.", "short_description": "A small tech demo created as a proof of concept for the upcoming title AGENCY using Google Seurat and Daydream renderer for the Oculus Quest/2 platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/62aeebe9-12ac-462c-bf94-4fb0ed733272", "developer_terms_of_service_url": null, "publisher_name": "IRIS VR INC.", "support_website_url": null, "website_url": "http://irisvirtualreality.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
NPZxweA&oe=6A2EB0CE"}, {"file_name": "Oculus Screenshot (2).png", "id": "6882517855134571", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031344_6882517861801237_7491338628550035453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8z0JPm9Sc4Q7kNvwEd7IO-&_nc_oc=AdocPlGjaJwG79DjscVLBX976V2fIMW_9O5OUlWQKDpCpUrVfdNn5C-Vzag6YYJCLvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8QYzfL8SN87f3RS4sFpi-5t4a5Y5E1FLnRGbCMh6qlw&oe=6A2ECDA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Screenshot (5).png", "id": "1502415067247993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001670_1502415070581326_41715781668599962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7t6ErKzqZsQ7kNvwFmhA_r&_nc_oc=Adq_bYHXJMgSuBc0GD2jZjqanYmZaivGeU5IErOPp4-7KGPk1nmKvmCm2MkyqGHJ09s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HH4Z5s-kh8Hi8QkV4E18R3IQBAf1odyEhleIc3Mv77Q&oe=6A2EC617"}, "display_name": "Shoot the Robots", "keywords": [], "long_description": "Good old 'shoot-em-all' returns, now in VR! Now in futuristic environment filled by robots, drones and flying cars!\n\nIn this fast-paced game you have to shoot the running robots, who try escape your gun-point in any way: running, jumping, crawling, riding cars. Take your favourite pistol into your hand, and enjoy sophisticated animations of how robots fall from your well-aimed shots\n\nKey game features:\n- Super enjoyable robots death aniamtions\n- Futuristic city environment\n- A lot of 'Mods' to customize your game experience in radical way", "short_description": "Do you love shooting? What about robots? And what about shooting the robots? In this fast-paced game you have to use a well-aimed shots to neutralize robots which will run away from you in every possible way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/shoot-the-robots-vr/privacy-policy", "developer_terms_of_service_url": null, "
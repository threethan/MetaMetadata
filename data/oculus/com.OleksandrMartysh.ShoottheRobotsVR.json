gHCvJ8g&oe=6A6F4A4E"}, {"file_name": "Oculus Screenshot (2).png", "id": "6882517855134571", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031344_6882517861801237_7491338628550035453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPrW8XYM_vkQ7kNvwHj0pJh&_nc_oc=AdpkupLsC9Z_PoTLHkjEEGZKq4Hmm4YOAr8Dio1HwDxw2fcOxIBD0mIx52LUjCeCS9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpo6s5wfONY2xz2oBwbbYUgnpqxNCkpSC2KBvgJO00Lw&oe=6A6F2EE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Screenshot (5).png", "id": "1502415067247993", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001670_1502415070581326_41715781668599962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrhWalF-wrQQ7kNvwHJ23dJ&_nc_oc=AdrtydmOMTmqy4L1xNtLO3lf5KeZ_vcnLtOojGV2QxtHpRfQ7Vx6dUP2E0zzfpXF-BM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBASn9VfTPvGZemolNQ0nZpw9JrvTzupO3tm0lxOJX6Mw&oe=6A6F2757"}, "display_name": "Shoot the Robots", "keywords": [], "long_description": "Good old 'shoot-em-all' returns, now in VR! Now in futuristic environment filled by robots, drones and flying cars!\n\nIn this fast-paced game you have to shoot the running robots, who try escape your gun-point in any way: running, jumping, crawling, riding cars. Take your favourite pistol into your hand, and enjoy sophisticated animations of how robots fall from your well-aimed shots\n\nKey game features:\n- Super enjoyable robots death aniamtions\n- Futuristic city environment\n- A lot of 'Mods' to customize your game experience in radical way", "short_description": "Do you love shooting? What about robots? And what about shooting the robots? In this fast-paced game you have to use a well-aimed shots to neutralize robots which will run away from you in every possible way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/shoot-the-robots-vr/privacy-policy", "developer_terms_of_service_url": null, "
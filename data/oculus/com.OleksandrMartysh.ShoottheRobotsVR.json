1344_6882517861801237_7491338628550035453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyGPHWWKde0Q7kNvwFYZF_k&_nc_oc=AdnZPbY64OAiWRp8l7qQwMoEdLKdE7ql3voEGq2q8X7V_P4GvJwdaNPlKTe0RHpeAr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvszMTWvKqhQlr-YJLOSNjX1eh-5R3GaPYH0E13RfYaCA&oe=699EE1E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus Screenshot (5).png", "id": "1502415067247993", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_1502415070581326_41715781668599962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJLrQTvQZdkQ7kNvwGC8jda&_nc_oc=Adnw--yCuAozaNNNJsS3LrXJy_acOvp4vK_-3zvwBqu-jrncS35Me0nHDuNlF623dGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsC9xSv7x-aqljoOnHH5kLUigzs-2z0StDbD6Pme5_4dg&oe=699EDA57"}, "display_name": "Shoot the Robots", "keywords": [], "long_description": "Good old 'shoot-em-all' returns, now in VR! Now in futuristic environment filled by robots, drones and flying cars!\n\nIn this fast-paced game you have to shoot the running robots, who try escape your gun-point in any way: running, jumping, crawling, riding cars. Take your favourite pistol into your hand, and enjoy sophisticated animations of how robots fall from your well-aimed shots\n\nKey game features:\n- Super enjoyable robots death aniamtions\n- Futuristic city environment\n- A lot of 'Mods' to customize your game experience in radical way", "short_description": "Do you love shooting? What about robots? And what about shooting the robots? In this fast-paced game you have to use a well-aimed shots to neutralize robots which will run away from you in every possible way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/shoot-the-robots-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Martysh", "support_website_url": null, "website_url": "https://sites.google.com/view/shoot-the-robots-vr/home", "category": null, "comfort_rating": "NOT_RATED", "co
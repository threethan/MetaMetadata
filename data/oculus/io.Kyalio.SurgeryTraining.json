ion": "Kyalio provides multi-specialty surgical education content that is comprehensive, adaptable and diverse. Surgeries are taught in detail with a strong focus on transferring practical knowledge to learners. Whether you're just starting out, in-training or highly experienced, Kyalio has content that is adaptable to your experience level. We go beyond \"perfect presentations\" and emphasise on learning through the rough and smooth experiences in surgery, as it is in reality.", "short_description": "Real Surgeries. Real 3D VR. Kyalio brings the best of surgical education to Oculus. Learn from leading surgical educators with a first hand view. Broaden your experience through our structured lessons and guides on performing basic, intermediate and advanced surgeries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kyalio.com/privacy-policy", "developer_terms_of_service_url": "https://www.kyalio.com/terms-and-conditions-of-sale", "publisher_name": "Kyalio", "support_website_url": null, "website_url": "https://www.kyalio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "593946652443001"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "553234996919608"}]}, "baseline_offer": {"id": "553234996919608"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681322040, "status": "PUBLISHED", "id": "553234996919608"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28388156787476444", "version": "2.0.0"}, "id": "141611351452250", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4500103800041744", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28388156787476444"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "141611351452250"}]}, "change_log": "We've completely rebuilt Kyalio from the ground up! This update brings a redesigned experience with a new interface,\n  smarter content discovery, and more ways to manage your content.\n\n  What's New:\n\n  - Simple Phone Login \u2014 Sign in quickly and securely by entering the 6-digit code displayed on your headset into your phone\n  - Redesigned Content Browsing \u2014 Explore the new homepage, browse by category and series, and filter content to quickly find what you want to watch\n  - All-New Virtual Environment & UI \u2014 Enjoy a completely redesigned virtual space and interface built for a smoother, more immersive experience\n  - Favorites & Watch History \u2014 Save your favorite content and pick up right where you left off\n  - Download Management \u2014 View and manage all your downloaded content in one place\n\n  Thank you for your continued support \u2014 we hope you enjoy the new Kyalio experience!", "created_date": 1787196847, "id": "28388156787476444", "version": "2.0.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typen
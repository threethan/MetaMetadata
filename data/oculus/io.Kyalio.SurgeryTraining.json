ler_thumbnail": {"file_name": "ELSA VR Library Trailer Thumbnail 2560x1440.png", "id": "409124470563514", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001656_409124473896847_3319268495931396359_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=640t8oT40IQQ7kNvwG_kq7Z&_nc_oc=AdrX2hejXpN_01WE_knA8QCl7Wkq6MM5vysx3fcyzmVzvqITlmdMsfvbOEmdn0hFN5A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x3ssM_BG6Duk-JvAWuBOMJIphmnJrEXWFc9kY-7f5fQ&oe=69E77E50"}, "display_name": "Kyalio Surgical", "keywords": [], "long_description": "Kyalio provides multi-specialty surgical education content that is comprehensive, adaptable and diverse. Surgeries are taught in detail with a strong focus on transferring practical knowledge to learners. Whether you're just starting out, in-training or highly experienced, Kyalio has content that is adaptable to your experience level. We go beyond \"perfect presentations\" and emphasise on learning through the rough and smooth experiences in surgery, as it is in reality.", "short_description": "Real Surgeries. Real 3D VR. Kyalio brings the best of surgical education to Oculus. Learn from leading surgical educators with a first hand view. Broaden your experience through our structured lessons and guides on performing basic, intermediate and advanced surgeries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kyalio.com/privacy-policy", "developer_terms_of_service_url": "https://www.kyalio.com/terms-and-conditions-of-sale", "publisher_name": "Kyalio", "support_website_url": null, "website_url": "https://www.kyalio.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED
cdn.com/v/t64.5771-25/38974692_1142491587438694_4527102211773150970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxMKLhapWTEQ7kNvwHjqG2D&_nc_oc=AdliKk6h-w0wFFE-BMjggyE-h7uGQ722kZhlWUFdTLx8faQd2vqmFNq8pO6vt8I-OeE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuJ9_bgJCZjeZ8CvbamSWoT-b9iSK6HH22LeiBWia1Pwg&oe=699C516A"}, "display_name": "PulseJet", "keywords": ["Music", "EDM", "House", "Live", "metal"], "long_description": "PulseJet brings you indescribable immersive music experiences from your favorite artists.  The PulseJet App asks the question \"what does sound look like?!\" and answers in the form of VR Music Videos and Concerts.   Other videos and albums are available via in-app purchase.   Our app contains VR Music Videos and Concerts from your favorite artists including Glitch Mob, Father Taj, Nicky Genesis, Diggin' Dirt, and more.  You can discover some artists for free.", "short_description": "PulseJet brings you indescribable immersive music experiences from your favorite artists. The PulseJet App asks the question \"what does sound look like?!\" and answers in the form of VR Music Videos and Concerts.  You can discover some artists for free.  Other videos and albums are available via in-app purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pulsejetstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "PulseJet Studios", "support_website_url": null, "website_url": "https://www.pulsejetstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
818861_985375611113980_2797188490599375733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcm2Ca9viXgQ7kNvwEARBDj&_nc_oc=Adok0UqL2dJJcWhq_v4i-jY0Ps6a-ZFIQ4haSMrG0P4W2iIdJpdmyUgdHe5ZZzGb9XE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rTyLR0PK_RBZYCHWjcKDFWTetJp8h1y33tPeO3ou2OA&oe=6A217C97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zipline Mayhem", "keywords": ["Destruction", "zipline", "speedrun", "physics", "climbing"], "long_description": "ZIPLINE MAYHEM is a fast-paced VR action game where speed, destruction, and combos determine your score.\n\nYour mission is simple:\n\nReach the finish line as fast as possible\u2026 while destroying everything in your path.\n\nUsing two fire axes as your hands, you can:\n\n\u2022 Climb structures\n\u2022 Hook onto ziplines\n\u2022 Smash objects mid-run\n\u2022 Chain destruction combos\n\u2022 Speedrun through explosive courses\n\nEvery object you destroy gives you points, but the real challenge is combo chaining.\n\nDestroy multiple objects within a short time window and your combo multiplier explodes, allowing skilled players to reach massive scores.\n\nMaster movement, timing, and destruction to dominate the leaderboard.\n\nCore Gameplay\n\nVR Zipline Traversal\nHook your fire axes onto ziplines and launch across the level at high speed.\n\nFire Axe Climbing System\nClimb platforms and structures using your axes as powerful climbing tools.\n\nDestruction Physics\nSmash crates, barrels, props, and obstacles to earn points.\n\nCombo Multiplier System\nDestroy multiple objects quickly to multiply your score dramatically.\n\nSpeedrun Challenge\nBalance speed and destruction to achieve the highest score possible.\n\nKey Features\n\n\u2022 High-speed VR zipline gameplay\n\u2022 Unique fire axe climbing mechanics\n\u2022 Explosive object destruction physics\n\u2022 Combo multiplier scoring system\n\u2022 Speedrun-style finish line challenges\n\u2022 Compete for the highest score and fastest runs\n ", "short_description": "Race to the finish in this high-speed VR zipline destruction game! Use fire axes as climbing tools, ride ziplines, smash objects, and chain massive combo multipliers while speed running the course."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26097825143253123"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2319166708841563"}]}, "baseline_offer": {"id": "2319166708841563"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775190060, "status": "PUBLISHED", "id": "2319166708841563"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26097879706581000", "version": "1.0.42"}, "id": "1530015079129547", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26097825079919796", "is_concept": false, "latest_released_
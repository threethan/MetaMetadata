ng not to disappoint the Company.\n\n\ud83d\udd27 Upgrade your station\n\ud83e\uddea Scan, sort, and sell strange items\n\ud83c\udf31 Climb the tech tree and unlock controlled chaos\n\ud83e\uddcd\u200d\u2642\ufe0f Play solo or with others; friends not required\n\nBecome the best employee you can be...\nOr the last one alive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://growacompany.online/privacypolicy", "developer_terms_of_service_url": "https://growacompany.online/termsofservice", "publisher_name": "Maliba Entertainment ", "support_website_url": "https://discord.gg/bpZrJRAmmj", "website_url": "https://growacompany.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24268462802851940"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_2725078817890593_8448968436906921774_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z17NdjMfM5gQ7kNvwEX_Oms&_nc_oc=AdrrjqaEY116JdZOQoSqq8ImCpHjFvSPb3UgoyBOFFKZJkHFTnmD0SwvUGqrpY7NxT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyljS1TD1c5SY0KtRlJXCoAkpFi81G2yxi7HbYBCkFzHQ&oe=69C11E78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Grow A Company", "platform": "ANDROI
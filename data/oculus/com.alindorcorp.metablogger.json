ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJqYwkrLoiMQ7kNvwG1OV8l&_nc_oc=AdpLXlr-3F17LomS_H1orXYpLgCckU1Jfyrh_13YgAaGmcOw0Tpd-osHVzT2eC4n8YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMF986WXbjJnjWWrijgLVwY3y5oM-B3F5F3VCF99Du5Q&oe=6A8C2284"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUG6nilqCiEQ7kNvwGSe3Fx&_nc_oc=AdpRWRBATrAL_g1DD4Fr8RlU7zAsuWEPAVhwIuKup1s7GZPuZjlnGbPiHh8aykaXecI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW0afG3DQz9eXB08CBIM6uuVeO8aizfl3bk0QWtCfYBg&oe=6A8C3A88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JETP58e-9zQQ7kNvwEJ9CU1&_nc_oc=AdrtYvnSq0h9uxZoBlSdkL0kiMYYIC6rZ1ak5G55riGBC4Uzfpf_fWdOq2C_mFnCyyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4YognXiKUI4SsnFvoULIctd80vq0eo91tNgl2cnPZsg&oe=6A8C3F13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4KY32GipCgQ7kNvwFikrgl&_nc_oc=AdrHjDaYR8RkuUdCuKjhAzSnFQCeagQpt-uwz-qxdpu2K_9hQB7t7FxLWu1DeCOKuoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_MK1qY_w4zPjgbjVo1wENL9f-IMoBvzEKRCea2hPeKA&oe=6A8C11EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEENezjWjN4Q7kNvwGoa8qq&_nc_oc=AdqA9O9Akt1zy13YNZe3SwBhjoZ0U2IEgFBkeUP-7JtzfbGay0CumUWLge_kvzL2UHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9iomWLYN5ytoudpSNjD6k1qRQjGPw0nMYSgl_VhSDAg&oe=6A8C1F6C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
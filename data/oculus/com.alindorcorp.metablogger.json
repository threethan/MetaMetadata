c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rhb5zhdE0F8Q7kNvwEYyfER&_nc_oc=AdkUGs6ioZ90z5WD5AuU3n7al00xMa-ZJmstW6bU-YWTmbiVVEHAjCXOsY1GY6TsQMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXpEaPpysn1wQzPfbUZSl1NFUx5TyRkMVlNorBPN6j6g&oe=699D8304"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTL7xhI-pzEQ7kNvwFZhMIS&_nc_oc=AdmvTITc5OVL9eB0rzm27YPijU07iv3KQ8TJdR170Tb8YlEJj8AfjrQ5HfB49XUUdF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvbOo4Cp6oGsgIDwv97rISbCOMYanVh6GZaEyhy7HeF2g&oe=699D9B08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c11Dwp42nsMQ7kNvwFq-5Yz&_nc_oc=AdmUkzBRmSbgtSnERyM3cdvcXZzMGU96wJtVyRwjlSD-Nj6kRmhIkqJ5ZefcPT2_7yM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEVsNlucuYYxDZrGthVOEmnY6T3OY_jzm993Dy_Pq2oA&oe=699D9F93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmUWqyx0AJgQ7kNvwGeR9cX&_nc_oc=AdkZqgsu_yiY8CSAI5u6Gg9CdotNVuP43fEPiwCRbLqUgZRgWOdkx-c_IuB94VQG-qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRsyUsh1JgkBdEhhEKrOVSwgxoYR1E-GqPys7isdF2dg&oe=699DAAAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTZRql-czVAQ7kNvwF618sx&_nc_oc=AdnmQt5g8OZG0LXYjlJAqSSpmGnYRFVcY7V8OGZa1m9kxhPAnBjPZ-Rn-0zveL6aZnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsaVFmMvDyVLiouxqu2b10DLYIqfVOny9nuhrmQibv7g&oe=699D7FEC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
xDp_hHpU9WUl-aF6Is3PtQ3OFLJ-b0rC213qjEkRrXKxTHmaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIm-N7TN8qY-PY3tnoVZGz-6CmY32LoMclBItNsc_NAA&oe=6AC7AE44"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXd9Asb_fqwQ7kNvwFx7ITG&_nc_oc=AdqcWu_UxYjOiZbl_h_NIb06WmBr2i12cMc2SMoL_qbiIvCTLs7-117pQGjGkP9AOb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQJ4AuMuWMLVPndEyTcL5naeGfzyhWe5MMj0qD6PHczg&oe=6AC7C648"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHlgG6VXn_cQ7kNvwE5Y30K&_nc_oc=AdpSXa3cVnWLSAhnLgzTjMCIWHgCPPmKMykRXOcezU8_NCC_ZmlfkUPrZ-C1EIE5Hvg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGwV_W1xiAFRiSPici5izZ-diIeRPXRuQ2z4eSPGeDIw&oe=6AC7CAD3"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yacob3QpwWQQ7kNvwHzNDGa&_nc_oc=Adqpse9Jo2LpxKTSwY4R4Y5kuNst7qeNtKOV1SBDECpTyWyMHF-vpt_LQFy5-GsIVDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOj2gpg5NnnMDcKdWCuDOtr8IEbzi0I1aSwfVeHIafZA&oe=6AC79DAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuGDb33AwP4Q7kNvwG7GNdR&_nc_oc=AdrXgBySR9vBiY-fiJ9laFdt55kadaiphGnvbh0Lp1-rD1mZsaLqh8J4Hxj_gZciCWU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuyAH-i7_iUBzYfpPuIURZvyqkH9fy98ZKERaYKuZzOA&oe=6AC7AB2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
om/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d91jgbWpuj8Q7kNvwEpLHus&_nc_oc=AdkfM7UjzPFxro7tjwkRyVfe6YUI2PeSWiVhNFPWUOoa7k6Wyiqrr_3t4F0DAgwAhWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLLROWNPwRjX0L3BEGNRlfEMkOwtZCv_PHc4XBMaET8w&oe=69BC0DC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JbnBjl0I00Q7kNvwHn-QhW&_nc_oc=AdnsrDjxMkT8jR9XKRrBnB6QTFCpRyUQKAIcYB1i939SThgEt-8v74fmONRQUCaE7iE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZD4FqiwwHdh4fvH4FTnFo_N4aR7boqOio-e0kdc9KHA&oe=69BBED88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiBeb7O72CIQ7kNvwE7qt9c&_nc_oc=Adn71pdBMh1pbt71-MNH0lvRB6WyRJNO3c6ir259-p3OLiQY02zzOnEyK58lgM7n2mU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGAcAz0z_L2f1Fn71xbOUc36Mc2jspR9Oh0f_jFR8u5A&oe=69BBF213"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ABF0hnD9KoQ7kNvwEt7yKJ&_nc_oc=AdmK38az95sKMvzJ7cXNiHjxFWFa3a1tmSeLRwAETdTJelYOgPWmwgaLD7Ot5vRtOPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVfqce8jCI865o8nOVkpd7zbyl6-X8pHkI5CJsjvT1tA&oe=69BBFD2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeXTeMt6h8UQ7kNvwGhwMO7&_nc_oc=Adk71enCFmwWLkvDV8hic6ovRcI7ND3JDvKQNnQvWMgCvBzNuNYzL_I-ceXj_MiL3io&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMu82lphACxlPSkkl4QxeNt40EfY7XIj9hfUZ6LTbDfA&oe=69BC0AAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"},
MmSvWCw4W9Vb1G4NSy5TgLXWYxsCGt6jWG7VFH6TdeEjurhRs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGS4urx8RhFv6mIRtCnhOhGvFwWCyUJ0bTVSoe2-5apw&oe=6A971F04"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYdB0pzXcyYQ7kNvwGjGplZ&_nc_oc=Adp4lG3r77-P250MJ--yhbpoympGS4D-pQsTPhdIRVPK78TSTNyPGZDJLp5vcfzN84Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXFvZmihjUrz2a70IOm7HrFgEZzhxF_cYWQa5yIF9UwQ&oe=6A973708"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEkzervhwBwQ7kNvwHRlczv&_nc_oc=AdpMzpXSk8Xl7ox2AelfLr73rFPH3_QyWl-NNyhZ6rMOe0bWaezleoJcUqeKYmbAguo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5qdTapA5rDjW2QM9PMywiF09MPJH6-kk9gbUZNqThHg&oe=6A973B93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKCbkcrWPRwQ7kNvwEpXcQM&_nc_oc=AdpEhkQ7Vrc3pkP-Dy2XlCkRw8mhWkbhJj-XQFYlG1oUh-0R6FMk3yWX3KcBIfTGdNY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_RGYsR16HhuQYdwZV_psoM3M3pYyG0IoBqVufAKtO5w&oe=6A9746AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt88WwWZvFkQ7kNvwEEEOBL&_nc_oc=Adq3ndx1dvQidrqdgJyO6OM6I8JEAYPf7vRBoq72Lhk4StRWofJ12fYgf3x9qK6e_Sc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGECXRHDTgV5tGEav-1oDehmGiIs9WGdg7irahaXvXi1w&oe=6A971BEC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
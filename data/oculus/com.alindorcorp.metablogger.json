ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOQY44o1cB8Q7kNvwFR3z6g&_nc_oc=AdqyovL9ANHivfLCyL9tVwzxaSJH-yFhNj0mBLYx-dDjBLOEkS_-QU64zQf_cyfq0QM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n0ePNbKrBFFCvcH_lKdkw5pwyHYoheL3Q__O0KMYMoA&oe=6A3557C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQNQdc490ywQ7kNvwGHWhPq&_nc_oc=Adp-6a2yizYYtwnWoNmeK_4RxMToXnM5dwFIEzwnS-FORXaC6tJh5jPV2gGoWgN20RM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__pXNQ31L_jICSX66T4O1DQQWGtGq3vR6yzEf-Rzlg3g&oe=6A356FC8"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVPBJ0vOO_EQ7kNvwHbl_p2&_nc_oc=AdqN-Mdz4UknbA9asOJ36UzSy_9F19P7bEmSlVIMbcAoRngJ-2-Xp81z1094Yok13HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QZIMfqUZp5DJ4g3AcFSvOIE4Q15rNvyDkJqVtKwL02g&oe=6A357453"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qeLGkGbkNwQ7kNvwHtXsRf&_nc_oc=AdqGLOpn0MRlJgWKlUFYt8QPB-hUJA9yI4vQaE5AaCyRSpme2xYkgqgm1PYgzsBDxgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZCgehd4cT0KbSj18zeYko3DGcjIijf3TO0OgQGBrE7w&oe=6A35472B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7j4OIkqV04Q7kNvwE-c78O&_nc_oc=Ado8ZrQhBl6iudg-PrVzYlKOqlIrCb0IOCDB2PaS4_JrplIsucTx1PgClwiuvUCsxoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g1rEEqZ7B2BrcJFFb1SgmaI_Kk2ZTQ8CPWJICvh57dA&oe=6A3554AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe61Ds3i3QcQ7kNvwFuP-FG&_nc_oc=Adpei8btltSyoq2wgNMwFR3BtpUHlHpLThcMcZW9_IZu8RY8H2F5Z53wEn3LMo-2_U8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07IEcV2R50GWGYVEgqMENumzPQEzH787Gaoc9n2tT0cw&oe=69F60FC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpJrD4DeFd0Q7kNvwFjSd4q&_nc_oc=Adp5P8KDBavmCz5krHeYIsVPTqbjPekODX76GOu_9mlHilgg_WLVi22AHZ5XJyEOXRI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VdMt5c5VGOsIn4cZ4LOpkncI2OoIG7Kbkrw7Zg5e_KA&oe=69F5EF88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw5xqkX3AeAQ7kNvwFQcNnY&_nc_oc=AdptAAbIPGCnAYzOx9xsQty1CyF7u3EZABC7DHb-JWkHshtpNWcls7Q4m5A2jkTfLCw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rrBYowalgeucJbUBGOJelGHSsvVjzJs8ZBXXKGE2OWw&oe=69F5F413"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_54kopI_0wwQ7kNvwGmSS97&_nc_oc=Ado9KcpT0XCD5RM1GELruIHru0_6n548gHTqCNgwvdiGznONSBnu_b2rralfAKonuwo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n4zQNlxxJjRdw_LSQNsDLPCpS6pCm8BOiA7SyM-JtxA&oe=69F5FF2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2Lh55rYgpcQ7kNvwEdbuFp&_nc_oc=AdooCw1YXgzY_RAkzFlZg1-0hzFm8aXcUF6HroCKJHNpIwAlrq5kBDGD-Zn0BU3axdg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37PE3yF4rDsjAhdWKj3m4tE0CaHN_G_azqjm1VN3TVfA&oe=69F60CAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
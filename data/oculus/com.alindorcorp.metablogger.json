ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d65nF-QlWXcQ7kNvwFir6C8&_nc_oc=AdpMcUmu4560SObI0X9bzjVl0cT18OWBhxhF7UG_aPb98rxz947yZ-k9YiLwCTCTQIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEPsYdYVoSAaPST-104Lm2aoTteZ06ZhQ78UjV4mq-fw&oe=6ACBA2C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iPRi2sRY44Q7kNvwF1AODv&_nc_oc=AdoL39vocXyl1wKROO1WTNIykdrZr2_ztmQYdtVG_wGsn-ZXm1bvDCqif4NpAw-WOwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAWCxllnioM8UPKZNlwnRhti2-IEHXP0ZwnTvQbhCpuQ&oe=6ACBBAC8"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5iPdVShswgQ7kNvwH2GkM4&_nc_oc=Adpx1dYJHzCLuVTz0IUqJ4g4U03E3I2XGcUOfB3dcIAAPDuccGC2fJ2GsT5WFFHjZCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKhZZEW91bpiG_MzDQ1gwHPJ-4EvSzbpNa_GN59x91YA&oe=6ACBBF53"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGRySTiS9TQQ7kNvwGEjowt&_nc_oc=Adp_aOUCuLA63T1Oq6Yx-CKk4ee0qMk4TlSrMN8UirPB8qE5m5keOiwKHe9DZOOHL6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7ieHCW_yrfZzWfpKbUiLWcRVub_VJ1aqpQXwtHPf64Q&oe=6ACB922B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULi2Fv7G4BgQ7kNvwFwfviI&_nc_oc=AdqjB9eZ2rRBVTkssadkAy0bztacgj7BHo-vXExkcPpiKz86XK5m5yjwSYPAfiX2iGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdsudzqq0inaQ6VX6vvvSIp2ER6MCPRtadtcfE2CZAyw&oe=6ACB9FAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlMPFpaK43sQ7kNvwFRl2Ri&_nc_oc=Adoo1nxFnM8ARBK8pu1WikzJ1-aQxi724ygd3XexfQzog5KCtjn11oxhr9gqRzbHYIk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvYca305wHBTCTZFafZRZtMMNhyK9TCYcnwvkMx8v4OA&oe=6AF9C744"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm90OMNsP-cQ7kNvwHPfVxE&_nc_oc=AdqCw0w830By4Fga8M2NOvX6DQl3D1_cmbTjmqmILdrTsNSX6E9Bv0CVaTObeB92MBQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxMuHBpTYQYGyKzZ2PUfvuX-zFrYVTvOpJusi2U_aLDg&oe=6AF9DF48"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meSqzyZhr_QQ7kNvwHpAst0&_nc_oc=AdqMy3zVGU0Wc0PV38rvsy12nuNuAi-271iYpiKo5_jP9xxFRETvAq3Z1rXMvwb0I9Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ_krs91PJvsBU7f3hBh9uPio6KFG-UA1H0QkZhk5FCA&oe=6AF9E3D3"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNznHiwSPfgQ7kNvwFMTPI6&_nc_oc=Adod4R6XSIH4ItmmW9eoQ69KKSbWUS2k0aYPqsI5FWJp2YfSlpCN3x3f6U_mrTURI_o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwl9XgSvNLaTidW-N9ne0O1P4Nlhi1P1Zmw2A95Q_vKA&oe=6AF9B6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbTXZsCqdaoQ7kNvwFk3PDC&_nc_oc=AdpOIMy10JRlCjObqB6ZXZ7OTKtVk-BYwX2tov9A9Q2JxcRO98up1j8yAlSoM723yJY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSvwcciNi9sQ41pJVJRzEMSHLroHhpTdVdu-QmVIJhpg&oe=6AF9C42C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
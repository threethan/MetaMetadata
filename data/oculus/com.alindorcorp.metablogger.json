5EOcSRDG0vz1coQc7w3zEC9yTACib90RxX0Vi5VAulmQIlHIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EFz8SESRr4zTqnvAA0bNzAbRimKHOFNGo0IGC4DlYzQ&oe=69ECD544"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8f_tzF1bVGsQ7kNvwFVlLiQ&_nc_oc=AdrMhH9cHDZstvfM3PG3RhXGPDlrcysS_td-vNjCBZZE3OJINRu2sWWBVvk_2u98NYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14eNPSgXYxUFZAxJv1cNMGf6_HWSnGqXHg4zTEACn9cQ&oe=69ECB508"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wmpBn4qWEgQ7kNvwFM4NXf&_nc_oc=AdqqMmWiuQQaFGntYkxoRjjdzlJUMJN8RMK0aiTDlyuCx1x2ywBmS4tH494HTjKSDNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J8l3Pg1NXzX9tgkkf8wP8sSuKRqnQtabnHhoKaPhQxA&oe=69ECB993"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvbXZ6YYweUQ7kNvwGOPXSq&_nc_oc=AdrtVOavWVRenDoZMiEK2MntlQTWhQWqUZQLgXTlF1YIPID5jfdc1Yo_qqVVIUCpb7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zXyVK3lY3tMFx2pCvDAuWHX3_lMBCnXB3AO9KyN65nQ&oe=69ECC4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9x7tjtmX2sQ7kNvwH6Spn8&_nc_oc=AdrjAzZpTAuxYxPCKYa5JKiqDaFN2_brmNWOk3D5DiDBNXNn8e8FHEbSbi6zXbZjG1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QLrYQVCwOJfJt1i8YKhVXymZ-wc98UJFvisU0eePYPg&oe=69ECD22C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
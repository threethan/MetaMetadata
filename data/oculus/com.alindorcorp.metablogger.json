cdn.com&_nc_ss=8&oh=00_Afu2fNhb4rgtLMHMCT_3225_MpK4ujqpXEIuchyzh9G0qA&oe=69A96084"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUgWcclIQncQ7kNvwGHdEoX&_nc_oc=AdkZogEQu_TtsOo2qZLEGdygNH9KSZsx1QS9B6NwSMkLRPBtECJAy-6B04QsvmcdueQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOhPTiCYfo_566QA9wjDbFEk5Sdoj_hltAMAWSWV6-SA&oe=69A97888"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu1sKzSGOD4Q7kNvwHtW7E0&_nc_oc=AdkKHlLRVFlkRr86EQp3teHBDOKZYyngnWXiXCfYMFR8_Ru1ZuQPvwmjq88BpBxzOGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsyrQMUHqgyR01DmbRlkt7pTPyw0EuUpSaq_BGW8Kszbw&oe=69A97D13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukp47VnTn1YQ7kNvwHIjRMm&_nc_oc=AdliU2mBy4XAoT-ZP6omKhYdQQc7N-PUwkmQG5wqgshzyOK0S8dLDXtAjby5mYg1n0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afse_ofJpKjhPrVZmOYQj1uFLLga6Q5_eh6WEtnxznncBg&oe=69A9882B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCXGhvler8MQ7kNvwEuig0R&_nc_oc=AdnKLquu58I4tPmJbN9aOjMDo1zmAPOfVsvrUCwAdPMkHrXQ7JgPh6Yy3XxzT3Oc4p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuer96EOeFi1DoryWbJpbZ4-mh_rke9vb0G90EcvWqJlA&oe=69A995AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
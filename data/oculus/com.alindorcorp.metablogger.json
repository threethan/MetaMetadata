ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJhPxqxgodgQ7kNvwGJbP3J&_nc_oc=AdqgqMhddZyECkbSeAhzAxNbd-LpjJGrnwTzyYoJGXyXRhvG3RcdbqGAv_66WQ-YWfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC813Elx6f3BT_9sZPBrCygmZOget3Dgy7Gz4FIzgtL9w&oe=6A622AC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt_KKncnDccQ7kNvwHnvOkS&_nc_oc=Adr9TQKJ78WQZp48-5ACYJOLS7MQ2O8Oq2oZ4XGBd_GF3HrWKsSMko7OSgcRcpjQaLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL8scpQWj-m6CspfezfxUvmLxT6u_aDUiq3U_YzUv-sw&oe=6A620A88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IF-7d7QNohEQ7kNvwEYwDR7&_nc_oc=Adr_VG-XOrhAer_hlh46eyoQEzZqdO-pncKtJ5Fs6fgOpwWukKv565SqXbaW2YPilno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP4s-IDvPHYBlbmRm7zVt5Gdo2nS40en9jf3sU5dDEfA&oe=6A620F13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccSrM2zXsxAQ7kNvwFzg0JR&_nc_oc=AdogpdCv7sOeTV8KNrbam0uen6p8Lg54rhj1kRMbnZGdd28azUxKLA3GyyVh2D4sUqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHR0ZHhLg-cfepCVxbLmWOHjTJIBRMBLH091IRq1L6fg&oe=6A621A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqXPMCfEsCIQ7kNvwEDPw4L&_nc_oc=Ado-8SfvcEs65NKmwGvzpSpN-jbUkeSJUF8J7K0DKPXGPYK3dYCDGfK7QWkssdIm96w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATAyXE1t5S9LRldfN-LjHG0JR8ueACT3c2WTW5pnjPPw&oe=6A6227AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
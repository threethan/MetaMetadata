ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkyXpxrsoZ4Q7kNvwGDY4em&_nc_oc=AdrSAItX27lWhuvcf2dPr9LoxLTFhm-PBGkzrX7dYZE5wx-szSiifwbY7IJznN5HSiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pAbR6fv74mMhATg2rVUlKjy5k9SoSaSmc_l57ZdpuPA&oe=6A009BC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6Ks3d9C99QQ7kNvwH7YWmg&_nc_oc=AdqLrzxjYtOp7oLMnjSzMt5FiHSkbP3etENi6Hgdg56kYAD-1_rnv_9IS_SVEFa4NQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FrQeFuDRVZS_fG7PtQRfJXMtoHswP9tj12Vm5A-WA5Q&oe=6A007B88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vsq9CAUthekQ7kNvwFql47q&_nc_oc=AdqFH0lgMnKLJcBljSATpiJ7Fh6rk1IPz6qw9lqzAHU_o-a3khq9KKwAsojgzfr5I_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61z9fHHXjJwmyuTJv74XdmTZjs2gnrLKYFMhRTAKd5Mw&oe=6A008013"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltzc-vHZRRAQ7kNvwH_Us6W&_nc_oc=Adp63v82lJtedtpeJJsPdNdnAqBEGe1d8UTof4G7nb8-m8VZFRMyPtbRbhga5nWsHNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af484WtqYMjXmRzIg7u3GDRZn9orz_fPmC87JRJWQLMlLw&oe=6A008B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn9b9ezM2VAQ7kNvwHj8yk8&_nc_oc=Adqwp5fYPxw9blu8tNGKOz5-rOI_6ehD-3rqW3RUCk2EZEd2ttNxsyn0YAiMVbjOEvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_xctk24ZklUkI2LDUuxHSwu-05FUh-9IavMeSy4_AHw&oe=6A0098AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
0AKkfW44xA0jeK83O9nugI0L4jhO474-zgqEIrKxxMXQCwJiQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SwWdjCFdWVD2BUEsHA0IGkp3jaxZVwr7IVP20FrCR4A&oe=69D7BD44"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAgriRNiT44Q7kNvwFZegi_&_nc_oc=Adqa_iHwcMv82M6lXro-aibugNLP4xDS_6p-Dyoc2iRFwUQ30FbsWnfFM-rspiCgjZc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sr69uUGqj5n1c84nZLx0sk9prbqnypwtko1hOTaGo5w&oe=69D79D08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDZbqCNoMiMQ7kNvwEGa0WT&_nc_oc=AdqdZoQURcQa5IlQgbtqm8buFIeeN_39eRm6ZoY3hlajrUPzxtvJtod4fW_iK51z3YI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zEarPgFVMcI6yh2M2e6rgiAgWq4L8Sa_iWXe-8kEszA&oe=69D7A193"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrF9QEXpzVkQ7kNvwHm6tqZ&_nc_oc=AdrQYG_XPSb2sJNnjqEK8kfxf5tFaqihq1UQ6-Cg_FrHrgf-69wxkX-Q14IFTrDacng&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1te8T1AXUYBKdLRM6x526U1HPejWZ3ZHozR8Y1V6-YOQ&oe=69D7ACAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg88S-W-eW0Q7kNvwH9S3xQ&_nc_oc=Adri5CiWepC-SF7Rg5GoJT_lNc50_NTJP3Arhi3wBc6hVWAPOqbjl2zFnrAi40ck-9M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qdx5rAB5sD2AArjgcUara5ytYhqZ2OlXcAtEnH2sBKQ&oe=69D7BA2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
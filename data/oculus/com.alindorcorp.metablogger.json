ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqrZQsuLTVkQ7kNvwEccEdD&_nc_oc=AdriAT2XmnYkpGtwLnhnlR--q1j8zCcX_WZOtzppq_i2j1SlzQOryF0IsOy0O865k90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEz3uxbwtMZe-NwYM00FuBvc1dYLiJytwfn58stxkogg&oe=6AE0BAC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V9y7etta4EQ7kNvwGVLJAY&_nc_oc=AdqtOYMr_2C34-7WquhmlTItLVRdI1O4cV7vmF11nMnABkZxWlJyWssWd290p05Yilg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM6rU1y3E0ha9FHGldRNbMqUkS5SFo2i1lexY3ExSKHA&oe=6AE09A88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef0e8lKLSlUQ7kNvwF_TBXm&_nc_oc=AdpXi9s9OfIMJM18YsKTDzN7AE99ghH33UYc-SBguG-ACIHpIXst--2ox0e6CsuI78U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBYcEP_Hr08q4CXRXnawqhAYz8plHjBPH3D1jC9ReDkg&oe=6AE09F13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQXYnn5KYqUQ7kNvwHgrttb&_nc_oc=AdqzPq2o58VRTep-y9p6E2nDiLzjBFcYQCSqKR2yapq2eqyCo3nzuiFWD8fYA2o3H7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPuTzH4fF8kILojni_5y6qvK4HGSjvM3eKJNwiuleGjQ&oe=6AE0AA2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX95ys_630kQ7kNvwHTpZLs&_nc_oc=AdqHKAoM7ZaeuP1HCnBtj2DiXnqMy2TO6GE0aokV9ovkdfQVgW1dR9YjuCLw8KSceAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqIBaBusym_ADtmsh6Nk_Ag_ukjQN4kD8aoRa59bnFmg&oe=6AE0B7AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
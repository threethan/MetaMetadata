om/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m6PbqoC_YkQ7kNvwE9sGqW&_nc_oc=Adkz_KxIPKPJOhfHhmxzLvkvRB-yIXBaf_N8Ov7yxI7AdMXATXRObKmjYsYdjc5A6fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqVd5VCO4NW2hbFVZp4gFbwjo8SE0mD9ncIAKZhOSsBA&oe=69B7E104"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIH-ZchPQ0AQ7kNvwG6lscS&_nc_oc=AdmqlAS_n2_pk4PJIHDzMYi64zlvtbzyzMGp3vhg5gpYemGXdLhyC4msMbJ2W7U79CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsibQmif4kQFYezHqUbMQseSRGi1I86HeNn_M7kUQ1bQ&oe=69B7F908"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDdmZboTJkwQ7kNvwGUa5QO&_nc_oc=AdmNOImR9XnnzKaUlpacH0G8eOSEeLozpt7DjqBOE5rFBU6KKbkmuzQXZsTC-ywu0TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5Pn30D2QsBIhYO7Rgr3T1pXTNevrVlLAy6eJKoaMFiQ&oe=69B7FD93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S5R_xMmSbMQ7kNvwHKzTAc&_nc_oc=AdlIepAsDvKRotZFqkOLwksKB2XYjX_Tk1kGwVnW_HHcVVKGJoYFAayoJiwwdVcH8tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwpIGpykpEu0HYH7VbJVbgLp7AXYuJy5ycwGsJFnIQ2w&oe=69B808AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G1tA_mpgkoQ7kNvwGzGjwq&_nc_oc=AdnDTibtIzXZKK_mHkvaIrR5NDarmoFb3akW6woEhrWIvPTxJWfyCzKbEY6NePpHZiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoprtUPhXUuO6PevM-RqflqH0BgtwZOlPzj7vr3nbBmQ&oe=69B7DDEC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"},
ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgcLyYYFW3YQ7kNvwHd5dRS&_nc_oc=AdpNqB83yQhbsMnLoDY_hquz_OobvKH98rAwIXgoOBM992izldeJa-PxKyoK57-Zuzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz8w1X7-ar2gJ5daKKNtKjYRO_hF13At0dJa6VQiWHcw&oe=69CBDFC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXr2e7UTku0Q7kNvwHp54hx&_nc_oc=Adoh5LTFxrtug69uvsoEVXJAAENlCt0e3dBmwKIO3t4WvYDAaH3nKnXbN6-sdWs-w_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJbr7VIxesL5MDPwx-i9J8TyzuY6x-L_Mf5x9x3IQCCA&oe=69CBBF88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgKXIwSK8SkQ7kNvwHOWrBq&_nc_oc=AdogdNNdZ0576B4FVbkKpfmrBd6P36QwtiNrUl9T61evXW3w4ZkLf9oNNrmQwZMSuvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaV-v69q2uKtztbjTCiCL6l-UyWBYL7QseCH4iigZVlg&oe=69CBC413"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBVsXYyhe1gQ7kNvwHyGtzo&_nc_oc=AdoFx-rmLzX50N6IQeK5zAbU_XVx_m66U3TzG3eDgdTcQstuOqkzDslQDA_BthwpR68&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLL2nRPYge0PDgJb7RQroNAw3Mgx-ml2kOX7nO55x7Wg&oe=69CBCF2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQrr5LFx46gQ7kNvwGuUraR&_nc_oc=AdqdNal4qhK8ZymuO9AXXrngunq5VfzMQnpn7WJDGchi4Rf8TtkjHZhX29MWyQe6Qaw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwH_65H9Lka-VT7-7I7-tLGRyb9z89V6d3nLWDbsx_Rrw&oe=69CBDCAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
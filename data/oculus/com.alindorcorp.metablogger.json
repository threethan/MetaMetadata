pdZe2bligs3jZvAchMNq14c5Qs62w1p__1F_GHIIBAWjonQ4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wIXvM7lJc0aOuBwZojAzAknadnHkyhOaB_SbUCzkBXA&oe=6A26D744"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gynRMOUhEqIQ7kNvwG2hZWK&_nc_oc=Ado07bt1fNTOPeuczKkk9ILbjE2ftPHZVPKjl5f-rttdB1MI-t5-D1O3g2cp0H0rA_4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_is6J7uF0tdWHxaMro0NWsUUXYnbf8ANh9cHis3ArbPA&oe=6A26EF48"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGPJnXJP70gQ7kNvwG_vjEy&_nc_oc=Adp7tXgrgk5SEFMD94TkcvkeGYYyVH13puYsxGvnVNp1kMn4AkLD_0Zx-Ii_ROLg8m8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rhhAioFCiXX_DaKis_3yy90yyTIuX_fgu6Aw1-ZLxqw&oe=6A26BB93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9rLQaqvoVsQ7kNvwFiF--n&_nc_oc=AdpakAMMdIEdRLFvMDLKqYJHGQyHRvJAR_Jnti4DhHbl5iuVPfXSZAbuiT4cvHnlljU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wEEeMNdiD8XBnw61ILXeKywFI31KSGWjM-_P79oI4dg&oe=6A26C6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYkZzqPqcuMQ7kNvwE0Nhi6&_nc_oc=AdrEAoEEdYEdJuSxfBZ8VMWruNpp-f8ek02JN_Jdngb345WETANTZokr-w0_nNOgVoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RwMOUqpo_OqUhIC-camEt5Ets4LEeh239inWW-MaPaQ&oe=6A26D42C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
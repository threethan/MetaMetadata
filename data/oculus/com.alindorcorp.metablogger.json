Nz0BSpzL6-5HyWQtQF64sNqg3R8M4s1DV9n6XeOxlf4I_Ma_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiU16ROkmqd2jL6abRGh7t8d8DakuDUmxhxD5m07vDOA&oe=6AEC9844"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXZpBY5phyEQ7kNvwFGJ_ZV&_nc_oc=Adre3gfPbZUjU1KDo0gEidbl22IIZFHbsoLk3Hefccsfl9fZgNHN4VmtpVVQ6sLEA54&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZqN3YmFaPseUIm4nyzh-gffF_9twapWqiKptR7_8l7w&oe=6AECB048"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82i3SNhjkN4Q7kNvwGbQVYc&_nc_oc=Adq5KvgCh3tyXswSAr8QPc7iQUWPafoqqTu49FVLBI5bd7eqGU6o3_yTfEC2sU5D7Tw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0HqKILhjR3Hi3gmN8mANlo8s28CTIc8LfJg-yscsr5Q&oe=6AECB4D3"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6bY27vxVq0Q7kNvwFMnJjU&_nc_oc=Adojd2ZceeppEBxFGb34u77sVlQQg1cZfA2GAXIU5ubMv6aEk48foB-_NohslBH5EA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxs5aQ2eDOoyFr7kzzuiKlVIXxp542TQcsuoUekwZBFw&oe=6AEC87AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU579xWb2boQ7kNvwHla8gd&_nc_oc=Adr_FSWj_APYPHz_SzOBnUWH4LhiGOYU1DZZUfW4_mnmnsSEiJWi6lYuCgxLkWD1a2g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiJg0Eq11sQ8-8weTaMfOS7phR6Mt0_9O9Hwcls5ETxg&oe=6AEC952C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
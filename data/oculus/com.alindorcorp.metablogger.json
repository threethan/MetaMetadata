ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpsLKtRFRpUQ7kNvwGqud_5&_nc_oc=AdqUgNWj5DaVMerM5I9A24UdZWQ-BpirsfnNB_zEAX_tCIvLfEYM6n2Go71jXSv1GNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPHTqkww91kVCBKReUBlUBx57pwlR0ISn2c7aus9Zuow&oe=6A5258C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMn-_HAbDLwQ7kNvwEgJWbs&_nc_oc=AdpKVzFfdeSmkdCQEVm5yWrDg9tarTsljB6uU2oMbbHNEZr9L_omOiIZ1j6dK-WXAnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8_h9mHjaO0BkGo2CYraQPqySrJxdSOcnngP5bUT54Xw&oe=6A523888"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbYiHQzyqdYQ7kNvwHRRiCK&_nc_oc=Adof_6R4aUYbmwKnbtKWGBQ-R_LQFwwn8eZMlGTz-8z0i7D_JHdixp1cFXFJC47-Szc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgqQlLA57HxDgnA7yCUhdGijSv5fSAYM5yZwcZourcuA&oe=6A523D13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sMDVDRGmy0Q7kNvwF_8Wz5&_nc_oc=AdoV9VIdxm4IsHQqkiPoOBFBPOWqJUyjNa7n_BdJU6ov1F9juG-M32v6YhJRsHDzbdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2V7aFbmXFxLsgzNbq9E1W2D9QlDRrrc0f23a6WuRtAA&oe=6A52482B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFBFZKdaCQYQ7kNvwHTW4Hz&_nc_oc=Ado8ofeoOsgJrxKpz20tvsZ1GNiFX0nZWBP8I_YeE82J30hOk_GQg4WfoLw9WbcCRuM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaxUJbakSFEA7apGtxuIp5lv2H30Z_QrXReP89rbEH3g&oe=6A5255AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
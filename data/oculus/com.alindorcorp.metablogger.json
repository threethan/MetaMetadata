ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2Lfu-zyET4Q7kNvwHAntSn&_nc_oc=Adon03Xf-mB0lRR9PoCXdYZHJe4dhYn-HbwnaNxOmqeXze1bbtT8TGpsgwNXnyZXxyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzhZM_v0e6ET0Ooz6XEzndxCDJLJLRkMqytqZ-vQG_ag&oe=6ABD2244"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tVy5jiFGAgQ7kNvwHCNB2V&_nc_oc=AdrD1l3zh5wrq6DU5Qz7lPtIkhmaS_tiUuaFZTM4uDTIe1J5l26QO4TGi8YaPcWssBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKays12nmqBnyCSciNeinVZKWHr-x35eOqSVGytX5FteA&oe=6ABD0208"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZRi5jskxz0Q7kNvwHXFlyq&_nc_oc=AdozneQC-T4jQLws0jmuUni6SbLawc_sEMUWGGel7Zb2oQtW3qU_lAGt66KaRIrl2gM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK54H0GofCKx8dX9Uo3ncLVcSXOtYVJZB7GlzYgDthAvw&oe=6ABD0693"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgEnzfxS5h4Q7kNvwE73jMW&_nc_oc=AdrlAuqBfQFimlNbKlSpeNvJkmUdAzpm0_Rp5bEdg8Qxdyov1DGR6kVGX43dqcChLzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv-J8m0jVCF5zp_P76BNqwyn2K9M5D4DYXwM2xoN2sOA&oe=6ABD11AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MK3y7Fr_ARwQ7kNvwFeFPjf&_nc_oc=AdrDFKZ0q8w8ZdaF380K825U0fHL-6UZCOrHRMaBiFo2cMw8bRQdkKUWeDifG6UPY8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILiy5iYzidI51BxJv42D6Kxq6Kth9OSiJrzQuZyKbKnQ&oe=6ABD1F2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBu1JW-UuoUQ7kNvwHK06uH&_nc_oc=AdoAi_0O1JVBNy91jXgZRjxOaJjOuLEEY6fAA_OStsCVZCNb4fPkugm6_IwH-yV7ysM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ4Iw3Dl9AUfKei2hFMRKLEy8wKqnwii7vVJOvm4az0w&oe=6A79E5C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QgcXAm_tO4Q7kNvwHeuR1i&_nc_oc=AdpdY5uHl1kTkz1F8ULjmnP0h3u6LEqXEDmyeCXg9gDS1Efozhv-3jSCVwYkOO23c2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbcU5IrJjNz94jLP8hBNirwXNClTzdT_bxOlAVLOrqHQ&oe=6A79C588"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28H4ZA-hc_gQ7kNvwGaReYm&_nc_oc=Adr7zU857IYfMYg8AbMJdovBFI-IqNvdWk8Kcrtx_GD9-3u4cjDvsz2_2hVa3kLMFh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPlljteBy__fBLZdKkUdqUVrRg3BZ6ZO_D5WyTXsUoBw&oe=6A79CA13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lhjn5jDAJ2YQ7kNvwFOk3hA&_nc_oc=Adp1wfCXY8WkfIgJ7xXC5-6RVNNruhrWm8F7CwOhYeLKOy4lvbNX8529SK9lPJ1v4_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMBZmevdhHeF_qyfdb1UO2WpL5Dz_e37OfDVtp-oovUw&oe=6A79D52B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFEM6oWqvLYQ7kNvwFHrofc&_nc_oc=AdpJEG8gqXJuj_KXA0LCu1OrpuXobRqip5FkeedZCiuxSxuwtrUV2qh-2Wfd0U2xeXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRyIJbVfeaIz9jL3FC-6Gy19KN8YF_VxmR_SHX9Zp1jw&oe=6A79E2AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
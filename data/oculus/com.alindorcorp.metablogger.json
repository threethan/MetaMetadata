ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqs06VGNlokQ7kNvwH7_Iay&_nc_oc=AdplcS3xi9aOIjaEtnmbMi10OrmQVjD0Frpbf11lZjkm34U6P1AGyPz0WeCd47DIO6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zqD1dsrJLEmHGkHCqUV-xBUl3zhXFDXijzKRYfzekgw&oe=6A3E9244"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ceb36WCP4xUQ7kNvwHBnsI4&_nc_oc=Adp4DSKiANuGkcxt0yclzFJCPpeJqx5qXxz2LnAIipHjjjreL63oO5oEyEDrALHj6GM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Na1xgttg4_0e7Md14q7zEhLFqkN4SdQhZcC4htfklIA&oe=6A3EAA48"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWl2VNQlnMYQ7kNvwGcxIGt&_nc_oc=Adq4gwNaxmkNDUljRG-28iAV1V9cXNPcIxrKcb5mTyrVvDrQ--QgzXGns_L4XtmSTc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U4LeQ6rCeI_xz58EHmSl6a3HeQW1AhP1tOty4fN_bpA&oe=6A3EAED3"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20j28kq7mG0Q7kNvwG6lrZu&_nc_oc=AdoDPb5Yu1vPcoEShQWSKQAORxnxDs_RlYCnd5QUdVq7u7ON8ApQZtFvipOkCrNIn84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zy11X1azSfQfQ7y4qnojypfoa3KHjrjOMvilQyNBW5A&oe=6A3E81AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPfsdDsxaqsQ7kNvwHyh0rh&_nc_oc=AdrF5LNwPObSWxKbafAZzwmvVVe72WCM6VhfQOdi5tWPkAEtWwnMrCFolzimKWVGjxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xa6sRqwZZdPHtEeZfBJNp07iXES-LBOv_MQVB7xtdZw&oe=6A3E8F2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
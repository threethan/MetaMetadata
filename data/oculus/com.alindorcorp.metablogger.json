LaBXlOMKOkYauORbbwyKcLWgpyvyaxEL6G8UGODO4mV2jWEnjfsBn106TNqVRB20&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FAIg3TQ9PfnUnElFb6HQvCebucQ3D1T63Zd0M8T4MSQ&oe=6A22E2C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCy7U6uj5wYQ7kNvwGI9FfA&_nc_oc=AdreQGvWasDZyIqsXhGrau8NvZbbvfywOmxlO862flvcvIzBcrzZ-TtLzZNCYYTCYO4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iBprPVzroTFGvoyC_zDtOXGT6r9FGEeVhUA-NwMBF2g&oe=6A22FAC8"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UtRhlG2hDQQ7kNvwFteA6T&_nc_oc=AdqSh1CpRJK5uNTzQNfJi3ZdcqmAkMoDlMthJ-x8cvGueL6OxLIEYUhUgL_GheQVOEM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cj7LG0BsDdiujdGZV69-g_6kTeZcWcc_asb9xbJNUBQ&oe=6A22C713"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo-PwZbghNgQ7kNvwEdG3Hr&_nc_oc=AdrKc0anks3yOd10vpUt7CrHroF9KD8LlpS-HIX_2Cdz8BxViCCNenZCBtKvH1r5Ahg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9KNuwcWL79jv-6F_SrOZUbMUWPjF-Wsj9juJLvVtbw&oe=6A22D22B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mjirsFlDfMQ7kNvwEaIfe2&_nc_oc=AdqzqoBly0FZQrsVX3di5r2X682to7Gz8c0VH-i4k1rVnWzRwPV1-0gbX0wZFhmJiXc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mo9sTL-bAGNkEYJXmP48HeQPgdZxh_ti1ydllUfzg3Q&oe=6A22DFAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
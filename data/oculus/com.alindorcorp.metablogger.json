ps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8U7TDl7vmsQ7kNvwGlaBTD&_nc_oc=AdpvOfgEnsPU4lCEwJBt96XsAANPSlRn9T0cMz7Xcy5aZWfOaJtaYtuXmR7A54_cIqQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L5xYN0aT6D9xQHgOPx4fTPCcgVFrkQ8UN1So3MZg1xQ&oe=6A0C7944"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV7jGY16jT0Q7kNvwHsfKFF&_nc_oc=AdqHjmj9feqPMd-z_H0o1odFl1rw9RUw-EPd0a7IKcjOxAzWfYBvRU84j2GsHwgSuiY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AV4g77FTFdab09r6b_ouGgSTLP91Homyyzw9nKc3AUQ&oe=6A0C5908"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujeZYzTjCbUQ7kNvwE7EP7F&_nc_oc=AdrpvuH9IvicAiGlIy6Geb00paWurnqA0CeqXn5jJjHX6j944Znfhy33_8O63ecwbGI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tOmi_CZZ9XOHOjM5k49ZhxRhQa8Khdd-bwdHfTEAGuQ&oe=6A0C5D93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1323J1dUh-cQ7kNvwHe8NIb&_nc_oc=AdqTJxJ3-MDj6do_uKGn9LjExLzqc7HHuTB9GbWw7mSLb06bILrLWHpADrIoVn3JN68&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FVCrKjINTzxIhQcoLCPUFDU1ccSs-SvDj-LfiX55FAw&oe=6A0C68AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_kbYLi5NaUQ7kNvwGd2SGW&_nc_oc=Adp49BXO42XAa79t1hsoHOC1In647XKGicmR0y19xwfEOkK-S3WUnhtRku4ssNE5TNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r6_hlAbKH4ySd_-bYnJuo6Cr78JWdRSL1uXlc7AVkmw&oe=6A0C762C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
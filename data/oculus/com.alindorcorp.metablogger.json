ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuwmYSInDFgQ7kNvwEqf9uP&_nc_oc=AdoNDIBCZBjTCSSlPxuzIIgSoCjyU2iZ-NRZ_67syP-CHRiMxKYAfFpblbyzSSpSddY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q6QWXZwhwNJXqgUSnrqKe7M_-WPKvAWa9Y8LzB20UaQ&oe=69D63384"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAgriRNiT44Q7kNvwEw2n9_&_nc_oc=AdqRX6DoQFcRGztM8gyZx6-Yg6XBIL30hB5uiTtqTK7nTM6xHA23QTz8V0SLBl9PUaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EUynlmSLcwMRfyaX9kQ90c8O0loXoWXQVgrmskPVGog&oe=69D64B88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDZbqCNoMiMQ7kNvwGG4fIP&_nc_oc=Adq69t-b9mLz7-X8TlHwdHIiho236vFXcNxXuCGSfJHWWB_kEF-qD4tH41cxyKI6x1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HJp6uUdEN82OU7hQgkBZziuumV7GKQcmNmoqhxd6gsQ&oe=69D65013"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrF9QEXpzVkQ7kNvwEHR4Me&_nc_oc=AdoBERR8Cjl-dKCohnIt7yx6XbR2LK5yMlFECt2v1JPx86Jyo0ilT_34UrNQDn3FW04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XyMlqhZaOkfRZeqHuXh0E9MQc0KelA0zN9vylG9y4ng&oe=69D65B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg88S-W-eW0Q7kNvwHJEdOq&_nc_oc=AdoAsglJG8ffuQXpFmBs69UYkmIZj4WkAplKh-ICsBeEIu9Sye-w1YH2SlMOT-AApR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fdYEpFUp_NOAt1vk3BY6f3N244B7m-1KLaQUDBzVXyw&oe=69D668AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
KOW30Lened1PJCHA5nA05WgWtZ1xmbFK6aREkzPV60EvIJxho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5hGdIirMAc0_vaQvOuHzzsHrhvhAL2CtsL7z98FqxeQ&oe=6AE20C44"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rWT2jrXymAQ7kNvwFB95qs&_nc_oc=Adp4VMT69JMflzkqRDukzdk4w_HYHM_O-hFRkWW6dc3hNd3jkaTjiFhCTrPv38INKHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrruOyI9RzLeAqJ-yX21AO2vLtUlE6FB72xFZbZj7v4g&oe=6AE1EC08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef0e8lKLSlUQ7kNvwGOAQj3&_nc_oc=AdoEy0524mbYp57C3ZggRjV5iqos6rq56xsov_k9J4uPLxpkfsJ4USto-3DaMRBUgl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqRcJUhnij27fEAJf3gK8aBr42lLp5Rrh0r5Qm6zrjUQ&oe=6AE1F093"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQXYnn5KYqUQ7kNvwHxLwwb&_nc_oc=AdpKPpU3mWixUTT44VQFoB9ZcJHxLDm90-sRLBuGi2S2Y7CfST7JkoDZXGRXhpiT27w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz3uz1wkoZNxaG-Xus8QmTZj_CVeuY8maGrBAmNofp8A&oe=6AE1FBAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX95ys_630kQ7kNvwGD4jsp&_nc_oc=AdpAITuPRYFJZKePMqLVFMPStrZxjAJMORd0G8hmHxzIWC0Rzx5WcoVlO16IxbJEwqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFQl5Q8cYq3sdJo3NIfEPYe4cStGZUQ8LUl-zuezSInw&oe=6AE2092C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CNBXaD1qooQ7kNvwGjbs-4&_nc_oc=AdoRczQ9FisZeQkE1ay8HjXbrW8dmcX1xgjzQ_ZZ108a6aCv5nZFixiv6TlZZY4uZLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh1eScd9XqgOfAeZIiYIblz5mmpVzgVAdakoHjp2avEg&oe=6A82E804"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQAo4WttXKUQ7kNvwE9wHYq&_nc_oc=Adqle-84lRaHStAEjLUZfRWNHsaH-NrF7sQ6fQ7Patd-IG4G45agJJR5D3ZOWDVAJ10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ6GmrWupPoPC2eYxBfG3tHgwsWyUM05lfuR2Ou7uQOQ&oe=6A830008"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyGy1l1D1wMQ7kNvwF2XDxY&_nc_oc=AdogCEw9rYLJGPr5Y62clr2v78MHgA_b_RtNJVvj0FrMHi4ba4jJQHTQLf3u2Z5AFc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv5EipZEQw_dc03DzqPkOuSK7AwgnoVk-RCwj4HdRm_A&oe=6A830493"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqOG-S1J4QQQ7kNvwGmuNVn&_nc_oc=AdqoSxvmJa_PHPCT8kmwyu9PaizoIGoulcRZe_SnDBdETVJ42szcLavlU-DbOkWlWiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZsK5Y62qL6JGJhrP27RL6geenr3P2UsWFyjdzItmPfw&oe=6A830FAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5amrBarW7HoQ7kNvwGoR8o2&_nc_oc=Adq6FPjAPhRzD6_BXXEymORFcW-AcTVbb8rw07ALVbfT2qKP4rLf_K-9gey2GLTj5Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0KgKH9KLHrktR9Led6Q_aOWngFdpzgB20jKEg3RsMbQ&oe=6A82E4EC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
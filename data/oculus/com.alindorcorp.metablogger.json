ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCJ3Cw5aphsQ7kNvwH25xmb&_nc_oc=AdoUIH3OzX-myTlmPe1Kzdyfc-ynaOullC21N_tUQYnFNWt5fxHEeQ32MJ1iO_-LMWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUfVoERQOSo6RFuSjYl3IgaG80mUzM0Zg1hf3xCb3goQ&oe=6AA6B8C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4xoQNG4XAIQ7kNvwHPoRGP&_nc_oc=AdooDHVWvgQmNC7Aaziy0YV3COti7xeGBszOpq_K5aB4i8xwd3mGKtC3uU89-NJXvGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbCJDB42lCBwDt9SQMls0ch2auvERrnC2YGeTtYpxlpQ&oe=6AA69888"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBAo7k6WN_QQ7kNvwHUuG1I&_nc_oc=AdrsTc4vkADCqi2tBIjsWlhmighbj43Z7N_0_NF8m9lo-92h2iUoUqgJZbRY03Q5Qo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdjwPtALKK2k382YUWO3a22b7wW2r_lg2V36rEsrIYfg&oe=6AA69D13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzR1bY9rGg0Q7kNvwFnTMDC&_nc_oc=AdoI48S5c0MXmf-xg2NxBZAwpEIKjdiDQLNor4yKSu4k0GYZHd4mMPNbdQhzsKaA_yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKow-IQrdn2dyg9f82X2DfTVQoFPbDEMPd7uuhuh4ejhQ&oe=6AA6A82B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZgK1GV7OKUQ7kNvwGMRb77&_nc_oc=AdqPQKGwltUGZEtk12aKWzrQ85pyBW6Af2j_919A4jq1vAAbH6foaOd_HbuoDMdmI68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJLPMrItWvXqzo3ot_QcHduUTBW6on1Jb7mMdMNKxMEg&oe=6AA6B5AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqs06VGNlokQ7kNvwF5yxH3&_nc_oc=Adq8titRMEAw8gj4YAjKn2UH01TuRZk_QfX9tUPCjWCmFGdbMQu265NccUXJfmrUFbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sB0WNMGPoaffzqPSE0EbWuMdGiVL6UX9WAxLMReiL2g&oe=6A3FE3C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2j8QEC_x40Q7kNvwF1sZmo&_nc_oc=AdqPowGYo7bxH7njqU9YMQYM21E3_3Vf1NbNwuuHXuNxzHy3fYvwtRZq0NUkHw7SG6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RKw8fd9g21AZJfBj1_vnAe3aQaF6B7DAemn8D45YW3w&oe=6A3FC388"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWl2VNQlnMYQ7kNvwGPC_WE&_nc_oc=Adpt0UeVI_TRZwp4zhcWOIowco0IIViDDvsFpXbmx5B3UHI0vhr0TaiYRbcN30Pb2HM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XWlZ21i3svL7OYTpcT__Xktbd0_pFunFm4Yxv33QR7w&oe=6A3FC813"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20j28kq7mG0Q7kNvwHsY_5F&_nc_oc=Ado0PZ5rhidvMkCqyZT0sXhcDFborH8m_TJOkzxvrxsMogs3JiqW78Yf_BbDmF1um6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VFjXXxULaE5JYbPBnGVQX-WnUmnjQqXVC1mhh7BOziA&oe=6A3FD32B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPfsdDsxaqsQ7kNvwFY2ShP&_nc_oc=Ado2FwiltJBwyQwMG12LflKJ-4G1nH212ULN5HS7snGGECIbQ4wRpmJ0b71CfwX8zNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oq11QLRiIaCtaCjsvAQ9phaMcCellQJYnfESkyz2Omg&oe=6A3FE0AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd1NlfccjXEQ7kNvwEec6DT&_nc_oc=AdplrxG1XYETf3Jt5lA7_f9fbSiu2H9NZQU1C2TR-LPw5tY-saKQzSSYA8q0AsynG-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW57Cjx4MKPPnKMqSm40SBwQIajuhH6QwVjieEi7zYUg&oe=69C3BE84"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dYaYnPCg-MQ7kNvwFDxKpc&_nc_oc=AdqDetw7S-TFLTmkND9BgFcOD1-9u15OQVb7C7Ihqi9vazded4bTmLwZAvud0xl5S6M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQNq2ZmRgVIs1IfqqCSsHbw4yd9ZukmBcrmITX9xNRHg&oe=69C3D688"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epckxQxF-SwQ7kNvwHVT2DA&_nc_oc=AdoljtJzQ7vY0oA4LpfIzaZPBAcvhe8L9obSVYl2R2F4XTFejyQZokKOqTyE4Z0bqdQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_mdDfMWJhMF_U3TxJJyfCeD1Shcl4B_q7PKKkhL3R9w&oe=69C3DB13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzpsaRbbvtMQ7kNvwGAwxHG&_nc_oc=Ado13xnJjjDz9Le_aa8PkfTsxq79QVhzadYFEifC_jGJvhDIkHPmKuZPtbgwUo4CLNs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYSEL3u-HpiEotxwzyNh9ZD19Ld4zND_AEeFnqK7kvbA&oe=69C3E62B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKTVWqkjiWUQ7kNvwHvKMgN&_nc_oc=AdoVDcFamE3E-QByZUoCWCclzlf1vOOcA1BLvrfdQrbTBDg09MPBOC0IYtvz3FeTUHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycKRcqaWtEZ08FiDbg54ZjLe8D7HNiBAuRnFfxUBlMuA&oe=69C3F3AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5EofeEj8f8Q7kNvwGUs_jF&_nc_oc=Adrz9uVC14L5jXNggJsYtVvA80-0XRtKza5JsLRl1FJzAkT48Da9XDiCy4DAxtGTRDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIes1D3chorYkw4Dj4pvqJ5fBX1maYyVRoAEctYX9zAKA&oe=6ABA7F44"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tVy5jiFGAgQ7kNvwFimrZ2&_nc_oc=AdrrMipJtofhqd0MKMETkmVZrHYk9JMkp2Z26ZhOU6Mc8YCV7w6fqEjtS4cUUwGeT4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK963Prd4tzGuOco2NDn_3DedwEzlkqZ1L0ST5-8PiM7Q&oe=6ABA5F08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJR2Z_62stwQ7kNvwEoo-wv&_nc_oc=Adpli_VpCTy9dOSXAQwzEMRhMk8Is03bLwUVgIt5MNGZgK0tw50EMBNJ9woF_-LHxKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNjgArBxlOXbjnE9QLxAojlp3_WJPTO-_d9gbyMPzyFQ&oe=6ABA6393"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz1IDQ9ObYUQ7kNvwEtMI8L&_nc_oc=Ado2aqRHbPgWX_wwAdUxPSqyZSyUzjGtQyZ7HVuo57YsCX4vAWm0Skbdd8NQdI8j81U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp2D5xHsqod93WVkvkgE7y9kI47XxFesEocWMdVBN49Q&oe=6ABA6EAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPlP5xQRZqkQ7kNvwEn69Jk&_nc_oc=AdrpNARqohLVkBLkOa3Lpz6lU9PJxyiKa-sHgv8bDrfnwDKa1W289ykkgS8NQfyyxL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU_8cOubjnSVNADj843UkNFF7-Ufuwzpe9_Vojad2pqQ&oe=6ABA7C2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
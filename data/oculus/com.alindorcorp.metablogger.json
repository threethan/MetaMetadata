ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSxhCvVeyKIQ7kNvwFb5J82&_nc_oc=AdpH9vaanVdEIKuEJn6jVdZARH6dL7UDnm_z-Xbf-oKl6mM-rmERt1B0EKpfz3AqFNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qio6ZV3TTcSo0tCVBEHgUFvkK5COH_TOTsTzPhJBfDQ&oe=6A203FC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCy7U6uj5wYQ7kNvwEgnpFD&_nc_oc=AdrrxZqaZU0h34ZQ7w-DPDFtEq5tpUnjMeian1TDl9Ed8pYhBB4M2KC7LaGtG3digiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74E6ijkFnfP2xWrb-Pe6e9qafZA0fIQzCesLp32jdcaQ&oe=6A201F88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjNqKTXjMz0Q7kNvwHg5R6A&_nc_oc=Adq0ZArCQoFki3mAZqnJsog9ufL2Pkf6X0C8d8ofZTkvz3GpjJHQYF6JqnkoYEnKHj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sWVvW_0ufXQnZoCuQrQ6ZxMzykAo08hqRzWn7o95UmA&oe=6A202413"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKP9m-4oyDQQ7kNvwFI_KdY&_nc_oc=AdrqR9VhY1h7jApAgrKL9DJ3P5dt4b_iIs3zyWEg3D_oiP3YjQsa0IQFudCQ11vuvkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uK-YLxvJWiU7FvtU-43DpsrRD-JZmm-Soe9ZRnM03mg&oe=6A202F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8CPlBCchmoQ7kNvwGMYl1O&_nc_oc=AdrH6CT3viYXDtWG-mXet48uxz9J3sLFupM5TmZB57POz1Ta4R-J4uMhu68gVYLOgFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fUHARQuhy_TPVMBxSKz128HxT1yFyxfYXhoR7gORZsw&oe=6A203CAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
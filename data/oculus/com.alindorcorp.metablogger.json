c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8WYH45MhFkQ7kNvwGRD2QT&_nc_oc=AdkvRbCfjdy3Ts5lhobpK0t6Au7xAKPmI3Uf-0QDqTwaquuvACDDQBKADtcJrSknWnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTgUzoPd1FOHoMNL64JLceilb-WLTGOFgpGrPDiTiaiA&oe=69A452C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT0R7AdEsE8Q7kNvwHCTcer&_nc_oc=Adla7KeQ09TtVGrJvHMtmdtG3kmGUwnzZjrMJIzfHW1pXdaJM2KIwnIrnBIiw5NQhBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afte39_3KzKqMKDijtcZU5SE8K6uqftgl9db52E6s84kAw&oe=69A43288"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T69YgtlTXXcQ7kNvwH3yCFB&_nc_oc=AdmFYv8MNSy_a4nbp-r9DNRMZeytAx78aj1RvHESFskBSuvpniZKixxMC3OzIR1VeFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftDJdsqopBuzyvmi9GYsT-YsCS53brO9o1ydYnxGhXYtw&oe=69A43713"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7DG8JfHXuQQ7kNvwFFxxyv&_nc_oc=AdnGwFdSHrMUEHbbbC8X5upWWW8nSFNrWhfvS3WE5q2Ux0t8FhuqZn3junnhQGRzpLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsxXvFsLrlHGVUsmJUGwaLX4-d8npRYV6mtDEMRB3dD-A&oe=69A4422B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSdgwisoMzwQ7kNvwHFacvO&_nc_oc=Adk6mQEQMsgnFD-JelS1wJxgP-4Dv62YgO_-d5jDov0wj_RbUUY3Dp_z5umc1UBPqUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujsVpk7b3AlyzKh684PIeOEv1zUcmZJs_NeV_n-Ql0gA&oe=69A44FAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
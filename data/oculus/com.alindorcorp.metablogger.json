ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh-6-zA_QtkQ7kNvwGlbgnM&_nc_oc=AdqHcWRJbgNSZpo7W0p1KKxrqyV0QiAq-A5o2-8utbK-N2pvU52vi1z_WmcIp57Bkfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8CD1o0j9EDoSy-mCxbxPirQH5AALtQL1fCA_I48YYGg&oe=6AB144C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIbbDVXJdz4Q7kNvwH2jZol&_nc_oc=Adrp7tDyXQ9at_Lv21EwQPWX_ot9WnWbt9N6LMq2uwt9ef3QYNdoVw3XI33APOn26Uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ963P2LIqNmubiqbjHii_A-7xZSctjUjocjmpZhyu0RQ&oe=6AB12488"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFj-zfHvvboQ7kNvwFgpBqg&_nc_oc=AdpVK-FSSMxCfKqAMZDJfni8V1Nlic2Emb_lQ8B0OFKRbb5nXzA8cLEtYrQ6hyqqu0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFx9T2x3qf1oQ022ALoa6Hrrgt_zZZRmgpnmLgg06AaQ&oe=6AB12913"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i16oyAIb_BsQ7kNvwHPDGGU&_nc_oc=AdqaxsiyG8M3l-dEsXPrkZG8DgtBbk9C6m1TO7piBJnK_GK_Oy-ustyLjQ-5gbZqq8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHQzkkAzKvnpDiKsQdPKMPhAIuygZ65fQh0VwkduXU0A&oe=6AB1342B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69jmwtVMjiwQ7kNvwFteCtW&_nc_oc=AdrZByUwIwOr1OqCcEWwORdPy1GpWDtYatM2-nquBgL1OPNGkk3P1LnhCSEPIWUJ20Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImP4SHxtMRRPMIJ1_ksAV7HEKnTkuNeGXanv07zk6OWQ&oe=6AB141AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8WYH45MhFkQ7kNvwGNxYe9&_nc_oc=AdnIRt-cXw0EpIwRYFqsqZp_4HcP6JaLqxhK8pTJb_OVVuH-ShpB08aSyLczeskxxTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu6LBOphYlaNmEwiMApjxw2mZC3OcTfS2I_hQEX61FT7A&oe=69A56C04"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q62ukoJeNMYQ7kNvwGUU6L7&_nc_oc=Adm0bBksWIA_5Cl-PsQvf1ja_GKJ4w8tj_s8sOtiyHIvCk9OFuH8dvvTg2XM51O0u1U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv0A4xoCeU9ezcv2pmnP4SumrUShRXrMvsdRmXn-Qfi1A&oe=69A58408"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T69YgtlTXXcQ7kNvwEBkbYS&_nc_oc=Adm761XFQaqN4oC8wmlAUQxvgIfWH2kDD-4vfvCwTkBRuCd6obB7iON1rA-YZx_7Tc8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv1tgCE4ZRicPJbbLtd0mZefsG8AZHS01EgPo9WUoZo9Q&oe=69A58893"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7DG8JfHXuQQ7kNvwGKm0It&_nc_oc=AdlyR8veY7CWy3JnoAghdh4vU6eH-OtZ56JWBWtMqrRuQpxzmQU9kQlaNFCU6T5-bs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftzpkYX4s9Uffw1BKkkp7f1oq-OdY4f9DJTJjUill-UQw&oe=69A593AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSdgwisoMzwQ7kNvwGxVQHK&_nc_oc=Adn_SSAOFXYk4ZP59Bnr_D9l-t6qNxHTb6e-iALeHV9u648suGV1Vp4bgKqdRASCr6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftcn2cmjCOP_fy7VDoeWcMmHhIQ_7HqkHlc_m9r0QS_Hw&oe=69A5A12C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
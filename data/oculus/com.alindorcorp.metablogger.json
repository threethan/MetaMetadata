Sx4RobTO3wTG-GH82hOZjp9qUfCkUDlZUnkWtvIn9ftdH0RmA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFMDVAM01xcHmAgSuDQ6qDc3zLZCi6jnYJuqDa9Se3fA&oe=6A4E6444"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDZm93I7iFMQ7kNvwGvWiJQ&_nc_oc=Adq1hJqU4iHDW730tCO7OVHCiiskU68Rm_SfrEcY7wKRXnBk19dyyDTAD89EXzhCxWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjkLfHJi4b9mo1VZ9BiH9zVCZvNSsm_yH9F72H1Hae3g&oe=6A4E4408"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RppFbwuAmToQ7kNvwEtgLAN&_nc_oc=AdrduqJGWEMelQVfNmIrMugk346lnyozMjHvgzxJM2hFk8EAchvMW8JDEWaamV4zV_s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzEroLq1QG8UQS-gP_9u6XRUMe0a19jQbRcySL7iQuXw&oe=6A4E4893"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tZnXdhexg4Q7kNvwElu1qb&_nc_oc=AdoCNv3Gah7ZXefbWCnj8fXZgFYWIyUaui0spotPKyWg1_a3i93qyt8a1JdjWkJUdH0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXkhwkfqyS0kinBGn7FaFHLkhKOuP5CFGTdvYH0DBcQQ&oe=6A4E53AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCR1-9hOOVwQ7kNvwHUNGej&_nc_oc=AdoHDbhWI0STHTZAoF6WM-fbGLxprGvYifgYUEwZ8dtwVMtrSdlTMKIcB1sJ-6GbVWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtPFEy_wPlxQQ5_TnkimdSrMnCnqekw0O-4BuwcOo2Cw&oe=6A4E612C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
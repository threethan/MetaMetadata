=AdqqgmG8mjcrcHUqeTg4kraWeiqbd4IhLXxgo4B0SdTC-mGh_6tf25ZFLrHJAjeiano&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkpPOikOPT93CZUP4HLzfd2kYrMsecrnC0bHFyC5_4ng&oe=6A8EC584"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJOKGUwXrasQ7kNvwENUhJP&_nc_oc=Adp_x9juqvuufG_-kvhdmOMeE4V-aNvgRPvobb-Xac7bu5IZUoQuuQH9TnkA47BUWWM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7eYdsLmKKsEC64DMsaDwoW6-9PSJSOQafAWte4YlW7g&oe=6A8EDD88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JETP58e-9zQQ7kNvwHKXmFJ&_nc_oc=AdqsmU6B5s_JD0jfiIerew_eK2CukL8PYhC8F4lDgwsfbSOp_q0dBQreC4Y6WaHfbjs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMZpyT7MxegKNPXFeyAXjPiIov_PbzSbV8VktL3Lzk6g&oe=6A8EE213"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4KY32GipCgQ7kNvwEphbEF&_nc_oc=AdrFdjKfCRrZDywxhlWIws6TrKWJLF2hcBxyXMNLg0JpEnHQ7rglHsWLJJ9QTbPWMO8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvh-vi-AlGTPFTWVHBL3T92IVYsf5F6gmVVGPXHyN6dQ&oe=6A8EED2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEENezjWjN4Q7kNvwGqMBHv&_nc_oc=AdpElmk1-FCqgHAAtpqjyaobsdBO_hj32bl3Xg3g-UgceEKBM3N7YHk552WT_JJrOUs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL6v1TI1vPS7xZ2-VP3HpPJbQA7aDCjujVOTIguGdIsA&oe=6A8EFAAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
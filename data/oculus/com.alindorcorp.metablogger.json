cdn.com&_nc_ss=8&oh=00_AfvtFgwUqyD1gvV-AfjqnBNx4yasvaLswNSv_hQ6Jv2pQg&oe=69A80F04"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q62ukoJeNMYQ7kNvwHl3DyA&_nc_oc=AdkKgawpHT_APssAPaZHEeR_eqk4axPouB_lf7cLCUXy5UHxiDdeRnd2NAKZzObjwZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPTeANIX-O7LJCRDWbsIYb1UCgb9DcJ-DjbjJOpQjMAA&oe=69A82708"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu1sKzSGOD4Q7kNvwFvTRkF&_nc_oc=AdmheWuag0kuJZvCCK9YTK02WlXGnrlNZ2isM47to-Lr_Xg7LC7AP5of8OHM5a29_jg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftmcbGR8m_hE7ukiQUTdeQ0Suv67Jy8osFXf8bRdESvKw&oe=69A82B93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukp47VnTn1YQ7kNvwEogRGV&_nc_oc=Adn7UjdRQzB2jLlKcwdFk7HTjlxZgRzuHr9TA3M3_Iwe4e3Ut2ntuFDEL_oWQwjiVmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMCE35MivQw5Fekw7vmmZzMag6p52y-jFUnwcfsPwInQ&oe=69A836AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCXGhvler8MQ7kNvwEz2XEQ&_nc_oc=AdlwdI36I08v1e7Yehv5yBwj1YHXY474grY1lpWwN2cLPchsFlqpRFKmGgqN1Wf4jrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGesNuUqP4ji_wBKQUL-ZrRwtDK-uS4JD40ccFnAWwUw&oe=69A80BEC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
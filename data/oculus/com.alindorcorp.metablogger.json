ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvyMbpZHkwAQ7kNvwHtLTSk&_nc_oc=AdpZiT5cANth8cUNAvUJC9sY2NwyFHhOJsOD6BqR0aWlE-HvzpUBN26Be9xSL8FLk2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4QqMyAugfnZSxUcDlJ1AjwuFuFfMIMDFFYtfSCy473A&oe=6A4FB5C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMn-_HAbDLwQ7kNvwFvRyuH&_nc_oc=AdpKECQTX47ezLSJefIwIzQc4sBEiLQKXa8WitxoB1Fs6wwcsxqe7zSSTE0XA3hV_a8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvMzz8JLXQHvVcr5XzbDs3Hx5ad33zVV5BTYIgOec_zw&oe=6A4F9588"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RppFbwuAmToQ7kNvwEY48-9&_nc_oc=AdqFHb83VDaox-5S25MYhfwMI0e1YmOci8hPTNnu5UtTVvkswyWN-0it1O_4l704ZE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBon-M9Q0W6vXHW9DMASMz7FUj5upYYIkN4U7lXal9Dzw&oe=6A4F9A13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tZnXdhexg4Q7kNvwGkzLew&_nc_oc=AdotaIAc3PUHUOYY-yGopqE3SWcRtpCFCxaPOQ6Mye3KvsxCNU17BMavgyr1EBerlIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCHT-AnpDjm2QTeoOGgGz8KQRyEVPDP2iVK41OHt8yjA&oe=6A4FA52B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCR1-9hOOVwQ7kNvwHeaZE3&_nc_oc=AdpxArcrtoLIUbmmRsRQCJFlFOebSCCwhTrM6MJGiUa4HhRjHugwHBdnULXIWe4_Nlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU0-AYtCV9m6G5oXfwHjY0wgT7dr9Bw52l9iGQV-L8TQ&oe=6A4FB2AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
QW0tWafS9iomp2LtZgPJMWUEarTnugMfETkzHL7bYZ2PQCKGeug88tRcdRt8KCWg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxcxJXjwe7Bi_9aSB5Pz3N6_QtcExA_yRk591UiSIyfQ&oe=6AA95BC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4xoQNG4XAIQ7kNvwG8_rlv&_nc_oc=AdrDmThXWHIvwDJaRLVATrw3jedV2gPjDYqv4evPuSaPB0o786vnHc2s_6KuanJs2SY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp3-3JHnnnyI1lfynoXm7ntor6Nq9lZCuWoGp6VelS5g&oe=6AA93B88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GNjSMiDki8Q7kNvwHLcfNH&_nc_oc=AdrkF3W6alt5zRDYjdTGNzCPubx-aY1wVXxiFtpBpXyZgkvaoDnmja8KIzviopafEvw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_alHpexYaoUc2nYrBmXlcuEO2PO8AwlkSut2lM4TNmQ&oe=6AA94013"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRXzRWalniwQ7kNvwHi2TYH&_nc_oc=AdpshjxhfbZ_wDOPMTq1AMNPqaCdrzbgRgDrPaRqucbkrDQTCdhOgJXGUATOmuRKrDo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPu9aLMoUOFKINdUUKIAQHQJYOOF-g2s5eSpU5bfwygw&oe=6AA94B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGZlMDrgCMQ7kNvwERt-_9&_nc_oc=AdplV5xx4gf0Zgw-RYTayYN6CZl2HZF27yRn4gIHZnmzOvlVxbXIS2PSFobUpLhZKyo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0t5PJNjHUW0v9D5_Uw6_rKlN2BoWdw0J1mM54r2c27A&oe=6AA958AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
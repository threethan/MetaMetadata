ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMhzBF4IAOIQ7kNvwEaqpFP&_nc_oc=AdresSHFe7ndhsrjy5lIMQPjJ4NchUTXYLviSC1qpiYxw1oBuVEYwdgtgR-Pm-RXOR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-FE__e48mm0jb2zGZFwzqf5xeJ3wYbPK4Q3gvTNg_fw&oe=6AE9F544"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXZpBY5phyEQ7kNvwEcSHwP&_nc_oc=AdqLFzru2g3Sa9zSXiIl3hJafGE5tml41ToU2VhsxXmGPlWDYVKk6eSJA2j7X5msF8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-1qxbe01c5vZKZjasRqNQDv1EalUzWTw1AwEv-WBKSA&oe=6AEA0D48"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUo-wspml1oQ7kNvwGoofn6&_nc_oc=AdrZ-fQCV9za4Mleayy3Wl7ebaFyKLbpqeqkc3C7iBpAdd4uNyab6rr6hXhgQ0vmwzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ19ntMucwFxYPN0Y5EtjJTDBN4r-i8BEVaToB0lbS3UA&oe=6AEA11D3"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2XA_zYWNfAQ7kNvwG9BIA8&_nc_oc=AdrUD7zRXRmUD89kRyxxbkqab2cHG6osrKC87DGbuZwFbT2wLF7s1JUbfGQOyGmYef4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9YkB76yZbmMUB-WVCxKgcSJNgcGrlboN6aoNjcX7tyw&oe=6AE9E4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eYTgp9kTD0Q7kNvwF5V79N&_nc_oc=Adpl6ieatUkCclQHvissMxjZZ2UjO8kDkExGgLb6TYFnSdDRfByRDV4VvD3hIifqfzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbERPocrBCaXKCIANV-5JCPaCFrO9UYYvkIX8tiBkgGg&oe=6AE9F22C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
=Adq0VPM4ZeZqlBZthw9y5s1YVZSZPjnUvIriGsqdPIGTYgVUxDaomiHfXwMopuyUePw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3222_wZGcNwWnkjfH5bDS_D_dx28X8NDTE9kouaMX6g&oe=6A8D7404"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUG6nilqCiEQ7kNvwGnE0iJ&_nc_oc=AdrGsECOpi_TaRGiRLbg5_8Mr1Hy1mZY1iHnpSZ0NYxLnn2i606zAN1AucgpDlyv2SA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy8NI4VWxP7yMsuo29rD-tgztuNbWbT65-2m42pzpR6Q&oe=6A8D8C08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JETP58e-9zQQ7kNvwFmv2Ng&_nc_oc=AdoMWwmiQ8RWNCQIvCu23pz01aQBPxR_UN9Sm9m0w4hlgU4n_Xmh9Q9qR1B38C4-YG8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGs2Rx9wlKGaMNkCZorALIoiWlXda7Ip4mcq5XdGN0ug&oe=6A8D9093"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4KY32GipCgQ7kNvwENaoZX&_nc_oc=AdrvRDAvgrsbVyRWPnO8055Bj_3WGFI2qYRoeAe8aA8pHC8_SEc6gxj5mwzh6WcSFgI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR5EhSRgKkP4TeYUmyp0GCTtGgbUizoFwdrfDrv-lG3Q&oe=6A8D636B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEENezjWjN4Q7kNvwGDP7za&_nc_oc=Adq0v08Z27onK8nxfrv3rLRj8-Jx42mHKfwGRXu_nyuse4Jv2fB61wfEvmkB5U7YmLQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYrVtNNQm1RAlxYmNpsTPHh03pB15cbKXHHLNP9Gfu5Q&oe=6A8D70EC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
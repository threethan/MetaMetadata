c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8WYH45MhFkQ7kNvwEwmveR&_nc_oc=AdkvA5lvnI0C1MtaFaDVSg-3KBXtaCFnRtzCU7xzBhfOxmAwgsT4tVhjH0Zb5AB4pjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiSS2feuh7l658kUUXGpHT4ybeKtrY8odYHcgGokuWAA&oe=69A6BD84"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q62ukoJeNMYQ7kNvwFqRopx&_nc_oc=Adm43kZd8H_vFTRpnlCDVF11PK5833r6uT28lzOFduxxMN0X9YbYz-iTNKiTlWmmV2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNfwqe2HIZ3uaBjQLjirl0nrP5PMO_-0SL-FZ6OCS87A&oe=69A6D588"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu1sKzSGOD4Q7kNvwHANTcx&_nc_oc=Adn5hw8SUVwKeysFCTV9WwW1f2eJk91uKn-8_JwlatgREqsBrTU2OOz208lWXFOxVsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfT2THNJxhB1pc_LPKZ5ZF_QBhwRWEtk4jlTqI85GMZg&oe=69A6DA13"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukp47VnTn1YQ7kNvwF4ii8T&_nc_oc=AdlvqlVIHd4yC5RSQ2LjCzdC2_WO97xrwC5DcmeLeSbUi4fCZdPa1SHUD2sx_Qv8QVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs15bfM2E7CMOOJmmsZ4SphvAtJF0-tAt4hw2-MDgt41g&oe=69A6E52B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCXGhvler8MQ7kNvwEhjhQ6&_nc_oc=AdkMzYRsUeUBjyQEkEQqmGOWrwSYE8QAxZLB1wL8I_NXhjztpTZFU-h74odF-IaYMug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvZv0FbBNnqkclBBMwjcUPx-CGtKlr46MyPQhTvn_SBw&oe=69A6F2AC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
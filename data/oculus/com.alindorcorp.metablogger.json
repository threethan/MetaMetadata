ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtaP1wauhtAQ7kNvwHoqvtO&_nc_oc=AdrsGKUWJDC2_2B7AVNwR1jEYbs9nitY4iPIVexuEJShL9HxYXJcwBts_tYLqFp2T3k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34yeezhrW_u1wjeerhQtdM8E0QWflHK8vwj_VAv1DTlg&oe=69D90EC4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHDQzKfEIAEQ7kNvwFuE2qV&_nc_oc=AdpqJ5QTrFsFM56-oN2anRA39DTBjY9aw24aEtvErsP31BxUkqs2l4N1AH1JQnvDXJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MfZLVIjxvoadB2A22AXOOZkkqTF6IUaL_UvLE_FQ59A&oe=69D8EE88"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDZbqCNoMiMQ7kNvwGvwGVB&_nc_oc=AdrWhMnhQHpJSYUFVfjodvC1JvH2cPvk1QzfOi1WwrD6Dj0U_eyW1OJECBAWSntNS4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EednuKu3u1mtNl7eWs2kCcvf2Qtfz6HcQdcNBoiQh2A&oe=69D8F313"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrF9QEXpzVkQ7kNvwGjp2aO&_nc_oc=AdrmuXH8FnrkBxVol52c9W8AzjHibFiWzNphKyP8HFx6MsUfuS82MsyUkxRDezJ-aTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Pmo7EIsCBseIh3wvfhz25-yq5hgM1H0sR4y_1yaLU0g&oe=69D8FE2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg88S-W-eW0Q7kNvwHCz94V&_nc_oc=AdoFzVFLvxEfiVkC4rsRPMBPB11JJPVpKcZOZWyEozgPergN6vNEE-HIMxgaxp8g1Nc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UYGMpznImOQrDcKa1f5hX4cG5_ZCX6Etw-3jGxnPR6g&oe=69D90BAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
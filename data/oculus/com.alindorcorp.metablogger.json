ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgcLyYYFW3YQ7kNvwHtW_m0&_nc_oc=AdpGvAvhV0y0bB2VbiUoXJTEcrmgxPCDFo95xD6GuwsNMNYXEmnijVf84YUDbawEG78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOZYX1b8-GKo3tEJ10vOrZkxFWR2yCoOw2P7KviggpRg&oe=69CE82C4"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPkiLBKco-4Q7kNvwFY5Elp&_nc_oc=AdpYs3vV4qerDTWGnouF6FmS1h8r44eAPvi539tn8Kj4XdXFhDNCwpo5neBNk0zQK8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaXp8ytgil22lnJy9aEMsLv4P1sQ5my1AA2i5OUFFccA&oe=69CE6288"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ctbdmjPIGcQ7kNvwH_Hrdg&_nc_oc=AdqkYqoCU1H7N_jvPBK6EAFnVUex9XN-BZytmgWgddu96E4WmGa1p6Un5u-NFFZ0XY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymyHsZBlPNfiRbJxAJ_DCQJoff1JUgt7g7ylx1XEUiVA&oe=69CE6713"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85hFcMiDHsYQ7kNvwHDsGn3&_nc_oc=AdpCtEyemdcwICyXEki7kSu055-3tpQCfiPX3hrWqDOzgofXtMeVLwVkqTmmb1D6_mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLkhGEK8iDS2REzUSXI6zcgHoRqNxoTwIWLFVXyBu-lQ&oe=69CE722B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WZmiUqPA3gQ7kNvwHcxSa1&_nc_oc=AdoF9PxqUQtd3eDshrAlKuz_JBTiu50lHrZ1kcTFKlJlMsULL_D90uq0UPJuw2fgvZE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP4c2a2QaBg_mT0vSAkl7SC4vvoYHm01FUnI0-_U-MMQ&oe=69CE7FAC"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCJ3Cw5aphsQ7kNvwE9s2MX&_nc_oc=Adq4EW7D-SmuzqJifFUiTlf-CTSCf6F7yiLcLMEWcZbhbR3zQ38bN_JIOEFiqBbC7Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMiqstqlJNDxt8tdHVKTnQgsvYMp3JcJ4ppsXUcZoIKw&oe=6AA56744"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEv4v4GfG1sQ7kNvwEaxe2Q&_nc_oc=Adr31tNQWYJzTejHG_FUC1ukakGvZ4pVUI0vvSvvEScNlQQBsNU6-9z3OaWbt1v8qxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPbyRe8SI5p5gxf1uUZ4S5aGL80rZmGGcOJOOB7f05pw&oe=6AA54708"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBAo7k6WN_QQ7kNvwG1cl7f&_nc_oc=Adp37xfLm7-WUEwIRf1G_a9ufzbyT3TMVeRwtqrldzM9t4pcYpjXuAxdij1urCZ2pBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz2fqlOiW8XJ2MNwGDmqa-Nh8Vb_s1tmE9r556BxjqsA&oe=6AA54B93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzR1bY9rGg0Q7kNvwH5oCz1&_nc_oc=Adp8Lldtok9E4f8qxygMR-tH9Ve_K3sQVmHPaKM9-uvlyYuHqY2Y_d5T6OICTjYmQ7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR5DtnuWvcQHgDgzVKQ_-5zIOtFbHBzBCO-oi5XI2JgQ&oe=6AA556AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZgK1GV7OKUQ7kNvwGI_0wa&_nc_oc=AdpyDcPI17W69qoOd8lxLy5c5HjhtQD1uER5E-ca7G8swnORPDpGwFW6qOnT7Ulh2SA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlfAn6iaAv8hS87CHhKfHR96yP4OL2M805OWKZlwbb2A&oe=6AA5642C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
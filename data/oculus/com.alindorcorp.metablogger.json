ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD_7KEF_Q7sQ7kNvwGgO8lh&_nc_oc=AdqjBkFBKvHPi8tnFyV2ow1vscMFwSTexaRrKGc4JL1d-phLW7z8pR9ZHIBYAJx70VQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OlO3XGpASM9N4HN7F3Hgu5VFS-cL3Aee_OBplrVO-pA&oe=69FA0444"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBpf-dVr3c0Q7kNvwHZ8D6R&_nc_oc=AdrizOx-S5My0FT-DpURXZ1HjXgJNGo0Swv9FIw2ZULbUgdOBu-NrascEXLVRi_IKFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lmbsnq7_uVwUiyvvwPgU-5t_x-h8PlieUn7xifP7OrA&oe=69F9E408"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGZIaND7oW0Q7kNvwF6w-eC&_nc_oc=AdqsQDke7mlvQ5Gy3ii4NhDKm3WdzHddl-3Qs41JM34nmGDW3OPV-sTtJZxcOG57ygo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lXVuPANwdFoVwWuIKnVU0PR2eTo8vJE2HLPaAfKjlcw&oe=69F9E893"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDJK7wc1Tz4Q7kNvwH6fUdw&_nc_oc=Adr4AvKaGZq0M7GANNmCYkfX_A-90USkoqRmzjGRLc3x-kDWm9I7cwqxrfRcnclL_2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af420HH75t8bTmkCbVyvNw1SYm3WK-NMWEZxHWDxp-fzgA&oe=69F9F3AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLZ1Np70dMwQ7kNvwHuM2Ec&_nc_oc=AdoFC8vZObrhvqy_p-SGp8EunOIaRRnrdib-49Vl2uNdQV8_73_I9Q5XccqY2jxwlnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s6MlIEonVDxh2o55wvJd8gY5dQLJnwWKv6AuzLDTLzQ&oe=69FA012C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391859_1518112312188611_1355305485291339783_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSxhCvVeyKIQ7kNvwFbGFj4&_nc_oc=AdrtgONddmgvLvtI8qHkqeWoexq7_-MDytlTEEoIonoFdbu_S1TrplncuyOc0NwRaSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bfFBl5m0QY8dqhkGN3WFt67S5PtkIa9O_7jp3cnxOSg&oe=6A1EEE44"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOTsExqX4_wQ7kNvwFwBrdc&_nc_oc=AdrnnjlGZtBduKpcwyMeLUojjPwwg86OLxxRMgJoOLHNCHEAPXkglRo4guk-vri0vjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Gu6-Y6J5CoiwoWfOabJlrAmz2Dphws622BKE5Jsjlg&oe=6A1ECE08"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjNqKTXjMz0Q7kNvwE1Llgv&_nc_oc=AdrrQhda5xxy_izEiwwpWpp_m--S-9IMhHRsHawgGYzZGCA8nrblTTk7iTD7fSNDKD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44GFdqGRrE4wmOvM0aNpKcjw_8qiQvcrxk_6aSSm2UKQ&oe=6A1ED293"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKP9m-4oyDQQ7kNvwGT2WxB&_nc_oc=AdryQKcxzUq1FrXPuid-T6jKVMzcdckwSEcKFQfCBevTojV6Xf5zDH5jI-jpbuUzKlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Mow59scw5PUbqiIZOXxEGHnSwpUKDLHoPKTrp0IMaA&oe=6A1EDDAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8CPlBCchmoQ7kNvwEI19Z3&_nc_oc=AdomgZ25wN8x5QThbiLq5gKf6PkuVohzN03UV6J5712RwTIpNKc6G4RSitDoPgNZVU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SBRMoLoOBQaDMJguAtq4LVdtRO2-_mhmN4puVjp6xcQ&oe=6A1EEB2C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"
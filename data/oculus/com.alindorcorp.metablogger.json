a0c_Wj07v5Ge6-l11jhAG39j2KNOTLg5WzCbYbcsEggiwbq7g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jbnxCEtqqk6F7jVIFTgO9-LBMuc66B5SXGNS4AX8M4Q&oe=6A09D644"}, {"file_name": "HighresScreenshot00040.png", "id": "628702753183188", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393195_628702759849854_3453678486927347405_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4rWVkbiXkkQ7kNvwHCkP2H&_nc_oc=Adod_lnpNUtYnVNkhpLbDuF3faE0Ji8qf6In_TzhwOD6LG8mWYTQBxTYPeHkwSnuUcw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af409QpxwOmaMOoTbm7lBexTUpROWPWuei2qNGgzkstTZw&oe=6A09B608"}, {"file_name": "HighresScreenshot00041.png", "id": "1127727558894208", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393558_1127727562227541_6305939956224130709_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujeZYzTjCbUQ7kNvwEu5lmh&_nc_oc=Adq3Hrs-6K4cSZQ-VrMs_AG6mpxhYmauJEw2PR0basCrI5S_my7cneCZ-Fb9CFH4DiE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Ccx_3SjXE6JzK34_OdiHumm6mSbAegWNw0mfHOPKLw&oe=6A09BA93"}, {"file_name": "HighresScreenshot00039.png", "id": "1139738020612460", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391739_1139738023945793_5280059691858437436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1323J1dUh-cQ7kNvwEVUPkn&_nc_oc=AdrOk0R_ZdVrVchRc1jyJWQd5b_8rxnwqE0f9an9wE0A3wETGm5mHjUPTki7N6e5WeE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vBC778ff8UiAwITTNzt3x0RTxG3kPEz7sj8suN4IPQA&oe=6A09C5AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (15).png", "id": "646952687853124", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393453_646952694519790_7054400811726926357_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_kbYLi5NaUQ7kNvwFh6ii9&_nc_oc=Ado1WWyw98Uf6QWc_mMqmHM9feurG3jhKIBXvkELK2T-YZ3KcLXC_mBGhtqLA6_oJnA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x43tv7GC0GtURuquIBe9_Lrg_jX12u3tpTDpw_M1xXg&oe=6A09D32C"}, "display_name": "MetaBlogger", "keywords": ["videoplatform", "blog", "blogger", "interactive"], "long_description": "Every day, millions of people watch online videos, but the experience is completely one-sided. You sit back, watch, and if you have a question, you can only hope for an answer buried in a sea of comments. The creators you follow dictate the pace, the topics, and the flow\u2014there\u2019s no way to engage in real-time.\n\nOn top of that, traditional content consumption is limited to flat, 2D screens. No matter how immersive the storytelling, you\u2019re still just an observer, not a participant.\n\nMetaBlogger VR revolutionizes content consumption by making it interactive, responsive, and fully immersive. Instead of passively watching a video, you step inside a VR-powered world where AI-driven metabloggers replace traditional human creators. These AI hosts are not just digital avatars\u2014they respond instantly to your questions, adapt to your interests, and engage with you in a way that no pre-recorded video ever could.", "short_description": "MetaBlogger lets you engage with AI-powered metabloggers in real time. Interrupt, ask questions, and get instant responses as you explore a new era of interactive media. \nKey Features:\n- AI-driven metabloggers instead of human creators\n - Real-time interaction\u2014ask questions anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
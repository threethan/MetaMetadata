5/12386401_150519782288828_8621626786309996544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sw_Kc-aIv8Q7kNvwHnKNRM&_nc_oc=Ado6f10cI5jfNEeXNZcZ3DpPE4p4_9GIT4rPufjILAeLosr6fC5-g6Cwy7Yow6O9KNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxFQ9-kiP-t4DEdeLM4lvmdAqxZoM6W-eFIQuu4cK5yg&oe=6A68B391"}, {"file_name": "migrated_image.png", "id": "209183670424965", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12331258_2299376763622129_3850969197735575552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjOyi5VoqhcQ7kNvwH0uIbP&_nc_oc=AdrN88dwpMBG7XXt7BishbK4ef403ZNNE99EtxUnA5JXdkHKqWxKFDS3dlZqh9rdk2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPzZ27m50DlYGNYsSs7Ri_ZspRXc_RXsWh7_7xmx5_kw&oe=6A68ABB2"}, {"file_name": "migrated_image.png", "id": "138018207646811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386220_165336207457965_7393072127391301632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU0TZeS8jbwQ7kNvwFoTWgL&_nc_oc=AdrvYklQoV7d08oaqRHQ7eKKpaBiKNmpNAmkG26yY5ekZN_X3esmK0iAdwe35cB5kIU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAF4StSvVpN3aiH1WGJLreDZ1cJkBgxL9IaQM5XPgWWA&oe=6A68AA8B"}, {"file_name": "migrated_image.png", "id": "688704755236468", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12448944_1582647781772034_2547836636494823424_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp4hh8vWL3YQ7kNvwFLpd1j&_nc_oc=Adr_1c78xZI9cZxND8xVtqQFedMctC5_k-RE4_lCrbcwYGhjO2QSs-C-Ym58CkDViBk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXOBMkYk0sqW8iZa93EDMhZk2XAvRya39bxd7aTLA7Eg&oe=6A68B730"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trains VR", "keywords": ["trains", "puzzle", "rail", "ride", "model"], "long_description": "Hop on the Puzzle Train with us!\n\nThe House of Fables has combined virtual reality with a childhood dream. We created a video game which offers you the chance to relive those innocent memories.\n\nTrains VR is a puzzle game that gives you the ultimate opportunity to find the best-fitting solution to railroad problems and relive your childhood:\n\n* Challenge yourself with 40 levels of logical puzzles that have multiple solutions.\n* Dive into a fantasy world of locomotives, train stations and magical stars that you will have to collect.\n* Become a master builder and the fastest conductor of all!\n\nBuild, Ride, Fail, Repeat and solve puzzles!", "short_description": "Hop on the Puzzle Train! Welcome to the fantasy world of railroads, locomotives, and stations where you can become both a constructor and a conductor. Relive your childhood dreams with 40 levels packed with logical puzzles and multiple solutions. \nBuild, Ride, Fail, Repeat, Succeed!"}, {"images": {"nodes": []}, "id": "511182213150760", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30c8\u30ec\u30fc\u30f3\uff36\uff32", "keywords": ["\u30c8\u30ec\u30fc\u30f3", "\u30d1\u30ba\u30eb", "\u30ec\u30fc\u30eb", "\u4e57\u8eca", "\u30e2\u30c7\u30eb"], "long_description": "\u5e7c\u3044\u9803\u306e\u5922\u306e\u9b45\u529b\u306f\u3001\u65b0\u6280\u8853\u306e\u304a\u304b\u3052\u3067\u518d\u4f53\u9a13\u3067\u304d\u307e\u3059\u3002\u30b6\u30fb\u30cf\u30a6\u30b9\u30fb\u30aa\u30d5\u30fb\u30d5\u30a1\u30d6\u30ec\u30b9\u306f\u305d\u306e\u5922\u306b\u57fa\u3065\u3044\u3066\u3001\u6a5f\u95a2\u8eca\u3068\u9244\u9053\u306e\u4e16\u754c\u3078\u5c0e\u3044\u3066\u3001\u72ec\u7279\u306a\u4f53\u9a13\u3092\u5dee\u3057\u4e0a\u3052\u308b\u305f\u3081\u306b\u30c8\u30ec\u30fc\u30f3VR\u3092\u5275\u308a\u51fa\u3057\u3066\u3044\u307e\u3059\u3002\n\u591a\u6570\u306e\u30d1\u30ba\u30eb\u306e\u4e00\u3064\u3092\u89e3\u6c7a\u3059\u308b\u305f\u3081\u3067\u3082\u3044\u3044\u3001\u697d\u3057\u307f\u3060\u3051\u306e\u305f\u3081\u3067\u3082\u3044\u3044\u3001\u81ea\u5206\u3067\u9020\u3063\u305f\u30af\u30ec\u30a4\u30b8\u30fc\u306a\u30eb\u30fc\u30c8\u306b\u6a5f\u95a2\u8eca\
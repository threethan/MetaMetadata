scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cw_W8J0U-XCGKV5irFli7aVglRSZIZ9wmpw2BpGybWA&oe=6A43E346"}, {"file_name": "2.png", "id": "1521654182249607", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1521654185582940_81568392664759228_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IInEZXGk7rcQ7kNvwFK1wMh&_nc_oc=Adp-rylfyTOVvx3R6HVleRnMoFMbIJ08aZAed8x3-HdBi5DHEz1pZTqhJ7deKzNUwwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--X6-KjtOPR9Sgwab-JMYwi4DVdhTkTNBDjTKbOfeXXA&oe=6A43C9C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0_Meta_Cover_1440P.png", "id": "1843966119658668", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_1843966122992001_2294568010826383451_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bcr4lS84F98Q7kNvwHSrjEw&_nc_oc=AdqVdhIA7f39oaovnuml_lW9c0U1_DVaL7rW0L1Ygl64oJ0kOLVEYtptoV8janxWdHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fbj9IiwHtr4j65uQedBgoFDM1ViaQbyVZd0HquIGFXA&oe=6A43D510"}, "display_name": "BitGym", "keywords": ["treadmill", "bike", "row", "immersive", "workout"], "long_description": "The world, from your cardio machine! Explore hundreds of locations with interactive pacing, stunning visuals and crisp audio for total immersion.\n\nTOTAL IMMERSION\n--------------------------\nCycle along the Perito Moreno glacier in Argentine Patagonia on your bike, virtually hike the Ubud Monkey Temple from your elliptical, jog under the Eiffel Tower on your treadmill or row through the Yakushima Anbo River from your erg. With over 210 land, road and water tours, and new releases each month, you\u2019ll always have somewhere new lose yourself in. \n\nWORLD CLASS COACHING\n-------------------------\nLet our guides take you on running, hiking and cycling adventures. Whether you are training for a marathon, endeavoring to lead your peloton, or just keeping a healthy lifestyle, our coaches will keep you moving. \n\nANYWHERE. ANYTIME.\n-------------------------\nZero setup and works on any bike, elliptical, treadmill, rowing machine, stepper, erg or other cardio machine. No special hardware required. All tours can be downloaded for offline use. ", "short_description": "Run, cycle or row the world from any treadmill, bike, trainer, elliptical or erg"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitgym.com/privacy/", "developer_terms_of_service_url": "https://www.bitgym.com/terms/", "publisher_name": "Active Theory, Inc.", "support_website_url": "https://support.bitgym.com/hc/en-us", "website_url": "https://www.bitgym.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25886646400948127"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_2970496579806316_2583319053666115740_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2dVxJXc_5EQ7kNvwHIDIXp&_nc_oc=AdpNW_tXOktGJ6m8N5459IttMepYXu-atVrh5K5i6p9SDTxwBm86N2MaqEXHCakUWPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86X9ogRGru0NyIui42wb8WLUR7YbsnRDa_djppkoGZfg&oe=6A43EBA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BitGym", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "c
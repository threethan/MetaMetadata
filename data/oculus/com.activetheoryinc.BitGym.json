2.oculuscdn.com&oh=00_Afv-w2O0K8MCfn-I-5X2dG9VYAT7s2x39Fep9g0Bday15w&oe=69A6D71A"}, {"file_name": "1.png", "id": "896981589487271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618252_896981592820604_3298539310528485085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll_a2iJzTCcQ7kNvwHZ8gFb&_nc_oc=AdkUFEmftIAsxAlsgvA5UWoGhcv9HcEhaDgAcIt1jQfikw-7Eqw-IbpedBCuv7Gu5b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv-j2UU1VBUJjOEYcXuYuZlwK086-KbP8fE-E2YaU5Ww&oe=69A6C886"}, {"file_name": "2.png", "id": "1521654182249607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_1521654185582940_81568392664759228_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYEdoEYtKbgQ7kNvwEeUOc1&_nc_oc=AdnTlzzz8eVoJGeHisnxOilYHjbQ_PmCu-NFi1ksINUw9VGdnqaspi8l1bl2zZgtwDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumjYjp4A2zQcmCaDvMRL3SK-rZOXnMQAWzMgAe33PwZQ&oe=69A6E748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0_Meta_Cover_1440P.png", "id": "1843966119658668", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1843966122992001_2294568010826383451_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S80cjTiqVBMQ7kNvwH3D0Bb&_nc_oc=Adno9TYpdO-2CaUpJjM62QNsNThBeBDeYInMQk08leLKO-X3SRNh-29K7oeHu3vq9fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1YbG_rzXfwkICDngAYTeSuk0Y64J-4GZI0hD9xeO7FA&oe=69A6F290"}, "display_name": "BitGym", "keywords": ["treadmill", "bike", "row", "immersive", "workout"], "long_description": "The world, from your cardio machine! Explore hundreds of locations with interactive pacing, stunning visuals and crisp audio for total immersion.\n\nTOTAL IMMERSION\n--------------------------\nCycle along the Perito Moreno glacier in Argentine Patagonia on your bike, virtually hike the Ubud Monkey Temple from your elliptical, jog under the Eiffel Tower on your treadmill or row through the Yakushima Anbo River from your erg. With over 210 land, road and water tours, and new releases each month, you\u2019ll always have somewhere new lose yourself in. \n\nWORLD CLASS COACHING\n-------------------------\nLet our guides take you on running, hiking and cycling adventures. Whether you are training for a marathon, endeavoring to lead your peloton, or just keeping a healthy lifestyle, our coaches will keep you moving. \n\nANYWHERE. ANYTIME.\n-------------------------\nZero setup and works on any bike, elliptical, treadmill, rowing machine, stepper, erg or other cardio machine. No special hardware required. All tours can be downloaded for offline use. ", "short_description": "Run, cycle or row the world from any treadmill, bike, trainer, elliptical or erg"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitgym.com/privacy/", "developer_terms_of_service_url": "https://www.bitgym.com/terms/", "publisher_name": "Active Theory, Inc.", "support_website_url": "https://support.bitgym.com/hc/en-us", "website_url": "https://www.bitgym.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25886646400948127"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1305782191560412"}]}, "baseline_offer": {"id": "1305782191560412"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770418920, "status": "PUBLISHED", "id": "1305782191560412"}]}, "liveChannel": {"nod
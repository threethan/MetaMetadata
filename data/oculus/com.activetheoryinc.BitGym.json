cdn.com/v/t64.5771-25/499618293_1230383529058371_1421670631690329512_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf_XeexWpcsQ7kNvwG3Cd45&_nc_oc=AdqmfIWYAOoJZFBMkL-0r06QgWfCuWEvdc2jCmBRmzp1TXuiQC_R1jBa1po-7JH1y34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Pm5WQsqRJxDORHpjXAoBg-0D8-dgKCVI6Juklx5WrXw&oe=69DB931A"}, {"file_name": "1.png", "id": "896981589487271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618252_896981592820604_3298539310528485085_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atGN1vlV_30Q7kNvwG2gy1s&_nc_oc=AdqgvMyaTaubcOulx8ir3R9GFp_SAV3WWqjbpzUEuY984Hm7TM3aOEwa0npmGFfuyy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O8YPcuI58kN4e-up-3-UZ8Xtwq_e9LuB68rBdk_v9QQ&oe=69DB8486"}, {"file_name": "2.png", "id": "1521654182249607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_1521654185582940_81568392664759228_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBzRYzAI_6MQ7kNvwEipg4G&_nc_oc=AdqEhwBpzGh77XZ-echCsgxjx3EPWP4Q5_eAHw7Sy2InkbcJTZc-IkSJHHIcDl6EXPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vhnm2QehHaCG9WwLeZC8qq-qqrD8nVbDZ_Nu1GI0g7g&oe=69DBA348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0_Meta_Cover_1440P.png", "id": "1843966119658668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1843966122992001_2294568010826383451_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeI2quH124wQ7kNvwGD7T8E&_nc_oc=AdqjBYGO5uNrKzfi3kaq2ONZWq-6WqibYlUm5LSFbg-aXLvzhmUbKJwwv8NO6Xm20hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OY4OYyTivDHSmDjZOc5xCt9WkPg5VRgB8QRcc3sJU7w&oe=69DBAE90"}, "display_name": "BitGym", "keywords": ["treadmill", "bike", "row", "immersive", "workout"], "long_description": "The world, from your cardio machine! Explore hundreds of locations with interactive pacing, stunning visuals and crisp audio for total immersion.\n\nTOTAL IMMERSION\n--------------------------\nCycle along the Perito Moreno glacier in Argentine Patagonia on your bike, virtually hike the Ubud Monkey Temple from your elliptical, jog under the Eiffel Tower on your treadmill or row through the Yakushima Anbo River from your erg. With over 210 land, road and water tours, and new releases each month, you\u2019ll always have somewhere new lose yourself in. \n\nWORLD CLASS COACHING\n-------------------------\nLet our guides take you on running, hiking and cycling adventures. Whether you are training for a marathon, endeavoring to lead your peloton, or just keeping a healthy lifestyle, our coaches will keep you moving. \n\nANYWHERE. ANYTIME.\n-------------------------\nZero setup and works on any bike, elliptical, treadmill, rowing machine, stepper, erg or other cardio machine. No special hardware required. All tours can be downloaded for offline use. ", "short_description": "Run, cycle or row the world from any treadmill, bike, trainer, elliptical or erg"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitgym.com/privacy/", "developer_terms_of_service_url": "https://www.bitgym.com/terms/", "publisher_name": "Active Theory, Inc.", "support_website_url": "https://support.bitgym.com/hc/en-us", "website_url": "https://www.bitgym.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "258866464009
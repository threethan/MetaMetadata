049109085232465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ST_CFr3MvAQ7kNvwH_kBKp&_nc_oc=AdmdYnzacn18Sl9hr76MdF0vcQ7J02lQUt9m2nEIP4ESWIBM-9IOEwcxarRQ3sNqQIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftym_JM0n7YHbGuTRxL73YDRfmitPWu3VcL4MtuiK-1MQ&oe=699F0137"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVRQoTp-VS0Q7kNvwGL-YLS&_nc_oc=Adnra5OMSGQVVp3Ip2U5Tj_j7kPkRu2m-YZH9sJBlyna16BGU5dKK5bi8f6-zSfriXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftgHvoAiLbfyTpq63N2bVXzVEQJGKRKTEZbSLY0E8NPhQ&oe=699EF565"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_to_be_a_pilot_trailer_art_logo_shadow.png", "id": "5077423468961009", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_5077423472294342_6989400384548126138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4olDb_DO4z8Q7kNvwFWO2rk&_nc_oc=Adl0h-a2onU2WwfMKGy8WMbwsED7P5vLjPHXj4p9clZQpZQAZH-wlVXbgmKYK9m9y2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuHjFD8i9agixqQcqKdox2P5gm0vTt1VAtzepuXNa8MEQ&oe=699EE6D7"}, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, o
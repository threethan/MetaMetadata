ream 25.05.2022 14_03_27.png", "id": "5290364314335399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75278190_5290364321002065_205049109085232465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QouWiDeUkZEQ7kNvwFPcHev&_nc_oc=AdpgPnLoJGtkW9leKtjaCVy1szBI7La3V0BHOQt2U4YFdBJgUU37iAp_654cOIYZulI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xjDDjG1puFGusK2avtCnNtbE9PbWMklgCVo3J77Ddrw&oe=6A3940B7"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7Vdz9Ikm40Q7kNvwFu7Ipi&_nc_oc=AdqILXdiHuAbpxWXhgEinZQyGiDi3g74IX-pdXGyN5BYVehJt5rQSWNNTMNsM7GjD40&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YOQ5EIcZNmbklxOvVji2L4_kDgo0RObquAMt2XFk4aA&oe=6A3934E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_to_be_a_pilot_trailer_art_logo_shadow.png", "id": "5077423468961009", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974444_5077423472294342_6989400384548126138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w4L6N4JElUQ7kNvwH_yy6j&_nc_oc=Adr8cYOr5r5zoPwHX0uMzdCaKlOw-lpkC2PyEarRAwUJRogUbYhgR-ekeKubFe_obZI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9isyh2E8OVkyjFfKXptzohvIo6fSpSCOIAdx0eHwy_MQ&oe=6A395E97"}, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, on the water or in the skies\n- Get out of difficult situations using smart thinking and vehicle driving skills", "short_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gaijin.net/en/privacypolicy", "developer_terms_of_service_url": "https://gaijin.net/en/termsofservice/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "https://gaijindistribution.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1663926103989431"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "494241679176589"}]}, "baseline_offer": {"id": "494241679176589"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1659301200, "status": "PUBLISHED", "id": "494241679176589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5189058697853543", "version": "1.0.4"}, "id": "551645659880202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Androi
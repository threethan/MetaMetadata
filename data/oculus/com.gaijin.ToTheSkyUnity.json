b=1-7&_nc_sid=6e7a0a&_nc_ohc=G6PwIx8QS7kQ7kNvwH-m5ca&_nc_oc=Adq5oVcXFKxmblc3TqJC4OqVpScYSt2peIJWQ-J_2WM5JpaejzWg4rTBb5fRL5jsw9k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO83w-JNepyIwNVBIpKM0vK61LuOlo0kIJCO9sckCu6g&oe=6AFB320E"}, {"file_name": "SideQuest Stream 25.05.2022 14_03_27.png", "id": "5290364314335399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75278190_5290364321002065_205049109085232465_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ0zKH61idUQ7kNvwGAjKa8&_nc_oc=AdpVfPp3iZ9EAMwMOwf-va7dJuuzqZ7hFR4cMm5Q2jm0LrSEZAalPdWV45gYVvk_1Wk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVx_WttEKfEebpa1mOH12_2182gMyiZt_fJ-_T6qJSsA&oe=6AFB4577"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fbEbRHnJLcQ7kNvwHBAIEm&_nc_oc=AdpQSs42Pnka3caKxNMhrXkjd58WcVumNwEXDc8mfNW4AlxGDpUrGA4MEAFwgOQgmP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpexVM58zPG2nfizjTxt1f9eWb9NtNxwnZKIHgtoUZmA&oe=6AFB39A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, on the water or in the skies\n- Get out of difficult situations using smart thinking and vehicle driving skills", "short_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gaijin.net/en/privacypolicy", "developer_terms_of_service_url": "https://gaijin.net/en/termsofservice/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "https://gaijindistribution.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1663926103989431"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "494241679176589"}]}, "baseline_offer": {"id": "494241679176589"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1659301200, "status": "PUBLISHED", "id": "494241679176589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5189058697853543", "version": "1.0.4"}, "id": "551645659880202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5009911189101629", "is_concep
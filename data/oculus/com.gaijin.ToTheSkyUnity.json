049109085232465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ST_CFr3MvAQ7kNvwE_Dihm&_nc_oc=AdnBHQQ9Bo5EWJTxu0JwtvnhTNT5XeGwdf0mwJIgukFuMPQe7CFhGog75jYORmBSvX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9I_ZoFz4CYl7a3FyahH9cmTjt6wovBsu0AukXvTXriQ&oe=69A052B7"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVRQoTp-VS0Q7kNvwHIMcyb&_nc_oc=AdkNk0SI-QZvt-VtlKtWjBUszGpeJnPsZrBxIixcYWC-x1f93oj2afDUtzcsv5GePGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuCgwxAT-vU0Cn8K2mxd4I4R4LlEL9vkRIES5x6AIOcg&oe=69A046E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_to_be_a_pilot_trailer_art_logo_shadow.png", "id": "5077423468961009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_5077423472294342_6989400384548126138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4olDb_DO4z8Q7kNvwGPfr9Z&_nc_oc=AdmnlY5IvNRDt36lq1_BzDlh-W-pj4hdJV_TnDfTSGpGcn264a-W9Unm_TTdN_DDdjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCvn5jD2EJXuvd58xkjMO3S-oPeJdIh6vUkxZ4u13MVg&oe=69A03857"}, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, o
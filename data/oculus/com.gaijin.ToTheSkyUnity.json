049109085232465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38I9mMyV3xYQ7kNvwG4Svwt&_nc_oc=AdlshxZyGy3yH0r6VGTt003jAv5ax77CPQgbgNb9zGTsFXC16o6wujjOlLK94pK4mBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxFOQTV1N86-Y9_5VyxRkkC7E93xpTsnX8tjvtQCAZ7w&oe=69A6EA37"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbZBLZHKVlEQ7kNvwHgK9IX&_nc_oc=AdnDDj2pcGk7JaJi6uoT_LqrH4TpTPw3tydbf41B2rJJazFRaQ0iawRVY1OebPcVH6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdyjqOSS5qmkPT5_0a_9Yg0bhVuLp72PwzSIo_5_o7eQ&oe=69A6DE65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_to_be_a_pilot_trailer_art_logo_shadow.png", "id": "5077423468961009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_5077423472294342_6989400384548126138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21Exslq7q0UQ7kNvwGTpq6U&_nc_oc=AdkZgR2fVAVS3RucppYmHVKpLhCYL4U0JOcJg5f36fSkJyUfUnJsqN_xq9WxoITOGFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4JVLRRPZ6d4qpBg070LzD5Y82gKDwpV1F1cytLt40uw&oe=69A6CFD7"}, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, o
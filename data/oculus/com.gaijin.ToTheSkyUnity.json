049109085232465_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6XClN4J-tQQ7kNvwHTGTcP&_nc_oc=Admme1AL22Oc6zXZN3WWmKg74iq_be9K0vS_8tqnugHCgB5A2F4Zc84a2kXTB3RmVRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuP936EcwNO-58R52T_q45-_lvPIR-1to1R3M8ULURYIA&oe=69A2F5B7"}, {"file_name": "SideQuest Stream 25.05.2022 14_06_10.png", "id": "313868977620471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_313868984287137_2352751904425151743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4euXk9dyTVEQ7kNvwENLYv9&_nc_oc=Adkxp19vJSQy_HDpc2h3jvjqss4OYc-DPKljJyhUftCKzRVhcMky527bANSbO1IEvjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXw4881wm3MNVpj-Iq3HvArr3hD7H05YX6WN7gRDAWQg&oe=69A2E9E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "art_to_be_a_pilot_trailer_art_logo_shadow.png", "id": "5077423468961009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974444_5077423472294342_6989400384548126138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-54xVJVUhSQQ7kNvwE2-yHL&_nc_oc=AdnNQEfPjY2yPGIEjCmkiUNKNJNiQjWjmKNMwKc4gqluJo665MNtST2RKAMZIF6uPx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afur4k6EdC9rmNIArRnWfITSa2-fT4l72Z-D5vCNLkFMaw&oe=69A2DB57"}, "display_name": "To Be a Pilot", "keywords": [], "long_description": "To Be a Pilot is a transport driving simulation game with an incredibly\ndiverse range of vehicle types, ranging from usual suspects like cars,\nplanes, helicopters and motorboats to exotic stuff like hovercraft, hanggliders, caterpillars, swamp walkers, snow vehicles & more.\nPlayers learn to drive all those vehicles in VR and use skills they got to complete challenging missions with harsh extra conditions. All vehicle systems are thoroughly simulated, they work and look like they do in real life.\n\n- Learn how to drive vehicles of your choosing\n- Explore exotic maps in the most beautiful places on Earth, like the\nisland of Haiti or Mauritania desert\n- Move around on the ground, o
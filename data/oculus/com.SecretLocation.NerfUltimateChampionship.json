458097024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_866202461430357_7963220389565184709_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v28naFj3wusQ7kNvwHtm0cR&_nc_oc=AdmDnNF38ljfoma3XngLUSb3qLyyNln3UFLswGh6jWrbCmhCgQdFdaAhSMWMyUYrEuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9vlYike6VO0jSU8X3uyVm3nifx38CPSLy2PZ3z2Baqg&oe=69A2E2F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MA_NerfUC_S1_Banners_Landscape (1).png", "id": "786464279244548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974878_786464282577881_8676115409890534977_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zP9olmuaVPgQ7kNvwHO6xV8&_nc_oc=AdnOGCdJtWuzvX3m19QRFVvIn-G03FiKZXDPs61U4HcDcEl1hjgVnBJgXu-lE8wMUWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftd_ZRz18DakH8x3AAUDimeeR9la1Sr28yfgA-lv4B5vA&oe=69A2D8E6"}, "display_name": "NERF Ultimate Championship", "keywords": ["shooter", "action", "fps", "sports", "arcade"], "long_description": "IMPORTANT NOTE: GAME SALES WILL END MARCH 1ST AND GAME SERVICES WILL STOP AUGUST 31ST, 2023! \n\nSquad up and blast your way to victory in action-packed 4v4 multiplayer NERF battles! Master the unique mechanics of an ever-expanding stash of real-life NERF blasters and rule the arenas of the future by wall-running, ricocheting, and slam-firing a storm of darts down on your opponents across 5 challenging maps and 3 game modes.   \n\nFREE SEASON PASSES: Unlock original skins! A snarling shark running down the side of your blaster! How about Steampunk inspired gear?   \n\nAUTHENTIC NERF BLASTERS: Master their priming and reload mechanics, perfect your aim with unique dart physics, and storm the competition with dual-wield capabilities!   \n\nLOCOMOTION: Parkour style-movement, wall-running, and double jumping! \n", "short_description": "Squad up and blast your way to victory in action-packed 4v4 multiplayer NERF battles! Master the unique mechanics of an ever-expanding stash of real-life NERF blasters and rule the arenas of the future by wall-running, ricocheting, and slam-firing a storm of darts down on your opponents. Hone your skills in the practice facility and unlock multiple skins with FREE season passes, as you dominate your way across 5 maps and 3 game modes to become the NERF Ultimate Champion! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://secretlocation.com/privacy", "developer_terms_of_service_url": "https://secretlocation.com/eula", "publisher_name": "Secret Location Inc.", "support_website_url": "https://www.nerfvr.com/", "website_url": "https://www.nerfvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "650909046839766"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974589_467007352034384_3123239347330184169_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbksiOVKvCQQ7kNvwHQGSux&_nc_oc=Admp6IyIOel-X_u3rt4D_WQ_q1DCSa4UYdvr9hfwMJBtOk9YyWFrT86VRALMBv-f05g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftr9hpFl8PZEqYKEjKE5Tj0OIJ_2JPflGy3D5bAlG0j6Q&oe=69A2E2B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NERF Ultimate Championship", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1661446763, "lastRevision": {"nodes": [{"id": "5169720976419984", "release_type": "MANAGED",
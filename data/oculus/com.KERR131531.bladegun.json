_ohc=45KgKxyXOSQQ7kNvwFAgQHQ&_nc_oc=Adq1Y3v51DIJRNyCxd4x_9RlAXddtgfQmqfW9cOyrubKE20jPx0BWRCHrUkVVzR-Qpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6F0V6dZTnHLvfNYy7hr-0-cFtbFFxqvwzy28KgfM8PA&oe=6A3EAB72"}, {"file_name": "1.png", "id": "485254837542945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520120_485254847542944_7654487730772767810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVX6gzii73YQ7kNvwHKxp4J&_nc_oc=Adq_0Hklcfgoft1jigYMvmlsZW2v3pbTg_2cl_T1yeI6fduvPXPoXidFzOdTWdaMa6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DNGIjRQQJ_kLFXTpMO3wC5JWI9lR8Id9aTdvZd3Dovg&oe=6A3EB169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFm7np0bfwQQ7kNvwF2jb0c&_nc_oc=AdoaXJVZS7N_FNoMzIFV9GZZBRpk-X3W8N7px2zcfF2lYKyJ7N4UcseHj0P-J75Ar1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KSrmDEkO-fr42bpZUG8LFPEIQMQFEFEQ8j5H8_6nWyQ&oe=6A3E8A8F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawl
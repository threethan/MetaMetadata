H&_nc_oc=AdpnG1q1Afj90viz2w-TdxMu6PXQS-e0FTbe_w6bCgmP5ocxPXhg_ZFCDEOe-wBBGuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjjNtrG5ED-C5ZbiXaHZ9YE7K4BBKBqg0oKwv_y1WG0g&oe=6A4A6AD8"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwQ6Y3NzXBAQ7kNvwEpuJ8Y&_nc_oc=Ado_nkKwqSLED5s8ugJ2QvXejV4WV23xn2lf3LBJsVTUSayG3qZ2ZHjvHn7dsdsVcFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYCflvnC7RjC9o2ercVQpZCOKbQX1G4THx_Dme_N52cQ&oe=6A4A50B2"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihVNEDpuxJUQ7kNvwFYJid-&_nc_oc=AdrqF5B00u0SXHJCkRs7OsQCWSQMwm4GZjSFpU6U52H_bcz4pGzOdwSqCw6zeNK0owA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmYjeoouCYIiZTU4XAopfTPeDcv5x23XpPz0WXv2_F_Q&oe=6A4A5385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JgKWXic31AQ7kNvwEkN_VT&_nc_oc=AdpDOhuvtQCvCzXnVtOZl6zdir2EFTBhhHmrb1cxSAxor6ij-NAh3wFwNgbASL-RAEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYDfiqMy98WZdP_o-t2q9zTJUKgOMqkxYQxfgMS2C-Eg&oe=6A4A680F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_87534815427247991
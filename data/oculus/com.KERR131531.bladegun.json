34h5sgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzu2EhDJyHCEMhz_UtwJ5N_pS1HfHgOrHWBHE01XOkeOQ&oe=69B2B432"}, {"file_name": "1.png", "id": "485254837542945", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520120_485254847542944_7654487730772767810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W8QjANrBF8Q7kNvwEAgel_&_nc_oc=AdmptMyfBl0i_t4Q4vnVC1wSwP9nn7YSMAbk2CihXjKT-mxNDaCLcpQG9C6CcD0Mh2Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9M5smukDmnmQ2sc0XJw2zH_1fanrcxQogRTX0UK6MJg&oe=69B2BA29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zeQ74SJgKcQ7kNvwGsj-Dq&_nc_oc=AdnMHRsIE9SWGIC9Stnr4U6_PEWCtNUPRiV3Gvlmzh2Z7E0Zn00lTkq1J8FNCHqhYWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmqhpWLvCceMq1TDzLEW5VxyhBDW-18rz8zxS6Gi2Yjw&oe=69B2CB8F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have
q&_nc_oc=AdpTIewCakJA5HghLeVxQbkbixXiivgBGXCeRtmqf-41E36VMAEt4rcNUyyYfbiwqs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aXNdZYxzpEcgENlQTcgUgvXiId16sxYgZi0jKUIWJzg&oe=6A1851D8"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDCj4rl8N3kQ7kNvwH6PWuf&_nc_oc=AdrwNX8Po7RstHY4_LwTfTQGCsh5XGdeyB8gfhbs9LpvCIDyQVOycrnwr87vUlbIg7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bdw3OSMbeai58KV0YjN6cQ-cTRi2hFWK2102m66_CAg&oe=6A1837B2"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFasp8hwu1YQ7kNvwGug-Gp&_nc_oc=Adqa84_xb05JYORPpkU9nwdxiFLowt87Cs9pO9PRzT6w8t6pxYAoKvb-9UJ5jZgjzYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pzw0CNoWvcbWgnmAW4H_B00tktOQlC7saO9DQxIEKqw&oe=6A183A85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hekKsyEmBYQ7kNvwFU2_rx&_nc_oc=AdrKGwRV3vUnYojKKIfAOliLxRO2M5P5dBAOyomlwyXToDe1l-cf0A5WBvURsZOhUMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WTyEBaxFh7VyfrQjfUdr0B3fiAtaxtCRarQIHD3nB9Q&oe=6A184F0F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_87534815427247991
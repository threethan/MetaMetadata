3&_nc_oc=AdosEJIJlFy6fZDSJyY1gvj_6CrDNcYiiYGFD3xYJA3BhZKP4NBQ7jKQKQowkT1IZMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeXWIzwcAPdonePGW6TqFLKZWSYg5beMo5x_WwkMLR0w&oe=6A5CDFD8"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOpoNnQ_fhoQ7kNvwF0V9Hr&_nc_oc=Adq0xQKjtYyZDfhLU3EdCLcgAJyG9LK04UVr8dlZdAddjCFhPaebM8ZXR80VkMstMwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYHx5ORHFJQR7GzmuCka7JO8i6Z9xcpcEBqASYcT5mOw&oe=6A5CC5B2"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCrWu7slcfcQ7kNvwEVb5HQ&_nc_oc=Adr4xWFBEyU32d0piFSRHYUP2FMAUR8L6apnst4a0jno4MQZvFgSuT0F-KjtbjmVVxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoiYXSfy_mkYzo648eF21nk0FAe2UVwwTbFrlIRqXqlw&oe=6A5CC885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNEX91RFm4wQ7kNvwEeX31O&_nc_oc=AdoKscc5Nz5ShhWHVNnJ0D49Q8GxAuVjp4EZU4LsxBY7ZGs1coHmCFMFEqlifd2kDYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZE7wrAGM6qM_XHgPlTzPF0jqMJDSBPGqd_dyQCRdFog&oe=6A5CDD0F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_87534815427247991
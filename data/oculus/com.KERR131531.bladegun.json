h&_nc_oc=AdrSG99HWV6FggBe390vJPqeqJ-NySlrG9ndyXzGflZwGcbjmVGfKMe4BFUZTlph6bU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa9O6g3l_7kSw_XGHzEpC-iDhz26NQ8UzInvU0bzIPnA&oe=6A882918"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR_ffq2f_0UQ7kNvwHQhMbg&_nc_oc=Adql0Mmz1z2rr4VWCaOBUCOX0WWQoMboWqUgGrP-d7NaEnvTUXSMIEsnV2mtEVnD_gc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF-iP6evehJszGtxcb6-mR77Uah8QhU2GK7nAZU6NYUg&oe=6A884732"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptLM54wQDwQQ7kNvwFqQ_vq&_nc_oc=AdriqbGk62P3nZZb1iV99QyLgqVCFSvfcmLXkTTCq_y-735N3CpLIkG_I0ezp2Vg2vw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3kAO4PY3CZMWa30K0Zk8hViYbdhFOa6b-VcVsY-3iYQ&oe=6A884A05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ieuNdw06aIQ7kNvwFce3z1&_nc_oc=Ado_dmm_Hb6Rb76l-K8T4-b1DKjaPdbMLy_vZgd6zOgNjmJ-_oXYlGmcPY29bU2I7dE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF596okNisXsKmwkBaLfZjj3Qt48j_fVOPavnjMC-RqiA&oe=6A88264F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_87534815427247991
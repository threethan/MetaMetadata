n.com&oh=00_Aftg1-ienwI613bRoju-rwGlYGNwCHGOsFz5j9r7G0GA-Q&oe=699DB658"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi86dSigSEYQ7kNvwFL8p1u&_nc_oc=Adn-cBGYddHT9XCEd3DDIuImyb9lMjETBYxaLXwjeT1x0Z0OzKBiUrjEOzfYSUoX-Ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2nrBaBWVRt0ij2tpO6yDGyJWu0FrLTBBeANNsOK842Q&oe=699D9C32"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRctQ97k10sQ7kNvwEMz3GX&_nc_oc=Adlc4yV0nkSZHD7ZDDNGvRiH9Q_K00TGu9ue47nFvAXs_OdHcBFeWiz3sjW1ZgXOAXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuL9gqh-igVzMmQdOLLv8h4AV8XNQLK8MqbBgnGNH_0zQ&oe=699D9F05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aebM91r5kAAQ7kNvwFR9opa&_nc_oc=Adk_40Ze-NPB2F27zr0c8nJqZNAyAWla_sxdhrStctXTGl8dKzydn009x5hGYu77lFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvo2je9JrWXVoU8Nw6Z72iEcRSEdA_f7X1BneTiV6zcHw&oe=699DB38F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_8753481542724799187_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evBmP23OY44Q7kNvwHBJmKN&_nc_oc=AdkcyOIMaIThsZRaFuxciusqcr8NI9ead58CLkgrGtsVEOOffpb91mVX0dLi6YSnY
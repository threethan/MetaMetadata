wGbnDKl&_nc_oc=AdrQR2P05LH8G5Az6tfSQjdBimX0mVEfRRg0BN6fdVyRAuzThjR2WdvDSQ60GAVPAg8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JOyBq_MLRwYKLuP7fj7Bb_mWBptcjprprCaOsDs3vKQ&oe=6A22DDD8"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dkRhnWgCgoQ7kNvwHzbyrN&_nc_oc=AdoccGk4Cd_MzMOszMixAb5fJCa91jvu4gcQXQnDG6ZPzrGFtApDf7PSEYqqcqLiQPA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PCMM4J6vzS3WT6PUFstMPoYskV_Ry45F-_E_wLq697A&oe=6A22FBF2"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhJde13-jjYQ7kNvwFT1y_b&_nc_oc=AdrPUDw0-_zWCFocvVxwLLZYDXaB6MuGMidDIUVcsL26KuJQ92iWkl53nWH6mx_IDsE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XgCFFDOzsEeuUDoc9DO9FRGFOSPEpzr9MLEW0UZ2DCw&oe=6A22FEC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8jWESIf0TkQ7kNvwFLhzid&_nc_oc=AdrM56RWKTWq6CmkYYyYj8Q4Kvl3j-qkXpGCa6Y_HAmG7OFXXZWEs16jVEnUYF4JaKE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yzrlSyvrDvZD5oKOtmEdwT896aeaYY-ypOalf-alx5w&oe=6A22DB0F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_875348154
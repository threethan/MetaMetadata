n.com&oh=00_Afu9AN9jBSYXskTyJAKvEyPV582c1WfhbWq7l170T_p80A&oe=69A59F58"}, {"file_name": "3.png", "id": "1467133110839817", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036703_1467133114173150_6241200002609965605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58ifk8Aps3MQ7kNvwGIsPlL&_nc_oc=Adm-AP8qFlsLKXeky_cjqdpi6tU7h5AntvB9reL18lA9Ls6WGwZFrFsIrkvvoaARF4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftdwkKK6-uLI4nDptr6HURjILCEbnaKeJe2QMeWRj9Pdg&oe=69A58532"}, {"file_name": "6.png", "id": "1204447597254592", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363518_1204447600587925_1604163569285309267_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ANIeFQPoJkQ7kNvwEUZRdn&_nc_oc=Adn8oqi5rXRIbv27xc1liocICRwTgMz9Cx1mJWVxGr2N7-eV0WaUQk5HilSxXeae9-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv8mLVhJHIKjLqpa5w6NcDNNgFZGzo8fMEmY4WEAZ3fWA&oe=69A58805"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXCIvuChAQMQ7kNvwHwJvld&_nc_oc=Admjl8odHnX4jJnr70FcUoUP8X1HPIa5Phgf8OHVRcG-0dbhIpNElKvn1ok7pgLhlT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvpl449Ei8Poh1azWaX_0vV95DRIWi56HkaULAairVt6w&oe=69A59C8F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8245955408771497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982519_778752394340116_8753481542724799187_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qUAoGY-pFQQ7kNvwFajn-t&_nc_oc=AdlbUyuQs0ceFfE9EySG6jrkIyuycFK6334X1itls7B9h1b2M5l-cnsSu4RVemz5g
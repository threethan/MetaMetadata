U5jC_4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQ1jdqlEGBSGj3fM4w8toXX5ceNzDVDCsnWmHjqn54yg&oe=69AC1CB2"}, {"file_name": "1.png", "id": "485254837542945", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520120_485254847542944_7654487730772767810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsCuk_7shCQQ7kNvwEZEeC8&_nc_oc=AdkJ7t_trNLV_v-YjiePISofnNz9at8cUWyPrpaeWMQSaOamlHT_f9XIzJc7UQu5F6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9vpB1cBk6Ih_LOj3qptEFC0f9q96i2ow-HDe7HWtcnQ&oe=69AC22A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXFcBOvuyAoQ7kNvwH8sQZj&_nc_oc=AdnCXjrvrqpRSiZSidhg3p7xMFAs8_eJeaMAiZJm4h6n2ZKO8gxiGPi11icYqwbigE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_C2Eas4nadasecqxgNVW7xajmr8ifzaTatp9vstnJkA&oe=69AC340F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have
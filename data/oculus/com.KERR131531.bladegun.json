_ohc=4J0VSEo9DGkQ7kNvwG73dGg&_nc_oc=AdqpTGRNHxryDe8aGscM6TVj2Q6KM3rpRrP_n_HQzddtM9YIsOzF-nKVM8E12sjV6ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf8uNyt--cVEwr-WGnOShaAMoKjxLw1wq7Unz8mwGSaA&oe=6AA7EB32"}, {"file_name": "1.png", "id": "485254837542945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75520120_485254847542944_7654487730772767810_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K-3M2FvKEkQ7kNvwHM8OGk&_nc_oc=Adph_AHEUtxw7_B90xUAymBrWsCht4LVwSFjdvLMI588VkmpABTNytT80Rn_Xqd8rbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7W0CcRrcInPBI130cZGfrCjFHiM6poKgDzBS4yWyarw&oe=6AA7F129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "409530038174730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207235_409530041508063_1594896824332022275_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2QkQCQTgI0Q7kNvwGVHUm4&_nc_oc=Ado4ycUouVpC4MHZAu_-iEIS9TjTFZdjZkets9eN8mgl8dCwIVVCqDRzWaA1w66JI4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILtgA_-pvm-G_O4lHL8IYCyoKFV0SsWv8uc3iL_HvQ0g&oe=6AA8028F"}, "display_name": "Blade & Gun", "keywords": [], "long_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order.\nKey Features\n\n1. Immersive VR Experience\n\n    Enter a fully immersive virtual reality world where you feel every swing of your katana and every shot from your gun. The high-fidelity graphics and realistic soundscapes make you feel like you\u2019re truly in Neo-Tokyo.\n", "short_description": "Storyline\n\nIn the sprawling metropolis of Neo-Tokyo, the city is shrouded in darkness and neon lights. Crime lords and rogue AI have taken control, turning the once-thriving city into a dystopian nightmare. Amidst the chaos, you are a ninja warrior with a unique edge\u2014armed with both a traditional katana and a high-tech gun. As the last guardian of the ancient ninja order, your mission is clear: defend the city from relentless assaults and restore order."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blade-gun/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KERR Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/blade-gun", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8151832978183741"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8217705388263166", "version": "1.0"}, "id": "3722200114663094", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8151832971517075", "
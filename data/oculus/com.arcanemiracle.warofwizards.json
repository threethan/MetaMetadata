AdrDx8lgDr-cVqygAyHt1kJacITPwOm05imzQ-PE1rvJHFV5QXAl_qIJDplNw6V1Dh4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af17FG93cb4XqfRhCO7VyuCcGh_sTWQh7ztlk3qJMNhWoA&oe=69F1F0BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "612966413832998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_612966417166331_4326765418550343614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oA7ZC8-BJwQ7kNvwFtb8kv&_nc_oc=AdqWdyOfvY-EhsPlLwYsJv6-1_lds46TyXMa2G21KUvViTrwLGpXgF1GcSgk26y2D_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BcoJpxPhcjZ74B51pAPo7r2zRXEIGtG4mccNloKUukA&oe=69F1F9D2"}, "display_name": "War of Wizards", "keywords": [], "long_description": "Draw & cast your spells, magic showdown! War of Wizards is a VR game with MOBA confrontation.\n\nDraw dragons to summon dragons to fight for you, draw fireballs to summon fireballs to shoot at enemies, draw pills to heal yourself...\nYou can cast different spells by drawing different patterns, and the accuracy and size of the spells you make will affect the damage and range of the spells you cast.\n\nIt's a game that uses both your reflexes and your strategy skills.\nThe spells you choose to use depends on your judgment of the enemy player and what strategy you plan to use to achieve victory.\nYou can also dodge attacks flying towards you by dodging your body.\nLead your minions to victory against the enemy!\n\nFeatures:\n\n- PVP MOBA!\n- Draw & cast your spells!\n- Dodge the skills that the enemy fires at you!\n- Use strategy to lead minions to destroy enemy magic crystals!\n", "short_description": "Draw & cast your spells, magic showdown! War of Wizards is a VR game with MOBA confrontation.\n\nDraw dragons to summon dragons to fight for you, draw fireballs to summon fireballs to shoot at enemies, draw pills to heal yourself...\nYou can cast different spells by drawing different patterns, and the accuracy and size of the spells you make will affect the damage and range of the spells you cast.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.warofwizardsvr.com/game_privacy.html", "developer_terms_of_service_url": "http://www.warofwizardsvr.com/game_eula.html", "publisher_name": "Arcane Miracle Entertainment", "support_website_url": null, "website_url": "http://www.warofwizardsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "802371900948208"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1190881556321388"}, {"status": "CANCELLED", "id": "1497522272085641"}, {"status": "PUBLISHED", "id": "2746210682444155"}, {"status": "PUBLISHED", "id": "2509874579406201"}, {"status": "PUBLISHED", "id": "2077008193035519"}, {"status": "PUBLISHED", "id": "2113596229390189"}, {"status": "PUBLISHED", "id": "1805905463350142"}, {"status": "PUBLISHED", "id": "1714840002496702"}, {"status": "PUBLISHED", "id": "672346438720664"}, {"status": "PUBLISHED", "id": "1186072769798596"}, {"status": "PUBLISHED", "id": "454629554332904"}, {"status": "PUBLISHED", "id": "375406612266724"}, {"status": "PUBLISHED", "id": "474638935492003"}, {"status": "PUBLISHED", "id": "1124141491576019"}, {"status": "PUBLISHED", "id": "6099101230211531"}]}, "baseline_offer": {"id": "474638935492003"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17
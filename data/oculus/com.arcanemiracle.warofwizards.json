54Q7kNvwHCmtuU&_nc_oc=Ado_tUNtBGP5QyutEzuBvcSTjqA937XyX30VkRSxzoSqN0JTzUmTKIsR0JYpO321XwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_VAIXxBre2HSTfr9aJSBsLfhgEazAfSEM0XYyQEqoVQ&oe=69CFD3D3"}]}, "id": "1541434623597891", "locale": "en_US", "screenshots": [{"file_name": "selectgold.png", "id": "792309740105482", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_792309743438815_3468558766857512349_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VopO8nmXqYQ7kNvwEMCePJ&_nc_oc=AdpgquOIh8mnDcK0su8_81f0VkJiXgEA5x_ASGdQeLDLtIjLoBUATY6tJL-2mo6e3AI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxvsa62WwzXzwz7xqVi1TTO3XwkIXXgNbbnJY1UIvgzoA&oe=69CFBBF4"}, {"file_name": "gold select.png", "id": "1955651858721397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622227_1955651862054730_8196515234133505593_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gq5lKb5IploQ7kNvwHRHYYT&_nc_oc=AdrAzI7vkr69d3WL_0-0JBFfHlLpyEH1El6QKrntVAfXSybo-lw6lhMgJ3nJ-Ux4BIM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJQ2hzTah7uy0W_I5zyp6uTylFKC4E2rcT1Nt0VxI-cw&oe=69CFCD51"}, {"file_name": "ingame.png", "id": "26336325039390508", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617831_26336325049390507_6977834553010242246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Fdmfqz2_NoQ7kNvwFjSQMf&_nc_oc=AdqeAJg9drSfhEdg9IrK8rxBDi4ZZLv5iHrCHRWstd7ifzm5RewBis7cEfYh8kiWl9Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8sKRS7_6h75U5QKaadO0NWUl0drwVLkHxCkN3Vxs2xw&oe=69CFBB93"}, {"file_name": "room.png", "id": "1581938583103009", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299922_1581938593103008_4089191360587084808_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fy2v-MhA64Q7kNvwFSpQUM&_nc_oc=AdrdKa-ruXSDnZv8UqIryeOJii5ays-hx3ooSBb5HxrrLZdwPZ7US8ru2DWBpjv0RAo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsiaBHJuQ3V_BjDqFB7VcBGY7ZnlFzHUg1nBPMzEBeaw&oe=69CFB761"}, {"file_name": "pool.png", "id": "1406737487447126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618103_1406737490780459_8578536948702364201_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JlP27sUxR8Q7kNvwECh99A&_nc_oc=Ado7PZHCB4XJLcNMYz3o8iG5RMJBSVJERJ0LTk7kfuUbcAgL2fAqWC9X9wyc3vGJHTA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypKTDGL4HZJbkkLIC2V-Z7qzxBnEFlydhw7LFxboW68w&oe=69CFBC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6625\u5b63.png", "id": "894583380149647", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623400_894583383482980_5001395732391501831_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUubbUYOrEAQ7kNvwEyPsuG&_nc_oc=AdpT7F8QaXYph-tcgQ-S9zOC9_CDVVD4AKVVyTINJC0VjMXnHnMmvYWgQugQ2DPmvDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxQm4op5X-9D9OLgxrv6j7QWaGv5Vr9rMKxsD4RWejOw&oe=69CFC7CC"}, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# Start Your Wizard Journey\n\n**War of Wizards:** invites you into a magical VR world where you draw spells to fight in exciting arena battles.\n\n# Rune War \u2014 The Ultimate Roguelike Arena\n\nEvery battle is unique. Every choice matters.\nEnter the Rune War and gain powerful augments as you fight! Every 2 minutes, choose 1 of 3 random augments to enhance your combat abilities:\n{1577081930252386}\n113 unique augments across 3 tiers: Silver, Gold, and Prismatic\nBuild-defining synergies \u2014 your spell loadout influences which augments appear\nNo two matches are the same \u2014 adapt your strategy on the fly\nHigh risk, high reward \u2014 chase powerful Prismatic augments or build consistent combos\n\nMaster the art of adaptation. Will you stack damage buffs, invest in survivability, or gamble on rare synergies? The Rune War rewards clever choices and quick thinking.\n\n# Drawing-Based Spell Casting\n\nWith over 80 spells to learn, casting magic is all about drawing the right symbol.\n{528414909801226}\nKey Features\n\n- Rune War \u2014 Roguelike augments with 113 buffs across 3 tiers\n- 80+ spells cast by drawing gestures\n- 1v1, 2v2 PVP and PVE modes\n- Fast-paced strategy with quick reflexes\n- Balanced design supporting diverse playstyles\n", "short_description": "Draw & cast your spells! Sharpen your magic skills with other players in VR!!\n\nWar of Wizards is a competitive VR MOBA game, where you fight in battles with other players by drawing magic spells. \nThe system recognizes the symbols you create, casting the corresponding spell instantly.\nPVP and PVE modes, with 1v1 and 2v2 battles supported by system matchmaking."}, {"images": {"nodes": []}, "id": "1482718049906435", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# \u72ec\u7279\u306e\u4eee\u60f3\u73fe\u5b9fMOBA\u4f53\u9a13\n\u300eWar of Wizards\u300f\u306fVR\u30e2\u30d0\u306e\u30b2\u30fc\u30e0\u3067\u3001\u72ec\u7279\u306e\u65bd\u6cd5\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u5854\u9632\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u3042\u306a\u305f\u306b\u552f\u4e00\u7121\u4e8c\u306eVR\u4f53\u9a13\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\n\n# \u63cf\u753b\u30d9\u30fc\u30b9\u306e\u30b9\u30da\u30eb\u5909\u63db\n\u300eWar of Wizards\u300f\u3067\u306f\u3001\u546a\u6587\u306e\u529b\u306f\u305d\u308c\u3092\u3069\u3046\u4f7f\u3046\u304b\u306b\u3088\u3063\u3066\u6c7a\u307e\u308b\uff01 \u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u304c\u4f5c\u3063\u305f\u30b7\u30f3\u30dc\u30eb\u3092\u8b58\u5225\u3057\u3001\u3059\u3050\u306b\u9069\u5207\u306a\u546a\u6587\u3092\u304b\u3051\u307e\u3059\u3002 \u30b2\u30fc\u30e0\u5185\u306e\u30d2\u30f3\u30c8\u304c\u3042\u308c\u3070\u3001\u30b9\u30da\u30eb\u306e\u5f62\u3092\u8a18\u61b6\u3059\u308b\u3053\u3068\u306a\u304f\u6226\u7565\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\uff01\n\n# \u53d9\u4e8b\u8a69\u9b54\u6cd5\u6226\u95d8\u3001\u6226\u7565PVP\u3001PVE\u30b2\u30fc\u30e0\n\u546a\u8853\u5e2b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u3042\u306a\u305f\u306f\u53d9\u4e8b\u8a69\u306e\u3088\u3046\u306a\u9b54\u6cd5\u306e\u6226\u3044\u306b\u5165\u308a\u3001\u3059\u3079\u3066\u306e\u30b9\u30c6\u30c3\u30d7\u304c\u91cd\u8981\u3067\u3059\u3002 \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0PVP\u6226\u95d8\u30671v1\u30682v2\u30e2\u30fc\u30c9\u3092\u542b\u3080\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3057\u305f\u308a\u3001PVE\u30e2\u30fc\u30c9\u3067AI\u76f8\u624b\u306b\u6311\u6226\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 PVP\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u306e\u305f\u3081\u306b\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u76f8\u624b\u3068\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3092\u30de\u30c3\u30c1\u30f3\u30b0\u3057\u3066\u3001\u3059\u3079\u3066\u306e\u6226\u3044\u3092\u65b0\u9bae\u306a\u523a\u6fc0\u306e\u6311\u6226\u306b\u3057\u307e\u3059\uff01 \u3042\u306a\u305f\u306e\u9b54\u6cd5\u30ab\u30fc\u30c9\u3092\u4e39\u5ff5\u306b\u4f5c\u3063\u3066\u3001\u6226\u5834\u306e\u5909\u5316\u306b\u7d20\u65e9\u304f\u53cd\u5fdc\u3057\u3066\u3001\u9069\u6642\u306b\u6700\u9ad8\u306e\u30ab\u30a6\u30f3\u30bf\u30fc\u3092\u4f7f\u3063\u3066\u3001\u3042\u306a\u305f\u306e\u624b\u5148\u3092\u52dd\u5229\u306b\u5c0e\u304f\uff01\n{841094031157493}\n# \u4e3b\u306a\u7279\u9577:\n- \u30bf\u30ef\u30fc\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u30b2\u30fc\u30e0\u306f\u3001\u8fc5\u901f\u306a\u601d\u8003\u3001\u6226\u7565\u8a08\u753b\u3001\u6642\u9593\u7ba1\u7406\u3001\u30ea\u30fc\u30c0\u30fc\u30b7\u30c3\u30d7\u3092\u5968\u52b1\u3057\u307e\u3059\n- \u72ec\u7279\u306e\u65bd\u6cd5\u306e\u4ed5\u7d44\u307f\u3067\u3001\u3042\u306a\u305f\u306e\u7d75\u304c\u546a\u6587\u3092\u6c7a\u3081\u308b\n- \u63cf\u304b\u308c\u305f\u8a18\u53f7\u306e\u5927\u304d\u3055\u3068\u7cbe\u5ea6\u306b\u5f71\u97ff\u3055\u308c\u308b\u9b54\u529b\n- \u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3059\u305f\u3081\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b9\u30da\u30eb\u30c8\u30e9\u30c3\u30af\n-  PVP\u3068PVE\u30e2\u30fc\u30c9\u30011v1\u30682v2\u306e\u6226\u95d8\u306f\u30b7\u30b9\u30c6\u30e0\u30de\u30c3\u30c1\u30f3\u30b0\u3067\u30b5\u30dd\u30fc\u30c8\n\u898b\u77e5\u3089\u306c\u4eba\u3001\u53cb\u9054\u3001\u4eba\u5de5\u77e5\u80fd\u30ed\u30dc\u30c3\u30c8\u3068\u5bfe\u6226\u3059\u308b\u30aa\u30d7\u30b7\u30e7\u30f3\n{1477188196297544}\n", "short_description": "\u3042\u306a\u305f\u306e\u9b54\u6cd5\u3092\u63cf\u3044\u3066\u767a\u63ee\uff01 VR\u3067\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4e00\u7dd2\u306b\u3042\u306a\u305f\u306e\u9b54\u6cd5\u306e\u30b9\u30ad\u30eb\u3092\u78e8\u304f\uff01 \uff01\n\n\u300eWar of Wizards\u300f\u306f\u7af6\u6280\u7cfbVR MOBA\u30b2\u30fc\u30e0\u3067\u3001\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u9b54\u6cd5\u306e\u546a\u6587\u3092\u63cf\u304f\u3053\u3068\u3067\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4e00\u7dd2\u306b\u6226\u3046\u3002\n\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u304c\u4f5c\u3063\u305f\u30b7\u30f3\u30dc\u30eb\u3092\u8b58\u5225\u3057\u3001\u3059\u3050\u306b\u9069\u5207\u306a\u546a\u6587\u3092\u304b\u3051\u307e\u3059\u3002\nPVP\u3068PVE\u30e2\u30fc\u30c9\u30011v1\u30682v2\u306e\u6226\u95d8\u306f\u30b7\u30b9\u30c6\u30e0\u30de\u30c3\u30c1\u30f3\u30b0\u304c\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u3002"}, {"images": {"nodes": []}, "id": "1482385360252963", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# Une exp\u00e9rience MOBA unique en r\u00e9alit\u00e9 virtuelle\nWar of Wizards est un jeu MOBA en VR qui m\u00eale des m\u00e9canismes d'ex\u00e9cution uniques et la d\u00e9fense de tour pour une exp\u00e9rience in\u00e9dite.\n\n# Traduction de sort bas\u00e9e sur le dessin\nDans War of Wizards, la puissance de votre sort d\u00e9pend de la fa\u00e7on dont vous le dessinez. Le syst\u00e8me reconna\u00eet vos symboles et d\u00e9clenche imm\u00e9diatement le sort correspondant. Gr\u00e2ce aux astuces du jeu, concentrez-vous sur la strat\u00e9gie sans m\u00e9moriser les formes !\n{906388464687715}\n# Combat magique \u00e9pique, strat\u00e9gie PvP et PvE\nEn tant que sorcier, vous participez \u00e0 des batailles magiques o\u00f9 chaque action compte. D\u00e9fiez d'autres joueurs en PvP (1v1, 2v2) ou affrontez des adversaires en PvE. Le syst\u00e8me de matchmaking en PvP rend chaque bataille unique ! Construisez vos cartes magiques, adaptez-vous aux changements, et menez vos co\u00e9quipiers \u00e0 la victoire.\n{497297146525793}\n\n# Caract\u00e9ristiques principales :\n- Tower Defense exigeant rapidit\u00e9, strat\u00e9gie et leadership\n- Sorts d\u00e9clench\u00e9s par vos dessins\n- Puissance des sorts influenc\u00e9e par la taille et la pr\u00e9cision des symboles\n- Strat\u00e9gies vari\u00e9es gr\u00e2ce \u00e0 des pistes d'orthographe \u00e9quilibr\u00e9es\n- Modes PvP et PvE avec matchmaking en 1v1 et 2v2\n- Combats contre des \u00e9trangers, amis ou IA\n", "short_description": "Dessinez et utilisez votre magie ! Affine tes comp\u00e9tences magiques avec d'autres joueurs en VR ! !\n\nWar of Wizards est un jeu VR MOBA comp\u00e9titif dans lequel vous vous battez avec d'autres joueurs en dessinant des sorts magiques.\nLe syst\u00e8me reconna\u00eetra les symboles que vous avez cr\u00e9\u00e9s et lancera imm\u00e9diatement le sort correspondant.\nLes modes PVP et PVE, les combats 1v1 et 2v2 sont pris en charge par le syst\u00e8me de correspondance."}, {"images": {"nodes": []}, "id": "1481657446728335", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "pvp", "battle", "moba", "magic"], "long_description": "# \u7368\u7279\u7684\u865b\u64ec\u73fe\u5be6MOBA\u9ad4\u9a57\n\u300aWar of Wizards\u300b\u662f\u4e00\u6b3eVR MOBA\u904a\u6232\uff0c\u7d50\u5408\u4e86\u7368\u7279\u7684\u756b\u7b26\u65bd\u6cd5\u6a5f\u5236\u548c\u5854\u9632\uff0c\u5e36\u7d66\u4f60\u7368\u4e00\u7121\u4e8c\u7684VR\u9ad4\u9a57\u3002\n\n# \u756b\u51fa\u7b26\u6587\u91cb\u653e\u9b54\u6cd5\n\u5728\u300aWar of Wizards\u300b\u4e2d\uff0c\u4f60\u7684\u5492\u8a9e\u7684\u529b\u91cf\u53d6\u6c7a\u65bc\u4f60\u5982\u4f55\u4f7f\u7528\u5b83\uff01\u7cfb\u7d71\u6703\u8b58\u5225\u7e6a\u88fd\u7684\u7b26\u5492\uff0c\u7acb\u5373\u65bd\u653e\u76f8\u61c9\u7684\u5492\u8a9e\u3002\u904a\u6232\u4e2d\u6709\u6280\u80fd\u66f8\u63d0\u793a\uff0c\u4f60\u53ef\u4ee5\u5c08\u6ce8\u65bc\u6230\u9b25\u6230\u7565\uff0c\u800c\u4e0d\u9700\u8981\u8a18\u61b6\u5982\u4f55\u7e6a\u88fd\u7b26\u5492\uff01\n\n# \u53f2\u8a69\u9b54\u6cd5\u6230\u9b25\u3001\u6230\u7565PVP\u548cPVE\u904a\u6232\n\u4f5c\u70ba\u4e00\u540d\u5deb\u5e2b\u73a9\u5bb6\uff0c\u4f60\u5c07\u9032\u5165\u53f2\u8a69\u822c\u7684\u9b54\u6cd5\u6230\u9b25\uff0c\u6bcf\u4e00\u6b65\u90fd\u5f88\u91cd\u8981\u3002\u4f60\u53ef\u4ee5\u5728\u5373\u6642PVP\u6230\u9b25\u4e2d\u6311\u6230\u5176\u4ed6\u73a9\u5bb6\uff0c\u5305\u62ec1v1\u548c2v2\u6a21\u5f0f\uff0c\u6216\u8005\u5728PVE\u6a21\u5f0f\u4e2d\u6311\u6230AI\u5c0d\u624b\u3002\u5728PVP\u6a21\u5f0f\u4e0b\uff0c\u7cfb\u7d71\u6703\u70ba\u4f60\u5339\u914d\u7dda\u4e0a\u7684\u5c0d\u624b\u548c\u968a\u53cb\uff0c\u8b93\u6bcf\u4e00\u5834\u6230\u9b25\u90fd\u6210\u70ba\u65b0\u9bae\u523a\u6fc0\u7684\u6311\u6230\uff01\u7cbe\u5fc3\u6253\u9020\u4f60\u7684\u9b54\u6cd5\u7b26\u5492\u7d44\u5408\uff0c\u5feb\u901f\u53cd\u61c9\u6230\u5834\u4e0a\u7684\u8b8a\u5316\uff0c\u9069\u6642\u4f7f\u7528\u6700\u597d\u7684\u7b26\u5492\uff0c\u5e36\u9818\u4f60\u7684\u9b54\u6cd5\u6230\u968a\u8d70\u5411\u52dd\u5229\uff01\n{510390911853917}\n# \u4e3b\u8981\u7279\u6027:\n- \u5854\u9632\u985e\u7684\u904a\u6232\uff0c\u935b\u7149\u4f60\u7684\u5feb\u901f\u601d\u8003\u3001\u6230\u7565\u898f\u5283\u3001\u6642\u9593\u7ba1\u7406\u548c\u9818\u5c0e\u529b\n- \u7368\u7279\u7684\u756b\u7b26\u65bd\u6cd5\u6a5f\u5236\uff0c\u7531\u4f60\u7684\u7e6a\u88fd\u6c7a\u5b9a\u5492\u8a9e\n- \u53d7\u6240\u756b\u7b26\u5492\u7684\u5927\u5c0f\u548c\u7cbe\u78ba\u5ea6\u5f71\u97ff\u7684\u6280\u80fd\u5f37\u5ea6\n- \u5e73\u8861\u7684\u7b26\u5492\u7d44\u5408\uff0c\u53ef\u4ee5\u5617\u8a66\u5404\u7a2e\u7d44\u5408\u7b56\u7565\n- PVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6230\u9b25\u7531\u7cfb\u7d71\u5339\u914d\u652f\u6301\n- \u8207\u964c\u751f\u4eba\u3001\u670b\u53cb\u6216\u4eba\u5de5\u667a\u6167\u6a5f\u5668\u4eba\u5c0d\u6230\u7684\u9078\u9805\n{1077459393991123}", "short_description": "\u865b\u7a7a\u756b\u7b26\uff0c\u9b54\u6cd5\u5c0d\u6c7a\uff01\nWar of Wizards\u662f\u4e00\u6b3eMOBA\u5c0d\u6297\u7684 VR\u904a\u6232\uff0c\u5728\u904a\u6232\u4e2d\uff0c\u4f60\u901a\u904e\u7e6a\u88fd\u9b54\u6cd5\u5492\u8a9e\u8207\u5176\u4ed6\u73a9\u5bb6\u4e00\u8d77\u6230\u9b25\u3002\n\u7cfb\u7d71\u6703\u8b58\u5225\u4f60\u5275\u9020\u7684\u7b26\u5492\uff0c\u4e26\u7acb\u5373\u65bd\u653e\u76f8\u61c9\u7684\u5492\u8a9e\u3002\nPVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6230\u9b25\u7531\u7cfb\u7d71\u5339\u914d\u652f\u6301\u3002"}, {"images": {"nodes": []}, "id": "1395256502612184", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# Experiencia MOBA de realidad virtual \u00fanica\nWar of Wizards es un juego VR MOBA que combina una mec\u00e1nica de hechizos \u00fanica con defensa de torres para ofrecerte una experiencia VR inigualable.\n\n# Traducci\u00f3n ortogr\u00e1fica basada en dibujos\nEn War of Wizards, el poder de tus hechizos depende de c\u00f3mo los dibujes. El sistema reconoce los s\u00edmbolos y lanza inmediatamente el hechizo correspondiente. Gracias a los consejos del juego, puedes centrarte en la estrategia sin memorizar formas ortogr\u00e1ficas.\n{1611032036494315}\n# Combate m\u00e1gico \u00e9pico, estrategia PvP y PvE\nComo mago, participar\u00e1s en batallas \u00e9picas donde cada movimiento cuenta. Puedes desafiar a otros jugadores en PvP en tiempo real (modos 1v1 y 2v2) o enfrentarte a IA en PvE. El sistema de emparejamiento en PvP asegura que cada batalla sea un reto \u00fanico. Construye tus cartas m\u00e1gicas con cuidado, reacciona r\u00e1pido a los cambios y lleva a tu equipo a la victoria.\n{859289829642171}\n# Principales caracter\u00edsticas:\n- Tower Defense que premia el pensamiento r\u00e1pido, la planificaci\u00f3n estrat\u00e9gica y el liderazgo\n- Hechizos \u00fanicos basados en los dibujos realizados\n- Magia influenciada por el tama\u00f1o y precisi\u00f3n de los s\u00edmbolos\n- Estrategias variadas con pistas de hechizos equilibradas\n- Modos de combate PvP y PvE, 1v1 y 2v2, con emparejamiento autom\u00e1tico\n- Combate contra extra\u00f1os, amigos o IA\n\n", "short_description": "\u00a1Dibuja y ejecute su magia! \u00a1Aprovecha tus habilidades m\u00e1gicas con otros jugadores en VR! !\nWar of Wizards es un juego competitivo de VR MOBA en el que luchas junto a otros jugadores dibujando hechizos m\u00e1gicos.\nEl sistema reconoce los s\u00edmbolos que has creado e inmediatamente lanza el hechizo correspondiente.\nLos modos PvP y PvE, los combates 1v1 y 2v2 son compatibles con el sistema de emparejamiento."}, {"images": {"nodes": []}, "id": "921388953811213", "locale": "zh_HK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# \u7368\u7279\u7684\u865b\u64ec\u73fe\u5be6MOBA\u9ad4\u9a57\n\u300aWar of Wizards\u300b\u662f\u4e00\u6b3eVR MOBA\u904a\u6232\uff0c\u7d50\u5408\u4e86\u7368\u7279\u7684\u756b\u7b26\u65bd\u6cd5\u6a5f\u5236\u548c\u5854\u9632\uff0c\u5e36\u7d66\u4f60\u7368\u4e00\u7121\u4e8c\u7684VR\u9ad4\u9a57\u3002\n\n# \u756b\u51fa\u7b26\u6587\u91cb\u653e\u9b54\u6cd5\n\u5728\u300aWar of Wizards\u300b\u4e2d\uff0c\u4f60\u7684\u5492\u8a9e\u7684\u529b\u91cf\u53d6\u6c7a\u65bc\u4f60\u5982\u4f55\u4f7f\u7528\u5b83\uff01\u7cfb\u7d71\u6703\u8b58\u5225\u7e6a\u88fd\u7684\u7b26\u5492\uff0c\u7acb\u5373\u65bd\u653e\u76f8\u61c9\u7684\u5492\u8a9e\u3002\u904a\u6232\u4e2d\u6709\u6280\u80fd\u66f8\u63d0\u793a\uff0c\u4f60\u53ef\u4ee5\u5c08\u6ce8\u65bc\u6230\u9b25\u6230\u7565\uff0c\u800c\u4e0d\u9700\u8981\u8a18\u61b6\u5982\u4f55\u7e6a\u88fd\u7b26\u5492\uff01\n\n# \u53f2\u8a69\u9b54\u6cd5\u6230\u9b25\u3001\u6230\u7565PVP\u548cPVE\u904a\u6232\n\u4f5c\u70ba\u4e00\u540d\u5deb\u5e2b\u73a9\u5bb6\uff0c\u4f60\u5c07\u9032\u5165\u53f2\u8a69\u822c\u7684\u9b54\u6cd5\u6230\u9b25\uff0c\u6bcf\u4e00\u6b65\u90fd\u5f88\u91cd\u8981\u3002\u4f60\u53ef\u4ee5\u5728\u5373\u6642PVP\u6230\u9b25\u4e2d\u6311\u6230\u5176\u4ed6\u73a9\u5bb6\uff0c\u5305\u62ec1v1\u548c2v2\u6a21\u5f0f\uff0c\u6216\u8005\u5728PVE\u6a21\u5f0f\u4e2d\u6311\u6230AI\u5c0d\u624b\u3002\u5728PVP\u6a21\u5f0f\u4e0b\uff0c\u7cfb\u7d71\u6703\u70ba\u4f60\u5339\u914d\u7dda\u4e0a\u7684\u5c0d\u624b\u548c\u968a\u53cb\uff0c\u8b93\u6bcf\u4e00\u5834\u6230\u9b25\u90fd\u6210\u70ba\u65b0\u9bae\u523a\u6fc0\u7684\u6311\u6230\uff01\u7cbe\u5fc3\u6253\u9020\u4f60\u7684\u9b54\u6cd5\u7b26\u5492\u7d44\u5408\uff0c\u5feb\u901f\u53cd\u61c9\u6230\u5834\u4e0a\u7684\u8b8a\u5316\uff0c\u9069\u6642\u4f7f\u7528\u6700\u597d\u7684\u7b26\u5492\uff0c\u5e36\u9818\u4f60\u7684\u9b54\u6cd5\u6230\u968a\u8d70\u5411\u52dd\u5229\uff01\n{2605825769621980}\n# \u4e3b\u8981\u7279\u6027:\n- \u5854\u9632\u985e\u7684\u904a\u6232\uff0c\u935b\u7149\u4f60\u7684\u5feb\u901f\u601d\u8003\u3001\u6230\u7565\u898f\u5283\u3001\u6642\u9593\u7ba1\u7406\u548c\u9818\u5c0e\u529b\n- \u7368\u7279\u7684\u756b\u7b26\u65bd\u6cd5\u6a5f\u5236\uff0c\u7531\u4f60\u7684\u7e6a\u88fd\u6c7a\u5b9a\u5492\u8a9e\n- \u53d7\u6240\u756b\u7b26\u5492\u7684\u5927\u5c0f\u548c\u7cbe\u78ba\u5ea6\u5f71\u97ff\u7684\u6280\u80fd\u5f37\u5ea6\n- \u5e73\u8861\u7684\u7b26\u5492\u7d44\u5408\uff0c\u53ef\u4ee5\u5617\u8a66\u5404\u7a2e\u7d44\u5408\u7b56\u7565\n- PVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6230\u9b25\u7531\u7cfb\u7d71\u5339\u914d\u652f\u6301\n- \u8207\u964c\u751f\u4eba\u3001\u670b\u53cb\u6216\u4eba\u5de5\u667a\u6167\u6a5f\u5668\u4eba\u5c0d\u6230\u7684\u9078\u9805\n{553729827314446}", "short_description": "\u865b\u7a7a\u756b\u7b26\uff0c\u9b54\u6cd5\u5c0d\u6c7a\uff01\nWar of Wizards\u662f\u4e00\u6b3eMOBA\u5c0d\u6297\u7684 VR\u904a\u6232\uff0c\u5728\u904a\u6232\u4e2d\uff0c\u4f60\u901a\u904e\u7e6a\u88fd\u9b54\u6cd5\u5492\u8a9e\u8207\u5176\u4ed6\u73a9\u5bb6\u4e00\u8d77\u6230\u9b25\u3002\n\u7cfb\u7d71\u6703\u8b58\u5225\u4f60\u5275\u9020\u7684\u7b26\u5492\uff0c\u4e26\u7acb\u5373\u65bd\u653e\u76f8\u61c9\u7684\u5492\u8a9e\u3002\nPVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6230\u9b25\u7531\u7cfb\u7d71\u5339\u914d\u652f\u6301\u3002\n"}, {"images": {"nodes": []}, "id": "895104369992884", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# Experiencia MOBA de realidad virtual \u00fanica\nWar of Wizards es un juego VR MOBA que combina una mec\u00e1nica de hechizos \u00fanica con defensa de torres para ofrecerte una experiencia VR inigualable.\n\n# Traducci\u00f3n ortogr\u00e1fica basada en dibujos\nEn War of Wizards, el poder de tus hechizos depende de c\u00f3mo los dibujes. El sistema reconoce los s\u00edmbolos y lanza inmediatamente el hechizo correspondiente. Gracias a los consejos del juego, puedes centrarte en la estrategia sin memorizar formas ortogr\u00e1ficas.\n{883826009918652}\n# Combate m\u00e1gico \u00e9pico, estrategia PvP y PvE\nComo mago, participar\u00e1s en batallas \u00e9picas donde cada movimiento cuenta. Puedes desafiar a otros jugadores en PvP en tiempo real (modos 1v1 y 2v2) o enfrentarte a IA en PvE. El sistema de emparejamiento en PvP asegura que cada batalla sea un reto \u00fanico. Construye tus cartas m\u00e1gicas con cuidado, reacciona r\u00e1pido a los cambios y lleva a tu equipo a la victoria.\n{1216402759482920}\n# Principales caracter\u00edsticas:\n- Tower Defense que premia el pensamiento r\u00e1pido, la planificaci\u00f3n estrat\u00e9gica y el liderazgo\n- Hechizos \u00fanicos basados en los dibujos realizados\n- Magia influenciada por el tama\u00f1o y precisi\u00f3n de los s\u00edmbolos\n- Estrategias variadas con pistas de hechizos equilibradas\n- Modos de combate PvP y PvE, 1v1 y 2v2, con emparejamiento autom\u00e1tico\n- Combate contra extra\u00f1os, amigos o IA\n\n", "short_description": "\u00a1Dibuja y ejecute su magia! \u00a1Aprovecha tus habilidades m\u00e1gicas con otros jugadores en VR! !\nWar of Wizards es un juego competitivo de VR MOBA en el que luchas junto a otros jugadores dibujando hechizos m\u00e1gicos.\nEl sistema reconoce los s\u00edmbolos que has creado e inmediatamente lanza el hechizo correspondiente.\nLos modos PvP y PvE, los combates 1v1 y 2v2 son compatibles con el sistema de emparejamiento.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.warofwizardsvr.com/game_privacy.html", "developer_terms_of_service_url": "http://www.warofwizardsvr.com/game_eula.html", "publisher_name": "Arcane Miracle Entertainment", "support_website_url": null, "website_url": "http://www.warofwizardsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es", "fr", "ja", 
2508257761801_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=124zUwEIw1oQ7kNvwEycXTE&_nc_oc=AdoY9fuf0opw8CRlyPlfqrR-8xTe4jp5C5PEb8wijERJ1yNQs7SuBXfmqr3ZKFrONkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuvwQlRPjn9UEjAuNw0mfV3md5lkxaYe3KRYIyqtbb5Q&oe=69CFBB34"}, {"file_name": "11.png", "id": "464666675611140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75272216_464666678944473_5500089804967371540_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNICK9jnKtsQ7kNvwHuwu78&_nc_oc=Adr_5f1CeQaP3k2G-K0yOs3SXA6M04VkFRD9qnktNUDFLayHli58_nWkb-L8DbVwPko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHl5YjlSADrrDeYa7gNJ34oF-SE5W6gE91FZfwD6NSvQ&oe=69CFBC80"}, {"file_name": "3.png", "id": "5574726782607145", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031510_5574726785940478_1985816967095681989_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KALeU1x3RO4Q7kNvwFGsn2t&_nc_oc=AdqSGIAPqCGko0Y3rybN_lwVa5KlyHwEOx9buD7NDaJYJxF6my5zSAqZa9OSp0XF8p4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKkqhmygyct7R8ZQum8A0E7XEtE9oboZI0kMsO-PWnsQ&oe=69CFA9BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "612966413832998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974560_612966417166331_4326765418550343614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGlG70qdi-kQ7kNvwFHsq5C&_nc_oc=AdreaJHIdIrgUeLS_RFa160tKXO9M0AvBRg34FsmvX8_x8wIN6L_x_47TiOEgfKyqPo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtJ8pBE28VbpDO4w0VrB0CNmxO19X7PMNamN0tW4qLDg&oe=69CFB2D2"}, "display_name": "War of Wizards", "keywords": [], "long_description": "Draw & cast your spells, magic showdown! War of Wizards is a VR game with MOBA confrontation.\n\nDraw dragons to summon dragons to fight for you, draw fireballs to summon fireballs to shoot at enemies, draw pills to heal yourself...\nYou can cast different spells by drawing different patterns, and the accuracy and size of the spells you make will affect the damage and range of the spells you cast.\n\nIt's a game that uses both your reflexes and your strategy skills.\nThe spells you choose to use depends on your judgment of the enemy player and what strategy you plan to use to achieve victory.\nYou can also dodge attacks flying towards you by dodging your body.\nLead your minions to victory against the enemy!\n\nFeatures:\n\n- PVP MOBA!\n- Draw & cast your spells!\n- Dodge the skills that the enemy fires at you!\n- Use strategy to lead minions to destroy enemy magic crystals!\n", "short_description": "Draw & cast your spells, magic showdown! War of Wizards is a VR game with MOBA confrontation.\n\nDraw dragons to summon dragons to fight for you, draw fireballs to summon fireballs to shoot at enemies, draw pills to heal yourself...\nYou can cast different spells by drawing different patterns, and the accuracy and size of the spells you make will affect the damage and range of the spells you cast.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.warofwizardsvr.com/game_privacy.html", "developer_terms_of_service_url": "http://www.warofwizardsvr.com/game_eula.html", "publisher_name": "Arcane Miracle Entertainment", "support_website_url": null, "website_url": "http://www.warofwizardsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
{"data": {"node": {"__typename": "Application", "id": "7865834933488042", "organization": {"id": "149029764464957", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9665456710187837"}]}, "id": "4110658555922772"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7865834933488042"}]}, "id": "594249895637449"}]}}, "firstRevision": {"nodes": [{"application": {"id": "7865834933488042", "release_date": 1727974800, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 13}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34390253283952846"}, "id": "522929719599990"}]}}, "binary": null, "live_binary": null, "created_date": 1771984301, "id": "34022235294087982", "is_initial_release": false, "name_with_fallback": "v47", "pdp_metadata_with_fallback": {"version": 28, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "34022294627415382"}, "release_status": "RELEASED", "id": "7865834933488042"}, "id": "34022294627415382", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7865834933488042", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "399417478945329"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1740223170287969", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# \u72ec\u7279\u7684\u865a\u62df\u73b0\u5b9eMOBA\u4f53\u9a8c\n\u300aWar of Wizards\u300b\u662f\u4e00\u6b3eVR MOBA\u6e38\u620f\uff0c\u7ed3\u5408\u4e86\u72ec\u7279\u7684\u753b\u7b26\u65bd\u6cd5\u673a\u5236\u548c\u5854\u9632\uff0c\u5e26\u7ed9\u4f60\u72ec\u4e00\u65e0\u4e8c\u7684VR\u4f53\u9a8c\u3002\n\n# \u753b\u51fa\u7b26\u6587\u91ca\u653e\u9b54\u6cd5\n\u5728\u300aWar of Wizards\u300b\u4e2d\uff0c\u4f60\u7684\u5492\u8bed\u7684\u529b\u91cf\u53d6\u51b3\u4e8e\u4f60\u5982\u4f55\u4f7f\u7528\u5b83\uff01\u7cfb\u7edf\u4f1a\u8bc6\u522b\u7ed8\u5236\u7684\u7b26\u5492\uff0c\u7acb\u5373\u65bd\u653e\u76f8\u5e94\u7684\u5492\u8bed\u3002\u6e38\u620f\u4e2d\u6709\u6280\u80fd\u4e66\u63d0\u793a\uff0c\u4f60\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u6218\u6597\u6218\u7565\uff0c\u800c\u4e0d\u9700\u8981\u8bb0\u5fc6\u5982\u4f55\u7ed8\u5236\u7b26\u5492\uff01\n\n# \u53f2\u8bd7\u9b54\u6cd5\u6218\u6597\u3001\u6218\u7565PVP\u548cPVE\u6e38\u620f\n\u4f5c\u4e3a\u4e00\u540d\u5deb\u5e08\u73a9\u5bb6\uff0c\u4f60\u5c06\u8fdb\u5165\u53f2\u8bd7\u822c\u7684\u9b54\u6cd5\u6218\u6597\uff0c\u6bcf\u4e00\u6b65\u90fd\u5f88\u91cd\u8981\u3002\u4f60\u53ef\u4ee5\u5728\u5b9e\u65f6PVP\u6218\u6597\u4e2d\u6311\u6218\u5176\u4ed6\u73a9\u5bb6\uff0c\u5305\u62ec1v1\u548c2v2\u6a21\u5f0f\uff0c\u6216\u8005\u5728PVE\u6a21\u5f0f\u4e2d\u6311\u6218AI\u5bf9\u624b\u3002\u5728PVP\u6a21\u5f0f\u4e0b\uff0c\u7cfb\u7edf\u4f1a\u4e3a\u4f60\u5339\u914d\u7ebf\u4e0a\u7684\u5bf9\u624b\u548c\u961f\u53cb\uff0c\u8ba9\u6bcf\u4e00\u573a\u6218\u6597\u90fd\u6210\u4e3a\u65b0\u9c9c\u523a\u6fc0\u7684\u6311\u6218\uff01\u7cbe\u5fc3\u6253\u9020\u4f60\u7684\u9b54\u6cd5\u7b26\u5492\u7ec4\u5408\uff0c\u5feb\u901f\u53cd\u5e94\u6218\u573a\u4e0a\u7684\u53d8\u5316\uff0c\u9002\u65f6\u4f7f\u7528\u6700\u597d\u7684\u7b26\u5492\uff0c\u5e26\u9886\u4f60\u7684\u9b54\u6cd5\u6218\u961f\u8d70\u5411\u80dc\u5229\uff01\n{724796903169734}\n# \u4e3b\u8981\u7279\u6027:\n- \u5854\u9632\u7c7b\u7684\u6e38\u620f\uff0c\u953b\u70bc\u4f60\u7684\u5feb\u901f\u601d\u8003\u3001\u6218\u7565\u89c4\u5212\u3001\u65f6\u95f4\u7ba1\u7406\u548c\u9886\u5bfc\u529b\n- \u72ec\u7279\u7684\u753b\u7b26\u65bd\u6cd5\u673a\u5236\uff0c\u7531\u4f60\u7684\u7ed8\u5236\u51b3\u5b9a\u5492\u8bed\n- \u53d7\u6240\u753b\u7b26\u5492\u7684\u5927\u5c0f\u548c\u7cbe\u786e\u5ea6\u5f71\u54cd\u7684\u6280\u80fd\u5f3a\u5ea6\n- \u5e73\u8861\u7684\u7b26\u5492\u7ec4\u5408\uff0c\u53ef\u4ee5\u5c1d\u8bd5\u5404\u79cd\u7ec4\u5408\u7b56\u7565\n- PVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6218\u6597\u7531\u7cfb\u7edf\u5339\u914d\u652f\u6301\n- \u4e0e\u964c\u751f\u4eba\u3001\u670b\u53cb\u6216\u4eba\u5de5\u667a\u80fd\u673a\u5668\u4eba\u5bf9\u6218\u7684\u9009\u9879\n{1277931323366043}", "short_description": "\u865a\u7a7a\u753b\u7b26\uff0c\u9b54\u6cd5\u5bf9\u51b3\uff01\nWar of Wizards\u662f\u4e00\u6b3eMOBA\u5bf9\u6297\u7684 VR\u6e38\u620f\uff0c\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u901a\u8fc7\u7ed8\u5236\u9b54\u6cd5\u5492\u8bed\u4e0e\u5176\u4ed6\u73a9\u5bb6\u4e00\u8d77\u6218\u6597\u3002\n\u7cfb\u7edf\u4f1a\u8bc6\u522b\u4f60\u521b\u9020\u7684\u7b26\u5492\uff0c\u5e76\u7acb\u5373\u65bd\u653e\u76f8\u5e94\u7684\u5492\u8bed\u3002\nPVP\u548cPVE\u6a21\u5f0f\uff0c1v1\u548c2v2\u6218\u6597\u7531\u7cfb\u7edf\u5339\u914d\u652f\u6301\u3002"}, {"images": {"nodes": []}, "id": "1569269300818650", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "War of Wizards", "keywords": ["rpg", "battle", "pvp", "moba", "magic"], "long_description": "# Einzigartiges Virtual Reality MOBA-Erlebnis\nWar of Wizards ist ein VR MOBA-Spiel, das innovative Zaubermechanismen mit Tower Defense kombiniert und Ihnen ein einzigartiges VR-Erlebnis bietet.\n\n# Grafikbasierte Zauberanwendung\nIn War of Wizards h\u00e4ngt die St\u00e4rke Ihrer Zauber davon ab, wie Sie sie zeichnen! Das System erkennt die erstellten Symbole und wendet sofort den entsprechenden Zauber an. Dank Ingame-Tipps k\u00f6nnen Sie sich auf die Strategie konzentrieren, ohne sich Zauberformen merken zu m\u00fcssen.\n{513309048151425}\n# Epische Magie-Schlachten, PvP- und PvE-Strategie\nAls Zauberer nehmen Sie an epischen magischen Schlachten teil, in denen jeder Schritt z\u00e4hlt. Fordern Sie andere Spieler in Echtzeit-PvP-K\u00e4mpfen heraus (1v1, 2v2) oder stellen Sie sich KI-Gegnern im PvE-Modus. Das PvP-Matchmaking sorgt daf\u00fcr, dass jeder Kampf eine neue Herausforderung darstellt! Bauen Sie Ihre Zauberkarten klug auf, reagieren Sie schnell auf Schlachtfeldver\u00e4nderungen und f\u00fchren Sie Ihr Team zum Sieg.\n{1443923172949001}\n# Hauptmerkmale:\n- Tower Defense, das schnelles Denken, Strategie und F\u00fchrungsf\u00e4higkeiten belohnt\n- Einzigartige Zaubermechanismen basierend auf Ihren Zeichnungen\n- Magie, die durch Gr\u00f6\u00dfe und Pr\u00e4zision der Symbole beeinflusst wird\n- Ausgewogene Zauberspuren f\u00fcr verschiedene Strategien\n- PvP- und PvE-Modi, 1v1 und 2v2, unterst\u00fctzt durch Matchmaking\n- K\u00e4mpfe gegen Fremde, Freunde oder KI\n\n", "short_description": "Zeichne und verwende deine Magie! Sch\u00e4rfe deine magischen F\u00e4higkeiten mit anderen Spielern in VR! !\n\nWar of Wizards ist ein Wettkampf-VR-MOBA-Spiel, in dem Sie gegen andere Spieler k\u00e4mpfen, indem Sie magische Zauberspr\u00fcche zeichnen.\nDas System erkennt die Symbole, die Sie erstellt haben, und wendet sofort den entsprechenden Zauber an.\nDie PvP- und PvE-Modi, 1v1 und 2v2 Kampf werden von Systemmatch unterst\u00fctzt."}, {"images": {"nodes": [{"file_name": "logo.png", "id": "5394586320605080", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974920_5394586323938413_1277775666128324382_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciPDIVrSF4kQ7kNvwH_D1eZ&_nc_oc=AdqAqnApnQE-ayYKLul9FjS9ylzsV-BOru_6eaJcKxhfnrmGATQ8OrKEBEhi-geXxSA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx9YEYy7bX183wkSGYfgL8y5NqFAZ8frb8WYkZxLxgzQ&oe=69CFD574"}, {"file_name": "portrait.png", "id": "3884977935128143", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618064_38849
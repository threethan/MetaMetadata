xGQgeZPI-CBlFUvQuIMcGSmKNR0b3_FDO8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzFKVS7al4scMLOtKdNJYLDOL7aTNvdFExv1ZhqsXkNw&oe=6A7348EC"}, {"file_name": "Screenshot_Startroom_A_02.png", "id": "326516959331196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035388_326516962664529_3297886005740334078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JSPOSyiGmQQ7kNvwHsX359&_nc_oc=AdrXFuOauCg0prfQvzUJ940zfBNqETEU2D84wpsheX9vv9qDVFhFW9VSwDPsN8xUyUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqPro7Q1RPsHCGvoB-7Y3yEBtYsGk9n9G8Ei-2-WNNOA&oe=6A733789"}, {"file_name": "Screenshot_StichgangBelle_A_02.png", "id": "608858426841573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_608858430174906_2600919328073995788_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9wqYtqg7GwQ7kNvwFjrxwp&_nc_oc=Adr3AnL1nM7o3hLyKBuy1EFpwKnyJLxudqGWLig9Ve6_GDZVvQY_8lxxSXn8ABdXY6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESSxUqEb7gTiKXfX0JBRbxVcVxrOa2iZ95nFzz8lV1Bg&oe=6A734CD8"}, {"file_name": "Screenshot_Rose_A_01.png", "id": "338937091152635", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_338937097819301_7495403605620351691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZbSQ98gQgMQ7kNvwGZwWVd&_nc_oc=Adq6sdkuxolgNy2d9-Wte015ZRWPtShCG8-Kqo3RHOsnLKSbn5KyrTijT6qjwN8hcT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp3e67jJJGcavxHbPP0M4Luw3o5lGis1wJCeqa3T9AAQ&oe=6A7334A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WalkEat-Teaser_v2_04_normalized_thumbnail.png", "id": "473000464364992", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031383_473000467698325_3576075146764866845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1wBLACkgjMQ7kNvwFxUU0G&_nc_oc=Adq7gKgJZcW_mAWjdE_uL0cYedWAi2RLKVm4bYtCouR2moAG4W4nAfBX4fGP5W3m_e8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6nxY-DIq_sgAOQNCa8c4hN2vChjGbB9cO56c9C9DN4Q&oe=6A7329CA"}, "display_name": "Insomnia", "keywords": ["horror", "backrooms", "jumpscare", "blink", "creature"], "long_description": "An ***eerie*** VR experience about a ***hauting creature that never seems to move***, yet follows you through the unsettling corridors of an abandoned hotel. Worse still, your vision blurs as your eyes grow heavy, forcing you to blink more often than you'd prefer ... \n\nInsomnia is perfect for ***solo thrills*** or as a ***party experience***. Hand over the headset and watch as your friends confront the creature and attempt their escape, knowing that every blink could be their last.\n\nWith ***high-fidelity graphics*** and effects, immersive soundscapes, and ***Application Spacewarp optimization*** this short VR experience pushes your device\u2019s performance.", "short_description": "Haunted by an unmoving creature. Blink, and it inches closer. Hold your gaze to survive \u2014 will you find the way out before it closes in?"}]}, "developer_name": "Krakentanz", "developer_privacy_policy_url": "https://krakentanz.com/games/insomnia/ins-legal.html", "developer_terms_of_service_url": null, "publisher_name": "Krakentanz", "support_website_url": null, "website_url": "http://www.krakentanz.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266005231
IOJtdqxnP3JNhBpNyPCyth1G-olEG6_RKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4L-QdfTxLdEydro2Oj3EtGDSBM35LjAeZdFYJVpPV_Q&oe=6AE206EC"}, {"file_name": "Screenshot_Startroom_A_02.png", "id": "326516959331196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035388_326516962664529_3297886005740334078_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRDNW9dctTUQ7kNvwH2YdR9&_nc_oc=AdoNykENqTsLiKkLN7DMx8CVUYkAdSR44S_pxKm1-OWgh7qptoZWhfq_I4FynvO2HPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfuYP3LwpLONrmriPLDQKOukBbG4ghkX647dtPRdSUVA&oe=6AE1F589"}, {"file_name": "Screenshot_StichgangBelle_A_02.png", "id": "608858426841573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_608858430174906_2600919328073995788_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knoBJqqbpLoQ7kNvwFKG8zM&_nc_oc=AdrjDb5J8DmztxaisBiVrka-nLrd76P2Mt2lEZhK8h23VS2wVNAaXJLV8Y3EjiuXHcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUHXmTyNapBPnZ9OWyF7efpVDQxYKpFHHD5XTdsh9HYA&oe=6AE20AD8"}, {"file_name": "Screenshot_Rose_A_01.png", "id": "338937091152635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_338937097819301_7495403605620351691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNJbpnuTYGUQ7kNvwH1GJo8&_nc_oc=Adrwbygvn72VlPCZ8qhh9xewSgyYuLtC6nZtrJXRS-NuKycnDZQEVItCxgOB9KEX2sY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsY52vYVL1rZs8QZs_cGzGOonHPR8NpRuQnpYNlxW6_Q&oe=6AE1F2A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WalkEat-Teaser_v2_04_normalized_thumbnail.png", "id": "473000464364992", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031383_473000467698325_3576075146764866845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBRT0pal7vAQ7kNvwFTbamv&_nc_oc=AdpKT3hGdX-LzB16HagVrhpuglDO4L5JH6kgz3OD81C6SGw4oYUJwZI-apzJ7Emsl2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvzPaBokHPrz3FMxV6mzS_2W3ZRHchqdTUjJfI1XWosQ&oe=6AE1E7CA"}, "display_name": "Insomnia", "keywords": ["horror", "backrooms", "jumpscare", "blink", "creature"], "long_description": "An ***eerie*** VR experience about a ***hauting creature that never seems to move***, yet follows you through the unsettling corridors of an abandoned hotel. Worse still, your vision blurs as your eyes grow heavy, forcing you to blink more often than you'd prefer ... \n\nInsomnia is perfect for ***solo thrills*** or as a ***party experience***. Hand over the headset and watch as your friends confront the creature and attempt their escape, knowing that every blink could be their last.\n\nWith ***high-fidelity graphics*** and effects, immersive soundscapes, and ***Application Spacewarp optimization*** this short VR experience pushes your device\u2019s performance.", "short_description": "Haunted by an unmoving creature. Blink, and it inches closer. Hold your gaze to survive \u2014 will you find the way out before it closes in?"}]}, "developer_name": "Krakentanz", "developer_privacy_policy_url": "https://krakentanz.com/games/insomnia/ins-legal.html", "developer_terms_of_service_url": null, "publisher_name": "Krakentanz", "support_website_url": null, "website_url": "http://www.krakentanz.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "266005231
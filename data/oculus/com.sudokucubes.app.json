Q4LqON3raOGSOnhxOxWOMWtOfhAsoTrK9Ob-7AIFqKX2wz6U7mpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfNtPbMTU-sU8srLxd0cWcLL0DT1tJyknbX2d7fkV6NQ&oe=6AFB1EFF"}, {"file_name": "2-solving.png", "id": "1153625577332955", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/754914855_1153625580666288_7167338870159604524_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYvtiWrjWtYQ7kNvwF2IlO9&_nc_oc=AdoT1lekgcgLbbU_IIVVHoiUmTypGOqgRjdiKd3CedaDnp9PnojR_r0xO4n3QbDdr00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSZ1jsH8fIInRu-Ba5x4z4p8yjqJfyhVsmyUVvTRHI-A&oe=6AFB291D"}, {"file_name": "3-home.png", "id": "1414939540822989", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831279_1414939544156322_8131980248896105572_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L-BC9cQ0UkQ7kNvwF50vBO&_nc_oc=AdpTjIfTtSJyDjjKFlP8DzO5ShmNu6KGC7f5qBTjtJoCtzoQfakIg1ZBKct9KFlnjxM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1N219XG4aK8c0ElwvTw7P13Pjb_PMke7reF_ocS97nA&oe=6AFB3C7D"}, {"file_name": "4-levels.png", "id": "938386345764683", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604375581_938386352431349_3248037284680847517_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyxJ1ZwXLQAQ7kNvwH8h6tN&_nc_oc=AdoDYZNhTht0Mn5C7MWgDhxaQTar-dxuBVgCl5dBtnr0TMh_uOmBnY-HeMnV7nW7lhE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLT-EKeYt4r8Y3SgznWnsoQTaDq4kXsRVoeYWdieKrpA&oe=6AFB334E"}, {"file_name": "5-badges.png", "id": "2717801382005850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673573223_2717801385339183_2172481645504649356_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aatfOvUCLoQ7kNvwFHwybI&_nc_oc=Adp16tCIlmhIc3WfZ3xr2PPJEwj5yfBqK1z1Vfk5BYGTpAnRMnVJ0o3EgFtgZIuMdIE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhQ3PN0wEckIfg2SIoj2UdMx8FXsYhoLiO9Uh7hhS99w&oe=6AFB3C51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sudoku Cubes", "keywords": ["sudoku", "puzzle", "relaxing", "logic", "cube"], "long_description": "You've solved a thousand sudokus. Never one like this.\n\nOnce you know the tricks, flat sudoku runs on autopilot. Sudoku Cubes wraps six puzzles around one cube that floats in your own room and links them at the edges, so every face you crack hands you clues for the next. Turn the cube, follow the chain, and feel that first-time aha again.\n\nTHE ANSWER'S AROUND THE CORNER\nEach face is a classic 9\u00d79 sudoku. Where faces meet, cells that touch across an edge must differ, and the three cells at a corner must all be different. A face that looks stuck often isn't: its clue is waiting next door.\n\nA LEVEL FOR EVERY MOOD\n\u2022 Easy: a cup-of-tea solve while you learn the edges.\n\u2022 Medium: a satisfying daily workout.\n\u2022 Hard: for when regular sudoku stopped being hard.\n\u2022 Ultra Hard: long chains of logic around the whole cube.\nEvery puzzle has one solution, reachable by logic alone. No guessing.\n\nMADE FOR YOUR ROOM\n\u2022 The puzzle sits in your space while your room stays around you.\n\u2022 Pinch and drag to roll the cube with bare hands or Touch controllers; let go and it settles on the nearest face.\n\u2022 Play seated or standing, offline, at your own pace.\n\u2022 Hints teach the next step, notes tidy themselves, and undo goes as far back as you like.\n\u2022 Soft pencil ticks, kalimba chimes, and a fanfare when the cube comes together.\n\nFAIR AND SIMPLE\n80 free cubes, over 80 hours' worth. Unlock all 2,000 with one purchase, yours for good. No ads, no sign-up, no subscription, no tracking.", "short_description": "You've solved a thousand sudokus. Never one like this. Six classic puzzles wrap around one cube floating in your room, stitched together at the edges, so every face you crack hands you clues for the next. Reach out, turn the cube, and feel that first-time aha again. Calm, hand-drawn, and never interrupted by an ad. 80 free cubes, over 80 hours' worth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sudokucubes.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ayllon Labs", "support_website_url": "https://sudokucubes.com/support.html", "website_url": "https://sudokucubes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399039603291642"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28734149719611966"}]}, "baseline_offer": {"id": "28734149719611966"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793397600, "status": "PUBLISHED", "id": "28734149719611966"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1432235783305357", "version": "1.4.0"}, "id": "1838076004557565", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1399039599958309", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1432235783305357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_
x0N_82caMK1Xz8_9L_Jy7yQGMWMZx6nzw&oe=69F1FC1E"}, {"file_name": "ScreenShot00.png", "id": "374672787296456", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031656_374672790629789_3465339864124643415_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36r_mJga3AEQ7kNvwEm4Vq4&_nc_oc=Ado03DCp1Wb954E_MnTtRkKpUuE2-Y0YeTxZua2x-fqUiHsig3i4Rnuu9fnFI4SZgT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1IHEYbVQOU1qdH_YE3PM7C9fGa4jFVIGigemh57toiag&oe=69F216B3"}, {"file_name": "CoverLandscape.png", "id": "785904978982544", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572941_785904982315877_8537425924808949631_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noKB7yVk_24Q7kNvwH5DVAi&_nc_oc=AdrsuGbc55GHlME36_USHqw5vH1CK_3A9NcVz-v8Tbw_bWFl2d2eLZ8MHrwbXkObGQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qUxVJXbIfJeZlZv76NyfarB4sPiGWPud_OQAzzq8leA&oe=69F20197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e0\u30fc\u30d3\u30fc\u306e\u30b5\u30e0\u30cd.png", "id": "897552224139259", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75435282_897552227472592_4859223191107329569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuegDxV09RIQ7kNvwHPTpfg&_nc_oc=AdqXIp0O2eiE9ItN-jFGrKtPQe6zTH35M6zDrOjAWOzSkd41DUqINu0FCKqeKz7eJx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0uQ0T_XqmO8cG9MRT-XAZsB5EXzInyedsT6BUtsXvhfQ&oe=69F21AE3"}, "display_name": "ModernArcheryVR", "keywords": [], "long_description": "An old Chinese poet said,. Ideas come up when you're riding a horse, sleeping, or defecating.\nGood ideas come when you're focused on something else. Also, it's better to think in a large space than in a small room.\n\nHere is a VR game where you shoot an arrow at a target in a big space.\nWould you like to try this game to come up with a good idea?\n\nAlso, all the sales of this game will be the cost of the designer of the next VR game we are preparing.\nPlease buy it for our next game.", "sho
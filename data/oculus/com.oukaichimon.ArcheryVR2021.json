/scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_636988162251649_2661356143115570172_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=614HgQaWiMoQ7kNvwFO_nkT&_nc_oc=Adp0ihsRCP0GpqaX9dvi9MYSDUNQQt6yyyM-MdkapchPq3WJo_OBR6OLP8L_0-aWsT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_3HkhcweX5KESA53DuwoAiR1b2HaHyqr1laGJ00CNfA&oe=6B0F1685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e0\u30fc\u30d3\u30fc\u306e\u30b5\u30e0\u30cd.png", "id": "897552224139259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75435282_897552227472592_4859223191107329569_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2z0BAt2xaEQ7kNvwEqXjPn&_nc_oc=AdqElEChk2qeacOM6QSFfohylagPAxAT4WzWJ85p2W7qlazN5G0A4wjY05L6ytf4yBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdwFvATQVc3TFbf5MSZL1SESuBypCFugnSKZSFQcRd-g&oe=6B0F1723"}, "display_name": "ModernArcheryVR", "keywords": [], "long_description": "An old Chinese poet said,. Ideas come up when you're riding a horse, sleeping, or defecating.\nGood ideas come when you're focused on something else. Also, it's better to think in a large space than in a small room.\n\nHere is a VR game where you shoot an arrow at a target in a big space.\nWould you like to try this game to come up with a good idea?\n\nAlso, all the sales of this game will be the cost of the designer of the next VR game we are preparing.\nPlease buy it for our next game.", "short_description": "I'm not sure if the Tokyo Olympics will be held, but if not, why don't we just do archery in VR?"}, {"images": {"nodes": []}, "id": "1031827598773940", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ModernArcheryVR", "keywords": [], "long_description": "\u6614\u306e\u4e2d\u56fd\u306e\u8a69\u4eba\u304c\u8a00\u3044\u307e\u3057\u305f\u3002\u30a2\u30a4\u30c7\u30a2\u304c\u6d6e\u3076\u5834\u6240\u306f\u99a
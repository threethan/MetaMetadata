.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtx_65Jk9MBo8W674qv51v1tQHzPb40A-NkheGe3jt5Q&oe=6A858A05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e0\u30fc\u30d3\u30fc\u306e\u30b5\u30e0\u30cd.png", "id": "897552224139259", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75435282_897552227472592_4859223191107329569_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVXL2eQ7pYgQ7kNvwF7ZWKF&_nc_oc=Adq9V6yiKX1sx0bwcRYS9ceVtCIDMdvlyR0WoAGwIlRQzKdXqB0BVxw_xYXzNTkbcyA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1M58r8VDqxeb4vBifb5vHyPmEk8kCqR-EtJmi4HbDvA&oe=6A858AA3"}, "display_name": "ModernArcheryVR", "keywords": [], "long_description": "An old Chinese poet said,. Ideas come up when you're riding a horse, sleeping, or defecating.\nGood ideas come when you're focused on something else. Also, it's better to think in a large space than in a small room.\n\nHere is a VR game where you shoot an arrow at a target in a big space.\nWould you like to try this game to come up with a good idea?\n\nAlso, all the sales of this game will be the cost of the designer of the next VR game we are preparing.\nPlease buy it for our next game.", "short_description": "I'm not sure if the Tokyo Olympics will be held, but if not, why don't we just do archery in VR?"}, {"images": {"nodes": []}, "id": "1031827598773940", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ModernArcheryVR", "keywords": [], "long_description": "\u6614\u306e\u4e2d\u56fd\u306e\u8a69\u4eba\u304c\u8a00\u3044\u307e\u3057\u305f\u3002\u30a2\u30a4\u30c7\u30a2\u304c\u6d6e\u3076\u5834\u6240\u306f\u99ac\u306b\u4e57\u3063\u3066\u3044\u308b\u6642\u3001\u5bdd\u3066\u3044\u308b\u6642\u3001\u6392\u6cc4\u3057\u3066\u3044\u308b\u6642\u3060\u3068\u3002\n\u826f\u3044\u30a2\u30a4\u30c7\u30a2\u306f\u4ed6\u306e\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u3044\u308b\u6642\u306e\u65b9\u304c\u51fa\u308b\u305d\u3046\u3067\u3059\u300
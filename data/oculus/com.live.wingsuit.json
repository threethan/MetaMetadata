98542323_5613533667600105472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqkQLpJZz5sQ7kNvwECmKn4&_nc_oc=AdpeqBxvoVWN4rdgBotrVCaizjEAv1N9GtKWV3R5EaB9VfkLbtXDk3xdN6KtS1IU-V8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oKdinS7ZqGpeQALEJ3pwTKTVcFYUGQT8k3I6SBJt2Xg&oe=6A11B154"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73d4L7NbeSUQ7kNvwGTiYx3&_nc_oc=AdpIzKoqJchhsrc9IajOELIDLz4bYSIFZTy0Cqi3IufbmkP_zbPTAe_50JCNsoAvOJY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lchWS-EQQnbBXHitWJg7Aph6fzJE6EeKTJ83pOzw6YA&oe=6A11B91F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdzOQyOnFNoQ7kNvwELUy7K&_nc_oc=Adqq5a6xLU_qzXMdGJApQKBYQdltAe7rWBhPWXiAEDJuikAsYNkHy-0KF7unPiJpt4w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MU38gCFn6KoXogdkWrPodBQh6uSqJHmerjWgJWDcudQ&oe=6A11A3CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdMSOaxPJOwQ7kNvwFOru8r&_nc_oc=AdrOLgQ0ntT0lCMvAX-wHEkCz_L_nT7EWQP25kMyQWof_mSx9HZv-WFZ7x74wgnsTMQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oVpl2h7eSA0AswwOG1db7sWM3Pagwp_lHRLhOt42P5g&oe=6A11B883"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504717200, "lastRevision": {"nodes": [{"id": "1184938521651406", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1317308518366695", "is_first_party": false, "
luscdn.com&_nc_ss=7f20f&oh=00_AQSTyiuSvPadAOnxsLiKDt449GsevNL5JYYIaWJDhCZ6Lw&oe=6B07040F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co-E5ornPegQ7kNvwGenbXT&_nc_oc=Adph6lTe76lc5K2D9xoaYpTkJInpE7XrmSEfCq_dIpp6jmGDgSy-Y_b-sOv_BKrwMTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd97B_J5InLKMqXi4Bfm4e_gNXJZi8ggAvUfNYgnukZw&oe=6B072094"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H_nv7QD38kQ7kNvwHmtsYL&_nc_oc=AdoAN7pGYEsF581eO_x1cu6Xs2Gqxud3z7tpbBsEjCuNWOenQ-l_2bZ3BWc-oZAFmjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb5wCztTGoakNqMmNyZtcP-QNmrJRnaIy7YWGJlHmuvA&oe=6B07285F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg_gwOFiMLgQ7kNvwFdv9WC&_nc_oc=Ado5Saq2NukiAQAZTb3z2eHjO-fhMCj3WZ0ubyP-XitBKqyCtmpwiqcMT81OTOWpofM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF7YKzevoj0tESUwHePVZGfZFBaTuzekYIBqFpSDBHqw&oe=6B07130E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c22BHXGj3hIQ7kNvwGM9rEh&_nc_oc=AdrW4hD6dWEC7bJ5llFRDPVTlUExeVtnyYKjjoxyddqxxN45IZwrnTXcgjzdA0WcPfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKpYUl5e3RbWeJVHGH_9GAnYzU3r7FPHePOrpeyLSU9Q&oe=6B0727C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "
luscdn.com&_nc_ss=7f20f&oh=00_AQRH-IodVl6Edmru9PVyOyzzfQuNcZBCSNzQ5-u53g1RuA&oe=6AFB268F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIT31-WQoWQQ7kNvwEIxw6H&_nc_oc=AdpO94xgAiEifQ7ruLLa5b2dCe9YRU2z2QLMlcDuvZ-F-NDnCqJ3rBGCWiX5caIJHgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBbke1iRzFegLcxwZVI8YhKWyBi7IYVQIwODqsnfzyZQ&oe=6AFB4314"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj0Lkriv6EAQ7kNvwEa7sQ2&_nc_oc=AdrAHPjsdqFkzPhHvbH73ksgL2AZ_EKb138ispGogMhfphBgdi6s2aA9j9IuDbTWwq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2qPbkxv5a9yHCdiHhe1eTlnWZD3AlL9vYcu8syllfhw&oe=6AFB4ADF"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuYbSdecOs0Q7kNvwFT5Em-&_nc_oc=Adozbz1NW6xX9XRVPAV7XG7IBZHuz1IOxpG6Em_IO0ODMBEr6nbXxzTFIhBD2z9_hpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGP3lg90w80z8hd2Vi1XPce6qL0Yf907THrvHbrrCEkQ&oe=6AFB358E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LROd3fmObiIQ7kNvwEtg6EB&_nc_oc=Adr6F02scAp3ZKhGrag62aobzdPL31siY5ZM1kSLD8eZc3ccJ2fm7MEgOmUIur-KwZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFWxCN3I1Ccg7kxTquWhano8GnOT20jtlZnll8L5H_3w&oe=6AFB4A43"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "
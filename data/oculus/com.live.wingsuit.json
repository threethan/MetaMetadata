", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162718_1972690013015220_8344338608143990784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acKw_ZZf6KQQ7kNvwH8DeZE&_nc_oc=AdmgCa70dH6zJTOyH_7WIe0WrRIr8-sEvr2DZ03qrrfom6OxpX2PqxMzwEh0rUAmJiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5d2p0RxZBRqchJYUGfwD92BhWbbwoYwHrTsy_-yoHwQ&oe=69B2AA82"}, {"file_name": "migrated_image.png", "id": "225748758573883", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162699_871905276306457_3424193828133797888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSFDCzTQENwQ7kNvwHisnFM&_nc_oc=Adk_AP4MToYYJ2MkFNV68T01Nxae3ODLu-GLvhKiV2yjk6EjNMm3T_lsVR5nm7PxwjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJnLZL_wrTlSBFi1jDkUvo_4aJlPXy3mQUO_foJUq9og&oe=69B2C785"}]}, "id": "687049208501254", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "674741426629563", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162709_667433433467861_8689599823499755520_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BohPLKY7NG8Q7kNvwE5Benl&_nc_oc=AdkKGT6Sl-fpvxqY1D2vdT8JcS2OZSTHGmMbR3ekM7kTnRCf1sWOdMJlSkmJWYuTse8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqcOI6p27tbZ3w-8sUtALZqQVV8oefyvlgl1FRW2E-vg&oe=69B2BF80"}, {"file_name": "migrated_image.png", "id": "206362084109924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162695_352975361787302_647078570224517120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFp0nJAsPVgQ7kNvwFJQqbU&_nc_oc=AdkAJodr_ZpbDgWkMTkFGwJjN_H5K07mDbMp4oSobfOMRGCdRtUCI7JW_ohfOC4r5s4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5gnjQceJA7kli55LztvGkaXT9EAzOTe2Qo4GPpQZcwQ&oe=69B2A8CF"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5ZjTp4gUX8Q7kNvwEYcLyZ&_nc_oc=Adnr0ZXovRhK3JAZYahkoFZk6SGxrUu1dA5-GSqi0R6WdCgJSys_rAP9-NY-w63dbB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfznhR7g29paBQeOZkUQRvIbwBOubfd7xYqEVyPpDLareA&oe=69B2C554"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzaF-_4FDuQQ7kNvwGQ0YtA&_nc_oc=Adk6Q_EGq4lj26t1U_8-ZC2wyi9a9P7n75nh-p2Kl_OfTVnq05oVWqQy3MLsdQ_fCcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwytIhKvyoft3T14SN3fwUJfE2qSUU6N5bgtIseqbwnrQ&oe=69B2CD1F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dejDjVtcotoQ7kNvwFTJ6Dm&_nc_oc=AdnY5BlEwIz42oiR_YiDSJJQkNXyTtwSUQK6rmLBTGcyd-qCPEz1qTQ9-XAY_UU01dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGNGh_pfxCwmwUq73GdaOY4W25qLNDZiqooDUhsgaAGg&oe=69B2B7CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEkcU544CucQ7kNvwHvYMEg&_nc_oc=AdmONdlZV7elCecbh887-KOARaUtMweBfWAXuzBjsDJ8extuZTSpPGOBvNZOZOoVRzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCQ5hMTxnGank6_xlz-YG8LGcQnROPa0Y69IbX6BryuQ&oe=69B2CC83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504717200, "lastRevision": {"nodes": [{"id": "1184938521651406", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1317308518366695", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform":
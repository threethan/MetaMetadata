2323_5613533667600105472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B56nrxHNhjUQ7kNvwFHm4Uz&_nc_oc=Adr7yiKpOzDjxeq3ELa_y6u79di3_xGe9Z9xrqnWyTNwvMSCWuVGXqdBhSkzIzO1uJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67saHOfGqz0CQIeJoV6AwH6bE2x6ZwO0MdaEeRFtFy2Q&oe=6A0B19D4"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTv0Yn4siLYQ7kNvwHwpy7r&_nc_oc=AdpCB0-hhR2QlBygAYJYB-r5Nnkl1S2X_DUfoQpVnrCmkQ1t-mGJsvuzP9ohbW3hV1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ycXpnmBoo8pIn8on8bLhZge0THSZFmGLIXIQeTMmF-Q&oe=6A0B219F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5Dta4wA_1gQ7kNvwHMR4jK&_nc_oc=AdqgyCvDaMIYpvthKtM3YmFWVl-efxpPDRQ1wNUMgxIIOxeRdd0RldiZ_scQSnJO8fQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LyZzmmixDtpHlTqolgeykk54Q9iFBJxfl8a7k2Vf8Vg&oe=6A0B0C4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9YelhKVPCsQ7kNvwGJfuoC&_nc_oc=Adr8SjiFmv-dlDGAqBluxbPp-39wGCgqjbjTkFVeta7-T0R46A94Cz4ZOvFRFRFGRas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af640pN_eQF4TC0xnNl0B2zGSGL95VqXiNX50HR9QU1DKw&oe=6A0B2103"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504717200, "lastRevision": {"nodes": [{"id": "1184938521651406", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1317308518366695", "is_first_party": false, "enables_
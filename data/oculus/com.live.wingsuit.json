", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162718_1972690013015220_8344338608143990784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbLAQ2t4tT8Q7kNvwFmkPXn&_nc_oc=Adni0CdwFRQ7oY01-k_icMdrga1UkWorSCjOviXR-Rw5X0f9Cot_enlKVXLhTt5JgI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5sMDEpAdfFNuqqn3Kh594NY6aZbRZwDJqUP6Ssap0Zw&oe=69A97002"}, {"file_name": "migrated_image.png", "id": "225748758573883", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162699_871905276306457_3424193828133797888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDsdpbxTj4gQ7kNvwH3zdNA&_nc_oc=Adm0EHRnGTmDBksMrm5FJNDiEgmbP1fSwyIc6VrCRr1zj0z5-SCmEMQp-2LoTW_jg8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuPRqaYnFIwEA8rHUCd_3J0hP7UJ1C6fDRiyx6_f9relQ&oe=69A98D05"}]}, "id": "687049208501254", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "674741426629563", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162709_667433433467861_8689599823499755520_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_I8VUfJPnEQ7kNvwHbnD-m&_nc_oc=Adn14GFbQq4utE2LHSY53NDsnk-jmNelKfZO8JzvV9N1xWAGmVNXLJRg5ySY1zZA4qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfudEpjo7RSpu4udCka4KYzhgIuFp_jgUegzya7xhwsZ6w&oe=69A98500"}, {"file_name": "migrated_image.png", "id": "206362084109924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_352975361787302_647078570224517120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G96kaGeYGMUQ7kNvwE9WNpX&_nc_oc=AdmX1tCSBnZ_7p4NY3vLy5xqCts_tg4CIAk4ZR0KflNuIKxILDg7NNEf1frabC8V3nE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuLbX3e0cmKB2i0hhe6Hb399VAVKjsuZexDvCotP0TqeQ&oe=69A96E4F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vL-y6LIulAEQ7kNvwGP81dJ&_nc_oc=AdlE1KmA73hrpRefePC03tnjiqT8iE0-ySmv1CFE3L45jcCH8zACN0er8MUWaCS8e3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsIHudVg_mTHSI_L9gQxOJNWIJonj4O5C5buG46w_WvKg&oe=69A98AD4"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=samaK2MukLIQ7kNvwHc_IJO&_nc_oc=AdkCfNRwxR2ax6pBFKzJSKcAmC7z8Zs4JZepc_PtAbeYls37ymmencdsJi5-Lz0GTZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu33gL5NSS0VLBeobBSACe30cdToYyGFHQM0melhIHDYQ&oe=69A9929F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC-uaRxErwEQ7kNvwFkpgRa&_nc_oc=AdmztkjPhswIuL0h9gBHfhxgp1NNqVjayw9Xw8R391nv3Oaj0VXjBa6OPjPjnMFMs7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftyPO_LHr2KZR-KF4Ne-b5zE_FP7RmEY2QKDlFwTRMWxg&oe=69A97D4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRWYVMDt1jcQ7kNvwGfz_uf&_nc_oc=AdkWmGedsxQ4ehhxRI4TzJJ4T0uU1OkDyZri_WAJ9sReM6JmEyRHJH5Bd6qR1Vpbdiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft7pVy_U34bpkmhea_90ZN5qZvQxBSGOHRojd7mqC0elQ&oe=69A99203"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504717200, "lastRevision": {"nodes": [{"id": "1184938521651406", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1317308518366695", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform":
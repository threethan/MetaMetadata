luscdn.com&_nc_ss=7f20f&oh=00_AQSbHG0jA_qMAZNl2p5Inzl-5hbB8ulGN8TEY95wcFkdkg&oe=6AFC780F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIT31-WQoWQQ7kNvwHOWjpX&_nc_oc=Ado1BrFMcww7HgG8iHhIRD_V9VTk_HD7bBDxHS1iicxuz8Bb_75EsvaVTrHgchrL6lY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG4sAP8QCwAXu2qzIdIUXjvNQ0ppQrF_iEsMMJVQ_aoQ&oe=6AFC9494"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=991vFhChJ_oQ7kNvwF6xbWr&_nc_oc=AdpfnQw65kpS3V4x9z_6jlX3CXrmkxj_0QCbw1_yO80nXQ-q0lRygadbBlF2VECheL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3i6lyVbVjI8M-R8mJoZYwISuaS4y1p1n1WF_eFGtGRQ&oe=6AFC641F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuYbSdecOs0Q7kNvwFD4w9Q&_nc_oc=AdrDfuUrUKYNj9Z-A8P9Fda-60n1Qa7snHxBfxProhHD90FwIj2DXozSsxbRwjM0a4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE-fSxIIxZ86OhJyH2NNx-_FoXOT9IXQETviH-o2sWuA&oe=6AFC870E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utNumbnNwMEQ7kNvwHyJg2B&_nc_oc=Ado-KFgvAB-gBd0VIemnf58r49vhmflLfwQuA54HA3u_e6g8Jh50x1fZndJ9e-VdDHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsxqUk5FJjTfpyoLbqPM-hfYZw21j_B6p00oR8UhUbYw&oe=6AFC6383"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "
", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_1972690013015220_8344338608143990784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acKw_ZZf6KQQ7kNvwFfgz_b&_nc_oc=Adl3zuYL5o0UrwvPwiozHOdJy2kMiLqfwa0_JpZ7C6nSmHp-2bOnh7e_18rQxlc27ec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMBgWBCQcxJduXgCJfU_1CJhddzkL8MXep-vHkrIEIIQ&oe=69B15902"}, {"file_name": "migrated_image.png", "id": "225748758573883", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162699_871905276306457_3424193828133797888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhwDyYUF3xkQ7kNvwHeh2_Y&_nc_oc=AdlPszpCPGXfirhmOH9hwWfrGs0WL1nHH0w63tZcvTsc81IsVRtCGZHQ7DETu5spqJQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz51wKzzNpxWUJaQnBmY8SkV57SvPvD1FDwi3VA4FvJAg&oe=69B17605"}]}, "id": "687049208501254", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "674741426629563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162709_667433433467861_8689599823499755520_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BohPLKY7NG8Q7kNvwFxfjbQ&_nc_oc=AdmwNBD63SnIoSaQCdgrOwMvt8RO9WAbJp0T-95jkp8ik3eiX8yYr9nClwrG4GhDhtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzO6sBQogHdD12KnWg0xlanU7w_QXQPGdHmxrT9ljUIxg&oe=69B16E00"}, {"file_name": "migrated_image.png", "id": "206362084109924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_352975361787302_647078570224517120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFp0nJAsPVgQ7kNvwEKY_Y_&_nc_oc=Adk-_a0JFJ0-S0mZheKr7aFDcsnk7_QMOSfQ-fJlGG0SasZ0NPdNnbXR_6MJYV7CPP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2akul2CWTYNjzyVEsSjC18_tfMvKXMUiW25kclGLHsQ&oe=69B1574F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN-JiR76McoQ7kNvwGxH37U&_nc_oc=AdlR0eYTsaWIv8Ra5a9NBn0gX0CxpmfGhOw6-NnbMcyWQwhmLvt7WgrlJC4eSgJcF5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx24_NzkaGpbIQanJPdnk8OcoUhGZVs0Xx0u6hr9LLyCA&oe=69B173D4"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzaF-_4FDuQQ7kNvwEHofBr&_nc_oc=Adk0gScYHhgk6zPsj59vhAsf4mr2MDlnk95tx5JdIRlkl3t7gNnvouuaZeXcoBvY8fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXGbI-WxDZe6z1cfH478L7sehjVIykK3TlsEjpGffM2A&oe=69B17B9F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvfQSDQson0Q7kNvwHbidfg&_nc_oc=AdlurfvT1tAbpbSj96Uy6RK_kyyGElm6KT0v2Jiu-ECO1IuiXs-yoRixpbIhAGE70-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1vdXZpk8m9wCTexT6Od3kMFSA_5DNG3ilKoAI2sHmwg&oe=69B1664E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEkcU544CucQ7kNvwGNlTza&_nc_oc=AdliYuQyHzYc4l2lhmdZ_vDW-9CNSdvF1EEwxjXqQtshRauBPnMfLy-CD2HcK8NkbB8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmS_x9IRslFo-Anvl1WPcaNCdruyhu_e9l1k38nwZuMA&oe=69B17B03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504717200, "lastRevision": {"nodes": [{"id": "1184938521651406", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1317308518366695", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform":
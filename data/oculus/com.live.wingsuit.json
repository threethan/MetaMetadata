luscdn.com&_nc_ss=7f20f&oh=00_AQRXSSRhvua6eKu6kZlC1XzXLET82v6mjI25p8vqZTf5Og&oe=6AFDC98F"}, {"file_name": "migrated_image.png", "id": "194708368497435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_1581976398542323_5613533667600105472_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIT31-WQoWQQ7kNvwHMp8bb&_nc_oc=AdqBOESKTJ3z47mI5uLe_vZpc2YENGmf6XDdbFT64DcG2wN28epKTV5i7qS4bgSNpn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3rYFDqb3zxTV4eCZ6tDBghsu38LGv4FhRZRT7Tomajg&oe=6AFDADD4"}, {"file_name": "migrated_image.png", "id": "1068865553495928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162683_215955958928679_8056483010838528000_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=991vFhChJ_oQ7kNvwH-KmRF&_nc_oc=AdrRuXmUOwyLj5-GziJUq70M1Xv_c-GbVm5zFiWJ3jEb_Jc2IuMFbcUeoaPzSEsWKkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQusMY4kRxTwz65TfEfffyYVat8AJoVit1iW1ZNZfCLRw&oe=6AFDB59F"}, {"file_name": "migrated_image.png", "id": "663548137779735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162683_1440437059380678_8001582002966888448_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuYbSdecOs0Q7kNvwFzLGS7&_nc_oc=AdpqOfVQDaBVR7U1Z5MXZqdPJiBtCUYrlgE_4GLUD1cBjFxfId4x6i1ALcg9OfTsXus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT9bQPZGC_oFY2jiakn0K_uDL6BWQYPA5En0nWHy_S-A&oe=6AFDD88E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WingsuitVR", "keywords": ["wingsuit", "flight", "explore", "wing", "suit"], "long_description": "Feel the air rush past you as you plummet from mountain tops, or dive deep into canyons. Feel like racing your best time down increasingly challenging wingsuit race tracks? Or would you rather take the reigns and freely explore three massive maps: Canyons, Stormy Mountain, and Islands. \n\n                    \nThe game supports two different input modes: Controller (either touchpad, or a bluetooth controller) or gaze direction. Using the controller is an extra challenge, but allows you to look around freely while you fly. During free flight, you'll use the touchpad to spawn a teleport beacon to help you move around.", "short_description": "Race headfirst through 10 different wingsuit courses in time trial mode, or fly casually around 3 massive maps in free flight mode. Enjoy the feeling of racing down a mountain side or diving deep into a canyon in WingsuitVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dubatech.wordpress.com/", "developer_terms_of_service_url": "http://dubatech.wordpress.com/", "publisher_name": "DubaTech", "support_website_url": null, "website_url": "http://dubatech.wordpress.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "274061094839865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162676_1747052455593184_5008304283750236160_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utNumbnNwMEQ7kNvwEHv2lK&_nc_oc=AdoqHJXoE21DdJg16ma8348nx-jy89dKOwQF3FNr6VdkYNhCvLUGE_O0JtxSCJP0xVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8zfQJMTprGKuaPcZQhr6tlGeJqlcc_A9DXKapY3DAJQ&oe=6AFDB503"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WingsuitVR", "
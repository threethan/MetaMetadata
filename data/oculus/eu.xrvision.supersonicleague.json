om/v/t64.5771-25/75236135_8475571175878076_77662690291013174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUbEZv0TBAMQ7kNvwG6BqnN&_nc_oc=AdoZ1R2s05v3I7j5xjuVH-MTf5B9ChKZG3yEsvZx-E2EA9CFXlVtZ9uYp_gLBS62WcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3F1i-rwaquiy7ROKZE59Y3znnRmGyveEZJhH6pvk9KA&oe=6B0B2462"}, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxCZYgRxcqIQ7kNvwHkjUxL&_nc_oc=Adpqe9dxH2G1PD9L6H9yPwVq5x3OSVEkwI7NkJcpe-fbPe87iCnxu-iOpSmC2zgDV98&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSirk0BZcLsHcoYSHwtZowQy5STsYRDcx8egz-llIgGNQ&oe=6B0B36EF"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0lHbvn1HLoQ7kNvwHWmvlH&_nc_oc=Adp0KMB1VbS8w1zmkvEIIIf8Y-gro1FM7U3CDD2aOODjmzBkmOG5_Z8M5axQEc18kS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSn7WAvu3Cw95QtR4AGykUpOCt9CT55_z9KUBPOVCtbng&oe=6B0B2077"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwgDJuXY65YQ7kNvwFyG0eT&_nc_oc=AdpXKBG3FhtI4eJD0UWUnkeeBITbjJ4DovMLhOr3Yn38oTf4UgLTnTnZbfICZ-SPDr0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuiyYXPIWtV4Q7knUNrSEAMVPhjyuIa7cMeY7r6Yj98w&oe=6B0B33A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ7xKeKYPAIQ7kNvwFnY4en&_nc_oc=AdpDoCz2WsDNg4YPZfFa-6mOWrPG7S8HJ5LkMD768ZGc4gXS4HRJ-_W2_5jci7UJrmE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI78pTFpMq8gSWST8MckmsOCYIvBe5POooTJ2pklZb_Q&oe=6B0B28E0"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9033789523326007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422388_2564795297052692_626731729550220583_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRi7W9ArRiUQ7kNvwHlKpI9&_nc_oc=Adqr85wCEZWSCQMP9Xy2W88vX_6csHLci_bk2rQLY0h4CHmWAi117uXeenHhtSwd8Qw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4-GFPUzCWoa-nRiXABUcLosjpxX_y8-EC7SuMWoHTIA&oe=6B0B114A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supersonic League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1733331600, "lastRevision": {"nodes": [{"id": "8827577817280513", "relea
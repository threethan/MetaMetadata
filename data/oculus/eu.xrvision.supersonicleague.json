273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhKMeam615YQ7kNvwHDaQKt&_nc_oc=Admsk_u3j71ofaLytB7Xzk4eQ4zFD6ALEu6FTKUqGLBiP0dOXz3VvlP3sr5QmgxCWX0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv-sYoWYhtb8C8xwJxhl-OqRYh9mjSGCTwWDFicaPiwGQ&oe=69A18B6F"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-6G98LmPboQ7kNvwEd8Yr8&_nc_oc=AdmaTm8MvfgW7lk7s51ZyC7pdm6BNrzd0zsMrS42CaSXbT81R1wJWCrw9fJZABCOzeA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs2z1nVTpSzheTRTncgjI-fMF6wzPxeH3UyMWBHBEsryw&oe=69A1AD37"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxGimWergkIQ7kNvwEpA9RM&_nc_oc=AdkInc4NhMJ5VhpOr_Aa86PYur13mMAnLVn2mHp4R59t-HVHa6cazCegm7buNN4oq-E&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftAoB_Ul6kbaoLGHbqQWq7fcuA8I2XmDWVaaePmxqJt9g&oe=69A18820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9W7I52nkxUQ7kNvwHU3_c0&_nc_oc=AdmsLUN70c4gcTxjJX0H1616gIPlx6ZLKk_k2iBbuRgvA_TJTVNol1UIe3nVuNf0duc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvzyPreUANNsLDUMX5MGj13BDBWG9ZwV1ZqbpG7uR1YXg&oe=69A17D60"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_t
, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIEQGcKhpT8Q7kNvwH43WdW&_nc_oc=Adqt_OoayzX6lgWYswfre3opp_hW_fl0wsrc61_i-EkhaK-eV8Ycmg70Vfra4oprrag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwvVqta5P_2VUkVfgJKBSVxlOmEpppRB_oSQF8GBSQfw&oe=6AF9DB2F"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_jQ1Sr0-ZkQ7kNvwGdbPVR&_nc_oc=AdpI0uq7nzuxc8PBnbX9nDKKrVBHEXnlkAUEE1x0SUMA4ANhdOPx9ysPyHkj1SUhQI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9d1LBUghwjoyQEcyez2RQfSU3OytuOpaxGzNrQwvBSg&oe=6AF9C4B7"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfqivd7U3HMQ7kNvwF8Jx6u&_nc_oc=Ado-NtsH9d9KUQnsNyf3xsVDpgsue87RKJxEh7BaIEYgFd2usjbZmkarcNEI_4q5u5U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVDYgdNiRSUTBNBvlgqXsF9YD4E0VmBxZGvDCuB7Rp5g&oe=6AF9D7E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFqAtK5dqzYQ7kNvwHSmBnU&_nc_oc=AdrbC7wIuFSWsSFzrrbK3gMvhTcOuT8u7ERUWPmpvmqMXjRNNar9Zx1eK2GR16xLkP0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKgbkJRlX0tkafQNHnRfOV41EXQyhgV0YYxDKkpXQDGQ&oe=6AF9CD20"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
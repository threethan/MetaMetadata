_nc_oc=Adp73QS_qbXZZgOtdY4yzFVJAlZY0ElTz4tgyYol2-sY21mIEY0P6H4QVlrnW9WpoF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNsQwKbnatd02rhmIbAMPdGTgI5p7vIF9GanPHWHDfyw&oe=6AFDD3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1A7OoyLW68Q7kNvwGZj_qp&_nc_oc=Adp459los3AzF8m5dR2WZ5SpPfoCcCyZiavhZpYIYR446UvtWglw08Y7QZJI35VRRbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDzzJZ8GahU55PpbwQGjIiRayCXLymHC3cpReY4S4Y4g&oe=6AFDC1A0"}, "display_name": "Supersonic League", "keywords": [], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer to a whole new level in a mixed reality experience. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity as you take full advantage of the gravity-free environment where walls are part of the strategy.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Perfect your spaceship control and dominate with strategic moves.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or from across the world.\n\nWhether you love RC vehicles, soccer, or cutting-edge mixed reality gaming, Supersonic League is an experience you won\u2019t want to miss. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8827577777280517"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2222856448654613"}, {"status": "PUBLISHED", "id": "1567759610996441"}, {"status": "PUBLISHED", "id": "1882666052422625"}, {"status": "PUBLISHED", "id": "1764349557457464"}, {"status": "PUBLISHED", "id": "658578670167574"}, {"status": "PUBLISHED", "id": "564733403036557"}, {"status": "CANCELLED", "id": "1241352640461359"}, {"status": "PUBLISHED", "id": "1316765049686697"}]}, "baseline_offer": {"id": "1316765049686697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2222856448654613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__
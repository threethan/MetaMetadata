6A36AAA2"}, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7bcI8uLrwsQ7kNvwGrrJxZ&_nc_oc=AdoXNI8rod9ArYA8IUCTeYYpchOAjvSoCHMFEqAk3SJT0J4sSMA0aW8nI6Ypzr9iOKo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wN1zHKyJ6bX71KKGvB_K2f0Pjk6E6tv0T2gnefwHJ0w&oe=6A36BD2F"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wgoc0_tQn0Q7kNvwEV3bhU&_nc_oc=AdqZTd5ZSFrG-TJ4sQhFrQ3XNVqIIvYeT422lcP4p3V_AqpNlL_gsrswDuLDpjgUNpI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QywEU_lhMueu_NqKOHbPkFZsHdwPB_oOotpY2Emfe7A&oe=6A36A6B7"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGZtmOO9UxgQ7kNvwELmGsu&_nc_oc=AdrE7eNMXLQbPaUefAehtuzNSnzRrhY9jKU318U67xtXpLNJ3mNicvj0DJsiRAHazYQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_rJIfntq7Rvm9WCBZTXcbdEVldHrkGBGjiRxuuwSsAw&oe=6A36B9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SheRI2tGy3gQ7kNvwEhOqUJ&_nc_oc=Adpkvm8R8LQ_sralSomPklm5htgAeRbzgyQrLEL2sfAXvqywtBfGaHORCfjgDH_0WA0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MgX_oR0Alb_PdtTnvQGn6UZkz5d4ED2MYNtS0mj8L7w&oe=6A36AF20"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tag
6A22E422"}, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOjKwF0oHK8Q7kNvwEVnWoc&_nc_oc=Adp1pVLeXq2O97GkeZZ3_2Nui_UA-Rr5HWpQ2-tskem9OtUWdYoXFJYDNFQEQY0zx8M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88gUpiVFMCr31ibuxaenP3Gm6N2F6cAQLKDZG9lvwdcQ&oe=6A22F6AF"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrUbQJUV3SIQ7kNvwG0ecJa&_nc_oc=Adqg3bQXm92uDVxosO9ErivgfYWdgipDSJmzyLiA-_bC0R3vSeCTo15bxumNwIKZY4Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ardi4BvCz9KCWAWAAROiqQL1LBdnUYO-Axwe733iy6Q&oe=6A22E037"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ezsncr_SBUQ7kNvwERuAeq&_nc_oc=AdpiYtd4Hu_NFJcF8ah8YK-Xtni9PiQbbUxg3wHS_74_yJXa98OKHo4xs1RRBVAa5YM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qi-I_sAGNugt7QdIFhZl3krzhUK7HC0fbR5fPKfUlIQ&oe=6A22F360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=538gnNc9cucQ7kNvwGJMFuh&_nc_oc=Adoe3S_LYbKav-ZE21jiVzcmsJArADsiduJEfgcTky_5RFkbZKyTjVhMn4zNzS-PeGM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wqJxEm7HwqmmxA14sPpRU7I798gc6lTrMR3WjG71E8g&oe=6A22E8A0"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tag
, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7Ei4PSiSa0Q7kNvwFU_wXz&_nc_oc=AdpD_IhK_25puKeHZKyveIrl7MHOgBa8JDienEjyrCoFOkIOqBlY-bRjuGTBagffbFw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J3hmAbmJMZ6oQoRR4meuhr2CW8tQIq9P_-gJqxB3vVA&oe=6A2C312F"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNh3jY91YHMQ7kNvwFpSwet&_nc_oc=Adph5n1ilzM42RhJmFAdnhno0u2cdliEPcJ5OpfxAwUD_0vlRzoL__vT_uvo-ikGM2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kxad1qFXD0PAv9ZbMzx_Cy21GnHIp976kisM1pH7QNg&oe=6A2C1AB7"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36zrKUgayGQQ7kNvwEfL7D2&_nc_oc=AdrFnvewerxf0pU9T8qYsuFhMXHxUaQHPFxTq3xKI7WqJM2xJUzMThHXABTeicl-kS8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DJo89DI9cFhxVXBMj4gmkHyku4WmBQY5iE2GyA986GQ&oe=6A2C2DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJPaJyrPINMQ7kNvwFNsYEm&_nc_oc=AdoKHITGcXBCs7XoEAy2G3qB_5emuSH5a1WtEmkC6P8FKIbgi1T4-sH25mb-ZwjYQtA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u7YznJajo9l_1w2JT4dacvt2-C4Kn-Ws4RD-YvBC2lw&oe=6A2C2320"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9033789523326007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422388_2564795297052692_626731729550220583_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKzntJlpIDMQ7kNvwHGtczW&_nc_oc=Adq3WUYQ9JlqrtWUSOkeJyZmk2YiVKOk6L-m48ebRRKL9n9EAJVaNKOPdbeovkD7c7g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9acxIYjnb60gXd4Y0gvxiHOGMaS8TSxfJ9GAarKjZPcw&oe=6A2C0B8A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supersonic League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1733331600, "lastRevision": {"nodes": [{"id": "8827577817280513", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8827577763947185", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1617001195559745"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_art_1440x1440.png", "id": "2564795293719359", "image_type": "APP_IMG_COVER_SQUARE", "uri": "htt
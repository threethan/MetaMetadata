oculuscdn.com/v/t64.5771-25/75375084_959769519309320_5166341335218547681_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs2PkJtFH1EQ7kNvwF2X5bg&_nc_oc=AdmMcKaBZPvdgs278h9NpSMmrLb7WH8uLq3px7A6Z7bDH7EFLqAX4mHMCyhMOhGexM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfunUxiVMnFoCvw7qeDDzD03FosPy_ga6MHGf0XWTtyBEg&oe=699EFB64"}, {"file_name": "screenshot04.png", "id": "985954119564846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_985954122898179_3846294578981005676_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpSjTvCWracQ7kNvwGFTWFd&_nc_oc=AdkvR7hsotW7FdwnVXuZILW965wQhigR5ZgSlSPmxAaOYERX5YvuFgi0QmmhntQ2Ins&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsOHJXoP5wnzj3dnd6WnTni4HBSIq1h2_Gs6-GDk8Sbgg&oe=699EE76D"}, {"file_name": "screenshot05.png", "id": "1330402724608748", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974910_1330402727942081_372689223035263134_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kauo4AOCf8Q7kNvwG0MeAd&_nc_oc=AdlKgy5NdKvyDsc5jyCqF-bZAbv1ouk08L7u_X3aJYWB67AFz_xs0NSzt-IJ2Vj_TzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftC0ZWNzzf-2MpciXzxbxqt-oegCMtKndN7jtTccy9EqQ&oe=699EECB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9W7I52nkxUQ7kNvwFRO2DE&_nc_oc=AdnMoVJzS7Y9C_VucVtNXAZLsIATmJS5X8s3TZjFCRw-G_rx-7YHahDRHYk89o7rHp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftSXrGm0VtlYF89Qi-XIRo-MenhbC1BHH42d716_zH64Q&oe=699EDA60"}, "display_name": "Supersonic League", "keywords": [], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer to a whole new level in a mixed reality experience. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity as you take full advantage of the gravity-free environment where walls are part of the strategy.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Perfect your spaceship control and dominate with strategic moves.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or from across the world.\n\nWhether you love RC vehicles, soccer, or cutting-edge mixed reality gaming, Supersonic League is an experience you won\u2019t want to miss. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
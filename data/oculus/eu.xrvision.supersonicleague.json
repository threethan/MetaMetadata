, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiPnlBjLeO8Q7kNvwFU5qry&_nc_oc=AdoFqt9y8MBidW-k90OFYEOwutMQ3b4s42YwDOYGP4-_5LqomlZxzUTxnK7bIs6Ib7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPxlpWE-q8MOmacM9V2esMhxPlGz8WMA5UCnx1ruisNQ&oe=6A50E2EF"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvf5EdfgUGIQ7kNvwFUoh-T&_nc_oc=AdonlvRlcOY0DrFfWuhMZ1NtzJeTfIlcVpMV8k7ZgmTDcIFEbf6nlJgYmy8WBlIP71Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZld2I2Z7ylkIhHDUfryV4RZ5x1bSf2lkewS_Yy8k_eQ&oe=6A5104B7"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDuA58RHmPUQ7kNvwEwb-BW&_nc_oc=AdoaKEpN7cNFc1Ip47PvsX_Ch5v6AbDdH_PynS25ILwBUCzt6nA29HZQ3VsXPSLuyuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI_2L7LQOia4hhg8--mTnfS1rIvaTasd1eKJmXg8tjrw&oe=6A5117E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GWJpKae_eMQ7kNvwG0Xwt7&_nc_oc=Ado_pS_wrRLSmMPRKNEF03HXd4gSLNA9uUmnHEyc67Vo5ouFL9M8QWczSLtiUAqCKWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdUOelkc_nlUOBi3-BIGhADcIfTF9Qik4YJ48bLo4Pww&oe=6A510D20"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
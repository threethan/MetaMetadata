1495506290682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COnY9YAmmNQQ7kNvwFSYMa7&_nc_oc=Adn_p_F-io2yrR6ZeQXI3DzFJ1kqL-IG-vvLmYZBxp2zb5dUmQ5nDNqTalGzKpiOInI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCXcwVf7AylGu6_KZBYDLMXT7UeuAmggv_h71Zp-QFtQ&oe=69BA97EF"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ggqHZS3jbQQ7kNvwFa9d8D&_nc_oc=AdnOJn7nrKcP-z0oIseS03A2DPJ-dc-wyfDhYnIplSG87_pj7863zBXc6h4G0zFvTw0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylE0lyGvmG7WsFMJ5j-s_pnghqWOstWx84CNHzMN6yOQ&oe=69BA8177"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNtn5q7lil0Q7kNvwEtqIsf&_nc_oc=AdlCwk56lZYwgFMYU_7EL3-TKAP5ORJ1TVWDJpc8HM6a9Juhbf-auLF7sPH9RE2LpmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFzGRnUJszOzB5kMkViQ8ad78jAL3fsMPUpPZPi1ec9Q&oe=69BA94A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLHiDcQdCm8Q7kNvwEYJ-ER&_nc_oc=Adkqs1b7o2-YkaI7JeqptSBdpWMjc0KPe4QP9d6S7B5DgyM0XAmhJDwJbmFks1KLfi4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxAwAIxXw23MBc9EsLF1szTZEaTT2QV9uj6_la2NyeLfQ&oe=69BA89E0"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
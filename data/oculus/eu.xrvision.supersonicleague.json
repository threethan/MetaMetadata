om/v/t64.5771-25/75236135_8475571175878076_77662690291013174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et3oLnusZdcQ7kNvwGWb_4c&_nc_oc=AdqUTnrwBMk9eP78UuFtmLdRAWDn7EuVdGmP09p1SSzzZh2LwAg2xXIjLydcWVQu8UE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkN8IZsEGNYx78-jj0WbAVL-YzAQbhBst7Pta6ol--NA&oe=6B0F18E2"}, {"file_name": "03.png", "id": "2041495506290682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003273_2041495509624015_4476263229582900891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYAW3sz4NoEQ7kNvwGs12ut&_nc_oc=AdrMrzxQw1bq6REkDMcInqApZDX2LP0HCb1u8CMEftSWMUJEHJ5yLN7u_i0YXPTMc_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFTGFLgv86CQre0qfvdh2ONnqWGdS6qll1dhINbDK5xg&oe=6B0EF32F"}, {"file_name": "04.png", "id": "2407684299578398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_2407684302911731_6233988705743374735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er19aGDUtN0Q7kNvwGhyyMr&_nc_oc=AdrLNbAckcLoqlXMYzYXThvtidPo_VI3tK2cqJbmwmaYaqy2ANTrS8B0IhwsPaI11bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeIJuJWAEq1W4C5bvqK7hXdeDU7Eu4UN4zwIK4nqhgEQ&oe=6B0F14F7"}, {"file_name": "05.png", "id": "1237750194192384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035448_1237750197525717_456122910025234852_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2tB3b-AyDUQ7kNvwETevEU&_nc_oc=AdoGPoGiHjZAKSl1BxrepKnjjyESKH-KU6tF68l-9lVZHRQ6PnmMoCxzdHSDfVIQlIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjxbqe0ynebgXvwrGSqjumh4rCEMTnNYIps4Uzf19SXA&oe=6B0EEFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560x1440.png", "id": "447494998389035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_447495001722368_5116219352783601031_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORyUxe_cJ9wQ7kNvwGK6Q9U&_nc_oc=Adqkki8UcMzwQmBCFea8CXCkIYt7jrm4rFFyS4smibkuohFcwO7pM1FubpQ4xoKG6oA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSb-V-BIEPGcpZM_o-BvD5jWNkaLdJ-ojWt8-TCJFNyg&oe=6B0F1D60"}, "display_name": "Supersonic League", "keywords": ["soccer", "football", "RC", "rocket", "league"], "long_description": "Supersonic League brings the excitement of RC spaceships and soccer (football) to a whole new level in a mixed reality experience that fans of Rocket League will instantly recognize and love. Display a gravity-free arena right in your space - perfectly sized for a tabletop - and dive into intense matches against AI opponents.\n\nIn this single-player adventure (with multiplayer modes coming soon), you'll navigate your RC spaceship to hit the ball, pull off jaw-dropping aerials, and score goals. The game\u2019s physics-driven mechanics demand skill, precision, and creativity, taking full advantage of the gravity-free environment where walls become part of your strategy, just like in your favorite fast-paced, futuristic soccer games.\n\nFeaturing:\n- Tabletop Mixed Reality Gameplay: Immerse yourself in a hovering arena you can place anywhere.\n- Physics-Based Action: Master spaceship control to perform epic plays and dominate the match.\n- 3 Difficulty Levels: Progress through increasing challenges and sharpen your skills.\n- Weekly Leaderboards: Compete to secure the top spot against other players.\n- Upcoming Multiplayer Modes: Online and local multiplayer will let you battle friends in the same space or across the globe.\n\nWhether you\u2019re a fan of RC vehicles, soccer, or love the competitive chaos of Rocket League, Supersonic League offers a unique experience that will keep your heart racing. Will you rise to the top and claim your spot as a Supersonic champion?", "short_description": "Take control of an RC spaceship in a gravity-free mixed reality arena right in your room! Compete against bots, master the physics-based gameplay, and climb the weekly leaderboards in Supersonic League."}]}, "developer_name": "XR Vision", "developer_privacy_policy_url": "http://xrvision.eu/supersonicleague/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XR Vision", "support_website_url": null, "website_url": "http://xrvision.eu/supersonicleague", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9033789523326007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422388_2564795297052692_626731729550220583_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqNoZ0l37msQ7kNvwHolmGq&_nc_oc=AdprgSDTjzX1yeIm9Seq6lgKB5G_tKLbzXnWgsTDWsddqx44mmXpfIrlooHXDjhUmbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH_GgswdNV4opDMKzLl4eggy7zmac-oKRVHBwLx686jQ&oe=6B0F05CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supersonic League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1733331600, "lastRevision": {"nodes": [{"id": "8827577817280513", "relea
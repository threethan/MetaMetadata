ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_376972670690149_3288105923206203580_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omct8QONYKQQ7kNvwGpNdsJ&_nc_oc=AdnPsdsjpInhb0sraWYC4HyOipORL0Nfr-poHoxSInFckcOzpvT5LChG67Rwa4s_Bms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1URqQ7PJ46rC_2A7wcOCTK4Loi1h4VH-dTDXsbK99Cg&oe=69A82558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "323394513108914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_323394516442247_221433893083022636_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdT8koMvGSIQ7kNvwFMTdxI&_nc_oc=AdmL6JZjOSvgU_8mG3DKbr_KRHn5EvChTHK7BqAiLRXkxSf_iJoGlsi6XliA1MxbwNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHYziX8G902wJ_239xyNkEo3Sp8Re4pGruzBcVtGW_-g&oe=69A832C7"}, "display_name": "Glider Sim", "keywords": [], "long_description": "Glider Sim is a professional paragliding and paramotor simulator built for real pilots in mind and is aiming to achieve photorealistic graphics! \n\nThe simulator takes place in Sun Valley, ID, United States. The scenery is derived from real world satellite imagery and overlaid with high resolution scenery and dense forest and trees.\n\nLots of attention went into the flight physics of the gliders as well as the wind and thermal system. Set your launch point and flying conditions then takeoff into the skies! Use wind current such as ridge lift and thermals to stay airborne. You can toggle on and off the wind visualization particle systems as well as change other flight conditions such as wind speed and direction.\n\nExperience state of the art flight physics where each cell of the glider is modeled and has physics applied! You can do maneuvers such as wingovers, spirals, stalls, and swoops. Watch out and don't let your wing collapse!", "short_description": "Experience the ultimate sensation of gliding through the sky! Built for real paragliding pilots in mind this simulator is as close to real as it gets. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BAqa7i5n38NI3LHQdANpLtsTEwJDHPIzWJJRG_iGr_c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "5D Realities", "support_website_url": null, "website_url": "https://5drealities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1354392565063348"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "727962033523369"}, {"status": "PUBLISHED", "id": "1249074990367137"}, {"status": "PUBLISHED", "id": "2167032823789757"}, {"status": "PUBLISHED", "id": "1801515860474796"}, {"status": "PUBLISHED", "id": "755329803530852"}, {"status": "PUBLISHED", "id": "1698582870789474"}, {"status": "PUBLISHED", "id": "1590072734955253"}, {"status": "PUBLISHED", "id": "1121073732860460"}, {"status": "PUBLISHED", "id": "1135870274412750"}, {"status": "PUBLISHED", "id": "5033453830079900"}]}, "baseline_offer": {"id": "1135870274412750"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "727962033523369"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26001620929536669", "version": "3.1.1"}, "id": "334584911815982", "channel_name": "LI
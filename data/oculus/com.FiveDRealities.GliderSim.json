3_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzvDtyOm6-kQ7kNvwFnoeiN&_nc_oc=AdrgPudM3ZZ707Ys88ShDwJ8qE8JglYNgjF3fjYngFNgF7BV2M8qwW63TsNKIZpRf_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjqLSM-4nBjugVtwIiCGv_fYVNHb1B6eeY-JJR9zwZIw&oe=6B0C66FE"}, {"file_name": "Screenshot2.png", "id": "376972667356816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974820_376972670690149_3288105923206203580_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyesMb0pMAUQ7kNvwFOKlKq&_nc_oc=AdpjObkvRx-qo-X46jtuqE2-Xoycu1J77exaS2_LtWtGexGFtJoW_V73XuZ2qJKUmUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9MtwjB9L7xG0cXQhZOXGFOxrpkx3NtJl3VoXLIRtF0Q&oe=6B0C5298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "323394513108914", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035322_323394516442247_221433893083022636_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re5a0nRRohwQ7kNvwHHgX1q&_nc_oc=Ado-C9t3q8C2dFunaCJYkrpdA-1RVvuWbffzmVY9CNoReWOjvRuaxTxF97vdVwiWy_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4w3yrZAbdallpSwzp9DFylPHmsiJV6zcmjUUbQ5fGxQ&oe=6B0C6007"}, "display_name": "Glider Sim", "keywords": [], "long_description": "Glider Sim is a professional paragliding and paramotor simulator built for real pilots in mind and is aiming to achieve photorealistic graphics! \n\nThe simulator takes place in Sun Valley, ID, United States. The scenery is derived from real world satellite imagery and overlaid with high resolution scenery and dense forest and trees.\n\nLots of attention went into the flight physics of the gliders as well as the wind and thermal system. Set your launch point and flying conditions then takeoff into the skies! Use wind current such as ridge lift and thermals to stay airborne. You can toggle on and off the wind visualization particle systems as well as change other flight conditions such as wind speed and direction.\n\nExperience state of the art flight physics where each cell of the glider is modeled and has physics applied! You can do maneuvers such as wingovers, spirals, stalls, and swoops. Watch out and don't let your wing collapse!", "short_description": "Experience the ultimate sensation of gliding through the sky! Built for real paragliding pilots in mind this simulator is as close to real as it gets. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BAqa7i5n38NI3LHQdANpLtsTEwJDHPIzWJJRG_iGr_c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "5D Realities", "support_website_url": null, "website_url": "https://5drealities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1354392565063348"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PENDING", "id": "1172158421943132"}, {"status": "PUBLISHED", "id": "1444244763756523"}, {"status": "PUBLISHED", "id": "1092105983196512"}, {"status": "PUBLISHED", "id": "3318359015031185"}, {"status": "PUBLISHED", "id": "3029883390534937"}, {"status": "PUBLISHED", "id": "984899271198837"}, {"status": "PUBLISHED", "id": "1796004174692071"}, {"status": "PUBLISHED", "id": "2342671869577142"}, {"status": "PUBLISHED", "id": "727962033523369"}, {"status": "PUBLIS
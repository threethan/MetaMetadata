 {"file_name": "02.png", "id": "455450905565145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404389_455450908898478_189181307660978746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0mgo3mzIsMQ7kNvwFrkXaj&_nc_oc=AdozE-3yZZCxIXHtsSExiV_iRc-re9Yz96k3rcJMa-No68YFtNBEdzNc8YO9nR2Zw3M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47eo9_XejOczjz199mq_h0ZYZHqBKBU9hx667niZHUog&oe=6A16F5F5"}, {"file_name": "01.png", "id": "1410681409265712", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031395_1410681415932378_7282475951672861618_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKekZmGZ54cQ7kNvwEy_svG&_nc_oc=AdqorBf_6eJ3z9l5VaUplGQAhMoU4a48xLsIKGG4cRc5f772pSoUveMIXmmXITSPywQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kchmiDtfqCCkUJRmY4R0LLLBIvyhKHwWGiVfZtCPadA&oe=6A16EAE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_video.PNG", "id": "489731825548533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_489731828881866_5152039745434726761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW0LBKzzEiUQ7kNvwGqLDJi&_nc_oc=AdqF5Ihhnt5dj7PyYtltFtlGfmzJb3iVq_ec8lkP0vhp6xvIlA8Hk365OQQ1OwZyzbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62OeNCWYyqSBj4F432tbTNYER9b0QWuF9_37E-u-Tvjw&oe=6A16E6F6"}, "display_name": "The Wizards - Dark Times", "keywords": ["wizards", "dark", "times", "magic", "spell"], "long_description": "Your body is frail, but your power is immense. Discover and master 11 individually designed spells with distinct abilities and effects. Forget about button combinations, command the arcane forces with nothing but hand gestures - as a true Wizard does!\n\nA mysterious dark plague has fallen on the realm of Meliora, twisting its inhabitants into beings of hatred and madness. Forbidden powers and rogue wizards are involved, leaving only you to face the apocalypse head-on. Dare to journey through the Forsaken Wood, wade thro
 {"file_name": "02.png", "id": "455450905565145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404389_455450908898478_189181307660978746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhsvE96nVJ4Q7kNvwEjv2Lq&_nc_oc=Adok5mNXhqAY9MOlRw21AiqsWzNvejAguUq1t_h0an3ojE8LrJZLs2XBfDfeu-9DIFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8y9DLi9bM_mCKbZf5zSeQCE8lb9_dbbG0BTfX6tUQiQ&oe=6A5F7875"}, {"file_name": "01.png", "id": "1410681409265712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031395_1410681415932378_7282475951672861618_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqSFa2zTusgQ7kNvwG1k9mc&_nc_oc=AdrvPTq-UiFVprBi-bV0UtABwSqdqQ4Mj1eUCyBZIXk8zq3dLqetd5ziWx7_hLAkUk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8dDw2OcQYAtCrMpZozRPWxPxg_42DiYZA1A4LJHuBsg&oe=6A5F6D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_video.PNG", "id": "489731825548533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_489731828881866_5152039745434726761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GKPmFBOCTwQ7kNvwG2iTvh&_nc_oc=Adp8oxux8NDU6qs0p4X4fVfEIJlNwxg7YnJORbhX6Dc2rnHmttYAxrNWI9Gt2Z0Fdvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbOqdPKQLUwL-LRMMRqihjxFZY__-pQ4piegc_ICF7qA&oe=6A5F6976"}, "display_name": "The Wizards - Dark Times", "keywords": ["wizards", "dark", "times", "magic", "spell"], "long_description": "Your body is frail, but your power is immense. Discover and master 11 individually designed spells with distinct abilities and effects. Forget about button combinations, command the arcane forces with nothing but hand gestures - as a true Wizard does!\n\nA mysterious dark plague has fallen on the realm of Meliora, twisting its inhabitants into beings of hatred and madness. Forbidden powers and rogue wizards are involved, leaving only you to face the apocalypse head-on. Dare to journey through the Forsaken Wood, wade through the poisonous swamps of Meliora, descend into the ruinous Necropolis, and more - with no magical barriers to stop you in place!\n\nMany fantastic creatures have fallen to the plague, becoming beings of destruction and death. Face new challenging enemies with unique abilities and individual behavior. Expect severe resistance - the world is ending, and it wants you dead too!", "short_description": "Face the end of the world in the sequel to The Wizards. The critically-acclaimed VR spellcaster returns with a gesture-based system, challenging enemies, grand adventure, and the ever-witty narrator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://darktimesgame.com/wp-content/uploads/2021/04/DT-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Carbon Studio", "support_website_url": "https://www.carbonstudio.pl/contact/", "website_url": "https://darktimesgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "ru", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "624444015317788"}}]}, "scheduled_offers": {"count": 49, "nodes": [{"status": "PUBLISHED", "id": "1962176857751427"}, {"status": "PUBLISHED", "id": "982393957617227"}, {"status": "PUBLISHED", "id": "919894127511428"}, {"status": "PUBLISHED", "id": "1416165490010033"}, {"status": "PUBLISHED", "id": "1256031153048876"}, {"status":
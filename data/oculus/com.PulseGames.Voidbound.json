1489564_2300076997655505287_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf7iVjaY6H8Q7kNvwEWlay7&_nc_oc=AdkXU7fs8B_BEQFzsIwVf9Az3Jp5vN-IoOGeE9kd614fbSPx_xA6ZRtKaxclcpZMZNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0AhhY2AFdUE6LVRYVP66h96VW6dMHfXmsYFXkdpjMog&oe=69B55354"}, {"file_name": "SampleScene_Custom..._11.07.2025_16-58-28.png", "id": "1874679893107063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_1874679896440396_6132988909719676437_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6IOP-UsatUQ7kNvwHTTusl&_nc_oc=AdlI3kp1OqXrtIRoDn6cbkJr0lIBEW6FajGoqIck5WV5SLqvZaX-wtD_koMIfGFQaUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzj9G7mpzES_xB83ugD3Gt4vpM0N9jNArAzCF_OKAil7A&oe=69B56DCE"}, {"file_name": "SampleScene_Custom..._11.07.2025_16-57-57.png", "id": "1075625797329192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299795_1075625800662525_8017885515756865472_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZGVpk-UrVkQ7kNvwFhZ-NR&_nc_oc=AdlV_v5RgFgD0Yd31YysZFajDvKK0OurAaxy0ilEKA5wiUEaO_Obmwz2NVVkhtk7YsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9ZbzzcvxIWog42JiuUhfZsgsZVz8zEs1iQ3OZTUpF4w&oe=69B54C8A"}, {"file_name": "SampleScene_Custom..._05.07.2025_15-40-33.png", "id": "1385117182712128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619055_1385117189378794_4685697881958893191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wjloxKEYgEQ7kNvwGzSpev&_nc_oc=Adkq1O7yGhLNAsaNfLCkbHJouSmnitnusmEQw4sZLncSQr_Nech_aCf_LPXJ1ixvoqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIoau8-dLn8auWKPnRU5TgvJ_N_34n835E4_DlfSx_Fg&oe=69B5698B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voidbound", "keywords": [], "long_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nWanna play zero-g games with your friends? \nWanna gaze into the endless abyss of space? \nWanna join a welcoming community of robots new and old?\nAll of your robot needs can be found right here at the NebulaNex station!\n\nYou may also want to take a visit to the Nebula Plaza, the first ever space mall located right on the NebulaNex!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!", "short_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nThe NebulaNex station is home to all of your robot needs, including a full, in-station mall!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!"}]}, "developer_name": "Pulse Games", "developer_privacy_policy_url": "https://sites.google.com/view/voidbound/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Pulse Games", "support_website_url": null, "website_url": "https://sites.google.com/view/voidbound/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24503423865931048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312306_724675066929889_1317516544986647731_n.
-25/499619055_1385117189378794_4685697881958893191_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wjloxKEYgEQ7kNvwGzSpev&_nc_oc=Adkq1O7yGhLNAsaNfLCkbHJouSmnitnusmEQw4sZLncSQr_Nech_aCf_LPXJ1ixvoqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIoau8-dLn8auWKPnRU5TgvJ_N_34n835E4_DlfSx_Fg&oe=69B5698B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voidbound", "keywords": [], "long_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nWanna play zero-g games with your friends? \nWanna gaze into the endless abyss of space? \nWanna join a welcoming community of robots new and old?\nAll of your robot needs can be found right here at the NebulaNex station!\n\nYou may also want to take a visit to the Nebula Plaza, the first ever space mall located right on the NebulaNex!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!", "short_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nThe NebulaNex station is home to all of your robot needs, including a full, in-station mall!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!"}]}, "developer_name": "Pulse Games", "developer_privacy_policy_url": "https://sites.google.com/view/voidbound/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Pulse Games", "support_website_url": null, "website_url": "https://sites.google.com/view/voidbound/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"
q0-8rrI13plVTA&oe=6B0C67CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voidbound", "keywords": [], "long_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nWanna play zero-g games with your friends? \nWanna gaze into the endless abyss of space? \nWanna join a welcoming community of robots new and old?\nAll of your robot needs can be found right here at the NebulaNex station!\n\nYou may also want to take a visit to the Nebula Plaza, the first ever space mall located right on the NebulaNex!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!", "short_description": "(Game currently in closed early access)\nVoidbound is here!\nVoidbound is home to the NebulaNex Station!\nHere we have a variety of different activities to enjoy and scenic spaces to unwind and relax!\n\nThe NebulaNex station is home to all of your robot needs, including a full, in-station mall!\n\nSo take a visit to the NebulaNex and who knows, it may become your new home!"}]}, "developer_name": "Pulse Games", "developer_privacy_policy_url": "https://sites.google.com/view/voidbound/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Pulse Games", "support_website_url": null, "website_url": "https://sites.google.com/view/voidbound/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
618512_983470484635094_8348146138788656652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Uu7P_9_z6kQ7kNvwGJFfg5&_nc_oc=AdrbGJjSBvIS9tv_LZ41UR3ee2IoFzwm-DM8JwsLMA9ekf4KXMWGGbxlp5IJEvZ2yY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I2UOuD9WjS30a-w7L_8pg8tX10EPh6bMy81wS5PurvQ&oe=6A38012C"}, {"file_name": "16_9 clone (1).png", "id": "817990607537332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_817990610870665_5318697997572411228_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lchb5LhL7VUQ7kNvwGdpbM2&_nc_oc=AdoHZpsrZfAUaIJoKgHMYeW9kzoWkeHJvdE1KkJ8kdjKnMOFNgZGPijgt7h_1h_veb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LvOTujJgRZ0xUZzm6fiVrQdYuOpdgRPowmRqPmb3tQw&oe=6A380BDC"}, {"file_name": "16_9  4 clone.png", "id": "763551016843604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_763551020176937_6263381611414932223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU86PjHP_YYQ7kNvwGEqZN8&_nc_oc=Ado8XuLnxyx-_hwgxcbClRH04CFRFht5myK434yIBKF85DChc7sQvqRvIf9zhDcopPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Py2A8Scwvskzg9e9cl--lJhgZNMI6LLAMGJvFB_yotw&oe=6A380926"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Headless Escape VR", "keywords": ["Survival", "Horror", "Scary", "Stealth", "Escape"], "long_description": "Headless Escape VR: The Ultimate Horror Experience\n\nThe Nightmare Begins\nYou wake up trapped in a decaying, desolate mansion where every shadow hides a scream. You are not alone. A relentless, headless entity stalks these halls, waiting for you to stumble. Do you have the courage to face the darkness and find a way out before you become its next victim?\n\nBuilt for True VR Immersion\nHeadless Escape VR is a heart-pounding survival experience rebuilt from the ground up for Meta Horizon. Feel the terror as if you were truly there.\n\nPhysical Interaction: Use your hands to physically open creaky doors, rummage through drawers for clues, and solve intricate puzzles.\n\nTrue Stealth System: When the entity is near, hiding is your only hope. Duck into closets, hold your breath, and stay silent to survive.\n\n3D Spatial Audio: High-fidelity spatial sound ensures you hear every footstep and distant whisper, letting you know exactly where the danger is coming from.\n\nKey Features:\n\nTerrifying Atmosphere: High-quality lighting and textures create a hauntingly realistic environment.\n\nChallenging Puzzles: Finding the exit requires more than just running you must solve the mysteries of the house.\n\nOptimized VR Performance: Smooth frame rates and refined movement systems to minimize motion sickness.\n\nAre you ready to face your fears? Download Headless Escape VR now.", "short_description": "Can you survive the night, or will you lose your head?\n\nEnter a heart-pounding VR horror experience where every shadow hides a scream. Trapped in a decaying mansion with a headless entity on your trail, you must solve chilling puzzles and find a way out before it's too late.\n\nKey Features:\n\nImmersive Horror: Designed specifically for VR with terrifying 3D audio and visuals.\n\nPhysics-Based Puzzles: Use your hands to interact, hide, and unlock secrets.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/60075b89-fb8e-45c5-9aa4-639b8cb94945", "developer_terms_of_service_url": null, "publisher_name": "Hawks Studios", "support_website_url": null, "website_url": "https://www.linkedin.com/in/shayan-naseem-496115163", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
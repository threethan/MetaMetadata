ale": "en_US", "screenshots": [{"file_name": "HorrorScene_2560x1440.png", "id": "1398649458760911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499313107_1398649462094244_3630325287863854885_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c4IyX-pqnUQ7kNvwE3nACp&_nc_oc=AdpLAGREc9foc0vQ5ZBCJZEeeYtkS0mTh1A07rBknQm9pfBvHQrr9SLsakshIVA4tKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MdKZ0x3f1s1_sbPgu8wthbWoM55ae699lBe6sm3I2EA&oe=6A34082C"}, {"file_name": "HouseExterior_2560x1440.png", "id": "1518513433155624", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312470_1518513436488957_4043080001697888426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcAS2MW32VYQ7kNvwF2Q7ap&_nc_oc=AdpSCfVj4UBxNPMyu3aeVYSqubaBK6e82gkDuU6pNpWJDe2BmAmLz79EfmiGvlgm6OQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9we2DpISHuUJzV2ytHUKUUwNBtDA3DN8h4DvrPQdrMlA&oe=6A340DDE"}, {"file_name": "horror_house_inside_2560x1440.png", "id": "2203411220491421", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499313107_2203411223824754_8349084647842420424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcMmh52j9LMQ7kNvwEXq8Zm&_nc_oc=AdrRFCzkBLVMY7cxRK59GiF1KJMyrR-RLFg4VPhoDbvX4fNYV_xxFSHtRs1ypbQN8kQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eqmjS-JdGFWgIDgZD_hiHHdfO4U2N_Er3PoK-vIKATg&oe=6A33F87E"}, {"file_name": "horror_stairs_2560x1440.png", "id": "2000504917501839", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507833663_2000504920835172_6295048499580692696_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z4apfNP5EcQ7kNvwHGjsLt&_nc_oc=AdolDECgOH3whwbBh2BZuROy8HGQdYBH28auabCOcCsIEGyBrWdSwEjSfzRltL1swcs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p8nYjpJkjJgZ0vYRZlzDrv_PMKKmasSICLDNEK3tWFw&oe=6A33F6BC"}, {"file_name": "horror_room_2560x1440.png", "id": "1326978828881099", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311585_1326978832214432_1454560789489568715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuY-GM9RzzIQ7kNvwErj_sE&_nc_oc=AdpgY4n2IvzTUCL2ejZEaoKn92Qa9iomUVpBdNLQC3pJEL1gATy_MicnsFRp2bm5qtc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5HI2UBYDmuhgcfPlNQwLl4clrNnUY4nyQYdZcbuhSTg&oe=6A33F3CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Headless Escape VR", "keywords": ["Survival", "Horror", "Scary", "Stealth", "Escape"], "long_description": "Headless Escape VR\n\nThe Nightmare Begins\nYou wake up trapped in a decaying, desolate mansion where every shadow hides a scream. You are not alone. A relentless, headless entity stalks these halls, waiting for you to stumble. Do you have the courage to face the darkness and find a way out before you become its next victim?\n\nBuilt for True VR Immersion\nHeadless Escape VR is a heart-pounding survival experience rebuilt from the ground up for Meta Horizon. Feel the terror as if you were truly there.\n\nPhysical Interaction: Use your hands to physically open creaky doors, rummage through drawers for clues, and solve intricate puzzles.\n\nTrue Stealth System: When the entity is near, hiding is your only hope. Duck into closets, hold your breath, and stay silent to survive.\n\n3D Spatial Audio: High-fidelity spatial sound ensures you hear every footstep and distant whisper, letting you know exactly where the danger is coming from.\n\nKey Features:\n\nTerrifying Atmosphere: High-quality lighting and textures create a hauntingly realistic environment.\n\nChallenging Puzzles: Finding the exit requires more than just running you must solve the mysteries of the house.\n\nOptimized VR Performance: Smooth frame rates and refined movement systems to minimize motion sickness.\n\nAre you ready to face your fears? Download Headless Escape VR now.", "short_description": "Can you survive the night, or will you lose your head?\n\nEnter a heart-pounding VR horror experience where every shadow hides a scream. Trapped in a decaying mansion with a headless entity on your trail, you must solve chilling puzzles and find a way out before it's too late.\n\nKey Features:\n\nImmersive Horror: Designed specifically for VR with terrifying 3D audio and visuals.\n\nPhysics-Based Puzzles: Use your hands to interact, hide, and unlock secrets.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/60075b89-fb8e-45c5-9aa4-639b8cb94945", "developer_terms_of_service_url": null, "publisher_name": "Hawks Studios", "support_website_url": null, "website_url": "https://www.linkedin.com/in/shayan-naseem-496115163", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27146125625041582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820923_1548132026873372_7463590729527058645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j24WH10RvfYQ7kNvwHj5Go_&_nc_oc=AdpxbLq-sP48Lwe_CFkdPRZKi-B0CGyKAF6EQ7fJR39WlwWidO33dwXIE534wOFWBss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lKoYd79CkXSQx3DZ2ouNH6FWtFrbeaKd0njxyfhxoTQ&oe=6A33F5B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Headless Escape VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "
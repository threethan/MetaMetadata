3356566", "locale": "en_US", "screenshots": [{"file_name": "1 (2).png", "id": "27660861363532045", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312332_27660861373532044_4761940542794207069_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wSQOr2fmD4Q7kNvwGn3MsF&_nc_oc=AdpdhSUgka0XHY762qK1Cj_0lPVNR2YDQ6P0topNKSO442mGp1bnVDCIS2EnfHMfqmQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdXpeWpYw0ZIWPvqRbLK51Ftb_n0SAnXvtY8YTjKccMQ&oe=6A8D9329"}, {"file_name": "3 (2).png", "id": "1000879549464678", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/507838217_1000879552798011_1679727963932020451_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg_3mp1ewUgQ7kNvwFVE_fX&_nc_oc=Adq98Cur47mBuTDXMfF4l3ns_pXeufBRKy222_lbOGTGDYcok6A1Z5dY4aKxYbYX5FM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHad1wZrvX3rSBsIFBxj6vtb0X6ZQrPWtN8gyFJDaivcg&oe=6A8D8B2D"}, {"file_name": "4.png", "id": "1449801753860145", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307962_1449801757193478_4849213868643035934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCg6c0sRvt0Q7kNvwHsxBaf&_nc_oc=AdrgF3iCBzPGqOSZseVoKOqERpwPgIi3cb4oEhZ68PcOkvB1sW4vgncI--9WxjcIXdY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLzCpek_4x6Ut70OBPvU8EfeI20bMWkpJUO_OR0l9A7g&oe=6A8D9AF3"}, {"file_name": "2 (2).png", "id": "1333796618199198", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499313072_1333796624865864_8940772427210200200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYDDeqmgAhsQ7kNvwEFcy1X&_nc_oc=AdrZTOtJJ0c5LCbS9RCX0WS_iL5KlyhiDLXtou0HTgJibBd0naSUmsDV2y69MiIdVDQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpNA2Af51qbzPQfQhxE7Gxp-nu5Fln48rZEhL4tdda3A&oe=6A8D85A3"}, {"file_name": "5_2560x1440.png", "id": "1392713849336885", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499311585_1392713852670218_6752710154628104828_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EqVpTB34toQ7kNvwExLV8P&_nc_oc=AdoVjBH443mYV4b-P0e12nmy7s1RShMoU4penz_Hsc1dj1DN9uDUh5eFHe9x3CuhM0A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeVSZ5tbHiuGO-6aNS8e57ratRjwu9mimJ9sUuhpjztg&oe=6A8D7E0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CatMansion_2560x1440.png", "id": "986520757715974", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_986520761049307_7115793154943484190_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jx_OdLfR2sQ7kNvwE1QMy4&_nc_oc=Adp3pHsRkju-h89OsIt8KhcuPVQj8nWz19o_85yyCfJ0YosWOOaYMOBl97doRKse7wE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI10tkQMEPi7xh-mHnGd3h8hzn7h1jilZMBPV4u5gypA&oe=6A8D69A5"}, "display_name": "Headless Escape VR", "keywords": ["VRHorror", "EscapeRoom", "Scary", "Stealth", "Horror"], "long_description": "The Nightmare Begins\nYou wake up trapped in a decaying, desolate mansion where every shadow hides a scream. You are not alone. A relentless, headless entity stalks these pitch-black halls, waiting for you to make a single mistake. Do you have the courage to face the absolute darkness, solve the mysteries of the house, and find a way out before you become its next victim?\n\nBuilt for True VR Immersion\nHeadless Escape VR is a heart-pounding survival experience rebuilt from the ground up for Meta Horizon. Step into a living nightmare where your real-world instincts dictate whether you live or die.\n\nFull Physical Interaction: Forget buttons. Use your hands to physically turn creaky doorknobs, rummage through dusty drawers for clues, and manipulate intricate mechanisms to unlock secrets.\n\nTrue Stealth & Hiding System: When you hear it coming, running isn't always an option. Duck into dark closets, peek through the cracks, hold your breath, and stay absolutely still to survive the entity's gaze.\n\n3D Spatial Audio: High-fidelity audio places you directly in the horror. Hear every terrifying footstep, distant whisper, and the scraping of the entity behind you, letting you know exactly which way to run.\n\nKey Features:\n\nTerrifying Visual Atmosphere: High-quality immersive lighting, eerie fog, and realistic textures create a hauntingly beautiful yet deeply unsettling VR environment.\n\nChallenging VR Puzzles: Escape requires brainpower. Solve deep, physics-based environment puzzles while u", "short_description": "Can you survive the night, or will you lose your head? Stalked by a relentless, headless entity in a decaying mansion, you must solve chilling VR puzzles and hide in the shadows to escape alive. True physical VR terror awaits. Dare to enter?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/60075b89-fb8e-45c5-9aa4-639b8cb94945", "developer_terms_of_service_url": null, "publisher_name": "Hawks Studios", "support_website_url": null, "website_url": "https://www.linkedin.com/in/shayan-naseem-496115163", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27313492064971603"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304952_1661688922138751_4033106432233253958_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q23_mgfDi9kQ7kNvwEHRlpS&_nc_oc=AdrlEo3hrOymY404_vcH47cTbEL8A0quDMBqy_AhwGj3c_z_RwzRAzcmX5nYwONDfnY&_nc_z
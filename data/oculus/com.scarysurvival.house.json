.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47vnmI0Ky9aeiVV4YgGWSju2GWhzo961SZy5kRlLNoVg&oe=6A107EDC"}, {"file_name": "16_9  4 clone.png", "id": "763551016843604", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499622315_763551020176937_6263381611414932223_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhP4wrrrLMQQ7kNvwH4XKXd&_nc_oc=AdqC17wgiVheAKH6koYPRSuVCgRTNAioD8ruuq2hbHoIlVc2wZ-RwkKZG4Zc6E0vmq4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ap9rSqZTXx-BDQ8DWIt7svBZ1yCrvb8P-WGMo-Fi7bg&oe=6A107C26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Headless Escape VR", "keywords": ["Survival", "Horror", "Scary", "Stealth", "Escape"], "long_description": "Headless Escape VR: The Ultimate Horror Experience\n\nThe Nightmare Begins\nYou wake up trapped in a decaying, desolate mansion where every shadow hides a scream. You are not alone. A relentless, headless entity stalks these halls, waiting for you to stumble. Do you have the courage to face the darkness and find a way out before you become its next victim?\n\nBuilt for True VR Immersion\nHeadless Escape VR is a heart-pounding survival experience rebuilt from the ground up for Meta Horizon. Feel the terror as if you were truly there.\n\nPhysical Interaction: Use your hands to physically open creaky doors, rummage through drawers for clues, and solve intricate puzzles.\n\nTrue Stealth System: When the entity is near, hiding is your only hope. Duck into closets, hold your breath, and stay silent to survive.\n\n3D Spatial Audio: High-fidelity spatial sound ensures you hear every footstep and distant whisper, letting you know exactly where the danger is coming from.\n\nKey Features:\n\nTerrifying Atmosphere: High-quality lighting and textures create a hauntingly realistic environment.\n\nChallenging Puzzles: Finding the exit requires more than just running you must solve the mysteries of the house.\n\nOptimized VR Performance: Smooth frame rates and refined movement systems to minimize motion sickness.\n\nAre you ready to face your fears? Download Headless Escape VR now.", "short_description": "Can you survive the night, or will you lose your head?\n\nEnter a heart-pounding VR horror experience where every shadow hides a scream. Trapped in a decaying mansion with a headless entity on your trail, you must solve chilling puzzles and find a way out before it's too late.\n\nKey Features:\n\nImmersive Horror: Designed specifically for VR with terrifying 3D audio and visuals.\n\nPhysics-Based Puzzles: Use your hands to interact, hide, and unlock secrets.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/60075b89-fb8e-45c5-9aa4-639b8cb94945", "developer_terms_of_service_url": null, "publisher_name": "Hawks Studios", "support_website_url": null, "website_url": "https://www.linkedin.com/in/shayan-naseem-496115163", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26459392630381555"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820923_1548132026873372_7463590729527058645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5PGwpt56wYQ7kNvwHNXNTw&_nc_oc=Ado0eXY6TG4ZPAEhOISIeUwc-5ZaOtxAS_4B3ycTCQJD2QUF2RWsEK9zSIIMzEJo1Qc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc
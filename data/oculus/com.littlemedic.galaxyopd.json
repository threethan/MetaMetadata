ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312068_2333142570786112_6681827255284507003_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx0U2L2PMBQQ7kNvwGJX9pj&_nc_oc=AdqbhpnJpD-SVO0nCJCkJKkZRDAmrNLEkHDyVgZ64NLOcJnS03yhsO7hFq8f-S8JRZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-tgap6GsWHMbk3d8L2CmAgs5loenBp_Csf04CxWZuXw&oe=6B106805"}, {"file_name": "room-0_2560x1440.png", "id": "1796012681664143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1796012684997476_6930160116755577043_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffPw53CdsdsQ7kNvwFYdJWW&_nc_oc=AdrQSmWKkVe84GFIvIdYUQcKZOtaZx-3BWP-lIrjq2WIYiH9z-Gz7GsG3rDRFi31WrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhfyqLrCt55jcDyV2M00TWu49Hr48ZMmL-vKCdNRVrCg&oe=6B103C5C"}, {"file_name": "seated_patient_03_mayo_stand_and_patient.png", "id": "1671722774631575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312454_1671722777964908_7950254085279191563_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QjxCZBohfAQ7kNvwHHsUdc&_nc_oc=AdqAN4tG5vPj0VguIBES65ySoBjtHXppH_w3kEiQiodgKOkVgwNAA3MvaIwzWtcAryQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXseMGfubW203LR12X84R_LS9_x0e-HwH1-x81T_tIufw&oe=6B103CC4"}, {"file_name": "leo_2560x1440.png", "id": "2293915418136813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604375581_2293915421470146_8549914487659547453_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C39npV5yPP8Q7kNvwHFg9j4&_nc_oc=AdoZ4gmeKKkqfml9uk2oAiqwejSV248mCw_hI1_hF7Ht4huhPZHaxO17jGWh_JF5sw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa99sNiVW2wKtd0x0TxYETahXRq9M0PDEBrBLRdOfLFw&oe=6B105B15"}, {"file_name": "knee-corner-1_2560x1440.png", "id": "1665941838494729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1665941841828062_2775052509700164085_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGKBmHq8YE8Q7kNvwHrCWof&_nc_oc=AdqHRC_hrw9HXIQVK0MvqM_Y9TRni2zAXiU1TqeAuCdlqJWNOg3-C95yMPZYnCgjnjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNV7dW0bFSCc7YfAgIHMtp-fkxhPOqi3PVjkzNQIn8HQ&oe=6B1054CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "first doctor-opd.png", "id": "29609677355385424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308026_29609677365385423_8017681903143452690_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDLwH94nh_oQ7kNvwHsXsmd&_nc_oc=Adqk8HH6vro7vxISq308n_VmKdBiud_qQfYXWxBORiOFNFiX4f-j1wPONQExdsPQCVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMllhjr2U72BiL5EzTEd_wJYR-i32JBeT02QXjE9Iakw&oe=6B1069F3"}, "display_name": "Little Doctor OPD Galaxy Clinic VR", "keywords": ["doctors", "little", "kids", "LittleDoctorOPDGalaxyClinicVR", "clinicfun"], "long_description": "# Big smiles. Little doctor. A whole galaxy of care.\n\nStep into a colourful OPD clinic where curious aliens, adorable animals and cheerful robots are waiting to meet Doctor YOU.\n\nPick up the glowing tool, aim at the right spot and watch your star power grow. Scan, treat and give pretend medicine as patients respond with funny reactions and happy thanks.\n\n## Seven special rooms to discover\n- **Dentist:** chase sugar germs, rinse and polish a sparkling smile.\n- **Wobbly Knee:** scan, match shapes and finish with a cosy wrap.\n- **Alien Hair Care:** plant star seeds and reveal a playful new style.\n- **Heart Beats:** watch the colours and tap the rhythm.\n- **Wing Rescue:** help a little dragon get its zoom back.\n- **Brave Injection:** clean, treat and earn a brave star plaster.\n- **Skating Scrape:** rinse, clean and bandage a skating mishap.\n\nEvery three completed OPD visits unlocks a special appointment. Your first trip is to the dentist! Earn hero badges and enjoy your patients' happy goodbyes before returning to your clinic.\n\nDesigned for seated play with Touch controllers. Press grip once to hold a tool, aim to help, and press grip again to release. Includes spoken English guidance, adjustable view height and a quick recenter option.\n\nSingle-player. All care, treatments and readings are fictional pretend play, not medical advice.\n\nSEARCH KEYWORDS (5)\ndoctor\nclinic\ndentist\narcade\nsimulation\n", "short_description": "Your galaxy needs a care hero! Meet funny patients, pick up colourful tools and turn little worries into big smiles. Run your OPD clinic, then discover seven special rooms with tooth care, wobbly knees, alien hair, heart rhythms, wing rescue and more. Made for seated VR play with simple grip-and-aim controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitizingtoday.com/games/privacy", "developer_terms_of_service_url": null, "publisher_name": "https://digitizingtoday.com", "support_website_url": null, "website_url": "https://digitizingtoday.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1506933417998946"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2270511597676960"}, {"status": "PUBLISHED", "id": "1685674436286677"}]}, "baseline_offer": {"id": "1685674436286677"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2270511597676960"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1517990986893189", "version": "1.14.2"}, "id": "2071834633536470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1506933411332280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1517990986893189"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2071834633536470"}]}, "change_log": "Enjoy hands-free play with hand tracking\u2014no controllers needed\u2014and automatic switching when you pick up your controllers. The clinic now adjusts to seated or standing players, with improved tool grips, easier reach, clearer side menus, and better patient and chair alignment. After every three checkups, visit a special clinic automatically and return when treatment is complete. Meet more animated patients and funny germs, hear louder, playful animal reactions, and enjoy brighter heartbeat effects and a new rotating emergency siren, alongside tracking, interaction, and stability improvements.", "created_date": 1795136460, "id": "1517990986893189", "version": "1.14.2", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1506933411332280", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1517990986893189"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "i
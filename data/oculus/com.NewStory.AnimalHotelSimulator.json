ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE13r104XrNK-FfNUChV7mLlvTL0hAhmDH5AQWSbGPNqQ&oe=6A843800"}, {"file_name": "screenshot4.png", "id": "1797314224394098", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1797314227727431_157826986001053307_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl8nALN5VWMQ7kNvwE0OYEe&_nc_oc=AdoodSv3mqimXIgfS40iRg1ThhYFUNL5Sw_rDjJ50c3uVX2cEtbrKKMrGXQ8b4l6KV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYf192U8egMxAK87WxP7xC4tIY1pM0farmsozNw3ctw&oe=6A84553D"}, {"file_name": "screenshot3.png", "id": "1036771268273592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393718_1036771271606925_2485325265061563247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-ARVcqn9kEQ7kNvwEOhtUY&_nc_oc=AdqZfoMgSff_w7E9oFXvMSY1_ZfehdU5c0VYKP7CGTP9T4QIDyUvco8rda2QlBaRGMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu7XXttIQia39wauvrNLmN5ZYK80MOvsblKBd97nJQtQ&oe=6A844564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "652312050611976", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_652312053945309_4070145602436780626_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amoWBUfskZIQ7kNvwHH3iKb&_nc_oc=AdoU6laHpqdCGdWSKavgMvtc48GVjWt7BHr1MMB13HQzqd3pbiH6-r-EA-Gqnp_Vm5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4cReueZSonGUaH9Jp5ULYZHYCaCCJPIOqB5inG1a0aA&oe=6A8435BE"}, "display_name": "Animal Hotel Simulator VR", "keywords": ["animal", "hotel", "simulator", "action", "simulation"], "long_description": "Dive into a deep hotel management simulation! Craft your dream hotel from the ground up and optimize your services to attract guests from around the globe. Hire the best staff, master the art of hospitality, and climb the ranks to become the world's No.1 hotel owner!!\n\nI am hotel staff, and my job is to provide super service and keep this wild crew happy. Think you can handle the chaos? As a super hotel staff member, you'll provide Security and great customer service to all your animal guests.\n\nHere's what awaits you:\n- Super Security Challenges: Keep those mischievous animals from turning your hotel into a zoo!\n- Hilarious Animal Interactions: Get up close and personal with elephants, crocs, and hippos, each with their own crazy quirks.\n- Hotel Management Mayhem: Upgrade your facilities, hire staff, and build the ultimate animal paradise.\n- Immersive VR Experience: Feel like you're right in the middle of the action with stunning graphics and realistic animal behaviors.\n", "short_description": "Aim to be the world's best hotel owner! Manage a hotel bustling with animals and provide the highest level of service. Experience interactions with adorable animals and the depth of hotel management in this simulation game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28638018365813347"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1832987517296731"}, {"status": "PUBLIS
cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLF4ouotif8Q7kNvwGqLfH3&_nc_oc=AdlMxsYGZdpZPvL6vEw16uv9uPMng4vSJgZrvinkeGSKWYKC-HMOip4An6axx3oinfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3-rSLeva9DmS3Z0m1A_d7ko9XfWZo-Z0CSwTctF3PTQ&oe=69A041BD"}, {"file_name": "screenshot3.png", "id": "1036771268273592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393718_1036771271606925_2485325265061563247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXnsbIVhv9oQ7kNvwEgDg6q&_nc_oc=AdmtaVnQsF4egRsOLL9N1Qnc13R0Yro4VOQaW_jJGJ3Cmfa0Y2XZrZHxeNWTJFtI4_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFjtIVFVA-MA-gJpE4RcXDaRVIh0jBNLNnpXIBUw_N2A&oe=69A031E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "652312050611976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_652312053945309_4070145602436780626_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJr4Uf7TbLUQ7kNvwG8bOcC&_nc_oc=AdmGw_U0UrfJQfjSeGyiKec07EkXk5Bj6ikGjDewaOF0y6fC6e0tWiFz8fC3QLEK0CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUDXe4HmfzM040nhxjgzFN-BsSBZYYuxxs1legqMNxDw&oe=69A05A7E"}, "display_name": "Animal Hotel Simulator VR", "keywords": ["animal", "hotel", "simulator", "action", "simulation"], "long_description": "Dive into a deep hotel management simulation! Craft your dream hotel from the ground up and optimize your services to attract guests from around the globe. Hire the best staff, master the art of hospitality, and climb the ranks to become the world's No.1 hotel owner!!\n\nI am hotel staff, and my job is to provide super service and keep this wild crew happy. Think you can handle the chaos? As a super hotel staff member, you'll provide Security and great customer service to all your animal guests.\n\nHere's what awaits you:\n- Super Security Challenges: Keep those mischievous animals from turning your hotel into a zoo!\n- Hilarious Animal Interactions: Get up close and personal with elephants, crocs, and hippos, each with their own crazy quirks.\n- Hotel Management Mayhem: Upgrade your facilities, hire staff, and build the ultimate animal paradise.\n- Immersive VR Experience: Feel like you're right in the middle of the action with stunning graphics and realistic animal behaviors.\n", "short_description": "Aim to be the world's best hotel owner! Manage a hotel bustling with animals and provide the highest level of service. Experience interactions with adorable animals and the depth of hotel management in this simulation game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29601482622800245"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393652_28729421250005963_9206221269940275866_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QiXc_5hjt4Q7kNvwFhivL9&_nc_oc=Adkm8NuaX904An5OucBELIY-ZJSFbOz2nP0hWSsKtyLBiM2xRgYJpccwCCxCkQhrY88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDFpR51aU0L_Tthm4BCnW5FEnZ2UAYQBUvgfi2HtbhmA&oe=69A053BF"}, "is
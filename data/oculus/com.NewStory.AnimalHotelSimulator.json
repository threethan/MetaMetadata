enshot5.png", "id": "3477076219090844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_3477076222424177_8134630250272719852_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HDtZSXRk3YQ7kNvwH585BN&_nc_oc=AdorblJOyJ4HIse1BJEaFCzvTCJOgu2iWTLRclNXzPcbqDu31Nyidl5POwkzOsnO8WE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3fop3ARQ1sKc949dyYJGG1YoNnFDK4Ju3ZHZrgH54aPw&oe=69F0B64E"}, {"file_name": "screenshot1.png", "id": "1801267400639199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_1801267403972532_1844380825730135798_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctFPOO1-I-0Q7kNvwFfhXuK&_nc_oc=Ado-xXdghFS3CNadzPKVn1Qhm9KHiktvEWoUQvE6Awjuiyokwmbf3llomwcTqqPtiCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3xYjTrWolFypKhaxVotO6qNK4nWNqpxbuoF5PTOeo7LQ&oe=69F0C840"}, {"file_name": "screenshot4.png", "id": "1797314224394098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392168_1797314227727431_157826986001053307_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L81QQmU1424Q7kNvwF05zmU&_nc_oc=AdpdY5Nz9tfIjIJKzWVqNNBobTaS4ufO7s8J-Dw4yTb73d6MB2xqefVcqdG7xKJsGcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0Etzoa_zv2NoWlwFEW0PSBPmzHTKhVMYWCbTG8mypq9g&oe=69F0AD3D"}, {"file_name": "screenshot3.png", "id": "1036771268273592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393718_1036771271606925_2485325265061563247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8NYEq7rkZQQ7kNvwFBBlNw&_nc_oc=Adq3c8TJadX75qfAjY86LxMtXlbjtzk6KZTwLOQdRq7Qa8BGupryaSKJtUBJPwcwNpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Re7B2ZST_casq6glwDrgWedftqQgE3qAhoVyuUPTmAA&oe=69F09D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "652312050611976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_652312053945309_4070145602436780626_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2eLGfFG2KoQ7kNvwGOgl_j&_nc_oc=AdrKrZVllhgvNcz4VejSKELtKUlqN58-tASzgt96JFYrjpA7UscLTfGQsicYMzFup4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3SKiPnYrDmzTx4fha-SYPolNCs25Klk0J6ugzkdm3P-w&oe=69F0C5FE"}, "display_name": "Animal Hotel Simulator VR", "keywords": ["animal", "hotel", "simulator", "action", "simulation"], "long_description": "Dive into a deep hotel management simulation! Craft your dream hotel from the ground up and optimize your services to attract guests from around the globe. Hire the best staff, master the art of hospitality, and climb the ranks to become the world's No.1 hotel owner!!\n\nI am hotel staff, and my job is to provide super service and keep this wild crew happy. Think you can handle the chaos? As a super hotel staff member, you'll provide Security and great customer service to all your animal guests.\n\nHere's what awaits you:\n- Super Security Challenges: Keep those mischievous animals from turning your hotel into a zoo!\n- Hilarious Animal Interactions: Get up close and personal with elephants, crocs, and hippos, each with their own crazy quirks.\n- Hotel Management Mayhem: Upgrade your facilities, hire staff, and build the ultimate animal paradise.\n- Immersive VR Experience: Feel like you're right in the middle of the action with stunning graphics and realistic animal behaviors.\n", "short_description": "Aim to be the world's best hotel owner! Manage a hotel bustling with animals and provide the highest level of service. Experience interactions with adorable animals and the depth of hotel management in this simulation game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188
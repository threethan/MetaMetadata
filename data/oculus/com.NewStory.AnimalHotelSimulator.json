3xQl8VOE6y-UfSJaK4nsyVEBbk3icxI_RlbG34YRaev8QJig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcLwH1LEewa-QMmXWgcw7I5BRzLWCgbLgiRYQfVTnqUw&oe=6A6602BD"}, {"file_name": "screenshot3.png", "id": "1036771268273592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393718_1036771271606925_2485325265061563247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkagvG-siyoQ7kNvwG_GQq1&_nc_oc=AdpA43AyWvugrEREayFKK2CZGBD_FEOuhlfmm6JGZzQQoKAkHfbH8SqpWjC8p91CpE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7G_EHBrTtXF-_7UKhBBm4YeQlAQWANhkf1bYbxDSeMA&oe=6A65F2E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "652312050611976", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391946_652312053945309_4070145602436780626_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zka80RusK8sQ7kNvwF-oSmp&_nc_oc=AdpYo5fEarasa81ul_3ekbB2u7iIsbLksauxNYHbYA1aEk4kDtjn8ssEAqwgyOsFtTs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtHXY2A53FHMc0QXWRusMztJFit47MsDNDqkGioZ5EJg&oe=6A661B7E"}, "display_name": "Animal Hotel Simulator VR", "keywords": ["animal", "hotel", "simulator", "action", "simulation"], "long_description": "Dive into a deep hotel management simulation! Craft your dream hotel from the ground up and optimize your services to attract guests from around the globe. Hire the best staff, master the art of hospitality, and climb the ranks to become the world's No.1 hotel owner!!\n\nI am hotel staff, and my job is to provide super service and keep this wild crew happy. Think you can handle the chaos? As a super hotel staff member, you'll provide Security and great customer service to all your animal guests.\n\nHere's what awaits you:\n- Super Security Challenges: Keep those mischievous animals from turning your hotel into a zoo!\n- Hilarious Animal Interactions: Get up close and personal with elephants, crocs, and hippos, each with their own crazy quirks.\n- Hotel Management Mayhem: Upgrade your facilities, hire staff, and build the ultimate animal paradise.\n- Immersive VR Experience: Feel like you're right in the middle of the action with stunning graphics and realistic animal behaviors.\n", "short_description": "Aim to be the world's best hotel owner! Manage a hotel bustling with animals and provide the highest level of service. Experience interactions with adorable animals and the depth of hotel management in this simulation game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28638018365813347"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1832987517296731"}, {"status": "PUBLISHED", "id": "1728402267775123"}, {"status": "PUBLISHED", "id": "1860638424683820"}, {"status": "PUBLISHED", "id": "437884192684615"}]}, "baseline_offer": {"id": "437884192684615"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1832987517296731"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "An
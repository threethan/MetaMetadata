ss=7f20f&oh=00_AQQXaFcYcNsNCkdCBjXPA4KGlTW0wQjQzf3WFh4A0lyRxA&oe=6AFC77D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 1 2560.png", "id": "1038311352591516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1038311355924849_6239940989305583215_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov6-aGDmYXQQ7kNvwHS0eyZ&_nc_oc=AdogdT-D8FnYOveLULSG-N_Ubq_hHA_gAQV3kTIcN8PDLNPtVp1T8HfO4ha8EnEMQV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ25iGSaRofEx02p06cX8GRQLcRAj-5YLD_5q7tMCbTTQ&oe=6AFC7EE0"}, "display_name": "XeeXR Remote Guidance", "keywords": ["streaming", "training", "support", "guidance", "remote"], "long_description": "XeeXR Remote Guidance lets trainers, experts and clients view a user's session in a compatible VR, AR or MR app on a supported Meta Quest VR headset and communicate through two-way audio.\n\nThe app runs on the headset while its live view streams over the internet to the XeeXR Dashboard in a browser. Participants can be at different locations and on different networks. The remote participant needs neither a second VR headset nor a copy of the external app.\n\nDesigned for businesses and organizations, Remote Guidance supports training, simulation, product demonstrations, BIM and CAD reviews and user support.\n\nHow to get started\n\n1.\tCreate your account at portal.gotoviar.com and open the XeeXR Dashboard.\n\n2.\tInstall XeeXR Remote Guidance on your supported Meta Quest VR headset.\n\n3.\tAdd a Remote Guidance app in the dashboard, name it and generate a QR code.\n\n4.\tOpen Remote Guidance on the headset and scan the QR code to pair the app.\n\n5.\tClick \"Connect\" in the dashboard and \"Start Session\" in the headset app. Either order works. Then open the external VR, AR or MR app.\n\nRequires an active XeeXR account, dashboard access, a compatible external app, a suitable browser and internet connection. Functionality depends on the headset, firmware, external app, browser, network and XeeXR release.\n\nXeeXR is a product developed by GOTOVIAR.\n", "short_description": "View VR, AR and MR apps live from a Meta Quest VR headset in your browser. Use two-way audio for remote training, reviews and support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gotoviar.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GOTOVIAR BV", "support_website_url": null, "website_url": "https://gotoviar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1633892588344644"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28642633358687245"}]}, "baseline_offer": {"id": "28642633358687245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790693880, "status": "PUBLISHED", "id": "28642633358687245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1641366220930614", "version": "2.1.1"}, "id": "1755260095520729", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "What's new in 3.0.0\r\n \r\nThis is a major update with a rebuilt connection system for more reliable remote guidance sessions.\r\n \r\nNew\r\n\u2022 System audio sharing: the remote expert can now hear the sound from apps running on your headset, and can turn it on or off at any time\r\n\u2022 Remote Guidance now runs as a background service: share your headset view and voice while you keep using other apps\r\n \r\nImprovements\r\n\u2022 Sessions can now connect on more networks, including restricted company and guest Wi-Fi\r\n\u2022 Faster, more stable connections that recover automatically if the network drops\r\n\u2022 Improved audio and video streaming\r\n\u2022 Clearer voice on unstable networks: short audio dropouts are now filled in automatically\r\n \r\nFixes\r\n\u2022 Ending a session now correctly disconnects the other participant\r\n\u2022 Fixed a problem where a dropped connection could keep reconnecting in a loop\r\n\u2022 Fixed a problem that could cause audio glitches when sharing your microphone or headset sound", "created_date": 1794316147, "id": "1675135840886985", "version": "3.0.0", "version_code": 7, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "What's new in 3.0.0\r\n \r\nThis is a major update with a rebuilt connection system for more reliable remote guidance sessions.\r\n \r\nNew\r\n\u2022 System audio sharing: the remote expert can now hear the sound from apps running on your headset, and can turn it on or off at any time\r\n\u2022 Remote Guidance now runs as a background service: share your headset view and voice while you keep using other apps\r\n \r\nImprovements\r\n\u2022 Faster, more stable connections that recover automatically if the network drops\r\n\u2022 Improved audio and video streaming\r\n \r\nFixes\r\n\u2022 Ending a session now correctly disconnects the other participant\r\n\u2022 Fixed a problem where a dropped connection could keep reconnecting in a loop", "created_date": 1793709050, "id": "1668047684929134", "version": "3.0.0", "version_code": 6, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "Fixed pairing being lost after restarting the app. Please pair once more after updating.", "created_date": 1791298334, "id": "1641366220930614", "version": "2.1.1", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "Fixed pairing being lost after restarting the app. Please pair once more after updating.", "created_date": 1791296413, "id": "1641342257599677", "version": "2.1.1", "version_code": 4, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "Remote Guidance connects your headset to a remote expert who can see what\r\nyou see and talk you through the task in front of you.\r\n\r\n\u2022 Scan a QR code to pair with a session \u2014 no manual codes to type\r\n\u2022 Share your view and voice with the remote expert in real time\r\n\u2022 Start and stop sessions from the in-headset panel", "created_date": 1790356394, "id": "1630901521977084", "version": "2.1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
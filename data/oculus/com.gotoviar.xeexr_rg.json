: "1450189417024127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1450189420357460_7906020745119294774_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLQ2BTjNcrMQ7kNvwG_tEBr&_nc_oc=AdoyqHDUNJk_7Gyaouak8S22LsV7f8G-Ez6T9tiwNHXi2bdYQ7jgND4bn7YP5Pep3nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDHjaQN03aotlFRaPEbMAsnwpspwmQi2E8-svL2gcabw&oe=6AEB3999"}, {"file_name": "XeeXR-Remote-Guidance-02-Start-Scan-2560x1440.png", "id": "4508566769411841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_4508566772745174_6284524578529856601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1OfGuiVtCoQ7kNvwFfcbKZ&_nc_oc=AdpF24hVW4fQk9awzoD-cy7-tVvaMkZIU0F7A7o1pdJz2vaebFQSPgKp2QiY5yY_1Kk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAysmeGFVjpTtrhRZI4XAUGVG9zIZtXnmspuvISro0hA&oe=6AEB58F4"}, {"file_name": "XeeXR-Scanner-Frame-2560x1440.png", "id": "1624486286012783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1624486289346116_218608890201562795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC3YVA0E0ToQ7kNvwHjXP78&_nc_oc=AdrYHVdA0VIzSKo8sY8Xs920TcWs4ZiZsdjZ93gvx7K-oP1WMU4Prpbu_CdjOiEbWPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbOIPr4n6idCmVQbLcFYl4v9kghxWLr6u7K2Dn3g8ymA&oe=6AEB4A5F"}, {"file_name": "Paired succes alert 2560.png", "id": "2249024632306054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827973_2249024635639387_7031228560259539540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHl9-q4ReqAQ7kNvwFIt_vd&_nc_oc=AdoOw_gokaIdKMemxH5AMGqOJAEb8-Y3WaX8ETxV6c89nT_rDdaNeBAY5hDtzdk1zuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYkM67Mvpe7FQiXp8SeG_oU8VmtiuykLYOeLid9gS5fw&oe=6AEB5452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 1 2560.png", "id": "1038311352591516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1038311355924849_6239940989305583215_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jWU0VsI1u4Q7kNvwFzR97B&_nc_oc=AdoSqs6wjcHAFyZIjW1NG0HSPbdx0p448JMWDhf4m1tsHHnHsYafyvkNv26Q42eCZtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYL7qnkclgQUAdqYZKdAfFF8Rdno7c6I1YEqAhRUXSGA&oe=6AEB5B60"}, "display_name": "XeeXR Remote Guidance", "keywords": ["streaming", "training", "support", "guidance", "remote"], "long_description": "XeeXR Remote Guidance lets trainers, experts and clients view a user's session in a compatible VR, AR or MR app on a supported Meta Quest VR headset and communicate through two-way audio.\n\nThe app runs on the headset while its live view streams over the internet to the XeeXR Dashboard in a browser. Participants can be at different locations and on different networks. The remote participant needs neither a second VR headset nor a copy of the external app.\n\nDesigned for businesses and organizations, Remote Guidance supports training, simulation, product demonstrations, BIM and CAD reviews and user support.\n\nHow to get started\n\n1.\tCreate your account at portal.gotoviar.com and open the XeeXR Dashboard.\n\n2.\tInstall XeeXR Remote Guidance on your supported Meta Quest VR headset.\n\n3.\tAdd a Remote Guidance app in the dashboard, name it and generate a QR code.\n\n4.\tOpen Remote Guidance on the headset and scan the QR code to pair the app.\n\n5.\tClick \"Connect\" in the dashboard and \"Start Session\" in the headset app. Either order works. Then open the external VR, AR or MR app.\n\nRequires an active XeeXR account, dashboard access, a compatible external app, a suitable browser and internet connection. Functionality depends on the headset, firmware, external app, browser, network and XeeXR release.\n\nXeeXR is a product developed by GOTOVIAR.\n", "short_description": "View VR, AR and MR apps live from a Meta Quest VR headset in your browser. Use two-way audio for remote training, reviews and support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gotoviar.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GOTOVIAR BV", "support_website_url": null, "website_url": "https://gotoviar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1633892588344644"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "28642633358687245"}]}, "baseline_offer": {"id": "28642633358687245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790693880, "status": "PUBLISHED", "id": "28642633358687245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1641366220930614", "version": "2.1.1"}, "id": "1755260095520729", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1629041892163047", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1641366220930614"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1755260095520729"}]}, "change_log": "Fixed pairing being lost after restarting the app. Please pair once more after updating.", "c
37_5014270249595180068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-g-9eM_KPoQ7kNvwFI2EsQ&_nc_oc=Adk8RocMJV0VlNoYe1mLYIjKbjHhQoqhq-bixuDFeRamEKLQU6zK5Og7dX7dZuvULUQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhrN_ym66X16be2IELLnhFK7-llVCv-zLPj-clcYNOag&oe=69BD52ED"}, {"file_name": "image7-PNG24.png", "id": "2958416797620583", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001672_2958416800953916_101512229079805465_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd0_inA5mEEQ7kNvwGhAV3a&_nc_oc=AdmUwzMpieeqPnxgKApXfeSCqKUzCLHUBdu4ATR2_7kgTpJSctI_ZWUtxeeiIGhOgvs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf8mk_Kszf83N_ydNvN_vwm3pVzc3kX1hCTyqkDJhk7g&oe=69BD551D"}, {"file_name": "Group-203-PNG24.png", "id": "2849646311930827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75404372_2849646318597493_7750170330449046171_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=802bmfmJMd0Q7kNvwGXegBj&_nc_oc=AdlbK8te9ZnDFbi134CrbaJkSiUjRgNz4kJJQhMunfNd5_t91QCnaMf9cuE37aAwNxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhE3jMUIe5_y9nR0o6MVihnnkHDx5qZSUxdn26OmOimw&oe=69BD4323"}, {"file_name": "image-4-PNG24.png", "id": "329465291535638", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476598_329465294868971_915099151972390857_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXpU3UgdPsQ7kNvwExOEB4&_nc_oc=AdlzQatiq8k8MXYuOsrlnx2mZNtanJxMPNjV3VdJh1G7Efu1RVSpd_2MDfJ-sjAKInM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDJbhhApn4lytQ1ltKmteUxfEE_-ETGeUXF7-vnYoe5g&oe=69BD5B13"}, {"file_name": "quest7-PNG24.png", "id": "349757816030660", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031308_349757819363993_6809272252006383934_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8qY8AG7FT0Q7kNvwFYDD-n&_nc_oc=AdlC819C4_i0t4x-aOpRfIDdMCg3RwM4jia0cnV14s-OKAgVFdIZjoTpIiLBxOdLPqg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwC_K5vh-Pehha1-keWo8xKmB-jRHQvBIi7rYIZdEg76w&oe=69BD5B85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "REVISED_2560x1440.png", "id": "637109270552510", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974447_637109273885843_2049905708003950599_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x6Od5-y8CMQ7kNvwFQriDv&_nc_oc=AdnK2daPSCFaR2OB4JLBRdgIuF9N5WK6pIYzCCc4TD-mggrEopyLeMZTUtoPxuFlbLI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6L43eNdFGZv_qnpALJvvnJzQseTI_kIqZljxtviNzpA&oe=69BD3BFE"}, "display_name": "Spatial", "keywords": ["Free", "Virtualdesktop", "Productivity", "Collaboration", "Meeting"], "long_description": "How work should be.\n\nSpatial brings people together for hangouts, immersive presentations, team planning, product reviews, & brainstorms.\n\nDuring a time when collaboration feels disconnected, unclear, and inefficient, Spatial enables you to - \n\nSIT NEXT TO EACH OTHER FROM ACROSS THE WORLD\n- Create your lifelike 3D avatar from a selfie in seconds\n- Your avatar talks, moves, and interacts, mirroring in-person collaborative sessions\n\nMAKE YOUR ROOM IS YOUR MONITOR, YOUR HANDS ARE YOUR MOUSE\n- Fill your room with information, defying the limits of your 2D screen\n- Enjoy beautiful immersive 3D environments \n- Express and share ideas w/ whiteboarding, notes, & photo/3D model search \n\nUSE ALL YOUR FAVORITE TOOLS\n- In-app browser + screen sharing\n- Seamlessly upload many 2D/3D file types \n- Integrate with Slack, Google Drive, and more\n\nJOIN FROM ANY DEVICE\n- VR + AR (Quest, Nreal, HoloLens, Magic Leap)\n- Mobile (iOS + Android) & Web", "short_description": "Spatial brings people together for hangouts, immersive presentations, team planning, product reviews, & brainstorms.\n\nAdd Spatial to your wishlist, and get notified when the app is released! \n\nSpatial enables you to:\n\n- Sit next to each other from across the world by creating a lifelike avatar from a selfie in seconds\n- Fill your room with  2D/3D content, including screen share, browser, sticky notes and whiteboarding\n- Integrate with tools like Slack or Google\n- Join from VR, AR, Web, & Mobile"}]}, "developer_name": "Spatial", "developer_privacy_policy_url": "https://spatial.io/privacy", "developer_terms_of_service_url": "https://spatial.io/terms/", "publisher_name": "Spatial", "support_website_url": "https://support.spatial.io/", "website_url": "https://spatial.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "408326344401343"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3376645172430456"}]}, "baseline_offer": {"id": "3376645172430456"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1599152400, "status": "PUBLISHED", "id": "3376645172430456"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26435062486118362", "version": "6.190.0.92309"}, "id": "987219524986292", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2927141310670477", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
scdn.com/v/t64.5771-25/491827703_1177623257382012_3092061566751627355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn6dzlL6XVcQ7kNvwG-v6-U&_nc_oc=AdoojxzZ4dJ065iAmcnYlI8R9Mtg9QCutmBwOAlkAw_8FzZ6C0XDqUqT9IGLP7jYfOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETxE7p9CptrYQBZcZhhJ-YvvwQspPsPVFw97E53kn8nw&oe=6A859E35"}, {"file_name": "Picture 4.png", "id": "1176399364232067", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Irnh07kfQQ7kNvwFkaus-&_nc_oc=Adrv4y7bgpFSTvQvtIcOP7m2yGZ7IAu3Qn6XTQMvJrFN8Jsp-VBYD2gpdYAoF3U0Nbo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHBEYKD9Mgw_nVln3bl4uuiyRAcGA2WE3guH6Psoxs2g&oe=6A857E50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_u
-LQ9SfU5p3dwA-V6Nq7fsQn97_HoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8FCqOSjHhq9k58S1lbc5WaFBbNCsm_gtBD5o0E9UA1Q&oe=6AFDDAB3"}, {"file_name": "Picture 1.png", "id": "1177623254048679", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827703_1177623257382012_3092061566751627355_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTdKeAkOsykQ7kNvwHlBsns&_nc_oc=AdpfsuIvka1FgD4zN8-YpGM9rDPCyr_yOZ4w1TkS07YbOuOTsnMo_2irlS1tENTMm2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA5Ue0l7JS1dNcanJ0iUhlHRuY5O_rI70VdPveQlsefg&oe=6AFDCEF5"}, {"file_name": "Picture 4.png", "id": "1176399364232067", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Aq68r3lErYQ7kNvwFFQ2Gt&_nc_oc=Ado-r4VbfutcBPAx5rlbVsyOBPI_bH-fIGbsc8rS2kJaE641P-HcFzBBAmRxy8g0QD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDY7uXWUyrD-b-6Oh50UogUFf7h1gzr0-gAqrzB5jILw&oe=6AFDAF10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_url": "https://sites.google.com/view/winterproduction/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Alejandro Sanchez", "support_website_url": null, "website_url": "https://sites.google.com/view/winterproduction/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23918242741150333"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23992778287030111", "version": "Winter"}, "id": "701785885807210", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9870190226382154", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23992778287030111"}, "release_status": "RELEASED"}, "binary_release_channe
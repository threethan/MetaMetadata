ri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpQiN0V3dBoQ7kNvwFStJkX&_nc_oc=AdnnPLfxn6VOwGFC87aN5E5h6iAd36Ek-h_Cxfc40_-RA6ks8ATrO1Nc1jv6Fo8zcIE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftGLAVsquF-001b0FKYtS8nb7V-9oUgCxoKusNZuq_dFQ&oe=69A1A310"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_url": "https://sites.google.com/view/winterproduction/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Alejandro Sanchez", "support_website_url": null, "website_url": "https://sites.google.com/view/winterproduction/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
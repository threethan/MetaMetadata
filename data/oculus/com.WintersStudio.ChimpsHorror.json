om&_nc_ss=7a30f&oh=00_AfyTnzz44ifq8S9CoeL1h-QG-RCmiqx8TpTwS7ISPorNTw&oe=69C3D1B5"}, {"file_name": "Picture 4.png", "id": "1176399364232067", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJeNgygNju8Q7kNvwGQn_sl&_nc_oc=Adof016NYgYGjiwXDYziHAgTU7NdgKnYI-1iWn9uP2mhRn59feJ2WynqEuVyHC9Ws8Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx31jFtzmI_yko5VpbXDHl2EQ3-WLyjm2qwfMXEoI8itg&oe=69C3EA10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_url": "https://sites.google.com/view/winterproduction/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Alejandro Sanchez", "support_website_url": null, "website_url": "https://sites.google.com/view/winterproduction/home", "category": null
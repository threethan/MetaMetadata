uluscdn.com/v/t64.5771-25/491827703_1177623257382012_3092061566751627355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk8WxzBhSlAQ7kNvwGmUEKO&_nc_oc=AdoLUnwoi1G60RSuHsA3SE-WxNtKGLY8B44nSJh7Ps_oFOWRMpDiVxVaMCE308U8Ac8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXzfsCDkDYYFfSOejwEDkGLH8kl4aFuMdkcAtdLwwgDQ&oe=6AA3F0B5"}, {"file_name": "Picture 4.png", "id": "1176399364232067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpVB5EgGJ1gQ7kNvwEZ5Ygt&_nc_oc=AdoWigFdu29WqAGvihXdPFXMn9bba37TId1pMXns3f_k1PNaA0TS7NQcSjr7lv29KQA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcuzy-e9tyAqFzaeiptl_g2Zch4SIqAygo0SIZhHbsGg&oe=6AA40910"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_u
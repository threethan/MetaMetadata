uluscdn.com/v/t64.5771-25/491827703_1177623257382012_3092061566751627355_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpVLo8PNDwsQ7kNvwHY_LTw&_nc_oc=AdoQIz5B2m-8nh_aCOBT57G54tBeZr_dIA5UMb5s7GmU24yfOcO9VubzbcEfIA_dm9E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfdqIbjMVYkroCvm7ncnWtngIdGIzgT78TIkIjNiNQnw&oe=6A7DB535"}, {"file_name": "Picture 4.png", "id": "1176399364232067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499318491_1176399367565400_2474158008267133205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWXgJAXOrbsQ7kNvwGSm468&_nc_oc=AdpK9aBNH-8PKoQC0dFzVacFZwI4Df6-lp9QDOKb7rxnYe3FbOO7xC_miEOjYvVIffc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKfwF9VvPOSstiVYL6gTEvPuYq5FBtffv1D6EWC-cLqw&oe=6A7DCD90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimps Horror", "keywords": [], "long_description": "Run. Climb. Scream.\nChimps Horror is a VR horror game where you're a chimp trying to survive in creepy, dark environments \u2014 and you're not alone.\n\nUsing physics-based movement inspired by games like Gorilla Tag, you\u2019ll swing, leap, and scramble your way through terrifying maps full of jumpscares, spooky vibes, and lurking monsters. Whether you're messing around with friends or playing solo, every corner hides a surprise.\n\nThis is a fan-made game built for fun and fear. Expect chaos, bugs, laughs, and scares \u2014 and we\u2019re just getting started.\n\nFeatures:\n\nHorror gameplay with creepy maps and scary creatures\n\nVR climbing and movement with no buttons \u2013 just your arms\n\nMultiplayer & single-player modes\n\nConstant updates with new content", "short_description": "Chimps Horror\nA VR horror game where you run, climb, and escape creepy monsters using physics-based movement. Play solo or with friends \u2014 scream, laugh, survive. Inspired by Gorilla Tag, but way scarier.\n\n"}]}, "developer_name": "Chimps Horror", "developer_privacy_policy_u
e": "6 1.png", "id": "1384301515552101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1384301518885434_1353660592884405840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz7bLQOOCroQ7kNvwGhUnM5&_nc_oc=AdmZdFz4Bq2kVXWKL4d1DuZR4hDF2gXj2SkewNmjSZ4J9N01ZEYs67fAai_q0B7mcEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvi4FyGWRuq_Jvx8ttrModv03cUXvCZGVExnz_3XfcQwA&oe=69A81A70"}, {"file_name": "3.png", "id": "7288427597944987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569423_7288427604611653_2892838691363188270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7Tu6jvCk4AQ7kNvwFvhhzZ&_nc_oc=Adkz7r5KjMLqnkbvB4sCl_uxnT19BqjTJ1dxAw-sf9uLcfYpuHEQyIRBjvb5TSUf6i0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfutQO84iYmihzgUT09EzPE_cW24jhHZ9ydCNMEYXnwc7Q&oe=69A81A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOGO2560 1440.png", "id": "1469182470614936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1469182473948269_5671557392808311117_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW5xO-42tF4Q7kNvwHWrltt&_nc_oc=AdmgmmxkuRd_cYH_VlxmPFsq8Sf6PEJmdoD3QHqkYwIkMT6CB-siZdSck8bTE7M5x4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIWMdBtOhxvzo99Hkq5fgSMEql5qd6GE7myztr9W0rYw&oe=69A80CB2"}, "display_name": "MindTopia", "keywords": [], "long_description": "We provide a variety of virtual scenarios for users to experience the immersive atmosphere and freedom brought by different environments in Quest. You can overlook the snow-capped mountains with a warm campfire, swim in the depths of the ocean as a small fish, or enjoy the greenness and quietness in a Chinese garden. We support you to freely roam and explore in the scene, and also support you to accompany our carefully designed animation effects to better practice breathing and meditation.  We hope these experiences can help you stay away from the  pressures of life and enjoy a moment of pure happiness.", "short_description": "We hope to bring you a mind-journey through the exquisite scenes and music  we create.\nRelax, breathe, meditate. Feel peace, calm, freedom. Welcome to your utopian world."}]}, "developer_name": "Shenzhen XVerse Information Technology Co., Ltd.", "developer_privacy_policy_url": "https://appasset.xverse.cn/privacy/mindTopia/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://appasset.xverse.cn/privacy/quest/termService.pdf", "publisher_name": "\u53d1\u5e03", "support_website_url": null, "website_url": "http://www.xverse.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6914983828624072"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7758880240901089", "version": "0.14.1"}, "id": "451518757305263", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6914983818624073", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7758880240901089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_na
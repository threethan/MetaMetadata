5/75269589_1384301518885434_1353660592884405840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8HX9pIWsgkQ7kNvwHj3aA_&_nc_oc=AdoOFIxnGb8LxMYIVkTU1Ckzb7Gwfcn9IvlfP6cEAO1Qpgi65Q1wPnGxkYRNNZBgnhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0n-IL6zdhnIbEGo0wAhUnGqnb3PmZz70Lvtp7aCnP7pg&oe=69F09CF0"}, {"file_name": "3.png", "id": "7288427597944987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569423_7288427604611653_2892838691363188270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WehLI2y5iOYQ7kNvwH53y07&_nc_oc=Adpe0hhwk1jXmGR-uikVZvYWB1jmNV-VZBrQlXHlrmh_bPrixQ4qwFkj2M6W_Ui4HNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0K1mxRIV4c9XXgRMeaUj4sDwcBt0NJhVyHS9CHLXHZ1A&oe=69F09CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOGO2560 1440.png", "id": "1469182470614936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1469182473948269_5671557392808311117_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQJsvD4CpLQQ7kNvwHcfEKQ&_nc_oc=AdoNxa4qZ7NUk2us3IF1qYS_zb0h1m8iKmkCS22DVbNPPLwBZxwkr3XB9tleJsDM1c0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2_sZONQJBFQtc1tXe1cnZgI1_H8GjKLlAGXDEd1OXQIQ&oe=69F0C772"}, "display_name": "MindTopia", "keywords": [], "long_description": "We provide a variety of virtual scenarios for users to experience the immersive atmosphere and freedom brought by different environments in Quest. You can overlook the snow-capped mountains with a warm campfire, swim in the depths of the ocean as a small fish, or enjoy the greenness and quietness in a Chinese garden. We support you to freely roam and explore in the scene, and also support you to accompany our carefully designed animation effects to better practice breathing and meditation.  We hope these experiences can help you stay away from the  pressures of life and enjoy a moment of pure happiness.", "short_description": "We hope to bring you a mind-journey through the exquisite scenes and music  we create.\nRela
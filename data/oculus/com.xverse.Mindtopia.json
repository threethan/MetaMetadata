5/75269589_1384301518885434_1353660592884405840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfFwXpMONFgQ7kNvwGo5ASo&_nc_oc=Adk2DaGoeZa-_l4hAPtM8km-4iqda_zWzdwW6qwiWeahFH0OtLTiJon_LegsvKmXBps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsgr9cx-kE1ZjKeCaUDMFyYKvftXaB7Jyp5sKVDnq2biw&oe=69A425F0"}, {"file_name": "3.png", "id": "7288427597944987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569423_7288427604611653_2892838691363188270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQKZnbwZSp8Q7kNvwFNc99V&_nc_oc=AdmUbQ3WVlg7bg07gXRZV09J8MxpNbvqCQlpyAlvoiJ_75NeGF3bx7y9nrHhFzXjJwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs7PuC0wrypJQeCSeLF_kTAQuaZlUiOV8iWoYmx96lagA&oe=69A425B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOGO2560 1440.png", "id": "1469182470614936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1469182473948269_5671557392808311117_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQXuv0lRESQQ7kNvwHMU32U&_nc_oc=AdnckvGadcbOcECtIa-sZJbzdnxRbUN2Ih5XDR_iGC3h2d6WsuI4-RgUYGK-LlXMQRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEZOaBCI5hibs1U7_CfSr1fveLeHJbPje_vwHeaiRCag&oe=69A45072"}, "display_name": "MindTopia", "keywords": [], "long_description": "We provide a variety of virtual scenarios for users to experience the immersive atmosphere and freedom brought by different environments in Quest. You can overlook the snow-capped mountains with a warm campfire, swim in the depths of the ocean as a small fish, or enjoy the greenness and quietness in a Chinese garden. We support you to freely roam and explore in the scene, and also support you to accompany our carefully designed animation effects to better practice breathing and meditation.  We hope these experiences can help you stay away from the  pressures of life and enjoy a moment of pure happiness.", "short_description": "We hope to bring you a mind-journey through the exquisite scenes and music  we create.\nRela
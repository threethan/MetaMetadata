ages_20250205_Explanation.png", "id": "9900339629983014", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392121_9900339633316347_5900130740275128173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-3JKSTUk4UQ7kNvwHYSwlV&_nc_oc=AdrA9UacHl-PHVZO7AFRC8tUqtHfnuB6-gp8h9CDP6sPk5YInTYWN_ZYzSjBaso5zPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEFJAV3zq1DHO1ODuSOGDCWKe3QSurHtMl-wrMaQFuog&oe=69C2996F"}, {"file_name": "T_Immerrock_Images_20250205_FrereJaque.png", "id": "1030131198956479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391898_1030131202289812_6559149501792222694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCpG12Qhct4Q7kNvwFO3Asc&_nc_oc=AdpqRwP8qxjhbQWhmYD6CLWpQ4PswSLcJODq_EuGL9KOhMsJUKGAVYwG85StMz4bwPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbvB0U24HxP9mXl4VXsxsqsdd-fk9HZJxvcGEE2Lefng&oe=69C272AC"}, {"file_name": "T_Immerrock_Images_20250205_Path.png", "id": "2457593507918147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391935_2457593511251480_5732366248496819494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta7HtsFvnBMQ7kNvwHfQil6&_nc_oc=AdoMvLXVUn1EyLdyVz0PFn_0YB3Ly25BvZ-DSTBag6B_7PvlQRzlIZ2MEHnSGZEHb6E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznTnTquqB6uxaaX_U2S1u6mYVQDCyrxlnvovQCdhvmAg&oe=69C29336"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jDrBv1qamYQ7kNvwGiTFbQ&_nc_oc=AdoKn_m9Lj7sZRmtwLUhIJ4v6AhcWvnyEry-MHqng0BdT9ZUy3au1vYUqX_O95kTdVA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHatw3Lh_j8JzPgi1_eoU4p9Fjj_Ge_wvcjXwFbh1_Ig&oe=69C28767"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IMMERROCK", "keywords": [], "long_description": "# IMMERROCK Early Access transforms the way you learn and practice guitar!\n\nPRE ORDER NOW & GET A SPECIAL PRICE UNTIL MARCH 13!\n\nLearn guitar with a clear path and bite-sized exercises that will inspire you to MASTER FASTER your guitar.\n\n{1300067974662465}\n# **GUIDED BITE-SIZED EXERCISES**\nGot 15 minutes? That\u2019s enough! Our lessons and exercises are designed to fit into your busy day.\n\n+100 exercises, lessons and songs (and many more to come)\n\n{578409818524982}\n# **YOUR PATH TO MASTER GUITAR**\nLearn new exercises, lessons, techniques and songs tailored to your goals and skill level. \n\n{9110577785655427}\n# **PRACTICE AT YOUR SPEED**\nAdjust the speed anytime to learn cool songs or practice your favorite exercises\n\n{1769346543863016}\n# **FOCUS ON WHAT MATTERS**\nSay goodbye to staring at your computer or phone, IMMERROCK lets you focus on what really matters: Your GUITAR and your FINGERS\n\n\ud83c\udfb5 Play your tabs: Convert your tracks and enjoy all the features of IMMERROCK\n\n\u2b50 Stay motivated: Discover new exercises and activities to achieve your goal\n\n\ud83e\udde0 Retain your learning: Develop an intuition and the muscle memory to play anywhere anytime\n\nJoin our Discord Community https://www.discord.gg/SP4tumnEx6\n\n{1342640510088304}\n# Early Access Notice:\n- 6 String Guitars.\n- E Standard tuning. (E A D G B e)\n- We are working on a guitar tuner.\n- We are working on note detection support.", "short_description": "IMMERROCK makes learning guitar easy and approachable, with short exercises, and a clear path so you can MASTER FASTER your guitar."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
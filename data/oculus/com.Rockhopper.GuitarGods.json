=6999A8E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NoteDetectionUpdate_TrailerCover.png", "id": "4060280770852084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619014_4060280774185417_1620530166128442565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpXnamJVxf4Q7kNvwEZ8bxe&_nc_oc=Adk-VyEZ5SnAGzWiD5yIZJTMgOPd6f62IXS8IrmBsRjMnnX5fdTXCPVGBFwY6rRyU8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu6Z14Zdnt7ZZ7Mab2E3JR9VdIFCaZKV7LggG-8y3YnXw&oe=6999A86D"}, "display_name": "IMMERROCK", "keywords": ["guitar", "learning", "music", "mixed", "reality"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n**Note Detection Setup**\n\nRequires you connect your guitar in one of several ways:\n\n-1/4\" TS to USB-C (with headphones)\n\n-Real Tone cable + USB-C adapter\n\n-Mini amp such as Boss Katana: GoB or Fender Mustang Micro Plus", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24746335175068277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_656438436893143_1764554274823105781_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9FJrc6MzYUQ7kNvwE52sXv&_nc_oc=AdnuP6fpv_XlhEp89qFaXaRfBr6GnDc7IFsdC4cJvZ4Eu_s0yUAzCTOqezVwwpqDTnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDV97YJ0s7DlfLXKVLK3oI2FvTWiPahfRdQmDHwBcb0A&oe=6999A8DC"}, "is_concept": false, "is_test": false, "is_t
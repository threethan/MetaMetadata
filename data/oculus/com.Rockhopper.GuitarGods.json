nywhere anytime\n\nJoin our Discord Community https://www.discord.gg/SP4tumnEx6\n\n{1342640510088304}\n# Early Access Notice:\n- 6 String Guitars.\n- E Standard tuning. (E A D G B e)\n- We are working on a guitar tuner.\n- We are working on note detection support.", "short_description": "IMMERROCK makes learning guitar easy and approachable, with short exercises, and a clear path so you can MASTER FASTER your guitar."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8334804496647938"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "1647876816956905"}, {"status": "PUBLISHED", "id": "2708729389545795"}, {"status": "PUBLISHED", "id": "1533619451631581"}, {"status": "PUBLISHED", "id": "757020864138994"}, {"status": "PUBLISHED", "id": "1675702826768378"}, {"status": "PUBLISHED", "id": "2093203904586879"}, {"status": "PUBLISHED", "id": "1234399715032240"}, {"status": "PUBLISHED", "id": "2673594696374306"}, {"status": "PUBLISHED", "id": "996230202830051"}, {"status": "PUBLISHED", "id": "2072429290219582"}, {"status": "PUBLISHED", "id": "897694796
_nc_sid=6e7a0a&_nc_ohc=JJKzPQc3weUQ7kNvwGjkeZ6&_nc_oc=Adp02JzYv_lMjH_pxt7uUsdIG-kIf9PnI9GkplzQTB00L0uBQREWSf3FOAWMXUztNYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiyJSeW_sbeiLvfAGlQZUPcybxxqMvK_KNx7NjMsJcAQ&oe=6ADCB436"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL9Kh46nmkAQ7kNvwHhoNOL&_nc_oc=AdqtGtq7CEn7WllFSjQQmubCfluzShXyliO5tdaGC2wha2ZGmYFRnqx5GcAAa4Wcpyk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYoMQ2gADqwWjS0OKvwNddAB3y7YVS3bNQAUrhvczFjw&oe=6ADCA867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IMMERROCK", "keywords": [], "long_description": "# IMMERROCK Early Access transforms the way you learn and practice guitar!\n\nPRE ORDER NOW & GET A SPECIAL PRICE UNTIL MARCH 13!\n\nLearn guitar with a clear path and bite-sized exercises that will inspire you to MASTER FASTER your guitar.\n\n{1300067974662465}\n# **GUIDED BITE-SIZED EXERCISES**\nGot 15 minutes? That\u2019s enough! Our lessons and exercises are designed to fit into your busy day.\n\n+100 exercises, lessons and songs (and many more to come)\n\n{578409818524982}\n# **YOUR PATH TO MASTER GUITAR**\nLearn new exercises, lessons, techniques and songs tailored to your goals and skill level. \n\n{9110577785655427}\n# **PRACTICE AT YOUR SPEED**\nAdjust the speed anytime to learn cool songs or practice your favorite exercises\n\n{1769346543863016}\n# **FOCUS ON WHAT MATTERS**\nSay goodbye to staring at your computer or phone, IMMERROCK lets you focus on what really matters: Your GUITAR and your FINGERS\n\n\ud83c\udfb5 Play your tabs: Convert your tracks and enjoy all the features of IMMERROCK\n\n\u2b50 Stay motivated: Discover new exercises and activities to achieve your goal\n\n\ud83e\udde0 Retain your learning: Develop an intuition and the muscle memory to play anywhere anytime\n\nJoin our Discord Community https://www.discord.gg/SP4tumnEx6\n\n{1342640510088304}\n# Early Access Notice:\n- 6 String Guitars.\n- E Standard tuning. (E A D G B e)\n- We are working on a guitar tuner.\n- We are working on note detection support.", "short_description": "IMMERROCK makes learning guitar easy and approachable, with short exercises, and a clear path so you can MASTER FASTER your guitar."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8334804496647938"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "1161815948646261"}, {"status": "PUBLISHED", "id": "589514274065650"}, {"status": "PUBLISHED", "id": "1647876816956905"}, {"status": "PUBLISHED", "id": "2708729389545795"}, {"status": "PUBLISHED", "id": "1533619451631581"}, {"status": "PUBLISHED", "id": "757020864138994"}, {"status": "PUBLISHED", "id": "1675702826768378"}, {"status": "PUBLISHED", "id": "2093203904586879"}, {"status": "PUBLISHED", "id": "1234399715032240"}, {"status": "PUBLISHED", "id": "2673594696374306"}, {"status":
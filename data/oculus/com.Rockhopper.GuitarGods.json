ocale": "en_US", "screenshots": [{"file_name": "IMMERROCK_Screenshot_Chord.png", "id": "1825519251676146", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617793_1825519255009479_354955192305151329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahfg0KAmv5AQ7kNvwEgxzV_&_nc_oc=AdpYfv5XyzKbWRdmcrztWlC1j22Lc8R1y3mu3U8E1h1x3LQMPoMVXSpr4cEyWXmrukM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MwaJRHM34L7VbI4j-ZBSrni5HrCZORK2EKHpv7AdV3A&oe=69D27D52"}, {"file_name": "T_Immerrock_Images_20250205_Explanation.png", "id": "9900339629983014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392121_9900339633316347_5900130740275128173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGv_FBZqJL0Q7kNvwGWB_tl&_nc_oc=AdrrDwD9Tfk6bVglGb97eZLaKnWmAZR-nfe-7hYS7J6cG7l5Km_jz4Yd0uRoVVyvvzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HVVWxYGRwo81PlLiLU5wtK_yvkv6a3UyR_aU-3Gq5eA&oe=69D26B6F"}, {"file_name": "IMMERROCK_Screenshot_Warning.png", "id": "1002690805201396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491829980_1002690808534729_8561384863482989854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDvpa34QiJwQ7kNvwEzIRr0&_nc_oc=AdrCxTjxuqj13QOFtwoAakkFhfsEdiyTis1RXFnZ0mbsuqbK2c_QatzB3TTzraGdgWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nXnuRWgZMcGJp7HjfpUi5EWrpqyb3C2I2hucc9GaHpg&oe=69D26CA3"}, {"file_name": "T_Immerrock_Images_20250205_Path.png", "id": "2457593507918147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_2457593511251480_5732366248496819494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAOKX_jGKVUQ7kNvwFTthx6&_nc_oc=AdqSZTILZEOCFV3kiDzt3AXO3h5WKNu967YcRDuds49V93Ze9-QosUy0IKzCvb1Uc3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QIDy7zHcMUgPxgsYmnNQyZRV9ZiehOZgMCDEBOelo6g&oe=69D26536"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28wpcjVXHjsQ7kNvwFcRFnX&_nc_oc=AdqXe5AHM0aj6aftn8g-XHnoEkVlcbhKOROl1SWwdaVA2x6o20_EsRrayR4OLuwKqkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IadgK-2dwPCgrFJilbBuZavOc3X1qWQ_WqtClCVGtrA&oe=69D25967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NoteDetectionUpdate_TrailerCover.png", "id": "4060280770852084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619014_4060280774185417_1620530166128442565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRYsaqRaJNAQ7kNvwEBizVF&_nc_oc=AdoSLkVDLRuB6zq3_0WB118ZUJPe0XuuL01fFvcqOOohc45IEAOTS_SKB7ubY1jq1dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iCu09KabapdVOArRTllK8jgYlm-ITkKTv0ZPcf4BYdw&oe=69D258ED"}, "display_name": "IMMERROCK", "keywords": ["guitar", "learning", "music", "mixed", "reality"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n**Note Detection Setup**\n\nRequires you connect your guitar in one of several ways:\n\n-1/4\" TS to USB-C (with headphones)\n\n-Real Tone cable + USB-C adapter\n\n-Mini amp such as Boss Katana: GoB or Fender Mustang Micro Plus", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25758011070567344"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_2424299011317636_86
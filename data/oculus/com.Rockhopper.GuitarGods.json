 "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617793_1825519255009479_354955192305151329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnDMoLbGUPYQ7kNvwHXrZr9&_nc_oc=AdnjCnKuHTORkIOc-oE50GlEs0FoXIlIXJYWZZJi5X9BP1Q2WTNYoLFuiB7ld7p8dtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkg1Jbe86tFEzwEuRlCpvCKny39EQyI42nUJhrLX5S2g&oe=69AEAC92"}, {"file_name": "T_Immerrock_Images_20250205_Explanation.png", "id": "9900339629983014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392121_9900339633316347_5900130740275128173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh3ofzzsvbEQ7kNvwFcLwpI&_nc_oc=AdmLZ_r1bs3HZd_aaBge8ilzpLZ9bFkF-jQKvnf8SSrsQH_9AAwESOAjGZ-cInzpPOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXYNSjk83OXGrvuAV6AsW2FtSHGzurr-NynbZ050nqoA&oe=69AED2EF"}, {"file_name": "IMMERROCK_Screenshot_Warning.png", "id": "1002690805201396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491829980_1002690808534729_8561384863482989854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf6loYsmAngQ7kNvwFKaJaj&_nc_oc=AdkdKkC9rHnb4v1EqwlnaJVGU-OqpVNhaCCuCoCQoQxhAouOQNQpfrdH3vkhKDAupN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtcDi00QfULVoxDaG9hovFTByo4Ano5zhDbmfjeNaOsg&oe=69AED423"}, {"file_name": "T_Immerrock_Images_20250205_Path.png", "id": "2457593507918147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_2457593511251480_5732366248496819494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWag4Is1I-YQ7kNvwEuBvzL&_nc_oc=AdkqRQIfcU-0KiTnPRxeON-JpyZUvTFurW9mWwiaL8xEuMl-_vhcC4goUHVU7e6dKhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCyr9EiPmwlYt-u4yK47ttmhAoSbgUF5vypbX4UdRNTw&oe=69AECCB6"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NYQ_n59JT8Q7kNvwHx5gL9&_nc_oc=AdnQ-q7rZgUhtXi35Ej7MaEwKEC-dJESPbQsx_IajQAh5SFgm_GN0zpM-QpGg-HCQaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN8fZDtKuvFX6EQhiwujbgEvAHD2HtOx1A6gTbJVBaeg&oe=69AEC0E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NoteDetectionUpdate_TrailerCover.png", "id": "4060280770852084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619014_4060280774185417_1620530166128442565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wismLWDlLNYQ7kNvwEZtFRu&_nc_oc=AdlZOEQBY6TRvjAmUwn4IWYIY2JH7gPMf2HOPsEid1a60zux44OCKiViqVUM-NXKVjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz07MsSc1XVSkARMJqpNO6-wMKa2uuDMvrSwshuxVIBdQ&oe=69AEC06D"}, "display_name": "IMMERROCK", "keywords": ["guitar", "learning", "music", "mixed", "reality"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n**Note Detection Setup**\n\nRequires you connect your guitar in one of several ways:\n\n-1/4\" TS to USB-C (with headphones)\n\n-Real Tone cable + USB-C adapter\n\n-Mini amp such as Boss Katana: GoB or Fender Mustang Micro Plus", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24746335175068277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312231_656438436893143_1764554274823105781_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrsYUHmDqOgQ7kNvwGUgHz3&_nc_oc=AdmTVFvzp_6I7PPNHjA
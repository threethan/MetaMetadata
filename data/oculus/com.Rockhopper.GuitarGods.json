oK7tu66HxQKhEiPg&oe=6AFB3EF6"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxu6OIFVsNcQ7kNvwHC9qcz&_nc_oc=Adrx3rmPj2_Dt0cj2gjSGRLLyvGGJwolf_rh-78yfj0_tDlJYAeGcx_g-1qRyJ2FZ7o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtzxtB33H0hdTaqAhCrNOVmGJjQ2jr58UKVKfN3MK3LQ&oe=6AFB3327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMMERROCK Cover AB Test - April 2026.png", "id": "1444728823806575", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622214_1444728827139908_5691591753620686861_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX0GmKQhzK8Q7kNvwHc61LN&_nc_oc=AdoRtB0CAnjyP3iT2sl1fTluUk4Kjv8TLyb6EevSOr3IoY0t86dzlKLOa9Fx9k3d384&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSItFuLYCzgfn6ZbUnaMhMHGClc58HDueda_Dqy9KZcTQ&oe=6AFB198E"}, "display_name": "IMMERROCK - Learn Guitar", "keywords": ["learning", "music", "guitarist", "beginner", "rhythm"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n# **Note Detection Setup**\n\nTo access Note Detection features, you must connect your Guitar or Bass to the Headset with one of the following. \n\n- 1/4\" TS To USB-C Cable\n\n- Guitar Audio Micro Interface\n\n- Wireless Microphone\n\nYou can find more information on our website. https://immerrock.com/note-detection", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback*, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK MEDIA INC.", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK MEDIA INC.", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
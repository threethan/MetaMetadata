oe=69D50AD4"}]}, "id": "828672112903827", "locale": "en_US", "screenshots": [{"file_name": "IMMERROCK_Screenshot_Chord.png", "id": "1825519251676146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617793_1825519255009479_354955192305151329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahfg0KAmv5AQ7kNvwGw4tUE&_nc_oc=Adr4PqLN379IQRX1AYOD6jz42fe6rPtjmFwKOOW-0IqhOhLSE3TU-qOE_2HD5Iee-LE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vEpWgFEqnxgz7y72vN9rkUQ7WsFCjub-RtZhe1aQJ5A&oe=69D4E812"}, {"file_name": "T_Immerrock_Images_20250205_Explanation.png", "id": "9900339629983014", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392121_9900339633316347_5900130740275128173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR2n_oygIgsQ7kNvwGBzo8j&_nc_oc=Ado-zbq5iCM4sJ5NK7AwxYOpLKbxrvWZBzxltckSIWiMcTJm0165k0W0lJUVRNwFYyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OIBFRPYgNW6NXeydDXr3VM-ONao0UfyFEpm07AVbByw&oe=69D50E6F"}, {"file_name": "IMMERROCK_Screenshot_Warning.png", "id": "1002690805201396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829980_1002690808534729_8561384863482989854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5r2lzUDrtwQ7kNvwE5m-Mv&_nc_oc=AdrB8IFPOgrudk6DFYccN4neZuGKk7JAA-NiLW7rBWXmOOC3HKbbspDuPYu9mn0zpEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YgrMvsIh14xPB3x8dTyBCHn8EJINjBl6yugxr6zGljw&oe=69D50FA3"}, {"file_name": "T_Immerrock_Images_20250205_Path.png", "id": "2457593507918147", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391935_2457593511251480_5732366248496819494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfjkP7uWSAMQ7kNvwGGcVfj&_nc_oc=AdoqPFEO5EATO0wnBYsL0EnJL3QOejTBZdCSAyS0uMeXqBe0-4bxKQ_GEWK0Gm6nK9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kZqZAw9niSTk8RDbYyIs44yvtlFFWzKxDwfNImBx9vg&oe=69D50836"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzNbdKSof0IQ7kNvwGuNHS8&_nc_oc=AdoRSXgxo24z6PQOQm19E-bctMLeObZtg68UN9Slczj0ZD7RzaTZdOzGmoNAgT8fhx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1szHUYPXatgUP-h7UlCEb9-q9hpJAyeSozLKlod4qWtA&oe=69D4FC67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMMERROCK Cover AB Test - April 2026.png", "id": "1444728823806575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1444728827139908_5691591753620686861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtB-qZd4qG0Q7kNvwGtuoUC&_nc_oc=AdoRSob60Tylqr9LTrXVmZZRWPPpAkeOQKyHTBKET_flsyF6oaP1mbChlMsTHaygCyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HW8P80QEyGy38fe3g38lA1mSltPXgihrJZMApSQi4SA&oe=69D4E2CE"}, "display_name": "IMMERROCK", "keywords": ["guitar", "learning", "music", "mixed", "reality"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n**Note Detection Setup**\n\nRequires you connect your guitar in one of several ways:\n\n-1/4\" TS to USB-C (with headphones)\n\n-Real Tone cable + USB-C adapter\n\n-Mini amp such as Boss Katana: GoB or Fender Mustang Micro Plus", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK MEDIA INC.", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK MEDIA INC.", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25975015935533522"}, "review_messages": []}]}, "cover_sq
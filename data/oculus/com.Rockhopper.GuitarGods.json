 "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617793_1825519255009479_354955192305151329_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnDMoLbGUPYQ7kNvwFtOCj6&_nc_oc=AdmJeeQEqxuej1WLBaHoUdOX2rajkP6DflbQk8SrvntQv6qzMTBSQVdkAhJBZj3a6PA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNdgYxMVV-l9CaLJhZASHc9HaRWE8n4haQZ7Iy6-pfLg&oe=69AFFE12"}, {"file_name": "T_Immerrock_Images_20250205_Explanation.png", "id": "9900339629983014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392121_9900339633316347_5900130740275128173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnLV5Zd_ujwQ7kNvwEPJayw&_nc_oc=AdmO1cdaJjM31eNW0Z_CNVgEU86HH4NYS7fEVfERoMHB1DnnnuSH8Kw2Syg19NV9bG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt2_yJUcOL1-swnEWj-oJabuz11vXEF_raF1bzHotmvA&oe=69B0246F"}, {"file_name": "IMMERROCK_Screenshot_Warning.png", "id": "1002690805201396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491829980_1002690808534729_8561384863482989854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf6loYsmAngQ7kNvwE20633&_nc_oc=Adk5dVquQRvP1eVQUbZcuumNrwZjYGdYFhArGr9aa0WNGQDophkLoSNrEI82usd1WUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwkt33lQVCdyg9zaJQ84os15ZkCHEhnnfQ6wAuH7X_7-Q&oe=69B025A3"}, {"file_name": "T_Immerrock_Images_20250205_Path.png", "id": "2457593507918147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391935_2457593511251480_5732366248496819494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue0rNbozTQAQ7kNvwFd2qvC&_nc_oc=Adn4xSum9o-wBu_aFcHeAMryyXd7OnoYl2PPorBY4Z389TlUbCU_55qBe0Bo0_hc4YI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxapsxgAQIWLLtVPT6fJRHuhHjM4foFgu1WhUgJpyCfPA&oe=69B01E36"}, {"file_name": "T_Immerrock_Images_20250205_SongCatalog.png", "id": "815124577446277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391893_815124580779610_3980147146822830398_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NYQ_n59JT8Q7kNvwF0qZS5&_nc_oc=AdkFavVzd3QDeQgHmMdtFUeQ1W_zrEDPrjXFfjM34bCdvHwKWcuU5vyurPcd-rMBHSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9e1lsSK54XOvTCLESYH3V7gFY3QxL7kqj48f7hcAQmg&oe=69B01267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NoteDetectionUpdate_TrailerCover.png", "id": "4060280770852084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619014_4060280774185417_1620530166128442565_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wismLWDlLNYQ7kNvwFapivZ&_nc_oc=Adk_Pn7FIdtotDLOCq9A_SVbwmi98x8-qzTx8l9qfFXhpzMsYIvhZHahXZNXCj64LNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPI969TYIBXTCLnn_6-EmrcBNtotG2iS6zyLxijiGBFg&oe=69B011ED"}, "display_name": "IMMERROCK", "keywords": ["guitar", "learning", "music", "mixed", "reality"], "long_description": "# Master Faster Your Guitar in Mixed Reality!\n\nLearn guitar and bass with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes.\n{1211108733952831}\n\n# **GUIDED BITE-SIZED GAMIFIED EXERCISES**\nWhether you've got 1 hour or 10 minutes, our lessons and exercises are designed to fit into your busy day, making daily practice effective.\n{1244545994098708}\n\n# **YOUR CLEAR PATH TO MASTER GUITAR**\nStop getting stuck on the same chords. With 300+ progressive exercises, you\u2019ll level up your guitar skills step by step. From your first notes to your first song in minutes.\n{578409818524982}\n\n# **PRACTICE AT YOUR OWN PACE**\nAdjust speed, loop song sections, or go at your own pace with Wait Mode.\n{754247963887536}\n\n# **EASY TO FOLLOW FINGER-PLACEMENT**\nClear finger placement guidance helps you lock in on your guitar, fingers, and flow.\n{1535031457483582}\n\n\nAdditional Features\n\n\ud83c\udfb5 Custom Songs: Convert your favorite tracks with Editor on Fire\n\n\ud83c\udfb8Diverse Play Modes: Practice Mode or Master Mode.\n\n\ud83e\udde0Learn Faster, Retain Longer: Build real muscle memory that transfers outside Mixed Reality.\n\n\nJoin our Discord: https://www.discord.gg/SP4tumnEx6\n\n\n**Note Detection Setup**\n\nRequires you connect your guitar in one of several ways:\n\n-1/4\" TS to USB-C (with headphones)\n\n-Real Tone cable + USB-C adapter\n\n-Mini amp such as Boss Katana: GoB or Fender Mustang Micro Plus", "short_description": "Master Faster Your Guitar in Mixed Reality!\nLearn guitar with IMMERROCK, the mixed reality app that makes guitar learning fun, intuitive, and easier than ever. Get instant feedback, access to +300 bite-sized gamified exercises, and play your first song in minutes."}]}, "developer_name": "IMMERROCK Team", "developer_privacy_policy_url": "https://immerrock.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IMMERROCK Team", "support_website_url": null, "website_url": "https://immerrock.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24746335175068277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312231_656438436893143_1764554274823105781_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrsYUHmDqOgQ7kNvwHeGApX&_nc_oc=AdmW4GTHCg8VAReHay-
t-atl3-2.oculuscdn.com/v/t64.5771-25/39001723_510284060097901_5315951693456980448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj0CWOvrUzgQ7kNvwGxJh0U&_nc_oc=AdqK9tHsB2t3hhOR8SmAa9Mczu8GKGLx3WLp6lVfRBhZzfyCjx9SmYQKkbFzVZJliPc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23BGHidG5r0carwPWzP-so9NGD8WFK--j2VpyVig_57A&oe=69F21B78"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPndAI0TRYoQ7kNvwG3Sl7Q&_nc_oc=AdqQPSOBldyZjvfykkkSh7CFmd5cjW3WQTmC3pboWBTFXtHfTMwqLCtr06Pw-mRPwVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14JW_R4x8ws1pIPmXr3HAMWnvnkOFu9ZIgYR3KFrdPYw&oe=69F1E687"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lsimh-sN4OQQ7kNvwE4vUpM&_nc_oc=AdpEdTWn_h2snLQs4_3M3d6WRv1AloiDV0HvbSXLX0FjM0thXMH0cDzNgvkbHzQjStw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3C_oe-YrMjeOY8FmVSbGZ1XOi5L2JkZrp80iuPhwS04Q&oe=69F1F383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWZCZnWq0HsQ7kNvwF0_UDL&_nc_oc=AdpFro24xkORPZ6rIaqOWb5PGP1HzmKeWeSJ6ut8aRxmXML9nT6czTQ-1qr_aDi3oMI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oiTqs53YVtmzLJhquZts2pcE-lIH6_tnJGKX-n-TyyA&oe=69F1FF8E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_i
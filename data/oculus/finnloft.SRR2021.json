Q7kNvwHjWBOZ&_nc_oc=AdmEXn6i8qxRtFFUcsvSdbgbAtOyfa7ZBemjWcYC2bUTWQEHOKuieD4kucHQc5JMwm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwG0-RKhk3TrzhYhGY-sAWXf0zbBTBxSurUQKTmk2qKWg&oe=69BFE907"}, {"file_name": "screenshot_2.png", "id": "510284056764568", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001723_510284060097901_5315951693456980448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMcXmH6fikUQ7kNvwEqrmsN&_nc_oc=Adk_aPuYHpcIJLdru_7nIdIEaU9oibztW0wTnepUT1x4teWA4xRNFAsrxelq6Do4oKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNiUa2XEJatLIAwZnzoZrw5AFeojJTf-DowGWyEhULmQ&oe=69C00278"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Cg8XZQYrtAQ7kNvwE9hU9o&_nc_oc=AdmWWAsbVXrI1asZykfQLneZajhqPHzaIgjrWUWZaidCY6Oyf8_Kyjehf2AHcaqcnr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmQ34PA3SnsYAQcJTp_jAmJeBJqehj9v_lJMHnlGuENQ&oe=69BFCD87"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiw9auxSIn0Q7kNvwGtTLEH&_nc_oc=Adk2UYtARfyyPBm6LocTotHPkV1-yzSVS6rUvCFDpVoaz0hjTCQzkcuBBttORVaOrDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAc1rNxUcvCrMVxw_06n59qfW5P8DWoUzqiklk9kFOLw&oe=69BFDA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rbx0rKvyosQ7kNvwE7-CZk&_nc_oc=Adl-_n1HBjF79042Dlp-jQxe92_0TH4EqaqTfBIhY6qNPDnXJgLbGgoiH7_FA6h7nvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMCDlsbQyglFZ7o8VXAPqDxxjasr2X-XEo6yOQjvvHlw&oe=69BFE68E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
nc_ss=7f20f&oh=00_AQSodgXBxZOiqLdMNLSbRgTw_x1tdGi3Yp9cPRnynq60wQ&oe=6AFB2943"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzP83XVFzJUQ7kNvwFeehlX&_nc_oc=Adoww0qetqEJA9NZ3jSvNHyoJuiFjVi0l-pTgTShd4TpxSgTi8NPHU23tHP_XzNNDUE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuroj3ba6N6rJbNmvPPN9QsaoJaV_yrXTn0OPVIFTeVg&oe=6AFB354E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1100091180561847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "519315482548687"}]}, "baseline_offer": {"id": "519315482548687"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1626104820, "status": "PUBLISHED", "id": "519315482548687"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3807608682697876", "version": "0.1"}, "id": "2920003218267748", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3807562616035816", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3807608682697876"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2920003218267748"}]}, "change_log": nu
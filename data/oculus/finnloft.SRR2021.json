=9X_hxDytfwsQ7kNvwGyjDbm&_nc_oc=AdmWJBTBrC14dKDRGud2a85W9aZOIvqZ26lAGBZJKjJg2AOatqjYTVhfSkCEXlGaOS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2bJM7GrTx3Nj7gxhoOfIXCz0k2a4OgqCnKf8p2DyFaw&oe=69A6BDB8"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxk0dHEKOXsQ7kNvwE07o6x&_nc_oc=Adn148jd1ZOccHjPZUq_Yve-MYQXNYethgzNmaG_vCFKHWuA_sRSfLt5zXhG8u-bwrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuaTA_ygP2i5UjocDXWt-mf4VGVsDSEDpSGBoEf-RPByQ&oe=69A6C107"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31wAmpG0T-IQ7kNvwG4UYou&_nc_oc=Admts2_GL3ZCXx3-wNnjn0dNNkjW7E9S79weg4ve6eFq3joAonQ0YxjHbYBV5HHAKhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXemJoBQ9YuwyNrxC71NJbszOJCo47ehMKuB45zuLLxw&oe=69A6CE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K_-B2YZj00Q7kNvwHUGncl&_nc_oc=AdlDekm3nMS1ngpS2V1DFVN9AEaCM-Drni4kUwvv0-t4APyZIiB0mXvsibhXxt61iUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTJxmr8Jpic0swL_e5GBAbV5tAhCa21sskTEk36hgFgg&oe=69A6DA0E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1100091180561847
ent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvKUlEfcsB3XcBv8X6uH6wfgVTr-SIVcMjL301czJMtQ&oe=6AAE8887"}, {"file_name": "screenshot_2.png", "id": "510284056764568", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001723_510284060097901_5315951693456980448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt9JQn14hEUQ7kNvwFx6cs8&_nc_oc=AdrzvwlruWXMZfRFeoS9TiZa4wrokspPprD4948yoCMlxjJ5FfE1j5tzeEZvkk00Vn0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKciTYB5WvJoyAi4Ctpqf1oDCamZi75TCbOMkpRBoGi3A&oe=6AAEA1F8"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC0qT_RFiHEQ7kNvwGy13kr&_nc_oc=AdpYe9NcXRb3P2pjARqrmN6xEZN595LrRcgCT6Q3hEKz_M-6wY0SI7apdNSyUdLJ5vg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKozI8WdojjX5zPUqgzn09tgKlC9DdRTMuWMoy_pfGLGA&oe=6AAEA547"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KwMPQEmKMkQ7kNvwG2KiWA&_nc_oc=AdpswD_xYyHQ0MIHyqrq60gAJyx-Nx7hMyM_nAxlJZ1_xGVGUEX6AQQMdetCFKStUbA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8Prx81GPRMsCCPd_4VT2ht7i5LXv3GobuiQtgFheoPQ&oe=6AAEB243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz4b866oiM8Q7kNvwHiiZxm&_nc_oc=Adqu0j4j_irJzTIRjPxp7vC5ZOUrVmywzvD3MEEHhqKeIL7eCXGqlYWESuidnR2Gdh0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuxX36o-36bkQ4EGZX9GmGZHttpFX4iZjFxr0w3dA4wQ&oe=6AAE860E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection":
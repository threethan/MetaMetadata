=GhgFfGR_xNMQ7kNvwH9mRa9&_nc_oc=AdnUEq66M83hm6VnzmBIzHWlb_W2Mg-VGaiR_tcZ9uNf1wGQ5c8KDC1Ire2djMMkxYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-bx9FaI5LJSYPC0AGAKPWNHlVgxpggM-dZgxWABWOXA&oe=69A2C938"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0NUj7w2238Q7kNvwFe4pnC&_nc_oc=AdmXAG9eLsDArPzC3ZqFNaulw80qqf6TdHSxZ5SrXBT-t8kbm1zrOoQixzVwlk5dQVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveDxD5ZZn7lV72gI9Gg5GhnhfMZBr-OzecZUHHLarnOg&oe=69A2CC87"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UucyQ5yTVQIQ7kNvwE236Hr&_nc_oc=AdkCRR_xtA-RV0P4GmdJhsElvfuMtC_OPMqt2Z7wshSCzNzPDmwDIQvotbjiZ8ufLgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJkP7Mv0vSqTuYxBq9jKX2IMh7vjPmmXR5Ya8p_Gg8vw&oe=69A2D983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LwSJP52nTYQ7kNvwFso6Iu&_nc_oc=AdmCNCVYV0K5oCMJXhz7rBSIHqKZRZYc0d2TkqzOAxw9q7ZZbYKn3_JKlUuX40EU5Ic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhMhibTiW_Spwq03m0ZQgsp6lISOYq6YGw363CioI2jg&oe=69A2E58E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1100091180561847
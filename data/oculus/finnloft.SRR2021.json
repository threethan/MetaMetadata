Q7kNvwG3L9lA&_nc_oc=Adm2Xp6jgMJxXdQA6Z0MgwN_7GkWCEhwFpb11C2idXovkpuMbWrlJaCuhkCIKnDd6ng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzZZSr4KXnqFtMDOGbJ3p9m5hRjGn-2kHb7AZfPeEA9g&oe=69B16887"}, {"file_name": "screenshot_2.png", "id": "510284056764568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001723_510284060097901_5315951693456980448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb0W_7zaZ7cQ7kNvwGgSwSw&_nc_oc=Adk-s6NFnWTTw3CIdjn5h_ZQEVQ5ag0iDnOacJo5_xz6bM-a9GEAGh_FcOg6Jwm8L4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq_85Cd_urmpHOQ_CRiX9H3QR7R3VU3RQZC8IumQPmDg&oe=69B149B8"}, {"file_name": "screenshot_4.png", "id": "148388943980422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982487_148388947313755_5024778715776979066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPM2RJZE4sQQ7kNvwHCYOtu&_nc_oc=AdlugnLBh_rqkxPElSoZT8MRa6hX3ncUxKofWh8HCnSM7gFqRaJiBd5qLcsMJXzqWtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx018uPn1hbvn2kqIi_vfyKX6p70HIN6pVwfRXgitzIfA&oe=69B14D07"}, {"file_name": "screenshot_5.png", "id": "163614015770199", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982708_163614019103532_4732119162269037049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSf4dIrzHhgQ7kNvwG-VGl3&_nc_oc=Adk4fnv-pcuvwZ3S-1z5HReeEf_DLxS85g_dgLei8_t5Xwgx74ggmpiKYhATvjDI8Vs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1lNCO1qpedViTcdxhD884poqEFjpN6IWSJuFU0HPMvQ&oe=69B15A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1193335231102828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001667_1193335234436161_3385811097838997547_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aQwQwdqOXEQ7kNvwGPQkX4&_nc_oc=Adl360gUHeIJ9YwpgXR8Mg0EOQN7XdSU8Mm5dIIAmfh5WMx6De4BOaU3nmS_0i3zr88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQRcgM-qr4XoRbWr-MU9Dw009p3vd_Ii1lP6EsemIPnQ&oe=69B1660E"}, "display_name": "Santa's Reindeer Racing 2021", "keywords": [], "long_description": "In this game you get Santa Claus as your co-driver and Rudolph your team leader, as you race against the elves and the clock. If you have trouble with steering Rudolph and the rest of the reindeer, Santa can help you with some of his magic. Start by listening to Santa's instructions, or skip it and quick start the race from the pause menu. The snowy landscape might look familiar, if you have visited the Arctic Circle in Rovaniemi, Finland.", "short_description": "Hop in the sleigh with Santa and race against the elves and the clock in a snowy landscape!"}, {"images": {"nodes": []}, "id": "188944089772722", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Joulupukin Pororalli 2021", "keywords": [], "long_description": "Joulupukki on kartturisi ja Petteri valjakkosi johtaja, kun kisaat tonttuja ja kelloa vastaan! Jos porojen ohjaamisessa on hankaluuksia, Joulupukki voi auttaa sinua taioillaan. Aloita kuuntelemalla Pukin ohjeet, tai hypp\u00e4\u00e4 ne yli ja aloita ralli heti pelin taukovalikosta. Rataa ymp\u00e4r\u00f6iv\u00e4ss\u00e4 lumisessa maisemassa saattaa olla jotain tuttua, varsinkin jos olet joskus k\u00e4ynyt Napapiirill\u00e4 Rovaniemell\u00e4.", "short_description": "Hypp\u00e4\u00e4 rekeen Joulupukin kanssa, ja aja poroilla rallia tonttuja ja aikaa vastaan!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://loftcafe.fi/privacy-policy", "developer_terms_of_service_url": "https://loftcafe.fi/terms-of-service", "publisher_name": "FinnLoft", "support_website_url": null, "website_url": "https://loftcafe.fi/loft-vr-room", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
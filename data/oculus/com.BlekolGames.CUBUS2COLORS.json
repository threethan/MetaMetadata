 {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSkxdWSy9EAQ7kNvwF53H89&_nc_oc=Adpr59av3ysakPDmqkHpAL-rw-WINGhA-rg76DW37rzmgmlQB7ZhQQ5iT00U3tzrvoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af26KHxnSagivWzQtRcbsXFgolU4podWe-3dRLUYlrS3yw&oe=69F09C89"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdGYtGTHDGsQ7kNvwGGwlx2&_nc_oc=Adr2fgP7sPVUMzGBcbpAcwwfXiot50IMUdG5wmSUDXQHLSofXCNibTO_eqcb0ioDJjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Qb9Tv7VaCC1YkvmRwO79djmx8qMfQ6a9mwqTKgGh-FA&oe=69F0B67F"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NHXe_Zuyl0Q7kNvwHhEpSi&_nc_oc=Adodg7ux1Y6s6Da8Bvs4r7FkfTlKn_fOsIJ-j7oH7RxEipvlkd17BsHw9hTPivX1mB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-04hiZSGI8YaVU6Z6B-qYy5nmcl2nkiuhbU-E4xt_7g&oe=69F0C810"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spd4e6ObZrcQ7kNvwHE0Mfn&_nc_oc=AdrRw3n5lVumETkfDYovoGRA-jwxkDyWdT0RUPA0OBsws6-M9F5xjQwthodKY1YCm0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af21r0d-Xcqidu3EtFd1dGGmegXOXKZJf4f9L_RLs8hwDg&oe=69F0A39A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
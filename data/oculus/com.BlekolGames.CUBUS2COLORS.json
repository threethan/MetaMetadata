nt-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_K70KbCQQJ-v-ibZ_jlvtKguQO0la93Rlq9V3Eq6WzA&oe=6A5A2064"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xv823oaJVgQ7kNvwFKma_C&_nc_oc=Adp6rAywJxUR1hMqyT2ewGuZXuhL1oUrB44eo7t0-RYRiJCh71ukQGRtn7dtcv8BatE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSG9Qr--j8rWkFAJ-AA1V4DHt7dmTfksIUVqgYmOXPaQ&oe=6A5A1489"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YSvB1gKQSAQ7kNvwEXy1Cf&_nc_oc=AdpnaKVBHYybxG5dAh397Ewj2I7oh3FdIth7KUNLiGCdt9w267QITdQbztoqAIXXokM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmlZtV0BXmsCv5my3hbg4LhmnB9_UhsP9bTZHXRpinUA&oe=6A5A2E7F"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhswjZpYqeAQ7kNvwEd5TZR&_nc_oc=AdrK01HB8CKAB3VJbINXcxEjSBdsG3l78dumG8d-Fn0h62lGVQsQIhrI4NV0IV-mVXw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOfTgzZwLDsgbUqKZWnkFZeE8moipC7njTN_MJd_lPJQ&oe=6A5A4010"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFVci5tJW1AQ7kNvwG38ac-&_nc_oc=AdpWLHlAw0HBt4Fv7vR5oCoH0VkHQfbche7FaaMB1nxRRiAqPojK27SMEV8CexMECSA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVUl8K8E63UgzdlRkZGuHaNMGoAOoa8QUjCq-XmyixNA&oe=6A5A1B9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
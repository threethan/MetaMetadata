=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtgg1FsLG63hebJU0UsZsRix_oKppcrVKXy2XzQuGf9w&oe=6A7DB8E4"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBaXMSfRU5gQ7kNvwEwZOnC&_nc_oc=AdobLBpIPUjNzVRTN1HnNDILpaFmK4GC5jA39rLy5pEMQZxa8ZtvnxjrcCZUnTDpYv4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNFxIX5lgmCU32CNPB2Ax_zFcrqusGOFEcpQ2LfR6hBw&oe=6A7DAD09"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlyPM-h_8EoQ7kNvwFMxj9J&_nc_oc=AdqJHs2sgn84EL4RRwEqrLgY0GSiOIlfBRpDkoHdvsl4jukbEDu5spPngLfjhBMJhFo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCOeZKg74QypcfN8xnst6TTxDkd72wUd1YcWHzf9l-bA&oe=6A7DC6FF"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDK8GOiOiHYQ7kNvwH2Lvcz&_nc_oc=AdqYzbFKiZfXm1ZoOIf5FaVxtHmWRJDARL_dI_ZMTgZ63LDwwZgRDh0D17zyp84Rgk8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExFCLK6iV9oce7MztHcWW14nbqpw0JRiD59vrnM3KQ9g&oe=6A7DA050"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzpC-vshCZEQ7kNvwFBg9z8&_nc_oc=AdoUB_0d0VOjRtYkPjj6d6KhLjsKA6yJ6zCdidmwLV87UH-uQ0AWqkTZsdSETUcJ8jI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCK1UyVkBf5gk2gmZ_s11HAa-BM8lQxJ8nXW0qPazHbw&oe=6A7DB41A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
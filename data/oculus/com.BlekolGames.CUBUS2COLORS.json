=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5ad6fBGfdkUiYM5R6Z6TccAgYB9wwoDvTbJWx-au1ng&oe=6A396324"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb7yl94DefIQ7kNvwFP2srl&_nc_oc=AdqGAtAIbZNjP0NzNuCYhcBmB_X1Ze6Oz_4kMy7nViwoSOUs1k13P9Xi9lVaMemM1Cw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UhHnk2n4uw1afMEWA4gfbAw3wEHrmbYi3IAYcmqZJdQ&oe=6A395749"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLJ1MRBHUQ4Q7kNvwHWRSMc&_nc_oc=AdqDC0ELVoteYyux7zvPPHgD0u1RioP0H20Ea0k67SZffAM66BhRcYesKeLaBF4VXNI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jDNXyKpx2iz1ta6R6tOTOZnzIeQTPSZgCM4Z1yzS3ag&oe=6A3938FF"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0lsjim9KgEQ7kNvwE9zSa4&_nc_oc=Ado3z1ymMF2N-vY1uVUTJ1-vQYLRTSX_C0gr_wClK6hqzk-YIs1UPadCzYEwOF6WjWs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rSRcXypCTgJ1BPiDuKfK5txaiB81A2A2Tloz6pp6CKw&oe=6A394A90"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfN3Jkg9xxMQ7kNvwHSA4rE&_nc_oc=AdqZdAqBkf50DDpC0oRHvyV0rkT-SS0UOrsjN-Wh1IHuEG1Olpgobvvy2FxYW90_1hg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lzm52DZKJyUsRZfPzr-OiaRkNxzBUmkH8KPJgmeRWTA&oe=6A395E5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
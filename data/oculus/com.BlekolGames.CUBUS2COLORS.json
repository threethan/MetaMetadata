t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXhWCiSv12f7KY7UcaHGqC0c7Lz3mWgtPkxhgI29iteg&oe=6A92D0E4"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuGi_u-nlcUQ7kNvwFAcZcC&_nc_oc=Adrxij1aUjt1xrMhf_6cpJ7_yWyZyhs8It8vqewBQm61f202eGCbV6JeLXhj0lETuHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Z2vWBEQqhWUlw3TxrcZQf1DUmZxBc4AvkG2kAW9FcA&oe=6A92C509"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4NGNDYFM4EQ7kNvwEngy3I&_nc_oc=AdqHV_2dcNw38OPDqohqrMPNPIaP718xc3JaoN7PeKdMu5TYfDibY5_Jk3fRZhim3b4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5gWmhaANHCTRPP4QZfSK2GXtyIge_T2KEywT2dChtUA&oe=6A92DEFF"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwGoTntCgMoQ7kNvwF67wK2&_nc_oc=Adqpvd3eSKvNkWPWi178yHbk_SUWtcwYz7DecYPEi_BIUZrZ1uOpE_cV2saLtXt2aS4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFQ9e_r828m8gfD0Qh3QOk92yYewV0_6TRSZ9naPPxhg&oe=6A92B850"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsAleBFd5KAQ7kNvwG1qcr9&_nc_oc=Adpk1Vf9vfeC1gSUe4FtZf5CnamAryzy0iw93f5UUPD-D3rJ5nn3olgWrgZ0UQmZY1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMNao9Z3jDI7cmXM_GgrtGoze8-ocu7ffktM_B3kD2zA&oe=6A92CC1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "M
nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rIsNm3WMx-T2OMDrwoVSohEId2FMS0GAhrSAQmnBigw&oe=69E37964"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFnukt6rZ3wQ7kNvwHhBHZc&_nc_oc=AdrzCTdThPL0ZsdUIjUYq8IloMd0_wvLOMYa1sUwlnilsH-N1TbQMtEGabQ8c1hgXKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BVWdl68iz8rtHbotaU0QfCo4sa6lRcvBJ4182t0YnKQ&oe=69E36D89"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkhxPPdp4c4Q7kNvwHg-MbU&_nc_oc=AdqdirzRFGY-MdFWScnevCpwXg9kx5c1TDWcMQSGZLD9uON_fAROzliZ1EYPvGe9Edo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I3REKhMBLi26kwB8Zde68WSuv_os0NtwwVGX_nN3KDQ&oe=69E3877F"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uebtDvF7gHsQ7kNvwEksFek&_nc_oc=AdoDJJrIFocGvB22lb9Dftbl5WfZxTBECNC5Xu6qjq4ZES2fLXDnkKzByJlbX9vrke8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12uJ2MqupSz_kBmrV4UkRWCd260euoaCW6p-TAwijErQ&oe=69E39910"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqC_iTpNrBYQ7kNvwGlx-VL&_nc_oc=AdoYmlir38EBZ1FVQuHD20KylBtMCCOerMtA9NklqihNMi-sxgAvxmPZdU1WJ-M7wOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NNH1jIu3Jad0BQhdTC4k9fZxoUVmEYGQeq-wE3rCNBw&oe=69E3749A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
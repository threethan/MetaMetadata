nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bZtoCrT7A7-bJ4hswjaSNveWDkg7LFkTtkgkbLtzXRQ&oe=69D3A764"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eCsy0JF5ZEQ7kNvwFp51jo&_nc_oc=Adr5v91wbSqkc_OAIS6xbkdT5f9GX8_8aIXhq9vhrkXQvGh1AfY33OS7swQWrs-dkM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33DL2k49OqC99vR2BGo5I8OrUuJnikHMJw0219pw8FOw&oe=69D39B89"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGwSpWr5NUgQ7kNvwG3_vDr&_nc_oc=AdoM0U0ff7e9I2LlkMSmiH6Z7uldTqVn9eTRZ2mOdNlSKI5ZXFO9Qysf0MNMVIq3WvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eFXHgzD6f739_8Z2WgpGBhYMwnePY2vrTzoe7l4D1QA&oe=69D3B57F"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQwYGEtl9GgQ7kNvwEhOxaq&_nc_oc=AdrjGvBqspLVGol5woakFKLVyD8MpuEdMtngiLIo6hP8IuMWmOUAbLX-jwz1ndAjURs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23P06tGDY6Ol1FAt5CBiY35DP3AbIMiy4_mdZRaLCq7Q&oe=69D3C710"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaTvUEa43DIQ7kNvwGUMAMW&_nc_oc=Adpij4fLdA5RV35VGanKTdD4UmB3BnA4hgd76IMDFEHIg07fZzDsIr7BM4JCNEL-LSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oKYurE8SpXPJt4QVP5h67N1ejTxrb36flWHUUUC2kDA&oe=69D3A29A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
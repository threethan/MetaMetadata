t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1z6yGf6qO1MXYcfHK0QScNbogIspvbi7g_o445jalKA&oe=6A95AC24"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4B_VLe7MFQQ7kNvwF628jt&_nc_oc=AdrMJ5qiIS2JE0FwL-bGSdZXXfq0EsaQiRo07DGtTTKG0v8MyX-XkA9jl6HmO5iQrAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSbG79jOtoy8zRXU0ahJz1vG1R1KxGjnBZ86l8UZqTZg&oe=6A95D889"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGuq3eG_2AEQ7kNvwF6C_-t&_nc_oc=Adovl7k3WaaBnIDric5njff-t_vFFZI5ZqZgs2XVbtz_PwuVqgqwnZNMy7zA0rp6pkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhKs6tv3jqUYpCf8WjjWHe7d2Vx4EB4VqwXC_YNDqXVQ&oe=6A95BA3F"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5OeV4Ub1sgQ7kNvwEe6z_R&_nc_oc=AdqJX1IOGtgBE7xcX9uY9T8Aa9vTO9znwBjmSUAKaJq7Rqe6tDtDVwATM8zXzDW60-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH48xNtzaVVv5iqylYYx5bOeSCypBAE_j8iofDD3A-eog&oe=6A95CBD0"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsAleBFd5KAQ7kNvwFzidZx&_nc_oc=Adp86i0RqQ2XVlUPwLvwLzepzjSMActBzVKXW3vH-U2MpG18NYro3W_YdW4Miba6qqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJO5GSRMUBzpWvLwvvWROaWrfMfxW5Urgi4zJghST-pw&oe=6A95DF9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "M
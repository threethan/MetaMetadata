nt-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y5DfqycUIHmnqr7h1v6U-paUJMnOmh8TvtBZN0ID9zg&oe=69EA10E4"}, {"file_name": "screen-01.png", "id": "895303302956974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_895303306290307_883538700252767878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zcw3-0XDyAQ7kNvwEWgEEX&_nc_oc=AdrFfsiTrJWKj9CrhXG3lLHiZlx6XMcEfUrvEDLGjBaOzDTWN2yzvaHhj7fE1o1zi4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13hiRo6_w5mftyQfwta1TSF22u3OlgvyKKaFbgxxCrgQ&oe=69EA0509"}, {"file_name": "screen-02.png", "id": "1325952856213652", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824307_1325952859546985_3194515278061979397_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBfg1cPoqN0Q7kNvwHe-FcP&_nc_oc=AdqDsR9J17a7eYI5NWfv8RZIQ2addE8Z526soDa7iWjSNIItiQUIRfuXpLHIyoH8Kn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oOJPVtZLqDUSI296yzRd2J6roevPZQZl4TqwT_wlHAQ&oe=69EA1EFF"}, {"file_name": "screen-05.png", "id": "759400299922287", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_759400303255620_6051725734723348964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFFZzPAumpsQ7kNvwFbSTjl&_nc_oc=Adr3Zqrme-bnNa4qRTMk--rUKIOZT8duY6igFtz1KciynrF6BlvlsDXmFGMPxTR-NAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z_NrygXqgE2dWqbgw1AJN4WA5M-403vol4GvoDpHg5g&oe=69EA3090"}, {"file_name": "screen-03.png", "id": "1206146704373229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1206146707706562_1592306317012086359_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cqL_YYiMg8Q7kNvwECvbRo&_nc_oc=Adr6j8R750ZuwnYDiVh03byHlnxbf79LIOWuTde9n71COFpUB8JpfH_caJhl9O6irdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JCEiDuW2YdN9jPhA25Cb-eTNc6_hcSTkUumu_QolZMA&oe=69EA0C1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS 2 :COLORS", "keywords": ["color", "puzzle", "logic", "educational", "stem"], "long_description": "Cubus 2: Colors is an immersive VR puzzle experience built around color logic, spatial thinking, and fast decision-making.\n\nYou begin with simple learning levels using three primary colors \u2014 yellow, red, and blue. Grab cubes with your hands, throw them onto a color table, and collect tiles by matching colors correctly.\n\nAs you progress, the challenge evolves.\n\nIn advanced levels, success depends on mixing colors in mid-air, creating new colors before throwing them to the table. Precision, timing, and color knowledge become essential as the game introduces mixed-color challenges and tighter time limits.\n\nSuper Intelligence levels remove all primary colors entirely \u2014 only mixed colors remain. These levels demand full mastery of color combinations and quick thinking under pressure.\n\nThe game features:\n\nInfinite levels with adaptive difficulty.\n\nPerformance-based progression starting from level 6.\n\nTime-limited challenges that reward efficiency.\n\nA smooth onboarding phase that learns how you play.\n\nWhether you\u2019re learning color logic or pushing your limits in high-skill challenges, Cubus 2: Colors continuously adapts to keep you engaged.", "short_description": "Grab, mix, and match colorful cubes in an endless VR puzzle that adapts to your skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/games/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "Blekol Games", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
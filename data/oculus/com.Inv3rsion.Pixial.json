cRMhZdycDb9Y6uwaywvfXWYA61Mw50w&oe=6A21928E"}, "display_name": "Pixial", "keywords": [], "long_description": "View YOUR models securely in an immersive virtual environment.\n\nSECURE\nBuilt with security in mind! \n  - Enterprise login support including 2FA \n  - Data stays secure in OneDrive cloud storage \n\nEASY TO EXPLORE\n  - Drive, fly, or teleport your way through a scene\n  - Reach out and grab a part, and scale it up or down\n  - Explode a CAD assembly\n  - Slice through a model to see what\u2019s inside \n\nREADY FOR DESIGN REVIEWS\n  - Mark up models with a pen\n  - Take measurements\n  - Upload screen shots to OneDrive", "short_description": "Securely view & review models from OneDrive or local storage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.inv3rsion.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "INV3RSION LLC", "support_website_url": null, "website_url": "https://www.pixial.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1809521999406547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75361346_1157402665146912_4656827147591897997_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh4wZfeT1-QQ7kNvwGDa5sK&_nc_oc=AdqEL8XpRjOqLeq6MtoW_61P
v36GujIWYgj6V-zAeJsV-8q388iTnqOraGe1XKHknQlwORU1Ylgf0GFTsy80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwljO1cOG2lVk0OjpnpXcHa7I4ApRJVz07FcTGFNZ51A&oe=6B0C7FA0"}, {"file_name": "Screenshot_4_\u672c_\u8074\u304f.png", "id": "1482823757126097", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839695_1482823760459430_9016647954895828215_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVVMVMCEGs8Q7kNvwF_Sbnp&_nc_oc=Ado6MhTku9kKhNaoHgpJMZDcvUp3jlSqsYJMoswOsHo9fyvupAkAZ2W_b_Ezj_s-7os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3OOXPCxX5o8g0ITIccJ9dpw8OkEav4xr6cJ_xtN_R0A&oe=6B0C7035"}, {"file_name": "Screenshot_2_\u3072\u3056\u6795_\u64ab\u3067\u308b\u624b.png", "id": "2945169932527331", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593809430_2945169935860664_7536762781045788724_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6M9xNaD_SwQ7kNvwEQEkL7&_nc_oc=AdqZsB9h163E9-HJ9-TV-ZUdMqVjJ0pP5Kcny_BaUr29-BD5R8tPhu0HSkFllymKLAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSC8bUgQ1cj7jd9UJstlz1ATf_BylfDxTKAVIZJ-1SGkw&oe=6B0C5355"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "2303186753869298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593714175_2303186757202631_1577530502778306083_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J12sdcEZ_-EQ7kNvwFpflIy&_nc_oc=AdptRNr67csVZWi7_WrPc_ogCvmkc6T2UsPbZ1mx3y33DMV4QS9H6eaFkqHzRQWfez8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4PYfwi1n4pF-ielyIi9t-2Ruc2NTi6cJdwg62lFJIIQ&oe=6B0C54E1"}, "display_name": "\u307f\u307f\u3082\u3068VR \u2013 ASMR\u30d3\u30b8\u30e5\u30a2\u30e9\u30a4\u30b6\u30fc", "keywords": ["ASMR"], "long_description": "Mimimoto VR is an ASMR visualizer for Meta Quest. Play the ASMR audio you already love, and a character appears beside you in VR, moving with the sound.\n\nThe app analyzes the left and right channels to tell voices, breaths, and ear-cleaning sounds apart, then turns them into motion: leaning toward the ear the sound comes from, moving closer, hand movements, ear blowing, lip movement, and facial expressions.\n\n\u25a0 Three poses \u30fbLean-over: lie down facing up. The character leans over you and whispers into either ear along with the audio. \u30fbLap pillow: lie down with your head on the character's lap while being gently patted. \u30fbFace to face: sit or stand and listen face to face.\n\n\u25a0 What you can play \u30fbAudio files on your Quest (mp3, m4a, wav, ogg) \u30fbASMR works on YouTube and podcasts (internet connection required)\n\n\u25a0 Characters Use the built-in Mimimoto model, or load your own VRM.\n\n\u25a0 A quiet bedroom at night Three lighting levels and a sleep timer from 15 to 90 minutes. All settings live inside the book in front of you.\n\n\u25a0 Notes \u30fbAudio, VRM files, and YouTube/podcast works belong to their respective rights holders. Please follow their terms. \u30fbThis app does not distribute any audio. YouTube and podcasts play from their original sources. \u30fbHeadphones or earphones are recommended. \u30fbParts of this app were made with the help of AI. \u30fbThe app interface is in Japanese.", "short_description": "Listen to your favorite ASMR with someone right beside you in VR. Mimimoto VR reads the left and right audio and brings a character close to your ear\u2014whispering, leaning in, and gently patting."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "29494291786860952", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_29494291790194285_8393422723746292657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJVsi8a8C98Q7kNvwEVID7Y&_nc_oc=AdqX9myO7KssAIA2LKZepoT_P_ZMmv6sMG8nEkCITA3oNLA2TDYHBQ46-yPISYEC-8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFx05s7qsHp1zo2rILCbh_Hi7Sct6HyRLzZzf2L66EEQ&oe=6B0C5ABE"}, {"file_name": "Cover_Square_1440x1440.png", "id": "3207274216329943", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623179_3207274222996609_5089304241319381446_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8nGht3UjHUQ7kNvwFCGCtu&_nc_oc=AdqeXHnVNfqlBo5EW5TXJiiamQhAH0bG5jmqW0aP7oKBVCSAgX8vTPb3hlXyBWEX3uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRX7pR1mTX8QyDmgm--d9_uroYPbL3zcNTWFq_6zqehcQ&oe=6B0C6C10"}, {"file_name": "Cover_Portrait_1008x1440.png", "id": "2906877383026903", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_2906877386360236_1975304542933234131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IFhMe7p4RkQ7kNvwEOkW4S&_nc_oc=AdoqrfyAUytjwv-_-s4LW51DDp-w18ooPdBdUOFwwP9ijykze2AzblrGEpZTeakBUyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRI6QLc4uAt7_6JmEwbpcKfqSoJmhjGWDnWNEbGYWrkvw&oe=6B0C7BA1"}, {"file_name": "Icon_512x512.png", "id": "1682323330085856", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593822060_1682323333419189_5998098880722400440_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T8mLDvLvyIQ7kNvwFVN95P&_nc_oc=AdqawLEt0CbejSN7t8mwnS0CtSkkdHN73raIc0GbmbbGFZfMUNT_hmKsJQsNghSyJq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZYbSSU3UtuSAxvGMCoJmNsnrFgWXdfYEiSiDIT4BRuA&oe=6B0C6F0A"}, {"file_name": "Cover_Landscape_2560x1440.png", "id": "1166441286039923", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628447_1166441289373256_6117424809556925486_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HZSo4vG43MQ7kNvwHuRdLT&_nc_oc=AdqvCc6rJqvPwUHWRSU-tytqBgMzAYRQhznDunwoFf
pEvRFb5rYvTPAb_29al_3oOHDnyD1uXD5u9qvCR2AFskY2XGM2h-dkjRsMd4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqQbMVi744ngbmrjhK40WGEX0EiWy0L8drqVjOkpmYzg&oe=6B0B2E20"}, {"file_name": "Screenshot_4_\u672c_\u8074\u304f.png", "id": "1482823757126097", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839695_1482823760459430_9016647954895828215_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVVMVMCEGs8Q7kNvwEfJOS_&_nc_oc=AdqqzkWfqvGE1Rpy2kqiNH8p2EN2LWBpWWnV2k6kuazYUQ2xm21RQhON-TSVNsO1vIs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMny4GbrBfRP0JJwanMY0yj2I5sTMxA_thPaTKxkBsUQ&oe=6B0B1EB5"}, {"file_name": "Screenshot_2_\u3072\u3056\u6795_\u64ab\u3067\u308b\u624b.png", "id": "2945169932527331", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593809430_2945169935860664_7536762781045788724_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6M9xNaD_SwQ7kNvwHrqNKg&_nc_oc=Adr1MDWhPseVIg8tDkuIEGR0Cu-NjDs4UmHyHWb_alMoEu98RVBqhbJuoj3jW4WZfgE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_bR8SQWzSRHuXHe40wcP30BDa2t6_8pmfnH2uBcSEmw&oe=6B0B3A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "2303186753869298", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593714175_2303186757202631_1577530502778306083_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J12sdcEZ_-EQ7kNvwG8jNEF&_nc_oc=AdqQQ9F1lzgwHT1F3yxV-zVOx0ghG100qo7WjiuSphCt_6ZKqqd8cj6rq4PK38TxhRU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTme0N15idLLqythbIMoehZKbnI5kSOmrOZSLV6w8Ue7w&oe=6B0B3BA1"}, "display_name": "\u307f\u307f\u3082\u3068VR \u2013 ASMR\u30d3\u30b8\u30e5\u30a2\u30e9\u30a4\u30b6\u30fc", "keywords": ["ASMR"], "long_description": "Mimimoto VR is an ASMR visualizer for Meta Quest. Play the ASMR audio you already love, and a character appears beside you in VR, moving with the sound.\n\nThe app analyzes the left and right channels to tell voices, breaths, and ear-cleaning sounds apart, then turns them into motion: leaning toward the ear the sound comes from, moving closer, hand movements, ear blowing, lip movement, and facial expressions.\n\n\u25a0 Three poses \u30fbLean-over: lie down facing up. The character leans over you and whispers into either ear along with the audio. \u30fbLap pillow: lie down with your head on the character's lap while being gently patted. \u30fbFace to face: sit or stand and listen face to face.\n\n\u25a0 What you can play \u30fbAudio files on your Quest (mp3, m4a, wav, ogg) \u30fbASMR works on YouTube and podcasts (internet connection required)\n\n\u25a0 Characters Use the built-in Mimimoto model, or load your own VRM.\n\n\u25a0 A quiet bedroom at night Three lighting levels and a sleep timer from 15 to 90 minutes. All settings live inside the book in front of you.\n\n\u25a0 Notes \u30fbAudio, VRM files, and YouTube/podcast works belong to their respective rights holders. Please follow their terms. \u30fbThis app does not distribute any audio. YouTube and podcasts play from their original sources. \u30fbHeadphones or earphones are recommended. \u30fbParts of this app were made with the help of AI. \u30fbThe app interface is in Japanese.", "short_description": "Listen to your favorite ASMR with someone right beside you in VR. Mimimoto VR reads the left and right audio and brings a character close to your ear\u2014whispering, leaning in, and gently patting."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "29494291786860952", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620530_29494291790194285_8393422723746292657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJVsi8a8C98Q7kNvwHC-Vk_&_nc_oc=AdrzN0AcTIFWMzM-_z0yMMn_rNeMC1kDJNHfY89q6zsPMDUi63VA_aAXOHtJ4niDY7g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBJ_L9g8OdUQY01gNuRvkVXQhVt2-F84woTIHTXLpA6w&oe=6B0B417E"}, {"file_name": "Cover_Square_1440x1440.png", "id": "3207274216329943", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623179_3207274222996609_5089304241319381446_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8nGht3UjHUQ7kNvwFoFx9C&_nc_oc=AdoYD-KgsNphAJAqJk-fRPuJMnF3D_WxPU6EwbXuyeAxt0JrnU559oKwDOQFL9K7eyQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjlNSXszNqHa9_YhRjxmt6NC8R0y_xMLrygtImj2tY1w&oe=6B0B1A90"}, {"file_name": "Cover_Portrait_1008x1440.png", "id": "2906877383026903", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623512_2906877386360236_1975304542933234131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49KOVwEJsjAQ7kNvwGJMRcn&_nc_oc=AdrDlCt6UZIlOSjCw_iNg69NXA5bFcacxTbd_z3_Yjd09ja0d1Voph_qVU2mQzlJi20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEh9yjlrzApGU0MHw6eWxUGoS0Ch-8RqyqQ76KzRtk6A&oe=6B0B2A21"}, {"file_name": "Icon_512x512.png", "id": "1682323330085856", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593822060_1682323333419189_5998098880722400440_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T8mLDvLvyIQ7kNvwE8bluI&_nc_oc=Adok54p3bSp21sOCJLwpa0sVR3RnMy7dmQWpDG-CMcpuKEn-eYryEqyeWWAB4RUIGrU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMHd-DfkddXqZ0JH0zkHbTMaba-x-jN3QRHcPdf87K5w&oe=6B0B1D8A"}, {"file_name": "Cover_Landscape_2560x1440.png", "id": "1166441286039923", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628447_1166441289373256_6117424809556925486_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HZSo4vG43MQ7kNvwF8T42Z&_nc_oc=AdoSMjNbXfoFhfD4rV-sHzFyWymxJZSnVvePwiAlql
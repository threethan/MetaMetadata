sOBiNJl2hB9tRSlSp_4tWZHfoneF1lohSxKxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAnWBCenLHbA8g4-Q7m5bQCGkV-aRxI0_MiGPyfk9qnw&oe=6B0DC1B5"}, {"file_name": "Screenshot_2_\u3072\u3056\u6795_\u64ab\u3067\u308b\u624b.png", "id": "2945169932527331", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593809430_2945169935860664_7536762781045788724_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6M9xNaD_SwQ7kNvwHNNOUD&_nc_oc=AdrUMaTsTrwOvmsq6sy0pcbNy2Ng2CDI1pEzvd5u1fpAUJWNbVLdeVsuM63dcwuoG1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzOCd6sBXqVKTpJqcLtZlknW0FF5kKoqpV-LeJ2Bh-Zg&oe=6B0DA4D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "2303186753869298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593714175_2303186757202631_1577530502778306083_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVyj3a76WMYQ7kNvwH0VE0K&_nc_oc=AdrWl_xH7C56LVyoUQf3d7m7Gnnd30abjn-dDsH7HAkf_MaPi627O888S4sHWPRJBvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQW9NZEKzrBDIl1SV6GD1WDlOaRQewF8g7DEzQ21_GX0g&oe=6B0DA661"}, "display_name": "\u307f\u307f\u3082\u3068VR \u2013 ASMR\u30d3\u30b8\u30e5\u30a2\u30e9\u30a4\u30b6\u30fc", "keywords": ["ASMR"], "long_description": "Mimimoto VR is an ASMR visualizer for Meta Quest. Play the ASMR audio you already love, and a character appears beside you in VR, moving with the sound.\n\nThe app analyzes the left and right channels to tell voices, breaths, and ear-cleaning sounds apart, then turns them into motion: leaning toward the ear the sound comes from, moving closer, hand movements, ear blowing, lip movement, and facial expressions.\n\n\u25a0 Three poses \u30fbLean-over: lie down facing up. The character leans over you and whispers into either ear along with the audio. \u30fbLap pillow: lie down with your head on the character's lap while being gently patted. \u30fbFace to face: sit or stand and listen face to face.\n\n\u25a0 What you can play \u30fbAudio files on your Quest (mp3, m4a, wav, ogg) \u30fbASMR works on YouTube and podcasts (internet connection required)\n\n\u25a0 Characters Use the built-in Mimimoto model, or load your own VRM.\n\n\u25a0 A quiet bedroom at night Three lighting levels and a sleep timer from 15 to 90 minutes. All settings live inside the book in front of you.\n\n\u25a0 Notes \u30fbAudio, VRM files, and YouTube/podcast works belong to their respective rights holders. Please follow their terms. \u30fbThis app does not distribute any audio. YouTube and podcasts play from their original sources. \u30fbHeadphones or earphones are recommended. \u30fbParts of this app were made with the help of AI. \u30fbThe app interface is in Japanese.", "short_description": "Listen to your favorite ASMR with someone right beside you in VR. Mimimoto VR reads the left and right audio and brings a character close to your ear\u2014whispering, leaning in, and gently patting."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "29494291786860952", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620530_29494291790194285_8393422723746292657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g18IPqennfUQ7kNvwH9rT-d&_nc_oc=Adqkby_ifbKiBT20eMR7dptyb3xkWPTP6OvU4ETZUMbe-5xZ5S1Aq3kgj-Zorg1j7P4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHjf-0IrGijUqQjwDLUa-th0oWC-1qx9SloChwZODYqg&oe=6B0DAC3E"}, {"file_name": "Cover_Square_1440x1440.png", "id": "3207274216329943", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623179_3207274222996609_5089304241319381446_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8nGht3UjHUQ7kNvwHxaEje&_nc_oc=Adq4K5COxAmspRhVm0hnv9oEtvsHUUaVnJJaLrTYtPD9xta3FPRk2icqk7QotMnlOiE&_nc_zt=3&_nc_ht=scontent-
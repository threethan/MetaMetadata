76\u3055\u308a\u3001\u97f3\u306b\u5408\u308f\u305b\u3066\u5de6\u53f3\u306e\u8033\u3067\u3055\u3055\u3084\u304d\u307e\u3059\u3002\n\u30fb\u3072\u3056\u6795\uff1a\u6a2a\u306b\u306a\u3063\u3066\u8074\u304d\u307e\u3059\u3002\u30e2\u30c7\u30eb\u306e\u3072\u3056\u306e\u4e0a\u3067\u3001\u64ab\u3067\u3089\u308c\u306a\u304c\u3089\u8074\u3051\u307e\u3059\u3002\n\u30fb\u5411\u304b\u3044\u5408\u3044\uff1a\u5ea7\u308b\u304b\u7acb\u3063\u3066\u8074\u304d\u307e\u3059\u3002\n\n\u25a0 \u97f3\u306e\u805e\u304d\u5206\u3051\u304b\u3089\u3001\u52d5\u304d\u3092\u6574\u3048\u307e\u3059\n\u5de6\u53f3\u306e\u8033\u3078\u306e\u5bc4\u308a\u30fb\u8fd1\u3055\u3001\u624b\u306e\u52d5\u304d\u3001\u8033\u3075\u3045\u3001\u53e3\u306e\u52d5\u304d\u3001\u8868\u60c5\u3002\n\n\u25a0 \u8074\u3051\u308b\u4f5c\u54c1\n\u30fbQuest \u306e\u4e2d\u306e\u97f3\u58f0\u30d5\u30a1\u30a4\u30eb\uff08mp3\u30fbm4a\u30fbwav\u30fbogg\uff09\n\u30fbYouTube\u30fbPodcast \u306e ASMR \u4f5c\u54c1\uff08\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u304c\u8981\u308a\u307e\u3059\uff09\n\n\u25a0 \u59ff\n\u307f\u307f\u3082\u3068\u30e2\u30c7\u30eb\uff08\u753b\u50cf\u306e\u30e2\u30c7\u30eb\uff09\u3092\u540c\u68b1\u3057\u3066\u3044\u307e\u3059\u3002\n\u304a\u624b\u6301\u3061\u306e VRM \u306b\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\n\n\u3008VR\u7761\u7720\u30fb\u5bdd\u843d\u3061\u6a5f\u80fd\u3009\n\u30fb\u660e\u308b\u3055\u5909\u66f4\u53ef\u80fd\n\u30fb\u30b9\u30ea\u30fc\u30d7\u30bf\u30a4\u30de\u30fc15\u301c90 \u5206\n\n\u25a0 \u3054\u6ce8\u610f\n\u30fb\u8aad\u307f\u8fbc\u3080\u97f3\u6e90\u30fbVRM\u3001YouTube\u30fbPodcast \u306e\u4f5c\u54c1\u306f\u3001\u305d\u308c\u305e\u308c\u306e\u6a29\u5229\u8005\u306e\u3082\u306e\u3067\u3059\u3002\u5404\u898f\u7d04\u306b\u5f93\u3063\u3066\u304a\u4f7f\u3044\u304f\u3060\u3055\u3044\u3002\n\u30fb\u672c\u30a2\u30d7\u30ea\u306f\u97f3\u6e90\u3092\u914d\u5e03\u3057\u3066\u3044\u307e\u305b\u3093\uff08YouTube\u30fbPodcast \u306f\u914d\u4fe1\u5143\u304b\u3089\u518d\u751f\u
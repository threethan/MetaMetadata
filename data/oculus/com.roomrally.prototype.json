_nc_sid=6e7a0a&_nc_ohc=nXgpJswmczMQ7kNvwHcPvQM&_nc_oc=Ado_pu98rK71NPOr0WBbL9eZdWVd0SYDCqd9eKQ4Iz9qgV805gLVfRmmRDto9VblSN0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEzS15qPbhUeEY-SUYlqqcbfYwrHkb2XRqZq1vp2-cpg&oe=6AFB211A"}, {"file_name": "04-rampa.png", "id": "28795595670078714", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824328_28795595676745380_1737953041393796509_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh7TciCgx-cQ7kNvwGLYC-R&_nc_oc=AdqOxsxLhHbzyHwvp71wOMqrdLmWNxtQ85ToxjYu5EcRJksJh7YunWqoEgk_Dnv5NJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjXgDwJju-PJCTL2BmEBvK57ehjldxLJUYLimeLvBnsw&oe=6AFB47E2"}, {"file_name": "05-salva-el-loop.png", "id": "1778709976773442", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824671_1778709980106775_5593803274213598596_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVBlshK5YzoQ7kNvwERZ-H_&_nc_oc=AdpFfUne73cRNqVs5sUaylsu6fASmQFsLqMmYFteCRKqnwNNeVEZtWRmZtHp0UTuzxk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDrZmWDEOWYQK3F4yKtU-CJeD37CY9YE4jcXtVOLyAVg&oe=6AFB1703"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoomRally - Build Toy Car Tracks", "keywords": ["trackbuilder", "toycars", "sandbox", "creative", "cargame"], "long_description": "Your track starts with an idea.\n\nRoomRally is a free, single-player toy car building game. Combine straights, turns, slopes, boosters, and loops to create your own track. Place the car, see what happens, and make a change for the next attempt.\n\nIn free play, start from any track section, pause the car, and keep expanding your creation. Let the car drive automatically or use your controllers to accelerate and brake. When an attempt goes wrong, bring the car back, adjust your design, and try again.\n\nDuplicate or replace pieces, use Undo and Redo, and save your tracks locally to return to them later. Add decorations to make each creation your own.\n\nIn-game menus are available in Spanish (Argentina), English, German, French (France), Japanese, and Portuguese (Brazil).", "short_description": "Build toy car tracks, test your ideas, and adjust every turn, booster, and loop."}, {"images": {"nodes": []}, "id": "1061376550227622", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoomRally", "keywords": ["pistas", "autitos", "sandbox", "creativo", "circuitos"], "long_description": "Tu pista empieza con una idea.\n\nRoomRally es un juego gratuito de construcci\u00f3n y autos de juguete para un jugador. Combin\u00e1 rectas, curvas, desniveles, turbos y loops para crear tu propio circuito. Coloc\u00e1 el auto, observ\u00e1 qu\u00e9 ocurre y hac\u00e9 un cambio para el siguiente intento.\n\nEn Juego libre, pod\u00e9s empezar desde cualquier tramo, pausar el auto y seguir ampliando la pista. Dej\u00e1 que conduzca autom\u00e1ticamente o control\u00e1 la aceleraci\u00f3n y el freno con los mandos. Cuando algo sale mal, recuper\u00e1 el auto, ajust\u00e1 tu dise\u00f1o y volv\u00e9 a probar.\n\nDuplic\u00e1 o reemplaz\u00e1 piezas, us\u00e1 Deshacer y Rehacer, y guard\u00e1 tus circuitos en tres espacios locales para retomarlos despu\u00e9s. Agreg\u00e1 decoraci\u00f3n y dale tu estilo a cada creaci\u00f3n.\n\nTextos del juego en espa\u00f1ol.", "short_description": "Constru\u00ed pistas de autos de juguete. Prob\u00e1, ajust\u00e1 y atraves\u00e1 el loop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://porfiadostudios.com/roomrally-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Porfiado", "support_website_url": "https://porfiadostudios.com/#contacto", "website_url": "https://porfiadostudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_AR", "en", "de", "fr", "ja", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1292126427323066"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297120_2134350660492043_3342496838801561118_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p2rDWnOcWoQ7kNvwERtlc1&_nc_oc=Adow2QVEwzuIoemoV5niquHR4ia-6sgIFA_PGSb0ZCMjA7rtv_ljiQKetf3_l4EySfE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS__Wva5pQJdlepCUj-qv3r9Qhe0XQHaqg7lW70_mrxag&oe=6AFB1DEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoomRally - Build Toy Car Tracks", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1790181420, "lastRevision": {"nodes": [{"id": "1288832307652478", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1288832290985813", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2447724795754680"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "4537085673218510", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoomRally", "keywords": ["pistas", "autitos", "sandbox", "creativo", "circuitos"], "long_description": "Tu pista empieza con una idea.\n\nRoomRally es un juego gratuito de construcci\u00f3n y autos de juguete para un jugador. Combin\u00e1 rectas, curvas, desniveles, turbos y loops para crear tu propio circuito. Coloc\u00e1 el auto, observ\u00e1 qu\u00e9 ocurre y hac\u00e9 un cambio para el siguiente intento.\n\nEn Juego libre, pod\u00e9s empezar desde cualquier tramo, pausar el auto y seguir ampliando la pista. Dej\u00e1 que conduzca autom\u00e1ticamente o control\u00e1 la aceleraci\u00f3n y el freno con los mandos. Cuando algo sale mal, recuper\u00e1 el auto, ajust\u00e1 tu dise\u00f1o y volv\u00e9 a probar.\n\nDuplic\u00e1 o reemplaz\u00e1 piezas, us\u00e1 Deshacer y Rehacer, y guard\u00e1 tus circuitos en tres espacios locales para retomarlos despu\u00e9s. Agreg\u00e1 decoraci\u00f3n y dale tu estilo a cada creaci\u00f3n.\n\nTextos del juego en espa\u00f1ol.", "short_description": "Constru\u00ed pistas de autos de juguete. Prob\u00e1, ajust\u00e1 y atraves\u00e1 el loop."}, {"images": {"nodes": [{"file_name": "roomrally-icon-512x512.png", "id": "2507612863094794", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298387_2507612866428127_6601129487998695364_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7cnNnx7gA0Q7kNvwHImFYT&_nc_oc=AdoyYfmUaNwYWXDSFpmzZ1BnwED9DD79Su9g4elO5X7fti7eIQKkhpetaNNJs0I3vnQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgGW2oaYRuwuZtBWY60UcHIGZCGhAmZ2aoyKeJfdm1Eg&oe=6AFB335B"}, {"file_name": "roomrally-hero-3000x900.png", "id": "1857847062066896", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312231_1857847065400229_3897610385066957195_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2eG-v7wmJoQ7kNvwEDSLB5&_nc_oc=AdoQU7dCDyLj_0Mqibor5B_NjDDrt2tEGAdSgnsbc0EURgNv50GJIH0_nfluPEIr0O8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&o
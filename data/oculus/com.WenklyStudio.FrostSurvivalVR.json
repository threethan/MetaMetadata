at=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29pV3HhL-vEQ7kNvwHkyxwT&_nc_oc=AdrLtighLe3trgrusE1xm86ZtPmrtx20DhcVd88WV2zxRqgWBgqnXwZy-h34oTZjMCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqrKYFzZbpseYt0GEFHMDFT85MooRRtecQgUR3IA76ag&oe=6AC3AE7E"}, {"file_name": "s1.png", "id": "1731821457403870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822784_1731821460737203_1976246460782187442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQgAnuAm3O4Q7kNvwF-LIxr&_nc_oc=AdrwRenTTBLMLYUhbAebNBuZ79fOSYGu8p7IV_FJPAko5_jtf9UNTIj1yXZrehxcVi4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNdCIZ7NGq6aaXJvujTCet1cfL-Mjo-rCXFmXigw0KPw&oe=6AC3C92F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Diusgj5YJJYQ7kNvwE5A7gZ&_nc_oc=Ado0KoEL9wCD75Azvacek6aDPaS_LzNYvjxp7cyQvbAagQn3_vNdCMWCg5v6N8RNfQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCHr8QM1qH9i-1Az5XrrvoqAbRVitU7V0fOi8fbymjCw&oe=6AC3CE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcxJQ122wrwQ7kNvwHGMklI&_nc_oc=AdoMSzOB0VS5T-jSmMWBnTsuay4yB9la6ddKlq46ov1V1GN1ai87pxk7zKzovjcivBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOResB_jw2rtwQkrMVaBUNjAFsNPfLsCuTKsC_CNXm9dw&oe=6AC3ABB1"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. \n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-frost-survival-vr", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-frostsurvivalvr", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/frost-survival-vr", "category": "GAMES", "comfort_rating": "COMFORTABL
g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnfvfARpKj8Q7kNvwEJyjaF&_nc_oc=AdrwMq0D1OlW4_VOlthI_TF8KnjD_jsMyxg1NQH3kGTpTrMzcibAsB7rUL78XD8viYc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x_DAcPj8KxG4y2-oSOMEPQxtAIwPsoJJx24XYBMkz4A&oe=6A22D77E"}, {"file_name": "s1.png", "id": "1731821457403870", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822784_1731821460737203_1976246460782187442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhvEf4G5dCkQ7kNvwG0nM1I&_nc_oc=Adrkwo5YpJ9N15Ysce2SlQ9mA4tj7_lWa88wA7BugdNH_mkiMhReDbtpyosIJFuf2XE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4IKMc32Qa0l26ttUi4zBoFmQGPV-hh4yEopDlojXBMQ&oe=6A22F22F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VduGf2ly8roQ7kNvwFdDvpN&_nc_oc=Adow0xNiUQ23R8_AWtrLo8kRoHpOqNN3dPfgyjGUEEk-2MnisFSbDQNcqzBxw4KPY1Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Zte_PCeP_B3i8-vN1fblV1T84LCDpwltNsTSyTqzxA&oe=6A22F716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMWowpd7dbkQ7kNvwE2cWUU&_nc_oc=AdoXXh9ViA15o3u8x6Gveu3LuNP3XdezvKJKQS5SlIk0Z3sB8U1XTDpsbfHIDOizRDo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5kmxbdfLw34emTxuo-OuLj3Q7O5exHdLaKzPO9UyEXA&oe=6A22D4B1"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. \n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-frost-survival-vr", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-frostsurvivalvr", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/frost-survival-vr", "category": "GAMES", "comfort_rating": "CO
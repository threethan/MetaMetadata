culuscdn.com&_nc_ss=7f20f&oh=00_AQRXknLWHVsp27nhwMtpG5zXj79zR1gh09-I9virp-Wn7Q&oe=6B007DEF"}, {"file_name": "s4.png", "id": "840338128307378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824052_840338134974044_1441857360551667786_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BTuq6PlnpcQ7kNvwElyUxg&_nc_oc=AdqnwBN1RmOaqxk-Suc3BAor3un99VaLKCmxdbQ7a11lD1wu4ZbZz2r3ZhpApqYrEMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTboRebNV3MYsNfn94v63FsguYVTfF8yoXi76iO-Zv0Qw&oe=6B00537E"}, {"file_name": "s1.png", "id": "1731821457403870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822784_1731821460737203_1976246460782187442_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRBqJNDZ8owQ7kNvwFq-VXt&_nc_oc=AdqFq9sz_R_S51RdfbZbKcuWLkpt0upmybfp0aGaOLJw0grecbE2WqMKE7XdQjQyOJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTumOL2qxooSswyCRjFDX-EhotbfSpWVjX6LR-8OlnLBQ&oe=6B006E2F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDWoze5O8nEQ7kNvwF3ThXS&_nc_oc=AdpQohCIVb6EJJcXncB3poou3pSxC9ROgie_h_NLbZBoyLZvsR40L_DRQmn2seCy5zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRca8maPs3OTV5wBKRSfgDtvYoTZLwsq-APQ4bb8HOwlA&oe=6B007316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kciV6Lbq4UQ7kNvwHgUyi_&_nc_oc=AdqYMkHGuzlOXNDfxsmbyoKlE2OSWYF3Miw9Vyxi19kmHW-XneKyFdfbA-GHSEbb7-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTolh-LqzxLW76XYuYRKIPGAK3hhva2FSwTCznItELHWA&oe=6B0088F1"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. \n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": 
culuscdn.com&_nc_ss=7f20f&oh=00_AQT8hh28MLujG0VtZGNrQ12_SI7c_L6TAb6DUyx0ROpHhQ&oe=6B05C3EF"}, {"file_name": "s4.png", "id": "840338128307378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824052_840338134974044_1441857360551667786_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxj57cdOpaAQ7kNvwGATer4&_nc_oc=Adq2toDO1gf8MJGB9uLS8yavJBE6bbpxY0a2Q1IjyiIpGXvyN7k7sQNGoD3BYBDPFHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTSTQRZb-OxXJIkL_8weQg9M0Sc9n7_KyeJfL2X4iHLg&oe=6B05D1BE"}, {"file_name": "s1.png", "id": "1731821457403870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822784_1731821460737203_1976246460782187442_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtE1y3WcCtQQ7kNvwHavjBz&_nc_oc=AdrB7V2GvBWmKPaX0lIACFowcsNKNLDGfo629p0-9zacRgioNP1KO0N5IG_CmkW-ZIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQNjgzMQkUvZqI-P39HCxhYBjwH-OS3nY4cxNhQN9Paw&oe=6B05B42F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzoGgwmnFJgQ7kNvwGAiZpJ&_nc_oc=AdpRtp2ADxvp9HzJ7ZwHTaDEgpaEOGBqnZgLhcst33ZhKEDmiNnDz_V0eXHow3N9E7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcu6SbAcc8GYiftn3dR7FVSVdX69dPjpLaSp66x3Y9Tw&oe=6B05B916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH3ggQT6CUEQ7kNvwHKG4y5&_nc_oc=AdpYSyAfcW_5qjpwft_xncGTGSV6f6k65DbGMQfazOe9r5Xp90-K45bNPsQduIiEQpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb_dgGcc2obFKtXJi-6e2RWqQTZJfaXSowLsWOHyeAug&oe=6B05CEF1"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. \n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": 
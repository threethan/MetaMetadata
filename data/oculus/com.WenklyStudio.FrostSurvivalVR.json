GZsFVdVSeYQ7kNvwHP8K-_&_nc_oc=AdkC_bNhD48JsqIkEk-M22n7HtFYKq8u2fHSItwpXg14Oa2_rLuvia4DgPO9c4G2eJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpNL2k-79IyAC0sHqkOugoQtbp8xfUb8BfxqwfPN2ggg&oe=69AD646F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39eAi-0f-D8Q7kNvwF6WMzt&_nc_oc=AdkgAU5iFWhObIg9qMuyGb5D2JFoXtahH_KRqroEwcJg7wepSVlRgnHNhCE-o10mRIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbSS9IDBmFWeBh5IsDcVCsO4Bz0PGwRl0lJuoyBlPIng&oe=69AD6956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhZDUzevDaQQ7kNvwHl4y0t&_nc_oc=Adl_e2L_Z_PN0tc99NDvoiwCK6zHT5PcL2o19pWKV2C3Z8bgG6EKSHSrUdYCPTCD0kM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYRWtyXhcIs63uFy-KQKYZk5LDqRPYzP0pgZZlwT5UTA&oe=69AD7F31"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. surroundin\n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-frost-survival-vr", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-frostsurvivalvr", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/frost-survival-vr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
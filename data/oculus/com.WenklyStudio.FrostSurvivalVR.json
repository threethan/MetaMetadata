uluscdn.com&_nc_ss=7f20f&oh=00_AQIe25tmvoqSAI8aOpvk0GtsUPK48ZTf7KU2fNLwQcg40g&oe=6ABE832F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YWLkPzCe3cQ7kNvwEm698-&_nc_oc=Ado9UZZF_wPV0BEIV_ARJpydRsFFkoY8Rf-kmeE9RXcPEX3K9zA-43s6hPYdEOYCfV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj8j8wHFcVzYo1dcj9ZUhaPbwvB2c7ix88qX-fZcXMkw&oe=6ABE8816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440 a.png", "id": "1672661304127956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827273_1672661307461289_3410736206105956984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTlRI3kdPQQQ7kNvwH6n2Lb&_nc_oc=AdpHC2YlS6cngHveskOjHaK7xZ1pHxNiQgRJh8_We9slGfFjq1qfBXFCCy_AgUxCyCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFYfK75uoFIzr7sYp0ffKLmJyKE2x5-dYJVIjHnhmryw&oe=6ABE6527"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# NEEDS & SURVIVAL\nIsolated from the rest of the world, you must rely on your own wits and limited resources to survive harsh conditions in this **Sandbox Survival**.  \n\nYour main goal is to stay alive, but how?\n\n**Build your Base**: Build a shelter to escape the frost and replenish vital strengths. \n\n**Tools & Weapons**: To survive and fully exploit your surroundings, you will need a variety of tools. \n\n**Hunt, Craft & Gather**: Hunt wild animals to gain food and resources. \n{2415482838807640}\n\n# WINTER & WILDERNESS\n\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n\n{1374006587069647}\n\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging. \n\n{1841986256579353}\n\n# MULTIPLAYER EXPERIENCE\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.\nDo you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players. **Shape your survival sandbox experience your way!**\n\n{946707934043394}\n\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme. \n\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Face a frozen wilderness solo or in co-op - build a shelter, craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-frost-survival-vr", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-frostsurvivalvr", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/frost-survival-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
g?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcTSBAMrmNEQ7kNvwFC3-7D&_nc_oc=Adqa7WmrAvCTESc3Pt0FEcQLN7C4ulQXhUHWId8751GrTSLbQcprBDVg-EKB83lvQAk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1HoHD7zP7smeREsNdoxI_nGWymBO6LbmDnyLOGzqv_g&oe=6A7DCEFE"}, {"file_name": "s1.png", "id": "1731821457403870", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822784_1731821460737203_1976246460782187442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d_5VmWmHKIQ7kNvwG_hfgy&_nc_oc=Adp8jU3r6PcDJxGCEK8GDSRkbg3Dy32mjcAJwtuMlM5OGqgv-6p3bVUuBD2J45KXwcI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg37TX-Q_28fUYtExZnkFfqyXNxOwaZeWzPjg3x-oeeA&oe=6A7DB16F"}, {"file_name": "s3.png", "id": "973142324806852", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828831_973142328140185_9053732965349338513_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=616P9idEXyoQ7kNvwG1bR2r&_nc_oc=AdqaArHCupQRUmxs153Iy2pjh56F-12LNKXeNgXln0lc0Z8S0syB1sKt6S2OwFJiAEc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3wcqyHS71PnsgQgodyDzXKGorbHTM1SDhCAscl3RLwg&oe=6A7DB656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1448934419753798", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618481_1448934423087131_883208975624079371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra6dT1bCeggQ7kNvwHdbSaf&_nc_oc=Adqob2WFsoTqP8KJ0hEe10cC6x_cO1cxFsmogO1j0EIXuA7AiXH0QaVYXi8JnQt54K4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbbiIFKTnwzTb848DlQMG8y1XNYQrzTUr0EOvp2M4e5g&oe=6A7DCC31"}, "display_name": "Frost Survival VR", "keywords": ["survival", "coop", "crafting", "building", "sandbox"], "long_description": "# Shape your survival sandbox experience your way!\nTry to survive **alone** or **cooperate** with others in a multiplayer experience.Do you like playing alone? Don\u2019t worry, there are some uncovered secrets scattered across the frozen wilderness that will help you endure. Or work together with other players.\n{946707934043394}\n\n# NEEDS & SURVIVAL\nYour main goal is to stay alive, but how?\n{2415482838807640}\n\n**Build your Base:** Build a shelter to escape the frost and replenish vital strengths.\n\n**Tools & Weapons:** To survive and fully exploit your surroundings, you will need a variety of tools.\n\n**Hunt, Craft & Gather:** Hunt wild animals to gain food and resources. \n# WINTER & WILDERNESS\nStrategizing your moves is crucial to staying alive. **Weather conditions** are unpredictable and change dynamically, so always be prepared! Explore a **huge map**, but remember that not every place is safe; some may be inaccessible based on your current gear.\n{1374006587069647}\n# SAFE & SANE\nSurvival isn\u2019t just about staying alive, it\u2019s also about **staying sane**.\nIn Frost Survival VR, you must take care of not only your physiological needs but also your mental health. If you neglect it, reality may start to blur with illusion. **Fake sounds** and **creatures** will make survival even more challenging.\n{1841986256579353}\nThe project is co-funded by the MEDIA strand of the European Union\u2019s Creative Europe Programme.\n{1928485044562051}", "short_description": "Sandbox Survival in VR. Build your own shelter and survive the frozen wilderness solo or in co-op. Craft tools, hunt for food, and manage your resources to endure harsh conditions. Strategize your moves against unpredictable weather and lurking dangers. And remember to keep yourself safe and sane!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-frost-survival-vr", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-frostsurvivalvr", "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/frost-survival-vr", "category": "GAMES", "comfort_rating": "CO
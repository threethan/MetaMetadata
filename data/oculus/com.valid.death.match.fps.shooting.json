c=AdqexdKemU6PQ9lDOHE9JH-NqDsqPTIg-T3tVU_NiTx_FdDM7tsvxC1ZCMD_IzvEV5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVC_g7sIlsGdQYFFnvtQ1gJ_9TiInz85iTKAxNTi4QrA&oe=6A9EB7BB"}, {"file_name": "1.png", "id": "27288414787428847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312231_27288414800762179_1435902586768437669_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akjvFY_MbU4Q7kNvwHhr5Jd&_nc_oc=Adq1cdWpkyCaOaZtTRfIwCWGKXJ1MqWX8ivCD4W8pVI7eutQZyduvt6uQk_RH81VvmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN7GzZcJdGVlL7_HgTkMFBFr8EQIuP_tbLds41LQv0-w&oe=6A9ED5FF"}, {"file_name": "4.png", "id": "2129705657881102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293669_2129705661214435_7728049287977058143_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqJLp5-HWOQQ7kNvwEkBcdw&_nc_oc=Adr_8TSMFzK-pmuIUP0itDEp-ZnDYo8gGuV5jLUGc0VFa9kP5gCAz7sAj-ma_nJk5lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_X1uz1hx17uJyf_S7ZKE0sy8Ja3tNTTHb5ciGZ7iQmQ&oe=6A9EB142"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Death Match - FPS Shooting Game", "keywords": ["FPS", "Shooting", "Combat", "Battle", "PUBG"], "long_description": "Step into the battlefield in Death Match, an intense first-person shooter (FPS) game designed for immersive gameplay and adrenaline-pumping combat.\n\nPrepare yourself for fast-paced action where every second matters. Fight against waves of enemies, master powerful weapons, and prove your shooting skills in thrilling death match encounters.\n\nWhether you're a fan of tactical combat or fast reflex shooting, Death Match delivers an exciting FPS experience with satisfying gunplay and engaging battles.\n\n\ud83d\udd2b Key Features\n- Fast-paced FPS shooting gameplay\n- Multiple powerful weapons and combat mechanics\n- Intense death match battles\n- Smooth and responsive controls\n- Challenging enemies and survival combat\n- Designed for immersive gaming sessions\n\n\u2694\ufe0f Test Your Skills\nEnter the arena, aim carefully, and eliminate your enemies before they eliminate you. Every match is a test of your precision, reflexes, and combat strategy.\n\nDo you have what it takes to survive the ultimate death match?", "short_description": "Enter the battlefield in Death Match - FPS Shooting Game, an intense first-person shooter built for action lovers. Fight against waves of enemies, master powerful weapons, and test your reflexes in fast-paced combat. Aim carefully, reload quickly, and survive challenging firefights as every battle pushes your shooting skills to the limit. Experience thrilling FPS action, immersive gunplay, and nonstop combat where only the strongest shooter survives the ultimate death match."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26629526013370135"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2128435891213198"}, {"status": "PUBLISHED", "id": "1645973877149861"}, {"status": "PUBLISHED", "id": "821521104231732"}, {"st
m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yfd2a8pQgCkQ7kNvwF4wF5a&_nc_oc=AdoexVDs_4boLSSBIWf-WJZxZMujb-4Ie8Ezcvf6B-DF0jJeWKdI9i7XOOg3XX4CZOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z_IzTLB3OdwWc2UlBIugEI0OG5Dvv6Iq1frABL4R0aw&oe=6A3E7EF2"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-9jjOHFK7wQ7kNvwGojUfb&_nc_oc=Adr_NOuLpA_Z3exlDcKGoL9weEKSo5KCII1e-mJKYJA7jyIQri-BDZUalqa2-Trw44k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kAyL7K4mt7JCxVfhh-oY9VSf4shlT_5v2fICmN7WQQw&oe=6A3E7815"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2aNETOJStsQ7kNvwF7RXAD&_nc_oc=AdpHAf9dM2xW4p0yH6rNqt2uGxXCIP13IZClA5BngRuEV60mtgdpK-jXBb57T4s38FI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JS8KFtSpfkYtyoVUvoK_M-u0YKzK-jqgFwyfe5fRZ0w&oe=6A3EAE1E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5xTQzp7cgYQ7kNvwEUrutd&_nc_oc=AdodZnq8M5Orxa6pskqBn5sL9yVk_jctXv4mZLdaN7MTkhSPZYWQpGuNjD12Ro1kIKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YrAuE30Wckpr0aJ3dZneYFIZhEXJROxX8pDE5gsQCpg&oe=6A3E9822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeN9H4QZp5MQ7kNvwFG8UYf&_nc_oc=AdqJ2yTGr0XJFqYzIm-MjyIy6F2MFZoXuFK94C6-8D7ojjtJUF-EdyGEg8iiCovE4GU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7rOEV2HQHCuQxl_YUxalEc8wQNI6dbZ9F4XijIgTNFg&oe=6A3EA72D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS_7cwwQ2fcQ7kNvwHwAzAI&_nc_oc=Adp1fsJF_hTMjfQTeZcuAk5kamTH-BBO3rrcvA0ib4WQbGtlPcV_kOPbyKHLQoOatvQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I5HPaMJGXAeUA1lvH6ZRgs_cMvYwJMmflpTgM_OMQMQ&oe=6A3E9C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI_SWIVqBzkQ7kNvwGXVfi0&_nc_oc=AdrLSxCzDxij_7E0fp3guB7olstB4C0f78Pj3taTk_OU6mrcO4VC94eTZbjIR16O3Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fLGOQ_vnc_N2DPQZ-qALvWTvNbeM6ZpzWVQM8rzI7ZQ&oe=6A2966F2"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWXk8tk-6fkQ7kNvwF7p3t8&_nc_oc=AdoVfaIHNJyeY_PME8O-GJJqNzsoAIL8SDSGtjzvMCJX-DOEro0PNRx5nzAs8cc3ddc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O9VTogSB_ti3lCZrsOn0QVciCK_5BUjPV-QEfureN_A&oe=6A296015"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE3TNtYS7y8Q7kNvwH0_qhK&_nc_oc=AdoqRM1CJgMVYzCF3R3V-2S4oRSkpQ8kMjwsT3he6o59XWu2BcFgzQqmS54UEYPWxTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZMB-EzDVg7j5xiRcF8-Qf6jRDoVFhXmy83VOO318i9Q&oe=6A295DDE"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_qgOApIivcQ7kNvwGuLREg&_nc_oc=AdqCfnZshyE5oiLJQWvDb3WI7JQeSICB7OvwZEFZV6mr3_ZOf9iAngnSd_Uk1inY8X4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_feAVERIK94UHpm7bu_UCgJjdLo0-cv5kd64TedVT5w&oe=6A298022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZUDPzPYeqMQ7kNvwHJmK0W&_nc_oc=AdootzHu3KakEh0OyBSv8zGJ_8006BcmsxvnxFDKPVdbtT60JJ9XoLNLKFCz3GX5nbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ebihCSlu9U0orsI73cBTOCNtf76kN_9uZbhIeXrPGGA&oe=6A2956ED"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YVOX9ibDlwQ7kNvwEykquO&_nc_oc=Adq9Vfzo7KsZMkpDQelDRvvviQH3fHXxOYEmf0FP2NbTpOCExVGLf7F1wcQIR8dJ0So&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GCfy_TKx5tp-YcmLB4tvkaLxEjWkEwsg-zx52B5RQ2A&oe=6A298428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
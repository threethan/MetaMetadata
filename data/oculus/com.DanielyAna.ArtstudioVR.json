m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UIKnJSDk_oQ7kNvwGMP4eT&_nc_oc=Adrk4d-pHLmkMOi4jq2LjRXyN7bKLgtrjsj22ikdOyhXVm7xOTiqx69vn6Leu_1-cK0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1jThFDo60KqsCLuG_JJCxgV0Q-yboFCwudztmuYSjuQ&oe=6A943072"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKqKt6ePRY0Q7kNvwFM8-mT&_nc_oc=AdrVcwydK_b9s_qNLxYux6m1RDs9KM-ypAf1RrkVoac-DPPElGvHa2KgWMOgQnNK9Cg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEki_vUDSgD1FoWgSSRhNdcjRSVwN-ABVtvX4Gs73e4TQ&oe=6A942995"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG0mzkEYwywQ7kNvwFnXk9c&_nc_oc=Ado-S-RfqVBtCozBr9oNNKDuPIekB3ZPguf_FUAWp_fOpOWduLse0Vr-w_adrOi9yYE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkZEFkRMp9PFXWDTBGCH8IpqUXty1ZbJVXnhJAx6SGEg&oe=6A94275E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrXzUD6o2XgQ7kNvwHi8uS0&_nc_oc=Adqm6fm-LQjFXlRxLJBGN4lkzcZ-BwPbJDDJh8QHrOhYBPteeuFb74sJ0guZZuxlWms&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZvQIePFnsNCC1ZzNMqKNbauRaPAbGWSPaUs3R_2GyaA&oe=6A941162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbPttVpTd0YQ7kNvwH5lD2w&_nc_oc=AdqVQhNhjz5rNqRXUwGPqEjZHzyfJuHG95C67-DUqz2P9GB-p9bPeVjUZw_-JQvQxSU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcNuxlH-aispNtXRrNq8ZCvVJh4zoeEDcZ65efzmF5HA&oe=6A94206D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB-ce1UMrZMQ7kNvwEE8St3&_nc_oc=Adpr64a4ZBCbC114SELB3Fw0Tl-VAZlu178YVLrD4PycvdBP7gKAw3hJF5stCOp_G8c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM4DNkJDqkHVAyoEbSubDHbtKY-J-CXI7yBiEhHBQ3Ow&oe=6A941568"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
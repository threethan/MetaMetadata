m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxfpsi7WnqcQ7kNvwGTptFf&_nc_oc=AdqZ6zCnaizm8F4K2YHqCeuAfGhgxPnnEnQtuMMxFWRh0lR1ZUusp_adJbX4dbwZG3s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9Jkv8DD77JOZoK_3Xi-CiSzUHVokErMQezadQR9Xlnw&oe=6AE34A72"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7IzThpOQLkQ7kNvwHB-U4w&_nc_oc=AdpQo5LCJUwE9kAA4I5AK9q2QwE9s_vrL94nk9RvYsUkz71ErqkOuzyUCqCOTyCz0Jg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6kKB3B_w09z-n_hkM4I9GOa-wGsFoh7bwxTlXgl5Bew&oe=6AE34395"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a3LM3yLiVgQ7kNvwEC3CSg&_nc_oc=Ado-iWJIsDzW8x9QzvfgidzUN93wN9oVssXh1hs7RCu02XezDPJpqcCyv8yLcfoEN9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlKG2eVx60NUmDlTzCugP7KVSyZrLGtgSSP9CP2RuaGA&oe=6AE3415E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIa-kbbp8A0Q7kNvwH3Gf0G&_nc_oc=AdpJxSraqIBZv83fUXsORb6qqUdcqTtGJ11ojTasKQNuqdWX_okCHel5miKS1vPmseo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8pvCKIMgQjR8U7byQNzeA-whyCbBSifu6rI0xonQRVA&oe=6AE363A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eL0s__BGYIQ7kNvwE0z3nW&_nc_oc=Adq89NOndbcKDvU-qkGZPFg2wivklmsfrdNpx3kLda3J3Rx52ipKPNgzDQOBTUppvLM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP13hxum_bT-WVIbsXt5wWhH7vS3FtHn2ZYJ4aATIiIXA&oe=6AE33A6D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKoeZScFiaAQ7kNvwG0kfU7&_nc_oc=AdrrxAdNHa4pwERBXpqoXjH-Yze9xm434dZkUkmxVTqEiJPE3DLaJGYOLgqqMYG3DVA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMroldpmNvHQUPbQhTqW_14Cj1m1TE4Vd44-YC6aOCwjw&oe=6AE367A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
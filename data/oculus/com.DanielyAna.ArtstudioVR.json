m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU1ihoDNeCoQ7kNvwGq0GVI&_nc_oc=AdqdvR4xwdlgC-AO58iBQX8eQPUnMPRsCpiCHtCrGSSjEnOansXfu2P4l7Ij41WqC-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX3ylx0QGiV-GpBIQJK2mhcGO_93XFWUG6YXAMfHAxxg&oe=69C68672"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtBCW9gYnv0Q7kNvwGJMcoL&_nc_oc=AdocOpZCwEbcr5KwNegzB7YOFp3wsecFDGudlpprnehkUPYFEiMEdtWuGvcI0R0m8bc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGd8VWZbRmOInTiaV6C02gtE5zSao3NoSoq5PZC6eMug&oe=69C67F95"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_XSIxaOYRsQ7kNvwFNMN-H&_nc_oc=AdrGeccHqhI3DJRAsQq0OHu4NDTfKVJP4a7R1tyyMEAARjzmELqnmZSaSFlFL9Z1jzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLYe4g7G1YGIrdXWp_RslR8bxvdfUlt_is_H_4zQkxOQ&oe=69C67D5E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnNVtFTD6ooQ7kNvwGkkbhz&_nc_oc=AdplBrk_TtncbvUoyMDUj9IhMrewC8Eoo2tmViiwxHMqhSuga0gbrgRtPBk5zCzjx5s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt_xZdksJcHqf2x8v-WKz9LlQI1XfWn7AqpRMeRtTBcQ&oe=69C66762"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUhdCIetIYoQ7kNvwGLJUCg&_nc_oc=Adoo7vu-ETVLaD2WbzmHuLi3TPPGvc0XWa3R-0pb4v4mLhdtJXv4Ds2NXwd9mcW4e_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrR8e_OBt8OruVWs_n1XhuSu4RKm7tYmErtAnvRgOuPw&oe=69C6766D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8mOVuZ8Sp8Q7kNvwGzWeQv&_nc_oc=AdriUG2zxrdz-dL4dffCFRrrTNtjfm74fylJO9JVpOTwQM5y6g_ReF7XIsPlOP8HoSQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQBvyVYgzxOhMG_LCDKvM-64dC5g9yR2ZVwUyc3ZMulg&oe=69C66B68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
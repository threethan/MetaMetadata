m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4YnVBQBMH0Q7kNvwFtQC3S&_nc_oc=AdqPMHAJRDQk86ZlbjuzYZnSV_DHrmChMMlo-KOAbIs8Dj4lIkQhhYvAaM_5w-4JK5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJZp4H4qq7Uzky2YNvBomdTTGKoYPu51KqFmAi2FWwYQ&oe=6AF0B1B2"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3nHhMT9NcMQ7kNvwHmn-bi&_nc_oc=Adq-_RzKDnY8IDr5Z2HT2cgc0k2BHTO07zDmZqfJhiqmW6Nw2DH_kX1y6IrTh4CfQIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzJ47jJnjrERDEOBdORhA3JNQApg1_1GK9yHRFojsmtA&oe=6AF0AAD5"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=696bDt_uarcQ7kNvwHVR_W7&_nc_oc=AdpKkXZM2v_fqEsct6AN2-rSHLLwK_6ZGw60N6Cie3M4rLLtjzhPQATWTaqN6Qa2MU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_7DVAzp9CXwJtsbOZJ8zDmTXM5NIpEjFeXx9ATAQljw&oe=6AF0A89E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ku7FAqDQnEQ7kNvwGYdYWb&_nc_oc=AdreQp7YaIStBHuokjmR-rnp9hoT_0kG_Pkne5YfFwGNcEW4-MuWHJn4GdqhNXz51kk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNcjrWfju_ok_51ohgUGaXUeQPiBqvCXHjz1k63sJmww&oe=6AF092A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy1jp8EuB5EQ7kNvwEecUN1&_nc_oc=AdpvPNM3myoAynsRdQiUqn_htloZPleHjRNVoTC8D0YbMm2LZfoyXMcqo82d-RO86Kc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKRNaGUOiQIKHUu6crtxGADQZt2YTUok_pNr1VuaVzUA&oe=6AF0A1AD"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMb4U-COM20Q7kNvwG8snL6&_nc_oc=Adoh3aeqbSDGv6UieRqH5P-ox6kio91oa3YduYp2hr1YayzRtG6bG7tnT4Tncv2b2YI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO0j_Omqi_WHLYHoclXgW0kAtSaSKSu_8jOqtF-Et7ew&oe=6AF096A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
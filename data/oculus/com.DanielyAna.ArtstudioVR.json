m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9_1OPtWoHIQ7kNvwHAy_16&_nc_oc=AdpoD1Ygux6r9KAaEOksXxgeVMj1mA1GygBVtVKxM_gMHLqFU95t6Yupw-x8W1uDzA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTe6u7npxbv-z7frbpSRlpCE6ChlHcdiLdMmeHWR5ojw&oe=69D11272"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7JFepSvdskQ7kNvwEycwFw&_nc_oc=Adq8QpcK6o1RocfOygRzMxDqNqg5X2uGiDY-Ch5fzzFebfe8IbzZpGBxH9YI1KljXhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKRir-bMXRkB9OQywOMtGND4ko5xvWHgWkvnw0CAhJWQ&oe=69D10B95"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnKQPTfCMT8Q7kNvwEEVBGE&_nc_oc=AdptM67Eke-M907nsabnRCJnn-LCZA85MnF_juPPpYLdHcnlw6isvESRbINqT0c3ydc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTBNOv5FXjd7UDY_tX4sbwZ6jQNn3HBqBceGznfVpwNA&oe=69D1095E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAxFjsrIZW4Q7kNvwGgI0Ne&_nc_oc=AdoK78TeGP2DE8kMyq85yw_VahgFctgxBCeIdjMs5kfhOOh5IKkaf5v8WKV3WevwCF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxF2hsCFtrpUQpLsx64EFy4GGZNavsn-e4QdeN-OUGAKQ&oe=69D0F362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SskshYOXMbEQ7kNvwEVCsRR&_nc_oc=AdqH8Za_ZNfnQVUKcNQSaaCCYgZAROni2Fw_eCsnNuRbwZaRamkgqHFph1_01Ftsf-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx07QbhpNIQ_VJxKMxyhPcIyMowuHC4sZpjpcn5CdEhA&oe=69D1026D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMEsgYrKYPAQ7kNvwEqre3J&_nc_oc=AdqLREUFv8Jhz5eQll8mGpy_mjJoLpIKQsISntRaJVvZWLQu-RIoDQ_b0ztClw6mPqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhABCOrdg_lD91PNb-jJTLd0sNzikhKRHbrZFL1nnHOQ&oe=69D0F768"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
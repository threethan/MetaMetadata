m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N82IcY0dCjUQ7kNvwEjcTqk&_nc_oc=Ado2VVx6kX7kxLlYraWUYmZfg67hpac-EDMn_rrKsKGvNzhVox5oEwOPClxBX6jPwI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpdydDC13H0szuoqL9xHmLOJQ69yOaQLmCIGFWpXLQLQ&oe=6AC64972"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnvmRUlM45UQ7kNvwHxjNPD&_nc_oc=AdpycwHSyOI3MAazMTmuHvYpmx7b90HTa1t0YYGmB5lmNHhFzC7rIwNsYjDaXiOVVeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhafvSFX78ylKpUb9Vc4AiBfrDMvjvKsLnVocKYhe1Bg&oe=6AC64295"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQbFTuY1wD4Q7kNvwHduBBH&_nc_oc=Ado-BstX6KytaNjDa9Yjl9iC1LcjsEhQFAFEeP2prRXi-I2lB4dBzu0ALW3JL6BT2iY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhvUzHvTw1sv0SFi8nI3CXP6baozuSm3AAwCDfmLdJBQ&oe=6AC6405E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ntCnMjUtG8Q7kNvwGvS6j1&_nc_oc=Adp2-HHYc3HjTkasH3wah3_IjZMxZelzEze_FKRYeD9vW0P9WEVUWnVTdhPjfOvBufE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2f0olyZ_d7wQO1MQm-GV7D4D0vLVSBEcSPMRbrMRy-A&oe=6AC662A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxuJhaecYlsQ7kNvwF11M8-&_nc_oc=Ado4b5Fkc13fRFZl26mNuKAK-ECNxYVSZ03-kxuxiLjXEo6C7hOlxzBGBSIKQtj4Tbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYLlYdayGnnT7BvfrYrYk0GDKTN8cY1suak9fZwRvQxw&oe=6AC671AD"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INJ3uqc5-4AQ7kNvwH9J-4N&_nc_oc=AdrZUk_l8LC42_FQFuGE3Y6_VhF-ptBdAaNM8cbNP3enSZXUSzVJx4nqMpe_AzuxyS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq1GD-MCR5IyaPcx6SDLjZGmAQrfhLprEc71XNDWa4nw&oe=6AC666A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
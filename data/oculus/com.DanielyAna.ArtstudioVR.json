m/v/t64.5771-25/38974526_626939528747678_1951444406116916035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1WNN1_TA6YQ7kNvwEjDdTw&_nc_oc=Adpr__FGV1Lge3sWlnYhF6nOla9jduABD54t0jIs6Rxrv59SbM8rIWfDhOvChtPgLN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX_uNGD7XXvPjSQGK_WO9l1UVO95ny8S4ngQLvYL4wLQ&oe=6AE73EF2"}, {"file_name": "screenshots1.png", "id": "1201809423679574", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031342_1201809427012907_613672719983456052_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Eytoxq8kwQQ7kNvwFTLBpW&_nc_oc=AdoDLNqCK1IX_rEqA6djXHLyMcN8iEuuwo0Y2RsbI2oCQS751aSa9FjG1DqJKNTrmKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrxIyXx_MlNNyey9pCQ5wvKYbMnPEqrD-3P04XiX3z4Q&oe=6AE77055"}, {"file_name": "screenshots5.png", "id": "1024326568133913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001703_1024326571467246_4068819455123174492_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llN4PF4Xok4Q7kNvwEMckZx&_nc_oc=AdqeBN18Ak4rIWGZLUjjkXRDxw44TE6e3ANSX1wZ75t_cuzKOgPoPqgnq9pVQ20dGuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU7gb6nhCcnGHYNVS_eVW-oe_sbDj4IcZoSy-UL_nd6g&oe=6AE76E1E"}, {"file_name": "screenshots4.png", "id": "238604198343933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_238604201677266_6669049817509141523_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ8lpNfkxncQ7kNvwFarxn-&_nc_oc=AdqrBywXP9dDWwEnrXtlqoyuBWsWaREsWeYShvsBDiToAsDg0ZUs11kmAXmUj24ouvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd2Til469Jq6csrPsVYZd4NJ1heCHfi5h8hg4BaJAl8w&oe=6AE75822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "newCoverImageSafeAreaTemplateLandscape.png", "id": "1087912382012890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031368_1087912385346223_257836451752031115_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs2rRlLdI0cQ7kNvwGztpqo&_nc_oc=Adop-iLmf8qzONlHJArNloOJTkZphWLHgORDtdVGG_YKw-mfq5_YJlROWFhtM3SzoLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnUYuRVPXvtTvFFzI2t_-2yHlCChT_6_NxlhSKFJ_JbA&oe=6AE7672D"}, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings, and beautiful textures on your own 3D models. \n\n** The app is in development and currently in early access, get it with a discount price **\n\nHighlights!\n\n\u2022 Achieve different looks with a variety of tools that range in size, finish, and pressure.\n\u2022 Import and texturize your 3D models with natural painting tools.\n\u2022 Lifelike intuitive painting experience with a twist for the pros.\n\u2022 Save your art as a .PNG or a .JPG.\n\nNote: Some of these features will arrive in later updates. Leave us a comment saying what other features you would like to see!", "short_description": "Art Studio VR is an intuitive painting tool created for aspiring artists and visionary professionals. Create striking sketches, full-on paintings and beautiful textures on your own 3D models. "}, {"images": {"nodes": []}, "id": "643792223642414", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Studio VR", "keywords": [], "long_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D.\n\n** La aplicaci\u00f3n esta en desarrollo y actualmente est\u00e1 en early access. Obtenla a un precio de introducci\u00f3n **\n\n\u00a1Aspectos destacados!\n\n\u2022 Consigue diferentes resultados con nuestra variedad de herramientas que var\u00edan en tama\u00f1o, acabado y presi\u00f3n.\n\u2022 Importa y texturiza tus modelos 3D con herramientas de pintura.\n\u2022 Pinta de manera intuitiva y realista con un toque para los profesionales.\n\u2022 Exporta tu arte como .PNG o .JPG.|\n\nNota: Algunas de estas features a\u00fan se encuentran en desarrollo y llegar\u00e1n en una update futura.", "short_description": "Art Studio VR es una herramienta de pintura intuitiva creada para artistas aspirantes y visionarios profesionales. Crea incre\u00edbles bocetos , sorprendentes pinturas y hermosas texturas en tus propios modelos 3D."}]}, "developer_name": "Daniel Santalla & Ana Bolio", "developer_privacy_policy_url": "https://www.danielsantalla.com/artstudiovrprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Art Studio VR", "support_website_url": null, "website_url": "https://www.artstudiovr.xyz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY", "ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466384818311820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_197849565882636_2387493613685105804_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAPV4g9LYJcQ7kNvwEZLxyX&_nc_oc=AdoDBWyErG6MLKkBXEXcm3kx_vxV8O4vWwiY7xHlx7Dj7xPYoA8PCfEpejUP1nIKODw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDCuWxb0gf4lhvH4nmwlggaehxTTcYneo5xEuiM7ufbw&oe=6AE75C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
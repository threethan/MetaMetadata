0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZSvyFShgLcQ7kNvwHCyzVR&_nc_oc=AdrY7Qz4djPhzFr3z1MahNmt_LeUi7MYkwiCRVQcpF2-J-m_vUunAs705H1ZB7pKf1M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsYEtCHYigRx3ygKwg39inRv8jlDA5Y4USC-FzuNT4Ig&oe=6B0B42BD"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkk3ZRJeh9kQ7kNvwHLJyRo&_nc_oc=Adr7Mja_c_iaf69-gSYuNaR0YwJBkKlGpoe7mVEWKjdP19SDn6N--7q2tZdD0cyS2Zg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYhOGh7xYQcfmmPGF6V_n5q9XX4ZtH8UGdmwVgvLbyZg&oe=6B0B331C"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce6kCTWWu2YQ7kNvwH2GyQz&_nc_oc=AdqoYU9KNk4N95FQ-nWFjS5L83ldcFbkeTd9xhc-caywk5z_WonGKJxNEO3Leu5mfRo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOWcogHJn1v_9PT1hjt82pcb4OkQlNUcpz4KbYySZ6qQ&oe=6B0B1F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3JBFEdJZUQ7kNvwHy88kv&_nc_oc=AdptWelnU_PnW9ArqcwtB-c8Dqh74vuUjj6nEBsZaJtMgHqQNQnNzxo7-LnhQWFngbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq00DhheW8OidZiyHEeIoDxCZpOfMs9YFJ79ibLFdyRQ&oe=6B01CFFD"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-1nQcf5Px8Q7kNvwE3MzF6&_nc_oc=AdqScvzMh4lbOXzOOhImyNmNaO8a3hDcNfq6Pu0gPXn-meCXAi4N_uE1lKC0f3AEOuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7g_Lh4SLsVnzV6_1dFcZoP7hfPHs9-rZQImDtlnNO1Q&oe=6B01C05C"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jZvk6BtjXwQ7kNvwEM7_W_&_nc_oc=AdoyNPtC5D2kWzyIaCNIDpcNLtNk2xLlpNRfz3VYPG-1F6QkB0Dxtj25L4JucHd5v-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFH0SBy7cgpdXe9Jt98f9jWTRiTVldtiBAfwuQ8g_ygA&oe=6B01E50B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
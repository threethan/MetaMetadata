0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjJFpkpM_iYQ7kNvwHHFswA&_nc_oc=AdpvnCwmO-m_X96xo5x923ksZXQwWLDc3JE0LQh0x93miky0PYDB_IEvZN5TOMV5hJ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsK8AuYuRNZ18S6ylwM95WhGnwRI9DoSl_e37KPRiPYg&oe=6AFB387D"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INmj9HgTTbMQ7kNvwFs0oSt&_nc_oc=AdroSuFjbyFZd2ou16V4xcI4dhXY6UxLka1jSlfS_DZkWuLWJ2ToQkMlhiFKnrU7hdo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVhIOBQu-LC8amH1Td4Sbql_7n1fGNuTjUfclajki76Q&oe=6AFB28DC"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHPJywc_uu4Q7kNvwF2pcgu&_nc_oc=AdqqjstGWb14rvnnbCf7MNRr1fEv3mU5S6uAfgXPf4cQTYN50avZvegSCaW4itvEKPw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRWfYDvY9RzTgdmC1bTCiq_meC2TAKxDuBnhrz1626Nw&oe=6AFB154B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
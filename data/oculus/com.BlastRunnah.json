egy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1y62bDs1Sf9DXYfmzyQrIyPxLSv_9Qo-l_O1GFOiNqL4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "z4eu", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NZTEFjpLqjcUWGt6PLAB76_94JUoVeIm1A3L4OZtohU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9844921685632004"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9977305719060266", "version": "1.1.59"}, "id": "1286947586579220", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9830389543751885", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9977305
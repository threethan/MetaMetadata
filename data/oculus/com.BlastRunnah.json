0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIRrdVNQMgEQ7kNvwEUWYys&_nc_oc=AdpI8v4ZCI0nZ7N3iYekwrQPXXM-EhzpljUXEenmlnhH7zJqNeMJhx5O58_79CxveFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVmUGjpGIGhTgeArcWKuQ4f5RTM0PTK-THPCjH2W_n1Q&oe=6B05C47D"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PztTsA9qGDgQ7kNvwHSajm7&_nc_oc=AdoueviECcN3V3dBnaf4sZYRKJN7guXGLIsm_u6FIFHd3MoCoWrzHy77vyD5VA7ZrgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqgt05_9U4Fq3-sR-QEPKabe8XmxUUZS3Do1v0Nsil3g&oe=6B05B4DC"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HihCYgmKpxUQ7kNvwGhculh&_nc_oc=Adr8fU36bvLQvtVAiBQwn4vkz1Zel7CvWorOubhwn99XbW4k3W_eU_2sXPrG1eAnLNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeffAWVv7HIhDFxora9IqqGTPJ-BKERgp2PL3HQL6OfQ&oe=6B05A14B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
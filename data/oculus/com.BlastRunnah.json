0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56HldVAxhj4Q7kNvwEFsebJ&_nc_oc=AdqdZr-DxRIvHf9XJKhg0H0NWXHLCiqOY5e9ftZ2gRDEElZuYY7I4CCVFnVctd69RjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYYbSkq-JZvnFob75C36XplrAHyMlbW5ezls4-XCPY2A&oe=6B0C5BFD"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkk3ZRJeh9kQ7kNvwHmbOhN&_nc_oc=Adqs3HYy3_9Llp8sJrHU_6kPa3YD4cM9xoLIp9jVLlQ14mQVp5IBlKZz9YxPt8OzT0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuZwvzpHIOlBuHbACGvkyOvOCIlVQ8XsIZzhPo6B8QXw&oe=6B0C4C5C"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlGTNakkGi0Q7kNvwFl3DvF&_nc_oc=AdpznH03c3OHhu66NSobgzFeTfLRRP-tGR-srlL_Ai_nQTVj61vhaER8xNUN_hcnl6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx8xhrcG92FgKliOq7KWMCaV8y9cWfLFvdGAzIOaF_7g&oe=6B0C710B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
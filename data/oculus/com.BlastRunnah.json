0_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR3JBFEdJZUQ7kNvwGtDOJN&_nc_oc=AdqZTSXUrQA6Ifq_CuVEdR08sFj94q542lXMVnzvdWPFfa3_Y5G2R5-4P4uX1nC1o6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLAi6lCDsrTJkuAUoTghEqJBRyO4lrx3qd5-W3dbJO7w&oe=6B03217D"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-1nQcf5Px8Q7kNvwEwRtE2&_nc_oc=AdpmpmK7RyEC4kZM57RK7dk_811RTO0vRyyjnrhwq43Ja5uTVuQX__e2wKZMY4OqM2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScuiLt5gqwh1yGewBvYymRS-odicZtXEb-Nznk4wnNgg&oe=6B0311DC"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jZvk6BtjXwQ7kNvwEuZFcO&_nc_oc=AdrcDBTKNM4DwUWvn4c5keSTUwf4bPy9NF-6s-gvjn3-dJb2AkNuz1mh0v5CBzNUSmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4T1fMQ0s6T08Lgh73k70Z0CFm8zyVlbstPph9WWXwTA&oe=6B03368B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners dr
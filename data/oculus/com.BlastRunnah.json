d53NDEjt2KXgQW77w&oe=6B05C2D3"}, {"file_name": "3.png", "id": "1674843673899447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618910_1674843677232780_4138213223402064548_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIRrdVNQMgEQ7kNvwEUWYys&_nc_oc=AdpI8v4ZCI0nZ7N3iYekwrQPXXM-EhzpljUXEenmlnhH7zJqNeMJhx5O58_79CxveFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVmUGjpGIGhTgeArcWKuQ4f5RTM0PTK-THPCjH2W_n1Q&oe=6B05C47D"}, {"file_name": "4.png", "id": "856123770368936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_856123773702269_657648894617181612_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PztTsA9qGDgQ7kNvwHSajm7&_nc_oc=AdoueviECcN3V3dBnaf4sZYRKJN7guXGLIsm_u6FIFHd3MoCoWrzHy77vyD5VA7ZrgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqgt05_9U4Fq3-sR-QEPKabe8XmxUUZS3Do1v0Nsil3g&oe=6B05B4DC"}, {"file_name": "5.png", "id": "867347992570106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_867347999236772_6870565404783761817_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HihCYgmKpxUQ7kNvwGhculh&_nc_oc=Adr8fU36bvLQvtVAiBQwn4vkz1Zel7CvWorOubhwn99XbW4k3W_eU_2sXPrG1eAnLNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeffAWVv7HIhDFxora9IqqGTPJ-BKERgp2PL3HQL6OfQ&oe=6B05A14B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blast Runners", "keywords": [], "long_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.", "short_description": "Blast Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1y62bDs1Sf9DXYfmzyQrIyPxLSv_9Qo-l_O1GFOiNqL4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "z4eu", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NZTEFjpLqjcUWGt6PLAB76_94JUoVeIm1A3L4OZtohU/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9844921685632004"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9977305719060266", "version": "1.1.59"}, "id": "1286947586579220", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9830389543751885", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9977305
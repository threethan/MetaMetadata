Qe-KBgcppx-cUikhzPOzWiffKFwHDwktmbbop8WuH2C8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfHC2GUt0Q84jRb-OW-yillos9PanJvAtAn0kxIyaJEA&oe=6B085773"}, {"file_name": "meshup.png", "id": "1508928037909581", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827585_1508928041242914_7752601458656320913_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD-KEbZndnkQ7kNvwFELHku&_nc_oc=Adoo_SNCi4l2-eQ4t4BzAzM74QRh6au6MR1gagY-MhUBSOiVA6eS5IefvdD8kv9Ukok&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFZFDrqTItVYmMlmE2K1z87qgRoDC4lwEDoGZx2Nj6Yg&oe=6B085E1F"}, {"file_name": "objects.png", "id": "1880366796700358", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491824322_1880366806700357_8356420363446108696_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwBzUbOzy-UQ7kNvwG7LNLc&_nc_oc=Adr2p2fxQWF6bgDldqBRc6UzE8sexu28AI9GG0TpLwjLhYy7F0Fc_0Aurk9w2UkgoOU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpX_vEoENH-35BAHRqVXJ2Lg83q8VwLPYGrOIo2JcOOw&oe=6B08485D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blendimals", "keywords": ["animals", "kids", "creatures", "family", "mixing"], "long_description": "Welcome to Blendimals!\n\nStep into a magical forest and use your controllers to mix cute animals with everyday objects \u2014 and discover what adorable hybrid creatures appear!\n\nHow to Play:\nPick up an animal, mix it with an object, and see which unique hybrid creature is revealed. Simple to learn, endlessly surprising!\n\nFeatures:\n- Unique hybrid creatures** to discover and unlock\n- Beautiful VR forest environment** with a stunning night sky\n- Designed for kids** \u2014 simple, intuitive, and safe\n- No ads, no in-app purchases** \u2014 just pure fun\n- Supports Meta Quest controllers**\n\nPerfect for the Whole Family\nBlendimals is designed for children but enjoyed by the whole family. Simple enough for the youngest players, surprising enough to delight everyone.\n\n## A World Full of Surprises\nEvery combination reveals a new creature. What happens when you mix a bat with a cactus? Or a dragon with a cloud? Jump in and find out!", "short_description": "Mix cute animals with everyday objects and discover adorable hybrid creatures in a magical VR forest! Easy to pick up, impossible to put down. Perfect for the whole family!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blendimals.web.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "morokar", "support_website_url": null, "website_url": "https://blendimals.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26852350897737440"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1680964723326860"}]}, "baseline_offer": {"id": "1680964723326860"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778242740, "status": "PUBLISHED", "id": "1680964723326860"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29407656642206840", "version": "1.2.0"}, "id": "1684045679440377", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicatio
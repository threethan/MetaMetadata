le": "en_US", "screenshots": [{"file_name": "forest2.png", "id": "1771984620883424", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830888_1771984624216757_442449507614322152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBnImXoy7agQ7kNvwEYLieW&_nc_oc=Adp7V3qkzkkyECxm33RtcRY70zv50u7W10qmbkoEpKQEmx9WuFIW48Ou-yIMH7Hgo3c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg5yOgr453jgJHci6MSSFAFSDCEjWeVsLFpu8N0wepeA&oe=6AAD5934"}, {"file_name": "animals.png", "id": "1993168734600619", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_1993168737933952_8799568720541809860_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keRyepULswkQ7kNvwHGt_Rg&_nc_oc=Adp1zfoE_KflULAJQwl3XBc3y4PmxV4rE-2BbUU7u6qUFb1GU4pDa-5tmUl62SrvoiQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWFGP2tHuVTmWLCnzjznBiHjkjomssQvc-709g2O0INg&oe=6AAD5FF3"}, {"file_name": "meshup.png", "id": "1508928037909581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827585_1508928041242914_7752601458656320913_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K864vAHlPlAQ7kNvwEjsFB7&_nc_oc=AdpEX7TvuTnAUM8gWdhg7xTs-b2KBu3XmIxoENbQRE_kJbgEM2YLMjSAsNqKAmyRBM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjYFpJXA18UUvtAt7yhQOAcbB5lcHioe6bgAdi0QWB1A&oe=6AAD2E5F"}, {"file_name": "objects.png", "id": "1880366796700358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_1880366806700357_8356420363446108696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OxL_G-xAz8Q7kNvwFIBjLv&_nc_oc=Adq3rrgLsFI_-4ZuuaTsppf71ULmJQHTED7ir0PWXhoOP7583TkBzQmqf5e9oUw9Zps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1dj7f-G82Rn_ZyI_fpmPRfq-Np617LoqV9cKY0gKhlw&oe=6AAD50DD"}, {"file_name": "meshupDino.png", "id": "1003917586032031", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823351_1003917592698697_8714303270760114659_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlvslO1JRwYQ7kNvwGz5S1F&_nc_oc=Adql14fdk_qh58gjuHe0VOJhAD0Q75yxs6tblC4108HK1a0L8Uk-JtPBonjNhVdYR_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLesZL5gNix_eZHmGdPelKHByhUEnVnDB3VBzKDGeUdrg&oe=6AAD5F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blendimals", "keywords": ["animals", "kids", "family", "mixing", "dinosaurs"], "long_description": "Welcome to Blendimals!\n\nStep into a magical forest and use your controllers to mix cute animals with everyday objects \u2014 and discover what adorable hybrid creatures appear!\n\nHow to Play:\nPick up an animal, mix it with an object, and see which unique hybrid creature is revealed. Simple to learn, endlessly surprising!\n\nFeatures:\n\nUnique hybrid creatures to discover\nBeautiful VR forest environment with a stunning night sky\nDesigned for kids \u2014 simple, intuitive, and safe\nNo ads \u2014 just pure fun\nSupports Meta Quest controllers\n\n\ud83e\udd95 Dino Pack \u2014 Available Now!\nReplace all animals with dinosaurs! T-Rex, Triceratops, Stegosaurus, Pterodactyl, and Brontosaurus are waiting. Mix them with objects and discover 20 incredible dino hybrids. Available for $0.99 in the game.\n\nPerfect for the Whole Family\nBlendimals is designed for children but enjoyed by the whole family. Simple enough for the youngest players, surprising enough to delight everyone.\n\nA World Full of Surprises\nEvery combination reveals a new creature. What happens when you mix a T-Rex with a robot? Or a Pterodactyl with ice cream? Jump in and find out!", "short_description": "Mix cute animals with everyday objects and discover adorable hybrid creatures in a magical VR forest! Now with the Dino Pack \u2014 unleash the dinosaurs! Perfect for the whole family!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blendimals.web.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "morokar", "support_website_url": null, "website_url": "https://blendimals.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28141730928799424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619078_1645163846753832_3454559964970853976_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgGWYVS6bgsQ7kNvwHM3oJC&_nc_oc=AdrnWD_AxdWHNSo4GcqcC_HiXkqwleHKeDgQ4fqPj9Y_X2Sc_reLPZUVOADwba3w_Kw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh9qNaxk3jSEjqRhspI_CCjSdhsS2dtrucwyMiA0DrIQ&oe=6AAD5343"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blendimals", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1778242740, "lastRevision": {"nodes": [{"id": "26649159131389952", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26649159051389960", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1485194360014679"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover art portrait.png", "id": "3179525522237640", "image_type": "APP_IMG_COVER_PORTRAIT", 
08485D"}, {"file_name": "meshupDino.png", "id": "1003917586032031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823351_1003917592698697_8714303270760114659_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sohJpYhoi94Q7kNvwHSIKSu&_nc_oc=AdomUdUKC2o478_A9BbmASQ4NX19-38Pd46krbL0dRm0lUTY9TSwk_phTuppxOEMiuM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuf5Rwl7GpHpSNm38eOPhFWOV_KClJxI1f3ESqlVlhCQ&oe=6B085709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blendimals", "keywords": ["animals", "kids", "family", "mixing", "dinosaurs"], "long_description": "Welcome to Blendimals!\n\nStep into a magical forest and use your controllers to mix cute animals with everyday objects \u2014 and discover what adorable hybrid creatures appear!\n\nHow to Play:\nPick up an animal, mix it with an object, and see which unique hybrid creature is revealed. Simple to learn, endlessly surprising!\n\nFeatures:\n\nUnique hybrid creatures to discover\nBeautiful VR forest environment with a stunning night sky\nDesigned for kids \u2014 simple, intuitive, and safe\nNo ads \u2014 just pure fun\nSupports Meta Quest controllers\n\n\ud83e\udd95 Dino Pack \u2014 Available Now!\nReplace all animals with dinosaurs! T-Rex, Triceratops, Stegosaurus, Pterodactyl, and Brontosaurus are waiting. Mix them with objects and discover 20 incredible dino hybrids. Available for $0.99 in the game.\n\nPerfect for the Whole Family\nBlendimals is designed for children but enjoyed by the whole family. Simple enough for the youngest players, surprising enough to delight everyone.\n\nA World Full of Surprises\nEvery combination reveals a new creature. What happens when you mix a T-Rex with a robot? Or a Pterodactyl with ice cream? Jump in and find out!", "short_description": "Mix cute animals with everyday objects and discover adorable hybrid creatures in a magical VR forest! Now with the Dino Pack \u2014 unleash the dinosaurs! Perfect for the whole family!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blendimals.web.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "morokar", "support_website_url": null, "website_url": "https://blendimals.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28141730928799424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619078_1645163846753832_3454559964970853976_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyN7RaOJtsYQ7kNvwGGfjqA&_nc_oc=AdqCqGyp-av51SWlb7BQfKf3mx-G-L0NP5RO7miKEEwh9_4jvNn_3RqQPvTcozA_QQs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8K7HFpsV_PHknDzOlt8rjCoy7sJ76hI30s2GU1In2CA&oe=6B084AC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blendimals", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1778242740, "lastRevision": {"nodes": [{"id": "26649159131389952", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26649159051389960", "is_first_party": false, "enables_in_app_ads": f
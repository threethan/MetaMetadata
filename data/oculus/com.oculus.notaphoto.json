ed_image.png", "id": "3144369895594300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39lkHgQ2DbwQ7kNvwE6Sw8l&_nc_oc=AdrxLOMkvyH7kTxnMEBeZ2av3-6UqEkXVsf6hyqHDlUOg5BDNdS-ljxxfYbApuulvmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvRAYB3AflbPnP574bc3EMO1RxSAMra4Gz_paci9rfnA&oe=6AFC6D0B"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPx-7kR_140Q7kNvwFmbiy6&_nc_oc=AdoveTcvrZoYXNZFdSEcbayMf3m5BFsMIHXcwEsJTPja6LXr48pRZIqJeGReClYkwRM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrpQtpuUBkfp3RQ4dPd0YFoFYnmQKYGFdevWuQOUnbxQ&oe=6AFC9221"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_wwhsQSskwQ7kNvwHPd8R5&_nc_oc=AdqIRA5QslbemqpP4Ej16sM1SYTxw03w3diSwKU0G4SJ_oC0kaGDQ8kNfp7gCFVBpO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDRoFh3YbuocYoogIJgB8DaCfW_qOpnRm2sL8iSatSZQ&oe=6AFC69EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feilPkD4jVcQ7kNvwEsR9Kz&_nc_oc=Adr-W8lxoD186A91MBdJDQzOFUfco29UHwDG2nUw_lYsEAV6arUK-FiXaorqgqJTPJE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ91EG05Nq3HQx8xRvy7kieuIGoLnFpVYFx6M2Vqv_15g&oe=6AFC949A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category
ed_image.png", "id": "3144369895594300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqpwJX2IavQQ7kNvwFfN2-B&_nc_oc=Adod6hShKSrXPZK07H6wpm1Zs5fKj8wIR4CX91NfddFSt1u-91s5ygV5yy4bCvLg1c0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8hM_ZeQLmrJtSfELyniVdCV2W617Y2jVfjsA2ntRQaA&oe=6B106BCB"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVCd6-DNe3AQ7kNvwFBR8BK&_nc_oc=AdrjrmlSYEojzFcaQY6-17oQQHNz1G0U7ByDHQNmeCGXWIBFrevIYK4jyRmv_g5IKVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfv4HjLg_EPoomVvWNo2CaoIFQ7sNofK5wEmU_N_DiDw&oe=6B1058A1"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs4zskwuuMoQ7kNvwGKzI2K&_nc_oc=AdpmjSZf-haX5hKLlh_gYvpmVIMmfMDxZzNV1vp-WbPsJzUIKK-RDqlOnFcUq9Lf2ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9yAld9IjDcrLSLOhLJadCL4_6BQ_one5ZKNGtDt2IVg&oe=6B1068AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoC8XWcK8vcQ7kNvwHx-jVD&_nc_oc=AdocgjafuziOoOrgmrCNLv825rWrVH85QAaMEDsWa7nucc4bhfsyFDIIGrZWwwyl4DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuj9dc7YM4oG0V9h1OpW8WbeQyjMU-iPs_lHS_bYHujg&oe=6B105B1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category
DX9JP7CtRNglyZjI23-g5EXWizo6GZAEpvnmDKDyPWibOEcWTFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PHfpkylhqxoRunb3s3ewKFAEDubh-csh0Br0GbumqAg&oe=6A01F00B"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbGBo35gjVEQ7kNvwHx3cje&_nc_oc=Adpd6YnjDzRnT3sfzs378hTSm7qZWhtDv9u1izh2qhXaGxqqUfrHak4H-pzvYbmO8gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ya-m-5sZFBeDz8n2oNzoXOSCsrsrfyZ4LiZPhYUXHJg&oe=6A01DCE1"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P4vgcLNswcQ7kNvwG86T2-&_nc_oc=AdryrwoJV-Q2zSKI0_EfwAf6jj5QhbveU59DQM7-k1TCkHjNYRHOZjcQrHI0bdu0NY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dXWiziMIxMOoYXoIBPKbojdIBM9n-PgbJbVCcoKBzqA&oe=6A01ECEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0pESQLG2xsQ7kNvwH97uB0&_nc_oc=AdoQwNfnckDQhEf1brxCS_UxE10pZ0YNSTgXy0Z4ePZXZtRAlYBj1F94x1Kzje8o41I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ngOEpVY7vOtMwNX_BAhzqDRkpV149NVzc8Ul3S5d2oA&oe=6A01DF5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460530800, "lastRevision": {"nodes": [{"id": "1130351240343313", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "977682772321493", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false,
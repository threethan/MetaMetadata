dw3wtBlmDXaY1j03H9dPQYk_WJBJc9smTguGflkELw&oe=69A17DBE"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-r-hK6908gQ7kNvwG7C_th&_nc_oc=AdmUbWXLJFCYcUzvVq0hSrCAUHOUoBReYYDzJwJVdv_vP0HIzSOc5EPMEMe5rm61Yh4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsBt-08lTdxS-9VxItJ5XsS1WO6DgFln05UIylTAno7PQ&oe=69A17A4B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSY0M7p0WBoQ7kNvwGoULkh&_nc_oc=Admh_B1Nfly6CfVqApmFVphMccy-0mXuJvXZU686H9UabUjeBzN3NSmFhtj8LD0RzXY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv82h8Z8oWs3SvVr9ETrSqlyYJgLV4hrVICweshr8x8kA&oe=69A19F61"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHOfadj0chsQ7kNvwG9WuY9&_nc_oc=AdnX9v6ummfqWj2uZBDylagWEQm9V3BUDPHpcP_CSNHq63fpcZcYQ0pn1OoP789ctfc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsniWTFNr8OHCkzsIu5Sepho95nyHFEqx-WliWNc-ji_g&oe=69A1772F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "977682772321493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "686761641426550"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
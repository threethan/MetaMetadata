ed_image.png", "id": "3144369895594300", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXAhzz8Q3BwQ7kNvwGKS1cE&_nc_oc=AdoKBQJVFreroNvhd1vO1f__7R4-0WoqvCB_WoKw2Bg_Vkhfnz9uQPUFR0cbEJl-pgU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ATwqJubO_jFrYnIa0fNj1-VO62MuCbbJInMTMOh_zA&oe=6AFF100B"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=174nuIuUmyoQ7kNvwGYJGXS&_nc_oc=AdorzXg9rGf7DRy6jOJWDagcEjO3qxuGQ8-6li3YsVWqP9H_PO82pp_wsjfpebE2uWk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg83HFFVXxetoXr4HQorUEBPudSnOmN5ORyOQTnp7O_A&oe=6AFF3521"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09M3zconj40Q7kNvwFtBuT-&_nc_oc=AdoO3UGZ3Q0qhwnE8NSBHvkos7tGctQisyS_yX_RjBQy0Rn36ppb4HxAtGrkRp_tpcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR3JkELRWTddHn7PFPAr_CN3IaAu2KbNc9_4BfhuUsvA&oe=6AFF0CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eolcFjZSL9QQ7kNvwHYEvt7&_nc_oc=Adpjy14n59366LL2N70kDyrV43l_95a3F0aqtVBZ5EOMYkZnTGx9vRHW9Q59MCxGU7c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4breAvV0aXEQXBM7nMBbkMMYcBv6J5mhcf9RJkWPGOA&oe=6AFEFF5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category
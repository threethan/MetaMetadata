2-1.oculuscdn.com/v/t64.5771-25/12138834_1757166401179652_1834676902_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXxeuB8z_AwQ7kNvwEZDW7x&_nc_oc=AdpERueRVzVHcEh1Mb7H_TXusy8Dg-R_3UGhiYNE2tV9t90W-ZnT6xkq4P5Aj1pxH28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pBrDw6jSsUyIteBQ5FQwDkKOSa0JggoCfbArMtciCMA&oe=69FB5BFE"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnr3bsquIOcQ7kNvwECLuJ8&_nc_oc=AdqJ1aUhwI69rbN2QfpwS5KFh0gUxZa-zBy9_7pguIsv3lUFscdGCi9XFTTdMf6NxUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43-6p4H6sT7Nm6Jt-JWHuEV98jSRf7oQOMwDOaUUSv4A&oe=69FB588B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebQ-ZFkWD5AQ7kNvwFUoGrG&_nc_oc=AdqyAs_JJEFBYEbhXSvNQlWgEbcx-lFP6LbGN1elmCNJH1iZmshRK6pjWsvGiNtFpEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aZAcx3b5jpGo9OKa7Egj-r54ESVt9bz7SBJsX8QHPHw&oe=69FB4561"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X0Wjdjlv4wQ7kNvwFiaqxn&_nc_oc=AdopZtf9buQ-UBa_lARUApHrtouqw9TX0U45qE_FBbtqf_dJs9NmH7LliuH04iIcvMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gXWHtzl4ASoDnmeWj3kE42dXZ-AInzGYY_jG9uU8aFQ&oe=69FB556F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
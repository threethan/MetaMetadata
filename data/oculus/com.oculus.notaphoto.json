3-3.oculuscdn.com/v/t64.5771-25/12138834_1757166401179652_1834676902_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3JbcWPXB3sQ7kNvwFQkC_8&_nc_oc=Adp_Kkd5qRGm2PeKxBjOYiiWoMncKIJTbLymF-efUx4aE7Nq5xpn8sYozPev820AHtk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVs0VVa7DV3xadAHP4Cx1M7L0spBjqlHfPE0ypd5CDcQ&oe=6A4E6A7E"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLUznV44jPMQ7kNvwFiNyKj&_nc_oc=Adq6L2cVAozsxKO1fk7KEbat1u4yHKPuCT0NTv5TrkEce3gDrgttErFD-LAuDx7qsVs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvbVRHjbBSgsquLjhOVOSq83VutOsJM00OvvlD9sBiRQ&oe=6A4E670B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmFJEl6HRKMQ7kNvwEwjfKW&_nc_oc=Adr4swYtuSe_EJ9mH92ABqRJEmx9-6NGYQvKz6lvTU5F8MiFzeXIsN1zoCW4I-LySsY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKax33ZE9mVs9LNk_Is_JAVVMSTjwPGPg3MiQ-ue1erw&oe=6A4E53E1"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj5zxpxT3tMQ7kNvwF2Sl57&_nc_oc=AdqMHa-GpToEf7G7eRzc7ga4FTU_djGWebAJOoTAUQHC7snc9Pm7qqXEYiedS3a44Tc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwVN75BEBdYpdyLc7TAQUSOf02YcB6aC1_uqo8DbJ7Ig&oe=6A4E63EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
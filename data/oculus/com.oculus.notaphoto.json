HSTrdL9P8dzrGtMTRdxC7A1IF6yzdkgkk2pwXgUrai5W2m1LKp8qiRXU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZQSCxblE5OGUtZt_GLd8KpN7Qb6elcM5P0uF4sPSHpg&oe=6A7DA4CB"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReycUpqTrEAQ7kNvwH2dxlD&_nc_oc=Adp2L7K-l6ms9guNzePwwbkd3VFLFrlh3Lv937FzY7D4gsTsdJYpeJ4RU7hiGNUj42g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENFDhQnn31iYA1Op4njOKW92YH28ul6jYYobsR5bKb4g&oe=6A7DC9E1"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdLkeolyWm0Q7kNvwFD1x3l&_nc_oc=AdoziEbDNyUh8WG6lNV8f_fEkLRlDSXEVisl_6SCMHCteqtXKazsuUF3Csrb81tFewM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERzM2oDFVAetke4Zvhj4U2CNrvQMleYrjbMfW7F_UNZg&oe=6A7DA1AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jycu5EbOWIQ7kNvwFSEglr&_nc_oc=AdqgnBSw6Mll49ogUHBBWgvx6JBQncZZu0q3EBK3QQqjKbO5auZa26ShXSo-Ir-Vtts&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZTgq6Zi-H1siGtu53Ds62_ozTadgCbUfyG1TK3jOyeQ&oe=6A7DCC5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460530800, "lastRevision": {"nodes": [{"id": "1130351240343313", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "977682772321493", "is_first_party": false, "enables_in_app_ads": false, "is_concep
3-1.oculuscdn.com/v/t64.5771-25/12138834_1757166401179652_1834676902_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RulIY0lNdTwQ7kNvwFX9N_U&_nc_oc=AdrniiSJ5QGXSny5kn8UHHZRti2JNFPuXCk5KGbvK8mTJKGx2bYSPqDjEz5aYp3eDX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMOjKypPSrgPG3T1QRoq_Gra7aBEP8q3siyz3g2q1RTQ&oe=6AB53F7E"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_j71aliY1cQ7kNvwEtvThh&_nc_oc=Adq2Lz6j-vLU22lct_Mlfdf_7xJ0wpF_gP97LTmLpyVSjbblv9jRsjmSvl1PBLyfVWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEvu5lRzuTgTbWuWzEwS5SoTKTcQmVsAvB_NAwh45qsg&oe=6AB53C0B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHgzn4Hp0boQ7kNvwFy0UBL&_nc_oc=Adpac8QO3RhH13u-EociQU-DORawBVLLrqBT8tQ-ijrPbB_WNze17cqOgDTUdvH_Vb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKWD6fX6zleWjjx-naWg6isTEKS_qPR7jIAn4uIVl7fQ&oe=6AB528E1"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3l5OUwAwosQ7kNvwG1Q39P&_nc_oc=AdqtmkbbQRuy3dUkXdmtRtPA1yAGzG6eQ75AJHjjHeKz3oIGV-4TK9LmFOD0fh1zHLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWLOyMbPk6egMIYIPPT6NucPzDcnG90JyoQQ3kKqah3A&oe=6AB538EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
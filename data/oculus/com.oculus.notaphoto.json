-9VxItJ5XsS1WO6DgFln05UIylTAno7PQ&oe=69A17A4B"}, {"file_name": "migrated_image.png", "id": "2362415107383295", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSY0M7p0WBoQ7kNvwGoULkh&_nc_oc=Admh_B1Nfly6CfVqApmFVphMccy-0mXuJvXZU686H9UabUjeBzN3NSmFhtj8LD0RzXY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv82h8Z8oWs3SvVr9ETrSqlyYJgLV4hrVICweshr8x8kA&oe=69A19F61"}, {"file_name": "migrated_image.png", "id": "668669003899669", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHOfadj0chsQ7kNvwG9WuY9&_nc_oc=AdnX9v6ummfqWj2uZBDylagWEQm9V3BUDPHpcP_CSNHq63fpcZcYQ0pn1OoP789ctfc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsniWTFNr8OHCkzsIu5Sepho95nyHFEqx-WliWNc-ji_g&oe=69A1772F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. \nmore info on how this was achieved : http://aurelm.com/2013/12/15/fernweh-3d-parallax-photography-tutorial/", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://aurelm.com/fully-3d-interactive-photography/", "developer_terms_of_service_url": "http://aurelm.com/fully-3d-interactive-photography/", "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "228173919532150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12449013_209873299377563_1755831407_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6dWU7IkNqAQ7kNvwHCUsQ4&_nc_oc=Adliq-YEeOp1GAxfqeJDNAA72sfW04-zS2YeRyo2xmE9aclEdBrGushlG2ZiZZOi_gc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs8ksp0CNnsJzaTYtSMwY6eihFbc2fB4nOYh9rfgXCVlw&oe=69A1A1DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Window to the World", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460530800, "lastRevision": {"nodes": [{"id": "1130351240343313", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "977682772321493", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": 
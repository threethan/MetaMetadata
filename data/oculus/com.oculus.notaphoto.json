5-2.oculuscdn.com/v/t64.5771-25/12138834_1757166401179652_1834676902_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-KZ-MHnjP8Q7kNvwH3LZE2&_nc_oc=AdoxZ7pHeJ7snbv4_CSukVEiVOXwfBTkgYmsHNO2jCyZLQ_fb6DXmuA1djkGqVLV0Y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs0zO3q0E2XsMEsulRxRnHelPRuao-MydJFPFuFXaHag&oe=6AB933FE"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQf4_hbLeoQ7kNvwHvqs5X&_nc_oc=Adq7Kvvkp7MTVRvvvOKqGfNCXtEHvDLhubH2LpopCwBHn5evKP4sSz2_4YWLDRDVBTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJRgzAUm-x0yoB_WI6xkgKT7wZ5i-_ISvZ6VwqzYG-2g&oe=6AB9308B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBULtxKQsWsQ7kNvwGdq2f7&_nc_oc=AdqNkL8aA16bjh4cWJetYw6WShMMdVl4y0yXke4ru3D2cw7AjXKBqjxeYwDZNHYeiHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf-_KCe0mF4jJgDrbc_XQ_JOgc3JQMjtggP7wnW9clzA&oe=6AB91D61"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fR9PQqekfUQ7kNvwFWrYAu&_nc_oc=AdphcFe5361xAyjSwEYX-Uf6OtuCK0uGK-U1ya_0W8_k5xSFoN83duaBM806xmGE4cI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK65AmzhAP9S1ZEW0-UAHLSCsgHzmEUKrvu8c4HAvf6kQ&oe=6AB92D6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
6-1.oculuscdn.com/v/t64.5771-25/12138834_1757166401179652_1834676902_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxmF4tdJriQQ7kNvwH110zP&_nc_oc=AdrgX47px4Plr2m95diwJ0MBeR7vGmVFHbXLQasmY98aPWjGtWhhZRDIJ8b_LP3AoVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVGwsy6vCV7lG0Zq1-QS0X70rslWbxU5FszoDay3fZ8w&oe=6AE0C0FE"}, {"file_name": "migrated_image.png", "id": "213996426484298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_1248797961801243_1985556965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zObDqdT-64Q7kNvwHeWitP&_nc_oc=Adrs5XnQ657Zez1-iEW9GGMfQ3kSHtDlzayMKDYXNAqB8NhFfAHS3GssTuG8lC1MKus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz5PiTDS4P_THmWV76HuLS0ejsu2XOOA_bg1Eut1yUSw&oe=6AE0BD8B"}, {"file_name": "migrated_image.png", "id": "201456891084346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448837_1712346882351320_445814653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gvDWukZXOsQ7kNvwGJZnNS&_nc_oc=AdpB8o4_toH0lUKB8jPE_oB0VCZUYzluhEiYll9aD5lflM0dD8l0iO-_iu1W4LUw3Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjW88mFFduhNcRYdPAjFXYsPBapAAlzrwfHfWw_SWQ7A&oe=6AE0AA61"}, {"file_name": "migrated_image.png", "id": "3123820037630308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448842_1552150631781687_1259563216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTshWsiM3zUQ7kNvwH0odON&_nc_oc=AdqRfZHeEEfIOt23ED1vVje9k9ONVyAsle0GMsquEWJj3xAQsYq_gpuxq0KA6ojEf-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhO35Zyn5uKjyn5w1qZGV-jLwYNlfNrUEZ8uTj9rf1-A&oe=6AE0BA6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window to the World", "keywords": ["photography", "art", "landscape", "transmedia", "experimental"], "long_description": "As a photographer and VR enthusiast I have always dreamed about a way of expressing photography as close as possible to the actual moment of capture, about the moment when reality and photography converge. The first trial was a couple of years ago when I took some photos and made a short film based on the famous parallax techniques but with a twist. The twist was that everything was now in actual 3d and not just 2D layers. The next step was giving the viewer a bit of input and so came to be the online WebGL version. The final step was full immersion; VR was only the natural step forward. ", "short_description": "This is a photographic experiment. It represents what can be achieved using classical landscape photography and virtual reality as means of expression. "}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Aurel Manea", "support_website_url": null, "website_url": "http://aurelm.com/fully-3d-interactive-photography/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "867698490639077"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1076626689040384"}]}, "baseline_offer": {"id": "1076626689040384"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1460530800, "status": "PUBLISHED", "id": "1076626689040384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "686761641426550", "version": "1.0"}, "id": "1096403830401412", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
6zEMMPyDmlVYuwfHp7baaTQGG8ZKQWy8LTu90ZP6b2EgT16O8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSO7Jq69jbTyezfxEuNVtPOzgKpc6ECrAu6qTbtYJvp0A&oe=6B0DBBC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RacingX - Car Racing : Car Game", "keywords": ["car", "racing", "driving", "speed", "track"], "long_description": "Get behind the wheel in RacingX, an immersive VR car racing game built for Meta Quest. Experience the excitement of high-speed driving as you race powerful cars, challenge yourself on dynamic tracks, and push your driving skills to the limit.\n\nTake on exciting races, master sharp corners, control your speed, and find the perfect racing line as you compete for better results. Feel the intensity of car racing from the driver's seat with an immersive first-person VR experience designed to put you directly on the track.\n\nChoose your car, hit the starting line, and keep improving your performance as you take on challenging races. Whether you enjoy realistic driving games, arcade racing, or fast-paced VR experiences, RacingX puts you in control of the race.\n\nFeatures\n\u2022 Immersive VR car racing experience\n\u2022 First-person driving from the driver's seat\n\u2022 Multiple powerful racing cars\n\u2022 Exciting racing tracks and environments\n\u2022 High-speed competitive racing\n\u2022 Challenging corners and road layouts\n\u2022 Realistic driving and vehicle controls\n\u2022 Car selection and progression\n\u2022 Designed for Meta Quest VR\n\u2022 Race, improve your skills, and chase better results\n\nGet ready to start your engine, hit the track, and experience car racing in VR with RacingX.\n", "short_description": "Race powerful cars in RacingX, an immersive VR car racing game for Meta Quest. Compete on exciting tracks, push your speed, master challenging turns, and experience intense car racing from the driver\u2019s seat. Choose your car, hit the track, and enjoy a thrilling racing game built for VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://uafle.github.io/dwelve/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dwelve", "support_website_url": null, "website_url": "https://uafle.github.io/dwelve/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1405881459264977"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1110471455104355"}, {"status": "PUBLISHED", "id": "1644531697197541"}]}, "baseline_offer": {"id": "1644531697197541"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1110471455104355"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477753208744468", "version": "5.0.1"}, "id": "2289333091828252", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1405881452598311", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1477753208744468"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2289333091828252"}]}, "change_log": null, "created_date": 179329609
-driven world built for laughter and spontaneous fun. Perfect for friends, parties, or just goofing around in VR!"}]}, "developer_name": "Hexert Studios", "developer_privacy_policy_url": "https://sites.google.com/view/hexertstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Hexert Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/hexertstudios/landing?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25117490161248231"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1227327749452319"}]}, "baseline_offer": {"id": "1227327749452319"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765211880, "status": "PUBLISHED", "id": "1227327749452319"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25268084892855423", "version": "32"}, "id": "1369007284932442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25085761297754451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinar
586_5708625233643614214_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoPifBeylnQQ7kNvwFnNg1p&_nc_oc=Adpcm__sIgYuLfHS5fAvnxy_-J-umavDHbIH1u9rA446kOntZg6NjbyjgGnpjcPchyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0X7IYnnB8aBzP1m11i7QCUTzwUsP_TCPaHx8FXaXvNSg&oe=69F0C6F0"}, {"file_name": "Main_Custom..._18.11.2025_20-14-56 (1).png", "id": "1324517298977212", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_1324517302310545_7398399119652301146_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeFvSpqSH8kQ7kNvwGU8IAY&_nc_oc=AdqpaVH51tGZKuaRyvaf8Y8QQZsBNlBJ6-A4sMgb_R4ipKJ41RMwvDbjPWH-OTrE7mM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0Xuj3dMEBKMxRcnZFwvUyCclbjfr5WJBAy0nSggxfgVQ&oe=69F0A3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibble VR", "keywords": ["gorilla", "monkey", "Gibble", "VR"], "long_description": "Gibble is a fun and chaotic social VR hangout. Play mini-games explore interactive maps and hang out with friends. Swing on vines glide across ziplines or try tricky balance challenges. Every corner is full of surprises.\n\nExplore the forest map or just goof around with friends in VR. There are lots of activities to try and the game is always getting new updates. Whether you want to compete in challenges or just explore the world Gibble is a place for fun and laughter.\n\nConnect with friends play games and enjoy a playful VR world together.", "short_description": "Gibble is a chaotic social VR hangout where you can play fun mini-games, explore interactive maps, and hang out with friends. Swing on vines, zip across ziplines, or dive into wild challenges, all in a lively, physics-driven world built for laughter and spontaneous fun. Perfect for friends, parties, or just goofing around in VR!"}]}, "developer_name": "Hexert Studios", "developer_privacy_policy_url": "https://sites.google.com/view/hexertstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_
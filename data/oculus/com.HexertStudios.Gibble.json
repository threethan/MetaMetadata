es, zip across ziplines, or dive into wild challenges, all in a lively, physics-driven world built for laughter and spontaneous fun. Perfect for friends, parties, or just goofing around in VR!"}]}, "developer_name": "Hexert Studios", "developer_privacy_policy_url": "https://sites.google.com/view/hexertstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Hexert Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/hexertstudios/landing?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25234494592881120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823431_704566578933519_511273860351733000_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDZZwwv7BfYQ7kNvwEA-Chy&_nc_oc=AdopqlDcm_xW7siZo8gjU2ahUoV_E1qDFCekJXSa_tf31rRmr-fIaeSpg5FoCrkkKQM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxCWMWUeNwojt-Mm2haw5Txd0kr6DuPdiZjwHU-Z753A&oe=6AFB362A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gibble VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
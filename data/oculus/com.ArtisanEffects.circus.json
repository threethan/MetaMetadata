ailer_thumbnail": {"file_name": "Circus Freak Fitness Cover Art (2560 x 1440 px) (1).png", "id": "2334479143612630", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391883_2334479146945963_1177154726775482465_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f98m8S8-gbMQ7kNvwE_GyoK&_nc_oc=AdoM9TetlDCiQQX95kndmAizXkY0z6H658R0aIA3zP5DRmZ1q3Z2Wch5MDQI33eMjdY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLBTbaUke2MR-zEswozS8x173VH8pMLYb5WXaSSkvzGw&oe=6B086596"}, "display_name": "Circus Freak Fitness", "keywords": ["circus", "fitness"], "long_description": "\ud83c\udfaa Circus Freak Fitness \u2013 Step Into the Ring and Work Out Like a Performer! \ud83e\udd39\u200d\u2640\ufe0f\ud83d\udd25\n\nUnleash your inner acrobat in Circus Freak Fitness, a one-of-a-kind VR fitness experience where every workout feels like a show under the big top. Jump into a colorful world of circus-themed challenges designed to get your body moving and your heart pumping \u2014 all while having an absolute blast.\n\nGames include: Fire Juggling, Trampoline Jumping, Trapeze Swinging, and Tightwire Yoga.\n\nWhether you\u2019re looking to tone up, burn calories, or simply bring some fun into your fitness routine, Circus Freak Fitness transforms your workout into an immersive, circus-style performance. No clowning around \u2014 it\u2019s serious fun and serious fitness!\n\n\ud83c\udfad Train Like an Artist. Perform Like a Circus Freak.", "short_description": "\ud83c\udfaa Circus Freak Fitness \u2013 Step Into the Ring and Work Out Like a Performer! \ud83e\udd39\u200d\u2640\ufe0f\ud83d\udd25\n\nUnleash your inner acrobat in Circus Freak Fitness, a one-of-a-kind VR fitness experience where every workout feels like a show under the big top. Jump into a colorful world of circus-themed challenges designed to get your body moving and your heart pumping \u2014 all while having an absolute blast.\n\nGames include: Fire Juggling, Trampoline Jumping, Trapeze Swinging, and Tightwire Yoga!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-circus-fitness", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/circus-fitness", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9640456639342872"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1138662762380962"}, {"status": "PUBLISHED", "id": "983080380760077"}, {"status": "PUBLISHED", "id": "1258398212941568"}, {"status": "PUBLISHED", "id": "915251097922190"}, {"status": "PUBLISHED", "id": "1240495394683742"}, {"status": "PUBLISHED", "id": "2094168008101846"}, {"status": "PUBLISHED", "id": "1500805984561299"}, {"status": "PUBLISHED", "id": "1779312509459759"}, {"status": "PUBLISHED", "id": "701447702636296"}, {"status": "PUBLISHED", "id": "569482809548127"}, {"status": "CANCELLED", "id": "692630580283777"}, {"status": "CANCELLED", "id": "680513084886205"}, {"status": "PUBLISHED", "id": "999527188918810"}, {"status": "PENDING", "id": "1889207571889870"}]}, "baseline_offer": {"id": "999527188918810"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1138662762380962"}]}, "liveChannel": {"nodes": [{"latest_suppor
892_531658435346322_2498602236473869883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiRvAL9KyaUQ7kNvwHx71wv&_nc_oc=Adr2CpaQC1A3vcfPehReuE5OZUEzqTSOSoDjeQGT_SaMBmZCnpok3ODtM7YWStdRbQc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF-CAxpSbeHFcz5zviMJuw64R3XhuPadRAla4p-ndjdw&oe=6AC51C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "303126395346017", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001671_303126398679350_3989977132688586270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKQnZBz_juEQ7kNvwGjSv6O&_nc_oc=AdrJLevzhH4tWRre6DjGNewYb04CsmwY40R3a7phne97pW2gY5iUqNV_ucqdgX4sFg8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB8ErHhV6vglq0mjKnP5YNsnOOyI0R-NRhSimAw7H3hw&oe=6AC50EA7"}, "display_name": "Zen Monkeys", "keywords": [], "long_description": "The first rule of Zen is \"Do One Thing At A Time\".  Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang.  Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm.\n\nZen Monkeys is a simple straight forward experience in VR.  A peaceful place to chill, climb, and hang.\n\nZen-Monkeys features:\n\n- Unlimited Physics Based Zen Monkeys: Use as many as you'd like!\n\n- A completely climbable set of Monkey Bars to hang your Zen Monkeys.\n\n- Dual-wield squirt guns to shoot down the chains you've created.\n\nZen Monkeys is a fun and relaxing getaway from school, work, chores or anything.  So release your Zen!", "short_description": "The first rule of Zen is \"Do One Thing At A Time\".  Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang.  Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/zen-monkeys", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_websit
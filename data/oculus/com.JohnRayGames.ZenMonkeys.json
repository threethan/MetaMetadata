tps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974634_1330435127793681_5526657567824672466_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd9EWIp96K4Q7kNvwEh9FAA&_nc_oc=Adpudsf_3393tt9XEIQK_bs5MnCnMjQHA_28qiy5Pe2gkRD3cx7Z63xsun14FrzmiH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhwkjaqgoxzpUkY_X5svpz1C6-T0y_VqYBKgLe1GVOfQ&oe=6AE20532"}, {"file_name": "4a.png", "id": "932254084425165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984455_932254087758498_4069787340728150683_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqguom9-LXoQ7kNvwGDBxMm&_nc_oc=Adrhj4h8imIQ9PR0ZXdfOHZs8gUJqWNYvDTvAgJsB5Ua1KIoEwpbnlCg02J58BguuQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr70AM3UqkTg6Bfu4I5E7EUykT2LqcM7zoLsQXAEs28g&oe=6AE1EFD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zen 2560.png", "id": "1976302526134516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_1976302529467849_6152825660440571977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfEsTaQPxNYQ7kNvwGaI4su&_nc_oc=AdqGtz5tQdc5-JYOVUqQmBsFjTeDSP5kZBdfvZsV7yyXxOyYQFLrkCzdiyqo3tDZgR4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQC_jBb3ED-BbNGw8cs6B0eqYvGAWWt-dHdcEcbH8cFg&oe=6AE208B8"}, "display_name": "Zen Monkeys", "keywords": ["zen", "monkey", "puzzle", "relax", "arcade"], "long_description": "The first rule of Zen is \"Do One Thing At A Time\". Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang. Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm.\n\nZen Monkeys is a simple straight forward experience in VR. A peaceful place to chill, climb, and hang.\n\nZen-Monkeys features:\n\nUnlimited Physics Based Zen Monkeys: Use as many as you'd like!\n\nA completely climbable set of Monkey Bars to hang your Zen Monkeys.\n\nDual-wield squirt guns to shoot down the chains you've created.\n\nAbility To Change The Monkey's Color\n\nMusic Selection Added\n\nCurrent DLC:\n\nLocking Monkey FREE DLC\n\nNew Space Environment DLC\n\nNew Open World \"The Islands\" DLC\n\nNew Open World \"Zen City\" with \"Zen Run\" mini-game DLC\n\nNew Open World \"Zen Archery\" with mini-games DLC\n\nZen Monkeys is a fun and relaxing getaway from school, work, chores or anything. So release your Zen!", "short_description": "The first rule of Zen is \"Do One Thing At A Time\".  Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang.  Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/zen-monkeys", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26406761792301781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974729_496472076305721_20559090774420717_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvEfbca_LHQQ7kNvwEgV_mJ&_nc_oc=AdqyUVF8WlAI7hgL0Ko2ZspFKtJ7jAY97nbu_ZmzGSIYXszAdeeVhl47f2JKi9EbjRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmRcAPvc
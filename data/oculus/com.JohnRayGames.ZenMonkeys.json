6e7a0a&_nc_ohc=pCvhGmN6UnwQ7kNvwEAet1K&_nc_oc=AdmQPkLw1nzf-p0Sm-nq3GZF7nuKCtPThV0oWOc9da09cUbov1iiUmA9iDssJYLiiiU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfudHTHDWdTVSm0rdga5ARwgpbODvAwHLwRkt3g-GWr-tQ&oe=69A1A8B2"}, {"file_name": "4a.png", "id": "932254084425165", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984455_932254087758498_4069787340728150683_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSagG3G8s8EQ7kNvwFI0u_A&_nc_oc=AdlFvYNHUitLIIguG8-U-dL2kqRDS1rPrrCjX43rJ2kcHbj45xElM3fOmCK8aqhFDuo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuvclSPO1Ws6bxdBoVPW7Y80xrcYd1a4CQZqydsxsX7Og&oe=69A19354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zen 2560.png", "id": "1976302526134516", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974518_1976302529467849_6152825660440571977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYnN_8lmy9AQ7kNvwGtFxTq&_nc_oc=AdkeXyIg_GLQHQuhY13yVSqNYBSnpboJtH7kWPZlpzsRNkUO-WoPLrybJO4QGbBMf18&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afstd4_rdV51LbGr4f4CkF_Xvgu3Bsbkf4xeI0WAiSjv1g&oe=69A1AC38"}, "display_name": "Zen Monkeys", "keywords": ["zen", "monkey", "puzzle", "relax", "arcade"], "long_description": "The first rule of Zen is \"Do One Thing At A Time\". Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang. Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm.\n\nZen Monkeys is a simple straight forward experience in VR. A peaceful place to chill, climb, and hang.\n\nZen-Monkeys features:\n\nUnlimited Physics Based Zen Monkeys: Use as many as you'd like!\n\nA completely climbable set of Monkey Bars to hang your Zen Monkeys.\n\nDual-wield squirt guns to shoot down the chains you've created.\n\nAbility To Change The Monkey's Color\n\nMusic Selection Added\n\nCurrent DLC:\n\nLocking Monkey FREE DLC\n\nNew Space Environment DLC\n\nNew Open World \"The Islands\" DLC\n\nNew Open World \"Zen City\" with \"Zen Run\" mini-game DLC\n\nNew Open World \"Zen Archery\" with mini-games DLC\n\nZen Monkeys is a fun and relaxing getaway from school, work, chores or anything. So release your Zen!", "short_description": "The first rule of Zen is \"Do One Thing At A Time\".  Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang.  Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/zen-monkeys", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26406761792301781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974729_496472076305721_20559090774420717_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoT1-gxV86sQ7kNvwEeEtrh&_nc_oc=Adm_kBU2SRBiP8jAOEMXAiTFu6Ds9ANHPHLaS3D3OeQkAaoR2mIaEqlCD6auNZfwc6U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsw1i5ojwIv-Rt4tF78X3htwIgDJyf8mJcEjjTiP6cDCg&oe=69A19C97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Monkeys", "platform": "ANDROID_6DOF", "
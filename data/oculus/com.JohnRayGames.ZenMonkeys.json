6e7a0a&_nc_ohc=O2e3rl0JITQQ7kNvwG7KWcu&_nc_oc=AdnH1vJPbSFR6VKi97aNk4gfOsc1aWgrdBm9L_HZ6b06lJjNovmh2Ac0nEKhSOrH3IM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvAOm_C8nSRJ2o5CO0rdfdQaXdc1I-YXsrUOysI9jCviA&oe=69A59D32"}, {"file_name": "4a.png", "id": "932254084425165", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984455_932254087758498_4069787340728150683_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M54ud4SoEVsQ7kNvwFFOyrx&_nc_oc=AdnT08fdWtL35s2W_FYjBgZLi5VWzoXBlIiSkYy_S1KY2zBG2Vou9v2FeMHfY4toPdo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvW9-BHI0_2ej2XjNZ00r-OqNuqstkS1AGBWw31IpOfuw&oe=69A587D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zen 2560.png", "id": "1976302526134516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974518_1976302529467849_6152825660440571977_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HefKh436vFgQ7kNvwH-4UVy&_nc_oc=AdkAlNQcg7ghrmz5bQ3XQNsZ1RxuPBofrzM0RsE3_aSZoi9pjLk54VUvhmKGNH-jBjc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv4n9J_vrAW_egeTRbNQMTc13hbin0MyFLZLfY0zjMYOA&oe=69A5A0B8"}, "display_name": "Zen Monkeys", "keywords": ["zen", "monkey", "puzzle", "relax", "arcade"], "long_description": "The first rule of Zen is \"Do One Thing At A Time\". Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang. Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm.\n\nZen Monkeys is a simple straight forward experience in VR. A peaceful place to chill, climb, and hang.\n\nZen-Monkeys features:\n\nUnlimited Physics Based Zen Monkeys: Use as many as you'd like!\n\nA completely climbable set of Monkey Bars to hang your Zen Monkeys.\n\nDual-wield squirt guns to shoot down the chains you've created.\n\nAbility To Change The Monkey's Color\n\nMusic Selection Added\n\nCurrent DLC:\n\nLocking Monkey FREE DLC\n\nNew Space Environment DLC\n\nNew Open World \"The Islands\" DLC\n\nNew Open World \"Zen City\" with \"Zen Run\" mini-game DLC\n\nNew Open World \"Zen Archery\" with mini-games DLC\n\nZen Monkeys is a fun and relaxing getaway from school, work, chores or anything. So release your Zen!", "short_description": "The first rule of Zen is \"Do One Thing At A Time\".  Zen Monkeys is a Zen-like playground to quiet your mind, relax, and hang.  Build chains of Zen Monkeys in a peaceful and serene environment that is fun and calm."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/zen-monkeys", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26406761792301781"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974729_496472076305721_20559090774420717_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prEgvh2rC5EQ7kNvwFsRW5P&_nc_oc=Adl78ZLkhohKES2wNXDSEpIDXlSNflLBwn5r5zmq6fkZT7HoyklstiCtZZEj-Y44yqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftffGhRsj00AkoJK3bq8c7_Z4IFiSRhEIzw-vDVTE54LQ&oe=69A59117"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Monkeys", "platform": "ANDROID_6DOF", "
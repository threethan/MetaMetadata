au13GuBTCBUJ9rQnA32t_1gSNS7kX0zQ1-HA6jn29Fxsguxxf1aE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb5XbsGp8DeGuTpmp6LEcH5mEuUqp3OjqPD57KNhE2FA&oe=6AF5D57A"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajqCHuZEGFwQ7kNvwFtaRzb&_nc_oc=AdoCcOqSrKKVsrrYV4EpPKKvaysxvqsdSYc-heca5dj-2nAVunDUdFOmdE0OyJhj0qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRknGHvJKG_It1mqDep_cCn0D2d1q_pxV1g2ub6ZVDFDQ&oe=6AF5E108"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIWU7tHHJzsQ7kNvwGirboo&_nc_oc=AdpWCME_v8fUBqM_dnAsZW2xEK0FPXooSeh_00bNvh6frJyhtMJc6RDKL-vRbs2DDSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi4Z5EKSnnFtNQ_e6Mi3e14bCvnLDaPYW_P0ox9bdMUg&oe=6AF5C7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzQBexXJqIUQ7kNvwGjNcmi&_nc_oc=AdqPmYs7Rfn37MMA-AHCclhdIgAWFCgCT0CmYhdWewQhg_aBxvQvoXoyKLYyXWpuy6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY2VYcs5eF8sQdJ2r7OYIoVuD6TJNVPOf9AW8b66DjAQ&oe=6AF5EAA5"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "40969238846008160"}, {"status": "PUBLISHED", "id": "2186275438606173"}, {"status": "PUBLISHED", "id": "1325457832485756"}, {"status": "PUBLISHED", "id": "2859013591105136"}, {"status": "PUB
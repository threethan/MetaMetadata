.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7ylkB8EzhcQ7kNvwHqc-qd&_nc_oc=AdpseCHgKF1WK1dRcKHvlzDgIux1mH4f-PNr_LVp-GDTantaNfsrSH2HuWJYWJ1BTCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Upjn5u_RItMk1BBpnczXKDzbjaTpo_Bp3ZmwTwHl86Q&oe=69EA2991"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfn5i-QVa_cQ7kNvwEYWAzD&_nc_oc=AdqGLwDzreMcM7_RED4ogdHLQh5JWxf1rYTK0MxGnHi-KeWPpGVZcxmB-_oJ4Jgy-io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0poypTB5XkIZVi4xDPTGUc9DoKS-LO7VDTmBU8pCpg1g&oe=69EA30F7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJSpsE5CkZEQ7kNvwHQGaOd&_nc_oc=AdrnYdz6iSgFJqsWPTC6kjMZ0r_X1aI2l2BHXliAmDKx2P9Tx-1ASgzm-ZDr32lUcas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x5lwJ8Zs7Fd6CpPUDD5Ee6Xctffof1qX_AF6Q5uHitA&oe=69EA2604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbEhpej2Ug4Q7kNvwHS-4jC&_nc_oc=AdqwaCucFnv1exfwiYozbWp9fwhu1LOxKgEGRfxVsx3lFz459wcDju2DBEq1LNg5uig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EHxvaMQWegeKfXgt2gmvXYOlMclNyk7_1gcucTl2nVg&oe=69EA0DD6"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "**Become part of an elite special forces unit in Tactical Assault VR!**\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**7 Non-Linear, Asymmetrical Missions & 2 Wave Shooter Experiences**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Hostile Surrendering**\n\n{999770658801096}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, High-Value Target (HVT) Eliminations, Mini Games, Room Randomizer Killhouse\n{1946208202559962}\n\n**40+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
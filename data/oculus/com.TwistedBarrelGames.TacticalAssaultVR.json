Yamop6jgJrjajxUvpmT0xJBppy9S2zwouJqQZYDaAZY6dVvy7e60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYLVsjIm45KUqcus69Tq2D-g6L6T5QdcPXQbuAeD7wCw&oe=6B105B5F"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWVvqpudnJsQ7kNvwHhHf_m&_nc_oc=AdqzavSc5pVK15YerCMH_NqDEaLKSagaYYTVN_EwBvyyepcXvuXIjl_3ExdMPFL0Jq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYs4hhx_elsCoTRQf14afDdDvgUYLb4N0CmZANI7JsQQ&oe=6B106051"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MqiLowlcwgQ7kNvwEZqFKe&_nc_oc=AdoCJP8ms8IIRHkHHoSiY4P7aQDBu39-hZxaFPEsItiwhzq4JMp8dabp1bhjB-we2F0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcmnSrzmLJW1YkFECsRMIc0r8nAGJsLXMjp-2d9G8c-w&oe=6B1067B7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV5hvmujcaoQ7kNvwHHtZeO&_nc_oc=Adr_MPgZpwzRn5YAg_sYUM7bO-jBJXXWoCTeoPqagNTH4t0ynJtuJpVL42Qa40IC2Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnax87ifIRbnNN8W4HBbp126r2BCXdW71POToXTIiqRQ&oe=6B105CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vySmRdG4XUUQ7kNvwFvoz3-&_nc_oc=Adpu69jaKN6hNcA2kxCfXCCDhkgPsDEwZUuqqoVsxZUkqvyOTxgVaJb2bMJCMmIs7QM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXoxgGqjoVGY831pDkpyf9Sxze1Tl7qKYqnRJhAmKwvHA&oe=6B104496"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
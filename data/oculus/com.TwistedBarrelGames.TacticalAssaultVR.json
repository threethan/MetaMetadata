v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYeTIWok9CIQ7kNvwHMn2Up&_nc_oc=AdqItVtN3CM9omCX4IlEKCiWr-cfsmFP8RqAAG4dvH_wOni8S2C_QCODYqs-KbV671w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eiZ9daqWlXOYoAolZXU8YY2OHSme423GmJ3vVDIIAAw&oe=6A0C7091"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CZo1jCwEQkQ7kNvwGSfwRk&_nc_oc=AdpZIz_eD4YZkId8Y1aS4RtJVH-ucsqcpw-ySWQlkPKOQHjD-0Jo8RAox1iM6PFbqL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y2iEL4T9MgXtko3F5JajR8xMmOS0cAGBY92tf2BfGXA&oe=6A0C77F7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otXv7EmkWogQ7kNvwHYlsZ8&_nc_oc=Adr6IGr38TymT9GYfCcGNI3seylzqu6hExdLondUM4Dp_QGnW9-2kr3F-HtaDTI9Vgg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m2t3yTtSlhkjKoONTkSp_6KQxk7YWlq-4sEdxuCxkLg&oe=6A0C6D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RcCNEzhDEMQ7kNvwHYBPGO&_nc_oc=AdqqQfFCv4d2u5UXLEY246qRG1LWRbcIvbfsjaRa2TzDROe2sDQG5U4eHU060KmO2xc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EZ9qlCGR8vdnRcmFg0ypKIJrx1pC9L4ZF_PP07O9vtw&oe=6A0C54D6"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "i
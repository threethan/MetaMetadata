05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkJFnlhkhCoQ7kNvwGnIDX5&_nc_oc=AdqASmnUbIRzDS0EJqaB-d9zqvsJSe7wOMfN42EhoGIQ9BFuvaRkodnxw-E3rHRETiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JwIUhMahfp1p-tIWanMk96qfEQKQloCnXvS1isWzA3w&oe=6A43CF91"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYCd-4sdDL0Q7kNvwGDZQ5b&_nc_oc=AdpvF4PYp2WGluuEcvTxZhJe7s6Kw2Lk6TmPsyQ1qyyqAhVXbI4HFrBR_lLmaUDoIuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bFxNQsPNAmCxSOcqq0cVUMC_O6GnwOHU9KnVvx04OUg&oe=6A43D6F7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaYbMD9DBFIQ7kNvwGKrVBp&_nc_oc=Ado0VHA4s7EEHU6SDPHg6yBPSFWYJ8eyfswBIh0EKkdUUGwYYFL0Lmy5_w0ESuIEI1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mteo9la_Au5EBWNF8UwFv2g117oVx9ej3CUOVjBQ8rg&oe=6A43CC04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjaFt0_sgSAQ7kNvwHVQWT9&_nc_oc=AdrcPzbZe9TON9z4wNxDr3GCKNoBViiI5V0dMrHzc6-YlnnFnxmPNV25GNJ5Ljgp92A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YzG5PLiy0Uksdkt04SCGCO7uZW0h2dCpy_wXe8GWl2w&oe=6A43B3D6"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_
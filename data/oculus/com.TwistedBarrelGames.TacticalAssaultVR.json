.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GEduMzUqMgQ7kNvwEbWFkK&_nc_oc=AdqweBVlw9i71tA7zR8SYFsbq7sQUHEjU6QccKqbydafLNBVcl963OkWQ5AP2TjWsVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycraXVKEci6EeCTHeXsSuTFJeXZM1cjt2DyFRW0ikMgg&oe=69C3EE11"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQE664WwtygQ7kNvwEYbHYI&_nc_oc=AdqYKbbdghoYzUVEtkKtYLwhE-D0W87h7J_LBwuWVd9AGwmAB56XtbzjK3_qaN0A9WE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx8Ux9kmnj8jeu5JqXKHX0rCCnN7aafbOzmAEd8ZhSOg&oe=69C3BD37"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JFVxgSmsqEQ7kNvwE-f2SZ&_nc_oc=AdoP5w1PEExcMeY5V8x5Pxv3fGssfqR1yd4vtaMyoHtkB5rQhM3uRYc5zK6yJJcXSMk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE6_-EPx50nHZpUbYF2hn78Q01anB4eJFYpZmmD13y8w&oe=69C3EA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcpuX1MUFrIQ7kNvwE1DJz0&_nc_oc=Adr0IppWFG4PMRrfkJb-wYTm0nJpJ0JpeFg23IillLGITNHBT_VXVffzPrRqu5_Jix8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzRP_c_PIL24aBKi4RjN6Cgwyolrehb4GZ65tlFR3LRA&oe=69C3D256"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "**Become part of an elite special forces unit in Tactical Assault VR!**\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**7 Non-Linear, Asymmetrical Missions & 2 Wave Shooter Experiences**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Hostile Surrendering**\n\n{999770658801096}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, High-Value Target (HVT) Eliminations, Mini Games, Room Randomizer Killhouse\n{1946208202559962}\n\n**40+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "inter
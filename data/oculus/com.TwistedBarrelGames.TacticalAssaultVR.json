_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPHwUA1hgu8Q7kNvwGYI9cj&_nc_oc=AdqKAzXdBtLImssAxtvjhoG3biZABpdZtRFffE3JJLdCHBw9kkfjZPAwDm-BqP0Xq54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af114VmuvO9PeWtkeMfnrJE0giNzo_9wKDECcq3-E8RxKQ&oe=69F21291"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uX7qBDEy2S0Q7kNvwHrsTPM&_nc_oc=AdpOnWaKQFcwTsfY-sKutaR7luldZ3bsQvKWpjxmqQ_wlUdxMICxLi1R22ZRjzxvupE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Fi6NzbHs82p-4XxI8ZCTOf1oKC0gNiWg1M6PU0SCxlg&oe=69F219F7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bW3yN23lCEQ7kNvwGVz2kO&_nc_oc=Adq01XTmemEu8PUIdBizv75zh4Yc6KZ-V7NyVFrRSwmw9t6hi3ryJ26gwO86saOSB2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af18XM81yyobtakqkuUfdXqofZ6UBAcy0fD4t-8jIK2olw&oe=69F20F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGlVZG_SP0kQ7kNvwFBTWX3&_nc_oc=Adr-YRgE8Nc6Pv6f4Mpf1m74jAAGZ75TZi5VD7x-kH8ojqXraRU174brMSoiyhE3eU0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vpm3q649QybT2PC_Fg8xA2CqaQKS2rx-5kWiQtd5ULQ&oe=69F1F6D6"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "**Become part of an elite special forces unit in Tactical Assault VR!**\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**7 Non-Linear, Asymmetrical Missions & 2 Wave Shooter Experiences**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Hostile Surrendering**\n\n{999770658801096}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, High-Value Target (HVT) Eliminations, Mini Games, Room Randomizer Killhouse\n{1946208202559962}\n\n**40+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
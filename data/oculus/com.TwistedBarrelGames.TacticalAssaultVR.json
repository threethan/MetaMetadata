05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uWBTmRTZW0Q7kNvwGFJzt9&_nc_oc=AdpHa3QQETXm2k1_5yYN13oAejMhvVAPAD-b4Hi6FwTlKXRWrgSwlxRuF6cZaf0HNxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6wrLJBsthLIV72T7I7Rw56u9-XVAghxV1LTzCeie0dg&oe=6A3D3811"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYMZdRMWq2gQ7kNvwEyVWee&_nc_oc=AdoTn2M6fcj84KGxPJhU0kzqMZ68PyPnzj8GqzXlGPhgASfdO_On3QElEYdythoACPs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tPOwLfrVwIuHuRujK4Ii4WsxxntTB0j0l8_bBvij8xQ&oe=6A3D3F77"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF46LaEAeuUQ7kNvwG6dL0J&_nc_oc=AdqR5OVoxWAmtUrnSod_vSEQuzWHcCX0VnDcn_hYmy6EJa24VcCpklj4wwKMlEgCXCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cPyH_TmHtv8cWNKfKAQarmHKhfYV3Jp031b5LP3sOog&oe=6A3D3484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1ixpPpEFvQQ7kNvwH3jb-m&_nc_oc=AdqMfxZI8yHJSaCNC7oMrC2vA-AYOOoHiw4-xa9hH6j4mjv_xkd2UOtCi5Jvzj0ErO4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97s8DVFrPqdc-TK_OT-MPxra4uGYEjSVnQRMa13W2kuQ&oe=6A3D5496"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\n\u2022 Habie147 - \u2018Tactical Assault Is One Of The Best Hardcore Shooters I\u2019ve Played\u2019\n\n\u2022 Gamertag VR - \u2018The Best Tactical VR FPS On Quest\u2019\n\n\u2022 Controlled Pairs - \u2018The Best CQB Game I've Ever Played\u2019\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_
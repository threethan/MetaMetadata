=6A1851B5"}, {"file_name": "04.png", "id": "1055226238425444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1055226241758777_1831115996652299582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkm9ft6JscwQ7kNvwFKXK91&_nc_oc=Ado1Ps-6IUDe10UrO40ZyQ3KQQQjErOD3XsUv3eCI4aYAU8UVlKn8SmiS9chepDx2w8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F8AwpYIi72G0pBfMuC00AGM0G7aad2BKYVf7j_eIyww&oe=6A18597A"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd496MHN3UgQ7kNvwGSw8eG&_nc_oc=Ador4qeVVOw_SRgMdr7tLzveSBR3xlE5p1Stg6slz5gesE5HHlQO-IccQo2CtN4Qm28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rdb5MhrNVisa_8qd6mv32Qb5jJqHxznsPcQ77B_JTRg&oe=6A186508"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDMDukZEg40Q7kNvwHjzjhL&_nc_oc=AdrQdXrY9MgUKlc6FS5RItZOxxxVly_ayoYM3LHV4ldDprNsA9_EnP1xGgM7BNGWP-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fQfuWlemLerEFGLn-3DCCKlAz6hnML8dtsOn-E7phjA&oe=6A184BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhsnU73p3GsQ7kNvwEbWKqm&_nc_oc=AdoNt7J2hWPlRbYI6H1SRUAPfkMBgKhFBVAd3LxxBwnqlJmFprR6JEfzmn6kGGzj2eU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RYb3fVZOA9ADvgmh6yviJjViTYsZH7E3r4QPBR36-Sg&oe=6A183665"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}]}, 
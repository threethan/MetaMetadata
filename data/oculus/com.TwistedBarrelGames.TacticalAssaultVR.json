AMkZWA6zbw0JTNMEfpolHSKDzC0WQQTwvQMVh1yKa6vek9Ox8uN0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKssVvNfxn7A4qaT-q8tJwV6SHUUgUKN9Z-dXAOag3aQ&oe=6B08725F"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwA-HKqBYjIQ7kNvwExS9XR&_nc_oc=AdqvIvPXrT9CHTXxVW5EksYM7zXMPnvpw8MP8d3fCpfmJv3Qsync4tKSlihUFL8GJk8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7xkjCjL-K-m7bWxymaEQBLph6QJPcUfwyE5cjVv11UA&oe=6B083F11"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYFCUP02e9cQ7kNvwFyFJ8O&_nc_oc=AdqO0FsoFcuLFyDj6n5ciDpqS-H0Hx7yhU4LzzrkINoEAuTtxWmNj_Vmour_uPenctA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9gNrGSpUL8PbNEhCWJZcCCbdNgwy3FvcHhtfb0befmA&oe=6B084677"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKY0nFvxj-UQ7kNvwFdi15B&_nc_oc=Adp0GiiZasBj0_VuD2OrcTzTs9B8SSVdSGQkOvLtCOB3FvJ9MJo5I0hJp9UcieX6LaE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP0I5U4TQjB9Gam-F-BsgNH6RO9QINmMJjlGjR4xixww&oe=6B083B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfn_uITHbhkQ7kNvwGTZ1XV&_nc_oc=Ado-92RE-lGiDnWHXNKR2DXBvullWqkPGXsYebUkLzxkxvH5_rcThvzp1ibJRZS2iJE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmYPPDpEcjl9O_oTmHwxV1koNfZF1F1L9j08i5uv9bxA&oe=6B085B96"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
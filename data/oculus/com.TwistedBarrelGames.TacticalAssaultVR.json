xC6xUKDz3B725VdAJ2HV_oLWf9Ddu-UmDYR7iAt9p7Ae1LDHQj0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL3PjcchhFo8wg0nAuVdLqwgTGwH1WLY-PnOIPp8BqTw&oe=6B01DADF"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9H1PzdGkPgQ7kNvwGkQQ2t&_nc_oc=AdoLDEcbN0B_ibUy3WcsEsB49AcmCLqzceznvKrqIxjfltBmthWI-gJVyl_QwjVHTRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3lt32wBwwyD_vKKNSnoUuBcJyfJCR04yAHKEHBPnbYA&oe=6B01DFD1"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciig8ArQ1kkQ7kNvwEjigxH&_nc_oc=Adp-5NXO_bth-ZO4kMqHiuFAsUEs6fkAggqgSeTGJJM_61fXUZ8pjcu42RlklG_71vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYfKDXd7vMi7tQOJOYTZnYphjT7NZmIP_3Jb3NUpM5VA&oe=6B01E737"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHDO3RgNuPQQ7kNvwHNf0Ar&_nc_oc=Adqf5-rQe3GDyyNwo0X-ADm_M2T4XmjDnVwYI3RVVltX1kWM17Lk10bQ7BCuWcW2w6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHoyeW9OTN_56KXfTP-HZEYdwczraIOya8o58ZeXyluA&oe=6B01DC44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZl6prIsTVMQ7kNvwEMJ9TS&_nc_oc=AdpXawkSY_be0fqusTEkHHBN68VOtEfIkYpIrEvUCwNWeFRUWiPzseWP2WtL5m98neI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ35rJAVHJbAK1CHJ7rZU1QQv4yEN5Cp7OKgSPGRQ7Log&oe=6B01C416"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
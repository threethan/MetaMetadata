A&oe=6A1C4635"}, {"file_name": "04.png", "id": "1055226238425444", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974444_1055226241758777_1831115996652299582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzQ6_8rzQzAQ7kNvwHCLlIl&_nc_oc=Adpn_5Zpe5cFJG_cTwy33EkQD9IVEerDAK4ZtzBMJqsD7swvta2KlF_YzVdgeHAO0TM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yHUHUY-zQduNnvfqbhlCmo8nyVuVqxCiz0BLztuEkvg&oe=6A1C4DFA"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcXNNKuETp4Q7kNvwHfFtUZ&_nc_oc=AdrKp0FlUS6g-JUzQPpaYiVpff5lx00Nc6e2Hg2YdWqpE6tDmpkC4h0ZEEjnbaE9lsc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WjcoDvYZEGqSjnkgg9XGt9J8fwH7TUMKk_jpLwV7Gow&oe=6A1C5988"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxHnVTRJuDAQ7kNvwFiVpQL&_nc_oc=Adpjh52nZ5eRMumHwSuwE3SGiz_Jd9XjHc14Mm2CLc8nsv0oowwrUfLkHCYP-REpb8M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mUJxsLtwoBC3vnzgdAxVBc-z2hEWx8vVn97rQ9jAzCg&oe=6A1C4050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0fnd83csqUQ7kNvwHCJHWi&_nc_oc=Adq_qpinKWuleRCd_3PI1XeC1pwi2micERLQSZQBig8v9rKlqKIm5ubMDJc0AcqEzj8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YItRtuWesQkfyttwBsgY8ARhIWQnYzlmoE9-W-FRoQA&oe=6A1C2AE5"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}
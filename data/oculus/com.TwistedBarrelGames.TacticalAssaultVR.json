fYUZ8CXvFlCHXj1fSpwDSQ&oe=699C343A"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8PMh1qP7qoQ7kNvwGrBjp9&_nc_oc=Adm3WPgI7dBCyF-LtnULtTsZvO4ze87UhWBCydAWq_MhyhuThmA9KUOj7cqlvYer7R8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs23jijCVXWfEN7VumN6tuPsU_T_HGNuMwVgh5pebC3kA&oe=699C3FC8"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiQJJJpTk1YQ7kNvwGgz5UO&_nc_oc=AdleC6GWwvcj2J_oIocVndmXcf3UiPMWKqUOMDf8Noldi4lQuGXNMNDVJgR7LH9Lrp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsePiU78x8OOqFpDkPhMzYfA-Hi_msQs9F-LpSZeSDenw&oe=699C5ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ouf7KOzQa4Q7kNvwFfKwB6&_nc_oc=AdkrbSw3Y86iU5U8RcSYiKnFkLXhzavY1XFsSv8fYcJbynPNXa58dhtUrrGB3cstIwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs19M7ud47lZbAbbaihBT-BSKzIv0cOWFXcqKDlGCHmVA&oe=699C4965"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "4422442818079351"}, {"status": "PUBLISHED", "id": "1597914691527887"}, {"status": "PUBLISHED", "id": "1151692650031602"}, {"status": "PUBLISHED", "id": "1446214136468366"}, {"status": "PUBLISHED", "id": "1264311105711421"}, {"status": "PUBLISHED", "id": "607656328564422"}, {"status": "PUBLISHED", "id": "1398645178122041"}, {"status": "PUBLISHED", "id": "11690195245370
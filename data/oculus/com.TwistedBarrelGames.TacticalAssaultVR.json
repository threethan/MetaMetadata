rU5NgB6HsuXmFKiLpVvTgh9LA0_x_hcaf9Nv_-sOEIL4yv8y8VJE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZDvO2daUlvlzpEiZcxDBP6xKY9Y-kjOOEczKo34qbqQ&oe=6AFC94DF"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2YpXjm_2FcQ7kNvwFZn2Wl&_nc_oc=AdraftxeMl_W6r3RBCon4NzWBYQSnRq3RxUauw_n48ov5LqujHLIRnCsoDrYm0LexD0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeYNDnbls-Vj4Z6r8n2p3EI4huIgc4LwyKc83TDmqODQ&oe=6AFC6191"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNhPBDbVyOoQ7kNvwFHVrDJ&_nc_oc=AdpexpiBiy1hfAGN4uuOp08VKNUyoIYH6ZKQgEeWgA_aGfRzBjJKGp8O5cUYMHlPYwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8j_ppZGhFUbUZxJAZdnLTEsQx11B8kyxmfbtwP6ldVw&oe=6AFC68F7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOGfIKczh40Q7kNvwGLkO9C&_nc_oc=AdqwHVCjRp2nGZuFK-3S9z4M8105SOtPxUxPdEDRuqWMaccNkUCJNt3M-Nyc4GJwt_4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2yaOzcWHlZh81ZvMrb5z4Z25w0NUZyW7IfZKbYE9lmw&oe=6AFC9644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3rqnSRFuhkQ7kNvwHk06Qw&_nc_oc=AdqPoMI9TLNdfX7cYC6BbNoLGdlUhQSkXReNrd9IA7tbEhlM0f1oPbPwhCBYqQCY99g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd3-zZMr8iD32RNbRqrw-Sp7oFNxm3rOKKxG2LvZy1OQ&oe=6AFC7E16"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
uhv6IGa1KxD8vJEy4F-8a0uQ7PXbnZe5UE28axV6otysNoHQdQUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj9RC9IYxvPHVOfWXS0PbHQAUOesi70kCwvUBRBBHIcA&oe=6B032C5F"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9H1PzdGkPgQ7kNvwGS20as&_nc_oc=AdoOt21maE0uqmhzbGSZ8nKsxTUidfSgstF0_VX-AtJ1YvZtk7bOoxD94fn684NjcHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGUm8h63qIKmLdDGoru8K7DTstS8p603Yy8lMDrG5cjg&oe=6B033151"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKCNBRSAPcUQ7kNvwEfw0Wf&_nc_oc=AdpFaycCv8Gw8pio_vyDUZRDnJAQQOP1Ezel2x3GHA7MxJX8B0cHBoA1jrCxiLwKIlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk120ifu3cMMt_VxoIDNMfHRC9B3hmhr7IETtpIrNg_g&oe=6B0338B7"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHDO3RgNuPQQ7kNvwFs8_tf&_nc_oc=AdrnfTYPOHdRD9wQ0HJrk3h8o_hFjZfT_yy-E2wpaLGSWkJsefjTdYver5uKP7Im53w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA5ffr7_fk1UdRupPuIw9v2lqCKIQJo2ADa3DLLWFIOA&oe=6B032DC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSoQpCRvVr4Q7kNvwFu9wJN&_nc_oc=AdqkmsFXi4E18jpMtqLUkyt-IWAsMpB25ig0ggJSCKbe82J36FS-guwZI1h0DrID7GI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShv4nHqYsko4POMmvvZ3of8S35UgFtUbsmq0eoW-wJOQ&oe=6B031596"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
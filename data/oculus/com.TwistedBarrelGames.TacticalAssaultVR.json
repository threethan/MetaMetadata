Q&oe=6A2823B5"}, {"file_name": "04.png", "id": "1055226238425444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_1055226241758777_1831115996652299582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9sS5El_MrEQ7kNvwG655CG&_nc_oc=AdojvPdWvI1NmbdFPJErRqUGcP7DxQqhohkFF0KGOA0W-4syLFFiJGh2Rs0ZGF9N8lU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YYzfknHzdOJIUtuefDgH4_X_hHeaWTO4Rr2QHpZOPgA&oe=6A282B7A"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cty9CKe_isUQ7kNvwHI3zA4&_nc_oc=AdqLFj3RjxLjiYWE6ny-sSeHlEmWo8arT81C_EPETDmlWWUXPUDVr_CGiVCcWKsav4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eWBCU7mp1Fz15-87HknpqVX1pomwW78SgwAYHYfgzVw&oe=6A283708"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZUHWh-RUcEQ7kNvwHwxpyv&_nc_oc=Adp13wAmS3nV9QJBgSPivtrSks3IoGVM7iNzTDn-Yt55SVTsXtMN2UkfIAHQroE2g5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8z3NXWa_8ijzSUO_C9YmGb4aaLU0cCZzNIKcNfEOc6g&oe=6A281DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji-0dpEMVrgQ7kNvwGq-jtq&_nc_oc=AdpZH3IcBjdzjKQ4GFE9SNHtDWqowj6CjiyVF4CccgOyiOneQpWLdrzcBDB6Qu20vT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y-gYwqAaNh0ZktBeJAAl2ZGhWmd-WtfAFYTwUFw2q_w&oe=6A280865"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}
OugvpMb0z7b5o7JBr6CvnEEZPROn8lA3BYyDYWavZdQjNGXEH_j0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHrux7YJLmNRZPZf0v9jjsLtTsEa64sXLzKkrQCOBag&oe=6AFB435F"}, {"file_name": "Mike1.00_05_50_04.Still004.png", "id": "593966966655966", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974465_593966973322632_4982309690223554663_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8YPoh-f4fgQ7kNvwFIBU-I&_nc_oc=AdovkGDsHZK_ZZ6o1Sx65Il-g_B-NtSgCaOWujG1fyASVLt1chF73-Nj2H9t8c4Z6a4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw0B6WbpH9qqqWv9ncDJYzsmGvEvn6tPGTArRoOHf0Gg&oe=6AFB4851"}, {"file_name": "7.png", "id": "1046485386953462", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001725_1046485390286795_4079334239054220795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNhPBDbVyOoQ7kNvwFQPbeF&_nc_oc=AdqEi6WE1t9NZDp_NrshbjYCldwL-8purmKBDNXEHIBA_mz7pupGWl-_CZPs4Db_yxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLa9SHV5CAUJRUlOjkBtrYtbfKd_9zAdAdeytX-QFe8A&oe=6AFB1777"}, {"file_name": "5.png", "id": "871826811724630", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86620689_871826815057963_7999414902838153684_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHAJsIx9tRwQ7kNvwGXn6uP&_nc_oc=Adqg5yBAVe_6DUdyzE9bSwnoHDOmIQrB0m_jXBcht7Bq4l_ubCLXER9ofIOiRFGYj04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyn6C2WqV56P2H77QR1fXKdQkjvEJBkILk53nsqXpXwA&oe=6AFB44C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TacticalAssaultVRTrailerCoverImage.png", "id": "3497936147171850", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75540506_3497936150505183_3880119875800127416_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3rqnSRFuhkQ7kNvwGqrzPf&_nc_oc=AdpT080vfAI76Oz1cJdtfViNWorRCjAve4ArvmcEi3I9ijAdEfUvDcefJwQPTHBO_Sw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrcuLvQOxfwcBWIxmARDwH4L_V810CVYINvOaSG0PQ-A&oe=6AFB2C96"}, "display_name": "Tactical Assault VR", "keywords": ["TAVR", "Military", "SWAT", "Police", "Tactical"], "long_description": "# Become part of an elite special forces unit in Tactical Assault VR!\n\nTactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world.\n\n# Features\n**PvE Missions: Solo or Online Multiplayer Co-Op with Up to 6 Players**\n{1487526115258066}\n\n**PvP: Competitive Online Multiplayer**\n{1082589306850803}\n\n**9 Non-Linear Asymmetrical Missions, 3 Wave Shooter Experiences, Room Randomizer & Sandbox Mode**\n\nPlan your assault. The choice is yours.\n{448475627682065}\n\n**Game Mode Variety**\n\nBomb Defusal, Hostage Rescue, Enemy Surrendering, High-Value Target (HVT) Eliminations, Mini Games, Killhouse, Hardcore Mode.\n{1946208202559962}\n\n**60+ Detailed Weapons and Counting**\n\nCustomize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips and breaching equipment.\n{1007758587705278}", "short_description": "Tactical Assault VR is an intense tactical shooter where you use real-world CQB (Close Quarters Battles) tactics to stack up, breach doors and eliminate threats. Play solo or join an online co-op special forces unit in missions around the world."}]}, "developer_name": "HammerFire Interactive", "developer_privacy_policy_url": "https://www.hammerfireinteractive.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HammerFire Interactive", "support_website_url": null, "website_url": "https://www.hammerfireinteractive.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
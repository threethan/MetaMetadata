ncjx1oZKf537Woss15cu8St0bDrvSWj0A&oe=69A6C03A"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjSBHFIoKfUQ7kNvwGxPWe8&_nc_oc=Adk1dVJIqc5mkOC7M4nZKaKl-K4fAgtT49geN-rnOw1lWbxnRX_tCcsRkI2lQcKKCrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvZpeXfAYcaEroBb-hgD-hHJuv_CT1P4r7wlLp7JrIn3g&oe=69A6CBC8"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUIWpwuPaEcQ7kNvwH51IDj&_nc_oc=AdlRGdwKtr6zs5zE_rpPlndFbOtkUDLhwL-X3F0oa4M1_G6J-aPjLmpvremZrAvHrIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-MC3Fg4hEoZt6H7rf4bMPWHFxr_lFAOr0eVagJWRYhg&oe=69A6EAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVBYv4YdNYwQ7kNvwFMtcYk&_nc_oc=AdmFRdTNMRohpp43flT6EFd9oXevVWrWwa4KOb_HKaHqScqott0isgXWFdq6aD7s-E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCP8I_BGzp348mWkXgKbcKy2kYwTPAHIlV6928ZrT5Cw&oe=69A6D565"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "4422442818079351"}, {"status": "PUBLISHED", "id": "1597914691527887"}, {"status": "PUBLISHED", "id": "1151692650031602"}, {"status": "PUBLISHED", "id": "1446214136468366"}, {"status": "PUBLISHED", "id": "1264311105711421"}, {"status": "PUBLISHED", "id": "607656328564422"}, {"status": "PUBLISHED", "id": "1398645178122041"}, {"status": "PUBLISHED", "id": "116
Q&oe=6A297535"}, {"file_name": "04.png", "id": "1055226238425444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_1055226241758777_1831115996652299582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9sS5El_MrEQ7kNvwFepupl&_nc_oc=Adq2reudvWdxoGns0K0ojv8wgZ-70O0hjkIbRjiTzrPxejKz4X8K2DdZtBGDkzvf3KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gWrafkCri6d5jbjCdIpvTZW6WTF1MHoN1FqnbShXLBA&oe=6A297CFA"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cty9CKe_isUQ7kNvwGyejzE&_nc_oc=AdoKuwxH2rryxxzq0mIQNCa8zJWciof0khYGRRqOmsX7P4fvmJ1asZiSPNl0Jej2BaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wBuhn0cBJmHDpg01QNd41rzCd3c1rAtg0USkaXbkllA&oe=6A298888"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZUHWh-RUcEQ7kNvwG9YNC1&_nc_oc=AdpCz7NCUsP8H9mch1oKC_6-t8Ph6K0k7ukkKliGRCFSyZZWAY7WEBTyuSOesHtixNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hucHIWaDAXf4rjeFoU2Jr9mh2Y5PX_GB7XA8bgPfksQ&oe=6A296F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji-0dpEMVrgQ7kNvwFZQBYn&_nc_oc=AdoQnxUId0x3n1esHYrhN1tAnpYQOiOoEotzSd37c18zO3oFq4txWxNUCMA4o7zNj0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M6TMu65Jf5olKm7daoCCAE4k1xyg5S8-87zrRhF9GWA&oe=6A2959E5"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}
-2.oculuscdn.com/v/t64.5771-25/38974444_1055226241758777_1831115996652299582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfAUTqBvt7EQ7kNvwFgea_l&_nc_oc=AdpNJWxlParYhaswT6UG937cyvEPPCs78yrzNPjk-DJo14zbrTwsajSvK0JD2_24KnU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X5aoUF6rWIKU681qtL2C8dIsjxfY1e1-fmZh_uUtpOw&oe=6A0C7BFA"}, {"file_name": "05.png", "id": "370038625185407", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_370038628518740_2936465798892377324_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIlW-iKnbEgQ7kNvwGhiBwY&_nc_oc=Adro-jFqFTeOOZzc3cfdS5JDG7TmgIlx-zc5FdKYlgLWu9BPQFxlQo2LzndJFYmJSh4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pztyASBxbYz1P8Pz75ynDBKlhFj3w44dqdbYq5pie9Q&oe=6A0C8788"}, {"file_name": "03.png", "id": "404213504899404", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031553_404213508232737_1503129241169604478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mvLn_3lBD0Q7kNvwEpImj_&_nc_oc=AdpmCkV8MCMRERnt2CQ1ZYnxWEKWOvTL3NHL4mECtG6KwqtHrHoBlOfnmkiRZEwQ_UM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LUaTt3y2a3V-TbX0MM0NcbHgLsVPa3i1bKqtWGBXuvA&oe=6A0C6E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "744940850199945", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036630_744940853533278_1975672743797178257_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGwq4JRTU-sQ7kNvwGbXKtR&_nc_oc=AdrttNJ6wWDqX8wZWHlGTlq78sc3MUQTIa7RP3fYtyI0EhJ0p1lIcNv8jHNB215rr3g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GCrhZIIxV2-Jjphiu1HqPrlxCRfca7ilsMXMABuZV2w&oe=6A0C58E5"}, "display_name": "Tactical Assault VR", "keywords": [], "long_description": "Become part of an elite special forces unit and use real-world CQB (Close Quarters Battles) tactics to clear rooms, breach doors, and defeat the enemy threat.\n\nFEATURES:\n\n\u2022 Utilize an arsenal of weapons, scopes, sight attachments, explosives and equipment.\n\n\u2022 Take note of simulated wind and target distance with the wind meter and spotter scope. Calculate physics-based bullet drop and time-to-hit to improve your accuracy.\n\n\u2022 Use stealth to sneak up behind enemies with a silent knife kill. Or go head-to-head against enemies that will take cover and attempt to flank your position.\n\n\u2022 Randomized Enemy positions and doors, making each play-through an unknown challenge.\n\n\u2022 Non-linear maps give players an endless variety in how they choose to infiltrate and complete missions. Enter buildings through doors, climb ladders to reach rooftops, or climb through windows. The choice is yours.\n\nTactical Assault VR is currently an Early Access release and is updated regularly.", "short_description": "Tactical MilSim CQB (Close Quarters Battles) in Virtual Reality"}]}, "developer_name": "Twisted Barrel Games", "developer_privacy_policy_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Twisted Barrel Games", "support_website_url": null, "website_url": "https://twistedbarrelgames.wixsite.com/tactical-assault-vr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "707998687088613"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2859013591105136"
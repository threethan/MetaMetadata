567_1562034588682300_8086777656620789470_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9oEDNXCpfMQ7kNvwFXDIvP&_nc_oc=AdofRW_Ww9gHuKLyB4EBZVs59rSA11cipFgtmmIla6K7va9XVWZhNhXHXGCxqtpMH1A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQqRg8l5o0UEuRbtJsuYG5t75BMiEEglIV0KTwoV71Ug&oe=6AA96570"}, {"file_name": "3.png", "id": "2010112022932093", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828050_2010112026265426_6436682946233115914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltdTvZ3kIKsQ7kNvwFy1zNC&_nc_oc=AdqE-_gKe4_uC6w6kdadUMn4Dfu8JrN7TFh3k5FQ001jZQ3S-CxGuDVcNeeIb3pyKdo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6XIIBdbBDYh8QZEdzUYpQwpGnPmLxG3uK8Wmx3v_xdw&oe=6AA9555B"}, {"file_name": "1.png", "id": "1012298311302829", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823901_1012298314636162_9082375231519822823_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kSrcGDiTV0Q7kNvwEeMTHC&_nc_oc=AdrbY1G9EIv12u71onZP_2uRlk74-3u5W0k2zDEWwygl8HHBeRKFI84gWaLYPHSMD9s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmllgsAbzrrV9HFDN7WlrqoUdYYjrC2jXrUx5OW2Nh1A&oe=6AA94E23"}, {"file_name": "4.png", "id": "1571889697974973", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828038_1571889701308306_8593686806076894843_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkhcgtovVCsQ7kNvwEePhsi&_nc_oc=AdrDG1IOh2E8B6d0hAmzh-daRLi_iD9Zks8uUmxBTbuzhERxKCvaz-e7eb7IrK_af0s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtg0Vi9mEPAuflwequDhHGYtYMlaOH61wlC4IgB1uDQ&oe=6AA9374B"}, {"file_name": "5.png", "id": "989895950259076", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827626_989895953592409_4918534558424645376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQIEqV9Qq54Q7kNvwEO0vTF&_nc_oc=Adp06JOvdLyWfLKwfBU7LC2ww7XczwzzShupY_569jcj5aAxGxNWGNLBY6LtcP5ikxI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzwqTbRXMLaOUCoBdxcEnkIHUijeUtyf10GuCXgiCP4Q&oe=6AA93E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "1007730408877788", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824318_1007730412211121_256163977082375150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa-OuTSfkuEQ7kNvwF4iGbo&_nc_oc=Adq7l5lde_tAMWicbipKxe8WPne8GJVvKpyg4rkX5rkJIxvZbpqKNzKDdlo7XEd5shc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKgd9lCbtzZBO4sWBRA5y4XKajGPppYsJ3e2n0B2_9UA&oe=6AA94677"}, "display_name": "Doodles", "keywords": ["drawing", "multiplayer", "ai"], "long_description": "Two Incredible Ways to Play\n\nCouch Co-Op Multiplayer\nTransform your living room into the ultimate party game. Pop on your headset and start painting your masterpiece in mid-air. No extra headsets required, your friends can join the game instantly from any web browser to guess what you\u2019re drawing.\n\nSolo vs. AI Speed Rounds\nNo friends online? No problem. Face off against our custom-trained AI model in a heart-racing race against the clock!\n1-Minute Blitz: You have exactly 1 minute to paint and make the AI guess as many words as possible.\n100+ Word Pool: Start with easy prompts and adapt as the words get progressively more challenging.\nRisk vs. Reward: Stuck on a word? You can skip it, but it will cost you a strategic time penalty.\nGlobal Leaderboard: Perfect your spatial drawing skills and beat out other painters worldwide for the top spot!", "short_description": "Doodles is the ultimate drawing game designed for quest. Whether you want to host an unforgettable game night with friends or test your sketching speed against cutting-edge technology, Doodles brings your imagination to life in full 3D space."}]}, "developer_name": "Sunflovr", "developer_privacy_policy_url": "https://www.sunflovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunflovr", "support_website_url": null, "website_url": "https://www.sunflo
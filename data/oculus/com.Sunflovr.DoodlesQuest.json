567_1562034588682300_8086777656620789470_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai-pY1Z26VcQ7kNvwH2TzGn&_nc_oc=AdoCuZgQbN1arUx3_s07YvYE9G0i2E2pQ2A6i-E5gWpCbJ4IkZ7pWuIOgZ5vXfJ8suc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAHNjX64L0XMXLss-W9SRcysRIgmF9wx-3qHPZnEZQSA&oe=6AA41F70"}, {"file_name": "3.png", "id": "2010112022932093", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828050_2010112026265426_6436682946233115914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFPsYI58x7cQ7kNvwHfdSAl&_nc_oc=AdrQRmnwX4r_yW5c46P5bwArcngmn0eK04xZ0slDVfI7S_geBpQTsqW30C7inDS-i50&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgMPbFLssnCyLuKDrrG9f-V0eHXpPDn8ToHxfi-oj7yA&oe=6AA40F5B"}, {"file_name": "1.png", "id": "1012298311302829", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823901_1012298314636162_9082375231519822823_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5pCVhQ1GioQ7kNvwHb5qW7&_nc_oc=AdpI96Xx7sE0rij-anaWy4xtZfrh_VgQ9k4ZxQ1P9CKkSh1JpxrlJew3iWI3LksVy6Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJipGS6JI8I_emmFdBs-zEztySdg9kUjgz4SLOVVjwIyA&oe=6AA40823"}, {"file_name": "4.png", "id": "1571889697974973", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828038_1571889701308306_8593686806076894843_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7KX3RcREmQQ7kNvwEMnKit&_nc_oc=Adr_k0VLDQ5zTcPI94MfG08rxuJMI1epveIrw7CfQ1WpuPnNZs1HoYf7ogVFqxLSfj4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJESjRZd_kzW_WnoTtK0EtXP_e88qWT1Z6Sf1TuahxqyQ&oe=6AA3F14B"}, {"file_name": "5.png", "id": "989895950259076", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827626_989895953592409_4918534558424645376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndmsDaAfmq8Q7kNvwHZlr5I&_nc_oc=Adoe9-gO5HmEQfg6a6AcQBRE1pnxRgeBqLsxV2o_tpRAfmGIwNEpOSXe7FFzJMSvbqE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN8r0M3dwgUObDNI4S2rzszRILqZlt85N6ghUM8wO3eA&oe=6AA3F890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "1007730408877788", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824318_1007730412211121_256163977082375150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyWgaLnZ8gIQ7kNvwE8xu-e&_nc_oc=AdqtNSoe2UcmwFTxCQ3PcRnQK_WDRTMlNGKaEs5hGLgFZTmBDZW4c9I_HeXPI3q2Jyk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm-MMbFMRmIsm2RAL-n_42YiR42s6Or8qSTw7UpdCRfA&oe=6AA40077"}, "display_name": "Doodles", "keywords": ["drawing", "multiplayer", "ai"], "long_description": "Two Incredible Ways to Play\n\nCouch Co-Op Multiplayer\nTransform your living room into the ultimate party game. Pop on your headset and start painting your masterpiece in mid-air. No extra headsets required, your friends can join the game instantly from any web browser to guess what you\u2019re drawing.\n\nSolo vs. AI Speed Rounds\nNo friends online? No problem. Face off against our custom-trained AI model in a heart-racing race against the clock!\n1-Minute Blitz: You have exactly 1 minute to paint and make the AI guess as many words as possible.\n100+ Word Pool: Start with easy prompts and adapt as the words get progressively more challenging.\nRisk vs. Reward: Stuck on a word? You can skip it, but it will cost you a strategic time penalty.\nGlobal Leaderboard: Perfect your spatial drawing skills and beat out other painters worldwide for the top spot!", "short_description": "Doodles is the ultimate drawing game designed for quest. Whether you want to host an unforgettable game night with friends or test your sketching speed against cutting-edge technology, Doodles brings your imagination to life in full 3D space."}]}, "developer_name": "Sunflovr", "developer_privacy_policy_url": "https://www.sunflovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunflovr", "support_website_url": null, "website_url": "https://www.sunflo
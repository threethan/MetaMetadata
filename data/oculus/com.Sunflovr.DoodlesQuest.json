eo_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "1007730408877788", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824318_1007730412211121_256163977082375150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVM1Sa_yuuAQ7kNvwGmpITa&_nc_oc=AdpMkdcqEUoVCr5uY5QU8BnyAVHUWVjTlesi6PG18Rec8N-sCLax9xGwZMSsQwpMmmg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh_487T_wV1L34UN44P0FfMazRwho6u10CR1KMP2xIbw&oe=6AC8EA77"}, "display_name": "Doodles", "keywords": ["drawing", "multiplayer", "ai"], "long_description": "Two Incredible Ways to Play\n\nCouch Co-Op Multiplayer\nTransform your living room into the ultimate party game. Pop on your headset and start painting your masterpiece in mid-air. No extra headsets required, your friends can join the game instantly from any web browser to guess what you\u2019re drawing.\n\nSolo vs. AI Speed Rounds\nNo friends online? No problem. Face off against our custom-trained AI model in a heart-racing race against the clock!\n1-Minute Blitz: You have exactly 1 minute to paint and make the AI guess as many words as possible.\n100+ Word Pool: Start with easy prompts and adapt as the words get progressively more challenging.\nRisk vs. Reward: Stuck on a word? You can skip it, but it will cost you a strategic time penalty.\nGlobal Leaderboard: Perfect your spatial drawing skills and beat out other painters worldwide for the top spot!", "short_description": "Doodles is the ultimate drawing game designed for quest. Whether you want to host an unforgettable game night with friends or test your sketching speed against cutting-edge technology, Doodles brings your imagination to life in full 3D space."}]}, "developer_name": "Sunflovr", "developer_privacy_policy_url": "https://www.sunflovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunflovr", "support_website_url": null, "website_url": "https://www.sunflovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOS
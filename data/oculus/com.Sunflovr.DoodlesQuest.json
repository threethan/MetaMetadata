567_1562034588682300_8086777656620789470_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJmRrXZ37IgQ7kNvwFnknVs&_nc_oc=AdrukE7A3s0c8KnAyKgO4ITTqn5GYyuuH0_wFO4kVhWzXc2G1HWxvEZIAkT8rVVhjpc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjJatxn2URIDT8_twIzHwPNsR_BLRfyIgPork4-CHBDw&oe=6AAEAB70"}, {"file_name": "3.png", "id": "2010112022932093", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828050_2010112026265426_6436682946233115914_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=459NZ-HFM9cQ7kNvwFbdbrI&_nc_oc=AdqHItBOQVcmZhROfP7iSnWKVH2KrlaTUjREwx1Sp9p5cCMv8PtECvGUPe7awW2qunc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhWmab_XgWQmIvCRJbPOZ9NOvFlIEsEYHl7fGwnph7mw&oe=6AAE9B5B"}, {"file_name": "1.png", "id": "1012298311302829", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823901_1012298314636162_9082375231519822823_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L--Xf7whO4Q7kNvwG1X1zK&_nc_oc=AdqXU3-JkQuQHAshpOYpyJ8Fu-lQAcXLiMOJxdXBdQ3o9pTbk1XlK0c0SWCn6pf_i3M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ1N6R_KNrAd16y0jy6fcfJCgdA6ak0nnc0VzzzWBSLw&oe=6AAE9423"}, {"file_name": "4.png", "id": "1571889697974973", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828038_1571889701308306_8593686806076894843_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9YPZ_eK_BEQ7kNvwHCglex&_nc_oc=AdpHlug65UZHtK3SEhtfZO37RR_UY_GcxCt7x8bzPPYDlZ0zI4GXHFC4s3MokGL6q7k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYnGZR00x5CX2SpIwgFXXw5umzX39ooG49H4Eeb1Ll8w&oe=6AAE7D4B"}, {"file_name": "5.png", "id": "989895950259076", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827626_989895953592409_4918534558424645376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEsfHfK3i5kQ7kNvwE6KPIZ&_nc_oc=AdpTPDCRiRzpwO3bqmhvlKpyoL-5HVhftBAM0QHjBs0PlQmsGIowUjj_FiC9w1uS85E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHxSnxTVEEOv_pVPdYI1yMJde6oQ1UkG8-I8Yu7bUOAg&oe=6AAE8490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "1007730408877788", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491824318_1007730412211121_256163977082375150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cyaFF6o24kQ7kNvwGmKByw&_nc_oc=AdoREc9633BkmMv2qJxxwvFyQlS6kAWGeqWw4jmNWaDbgO2csZz4tVrIqsWj-jeQpkk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS1XeRRfMMiRCI6In0A9pP7jw5jzak-34W3iHWH3qcuQ&oe=6AAE8C77"}, "display_name": "Doodles", "keywords": ["drawing", "multiplayer", "ai"], "long_description": "Two Incredible Ways to Play\n\nCouch Co-Op Multiplayer\nTransform your living room into the ultimate party game. Pop on your headset and start painting your masterpiece in mid-air. No extra headsets required, your friends can join the game instantly from any web browser to guess what you\u2019re drawing.\n\nSolo vs. AI Speed Rounds\nNo friends online? No problem. Face off against our custom-trained AI model in a heart-racing race against the clock!\n1-Minute Blitz: You have exactly 1 minute to paint and make the AI guess as many words as possible.\n100+ Word Pool: Start with easy prompts and adapt as the words get progressively more challenging.\nRisk vs. Reward: Stuck on a word? You can skip it, but it will cost you a strategic time penalty.\nGlobal Leaderboard: Perfect your spatial drawing skills and beat out other painters worldwide for the top spot!", "short_description": "Doodles is the ultimate drawing game designed for quest. Whether you want to host an unforgettable game night with friends or test your sketching speed against cutting-edge technology, Doodles brings your imagination to life in full 3D space."}]}, "developer_name": "Sunflovr", "developer_privacy_policy_url": "https://www.sunflovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunflovr", "support_website_url": null, "website_url": "https://www.sunflo
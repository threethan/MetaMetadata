om/v/t64.5771-25/491827626_989895953592409_4918534558424645376_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hrPcERRufAQ7kNvwEoXAcG&_nc_oc=Adrr0mGB0gECuYphga-oc1Xe-dmrJIOeFNsNVTBrHsb9lZ5FRMlyiE49Hv_ZrhW0JC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ4FTctIcpZ0ppBPz91I0_4sfSig-VF_ryCgCecooTyw&oe=6B0DA8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "1007730408877788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1007730412211121_256163977082375150_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEBMZCyiuuYQ7kNvwEc98rS&_nc_oc=AdpoBW-Mo-_NhxEJ-yY12cc08BvVb0GPrGVTRwJNf7PjBU-SngUOKd4UdkX4f6Tt5rY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQj3chqOPEhXeGj_QixLkaqynV5eFk6z6kYQveR9bXBDg&oe=6B0DB0B7"}, "display_name": "Doodles", "keywords": ["drawing", "multiplayer", "ai"], "long_description": "Two Incredible Ways to Play\n\nCouch Co-Op Multiplayer\nTransform your living room into the ultimate party game. Pop on your headset and start painting your masterpiece in mid-air. No extra headsets required, your friends can join the game instantly from any web browser to guess what you\u2019re drawing.\n\nSolo vs. AI Speed Rounds\nNo friends online? No problem. Face off against our custom-trained AI model in a heart-racing race against the clock!\n1-Minute Blitz: You have exactly 1 minute to paint and make the AI guess as many words as possible.\n100+ Word Pool: Start with easy prompts and adapt as the words get progressively more challenging.\nRisk vs. Reward: Stuck on a word? You can skip it, but it will cost you a strategic time penalty.\nGlobal Leaderboard: Perfect your spatial drawing skills and beat out other painters worldwide for the top spot!", "short_description": "Doodles is the ultimate drawing game designed for quest. Whether you want to host an unforgettable game night with friends or test your sketching speed against cutting-edge technology, Doodles brings your imagination to life in full 3D space."}]}, "developer_name": "Sunflovr", "developer_privacy_policy_url": "https://www.sunflovr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunflovr", "support_website_url": null, "website_url": "https://www.sunflovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "27299760552940788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_1559088025840866_296468481289200375_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6TDRzfjp34Q7kNvwGusG_f&_nc_oc=AdqM_NVIsjGWs35xBKR3pqOyQLi0Jts5_94dDQZKV1dvzS5tuaBaKyih732IDMWpMUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfmx1G8XFXgZab3wGrYsdd0kd-bAx0wWPoLxaWCCd3Ow&oe=6B0DBCA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Doodles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1781270880, "lastRevision": {"nodes": [{"id": "27299760609607449", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application"
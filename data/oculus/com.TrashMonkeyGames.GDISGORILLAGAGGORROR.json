-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_952524100033940_4531142803491726498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kgR99qa0vsQ7kNvwEPuOPz&_nc_oc=AdqjvF7YZJs94IBuR2VJmdjvMAU4c-QKDuf9BdwSGt7cH0UKvuhPj-3bGFHkuLgDYCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p4_RnhB72bU8KZx78TQs6yhiOHYsirlGqc8FbmqyrTw&oe=69FC91E2"}, {"file_name": "Screenshot 2025-03-30 163426 (1).png", "id": "511890875123897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_511890881790563_5958363890073490536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrSHsHqgNOIQ7kNvwG_gXgb&_nc_oc=AdppNdYZydTAtMyGdJBGfsJYQpnpkvZwVCmLPtr8844ZUGIq-aBU2vo70XN9aVa7QwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ytu8P8tIdiVV-quSJundkSJ5nRxscJWLO3FBmMJJcCQ&oe=69FCA4E2"}, {"file_name": "Screenshot 2025-03-30 163513 (1).png", "id": "1410053829994328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393594_1410053833327661_5237554230325882025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B1F67tBj90Q7kNvwGnF_Jn&_nc_oc=Adrur-aZlD65t2ZXdHfd3JqslLgDeW6ionKS7_xlyz5TpT2-_-Tzo9uXvQdTQ1tVTnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72eQZl7tMvQJkJQI7P_SXcUaeSx5JG7I6kigrTSxsn6g&oe=69FC8EEE"}, {"file_name": "Screenshot 2025-03-30 163552 (1).png", "id": "667761859142858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392127_667761862476191_4826613749585196235_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7U8mil-7oYQ7kNvwFPBKmX&_nc_oc=AdpnMWYah6DBAr34Ql-i9LimLkPMS-W7nPIlbAzPifeUfjO3Kza87Ya5SqthkR5mPGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zgOPCAOK36Toc46vBfsguibFeIp6h31QaiYAQOCNo9A&oe=69FC7C50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GDIS GORILLA HORROR", "keywords": ["horror", "free", "gorilla", "monkey", "monke"], "long_description": "Imagine a heart-pounding, adrenaline-fueled game inspired by gorilla locomotion, where you must navigate eerie environments using only your hands to move. But beware\u2014lurking in the shadows are terrifying, nightmarish creatures that will relentlessly hunt you down. Every step, every climb, and every desperate leap could be your last as spine-chilling encounters leave you breathless. The monsters aren\u2019t just scary\u2014they\u2019re designed to haunt your dreams, emerging from the darkness when you least expect it. With intense, immersive movement mechanics and a horror experience that keeps you on edge, this game will push your survival instincts to the limit. Can you escape, or will you fall prey to the horrors that lurk within?", "short_description": "A gorilla locomotion like game with VERY scary encounters with monsters who will for sure spook you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashmonkeygames/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "TrashMonkeyGames", "support_website_url": null, "website_url": "https://sites.google.com/view/trashmonkeygames/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23914081294862037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392014_2383698771977843_69708299671
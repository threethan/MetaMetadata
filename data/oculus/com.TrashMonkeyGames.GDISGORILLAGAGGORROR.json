-sjc3-1.oculuscdn.com/v/t64.5771-25/473391926_952524100033940_4531142803491726498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-8dipLv5nYQ7kNvwHbD_2d&_nc_oc=AdoSNEE_RL_PsB29_s-rE3Tfaxs1xn3ZM5IVAVfXu69k6ZfY9QbiYX1mbE2gmjrR6Ww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0KtIL_6Y9fQDsplSP5GjpTEQYEb12MKUBtv9dyXLSiQ&oe=6A9D68E2"}, {"file_name": "Screenshot 2025-03-30 163426 (1).png", "id": "511890875123897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_511890881790563_5958363890073490536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hUjOvot4YgQ7kNvwGlE_-1&_nc_oc=Adq_pfOgxsI6-rYDYROp10xh9Kwm0PuwzeOCRKqCdNQda9RK6g2cRv023aMjkBJqPu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwwBLT2PyuobrfUDPPMb_W-N5XVySGBiDO8TmpOI7ckw&oe=6A9D7BE2"}, {"file_name": "Screenshot 2025-03-30 163513 (1).png", "id": "1410053829994328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1410053833327661_5237554230325882025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xgt8nhXpd0Q7kNvwFsoLLR&_nc_oc=AdpOuCqQQy4AGuTL-MncR8GMLTsYRr3bKyhGgyfwD6zQ-xcnZoYztnxzICuvpzmKO5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa_ienD1IUK2_tShrtoeAa1nIBYQfeD3JjP8xV0W8V_g&oe=6A9D65EE"}, {"file_name": "Screenshot 2025-03-30 163552 (1).png", "id": "667761859142858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392127_667761862476191_4826613749585196235_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWo6acPMgcYQ7kNvwH_bznY&_nc_oc=AdpE2DBDRI8RQorH2OWbdf5faTeIILrTk5S3jkkSpmJwLguZErb8hJBY0TJkH_a73Kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa9oR99kc4Xj8MQNzK2dZuPty-BEj1NkVyw-fCPeOFLQ&oe=6A9D8B90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GDIS GORILLA HORROR", "keywords": ["horror", "free", "gorilla", "monkey", "monke"], "long_description": "Imagine a heart-pounding, adrenaline-fueled game inspired by gorilla locomotion, where you must navigate eerie environments using only your hands to move. But beware\u2014lurking in the shadows are terrifying, nightmarish creatures that will relentlessly hunt you down. Every step, every climb, and every desperate leap could be your last as spine-chilling encounters leave you breathless. The monsters aren\u2019t just scary\u2014they\u2019re designed to haunt your dreams, emerging from the darkness when you least expect it. With intense, immersive movement mechanics and a horror experience that keeps you on edge, this game will push your survival instincts to the limit. Can you escape, or will you fall prey to the horrors that lurk within?", "short_description": "A gorilla locomotion like game with VERY scary encounters with monsters who will for sure spook you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashmonkeygames/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "TrashMonkeyGames", "support_website_url": null, "website_url": "https://sites.google.com/view/trashmonkeygames/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23914081294862037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392014_2383698771977843_69708299671
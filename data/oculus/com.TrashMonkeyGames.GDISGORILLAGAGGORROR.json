-sjc3-1.oculuscdn.com/v/t64.5771-25/473391926_952524100033940_4531142803491726498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8e76KzwyvcQ7kNvwFvDZNr&_nc_oc=AdqlLG924XpsF-h4b3KaquGEE7_U3-8mdWjuVN0xm6ZqJKoYeFe1nZo7QmHy6UIqFYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcdUV5JGyQnfk2YlX9EC--R4MFoNLsFmjmLobZwsBDOA&oe=6A5CCF62"}, {"file_name": "Screenshot 2025-03-30 163426 (1).png", "id": "511890875123897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_511890881790563_5958363890073490536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAs4NtTUCfcQ7kNvwEsQqgZ&_nc_oc=AdprUalEnZAZIz8OWQZncQH01WZnFLlXhx0tUckkKlA6Xsev6_HDOna6QuuVfvTGURQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXF6C8_iu7Te_P_Q7_wRGMxGalQohRF5abYOXRKXGg-w&oe=6A5CE262"}, {"file_name": "Screenshot 2025-03-30 163513 (1).png", "id": "1410053829994328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1410053833327661_5237554230325882025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAwaJoWEi7oQ7kNvwEpQEAa&_nc_oc=AdoQpqOJ_HVtcX87egA3EKWVaWCN43lw4LWs3G4uFs-5wKt09C6NdlG9vgFCE4QzJa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTVjI53PSqAZQGvywk0pY-hbqxbyRf_wlKGza-zGkFGg&oe=6A5CCC6E"}, {"file_name": "Screenshot 2025-03-30 163552 (1).png", "id": "667761859142858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392127_667761862476191_4826613749585196235_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkZ_nODgy5cQ7kNvwHLKCCr&_nc_oc=AdqQCf4IBeQE7f9xuqRNgO3hJ9-b5mp4MGCalw81k9c6G8EI_QUSsGkHfWbeo_dkBGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrjXvFdLApq69NHlF47RgeW4CHEMZSudKve4pnVR7QWw&oe=6A5CB9D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GDIS GORILLA HORROR", "keywords": ["horror", "free", "gorilla", "monkey", "monke"], "long_description": "Imagine a heart-pounding, adrenaline-fueled game inspired by gorilla locomotion, where you must navigate eerie environments using only your hands to move. But beware\u2014lurking in the shadows are terrifying, nightmarish creatures that will relentlessly hunt you down. Every step, every climb, and every desperate leap could be your last as spine-chilling encounters leave you breathless. The monsters aren\u2019t just scary\u2014they\u2019re designed to haunt your dreams, emerging from the darkness when you least expect it. With intense, immersive movement mechanics and a horror experience that keeps you on edge, this game will push your survival instincts to the limit. Can you escape, or will you fall prey to the horrors that lurk within?", "short_description": "A gorilla locomotion like game with VERY scary encounters with monsters who will for sure spook you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashmonkeygames/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "TrashMonkeyGames", "support_website_url": null, "website_url": "https://sites.google.com/view/trashmonkeygames/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23914081294862037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392014_2383698771977843_69708299671
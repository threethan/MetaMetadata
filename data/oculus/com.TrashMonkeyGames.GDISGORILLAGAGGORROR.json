-iad6-1.oculuscdn.com/v/t64.5771-25/473391926_952524100033940_4531142803491726498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_w8y7MS1E4Q7kNvwFhrmoR&_nc_oc=AdqbYqND1TqjJiP8xzZzppTZ7oe1L4EpRoLwxePRjxaA3-wsq0Pp5-Jc1lJI3j6zwX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoFghWeCZg2nHG2DzS67YjFFUGXerW-eZS_4gKQaFrIA&oe=6A9EBA62"}, {"file_name": "Screenshot 2025-03-30 163426 (1).png", "id": "511890875123897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_511890881790563_5958363890073490536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hUjOvot4YgQ7kNvwGj2JGj&_nc_oc=AdqEAw4bfqXEAp1UMgMyU_HF-Mamvi6-oeKcET9JwTKCPb1xU9BzBUFVAby2WRzXGjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLytopmf0uIzEeRsFz8OhnQvfh9Y4GK83oiDIKKxW9X4A&oe=6A9ECD62"}, {"file_name": "Screenshot 2025-03-30 163513 (1).png", "id": "1410053829994328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393594_1410053833327661_5237554230325882025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2WQXNpJ6Q4Q7kNvwEQIC9t&_nc_oc=AdoA-ovVcIHO_VlNjti-iWE2ax6xur0R_xT75VgkeAMpz6Cv_58XWJh-foOXh3SkE2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISntvUSL4hIPaJXZuH6Jo11gAnD08A3VSnXoOFRbxCYQ&oe=6A9EB76E"}, {"file_name": "Screenshot 2025-03-30 163552 (1).png", "id": "667761859142858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392127_667761862476191_4826613749585196235_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWo6acPMgcYQ7kNvwFoqoQ9&_nc_oc=AdrRx3_hAG07xb-w2Afaeyp5ix7TAGSYuH_o_MmLhNa1fL2C3ppZQ_vud4lKsAG-oe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-LeQNDMjuNuvMnZxfhMFLgEYqjGoLNJc1EYYYNne37g&oe=6A9EDD10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GDIS GORILLA HORROR", "keywords": ["horror", "free", "gorilla", "monkey", "monke"], "long_description": "Imagine a heart-pounding, adrenaline-fueled game inspired by gorilla locomotion, where you must navigate eerie environments using only your hands to move. But beware\u2014lurking in the shadows are terrifying, nightmarish creatures that will relentlessly hunt you down. Every step, every climb, and every desperate leap could be your last as spine-chilling encounters leave you breathless. The monsters aren\u2019t just scary\u2014they\u2019re designed to haunt your dreams, emerging from the darkness when you least expect it. With intense, immersive movement mechanics and a horror experience that keeps you on edge, this game will push your survival instincts to the limit. Can you escape, or will you fall prey to the horrors that lurk within?", "short_description": "A gorilla locomotion like game with VERY scary encounters with monsters who will for sure spook you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashmonkeygames/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "TrashMonkeyGames", "support_website_url": null, "website_url": "https://sites.google.com/view/trashmonkeygames/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23914081294862037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392014_2383698771977843_69708299671
3910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXt8eUj2wHIQ7kNvwG0l56Q&_nc_oc=AdrOHNSvtlbZd5BVZLArU_PJjVu7EPJLBvPKYBT09GCglu9YcV5e0xqOviTtjYQwvhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWPR1K2sR0-RA4ZB_OTeBJdaHpTH6WGyOsx-q1BczHzg&oe=6ABA6663"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03-gejuQoF8Q7kNvwEr2gTC&_nc_oc=AdoYNx8XOjWYakuYymDRTUlgyeDcY_iBf4oufAIFcww4gf7yhJbFkjKKPsUG9dXp4Sc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVkoIEZgYJWpCEFUBD3A-U1UVrwuDYHW1VDNRFnv4ijw&oe=6ABA61A5"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGpGDfZipTkQ7kNvwHPLaX-&_nc_oc=Adpbtf7aDZ_DpyU5I4bcamdyPvU1c23kIIYgaL3kf8FeLzjT0PyC5a01MrhPPNUy6EM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUVkCdlltvxg1qndt5JvPWxEtKK-bdP2uPAxhF16dcRA&oe=6ABA83EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VLS-Trailer.png", "id": "2523335394743131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_2523335398076464_5880881015743401913_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QfPZjdbr3UQ7kNvwE5Cggf&_nc_oc=AdrvO3NW5pQVyagzxMGHRMG4V7MpPhtTTocv2dJWy2fC_kQkWsp02qCpQov9H_FKaDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjzORvmi0v8heHRyFXv-UJz27wHa0TQATEacF8NIqU5w&oe=6ABA8254"}, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international Basic Life Support (BLS) guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}],
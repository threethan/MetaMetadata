Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfIoV_NWaRJvVN4s7Od2U44X943Ar_Ar5ppykBlfhPqg&oe=6B09A112"}, {"file_name": "vls_3.png", "id": "1452745176915109", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcK0IWImqMIQ7kNvwFzlOuO&_nc_oc=Adqbp4iE0UQouWJ1CHo_hwo7Y_HVppLtAe5GXiIabBXVk18Hiirb4ruqukTrbj5rU0w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOiMqYuFVPqzXtIYNKtsgMENcIis9XNeK9yu95Gc9mkQ&oe=6B09B8A3"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lkm7DBx2tnIQ7kNvwHBoE2G&_nc_oc=AdoFUkDfMkfa_xikK2-Kh4WiubjNj1ATz9FrOZUywfy2V8H0eTjQAFPOLVvJviKPt8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTayrX4v8SU7Frh9EYDjkzrTJrQbfCXKkTKl8J-tpw6w&oe=6B09B3E5"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j2fYK2aBdEQ7kNvwHGOSy4&_nc_oc=AdqrirfN-m0A1Q5AabriroMtzCrl-CuxKckGfTyUQvGTbvwi0aCael6CLwHqDWFYMPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCqQTcRfDCEbJm0YjVo8IqtN_fb9pLppr0VQavlI3SiA&oe=6B099DEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international CPR guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
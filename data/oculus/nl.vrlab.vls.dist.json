scdn.com&_nc_ss=7f20f&oh=00_AQRRJ_1b5DHpKm6YgOIWDd_yzjEbRCgTUHM2LMP0U0Qb9g&oe=6B084F92"}, {"file_name": "vls_3.png", "id": "1452745176915109", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcK0IWImqMIQ7kNvwEbbvTi&_nc_oc=Adq0kYL05rN7yE8AWnSTTcA25lm2vhYiJjanELG3rfguo-PzpQFr94ERQ2-ORxyqchA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU7oHDErMSdupgsNM9udhZHEJwQ1a4A8T3SbWb2G3w6w&oe=6B086723"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpRPevLLGVUQ7kNvwEhhGAY&_nc_oc=Adq6t1-stuL2pXdh0KBT062xDZ27WuWyIT27n46fo920DaH8DOFnpXBJi42zybj9o3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfhAk8wGweWmBcpCz9p9VSfyAdNJFACgeAtaKu_a5h2Q&oe=6B086265"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j2fYK2aBdEQ7kNvwG8oLqe&_nc_oc=Adrp6Hey37yV5hjCm0Iws6OhR-NRnQwrEn_krgZilFsmNG7LXCkoYMMPAWGq2Vw9-6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdWcs6ZFyV2VJGNnlNkvWaJpF_5ARb-zHTwhYE9B3uAA&oe=6B084C6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VLS-Trailer.png", "id": "2523335394743131", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823790_2523335398076464_5880881015743401913_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCs-df7qrnUQ7kNvwHcCIS9&_nc_oc=AdqATcmJL6RpRxj_geiHXlaIkwSD7n4Qq-D1QoVqiBvAlMHutyYqrH5jqhCYQJI3DVs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVl_Wr2QLp5-n_SCOFgL5aL5D6MdwHroShkNEjM_4Mng&oe=6B084AD4"}, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international Basic Life Support (BLS) guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38747461074867110"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823757_1236697658587516_6993424575090373312_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1vzjBzfWDoQ7kNvwG-StfB&_nc_oc=Adq1t5h2RP8vq7sLcmaPuUDFloVzCCkuO6DAbD1MZMed9B84GgrxcwUR1cx_cy5Mr3E&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH9ToGbSACGlANV7QNxX7-miXuW7gCFtjcyAJXOAvwRA&oe=6B086966"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Life Support", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1789110900, "lastRevision": {"nodes": [{"id": "35447602684852982", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35447602478186336", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "108729286372
ile_name": "vls_1.png", "id": "831452633391566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824700_831452636724899_1506030654918094440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flgISQufaRcQ7kNvwHGK_vn&_nc_oc=AdpxJZdF446TcQjPKLcEzs8zuSxdXw2Vps78eufHuxrUnhQtEehKTH1LHHWMy2Bl6mo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBoz1jr9YAb5_GO3MN_K3DXSaiM5CxbXhfEY7b4XUojw&oe=6AAEB0E5"}, {"file_name": "vls_2.png", "id": "2082126259111582", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823279_2082126262444915_3841851966046109697_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZceqX5ZQAQQ7kNvwFSVDhB&_nc_oc=Adox_H34Lmbp38-sh5Uxv58lg6Pz_ih6kiNI0oS7YWpYAiVDA78RSZ9J241uvDJy3T0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqdRWy9BgbhgSLuP3MvPHJ4CukP3y1ekejRYcrs-FMLw&oe=6AAEA992"}, {"file_name": "vls_3.png", "id": "1452745176915109", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKsPAe2W-8gQ7kNvwEcx7AO&_nc_oc=Adrt4akomxtXruHzHQNvjGzSbMWMRW7rpsHskaPAUslMO-_iZOp5rjorMsgUGyv_LtE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWYy5nOIXEvP6Y3x4iJuIRcXbY4C1TzEcccQUVZZd9og&oe=6AAE88E3"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5NktAg4WMcQ7kNvwF_92Ag&_nc_oc=AdrZPQBW-hkzC4Rv5_x7-TwNbcPPCJY1arFWsByETa8ArouJ7EzkG7fGfp7_bEUCzo0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAPYPCRDeJfKoZBsNHsjaYyETdVivlWiBIqhmgptLREA&oe=6AAE8425"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUWPJs9sKU4Q7kNvwFm-PIk&_nc_oc=AdprTcWNA5_sNgfMcndHkfYrkr47F23xwXiklSpM-Ej-7KlBLlRAh2wQPRzW_t1zLio&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0FKVIsVYnq5ArAjDV6NJgglC3uMXd0BE54UMfIgdV1w&oe=6AAEA66E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international CPR guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38613725358240683"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1949130142399988"}]}, "baseline_offer": {"id": "1949130142399988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789110900, "status": "PUBLISHED", "id": "1949130142399988"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38617513501195202", "version": "2.3"}, "id": "988109464162467", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35447602478186336", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38617513501195202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988109464162467"}]}, "change_log": "New\n- New Hospital scenario (Pro)\n- Structured patient handover (SBAR) added to the Alley, Supermarket, and Living Room scenarios\n- Icons show how challenging each scenario is\n- New audio distraction in the Supermarket scenario\n- New drag interaction for unzipping the vest in the Living Room scenario\n- Detailed step-by-step tracking for ArborXR Insights\n- Shout and shake, just like real life: the shoulder-shake check now also listens for you calling out to the victim\n\nImprovements\n- Better warnings when your license has expired or you're offline\n- Faster, smoother Bluetooth device panel with a redesigned look\n- Improved license QR-code scanner appearance\n- Better feedback when a rescue breath fails, with the icon moved to a clearer spot\n- Reminder to check breathing correctly during the emergency call\n- Animated icon added to guide pose interactions\n- Loading icon shown while the virtual leader moves toward you\n- Smoother experience when deactivating a license while offline\n- Removed a victim outline that appeared too early, before manikin selection\n- Hands-off-time reporting updated to match the 2025 guidelines", "created_date": 1788957595, "id": "38617513501195202", "version": "2.3", "version_code": 20301, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38617492324530653"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35447602478186336", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38617513501195202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788793373, "id": "38571556002457619", "version": "2.2.4", "version_code": 20204, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id":
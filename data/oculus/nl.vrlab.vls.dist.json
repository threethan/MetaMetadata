nary": {"__typename": "AndroidBinary", "id": "40232745179672018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788793373, "id": "38571556002457619", "version": "2.2.4", "version_code": 20204, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "38571527965793756"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35447602478186336", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40232745179672018"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988109464162467"}]}, "change_log": "New\n- New Hospital scenario (Pro)\n- Structured patient handover (SBAR) added to the Alley, Supermarket, and Living Room scenarios\n- Icons show how challenging each scenario is\n- New audio distraction in the Supermarket scenario\n- New drag interaction for unzipping the vest in the Living Room scenario\n- Detailed step-by-step tracking for ArborXR Insights\n- Shout and shake, just like real life: the shoulder-shake check now also listens for you calling out to the victim\n\nImprovements\n- Better warnings when your license has expired or you're offline\n- Faster, smoother Bluetooth device panel with a redesigned look\n- Improved license QR-code scanner appearance\n- Better feedback when a rescue breath fails, with the icon moved to a clearer spot\n- Reminder to check breathing correctly during the emergency call\n- Animated icon added to guide pose interactions\n- Loading icon shown while the virtual leader moves toward you\n- Smoother experience when deactivating a license while offline\n- Removed a victim outline that appeared too early, before manikin selection\n- Hands-off-time reporting upda
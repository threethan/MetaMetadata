97_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZceqX5ZQAQQ7kNvwGvoLjc&_nc_oc=AdqADEDhSdPmq9Sizunfkxne-VUTW9rRwR7U4kHxQ29i6GaxHgU_CmCJKbtLeCv5DIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Z22UT3sS3GMtLgA7_8A5dX-xpQbzJWDF_lYPLrbU4g&oe=6AAD5812"}, {"file_name": "vls_3.png", "id": "1452745176915109", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKsPAe2W-8gQ7kNvwHsVIGP&_nc_oc=AdomEpyvX_O78H35ZenPHiPzsXZJSeF66fsDVAUrciMXypB9EbnLMlCP5aPOobkpHRQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6w-5fFvKmU_DPp4hZxvQt0WOwodDvbGTDVFwoUC2AuA&oe=6AAD3763"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZH2Lf9eY0IQ7kNvwGnPNoG&_nc_oc=AdqtyaRqvCeORagF_sCKiP7fvCosH5tC5OcpZ9uXU8tr_gCnWWXSvC91OlUTJeH50DA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVVdarYmD4pDaEBZTNHzqVXfsQDNlR5V2cQXmfUXvT1A&oe=6AAD32A5"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUWPJs9sKU4Q7kNvwGA28gF&_nc_oc=Adqjn8O3urDjqj8fk2z0R8E-OP8xnG_v9jfB40XkWByq3Kl41vGSVmjnge8fHhQRzt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQbgf_4SVtl7TI8hXqkhgRC_gv7cM9-bt4SJFjvBAvdA&oe=6AAD54EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international CPR guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
scdn.com&_nc_ss=7f20f&oh=00_AQRvRRqNc44IFh99ANK2vKhDQj10dfEo_YjzEii5o4ShHg&oe=6AFC7212"}, {"file_name": "vls_3.png", "id": "1452745176915109", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa0Of5ZNqIEQ7kNvwGJjdhS&_nc_oc=AdrZVaNV-WZoNuZtScDOFI-c1yMfxNZ7IWj_T24b8MX8LH4lsE9Wt6JnSPFQkC7_iR0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCXgFQxrlsMjtUriflcwoDZ0NgnIr-mtV56zlsmYByyA&oe=6AFC89A3"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geWLV4sOvFQQ7kNvwFnsDw2&_nc_oc=AdqKR0F4VUoKURoMz8FPhkvEz2U_UUOXbhjnSqwIx2hsRUOtEXgfSLookPaxlA3uVt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOz90afGzQ1DPNzK-rgNqyXbCDKp2BGe0F8X2ZMTlJWA&oe=6AFC84E5"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZSo_xJKyCIQ7kNvwGjjrDP&_nc_oc=Adpn74jPlDdhN-Z945kXplbtl-uC0GIF2TyzRAnxWpbtyINttHydS3A6k7PaT-kO6Pw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKCdASh-goMQYJMM9An7FkZHlZg3OPsKDAlH5UTK6LDw&oe=6AFC6EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VLS-Trailer.png", "id": "2523335394743131", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823790_2523335398076464_5880881015743401913_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f_MzPkU67MQ7kNvwHNLbJC&_nc_oc=AdoPQWDRw4kpuMMH_PMS5d5Z99awV8zbpgE3OPjF5DkIorjpMPEbQY-sczx51J8_HIU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPcUObJ0MFVerXWpfljYZENvbHkoRzPdZyHuAVQFVfVQ&oe=6AFC6D54"}, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international Basic Life Support (BLS) guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38747461074867110"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1236697658587516_6993424575090373312_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unxes8q3oJIQ7kNvwEpHyKj&_nc_oc=AdoM8bwjBNSYXeQ3KglYk-Gd_bq5_tgyrqEniEmNzseLuCPe9gVSVsw0XkslJbOnRNw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMcjF9tCLUnSHgVURz9QaERGVJ9MP-EmtW2K_QxDHVSQ&oe=6AFC8BE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Life Support", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1789110900, "lastRevision": {"nodes": [{"id": "35447602684852982", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35447602478186336", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "108729286372
3910_1452745180248442_6374993917195055079_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMxNR9XRPD4Q7kNvwG_2Iqc&_nc_oc=AdpCJ9MTkCvNwiZM3XjJ8xnxQLSs2LxFeYIu5OOhns1GDq2xztAoxAa3cG2sAWsnkM8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQN48z8BnQVImg7R4jhyeQMk4vGSqJd5JqBzdD0R94dQ&oe=6AC52AA3"}, {"file_name": "vls_4.png", "id": "1905428140434258", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823259_1905428143767591_1810367736796037563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW2jXMC91owQ7kNvwG3LsUi&_nc_oc=AdpTtPPO2WhHDq-xH1yAkKKgboWE4rrIkOai9T5eyyHMTurQ3lGoANunTuhp2vFm2EM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQG3Ed7ML3-MUUeNKPNsIilpsBpRsYZK8Eh_KJCowEIw&oe=6AC525E5"}, {"file_name": "vls_5.png", "id": "1810067030171742", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824665_1810067036838408_5894057158040355315_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UdkORISzVAQ7kNvwFeAELY&_nc_oc=AdpjDis3nC17uiOCynnd8yjGUNytDv3f59yhJtig5H6aGRo4eVdIcg_s9uQNqRC28wI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt1DBw52900KZpbgEWH0QIj1ne_Kn9gf7xZbZ3KPibRQ&oe=6AC50FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VLS-Trailer.png", "id": "2523335394743131", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_2523335398076464_5880881015743401913_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7mN4uNL15QQ7kNvwF2bYq5&_nc_oc=Adotk_dpNM3Ug57cta0tp3VsmCwD5ndCunIBjZCoaIa_EvkaW0bH1g4-pndnLy4cpfI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpwrQ1A3gVlnHdvKBSavU0aWOYb76qCyzWYDiisiG9GQ&oe=6AC50E54"}, "display_name": "Virtual Life Support", "keywords": [], "long_description": "Virtual Life Support\u2122 isn\u2019t just a training tool; it\u2019s a solution that redefines how we prepare for life-saving moments. By blending technology with proven training methodologies, it empowers individuals to take action when it matters most.\n\nIt is a cutting-edge virtual reality (VR) training solution designed to transform the way **CPR** and emergency response skills are taught. By immersing trainees in highly realistic scenarios, it bridges the gap between theoretical knowledge and real-world application, ensuring participants are better prepared to handle critical situations with confidence and skill.\n\nVirtual Life Support focuses on practical, hands-on CPR training in a simulated rescue environment. Core capabilities include:\n* **Immersive Scenarios**: Realistic virtual environments that simulate the pressure and unpredictability of actual emergencies.\n* **Real-Time Feedback**: Instant guidance on compression depth, rate, and ventilation quality to help users refine their technique.\n* **Scenario Variability**: Diverse situations that challenge users to adapt and practice all CPR guidelines effectively.\n* **Guideline-Based Training**: Adheres to established international Basic Life Support (BLS) guidelines, ensuring trainees learn best practices recognized worldwide.\n* **Assessment and Reporting**: Clear performance metrics and detailed feedback to track progress and identify areas for improvement, measured against these guidelines.", "short_description": "Master life-saving CPR skills with our immersive and realistic Virtual Reality training experience. Fun, effective, and designed for real-world impact. Training for the moment when it really matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuallifesupport.eu/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Life Support", "support_website_url": "https://virtuallifesupport.eu/contact-us", "website_url": "https://virtuallifesupport.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}],
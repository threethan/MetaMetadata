=7f30f&oh=00_AQWRBJpWN01HuQa_A_27pw1-s31ap8m7plCnbg4V-yhquw&oe=6B0F0199"}, {"file_name": "4_fireplace.png", "id": "988074641027883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628446_988074647694549_5171862736270603923_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFtq0yjqEOQQ7kNvwF3jrB-&_nc_oc=AdrkChNSDrV-Kfh0Jm0NeLNzDpYAWPoVCFnTwSCNX38YrdW77SdioQ5Xv6zziwYj-Ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWR9E2mc-N41O9Yyz_cMe1mx-IbAZzmsQadCymnELjftQ&oe=6B0F09A5"}, {"file_name": "5_lakeside.png", "id": "1870104361088292", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593919959_1870104364421625_5608158152435786434_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQhx2ymAq-0Q7kNvwHzZMkC&_nc_oc=Ado5mAW75dhvyjLti9Dr4QUeRzGVZHwhW4RyIVJ6U2bMPdnV0FLniHOwHqumbjPIpN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWm9FYXhyxe0DBjPu5Vi7797k9b9KTJDRIGkpIH72OMkA&oe=6B0F0E6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spellbound Cinema", "keywords": [], "long_description": "Turn your Quest into a private cinema in a world of magic.\n\nSpellbound Cinema plays the videos you already own on a giant screen inside hand-crafted, movie-quality environments with real stereo depth:\n\n- Lakeside Castle: a castle on a cliff above a moonlit lake, lanterns glowing on the pier.\n- Sunset Fortress: sit on an old stone bridge above a sea of forest, a castle glowing in the sunset.\n- Enchanted Library: a moonlit reading hall of endless books, a fire crackling behind you.\n- Midnight Void: pure darkness for zero distraction.\n\nPlayer features\n- Plays MP4, MKV, WebM and more, with surround sound\n- 2D, 3D side-by-side / over-under, VR180 and VR360\n- Embedded and external (SRT) subtitles\n- Screen size, distance, height and left/right with exact numbers, remembered every time\n- Curved or flat screen, scene-light dimmer, nature sound on/off\n- Seated and lying-down modes, snap turn, recenter\n- Resume where you left off\n\nAll environments are included. More magical worlds are coming as free updates.", "short_description": "Watch your own movies on a giant screen inside magical, movie-quality 3D worlds: a castle above a moonlit lake, an ancient fortress at sunset, an enchanted library and more. 2D, 3D, VR180 and VR360, subtitles and exact screen controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ky37194-gif.github.io/spellbound-cinema/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Kuldeep Jatav", "support_website_url": "https://ky37194-gif.github.io/spellbound-cinema/", "website_url": "https://ky37194-gif.github.io/spellbound-cinema/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1505946675926469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628455_1583166250161924_2271262617369379472_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn8veFo8mIkQ7kNvwEkB58q&_nc_oc=AdpwjN3snbgN6PHYMJzJhLJ_1_gRlTRl_re-hXtgYytAyP2nGlJMzmyjAF5cbwaDIE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhRltFlvww3fjqF4HEU31o46BZJ5YmvCL-giubgbBNLg&oe=6B0EEF24"}, "is_concept": false, "is_test": false, "is_trial_offer
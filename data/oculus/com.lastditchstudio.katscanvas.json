4.5771-25/499299922_3276821352526409_1779969629921442364_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAm3gdsEsDkQ7kNvwF3xIuz&_nc_oc=Adoj8id2LIDUswWOsxyI_Re67LlR6bWZ0loWeK4Fb5kqfhoOEAtA1s9DSVw7rN-Of0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkbNC6gQQoftSGVgqklj5pQiEiGTOoCztxTnoHrnWznQ&oe=6A50F22E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kats_canvas_2560x1440_expanded.png", "id": "1032598019214499", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299715_1032598022547832_2137932650318737230_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4IsMG66uEcQ7kNvwFf6EZn&_nc_oc=Adq0LE3RSy8jjDBP8Wz2K-NZVTk3XE9mVs1SsoYWMzWXulbTt6dV8plGktHhLj3z65A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa0mHYWAcEe6fqyboY5LvYanXv9kE2XygnyTgYqcv_VQ&oe=6A511322"}, "display_name": "Kat's Canvas", "keywords": ["Mural", "Murals", "Painting", "Paint", "Awesome"], "long_description": "Kat\u2019s Canvas is a mixed reality art studio for artists, makers, and anyone who wants to bring digital reference images into the real world.\nWhat started as a project for his disabled mom became a full creative workspace built around comfort, focus, and precision. Import your own artwork or reference image, place it directly onto a real canvas, wall, or surface, then scale, rotate, fade, calibrate, and lock it into position so you can trace, paint, sketch, or plan your piece with confidence.\nInside the Kat\u2019s Canvas art studio, you can step into a calm creative environment, listen to custom music, manage your images, and use a growing set of creative tools including brushes, blur, sharpen, heal, quick select, undo and redo, color controls, and image adjustment tools. Upload images from your phone, bring them into your Quest, and use mixed reality to line them up exactly where you need them.\nKat\u2019s Canvas is designed to feel practical, stable, and natural in-headset, with precision-focused tracking, adjustable overlays, saved placements, and tools made for real art creation instead of menus getting in your way.\nWhether you are painting a mural, transferring a sketch, practicing proportions, decorating a room, or helping someone create with more accessibility and confidence, Kat\u2019s Canvas gives you a simple way to turn your space into a working art studio.", "short_description": "Kat\u2019s Canvas is a mixed reality art studio built for real-world painting, tracing, and creative focus. What started as a project for his disabled mom grew into a full Quest art workspace where you can import reference images, place them on a real wall or canvas, adjust scale and transparency, lock them in place, and create with precision tracking, custom music, and a full image editing studio environment designed to keep you in the flow. with every tool you love! Always improving! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://thecybersanctum.com/", "developer_terms_of_service_url": null, "publisher_name": "MakovichStudios", "support_website_url": null, "website_url": "https://thecybersanctum.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1187707954419334"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "851687338011223"}, {"status": "PUBLISHED", "id": "1413018753994508"}]}, "baseline_
9890344_7462638703564018847_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtrT1oPA2-MQ7kNvwGhh_I2&_nc_oc=Adr6AmlF1cCfk1OuUx_EpEzAuivpg26w5QBn7FeU5V1OIwuqk9ASMqiQilG6WQWDONM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAhmfC5EHIRmk83QnM-p53hElpIK4loZef7WZ5bzP8ew&oe=6B070D54"}, {"file_name": "Screenshot4.png", "id": "806857659927563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974580_806857663260896_6785614385867210998_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev5bKIpd_8wQ7kNvwEkC7uG&_nc_oc=AdojrV1DQCfplmGDfTT0DCOZyvzNNdF6u0PpX9SUI6ZexJAhH9F-JuXSD0J3MpikwSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ1kc2FHhOuBE8pTXqWRG8oJVJF9MKI0P4ZJvO8BMskw&oe=6B070E74"}, {"file_name": "Screenshot5.png", "id": "268244461418934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982478_268244464752267_4333674228665869889_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adkIKQayKLoQ7kNvwFd5mZi&_nc_oc=Adok1DCGxOJXv2D35YEGqji5zIehpYKm0q8qOM7rMPGW37uKeq59cfv8T2L6GomRGuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqwc6xslNiczI31PE4ehfeNxLPmaTojfrExrGCE2SAvQ&oe=6B071819"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volta", "keywords": [], "long_description": "Volta is a new way to experience music. Transport yourself into the mind of your favorite artist as they perform live in an audio-reactive world. \n\nIn Volta, the bass of the kick drum transforms into a ripple spreading across a galactic landscape around you - every note of a synthesizer triggers a multi-colored ribbon streaking across a vapor wave Sonoran desert - your favorite artist surrounds you as crystal fragments that literally shatter around you as the sing louder and louder.\n\nIn Volta, experience itself is an artist's canvas - dance, play, interact and create alongside them in their universe.", "short_des
[], "long_description": "Volta is a new way to experience music. Transport yourself into the mind of your favorite artist as they perform live in an audio-reactive world. \n\nIn Volta, the bass of the kick drum transforms into a ripple spreading across a galactic landscape around you - every note of a synthesizer triggers a multi-colored ribbon streaking across a vapor wave Sonoran desert - your favorite artist surrounds you as crystal fragments that literally shatter around you as the sing louder and louder.\n\nIn Volta, experience itself is an artist's canvas - dance, play, interact and create alongside them in their universe.", "short_description": "Volta is a new way to experience music. Transport yourself into the mind of your favorite artist as they perform live in an audio-reactive world. \n\nIn Volta, the bass of the kick drum transforms into a ripple spreading across a galactic landscape around you - every note of a synthesizer triggers a multi-colored ribbon streaking across a vapor wave Sonoran desert - your favorite artist surrounds you as crystal fragments that literally shatter around you as the sing louder and louder."}]}, "developer_name": null, "developer_privacy_policy_url": "https://volta-xr.com/wp-content/uploads/2021/03/Privacy-Policy_vMR_240321.pdf", "developer_terms_of_service_url": null, "publisher_name": "Volta Audio", "support_website_url": "https://volta-xr.com/", "website_url": "https://volta-xr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_play
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W03hvvzUkgsQ7kNvwFHFpeG&_nc_oc=AdkEQnl9bWlCCNOMdTMFy4riTST1CFgJ-K0X4ecDMuZSFPX1oPnVsjm13tzlvkJdBX0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFZrveHuD12Tzz-xdZF6gCdYIFovS-719GN7NvhF39CA&oe=69BD561B"}, {"file_name": "Image1.png", "id": "557571833262622", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75549081_557571836595955_7752800878290085319_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26_DwQ05gZ0Q7kNvwHcy_1d&_nc_oc=AdlbGtB8WbRK33LsofgfenfM9d7VgFZD3dr-yrPi26V56eobl0TErCKTROJt2BHUos0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyE4f3s-EuLjBn6rg86rIjHVeAEdYtz9TNyE_Qskzhxsg&oe=69BD3391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HB_Landscape.png", "id": "866328791671111", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982511_866328795004444_367377865113191215_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcDeVbi2rzsQ7kNvwGF3VP8&_nc_oc=Adn2jR3oavA5mNpnjGzmzTu6FWsWzJvlO3264-RlRTOg_Z8i6prqp_ft-IifDpFVEI8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLWOGhZADBkXWd-puNKTm-vB6YKi_S7TzTGJV8Uk8vJA&oe=69BD4CAA"}, "display_name": "HoverBlade", "keywords": [], "long_description": "In Megacity 13, racing is more than just a sport\u2014it's a high-stakes challenge where only the best emerge victorious. In **HoverBlade**, you are an elite racer, poised to dominate the competition as new tracks are laid out across the city\u2019s towering skyline. With nothing but the void below, you must navigate your hoverbike through intense, fast-paced races against other skilled pilots.\n\nMaster the art of racing as you push your limits to be the first across the finish line. **HoverBlade** offers both competitive tournaments where you can challenge your friends and a more relaxed training environment where you can perfect your skills. What sets **HoverBlade** apart is its unique gameplay, requiring you to use your entire body to maneuver through the intricate twists and turns of each track.\n\nFor those seeking a thrilling and immersive racing experience, **HoverBlade** offers something truly unique. So when the call for the next race goes out, will you be ready to rise to the challenge?\n{3625421424454523}", "short_description": "Race through the daring tracks of Megacity 13 on your hoverbike, outpacing your rivals to claim victory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.imitera.com/privacy-policy-hoverblade/", "developer_terms_of_service_url": null, "publisher_name": "Imitera", "support_website_url": null, "website_url": "https://www.imitera.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "676916699976767"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1027889088789663"}]}, "baseline_offer": {"id": "1027889088789663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726470540, "status": "PUBLISHED", "id": "1027889088789663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27344570458463338", "version": "0.3.1"}, "id": "620593052722561", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Android
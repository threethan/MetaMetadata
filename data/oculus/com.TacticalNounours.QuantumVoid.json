a5-1.oculuscdn.com/v/t64.5771-25/491823910_1793117311609593_2972476756020473400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKLsMTFLJRcQ7kNvwGg4FFk&_nc_oc=AdpbhPEpXzHUyIWRWt5mmXrm9F3wkiceueweJNh-v4yqidZsletxhkkmeR9ymGo1TN8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN1EM9K-txSdVv-29NFVe7Z3EC5MWEByjTndNMAsXiPA&oe=6A563DD2"}, {"file_name": "vlcsnap-2025-07-01-11h05m20s568.png", "id": "1252226376187195", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820496_1252226379520528_3929735633109854565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE83EmIGi1kQ7kNvwGB_2WE&_nc_oc=Adqedzryg1Zb6VWl59E9vfUB-_KVxI1DO8PVz-_omdqO3x9qGT-Elg5MJW8evAfTfJM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLdWYuTrREX9gl5ya5ak-0EYR0jNyIn-h9-KnZn_b0OA&oe=6A564841"}, {"file_name": "com.TacticalNounours.QuantumVoid-20250717-143949_r.png", "id": "1348356873295282", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818852_1348356876628615_6998942205690482237_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2mEIR31ZUgQ7kNvwHX18W6&_nc_oc=AdoH4q3nUMejLzvllk9-rpVbE7cj4XiF8OAq6bS5c51NyopHVK_BkGzzFjAVU9x_5XM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaEIHhSXkFrcQJWGnJGHVhbTYjItLCJ91vHrYFDZbKnA&oe=6A564378"}, {"file_name": "Quantum Void Screenshot 2025.05.30 - 22.47.05.36.png", "id": "1226639872041772", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303746_1226639878708438_2477672931187716274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vgUa-RthCIQ7kNvwE_Crcd&_nc_oc=Ado_Oe_QnS59wkUXoHK89ofAR7RwyVcXS4xie8kN6UWjPPujXAUpNCECc88xfX3Jgr0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbEt0SiKN1eOqz7f6zsxMJN8IK7TJGLmRg-a4Jhe3YSg&oe=6A563A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LogoScreen.png", "id": "1097255365586033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491828038_1097255368919366_2044532415060838777_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbEliz3XDsgQ7kNvwGkMxKs&_nc_oc=AdocT8c6n6SV1xbPaIi_ao2tEdROYgKth1fOSwb6Ovlk-6dz0pH4jsBxOo-abfX7hWc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxyHQiy5I06SO97mbU55RR_Ds2g-ftuXZKBOxBi2ubAA&oe=6A564C5B"}, "display_name": "Quantum Void", "keywords": ["space", "alien", "exploration", "scifi", "planet"], "long_description": "**Quantum Void is a non-linear exploration game revolving around space and dimensional mysteries, all set in a retro-futuristic universe.**\n\n# STORY\nYou are an engineer working for the gigantic CSMO space corporation. \n\nAfter a dimensional anomaly scatters your fleet across an unexplored star system, you find yourself alone, picking up faint residual signals in the area. Find your way across the orbits, explore the abandoned ships, uncover the mystery behind the anomaly, and survive to escape this deadly star system... **Will you get a good ending?**\n\n\n# GAMEPLAY\n- Immerse yourself in a cosmic horror story with **high-end graphics** on Meta Quest 2 and 3\n- **Pilot** your welding-tugship across the orbits.\n- Use the **radio and computer** database to retrieve and make sense of the data you find.\n- Find the fleet wreckages and **board them**.\n- During on-foot phases, **explore and take advantage** of every system of the ships (Electrical grid, computer network, air vents, crew emails and chats, ...) to get to your objectives.\n- You will quickly meet the mysterious rocky lifeforms ambulating in the ships. **Survive.**\n- **Make the right choices** and explore the maps thoroughly, every detail can have its importance.\n- **Multiple endings.**\n\n# Make your next career move, join CSMO!\n{1979887072779381}", "short_description": "You are an engineer working for the gigantic CSMO space corporation.\nAfter a dimensional anomaly scatters your fleet across an unexplored star system, you find yourself alone, picking up faint residual signals in the area. Find your way across the orbits, explore the abandoned ships, uncover the mystery behind the anomaly, and survive to escape this deadly star system... Will you get a good ending?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tacticalnounours.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Tactical Nounours", "support_website_url": null, "website_url": "https://tacticalnounours.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31242731791980787"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1003109228721493"}, {"status": "PUBLISHED", "id": "1837323903814131"}, {"status": "PUBLISHED", "id": "1486735442425395"}, {"status": "PUBLISHED", "id": "1054937916808562"}, {"status": "PENDING", "id": "673814151549216"}]}, "baseline_offer": {"id": "1054937916808562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1003109228721493"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33834895519431055", "version": "1.21b"}, "id": "1445637516020903", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary"
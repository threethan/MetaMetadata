": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lejN48PQYqoQ7kNvwFC93HI&_nc_oc=Ado6XxgvJ3rbWU0N3ioCieU9BiTTNG8eAm90cEOu1sJ9RzsbbTZgpmkaU7c3205Rrt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr-qy9VS9pEPexF_B_WGRHLZZQXmw5pT4YWEnH9y_iJw&oe=6A95D48F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmouvB0v0EEQ7kNvwE7bDSM&_nc_oc=Adoa20j9SrnzXAmMwVKGS8WqjtKmKrxpDBGX6i3G4UsEy3Sth-Qt6BjEh44mJGUfiuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHev8tG60RJ8WvP8cSUp4SD2g7XPVoiumhzItx3Tv0mRQ&oe=6A95DBFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hj2Ec9jNTMQ7kNvwGru38H&_nc_oc=Adrkq4a-Gg8aKsu02Cl9EAYH4M9i87YWRXXlOeB2zKgucaYiEw2HFvxDdlt3Fh48TEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyTF38RX1e0jnrZ1414PiA4DTqvkJZHMLEJyNKAGclWA&oe=6A95BC1B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD8mcNBtiWsQ7kNvwH9MCo3&_nc_oc=AdpYHqc4iK2BbNjP4cufMurVzstfXRz9nQKJ0T2ARjQdNpEJreqNXeVRjHx7Ze9Nu-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnFodE_WJQw77MowtoX52BDJLgf1AZfzcPpw6ewNPrHQ&oe=6A95D30D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35IFwxdA-FAQ7kNvwF_OT7t&_nc_oc=AdpMFWz4WThI5v00hpZ8OXYc_MGDoC8X4n07YZB-LGRBs8H0SDGuMtJ1gqM0a17ObpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPKc63e5eJ_6iY2Ly8mHCusT86MnWBrjHI-iU6EewF0w&oe=6A95BCF6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef_n1erZL-gQ7kNvwHQaK92&_nc_oc=AdrHAvsjH1_WGcgrU8cJeN2uqKc2V_j0kK5UUYZP1WAcHvJjAE69et0sGYxsXGAYeVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrr3EA_ckotzaloGDpjg13aon9G2ousZnxce9JI5l16g&oe=6A95D21C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itXk9TKMfaoQ7kNvwFXPLS3&_nc_oc=AdrzKvPED0aasGjsy-cQw1ljXyDjac8zt5pW1t-1UzM2EN48x0Ox_UkT1FB7-8W-u4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0sFvZtaENyxotPe0tOETS_Ir6yXWrL0hbmEN6B1lWcw&oe=6A95D632"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfqEsKt7RLYQ7kNvwGjgeJ8&_nc_oc=AdoKJ4POGVwIXwhLPUrQh_wOLwtJxU_eBvI6vmUG5SjXmqBDtciVk2NAVCZuUVf34ZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqsndzblv6R9xmYdApB9oz4gc7nK34NhYXDsDXKFdfDw&oe=6A95DB0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
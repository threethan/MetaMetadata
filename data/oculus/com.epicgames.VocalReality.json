": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5WtXjc_IN8Q7kNvwEa0Uix&_nc_oc=AdrIHajOCFpoTbl3ciXeekhHZvqB5z6JBmLDPt1NCWzJTY-vIBVg4Nz1VXHDYK2Mrbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5bxeqWn2MhwtUwK8ydoie-8-QCPGIaOgNqZ3jjTrtDA&oe=6A789B4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0_gmd-qkssQ7kNvwGCloMI&_nc_oc=AdpnoPZosZiuGTnwK4Lh7Bo83kYgZQD1W2Zpu68Vi00T7Q1R7RV0fLPw1aYo0S6W5js&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4uDKrkvrAv-t0Zb3I4PsgCQ5x7SF3ahbKjhBzW1Qs6w&oe=6A786A7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvTN4cJUut4Q7kNvwFaUb99&_nc_oc=AdqiUAnsZ31anIp3TPKKZz0bA8HDWDUKE-reCh4NhK5KAYq3-j5LRiJsfihqH5byZS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtHYGE3SY-DsZqsvKJqI2Q2-StfnxWpBpCmEn_PM9zzA&oe=6A7882DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K48l7ZU0YOYQ7kNvwH6mRHz&_nc_oc=Ado6rFRSVFvnvBO7z_PrXvobytJSSYFCxA7q63Ie6OTKSQg44NFHCWcIHYrz4oe6FMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaMC0QXL6IuAD58oY6_Vxurc31xews2jUx3bAnDykPeQ&oe=6A7899CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbyaLbMoE6gQ7kNvwE-1e1e&_nc_oc=Adr-pmz6zobipY-5T0rQL1HxkadRTXGm4W_trrFW3ukd6-Gd2yusFemlwrJjzrfkCH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ2Pz3kr9pC5TgDeXQErC9VIVLX6tNZFIrXUOm1xR1aQ&oe=6A7883B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8DQbzJE5kQ7kNvwHd9O1O&_nc_oc=AdoIo1Dx6iyr5c95Zu8oBzLvbB-QbAV4ZyKXHdVb6mx8q7zj-AUquysKRWW3W_u33f8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1UtFtr5JMi5lypsmXpP2RbAvWLNZqx-5PeBisclDv4w&oe=6A7898DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNt1mm7larAQ7kNvwFOlopK&_nc_oc=AdrtfRfZQqbthgxj-cn3O3ouxTqP5NySCfqsrQZNbUeuL8bHBLulEUuYYdGLpCuuA7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZHuR4OtCiUxe-kqE7bgRrguKHy7Pj8XT5S7kuinYvSw&oe=6A789CF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0h8krDI7nIQ7kNvwFd8pjN&_nc_oc=Adqy9e8F_w_HsDn7FNnF4aUCALJqXmrnU3Ne3AJc3Ep3a5pZhhP85F5mfL58ltvRgLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyahAlIcroTXx07_goW_pO_VKdmGcUgSNhGuU1e6uLDw&oe=6A78698F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lsa3j4JOqmcQ7kNvwGhQEDL&_nc_oc=AdowNzkUgPfilF6Kcci7DP9jm3TyvhvUlPGzQsrS1i57yUrFryEzk-PnArkvK2cSclg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMp8GpnNQ9ykE1B1556bHo963MbIV9lbGieE0mMtxA0g&oe=6AD0EFCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgy83UseTDcQ7kNvwFfr9gz&_nc_oc=AdrPswJjr02dQzetqerJj57uZz_AsSOEF8EUwIB5UU9qdXQ54bIvyfENp9KXY7kFZJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0NRifxqTWt1yoem0HNw6b2b6bp0Y6-4lOHJuGzm66zA&oe=6AD0F73B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V39JktckqNYQ7kNvwGw-bEX&_nc_oc=AdpdFjFiXBkrbnSjGV6xz01Aw4_Ij8WmXc-ojMsUAJfWu2hNvUBQuJ_g4_lXX47hy8g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe5UWQqmozop64p1AeBaD_abXFfF7v7X4cpX4EUGd7YQ&oe=6AD0D75B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuoB7qLH7BIQ7kNvwGtCdE4&_nc_oc=AdqWpucyPgjOO9j28uZwG3okOIzEPUyf6V93TGby7jUIdF2eSqsTFh0vfS8qG6QLJNE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObFEWzvfy7nJDFHYytixSaQ0tv38EGRUGiMe5RLqtEsg&oe=6AD0EE4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL7y0ZbzxB0Q7kNvwHGrtpf&_nc_oc=AdoT371NypKSpfedeHQzHijCbkf4mpRsJqSha5dUnaKkOPDSKE81MdlqmFMi0LWVIU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOAKtkInSZUQ30fSKVixm0NL7zAvVQvvuKtDVHmfQENg&oe=6AD0D836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-XqobiNksQQ7kNvwFPlw1o&_nc_oc=Adq4jpvk9rVLlw5xeWsvqEylgJr24E5Crse3VPzlDPvu-aBzFHSFTGMeiNbSATxwR3A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYa8tfqxRTjJo-Wg58DGHHrp11X0sizsk7FmrHnrfuuw&oe=6AD0ED5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah6QILNhE3QQ7kNvwHEz0JD&_nc_oc=AdqQq7dogyP-G2J3Im888yRi624lWXu5RA7trK1mdFh7Az0ZHwGAlf4X2GXQU0lt0Bw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPptRClmCX3clg3Y_PNAEjVEaCN9GMRyQLCjp-aJLzedA&oe=6AD0F172"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_Ccez9_McgQ7kNvwF2HWG_&_nc_oc=AdoOVEFXVcVxsPG3z5MLWi_-cg2bw5bJJhMxUd6TOw-HOziiLkO5OjNUq30TjOH7sAE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiBKZlmXUC1S1P6uYy0Oh3Ld5e0l7aBZo6nyaytfFVqw&oe=6AD0F64F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lsa3j4JOqmcQ7kNvwFi7_Kq&_nc_oc=AdqvDMbBCyQZ5jHBoL2KhkGtiBzsKoULfbVyepoN6QNG99wUMusrS8siBRT6KwtL_aM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOej3V1Zr-GbUrRQxboPda3Wqfz2hfZRv05NNtrdQluaA&oe=6ACE4CCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvUMuNg0x4Q7kNvwEiu-ok&_nc_oc=AdrnY2q3cXaMRn9jCp4U2HEMDW4CWZZg0jZtFOVRGX1_dlyz16QVNfNCN_n6-zDxRg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRaAqxt_XgJo5YZW-FCpj57cQnwzmjSJdQf3D8h0d1Ag&oe=6ACE543B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBkCoiarVqUQ7kNvwG20qEi&_nc_oc=Adp5Pfc9wC-nma_pqyS_qJXbPhXhdf0umuxr36gZTIiHccdiegrsal5IerkSrnCpsRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6wqcZXve5YeMOgKArxudHRJ5BdC5R_aJFJTDws-sUBg&oe=6ACE345B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuoB7qLH7BIQ7kNvwFkkoyb&_nc_oc=AdpCGvgeeFdpOO8NJBR85yoq_dJpLD4M5zRYyPHndx5f2UjH8tpTTP8LDf35ARdWaHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc1P3Gu1z-hcaqpgX7_cZQTiTxN1NWjLhV62DlTdtgaA&oe=6ACE4B4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL7y0ZbzxB0Q7kNvwFDzl5J&_nc_oc=AdrckaxyhlLiewpRfbI7h2DgCMoFCkSBEg1AhueeR3T5MX-BeOhL8ExFZtSa7Hyem3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWPMm8bMDIey2nmbaS8UdEE3wOPyEV3aufqTeMEJhW7A&oe=6ACE3536"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRK15abqex4Q7kNvwEIEHgE&_nc_oc=AdqMRvy0L2v07ve7Gbjgyl_tL6gsAAhZjpiw7cYlbZrji4vmhqg3FDbmvOaRqlcArnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF801K9fsnZU8bnkz9ZRbYMJBW4nr2OeVSn8cwab0Sig&oe=6ACE4A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsVPD-kbKiwQ7kNvwFXGCEs&_nc_oc=Adoxk55WuvN-oV09YuyO4oToPPFP46BBszBb-A-MisXpbo7siGIXk-lzLadiqJ3V-Fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOECAWYCT9kC_byjYR_YVAyY9OKJXdNWgNDlX7phI0Zsw&oe=6ACE4E72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_Ccez9_McgQ7kNvwGI23aF&_nc_oc=AdoDsONytpb4wNqzdURdcZFUh5goCxzZqWXHpsIwPzkDwTmQ4rxE_DY7f_mcFTjFRWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOOCOsH2SWTDW0XM_s7tC0X11mh4elmS0H3MdLn-HUaw&oe=6ACE534F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
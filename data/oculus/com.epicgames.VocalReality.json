": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no1mpPfDQpIQ7kNvwFP7Rq_&_nc_oc=AdrerHaxFL2f3OOBwIqPCjHG_doObleTwx9t97McOiI0JMvmLA4Qv3418QWegQRuWkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPVB61HHkXijj8Ag3C4_CoaUNLDlkTqCldZSJptgDDmQ&oe=69CE518F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6U_loYBu-IQ7kNvwEtvL08&_nc_oc=AdpdhorNmIM61kLwJrN1xGzqXpcmFokwX7hRcM8BsGSLYa4OCzmT8jOGr2H01akTDNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv_Ta_1sUVQP19vkHP3KyS9Y4WgbpRRvsB5f80_3dTAw&oe=69CE58FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmpWJT2behYQ7kNvwG4TSoD&_nc_oc=AdqZAhNBhy-nmNUaLYBYezQAk028-l35o2eXR90_Vb-tZl771ck6gmr2vepCU1ZGxpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRYJZtaI1e1Qq49Ixi0CaN33gs2vS06fyFinWEE7m16A&oe=69CE715B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3YUmlpNys0Q7kNvwGum_u-&_nc_oc=AdrgKriK_kHVBCnazOu7DZr8Qe32BIX-3nCeyOHuqVsL7e6VhpGcCYol4Qy4GwpyJJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmHFHpFr3_bXUsA-JB2t0w5EpNNvUbjHFTqz_P2iKDpA&oe=69CE500D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKqjJQGl-YoQ7kNvwGWYx6D&_nc_oc=Adqula_HgRn2Op6vNEv-t2a6uj-_HUk-532tD46wIdsQHJT8shloX0cOOtSKSCge4bU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVl6cyDe3dt_eJvkWTkeUssg9icjgTw5fAC9hQhl0ROA&oe=69CE7236"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-zTwBE9QUEQ7kNvwGzAe8e&_nc_oc=AdpCn3nlKiiOMKHpJBQCTvUsEfasdhR9LKgyf-34VGcY1RTTKY2xES6IEMXPxOpr2ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCenoSFG_GIFP8oX2GmCV8XNA-VSSlqhBym0JzaB1RdA&oe=69CE4F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn09aUq1hWUQ7kNvwGsCM5e&_nc_oc=AdroznuKbCnhF7ggnviDKGsYCQ3THnC13lIzJlrMGj2SYgmelWhRhjtitG8xEI_QHl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLsySoq80MQDAGLNV55arCQPdDtFbreBRIAptp_Whbyg&oe=69CE5332"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlGnbEOHNowQ7kNvwHEDTnr&_nc_oc=AdrqFHRV8STG3JRJOpD6SwFc9PVq4U_0sGKEBgVYW62yiZmLOMoMjV1s57MYBWY2fEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ0GnCniQf8AECqMaI-mIaWGtEhHFCWO63v6uX5oIWHQ&oe=69CE580F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
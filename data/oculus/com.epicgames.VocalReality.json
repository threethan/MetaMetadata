": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grl0Sjp7wm4Q7kNvwEZMtnE&_nc_oc=Adpk57zzLrx8lNIdHCbhwutSMSkT7Y1A3PWtv13BwgQZ4ph36hyueVcU7tooBcy8IgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_g2yiSG0yEfEqHvOYAsOHz8Q9U4lr9Kab1mjGod0-nA&oe=6A29814F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quDNz-pfMOQQ7kNvwGt4Adf&_nc_oc=AdqLmHN39YIjwPFKaXAkfMN7urp0bUvVD-f06CxUbX1gz7psnrbVJNMrgUQIhKvl1Ds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bg-ErKVSyiOGctYLfwAuH1vtJHD_8l8MkU7Ou6zB6_A&oe=6A2988BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1lExa3K_KQQ7kNvwGYoOve&_nc_oc=AdqIUGAaMQ1obNJOXYY1UCPHrOpfVNEN5VyaOQaU1xcgqO_T3CQSiGVQgcKkqje5rpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gB4lp7jJu0EaGltMXN8-7mt9ZLsGpx2j2R3LMe-YsQA&oe=6A2968DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHRyx-ZNPygQ7kNvwHECJQD&_nc_oc=AdrMgrxrimHAdcsPrCP-HPNJo5knBXWalS3vSZBcN08obbKMXxIb7Ex0mhdJiE2vM78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ksvk0vc53c1zfww0HzzScT1GyFpEUM3qrDVbUQEVFkA&oe=6A297FCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZX8FNrCqb4Q7kNvwERaucQ&_nc_oc=AdqzEUshPozpi8CUEu_OOgmZLgAy3Zn9tE9mHNwoMtBcYvx3lYcTnzV8hJfTy9ntPrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wAVwDsApItlmhkSeyFBK6qeripQynYqZZSGyeadpmhQ&oe=6A2969B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JKEn-CVXsIQ7kNvwEsxK8N&_nc_oc=Adq6q5gxKabVf-BLvTn2BXK6IOrFW5WUEK5jlJFDAixMkHdghEMl9J4Fgv1SFv4S5ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FsSSFLHeGROIZFtZ0qRy4ss8cxsc_iH0c9BuIBGRbcg&oe=6A297EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ6c76QSBowQ7kNvwEUAElw&_nc_oc=AdqBsUr4mliZv82yDOSJATAId54c8qODMwAWqPAzQe5sgTxBiWrYahu7KF1UgLSQB6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YIFDDGHaj4j60igGLYVmCMBNf_92KHznkzP2I1SW4GA&oe=6A2982F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N7lzx5FrMIQ7kNvwHKnKlf&_nc_oc=Adp4r48gEfplgIOncmpI4FNh4sUBRvaELg1ME71XLXEo_tl18RWjk8bWFkcBspwpAAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ke5y3969xi3-AB9kEGywH07JEi8JAKmKRRy8miGQeyw&oe=6A2987CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
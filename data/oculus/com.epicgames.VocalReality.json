": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no1mpPfDQpIQ7kNvwFomYC7&_nc_oc=Adpv_-VIrZpwj8PFiM-hRHfloPPaut8Y9mt9PvEpWrO4ZTaR1DhEqj8kGdR-rLzR_JU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi0HCj0cxsGPeklGT76w-_w7Iz0vTCUNKlA7_D6IBXPQ&oe=69CFA30F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6U_loYBu-IQ7kNvwHSRICK&_nc_oc=AdrAFAaFFK84NFWstOghbfbUpvMUSmy3MBp0pPnD-ASAx2IG3lPqVo6_uWlnrmNZaYw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTVBT_UhGauAUvMHSIQIWeOMQxA7bDKhIBzJmAcymw4g&oe=69CFAA7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVZ3xz_G0vkQ7kNvwELc9kJ&_nc_oc=AdofV63B6q4ms_K09T-pOVaNJaDuuSdRsTUe6ih96NvYHc055N6oakIuyU8rqJ5wpXE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziSVPlG5F2H9Kh_8MBh5CnzLWh6KXJoKLa1HjTXTa-Yg&oe=69CFC2DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3YUmlpNys0Q7kNvwHzLQyz&_nc_oc=Adrwlbrn4gcUAyqyLaBegQSUBwsY6MsluJvjp5XZX9CEKgeLm0v73GrATG71aszFIH0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyExeJVRWOyLBq6Yonib7UyTRVRqL_5au8jmtzhAUechQ&oe=69CFA18D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKqjJQGl-YoQ7kNvwETrAj7&_nc_oc=AdoOQv39dn037V29t83YB0lh_OCDV5xowi58bCDo4sa4tXxt1Dx52OOER0X_WQ-f-IE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY6XKVNxYkX29WJV8FWc7BQNOiYNqMI-7td6-tdtJ5Kg&oe=69CFC3B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-zTwBE9QUEQ7kNvwHlJuY3&_nc_oc=AdreknaFk_I8z4LlTqUSAfTmHSVBcCdtlw2kJq8ZMHNFmsB9CGybRDvDVhGmeTZlxPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afym6W1FVHmjJ-0mCu5mX7UvexYBdnQqvEMTG6lzUxS2LQ&oe=69CFA09C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHKnhyXSalkQ7kNvwGIw0cs&_nc_oc=Adr4oe4VVD_rxw3LcmTjDpAh5-uwiJSsJYBHIfkhUeBn--nACDe6cRt8o7-oI5Fnh78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4g6uCeN538FPGDnRmtC57vKAEmsbAwy_KMwjes0Oj5w&oe=69CFA4B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlGnbEOHNowQ7kNvwGKyEfz&_nc_oc=AdpFBqpq6FZX6d2bBXf2QxeysqaPhXoxkg0QrJhBVycof4TCemPUR3nDYuuJjQhRS04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTpIhU8PlBAX5zUuJWINb8Hmk6KKekuS3t3BCLAT5cWA&oe=69CFA98F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
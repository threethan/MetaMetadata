": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VZX5ChxE8MQ7kNvwGgBdmU&_nc_oc=AdpyjngmJoz1iZNnPjWuK72mXIcRQiFWEXgHTS5vb-gWeJvqV9OcQTgGcU-D3m0Dr9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_KgFQfNTtBrfJP_c8E7c7LDVuqa2v7crRKYsktaGciA&oe=6AA0284F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=133_u1vQI4QQ7kNvwGELI2T&_nc_oc=Ado6aJFqz41uudanUhyilyim8rURzJIVMHy9qOX5114T8k1dudj9ChZLxabTCy55EKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCyMgcrdd5G9GLx3mHl6biMabzlHfsSR8p0iFGTbR1zw&oe=6A9FF77B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3Mr0XOiaxYQ7kNvwHfzYM8&_nc_oc=AdpW53QwDEhSTPbwsMer7qkij-TRHAQt6N3U-sAW08IHf0FH9_bVwBVaqPUlfLXgl_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9d-I6vllKj3J74LSOyAdneNKDQyooK5mKOstZS33efw&oe=6AA00FDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY6QFd7eg8QQ7kNvwG-nQ7d&_nc_oc=AdqIlEjA5KhPtFT8yn54LQdpQOxcD5jQDq0Zge0HhrHf0B78Z5o5WdrsgLy_UGVaByE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg7lveWSLRpYd00emX1XjU77IDd7pq42u5liudLxY5pw&oe=6AA026CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6riUbutXO4Q7kNvwE-_cHa&_nc_oc=AdolQy6uNn51XzPy2yt75zYZ_Nf2bMD77CiuOrAM_f3J86R1oKkwA1eI9OG58wjakGg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmAcJacXFzd7T0tizoMdj44LU2_YibtjcStHVa2uQIzA&oe=6AA010B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PiESha9BvcQ7kNvwGh_dGq&_nc_oc=AdpxYScQlfbNcpUo111ypUxHLDqEv-7fXsAC-EdCbNN70wOmFjl5Mp4knl1utiY5lT4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6zuyDjzt4f_cBE-UJ6KzDaG4OIf1gYBNGNFoSXYXKWw&oe=6AA025DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FINjk_1e5J0Q7kNvwEZ92Eg&_nc_oc=AdqJ6tV_NuAc3eIhUNu8kw2FB1FMBMSAIvfOm3Fh4lhBxGv-GK9b_pYQbRDwX4XOSbE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdJ2RhmONbKCXC-IuE8wRMjlcamHvFkTLyTrisEIGZLA&oe=6AA029F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2fPiOlxYXYQ7kNvwFlUDUr&_nc_oc=AdqxqaYe3JmHJ0_wzJ_OzZFTDRtMoM-DkRLX-HWWN-hpGpNCeWxhmYPYRPOUyE8pg_M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxFp3hcXQ-lIni51cOIOnSnmrTlu5m354ruUY_g30mDA&oe=6AA02ECF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvdlOqcED3oQ7kNvwHKEUvn&_nc_oc=AdowXWCnrsTrEhYDOkHJ3tEJsU2kJx7cKItXMKV3tRvATipOfaHS6VCIXUO8N9lRtYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPRVtzstR2siRUtYBPWxOczZkMvpG7dLdeZC8_QGLtqQ&oe=69C3C58F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIt2dY29b-0Q7kNvwG6LMR_&_nc_oc=AdpbsIEdu0hTGo-axRolQekgLf74v_4GJ6TQh6yXqlnPjMJyPRMm2emFYnPapDtOxrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWd9aLuJcUYGnn8Fw2KLOREi3817rfUjz65k1UXoW3Rg&oe=69C3CCFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnvbmILAXN8Q7kNvwF_dQrT&_nc_oc=AdrfFcRkmbxrskslAusHJ__1DxndMq9ijZHXKTuLFBIivAXD9VEaiQsC2_F4K8TQI3g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAFe6LtMR3HPce2QIm3e1KRBaNWYB6BUnsxNJpVwimng&oe=69C3E55B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDtI4V0yAzUQ7kNvwHyJiCC&_nc_oc=AdoYB1gUoHFUHXOHxUzTw3hftIbI25PbcTc4Bg2e01eVDiMIaXoFcK42WLijkzXAhSM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbeKZJq3AxBPewD64BTrNpzlM7y72adZIMuEab_plegg&oe=69C3C40D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw5Vl9hFBO4Q7kNvwHmVGQV&_nc_oc=Adp4iGrW5n2anzWjkHUu47eX3DpUpeViH5HkOhemPktxTNWAVhOfxYHqrDM6by4dWio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN_1XAqmNLrplVlR824Of1ZaRWaczUo_G056uefpq_PQ&oe=69C3E636"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkPVSNHc4HsQ7kNvwFkQZMO&_nc_oc=AdrQ2fn8A8vOoBL6C198yXp7LM67NUB9R1gz71QZborR5Xxtk5-CZKscEHNcb1_wdpA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVW4LrfLwD1_fxtXomt-3YJ9JWXNVyShdOCTrHywOjiw&oe=69C3C31C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqFWrV9_2boQ7kNvwEGRCaI&_nc_oc=Adqp85s6tg_Rc1ds6SpVdbGXi_4BZCdYHOMomfOR5d2klq-2KeeeIb10OhdpLDkZleU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJYSfUk3U6XuJWDbFTyBOWaukBquxchtjC57yTbEdmJQ&oe=69C3C732"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I7TBtrxZ3gQ7kNvwExOmz4&_nc_oc=AdpfhWQ4U2JgNZbHz5VRcDCbMuvI3pDrhiDKuGIhpZn1uUxQlJ09V5jNrO38unB12m4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5ArJ2QH0AxgLYwNqajwtSRj81YsQeFpzUdBYH1ojIGw&oe=69C3CC0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
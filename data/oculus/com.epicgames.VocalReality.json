": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwmdo3E9d-QQ7kNvwFmg6sJ&_nc_oc=AdrpD_kMrzXoWUdQpV7_VceIBZafTPoomv47zNQlPtT5CohZ-FLHxqvHOuJ9XQF9Voo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKhC0ZSyJBboQajM-TJA8rPyNjC9ljpCkpiZFVwuBEOA&oe=6AEC9F4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nl2Rdf5ANEQ7kNvwHi-xks&_nc_oc=AdqlndLBDaiYiyaPlQCqdnyncBIXyIPPgrvdPC4LZaJpBwFa_01Hkxji0qRWrdzo2L4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkMkN0_VZhfBAGYxk7zSrdzhA9bxXS2xJ_2MbrdSj-gg&oe=6AECA6BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPu6a8ci7voQ7kNvwFRnYGY&_nc_oc=AdrdN7w0-IxPBAr3vwX-OVczlmavCHVLi_UySoXjWOMmg9HCZUtso0GV3dUMpM3Bnxo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLFr7XKQUSEfNZ8jrRw3gwoOQ0h5ZpDpIw3ByBnBp-Lg&oe=6AEC86DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOj68fm2z8Q7kNvwFQR-1M&_nc_oc=AdphAvqMbFJ_IoLNMEcoYoNtxMGeOwlTkGg0Gi4pwiHzwlJADnX4TNu5UdltsHFdh3w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ72n0oyR6aDJS36tDk77vDD09OJXsaAyNKCxY7MVVsaA&oe=6AEC9DCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGAMT5q6EywQ7kNvwH_2fhc&_nc_oc=AdojaLTh_1LTGwm4Cd24WFkbR-HI16AIyI4Qrw7MUwVYWWbaWJlVADs5EyGTFoTRab4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Jc-qIoklZLtmkwNzXn1IqF6_loTGZN14thStVbDHrw&oe=6AEC87B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbRngSdqKusQ7kNvwGRV5BJ&_nc_oc=AdoBIWRN1lVAf8WGx2zBc5liEUUCj4NqNmJ0kJryMhDu7LpjJ73Ikbf-UxpVOxN0XoE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFmqJbjdhUiut1EyXHqtY09DHpjTb9Y96raOXAHkq-w&oe=6AEC9CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0pB-YIu-WwQ7kNvwEUve0L&_nc_oc=AdqzcF9TbqMNj6--aflD3rirYErbC0p6yAZCzTmuGmokSQpJhvkmBE4LPx02oWtuoUk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTabHd6d3Q6Pv5ttht-sS1Es9p0BWMED9JgHHHq5rndZw&oe=6AECA0F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFMBh_z-WfMQ7kNvwHYbtyo&_nc_oc=AdqZrt5JZkJqkWfGQD452cMfmpd7EtpRXKPIZJ5ur0qYdxqlrLJskasfyL0Rnqiq1Bw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHVmCqCG0gJmIRilH1sYgDK0q3SYW-b4LrFf9R3JZmBw&oe=6AECA5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_YFqp13cAcQ7kNvwHj9L5Q&_nc_oc=AdqJxl-79Cf_hgGWh6aG0QszaYce-f-L_x4rCCANQEeQmIHfoP24EAsYMIftvRYJ664&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsK2d8xZmcfzLKv7cuLKp4YzpxBRl-1ETXFAaiykoO5g&oe=6AE607CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJylQNqLvu8Q7kNvwE0mmCN&_nc_oc=AdoGUIwuvHPkqgNZiEHoTSUQ_MaNTsZ91PARPujtxtCnHneHC0atVFgJ-tZhKqDwxq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7nv-34L3gfXgNA5eTrc44zWZyxQBtKQ0dzBsnNxtzig&oe=6AE60F3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDk6GNmAAVwQ7kNvwF4lzTl&_nc_oc=Adpr-0AphHu3IE1QFQFX2VBjGJHaYUX7yg8F6bV_5eQ5ToUO7LugFE1vMiwJxt-GrOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI5AZEtxAuBmfGpz-lfiDjysxZXC2YnVmC9XATqZpydA&oe=6AE5EF5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUroTD0aYLYQ7kNvwFOYNXq&_nc_oc=Ado7qYvBbe2xIt3N2cfaYeZtag9eInvSzZnsJ6u_UmeWN-DwBotBJoQ7RBZvZv7pyc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHPOprnu1he0pEPtp6h4DsScBpo7ptKTj8a36rltvAFw&oe=6AE6064D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezTVrRQzkr4Q7kNvwHpu7Za&_nc_oc=AdqYDxGj3FF3aQd6iN36h8xDLkQuswzPLIsCvmzLCO82JX_-_OsyFbvtBPJ_1Yx2fxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMALrjUFVG4kOhr_o4ky-U9dn0EHo8PpFOtMb1qCSHEZA&oe=6AE5F036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eeVU3jO9TIQ7kNvwExlj4F&_nc_oc=AdrB-D3JeKqTHvE0UG7Vlt8iqechNS4iFQj7BuDu7IrhZIo5SZGobzBzC48vkbwka8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJy6BcnHtIX8BLN2WE1eHIzHxGH-6SWSJ-uYGZvufSVA&oe=6AE6055C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3wE02vBBVYQ7kNvwG6G4x-&_nc_oc=Adqy18R-UmO42rHVVXa5UG0bAJzlK731lrTV0hCzVfjWmow8OCooe_KYTengKT_e59I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjBHYAJ887nSrJrfNlvCgC09_6sHiBZI4Axs_RNEPiUg&oe=6AE60972"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTKjLqTcYHUQ7kNvwEmKQaP&_nc_oc=Adrom9VQ1kjkOe7CVXHLXL1oe7CjiXgF0hbCm53fU6hBPSmjWvkFBBOpbxwXV_wI7I0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy_hLeKHD5KNHgXNU3rck601h1Tz11il_eOmCDyTafFw&oe=6AE60E4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
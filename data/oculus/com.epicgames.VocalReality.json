": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8ReXSA6wKEQ7kNvwH6rhfu&_nc_oc=Adp0P7ZtIXC-NQOEC7XIFhqh-rz7MIU-O6MNth-giAHeCje2SAugpkD2WcmfwMZqj8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l-cezC028zlSSOZkEEAYAfcrmYqdXEia3GXwJkzEUjA&oe=6A413C4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwc3dOf__3QQ7kNvwEVSfqO&_nc_oc=Ado5aix7mqTMB83Sa3iMMgbRdAqW70UEHAWmEbwA-mIxc7tQmVZkrjF8Xn6oZdrNs2M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pD4VCpRhkOlzR6IUlXLjArK-nHbTBNrMQSQDLgrAb3Q&oe=6A4143BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do4BU9uHjcQQ7kNvwFnlXYQ&_nc_oc=AdoA1cDqIbGn5eh4VjRlfU-IOgFn7nyzu9g4S6oP07YTf7KJjUBOp_f8PVmRxUa1K8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NubEKouNBlM8VYDZnhkPEvZl6URiGqiddfix4IvNxAg&oe=6A4123DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWHzwzqH2ikQ7kNvwECAyvf&_nc_oc=Adq82ee7vOePvKUWSTIUwUHo_Dr2XdORCFqlO3N8mnQHa6WoWP5h0khKKQDUnb4WagE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83gKs5CP4HETzcL-FikaQgFIjg7ewdYjTSNEGXIuT7zA&oe=6A413ACD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9QdDECBwvYQ7kNvwGRxN32&_nc_oc=AdpcqRuZI8xmOTzOZLM6cLPf1tqxeNqnTAGc6Y3qUkTyLPM0VTyWfVbDZlzncBri2M8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80XZpiwJj7yHoFVm9RxdP0fTeEHzlZvcdS57A8xp9wfA&oe=6A4124B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tv3gRHhNGAQ7kNvwFWnZQa&_nc_oc=Ado1gi9FPsS_G_eO4M-5j-X9f_6hObouCxvyBXtnQ9tRrng5WTW4dTg3a-ca788PvN0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KWOCc-xmLXs_bDurOig6iuoQwEkQaUgRLJfEWG72hNA&oe=6A4139DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ERSYsruswEQ7kNvwG2j4iO&_nc_oc=AdpXpEKxX5rkxFlPskt-VQ26LbWbt-mrHU2-5fkOVMjmpe9D6FFEPD9tnCAZXXJeQDM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jdtkQZ-k_1WvpLnjoLtYDpfuiMKsPRUdo2WeTBLN0vQ&oe=6A413DF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGf9HOzWPL4Q7kNvwG0gQm_&_nc_oc=Adp3pdpEc1D34nXU8U46QMmQ4ndDyTBZufXAbmxPEaaPoVRr4AYwveGLxfCucQ-647o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X_y1tZxuVg4YheK843L_7gOv56jatFy_-eFgK1xlkbg&oe=6A4142CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
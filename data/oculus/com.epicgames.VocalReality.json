": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxhidUwoKmcQ7kNvwGmX-0J&_nc_oc=Adqe9gmVX_CU5LWeJFECNd2TtbKoKkKOGcx2NLr1U9hM7dg9NeuVQTsinsIIsvxUPUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXAdxF9tHm3KqEA-bKTuOg2Dt5FnBfBa_jwPNirRVfUA&oe=6AE0C1CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji297-FKqH8Q7kNvwHbprBQ&_nc_oc=AdopB69AS5_52bEX1-XpltZyoD4B0BXjPMFJUWwt1ib_pBHebv_zZZHRbF9N5Lwztu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXwF8-BlXgNa-79474lsBv7SuoTuwFBY1v5QH6kPI13Q&oe=6AE0C93B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuEuI5xHjg8Q7kNvwFh9aUz&_nc_oc=AdqdoQ9HTRPnHt9QJX-QRQ24Pn1LWMvDPzmmx7q3OYV9P5iQL-DQLdfdgEyGzVW6tOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMGejwRrOb6GdW4Uk-ylI6_9WOuUG--UoVVrzBEz0hTQ&oe=6AE0A95B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3z_4Ot4H9gQ7kNvwEuUu59&_nc_oc=Adpkdzl0Oo5UoDEnCfmVuBR1MgPTC6EqgOeoqavSFM2KXKaerV4Hk-BY9x5GWUG9eOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGQtZouCs-18srgOgLvY84qBTaRNOiWLP5JuQhKIOM0g&oe=6AE0C04D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMWFFnP8dN4Q7kNvwFb-d13&_nc_oc=AdpLfPhpwD3051nFUm2JGuKm4tFOwOR9mIEMYDNU34V4oh4tvt3LlzWsdqsZA0BOGVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFLFQNfJvz1iv0vOEPdwWKomz5OhZjDstHO27W_VD65w&oe=6AE0AA36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyGfrw7YPfUQ7kNvwEvEn4R&_nc_oc=Ado2OqN1pEyO392g51FD0t4y7Z_5Sm1x85Xxb-V1X-R6hhYw6sSS9rVz7AXcCs0h4ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY-ObwDNDj8PzKNb3TxJiR67cwcKdsocvhWVv2nqG0sA&oe=6AE0BF5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyHkV38qADoQ7kNvwGu3Puq&_nc_oc=AdpM8xHH1Na4mg7yW4XfBCswkAk7dxbspJVxquhxEIi6OZS01Vugf447mz2o8g6ZJpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuL3YLqhQEd1yVnYV9xPWnzH8XX0tUt1OOiw91goiuPA&oe=6AE0C372"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EQ5Lz0OYIQ7kNvwFxL8Ky&_nc_oc=AdqEQt-xXmIsV9N-nFgWH4D1ES4Q-dfzrI8AP0NIVJrCmjDCpF_ybWi9VlG08RYnG54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrGumQpX2KOeBbREIhprd71WoQKq5w7ftTjhmZvsHVyQ&oe=6AE0C84F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
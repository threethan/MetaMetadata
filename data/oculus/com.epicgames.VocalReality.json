": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPANMbUOX3YQ7kNvwEvVzdC&_nc_oc=Adqv1341ga5H2YEgdAeNYtUsGOX_UWU1Rh1uxA5U-13n6PiPI77-lOl8z37VoaMV76Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBjwUaCgXRI8BF1OFGUlPRvqFbxI7HOmXsAYqh4yvXmA&oe=6A983F4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVDsLg6V8c8Q7kNvwEjzzHJ&_nc_oc=AdrFEVg41OY70mFei7mgnjLRf9E8_APkU0jDuj2QDLc8IuX9XMaURd0gestviRNzb7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJZsVwmd5_VrCSoBwmIHtUbrZs9BH_i-1KyEiF-HdkOQ&oe=6A9846BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hj2Ec9jNTMQ7kNvwHQQqnx&_nc_oc=AdpC51Yc3MwDnbp2y7el35fcBOEg9ydVM_7lZ21o72inaVq8OSzcj8eNDQFKNAIYINM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeKxGT707dctyFkEJ_y-4Qdryl62nPIEbnhhtNFDs9Ig&oe=6A985F1B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21VMcCfyYCkQ7kNvwHI1526&_nc_oc=AdqrZ8lLha6ndddx952VgCiWbMDHDwwMwjS38haSapdS6s8hFowUWol3l_zod6cf3yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLI8-dKoiGwd-w-WosGgFSFSqh2uyGPSezGQppjwHKsA&oe=6A983DCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50za1bdWnV8Q7kNvwHh0Tsb&_nc_oc=AdoCw7JgIoe8Djo9zbCZAgPkjzSc1Z1jJGzew1_GkbwVkRtKmn2yDU40L3_raVbN6QY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeIjxrlRQkfWfJYeemgXKjBRn4c8rEZAcsirgQmnvDZw&oe=6A985FF6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuPW_nJm40gQ7kNvwFEvRMX&_nc_oc=AdonxJFjiKIl88xBhaUprIzThHsjM-5ZXBTU4mjPV9_pPnB1zbQI_94l2pFqkEOi08o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjMChumHgp-8jXhlyFZ-EgCraSpIXT5hCGPRm3piWl0w&oe=6A983CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guFDcYH1OOgQ7kNvwFrnFtQ&_nc_oc=AdrSMIw6XBaYQeJWHFvLx-R4U75eNicRwyvuo5tZJAmuX-ZgDbnxucKypN9PbMNU4D4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI833WJuqKWvravg90IUjqmqzyF1nSpWR9VMEES6o5YgA&oe=6A9840F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwDL7E8yXs8Q7kNvwG2A7ht&_nc_oc=Adqe88NJaHfkgfNEEBkCptCDhGnbQLogkYsN_BHpCC2nqA1AdUPLPYoOdyk1NkgS-l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN43p5RdRv188NPqPG_LneaoRFv6IE5mk6AHCC727_nQ&oe=6A9845CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELFMBUBd8iIQ7kNvwHP3JfV&_nc_oc=Ado5xkzX0jy1LQ4Qwkhvevfh4ud1B72ZFe89R1rGwdnDvKZu0mX_EMv4LZjRFXrt0oY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjgDZxTLG4zME_WPO8MRhTLoGiRObv4AJMUqjguJe6vw&oe=6A4E6B4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SFdJIwCOowQ7kNvwGM3ZLA&_nc_oc=AdpFnRQfylZizm_Hjs6ENG_WfsLxWFy-DbjRu-SJRExtT_bP1e2N2NwWoEXvsVUj9AM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfASFah5ny3aTvtrUAaC-vvC8h9m3mSB3yhsZOsAqIsg&oe=6A4E3A7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXIxJD6Szu8Q7kNvwEbHoUa&_nc_oc=AdqTPtufzu2ahlTY_8ck_MKcDAf1GKd_cBimQX0Cuorm226ry6URBNXfTnExC6KFx_U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFkF0la4aB00fmpMoCN5l3GkJ4blQQAEvcH_40k8Nnyw&oe=6A4E52DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pqS9NtO0lkQ7kNvwEyyPo_&_nc_oc=AdqlBvHxnXV5PTcZ5sf8G4A7z2n9yiiABND931edTTBNc0JRgupzPBljDpasos6jJyo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtNtm-MidBmRmkF_olsCa-aCP1vodRS39-ye1G3fL0Mg&oe=6A4E69CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjGsGxObjfoQ7kNvwEL1KMJ&_nc_oc=Ado7FSCytKvVsuQtgxDQNblTyLv_8cVHViREFk49E5Vtc2IbOv81Lk3hRy_2taJxl1g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDI9VKx4xdFMAwN1W0zPKmbSmAtFa7Gpimv5WU1Y9iAg&oe=6A4E53B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-Lc6BLM0toQ7kNvwE7jji_&_nc_oc=AdrfkL7VCi_N55CpNkiZyTi5o7w7TezxJUDhQ1J_aLP_vuyFoRnKec26yjx_55d269E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDupIseB5hLKCUiSvjsxoG8qtpjw5zSFHSI_mEpa4P0cw&oe=6A4E68DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4WQanQVgjAQ7kNvwGs5Rco&_nc_oc=AdqQGBTWoPn8GPBDcK3uxqI4uJ7ltNwI0dPWL964p7AwLmFF3BjH6Q15pM-TOxHIgZs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfECVlRxWvbO4uFHtN2MAEwSxbu-W6UUIHqOn-dH2ihw&oe=6A4E6CF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwgctDjwTPwQ7kNvwHoUTth&_nc_oc=AdrnPC7HdduuMvn4un-rgKyetr_2z9fewk-ou8_Lhpd1s3VSS_wEYk1Oo1HMKAjlZc4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASOKOCX34soHD9RKxz1QLzIfrk9CF2ksdN-FAdkp4bSA&oe=6A4E398F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
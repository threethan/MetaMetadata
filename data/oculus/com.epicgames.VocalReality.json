": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIxRNsPZ_HUQ7kNvwHtzM_s&_nc_oc=Ado34Yn6K2NLx28V_a4rWjSlkhh4kKAgAptfLKhBaq2L4otEkVYyn7HwJLmiz8UEk3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6he1h_8m8zZItR4UubxzF14nBkcyTDKOagp5RhnpNZ-A&oe=6A01F44F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFtsgXIfLT0Q7kNvwHDDEAK&_nc_oc=AdoTDn3Xa-2Scyjg_VkGGyrA94QidarUYzxIkrSxH5Pd7YIxwBhCXBwAcMSIprCgXkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u2GenfE5gdm0ytXN6TYxshH_PYTWMin91HiCFk0jDag&oe=6A01C37B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sow2itHbfqIQ7kNvwF7wLTF&_nc_oc=AdoLWlzVB_ToyGR9iBKnjgu_EkLIvRA4C6tjeQN6HoM0B3Yl__UqKRQ2wBaEo3gVYPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dCklGrF-CLBKfIorFHeghJvk8Yyr9KI47oy45AaMGbw&oe=6A01DBDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_oAmuruH5oQ7kNvwG7r2HJ&_nc_oc=Adog9D3RhPIISS1UqxFDM3cWac2ip9URjbbMbc727SuxABdBdiwFq_qrhlLk4c2YmRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57u11gaRrnjWFZBXfrp4iqwCuISyhzCv3dd6GpeEFWGA&oe=6A01F2CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMdhYXmwRrYQ7kNvwFnMDA1&_nc_oc=AdqOEdctIPG5fhvxnVbc4pXRHdSQ-uNbf11yBZyrEYVuuJXyNipiESeMogdQ7eHBpPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oArPpv5SnDad1DrErXpK0WKwhfcj9rq1W5-FPdeYFxQ&oe=6A01DCB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLZTFiEWDvsQ7kNvwGCr_ZZ&_nc_oc=Adq9SzuNO7G_zgBeJazi3q5PqeZQmQVxpcxjJ6wXVLPbRvOwqdMt4nb7ecB6aBFca5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n_mm0ulAiaajkdVQBuvayJIXNvDK2upnwUMfOHxeUvw&oe=6A01F1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgXp7IF8ILUQ7kNvwGwraNr&_nc_oc=Adp8xUmy_3nlLtXO4LdDfgXTvoBqmEEOZHIXFoZoyoYv8vG1EUpCWm5yS4cODz0-qKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ue3hoMPH3dSgOY9WeMIDK51XvyXp3FIDd5k8oqhZrQw&oe=6A01F5F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr3gZzIMTdsQ7kNvwHzXliE&_nc_oc=Adq0v0OD6BuDai9vZP_cs8ljgh5UffzvEirfddaoeh72gjPgjuaJMooSCjs_t_TSPQM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g6-x37uMrV6VnuLtjas5dKcQZs3fE4oBScnCNI6ueqQ&oe=6A01C28F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
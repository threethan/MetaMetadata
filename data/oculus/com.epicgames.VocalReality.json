": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeK8kKZ0T8QQ7kNvwGFaP4S&_nc_oc=AdpNDuiuG4J8XbpRqgsMzLkiDdbS6BWIg6ZkylXt0HbxqN358IVDsXn5Moff5YKYPUc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShqGPFp5fjYjzKjGTNJiNVSlbK9IzR21HRnnMvIq8eCw&oe=6AF9CE4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpD70qZjF4YQ7kNvwFAWjdf&_nc_oc=AdrAaGnwsUfbSxkD_2ByQEKK0UpIUCbhf27fTrkqAhjxsFlTZBx2UixgXb1w9fKDXYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK_3mp0herQu5EOV8J43y3wj50zIxDeeRP7LE5qy5m6Q&oe=6AF9D5BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeTVh6AVJekQ7kNvwFi0HoE&_nc_oc=Adop6goqPax2CLnzPEDcEvbUlj2SvBdAvM57CicixLaTtOBEGnvbn76p-0nqQoBlWZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvXg3gVX7ttwf2hgxG1ILo8_tfnc7pxLQsMjVutjVmhQ&oe=6AF9B5DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2vFi_eGixkQ7kNvwGPdS6Y&_nc_oc=AdqmECvzW836nqRwm6PMSLkzROxvo-3v-t9uMM3KJoDgKqFjmkUq1g3wlUUIahLgAng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScKFvpkZohc_5ywHI1syZGF21CD0YnVRUzCO0JKGYUqA&oe=6AF9CCCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THexjx6csgQQ7kNvwGMC6Uk&_nc_oc=Adrg0mslOy8eQScPG_cH__lnPAVOZjJrTw33aLY8p6XEGVlPoIaqMxfaTrsyYduBcf0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdQcfD5x86KbE-_b6RCInrsvidv-na9tgusnQfAlUtCA&oe=6AF9B6B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgWA0v59I_UQ7kNvwHZYxQA&_nc_oc=AdoBpJ21I0SYx_Y6GHD7n3__0E1PheWYoXyhHyevnQZQzn9VobI7J4XKg8-yO1XHDVI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Et-oQUYhFvy2p_pMb9FJaViZYkYFn6YWnbjzfBa1xA&oe=6AF9CBDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_8Gxk-hweQQ7kNvwGYfGmR&_nc_oc=AdpoLoHHvYgQf4wsHl0J3rfcGk_N5Kop7GwDcvKkSkk18MwBy110nKZsS1esxShtqEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNoj2zNaB7t2ITDdWumQxZOU9vcwMb_W1uVMK8X92fgg&oe=6AF9CFF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSWYpQativYQ7kNvwG-sS1x&_nc_oc=AdpJVBA5-FKefNmiRmYrXX8tlLq9S4Yb8lWtAKfDKTTCJTSaYlQTQpa6Vpj3lO0RJwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHaEKmyiOPZBUsiHjhMJxVHbm3MVc93tXiVVykrq-QwA&oe=6AF9D4CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
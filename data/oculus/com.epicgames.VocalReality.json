": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCT2VrBXIpgQ7kNvwFVa6v4&_nc_oc=Adq2EfPtamo2YlfVlp78rlPSBcDXdzDyYuKixyypnbDVrEP7tO4jRA-9CKvkQbiQLs0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzJP8_UY4UhdVmtBrjDhJmE-tdE-iR6kzNCV4rNVV9Kw&oe=6AB14BCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-JLwYbaJl8Q7kNvwG82bUr&_nc_oc=AdrzuVYdX0PBTqXrSEB0VYFZ9M4RgKKLhBADnF4t5ytPaW7IOvT30N7lYlbFGUl-Tig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5iiElbaPJw2Wf2zZNWGeHHct_bwuw5Q2_obt0aScamQ&oe=6AB1533B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtJOdbsBihYQ7kNvwGuYdnl&_nc_oc=AdqE6EEHTbKcQmv0lW8aWXHEfECKay0ggucta8n5ddqd4cx-CYkgJIvtTp9GZK3ZJ5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR9IeD3t8sE7N_mU0Dp5MW-yifFRTmx1Q_N-aH3IxWfA&oe=6AB1335B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwEVv7DiXgUQ7kNvwGuCNI7&_nc_oc=AdrYzUlxApyX_SNDXb0qytHoWRG4yJJCk7dXemghcB2IQk2RH0AK4QcjzWMu20sdK1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMx8qjJL23DNX4pH5tTdY0JpKBr8isWdyxl__PFiM5Tw&oe=6AB14A4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-piXrWpQXEQ7kNvwE7Shnn&_nc_oc=Adop7RekLazmkS7d3gx2tWwaSjqtQAzp0aaMxKDc8WftAnL8GA7iFEHjvoHumrg2TJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHfHSfsYyapgqI24HLVUfK8Rx5oNePl9E5vCies68Nhw&oe=6AB13436"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9znitY9lzUQ7kNvwFQi5gd&_nc_oc=Adr_PsLSJLo41pSUgeDpt-D9CatJ3YqIJu_3rgpZ3luNWjUT6Ec4YdwC4_FbwIvF9hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2CAU0lboyZuoSFZvGqR-qCz3D_tJ2elVA5wu2cBaIlQ&oe=6AB1495C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UKjFvFRGfEQ7kNvwFjWIxe&_nc_oc=AdpF5fgNWnXXUhHMAoK8M7pdx18ZFc6RCM6WLSgD0HzqwWDf5DJxvelX-Hkz-2oaLPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvuw5Bolo6Zd5Lm8aNZTERI947BR4tLho7ufxI-6LakQ&oe=6AB14D72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX7GdEbwk4gQ7kNvwGxwVTB&_nc_oc=AdrLa17MndBk87Aeq0fwdQubglNKrbA6xaB4TLGKmv74qozJJkFs71KjZJAVKB1uLfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZbacs_3FPE1gua59tpYBTVU7bfB1N4Ah7fmq6ZTy3Yg&oe=6AB1524F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei_MvEx8dV8Q7kNvwFwgX81&_nc_oc=AdqdWrYD83_jmxeFUdwPAHiv9xxO2BhKgypmR8cERUx2TTeHaLGEz6qes4uHMTUlIFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iIli-BY1WuDuOFG1ZsPwG1yZllwGG9XPCczIn64lvwQ&oe=6A073A4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpIaOxgXYjQQ7kNvwFf_ZB2&_nc_oc=AdqEV4YBaEIDyqru-8wzysxiUnO2spwTgLyEU8WF_6FH9I_tnRkMHSQaQKFHTzznGR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LuFjd3TJWPLT9Z9TYFpmSjwMxQelexdc5OWvX3vNV0A&oe=6A0741BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsfKqlHWdD0Q7kNvwH3aNHs&_nc_oc=AdoG1ur9OpHtSloR4BXrzm2uYNv224-I6jfDH6rImFOzxjOd_ssw2oKcEi5bTx0tCN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41w_7cHLcit1jxGdMcjht7ZYGXE9tPVfA1IjTZMea61A&oe=6A0721DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxw9G2EUkj4Q7kNvwHW62PY&_nc_oc=AdqOdkZArfKJ2F3aQLU7G3Z1A5uW05nnHJD07scH2r_iJTUN19ofCgsXNti7atPsfZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pTA3FMEFJpoXz9JvgfJY2ViZHprvFRqzl4vF1-jIR0A&oe=6A0738CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdI3TVrAUcAQ7kNvwGGqAt7&_nc_oc=AdqsYOfjFxcd3init28GAXsuFpkqlHPQCZU3faoDUHuNqKF60InwuYOnNCA_pG3gYfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Ktdl8IAVEh3yhhL6sHPPUJ99VCWQ_y2dRh72j5c_lQ&oe=6A0722B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6DtkCdv-FsQ7kNvwHm1vtg&_nc_oc=AdpuALeJzc8KxDXCv8j0P8QGDat14Rg74WcoL8KWoclIf14OY4iwCEpcUR64wsBtkvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55vh95N8UrpcnFyLj5ChQhqcpPEqhNcY-CjMgHFKCaeQ&oe=6A0737DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSmA-tRoh6gQ7kNvwE9iWBj&_nc_oc=AdqKwYZkG2jcIJ_UflWmCO4CJFwVC3wjgN2OTFRAFIW7Ty9tIgO0nUyMkuWsyitlJgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BYVfdQHNj7BQliWxvrs_L-Sv_4eZEvO1AvK81FI7D9w&oe=6A073BF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP7qjC5Tid8Q7kNvwE8-QlZ&_nc_oc=AdpvNVP2-uwSt1oMMPuSqu7iIviBRfQbEMnuxZICcWr-dXlNqrtVDrfFfuaAtdArTJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4syIn891LoExlyY9pEBDaBD_BWCsXpQBDBUy72bFpeAg&oe=6A0740CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
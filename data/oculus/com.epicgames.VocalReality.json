": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kl9Bb27fJQQ7kNvwG8FQF1&_nc_oc=AdpSZ1vtME5a_fqlI5Yg8lBca96TSu9PFNoJpd5g5Dm9xbEJvKgyjTC7kRjF0Tr2s9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZoy2XkxNm4AxfBL8SB_4CfobuA7TnXoiC6CjiIiHU3w&oe=6A6F288F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbzbiALKiwwQ7kNvwGzhPR-&_nc_oc=AdqupIaMRWpAngH3PKYsWBUzpc1xq4hXaAfJrjuI2bll3mz634Cai7EAnaAPuKAmKas&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDxoeAu__omZ8gipBrzMGcyAtj80B5MxqSMFJ0xXRNmg&oe=6A6F2FFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWM9IUBW2nMQ7kNvwG9CneH&_nc_oc=AdoAJIrOGUbBXfQYqABBwr590jkYKMVUFQ96Zo7fbXb5xg8Da4GhRFG8eJtVfIWvqY4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBPPLp8Lg8hvynHVdKVe_xjy4O7EqrTZyWTSkcl5W6Yw&oe=6A6F485B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCSuhkisCsgQ7kNvwGRs_oP&_nc_oc=AdpfCFv-hyN87myhsccAdaCfIybl2q-0GBU7mlJ9hlXzRWb3nyZSFJmhfzA9e-RfrtU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcUr1EbnEfGvR8qkXcAfTyo9aDdgv3ccGoyawVvDKgzg&oe=6A6F270D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eEAyGpZU94Q7kNvwHUC1ub&_nc_oc=AdqyPuPrsfSW7PB8Ihvgo1bJZucLYXYIe6p5fRCGOaq3EOXOMWAtW88kHhovyB2U_mo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUMgjAIYp4t-XXv2hgOuUaPGv-wKoRqGAyT-5bRt4eSA&oe=6A6F4936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Jz8colhycQ7kNvwFtqi3d&_nc_oc=Adorm_LogMqlLZnY4_HBYlAykGuGUMLd2FmvAYPiUlNxGyrDoKXkjWer9lEQ_cTChj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeZ8X6b2cvAx9wYxXlFtudvh5Q5TWzlIksra5-E0J7XA&oe=6A6F261C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aJaGnffN_wQ7kNvwGW98QB&_nc_oc=Adoa0BZN7Mt6ByKFEKGHvmrcWoT-xcEVLPD_mzgvOd_s9Asl0r-9bOJAN4cXHzA62S8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5ZMQgeuzdDpAZHmXDbivszLz9OQh5qg0ApvaoN-yc9A&oe=6A6F2A32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r78bLW-tUsYQ7kNvwHXOUFd&_nc_oc=AdrsO8H6nFRg16yiCwCHifdzLFetoSsAQn5blKxifIZfkuTyIt-rBm8_CDJIkLbo7fY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa2JFdEjWuvg97dPQfpoKzxoONWdo3ea62TXKTHUDcYw&oe=6A6F2F0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
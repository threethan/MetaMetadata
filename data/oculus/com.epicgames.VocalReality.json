": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGyj95r4yBEQ7kNvwFokEIx&_nc_oc=AdqUwwf9jDpYjjFB3DdpAvQqazjcfyXsYQuSR1kUuw_OzA-4boMGwASoeF7xYcS6A60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x3iGu259EcJD0NGNnsfVVa5hkkMKWoRGLHnaMx6MX2w&oe=69D3978F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YICpKK_WVIAQ7kNvwH2wPw0&_nc_oc=AdpWy9z9cgpHCF3DWjrxC5inF7HuAvpsphpjsV7amynBgo826IfkEUdJqu5OR9mLZRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zoWY3do1qpRB758YxsBTTkjsgxdGVhgKikjnsllqOhw&oe=69D39EFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fGkczbhsm4Q7kNvwEXl5cG&_nc_oc=AdrpgwQ_9eGv0uR24Jc9nBgiEh8cwbN5hCX5Ulx7S37ln6SqP-TsTG0zRpixc7srdj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i3bRtuQDtXDvcyXKjYC0cN-ysKKT1kYKu4LY_rj8v7Q&oe=69D3B75B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEMFY1LRS2gQ7kNvwH_GfD1&_nc_oc=AdqbN_do_mgd9iyvhx0HMuC7TL1DYwviXfQCdBAmSz4ZxpeMovjrxpo_xUMP3PxIJlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E4j9Y3XLvJhj_qFJ3lNiPopPW1O_gAeqno0SVY2AYiw&oe=69D3960D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCOGlfEWMgQ7kNvwE5phrC&_nc_oc=Adq8XqVGNZ-6TSjzqqUjx2-McSLAkLAk9aX1SoldA8_Mv8hT9ucfK66LTUS-2JExTtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6iqRyW1dAQHhK9ff4TLhXdCZdj5xdo-ia5LwMSB8Qg&oe=69D3B836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BmDOVJFZYQ7kNvwG6Rgkq&_nc_oc=AdqaZzKj0BKNFLr5UpO7tcbLQU8EHN_V_nYS9FSSoJjOx0cqXacuw9q9CZ4bGGFHsAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tSbGskhbkYMtvojCOkzjMbDFdkoRTIiIZimmBKqEeEQ&oe=69D3951C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEuNAH7uoWIQ7kNvwGwZgmk&_nc_oc=AdogeqZ9oNJSol4IhioE-J9uiygs3Jr2evdU93Qin7w2N35JwAukQTMhmWT_zTT1vG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17uAv8tpSmiJgE0yPB8wecYUiJXhcZ76t2wkx1a78qzw&oe=69D39932"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9_hjeiOxJwQ7kNvwHY3TaL&_nc_oc=AdpJh6mc4y7G1mwlOTpaP4LLHFZWA626YpgQpq2RYHOOCIPMoCPIFXrZC3A5LKuPPuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N0xoKHvgk_EPkU1tBxfHwG7KY34ap6n14GXJWridBpA&oe=69D39E0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
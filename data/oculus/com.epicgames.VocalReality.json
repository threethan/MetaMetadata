": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y_QKnloC74Q7kNvwFRQYsD&_nc_oc=Ado17_Ii-zMrGscrvvSbF_TeW4lj4p3ai-l1gsanNjFJrdOGgtkUrdvzdftB_AF_ajw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mdOdgA-1rYzdhtQ0rxK15dY_byWVplfmPe-sT4gs7aw&oe=6A355ECF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y729rVHHnYQ7kNvwHnZDOt&_nc_oc=Adp7y2dMdTQDa5I3EVVmoaUYPnVtTe0DHj1fGQK-XDUERWXvA1CTJmzen_Wlfvy1kGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91DNFCDDh6xjZS0pI4Xm6zd--hqocPY-JEcNHbvOFCIw&oe=6A35663B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3n02mTiTkMQ7kNvwFcjniN&_nc_oc=Adp40dMAD850VqNj9sTGnSWS6qIMFFRZ4OoKHvBVGNF7biXL4-0_vzUpe6gAX7-kxS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wr0JpfTnGsOKuq-CuAj-LSgaLJFBpZ5tjp13s1eQIFQ&oe=6A35465B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dBUNnlqhDQQ7kNvwEeT4Bd&_nc_oc=AdrVT9mdTwxTKSDxm5d_l0g4-K8HtlZYqQmF54i49YeB-NC9AHTghLuiJO4BfRJQOlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ODzuhKnd5lr4OMHmG_DdiA9jqzh9nQ6T3hJFZruwn6w&oe=6A355D4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW5sKpf1HPgQ7kNvwGs7e-7&_nc_oc=AdpfI88DXVL0vLO4qrcU8ebc8VD9flvZeZeDoAu41PHDsyA85DFbsF30kMxG-9HB21A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-WElIf59763-sX-26dLsF1rDbNc16VaUujPXT8K9Rpg&oe=6A354736"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsOhs_3LIpsQ7kNvwE772ob&_nc_oc=AdoOdXXlFZh_ToUPHgb5kRHUYH84JBXNrcxbMs4X0LYoCMNbRhXxnobA7sSE3OCmIYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k6iwlmXBt54Zq11KpSnVU679Wk5mfr4ySx65w9e0Uzg&oe=6A355C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8CIEJ3UcIMQ7kNvwErB3QT&_nc_oc=AdrL_TqIfNAxBDGiF28cgQxLSAUpg9HHdFnbaaUVUITgCTsUNr-w_HPSkvI5DlprrOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oy8meUKH3r7LCzoI0GBabP78km40BPe2BxRbf-p2gTw&oe=6A356072"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCxtbx5FaKEQ7kNvwF-BMyt&_nc_oc=AdqkpdUkf8XsyAEd0v2QJbuntGR2BVcOdwfkcao9EA9MYQ05Ikm4FAq4Ni6IZF_v6LA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bay6oHtow4hfNh-yHKv06XTAeKQiWndGL_50mVaHmIw&oe=6A35654F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
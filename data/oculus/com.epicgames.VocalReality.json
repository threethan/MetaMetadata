": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waXCmZP3wkcQ7kNvwFAIZBW&_nc_oc=AdoApYeW0_l_xkHR8KwP5tj8287e1-3Khr9xLueZMI97JxHIjFdHE0JthN5M26SXZ9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQXC2n82dA9IpSH9xod15EYBcIqm11oJDHYk1HuktNzg&oe=6AF72B4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpD70qZjF4YQ7kNvwGJ3nkV&_nc_oc=Adpimd2HAbDlWWPgP-zjygk9VoVPoTpPCjl64fkj8FqiBY-cPiEKOePVbTrQ7pQzLw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNYlibQ6thh5HissVDeUe4mYAzg0NPdK1CdQMXLVhpzQ&oe=6AF732BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBBtWMgZTMkQ7kNvwG1N2e1&_nc_oc=Ado0Cq7LFHcKcrX5Lt7P9_mo6BSA9RM3-f5HNl9aor4Y4TW-nl5ci3SIEi__KB3fNpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuFODCYU686_COKCy7Lc84LN2wTt1oQ0pUSj3nN8WtPA&oe=6AF74B1B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hZZIVvB2w4Q7kNvwEC6GH5&_nc_oc=AdpdCeQAf5ARtl52NqIq2b2UvCUuVwCGyA0Sx4HOtMInrKpf0jm9EK149gVBa55aCXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3rgnlz25e9b0M7XGUHRjeNCU90O0JpTFoaPPbUo8UtQ&oe=6AF729CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLv8pMZqgAQ7kNvwEvxGvu&_nc_oc=AdrLyDaW_AVNtQslgMherFqTv9fLBrfakD_gRA0snZy6trT813C7eTW1JDLtA5ZwW3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVfL5hAEDNgrVMPMMz78_NGra19uVnQnCaQ1kv_ad3lA&oe=6AF74BF6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgWA0v59I_UQ7kNvwFrFHuh&_nc_oc=Adrn3QKsR227wFOSWPPk6xq8z1u9HtOp-txbWWF5NhBVj9WzODy4SaqKoQ0t_JZo2R4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu5AgsB6wqC2C6bDWDeCutUn7fEa6UI6nPxuGqTNiQsQ&oe=6AF728DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_8Gxk-hweQQ7kNvwGJOxrI&_nc_oc=AdqnMXprTIkVuQidBQsJMuNo-6b6xBtCp9k4uOIGMxjQiBFJF8xnZw7sG_TsMlsh2J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4QbKpUzfOKCjXj0c7h8rakQiENXVcODuZi-0PVRQ1dA&oe=6AF72CF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utERg0aQIz4Q7kNvwGFIzKB&_nc_oc=AdrmvVBxV0eb9T5m68NOM2lYc_Xf_pWOsqhfIyNgUjQW3lVf-BjX2x_06EXh-w68FkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD4tNXnRV-jVhuP8W1Q7TmG2KFftVt9gKi5XI5keTHSA&oe=6AF731CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
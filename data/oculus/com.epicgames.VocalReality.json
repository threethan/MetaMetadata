": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvrHHjIu8bgQ7kNvwGzIdh_&_nc_oc=AdrJRgTuIjVBy43b1s7EeE-BcQcVN2HCKlD3TPEkVVqGsXug3nhGxfMtbOvukvmoAm8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0NCoQW0A1hmvQQ7g2ed_jEqRPjU6TnlXQPvb0lcRnXA&oe=6A4689BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azgzma9c5uYQ7kNvwGUpCJ8&_nc_oc=AdpbUy8DPso6uq1LzG9FPbivYTn5kS0wZlh-s89oWFok9996gkI3eLtNdRTbmlwnzLI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zIphl_5SMJXFdsE1UNOdh9H7QASweS66gs3msSGyCng&oe=6A4669DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWSxkUEnqgIQ7kNvwFCXlsm&_nc_oc=AdqXl9mSGcDgdFPvA8IOLe4alH3msVhhmnp_QN10SC8fGDnb8iZor3ZoaKpI3MUHXCE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4p3vc-phHxfpR7_EHgKUxL3X14DrX2pKhULORWXSr5g&oe=6A4680CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ5CyqIJpL8Q7kNvwGIZJKi&_nc_oc=Adr1ye3HyjIwSsGIoRsvhJGk6dHuLIRqn6UCwHiiiQysf8HozNWxM5m8sZpLW6auERk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EnKBn-OIPQ9WcMhGaLciMlYZ0ducjY8hnRob8lrTw8w&oe=6A466AB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPbgJdsHDtwQ7kNvwHMNgUx&_nc_oc=Adog4W5-Ve3TsjfJ0bXPx8Q0UpA6DcXC3B51a-uHByTSqFSkYCbghhguQWnY5jwWRvE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86pXAcPXkZNIdzVJIEEKvGxvRUTnGjThfeAg2_0ECXvQ&oe=6A467FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VZX5ChxE8MQ7kNvwHnyTOg&_nc_oc=Ado7yHLtR4GVwKbcxlv6FWCxIfx1j_TXb-jn2zkLbqF2_etpElJoGlb3qRZcsONWhbU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa_QVMqNTztyWPz-BTSPKSS9cQ06Dxvjo-h-q4qqytIQ&oe=6AA179CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=133_u1vQI4QQ7kNvwEvph1Y&_nc_oc=AdodntwpYEj-AlK84QWIOPGk4n_nzDj76Y_640icQ5GQ3gSDnLDC1jpr2Pz-FFLREmc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmbXS0Q17mcO1yPi04KmlJ0YwHALp5cAa1x6tDYkAdFw&oe=6AA148FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRoKs-5bGckQ7kNvwFoCuYf&_nc_oc=AdrWuHq4ypVFbp1X-pFwTutOnd_5xJGnZqy-99pyD2AozPpJKO7DCInhN70B1vOQAMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9R3lwfV-QjKPHDxkt4CJlG2AG-zbi9itf_L8xcavoFg&oe=6AA1615B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY6QFd7eg8QQ7kNvwEyCuw4&_nc_oc=AdoBiJ2j3yuG4fMJTA01tfTfBcYXTxTMQqh95QYx3Wwigks-KMiBxL9pXnUSnmhGrCo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY01AMeo-Xc47EKquer1mVu4YNTD8eel1clHnsEpb9kw&oe=6AA1784D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6riUbutXO4Q7kNvwHv0ocV&_nc_oc=AdqbYqvGXZeyWIkgkwO2Q3WoDEA1wfEHEUBTwgasnD2kuXF-fB4g6WnOXzKlIK-pSdg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXlWsTFuf90nyajYzj4IrARevfuDjffrk2b6HhMnpNDA&oe=6AA16236"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PiESha9BvcQ7kNvwHAA9IM&_nc_oc=AdqxoejdhFyKxndxOz-F3W2YTYq9sh_G028wtYbrwlRb_rmMr4RUBMxiumwN4fDc0QU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSSzrM5EFkA0tDqIGFn0iuJN3zOm9y54I5IB7j7h0Exg&oe=6AA1775C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_YVJvXApuIQ7kNvwFgmQ1x&_nc_oc=AdqkEJKvT1_aKPbjmoTIQouBWlPwInov39PFDac3EM0QHqa2yewq9ghjRih8RzKH7V0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyRzIigLCeco31hZTHctrgUEfql7cCoFMy2V4p6Zpaag&oe=6AA17B72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2fPiOlxYXYQ7kNvwGkMFkR&_nc_oc=Adrmo5njoexdeB6Fz77jN18RYz1DcJQFWpVgNMAqIpolYjgUm7ARzybCgdREPqf8PsE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrSnAAxs3CUOqE_ZQp9-iJcnzuOzuTqv5FzFZhts1bZg&oe=6AA1480F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
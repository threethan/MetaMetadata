": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVGlrZqMXu8Q7kNvwEMB0A2&_nc_oc=AdoZt5qT1Rpc2iuRMOBsYvMHcYCOAz84n4PKH_ywLmUNFAdGtfq2YQjaJPZDmhn25WQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ETgSym1rmU8XpihXX9Rl5oCS-i7uWkBHAzBBMbkKzQQ&oe=6A2D75CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GLAwGEP1m0Q7kNvwF8HOJF&_nc_oc=AdqCJYguApklQwmhyr1PDc3CWUxFvJWLwvg4kL9Uc_iRSg0Xw7ZjUnndVTT0TuV6Uzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G4wGM7oEK7763dnGHOkOBZQFGRrGzWrqtZsMHGnfs3A&oe=6A2D7D3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJC8hfTeGG4Q7kNvwG5hOyC&_nc_oc=AdpRsXgJ-D3oeTmEZdSmLa8qrXR_AggSD-1RVgFXjSXtp-R8UfSkinuH_58_I_vSjgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EqcbcezMtvJITnryjai2MDbMfGi0ZhbzBnjOWJ8wYDQ&oe=6A2D5D5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykS3YXQ0YDMQ7kNvwGGZSjs&_nc_oc=AdqeXEu5gvzm2ueqbPY_V8HGuJ8VyDGcRSvyrtti1d8gTY0bAmTT8l-xWrqk9vkGawU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86gmX-LhtBlfdrIfEXWZ_n_cNX9TBHHsFI6UQU0vsspg&oe=6A2D744D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkE5vDHYvMkQ7kNvwGAd_bt&_nc_oc=AdrIo7GfaERsRaLCmwVel-3I5PjPKbgBzl4JOfpcvY-T13kWJrXP4EsfJzuEKr1Mpc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NmxUAzGmiKDOxoMO5c7SBbDpk7xkRkXRiDi30hEwZgQ&oe=6A2D5E36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t907pYRGq0Q7kNvwG8RT-m&_nc_oc=AdrEzAI_qU_5KIGxiXS_mY9ikPVKx8gyyOSpt08fbiA6ENiRkSqeiOgqkANt3Ow9Ibw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1f8awTCV1lf0xboi6syLzqnASXuylTugmQKzGLPFM4w&oe=6A2D735C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56z2eL2pgcQ7kNvwGOkmpK&_nc_oc=AdpfpW4f5kioQWRozzo8Nmh7sTDlBebvLoomPlxxtiZMWYtO3J1T54gkwc56FVjhHmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p6k3GO98V2WCfMJC7BYJuSipwz0BGsrr2DMPLREQFuw&oe=6A2D7772"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1lXa0UNRa4Q7kNvwHIhOZP&_nc_oc=AdqgTRpEoDdmsM1wiVUK1AQ5KmCXP-QPZkhTy0JCJWS9xL3rE5wvhsZVz5g8tXB3B-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Dl_DAv-xd3V0tCHXEONmoypjI16GmZxitSSBL8SwOOQ&oe=6A2D7C4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
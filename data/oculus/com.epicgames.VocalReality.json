": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yjvxls52QMQ7kNvwGY8n3C&_nc_oc=Adp7zAeHoarkdjkhQEgsMJH_6-gbtiZ6U9laFkqzbNTbZbWpdHmj28syAOsxP_RUvnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70Wv_bzd-Wu3biz-eQNLna3gsDxYpi60XIhnGG9dZSIQ&oe=6A0B2ECF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfm6oO9p560Q7kNvwGKdtjr&_nc_oc=AdoQTCe6ITDjLRwxWKObRsO1h6PNFDHzIuhSK1M18pEVvf3FIeh09D2neKj77VP0cos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G8Dwf9u-8woU2VrJuyTzzYTcvg_CR82w6DgpN4HO7Eg&oe=6A0AFDFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFh6qNpYHcMQ7kNvwEAmE9X&_nc_oc=AdrsguZGRqF1fCprtXg_7OKy0CumdYj2Tv7KzFKCx5N7f5pb7DV-g8mw3NacwCrQC9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71xE_onjpDmaAfJ__Uq6iawRZUCkBFJhOX7uy9uSedHg&oe=6A0B165B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odpPPaOI_4YQ7kNvwHTdTSd&_nc_oc=AdqM4sngaZb_yO5lD-O3kWTjELBlYt_KYKFvsgj77nfsL-H6VbbdDiHmxJhWroydJiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oQr7GvseNFOFJfTq_c7oWy4DN08fnXZL-d1yahVa_cg&oe=6A0B2D4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6sz_0arP70Q7kNvwHqgVvT&_nc_oc=AdoT-PX1HBVtlrdqWRHh_5V0i0vO2ueyUXMhtOCwpFoOxTMx7UkYpr3Dzh1s6PB48tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MlRchgfflKYE58FEFo8dtU5k5gTFVgj_L42Om1Tox3Q&oe=6A0B1736"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_PPwazP4IQ7kNvwFWbTUV&_nc_oc=Adosq5wIgcuxMG-2cqUp5B7ALBcEh9CN4GApAHIWOW0eVWDGDBD-as4CJkzmycMFCzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aBHnfG6OMgxypaBDhJhS0BSooV-0ybWGRyh8i4z7E_w&oe=6A0B2C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck2za13N0A0Q7kNvwGowtLy&_nc_oc=AdoUo3Vx1d6Ytu9uZajk2JZER_at0wKC4__tFHdsPkHM3TMbVYX5FiMagMREVBAdBnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bdQAN_zAImM-xrhRqd8wg8ydNCNxiLWGCdHJBCRp8ew&oe=6A0B3072"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bnuv5zp8BZYQ7kNvwGd_18D&_nc_oc=AdoOxfeL13HdYpS2EwvQv17eviC9rxoS23Z8aI5h50vflgefiSpi7bqHuPUX95-snQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BIXsP2W1L--Iy8Tx0JoGWLjg4wBfmqVhI4Ajk8S6bYg&oe=6A0B354F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
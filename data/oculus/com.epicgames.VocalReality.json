": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjNytJBgtBEQ7kNvwHErLY5&_nc_oc=AdoKXaQ-nVcHMWVGwlyaocpvYBRnmEJSanCPCA1mlSQXtYQIjYCX0x5p2YYzeED7XT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsu3N9Qe49G0HrgfQbrKBViiTeZmA7W6DiM46jYVLN6g&oe=6A89868F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrHYtmAud7AQ7kNvwFm68YY&_nc_oc=AdquJLRO8EWVPWUAY0LRUqTxuig7jFXyOvFmk9sC8hAAhyddq6N61-wwlDC6VEJo7GE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENYfl9q1m2qkAUsiV-DH8YBLs15lwp6H4RVVqUMUqGkw&oe=6A898DFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAg6CEm5Sl4Q7kNvwGpdvWw&_nc_oc=Adpqyz8QVatdZ8TiMRIh0BZFGy10Dp7JDqdj9U_sZnlWyBRWUkjKCZZ3dCbXJPksV5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr0ubODpjGzzWd1__Ojd7kvycxAOcs4QxCoPECHOEEmg&oe=6A89A65B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPgtsjJdb8UQ7kNvwGIRrDW&_nc_oc=AdpUCQIKEnFlbn9ZwAtiCzpdIMa96tjlu8QdhURZrvIFKpQTaahGTpXC6WO6gBMKmM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbUq7ujIrA0YPMe6KtAJMEQzEosaIW5Ze3mDuznaF1bg&oe=6A89850D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUQYsTYiLZoQ7kNvwExNz4J&_nc_oc=AdrYsU-35gLbqtTssoCLSo2uOy65N32nURqutVJnQtQH_6I_sW0cXcF7PKHQy7RGra0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6kJOibARfM5IT9_p9anxDRgHEj_wcQd4ymBH0TDp__Q&oe=6A896EF6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5KtV1X-V4gQ7kNvwGpDfh8&_nc_oc=AdoLbda43h922uQpeIh4_rVSCb5fwzAp3eY9-1xoP4OJdfkmKarh7uMo7HG-sSGAH1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUcecv_ZeRZkWYkATGFM_zSRA7OSIzIBQFgroWjkAX5g&oe=6A89841C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygXJX1npVBIQ7kNvwFH2Q3i&_nc_oc=Adogn1kz0l8gER1S9NNC0yPM1GP8pKMj5o8zZEEk1fIAwm0A9yS6rgDg4NEpD8Xc_Fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6_KyuLmhs0D3QAy_uUDIH8Ab-kY8zerAwJSGgndgiyw&oe=6A898832"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrpWuTl7PL4Q7kNvwGt-D8s&_nc_oc=Adow9-izPvddpwQiz0Z2FjBQW_PYyH1lMOc2pwM9sLB10jdomnd6mOI_dTq26rOttns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrRt2umEYyY3qujP-zU-8DOjsgMTM5uhxdMbo-1uFBKw&oe=6A898D0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
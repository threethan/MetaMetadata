": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe7dmkvtgXEQ7kNvwHu4qu7&_nc_oc=AdomSDFUaHSFIgufMsgmpPNdfZV6ULedzXucbk93aLdHowhGX8S9KtD7x5CNgmTVgUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5Ump1TCpmBFKVET9iQzsqOTZgoo7gi-yzRyXzwWupQ&oe=6A43DF4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwc3dOf__3QQ7kNvwE7-PHj&_nc_oc=AdrHS8o6JK75oOtxYZx8le3ycpLJjD2OcOPBnvnwApxDQ48-ZVvX6QAS3HnIuY8E6gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Sy62Mcg3i5E99fxgrkVbrJizDRDpz_iZeXkoImJ_hA&oe=6A43E6BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbboMEqXkTYQ7kNvwFV9Bu2&_nc_oc=AdpB381bqUN86I2C_CAGWNS6fRVQOk5bNJCh3-xuOXLiNfK9ZdxK0fMkFezbqRXPsyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AZhUENaeafivJzM48tROzUWzMc-K222KSm8HuJfYsYA&oe=6A43C6DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWSxkUEnqgIQ7kNvwHEYS57&_nc_oc=AdqPHgK_PEyvvHCKJaG2m_6_n3G5vkVgl67FqQI15L7fcPWWUU2TQ0wuouzOgEotXEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EZNeoUoFS_0CUpdYcFzCPoOWvbH0degYypZq51_u8cA&oe=6A43DDCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ5CyqIJpL8Q7kNvwHlGHYV&_nc_oc=Ado-Rtc1DLgka9IsA6zm3kEXag3xds1ifEZDy9URAziTLneIj70OjGR-2IzbSMOXwFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lp9XCRzik3EPE0walFcHnbA_QJmm2E4y_sJeHOxl22w&oe=6A43C7B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tv3gRHhNGAQ7kNvwHrkiqf&_nc_oc=Adod8n8wBDLCebdz8uczJSKxMy9UbJ3VeC5Np6d2bWT_zmsx195Wc_1zqgPb-rx95UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UpAGwdbr9jLrZq6tbLNi4ibryacztfhsluJxOimtpdw&oe=6A43DCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h2nDc1RyOwQ7kNvwGVBcUJ&_nc_oc=Adquou6kqnnyGqYwm7o65rQzI_Gw9eLxxW6v_4UjkDEKZjMfIYKgkeqIto77c2-qz6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O4pQAghRBp35ALikQpb-cyQy0WleqJugdxHj8CZQ1gg&oe=6A43E0F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY5lx2jOtcEQ7kNvwE3rG5o&_nc_oc=AdoXcaX6h2yxAJ6z_fFYJcVAMap-gla-SR-bgzkYkerjdTNWnXhUZDcZcdMLO9sZlTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iGxhE1NFUb4fMaKY-IRanwfRMbHZQ2bOYz0VLIheooA&oe=6A43E5CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8ReXSA6wKEQ7kNvwFbvE6K&_nc_oc=AdqBdhVFLd_GSoECQwODPYlmmgyzAeuGuLqvaTHNpeT-jJJcfHx234j-QkX44m2cJ9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k4JlTyNPloGd2ZV9k0_-BYwOdD7-7g1V0U8IuSjKqsg&oe=6A3FEACF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYpwNRnenCoQ7kNvwHYTxiR&_nc_oc=Adp8CsZphZF7e92Plvl41-J-dZQV09fb6uA2B-xLmPvtjSWKZqJUXQzLHNaeaDX_xNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HcM8_DZUqtdXR_RxGZw4maX3AJG-H6aDw-ZGIfPZ4mQ&oe=6A3FF23B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do4BU9uHjcQQ7kNvwHq878T&_nc_oc=AdqL2yLcrZUW3ydjd_bvQIUi3Jv5DecXJ9cHqCLn0SI_SrE45pMakaD0bE8J3jWNJFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ANZ6jt3FrfvTQIyJCb2W8hcxWFSr-K4Subo4Prqciiw&oe=6A3FD25B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbiDmjgxnNwQ7kNvwEE3th6&_nc_oc=AdrzUj573PIgG7OaXOeQt3cg7IzcElOaIFy00djrth2daGzonoL5dmmUHUptpECYfbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fnn57cEedsDE5dLnem_AYj10e68sdRm5XWSVBCEg6vg&oe=6A3FE94D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9QdDECBwvYQ7kNvwHPXCRX&_nc_oc=Adr_UxQSEXG2vPbFBgHylgYKFkfyoH-G0jZI9E3cFDhIItk-ctOlSFGvxi60JhjxsP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-laJqwfPdOMn1FpHftUu06Io9u2kQZWEenpS-3JxrurQ&oe=6A3FD336"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxT7-Etk1AQ7kNvwFkL28m&_nc_oc=Ado6ipFRS5PpFfBcek9WsR5K1A3stTIMJcsXHxHD1ak15NfUyrqcoCbrQ3HsPepki-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XwFYBr4SKvxm7v4Q1S3wQUKwfIpwLQB72j_l70_Q8Dw&oe=6A3FE85C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ERSYsruswEQ7kNvwFAfW5B&_nc_oc=AdpvPtfeM8Snjp9KhwY8LwxCmy-x17SBjm8RA_FStCSwIgwNd1eYdfdcokCg6Y8mhXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p7lgBYE0FrQLNXFfMDJexaGMGWcbFSGSbjqYr_S9EAw&oe=6A3FEC72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGf9HOzWPL4Q7kNvwGNiBGz&_nc_oc=Adr7PJCTwvR9p_HOx-_Fuyx5tmbdM0H06wXmyyczBG6VVgTgUZakIK_UUXf8ESp7n_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9goJl2SvZkj2DP4xBAl9G0FftjrePUZ1INdK1hwCIfkA&oe=6A3FF14F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
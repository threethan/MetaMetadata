": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kl9Bb27fJQQ7kNvwHen5v8&_nc_oc=AdrGtEDS203hqrB6Z2eDkW4ifXsA8hvB5cZJtJGm2x9qF5q-dQJfwV1I8DXZCTvmmuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg7wANj0Eh0d4kiQfUyrk-av_i-B_0XUc6Ynne4CUFQA&oe=6A707A0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FydF-TfoFsQ7kNvwHQMGGK&_nc_oc=AdoIY1Jvwl8TrLE--rljCL0nyodhl4PWqNhbJ6_5ksrtmKTPLOaN-JQkjpMI8aXvauA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsWu7Sxv4zotVMdUDRDkHMktOXZk7TLTDjIgquwmUTdg&oe=6A70817B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWM9IUBW2nMQ7kNvwEpTLqX&_nc_oc=Adp_BfC4eTg9trEyvy2SbS4z_D370NRfJIFAuRMVb_ddpY6ETa3JSrWCTLcFwuBfAyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJvrq6cAiYL-jcurDm6Luo_SKjH106fo6dfsQdJILK3A&oe=6A7099DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVuIaaE6c_QQ7kNvwF8WV_C&_nc_oc=AdpgvWL2t_7hG6ytbbuljUKTcu03Hv6TRChCnwXxu1nBcnjt-1EW_UdPIJ7yuFpLwDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvKruTV_b14OeMJHk4nsWPNnY_2yvTSh3f9W_E88x2fg&oe=6A70788D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eEAyGpZU94Q7kNvwG7L04d&_nc_oc=AdqIzx9SmNukLbSvZMw2aelWt4WK1fVCXIIQIwsIAdrfMgM8Avw9DCDuitQLP5TBHNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_vsGlvOI1V1p9XMHiWRIa203XzNUBuPbdZWNeHZEq6Q&oe=6A709AB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nReJjfHq9aYQ7kNvwG5aaI9&_nc_oc=AdrEngwHs0UDLJ2fXVN1ZUtgKut1x1aaXvgRNZkpCB2qMK-y5NShpVkb5gHkFfM7VFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLbu7xPMQWGrPV_okifKTM47wjeXht6TSD8O1z1TRHjA&oe=6A70779C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aJaGnffN_wQ7kNvwEmWrHm&_nc_oc=Adof9Nn1U6P9j9caw4LE7D0S5lrgHLMSNuZ-RbKzjXMBLNooNIEZtXtInFhq4Fs9fBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdAnh8FnX9CfhJ5C87BlT9vFhx5Cd1FtXuCnygC7NL-Q&oe=6A707BB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r78bLW-tUsYQ7kNvwENE1_P&_nc_oc=AdpwxeKEtrlRGcMnspNyiOc5_edy5V0F2p1FXXTpk_vkeSwyRZJ71XrFlsOQ5cLf6Wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFQ0oxNAdjhHrJQoAXctVFsQT9I5iD0TaMLckBOVBrLw&oe=6A70808F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
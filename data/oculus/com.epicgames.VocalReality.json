": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwpFThFEpgQ7kNvwEW8qCp&_nc_oc=AdqsQQ5cP2cQb0JiA7SSYTTjo5p16vcy9YVYROatgk6FOCaFTXb8cgLnPQ5s4jWsPRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NV8uL8YC-pYS_OISHN6E0vHkRJqNosF9Q5OoyUy3hAQ&oe=69DE238F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvkujKBqm-YQ7kNvwHQD79b&_nc_oc=AdquSkUtJU7nCb3q4rW73uXimNtYsgrWzwNk1RFWgc6jxCeVsxRUVknFX6hISkvzlkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qHGOtcqWRzjd7LqkDtrH1IH0eUWtk1_hE_-wR8cPUnw&oe=69DE2AFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxjrOjpLwkoQ7kNvwFw-G6c&_nc_oc=AdqeSvnhOpPR7MKdMl9Dfbetd5lqvvJ5NE0LCcG4XAJXpYp7Xu4YB3RU76RHqe5zP6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aq4lFoEpASrXQnmJ5nWlrXhnPRpyHG9qdR9YQDpcNjA&oe=69DE435B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G0H2YonRQgQ7kNvwFsKCNj&_nc_oc=AdpbuJXfbPSVgd2GSYqYnizdazPbN-idXTiDNcQr4MXjPeqGqsTngR7SES9p_nAxRZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kEUdgmGBS7XmLtOQgH-Cf4VREcRItDq6ZqTv1tVsZWQ&oe=69DE220D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSuLNoTW1pIQ7kNvwFE6t_y&_nc_oc=AdquHPUx9b7Q1yTybSUzB21a0VhG4zMNUNRxDUDos8m2-jx42FmKDpdU4mUYJ4nNyV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tCsATiocdU-k6Ebejon2-Nq1GmV2tGy5fIJtR47pv7w&oe=69DE4436"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpWymXNiQEQ7kNvwH92R7p&_nc_oc=AdqYHiBkhiTFTrHvv7XDcYb0B8kmpcxKfP79vArCKQxf-GKtoZXxj988Hd6D7eP8GFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XVvrtVV6UE9hNYoLuhHwiSVdTVLn-5l88E1A4GVWrfA&oe=69DE211C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPX0Fls6zqwQ7kNvwFXIFsc&_nc_oc=Ado_HB_2iG9Y-w5xdt34OzOEuRi-xurQsx4bnCUuAIRO9aE6-1w2qyBoa2Uhcj7y35Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07CgDsyWldMDfySyIn6lpQyR_IUchuPiXO-59262GtdQ&oe=69DE2532"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6er0iVdyhSkQ7kNvwF2o61r&_nc_oc=AdqKI-NzHyCQJqbg_zafjEE1-QF4pymovhgqNRcURW4-V1sqx5Iu-vQHoi1E4D8LWIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B-rDPHt7ukKGq3h6NZkkediukRI1SLK9x-qBBDbGy-Q&oe=69DE2A0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
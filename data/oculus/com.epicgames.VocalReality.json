": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no1mpPfDQpIQ7kNvwERf717&_nc_oc=AdrbppGfjtub1eHW7gQkdCFnnZT41OOBPB2xme1oduISH-P-QXfG8pmS6H1i6vCdfmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN72BNrEkcRt3E_KdWX-sQu4ithyrrG0thR88wepARLQ&oe=69CD000F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rhexWZdyK0Q7kNvwFbYHSC&_nc_oc=AdrC8ByX3LnLqFyHiEySj1d2AOctcCzcg6T0YgX5hEvx241AhIj-7WCDHMlgEu_aNB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJxRo6rSmqLtobnBPgzRnQgQJWAZT-htALjPeU_Djbyg&oe=69CD077B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmpWJT2behYQ7kNvwGUsYQq&_nc_oc=Adp-YeAvRiI-qWDOprk9Z2ew_XzzmTXqFSWrfrlYO1Nf1m64EoBlXictHtZzDfvgbrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCm13-5DAky7hW_oTw33vxGeGwNl2zQITBV2MKURk33w&oe=69CD1FDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX9tckGxEZcQ7kNvwEFpXFN&_nc_oc=Adp6BFaU6NhxYJjX5sHL8ls6R3cNh4rX91d1w0oaESTkEjNw2XRKhisWk7tlXp_WfXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJjK8jM-J6UVsVgZSIVSVSE4jeiUAcR77GSr5vg3Ry_g&oe=69CCFE8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKqjJQGl-YoQ7kNvwFTaolx&_nc_oc=AdrPJQY4efP8WVG0EMQ9-Nfop3Gkpmc9rR1hin8RNyQMPL-hw2u3C1mI9pLkeNSMCys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYhg3skRSoKzhOxrsihRB21SxZin6PQkCuSIbQmOSYfQ&oe=69CD20B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh20OMU09rAQ7kNvwGlY9-l&_nc_oc=AdpE1_Uf2zqzoGVmsbLzUx5yjPDngUVq3VBlkQG78s9afpJWyNKjPiGSO8gcg4xRpos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ7P27df0w0wbp7AVeHOUzuoiTnGF-4rnXlR03wYlpwA&oe=69CCFD9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn09aUq1hWUQ7kNvwG0RtRp&_nc_oc=AdrlzPS_dxw10L9CPTLnw4WJ3iuLriOmaPb_KWnpi3D6vEfDXueD7ffKWCRxFBS_pe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQzleHTl2Iu3TvlHci9C7w0SXqCBlnk1YiTn6sOzpuFw&oe=69CD01B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlGnbEOHNowQ7kNvwFux-fD&_nc_oc=AdqjtbyuUr03AycZOAq8ydZiYu7kNedsMc1DPLFK4A-U9xrFIB83gEPRofoU_hUxRd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH6g44RgWgchk2nlwl_gqU7KCcqCFIiMBfk0nSInArGA&oe=69CD068F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
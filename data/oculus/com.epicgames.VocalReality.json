": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvUWAmcwODMQ7kNvwH6Ni4e&_nc_oc=AdriqAfLGTHWklv49CV4ko6C-e1Kpdr8CpOv29EHQECKr65ULgsAhbhnmcPFzJ80YNM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5G3yDH1nJWn8ylquxH_SERuKyoEJUkGXZQl54qjl-kA&oe=6A5E3D4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqQJHhvZv8EQ7kNvwGx1Awo&_nc_oc=Adp7Ik9Wp97jnFwUgFzQ_5Dnco4kchwWFSK_Y-Jegj3tM0TDDgYVHhMTWOpr3FULJtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgM3aHS9gg7K1PvNvxkC9wiOe7bJhpsEEYoz9ulJE4Lw&oe=6A5E0C7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp2DATOJotsQ7kNvwFIas7_&_nc_oc=Adq4692OcDvhvOtLa0rk2QNGqbmRJ5gtwlQacJnDwF93oTYLh4OFLv8pdvutIqu6xXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzlSiE29_4Wav1vIYptEraEVGfMekvhG1jaajscPZDJw&oe=6A5E24DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvEoXwbi30AQ7kNvwFBTgRT&_nc_oc=AdqLGoso5Y_S9SQNRnUcsRX_y8rONzG-dknAu_hyGyoZqGnBMKtovleirkAMtb1arj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ2TMbbvno8jL2TTC5OEZDY7johhR5nRdgzLI0n503jg&oe=6A5E3BCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKNzyaDHHBsQ7kNvwE2aVQj&_nc_oc=Adok2XL49a99EYyzkOwp7QtaOg20XpILuCmdcXslCRr3LN6CpRaRnQs2mT2TDMG7nc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAci53vsHOui6bKTJKAMKEqmu7sZPin2ay_CgrEgEVg-w&oe=6A5E25B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG5272ROrXQQ7kNvwF1m0oU&_nc_oc=Ado8IjdROh120dVyy3jJH3LvrfeTJKYJB_VlSf453B2r2KkOtgkyW6rQnGXC6NLWUdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO7e7NgOS1N0NjdRYBUdu4R8vmOmKd3Kq7zZbcYim0_w&oe=6A5E3ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIQRPzgIDMUQ7kNvwEMZyj5&_nc_oc=AdrVxliOiLwQNKQRdDXRouKuPM75J3fLFnOaFfLcql18IAUwRylQiBz4F3e3xmvtX1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8c4plm5VCZhBiQI6TmIQEoGTQVZsCPlS7-cRUKnf9SQ&oe=6A5E06B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w5aNQ_HG4MQ7kNvwGEMdFm&_nc_oc=Adphr7M8yt3kuuRgAuk9ckjsrm9lvDexh8lhwiGM2eqSF3TYxQR-lbAX_dSIV8U2q-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF7xEP-mSa43iX-0T5xx7iMLH4hhzXYincIjrh5sPfOQ&oe=6A5E0B8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
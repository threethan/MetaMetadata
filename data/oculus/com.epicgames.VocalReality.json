": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLKHIpHMssYQ7kNvwFqpamP&_nc_oc=AdobX7ErBUso3YYOgAHsXpYO8yqt6Fozz1qpnqjAos7g5DPyAGW_o6qtFwFgYIvqYKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1A8uIQax9PJJ-OoTnDfQ10r71rTqfxEEJPHQ4zvFUGA&oe=6A84408F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi_6dVIwV4AQ7kNvwFJ6uvl&_nc_oc=Adp21N6WIVACym2ayIMMStLAd9-WgSKDL3XGOv5j8Pnx-6IuCuMyxqZGQzWqTnyt6mw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuTJV_k4d27kiGo8BRaYBC7fh9ucsOu0ZyqCXVTwTTSA&oe=6A8447FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdIjEXhawpwQ7kNvwHVTaZ3&_nc_oc=AdrRn-0Zg1cJ3WDvHuTzdJyBhRMdlbkiXMCKetMBad2TPDvffEEAokboY1oEwswGwfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHTOoxI1WgwXmXwcqzXIsPLSLevmU2AdgzVgo4GDR0SA&oe=6A84605B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkKc4cqADu8Q7kNvwFNRdMw&_nc_oc=AdqeiEdmxYi36ljx7ymNVPhDvI_dCV3kwO7tXW9HlvFPqhgsij35N9KfX1P84wMewNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbgcLVM35_c00MC84jiZ2r6eXfSFtFjGG8BWCMYWysAg&oe=6A843F0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypQjO7FkK9cQ7kNvwE4azoE&_nc_oc=Adp81MQp1q8wJPuoo8z6fEStQ8JOf8b-IXufVHa_QfP1USOWVGykS0325fOFlXliN2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl2KdkLwoZhGjiG5TCyTUFG-NUs-mefWEhpCwUylrPWA&oe=6A846136"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg1pEGQjHHgQ7kNvwEPwnuk&_nc_oc=Ado1jArZqzptUL-4FmM-n5YFAvfmdWH-owTKB16kKBlIJzoyxA1C84WbaAD9lcM_B-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4jC6F6APyB3ht54aGzW1KNKRLEv0q0oxcdcnzKM2bsA&oe=6A843E1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFdQa3kC1zQQ7kNvwGrwxqo&_nc_oc=AdrNwBzE7I9h8bC6SuhVaSGYl7eiefiCDVckeuiUcXFk-bU2R_db_sP7W21k39EpMvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTaQppwZmp7MXzTOjEjaPweqD0_YRKwIzYmv0A40-Z_Q&oe=6A844232"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZTYjc_8M0EQ7kNvwHyaYUG&_nc_oc=AdqiSr9xvi7cSrmzHY_UnehGbGqAzF7QiLlW9r4SpekwN3fLZtIMgngS8yXSrCxpTDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzNkQJtOPMaHcE4SEcHLmVwnDNNbRfsvw7sFK-KVNLIQ&oe=6A84470F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
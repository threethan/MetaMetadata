": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvUWAmcwODMQ7kNvwGIvTHY&_nc_oc=AdqeIAJorLyVDytG8enJ8H_anWtpmdKp-V9BnoYqxBgGqBWiF7CkODQ9JrVaRcRrti4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByXXZtB3ogeAHS_a314__aDazIHs9uUczzk9sDyepz5g&oe=6A5B620F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_VONTFDHIQ7kNvwGweOI_&_nc_oc=AdrdLDuesYAc0q8mjc6_TvQ6-RipZx6qj58k_hbI4iSAvw_9QC-sNL2ohmOjLKPV7EM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnc0mK0d-yZddU77sP2spbhs_esmLagzFJdR9-sz_r-g&oe=6A5B697B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYhgvB5TcEQ7kNvwE5xmYS&_nc_oc=AdpdaWQlbzmBpovBu6IMAaA5oVqpGlxSxf65ges436VgCYKPh7-6t2G4ElrUmb0Bf0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHeNjjia-04Td60p3VecieQOwv2fmFyCQXM_UMgI4_Vw&oe=6A5B81DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBiW_czCo7IQ7kNvwFXnTUC&_nc_oc=Adpq0VZEri8dqVxtUmCDVgnMdJ96p_cH7dcT6_nQXzsFBtBPSFs5QLnrfDxY-UUd83A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpJD9pOL-ygzandKZM3fQEe0wl-s5QWNTg7FCoUqoMyw&oe=6A5B608D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKNzyaDHHBsQ7kNvwF8gcHH&_nc_oc=AdrWzvn-NATgiu0kceG8dTd3Kas-vnhkQEQKyIa2oLIsP6JSLm9X-tJLI0W_ubxXGJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfK6Khv5SPxMuSlrFNrf2PcdUO0c_wFbicYt4k9k6EZw&oe=6A5B82B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZMv5p5pYcoQ7kNvwEr2MMU&_nc_oc=AdqllIAKtQUYZSt_l1aAVmg9F9RCQPuZAK9xBinEpf_f1mMks3cZm5pI5O6z_6ayG-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClnL36SJfXHWkqhyJLw2WMBkE8XlZbwrJEP6qZKjoxHg&oe=6A5B5F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ERRGmROVgQ7kNvwFt8LPM&_nc_oc=AdqOvkb7ab9Nd6ioZa-5QsxzPEqfhOzpdVMT2VqLEkYvQBvAzYTj7vFYUeQipFsznBc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMkvVWqGK3f_WBNKBDOaCLZ_cpNeuMpDlIapRLyHAc8Q&oe=6A5B63B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w5aNQ_HG4MQ7kNvwFbSVPM&_nc_oc=AdqNJB5okl73l47jGDlu3mu7J7mjqdF_dHd2JsiD0yputyqYi_g1613y0ymecPG5688&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC75quap_uq1cwYqx4zYhYQCzNVjv_7ZmjYWk7uHq_ZgA&oe=6A5B688F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
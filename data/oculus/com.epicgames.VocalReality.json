": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJsjufXDuAQ7kNvwH-aDud&_nc_oc=AdrNr3iLCRGqM_yBGlWr2MBkTNYwVHk--OZb20dcpG7eVdDbgjLy20AHrzsyjPuzMbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDGH-09BkO2oKaIoKwAKEkvNwUghcx-o_AhpaOxLSmeg&oe=6A9D854F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRjqg_nhIfUQ7kNvwEvIftv&_nc_oc=Adpg0PN_Mi7n35iQvtov7iF7Ut-RX7wcXxfac_hFkBKcUXlRJ1qR-iZA-k9ohMyqew8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe8RDQqKYRUvJ_iu9znk7O_Ez08DtXkOqQaQcdK8B7gQ&oe=6A9D547B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3Mr0XOiaxYQ7kNvwFIHPdv&_nc_oc=Adrq5cPr-sdi0vM-zNVPY2SPgcP1s7TQ90A4rk2nimYNeMhs39cM0mmf9MkKbNvohHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJjO_W1RJrhk4GhhNjWGGMg7nZWug9PfQMXELIgZTzIQ&oe=6A9D6CDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1nXn_UH7NMQ7kNvwGHGiFN&_nc_oc=AdoIz-4Axa950Z4Hgf2RrQ2hbJUgnHDY87Fwa6LBAIDrgBcC6APG3LcNC4gjKFRIT7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNbNva07bvcZxl83GzVhdia2mtYj7FaUFUdVNfm7mgXg&oe=6A9D83CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=704AOVzRS7QQ7kNvwE369W8&_nc_oc=Adpi2ChIB7PVLzq1YLJu6WfXpbOwj9UYONxwfjP6SxmYPMrsRPcasY5-_CUtTZEVrAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPDnL0qMtPV0S4acD1QTfYaV-35jW9bYftmzdnZQfwrw&oe=6A9D6DB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R1KTQaz_h8Q7kNvwHvzGSF&_nc_oc=Adop1T2gLx3LzaHCzpqWzF8umzH4dgwIGjTzu4C9Y1gOYRZ78GnzYlLQ3_DtqNHu5k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbXXl65zyrYDXuMjv-j62Pw4QpGHYgfGqwCu3_BTGiiQ&oe=6A9D82DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FINjk_1e5J0Q7kNvwGkZ255&_nc_oc=AdpAu8YMxt762Tfxl2F55ewmQPj5W1igXbtGcoZwhwCrCBuRJqBA3O-lmo3g-io4BLw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgiNcpy_g4z0eL97JBP8hwycuhj9iokaR0GJtLp51A9A&oe=6A9D86F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4CImBHN8IUQ7kNvwEjTfM-&_nc_oc=AdqrztyIRiFr-UkN2M_xaF0pOLqfp3XlFUFS_CICwd2a24YLEmu7iQmbsIvGiieh-UI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_RSN0SgeGuF_9K6U9btRX5fQgJGkw8vAsCdPqZUlH9Q&oe=6A9D8BCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grl0Sjp7wm4Q7kNvwFwxy1x&_nc_oc=AdresRi0p7_-HDV3PT0wkCSOf6maox8XC3H0i4UspVvHa9sAHAl8jhP1ZysQGYfMUvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81YFHT-2J7gMdsV1rzv3OII_qd-at-M7AAMsCrdlIqRg&oe=6A282FCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHEd55TRaZIQ7kNvwEIWcWB&_nc_oc=Adpk4G0fI6qJIDqBe15bTJ-cNLMuNUOozS2XKBlqayd_QXnVEEP1EY3RjXqR9Y-dQ-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HNa3l3cLTQAC8X68rK43eana8zYLbVDq48AL3GdEztg&oe=6A28373B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1lExa3K_KQQ7kNvwF3ht7O&_nc_oc=AdrtlDkoCSoGqMFE8zxFgiZKhOzMrBuce-HIdZcnx6nbAytpJxIdecDBD2yUfE0bc-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KbUjF5Uk9tzzyDVS-MdPKZ8g5ao7775e8v3Rj_wru9Q&oe=6A28175B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHRyx-ZNPygQ7kNvwEmxjMy&_nc_oc=Adopki1D-bs1vZqGszZ9vcEDAjjHtFEypb3FekDPcHqHfdg4cbc-Ob9lBKxxZmebTbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_djt4-wH7TOn3ey2U5fhSs0hb0iJycb1dwgINzCoq0og&oe=6A282E4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZX8FNrCqb4Q7kNvwE-1o-H&_nc_oc=AdrivQOalKMXvYUY4QBSlYXQ7bHG0TPAgewq1_A0-6FzFydV5KGQmeacMHIJrF9IxH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SzUejB_mBsJ4W0YyfY2Vt_M5H9HFf8iT2DRkH_dzuvw&oe=6A281836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKx74B2bYWYQ7kNvwFBSash&_nc_oc=AdrO5RtDE_E2Z9iMkNMOh0tCdOYfejC_QPek2UE38ZDsB9ETWPoHG90aq3m7eQNQAQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sPj4UbuWNPr6-RFlEUoQ38GjLsibIgTmqw45OiIevGQ&oe=6A282D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ6c76QSBowQ7kNvwFVNhao&_nc_oc=AdpP1HOeHnlJ2su66INEo52mooytR_UrH20Sx6v-6v2VrP4Xj9EZ3Qy0vedVAP19CG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ECcoeiPTJGpKhnfurqesGhE21wAl0aR5__TyHEMXFIQ&oe=6A283172"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0N7lzx5FrMIQ7kNvwFU5mE8&_nc_oc=AdpX8MEEZjmd4-eBdYBnDXjj9iKYlqdpDTFy1x0QEX46OHE-ochVuLBdK08HOXdSQ8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8muR_mujfbWoQFDdg3BP2Pl5aDpUdaQ60B6qLO7wLbtg&oe=6A28364F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYtctuF8f74Q7kNvwGTRAgD&_nc_oc=Adoc_PN6lt6IyoZI3sAv9-6M5jRC9PfuGBVAYV9e6Z_x4m3w4Gxfgk5y-tLcpDl0v5Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnS7Yk9K7DxY3uIO_205r1tK-GAc7Euhf4QbzADpGNcQ&oe=6AAD574F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2or4c26pD6QQ7kNvwEwN9SN&_nc_oc=Adp5unPjfwpsl6lbDtUJRW5vr1gaj5AM0b8qKv7Zn6DSOWbnA5Jbj1k5h9G2_n80z8Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxCcAPuBwACTAKe_Cc489TgVUb01YwjIWup9VmROdQOw&oe=6AAD5EBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayInhvoYaT0Q7kNvwE1A4bN&_nc_oc=Adr8vp0VDodZo4JqoKLKDf0l8uIPbx8lUExxwrdlGA0XKMCjXXjsqQmGG_06FQkjrW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJikJscoOEEIK9yYOoTdmKCs_0nIOaDlhwOBrKat8z8WQ&oe=6AAD3EDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kImUE9jiB5sQ7kNvwF9PANI&_nc_oc=Adp9l-9U5wletUfqcpzpoaeEdcsgs70kI8_saCSWpLNUuehtxemrfwjOOtKuMuhaJVY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1nSLFV9QB7cM-mxdam-t964QPTrlc0MOeK6O91M5Pxg&oe=6AAD55CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql-apW_mmgMQ7kNvwHwbdnN&_nc_oc=Adr3T31Kzaq_EyedK206uTddOQb_l-8aqd_cHnfOSoybOf5JT9xFEFRPLCBBXehb5L8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1BW4v2BxNHXnJJYjwwB8ktugFMnol_hv32eqmUw5enQ&oe=6AAD3FB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQoWmzao4-8Q7kNvwFLYeRq&_nc_oc=AdpVqvtMD9lAbC1STckRgOlr2TLLRTtH91hEH58yEwE1H0sJXvkOiFPGVlB6fE2cmfM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj5H7Rhee0Ikwpfz_y822AUBpTRSr6KERm8uTHSuwinw&oe=6AAD54DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBOCEx7fCn8Q7kNvwErxmlA&_nc_oc=Adqxo2x0CSI2umkGD1XxsD2wC4I1BJ5xUqeb_35doe4vL7cjweDz7Si9ZZqLUGjULIg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7SunMQnsMP8jJPb6mVM90ClaDKPhOoZNkbz9wYXhOxA&oe=6AAD58F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2VW3mOrrVgQ7kNvwGmc5Xj&_nc_oc=AdrK1DHC6c5fn51E6RHLXLOI3VHc6WXKpj2CIgV2gZwCur4uNTpSfx6lrpD2doC24nU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh42zsy12Qym7-NzQVVdqlH1-xxmD2_rwknuIffluXfA&oe=6AAD5DCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
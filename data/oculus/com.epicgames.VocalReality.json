": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwpFThFEpgQ7kNvwFsmt-d&_nc_oc=Ado-azGUT1dtZI8W0HKPSPSvnE6ax-frZjal7EZ3nH7mSu5xdyooeke2uwi7gUplDdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LT_CTto6_F1rdeN53wNfie8RJYqJG9ymyzXPGWFOq2Q&oe=69DCD20F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtINwMakd70Q7kNvwG9i6n5&_nc_oc=Adrk3eqg9KNV7lfv7C7ZuBU0fQKxR9pnGZnEHWfhPcFjQ0qR2LURMJpQNH6NCpSFZFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q0WXdQWKUp6fV4xrKelrJfdteVpL3dqwyRirT5W4TRg&oe=69DCD97B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxjrOjpLwkoQ7kNvwHfQ5RP&_nc_oc=AdpJ7rz2dRKUKjbI7b6-cyas3N9_smF4bhyzugKdxDqbmJ5n33HX-Qct3kM_hm3qE5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WTmR1BWZyx-oEaoreW_g-3DB5TzLU8zS_P5fLcUdkqg&oe=69DCF1DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cGhabba_tMQ7kNvwHYGF_u&_nc_oc=AdrP9N_cb4s32Z9TDWILFI5h8o67ClR0akj-ncvABdhk9Qhz3jQIf9N16b0KwAILd7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XdSf2Uc5uKGbXtwADljlX-QwzmkKkQBYM8v2Z_O5VrA&oe=69DCD08D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSuLNoTW1pIQ7kNvwHEO9hF&_nc_oc=AdpCmdsNyh0f3lPbxn-8JNX1_tdEDm057i4ok249vzz_Q7AkmbwoOrsmlcFScIr8txM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UHfqWnVktfuA9xkjxkKq4CgmSo2r9mZE9vMqZ9T4rXA&oe=69DCF2B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGzJjBt1aX4Q7kNvwFlyRrv&_nc_oc=AdqG5EtT5GOH_oMOYQXrbeItrQI94t3oa4znM_v3yzm09krKcmOEF8zyR2Xia8zsyqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N7sk263IlsKLmV3uwauQ2KW7_feg5YxaTvYIGcdZ-7g&oe=69DCCF9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPX0Fls6zqwQ7kNvwHvqdzc&_nc_oc=Adpsta5VxOvoUEBGgofX9Q14M7fWDzwZkGwYtq-thzLZhHNLMFxJD-FMX1fAD_ecnJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dauWI-aQ_vpxYGeUqtEXCEKS2p9jEv0diQNW4fJsf2g&oe=69DCD3B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6er0iVdyhSkQ7kNvwEjEEVT&_nc_oc=Adoap8dPiHGbNXxH1AXy-PKvutR3sMywjS1lr58T64clId9eS8uCcVJwVyPUcCAUjO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DVOGkzfqJZeq6qS56KjNK0l1TjNhsdYvQO1AJ3-5TEQ&oe=69DCD88F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
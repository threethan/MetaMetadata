": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03kVQ9zLduIQ7kNvwG-tWAm&_nc_oc=Adpzyr6K6zQAq7W9JYKZhkLIM-N9bJgfbHhp9cu1JjirGX-2RgMF9z7XMNUT8naslMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG0F1KRIWca4IjDXdx6-hIRNdDxkh9uTd7gwHOEckW9A&oe=6ABBD7CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1dYarNfiDQQ7kNvwFmPohe&_nc_oc=AdrIfXSTwOpb1KpEn6yZMd1vlK1114sBoDPgTtURWET2c5Oo-LPfco55GXy2WwWyHi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEzjlVeMj4_lDh5TM0cs_UcEFShVHmMtEI5wdoqb_H9g&oe=6ABBDF3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAxNDCYjtb8Q7kNvwFC-Esq&_nc_oc=Adqz7GdqmHetQ2RzOWRwKIIsXb-jxuiidcpCNUskAia0nt0IqIGSD1BZm0BwxF3tAwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfLuUFFBRjDOFPoIsazLvQMT2LYfJASldWwbFDYW4bUA&oe=6ABBBF5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NslP8GzXnUQ7kNvwFOBM4W&_nc_oc=AdoSnljE9j5U5s0WGzeXuGPt3WMWnaWnFFOcexyWfiK1UWta_cwA4QWt19WnsdwzIU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZHtm2f2JxplgePmaXieaCkCyRaZbwpPuVT4OPFUe9WA&oe=6ABBD64D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSQInzcIUGIQ7kNvwEsUXn2&_nc_oc=AdpJvJQ5gRP_nwSW31GWH5vePPz9PFqBdClHaNhVUcBk545Kuk3h9xThwdJ6RslBN2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXlWI3dvnOklZ-Y5I4KOLzgCqoN0hqJxDC2QALDGi-ig&oe=6ABBC036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLQ_sLfrjo4Q7kNvwEU5EE2&_nc_oc=AdpJMCCsZOnaoc_39ahPQB1KvpX33e4boKAr8eT1Z7Ps1i7TCyK9h78HasyGfu3y3D8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo90lIMv8-_pDMSebq1ZTp9gX17Q9AoLu2n9DzoJ4PZw&oe=6ABBD55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ3nXY9Tes4Q7kNvwGurieu&_nc_oc=AdqiNwgr6Xy5EIEAwFZKxr4ILTq-FRtVSnSIpkt-LOXRRXAlIwjesVCcCqY-B2AhGfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAbU0fePfDq6ElQz30Y6ZGVCJRQ9rvEZkkOwu7P3Snzg&oe=6ABBD972"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVkC7PcNgtEQ7kNvwEzS2vK&_nc_oc=Adogglc8eDHFOr7jgigx-ZyZ9rNrzquW693yC_xLFEAy-lhd1mNJe3m-JV7u-iK-01o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZImPzEzJTlitU_fl6ScsvXgOUf5_Ggb76_5hmQAIZWg&oe=6ABBDE4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmYWvTykZCYQ7kNvwEo7N7G&_nc_oc=Adq5y__E4C4-8miJFJE7jZY4vTPF6QPtBuowTYhKKJuARWkB5pzmrLYe84IVtza0aFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5DdEhlAfyXKE9dwLRqfh-pfvRRPvWB7f47tqBjwDVAQ&oe=6A73554F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FydF-TfoFsQ7kNvwEoIHSE&_nc_oc=Adow61MfU_6E1Mgytpw7jmRZ8cIfm0UMzJlNtd6vgkWltBRHxiMaqhYSpaT8r6IuSbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYjH8AE5HW-wrqdTKwiB9YTXX0SL8zsMMAVX6Sq6ENcQ&oe=6A73247B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6iINGIdID8Q7kNvwFs_Z4i&_nc_oc=Adok41N9HnCytGdE0DY2-zaxfAdHyO-btISPDhjHQXhGZDv-r0cdiL3F7X2g0Ol3Y6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMwra0OG5oPl6GYIjMmLniGtudOUlRMlkUKx7_1j4yOw&oe=6A733CDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVuIaaE6c_QQ7kNvwHdUDRo&_nc_oc=Adov8WiVxtuHt_x3fBgRzpFiVjLnbKyDUsT6RqyhKmsOGFSS3d4YgDxgrwlaEFXSGiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ2GjS9iPRdZSApRLd_OcUQrPOmWS7H8JYfWF6BpzFBw&oe=6A7353CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBt_ybe8Xq0Q7kNvwFORrX6&_nc_oc=AdqGo6RMlx1mtqoQOEumwBTgbp0T7hAwqUJCfK4ky5zvZ4G7Q_ms-VIYEpnA9S3RBZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9O9NHeNdKo9QhWkILn9Po3wMEJ0E2AtaSOPBkEh4X9w&oe=6A733DB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nReJjfHq9aYQ7kNvwF4MJIm&_nc_oc=AdqGwx6s62EiPagUTHISW0UARcNRLZzOHAFSAmmsh73kciVqKvcP9FZzJJExr2_MPY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHc2RvvNVfv8Q5vyDegzz7bTvOlsoOLsp94NbtS5r7FA&oe=6A7352DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfMIsuxHnSoQ7kNvwHo1xf6&_nc_oc=AdrRpBcHzAqw2BjqiVOzxObWsLOKWwHZpt4pXHMcmOWkRXAP_aeWLKc9rLcT3amaq1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1Gpchidk9z2I3n_WDCb3H1zT3r7zvT9LQMIiRSsHbSA&oe=6A731EB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwr-NQpRAYAQ7kNvwGEyfOS&_nc_oc=AdqHA3NYARLxV3I-FLPuR1Tt61UnCgAr9vlS3s9NYfRRa4qpQnpZrO71RRjdnaHS0UY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQcz7vgiSTlOnsd0BfnkzOxv-OyPnS0w_36teddtnDrA&oe=6A73238F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7imL0j8lZsQ7kNvwGpTHm-&_nc_oc=AdpW1peIKzPo0QpHZsilh9g62f2rhvF7NsGdS-zpSbBim79YG1hb5lxWpsIJNKWmbXE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOTlafcif_Uj8726t9swTxQCcYzlzpkzQTwptXXPdsdg&oe=6AA4243B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRoKs-5bGckQ7kNvwHQP3vr&_nc_oc=Adpih0MJVtwKQz3liXy-zKSd_tO1iYtTcMPWOxE1OvSmaLJc8ORz3VWQuEdOMg-bW9g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0oXO-2afrJ7r6quw-em5h1VIEe22XEjSRgh9W9lSWUw&oe=6AA4045B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWU7tCSjctgQ7kNvwFvbdmr&_nc_oc=AdpE51X-Cj0e2d9E6YBWmnAYEN6Gykz3SUcmayKGW5k9Sr9ScL1WnPqGePav1WqFhHA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOK1KeAQiN6k_GXIqz9KkNtZwcrDiKKB19FyLJsRjq6A&oe=6AA41B4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJphqoKhmY0Q7kNvwFDNXAK&_nc_oc=Adp-HLG6auyfCiN59TXzr1RHi3NBW5bMMSK_WxY87fluaKM9ZNNs2fKQ3SzyMXd78ik&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCa49HRzOJ5jcv208mCYjRqhJ2x5byTbJePMe3H-r4_A&oe=6AA40536"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTuec1T9_SwQ7kNvwHH8pLd&_nc_oc=AdroHCx223QL8-BcrHI9_7xI7tk5AwJ04UPHJIUUxVpgA_tQ1rf_wSBjytIxYiY1x_M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0-PLf6a1-e---zdJMXY7-YrSHLlN7D1dbQ9WC6eguXQ&oe=6AA41A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
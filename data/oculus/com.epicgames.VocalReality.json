": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49KChxcz8FcQ7kNvwH4p0iH&_nc_oc=Adr3QoVQNTya9htwmHMNcgcNo79sdG9Nmt6VEbZntIUbgUMPSK56q9GxF3Qq6-jiW68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07PnzjonYOBn_0XjqqgZSybNIvZAzDJnMoMzhpwuZgeg&oe=69E0FECF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvkujKBqm-YQ7kNvwEdrzsl&_nc_oc=Adra97Jf_IHkXuYhchNFiOmbuIEJ5mkCZ9AaVoLiHqfpeKAH4vsVVjGPGO-4xvvcZhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jL_UZdzqa5OFVzhb80FDl00bxBeDo3rKkeGiQtz7bzQ&oe=69E0CDFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7IuTjCDr28Q7kNvwGJSZk-&_nc_oc=Adofw5nqSmORKF6Qk7Gbp4EsSgo1eAdIY_t7Logac4OAk6uPrW5IZpTLBEIHpI_gDbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tyjOLBscBa7nPtNY9lVw2kqBmziWeNA9mb_Jp2G4AOQ&oe=69E0E65B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G0H2YonRQgQ7kNvwEItdB2&_nc_oc=AdrFUVr_zN_LNE0q2wszZ5HS-owczyWF3FhipmMIM8e8NBAJd3my7sXIWhAhxKtsYAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b4yjrY9GXjWvKzhLcxOxlM6THmWd2iF77ebC8y6Z8VA&oe=69E0FD4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB7OlVicH8IQ7kNvwFwtq1c&_nc_oc=AdorgyRFkh3IkdVHVTABorDhEWeOL_6c_jEY_pp2TNnGCT6Uwj1bws6qXj3LN12EvNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cEeYQbhnH4OtuI6wFud6DY8Xf9Dv8YuBXCo6tnwGUhQ&oe=69E0E736"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpWymXNiQEQ7kNvwGZU6LB&_nc_oc=Adq0EAwxL6iMnInXSEFaYMi3sfeBoSjxeq_cwkJlT8b0LLx5v4fTSc7W_S2_FbOO52s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IoR_MJamei_k1_HHo56J1b83yS8hNH06jXzv_NL3uFg&oe=69E0FC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLyrHMTVbvEQ7kNvwHc5flS&_nc_oc=Ado8NbLV9idz8fWfq85exIxMMsxUvkHmnaKosIAzY_fvJa9WwyW7RaSzgdl_lQfnmnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IzehM0MvEwUL5KYASOeNtVWdwy70WJJ7qG3niIGEEtw&oe=69E0C832"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDWDbwHyloEQ7kNvwGmVTq0&_nc_oc=Adr7GmF7CI9zWmy0W7TJocsvf-Ly8nyRQ_TATTwwYCOXbJNOqHAl8SRnhi2hN5z2Gq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qWnUlShLUxAk2jbLIe0h6Bx4GxmFMm7VssTp7FlqUPQ&oe=69E0CD0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
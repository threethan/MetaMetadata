": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLKHIpHMssYQ7kNvwE6fq5k&_nc_oc=Adrzic5QmnlnZb4owFGoas7G174a4-i840QqQ-DP1kMvzgPKZd6pC_Nni-PS1fHSKL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfnCKvBrX7XuM9jlZz1OaTF0kHcaOX2Rijvrnn4R0rVg&oe=6A82EF0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Riq_mNdg4K0Q7kNvwFhTpSJ&_nc_oc=AdpFWz0jlhASdl4UZyi67vn5zDW07EJneLBltShCRLj_3IhTDNo2j57Io5Sd-GMyTnY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFurhdKpbk19RcNOb8lX5K6hm_B07IhXKwyRQAZS6qNYg&oe=6A82F67B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdIjEXhawpwQ7kNvwE0jBJI&_nc_oc=AdoID7OMmo9g7-wGzpJnftOokpKwD216nM7zN8uMiXELd8lct2KljhrYSGPsgVZXvXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGLyuGEVjQxMMmJxghECOZws3JD-gcG5L7mYa-76bUpw&oe=6A830EDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9e8wyCcJtMQ7kNvwEPo_xs&_nc_oc=AdqHrvooLFT4j_SZu3DdadB_YQ9CmEmqXxMymDnGP_796xIVrT7MF4G0i5EzDp2SZec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqacTbENJO4pEB1pJOqfc09-9TBT_AuIUR5A7VW42lXQ&oe=6A82ED8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypQjO7FkK9cQ7kNvwFqVPa4&_nc_oc=AdrnUhbgzeqDOL5g_JltPLUZenMU2AqphwB1w215Xnouq5nGHqWh6e5ZGDTN0A9IcqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKZm9Mv9p5k4vtikF5PxcILNoEcC5jPAUCiRNsLQmAzA&oe=6A830FB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJPmFXhkShAQ7kNvwFyASqx&_nc_oc=AdqQ89_ehPUoxjGH1qZaTY8O8u4S0gxivw_tdRfwvRzzVtpAYqSYQAYic6KKWbnzN-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9CYhRc1yIv0DJAhHQPAmUW1rFV9Cg0d9A_of5y77UMA&oe=6A82EC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFdQa3kC1zQQ7kNvwEnBs3m&_nc_oc=AdqbCeUq4aq_YpKH-BCul5bHLIzNECdmotcC0Gwga-HxnKsvQ7eytBz3p1b9UCZzZwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ3h9gK6_Ol8w72Mjzu4ksPaJGZTKHAUf4ONCR4D6a9w&oe=6A82F0B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZTYjc_8M0EQ7kNvwEj_xNS&_nc_oc=AdoL3mOdbr9zNEmv1mxy6RrBVDenNu6t4qYYsvOjQf6qq72GFc0JIGlv6LNnYaIQkSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTUuoSuDjZ5YyKCxJr1KDIueTg9VdltZ0fNhCwX3fj8g&oe=6A82F58F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
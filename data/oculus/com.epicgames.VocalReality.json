": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy7-0Qy5mAIQ7kNvwH2apFv&_nc_oc=AdqSi6IbHZs0uKCPcfrf1i3vzgRiig3CdCDl9iFE_f-dqa3thizUGzXeLhwk-31rygg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDahY8Ije3B13_jD4v_tCV1rQXQErF-KjT_cLiiiFM4kw&oe=6A510E4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FzA5BgmFcQ7kNvwG44HZ9&_nc_oc=Adr0_iibo9Nx4zhSIRD0GAqydj2LkAvwrk_Obi2nfc-L4IzUoaVOFSzdhyxbeVfIs28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbtE2J4c4WjzTpIbPaxcibz2pB5cCEpOiku6RqeNeglw&oe=6A5115BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXIxJD6Szu8Q7kNvwFlztW0&_nc_oc=AdoEdR7Yf1W3mp9iP5aaEFvjbH6Eixuly-R4nZbGCfcIfnZBVHK3qi-HmU0qKy005Nw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYNlbJI4sTah6BvjBjXXov2w--W6ro_11O6NQI2BIAg&oe=6A50F5DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vixMhlNqAwwQ7kNvwFomY1D&_nc_oc=Ado3Ds0P7MvDvDcwzFJ_OEwJAxKEKMdmhuXw98Zjb12zFEZSCOxjFOZvYffypAz0ML4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPbNpDfYSf1OcCY-UicKDyUw1dA-tGLdbHys4nUAXRIw&oe=6A510CCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZWxsYsKwcwQ7kNvwHLqVfo&_nc_oc=Ado8ydcXQiQw44QAb9-cMJ_bFnpXiI_lhm_RELJ_qUQdccH5ece7vZSACva_ZYi5848&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8KOl0n68XqMfIBofzNAQ6X_5CHrJ-i7cz4EZihNO9IA&oe=6A50F6B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPcbvzpGkfsQ7kNvwFFAFFl&_nc_oc=AdqVZQ_86oWvEwhVQvwN6SWuu4h4WQh9UsG74-teq3ddxnO0uHXLe0t4TL1qdE3PqQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYWgSLXG6nbjYS6jM86eVIN9_DSno1TszzdF7hk_0odA&oe=6A510BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4WQanQVgjAQ7kNvwFisGNB&_nc_oc=Adq9ggGvvKP7EyUUmFPMp4bVsirV9GNqHJ17xY6gPsboDi3dwP82VnTrlBGTK34e-3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArRkS-wTmhfORVCyVxTzZwelkW2_jLWh0JcX8NG6TkoA&oe=6A510FF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzqZ6c2PCSEQ7kNvwGOzuyD&_nc_oc=AdoUBtR69sYEI_-PEoHYU8sXEHgztZ2A4WBJ1XnsrbDHS-aSa-xO53tVeSrOsB53c3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhNgG0SGBCqijyBxtj_SowQXSIsi8YaAGlQNTaxxWiDA&oe=6A5114CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
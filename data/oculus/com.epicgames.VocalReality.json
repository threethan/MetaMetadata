": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCmls96UhsYQ7kNvwGaoysY&_nc_oc=AdpEGVNEUSCuZxNxUlXQ9A_eI5PzET8Aju_K-n0r9m-Q8R5azfgjXZiOe1bFlMvZ7wI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrzKJ5LvKkJfxXjuJqHl5s5rFcU235A6nB_NtjIM0yMg&oe=6AC3C0CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p__YlkUIk4Q7kNvwF3oHWk&_nc_oc=Adpxqb5jw_GKCcV4QdY74sHyKQhf8MJeSqM5lJ2so_ES6nCB5hgZHYeq5o43LrBCMU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYtkHscfqzD9Duo0-YqJlBPUR2xTXWVLo8c-6w2VUxYw&oe=6AC3C83B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWmRlktZ0wAQ7kNvwFIhTFm&_nc_oc=Adp-b9kwxzvGdL89TXoKNETYuF_WC1Fs7advya9bhynfZXqU6c1BcxBDmqwwj4Euutg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTj6Z6WMhXD9IqP0oQ97BG861FSI3bgjT68F4SSF54Kw&oe=6AC3A85B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDuC_USJzyEQ7kNvwHeiGH0&_nc_oc=AdrYUc7XR1ukmxq-ND6AQjJWrP2WIqPm7iLnBu-fG1mJdWoPsAyoVzmQmu-78c5ekxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6WmnU23LkAhlxyGAUHDfCQ3KX7UmeZxryfyuSSnMm5g&oe=6AC3BF4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZV4YPb08agQ7kNvwF8BUiI&_nc_oc=AdrI078DGhMG8u3M95yVaTMGNd5mSmWkgD9imrL_IrtZveUdajc_TOZ5LVhGVLeKtK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0FbLqAwQwVaQ04P4QSQOCrs8CVs0V1IZPRjoYurLxLA&oe=6AC3A936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-4krRiZ3yEQ7kNvwGN7eeh&_nc_oc=Ado3SK1M3pyMYIqQ7EVFMGg5k7k_YYKVmEj1bS9rCKtOz3Ekl5JAp8My4lwxeD_qon8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbG3npGIOWXfsam1rqzl9Zvz_EJ4rQHX6dPg3FfNvAqg&oe=6AC3BE5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f2M22SuEmQQ7kNvwHgdyv3&_nc_oc=Adpn8v6jfYK_6KUtEP8XuUIaz6Kivaoq06RLNmoJO-azyJdAOXv6Esr2rAJ20gc_ZMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyu-DNs_pTZ6BWeul4EgXeGgKBp-iTV2sXCJr3mBpN6Q&oe=6AC3C272"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgvqKya-mLAQ7kNvwGNuKn9&_nc_oc=AdoQ4VM2XjP3XX01shusww4hzCa1zb3tRZZWTwveXXizr1_3-dkobGYspNkJheo8xeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOquEKEMKRWYT_vjjxjBgRSBQMj2Vn0DOTQu2YnrGsiPw&oe=6AC3C74F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wCTBJAWDzgQ7kNvwFRf5Xv&_nc_oc=AdqPm970bAtJ-NkMd49lauRQdRYOnVnIke9u5aTD1x-PkrMdXvgiEfKMsydPFI6flAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqXN5P7f92PHMvF2q7ssryarRrQa65BmYouig15kMgbw&oe=6AB7E34F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcHp-gK_DZkQ7kNvwEeCpff&_nc_oc=AdpW1IHIMH0B_gRBxJZ7dcvs11wMieEtGe-g-AThuscWiRqiUO81i8p_kQtxkl7erNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfn1G17EIOQeDmmIbgOYLFS-fo203RqQoQbMC30WnS_g&oe=6AB7EABB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjCED5CSO3cQ7kNvwHjbqho&_nc_oc=AdpVmgjCHpugWmWCvCgyfnV8LCaKpomGxZ8kjrTgj8diVnZCL_e7gPnKHPq6jjuk0ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUk7R8Oju3F20zjHwmbF0YXZxWQC2Ksu3lXyfo5ueByQ&oe=6AB7CADB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_B7j-8Ao1wQ7kNvwGXJFlB&_nc_oc=AdqyLHFFka7_zfUtVPqsxN7PVDydX1f3I-J5OG92SGXgqVXRo2KnDNPNesDLbJuGttY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFSS-2ANsLMRvs2HW-evt8Fk3-w_NWAP634pk8PAu9gw&oe=6AB7E1CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1DkcjLH8UYQ7kNvwFQaZx9&_nc_oc=AdoGEXWzsmn8oOt4U1lBsFcmmSVo3D9cOZ1Wt8_861NdZ2-wCd47tAR6cv9g62c0HC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCY0afZxtAFPcZphc1Kq12sT_2lElPn7HLqHZiyTEueg&oe=6AB7CBB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KDQ0Pm2nLAQ7kNvwHQjpCB&_nc_oc=AdrTx0xJQ1Mjxdy-mS1FgIN6suDRxW4y02tsmElJNuCOuqEVHjLmQY0ZAeuUo02XjFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK04llx9Yafnrfk8915Ir4tX4xwalLFK6mIrLuu__I9lQ&oe=6AB7E0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbrfvEvuVhAQ7kNvwHjnh07&_nc_oc=Ado4FYA-nZd_z7bHKjuinElhZ04ECQ2yDL1N9XIxR41OYQ25_rX0XfcZ8e21fzubZog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDoXv709hWTHvtxtZoylGnswlmXoqDyY9mBp_Fl3-Q8w&oe=6AB7E4F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KbPO3c_q5kQ7kNvwGPf9W-&_nc_oc=AdrDveqK7zj8upF92iJzlEurZdFoxDvcqiIrGtqnYRE8d1RL-d2AHhBhS0OJdhmrqTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTZkdvWVj7I_ieSM37yhPOA4luyt2AkCSBCe7n8L6gsw&oe=6AB7E9CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
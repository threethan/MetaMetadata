id=6e7a0a&_nc_ohc=Xu2UosQP9fAQ7kNvwE4Ohgv&_nc_oc=AdodR1TGPVc67v4Yrw5aWPnvfae3SYBxJRzzjZx1OEHklFZFR6rYYq-2iC0MulV6MQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GO7mmlRTZzEtzrxoYMEn4EPFW7FvFVzPNp4Ye7EgQRQ&oe=69D8DB1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
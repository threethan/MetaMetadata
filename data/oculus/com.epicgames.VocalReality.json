": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJsjufXDuAQ7kNvwECx1le&_nc_oc=AdrFyw2wb5KvRnQ6eplGIggbR0hDpzn5AuvC-y7beeo8dS6d087O5JOo3WBhLHtlgvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg9UEIHvBtAlL78CrydD6GpqhagIdwcSSG5sCAUnEpQQ&oe=6A9C33CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRjqg_nhIfUQ7kNvwHXLgCX&_nc_oc=AdojxV4JTSw8P7ZYcM_YqV79F88oNzxkyGacnRB_gkVMqMJOtHLNkUqYatr8Q7CFfe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITiTG1OyXpALlTtEmXuNJTXKF0OsoZH8aGHK_ExFn7Dw&oe=6A9C3B3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xasveDcSVEQ7kNvwEh9oxr&_nc_oc=AdoTavhF3_r23mDHjlGO0X-i6uyv-f28xCQT_dC3aajEP_y8_OwL7WCOg4z_SeDpsFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgT6Rdc03yzhHooQ4-ue6qK2-cLV_HpfYxn5an-ctLJA&oe=6A9C1B5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1nXn_UH7NMQ7kNvwEjQ3ef&_nc_oc=AdoIZ9PN1_GyeyIhPZH9RuH196yi1O7cABAGiX6OmO7fRxNqImdfiqIKboJveXGHZC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrkBTxq-u6mamf1COuKrCOb5Nte4MIpwMVe8ZIs70jkQ&oe=6A9C324D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=704AOVzRS7QQ7kNvwGVkXJC&_nc_oc=Adood1i7_JGDIw-bpFCiC-c8jLL-xIHdsoz7AdQMXBM7eFwStW7qvJJIjhD3HfK68jM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9ryg6rmz531SAf_shpoccn763_lgpxTXCeyOOo-yRvA&oe=6A9C1C36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R1KTQaz_h8Q7kNvwEip_Do&_nc_oc=AdoqgeH95YMl-3DzGs4YQPTZOV7IoQCeaN-mm1QUe4gfePMocq5h2zd2GKWhRGUe3uk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMov7AOwIaN3pz-fTUlSMKn8wiusyoSsXluDilKfIPUg&oe=6A9C315C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guFDcYH1OOgQ7kNvwH7OoGA&_nc_oc=AdrLWstWm9mGJslayB5GqzfXfb8DUrzWGgPLYExymduzzvi9aRA-vLU0vJeQ_-yIyMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJraIyycRzWukpHEAP1sNR1KH-kPRBHfj-hOE-AF8unZQ&oe=6A9C3572"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4CImBHN8IUQ7kNvwHAbhwo&_nc_oc=AdrbhwxCCgml9tUPqhXJAR1Gyw6DfGUX7MM0Ar2hlnVqeYrqpS_vw2-relZvL6o--VM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1-rKg736pcJ87bH9J7-oOZRnguA0EzKo6lamoQFGwZQ&oe=6A9C3A4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjNytJBgtBEQ7kNvwHBSDU8&_nc_oc=AdqvPCjbNhntBH-sS0HI1vsDX7VOfMR3CQ9oKDkX80dRQii_I9Z0kxyhMIRY8Lgm7dc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk2DjvoQhL8CCx-EFHimgMmTl7jCNcXispzuT8wqjyaw&oe=6A86E38F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi_6dVIwV4AQ7kNvwFBFjdO&_nc_oc=AdqX5OqDy4T4tJRH2bT1JXYkTn5HRtNkscTlDyhobhv3yJYKFQRhLJDUo3fYq0AKI1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHud2TuD0aOg5yAonlsZ4e6rzaNPAT6MPTZFPJ82musaQ&oe=6A86EAFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60RrgCF9oykQ7kNvwGrjjG3&_nc_oc=AdqTHjv0EiSNlH_Ibf1XTou_Gehep--_xFRM6PdER7gW_5MfqPCVuCeCkyRugh45ogQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-7xp3z8cvsKQGExAjU-0EKPGOSQnu2889GAq6gKKLfA&oe=6A87035B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkKc4cqADu8Q7kNvwGf-Xol&_nc_oc=AdrrZrn9bFkE5gMOL-lHUdgUur0dDVJJklCm32TtAcrVAXW2BYLswPXV50yqllVio64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHLZT3Q_SRt3sK6fM6Uy4Zp7pukAcXpZohMV89Uej2Zw&oe=6A86E20D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUQYsTYiLZoQ7kNvwGYBdUJ&_nc_oc=AdqT4wVcwzoW16vMxeDg5kfoEXzTiMmwQr5DkaIB16EA4edwZHpx38e41ELCmgWIzhQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6WZi6ViIIZ-nbG9mjj84xYXc4lIfhWAbSqSiFUPBElg&oe=6A870436"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg1pEGQjHHgQ7kNvwEOzocr&_nc_oc=Adq7sG9fqI0sdfanVZUI1Yl4xGrGMbSuNXR27kCNafEfIR5c7YnoEBgrSTOlZ8zA9BI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX_dJQiBIcw5JNwIvVOVRaHxzzXW6UFGgIXq_KiJmTow&oe=6A86E11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLjcp1hTOo4Q7kNvwGwIcW9&_nc_oc=Adqxgbi53T5Gic1BYBr1oCp9NkBba39lvIviTowb9QwFENWhjca_mI9zW6QcnZwpiFU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVQ2Ct9ZWW9W9jbsZ1OWzt9WJlH_k9r1SKdHHRNyXuQw&oe=6A86E532"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrpWuTl7PL4Q7kNvwFOOT3O&_nc_oc=AdpOSOfp2CX5lt6el5JMjmR9nttRfxOdkWKO2D_Vi-G02_yc6c1zNGfGbMWaJTNB12g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUxNI_24LWtxf1oYTvC8ww3HOFEtqnQkyKqE97siCf-A&oe=6A86EA0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
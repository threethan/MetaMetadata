": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjNytJBgtBEQ7kNvwHWC-bx&_nc_oc=Adr0OOwjHYSXcLoWZtuYxWM22UMV2lme5pGMIXCZWYikygqWjRWF10rXzVJsd9cgILE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQSvrdLcRQmv6YTohx18DsYtRkdRoseIkNdUYTRqSd0Q&oe=6A88350F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrHYtmAud7AQ7kNvwE0G4Xq&_nc_oc=AdoUgpOJOd2cBuH2Y_LVpE33xlpNyt95SVKXW4wYBf_DCy_68seVcG7lGxrmqH-9zfE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3GosS2d08c4fUeqE5avtZ52Q_k68-X36J-nglhssJ3w&oe=6A883C7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60RrgCF9oykQ7kNvwHoIh2t&_nc_oc=AdrwwgacM2385eoDKrZ8EkOkzYklebg4LwRrRYRKlPYdY7Vfkv_fd_aROFRsYHLhQW8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH9dPz34QmRCIsARkCfCHJUcjp9JRzpl9j_YgOIt2zgQ&oe=6A881C9B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPgtsjJdb8UQ7kNvwHvNzlB&_nc_oc=AdrQC8-EQZ4FXfFdZZCULvVHFBcXBmyfrlATVwB3nhUsKygnPNB5OsNN6sfmRNcG9Sw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_4vr9G8f1hsm2ObgikxgSBoAEjIY_OKXJI1d-VniRug&oe=6A88338D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUQYsTYiLZoQ7kNvwF1gXVS&_nc_oc=AdrbAziP7u2nZG93tEpa9Q5Ph5yJ0BQm6T70ZRljuNvd54gBTGilD_F-eeL5Ekq81Xs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXkW1V4XAy-kmM9YHG_9br4jQfSScabmtPp14Tonb4Og&oe=6A881D76"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5KtV1X-V4gQ7kNvwEbvcn1&_nc_oc=AdogOC90OJJCIdY2yvdbWJgoPAyFBSo4DJ4FZ0uiEsJv0GT-ih47YKf1ysPqG-jN4R0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF--1VHPefpGWjDqi4OZ1lNA09PZ3a8BusXBubLxHcp-A&oe=6A88329C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLjcp1hTOo4Q7kNvwEhotpt&_nc_oc=AdqBZ-wxnP04aWzzGdsaTMHhZYoMzIFQGvWuZeqgNlJkZDDq52vYnTAMb4lljOxMaO0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhiHDIULooemgq894RCjwRL_GLZfwUTCFv74EeKI7URQ&oe=6A8836B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrpWuTl7PL4Q7kNvwE2JCBc&_nc_oc=AdrrdOXO2Ixcpn2KgE_Ha8bvjUmQAPBIdsfOwfFoysTpZSpse8xsGDLPWALJbcZOwTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMcl2a9_V1i1V2zmvxvrOPwut6pt83s-Y7hveiTBGg5Q&oe=6A883B8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI0g4xMwM0cQ7kNvwGYGArC&_nc_oc=AdqSAEYE478DVRKnAVEHv1mJePeR3cgOFMid0djKf1WJKKyFPWEy05lxd9AJ-F5R_Qc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IqfQ3zYRI56bXweyMwgcAR6HGkkiLg72AP5Vj-xvDvA&oe=69FDFFCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHy78WE-NM4Q7kNvwE39GpZ&_nc_oc=AdrZhaLfvFHQp0NCQFynnKEFbhBzegmAnlaG9-S6hQ7WYx_2bt1tMTP2matrK2GBJn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a0mRlZvipgv78qJVKVktf27bhLL81e8Yrfsc2jc-Zhw&oe=69FDCEFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-RltsmXTwwQ7kNvwEgbVIs&_nc_oc=AdrMqIu5ILd1kmRH4dapQMOYlS2HyJB82ics3BhibCUoMOKE0B8jYE4dpnH38-2CEss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jxV7QGiBFvqWRS6BlxBCiKQWbeBqjfDcJiryIPz_Nig&oe=69FDE75B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkz98LlrWRkQ7kNvwHezXIq&_nc_oc=AdryTWAbQQkfrGeLIbjnrWtC-66ZW572AyGrpKu0UiYY1aALYmjIRrLKLaAS1n-mvqM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oppOVk-gkwKMR51Cy0UJztLFECrobJNzb9AjoGP6MFQ&oe=69FDFE4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUd1maUAWocQ7kNvwFgYGju&_nc_oc=AdqJoBGWxXj_M4BwIGh0N2P69r2wlz6qcrbUhMwODBo-QfOUSLqMHky73Lj74bv4vDs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61PHIF47Z30gC6aiEWiDk_WVy91DOCrMgFPbAEivXnEw&oe=69FDE836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umWmjvb78JAQ7kNvwFcOAqS&_nc_oc=AdrySwzoXQJwt7cBKq65O766A5T9oTPWV2V-0d5YhTwqGAa7UJvo8t1LfND3ICKqpBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zpMeoJbrVOX6IyKvUOc81hps6VROIDcINauTXL22Glg&oe=69FDFD5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=483_Dm3xrBgQ7kNvwGETqnx&_nc_oc=AdoDbrIOCxi9gevUzfbsN7xSfII3zmGjuE3Xqk6Lb4498lbiM-vfiuWBZRizsfkn25w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XA2qhR4YKNqddmpIEHQgmTawzJRqJgUn-gVZtMlkDQg&oe=69FE0172"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZRvc9J1vaIQ7kNvwHoEErB&_nc_oc=Adp1cIF6xiK2FRLGSc0MppVHvcba7PRqyLxWTaEMATwt73gjfGm--xaPeGiQglVFtWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vH7rdGn50a8GrrKznHtGp2DSGPlxILeQgF6xVU_44Zg&oe=69FDCE0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
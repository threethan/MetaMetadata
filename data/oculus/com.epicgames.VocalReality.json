": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD2hn9iAs08Q7kNvwHy5SEj&_nc_oc=Adp21qHZOowBs7m8K_E4GkfxF4s4p6oSk8_E1QJ8acghnNqrJIZvup98PR1A0epgzrM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXpVZLnV3zf4q8EqNL4np0W2cZmdPSTXLsZAbg8kXcEQ&oe=69C6688F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRGpmLoc9LYQ7kNvwEwLT7O&_nc_oc=AdrnwM9HRvYH3AqqaJ3JpJKtJyGxQC7IxWoaTUwhUoz8LEpU8dae0WvoHNV4JpRNweM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHiI23M-oIp-aE3v3j3InXDrg4aDZVr3RZBM3-0nnP5Q&oe=69C66FFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnvbmILAXN8Q7kNvwEyOG0d&_nc_oc=AdpxKHcfsG35X8SPWcTuRslPvW9xJ7F2G4armofqghlZNB2tFQALrg5KGgY4FJAs1s4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySvEnutO1fUEevmlhZuxp2sIGifgVMO6k0SKJopDwXFg&oe=69C6885B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRHNhqH99NwQ7kNvwEg_sot&_nc_oc=AdoNdxtoE6nGFSDqTic4DR8Oi9LQR-aS8e7wHTx4N_0IU-K8v5s9w4QuLhPvL-cjV_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHpM3VlD8wAwPDk7NIPsy2mlP67gntoczUtE_0uxDk4w&oe=69C6670D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLdu_H09zf4Q7kNvwHNJmb8&_nc_oc=AdrkhO0bYl4CFgiVPAB-jHqlt78GMF_U88jTWwqFN7bzkDc3FBWvOqvHp4IWjBnlK6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwx7pVGfA3pK_mJhr5eMdjeJngx9khyXwt2eP8g0Imnng&oe=69C68936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N87Glqz2oL4Q7kNvwEOCXZh&_nc_oc=Adp1IaxyhAl0Pl9VyqD_tiqamsOKMYcZaxNMJLmvRoEmI9XZ7BD3GjjQCj1w46R7-LM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4CNu-nCcra888iQv8lTCeC5fDra1NaY4Al8Olhfc2tg&oe=69C6661C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqFWrV9_2boQ7kNvwHZ9h27&_nc_oc=AdpUD2SPMosAsYwUXgRDQ3UZcls6UpjwZ4hOrc5rBG6j__J8RyGt3ZLARI9O_7IeKxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfJ5NoHHaOhWmLX57lJoVYOdOEL0cYU9wtNKTREaQZWw&oe=69C66A32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ6BQFW8OXwQ7kNvwFvRtA3&_nc_oc=AdpYB0OOwMNCzIXV7zVBPsuCf2vJiPSNpM-rJnSAA3oZyLPbsJVUxCSWotgpkqGnwyY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysNMj7gWZt2ZCaKEyvClQ_wJc0i9FJ9ghRZ7Z1bnfL3Q&oe=69C66F0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-bkT33TC6IQ7kNvwHmwXM1&_nc_oc=AdoNjj5N0tCrJef0Z-EbQEVcMBH9YkfqLDWvEQ1cH_cKkCaxpDY-XXQdcwHWl3f5pyE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qCqdKiouD2OWdD1A0Cj939eZFMOFhul7jV220uNglWw&oe=6A21984F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnB_fesKnEYQ7kNvwEGjJUW&_nc_oc=AdoW4bhqAGVA8y-HeNrc5ZxG2PEiWRfTZ-96NcimhSFkP6mgWFCwcCU3AApUMb44oRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r3hV9DMToO_uCgHg1oenKZwaVtsJ-1n9TYW_Gvn66Qw&oe=6A219FBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldC1ORf-FMQ7kNvwG-Ts0o&_nc_oc=AdpX9jEzUpuikPXPm3YOwJYsNvYoBy4cw9OgwaHzGjP6kGvcv3hb64-66v2qlZbbTUo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e_mRiUMFjpAqBpSIsf1EZb7XxaYDaic-VCYfHuSS-vQ&oe=6A217FDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnQdP-i9wrgQ7kNvwEzpDQH&_nc_oc=AdpyM9sWzYUopi5F13Ef1Fdr_2ql7Y7l0cH_iffTKrWHtr7UFFGlkXUCQKC_owZ5b7E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kmHXDCLZGRYs9N2sIPuRxSUevqdV8grpZDAzkq3Ad_g&oe=6A2196CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nF3xOuqeMcQ7kNvwHb2fBO&_nc_oc=AdowDtFTYxFuNNyt21GrO48oA9LmmLJ6xgRO69hA658g1qFgQ-Lj3TBNI8v54EH96jE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94n3mfjmJ2hF8WwQtZ6ydwLER2Ry3Q405-Of5cJeLxEw&oe=6A2180B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AezVwVC5iMwQ7kNvwFLyXSX&_nc_oc=AdqmHYBj5uXekFIj-Yd-xwVOdwy9j92ySddu5yLb9IcD8uckerB2UpPR9kSz3uFIZDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IuyGOnTrDUcWZ9GcOC47x06cBBpdDkY8ivyGVdtCu2w&oe=6A2195DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LblLGLFS2L4Q7kNvwE0j7kH&_nc_oc=AdreKC6KwNDKRWtI6pKjMa20az0kAZRNfiPhq9J87GcZINsk3nIP_KxzSDgId6cpv04&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IpADD0WHLquwfpeus82qavvTlPWFSjTkukmvwpJI0Iw&oe=6A2199F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHMBHcQa-YYQ7kNvwEXyHkX&_nc_oc=AdpQbbWgb1oGkce27HaEKJ7qiIMDn0xubkMHhq8U7pv6aA415unnYv_KOg94aqN8AVE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0d2h9kCb8eGhqx3xKbxG-O2JqFs9a8DjWc87ejk4Dtg&oe=6A219ECF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
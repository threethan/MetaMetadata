": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR8gfuiXbKoQ7kNvwHhv821&_nc_oc=AdrL0kBYAVu-6pY8Mlj933hoKe3pzeSaLeYHuDOYC7FBEYC0smoVjNcBtXRo5SHg2DE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc9opHpjzF5Nv1i9axnLsq5SKZQffu9FaSu3Oq-Hm8jg&oe=6AE364CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJylQNqLvu8Q7kNvwHdLgWD&_nc_oc=Adq_ICz81S5fh7ZMTtbpp0qCuDDhE1r8RPSALO5QTf71Runfmu08kLQIAbwRpJJzZ-o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoOgOex_2OFpC2rbI-f-5X-X2pjhcDzIt8Yrf__PdFCw&oe=6AE36C3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuEuI5xHjg8Q7kNvwHPo2aj&_nc_oc=AdqXX9p01CAJzVrNTF8qF9WCecW31R3y6RT6636c7_IlcAh1NgeJnL8w7Yjelqs3-CQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbwDa18cyuCnTFNhCnNFfEAg-Y3vYUy1nsYUHAB_IIzg&oe=6AE34C5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eA0CVf21AEQ7kNvwEwU_AI&_nc_oc=AdrbahVkeGqfTLLY55mm9hqvokc7uxq-lUxaHoLcHU4tPAwKI4_WErCBSBBi3-V_oBA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyTXLw1BjL8IMBzUeELcdY1qqSU7o_sbW2ExcP2VDc7Q&oe=6AE3634D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA8VLVFSzIMQ7kNvwH0Ki7F&_nc_oc=Adpkw2a3OYJSc7QTtdr318JrnpX2XDr6Tgkd3dV8XOLcN5DwRd-1Zz8AiK4cFbwVSpU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTiBdG4AlHdBuml3_JPRLdv2b0kXY_I5-MGhi0HE9UAQ&oe=6AE34D36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eeVU3jO9TIQ7kNvwGq-PX1&_nc_oc=AdpmKvS3O0apO3N1nwiOJWAT4SZnw6pmpK97_ZFTuIwk0nUgkl6gB8TVuLursGmSCp8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQKZfC61uvGLnD34jbMKV2G1RQB8WdePDy3U2fn107_w&oe=6AE3625C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyHkV38qADoQ7kNvwEIpwJs&_nc_oc=AdqfLH2CRsqAlFMU5gGw_Dy8dhMfwCDPk1Chz4ksPcBY27UMD5EwKRfLns6SChZ00T8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3CJyhc2LABmMmEOWjdn1C6aN1Cn4N6tl9Q4nNlZMvuw&oe=6AE36672"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ntnhGycGxMQ7kNvwF6sSZh&_nc_oc=Adp3QFOE9EtjU3pka5lhNuMiPWXCV42HHp3tX-cYDglDhuqZ9otjhudfK8pd2UJAe9k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl-g2QQvFOh6ZhsFl4U_THElwwkS-3DGIp6Z3VEhUITA&oe=6AE36B4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
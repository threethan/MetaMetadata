": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwmdo3E9d-QQ7kNvwHjkvsZ&_nc_oc=AdrvhHIT2zUfXYQd7tej_ntB2cuQgBRFjXlD_OxSWJEE9j22O6DklHDk4DEQx4QUzxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReEBcMEuXLMTTyit5Wx0O1Czj8NWWhbeuGG_J-T_MtEA&oe=6AE9FC4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEPuPRlgql0Q7kNvwGQvJui&_nc_oc=Adrg_qWhkF_7rjqA1oj6Uz20ruQwWitHpxUxTfNUZXZobGTIdD4r-NDB80XQrgDld5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVHQhMdYEXQzU2-zzwJnF9jsp4k1pqHreCr6AFJ3bfEA&oe=6AEA03BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNvJzz4Ung8Q7kNvwHm3vWh&_nc_oc=Adp_rCMDXXlmrm6OQUIvvMoVpo-7udTjM93yEkUbX3Ut8WOrOEUbZcLMN8ACSRM_uic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYRSGbKLuwX_pkhidDlyhYV3Pv5aictzzMwWIfq5jStA&oe=6AE9E3DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOj68fm2z8Q7kNvwGrCxT3&_nc_oc=Adq6DONonTmJ8t24mNQIyri53sW8ePo6OGFbDWVtfiECHyZFh23fiyu61a8_udRPJ9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrZOJQP1MFRa0uciINoT1mcOr_Fa_CPtk5Ld0SyU5ETQ&oe=6AE9FACD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGAMT5q6EywQ7kNvwGQ5UXL&_nc_oc=Adq1BjEnxmQtGBBtzPVvaudGZfvL2qeckV3UMg-PyLc8V0TWtp0v5ZPpai3U9yHn8Gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDiu7CBJ40hiv7sO1o5n-7Zzq9qrlXxaVgg90uux7AGg&oe=6AE9E4B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95dR9JUwFE8Q7kNvwH9Wfe_&_nc_oc=AdpCFO0k5w3XnfUmvDSbViWXGj-fM5uOJG5c2jl0MP1dFMmddPesoVWDiBZ9owPdSGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb0Zjgs3KcqJ1QiUCl__z7KzSqAmz081eb2U3rAL-4Ug&oe=6AE9F9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS-wL29_nfEQ7kNvwGieHGB&_nc_oc=AdodTZX2ap5DWSyBLKHkE4W9FBPLO7SVtJYD5Vyz6UBiWTG-nQlw3ablVMjjm5pQvB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdGO6Z_0kCuboMH6S1qDV1HHGECemZXBuT0A6HZdVEJQ&oe=6AE9FDF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFMBh_z-WfMQ7kNvwE7HAxq&_nc_oc=AdoGPhG28DuLiYO1N3gsNQZ5vUycPXy-ucVrKqt1qEKk-iZwQNN_hiBbqX3nUhFzlKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs5OfBMgvjlT1LR9EyDGQFG19Asw1wOccOhmHJxXqD6Q&oe=6AEA02CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
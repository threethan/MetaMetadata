": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPUEyyuEvZIQ7kNvwEAqS6c&_nc_oc=AdrchZ7eQ43m8x2QIedaTsMAWKDStM4Fs7aWc31FAgCs7k-PnVGyHOXn5oTbt5A1C7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LDdz07CdlNVTPB3OCrd-MdjW_tflJyXPArCtROK9VsA&oe=6A1EF54F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnhMN7TQuvEQ7kNvwGhTrVg&_nc_oc=Adr37q71gmh5fHMoHLQs6lP-f5Lr704n6x2pQFzTsLn_HuM2_JfK79Auuy7DCV8s9kM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VZjI9CQXLNrOVKqifEkpk7WLMYAeOPiRWIlV8k2KcuA&oe=6A1EFCBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldC1ORf-FMQ7kNvwEJKcAE&_nc_oc=Adp-Q2bInkbuYT4AAdaoGk7akrRIjzGokD2jIqSToc-5jS72S2akvRGY_0V3Fp4F3VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Yuu0TXpGnYMOW9Uc11cQ8Tv9jqRxeRO2qK30GH6rkmw&oe=6A1EDCDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXsIfeQsI98Q7kNvwFe0vcz&_nc_oc=AdqBpz3R_I7cnijzx-0G7iAEADQvei_phNLpFTJQZBL19VmqZ19Iq3t_bNrSPq9v1Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jyg54QIqjXTljDxWiz0yFVIyBRYpgN8pJzjEIyzibrA&oe=6A1EF3CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiT7MveLN-cQ7kNvwHwbFim&_nc_oc=Ado1K7Vt0PxIy3kaoWf_fmcuRQ_I4fYj3CthcdIYIuGv0lHWir0omD6j29dqJK55Onc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50OkNt_xS12PcaRoAAOIB9ho6NBhcfDdt04wMlEH4l9A&oe=6A1EDDB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21tio9Rzb24Q7kNvwH5YIQe&_nc_oc=Adq0ZFwWtWQIFjuATszZsbmIRe43RoZEenyTUoY40_eLfPE2ikj3s1pIYyI0qUf1RcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62m0s2BthqtNzIpaoUqUqn34InMgDe4zXZ-8YGnx--rQ&oe=6A1EF2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LblLGLFS2L4Q7kNvwHq8U1a&_nc_oc=Adrdi6Cm1I0bui3HLbxgllq4YwA7JpgSqjXfbwEcBi1LkqE908oLm7f4pXgaIZjRHI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uX31Upqw8thauEsC2jMMNWsuEByFa87rJ792hitdMpQ&oe=6A1EF6F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3RffeZvtYMQ7kNvwH8THmw&_nc_oc=AdrRlR1F2njAlamshuocs2aP496VPLpIYTICLwFp76CQTDnDQyyDHjw7wZ10VT9MEJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GlkqR_9AsGl305ntHqHAihGuGLpikB6d2vsMd3U7-DQ&oe=6A1EFBCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
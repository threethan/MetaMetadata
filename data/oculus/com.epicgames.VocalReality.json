": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SO0tb-82ikQ7kNvwHus3-S&_nc_oc=AdqCJGbIfAKSzV0Kol4oy59ksPLNaGD0GU7k_OJpjfukhvcUmOcLzRi4NySDR4b-cmU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afza5QYo18BFWSrpCRJkEBQwpviPUOIngriit8yHWCHPCA&oe=69CBAE8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rhexWZdyK0Q7kNvwFCTYI9&_nc_oc=AdoFrF-u9r7pF8cOtD_ZYI2RSgFUYO5VVh8DPGz1-s5Ss7fubWikB5EPUzvMsAA5q7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwviYKEJbgww-xP9XOr6BYFg5QgeBHUU3QpYz_u1hph6Q&oe=69CBB5FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmpWJT2behYQ7kNvwHeqPGp&_nc_oc=Adq9hTtEqPaQ83qVv2GAielT09USJyKVeDWleFvjgVzjAxjeIgEtyySUXv6Grp0KNkI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJRLfLz0J0-bXQVTo7e8I30n8NcQx_yL2bYJWmBcd--g&oe=69CBCE5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX9tckGxEZcQ7kNvwGL171r&_nc_oc=AdqzAMmnlBXXUlMcAYzZ7CN9fllkfvysvBWt1WFnIHPkH4J2AlbZYKV2mS_xBZbRwXA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsVtgb2-ZmU_ct_xR4E1KBNnmgXheWMuOUSLZUQw_mOw&oe=69CBAD0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxyQQPQBTcoQ7kNvwGrPq8K&_nc_oc=AdqmriU247zSZj-p_ectXroyJUnHdrMcm0JvsW98pKqMYKM_NaRh5r3AiaJ-7Pgk6fU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTolBtnx2ItGC4TOpRpxoQsvG5Haxz_nes6AlSZaGYPQ&oe=69CBCF36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh20OMU09rAQ7kNvwHA4-8c&_nc_oc=AdpXjgK0C_QOJy7-RNDdvJMIGPU6tITve6wJPhX5teZFS9wKBOegVFXyHsH7pOEdjNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6cwTbB_A5ilM8EYOfbOSLzujtc_mGETYucHJlnsfBBA&oe=69CBAC1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn09aUq1hWUQ7kNvwGeY99k&_nc_oc=AdqdkWaU8nmvAQlchyazJTOsFLXhsFMXqrCGm6C2aHhoOXzW4b1AXNqET1qUFBVMp3E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyjPUV6851qboHikTsfsaAwtvnfM1m6L9gNDDYGgCTxw&oe=69CBB032"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRt03tSfCCoQ7kNvwFrnnmt&_nc_oc=AdoBazqJTac_5YT0kAob9wFHNoqRXytnxj6rLYmBmC3ylRTUhQxFJoPlKIc-HzuImCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVAQ6sAtSd1xPOBsw3yBZ3Oprtq5uTrdKwKgHTbvYfgw&oe=69CBB50F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
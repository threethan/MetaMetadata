": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SlArMMuGeMQ7kNvwF3f4Zu&_nc_oc=AdocmEDt-VoOod5Z-O2orGWJdjeaYZjc4h1208ehFSi57D7Lsov8dM3AtFzZGnXnRns&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ubj7A5YrT6rBYKwkcCnLFkrNiNL_57KcrIQXJah3zBg&oe=6A11CDBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAt5Ma4LcEIQ7kNvwGW-Odw&_nc_oc=AdpYKY7IFObs75kBZCKWwciHi39QsSJ43vXqlA2HafgylrL9lI9sJ-5ZvVOcSV8NrL8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JXtlEr3L8aahjsWDnPC0mfO9OEpfcu6nDz5203pg1fA&oe=6A11ADDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2G1b726YZsQ7kNvwH0XwHe&_nc_oc=Adpl42ECeX5oiQn4KXjXv2GQdLTOvBWyMw_uEX7DcZyEmeoJot4dX2dFudJpyjt4Im0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y3IveNNIuFTxGIxP_aPHPO3HcqQS1oe2HQK-dLtGMdA&oe=6A11C4CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-A4XMsfWA4Q7kNvwH43flS&_nc_oc=AdoMkonqyXIe-mBAONsraXAPYayPAcutR2G4AfyAc6S8joLUz2EHAHDl5UKbX974vDc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nwFvvRAs522ND_DJNnIa02-hI-Eukl5U6kEJ1MjYNpg&oe=6A11AEB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-jzM-gll6cQ7kNvwGueWsQ&_nc_oc=AdpXcBmq0qxxFN-enHM-zOKAVJFhgDH0xWJz1RzMqvvsIq6cYeGfh8c5sndnmRSVpJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o4kbEH08CW_xeY_jdJnLzyZe2Sk4V7SyNCp7jgCVMGA&oe=6A11C3DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
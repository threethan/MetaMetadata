": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v-lCRDS2DMQ7kNvwFJ8qsM&_nc_oc=AdpTE8YY7eGAPK9ifRiAchre7QE9BoX-_qOZT8wPEiF3DI_wMzB6upjrX5S12kwZITQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35hkC-6hkEtei7Rq_qYeprCAEaAG9N_AZnEcZkt6_p_g&oe=69EB8ACF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YSHkaeQJpUQ7kNvwF8C3X7&_nc_oc=AdqVmns204n_GGMwvl0Hm4abDU0J5DgTfiOfP5oMYzGR8ObkWa19xGAfobWvOJDZfOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q15qyrCoF8g6kRfXD5-NezFJhUSJHRZj3dOITucsD0A&oe=69EB59FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfwXXUJ_ewMQ7kNvwHcUIz3&_nc_oc=Adr13Yu2OGI-LdAjzNHmNvufva4FIiJox10a8eicja6lkrkAwAJ8lgGViizaCkhrrsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3o-2gyz_xzru6N_neOcKgjaWXWvVVUMoMm4jP9NCgVsg&oe=69EB725B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKWPnsRi2ogQ7kNvwF7FTqe&_nc_oc=Adrdc-ZYxxitGzIxTQbKCxKe2-bUznJsKaL8GcPT0DPvONIb5qaQSs0eMMm_pQgfZjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mhbo4ihR_pmMDV_Blfhp0xDm_y3lJigc-1FHvVLlhkQ&oe=69EB894D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdAg5v2yutgQ7kNvwE2rK3D&_nc_oc=AdofuZEUPB0orF315da49pX2V3kMTx-yVhFQwsjAMJsKW6aHYCniej5lkc8IrVRJT-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TVGVDI3YOLDc5FXP8ren298pq4lCr9Gz6z3Zx50-cYQ&oe=69EB7336"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKKQ1NK3SUUQ7kNvwGQ0nJQ&_nc_oc=AdqdfHw_5haNmWtyh7ST4rGKng6PoRmevaVs4ANw2dVLB5WdZRQZrfp-iB2qd1ndhMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28rAE4dU1uiCSkV0hploMlnYUcoue-X2DX5_Wx6vg_9A&oe=69EB885C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFAZpfJ3M1AQ7kNvwEhB8bp&_nc_oc=AdrgO-LFg_iBcHu0MujPAvwavhASt-u_s1jkYk3g5-pvH0nj7edcYcbUp-cyh0pDkNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZoO4tSij5Vrg5A7O6KorBmNt5KMbxlvCtsCGdMfJMxg&oe=69EB8C72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxIvF1J2CpoQ7kNvwG6HU-a&_nc_oc=AdrkYIgvD0g8dNLjdmpJnMIAdzSAUrZ2UPJI_U2T5lOdx82YAqN1xqcZuiSKMMOKD7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EG0pNZrHPqq7dXw6R4deZF_eqLJBWjcF3uan0pbwk7w&oe=69EB590F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waXCmZP3wkcQ7kNvwGqEAxP&_nc_oc=AdqbIz41re0EbkGW_g0ET2CIEokxgHZSG_vs5vXi1RqmBqdq0FiG4BbkUb6HYgrdQZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZT05P6Ozx58a3rYItTYB9-qStiMiGG_ghX7FaB3S7qw&oe=6AF5D9CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa5CS81mQpcQ7kNvwH1mZiB&_nc_oc=AdrLiN_BqZ5DTZGQ1198x-KjYX4FbpjHQyK8ZA050HLwEXWCOTz_ZRZKzifwUFrEMY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrh8DYIu9o0VKYUhIl050srGEq6IzZGhsj8DAprSGtvg&oe=6AF5E13B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBBtWMgZTMkQ7kNvwHKWQcS&_nc_oc=Adpff9pvquOGW2lP_ju4NscEifjIeyVywzrR39Y_5F6JlddGPS7MWuDOWH1nx-An3fU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjQtFlll-FdHH5-yA0YNinx4bm3fYfnwIcy_8JE7gbfA&oe=6AF5C15B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hZZIVvB2w4Q7kNvwGczc93&_nc_oc=AdqqI1Cixx4lSMVdly0-qUDBLgyfmaSu9HQhX0R0-yL8eeM0EOohgvEe3YG5VLPddUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDocVBFKfqKLJ7oc7o5wtB-blTT9BVjuTLTB24QCAn6A&oe=6AF5D84D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLv8pMZqgAQ7kNvwFL_I2s&_nc_oc=AdrZUIMwo-0UToeidRVReFWs0iAvV1LAeb5BBiE9Qu7JIpJ2s-LTqScKtqbHl4f0ssA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbKX_7ELwLBL4jc3O-yWTpDG6KNdx5qYil6bjb2uZGgw&oe=6AF5C236"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_liH8ar8ks4Q7kNvwH2bH9L&_nc_oc=AdpFuQJyUlBPChEOXxL-AyR9NRi2Rz8zYpZXFjUtnBsjv4h-YUuDq7o0h92fK652ORw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Ib7C7sXZZVhZOioWJ4iAkrb95_cAfkSB-Pynw-dF5Q&oe=6AF5D75C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq3p8FIju7QQ7kNvwF24LIQ&_nc_oc=Adqgts1Z_XN33jiYpprM2Zy1etndwLeqbRUMOeAWEcrFlKXPaW6h2Qfki3q0-by4Tcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDBUGj9En8nFvv0vUkOR4withnZRyB5q7LLVC6hV94wg&oe=6AF5DB72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utERg0aQIz4Q7kNvwGc0IP9&_nc_oc=AdqyDUhFZKhKYdeEQmptKYP7JTscLgivfP9_SQRtbwtMSBp-gH2_R7FTX84zk3Qisdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1VL6GIGeWHLFUZwJvSMCZ9JFqSGUtIdWUvOCRpw9f_g&oe=6AF5E04F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
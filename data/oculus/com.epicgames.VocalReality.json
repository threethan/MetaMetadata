": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVGlrZqMXu8Q7kNvwGJA-k3&_nc_oc=Ado7PbyCwltzCBTZwDlBLdHksCzKblwcsCScdgGSGCzvI1SVNEwmypscgsc0yosG8cE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8Lr-I7nOQ3T8128rC0ka22pUUseKNMGkMBzR-zuNoQA&oe=6A2EC74F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GLAwGEP1m0Q7kNvwEBAy_G&_nc_oc=AdrrtYlOgQqFZxcG6XL7qZ2lF6IyRZ1S1azJdGt0hoSgwKDt4l4CDl-D31PPSk1DnV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vTY6jc4LnsU8R4LW-vEP8ZhkgsqZDI2TlvYPZh-Dx-Q&oe=6A2ECEBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plqQNFL7boAQ7kNvwHfud7K&_nc_oc=Adr_93R8YOlzMw-vJueXfRkzJSVAfAT-diBOVjqsS11grup_CdgGdF5thZuVnVpqeTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QFmNuWorE2ZSylR_Xgx_nJgU0N29-d3X_ux5NIidcSA&oe=6A2EAEDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykS3YXQ0YDMQ7kNvwHJOkg2&_nc_oc=AdoQarjbn6EnDMOM_MgYtHk6jbsvu5KuNe6U0YwVkMVxnQDibkvgxuGb4zr9-9PWsBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hVAlmlskAu_LOPnZ7Q-13QKNTqSA7PeGph1vXsJTgqQ&oe=6A2EC5CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkE5vDHYvMkQ7kNvwGrcj5C&_nc_oc=AdqibnSv_v6ZYA-Uus6HDi1ZoUFe7I0KrSQwCRZjmYSzIT1AwHl19_bqEBk9RtI3pMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H5TklnxwjIGlo0LE1k0QN9yhJoMZxBDExGydp4Gmljg&oe=6A2EAFB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t907pYRGq0Q7kNvwHJJ6kr&_nc_oc=AdptmOFE6kEswve2Cj5cpRacmyCHYp6Lwu42Q8ZZTSMaGCLoIFQ61ygylO6DIk6Cf7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y7AhUN5hUUt0YHIGBW-VNK70d8qfK0kFrvVn-jUCaRg&oe=6A2EC4DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV1rYWHen80Q7kNvwGjpyZi&_nc_oc=AdoutQsiBynECmqlQb7uaJVejZ0M_NTsf7Cci0F9VeCGwjMUxEOegjYoCIhl2evsBwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gGIB-gTV0g-jzOPoc_btu5k0qZl7ES6FeuLO-O8lwQ&oe=6A2EC8F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1lXa0UNRa4Q7kNvwFkKRcT&_nc_oc=AdozRbMoePj2dH0GivbaUQYxIoOFd1s3zGSmVhLOHIJRxdiajaI4khl-NgwjqNaPq9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eajTVklRNvcy_fUtYdtBajv8x-SQsmbjraJCpT3Jjew&oe=6A2ECDCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
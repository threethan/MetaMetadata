": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49KChxcz8FcQ7kNvwHqLylk&_nc_oc=AdoqFFRpqdNxYBHh_p0lHmdFvMG6KMOoQQPEj9uTrmC5TTtM56s9tRryg-7j-NKv3zQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nn85zv_5dBygA8rtfE4IZhkqlym5fy2zbsUYk18qbhw&oe=69E3698F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCWBheX3r0MQ7kNvwF7dqKz&_nc_oc=AdoqxYw64brMVUrRzKyy8E72RTaoV0p42Mg96WlUpK2jR81ngEXvb7XGHMFRANrZegQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FUYt7yte6DEUoNxSgCA_GMqaKRrcRroWKvy5S3Nmv2Q&oe=69E370FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIiDXMbFvDgQ7kNvwEak211&_nc_oc=AdpxDycu1rggllwUHhCfhZzeCg954RupmxZbxJWN2Cri6UT4iQa_Ky4Ko56qah-BhKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PfS_EHZnM6bWn84NZ9KRO3ylShc7M9YWPT3wibRAxZA&oe=69E3895B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgZeoIJByEwQ7kNvwHS6kC7&_nc_oc=AdrpqFyGzfufCJK8Y87PbeFCrO-6xWtHxmEhUu--iClfDndQMctb-FHDwaLfIbv5YcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zZWN5082iimhZCiiA9-P82UDBd8Hy6clO1fNLmmfutQ&oe=69E3680D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB7OlVicH8IQ7kNvwGAChxI&_nc_oc=AdoqUwkzKL_8TZnjk9PNNfY9nUyFpKuGyWPy3wrbFjLedxmgaml2VPyni_5yN99wBBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l287-K66VcdoswhbUlKieOjOoj-mqOMSBXc0vIyOYXA&oe=69E38A36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDFvC6oAiiMQ7kNvwHmoGkr&_nc_oc=AdqT4augiomjicXdL4VsQKs-vEDG8Vq0dFG8wJ9gkHaZ5haY2sXS8RVB3DJZI-1S6TM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ev4cWFu4XRYXu75_iHCVjhyWO7-f6AnwlJWJvcI5cbw&oe=69E3671C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H42o3WMbHf8Q7kNvwFkWZqA&_nc_oc=AdouJ7DYFmmT0KJNLoYMlDhf6lDCPNcVo2zpfaJibujr4bFlWqlPCvppJzLxLJJOMHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MihvYgzUSaFlRtuE_W_kNV4NMShS1B3Q_w7xlys41_Q&oe=69E36B32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDWDbwHyloEQ7kNvwGQVKf9&_nc_oc=AdqsvlVd09Vvaq8oxEFLQVGY-y-avWw3RRx1tUxwh7w-Yqaa3v2l_66pn8Ar598COpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_bdkEWoq-tlpyqyIwh7XAcpX3PuwOcDFcWzqFSdgLGw&oe=69E3700F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
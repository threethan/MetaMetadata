": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K_DjpE9v1AQ7kNvwEA9PCY&_nc_oc=AdrHeNoLgI1WPvVOoFERzUYU5c_SrZ13D7uQi0bKXUNIX_ayLdJ_ZDX8DLx7ALTeUoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhNn9VBOWeYddc7A0-pSQa1ufHeXYqVoMkACOeEFn15g&oe=6A68910F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBSqHsATJRIQ7kNvwHtpUlY&_nc_oc=Adr_SK-C_Cpr1-hU8mWppmnAv8smIaZipccDx7m_7JC_pEADlr8RUGlRGg4tmz7neY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0qNkSwG6wv0jB88f5HS6vlsbRo9wmhgNtJ5b9PiR5Pw&oe=6A68987B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAfcHgAe364Q7kNvwEr196N&_nc_oc=AdqdcEAfznW7Y6VyEBxEc43SFDnuhZHEPkHUJmrpVTVNl0IH8lKERtjhS1TjjHPyWdA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgDxrOkr6auGP9O1Y4_ooXX-ZFVqNYKOg4JsKBL0sNtw&oe=6A68B0DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3fKj6sMiLMQ7kNvwFJ1UF-&_nc_oc=AdocfsrJS6M9Fd-QM197cJFYCORI1HE8g2liKlNXRYi1F2wRLKRKZjP-RXshoUTTVjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuYzLNaS6JCnzpvj4OyhFYUdx0qsQEP9Ec0b8SYTcSWQ&oe=6A688F8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9k_HtVyC4DgQ7kNvwEArhhJ&_nc_oc=Ado-QaAnw7sOixroym8hAhz0rD-nfBOgndHx-0pQc-rlXaVbDQ8ssVRvc3OFq-lOL1I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7liIKL8L_in6ZZRHKQMXDI0j_TsXt01tZV3_yAzUGlw&oe=6A68B1B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfJlABua2TYQ7kNvwE0nyJ7&_nc_oc=AdoQJTBDUGb7R3FybPCFd5yEcoWrkNlK4YdzscUp2v9zBybx18tIEjD5Am0QaATiLoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd3NRoGxPbhml6fp3j2I_XJHD1yPDp7DyliN-Jj0fVXg&oe=6A688E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMRT9T3vbzcQ7kNvwFngmrA&_nc_oc=AdpzmAxuhlQOifyyxe9x5niWJGdO7YH3e54eer-Z7jgRNm_VzHA-DYpTijYmWZlry4M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA05dj8RU2FaEcD1-JqkYB8tjxbf189YlQK-eg51Xcgag&oe=6A6892B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf4RIFiyFVYQ7kNvwGy46Um&_nc_oc=AdpBYttKYnwcIvuX2HBOx-tr5qSY26mSHXdp5EIKPNyBOV66MVKzSsEyT5FeM_w3ygk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzpv74oT2zMW8Nxv-jt-EJNzj1ZR6EnNl8Gq-8RD6BkQ&oe=6A68978F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
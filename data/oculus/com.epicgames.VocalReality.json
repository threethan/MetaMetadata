": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktnxKPxQp9gQ7kNvwGYiKBD&_nc_oc=AdokLO6hfCICzz-lQu9pKd4nyz2bWco1tQerbQj_GmtD_85el-Zc4DcB6YsTZZbGe0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0nj238TXhAIlx44fT0YK6o9_kEF4wpKQaVKa8LN-IpA&oe=6AC663CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p__YlkUIk4Q7kNvwHwiFxo&_nc_oc=AdoCItLbkcsqEn4OZz6v3YxjGgLjvLG_lglR4kbjo2K--FMEmlx-eKUCo4RgmxjJ-RI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqHZSrHfzHhP0BuI5OwvMNWPIji9Y3ZXF7TvmSFqlDZg&oe=6AC66B3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJu0ZWSgqXEQ7kNvwFYrVBr&_nc_oc=Adow8PcuLvTTzUgQTIbZwv22yv5Xep3HAFmWuSfi7DkFVOjQzMmbYQanRywmzIlh9DI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNItRh_Gj0W3Fr38g8uS3_43HzYRcAEMGm7XyfsQI0LaA&oe=6AC64B5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwHylFl6rEYQ7kNvwHBP9ki&_nc_oc=Adr0ecWIKdZOgsjXOD_8Z2-IRfzNPbOREXTAlS1SPKfG4s6_2fi9MqUjpY60QXUBptI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP92JAHe8lguACCh7TLg1YGkArSv4fWZ7_fjkOKbgUzNw&oe=6AC6624D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvgJ1P1M8bwQ7kNvwFdqefV&_nc_oc=AdpQbJ9aAEGRe0hXJPysfv6VvgTwdGt6P3UNkQwmFijrS0DFNeeNqJUh_MBEdC9mslQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8hsiLZqt9i2Yb9jKkikvp76c04h69lkDJYQEh-MK8Zg&oe=6AC64C36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-4krRiZ3yEQ7kNvwG4a506&_nc_oc=Adrhr1fSkyC_h7ucKuNeLp-zdHiO4-Nd0yfGp6VAop55oYSDo5HnjUT3KSgEO5b2Z2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUIG7_KQo_xTh1W81ZiEoWVJpSxwppF-PlRgqOx5oDFA&oe=6AC6615C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f2M22SuEmQQ7kNvwECGZT_&_nc_oc=AdqghGSruCB7jkTSaSnuk3sdHRGbpA-3rSyhpmW1RDBrp6ALs87Gbp8d5uqdX2Ku_ZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0fnwStOhmszYnvAeQfnA4TvqUnlhHPNWMLY46gVLZmg&oe=6AC66572"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1ocENRI-4YQ7kNvwEyUzE6&_nc_oc=AdrusUazJ7keRFUBtT0E_UbWeFzjlyJPSW4k5Srrre4An-Z8zp0tAdz1EFbNKjydZXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyACXl6ckiXReh-s8QTvRg0a6-nUcRBjNEevYovIN6qw&oe=6AC66A4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
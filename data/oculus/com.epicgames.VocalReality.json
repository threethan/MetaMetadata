1oXF5445cWGN6CT6RmuWcwQ-BPgqH6N-sVNr7hUYFvBs8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuqp8ZfHwlod0ifVdIA4Y8Kfsg5MXrcBsffyjan9iIh5Q&oe=69A2F0B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-0xBfBnpoAQ7kNvwGhARK8&_nc_oc=AdmCl344kMjIp7tewlW4dmgXowHkDVcSblHD1NEyJAk5juCSIoo7v-nHZHIjLatWvVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCvlQfAoG7PuTUGD4G63TWQgiEyAU0xs2KInMd98CMPw&oe=69A2CD9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d28k-D7UW_YQ7kNvwFuI43j&_nc_oc=AdndjoF1NNIQ2QRNsxwBCkpVicrcapGDza5-JBAYfnQVX_mUURsr69MjVbtGWPd2u6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuREymcTrkGeRIozH0fqMT9ixkaQi2nlX23F9nKMyJ9Cg&oe=69A2D1B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sp9FeRP3OUAQ7kNvwHL2wwL&_nc_oc=AdlP6DvNfUWgLaqa59sjFCInsVVn3t7pnrWHh-LsfQbnaUUENKxp6ftvqvXxUHR7bbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5pucPbdwcRUQAExstTntq7kgjr4J_l2GIXrH6ukb7iQ&oe=69A2D68F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1746935640, "lastRevision": {"nodes": [{"id": "8520715531
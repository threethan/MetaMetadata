": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjjtDBfHfpwQ7kNvwEuLV9n&_nc_oc=AdrBYA9GHacCSVV5GLsVqcjMkzfHJdrWfALVu-xOqsOQ8bTXhLiOc1wlv3HL2PiODzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2AOCVKr_JCOKPG0_nlLKd_4mk3gAgYHr_9GSIh7XICA&oe=6ACBA9CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvUMuNg0x4Q7kNvwHQgviW&_nc_oc=AdrTN7AjO0IkWgawMft7FGzyDV5aqIkFyfY9ow5j3MSA1qqH-awifTA0rEHTQvPdv8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSGUmmYU_2QRtopD88GlbFwgLuPhIWhL_Ro2INPXrFYQ&oe=6ACBB13B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKD5Gfz2yysQ7kNvwEbJV6o&_nc_oc=AdpErqqOpZrRrFFvE4qE8E-GvEfxlxs0VnwhY5_IAhbk5BEnPKhweQzLfreV7cfEZFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQdDdkJR6fz90md4ihhIM5YeN0h1a1YdsNC7m69KTCrg&oe=6ACB915B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzKI63wpizQQ7kNvwE923Kv&_nc_oc=Adp-_SR3TDPKtMOyXiGiyEBh4oJ_ZCHHVYrYIDaUU9zWWj9U-rouYOzXodubTkALE0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVXhOc0Pw8QjC2jqGV-hyGS_oRY0F-8ax6r-hyM2lZQg&oe=6ACBA84D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3135zFS72JkQ7kNvwGUlfMX&_nc_oc=AdpL1nGdzKcddF8iEWRWUCiqVADPKwGaejjnd88-6ERv1wmsE6thGBoEOaBfTHLQ7VM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQdiOgUKpFoFMu07VzKyrqkg4BP1EwYs25x4BX8j9zWg&oe=6ACB9236"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRK15abqex4Q7kNvwFNvEck&_nc_oc=AdrYKavq7DEWFzrCaJMAt4ovn3Om5jjm-MhBT5tonqcgbXT_gw17Sctcuxr8GwNf8Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl2CpTgSBUJFm1iwCbLtkzAmj0OObO11lk2sF12PzCcg&oe=6ACBA75C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsVPD-kbKiwQ7kNvwGmOq5b&_nc_oc=AdrJjlh1wTwK7DFHYXyxou_T4qdCxnHDE_CZ09_j9LG_h7PU39FMQKi_7hk_1Qwr2I4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGozaVUwILFnq6AtWWCLoQRRhd0NPc876HCdn0fMeRNw&oe=6ACBAB72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEcx7XRNPrMQ7kNvwFRi2GI&_nc_oc=Adp7WMiiDGhbmFFROApim1d2oCw-lYSWqV1U2lrcG9PK50pD30_kdsIQHIPC6yhkdYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBwCIKxCflvAG2WZ08Sd4Iu2OlK8KL29Ypq4MUad517w&oe=6ACBB04F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ9RuSehcv8Q7kNvwGA6Wdk&_nc_oc=AdrH3-siTg4XZVgzLYi6eKHKoK2-3N4T7RMS-Wi1gB1t15bxyxpjuDNqst6r9xOEaXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09nXv-y_b5ylLOVWFZ5S0mZjQJhzwSiQ8-1vBsWg5Gxw&oe=69DA2F0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtINwMakd70Q7kNvwHyb7jj&_nc_oc=AdrehsHvjIWXHgc6rlKjBmKlYZFz8jRXFFKGSaihcz9Mu-2Dpswk-vlw_48P8Q-B37I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LvZzKTTUJzCwC1nN-vJUjSEzupJsaS9zj-RfO8K99xQ&oe=69DA367B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSpq6_h3wykQ7kNvwF-EVFN&_nc_oc=AdoVTUeJhyHtpzzg2n92gpIZGPLqq0YfjZI3qDZnaophW5tJA8AGh2I8wyfgJ2zRBwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ohmnix5fQWLaC5YNaLg3u3xHqcc88c01wGRLYGh1AYg&oe=69DA4EDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cGhabba_tMQ7kNvwGMY02R&_nc_oc=Adryd1WDJFO3Yc7UOz5ik2TVJFsOF2-p8TGOod0ivX1RznwY5eTeKGXZjLEgl4vbD0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07xyTTSFOcUmhhzNlJ-BGd0j9OKemn6PYP_fWtNJpiLQ&oe=69DA2D8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJbdHL6KW44Q7kNvwGun7Wd&_nc_oc=AdoM9yRit09eq_tVMz95CNkrFbUxydZXP0d1Wgcah_cGOLptIqtDRJd2hQ1WJh2G5wk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A65qUYZQAiukHrSfD2qs-GA3UYFOsTUEMQ0dp6igu6g&oe=69DA4FB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGzJjBt1aX4Q7kNvwEHNPz2&_nc_oc=AdoZhxRwxyHSgTAFP8YwSHkh-GuosFRCDU-SNNWD6lt0bqWMq2K1KnT2vEks2w3vdIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n58keyxspNB2P0Zmcaut16xjUQLunZJdqKUya53KYuw&oe=69DA2C9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3SDzFC50skQ7kNvwFDXi1O&_nc_oc=Ado-VLmDLcTP4mQKP9yLPFE2iV1AhE9KVhjh5jL9XIdb3VyvEmVYl5W1sYUzqyruQnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26WuSlf0U3bgf8pU6juMBbdb73NsVNsmn9WA_dp41KDw&oe=69DA30B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rojSymtRKk4Q7kNvwHpPWhr&_nc_oc=Adpor1Uncj3KriZK-0CBX3bW0O0UWRkX8bHpDnLxkyz-GtpXv2F0igi6l0cf98g0IPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1olWdNkXHj2WKjluV00Rt7EMgGhIeuUB1Pn2Trg2YuHA&oe=69DA358F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vKheyJhBMIQ7kNvwG-sNM0&_nc_oc=AdqyOkmP2VCHFvwHmtuQZCzy88tEaHwf9VzO93WsWkbNgHoUej4lEGj4M8LjrQKqVJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OTkuwpzzQuKOMj2l6SK13xcrkehj5vvFtnpH3R9sbnA&oe=69F7684F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSWaIIl8huIQ7kNvwHK06NE&_nc_oc=AdrvdVCQwFr5yusSPb5AOHJl-Iv2St_sB00DU32JKTd_hmZzr7JN6t0mIEYyk6emol8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rLyoLbYVvx6_p73BPjTHFssCJZX2TSQUzyy3jvHh3Zg&oe=69F7377B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vWdjZqGUVIQ7kNvwGt8c-U&_nc_oc=Adok3yyXwAQHRUu0MkaBSXHt4GX_gXm_G_OSVNZEmyg2xiLhMawUTMAaGyd8koatAIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qfhZOVst4q5tCRJHL7ZEqIMsXclpuY4WZy7qKVIZ3rg&oe=69F74FDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHDjkJ_USBgQ7kNvwFP5Y0a&_nc_oc=AdpnObF3ezSgpk_edyAgmmIILh_37g6c-HicjSUmH_n-6BdYC2M_RNRaKxaPf-ngU4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Vg8oxcKn5eSi1xhg7_tfQG0jsgw92fWegHFIS3-06IA&oe=69F766CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEJ8C3BsiWgQ7kNvwFcYCCq&_nc_oc=AdrkZE7clW3ZhLirxV6f3TwVtWFn9hXm4gPYSUOwL3vYN8YwplkoNLvomgK_Vuc9u34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1y42fGbcqa_FgEr6PYd5L0AIICFw3yOTE1Nlu6woLJcg&oe=69F750B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyq0AdeG7ZgQ7kNvwHgu0A1&_nc_oc=AdofENyGqtF_hppKBcI1oB-XbQE9Akdfg8R7lEYF1apuZWea-mEhWiGPlw1HlLNR8eA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af260eBZCcufEWmaE8HfWeOee-ID1e8ozxSKUTiTuSGigQ&oe=69F765DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPzGJ6VoSKgQ7kNvwF5hWU1&_nc_oc=AdqIX855YylYn0U3gSABLZw3wKf-IwwqBMiC5Lt42HIu2KVTXHSwRIqCV4SIHnyJHmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TRChTD1haokGw5dQgMeFuuAK8wD3_qvXPgodHB1Zf0A&oe=69F769F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr5u1GmzhTsQ7kNvwG7qhkV&_nc_oc=AdrFibBlLDkGDPSofg9n9gCK0Rizr8ZbvAGrXc6XqlFODRXtRGt4Qzl-oHHxvRDgMVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JhZttgfRx0nEyCP9fnejEvyoWVRj2-bJpoxPrRn2BUA&oe=69F7368F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
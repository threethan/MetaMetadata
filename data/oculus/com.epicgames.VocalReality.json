": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpvYD6m_A6YQ7kNvwGpbNqm&_nc_oc=AdpI3k4lT-rHHCy1P2OaX3uWrcZIVaMJkkidmpf0rinDRUK9oIXkmahZ0Gvv_S5cuQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sq_B4KyV2Bfoz4DaURdyUTZjCvPYvNIrzaCbavfzubw&oe=6A3AA4CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsQ1LDIjNaEQ7kNvwHu_uiG&_nc_oc=AdooL4ER2qEBo3IwKobjrm-UryS32b1NYkAAVTZnljOBYjUqSPTX3E54EQfp85Nz4OM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lYJc8pk_hamSiRu2e-qaGWFlQakWfbjEJ39IlnP7HCg&oe=6A3AAC3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmR_r_Bj9TMQ7kNvwECWGyv&_nc_oc=Adrjs3rJGIvLbr1tc9NmlIEmhyjK291VmBEOd3yvVP5zu_JYVtu6O1YL5cN10HKDjQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MvJWoKUyOj3P8T2FM9LVLu13RNiLQXKwhirQMRIHpAw&oe=6A3A8C5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SRMnp4bc4wQ7kNvwEIc6Ay&_nc_oc=AdrAuGtX0cCy4rSafHFQ3lqUhfwLZd7reZ_OlTYXk4KNzbNkDsmt6IZjquk_p7uu22g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cnL30eJHyY67gHLRlxOGbNNaw3koqlPgRX_QZRqd8Zw&oe=6A3AA34D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGThMuDhl5cQ7kNvwE3Qicy&_nc_oc=AdqRojqrYJZu3MOsTQVNbieqZnlmJo5s2Ax5B-K0904SHYI2p5veaBXYPDcm76y5P38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xl2giKBU5rcNutfwa3bNnjkw6Bt4qNpJD-qLIHRN_Gw&oe=6A3A8D36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FtX8Rs0-9kQ7kNvwGbf1Er&_nc_oc=Adrknv8FYQNQGMBf8vTJm3qW3ExOfIMQ-SfuS82xgc5zGs2hbM5xIy_hXuMSYydURsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WoSWZjfTCamCJT6s1HCEil4wJwrT8eHDOpgatvW3TqA&oe=6A3AA25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3pJi2BFz-YQ7kNvwHnuHnm&_nc_oc=Adop8n1CJT1kVnq7iyr_31S7mgQIJxc9oe4nkTpfzfjE6jRgMlg4ftMg3eniFEH0y38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HQOlcjx_96svZSqm9ODZeQlGXjDHIvwIM094lPQdffA&oe=6A3AA672"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXXy3U-Op2gQ7kNvwEuGPGK&_nc_oc=AdoEO6FRuXvGyIdpvEReXWipeQ2fEQd2gW7UK2oYfu0NTgU23nvSROkdXdAJsN2Gjes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vjzv2caZJfACpx9HKCEqcz5DW4WoDwEipTOTeuwEbQg&oe=6A3AAB4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
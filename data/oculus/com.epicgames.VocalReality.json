": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VZX5ChxE8MQ7kNvwGWV_Xf&_nc_oc=AdovFq8j6sFHQPW0_MfvXFqmM4CN15k9aOxVl1-lcPsy9Brb6DmRO__50VV1AxVbcTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu6Idfii-UOVfVwdHSH70ghle7uCG2PqTFyrxeupQjww&oe=6A9ED6CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRjqg_nhIfUQ7kNvwFhrEut&_nc_oc=Adp_ItU_MZN0VIkJW4vPZkJ0I6_JpgW3Cld7uFIEbsTvKGcOWpvwS8naCdxy39PJ50M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS09ITrZcuwKHZ4yiWsV8ErciyTCluHRX14AQG7nl_Ng&oe=6A9EDE3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3Mr0XOiaxYQ7kNvwGPIaFb&_nc_oc=AdpjT_D5xOsOkrZyGvgaZcr0epOvY-7Dwu0vDcDueh55363VQMSU6Pm4gmzwI0aU9_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfJ7I8ZnJ0jFjRTxaY9Rz8LomfcyMDRlTpIuelO65zjQ&oe=6A9EBE5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1nXn_UH7NMQ7kNvwEOmGVL&_nc_oc=AdrIWzFZ429a4TSKxsyQdBK3je8xVuuyZ6mKNqNg0sg2qbajthFoXX9UKudsQSqhuxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuo-x1dhLEzwnC1f-HKSwSy0O1r2TBWk1Ga2RQ5EBWEA&oe=6A9ED54D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6riUbutXO4Q7kNvwHuRkG1&_nc_oc=Adr7Z-pJ3ifPpLbCIcxzef705Q34cxzBVUI1ZiL2gyGYFW_Fc62IZgEVqCC5yYNbJA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt18nxZxe3XnifUKm_U64y9A4odDQDEUFZskxUKR68ew&oe=6A9EBF36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R1KTQaz_h8Q7kNvwFpr7Xm&_nc_oc=AdqabODcGUir5qXcLe84OwVp2QN_7uf_9JWE61w6oL21TFUkeLroFZoz1h9fINFZG88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwY1BevyIx7OVULsooa6ESuLZZ3diURTTIc6V_LP-LfA&oe=6A9ED45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FINjk_1e5J0Q7kNvwGmQA41&_nc_oc=AdoC-gkPHzTVMxrVh5CpKJiPC4bjtv20oYzY9bsbfVXEBxU4FzdT9qIHoaY2LK67UPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwD-dHIhqiYc9dkohW4OZQBjJ2uOTKrod61hGXWzo-nw&oe=6A9ED872"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2fPiOlxYXYQ7kNvwGeKCO1&_nc_oc=AdqMO20T4ZNezfT_Z0-LYwgbDM3ela9CfsgoJFJyJrxoBdOHxV41b3Fkxjd-Dpevfgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlmFEAg3ykoEHIJKfHGNt0bMKwDnGnwpNgyLbpgEwISA&oe=6A9EDD4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
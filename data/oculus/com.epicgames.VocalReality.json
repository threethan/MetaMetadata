": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIxRNsPZ_HUQ7kNvwFzG_0s&_nc_oc=Adre1Dwsh3P6LRUcJBeij98nqykUbupz_p0DEfHlw9lCm3Uc6s2X1mZRuoAUe7NT63w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cD_83Tivc_fFH7kbuW-Ve8u48GTaV0A3MOZIm8B4adA&oe=6A0345CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFtsgXIfLT0Q7kNvwHZXc13&_nc_oc=AdoK7fAv3R5efo0PLuNmj8oj1keICC-x3mX9bVobG4g-vEdNNn600pGvvNnM9wsW4Tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OG1KCl1m-IEV9c4MU2aIvZ5nO9JRhRXlXBTca9mEJgQ&oe=6A0314FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT6dB2Y_JboQ7kNvwEeuttx&_nc_oc=AdqQyAGnCFnT6qU905t1sndZn8741x6sPzpXY-qjSGftAGPxRW8ipjfK79mBBFNCI8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sk_DfMid5Ksvzewe1zgpyoyA2fMcslBXzOz0jtXSLFg&oe=6A032D5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_oAmuruH5oQ7kNvwF3q4ud&_nc_oc=AdrmESIaQ-9BGZ9vS_Q8gis04JkUhgCKhHlPzRmLBfik4Q4YooJzzsL-cCneYWRgKHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af641wAritZEou5d-y2VGqXghkObg6LRGCGryYzXaoJxFA&oe=6A03444D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMdhYXmwRrYQ7kNvwFZEQwj&_nc_oc=AdoY7Nwh_ZISqyRvUtQHEcmrmIfAHH4DQJrwqvnKGyEGhseFpsIG8VmyK46DTzDwpa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cTJahwqmXocqEHhcwCU4_bIJwSyQXwpT72igV6wMcCw&oe=6A032E36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLZTFiEWDvsQ7kNvwEli9dy&_nc_oc=AdooNzobx3osj5UqW_JFbU8kx9tMyQU0s0ogG0oKVZt_tNuqPElRhd-TfSeATnW3fSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NFVrzYoL224rwDrJgaWQ_eUDGM68-r8qd_POOA8HNxw&oe=6A03435C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYznHYumnysQ7kNvwHfD-mK&_nc_oc=Adr0aDPR2J5E37VBVG1TVKz0ye13ow3-V4lgRV9GhvXbfGsbw_EU2QdJHpAy6oWlDuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-iGqL1TOxc7iLlQgghLFeDhSHekYg6kx00kvmZsWiFQ&oe=6A034772"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr3gZzIMTdsQ7kNvwGG5l-G&_nc_oc=AdrHSF8w0Pd5tcq-c0sdySv17gDbimsFHar-0qDnYxRhRvPYCGUaXYsc1hUcgRi7OZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BC7XZOGamdPdTXNsRGqYAyxyZgFB_Dgwy-oDJ4cwVCA&oe=6A03140F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
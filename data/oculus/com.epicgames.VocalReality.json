": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0F7mboVMEsQ7kNvwESSzJi&_nc_oc=AdpDt8KkSTPR2tL59BiGHtzF29htxL-qTrCW1aVau6R_34E_014VXgAP-M_m6osfFvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpn2zvmLe8A7wXPx78ZGikqdbv2CZ4c_0ar23pyqYfQQ&oe=6A901E0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxRSShghrC8Q7kNvwFpzyVx&_nc_oc=AdrCg6vgEx4jPG_3rTaVxJ2lAp8ahmjRG-5tIIV15e0UxBjpQBbnbUglSYhneWy9n1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIkorgzXRWQAvMRlsEpmvJXGOJcx5c_vKL9k8a-Jnopg&oe=6A90257B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1qVT_afXHIQ7kNvwHiobxY&_nc_oc=AdqL7cprcEPyZ6Vz2nbCA1Q7TkEWy8TPmBS8WFCs4yqBaBtIlq3aoH0g7hDhaGQUP7Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaJ9Jmg7Q8bM3gXXrY_ygfOOq-NpEJiiTt28HMbFYltg&oe=6A903DDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74GhWdq1jEIQ7kNvwGkQ9f9&_nc_oc=AdqTdVaF2VjconEV8RAVuHawDAbwziimm4ZWSe7QcwG-5LcW-8639JLG41j7Xrvnmwo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyttBo0XQ1YeY-HfBEApV8URyGiPXusxlQzwX0YHNYJg&oe=6A901C8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvQR314HkmkQ7kNvwErqgKo&_nc_oc=Adrl2-ybz4_Niox63pDmzPxU_01DJTWRM4fx0pLKMkbnP6iOBQgGHb-YictFmgL_RXM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0FRnuio1ut5i4dApIqHyA5NQ0BKRSGaLSJTnI5Iff4Q&oe=6A903EB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmGueszhCFgQ7kNvwFNPw0e&_nc_oc=AdqVmFD-Bykw0P1u7UgQl468dEQBeSwOXtWCWKFhr4ZI04XxOd4qjN8ZlcCHkZ2UceI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDHBkT40drlNkxPQXcnpMy-WdPuiNYqz0rg9q1dKGDGw&oe=6A901B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JDTp76vNWkQ7kNvwEW4Wyz&_nc_oc=AdqlI3i03o1dzYSI8MImfA-xD1Pm-gtUhP8OiGIt43dYlxosWCkD1ExoYzp3RFXgwVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Cga31eKNBkM9wbN1v2VSXiU_3paHfyxqvJ1sZ_2hNw&oe=6A901FB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQtfJiQPducQ7kNvwFFZBDa&_nc_oc=AdpdhA9ThLrpl3GqOfD3Hz3hDaCVVEC1tW4-O5ptXPCdCsXhJT_8-DDvLAKmaiFG5Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Xf2SIRQH4DzYKXEdi92za316zjSgkUgvVu7xGmjoZQ&oe=6A90248F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
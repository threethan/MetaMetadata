": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwmdo3E9d-QQ7kNvwHAjAYX&_nc_oc=AdrAqStGv7QuQr5qjY1V1AI6STBaXmAHri55qFyQdjDn75in1mFsJ7TRQWkY0LWrf3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvFWjoRRqp68_MxU3NbkxQ4EdmAbi4D3Eb0mEk63RFag&oe=6AEB4DCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nl2Rdf5ANEQ7kNvwHYjGSi&_nc_oc=AdrKXR5C4h5t3oqg1zFP1a8Me2D9l7s-OrxNViCGHOZsdMyCiN3Kl9W3bFh52gAZ5yI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbk1bTPgD2yGQWNKm5jrXxi9mpCFpDA3mueyxzqs2jUA&oe=6AEB553B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNvJzz4Ung8Q7kNvwE0qNDh&_nc_oc=Adr33H7aq07nR60dE8RZuCbgHe5ZqORhii1dUpS8bDCP-G7PHbNkn-dTiS8wLfHmDLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2Vk9qSkAdILu5qvo1TEs1ntpdXsNLx-T0ZWO740L5zA&oe=6AEB355B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOj68fm2z8Q7kNvwFkpvq_&_nc_oc=AdrxRfNLVboScXYrpGvT-nKZG8QGIMN2ZiAq6NtJNzywl2qQcBw1sHBYiQ5Vc6UlMQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST-DlWVgFDzby6NgZ3uRkJ0saxP_x-9MI34sEA1_MIZg&oe=6AEB4C4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGAMT5q6EywQ7kNvwFy_ruM&_nc_oc=Adrb1NnVX1fG-PMEak2o9Nd0hlnHxV5X7POFHHhDLtPFs9_gJcnG-SKZgmXyw5hRNA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb6jDtMeSZFO3NkrTfcDsjYcCaBmzeXdrhyKr0tRUwzQ&oe=6AEB3636"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbRngSdqKusQ7kNvwF487K2&_nc_oc=AdpEP2QS0zzcdnQRc0HkJ9rPOS1b-ivSkBrGE5Nzr73-YMjXidqq1XueJSYlyOel6Ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_E84zNoYA1Ll8tj79K5VsxwwXNQXPw9n8R8bkMdnvNQ&oe=6AEB4B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS-wL29_nfEQ7kNvwGLKIt9&_nc_oc=AdpwEBmZ1lH2oA5xWbbrLFTprr4wqfPyoqdytROjwKPj_21br-ZUSVia-aFWi1OHqBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQze4zR8hHqWZWOodG0blb72R7Rc1kInxXL0GRhHf_ZyQ&oe=6AEB4F72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFMBh_z-WfMQ7kNvwEhRvFi&_nc_oc=AdrNLbwVlecW4QNyFox7MboEBkLlx9uiB5nNVp2Exy1Iw8UclPO1BskYLiNPFIJ_FJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIx_sbagAUQikgxw5Jldn3HpMt2MXMN08GexWs60XZMQ&oe=6AEB544F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y_QKnloC74Q7kNvwE1zRA5&_nc_oc=AdoHKfaZBkLdgifDp00w0z7aXrENU1C9eiifstXaTGi0-qxx6ec2hZVjvY8STqE17oM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z7-wPvvKYrZnkdw4ouwAK4LLBm7qPj5JKtt6ITYHxiA&oe=6A340D4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IELTFQ8TSMcQ7kNvwGLhx62&_nc_oc=AdrVpMBZL3Bw1j86gL5ntTlB9ypam7pXSug3f1OZ8N5H7P57TuLZqrEHxmhTLzfowt8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RtF5C0Kk8rdirNbqKexj7467tvkGSzabBMJ3bWLUKEQ&oe=6A3414BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3n02mTiTkMQ7kNvwGnBXaC&_nc_oc=Adr5DhXn5gtDvXkIAmLQX2qX6C_7lDkVH0kfcdDdVebaHTpEm7QDuipYF3G18PhkQzM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pEDv-dU9XZNqojWziNZvTLTGP5sumUVp4l_KQcxspPA&oe=6A33F4DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dBUNnlqhDQQ7kNvwHXgI-V&_nc_oc=AdqdtGttMOl0GfCorbHUfW0DmmehTHpmxzP2T4UY2IjgkUGdOQ6ApuQoPDuUvUYBvBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4f2o_lMuykrTqPphv67cGwo0QZfz-7dfBlJyWGb7dUg&oe=6A340BCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW5sKpf1HPgQ7kNvwHWuvQf&_nc_oc=AdrKQOr9gRwlOdQ-bcFrK1lj8CCUjicQkP6mXYvK7OOihGMWTWea_YAf5cOJQ8oWb5w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U62nreV1TYMjdsmxjus84hXMjyZe1FC-OoNGUumwlFA&oe=6A33F5B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq5aPQaGrooQ7kNvwGjT8yV&_nc_oc=AdpXSqyZkqXZcWF2jaBaB3Am6ChXjbXLr6IG8BVRP4vl4FhRSj5oLLzsQ88MOl2fXVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r5kr_L5GNqZy2MdmiJOxyXWDB93DbhiWLS3HTLCjdBw&oe=6A340ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJM9yifITWUQ7kNvwHjNu_I&_nc_oc=AdoGi7FlmllOHyYRakbMTkYS5WjVWI5Nip-8TEZ3lpIb57b_KjBFSnlpGPNt4k_MgWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w99IoF4w83FI4Pwa9eUPzpaHg8Fpnla1m0MiXWZliXg&oe=6A340EF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCxtbx5FaKEQ7kNvwEeFaLh&_nc_oc=AdryE2WK1V-3dpoRmPC4pXmZl_4sc81r9wdSBV3WPcP2-9Y4oCDjyKJp6oxkoxWofhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bi1Kb9E29JngF9cIEKaohm8ezdDWZ0CHcSKXOMYsDZg&oe=6A3413CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
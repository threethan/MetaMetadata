": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ATCtzmJ0fAQ7kNvwFZBAPU&_nc_oc=AdrRJXQFDvryxD8E75bvMqGsSWLQN1n-YfpJjP6g4wq3bM8Q2rPtR6LVnGH9iS4Jn_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hihTmCqGDNbADGKF_iaSbK7zu9WV3LYDN1zxjPOWEcA&oe=6A3E994F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYpwNRnenCoQ7kNvwGnQ3FF&_nc_oc=AdqrPIkElRkWc1eHLMqkKk6zkUJZgc6emVYCt7Ne7By7QvpbSFirRY7V2qMPJoojdvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ixF1ebkXFA8xfvedluA2lbrqGOYi4z6_jKBPiFLFS2A&oe=6A3EA0BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do4BU9uHjcQQ7kNvwElVtaZ&_nc_oc=AdpThsT6wfnndwTIG83HsQAak_XEIMhftfxqFZlfX-Uh0rogGxcgSQkF4jGxyGNzpfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RPhmxVcLVQVOASZZgzs-Z7R__LWcm-MS553Q-reWOZg&oe=6A3E80DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbiDmjgxnNwQ7kNvwFlc-UJ&_nc_oc=AdqsCLdxaT2f1pOwccrSsp3FL2IKjOu6MSEoZuHipb0usB8w4H2qAU7X_03fAm1DYXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T8dice8yuXXgyp3OSlLWlRLtY2HtMQUdnBQf7cDRmww&oe=6A3E97CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0SRiAxrmvEQ7kNvwEGXU_x&_nc_oc=AdrCmK6R7CV79nSFnTKOdB12htppONnSfyi0ar-dPQBQF6jcJseKD9QhpwHsoKb0l3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MMlLnhHrOc_eCR3ThBioj31O3vQfGQgeum-MadekKnA&oe=6A3E81B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxT7-Etk1AQ7kNvwHBl5ZD&_nc_oc=AdrKJesi8bPadm43btu9D13c8nu4a_PY_J9i8zcVg80oLfHUGkndqfV_B2uvwqcQWuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Grql8vq963Jx5Lk48lTfkHNGz1W-uCshI43dLWPHsOA&oe=6A3E96DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ERSYsruswEQ7kNvwHFVdZr&_nc_oc=Ado7mCpQ_thBcLjpydPLXDozCuHAig9XMGOHjwYTdWItEafX_I6FAEwPanuBazpeg2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-rCVoot0rc6zVMamHo_qDczHXnIGQzJEtmhLbKED70w&oe=6A3E9AF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKOriKmdgPoQ7kNvwFJsADV&_nc_oc=AdojCgKte0znDRKpRFp69RQhgYXBcZkAkDR2J_c088zo7ILoUPY6lQCQSEiT9vw1ONY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TaBMHmWi9rLYgL5qi7QWnczypMBIWk81fgNYx3VLBpQ&oe=6A3E9FCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SO0tb-82ikQ7kNvwGn-l05&_nc_oc=AdooOJ-QhcCYtVsTj5LvI9uaSiVLwGvi7_10hyOqb_vKi1kmV8-aG_q6NByEln71vFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwuju2qUVB6HQkUylPNDYPA_44an2b2oaLBDCoJ0ktUqg&oe=69CA5D0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rhexWZdyK0Q7kNvwFH5Hbu&_nc_oc=AdrFwy1oyLyFpsotn2Adu8hmwMWx-Q-ItQ4L2qt-bDB18gWO4Bs-438QGn67umVsjaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeeI00eiGVov-MaZaDUQHkhiHwSsbHlCyGhSDIHIYTpg&oe=69CA647B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvdKIklpd4YQ7kNvwHSv_3q&_nc_oc=Ado_WzsR3NFdM3fkxh8hUMZIRkGM6O8_3P8dAeptx-bG-Io-RZZIk3tvYQluN4MMp8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvB4TJ5Cm1nE-nbKijDOgM1Uf3RIhvcxJ4WWnkpI7hgg&oe=69CA7CDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX9tckGxEZcQ7kNvwGSBPn2&_nc_oc=AdoQDi3IgkwVYhIRxenJ-uazb3YrXMQNAdrKYpqOZ6RvrlpVlnWx-ur5rh_PnTJ_Q4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxELzfTheeEC40mnqPnLH8_N2a_UAZ0W2ZLf7892XxZMQ&oe=69CA5B8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxyQQPQBTcoQ7kNvwH_L_L9&_nc_oc=AdqVVmwtAroJSf0_hMFaSMHuUNJw8MR9HLoObkt9k7PkrPlv-9di1ia2MC-JEcd2ubg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAsSmHZQz_L9ZDrseqrvSgHuferHrJ6QZWfV-SgNgyoA&oe=69CA7DB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh20OMU09rAQ7kNvwGmHoNB&_nc_oc=AdriFhGyhP6qJcQceucBWnIrchRDsKpjQ7tIEpd5Vu1FIcbhB87lTzuoAqXtxUoS_L4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb7youbA--RmuFnPu4DiV3apcGOP_4hbpJw8zxS2VWIA&oe=69CA5A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir2wmszURr4Q7kNvwG6oXRK&_nc_oc=Adox3kZwujetoZNHbrUgKLjhDjsIrjOCLJjoH01fDYlbRaucRbbxDprqV1ICwjYJ_Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcFsz3CXVpvZ9rzLoLrakJ3RMChbSqosXrYeSVAM3log&oe=69CA5EB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRt03tSfCCoQ7kNvwEBdNdP&_nc_oc=AdoEFE4KCi5vvx2GyHPlRsJ0PVb_bq413HdWMVsprdPX-hS3mXMLEhqKs3jaT23p9cY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxgvgg-OgqZcIC565jmOvkIsw2GkrjWHIIpCQ_tbkJ3Qg&oe=69CA638F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
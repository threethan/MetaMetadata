-mkcx1AgpwmHuDJlm46VaH4P1Zgs6HdHdqbBzXWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfAv_6iQ8rrwY-YBhsCxPcfvAEqDBVL5OK-By-evtmRA&oe=69A6CBFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv0qpb-9xl0Q7kNvwFppa4u&_nc_oc=AdlvMMn5Ag-qm96ZncVkytLetdbDlhqi_zwicPCeg2S6wXRJDdZ7bXlKHquCLIofC8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRlGhtX5-dqe7OZZAgsfMjxh75RBqtyMpSzqBmieIHfQ&oe=69A6E45B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeXbi2jpX1MQ7kNvwGzA9xw&_nc_oc=Adlqe_5ur5aiTbwtIAYvXKVgON0zwBIrq94V-m8o4J6sBJLgQ-V1TzcdKUiN8ZlpPcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsM2AgspYwQ9Bti-_DcTim5eEdYOIbJzp-AQCQk3KTDow&oe=69A6C30D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LZ7jYNAcjUQ7kNvwENg9r2&_nc_oc=AdlV-Pm571lhsXStYzb2XP1xeSbIDcUODFDAaj27EtXU_jR99ll0qZ7T_TNmIQeLGOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftm33GKn4m_Ogka0fba3wO3HnhCCRaOhS-XD_vmyUtDOg&oe=69A6E536"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rs30YVGYcQQ7kNvwHF--_w&_nc_oc=AdkYDFiVAe1YUW3_i52bf3UdJni1wk0R7eyPWK3ucwptFxkpy3hVk-9A5FXUBjUbejI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8Poz_tPdEDWpJORIvb_bqxk1LnyH9DtcNuw2ZJ5BqqA&oe=69A6C21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "suppor
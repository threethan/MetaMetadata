": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q-yM3mWhs4Q7kNvwFejAYu&_nc_oc=Ado8kipFGebaUlbA7HJaaEcgb6QK-ftrwzskpoEUJw4c-9U3NMelJ-1_OapJjNqt4u0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYxhXASPkL3LTUrdKoqN7eQDH9FCNV73CNhWDit0GisQ&oe=6A576D8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_jUBCYWSeIQ7kNvwHMwY2K&_nc_oc=Adqw2fSAOKBASyD0GZk0LvqCov7aw1apDGZdB-KtQ9BDM8-2Tn-Ge72I81_xXncVTv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHsQ8kZAHsgLGBJs5CyvVxnWgwrBGNh988UUC0cFQJXg&oe=6A5774FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU4bty6IEAwQ7kNvwGIELu4&_nc_oc=AdoA8SPq5K0yaBNuWLJc49Y5yRfezMFX8FAjW6w60RLJ2JRtjbVuwZb3ADUtjbAuFwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaYYKMKrN7x8hORRjSac2pS1UyopraC4QaW43626GhFA&oe=6A578D5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nPJB81umSIQ7kNvwGzZeBx&_nc_oc=Adp7bs2IzZdor8NSskw9lKH4FiOR3L6OYB2VCfG6hlZkcx5KM6D9PIrfvvB6qsT6WNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzAPpFJk9yNhs7UEsn03pcymfTmrwaQtY7XpVM_feqKg&oe=6A576C0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zpX0w8IULMQ7kNvwFIenAA&_nc_oc=AdqoLS1cS4SsLPV-5OskhsaNnmgosQs7nANCOOAhvN_ZrBjR83ozw8IS2Co9QR0odUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu7To50_B9I68PZivCUCWphOMFUa_F-Q1YZT6fh7Xzww&oe=6A578E36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Lm4q-59VYQ7kNvwFVN3Z2&_nc_oc=Adqlr6u4k9J3YnwQwe3io_Hl_VCM5PxjS9pVt5ctYxXXh6cr5tELQC6x8GDk-wGdRbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2r3JQAZ3ejOydlh3Y3WPm9ithlp0SCGMO6JZH8EWmfw&oe=6A576B1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvKMAzvfasgQ7kNvwHiqI-6&_nc_oc=AdoQl4Lhe33HtmCaF4rWaaHu9mfIEBaSzOBCyQLxQmYot9SrSa7COj4j7O5uCD2KmnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC2uOg3sN0ScslLHP7cyI9smj0RY51KuH66i7IP7Z2yg&oe=6A576F32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4pqPH1mGFoQ7kNvwFRJRDp&_nc_oc=Adrb9uG373TCrIvc8obmybnM-Ffc2CSNcouQtgEGJwu9dvbTykJSyF9uVm8hZIWAf0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvDbOFYuURHNsaPnZBDG26UCKfFyOMeUqz5QaC-iHMYA&oe=6A57740F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xxMUHpa8qAQ7kNvwE0Bw-i&_nc_oc=AdoXwQ5vY4WLwoMquJ3Ld2v6J9cco07dA8KaZVkysUBdsx2ekq4Ef1CbUrSB0HSlsbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrKIfRemoriN59NYOTB7xJQjp4rKx5SSB4B5zG-kVNJA&oe=6AEF424F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJrQ_n9LYLsQ7kNvwG-jx3S&_nc_oc=Adpdg2DcYY9iKGFJBq1tCxUB6WfBDI8wDld0CrPSA-gfUgme1aztVFcRcywx-su8q78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR--ZL-615fO9KHaUfi9CJJjpC7iNjRaAy-XQ6l4wJMSQ&oe=6AEF49BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPu6a8ci7voQ7kNvwHGxOLc&_nc_oc=Adraplbj2SJkjMZQinuPQ-1RFF6RzfS-2_1XQCTERW3tOWhPnEIt3u0ts5B56htzWo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Mawv-ppBF5SNZelfPH94Ghqzsq1t6SHmK8ENVIiuTA&oe=6AEF621B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1S6aBMiQmMQ7kNvwFf2jsV&_nc_oc=Adon0YWZTBtdbESLzR_5J3NUDnT_R84o09OpoT07VMXzpUBj_rcgtVCXo-RlAuoA8cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfe5EnZ6QO8qBxBkDoP-bomyVSzUjirJ73DGZYD698TQ&oe=6AEF40CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQy-IQDD5CYQ7kNvwHnkfHQ&_nc_oc=AdqarG1ZlVzXTwhoJ51DlTZDLs7MfvOS5HrXq63tCiKLIJBYZ_RzPXtMn3Lwr3aRtR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzUN5jBlq1d3Hg6vuWeKg1970so3dEHfKHl3mtnM_vjg&oe=6AEF62F6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2a2tohFGz8Q7kNvwFBaTb4&_nc_oc=AdrvGIGWFp5s6ikxxUeUOw_lEwO3khq4T5Nkzw8FyyQyW2QYZLKYdTTdzM-vsqw2168&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2DOxJ-vArInlt1_UEQhbqqX3Uve7eGskdFv1wQMdkSQ&oe=6AEF3FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGLMB1FoH6AQ7kNvwEsPzT3&_nc_oc=Adr_xRYNEQfYu3jKaflfElUl8JkdABoH49ih6X0hfSXWhQpJ0XL8njeopCIp4h1BWr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_CGBLX5N8ZJFapoirRudYY7M6M_jHlTtHaR6BB9nbVg&oe=6AEF43F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwv5Ci-mG6gQ7kNvwEqCINJ&_nc_oc=AdpB8_9T_YZvyW3RSFDtWxGX3ujmBux360zwQSxDxuZOIxTa6SW7OIwUEwcJ-t5txBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNPnSTX2myKnOYqYOww9f85v4J1fa-7OEmsGjXzDC5eg&oe=6AEF48CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yte2tXPHBJ4Q7kNvwHJTjCG&_nc_oc=AdonVqGGN1qOlgzeSpLBLWS5s7Arr-ABJ3y2_NNmFuFsJpcRNuhzAegZoGwyZRUDB5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cuLaudnIgNGsXU4ttKR2_L969svr7bcJOR-5dXmTyow&oe=69D63A8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWMr3N6qQgQ7kNvwEPChJx&_nc_oc=AdpAmHqYi8jSyDgvlfP2IQxkI7mUstbo_alBX-HQdi6dGDvKCBif6AAMD2pT-gK1_3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FoHkev2mzX_Pcd5dhNq3SpkUvA5pQSMG-nG_MYShcqg&oe=69D641FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fGkczbhsm4Q7kNvwGAuQ1q&_nc_oc=AdpIW2kTQUPUwQFvL7rulygsGZyTLxndvbWly9ZuSSU67l5PeIEXWZIWThAfgp0kHDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ItcXepxkxwUZcVxi8Cr6wv1tNs2QIgi3HHsDg2BW27Q&oe=69D65A5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TNWN9xTJEYQ7kNvwGqVvJE&_nc_oc=AdqD5GPYLzm7YxzaD1bVkKXPxpc38AOcCJ5Tm1vP5hB7I4dgtfpE8wlGWN23WI6mOTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s7lCLUhvXqKTstmVUsXR6trGmw4WcfMZci4YOesofRg&oe=69D6390D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PukC_WecKH8Q7kNvwFyPU7L&_nc_oc=Adp7RgV3GbpbQciuj0ELlzpdYBQl9bffkAW9_0aWh1bY9rafquIhwMxRz3cEzShaO3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n_VRGpqPbrI8LuP85vwhrxg6XQ-twK6hB3fWHzl3L9w&oe=69D65B36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu2UosQP9fAQ7kNvwE_Rkju&_nc_oc=Ado_bz7WztB31bBncKtT8bMM5o5JQcLmLuU9Hdlykrmj8YU2OhftZpwzq26UeZo7Cmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bTw5wVUU0YEuo5WR-axVSi3oA5FKVpcqJNuenzAHrwg&oe=69D6381C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEuNAH7uoWIQ7kNvwGPmVlG&_nc_oc=Adp7yEy4a9jdT0c5Ak0WiAODfKVk3FiUgrRDyjKhvXKdOxJGlyAMe-Ii3xN2NWiN-_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mq8eSPpOMitUvhAfwvkUgZ4X6ODkaz8zt_j6FPCV_8A&oe=69D63C32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbV9G2Mx9gkQ7kNvwG8eX1D&_nc_oc=AdoED3Rfaa2tg_lAl9XMooMIE9Wh1t9W2n0npDjid09RVfn-Zu-qZsxDQSPuC9hdyns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T0F6TMmhJgpNP5g_VkOKunAKUlkwkI5iYzfHE1fwiDw&oe=69D6410F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
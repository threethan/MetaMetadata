": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei_MvEx8dV8Q7kNvwGhN501&_nc_oc=AdqbEZwCallNqv8URym9f1JACuJXhopgC_VUc2qgRJCQUgBMl16Q8_85co4W2-uy5BI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iXq5b-s53U5IMnW4Y7cU9iRMgpzFiBTGk5VwHmQWNWA&oe=6A05E8CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpIaOxgXYjQQ7kNvwH6udRN&_nc_oc=AdofskyLTjXFHZYW6iAINfCr9V7dgz-G58LQvHipdBL0LT2BmrtEr7ZegC2bIGwcARA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zji-yJNA5lijLZodp70vHwH8CfxCIl25oyKnm1GRwXw&oe=6A05F03B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT6dB2Y_JboQ7kNvwHyp-eU&_nc_oc=Adp-2gCMIpXfz4hjxh1tno8B-gIMYCG2vOGzakAwKZskRF2g47NxAl-zh1XIg3a5ZxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ZIl_j33azWzFs1l1cv7N2rNjPzNGW1dqucpOq9ME3g&oe=6A05D05B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxw9G2EUkj4Q7kNvwH-8jju&_nc_oc=AdqeTDWE7_qsE5qd17DYOhZlidr1XkBYUX0yx3jw_mTj6TS0T4vwh7BJAOILeh45CCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yg0p5lzz1PIcEq1IHrlAjzrFdkhZT2kG24r1Cc3DBSQ&oe=6A05E74D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdI3TVrAUcAQ7kNvwG7M--V&_nc_oc=AdpYDvfOwyoraFKOjvAZKL_4av1PJfq7Jc-OdbqaUDe_-jGHwp5hEoGFZp8JjHTLdsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4trONdvP2ZSXbi4UUi7CtC2_anfScvbsDf90QzmRJ3OA&oe=6A05D136"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6DtkCdv-FsQ7kNvwEK3CD5&_nc_oc=AdrvzcPlF8-Y-frh2SD7sRyHvpo6TpbuMljWYaOW8o6q3yY6sLlYHLtsZp2s3EuIf4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af755txHXOXhP4CRr9QoAd4BlNCra4QBGnQgcGCqDZbgyA&oe=6A05E65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYznHYumnysQ7kNvwEwzFx0&_nc_oc=Adp36ELfYpbnGK32HXxeYzGTi2rYpeE7Pc3ip95OxXRxoUyKGpSEmQkfSAiF_el3KKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ujUrOJqUeUEqXg4jmJIAdea4S7TOYX7ubD8cx_5e_hQ&oe=6A05EA72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP7qjC5Tid8Q7kNvwGGwWer&_nc_oc=AdpiIdE7it8coYOe8k2MxFAPMId5R8rfEM8Y0amQ_dRzDt5tc49umBkyrw93ft5Q18M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s_lQomtF-XDGHEq5LEF3qN-6QOIz98qsTOih7eBlshg&oe=6A05EF4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
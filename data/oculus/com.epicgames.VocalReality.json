": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZICgBq_gnoQQ7kNvwFy4OeB&_nc_oc=AdqqLotEGgUPtMkaP8WiE9xqe8M6Ru9_eWyR9CTD7JQ2MyVmsJdyyUusx9WZi9lXt5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg-giJbX8XEkSyqAEJB9rDW7xqGdWNhZyD8RmDmhyAFA&oe=6AA8114F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeR0bKt-pJAQ7kNvwHjjtsr&_nc_oc=AdpH34xEPWB82sMSQJPyzol0W6JMzJBkjWU9r9ZArO58frz_sPh17tS46tsX8BmNCWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu4EW2dIwWOfh-6yQJRYiwAun30gRa9Wt0LTSXHZuJhA&oe=6AA818BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZOqXwEZS4gQ7kNvwFNqfNZ&_nc_oc=AdoFgXt1y8QV-eClDbdiZ8J8WThr2lr6e0P4hZ5N_FGmAu9FZuah4waH6VxJTfZAx1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDZzafHU5BjA1oONVBVmhPWdBmjvHCjCAZu-g0SrRWsg&oe=6AA7F8DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRmKwfez7OgQ7kNvwFhRM06&_nc_oc=AdqlvNHp6NtbfaC_YnqNHM3jSVz4AJ0LowVk6Z7jsO8GoX413awo51KD_PK09qjBS4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIXT3JbEfCjmhPNR9aUj6juzVBmI83FczO1AyXSUWcw&oe=6AA80FCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jICvP_LifGMQ7kNvwH_i_Z7&_nc_oc=AdoMgkE2ZaanCeAbtSg6z9veOSUh7M33qOibsqc_sPGpAkPP_zW-SuuwkZRpAu4COvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxB_mObmDwCCy54a4ahhGANoOX_5U01Dq7RxrPSONtVw&oe=6AA7F9B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4yluOWDz6kQ7kNvwEQ2eFb&_nc_oc=AdpIRyDuWgo-VF8bsjNOYEu4Uu1UlC9WNMSGmv-4Kkj_BEEssY4-LKRixn9XzaT6I1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAmKtwGVxvTSOkhPPvvFhUL7o26dIbSlc-qnuLILzVSw&oe=6AA80EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfySXa9QLS0Q7kNvwE1Lgwk&_nc_oc=AdoMxf46TBLaonLMWCeAwlOrcGzcl3KdN7Rww6safgw83a1A4lHUh3xfSC9tKwMQij0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTInVK4yYKNOa5SlO0pnt2pgGfLBW1JdiSJCo3erEW-Q&oe=6AA812F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iw0kAJOj-awQ7kNvwEUKtIr&_nc_oc=AdrxZ80mkS1OovAe1LbHp_dzJ77sXIpXIx4neQGVGor1dMhBoH6SKuTomtxKix0Jtzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYXRX1MCq3vVgwtscktBEJqBd2VvFJioKwx_3rnNxiwg&oe=6AA817CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
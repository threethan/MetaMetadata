kCF-UKwJ_dOCM8bWo6N-yBpj0KMJ_txRIVruhWimJm46g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5ZA63JLpVkhmomTeEDc4IXAbEEdn9OFkXE6d4fJ9Hsg&oe=699C5936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMh_LsD8ACcQ7kNvwEA7AIo&_nc_oc=Adl2N-3BPOE8nny3K0gaEx0H85m479Kv0WjMF3X-jMQBVZ6tOtAOsarfWaBZCYTPGXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfswnV1boK81Ir1vVs9OYti55BN6DnP2C14Hdiz3Ztwrdw&oe=699C361C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_6_6DBHRcYQ7kNvwH9naZw&_nc_oc=AdmUTKEskS-D_tEfHp3RnCfVqjwXpzZMxAt2SOngtRtUmKNGPfVEWr0UimaJMh29fSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftPcn5q6Yqid5j_hgvt8Vy2oUOCFBFYlwV1SaReT9YXPA&oe=699C3A32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eolsPnnXXgQ7kNvwGFTBLf&_nc_oc=AdmJIImX79Y_mVDsI4o_dhopMIzXpNlZiHiIXM_a3J7q-8KSeN3smcHqdPS5rZ4j4UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsSp4TmUXjfLwjU4DFNzM66tLze3DpnolMtAohpQA_G-g&oe=699C3F0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1746935640, "lastRevision": {"nodes": [{"id": "8520715531
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zziahewj3SUQ7kNvwEw4pmh&_nc_oc=AdoLkAuuclAzLWXFGXlzMM4gc6EpzRuuoig8ULnROkAAzJOWD4jjseZ1wpxUVvoZ_UU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QPI0Rholwc20hmakOuN7xw2yh-9HDBdLyQFkh_ysOyA&oe=6A26DE4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHEd55TRaZIQ7kNvwECjaI3&_nc_oc=AdqBFtO_NahN2CsWlrgr2TlpU3lFwtY2gBF3Ij-oQ__fMeV4L0nU-si8O_djBvDXl3A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gd4gJXWdyr6lfvizTv5Sofz2G0T0Vc4IMOzc2S-otfQ&oe=6A26E5BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1lExa3K_KQQ7kNvwHXn9Tn&_nc_oc=Adrv7zpak-C30lCNQ4jSTDo5dnJaGagSBR9vXXhpn9_v-n4EnpQBlWNcjjBQQ8CcvZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMnCEZ3ruZb2CcL2npyDqKS9MgUnOol1fZNDnpfygMg&oe=6A26C5DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62qmPKqKrK8Q7kNvwFLxihZ&_nc_oc=AdpT39ju4CH_uafpohfNU-MnajBlzUffy-joKKX5YyoK-8umIJ0aIVPGfk-n1i3dEEo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_abzjXt4b2WbgYTVvSSQh6tHQR1YRdx_zjR9hw3Cg6eQ&oe=6A26DCCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr60KYUgABQQ7kNvwG9BRvT&_nc_oc=AdrfnbY7ftW3HvDyJ-s5S1g19oaCd4A580LGds8_r9fW0e_mudRHaYVY32ULXSGCT7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vd8b4CVHygZJ4YucDG2GNEdesmK0P4_oOfdfZ3k1i3w&oe=6A26C6B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKx74B2bYWYQ7kNvwFznIB8&_nc_oc=AdoJCr9OeFvvzl2rW-SsqUoUQGUWLIjJT7gghCjj1_WU2OpLyVftM4QvZeUlQtW1D1A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3B9bZVUSyG5CcN5AhMrZ6LDOBHVeBf0kL0fE3S9xR8w&oe=6A26DBDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ6c76QSBowQ7kNvwE6uhw5&_nc_oc=AdrVEEm_GLqiiwV9e1690xlgxQd0hGHPRfmvv5iRwWUTAAhFccofdg0nv3HGNITteIw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kHCpT5qahB2IdOMStcQmloiejYtPB2-6IZ2P_WpCsPA&oe=6A26DFF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haR3VvilQyMQ7kNvwGkhUWS&_nc_oc=AdqAyxiPCqe1nd8kugB_DIB5qEaVdi8F5N2RS-rgxc_oi_s7z5WokEcwnYkascpxsZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1WjymLqZMHaNyrIwNOdgqHsHhmbV6o3BmKVZ0fl6R1g&oe=6A26E4CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03kVQ9zLduIQ7kNvwE9ehiQ&_nc_oc=AdoXnmw2NATeDyqaMv7LZxXp_T-vV0YlbiLMejFEOeb1zfkMksNXpWZMMp1d34_OIDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbpJdAclFXeRNqPwHjinIGWnW1Pa2rVyIA3lnpArJ4iw&oe=6ABD294F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1dYarNfiDQQ7kNvwHj0nH5&_nc_oc=AdpOUteTfPXocBuIbDZ25mWm4DWgHXdJUVMOMWO5fD3OlfCixd9XmIJEG5aR4-T1GeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn9b_xF-ZQoHmEwMEumOjt4Y_FCrjqTgmxZIBNAAozJg&oe=6ABD30BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jClrxxexyLkQ7kNvwE-sFcv&_nc_oc=Adqq8NxixepJwJtLZOkcsfaArBZLuEak5DmTYHab16POSGjQbziV9ZHOW91cLdD72GQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjYPOU0aNoeYXgthkc06jxNhngQDRhw15PUIg64tq5Q&oe=6ABD10DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NslP8GzXnUQ7kNvwHO3hZi&_nc_oc=AdrU2_gbLfi15z79yXJKkoGITb88vxj5azXVJglwtX_bTy5U5RtHk1lS3rOcIXExvcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBYcnRfKIuMBdsaNXEaFNUDVQ9sVE1wcDMWPrKJji3Gw&oe=6ABD27CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSQInzcIUGIQ7kNvwE3xYFJ&_nc_oc=Adpfk5VzohqtDVguU5_84IRFUupR14l1lofjhidfQH_L1tYkFu7rru_d0p-QwCPDJ80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXyvpNRgWsjS6s0Wj43l-CJkXmR0F8sIB8SV4D5auqvg&oe=6ABD11B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLQ_sLfrjo4Q7kNvwECt1zW&_nc_oc=AdrL35QLDLP1pAKgtJOLzyXmfSXeBahGCTDuFVPC2KJkA0GZb9RzM_6szNQqW3pAJDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGOenl0CiMRnZKhqGDYh0-fa2LazTpQ-m0_Fk_4m7xrQ&oe=6ABD26DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlG5-e9Dp3oQ7kNvwHILdrR&_nc_oc=Adr_pK_04Q4YuECWlwDNtKIgVHlvyi990H2wSHmqsdJQvRAO-SQqPWJnC4gWXYLyaZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCR1hLw-w9L7YWfUMJglVhWjsy3lP2hjQ_4nu-ow5hQw&oe=6ABD2AF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVkC7PcNgtEQ7kNvwFpSjr0&_nc_oc=Adpifi9ItLg8nNoZl2yuNZAh6WhDjDQYnEFedHANPxjNaO9hcVRRfAxkIlcA9rHXqEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkstUao1rxhBbelel_bzLGMdnyIkjwHNG_qKP9_PYHGA&oe=6ABD2FCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
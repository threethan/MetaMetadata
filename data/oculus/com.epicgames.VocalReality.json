": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlmFuQQQ9wwQ7kNvwHvz452&_nc_oc=AdojgdMq1p-_YfgjTcO3EetnZKncKQMEGybPY89TdweUb3HyITTyV148Uu31BORuAl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rKFkE6O46jwTBzS1HODPNrpL8ybSGMMqIGnMOq-d6Jg&oe=6A316A4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IELTFQ8TSMcQ7kNvwEymU9E&_nc_oc=AdpMJpWhFakq-RRInaD1ALzUgfvlDkhC5uKYWp0jV5_Egg1hxPiea_HieiweQlyXzsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F8eXQSyFeMak6oSUK4waCQvtGC_yqJi6NN6747wXv3A&oe=6A3171BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plqQNFL7boAQ7kNvwF52rfb&_nc_oc=AdpjKwgrr9AEBYOIVYvNbMrncBiXHjSeaJ7DJyYYc8oFt_nRWKz9OTnMiPhGlQ1XfgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aXIrGXcBXciVb4AE_cy5D-w8LKLFx5FXKwFAF49ySLg&oe=6A3151DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiLibeESiogQ7kNvwFNVRcA&_nc_oc=Adr2c8rM2OSpQmJusTXGdpy_l5I8vZOnSbcvl5_q2EB6v7BBGwOK4GhAuXsKGtOSpZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8acrRAH4Fp7lQyGrH9hnKkqTh5VL-Egz2f8uMf1lmwwQ&oe=6A3168CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eXAHKKGW8UQ7kNvwEmT0_K&_nc_oc=AdpvMpVcef-4lFKnnx3hk1SqEaDsRUYezX6I5ShPF3r9h12DXMZKC0YtS86zl1zm-dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OktUykGeX8xO6-jTDl3iZyIcK_P_qVFGpnibC0IBA8A&oe=6A3152B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq5aPQaGrooQ7kNvwFdPciX&_nc_oc=Adq-8d3WsiXn76Ns-__0CXcipS4S8ydMacdbm_iVo5qcAnFJlp1ruEs_FMUtd4F-Nvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x27lOsoymH4B7yf948tJGAdH_5npO9zrQB2DGBO4bHQ&oe=6A3167DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV1rYWHen80Q7kNvwHNdlXJ&_nc_oc=AdqHLsQQEGOQGyaQppM445ieM5MYBdHP9hJwEFNa3Epk7qnY-YAH6GCXKnOSlKjuDb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q2UquJy5ORoLcS8zmCD0TsoQvrvM3GHRuvUDBE-KtgA&oe=6A316BF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PswmeQOtr0AQ7kNvwEiGD7o&_nc_oc=Adq7d4x6kAEYsdiyYOuGZYwRE8SyIyQuba8kiESIqdN_pVT5Cyl4nhh6B6hHZ-_-qpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BferlaR05G6OAMdDXUdx3kgrIKprqio76yyLMnZTUDg&oe=6A3170CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
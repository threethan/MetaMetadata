": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56bmZg0KaMEQ7kNvwGcCiHn&_nc_oc=AdrM47n60UFryzEBKPcZZjGGT2vrMvO5M1uGCZ--qaUluol79mcOuQqSFi3mu3bXqjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx60sZfRvJC2Pv-l2hXUi-CFvPyxdEOr-1fk5NbygKxg&oe=6ABFCC4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dTimBdIEa4Q7kNvwERnFea&_nc_oc=AdqtOy_FXCh7yAoxqygT9lfIAADXE52RrP-rq72DFrw1sZdeRVNTjOcvXK2LhFqHJzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQtXA1w8gx3by2EECvVklLZDYaBnO9XMAPGZcx7JNeXQ&oe=6ABFD3BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jClrxxexyLkQ7kNvwEw1EDU&_nc_oc=Adql1N43qIPVXWHWGE7XxWjEResEg_b8pJpFv4JKfRyshaeqIDilvwmuFBymNyFLUWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBO4wIg2zWspmJTfENXG564AbvLjAVC0ew9U740DqLqw&oe=6ABFB3DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIf7V8cEW1MQ7kNvwFLGwjs&_nc_oc=AdqX3egprYlr9mX0akChf3tYtXN3worWQTCOv7Ik3kKU9yj0KT3IkDxd4sW-uppWg_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcO92Re44WFxGShne-zc8RcqFYZp3FZe6cD2O-Jp5rfA&oe=6ABFCACD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-czaRywYSAQ7kNvwFNBlDl&_nc_oc=AdpfouLzKHmd2uO3GcMtCPesi7JYft_PM1Zq5yqSUZReTGiYpCYPjhPaYUDHE5Es-V0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG0X1sQpaGOgLwxI1oniSMY1ZRmFxDLBaTDn1e27NiBA&oe=6ABFB4B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVInpt3ubx4Q7kNvwFrMOBG&_nc_oc=AdrqqBYmpxx6pdZ0iofoWfnnQgN2fdkbhDnOZv1NWC40DL7RpHh4yhWuYbG1NlDC4K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUHUq4AtOOSvZVOdNZQJdygfEWFbvujIa4pqKKZm9lHA&oe=6ABFC9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlG5-e9Dp3oQ7kNvwHDCl84&_nc_oc=AdrPYss57zLy1JC6xu5K2H8H6pxFESzYL-6blDk0qzw1p0OGg2w0EtTznmMvsIqDoiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPinJuEuNdS7SbaIo2a2ZoGydudgyzq2XvM9XN2fGgkxw&oe=6ABFCDF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uE5qTBF_YIQ7kNvwEkGaMa&_nc_oc=AdqR-GxbX7tS3ZTtuoWzb7WJp7ikZ-BDmQ9tz2RFQmb9jMMZdWxTS6HoczApPPyyZ04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3o0UIIDUyauWMWXhcIALutYv00GWq28VqO5u6HhfcPw&oe=6ABFD2CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
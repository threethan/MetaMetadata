": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN8rFaiczQ0Q7kNvwGrAZLI&_nc_oc=Adoo9z1Qxw7Qv_CtIsvDIhXCmHE978y9c2VIfSH9jhAHNC3bX0jTGmY7AAgxMp91Ou8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGa-w3_YvFHouful_zqCV4-kHNiJd-Yobc4MFPdwLIw&oe=6AF1E54F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJrQ_n9LYLsQ7kNvwGHP8U2&_nc_oc=AdoLqLcar4Aw4t01OtnIy3BMglh-RyCRgpUDQTVC5mXaPpQ-lnZXwMrWur8ACSkV0ok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd2RSsRDtCZ5D3GxCjNFFW8FO54wwcsMQ2icBXkLpbog&oe=6AF1ECBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMKkNlgItn8Q7kNvwHUIZze&_nc_oc=Adp4wCkf660pqeQ_YbXtWJDQZEEreU11RxCanOCOaADZS6USflCFvvqRM22jc3fNl7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5dTlWZxNdjefC3WHbR1SSaKbEcamfBseojtAsutfbkw&oe=6AF2051B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEqiUvTLFZwQ7kNvwF6CM6Z&_nc_oc=AdrhZXy986tK1NEVfOb7b1H4fB9BGCPpjXTVIweXxDM0BDUV3UhjmTC9RD0OqbBVYl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSROxBGQXO925uT_w6Wvn39AntahShHXXrD0VwLhB3kVQ&oe=6AF1E3CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0_roHWOrmIQ7kNvwGft7l1&_nc_oc=AdqhCl_stdQnt13h-RRz7oGBnwf5tEvdG6drNy-XOrQDs-9_dxZG_zlOCLJmQSgjrI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7LQfJtZ4qlsBu7-fBIsnt61ZyS91-xaxGkWvtFubYcg&oe=6AF205F6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2a2tohFGz8Q7kNvwFu2Nty&_nc_oc=AdqvHirECTviWBnQlGdIhMWFCkMlxhiRFJoap-olcHnT4OnjOrJaDfR59WEFtoTXszw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjmxmyF0nadmYsb6XupiBGW5a1wZ4FPs619RZUOhrjHg&oe=6AF1E2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGLMB1FoH6AQ7kNvwEumWsu&_nc_oc=AdpSTn6SHQOrqZ7lCI8Wk51XaQwSWRz9q1eY6wvr5ogkkfd5bP_r1aOM-8Ml7n-jHbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVqfsv0KZ5Nk4pqz-RkHi5LZJzgDceJ76euG5Voo4k-g&oe=6AF1E6F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGGq-X_tP24Q7kNvwFGRqro&_nc_oc=AdoE_SedBQ2khsetGdhVRUBswLvaMK7yt_OLAFctITG82JAuOoV7EEks10wzpHUJHXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7_OU5THQL18JOvBaQDeG4m_T9x5LmS4cVpniGO-G52Q&oe=6AF1EBCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
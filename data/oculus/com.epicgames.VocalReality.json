": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGyj95r4yBEQ7kNvwHAlhjE&_nc_oc=AdpTE0RYOWjAeVl09SNPnrbvukkoDATfcZ9o3TjNSoDUP8t5yA0GOx3jfOM1PN7DWwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjzM6Sw6Dw0tD2L40B6D6tSbJG-zfZ1p2YOx1G80O21w&oe=69D0F48F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6U_loYBu-IQ7kNvwEXU4OC&_nc_oc=Adpbg2SHR4GwJGJNquMouRXS7ITLx2Sula3cLofAHoE5gVDDjQq-eDKDgB0aLALJJtw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAjQmx0TGEJ_8TqHQw_Lb5Cd2T9wFTlS8saV0NqkN8uQ&oe=69D0FBFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVZ3xz_G0vkQ7kNvwEDLZzW&_nc_oc=Adp1G2Jutq73LDQck0MKxcF0eAWb559JQesuBkfbVXKBI6_mAs9Hj9_n5ro5lHAzJ14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdAvS54_VxISm998V9jND43_f3FT9ddpuui7hpkJR8Yw&oe=69D1145B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3YUmlpNys0Q7kNvwHNeuaN&_nc_oc=AdqOhrOrOm1fLZBLgq0evjmruh0XnZukhw-TaMNfkmH8_Y7JORhEp9rcwMENVfNIc4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4wvYrWSPCnJCtwbsCzQ8ni26R4G6LU8Ba1tfCcB7NMg&oe=69D0F30D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCOGlfEWMgQ7kNvwFklfX1&_nc_oc=Adogf19qZQHYNOTycddFVOvFXyUwQFWxJ2s4TRhZgPsXiOPPJs5N55aq4fGtLFF9vTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ5ho2aXr8NxmhI_rhQTpnhRFMx3gDRbHkhwhCI69xKQ&oe=69D11536"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-zTwBE9QUEQ7kNvwGBPy09&_nc_oc=Adq5YYJ11E5RqehPeKbVPjKhovj4J5ZmJ-9_SvdGI3nZDhBdCoM9EfflLs9BxOniOqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl58hsBE1GoTqj3ws38MC5ExAxc-9dEtvaFXcm1zbDXw&oe=69D0F21C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHKnhyXSalkQ7kNvwG_CXPD&_nc_oc=AdoOSNHXXn7BcFXzmjWXhGFEry_8fYx4CUVOBoOI7UiyVTVIFB5Q7TNzQBSVOIEfQyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykwQS68R1PjeMfi7UZS1hdVK61ZHSUWPJGfck-d9r4aA&oe=69D0F632"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9_hjeiOxJwQ7kNvwHur3cD&_nc_oc=Adp7_7aqEakneckBOtZDSAM22IAp6Im3wr03lrqIEnJGoo-KcY-aCsV2_BaALxAnzus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0WrJ33gjxOvE2tkP0wrfkXZgYEo2LR39uIly6uNS0Gw&oe=69D0FB0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGXQzecncDQQ7kNvwGMexRU&_nc_oc=AdpFyzu_WKjVMeR0Zp8Ulp0WvbqR8XaO1xnrl7_cu5hJ0jZSFLy3YGHwtV-7U-guc48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuVrbLFRql-FrcCPrkzzXKUZtMbNt9C1YwXxEMgejeLw&oe=6AB29D4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-JLwYbaJl8Q7kNvwG75Z7n&_nc_oc=AdrZ3Hi6dF-mAGsRo0H-6W381qlXv9Nu7hu_FyMk_aA0997OI-sYlqwaJPiX8Le_smc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKSqXqNycBoFqt0E3jqO5Z666Bd5sM6CezwQ9Yl8TuXw&oe=6AB2A4BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtJOdbsBihYQ7kNvwFUsG5r&_nc_oc=AdqBFu4k-pbF9iSKkEpZJLkyguUblowhfmA1R73pRUN08gvfiYVFPiVYnFkjrInfPDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIi985X0Tq15SzRkhra8_Oh2WSvpSs6-MzDd2v1PH1MA&oe=6AB284DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwEVv7DiXgUQ7kNvwFF-JIe&_nc_oc=AdqyGzAGS6RgncgRcBOdOTvyOxagjDD_HT6WvzBKq4Cgcqc9jdybrKNmiTf-Se9ba0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtDVjXb1GMfEEsNLLQ5J79tmvW1j76xF32Twlgw88whw&oe=6AB29BCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoMpR75VZa0Q7kNvwGXD7qJ&_nc_oc=Adrzdv8of37FrbDko63sKyn3KIWY4rTbEk0naZ3ZzGfu23Ft7QwW6WFrGuMq3ikvs5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMIu88q2wwxrP2bte8jqHlzfLIbNyoG77BQcbPDTClhg&oe=6AB285B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9znitY9lzUQ7kNvwHqevRR&_nc_oc=AdromJ1z67s9NRptcLt-ZysEb2gXrbSrknw_ymHTfoKs9152VptfOVEa3YGhAB6yrRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhTfMy6GhHf5OJZ7WygCmHKntgHI7-iJdN2B6VjKYRbw&oe=6AB29ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UKjFvFRGfEQ7kNvwGDS3gj&_nc_oc=Ado_okw8CofRNM_7yaM70zGIyRTX9HWzvPms7n72zMMd93Ytq03fPvR7PrZl7r6Ic5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ53h8ZN1iPgMAyuT_HIwIWviKrp6m90iv-U-neqYSPMw&oe=6AB29EF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1wux6GkBpkQ7kNvwEXVBPS&_nc_oc=AdpC0GSCP-qce-V4aavIVENu3uMxzT7cOHUuE5mikbTtFUuoX9LBfq3JY7LXmdCNloo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNIV4v5v55rwtNBL89Y2Ok8FsCA8vwq8hXXoT7s5qDrw&oe=6AB2A3CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPANMbUOX3YQ7kNvwHDrf7D&_nc_oc=AdqbR-OzurcuhVeJFWiUdiVcGliuTKIYxUh0vFVp0PcSEfVZ_8s3WH6Uy4nTx2-c5so&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1AWorBlBnY1ANKiQcp_w14UdNvIM5SNoOY_RY7q3yQw&oe=6A97260F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmouvB0v0EEQ7kNvwFTA3Ie&_nc_oc=AdpbD2l7BbN7MHlQd5f-vl6xf0rti_UqRCbx0F7b2mC5peGMdFgT5SismxyWPIkHHJQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_84YNRaWTWmdzAMbLROZEhFbctZHq4dCeLRBxgSradw&oe=6A972D7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hj2Ec9jNTMQ7kNvwHI0vhw&_nc_oc=AdoGsqtFjep_t4LeA1jr-T054Z8vONF5CUt52tfx79abyK9pWiJqQv3j8Gpl3CnCYC8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHRY4sG99AswBouhB6oLWqOgmkH8GUj7NIoYXsGh-VcQ&oe=6A9745DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21VMcCfyYCkQ7kNvwFVL45O&_nc_oc=AdrtW6X6uzsUZzJDY9_ReJPeZCRBEixa_LsQZFLuR0qfRvJ0ZVitFkjNmIjjQL9CubQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWixOu42TfiHrP3WMV5ieNbxqYRM3oLJapFmWvPRg0qQ&oe=6A97248D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50za1bdWnV8Q7kNvwHVuPIX&_nc_oc=AdpAyU9Vs6BNdUYmpzW2h4eSBvegPosJ3_h-erwS8EnzgRv0M6FqYL6NTMmCafcwPtU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERmmQkBNjdbgb9Lb2-X6BZi_FiOCTMWokG3QdaJyiKBQ&oe=6A9746B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef_n1erZL-gQ7kNvwFX-JAw&_nc_oc=AdrAk1Dg2wtEQE9M087QRSZvAADX8vnlUKTG44E12fU1QK78QnUsRMmlTxTWE7xkYEo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGddvLoPL_dfUZIMAyEMXT5snIECc73P2isCHU-RfRsbQ&oe=6A97239C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itXk9TKMfaoQ7kNvwH5JhZl&_nc_oc=AdoKc7XqMq2CzWbA8zv7JQEiTw2YK20e7pSCqgOBLgdduroZ6YFusE1_zkdPhCp7bJ4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDVee32H425a6M6UdAqW7wx6wD-bjUvS-k1gna8V5udQ&oe=6A9727B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwDL7E8yXs8Q7kNvwEppNDo&_nc_oc=Adqtjce2Dhaaf12-YCTpnaCo-uZycKW_3uTbxJG2WmhBSWnFqLDTRL1_fgGQgF9X8ps&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoF1QCHF09kmQs49bUSeDol9VYFPd9y25ZCuzAM5am1Q&oe=6A972C8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v-lCRDS2DMQ7kNvwFTdbDB&_nc_oc=Adps2pKQuVN4nhIMj0pPLWuH0bg7jOXsky8DUU2nQH45Jopgfqub_FTdpyFUwIFAbVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EqMtKLcSPh4c-XLBzenIkdDJd0x5xPpJEXoOUpqeclA&oe=69EA394F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YSHkaeQJpUQ7kNvwGKYJWn&_nc_oc=AdrbHgww1azvCYwCSxYzHrIdJVi2QsaWSUi4SzI-FtqWPTjd6BoKF6IzlO0WEYJd_UE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cKwOMWfCjdlt-4_dxJS1yIq6n0nIOWpWvv1oJxw5p4w&oe=69EA087B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aznm8-uGpCgQ7kNvwFBtdLV&_nc_oc=AdpHVamFbmt2cgsow-ch1ZW5u16eeCuaNRICftZ8aDhZCjEltZcB4Y6UYeJtGp7AYuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i54vEa5XHG8biij28CF1mfThDStXmW2yrabzjdcqptQ&oe=69EA20DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKWPnsRi2ogQ7kNvwEIDhBZ&_nc_oc=AdoddddUv6hJjt_cxj3lp7k83b1JUlT05oV_RCFp6u7449xbP7F6r2oMB9gpGVJbA6k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BpLuDQdgEQwqG6OJAq-P65veCUuX8bof5PhbhQ1OguQ&oe=69EA37CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdAg5v2yutgQ7kNvwHt3TO3&_nc_oc=AdoWzV4o6iQq5TCFkMiod1vzS03XRCpS-a5c8v9ubab0zxIslpyywsoJudQdiqdpm7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sZvsgSqt3KUqx5Op_HUPQg0WXLuyXYjWmfFcTv1HY-w&oe=69EA21B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKKQ1NK3SUUQ7kNvwH6KSTk&_nc_oc=AdrskQgTAOU2uS-KAU3LZaBur3HbqxEfzQbmDNYhGCCT6PvRtK_SF8xMhfglWpKbB1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C0SJgBUjiMgT_Cg5KAErwkjaWY5CX0YdYAZDN3Emy3g&oe=69EA36DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk3aqbIWSWUQ7kNvwH5D0r8&_nc_oc=AdrYrWWY7RPHgYMUWctPuXpU3CsIbY64Hs4aH70wTMQ7GUMs1IhZNX0DQhiqW2jadcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L-YOsxd7UI8n_sr7gAFpbHT_C-_BEGvZtMaMFvWCokA&oe=69EA3AF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxIvF1J2CpoQ7kNvwH0kEXH&_nc_oc=Adq-MTSkuf1-icd604Bu4br3xcKgq49MO332RiUJw7lJ3BL9Grk_4m3rV4wMnMpPXsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ohNexnQc3oTqdRy6oOz9vRfgg9XvncLud11rP-kKx4g&oe=69EA078F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
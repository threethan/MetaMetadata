": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N4U63ld8HoQ7kNvwHfxGVl&_nc_oc=AdoRHqT_QSNrqFfbZiTQwAz1rKKSYSsTo8_YcvMJiUTeWXa81eyrQlGfVXE-mfFG_tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfPQzvn12fN-4R-bTHS2vhptphEXSfYIVxrYMTEfnvvw&oe=6AD2414F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgy83UseTDcQ7kNvwG-YUoy&_nc_oc=Adr76W37sPknSYRTCk91oOxGetd2X0mUDLrnai0DmTkbGbU6QhUVVeOMcgYUswXvFnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEVqnPWRMhlD5nY8BlSN9ahlTv6XuI6k9dpi4IkJOqPA&oe=6AD248BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V39JktckqNYQ7kNvwH9hc7T&_nc_oc=Adqpu_s-argQ0AMwPUPe2SXaAsjNLK21dSOjUha0N6qidDEu2Q8_v-t70bJeafcQ5S8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO22MZrU7k2R8aSuiWKMkuknRAFK9FzYC31KC-FM01yKw&oe=6AD228DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7sexowNbBQQ7kNvwHr3VZB&_nc_oc=AdrWR_wO7WvBiTMZEjX45JqU5TncXeExNMHCioJa9MuckDz65O4BgHfFFfEzNMQYEH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkPPbJv0p_gvtrq_tl2fz8UQteh_bkCDBBX6-2Wu1BdA&oe=6AD23FCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96LB8GwLamgQ7kNvwG40dYz&_nc_oc=AdrswJUepyI-9HMVAsP9parXDyjcPl8ElxhCyF5JjuWt7XdbYv5bNHq3dRJYVemlfPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQyNKIljsAAK7PMYFT2Gw3g9L_V17sSsY55NSrMGos7g&oe=6AD229B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-XqobiNksQQ7kNvwFx0Lia&_nc_oc=Adoa3H8XgMNE0x8s64gsQly8koo4dInGFUbqycweEFEMuhLyxO1dtfhOMCQUi2QuK1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1mhmMagK2nFR-mQpIIw5s54ZdvxhIrtgoDbXRFcCDiA&oe=6AD23EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah6QILNhE3QQ7kNvwH2ddwo&_nc_oc=Ado7iZ02TlkyMWyDWs3f_TVqiuhTGf5NuczkuvomYz5J7_ljTAhCcCbZmi4y03eOuA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs_b2CM8514UOKmw-SJvSmWSFRCF9ECaG-G4Q6CCeNAw&oe=6AD242F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMs5Q0pzHqAQ7kNvwGzLQqR&_nc_oc=Adoe6fISx6FiuAGSJ3ulM_iPou9V0AbrM9vVPo4NvYSnMLgfU8qvoyitdhgkPUhn36o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSJXzKA6KIs8xTffkLhdu9zHGVX5t5LCtMTQ_tC3G7qQ&oe=6AD247CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yjvxls52QMQ7kNvwHuxyjq&_nc_oc=AdqJFsi22r5fx5H7Uau8dTbUqVj-3HLigxrCDRsi6NIQLLYcBuBHMLeEnjQwcd3XQTQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GqaAp2QYAek1dkWnrnB-a7DWkn1ODPQIdaBhWvMeVYQ&oe=6A09DD4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfm6oO9p560Q7kNvwH1l5rN&_nc_oc=AdrN6bSNN0_4lcF9gJf-6iJTzgk30fHB7dHb55ZBHBCP7RvkQftOf23hc58TsfLMopo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r71_vQyNIqIJw8QhyDZBn9STM8bhrhNlUNnLa2VZd1w&oe=6A09E4BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsfKqlHWdD0Q7kNvwHYBjfV&_nc_oc=AdpPlgPwpBg-6zgQAf-53D1J00DkaCd2NPTSseWk_EWba6efoc9K1BlyCCU1E0ENTIE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5inB9UMs0hAzFTJ-GpnuPmhIgY4tHQlBhB3sEBr5Y-IQ&oe=6A09C4DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odpPPaOI_4YQ7kNvwE53vcA&_nc_oc=Adp7VxBaxx1rdjdYJZMyReG3taxE3l8ObafAIKOdNOp3c9c8-7BwRnXgh12M1wVfS94&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P16UbBpJC0OJoNXyG8B-8hRdx44ZtZQPdGzPDtjcd6A&oe=6A09DBCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6sz_0arP70Q7kNvwEAsbej&_nc_oc=AdoviO0dv5XMho8oivOrsaIDcaWjG_I7jsW_59fA_2j7rcLEI1h55I3403Ic1ewmKEU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GRziRI8SQbnlJ0SU8GOAELMfz7-LMgD4ViHkqB9cphg&oe=6A09C5B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_PPwazP4IQ7kNvwH9tIOD&_nc_oc=AdqkZuRlrPkFfCMKdENGeajy69Qegd44J77VWNW4JKRpwcRZzvEHPuqix8A-miK8cMg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i7y3MsY3nJWGrILIRm9dDIab6p8jOf14XS8wUcCw5_Q&oe=6A09DADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSmA-tRoh6gQ7kNvwG93zgz&_nc_oc=AdqKAWOwMGAAaZvzJjmQ_KhmqiqErMU12ZWVroMpZobuZvB5gIL6VnrHoS3mq9XKwjc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TfOSQimXNJxX7lfiPgltBUiF9IabVlPSvlxHUbgq6Vw&oe=6A09DEF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bnuv5zp8BZYQ7kNvwFU6pd6&_nc_oc=Adp6FMMQ2EgV3PL9Ux73ARG--qLzuMIY5NNp4kkp5b9AaVxKwABYv-f_rWJ6oPObLjA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PiPHYL9NylzoyeM7OOa6_CWXNBtc9UMhARxzZRWRaNA&oe=6A09E3CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
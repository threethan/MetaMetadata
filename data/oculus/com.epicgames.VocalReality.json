": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v-lCRDS2DMQ7kNvwE5qnvN&_nc_oc=AdpeWkhB-oX3w79JvVwKlsQHFl9Fkfr7eru9iurUnmY7hBsAJOWX8THwwaLLhewMfKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hN82PLstdndv4mpL2Aa86kGsAGshws8eAnsBbGxp0pg&oe=69E8AF8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxoaxUBYL28Q7kNvwGno9KY&_nc_oc=AdoEh1Mk7z_CcAulef_Bx7Qza27_vke8mIlxBjJI6CxuyUDrrWjDJB83VW67LfXXQsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19B7zUnUfVHpT8ndmm9-TTtn7-1iQ5GmGU1Os-JBBLxA&oe=69E8B6FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aznm8-uGpCgQ7kNvwFjydAc&_nc_oc=AdpWGdYu9bMZRd-LCkuuX2ffUWmUW_dkJx4gelkIddpaR86FJNKm4saS-kJiW7h6Jmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KqmT7hYLguNM5ggyqGrsJO7FfJuoOYcHqvG0cAuy9eA&oe=69E8CF5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkOeXK8sKmMQ7kNvwH4sYUX&_nc_oc=Adr9Wpl5UeffKRIO3YA40gaUvcuBGBcEI6v1Q1PRBRvhqJt3E3pF0k_R5S5lh_9acvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0exoaLKdKrtqCzrguzHN6brrroDgGxaoYjbDs9sszxEQ&oe=69E8AE0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdAg5v2yutgQ7kNvwG0uGZS&_nc_oc=Adq5QC9wPsQdKZ6rYeao3ZU6soF7wh9Gwlpfp0FxwREU861Ss2zR_THxaPvsFTywcSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HF__jWPaSw3uHz1TX_Rs8-UDUX8WUoDGNXOfT32yJwg&oe=69E8D036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB8IV9BqRzQQ7kNvwENsgJ0&_nc_oc=AdqdKbaGGTp67UQhPYDlMaQpSwT38YMjZzp8_onuvhqWt6PB9mRJOmRWrQr94R9wmlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S81OvyfXlYdyd-9Zn7TnSmrojTXWNxgm_6Wmx-onJeA&oe=69E8AD1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk3aqbIWSWUQ7kNvwFw-VPc&_nc_oc=Adrnoex0NCXNYCLA1AR89sCpgPZg6jgGL0ngn7qHWUYWm_3GrtYEI9ckOJcPI2V9Xl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RqiG0KUkoskiwx5Lmj_HkCuwPvirwa2SRy_jspvzN2Q&oe=69E8B132"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxIvF1J2CpoQ7kNvwHTbfh6&_nc_oc=AdqSS_94QuVrziejn1o59P91ailMB2wY3gfP7RD-7vw-0864TGwLIVxBw-up6Z11cBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q0v3LMVUuW0_EyaX_-Oa91P1lYQPTGTBvXdZ5eTfnGw&oe=69E8B60F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbhwSBGikSwQ7kNvwGLU3-c&_nc_oc=AdrCqgIniKH-2ZgapsjMTq7SWkwrsf3Q6_SYl1rKA8--dDRXK6zZuD3AW-tg4QrJzDo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tsBeFLQJuHLz-v9rdoFdfQKV8eflFiveV6-6tKYp_6Q&oe=6A1B00CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrJWPsgjjWQQ7kNvwEgzUiL&_nc_oc=Adq-wmdrcWo-Ag7VOZlbdabvLMjSW9qp9CrslpkOnRcR4-TETqRNKggfLmUOpi0QO_c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G-BAxbO6UoWNEc9GoeyANzl4IKeMvwSS-M8XLcO5-7g&oe=6A1B083B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GUUFuzAV6gQ7kNvwGEiZZJ&_nc_oc=Adr5_K8SwTP_DT4Muam-nOrxuc_RRb-_s7iykSz_nUsX9HBroFQzNR5b6TzYspa9yLg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uh4dEMuCYFarwU4y-eL-ebxI5dCvkCi0ZfsFHBkkL2w&oe=6A1AE85B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZdN31BoiQQ7kNvwE5GQgS&_nc_oc=AdpnQ86G0BUchqcXqdYF2-Gz_FLKNaVek_u1dkc2CXc9Aov49IJqT6ELE2IX_g2QlqE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B_T580rhG2_WhEs40pAodDtI6_AqH4LBFfeo8iUFZNw&oe=6A1AFF4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X2qF5a3KOUQ7kNvwG_s9h6&_nc_oc=AdooIA_aBqtJIk6yvBUJ7M4Zgxr17SEttgr29OnZaoAuk4Ff3bD39H8yJib3uZ8HJSU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49lGbzK6b0Te8eIooJ-GH97UltsdjH6amPdLphAfK7ug&oe=6A1AE936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=449zR5aRZQIQ7kNvwFsoIrM&_nc_oc=AdrIumpQmqtJuMW1f705Z8gQgGRKJDjR2vbQpdJIig_xdraG04yJF04u6imPaNWbwsM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YcfosbnxQWlXcNdTrOCWCcIPYIYT1bCyXhJx62Qm31w&oe=6A1AFE5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sryh1wny_wIQ7kNvwHKTF29&_nc_oc=AdqxCZHFlTLNhqNz75uJRr3k8EeysFdaglptD-6YhVgMcwOxDWGKwF9jcZFHmkbVZgU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iWWsZgPdyGb_3xViOd02_OXbI7yLOeed2PUQaufLUiQ&oe=6A1B0272"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw1LVZeaKgMQ7kNvwGSKn36&_nc_oc=Adp3Tyea_T3cWK11q35LvvTy4H6w0EpUjOkC11JOcCNemkpk78BzDH-DPj7sCyvlzCw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5irl63wi4HyqlCFezPBSFdkQli8msnd_4lzAbvk7473g&oe=6A1B074F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
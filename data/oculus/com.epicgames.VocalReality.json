": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q-yM3mWhs4Q7kNvwHCtL6C&_nc_oc=Adpc-zfjnAYO0P5ADgQvYxIz9Wq33JNqwoMFtTHmqqvBTYjmSAteCMYTlbVeJzkCo40&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvYG32vJB98Sg_hqPHjke8XGodveIrEBIlfUONpAzRtw&oe=6A5A48CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_VONTFDHIQ7kNvwFKuqS2&_nc_oc=AdoAQb4c7CancjWqJkv7ierEdlxs6Up56MmeRZ-yEOADY00Ldd9iBz6DfQImfx1P49E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG3DU8TtZwVox9DEWa1GLdKo3FzDi-vo68sGhfI_0BlQ&oe=6A5A17FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYhgvB5TcEQ7kNvwGyrDHB&_nc_oc=AdpfRhbK9oUkiE_bU_VOrizC_AsaV8lRjB_hjJErYqHh4u8kCCh1eL4sE6Fn4HoKMoI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdXvX_fU-e9lH3YbrTiymoX4nQ_62mE7CLdM8GqDw2eA&oe=6A5A305B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBiW_czCo7IQ7kNvwGNexwA&_nc_oc=Adp7lPEeVSZa0RiyrxNYrEX5yFTbv3IQ4PH_OHvOPm-Yx1-XuSAmvF_KOtuBYYJbSus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJku2JboNK9mQGGUOYGCt55PO_ypB7qGpb7mmV6lXTpg&oe=6A5A474D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zpX0w8IULMQ7kNvwHBzJFj&_nc_oc=Adp4mG2g645kuiqb5rDZ_LoE8sVa1ntthACW2oGy3wNK-fLXCvKyDojA8mcpC025vvI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqoOLbAfLdyMelxKUMaOFlH2tss4dvossTLEoz1UD4Gg&oe=6A5A3136"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZMv5p5pYcoQ7kNvwHOuUiA&_nc_oc=AdoZQ60qwMjUmjZJrdWA12Xb72iqkNr9KXFHAD7a-GJy-pBtvcEG9jZVc1eExbkwXvM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnF9U9UBOy_pl8u8ZKHgYKo0YkGXOGR80xj9-Ao8K4Rw&oe=6A5A465C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ERRGmROVgQ7kNvwEXY0F3&_nc_oc=Adrpjuw6ICnAdz4vzmEroQQcbNrxVbrXnqIBPLoDMnzte-1sdYiNkQcWJqJy_MN93eM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7iUq_0ZgxzGjUU07Pj7QqYvciZ-pW0GYm1IKCuXa_pQ&oe=6A5A1232"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4pqPH1mGFoQ7kNvwGerTFz&_nc_oc=Ado8nrr6RnNqcUaae-mZhWqbDGsUVidQH7ois0JTA9GlHulLKy_EBZm02sE6lsxx01Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd6-QKRRvSftwP82MuDV3s9xQueYQtZzTvXmy9Mq5KNA&oe=6A5A170F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
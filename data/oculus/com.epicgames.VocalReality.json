": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N4U63ld8HoQ7kNvwFWgO5v&_nc_oc=Adpfxd8uw8jnNN4HoKMK9pNvZjMZhY1aEn7X189_t2izhrkMbnQd9Gy6RtotJ5-If6Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPg4zVmeB4ZIKKKBQD4iHnbfYKGrWy70pvrt1dWA117w&oe=6AD392CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NHMrP8vTpoQ7kNvwFnaTDq&_nc_oc=AdqEZWCmgb4Jl-qAAo8ekEGE_-eJMIPjaKxuS0niQ6EaLzSm1kYINrN9ykPebjstiPA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1N0Y5qXitlB6EtC8nqbv8GWg0VUhWlwFCjJB8O3PE5A&oe=6AD39A3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V39JktckqNYQ7kNvwEKMTqG&_nc_oc=Adq6J8XAgTa1EbFw6KSzdobo6a1tMggOJx-7HyhS8ez9-piJv_-p0I1VJR9s1SiS2LU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAjh3cqWu2Iamxsu1Q4rNKulAUMt2T9Bdmy0sMEtCqrw&oe=6AD3B29B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7sexowNbBQQ7kNvwFna4CX&_nc_oc=AdrwjHOdVFsPlSSc9rZGySkLOqTci4C6dCQ5ederaknRacZcgsf78Lgq8_aP148fDmw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtPqG6frGY8UPTcnMtBZ0wSnXGHoskQYv2bhAnRizfdg&oe=6AD3914D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96LB8GwLamgQ7kNvwExr_i0&_nc_oc=AdpqtDyjMT-6jgqFLFsQ5PvOxbofxo4vTcLTgdqKxXxuL3bzPmJvCtli4apCgLcW054&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHxIMrSEvKsMuBXJU88yrze_kjnkfVzNBOQkN_esKqXQ&oe=6AD3B376"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDiays3XMZUQ7kNvwHomB-O&_nc_oc=AdoE3DcRo80k6Hhh81s58lywQo3dO5ILCj_bI28NKEfyT488fjnKVEEPgqgerWh--Mw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM486_3VHVMwkQbQtS3Ryeq33T51wX89kUzz7WoACwDZQ&oe=6AD3905C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4_yDEbxVzIQ7kNvwEgINa6&_nc_oc=AdqhL0-T7_Yfb6QX6CWa89Ng03ppqx6j_q55BiIQ1I3U_XNLpqyfXJXCDHGe6Mc_tcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMksKwYpion0AFm3fWeg6G9pUfnzQUvOkBaS7wDP1kZRw&oe=6AD39472"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMs5Q0pzHqAQ7kNvwFn1XpA&_nc_oc=AdrcVeG-vqd2l7nLYGfYa4EO4wLUVB81HAbbKJfG0NL3LRCunjZb2Voq7Fun9t1QMxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOreYr9Vk7_wgXSs4Y3aXSbw9QfGbBiomWjQDxWoBnZTw&oe=6AD3994F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
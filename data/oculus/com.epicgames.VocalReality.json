": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPUEyyuEvZIQ7kNvwE9k2KQ&_nc_oc=Adq_EY6ieOxWXnZy8e52prW4fZr398nFmCti9mkdUZ_LoegovpSVoIw5PeG8zjWdOKQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qPOXec6Kiv3N5PYlGO5ga-xfzs8dAQJXCiDkiglzZVA&oe=6A1C524F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrJWPsgjjWQQ7kNvwFsuJ9H&_nc_oc=AdrNU-hV2JZhzg59o-kNMEVAItyXCobJce-laUWtzD0WS5Q_mO10c1_X9x02GEQfB4U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZH0GYCdASBIx9ifSK0QRV7Xztr-5V8EwCFpYp3TyjYQ&oe=6A1C59BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GUUFuzAV6gQ7kNvwGEnFBc&_nc_oc=AdqjzPlz5h7NDQrYn_3-wNjKhW69dyEcgnHmL1BhQMi_44uk8GM4KpxEsT5cbR5gH7c&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5amnl9pfhHqz-HOWXXhnkEFJw_In8wQwO-NM6O2wKIsw&oe=6A1C39DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZdN31BoiQQ7kNvwFBgBeb&_nc_oc=AdpSFN-j7pQywReIQ8-CVKd_DFYpXUPqhwHXJ6SAHh1BWuJpPyhNo6kkBskSobD9l4M&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sqkSbUD9Wsg6Bbh0hVh2wXZ7ySb5yQNgEEpaaqfuBYQ&oe=6A1C50CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiT7MveLN-cQ7kNvwE_WSXl&_nc_oc=AdrJuL8rxx7-TEHj_ByFlaLHw5UsawDP3hX4Qwm1Q6ZaXGZAmNGbg_5Z0S4I9b3ywGI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P-HRXvuDLbni3mvPjGkIpGFp6SuVn1tYKCV9Tz0-oBA&oe=6A1C3AB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=449zR5aRZQIQ7kNvwGC00vd&_nc_oc=AdpzmJ2Kd5V9JUlDuWrHFRbcuFtTLVedJKKxbeMm23cnWXNuTbPx6yRsciaMBSGe17k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69D6CzaJ_QfuavrnHMHgYav58yhjPeHGpKi-4xYNYV3Q&oe=6A1C4FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sryh1wny_wIQ7kNvwGVoVNe&_nc_oc=AdrqSsEuNsxIYkGqM0uC7yxnOK7pEzpAD5NxbB5dwouENU54nQuxFklufIJjeaUumcM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65faJv8MTUIndn9ZgiFaSB-_SXERYmACNq0UVZKfz60g&oe=6A1C53F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3RffeZvtYMQ7kNvwG6ytly&_nc_oc=AdrFM9m8rQxfZKKbnTtl8eM1U7jUN9yIUoEs8LiDsOtABUtuLJZ_zZdoTmaRP4vZb9M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cHIS8OZzLmEh3pZCiVzLZWk8jPkBDH1uWuF_39Vs_HQ&oe=6A1C58CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
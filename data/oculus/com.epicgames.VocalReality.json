": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSD900sRGL0Q7kNvwEabIrA&_nc_oc=AdpR66cI2Jb2AaMNkWlkpghTj4ywFhzSUTJZ8QYxmTxTJPWmNmqvXpRjK4Cn1ewLMXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uPoKWc9akRmvGyBRLJ8yTLzuG3hEG5D9vRSXRb7czMg&oe=6A14694F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SlArMMuGeMQ7kNvwEpTWrl&_nc_oc=Adrn4xpLx4ADgyH0Sn_wDQxO3HD3VKLt-ORf_6X8kjLRp02DRoZ3uNdTduIssINZ-AA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VH9VIxD7tGd97DPu0s39Orf0yUxaG30FDlWxsoshCzw&oe=6A1470BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXDT418S8xMQ7kNvwEBEnK-&_nc_oc=AdoFdgd55f0VySBAK25yh8SJPZWe13UafEUK_pvGu3CO7VJPKAhWH0uAaGkGXwggfaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66GYBj0DVdssKB4caXhtOE9H15W_R_1HcCuFGUK2_aOg&oe=6A1450DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2G1b726YZsQ7kNvwGPlxhA&_nc_oc=AdpLUFLfEBnjYHPx7IjGyxFucqL9l_UEFlUBhA_rPGMF7cJ5UTddd5fLIPP_ysu53bQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sy9jnnK6zvUkBFhPDIYnfxyQJA4WoA_RFV7T3q8EWoA&oe=6A1467CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKjGqBkgijMQ7kNvwH3J5LC&_nc_oc=AdopvfqzcEaHno2LQ3siCOxpESu__dytrFf9u2jJLvsvDHuIqaRZd09jHZHvBT6FLA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50LIGJYBwi1a6MUmgkB_K2_zOmXNa_1gRtjLm0CszK9A&oe=6A1451B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-jzM-gll6cQ7kNvwHvH_vI&_nc_oc=Adqhrfz-VeXwQq2AE37jB2033j8ReR7zXqubFew7cD0HCiklY0ilNatWD3frJXy2v9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cj2BUvG93Tr84XH15Oh87UpRfumFmWj5Cvxbap6i-kQ&oe=6A1466DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYwj7DSmuT0Q7kNvwGcKUpO&_nc_oc=AdoJMQbwtv-XckXpelYdfGxicZQ1l7uSy4cTrgP89NEHQw7VNvffC4W0QqXl2IZwWpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72-3Fqx7k1DKDIhFR5VBbiIoszMpeRc3XQW9CM9Vpuig&oe=6A146AF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDlDJHtocZMQ7kNvwGFhDuN&_nc_oc=AdrbyjSRRYAvisxQ4910abworhOsUUTb_sXWW0kj5uZDpDg7V-nUEFe_ZNmqjgaybWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FM__tSpbuUmksR1aBwl0HGWSPJD6B0a-Y-Ox9cfTQ7A&oe=6A146FCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
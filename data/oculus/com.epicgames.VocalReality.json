": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pmsPd2ojrAQ7kNvwHqwvMe&_nc_oc=AdphHka-hTPbhJWGh2RXNeR75mbOLwNcTbdYMSoppFCk47Ly2YuTxLFJtVBf4p2ZnXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb4cuI0q53jZGSJ6XBGsE339u_XG4FtftyJZ5EdeuqMA&oe=6A6DD70F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbzbiALKiwwQ7kNvwFAIdQ7&_nc_oc=Adon9gwiEzeq-h3L_4OAdy53ApEfoB8ItodW7Bkcd-ymyWA03L4X-yzBvzP5YFpm2qs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAJRyWB57kMsZwd7_jI7dYBVY6sV9D38So_3K8rFZSbQ&oe=6A6DDE7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWM9IUBW2nMQ7kNvwGuTZlu&_nc_oc=AdrRg_hLAI0GV34UARO5Kgic-WLtuwGqsN5MXKpbFugI19NLvIH-8Gi6-yFftsk8qaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKn_GAGlCKPEJ-zt5wPb4CNEHJlqHSa2TC7ZAbK8Oq0A&oe=6A6DF6DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCSuhkisCsgQ7kNvwHZv09f&_nc_oc=AdrL_h-rRV_vXtWU4EJpo1pPSrP54zsyKl93ruYbX2_WkF8rMVW7sZFAnQmIk8pcNsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEgFp9VVs1BA6IOjsb-MHVRrNCBKB4ozA_LjcsBlWICQ&oe=6A6DD58D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iENKoeVE33UQ7kNvwFQxUm1&_nc_oc=Adp81IjpaGNtI1FSBR27K7di_pnJpNAF47328QB56x44ctE6GzwrBEZFPX15qD7ckSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBabXfDSnudf2cg7Pdo8_az7Tz1sEdVDhIutiII4UbRWQ&oe=6A6DF7B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Jz8colhycQ7kNvwHgosmv&_nc_oc=Ado8rJQll-K_Hc-Dlr4kIZdNZvFagRQfu68Q_f67ZjrSUldfP0eA7CUcF8wn6qU4kZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCErYibDnjf1rmYYWtSm_V7--TYXxoGPiRC6pH5DuXW2Q&oe=6A6DD49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aJaGnffN_wQ7kNvwEeuna3&_nc_oc=AdrrIdEjolwWCXHN9-HUOzRgs0fzd3t8Gyzx0WjesogYTfx_NFdIyTp_0UBP-kfvpi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaxrrbJ8CNVQSfVTOI4wOjAOXfogioQk6AsOmg_5Wqig&oe=6A6DD8B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsqDyqFFBssQ7kNvwGEnwcR&_nc_oc=AdonN4hbr_JSOFnJwh_F51_c2L78V3Q7TUO1_fFbaqBoos_S540DdCEiF-p8wdpCEZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnDr5n5ijyXa3xDb5s4Ib_whLCsm62pNJCAHNQ49t7Zg&oe=6A6DDD8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
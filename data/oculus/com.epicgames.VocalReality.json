": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yte2tXPHBJ4Q7kNvwGBNyrd&_nc_oc=AdqaxqQ-Edf8JC2joAJ7O8iZ6tBEK43ReUe5rlzNgmlfCHhaUCNh209xAghn5Hu89m0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d2Xz71xRLddLHhqqcD_nnOWio2PjgIXKv5gfxI3Mqrw&oe=69D4E90F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YICpKK_WVIAQ7kNvwG7V_pQ&_nc_oc=AdrC7PRXTA_0FywiNW9rTAQ_j72YcYiSJIPFaPZbw2Yl6UXIv8-925ajkJuwmw_I05Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09VnBCNGnW6R5rwHqqipFRHG0pkw4zsihrv9PVJTvO6Q&oe=69D4F07B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fGkczbhsm4Q7kNvwHk3C4i&_nc_oc=AdqQzr-knrBpJmxDuZnFxoWy96hoh9LsBLJMUTt-IUEo309Yr8tG5baQKIc4tvDedOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mls2f5JJ-5_UWNaXkvfqCKDQbEwBFpbchk230aJHy3A&oe=69D508DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEMFY1LRS2gQ7kNvwH2YQnM&_nc_oc=AdpujV7d0YzpHCdfBxdUFrpUNBGxGqPoX0LLhHfhGpvbNOJ1CnBcSuQoF40ZCFBCIRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12750AvLb_LE_TwmXCY8gsbQU532R0V-l_xWiG-myY6A&oe=69D4E78D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PukC_WecKH8Q7kNvwFv1I_A&_nc_oc=AdpA6zBb9B-NO9fY028xT-onj-onidMQ_bgR9-Ney6TwX0ZQdczEhPcZAS1ijAKWy6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N4dPPHI4dZGuC2hiGapiViiC5FfEbvb7qt5D3RGe4zA&oe=69D509B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BmDOVJFZYQ7kNvwFtwgjz&_nc_oc=Ado3N33Cl4250fM2W67wGAsuvCjMcmPMEcxghydteGhk7dA9cEz0FLBMYipFMuLIQfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v3wIqT_M8Uj69ddj45QQc4EIJavlN5m3KWuQ6QqNg6w&oe=69D4E69C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEuNAH7uoWIQ7kNvwGp_l0u&_nc_oc=AdqK4VrO9zzqHbtyijNagnbvGj5qCdUzlhTHlL40ek7_98ZfEEvZNiv4-FBEUjDTy7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HCFlny0NorYo861ZfFFmc2TRjfk_YvJbQSPx8T8pEPw&oe=69D4EAB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbV9G2Mx9gkQ7kNvwH4VoAH&_nc_oc=Adq6etuGbxik93fDW85oyixmUnJVMWjvE1RbB8gD-B0IE0Q6ccvzS2UY1acUsLnDbiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qbFBPPBM-RRapibvwEjKSWq_avAe8X8iXPcvlJo_rfg&oe=69D4EF8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
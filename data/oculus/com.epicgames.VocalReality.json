": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ9RuSehcv8Q7kNvwHM9VgM&_nc_oc=AdqbwXHtblkw9-v8Ry_Aav29EQtHwYe5Qkmn8qewJuRLR5u-x7AxC9PqgwlRprkSQis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cCxA3OI9yMPNnRkN3pN2t8znkyH50zuUha7rNgr2VQA&oe=69DB808F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtINwMakd70Q7kNvwF_7b4w&_nc_oc=AdrmtM1HHQKvSO0lHsiWoyeNZv0p8okodT8b8pFnVaS1qSPUSMaRKMd-3FrSLavfsBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3muHIQKaZtewnlFscCtxCVfvUT-vZdOOoT1n6WOYgGcA&oe=69DB87FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxjrOjpLwkoQ7kNvwERGIs2&_nc_oc=AdqW9Ym4fqBHSL-tp6IhReWi3dlo7GL3yonox2K1Wy1GkvCMjiXhqPoHTZOpDIQaU9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37duqn6_2vre52JXXUihBPUrJ92wPEoXK-jQ0sAvB7uw&oe=69DBA05B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cGhabba_tMQ7kNvwEt8R1x&_nc_oc=AdrwItUSsTJpCdxjytQcjwID--tKnVnre6jLZJDG8OfTe7NgBwpbDeP5M1psUQH1UX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CRc9WK0ElDGAeCd8YyUe0wEmBgylU4Dk4jhGFfbAKrg&oe=69DB7F0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJbdHL6KW44Q7kNvwGBhT3C&_nc_oc=Adp0u6oy0twxNNKye7wM-ZenIqhi2p1wIuTQOXik-dHTKIrvwWmYrpZ40miMHqB8spA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wLWMI3jPpenzv7v6qBxZUrSpepJX_adTN0Fah6QLVVQ&oe=69DBA136"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGzJjBt1aX4Q7kNvwGV-6XG&_nc_oc=AdoitcrpWqRrI-XGyRuK1Igp03uVdb2wqkHM0_SbAJg77XEx_OJKgW1jx20ulUo9770&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kXmwx0FyRDOskddQNcwPfB8iZBpQsUUzUg0sbuwV_PA&oe=69DB7E1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPX0Fls6zqwQ7kNvwFbHk4s&_nc_oc=AdrbKZTc6AhuhJ_BYH0HY5ZbiFMIwt6TU2Y-lPUZvIgTS9b-i-4bKV_IDI-bSJFJ_7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19v3lO2ylfQ9sJW6r75t9qNGuTIQdypOMO-OIwVB6SPQ&oe=69DB8232"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rojSymtRKk4Q7kNvwF4lKEZ&_nc_oc=AdqFn0xoS4XuW_ZmHm68z33tO205eozH89ibG8Bl4vmqR4i30YO_L4V5dTk-Xsjlwx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aWb-p0s9mWqBSntaf_fmZf0Wo5Y0QMrxDyPNvxLUZOg&oe=69DB870F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP_i4fvXfAkQ7kNvwFtdZpG&_nc_oc=AdrlTfYOJAdVIVMZmNoEioedQJhCmzgr7vl0NplxnsiSTxY1GmmDb3qGmwUeKi9bmuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr5W9kPXKd-J5MUCPlpU0yAdrQDQOSYaVTGJ2LuCjFig&oe=6A649C8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCE0s7zbsAgQ7kNvwGl0T0z&_nc_oc=Adqydx0jNSDJGMKDfipPijtToKvsYbbaAjv-7QHInW2HPXP7ttnVYAjXoZE7ni9IOOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj_87ymsvPViDfm9mMbU-IuVP2_y1J-e1JIZJMOSQy_g&oe=6A64A3FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k00_nSpbk4Q7kNvwFVstWv&_nc_oc=Adq1zcmxMvqejNQiPFXERPD-PXOOEs4w_c5ee-OjSBZDkzM5wSY3afJipXEXBSC6KNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi7_gAbvHq2aMRU0_a_Ak7ytI4TTagXrph9D4BGQcIKw&oe=6A64BC5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJlnzBoz4nkQ7kNvwF7GLu6&_nc_oc=AdorpOmtopT5pMPmo23Q3eiK17oshMy6KYgMlcSLYPvLu_Dvly4u-NujU-nyGrVkImw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBjeyFEQMDBky2hCQmokQeKQXIxVjaBIKzGaIwIULubw&oe=6A64D34D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I6dZut66cEQ7kNvwFgXwrd&_nc_oc=AdrZxennplHN52jmS5kkuUDP2MLPaffa3_Ku_5NuxD0q0T5zh4NgRDtVgLrF8hUj0ik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJyl_67_L28Zqnc19mMYZLHrCkebD5moV9FOODSaAJUA&oe=6A64BD36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BylgSZ29gxEQ7kNvwEFoo6_&_nc_oc=Adrq8C1eVecJOaEk7pGTAORN4NPZB62V-OViVnn3wRt1lz5_uY0rbu1YmOO7P3LBGPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOYn-yxdgQrb_DDDWbRTvRRsW7MW-DRD43rpXEH1cFJw&oe=6A64D25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8cEBdzGiC0Q7kNvwFImxNJ&_nc_oc=AdqqacVgFTgbRM1N9_vYzNUuX6BrEYxga65hTgV2V0L2t8Fel4LZnXXAfQ6amaST8F4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNRzi8TG1SJnwlMDzzmjkuIKDuphrgNH99SSqRapxwbQ&oe=6A649E32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddgXFpnpyb0Q7kNvwGcuUil&_nc_oc=AdqCxJNWQEzdIq5gRzcbVuWAJEnk_6yEmnnqBRb8Ig74D8yuaqDIfa_fHYotPGT8FTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxL6EC4C6lffxT0uBfF9y40iyrGu_7Mx7lpHcvk6V-4Q&oe=6A64A30F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZICgBq_gnoQQ7kNvwGbeozG&_nc_oc=AdoBUhU6xLkaZ9AQLT-vz81E9zsVwGdac1G4IdrL9ZZKUXkObuQH2DAldR5LJoWbfPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzKEOrP9qNdZ3QQChAfaVg4b4jr1NzX4UcZDAnrlSakQ&oe=6AA6BFCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7imL0j8lZsQ7kNvwE9KbRy&_nc_oc=AdoiZyVNPKThK6HXThCMpKdYNZN57KmyoRHbmLaWhrL8RcGx4IRrHTQ9i1nJ03Y-8QY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa4msfRjEEH4rqY6U_SrfcWFVteQejec5PKd9Jta4vWA&oe=6AA6C73B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZOqXwEZS4gQ7kNvwHZQQoV&_nc_oc=AdpbUE7df39qpH6O36JrjUM5oErlIeXTYxvII0uo7_0I6TghZlOZEu1KwEjoaisa6vU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ8XlZ-Z8_p660_l3tHYucn1zM7Oq7TBKs54ku5DNSxQ&oe=6AA6A75B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWU7tCSjctgQ7kNvwFC20Ik&_nc_oc=AdrDtaGNTGv_Zkzwl0s-ENt8ETAx_5tH7Ybn_x7-lp2P73t5pWW4PKnc1e9l7whDm44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfFPgm86VGwLNWLizwWeUvSb4CPB92ulFCelqNVc0IWg&oe=6AA6BE4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jICvP_LifGMQ7kNvwE1lyiq&_nc_oc=AdqO2aU274VY8mYZ58c-mkskIWcfreg6l-CKg1Ip3nat4U-tuuTkOIde3_u4PNqs_WU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP1S3FXUnj8n1FHpizSyLuImWsgM3da2-l4F8mnIBKCQ&oe=6AA6A836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTuec1T9_SwQ7kNvwFN5wQF&_nc_oc=AdplsVDIGAQcK2djWhZg78nqibxrJPRGGGmOuFeqlg_7RWfQ-3jUjO77C4Ngs1rXRSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIlmiYNHz2bG8NBnz2fmw10BslOh8DPSK73kN7ixXcEw&oe=6AA6BD5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfySXa9QLS0Q7kNvwGm_Lm0&_nc_oc=AdqgobUhy5vXu2ZrPxeHrG8HuDjvPfiyeAH3CFk9l_mnfPQ_xWJkl8Ym9-jwVyml0TA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn45zaH-WF3yIqXUh39NImdPe00XVxqDIAo6vyQCxpGA&oe=6AA6C172"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iw0kAJOj-awQ7kNvwE7NLHp&_nc_oc=AdqX6hgtYg7Fhds66GKQg07kCSiVxzd3t9bcFXVCiHxKbVe4P7TKbtSXudwWMcT6PZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOJfNbMpVja6wGE-FSIn33zaPA5u7esLYTLJ60u1J47g&oe=6AA6C64F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
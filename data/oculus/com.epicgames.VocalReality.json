": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSD900sRGL0Q7kNvwE1LkgG&_nc_oc=Adr-oAlGIZY3WQOP7q9_9kZ16Ad8SnM6_XvSxI3jR1wOqhen0AVXocUkoxbYobyrTUo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qB9tVf1fQzt3aAyn3WnDeijafeG0VTPK3GZztwl0P8A&oe=6A170C4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYxiPIn3gywQ7kNvwEAYFJz&_nc_oc=Adr7z9TkjnNIgxk0SNR6-yJ05lFMesZPDusdQCYzvmhkRv6bgQGiDl8TkCj_jh3T0TA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65JmTEOgMROmMqFDcf-c0zjqqLkG5g67WI85WJKNvZOw&oe=6A1713BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riUyQ1kZeKkQ7kNvwHo43EQ&_nc_oc=AdpY-D4BH_HTLOLcKkKEjsqKBNcZ3UG2RkSXLsaVE8MJsbnDVfsvpX6QtqEmhsxLpNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lGnB74K5BOIbpxnmlvOJHh5M1iYKVYCybjopHcMOT5g&oe=6A16F3DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9trl1q9i68Q7kNvwEf1ERE&_nc_oc=Adrk3iwXWfP9QKqqhrM_NHwEF0Nln98M6c8eUOalpFmV091QvuSFj8-V2r8wLZHSNzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74nDv-E_yio-hFRvWUSIYEVMTeeoHJYkGNR2bbiE-ahg&oe=6A170ACD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKjGqBkgijMQ7kNvwHnxw_z&_nc_oc=Adqo6yy3XVosAP0T7NhJsJtmn3AKgmpSg864X1phI_tl5xYJs9Isx3CnKec2TPjT9sg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PZFkGR1udIGUAHWQddn3UfnbF6DxQJpTl04SQxpml0w&oe=6A16F4B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peYZiU-0zOAQ7kNvwENOmtf&_nc_oc=AdoZGfBvQc3r9Oh2m8jKUjGJJdJetkOmNU8EgQSXvOFuLMC1m4c0JV8887BjIakyfCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a-HTGu6WdwC4rUUqvqzjJFCOBNReCVvfarq2J2TrA0w&oe=6A1709DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rbb0YJrG2wQ7kNvwHuIJ28&_nc_oc=Ado3iYVwFB2EPnIA-IGIC4dnfbi26qSut8nHLBwtD9UhyNDOjO9NGVHZPdVP4dQk2pY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i4aD1r_yUF-QdtySD1R-D0WR2Zs75Jj1-XqG6j4MtOQ&oe=6A170DF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDlDJHtocZMQ7kNvwE8PxVb&_nc_oc=AdqmfZT4eQ-yWEnQYAf7VNSjOkQc5kAMjhT5hL9L9etayMbwZGOamOF9qLPGb2WHVU0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QgSV2074ubdNKiEpE71-K5eMiY7abIbRJTHDfoEOUtw&oe=6A1712CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
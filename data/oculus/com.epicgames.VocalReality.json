": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ATCtzmJ0fAQ7kNvwGD3caB&_nc_oc=AdpG4UJA0UoXbQZkjgvmyXr1-WPwGVdnAbjQCahBdytY3WsYcrbtSJtdcI62SZ9F4K0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wSRO40xlS3OHJDwPO7hUH7bQ6MIJdkOgOAEJ2Mxl_Jg&oe=6A3D47CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYpwNRnenCoQ7kNvwEv2beY&_nc_oc=AdpV8_vPE0KVePUGYWnV6rX08-9UZn5ys1EVbp5Rd9LQwLfzlD1S3SLabTyGoJkoxmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mv_MzEOPcv8yCF_-cLbza1opQ7XQA7bnjo_c4vZiGdg&oe=6A3D4F3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmR_r_Bj9TMQ7kNvwHKv8cb&_nc_oc=AdriMqf1b549Z-KvEbxUmQzbYiep8W-Fu3VlzoFUgGFgk5vcEIVu6FWMpW4yGJzVCUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8shfpiDvTOi-Nm0rkluLW5F_CIaPDvA_n9FwDcUP8MLQ&oe=6A3D2F5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbiDmjgxnNwQ7kNvwHTEOg4&_nc_oc=AdoqHm_f9cS4ERXYHtpQvo87tgbN0Cw6avyiaqD2CN7rqhHbI4zvkczEs7uDoMvJFwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HfJ_GUe6knwxJrm4o37ZMGq3GGaCm1cxb7yXn-aUNpA&oe=6A3D464D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0SRiAxrmvEQ7kNvwEcfkWp&_nc_oc=Ados-bz0Dhc9Ioaiv6CfcGhckD4rc9Od2TV1h10fllsn6hmKjfOzfkNClRyBEkjA3PI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jKXSVITfTddlv0SvRx3z5mSh7MIKzirdj8ensomq_zQ&oe=6A3D3036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxT7-Etk1AQ7kNvwF-oniP&_nc_oc=Adot1f3j5YKM3fVRRcOIrGcOjPN5nwGUng9Pg4eVRvBDgo3RdQ81YivOCruD3Hrc08Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ha16G3ubru_9WtaeqXEXcstjiFuatxAZadLqMkCmI1A&oe=6A3D455C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3pJi2BFz-YQ7kNvwEuZfK4&_nc_oc=Ado5o2gVJcR4Vg2feTKZPJ_mn5EMgDvCwfhJxYLnHT3wEE5jcgwmC7t0u1AquGUSUik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U8FpgmbiKGmlhF5x2W9RP-bHUuTHtBAhwMIDCBvVZQQ&oe=6A3D4972"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKOriKmdgPoQ7kNvwH_f0Ss&_nc_oc=AdoiIlsztPEqC9_uRp7ZBVThsceR59ijwJJAtLFoSTINTDuU1Ki4KXqbNILXdcxNuvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I4AkfKR8PTsi98UxBtLxhHW0GvngJkmjai2RT7B9pWg&oe=6A3D4E4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
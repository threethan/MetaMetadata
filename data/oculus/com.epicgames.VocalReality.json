": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6wAV7M8sWcQ7kNvwGnxT5G&_nc_oc=AdpiS3NQLodKYGhr0ZqyBMBOdyKoFbJyU1ohqPH3WhP-QSolRpcmQuQXO_ZB0ya-5sA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIIxMAxcCquExP7-sMVW4iRW4Z1lD-G7aqmcdaSag0VQ&oe=6A6231CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCVIHfHcVk8Q7kNvwEb3djW&_nc_oc=AdouGPCWgcxKOhaDMCRUcuy6zR15TsLeoyAieaxtUQ-qXUpS3u2_pMt0fNwBJDSzm2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALyscHocuTSB8A1x60KVOdq65j_TPlomYYsWF_vttj9A&oe=6A6200FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k00_nSpbk4Q7kNvwE06hxX&_nc_oc=AdqjKSjW--uupdRQjChb8-0ur9PK_Kw8puCmgoLqhF9pf2va_21dSise1SAvekutc-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSoD5F7YQx-Cvc5UHt2HvNpYpZkCKs4tRfEAqTjvydrQ&oe=6A62195B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyRh5i8f-j4Q7kNvwH0x8py&_nc_oc=AdoQbzpXeE8KG4j3dZT_xyHqP_koJtpfev9zr2m14cAdndo_dyzIN_nY4TjR-kKOW-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG1bPA6dtj33xxtfQmRd8ZDwEyY2tjD0CtDeqyi44pBg&oe=6A62304D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lcSccboNwAQ7kNvwFcRNTG&_nc_oc=AdpX7gHPLu0s3yyShetXgShN2Nz0_ujZ3Nt-Si-JFNnpGr03GED8cZSBNpTxrOgvz-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMC-nlyDJIn3_mOjFbQPg_tCqR1uys_jGDuHT9xpcP9A&oe=6A621A36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egHwhxWdhMsQ7kNvwHprtIo&_nc_oc=AdpJWgbHTpUuApQE3ZhWWWm0xIxPoA1ApUqpjnwYbq_dM9TWW0eOB4I1YgTAT5zhck0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAVIA1h8vXKKthBXOlw8QVAGvMlIuXhSpIZQ8S7FS8PA&oe=6A622F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8cEBdzGiC0Q7kNvwFWuUm3&_nc_oc=AdrXkO_BYKFjwSksraS7KgY338DYDMiwQ-fFQwD-_NxBW4lbgBwu8uln8t2-Jt9Gdz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIpPNDNjVZ5pO2nb_ApIDLtTf7Cz7xcAstXaR8cHUmJw&oe=6A61FB32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyKVJ6ZthugQ7kNvwEhso1j&_nc_oc=Adqz70-Md2_x_ah39TpbQFDlpWSOZCd8uJ-LVZWbxULGW_Vx-irbLEFlMn_PMmP2zSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE3MMR4lvDQZXFagGDF3Og8jtIBhaBBndsFq8MEMtA6Q&oe=6A62000F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
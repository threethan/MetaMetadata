": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2or4c26pD6QQ7kNvwHH82NB&_nc_oc=Adp6Eo-GvTkVtYDC58wtCs9gwK5Yvt5_paj1xv1BJmfadptIswuopd_x-XEe7TC3ppI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9UgO3LHw4xsMiyAroQrraMP_5zaa7BcOoAyQOJkMOiw&oe=6AAEB03B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayInhvoYaT0Q7kNvwHJsLqm&_nc_oc=AdoQGle9TYXzCoggQEbCKlDIVyjySQ3nin-mq6p5okXcWYFP813-A3vkHU-UxOcb3io&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEfcfaipWAigaxiuwAte22Y7pZt8s4WFUNOpwjgzkg8Q&oe=6AAE905B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kImUE9jiB5sQ7kNvwFfnXdP&_nc_oc=Adpdn1YFl4QqjPR63k7EHjJHGPzSBEVoSLZJwKnlJV3u_fBszsWU53jzI6fRSbdiSHI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL41BkizpMX83GUn6Cc2XmCz3GiJPDxfdAmZpTRDzcKCw&oe=6AAEA74D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-piXrWpQXEQ7kNvwF2g4sm&_nc_oc=AdrIDj-skrr43ljaLecBpgd_0t1MS8ZiOIna3_6skoKzgoKAW3gqfCtgHCzRw9ltO48&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnXOQBpanlzPcE_85VVemXxYQA9MPolq8xH-yQWDxM9A&oe=6AAE9136"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQoWmzao4-8Q7kNvwHstM4I&_nc_oc=Adpj_9u54JQSyBrt_Ef5ZazPyWceMwJ-R6c7CrIf8D1R-GAhF4Hbstho5Nol0KeM7cg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkTHg1Ce_bDHNfy57G3VEEFx-uYaF7Ss2DQxC0w1seSQ&oe=6AAEA65C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3bzvXZ0QdIQ7kNvwHl4T19&_nc_oc=Adorw-oLD01LcA1JCHdr8oFZ11AeiKqXBQCKVOeTK0bI8MxXjFB2lnrinlXcFbTG4xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBddCXII1oGUMfvymbgIbWOoOYvxhaLuDJgpFjSZYNxbg&oe=6A4A76CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRf4k_gNzuoQ7kNvwEy85Gn&_nc_oc=AdpYjOflP8AUZEAyHYKoc8ZEKJf7uCA6xyKkPHy9IrZFFiedQe10LCiioWh2qo8aGuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfMc-gr1AEPSYBBIoMRqCaMFoLDbABDIMvvLqv6is6Ig&oe=6A4A7E3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TURK5B_OJ_MQ7kNvwEBpkj0&_nc_oc=AdofV8ggqNkkjtnJOySfwINlmeUdHf-jmIYhSdief_OmolkAGvpP2_rzJI137dqk8Y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnH9V6w16bFM-TysvP3a-BdoljcmpZvhiFaSaWEYaFrA&oe=6A4A5E5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viiCjRMNiuQQ7kNvwFLajoL&_nc_oc=AdoZh7ZWZ5Ru__sLTzfh5DaAcdk3Hrpl9ABt4Js6Lkhzm9RKQ_Ecmb0GHspwLz5ub80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt5-0XSTUo2rbVEmJEuAHIQ2DsHFt18RkpoVBmv1_bdQ&oe=6A4A754D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nekf_Jptj_sQ7kNvwEu6Txs&_nc_oc=AdrH2OQILaPcOOH9VA1Bj1imPSwIrXjg69xACOh8UntuvgpcLSbFTm3vo2HbVgTRDWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWuvH17TVSfkEkagu4IbCVIP3Qb5oxAe3pPpiHsoWCZQ&oe=6A4A5F36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS3jq5spnMcQ7kNvwEMcky4&_nc_oc=Adr5e3T0V3HMarxhl26CY4Z0sKX1WZmjGHYYQXiRIrvBM-goZjTcMihz_fuDaA7gJTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIO0sxUTfeQ4hQYmR-f-N8q9rL_teHoNQ-8M7WVk_eZg&oe=6A4A745C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE7R06BGiWYQ7kNvwG7WyRm&_nc_oc=AdpKGFVXmLKei31gvNaAUSW6-IvocAIqll1CauU0Q8DXuFAOqUaIjq5Ym8Fez-aIQiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH5hLXQuswf8TW4ihflQlBl7KfEBi28emJkVrA8W4AWw&oe=6A4A7872"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TL-RCMQv28Q7kNvwEKPxEu&_nc_oc=Ado0miw1Oz2MA7ag2RZMuIuZeZsEOU3Z6wEVLYJArv2BLjVFG6uIxzxKYC5h7DRPEEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9GVSuHZG6vtN8dN6cr-n2DBmfHy-ylRaO6WtM7QwErA&oe=6A4A7D4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
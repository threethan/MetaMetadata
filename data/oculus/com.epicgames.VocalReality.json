": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_YFqp13cAcQ7kNvwFlXEPf&_nc_oc=Adqa9Tk-hdLDFFpbZgngQANn9HS3Yn3DPNt2AmyfPzJg_Vcz4YOmbEgSjVmAdt6rlaY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLIfeEJ1JXKDaTz4Nd5eF4ZFSZWRVy_qL3S73PDAmbXQ&oe=6AE8AACF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEPuPRlgql0Q7kNvwHfaQ9h&_nc_oc=Adql9pRrloW32b3vG1MQmyJmwJ716VAl2W5K7yUcRvc0W4dFiCNuXPMMzm43Oq-lFxo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX2MmCXlPl76WObfS_BJ2Q3vll5NVDWCItSLVp0fFDgA&oe=6AE8B23B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNvJzz4Ung8Q7kNvwE3_wFc&_nc_oc=Adqi8E6Lsr3UyXe1Av549cWzZGQdmLG0AvtQBL2vOGuVoHAvPIa-hReuWtZYAgHsZ5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3EBXSRHb_iFTpgRL6uTmzGVTTDxukREe5RHkuhlAIvQ&oe=6AE8925B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUroTD0aYLYQ7kNvwEhDDBC&_nc_oc=Adoghf72bqTd5R5YQpE7ZaYXA3VYtA5mDe5Mq92NDxS610q7XqZHCMfGP-Onk_GI0FQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROsQld0YIiPnI1XYtW_zNEw62NbtX0VVIoapW71zd5sw&oe=6AE8A94D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezTVrRQzkr4Q7kNvwGfEUwx&_nc_oc=AdqoBsBG09oV7ZfDnkRklGf82elfaKI1wBFhdlyk8U_B-LTmQTNfh-BRdThwjb0hcnY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqP5eYAOPFVCaJIli7zxAbCbfS3nPaQ19u8KauG5F_ag&oe=6AE89336"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95dR9JUwFE8Q7kNvwGXd5kQ&_nc_oc=AdqxOj4zFKAepo1mudfI_9gsdUGsM_c2gzQDQ6YjFQlcs95jR9h41ff0IlfEBKy0UU4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFc_pI8HnYxMdmOh13VSNWNQbcUeVZWnQ-ARLCNrxLOA&oe=6AE8A85C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS-wL29_nfEQ7kNvwFFVu0R&_nc_oc=Ado-R6N45Kci8rbjxLGX1TDL784A2m0gOeq_sSO7X3y7sPfTxcuDmwpjN2KINO0sYyc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHtMP667gNMou2urZD6y18rC_jNm2DygzDG-FPhLC1nA&oe=6AE8AC72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTKjLqTcYHUQ7kNvwEHXt3l&_nc_oc=Adq8Uj7jHqDAYcQ62dWQhoUv2WenV4gK65ZIQU17eUK0Iu3dfB-RxjTVXWHOHEoG-dk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_YcV83lyJqb0nfTEfPksEsOl5xq8nYArHjHThNuDBIw&oe=6AE8B14F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
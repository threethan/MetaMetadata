": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q-yM3mWhs4Q7kNvwHO7td3&_nc_oc=AdrdLr2P4oosZO_BbgUAc0gYLl4ubybgCJuB8Fn6KGY7kiRDsa3fpfZQ7KY0tSpQTiM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-E4oTKJI1hySBcE_GNfBkolpd4ccPBmaS5YArkiOBHw&oe=6A58F74F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_VONTFDHIQ7kNvwGSgXN1&_nc_oc=AdrBEVlqxXZogksT_FWzgjpIETmDjUjOp-n8RcN1u-TqygkE624KKcm_j0BLM172wjc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKWhc6OBF2SbS38as9Zft0ExUJYlmdqExoGfvpYh69hA&oe=6A58C67B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU4bty6IEAwQ7kNvwFjIZMM&_nc_oc=AdpMOE3BFwEkIEpKMT-2bjTY2r-uKV1FWFSj6CgB18uEcBtDS-IPmVHbJlgoVbewaCc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjJ1lVALW9D9_UoR_C_iBuhlZ_WRTPYsdVv1pNCUuJ2A&oe=6A58DEDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBiW_czCo7IQ7kNvwGP1bGv&_nc_oc=AdpgKl-fks0I9YNAiJEssnLgpQjnw9P01JY1eM4ihUUJMpPkzYByBeoOYnWCOVP9ksw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfq11DJ8UQ7w30fWbygPF7YAqeQF_JAK1CoL9Z33UyBQ&oe=6A58F5CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zpX0w8IULMQ7kNvwHY1qx9&_nc_oc=AdrhJC3-WsS-mIbkS41jDS0GTd8B9fdq4uVu_AXbIE4oYyYcU9YxbuSZPg2txgXV0Mo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFguDi-uKwNDJKC1njyCJdvgBTYbjaqPxD1Gytq--ugg&oe=6A58DFB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZMv5p5pYcoQ7kNvwGUo4HO&_nc_oc=AdqbtoYwsKmBKSmS4WkoLRNCLw4MRoyj7Te9tQGZJb_rDQLBXE0TzP7FoZk7nGUh4Ps&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7QVxXF2DHwwLVuN1KcA2ZdkverQjOwcRB92V9XYC-pQ&oe=6A58F4DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvKMAzvfasgQ7kNvwH2yb5R&_nc_oc=AdrgETjwtSYhZ9F2jQSXgIxXWMjcjz7u4bE9Xz-zoDxGG1H8EMjkB-7c_Yckxv-yMuE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8F7aH88UKf8LL8lzY9aA8eMHQ5iVERDN1-1gShqJwZQ&oe=6A58F8F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4pqPH1mGFoQ7kNvwFzpHg4&_nc_oc=AdpUSqddW8Pz5IT-GYuOh1_DmiIK2XX-Iu0ywP6oYGtstX3BihqoDsGMIfifNKlFIMU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL_qdBKVnWKY1OtuInvLH901XchlL31OJMlud4MYZhVg&oe=6A58C58F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy7-0Qy5mAIQ7kNvwGhcqHD&_nc_oc=Adrj26ilHDRKbSF4jUhctzzPLQeaZ5y0Oha4E9ig98LO8t-RrHn7DaiGt4QSpwxybs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMEgBMapD1aZjQd2qXulsiNftKosiNyZV9kFKCm7Njbw&oe=6A525FCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FzA5BgmFcQ7kNvwF1mT5x&_nc_oc=Adrf0AH3gAva0bf5HNNfqXUuEob5kDLu35J3Lm8YWhySimWqGY6Kg_CaoobZuLS-s10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCljetUFwIIOGjsGdJ-KsRxEFRkP7q5O-G7WFgNo8Hj3w&oe=6A52673B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmVYzNwJG7IQ7kNvwFvTcMh&_nc_oc=Adpbr7hh-0fSMBoglWYRPJWaUNt6O2AFX2NJsxBvOfUXuk_ttw3qeOgNhhqqP6UN5Ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAExbjH1Qw7j35QAvgw2teF64SHjNcrGiMmrXpHupvaRg&oe=6A52475B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vixMhlNqAwwQ7kNvwHtk8-N&_nc_oc=AdqwswbpflRPLADSLbZwunszGLxMB1P11jdJphZLWTSA7pKX-LQGRezVeklFUkfz9LA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKww3ZQ-nJsvEtAQy10_T-JuLcY-KHMmSdQH6aKi4CHw&oe=6A525E4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZWxsYsKwcwQ7kNvwHyOhx_&_nc_oc=AdraoTbNnGyF9xQT6IgnuJ79ey7MMqJOAn8bw4HkCFAtn6iWVF8_BGqv3x6rnKTeibs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR0KP0ZkaXAwtNUrT_-ya082v40mUkmheG7aJ6YiOotA&oe=6A524836"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPcbvzpGkfsQ7kNvwHlimqb&_nc_oc=AdoTZoIQvSr3rFNLoO6bL4buB4JGNJPNShQBK2MEaVln9f2RGoYRNQUxl3astUc089w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeRnR4NU_vOmPsT0JZLYLhd3Qs2ISpJCpcaVDssn6QQQ&oe=6A525D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h22SnDmWHwQ7kNvwHKOT8J&_nc_oc=Adpfk-EnYlEREjVDtolocOJwSK9VgUro_UBENdJy2ByILHrmC-f3fq727koJBQFrZZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbtDztgyYsRDNKD7hHB1z3in7y-IN3aje51UV30tUl9A&oe=6A526172"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzqZ6c2PCSEQ7kNvwFvE3Pg&_nc_oc=AdrcjMHrKqywtAgULw0B4mQWBnhI3wSfl_mi2I71d7GJxlGv_iWN-R3Im4idgb51DkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjsHWHPU17HAlMY0lumkGl525b9IueuncQZQ8Qqa-0FA&oe=6A52664F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
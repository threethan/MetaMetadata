": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lejN48PQYqoQ7kNvwFJzLx5&_nc_oc=Adqxa1NWncvLmBA4VFfdIgLdafApL0Vb5FLpOZ3kBT2YDpFbNIZXQ55fuk2Myp9p7NI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUxETv1UBWRGLTS__icv0_hBtB5Ok5_vs_3J1jAAkGwQ&oe=6A94128F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmouvB0v0EEQ7kNvwG-WAQY&_nc_oc=AdoNqvYcoLJabWYTPg8X4syOCv_n2qsm7zm6mZe0WCPv5-2xErfJmJXTDxJXdGhrl2Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGx7pU9NmCQsMR3sI2z_nUWqL2AKzXg38hjITCLI2fyQ&oe=6A9419FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zs42NgvD1cQ7kNvwHb4XMq&_nc_oc=AdrMgnH9rTyYUw_-0se6obPqNgh1KdkOughhjn6BkZTdlfY1w0hiYUzrSzp7zHJvby4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHR90enlR2bkaa9b3eF18Pn6TyIyc6e1ytiSOZr80Tzw&oe=6A94325B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD8mcNBtiWsQ7kNvwGwZvAi&_nc_oc=AdqBbL6TNJnVDAPGqVHBZV3f1hZEKZBSizEnLagYm4z_kMREtIpF20DW7TXWNQN1tB8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg4Wi6nBediztyVlMjx0LwjUG94Vfbgv6gjcrcIM7d1w&oe=6A94110D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35IFwxdA-FAQ7kNvwGRRdXG&_nc_oc=AdrbTFHVHjPNvHKAv3eO17C2eg7IGZy2qEJfrJMKKQZ-NzsSVfF_5765Pzt3XfSiUGM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJUEb5nNA_ZTuHNZGVfNqo-H5DHoMCxv4Qh-Pufg4a8w&oe=6A93FAF6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef_n1erZL-gQ7kNvwEeP9hE&_nc_oc=Adp6oVnsWte6gCTu22q2qqWmUkRSnsQhWkuptxvDtBIJ4YXlPMdWfObnuOoafdArYoM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3IDjVqVEbnFdeoKpD6XbAqRLWZAdU3qZUKQ-q1IcdJw&oe=6A94101C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE4FX_9a9iAQ7kNvwETh1Aw&_nc_oc=AdrEmqt5KZ5V6UGA-sgjU-V5MIT0oTISC7UNaW1YDlLQ3iZmOyFiHRvvTi6h-zdew8c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzqILR-wDVpXxhQou5UqM08WNIGGgrXPcHIqznoeyR9w&oe=6A941432"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfqEsKt7RLYQ7kNvwH2d4hs&_nc_oc=AdpJpbaq5bLaOBOBQgQK0YSIkaupFxdNQc3IqrWqt3ClL5W9ShMcLp2p_96k_-hQ6jg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyZI80YuO7RkZx8bI_2KtZ6TRTXgwj9M3hUHJAyHJP7w&oe=6A94190F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
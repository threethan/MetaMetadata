": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Kl9Bb27fJQQ7kNvwGDoKgk&_nc_oc=AdqXTXjDxG0slod5mBAF_NxxxaZeXK8gfFZZrkZjdODqJDmSd4vZWx5Nxmh1eQrZUJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf4aUiOFlnNKcx6nXDe0z_o85cNFbkwQnKxwIZ3-UZ-Q&oe=6A7203CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FydF-TfoFsQ7kNvwHEgElo&_nc_oc=AdoW8OirlB-cokoznlfprwDnigUb20X9BQeTznKcvgSpwrUaF5xk6phot5NtKa4uFjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG62SZIX59IEdZzN-ozeEInIEfWONeXEJ0UJcBksC3b3A&oe=6A71D2FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6iINGIdID8Q7kNvwFxzX01&_nc_oc=AdqENJQCXRvT0aS7QEQqwNTHBnnEuxZSNIORUauVv-KcYpmj9CgQqBfAWG-xnwMzJ5o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ7ffKHNwzdiux1dN3-RBlT48XuJYZFs3YrWkzmbZ_0Q&oe=6A71EB5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVuIaaE6c_QQ7kNvwHmH4XE&_nc_oc=AdrxfJPybTIw80gUiKQyZpVeznYbb0xHg5uzjrnQNxANvQqzCJQc4D8PhFr18sGG8iw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErhJcN4T6HxyDMm7zpWb4Hnyglu9ttamxBbWr_R0Zqzg&oe=6A72024D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eEAyGpZU94Q7kNvwHiEV6u&_nc_oc=AdopIkmB0bTrz5n2PnPSOHzDV1AD1Fn2xs51YLDuiTcgg_IRsMQ4E-lbCGOjkiX7iKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI_6ah-P8Ve0dU06-WP2m7Oh1m94OeBu2sKmLEzZ1esw&oe=6A71EC36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nReJjfHq9aYQ7kNvwGR32pC&_nc_oc=AdqPj7D7sg44ocEwdkNAndD0qGaS6iyNTUov2L2D7tCTeAL6mmk12spCE95oN4N6Xso&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5PASptML8bWJNgGHYYe32PNDF8nmK4SGHf0Q0ZoPZtQ&oe=6A72015C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfMIsuxHnSoQ7kNvwExHXaA&_nc_oc=Adr1_Mv18p5L4c2rX_pZEXlBRfL_X6aKSsSkJ-D8cn9NTn7hgFiFyQaU3e4I2-maXrw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodao97bHzbRS2wCHjwm2bGvkXwZeNYadq4ZAI-SrlmQ&oe=6A71CD32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r78bLW-tUsYQ7kNvwFb09MJ&_nc_oc=AdriQqMG6EpL1rYGRqSELL5U-xD2goUVxj1BPkhCldE_N5G3qPbGNLyqCklw1jbFgQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZSiJkmSnP4ORfQ1SCvinD9MNmTn7WtdkKPyry81N4SA&oe=6A71D20F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
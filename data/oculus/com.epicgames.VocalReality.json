": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP_i4fvXfAkQ7kNvwER724x&_nc_oc=AdroahqM3l7CFsg1jKGhKfwXPhkC-A9nKGtRYliclEFewFb_w90V54BQbF_9QDL09X8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnZ7NhXMw1usPYccYLF9CHrTgXPJKaMiq_OmWHgaYIKw&oe=6A66264F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCE0s7zbsAgQ7kNvwEhiOfV&_nc_oc=Adoz7KWziSXGSDLVUV8gyI3cU6kX8E_kqufgXJQ3OXLfOJbDIaFzeE7avb8N5z2H_Ug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrg4KNiT4yjCiacojNhjgV7MnoBGp1kOo3o2OQi_SoXg&oe=6A65F57B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAfcHgAe364Q7kNvwGm6y40&_nc_oc=AdpGzubLWTSbMd4Mo69fj6MECeIaonZi6C1ggrDVQrqF4e7M3XQb26v6A6jSh8Kwodc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4d1Fqm-wJvSW1wP9n2ZrES7uCCVqqdGjvqyDVTkTbpw&oe=6A660DDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJlnzBoz4nkQ7kNvwEkZaqs&_nc_oc=Adq6tlSGLhbTx_IR9Ts1Nc9U2VcXZbISCG-y25lI5f0nmG0By7_wKgcC9Lvc3kdpUIg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLll1_OBIfDOiFFc11giU5SHFP8ltD5psqGjGr89Hn-g&oe=6A6624CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I6dZut66cEQ7kNvwHYfYwj&_nc_oc=AdpqoQYu9PR9STqd7RYsEDRS6TL0KQh4rw4e1rU9ldqdnEOVKGpmfVq2v82ZHju_X-E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFvECp_VzcsB7ZwdUH0fG1nCPkBwj-zWGrQbjQ4CuwgQ&oe=6A660EB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BylgSZ29gxEQ7kNvwGeG5bN&_nc_oc=AdrP-hpFAR1e1XygpRfRUs5DXrynCyDlf_WiufOIKM7YpS3I2ak7mMIm6aXUFP08-4E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSUt9FPMZyen3e1KkdNAF_gZshj90-iW7sRB6rom6qPw&oe=6A6623DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMRT9T3vbzcQ7kNvwEuIoLa&_nc_oc=AdoMavk3FrCYpbwR430qaaZE4gjvC-xZ32Zg8Jc07xPz8YdsErmvb6udwLpCznmJuEU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBalLLlhEb4-vH8vWcsWEVMz7Q8P30P1CzC7o7AY4u5sw&oe=6A65EFB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddgXFpnpyb0Q7kNvwGH2PHM&_nc_oc=AdqkZr3_I2-omI45NQgiVgcjpr2HMlNGQYPoqWSUIQE6d6LA-e07YPTcEFmLJ8rx6Yw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWazaSzsaPlFD6gfkvZY5U06mKcPmNzLMJ-CP8J-S6WA&oe=6A65F48F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ9RuSehcv8Q7kNvwGZqINL&_nc_oc=AdrjOI7tM_P2ZA7SX_RmlrhSxQl84heOJeucnCKEotO05E4F0U-kMbhX-wtDkj7HEqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2jgOmy9v4UjU1ZQlJqJPkHS3KrHgTANffHqHB2GcNA&oe=69D8DD8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWMr3N6qQgQ7kNvwEdzGRN&_nc_oc=Adqyu3wCWbejzKUAt67GUsEQlgItNx60muZk6rD6oQn42Lhv9dDxtkMDglIKqAMAcno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12IyBzkAb0ePuIBh_jkuzRAbuQBzV1o_ALojjcT-mqtA&oe=69D8E4FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSpq6_h3wykQ7kNvwHRBryP&_nc_oc=AdrPbZwhzDDFSii9_ySzG_EllLJg4rfIDse9jMJgfJisFchLf0RL4H5KwHq_vBwiUgI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GVJvEob2_j1O9ZaHrK6CCCpTE_JOYQXKelPft7lNQFQ&oe=69D8FD5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TNWN9xTJEYQ7kNvwHSSHGD&_nc_oc=AdqhkQy628gqjAhtjoBik_BEW6HwGntVgmVxBet8njcOUXCRisVb0bY7LB6afoui0Ac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kfAmRs2MRPz_w-hq_PtF08BfgnY3WmO92cPLwnpkJKg&oe=69D8DC0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJbdHL6KW44Q7kNvwEkzFiu&_nc_oc=AdqXCEwHEr7ZplRDc9XUfchRjh1_3uRItyuhyV9LpjoSlj4bXmXfX1Jfg_j29J5AJig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LPiKpKzjCR8e8QfWR6bOC6fcn8jgAsaBjeOaON59eCQ&oe=69D8FE36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu2UosQP9fAQ7kNvwE4Ohgv&_nc_oc=AdodR1TGPVc67v4Yrw5aWPnvfae3SYBxJRzzjZx1OEHklFZFR6rYYq-2iC0MulV6MQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GO7mmlRTZzEtzrxoYMEn4EPFW7FvFVzPNp4Ye7EgQRQ&oe=69D8DB1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3SDzFC50skQ7kNvwGexULM&_nc_oc=AdpddDSV3sAWxGlGIMxjTsOViqlMwlBLTz8eVn1XxNCHPxmC5FAKUSFurFqaoxMiCrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34hN6GVi3q-15imucMewrNzoLXA-58EbCQznF1yIupnA&oe=69D8DF32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rojSymtRKk4Q7kNvwF-HbHG&_nc_oc=AdrwM7sP7UJScK4zwbXDuNkeUb9k6SBuAelZC3WoHbjgUgK0xy6913HQ1Mp0hVDwfMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B88eQMRxad5ncf-AN8yIQ_dHQfElc5NfoZpqjTgPuYA&oe=69D8E40F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
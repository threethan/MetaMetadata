": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxhidUwoKmcQ7kNvwEcDLiK&_nc_oc=Ado2eK69WLl_jWzRXILnApUkgbof47oPXezSy9TOW29yVSHYEqU081CbqZF8oGUE6hI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORPjywaXX5XkPl0xsAwW7XQqAFAbe5l2KprwhpEHYhcA&oe=6ADE1ECF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNv8J7is4UgQ7kNvwEPWoC5&_nc_oc=AdqAcwWXqQL5yeKmYV37peKZnS74qDox7geCW9bKlxlTiBIXOGwu8-v8t9x3LD1rP-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2qAzqx4WDfRgPwb3JHGB84syGaTUURrV5x-bJMYxehQ&oe=6ADE263B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAQbRCFpvzAQ7kNvwG0E5SW&_nc_oc=Ado7ytJlnxl4m042AFrmxWPMpBnB-H7mp5Nc76h2-3FDgj5qP8MtjK-MoymGqKAzuNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9YI0F_HJlEXX5WvgZ7k9ASZzYGUFHYv5zepXpEjuPgA&oe=6ADE065B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8HvFHFusRAQ7kNvwGe4TMU&_nc_oc=AdpM1f-2Cnl-Rv9o4PB55XiPBXGyrzzlDrY9hSHHepzo0zKBqr3ztClTey8MzJHFO4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr4JFBI-kF2KBc3pYr3rqQDaB2v5tXXC20VWfd34fAvA&oe=6ADE1D4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMWFFnP8dN4Q7kNvwHUdxZ3&_nc_oc=AdqgIfFn_AWaT3dhTVpMWv35arrNFFZ5Zmbg1OEiQWBiGfF2q06ZcwHD1QS23ZwNdOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHHRscqmMmVMf3PZVP0Ay5MNOn_asQ6sUbY1LH0Jtq1Q&oe=6ADE0736"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss-VHOGBrw8Q7kNvwHJ3KzD&_nc_oc=AdqDRVSB0j9l7eGH6fhmLiw0sQFw1CktkDZsuYNh-ANz7LXgcNDRi1MnPn6BmdqUyAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEKCGPiq18VsGzJKzqa5wcEraqrvOfMSLA-Tjp0GtzLA&oe=6ADE1C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQLG-uWmY0Q7kNvwGJRQgY&_nc_oc=AdoFBVnsGuk7NbcsxS0hUvh6cCvhppIkupsPksqNBTMiIKF7QwlMiKlqF2N3w8h4uN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbIlI0IDvMJwcuKnp3KP-EAqDCkxMceoWtyyYKy1_Gtg&oe=6ADE2072"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EQ5Lz0OYIQ7kNvwFDLLOv&_nc_oc=AdoudgxKYb5fSqR3JJAzznriV_ITk7hhwmzvJiB0ODdpl97ANIs81n7qXUkHsMCFBc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdQyHZiaTa6MO1s8lMJYGyjRdNqjHIf_Yuz1TfuVd5Dg&oe=6ADE254F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
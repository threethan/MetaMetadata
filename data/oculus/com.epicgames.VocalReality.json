": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0F7mboVMEsQ7kNvwF-tMFs&_nc_oc=Ado3TjhUcqi3AF_0_ip4eAIa6rELPYqpDL4_5x9SXokyKZZp5QIlH1Ov-IV_3EIlXUI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5tQcvKLnf0RzD2RFiqvgRDiEpH-oc5ybFFIMGaUAHgQ&oe=6A916F8F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxRSShghrC8Q7kNvwHJB2ia&_nc_oc=Adry7akqm9LId9pWAqfChMWdHFrWb_9VzNIjZ7kTje3jATFM5wcwSSDPEhuH280VVfE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTh1j0lHn9xIvBMj2u2B_vKj--XFT7BoAIaHeNpewgUg&oe=6A9176FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zs42NgvD1cQ7kNvwHzFU4t&_nc_oc=AdoULBWUWMwuJ-Pv3nzQ83-Z-Tt2fyLKmvuuRNldO29_k48GKOwFpp45jGFqTAbQToM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk3XsFFdDvGPi4C12j_Tib4jQ1ADTaEb7zUPdsJx0DWw&oe=6A918F5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74GhWdq1jEIQ7kNvwGhESGI&_nc_oc=AdqTiWnGM3jUL24Za2wmFPHPMvVieXi3tue_GaY395oLjUZ9j7mEmWj5K1YMVxuAyjs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYty_FRUHa5WSRGM757i1X4yL_yhIFftov5SEMZPCmbQ&oe=6A916E0D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvQR314HkmkQ7kNvwH36ukC&_nc_oc=AdoyunuWhsXde9tQqvpQ-ii1o8o1CmtKZzqVX4ORm4edByJvrmgPLvCmZjbW1MkQQtU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTeiKS1D4ZBn1PbB2XW1bBAqFqMH3yvOdpBUPIyJe2Qw&oe=6A919036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmGueszhCFgQ7kNvwFXB-7p&_nc_oc=Adrc_ZSkdPRRmjx4r6dyrVaKm7YKFaFtZKUmmC-wmuY84qw-20OoEkVu52GsLDML1iI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDeEM0GgMvI3TLzXNpc4WQ2GHVCfn3sqZsf87HJmz0Nw&oe=6A916D1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE4FX_9a9iAQ7kNvwGUuslt&_nc_oc=AdrOnicQi5TcgSRM5KH_bs47QBqleFNUXemgylcufAArU7w2Nd-SozhdgG7woaJtib8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHXxBs6--3I4mO5NDimh4kBB4abfovvG9TjQ74V4J_3g&oe=6A917132"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQtfJiQPducQ7kNvwG9dkrj&_nc_oc=Adr3u1VGsBwafl8ubWjhmVUIV7pfrxBZiVvWVyq6bgz2QURHfbCC8auHiwdKja7J6Nc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl8s1Vx6W_-OX6-hiqTjUwSlwbsIZuf08mKsNW0myJ0g&oe=6A91760F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HANSsX4GiFQQ7kNvwG2MmEB&_nc_oc=AdojATC1MyI0-Jun-028vpu1WDAeyvDdVVMeOK7qVB1I5gxJX4Wlml_9ZDzjbJQ4b8o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TA3N4gQlevVWuGgWTTMp0VrKG_ogBqVYrDipo4cN1-Q&oe=6A1317CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SlArMMuGeMQ7kNvwF7X-Yk&_nc_oc=AdoeJE4Kqhg39NNKGbHybN4bR3eU6scNkrwUCEz4pTH6UklxofCG5D4_Gf8s0TCRdJY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lZSoGGKEHVDHMPKS20xJvR6XldplvM6ANvVz5QrpiOQ&oe=6A131F3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXDT418S8xMQ7kNvwEar3uU&_nc_oc=AdpjRvMHqASQCI3vWxMmL6H7iC4yohueVEBxH3ZgMwd8M1bHfPk9WEOOIneP57XPzco&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q9GiqltxCp-rtl9FBuaabvlrWBKGT3q79JFyRn1FYbA&oe=6A12FF5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2G1b726YZsQ7kNvwH3WkrK&_nc_oc=Adq9YyYW_rHPDc1g3noSf-BWdFtpcvXSWsycDZP7X83ARgOw9r2AgOsitYXQESV2-xI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U5G23CZQHfyfh8PAxerKM4vl9qaZNK2U6FlbeTdERyg&oe=6A13164D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-A4XMsfWA4Q7kNvwH2lRuo&_nc_oc=Adp_rqOXch9HKYTHfPTgB643UHxqYRZuPok2amzi1Aytu8tInAZawbE2eavseSF01ks&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HUIYHAkHqKYGpio9LFvCu0j4hPIeueQqmBRpEB-4XtA&oe=6A130036"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-jzM-gll6cQ7kNvwGQut3Q&_nc_oc=AdoBCtosgvGFs-CdFkSGq1kC6u-td_L1fxRIBtAdiJ-BhcM-PKfWfeiEpKOEaOz_9wc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xtmekds6FxxGuEeYDfWfSFvmn450t1Lx-2fn4sPzFmg&oe=6A13155C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYwj7DSmuT0Q7kNvwFpOt_h&_nc_oc=AdoL2Ks0rIanJRM0u7y2gjM5U75eRigN1FO6MHRSvOpZyvIlfAxEMryb3tTArXv6v8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42CbWZCLFGQfxUW-CvW7s5D1_RHJctqCvIxxCudXQ0EA&oe=6A131972"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edMbT44VpH4Q7kNvwHuhHWt&_nc_oc=Adpcg0nf3kNx19uL8R5n9m3oWZtVkDmJGof_o6b0NCOYQdWhBfEYSKct497JHqgdP78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48Its0oFcEp2b6QjXsrFciBSIzW6T7V92NFy8C7FqHcA&oe=6A131E4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxhidUwoKmcQ7kNvwH1nR24&_nc_oc=AdopJ3XnZf7eaV7ZonSrJl9wAIcEcxHHCsC0hl-ZSYJ4wPqcflbCqZoikFAFmltP294&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSmMxEo3xAt-sMsaJyivL6VPyiciUHt2EJMgoFsuntsg&oe=6ADF704F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji297-FKqH8Q7kNvwFofsOU&_nc_oc=AdpPs5HNUj0CgfwDMOcu1n-NZmI2Iv6Hj94_vuYyp5ALy0p8O91MTkafCnhGatzVxEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZl5QJMiXfKT7cMzUsfjUXYb7Z1pw6GbOZ0EC2auWeIw&oe=6ADF77BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAQbRCFpvzAQ7kNvwGccebb&_nc_oc=Adpqb8ZizGMJwXxKPDVdwHpTmJDnyf6eAQM4UhWB1bi9RORS7ysbUulmMUlYSyjp2p0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl11Kf0VLF6lS1Qfq9GfFvT3fqqRpGWgWpUk0o_NAONg&oe=6ADF57DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3z_4Ot4H9gQ7kNvwHnhxGS&_nc_oc=AdqBvhZerZWLseCKB6qA4ye6eBxJqONgKhIslJg11c8H2mAx8Ryeb5jgcBfAsduyTqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfArPTBD8HqBMp0LSOdwJcXVUicWhPRbDX9-L8WavRFQ&oe=6ADF6ECD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMWFFnP8dN4Q7kNvwEcmsZ_&_nc_oc=AdoZg2_B5j06PXujgiiYeiqRgDR5jQKlYndNnicvSqRnWL0iaD4wGv5HGbs0yfNTNAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAYldHAuMEmFzou9afNXa-rvxUIjSjv8FnLM4KcUTvPA&oe=6ADF58B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyGfrw7YPfUQ7kNvwGAK7_L&_nc_oc=Adq5COiNG7Ahoq20bZroeXnAvwzhBV328fra0dMaX2uwTY0JDMehe5oxnG5kWPhLaU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6bcye5nmZ9HbS5IJuwX3QzRm-FhHljzIKqvzD1JLJJg&oe=6ADF6DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQLG-uWmY0Q7kNvwGfJadX&_nc_oc=AdrkPZIeqBlMqThR_MiHGbdvyIfccOVvJ8P-Im42f6gy1C_Ia7Ln_yh3A8bbGl7xAbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSoB5QHb36uO6WoYFH9WTAkROhkig2ncjzpiP50LUAkg&oe=6ADF71F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EQ5Lz0OYIQ7kNvwHYQPsm&_nc_oc=AdpDGDTIjt8lK3gE-kIHlPseT9SZkpbv2l7-hRac9-tp_D0GhTNpe98bdxPvDEg_Bsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIeZd6ycb2rlclrECnZPpzxaeTfsZFwAgT0QfGGEnGtw&oe=6ADF76CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjjtDBfHfpwQ7kNvwFLo_wx&_nc_oc=AdrLuYmTK3yqQgjUbalij7EBnBP_4caTnv5B4f7uCpVnyXtRM_TZgElK7OAQ57DOFN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkj0hbl2UOVJCY_9GHXjjmNGxuF1kXWBB31MWTx6T4tw&oe=6ACCFB4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvUMuNg0x4Q7kNvwHES9G4&_nc_oc=AdoPaPyyAZ_g5On10W_EGGFX4YkvvWraYuAtMRqs97Pca-Ss3CDdp1kly6FkIDhGvw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlSn9VewNyiNhAT_puD4UTm7cocCIvBeZ8fMdqvFyUdw&oe=6ACD02BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBkCoiarVqUQ7kNvwF-YLIP&_nc_oc=AdpvnIt7KT4kFWwZpBMREV69Vok5qZxph4g5L2vZNILwRYKaOurhDH45ReQ7xk4ER7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYDeTyNuvSEjt4obEcmDPjsE12dYWbdXVvZDcAEXCQmA&oe=6ACCE2DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzKI63wpizQQ7kNvwEsEYpU&_nc_oc=Adq8ADnMLuut2Fi6I5OYTvlol7qWYPXFaMuRxxozfnExewuillH2jvb3YXhINpaFCHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcU5tRJnp7s6BBxdVIka47o4r79d_2VlVRqVD078ke7g&oe=6ACCF9CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3135zFS72JkQ7kNvwHRQjEE&_nc_oc=Ado0a88N6rGe06MZtwMKpHk8yKe9wArX-GzrSgteihkWI5m9JwXj8aRqyPguX353WW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR1P55sgkzecMLB7HGbJfUUxTXVZkwYm8d60DbwucpyA&oe=6ACCE3B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRK15abqex4Q7kNvwEtixyW&_nc_oc=AdoY7st9rTaeHTxMVYOSV8ItBQKHzurGBfFUHaSg5q3j24aYtf9ii1bO9nAx3XYnnpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgztXLXuQICxvihTnB8VPl-J4T4qjMsr3A8q24DKVSyg&oe=6ACCF8DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsVPD-kbKiwQ7kNvwHWxetJ&_nc_oc=AdrzFwdQBUnbPnxtAHmwz4Sxinw88RklSj17BuclczrxbwJRc1PQP3p3xYzuIspXEAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObN9X0-dIfjU3tou2oHvZPGAr40lkR6KbqUzgMYGjjRw&oe=6ACCFCF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEcx7XRNPrMQ7kNvwFnH_Ov&_nc_oc=Adpi91jR_H2YvKrx3nEKWCw7ef827Ehu0QUdXD3h7rF-aqtNsDza9ULjS22cxkOOtfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO05Mk2ztQC67q_P-0WUcB9G0GrNgsu7hkFL2UTMqkXew&oe=6ACD01CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
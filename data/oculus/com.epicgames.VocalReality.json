": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IYbN6LGOnoQ7kNvwFaNnyR&_nc_oc=Adpl30iompyow2xrKfwrIDMG-P9r0JvpcGJnfKceXGAinM8qv72cc9VOlKD7ltCr-sU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYF_orY_koyBDXqk4hH9lXXGCgUfw7dkSer5ARI3e44g&oe=6AA2CB4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=133_u1vQI4QQ7kNvwE_k_w6&_nc_oc=AdoaCXgj8ari_v8X944ntspOYeaJfu8M__MgH5zoWOz71xS9U58fzqgpLYPj2a-m-cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhLkoYqFIoua4zZlO9FRh2ggxE6qZbpkLJZqW62o8KEQ&oe=6AA2D2BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRoKs-5bGckQ7kNvwFXUPwq&_nc_oc=AdqphBYB3gao0R7dnkaYMSYRKjsWLSg5V0qDGnIZFqZ45nw8cQYQwVwEsdCgp72U3SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1azaIwyCWgLxe_kcVbmMYfR_SAwdGuN0gNS8e2ohjpg&oe=6AA2B2DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY6QFd7eg8QQ7kNvwGNGTGx&_nc_oc=Ado_0Md_v067o-ZIebOn7mkCDbe-aOTKLLI3nvlE1XCsn6r_YvcOsJ18SkgmRfc_dLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA1VL0MVKzF808Y_jVegBLkd5mnC5dQpfCNiVm7MvDdA&oe=6AA2C9CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJphqoKhmY0Q7kNvwHXhKMG&_nc_oc=Adpldwe262n21yV86Ky55ClQmLwzMiphypD73alHsIT3V0jIkZVLXmohHwAQ9LFZs2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZLmPj_NU9KYc6fhIb0Ck7rFlRBf5WGtIz96GjxMl89w&oe=6AA2B3B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PiESha9BvcQ7kNvwF1yVzm&_nc_oc=AdpmlA5DegzS_M25xhkHq5leuDySZHywV3yBCdDMbz1qWEtBoOZeejXcZBZHe4Fa5rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkIW96VHw0vPt-SRp49_ifmU5yiaEPZu2cvFoUKPjFEw&oe=6AA2C8DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_YVJvXApuIQ7kNvwGn7X9X&_nc_oc=AdqJP-Shlrig7JeowYtbKmB7KJmqgZrxRqkpm2lAc4-IiwS5169WwteYMM9xL_bauT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWVPq8Kkc_km0uvLhtLGLT4RFvlok2vxJpVPnnwnZ-oQ&oe=6AA2CCF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R-JkDABdpcQ7kNvwFkMRpJ&_nc_oc=Adquu8JR3Eow9iUbCNtJ3_lNQaJwZ8bE353e0tEjSYpiKSV6fEjLIhxDmNlZAsbRsR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3qoME5ZN2GOlxNkJFf8e9OhYyEJgBxlfr0qs7ROkWhQ&oe=6AA2D1CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
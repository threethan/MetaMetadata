": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahv4o8NZOikQ7kNvwFQnpXW&_nc_oc=AdpAMxX_JZ4SghUL2l6rqfTjnx4_b1zx2sRGi32ugliBQTFkUgGMT2pmnFTus9ml9C4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEceGYRieYuQujTBCHXWUPJljwF9W4R-SBXIxiDOCsDZQ&oe=6A8AD80F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrHYtmAud7AQ7kNvwHndsDA&_nc_oc=AdotRWx4JiESurx-zyq2b1pz2mKnhnY3E9LJtJkKoxhGArc8Y-0S8mIWDFR27KwJgLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsHbL3hC33PnVAHWSJPo0buc8zmJlqOm24s5Imq2K2sA&oe=6A8ADF7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAg6CEm5Sl4Q7kNvwHrrONp&_nc_oc=AdqvhnnoaqucTyqSSJeoJUjDIfMQyw5FAVVqIeXpX8wNpXQ4HwPZSBHqsiSQo3VLNVs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCy5B1fIbReS2CfxtNivu4hFgUYQ5up-9gLr02gcMsiA&oe=6A8AF7DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPgtsjJdb8UQ7kNvwFCAZsJ&_nc_oc=AdoLdRtMQs9HIuRc809ipIawzw9B1qqNfm1tnWksLIlLhLLi4T5J_lsn4G_yMmeyCMc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaTc7viU--i44InDOPPtKZ9AMC4ZNcS-XTtKe968QbOg&oe=6A8AD68D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gPWJ2NxU2MQ7kNvwHHj4sT&_nc_oc=Adoz0N8Fa7_R9phMCj_-EHfer2ISmrGAJhUChms5yAOAwdlCOiyMm3RPUgzVs0wJYlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ4Q-vpMu5CACGGY4zPKZlgXRPl6UTtD1-nWcdd79epg&oe=6A8AC076"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5KtV1X-V4gQ7kNvwG9goE8&_nc_oc=Ado15_JjKYUah5SbYP2bTUxDwot87FEnyhDTMAK2XZKgmoYq_-FzyjOazbnct_PQDPQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF6cIr4p2aTxkRmT1a4_t8wclqnXTYfapY_ZyeBZTDsA&oe=6A8AD59C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygXJX1npVBIQ7kNvwEc26uE&_nc_oc=Adphy8bGJgs4400aDG1JKIwLAE_V-PfBc_4LWLv6bek5kUMVFZwADK6Ot52XR5iq1JE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwfqS07-WCNugQbQg1GW1OQwReSC6olfpD3I8yWb6KQQ&oe=6A8AD9B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I083mi0JicgQ7kNvwHpTnyO&_nc_oc=AdpB_xsj1IFmDdbJ4B-O9mTjV_qBuetvzB-EEQDK3qaUXACDMgc_Paq6cpDvrtS95Fk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYs7eVdr2vSPZP-UVDHuJ59NmsNQ64iTAZLbdk8IIhA&oe=6A8ADE8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnB_fesKnEYQ7kNvwH7kwqs&_nc_oc=Adr3ZjLVj0WGkRiBGW0FjjgIc_0Svqe2XdVYxhycxopsdZdBtcjaQ36sJCqewJ_TBnk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gcrfAMsMuWfWeKw3vKECbqeaV-78rNVRvGWGs1YXsvw&oe=6A22F13B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb18R8wp7VsQ7kNvwGv04bs&_nc_oc=AdquoVGKHmWPUXraz4TD2fTzVc8PnHCvvexAsdiVyOLVit0Pwig-gKCaXG49bCy64No&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OZqoB4HCakOpOpb8J61YVHcljhz6G8COinxbO1z_Hpw&oe=6A22D15B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnQdP-i9wrgQ7kNvwFLGnAf&_nc_oc=AdrkR-0S-3wA0CXK0vAxhoqIWqkqXVDT7_uZglt1xxr9-HWBH_JGgEcPm1cFHXc0rYQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gxseMjc0Pn7kyK12FohFmZvxSY_A5Y3aVsZE6jkyvCA&oe=6A22E84D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nF3xOuqeMcQ7kNvwHonMI2&_nc_oc=AdrlUuVpwfX2xZY6MU7QCmZ14UJZ_IfOFv2IUR4kHQ1W57j2S28xFHIxO03_FrjFORc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-axkUb39mR3QYz9ZWzXd3FgTZyKai10WeKO_7Kebnojw&oe=6A22D236"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AezVwVC5iMwQ7kNvwGkDAjK&_nc_oc=Adrek-5Zeri3PVv0tmk43fcbKrOUpdlSLUXOo5khGTq-5mle6S2jCSZdyzpJC0KRf8I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UJCDRTcLBYbjUmA1xlTbxZQ-NxtxIeumlQxzJGqj5rw&oe=6A22E75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "Selective", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. With its immersive 360-degree videos, Vocal Reality places users in realistic scenarios\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. Each scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://polingbork.com/VR", "developer_terms_of_service_url": null, "publisher_name": "Invisible Seams Studios", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres":
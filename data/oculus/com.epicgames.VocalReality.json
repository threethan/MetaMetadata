": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe7dmkvtgXEQ7kNvwEtfID7&_nc_oc=AdrGWgf6ChONKMOXDeA-ACUyLjZyrnIhXHbPvJDZYUFgKcvewrPFDAN4u1StuhHCj9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gE0NJv8YsYE3LjJTSplkxzwmCoFPOgYtQlkviqiHhiA&oe=6A4530CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvrHHjIu8bgQ7kNvwHYZ1J8&_nc_oc=Adre3nDvmDZ_qQG6YUAeHnQ27GilkKdXpRt5wIdidag36zsVGt-UJ7HfiL232UCbaXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_622UclCOnI19iNTvAHS06L2hbS0F1d5YXSS5YjeyIVA&oe=6A45383B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbboMEqXkTYQ7kNvwEU9HnV&_nc_oc=AdoNA3S6Jd9qsMWGxJ63yxLeq99h4FD1Lb1ZE6Lu5LKlSmeBDpskS9M2g30CKhBzGvs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nhr5ZbGT2mI14gla9OgGgw-VivDIgmBHG2RcM3lu5Sw&oe=6A45185B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWSxkUEnqgIQ7kNvwFzUU6j&_nc_oc=AdqWsyhUsg3GQMhX_bl1bhEIImxJ1adP90SG2edZFt_x5SDR2kLdT6cqlFR2PHuSFxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CpQNfk44dqWA4wW40CDJifQ-e2_gFFej5yHo-dynltQ&oe=6A452F4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ5CyqIJpL8Q7kNvwHFX4od&_nc_oc=AdqE26hpxXCHQ8HmDAAxNeCbVhpg5ETdhPa2FVa4meE_lzCCwIcbHenB5qlvQ3G61pE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sAqKDsb-HIidgB_jGKE1vKSNHGaGI7HOASTtLxFzxlA&oe=6A451936"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPbgJdsHDtwQ7kNvwFcGcVn&_nc_oc=AdossPW7yJFW7UHnjvea9qCWo0q694UdNf2ATVAYgIJGwGreIoNZ2o1d-BgMdtdxJ6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qWMokjZWr_4rPcXaiqzgPN1SZQGsL2I8RC0TjRD4BIQ&oe=6A452E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h2nDc1RyOwQ7kNvwH98nwT&_nc_oc=AdrybQ7Zj8Mrx_SyL_iWfUbgfo_edYfP6L68JYCyWQYwnMa6eyHUREmOF0FIR4xXG1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eratyAbGRW-TctLWd0VJ0C5dAoRF9ZA6YabKj6sk92w&oe=6A453272"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY5lx2jOtcEQ7kNvwHxQW5x&_nc_oc=AdrKiz25UD2o_VcPnoJEYtFzyBQ3KMeQqzknJWWqP2m5D9kHxxz6KG0vMeXkMHywc-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cnixb9HsfqiuAiCeCgcSN_UJN3dlVyoSiaB0dDuNA_g&oe=6A45374F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
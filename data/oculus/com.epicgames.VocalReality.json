": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIxRNsPZ_HUQ7kNvwFVRpWE&_nc_oc=AdoBosHPCzsUtXK9c5_1VFG_cd0lIpkpPexuS5BWlzsZXp_G7TYC_u7w5u35a8xR-jY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aeZcQZLlx3iOuBew75NrgC19ZLGMYsTfhDLnJwTH4yw&oe=6A00A2CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHy78WE-NM4Q7kNvwFwW9PX&_nc_oc=AdpHtBhosPV4fxV6468FnVL0WWlBtqU8cCDjLdHZsLwz_9WYNTaQftVAlo1-l04KdUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gDkp2rjMrwnH2T1rPgtBy4UFk_YO_Y4pDb-RTQwpu4Q&oe=6A0071FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sow2itHbfqIQ7kNvwGK5vq2&_nc_oc=Adp7n0DZruiL6pZ3IOsMcIqmwTPYEggzXoX-Kkt0mzP3-y2UphReNwzjTpwX3yLy480&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62oiTJX3L64M4HutrI29GzFB9dgWzZGGvQwFE55wPE7g&oe=6A008A5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkz98LlrWRkQ7kNvwHdCKT-&_nc_oc=AdoOOj7fC-xfqgm39KDPwpw8O8kkov1eSMSK87NHGh3AqTk0GAUEQ8jjObcsOQqFRHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GBfA26wr6WgJ9xsqP44xvF0-4Snj5NhxUJzg3DUIqPw&oe=6A00A14D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMdhYXmwRrYQ7kNvwHRYAky&_nc_oc=Adp_PAapl7jl-tpplgKbwNTh4gHZMr6RDjf0PvXV6TD8mvoO-EEPT52gyM_NeFhSir8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BxekWjrMvIkYb26XoKiawKa6NMnTmF35fj5rY8lwSTA&oe=6A008B36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umWmjvb78JAQ7kNvwENXGM_&_nc_oc=Adqzx37R_m5a5lzSAbhG1QFoBLNho5CNABFSks_4DjRCtsGXtPba8IM7grnaGZlMPSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4usZFzu56ro6JSoGK-54C8njHQtsD_tchTQkHMMNh8uw&oe=6A00A05C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgXp7IF8ILUQ7kNvwFu5CTJ&_nc_oc=AdrNr3wLvtv46qythFLh3DBexXEkcsaYvRIzJRyZlz_hpO3PziXz7H-zspicaBjdHQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Or00UVwbeldiJimEIivaYmS_wyNTNKUQlfl6d109gEw&oe=6A00A472"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr3gZzIMTdsQ7kNvwFrxG7f&_nc_oc=AdqF5ISW-_xyVj6GICPQ6L-MHWZGxvoCyWlzU_2lt-KiUkJpSo0I5mziwiXv5vkeXbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OUzPq8iC6FvRsocUXsRE8rTSLaL4ME4PnlUL5mXm2lg&oe=6A00710F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
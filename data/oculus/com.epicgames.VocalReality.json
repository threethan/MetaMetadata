": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwpFThFEpgQ7kNvwFdJCIM&_nc_oc=AdqNaDPkXpakP0s1H4ttWPKWQDa3p9OD9y6IkdGN0cX0BX9DISSBOAH6OsBkTWQ27CI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fa-FHvLOQ4dQQ7TGothpdyGmI_XAr_vDMpeo-LpP6_A&oe=69DF750F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvkujKBqm-YQ7kNvwHEMF5X&_nc_oc=AdqYIPeqW_Zqu_MtIO25ognzjrWeRGTBJ6Jh-BrHd1lKtCspepZyEXjFi7J1X1tw8aA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rBmMFMJ6HWkdTVyWjoC9yha6b42hc8vCiOblE9hEdRw&oe=69DF7C7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7IuTjCDr28Q7kNvwGlCh5_&_nc_oc=AdquUm5daEjBkBTFWnJ_4yRrPuIvsfWcKsFm5VxtVD4Rp6-xlXfbR8Ashkxh482IIGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fZkIo_-f57_A0_P9-n9CT7gISAsD6IqVeXQQ4mO5bWg&oe=69DF94DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G0H2YonRQgQ7kNvwF1uiYe&_nc_oc=Adp2c7paEbuHhLFFVfR7JBFWPFu83896pbwvEeNhSTYjUJNaTzMP_80O-h5RWPUQsFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xuyImYlw3koNIJnqcFOto9E8brQgyfd6_WkJZ6YP9yQ&oe=69DF738D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSuLNoTW1pIQ7kNvwHr5Z_U&_nc_oc=AdoS8G5o_NiEQtSp7CIbsEJrAtB5z6FqL91v-gtdtBceoKbmIu6-9No04W8t-UPQFRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29ofDjhKAzkFTS1ESa-_BUHXFwtUCnMpFDhVYlc_ttjg&oe=69DF95B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpWymXNiQEQ7kNvwHJZJtY&_nc_oc=Adr562h2qHK1cRe2s69pPVN76UwGxVoJw3gmS9w-niJYnUne9XKYSxnCVPDY_-hUY5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C0n9sFdhRatDRzGDAvR-STN6i3fGQG0lFeJDz88xtUQ&oe=69DF729C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLyrHMTVbvEQ7kNvwFki2g2&_nc_oc=AdqHwKJTbpbZaodbKaRtd72xVKAVfuudFrxZZD90OoY1PxtnWKHIls_49dH_QkgsVxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FFGEiiALiWZu5sG3p8_R5vKiAUvv-HtrqGUv2JIbRWA&oe=69DF76B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6er0iVdyhSkQ7kNvwH1BpWq&_nc_oc=Adp600vdZWisIo2oy6i7agIm4LP17sHYpMsALoA9eY8nTE2swYQq9emdVVgFTTNCuvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_gaIvsVOqpy4D18J6JC-lMbPUqtRzHhBURc_uRAHK3A&oe=69DF7B8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
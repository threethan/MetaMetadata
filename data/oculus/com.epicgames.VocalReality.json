": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGyj95r4yBEQ7kNvwEQAr7L&_nc_oc=AdppVn7WLdACXd2ETskeQaCjcjeKvP88adfe4CVlej1ivzA8-CGjuojjxV9ilGX_blU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-9a-jfwBVwVLehdrkEtSXcpmy3McA2njB-XqdCakC8g&oe=69D2460F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YICpKK_WVIAQ7kNvwEgHqxL&_nc_oc=AdrNxNhBGGRSL6OCVY-sizL2oZy7UULcZ2xo8kaoY5p-EEHPNGNl4imCwqSnfYQfOzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V7hgdie_O23QPZNkieLl3iIh4XdD7yqL_DjeRX7Bd3Q&oe=69D24D7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVZ3xz_G0vkQ7kNvwGFI9MB&_nc_oc=AdpBHY92akmF-odUWWUS9m-97xDix0rfybfxvZp_AC30e97h8uDt8eS0k-Uh6FEHtqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ooIhWJFdvAT_4rgzDNxOct54AIWB9fBl9qfo_VTJ6ng&oe=69D265DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEMFY1LRS2gQ7kNvwFDV6hk&_nc_oc=AdoctrQZcscsRGL5W_j5RqAfsr-_pDfP9dC6DIvjIzrzecHY-MJrxl8UtNgOf1O46so&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D6DOeoLksoi_xBc0sPvSYDrH3bYRTbEOeTYccSyL0Fw&oe=69D27CCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCOGlfEWMgQ7kNvwFELrZZ&_nc_oc=AdoVA58HSewrS29SlA2S01JRQdQLdARguKaulBFxEbFPawpKgzjmdo8nBKSgBV2KXl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01FpgXBL9dqlaYQa9IAjEXIw2Li0AO3Xi5cMHFf_WdtQ&oe=69D266B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BmDOVJFZYQ7kNvwFaClL3&_nc_oc=AdpwAJkiBp1lIBrOfNsB2mCUGP3Kg9bHcLQX8Moji1WePIWI0OyXUWNbGv5wC1YwaAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xcBb7nfD6mb_-5xsh24TaakU4YYzzTp4Nb7spyHw6IQ&oe=69D27BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHKnhyXSalkQ7kNvwEsPLk1&_nc_oc=AdqZoesjneCW0qTjeeZWjzmTo-VDwrDPf3_Ks_YLyLPdeqxpRJta23GJUe8qmEdHuTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gg7ebQboWeh6X_eKlKtg7DRZbamfafQQLHr-Nd1NJBg&oe=69D247B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9_hjeiOxJwQ7kNvwFX8uMM&_nc_oc=AdoT_ji7cUhEXBGMb4UveNKvNRHmErZekOxPgZjbkwo_QE9p_xGMFYu0_Vp4mtv-08M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tj4IloeUlvb2GGpsAdt6ivsKAmXtsUkdj-7g0_D_n0Q&oe=69D24C8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJsjufXDuAQ7kNvwG3KgCm&_nc_oc=AdqmJdUMLW-3DeqWLrVzuYrew_RB18DqW9KcnAck61NMsBaORnWSTJqhKuSqbGjUvDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMoDQLDe0ZY8G4ZYh11G8lU-rzzFPsQ9jY6rCGwDm7Qw&oe=6A9AE24F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVDsLg6V8c8Q7kNvwEJqg9p&_nc_oc=AdpVQZTAJeB59pprouR9j7tJYiPh13_ln4jwYnUUll5NTTPDJ9it1nyrrGeAgYsMyts&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl-w63WsdSqoF_-wF5SemRHC3VlX09ol4tKgkwuHzfBQ&oe=6A9AE9BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xasveDcSVEQ7kNvwFtHBX5&_nc_oc=AdqHhosjR28gWOtSzaNGrcGmqeSylYmz_8y1GC3AXchPrxhRoq01n5UZ5bDGcvBNjWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEYUku15-298MPNXFJC7vutRDHRLvfP7WjLpYX4De0jg&oe=6A9AC9DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1nXn_UH7NMQ7kNvwFyMzv-&_nc_oc=AdpmlvGoG5uj4tfTv03V6550a-HqXJU8BVMqtI6-tr-sKhLEMLt_fRcm--wp-JddAhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhkYSxlYKXy-AvAKo8NPpS_bxuNYobz6iwcJZMHMetUg&oe=6A9AE0CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=704AOVzRS7QQ7kNvwGOyMEv&_nc_oc=Adoq7GxnSOPLYe5lmmOegFbbRZsl81WeH5H3EjOCYDJ7N1RJrfPUqU_rAHZ1M8I9LYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjBeV9xrIjwh4j7Z_fvp3dyDYoZaBdRFYCWySq0uHGPg&oe=6A9ACAB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuPW_nJm40gQ7kNvwFkvOZV&_nc_oc=Adr9KNAUMg1SxFITKAn3imyVrJslSVehNO00dFuUTq6rLP4uNlX-mc5JFAAw09jGTnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3EvseFgVlHCJv4eLOIEMB2ixH0fb8GHmBDVGH1_luag&oe=6A9ADFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guFDcYH1OOgQ7kNvwH7X6hy&_nc_oc=AdqfjH_TF91kLZ0TaVPRcLXoFg9EEkEegLQ9FRWOYbqADAZQIR42dMtv-EKAPnAPuBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuKX-m3ao6Dh887YsjIeSFPlF9qv8HB2WV12S5v1LXWg&oe=6A9AE3F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4CImBHN8IUQ7kNvwGlqZHy&_nc_oc=Ado6XbnBqibxFmYDaPHwl4KEp7yXR4bQihu2-5eSJKpq1SaHDtPBsN1J4Tzr43ggJP8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWawqXKMtwWO7S6Ai1wfqHHSreFuRqXDYsVoSTNfBx0A&oe=6A9AE8CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR8gfuiXbKoQ7kNvwGmjtpX&_nc_oc=AdosvnvRNt7M6xHmXcatKAxd2QW9fpMSSsmafC5K6agTHW19jpuEOc9wMrDJK87dhb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3AvWeP4VpP1LF4V6wIBxHByCGX074R9T2xSojfWUEwQ&oe=6AE2134F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji297-FKqH8Q7kNvwFr4NMF&_nc_oc=Adric7n6S5ea5DUYkSwEilnHVBhrajGLqYOhAi4P3lm8CssLGACp6A5PqIWNddaHkYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCuGvQJtb3s9wZHgv0CNjc2JtOKka2PykXvaa2DJeAaw&oe=6AE21ABB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuEuI5xHjg8Q7kNvwGlGTsw&_nc_oc=Adq3C-Usg0dul8yppM5t8NeJ_ufbHv9nZG00bDJ1S_MNgmHdH7w5typOQ6-bls3-Bzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx98tdL1okrqA0FWkMau5sLwMO2eY1IN8DoxQG10lKlQ&oe=6AE1FADB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3z_4Ot4H9gQ7kNvwF0IpYC&_nc_oc=AdpqLGFxgxiGd_M1HcSh7F6mtphbshrToAM-vRj1xWEnKfv_mm8lgjY3rUqEyQAewd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH3ecYhmt8AZSk2xcOM6W1w1Bcqq2HcR-oSYNkrpRFSA&oe=6AE211CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA8VLVFSzIMQ7kNvwEhvPfa&_nc_oc=AdqS2_9QkLfMLkTVQhalhJo0bg20POcH3ErPrJCX4b1J6eDXxFHeupYmRZXGItRjbgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh0HtMDLqgz9-tHxe98FpZWc0xefvLXcFabfbfMD5_fg&oe=6AE1FBB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyGfrw7YPfUQ7kNvwGFaKJz&_nc_oc=AdodFOsReIYShmGlGkE6NKulEQItoEPbTkDASacwqenNpWChEJloMvN8C8XfA1HMNyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHzYLIWGUpi7OL-HcwTr6xzDnN0E319lw488Q4RtmhyA&oe=6AE210DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyHkV38qADoQ7kNvwEvdx9E&_nc_oc=AdpBUDK8OEz3Gi10wwjfbk82lKtDGWQKoGnEN3zj9AotDoPXBFMthw6unybL_quI2hY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgOUdChrK5un_e2GhWZdr7gV0AKngQeTSZrIEKz_zxvg&oe=6AE214F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ntnhGycGxMQ7kNvwGrVZWa&_nc_oc=Adoxl-AM1KCMf9B14wgdc69LTxPnoqBUSr2ZwnQWgrIadD3-XWVMj1-d7PEnaRpnW3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlahVFnj82iD9ZlSwtOcqWmfPDdAgvmaHpYRhLbi_Ujg&oe=6AE219CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
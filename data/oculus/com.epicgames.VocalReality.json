": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6wAV7M8sWcQ7kNvwE7KBtN&_nc_oc=Adq0KD8Kjl14OwcxUVCQ7VUlNs2D4LzZjkdrTVsMndRqSU7hH2T5izhK8w8XioeJw7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzuvNNgYj1TqiUBxffG-09iuvKDbY9KKMTTGMkEVWqHw&oe=6A5F568F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqQJHhvZv8EQ7kNvwGU7T9z&_nc_oc=Adp-VjiMCPsI_XszGf8j6uOAZIojKSbwU26hKrFHeNmDn9jTTk-ynEQ8HNaReE3PCgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPSfBFbsnmRCf_BVp5XPN4i_fTM1CGJP98MFaGbOHvMw&oe=6A5F5DFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp2DATOJotsQ7kNvwF6ufKF&_nc_oc=AdqeDFonQzrUcj6ahDuUR5WSb0S3Zq6o1ODNbhaME_SqrbqX6xgS4ECTtyu0s2OYGxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZMyYBdds--wKNJqps9NA-p13gp6bbGA0BB3_giayQog&oe=6A5F765B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvEoXwbi30AQ7kNvwEXH6Je&_nc_oc=AdqsqXi-ZvHB7uOsRQ5G--ts00MyMJQtQgjc0uj1iK7DJaOAt8EDp2kB71C_XQKb_lo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrPmva7u4CmVn-zeK6I2CS5wGQjSGqRosQxfMDtDzJ1w&oe=6A5F550D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lcSccboNwAQ7kNvwFBcwIB&_nc_oc=AdrUSN4QGdtR_KGE_o4etNYxYXr45Firp1d3EYwngFSXC7W5hey0M_cPOICUHljpJzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh5XSwyaowFnpGQnpxFTB47dKcWkXtAPQOPfcmP_sHew&oe=6A5F7736"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG5272ROrXQQ7kNvwHu1i29&_nc_oc=AdrS21rEz-xhZvHdUjeKTWHiODRwd-bkhxESaj8gOG2Cs-rV0azjZ0SZze9x3E-CV4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdjj99SRqTBEXRG6-csGOphALw6hotAqs09Q_MXNDUfg&oe=6A5F541C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIQRPzgIDMUQ7kNvwEn6bg5&_nc_oc=Adr16FIMctaRQbckuKdq9zgXu1cohF_eHaW2cCMUadHOKCgw-XhuhiepvBgwHXFk8-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP1Y5kU1qcPtwtHTrX0qT7vWC5ymgUnTkM1-hp0yCPZg&oe=6A5F5832"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyKVJ6ZthugQ7kNvwHv4TWP&_nc_oc=AdqJZWbkH8vAh4vo9_7YORuHIfxcazfpIxETtYnpR5T3dSgGToaRjl4BcOy4K36Tu_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1l4nHylz3jxi19-8_D1Jw5Zm9Cup4QD-3UtGiCWtaeg&oe=6A5F5D0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpvYD6m_A6YQ7kNvwFrKT9c&_nc_oc=Adomx3eO-vRCMyRCiOrg5OAgHNQ9_H5qRgSpJC_AOXqUPSuE556WDT5ag-an43OAR18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JW1xFXUyQ6SEui6YQ16EMKrqIMKGc_5jCDsbWjiOFwg&oe=6A3801CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y729rVHHnYQ7kNvwF469Lh&_nc_oc=AdoDPX7lGqpHuin9rN3jUa-f0VIozz0gedVPtJo_y5dyJA5tpq5SM640xS5QsrsRFoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82bPs14AQYXSHdv6MiTgIfAh7-OhoL12lW2h_W_-IWUg&oe=6A38093B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3jVS9t46IAQ7kNvwGXC5yp&_nc_oc=AdrWeRMhjMPeRYOFpBd1oY1WQQhqq9m9tX0relAUQLgcdJ4p8fOzVzDDizzrTjdLVkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aRtDLVACVmUeDPcC5Ql4hRlL7tUljmJULOGXlW2IPrg&oe=6A37E95B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SRMnp4bc4wQ7kNvwGOdVnO&_nc_oc=AdrEWEgKXG4I6PGCNQeJIR7XKs3FtGxbpcTjPd0YEehuhUy1Axl7MG_fiDe-rleXoCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IEhsaDvg-rDTj4HAH7QW1dZfRlpZIe-_wN1WGWvk4FQ&oe=6A38004D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGThMuDhl5cQ7kNvwFpUtpc&_nc_oc=AdorWR77VsBv9grjYH6vwmqy1eir0GOftiODmLRQnJ-6KmWSbHWEKYIwjqTY6XFyfLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BGoSf1I-JXme41RcankOaF854JQfWkrMJbk8kL0xOrA&oe=6A37EA36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsOhs_3LIpsQ7kNvwFwAfUF&_nc_oc=AdrM5uESRC0tGs3kZTdJKZ_lktIsbTnbUb2T1kyoDSgAH1XNYC6jCLo89oP_l3ppUPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AiFYYSGQ35geQFkP_wl5vI1jrQAtdIrM-6DxHjefUug&oe=6A37FF5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8CIEJ3UcIMQ7kNvwGUDn9T&_nc_oc=Adpsr91acl9t0TBHphBSK3WZzNtJ7L7OAdhwrKIz5JjJuP_pXBPQ47RwzhReXWULILk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_44LmG3FQNIQrUvsqZHu8b_BUeyQD0UcjbB8i7d3cHUw&oe=6A380372"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXXy3U-Op2gQ7kNvwH9RTX4&_nc_oc=AdofiwkfoRCKXphH-mCVZCA4nkmEaKg7zWj_Pcm4O_ajYry5G2I818RqgEn50V3pxGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qkpNq0o3Dz84hajlEO9LmYq_kqM1nCK92BHad6psgMA&oe=6A38084F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
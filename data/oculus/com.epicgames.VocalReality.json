": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yte2tXPHBJ4Q7kNvwG5KK-t&_nc_oc=AdphY-RlBCmxFIMpX4usdBVWuATMPaFHmxOwKh1mi3NPY3nDgiZ95P514aWRAisbv1c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oMqgjtS-4iBe132BcDunp72dXN69_ZxcaPy6-jPV3xw&oe=69D78C0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVWMr3N6qQgQ7kNvwFLeQ-l&_nc_oc=Adr7IK_VkmDNQ3teccQ7VKJb1L8ESKDfUqdMZ7LEBD3SbdBsI-k304xQOLVOvBDGvow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1URwJe2XyfIWaybPaeRldpWeRHZ7h_RZPe3ssdPn4HPA&oe=69D7937B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSpq6_h3wykQ7kNvwGoi9nW&_nc_oc=AdqemRMM9pOOI0biEWOPytXYVWJCdNuJrCOzgLUKR1gng6w8Bw_OAU44KPMa4wFwBjU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nQVnu9XRoXEHI43jmxphPV56lH17tLQ8_kUNBre5lxg&oe=69D7ABDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TNWN9xTJEYQ7kNvwH13PWV&_nc_oc=AdotCHFngSQsegqLD4Yy5DhmM32j3YxcxroXXzSnrBjeSPa_-EovQEVFN0pmtOwBv5I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S5LJCl36frQIr05eehD4RwjE9VvyA7WKBTLd8Fb_LjQ&oe=69D78A8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PukC_WecKH8Q7kNvwF1JEHX&_nc_oc=AdplbOdDqZWvo2T7aS-I3fhsEXhEV_8ixDscnhKQSJppWp4mFJvlCOPd-QEL_1f26Vc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WoLDzlR4oSz2DgmdNaOfq9Ozlevgw0KAS9YBGoFUikg&oe=69D7ACB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu2UosQP9fAQ7kNvwEhn5A7&_nc_oc=Adr-8rcPsO1HG_XUGkKNJTYBv7GkCNecP-iAKRrMgRnlfi2o08Box16AuTh60zVkbf8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af372wMEjlYEFj4n4lSwzOXkjkerU0ZrSyhmEYELaYyUGA&oe=69D7899C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3SDzFC50skQ7kNvwH34blk&_nc_oc=AdpHcUie0f4wyHeR1xiyhwP9SMDMA6wrCNRfiWl_S6_DUnf33erzBXNwdPsLNyXqJYk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20RtWKHXUQ5qpCcX4zHpjH1cGaHV-KJnc90ySGS-r5Ig&oe=69D78DB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbV9G2Mx9gkQ7kNvwHqoqNl&_nc_oc=AdpV8WntyCmp1Ijj1UVa1yjttd8sulxSfOsIQoY3T8hdg-AtiWiMcZv3Q3dgTPGwfI8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kWK71Orp1dlkThrssnATkvJWkO3XWb2fzBv0ThMi53Q&oe=69D7928F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56bmZg0KaMEQ7kNvwGRlHJ8&_nc_oc=AdrsXGpMmNIFeNKNbFZOeP6OO2KygL6xn-G2mft8G3TUjZPPA6XnHG6cMCQnxbeYQAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0UtlYsdVNaZOhjTV15BQI86nXY0UuJxfckGJXI8-cdA&oe=6ABE7ACF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1dYarNfiDQQ7kNvwHugBc_&_nc_oc=AdorbxLofroRlfz4hoHWez0jONo8DPThE7euWTnieo57ySyHdEEKNVNUc2Tg2OJZsTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdaYOfmVdUduQMNC0HYl7O1eF1Ce7cqmDfqgpXfYDaoA&oe=6ABE823B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jClrxxexyLkQ7kNvwF-r0dl&_nc_oc=Ado2IBr8LFrdT2cmy4V5oRTRGSkRgLH6t9i3_IPTAM2kafU1exs1rm2U7JJbJp0Vcwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2pNgdPY5XBwcI5GDrrOZEVCN3gIhRbGnarBJLRcAI3g&oe=6ABE625B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIf7V8cEW1MQ7kNvwEJTsiD&_nc_oc=AdpLErO5dFSpP3gfztSwBEoSshuTxzF2ctPjJWKdDDA60jY4qm3bpKdOjJ9DvWLSKSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8I8y4MDMSgAi7cVfF5GxA9Xa0upBJQd1wAT2OqwYMpg&oe=6ABE794D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-czaRywYSAQ7kNvwFlNdQT&_nc_oc=AdrQUSotzlq4TwjAE-V-pmf-LwIr39svX8KQ-w4631ar_wynjSCFfnnDQgfhNStk82Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqag5-ynfTN5POdqs9VMFo8jfAYHlquLs2ZzISH2dhfQ&oe=6ABE6336"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLQ_sLfrjo4Q7kNvwFs_ZEf&_nc_oc=Adr6oYBdeNACak2bl1suMjYJ5hHoDkmg1oT4-b5nIiaSRheSKVFYaX8_MrR87Qufe2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdRqZFcn70tAmhnYNSaypxujNR51A76QqTnOuhypn4Ng&oe=6ABE785C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlG5-e9Dp3oQ7kNvwHvkTjy&_nc_oc=AdqUNpR8XVoFtD5YfDpZDKwLTQSG1VR-bZtsiu9g4o8wcPCCAkm5rVoEqutPHe1xAAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw5iSeg0ik_SORX-hpODpQFK0tw-zW32-Nojo5nIuSFA&oe=6ABE7C72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uE5qTBF_YIQ7kNvwFXqog0&_nc_oc=Adq82eA4_aDZT8dvOFdTfmRNj3gweNVMuRSJZj4XLKzEMwMD3gFzZe3kc3P86VmuXjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ73RsZl2RBK1W2ChP7Ry1l0f51VXE5CO0r-wK6VT7og&oe=6ABE814F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
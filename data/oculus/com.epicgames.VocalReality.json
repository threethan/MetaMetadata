": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wCTBJAWDzgQ7kNvwHkQvPT&_nc_oc=Adp3BOZfDQHPovq-F4Bd7e2whf4sKYIiYtIcQm9bi-8WrjI3CHLjd46BZ2X5a651IR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBd4cqmVxANYKb32fG1vYDznwunV7swV_cEuI15XU7Ug&oe=6AB691CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTx5NYPXwGgQ7kNvwGKj7RF&_nc_oc=AdrqLO8y2GUe3KBIEQ2ogoxpPS6oDTd44LwiNPzeOYQ_XCdQyi1myPi1pDHXBEzClk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTvcTJy9WCbO67vbvTsXZzc9NzdACo56WHvtFyPKemyg&oe=6AB6993B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjCED5CSO3cQ7kNvwGNN9PZ&_nc_oc=AdoHIAgo85rnr64Syl7TsWeFq5FH6zcY0aPyfUDfrCGmIe4qq4h_YRaYYmggeD_7Qno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI84AsmHnGEgtpxHunzaU5dkLIGfAQGtNg7XdaLUs4Lzg&oe=6AB6795B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkCCkt52moYQ7kNvwFWjz2u&_nc_oc=AdrA_NPoBnDT9WDaDfHFyrBC_dha2Jufhlq_F2DOLdtfQfAFn0daLK3daV4HlK2ptvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ-2bleQ8yKzzZavyrPP2v6KWDEEZ2WSKvvZV1WCwD0w&oe=6AB6904D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1DkcjLH8UYQ7kNvwHMTO8N&_nc_oc=Adrl9G_FZc9ams_pCWUOhhxY9CVe5txRefCqFQi9JLXCQ4fRxQV-kcyRANPup5G3Bfs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICnLT5SG4CSr4twFYBQI_BhmJJjnCn8hDw06bGs7EXMw&oe=6AB67A36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc9lO6Ye1NAQ7kNvwGiKgrd&_nc_oc=AdoqxrDOheXEwSy-uyk5niRm_kyEggAhFVzjcWBfb-WSPtNHAF8tq6yYdWwZNb9TBjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNq3BVvRl9RTBp3b8ze8bprg2paEcfz2AoEq8RNY6mSw&oe=6AB68F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbrfvEvuVhAQ7kNvwGfCJ6b&_nc_oc=Adqw6LNfW_SDbQR9sr2tjl_jbEYaexJC3djLQy2cLo473cY98uuqiGAznig5Y5UO-mo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7lEHT4bQRwmp-U4H1LfzqP0HTTNkOkZHdbPh-X9sN4A&oe=6AB69372"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KbPO3c_q5kQ7kNvwG0BoNv&_nc_oc=Adqfs1_JLEVa0xiXnU3Q2ka-90cP1mG_QWsUm5SCRtj-4PX40nBcTuw7anLrME1AU1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg3qc2PscdNz1InF9WoN4KWE6-ezSx-kTvr-jL0Ym9TQ&oe=6AB6984F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
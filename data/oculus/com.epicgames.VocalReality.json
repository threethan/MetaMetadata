": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IYbN6LGOnoQ7kNvwFim9GP&_nc_oc=Adqw4e_-MOWzOJXraXQvSzbaVEbYed8jrMolWaH-6Qg6y0YfOQ5F7OO7172azo89Rjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI198rHZ09M6_rI0RshGJqDjWBpfdmk6AcJurQrgMDDQw&oe=6AA56E4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7imL0j8lZsQ7kNvwHO1aGG&_nc_oc=AdqM5g5IcyzlHamw2St5CNZuvybIrMisEzQ23lvA5LG5VG662OCTkmFfjQwxngKDxek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKnCBl1BpVqs1ju_iMOdQH1y0tTXHEUQv4FEUbyyyZvA&oe=6AA575BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZOqXwEZS4gQ7kNvwFJ6t02&_nc_oc=AdoW1cZmM73iWH-brhKp_IYwrT_Cwn1k9B0toK59tYIWb6ZgNrWmD1ni1iSl0ToYi_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA6I9SYSi88qZMD9zZH2iIGHYrBlMGUDtY25xh3__MwQ&oe=6AA555DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWU7tCSjctgQ7kNvwEZVPWi&_nc_oc=AdoZOaMUaMBsXsZysgPDNpuUlHFkXz1bp8Y-r1GDW_HHyPTwoo5y5k9Evj2slA8F2sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcP1qf0LIlIvMe5o8H-_3F4ScxVDt84D8TUFB2NsXayA&oe=6AA56CCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJphqoKhmY0Q7kNvwGbNkVV&_nc_oc=AdqKG06zR1pN04oe304HtkiH73Asmw9FwsgCDyJehcDDbnhIGlaAdSZUZQfK_5vluXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPJVoATz6lcpGgnW_NzKVcan1XoD7lA3qgWjb9Yl7rpw&oe=6AA556B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTuec1T9_SwQ7kNvwGwxqCc&_nc_oc=AdoDSpivobCxCH00f166tkYfgl0iayn_Ef63QosUQP_JSPk-BryMaFYKRsQTs5bGOb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx8ePW97s2-PwMcQ7RbF6E5QHdOa4Ir2gpPn_DPNdVXQ&oe=6AA56BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfySXa9QLS0Q7kNvwFUt3rd&_nc_oc=AdpE4g0ZnGAEHlCj_c9r6cmK8oJ6RjUB51N6KWb4lERlodIfiLrhi4zObj65y4Bz_R4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU5g1exvN4SzpEC7QwdoiZk9_bu6FyNeVEnS2T4YbyGg&oe=6AA56FF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R-JkDABdpcQ7kNvwFk5o1R&_nc_oc=Adqz8rq7B5nZXvCNZEkUh2NnU1RCPTuXhqR4ovMm5d5OkexCzM_UFwR5jJlsallekNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkGPUDet9Bw1E1bsduBuz4Eff8cXi0J2i3H3LI5PhChw&oe=6AA574CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
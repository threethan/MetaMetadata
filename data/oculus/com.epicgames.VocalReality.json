": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEjnxpGWspMQ7kNvwGkrcP6&_nc_oc=Adrwedz0m-4SCkXGBPGhp8dleFekSiN0pKWQ0d8h1mgUNaxcrhVI03W1N_V7O0iScqc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIIBwdJPAmjiSeLtWP0MEz0Hv6kwRaQQXjquABSnb2LQ&oe=6A56544F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_jUBCYWSeIQ7kNvwG08eqs&_nc_oc=AdoGAJFsoL8opghZ1tIACz_5-f-RboOhpWWHe02pRPPEQPuu5A8RqqP13_rZM2BYn74&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL43BgMmZh2WpPnNSeYFoXRbC2FXLF7ylDVJk5a9benw&oe=6A56237B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU4bty6IEAwQ7kNvwGI7D96&_nc_oc=AdqlHp4_5I74syxWpZG43davEAufru1Ka69aqUUrTcfUeawM0gWGfaM6gszBYO9Q_p0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwB7o5f5WGOqviUdyQvAw4Uy0wW_1gKoov8F63TFM5-Q&oe=6A563BDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nPJB81umSIQ7kNvwFTzFSj&_nc_oc=AdoONLu0v6hPpSQ1nXX1K5GR2Ht1dz0RZXJkSsXMKjxYBGfprBkdggSoN_DICj7Xg1A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmSGJnUBnkMSzYx96MbwKpgx4zEMt_6CmM_r6R81Rb6g&oe=6A5652CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlzAVrxw96IQ7kNvwE30lPe&_nc_oc=AdpyzgB914tC6Xrlh0B_CJ4sG7-0o41cS866BfqEq7A4tJkjNTFYdNJLKC1OA9_yEY0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGy6HnAtnWo22T3PAqb2nYKlSHPt16OdL6kRBZEoJObg&oe=6A563CB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Lm4q-59VYQ7kNvwEIv-FU&_nc_oc=Ado7oLvowOLn0oR2WwFj8t-CyflmPgUSnQWxkMGZ6d11qp1KbIAn09LIxk2-JvQl5W8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCrGGjd4xMKuWhks_tsng1WpfWUuX5Ilyh78kHlhzuEg&oe=6A5651DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvKMAzvfasgQ7kNvwHt3RMp&_nc_oc=AdpQ1sggUhQdctlN41bplq-wRUhlfaf3FulJ5nH3N319Eh-qbBDJxaT1VLR_o4QIDYI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATg5EkOftHcY7iLrnZH5cZseVKw3BPVrjB2R10ZhVTMA&oe=6A5655F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD5QBqHB4g0Q7kNvwGgEpih&_nc_oc=AdqzzH9a2GZNvOlB2pJPgBiksixiEYCOH9cqsNWjDTkaY6P-iNqYbpk7CwdF9BHwhQc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO8S5e0XWtU9n0B3GkDOF_W7jjWAZ1wJKQXD2QFW601Q&oe=6A56228F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
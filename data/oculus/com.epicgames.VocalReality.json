": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCmls96UhsYQ7kNvwFrMRnI&_nc_oc=AdpENRoXNIcri4aBs90PjLnXwhGdNsWLEXXi3d3e2UGxkcWPXfItu6OMTKIQo8tzNwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhAw268ehRmlfDKiPTNVfausXzn_bva5-aknLMAqpGDQ&oe=6AC26F4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dTimBdIEa4Q7kNvwG7d3YB&_nc_oc=Ado6AByb8ERKohuIp9vgjyV8vKl29aFnd9-0hsLJryIJi8VcbrL0m_duZrwiH3YW4QE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi-YJAps3eKxZyUeO6OlJr6JmpmkVjXkKdF_BL-SXRJA&oe=6AC276BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWmRlktZ0wAQ7kNvwEV3iPA&_nc_oc=AdqmHnIwvFt-OjzFoVzC1sJM-RkOlI8f973zdC22hPkrcVfMKfiu58AUdBBGL_auKQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR58_Ye0KdsZhVT-ceJBsFDXkZkZYPSjpi3WZJXAOwsQ&oe=6AC256DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDuC_USJzyEQ7kNvwFPpXu1&_nc_oc=AdpJIcVdtT8TphOTWfwV8epk_ETt55sxWE9221qXjk-RmFaIajkTAwS_tCUiTihc_Fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAbmFRvau4PcxCHZ_lrd0SaTfEbBbbzBnH0vjVoS9ztQ&oe=6AC26DCD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZV4YPb08agQ7kNvwE2DQ3h&_nc_oc=AdrK1qbs-OEqV4Y65JrhuAcgd4pcHLc3jwKW_-Jmk7szFhtb7OC6ap51CQqAt-0zQ5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6RYrF6xYqlpCKALQCon2qiDj55S4eiWcW8qxgG5dv9w&oe=6AC257B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVInpt3ubx4Q7kNvwHANL4A&_nc_oc=Ado4_kYKm0rpuEdMe0Oa1Pea1nGsTaeUMaxKqhlYBvYfjlSoLsC956o8w1kRr1uiJts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWqTi1QlF6-9e4fdZu9JQlJPm_hfxHoGZxb_SdZTdvug&oe=6AC26CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSTrgvss0zUQ7kNvwHojRSK&_nc_oc=AdprXWwNIAyxTrxkoL0i539sBNmVahYRVs4kn1blqgfW50GIpPpVac904pfXYZLFC9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7sKCEDdwlBSO7rIzKuhnuYGZWtM4tHACRyflwqj179g&oe=6AC270F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgvqKya-mLAQ7kNvwGdjHxJ&_nc_oc=AdrU31NMK0oDtZfJIOGUBQYQGymFMnPAOOvQ0D6kWhjOv-TzotJ2kyLoH5TzSvb_Pfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIPRSG-tfpw_EO4LqYUpe4FC2qRIMniFPBSxW2PqwbDg&oe=6AC275CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
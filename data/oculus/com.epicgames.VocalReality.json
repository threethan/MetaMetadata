": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HANSsX4GiFQQ7kNvwE3pQjs&_nc_oc=AdpsxinFuP4PYyHLXSJjmyhwvNPY0kq0TUZQCQ7GDgX0V3rzKFBrw9CO-cN2AMf80_A&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kasCHcvpRTtqU5p5Rrar79Sj13ke_c4Mcl4kqIaHwTA&oe=6A1074CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inmuJLP-0qEQ7kNvwEHaDZ9&_nc_oc=AdqevVImTwBq_3GqLuZHOhyb5yy3JWaWuK_tdhufTQEKgVqgncV_gn17aaO50EHq0RU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SO1WyBQf0tyrZaxRLFfqj66d2_JtvX1pq4-nrP6ZMeg&oe=6A107C3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAt5Ma4LcEIQ7kNvwFM-2vO&_nc_oc=AdoZLQlm2A3PBGg-C8jo2HvnQ4njvV-CyijfGTnT2vrwXHpeQojB2RcFLwElo76yxSU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eWEgqzZs948hidhf3JO6JD6tv5wC_CC5lcutxghFkbg&oe=6A105C5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqqguOlmDC8Q7kNvwHO7tjd&_nc_oc=AdqzE6jDnQmEUDVCQkugzOZeLCwTnZ3G11Wy9Ex6Qiz9uBXjwWb-OBm7xGy8aQursT8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68qk-qOQvo0AcMNIHJk1yzphIJG1y68DuAOaEqycLJDg&oe=6A10734D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-A4XMsfWA4Q7kNvwFyBAOd&_nc_oc=AdqXYFJFWHnfCZdlTVG_rNDxIiV3ERiKYKB7hpGdW2un_LjOxFGtPi3y0dEo3v4Ebzw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52MF7PYIcJ5lxWcSXYW9zwFPfs5gHYbZKkQe2aXloyQA&oe=6A105D36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_FG0ee1QRMQ7kNvwGebvWW&_nc_oc=AdoMYeR__wY64W8WzYMxU7NUqGqqPIpOFJLqNFVA6E9h75QCcxBe8f3acx_QCB_rdAc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vfzIVqFqQHuVmiPanLZigkD6txWTjeCS0u94GyPj1Gg&oe=6A10725C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWCS8K_nw3wQ7kNvwG-s2Tx&_nc_oc=AdprE5G7eOsGQt6cTd24KmswzFCzuqf1pGjhLMMCgyjeKb1SbAUoTMLNq3cBEtvpQB8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zjyq98hexLf8Q3Ll8MywCaG-QTg-IDE8Sr1-lCOjEBA&oe=6A107672"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edMbT44VpH4Q7kNvwFocXdd&_nc_oc=AdpBImbQd55UvslveootJLipJgGhIhJLG4AgP32tqbTbXUNeoZC8kM7f-_Nb8f8USx8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af606EpwkixY5B3nrrasPQrjCPndRI3kwcjWp016h-0Qmg&oe=6A107B4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
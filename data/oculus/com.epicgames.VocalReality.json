": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahv4o8NZOikQ7kNvwFUsqri&_nc_oc=AdobWom5A9N7buevtRxgWf-h3zijW6-QIWbw3Ogn1KlD6Xs57C1ejcDY2IPlJtoKJb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz7xgZOZxpOxX1vEJwnc-Bd6Jd_bq4RaTtex7OwKNYYw&oe=6A8C298F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O104a0uJ4JUQ7kNvwFHQay1&_nc_oc=Adp7Vg1ScN6-AIZK6VbdAu0MtY2K6xBPv11fQGbi_fDvyXumuvR4EqDKW8goPRAxFUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIFtAckFG7oBlFl5qK_m6L6T1fF_L9GcA8BP50ZkehwQ&oe=6A8C30FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAg6CEm5Sl4Q7kNvwG37BCd&_nc_oc=AdqTVMtP-CZHtJN5OCRQNmY-Fsm35vllqNlg5wyjUL3GBMaoi1YW_ipvKPikINaNeOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETpHY6IlblBzCWAgZTgmw0d6058CvqGM6-nDp-8FaqCA&oe=6A8C111B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZNl1PYqMw0Q7kNvwGG8r0j&_nc_oc=AdqdtpGCeMfkUAuV8wxK-VX-NrNyQyf8v9VyygfgbH8cJYb0Y1PbjAGTnOqf1UyBUYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWR4FaECBqT755_8E-CTFibcAbMAMgNwm5CQ8o1K4Olw&oe=6A8C280D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gPWJ2NxU2MQ7kNvwEFcPjT&_nc_oc=AdonQQV_67_-Y_1mLSwOjD2sy0iaZ7IUTr-WFFQYyxYK0CDqRmfUR7GnDZqgGVGCN-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0PCpWhxZWnzN3NEsT00rKgKn2EkuXXW_v46rP05lzOQ&oe=6A8C11F6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQxedAtbxEsQ7kNvwHNB-QT&_nc_oc=AdrHinTQ1u_pLl1T9AkVtmZld_IIrI2XrlADPRK-7J1esk7ERMTauArmTimfuww4VnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmMUlqfKUtvoQv80pO98G-esqGo8RhMHWqlb-3jD5z3w&oe=6A8C271C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygXJX1npVBIQ7kNvwEsIPjb&_nc_oc=Adq-Nb66m2gMqc-9DhOV95tIZ8AO5QfyvuP00wuE144w9qGoLeO8xrxNt8fS48OXg3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbxuMLeonpylzyZh3i_0-_kcMcTMeZl2trzqmfYWbm5w&oe=6A8C2B32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I083mi0JicgQ7kNvwH1B90q&_nc_oc=AdrRx1NNjT3bhjGgR-i4p7_yc-S0k_Fr_OiQEaM_Plxq3hGIpqGlnUn8xfg8J2Z-MuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqFOaEK7yG-mLtIDgp9rlS4fYbuJWIkrtkeQj55vAZkw&oe=6A8C300F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
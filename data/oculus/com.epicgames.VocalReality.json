": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEjnxpGWspMQ7kNvwFnx8IX&_nc_oc=AdobzCmNtN4pBlGi1vIFjAMyzbqnJvdcqSOMwErQKSSICK55WzuHOZfZhQbleJrBK_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfMCDxSMo63gsG8WK857YqeJBGWSDZm9nRoVBZCZoVSg&oe=6A5502CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_jUBCYWSeIQ7kNvwGGqjSq&_nc_oc=Adpb7EvGQW7VDH-0vxBz7nWohOypfcOpIjDcH5gksGO-FiadJ5SAxSBwswV2ESOSe_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZzmU7uoeXi7_nfFV8To_t9aXTrt_bS1fSCp75z9ZRXA&oe=6A550A3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmVYzNwJG7IQ7kNvwFij4XN&_nc_oc=Adq2rMG5LE4rfshhj67SNrqxUUKmoGQsynG1BWY8_c0p3I4cNQxNlQrq4dxjxjn1vMM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7EwyPv9GqI42st4Tsy2VXGJHa9hLjC715_Pl5W1DzWA&oe=6A54EA5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nPJB81umSIQ7kNvwExYK8v&_nc_oc=Adp1rB0mjSoWi2m5wiJlsFfX2zkbIlPjW1ci9cdJHUUuztKPx5CoY-uO2tGbGKJN770&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ9WD608SBMNfFEIqI5dPOHMcMTxx9dX-4Dmd4bCzxOw&oe=6A55014D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlzAVrxw96IQ7kNvwGsA0lT&_nc_oc=AdoUR-mpwkadwJ4xzyMfhtFWZisahhH-QqMyqC3q_83dKZ1DMsqp0JqIlMVsDAQ5ipM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4FmrL-w6KvglyQYQ7HMwEM_mPElynylRG43QO7zIQwg&oe=6A54EB36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Lm4q-59VYQ7kNvwFjowTr&_nc_oc=AdrCzL2CP4vWA06wy0ND4DL3wU9t5AYW6pi9xM6PFtT-yUvYqjlp-cWLyrw1QH-eF8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo-oOjw_RUguBBBK6enOAigJHcULAYJhTCr-Y7dBAggg&oe=6A55005C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h22SnDmWHwQ7kNvwFS7eCP&_nc_oc=AdqclaPdGIetlyjDM6XK7Jx6vH54wTWWBm7EcWIfBqcQeN-672kLb8KCl1BfiIExRXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb6oomWDbRII4OIoxJmPm8KN9d-UL_npbzN4pMN34Uqg&oe=6A550472"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD5QBqHB4g0Q7kNvwExRnfK&_nc_oc=Adr9WUKqu9aMoai3yEZQBO0W1x489imQ3m6Yg_BUZpa9HIl4vH9kxJmLkOlnEa9PifE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1SH8EbsOVxBV4zRtPtfT8jHCBSCwDJXaA_3zucILPlg&oe=6A55094F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
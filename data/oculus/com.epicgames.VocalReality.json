": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn2lFViai-kQ7kNvwHAOvJN&_nc_oc=AdrXrQ687E3dJmcCX74I9IRGH78H4n-6p3XJBaf6_ig8cihCynPiNAALMSPCpwiyzfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mGSCHbC401kFGXCEnau9C2Dasycif8NQ-f_kLQCyBWA&oe=69EDF58F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1KyBFlD_CAQ7kNvwERY5Wi&_nc_oc=Adqf8-EXEQ4Kv1AqRMe7BBqiURbMrUx9yw_rb_UcZCUXw5BB11DpZkLVsE7KIpOq_HE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FPlaUEd3tx45u_CU5PpiXtzfJbF3149u3J2qphqLaag&oe=69EDFCFB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfwXXUJ_ewMQ7kNvwFHQEZZ&_nc_oc=Adq4VTMb73qg8ePfn75zOynanBI-LEhQ9nw0CZNSB-EKHx51KYsTZZKAXoa3_vQ2J9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zv9mgauzbnDjZZpjU5OwK-X3c8tCtcFJk7r7yWuZJcg&oe=69EE155B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf1hjlY1Go4Q7kNvwGQ4Drl&_nc_oc=AdoWDrsyeaQMO0dSEf0Cmh6eRWhsaxEOI4z7uj7Rh-ql9guDD2Y6F34ZyisCl_5AFyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E5F4ui702gb3_2bUnm3FLkfwawVhwhr0v897a_EzqOA&oe=69EDF40D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blxHtgbmkDcQ7kNvwHaCITA&_nc_oc=AdqnJ5zwlNGYwGOLyYRchGesGqR-FD0h73nJiC_uUDUao-8I00tOZEGycX0xTt2nIQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w1diEJqp_lqZdWF_tTvzRF5Rmm0J__kia-J1WhFs7zQ&oe=69EE1636"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYHbAxM12OgQ7kNvwEF--A0&_nc_oc=AdrlzQNPP25ZVArYNBt6YHBK6h7hG8tO0IkJtvXEnWeNq2iQMG3vJpUxS7zcnJLA124&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nlSbOLTMJBa4h9687nAIp66gYPMFuFvJx6YxVp1_fGw&oe=69EDF31C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFAZpfJ3M1AQ7kNvwHFmg_X&_nc_oc=AdpWmNmIs4FLvL2Jj42EyNcWl2FK8H6wuz5ozQPy-v-9_SQ4ttuz6Uq7iz02s1Vnm-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2amDJWtUrNZgghKEDM9O00AKkBqXuH1q9qTE_Kn2CFiQ&oe=69EDF732"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_alPJVjuaEQ7kNvwFQzkmD&_nc_oc=Adpi9V0tGqJjGiz-u4mp9gdBle--hbreYx8qwxXAsbnJHvjwFQk5zxr-2tT_fEd-ZRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10lm24k9xyCM0xz1k53w-RpV0FOh1KFss0z4N8jbsXjg&oe=69EDFC0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
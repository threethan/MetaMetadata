": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49KChxcz8FcQ7kNvwEvcPXu&_nc_oc=AdqzuLhOibCkFLnyhTjyTcXLBh21QNu-WvBzhKq2zaqo2W5HVK1tAWN2YEFMpr6XH4U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1765UrhX9iwlWZEpBiUdJ0b45NUyZL14LDy9tg2g2CXw&oe=69E2504F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCWBheX3r0MQ7kNvwFf0mCs&_nc_oc=Adpq4x6sqCYksc5iqq80T8FRt1oZlOTWOj7gbgDKwH38oRXxQgrYOeZhwvvkgNPT6Yc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IJVjtB4ln3TBjcJzg5qSQTd0joc-Nefb5smKXknaOPg&oe=69E21F7B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7IuTjCDr28Q7kNvwGee6Ry&_nc_oc=AdrvOFCPc4xZVUZCtYyjwNz5wgPZa-wjcNBjy2GUyG7ZnTTxDdloRmVZwnFcASu5sQQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PMZtYAr__kUzAc-oGk3x_awdRnBEpzfBGmDt9A6oZ0A&oe=69E237DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgZeoIJByEwQ7kNvwGftTbD&_nc_oc=AdpCD3XryAY9jlX-720w4rn_vpJCUG1Y4mHezxqyslbFidtDr4mLZMswgQD8CDOd9MM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06EF5XX6xODQLG6iP9on6UV_kZ4upo0n66BFbGe05DLg&oe=69E24ECD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB7OlVicH8IQ7kNvwHP-pnx&_nc_oc=AdrfI80cY6bhZdw0P8nft7z9Sy8n-P63Icdaccne6LjGp9pz46mRBmr_0GFK4x0vm9s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dvqTc2iCIf1_Oj59GpGv8_2xtAa5kPAI90mzavx9g2w&oe=69E238B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDFvC6oAiiMQ7kNvwHj_YoW&_nc_oc=Adpu1RqXBe-3hpHRbo0tV7FTszPOuexi7cDu3Ms2EH1Om31NDclcg8y4WmAeviLhRUk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wJxRhoimzkxCWQ3sV-J5x2aUKq6w39bSvI6ThgliWaQ&oe=69E24DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLyrHMTVbvEQ7kNvwEvR1Sn&_nc_oc=AdpwhjCBY5I65XOrn25WLlvUBXVqV5oL9A8Gjbb9bhh4a91e-rHA8KJYWgzkTAvypb4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fzBiYGO1sEb0apgsKRI7gZVN2BWEiCvcyNW4UdQTM3g&oe=69E251F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDWDbwHyloEQ7kNvwGYVoa3&_nc_oc=AdrbktSWEImpEG9V-VXDkCzUIA6JbUDXlIHZfttaKPUar5texXFCHk5ZBpSiNWjbHk8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KIoe_ec4wdLsz6rEPKLggBQgKn_suJJDm1D1WIjiGQg&oe=69E21E8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
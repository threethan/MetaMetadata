": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktnxKPxQp9gQ7kNvwEHLBts&_nc_oc=AdofR_hYsrxtQd2b8yiSiTC2TXe0I4--xqun4aXZDRpN_XIWiB7dh4daHdTnDRZ58fI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-ZPl_7GwICpKr43lHMl0tmx72pMsxgXe-ejvNBat3Ew&oe=6AC7B54F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8277VRiNiuAQ7kNvwGY31Kp&_nc_oc=AdryiCBfsSnhcZKu0OO_BgJmIDAf0VF4YJaMJ3c3rhXqtJvjnHJazkb5yaRMkT0Hp8I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZGJf7uYboALSdF6J_h9pajprTSViFhFwZQwkfoF7MMw&oe=6AC7BCBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJu0ZWSgqXEQ7kNvwFydK7p&_nc_oc=Adr113Qvql7ZDsAytVqutnXoQf_1ILu-sKiRpHhHSBD7mYewe1qYfwWOm3ptTVEXPwc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTLKHBM266YZXrcFnzIs8ggM826-7NMFtWmCpyeGmA6A&oe=6AC79CDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwHylFl6rEYQ7kNvwGEIwRJ&_nc_oc=AdojaBGZC3QSWC4iAbuINEVwgU2_EF7zZ5BX-OxxwtZ1vtkra2gFaFA0Avuzu-lrc1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSnhBG0kA2mrnael8vCwKPIGN3Z92G40ra92DWcKwGcQ&oe=6AC7B3CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvgJ1P1M8bwQ7kNvwF2eyPj&_nc_oc=AdprtNw7ZV_t67TFf-7I8FuBSGocmqhVcez7hX3r-YVKRJCerOYu7kOHM0luMWJzJbI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDjL-iXZxnPQwc3L7w8YufW9o9cxBpjkNplQgEj_JbkA&oe=6AC79DB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPRtAULZUZwQ7kNvwFhYb5c&_nc_oc=Adrmjx3uBJCBr9lf3bex-WissGN8TCK6i0ujdJsNewY2brLHeSRdusnkAfz4pPj3YEA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAXcPg5mH5ZHnt61zYEdKGd0bnrd5lvOkewUV37Vw5uA&oe=6AC7B2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5PyfB5YNdMQ7kNvwGStccU&_nc_oc=AdpuXNG33sf2o9EMV0zp7Tn6lC3Vf0aAfou3WlmRp71rM7FArUO9_MLmZyojGzU2sP0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP16VFak5Crr8_vDECqBV89nYOjUo8qwr55Ee8MX7DgwQ&oe=6AC7B6F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1ocENRI-4YQ7kNvwG0nzF7&_nc_oc=Adoqe3StyKJdSnYg3Qqlg2lI5W4A1lY9zputdCxtfZm0xKmB8qM1jKnp5deKSRva6z0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPehIE8BE0Aq6KYy5xI6bFpXaSimAqO5rt6N-XjGlftNg&oe=6AC7BBCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
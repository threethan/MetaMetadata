": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCT2VrBXIpgQ7kNvwH6JQLN&_nc_oc=AdoRsd2ccbCExbGI95N_YO-ItvIeTbrjSPwEiMv1uIYMebuvso1OsbSC6KQIEDRKbdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuBifzwMwoVk-HN577hUQyzXqpvTqIrQqJuGgYXctziA&oe=6AAFFA4F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-JLwYbaJl8Q7kNvwHJ8lF7&_nc_oc=AdqVXeGM2qZoALBDil9bkd-Qgri_0sr5QCZIXjFyjFv4VXoUyw41pDrKONP_bD0L5TU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsJ4JW_Bv5DI-iAWx59VoRwxWfSE2mn2u9H-PzulyIow&oe=6AB001BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayInhvoYaT0Q7kNvwEogXaT&_nc_oc=AdpdzMfNBD_-50eSRIG3xWLw2F48b4yqqMeEmUbNZX3E9XvEqsfwFXFD8hHvCRtypM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp_Nu9YizDVOmmVBRkC5uzCe11ssmoqmcDPd-QRUfxvg&oe=6AAFE1DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwEVv7DiXgUQ7kNvwGhcYTu&_nc_oc=AdrUT8uKPS5DpQDyhfXQ9yfSLDZCL-tDLcG47d9W1x9ZkgGOcJMI3FC5AcmMnTthr3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzykc-GKcTi4nEdVsYPSxN4n1ttIgf8RPjsW9bZz8qqA&oe=6AAFF8CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-piXrWpQXEQ7kNvwHSSd2-&_nc_oc=Adr7YC0Do686DSnfH6iAITFKkce9Wtx2Y0SdPhAb1OdflZiEm4tFzyYoPi3IRQYy3yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUwKGQ2dhGXZxWQPFFB1Rt8oc35lIlyIpFANEuo5CWeA&oe=6AAFE2B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9znitY9lzUQ7kNvwHSR8sV&_nc_oc=Adqq2qQyOdqJpUMdkp6BrlLl6gWvECH4LgF_HuWO03Wa4B9opfFdr0ekitSrcQg8-VM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxKM_yhOagi19EAG5ICPLIJuW9Mggt1MOBdwMoGPc4Eg&oe=6AAFF7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBOCEx7fCn8Q7kNvwH50lWJ&_nc_oc=AdpKetgadeaXd0edxYJyJaS2U-SoKBuhU9p0T3ujGmYSCh2QRX-dL8Ez72rkLjw6UDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEoNBOJYroVbWneOO9bDV0aWlzRyfwbDGcwqPeqQviEA&oe=6AAFFBF2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX7GdEbwk4gQ7kNvwEX8XCY&_nc_oc=AdrFgATX8irBr9nyBT8aEHvhgpEJjm3EdZl6Tw2K-d2FXS-2Kbw87VxgAPeI48USYrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGHLZIumozwhWBD83itvFDY4Cb3jHB5KAmuoqeRnxEzA&oe=6AB000CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lejN48PQYqoQ7kNvwEKMt9m&_nc_oc=AdqjuUAa5_xC6L5hqM6-q4-ck5AiRyu6-KhN2en8FeT0YKkKNGw4foa5xBPYDVXX0ro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKIL6vNKOpz1jZpbxlzNh13NZP6Sl3ElEg_cIvfYGPPw&oe=6A92C10F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxRSShghrC8Q7kNvwFvqAZQ&_nc_oc=AdrUYzFVECduvAHmiLTzCnRimuN0zfrr0a64JwpvwQfXN3jN4izd-DDylPfV8_8j_NI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRKp7RaR-PcU2-l0l0i6-lAKX1OS3GeEbNDGqY5H6q8A&oe=6A92C87B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zs42NgvD1cQ7kNvwEMBgQk&_nc_oc=Ado-S-n3-xLcPaYpbZ_k4Efs6zL9j_e2hVXPAm8VFRc-XUMIOUZqbnLQ50df5pLbjjs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHYa_exxAfBi5pL1dxLRIdJzRoedy-HwDM7mhUrF6SNg&oe=6A92A89B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74GhWdq1jEIQ7kNvwHAHU4j&_nc_oc=AdrOL0zNvtBG4djFDJZygLh9zi7mHu-E9ZQgfHIoKzXe-bDlhKtBBRRhkBxsN7mkdZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERSZgxPFwLgJ77xfGQxfEF4AIV2B0cDRH4C_sQFNfStw&oe=6A92BF8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35IFwxdA-FAQ7kNvwEx8VJk&_nc_oc=AdoPUv1oo2UqA9sinVEuBK4_Sd4EFbczKlqibO7ZR1Ip5l8kCadS_vpC6F7kE7DvYng&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQx7Gllli6whLMEaMqk5bX-qZr5WQ_BXkcK9si9YNqiw&oe=6A92A976"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmGueszhCFgQ7kNvwFT8A9Y&_nc_oc=AdpsTYq8MlCPJGpdvSkpOTvU60cS4FBb0XCH6xm8laByiMjHjJcd24fTnvobuTsWCLw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF59qxiFbd_anPHi0AruqDnVi3fBHyrpkFVx-4UqEs1tw&oe=6A92BE9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE4FX_9a9iAQ7kNvwGm61_v&_nc_oc=AdpSJIuPDnEeMZ4sDJbSqOXwyftN4mWAj7pOZscyHPqDNWBkgTX15O2r9H2nAayvk2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmShoPDptjlqMpbqhnh8k6CA8g6ZQLJRUN84ddepysWw&oe=6A92C2B2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfqEsKt7RLYQ7kNvwHt_xB0&_nc_oc=AdqljHFseQFFsfXofneaUtOrqzk1UB7-SxGnIndt4nJExzB5kf16peYz_6MUvos8eiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwbgQsbBCMVbfYsDUHgASbfq61B_BhkIPn7mYJhjdqsQ&oe=6A92C78F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
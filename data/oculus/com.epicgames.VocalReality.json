": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1iOOLaAI7gQ7kNvwGI018v&_nc_oc=AdquyGScMOsLVB26QnCO9Q8XO5NApt_WsAHApy17_gkidTQmk9zdwP94rg3gBrrzIhw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J4jVBZMRPtQI8UZ7EdvzLAtxiybF5doQpEcnJO9eorw&oe=69E644CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxoaxUBYL28Q7kNvwFD2vfi&_nc_oc=Adp2lM_fkFD4j1t1lkJwgstnI_4gX4_odWMLvfE2oZX2zOcmtAnP3B7D_eQj2rgE_4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qdYIbVbOl9VVXJVEC3gqHcwpqiyx-4fby_YFYnt4bcQ&oe=69E613FB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIiDXMbFvDgQ7kNvwExXqBA&_nc_oc=AdpZ43_qias6fP2DLU5kS8_bjbZozWKNAJhd-iwd03p9Rzf50EhXoFKBxunRozvzWbk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xqHshUWnia0xP8iXnhIvXpFHyvS6BmrsImoyAiny1hw&oe=69E62C5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkOeXK8sKmMQ7kNvwGJEMzH&_nc_oc=AdqCggXWyVxqDLAYNwc71rfdrXsvNeL4abQOBY9182qzEBRj5MsgR2ZxLnvXE_H-o1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gkyn7Mgqd2T28e8bAvG0V1fAeEc_PsY0H8jdebkE2WA&oe=69E6434D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1R5wZLJEUEQ7kNvwHqUWH7&_nc_oc=Ado35RLQ1rrtAdQM0fTllQDwzsuibfshbJ9MXLOAxK9RImy0QyG7yozHpES3Je3Jchg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ij3a54x3Ydv6W4rW1vQF_vi-F40-u1xCCSsa679zd_g&oe=69E62D36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB8IV9BqRzQQ7kNvwFFzfNF&_nc_oc=AdrLrRrIKtm1FLSzVmF2C3wl8aUc_31hMFA75JcknAjy7K9cEreeKpEoaZYOsO574f8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31qucErKgbbPHeh9Y3CNgLNc-r7N67W5D1y3_mnKLRLg&oe=69E6425C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H42o3WMbHf8Q7kNvwFQ7JVl&_nc_oc=Adobc6v6os44Vyx27btbk8UOcanJYJpRYJum_D-Z0XBe-fsrUA7TFzPOEcfjPTAwNmE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0skO6DCUXTE1NHpYsdGiko9CKfXznnCFgoafdzzJgotQ&oe=69E60E32"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAs-eGw4imsQ7kNvwE6k_hS&_nc_oc=Adph1RFx4_R1OfwsCHwe8kLStc-WEYI_8Y1vzbY2dRLzrujQ7dBZcDyNUlT4RAH5OQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g4f-dXMYkHUu0pjqNQ1AwKQHFP76i3sTuFrpAVylAdw&oe=69E6130F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVGlrZqMXu8Q7kNvwHxyPFG&_nc_oc=AdoP8A6VIio_mLo07v24IIPwkiK3udHHijgWddZpzYpaBYFEa4-IDZ2_CQ-OY4P1bi4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8vP2p6iSUkLER6gE1xtDNbB-xyQ3FgiYS7j2AQ1UHbQ&oe=6A2C244F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quDNz-pfMOQQ7kNvwFM0Y3w&_nc_oc=Adq90EifGCY9r9LWkbfU4o7hYguOm3IFcgN64zzwtKATyjAHCzXmY6gGns00EZwu5YI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HC77OEDmlOf7_KWRtrbyp0m_tUvjhYvR-3Um63gSnrg&oe=6A2C2BBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJC8hfTeGG4Q7kNvwGaHHCF&_nc_oc=AdprPY-vkmHmKQt2_L9BQseYuyUTSJAFj-NnggI8fN9wbAWlq-VXdYvbnvbXjc6C0bg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LsZxzdCfCaJvwAUnphcZCOHol6e5ljsQ2Ddvskzfbxw&oe=6A2C0BDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykS3YXQ0YDMQ7kNvwEODmym&_nc_oc=Adpv0y6sN0at4ujp6mXdNdZ00gccUB3BizJbdqH-TdUcWDRQRtJ_vLvPYKAyMRdUWnI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oMjGvO7iptGglygtSgnMsOqhPRWytNxFh_HPKCdKLCA&oe=6A2C22CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkE5vDHYvMkQ7kNvwFlEnjf&_nc_oc=AdoSxWZOsNPjqmzwEdaFpdDm9hJI3J4TSg-XQDzm6awJHyHXqJ5-mIqm3P3MBPK6na8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vwkgDrxUpse0x4MKC9AQnkHzD-LvsfEJjeY5F4KtfTQ&oe=6A2C0CB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JKEn-CVXsIQ7kNvwHQIn0X&_nc_oc=AdqtM9EhfYVlxEAC86eJ6dUFyPIuaF_E49Rrat2nnBN-yiJJuQ0COBMqcxqW21OYAIg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SNzKd9NoeNtLeNLJtltH-ykjM6gimkgA8meFJP4azGw&oe=6A2C21DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a56z2eL2pgcQ7kNvwGOifMv&_nc_oc=AdqUstWcGz9Fi1zdSKEX7vpoxUxliBqkR4O52HwOUkhlUk-4UODzAdwuO2LqF2pos2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mcMOfTjXVsckM0XyRBDW0Piox82pr7oeycuuoxXgRdA&oe=6A2C25F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1lXa0UNRa4Q7kNvwGAo95B&_nc_oc=AdozI_175_5QrJ-NYLXRNvOjGQFKHsHIZMK_siHJtZvUXRelm9ZaIqONMSuU593Vyxc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vh9eltJWMzGxERKBctJy1cDJJpIIvoTSWRWuC-ctl4Q&oe=6A2C2ACF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
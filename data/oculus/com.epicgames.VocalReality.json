": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8ReXSA6wKEQ7kNvwHOZaM7&_nc_oc=AdrfD7yzkCUx-rqxlX4_IfQCs2VKip9Mvu9-_7VRIYXgj4gNPaUMWgyAzuloK2ytD8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dPv_J31Q6aGj_ctYFUdImDR3cqG5V0IrvjvKG55l9sw&oe=6A428DCF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwc3dOf__3QQ7kNvwEVLd7I&_nc_oc=AdpDb0Q3b-jJUaMtrYomYwASG7QhDHCNA6JgUAS9RCXWhYKD7Ll9f6yuZjHvLUfBKcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gE0uglSVIH85mIdPFR-3bVCRDJnoZ-DvGUe9LtqRCbQ&oe=6A42953B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbboMEqXkTYQ7kNvwHeH98s&_nc_oc=AdqxPDQNHZOXSxmy1Yf1pTktORaxv4Ytc04kq6GEN9javFW8M1jhTZ2nc02IWhGOFj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_haxdaahyKThaoxrDFZ8fAfVe7_PCOWYHRjAz-_YcSBg&oe=6A42755B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWHzwzqH2ikQ7kNvwFLlAbB&_nc_oc=AdqFkyWo-qEKHorHtDGf-kjNMHEEyM03p-5PS-6zQ9UcJgUuF7imd2bGYI_zyOc4EuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O8A0I0ryz8CnsWTBF9Z60vbImX-opLkJsvxvXD7ObsA&oe=6A428C4D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9QdDECBwvYQ7kNvwHEusFW&_nc_oc=Adq9eGvsUxRpcyDXf_sSQ6_JjNZTJm8vIoApm4OjNwm90axsRNdTpq-FYYF0eXY4Akg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94d1E0DHAGVjbwU7e0suNUMQWtgg_6FwFsOiP-PnJupA&oe=6A427636"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tv3gRHhNGAQ7kNvwGX6t9U&_nc_oc=AdoTmJVI3v8LZc6VCzu1pdx_isvSVJ-Y9yJhAcfpUY4vK-geLymq7FBmmTVRmDXA4sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_RRWm1ZVBn7jlxLTArxOWfAUFG7KXZ203qvXFww8s9g&oe=6A428B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h2nDc1RyOwQ7kNvwElGFUQ&_nc_oc=AdoUf3HHqdC2_pCGaF2yC_gb9bD3I_KHFgnoxf-Ch6x9cuVL3QXdhgN3cogbnEJg1rM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8amwwK6pNje3uwzGpD_5v-KhKnnHVGfgBa2VL8-ztcwQ&oe=6A428F72"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGf9HOzWPL4Q7kNvwG8Tuv9&_nc_oc=Adr6s5GdGsSgbr-2opYqElr55h63XmpXaCQ21ENcSBAsynBHoQkiLIRzaBz4APobvrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ku6SYx0sGN5OCQ8cC22ACgHQe_ibzynDRvSTlOrFZmg&oe=6A42944F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
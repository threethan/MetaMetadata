": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-bkT33TC6IQ7kNvwGiCs6r&_nc_oc=AdreZr8dSvCwSbzXr4r6yMr7V7ltzH1yHj1tdTj6D9R8yVUNCPRds75tuEOslJwOzlY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ph2ml0C5hGzKpbjKJBHOHQdcuuQUKvXBdkm3-Tm0vTg&oe=6A2046CF"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnhMN7TQuvEQ7kNvwFpC0Au&_nc_oc=Adppm07kw7OBbaZsWh-3zlTv8LQ6Fwzs0Z3q-s3yJeZl3ZFDIEPmjej0dAZ4LMbaDPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rmCg6gX-EGFHQpWKr6J85Dbrnow2zMU9UjeTyW1ABtA&oe=6A204E3B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gldC1ORf-FMQ7kNvwFjJJLp&_nc_oc=AdrCP-06xxKnhjhWj3-_FkZnF6qsYT0djWmMfnaMpsGsurMnFoJwuJJiJwTAt1mYHk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wwP_1H_Fz6KBOiD8uUzXDFF-V8lhZdIy_5zwI-_-k1Q&oe=6A202E5B"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXsIfeQsI98Q7kNvwG-6Y5i&_nc_oc=AdqWFki5KU1QdEmTl6TgVtfM1kny3FdjZoqawAHaiAXjbHBcIjntDsB_JQ9Sg_vqpfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HJTE0DKDqH2G3S3EhXeRpMNVh-rrY5KLhG8KZ0GkLYg&oe=6A20454D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nF3xOuqeMcQ7kNvwH-D9hj&_nc_oc=Adp1t2GimQNeYKPgSzUIqD67nBkPJAqShExQtThrDAu1S17XUVFsnp46ecMVthW78Yo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6axSxyUEOL5kTQqzclvpcv9rClTaiDc_4NlF4yUFXcVg&oe=6A202F36"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21tio9Rzb24Q7kNvwFjqL8Q&_nc_oc=AdpNxFgYC_3ifdRmxdmrchOC8_5bPCVPsPWTCVtGV6Do9xfJUI3gJeLstefCnViEcvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_HaJgEdD51BEpQcqcEtxeVWEPLbg5LFsWug7VLLU8sQ&oe=6A20445C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LblLGLFS2L4Q7kNvwHMOCzu&_nc_oc=AdqFoRPQZCtygm7I7Vecat_23ssStFfkuiM1s14AlB9Q7sflILqLbDC49cVl2eMpptM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tvdhfCbRFwhyUZegSecnbZcyEEoUxjhX1_SLbcmoWag&oe=6A204872"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHMBHcQa-YYQ7kNvwG26V2c&_nc_oc=AdoUs8rCoWjVyQiwBGwOhY775yOQE8tHXh8NByGrKkNM9kq0K-qRH0jneULryh0geSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UEe13MdjJp3Z151DDHo78byYfu_yl4rI7x2ipdehFxQ&oe=6A204D4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
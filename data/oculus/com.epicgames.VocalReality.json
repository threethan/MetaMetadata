": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgqe7rrljY0Q7kNvwHd6fi2&_nc_oc=AdqcMoVeq1XK5IOpxajHvPP9FQbJlOirW6wTmdynvHFipL8OBWKGQPhfuZxzItGTvG4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OaW-ZhC32UqWjTFINmMxZ0F2wNgFlo169HBY-bbanRA&oe=6A0C804F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfm6oO9p560Q7kNvwFwzo_W&_nc_oc=AdoMgWLccJDKAexoJqAwhcpry2NBgE2EQZmEG63U1_uKN_vIfJw5Xw6EEdyCe4vs4qU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dDchJri7959KaFro_3lngvZY6tlIRce7nRQcMSi3fjA&oe=6A0C87BB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFh6qNpYHcMQ7kNvwG81yJx&_nc_oc=Adq3Qu_hpZKjhYg0pBKvfzmejzRP6Vh4PJR-j5QmACBpOXl4GKXIbbYoF5pRpTV3g74&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ny_GfwNwvaImWFYm2LEZd2epjJicobaROd5fnVwf3zA&oe=6A0C67DB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odpPPaOI_4YQ7kNvwE6-hDZ&_nc_oc=AdrHytGtOsYcmXqzpPPnphy3z-4ZhU1TZhDa6tsGx3bdTD1rs4lMgu1zrYeAY2udhto&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EMtxtPfDYnzIFms1VKRfReJM3h4Csv_Wlko9GIw1ZoA&oe=6A0C7ECD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZCLJ5tTmQ8Q7kNvwEjQrG-&_nc_oc=Ado-kIKRncQbTuxMG4vxGVmNie-NIaqIRV82cCkZnkOXPWVaT6aT0cUY_w9dw-O33HM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z2_rmf7AH0j-kzaWI8JEdp9nplKDTGNEGlbmmdQ_vRw&oe=6A0C68B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_PPwazP4IQ7kNvwFxDzUu&_nc_oc=Adq80I9_vWnKrKdpLnFsbfI3sfYGx49XAFaApZZ1L6vk_3SNrBk7SY9pyWwwK9FN2OM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Y8e6aijR0RXy8kQ82iBMUNNMTMV-7N8BbRNuiYfi3Q&oe=6A0C7DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck2za13N0A0Q7kNvwHEOG64&_nc_oc=AdphKASThnxBifWueVEGIm9fRS0t6z1j1FgWicQxjEHcZIUC1kbR6zGQfYAwiiWmrS8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JDyqx2HBPbKbHmAfq2UNeWPGdzObHZ-KwJF9DRMOCBg&oe=6A0C81F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia69eMhBko4Q7kNvwH4Fyon&_nc_oc=Adpx0r3d33XeTJF85s-TJUl9I9rQ0c_IH3z-heWh3XT1bDKGl8BM6be9ov1THSBqH-E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dpK-VwJQNsVG9VLKcaBSqbkMC5HsrtTpzhBJ-0gf9YQ&oe=6A0C86CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
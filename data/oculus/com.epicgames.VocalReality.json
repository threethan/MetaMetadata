": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELFMBUBd8iIQ7kNvwHxqP91&_nc_oc=Adqvp2Q0a-zpOkYOl31GjGhQqIoowvo4bumy2zQt0Jf08viEnGJDN8Q7U9OshvsP2Lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGmgBoNLJHSsrIO4qbsaXJ_xLqcNY_wKH9I7P4OT6VDg&oe=6A4BC84F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRf4k_gNzuoQ7kNvwEjHKNS&_nc_oc=AdrgE2rS80a1T9g7EuMFDOzYZ3tynsUH_aztMNS2ybzlMJwP7Ys_7jYbNk5XVlS3iw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTWBC6tBRxT4gwKvmx_t7JAborgYq8h375Y0yNGDMOPg&oe=6A4BCFBB"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TURK5B_OJ_MQ7kNvwEZjD7n&_nc_oc=Ado6i9aIgJPLmYHUTQ-pzfZnBiIEoM5bNVp6ikq-CEFrHAKTIPFO6GWzG71tBH5fEgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_fw9-YEQH1r3r64UVm-ko4pES00WAJOkNBVWzSuuy9Q&oe=6A4BAFDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viiCjRMNiuQQ7kNvwE1InxD&_nc_oc=Ado0RfyoTt2E64dQUhEfFr5fytLMEnVYO0uwwGMTopDup7fYV4-s2lSKt_TEU6__xsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG_jcDPPsjB1xukduxqfKdnOOmhlkTqOKNEbZHiXjRQw&oe=6A4BC6CD"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjGsGxObjfoQ7kNvwGSL664&_nc_oc=AdqclZEAUGiJoR0SqWV0qd5T9KH90ZLsH8b3bMdD0w_pldivC_Zx4lOLKgAcNK03D38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9XBGJVuc8HqOtv7TSFa1thgcQjhmvuCOd2NcwYEcI_g&oe=6A4BB0B6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS3jq5spnMcQ7kNvwF31OrO&_nc_oc=AdpM3IfKgVmMS1VZfo9NeRGnn3CPEzzOVx8YA5bV5AI9Ew8BdZKkYvh7sGezIPY0Sts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvE_qTDv5tawU6UhVD4yne9opg6Mzpxg1SAA27-ZvlIw&oe=6A4BC5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE7R06BGiWYQ7kNvwG_voUQ&_nc_oc=Adqi-DmkzMkL3tRt-U4ZlZ8YulADUh6q4Fx7rc6MfxVc87NdyI2xQ7oCGzu7IJr7FmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiMGmXdlOGohn9xd1dxnkTUc1n1QMusQSNExkr9j05aw&oe=6A4BC9F2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwgctDjwTPwQ7kNvwGEPjyT&_nc_oc=Adqr5pB2XIFOrCRuTz6dhc_Q_c-UcZtYpUQIb85h1cwPm8qVeTeO5Dp3ZoNoFvc_DwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBw4c3h3EwFnNTWkNbwgzHUSLewJd1VlfMIfGw0pwi6g&oe=6A4BCECF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
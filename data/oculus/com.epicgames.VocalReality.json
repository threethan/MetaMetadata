": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982699_495872829648582_5281505309081290580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1iOOLaAI7gQ7kNvwG8AvD7&_nc_oc=AdokbuFYND7IIo6v0uh3o0ymq_hzpceuPkD6R1m1VLl7wvXMoIm1xMs9fK5L4-n2PC4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NNTvRhBfewf5EmZQIlw23gjTcHgGJWjEkgsaYYSIq_g&oe=69E75E0F"}]}, "id": "1603002494393429", "locale": "en_US", "screenshots": [{"file_name": "image_2025-01-02_125337513.png", "id": "638541368832780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982612_638541372166113_4273128445960510279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxoaxUBYL28Q7kNvwE4Xm0o&_nc_oc=AdqeQvKWd-Ro7M2csTk4cxv_zq-hiatTM11wrtEY3Aqtk25JY0mZSMvKySQEyoSu4YY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tEFMRdKbK6CZYy1Q7LvrQstbwN6rBy7oeVqZu3mITgQ&oe=69E7657B"}, {"file_name": "image_2025-01-02_125410554.png", "id": "2958168147694099", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615253_2958168151027432_4329574331607035679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aznm8-uGpCgQ7kNvwH2Oeni&_nc_oc=AdobJNqnuOZOKnhWVM34BexfZpnU3ulYiWt8Ql-yEp7x26MWyanQRLMrjLrNKSMu6C8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pMLyoaMD4iWS15icJgyXe8hQA4UlGvEd5sKV9cF23OQ&oe=69E77DDB"}, {"file_name": "image_2025-01-02_125426843.png", "id": "1621145555165828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982696_1621145558499161_8788104483551896296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkOeXK8sKmMQ7kNvwHJxjfO&_nc_oc=AdrCJzkBbjdo-_7Ukdm4H25_aazeCu01uzFXiEwWI8aURUpTzat4yIVoniAX_aR4KDE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xzXEPWcEMnPUzfmgWgYcqlVjQ9Cc90-cVo3F2_4_G2Q&oe=69E75C8D"}, {"file_name": "image_2025-01-02_125454650.png", "id": "1296827331336744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_1296827334670077_2797112606820431540_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1R5wZLJEUEQ7kNvwEzlbg0&_nc_oc=Adq036TE9kOT1ySwP_QRwA6aNpz66TsLMBYL11HPSiabxKwV4Llu0pgDgIIp3TtPn9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34Oqq1-_5jVcfHKMdWBEaUcF7-12yHb2vHED2RRaH1Mw&oe=69E77EB6"}, {"file_name": "image_2025-01-02_125531117.png", "id": "925519766350458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974460_925519769683791_54644173791050856_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB8IV9BqRzQQ7kNvwEU6DB3&_nc_oc=AdrfrcGizWONvF3uZ3dg4ORJEVXM51NM034kf5sKtVON0B41DdzwtGS_Fpglnv9RqK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2magJJKU3MjdOPk4uX6rcM1MkQH1kBgyII0WkX5dOu0A&oe=69E75B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "904065131636262", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394202_904065134969595_2630349408296369448_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk3aqbIWSWUQ7kNvwHBPqSJ&_nc_oc=Adpntp9TJUxE-DfG9H8e8cenQmOM8zuNTq65NsVfqRHRuKsKdu7bUMgaUFVpgZ-ex6A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bLzr3COqJn5_PS6wCeqNX7rBLJ6OwCmpnmUufloCF6A&oe=69E75FB2"}, "display_name": "Vocal Reality", "keywords": ["Vocal", "VocalReality", "Bork", "SM", "Mutism"], "long_description": "Vocal Reality is a groundbreaking VR experience, specifically designed to help individuals with selective mutism and social anxiety build confidence in everyday social situations. \n\nBy using immersive 360-degree videos, Vocal Reality places users in realistic scenarios acted out by real world professionals\u2014like visiting the dentist, taking a driving test, or engaging in conversations at the store\u2014making it easier to face real-world challenges in a safe and controlled virtual environment. \n\nEach scenario includes subtitles with guided prompts to help users respond naturally and participate in meaningful dialogue.", "short_description": "Vocal Reality is designed to help individuals with selective mutism and social anxiety practice speaking in public. Through immersive 360-degree scenarios, users engage in realistic social interactions, supported by guided prompts and subtitles. Whether it\u2019s speaking to a doctor, ordering food, or participating in class, Vocal Reality helps build confidence and ease in real-life situations."}]}, "developer_name": "Poling Bork", "developer_privacy_policy_url": "https://polingbork.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Poling Bork", "support_website_url": null, "website_url": "https://polingbork.com/VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25485087887750470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031598_1942185782948996_2999081705981834669_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAs-eGw4imsQ7kNvwFffKg9&_nc_oc=AdpskhUJ3vybLWhtsRSbsp_K96pkSVfj33vMeOQo7a0PrMF7PU98XkHYQbLBVgWRrBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kJSdoKAT2MDsvaJ-awC_6GwioaJA9U4Q3omr-PUVM-Q&oe=69E7648F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vocal Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692
RyBq-ZP2dwO5pM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLxIDCb-cDNcqO8DUl5IBcJbcsWoHPuKcHNejBgjm-Yg&oe=6A915D83"}, "display_name": "Open Blocks - Low-Poly 3D Modelling", "keywords": ["art", "creative", "lowpoly", "modelling", "productivity"], "long_description": "Open Blocks lets you easily create 3D objects in virtual reality, no matter your modelling experience. Using six simple tools, you can bring your applications to life, create a volumetric masterpiece, or simply let your imagination run wild.\n\nOpen Blocks is a fork of the original \"Blocks by Google\", originally designed and developed by Google and made open source in July 2024. Icosa Foundation are continuing development with the open source codebase to keep this amazing creator tool alive. ", "short_description": "Blocks lets you easily create 3D objects in virtual reality, no matter your modelling experience. Using six simple tools, you can bring your applications to life, create a volumetric masterpiece, or simply let your imagination run wild. "}]}, "developer_name": "Icosa Foundation", "developer_privacy_policy_url": "https://docs.openblocks.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Icosa Foundation", "support_website_url": "https://docs.openblocks.app/support", "website_url": "https://openblocks.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
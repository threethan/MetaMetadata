70_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfyvQAxRTokQ7kNvwFC5Wxi&_nc_oc=AdqSx6lRaet1tqpiUPVOp8afOcIb_HCVBvhGXFkH_cXzj4amrfYsGwtl0O-KUOG5MeU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw91uE0XaVpB2_iup4V9LAb91KZdJCa6wVs8AsdiKwABg&oe=69CBC5D0"}, {"file_name": "ss 3.png", "id": "2445850529203820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822550_2445850532537153_8046651433486405801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCCx-ZOm0m0Q7kNvwGNAJZm&_nc_oc=Adp1_60iuaXmH_ifBriSPOdTEPKp1Z3AKtEzly4SX3bw4w86EhXq1Y8gsYvH9J6gyRQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYtBmbP6wVu9FJhzrwVVszgzhqk-84mP2iNCRwEvkbAg&oe=69CBCC41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-An'am", "keywords": [], "long_description": "xperience the recitation of Surah Al-An'am, the sixth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the powerful verses of Surah Al-An'am in a calm and distraction-free setting. The peaceful virtual environment, combined with high-quality audio, helps create a focused space for spiritual reflection and connection with the Quran.\n\nSurah Al-An'am emphasizes the oneness of Allah, the signs of creation, and guidance for believers to follow the path of truth. It highlights the importance of faith, gratitude, and recognizing the blessings and signs of Allah in the world around us.", "short_description": "Surah Al-An'am emphasizes the oneness of Allah, the signs of creation, and guidance for believers to follow the path of truth. It highlights the importance of faith, gratitude, and recognizing the blessings and signs of Allah in the world around us."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "su
70_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj2tPD5VNxIQ7kNvwEMQoMz&_nc_oc=Adq7wN7PBWFdysJ3SCr6i62hLdr8xh3Cn1oYY6HZws_6cbOeLm3-h0Orxano2h2Q6VM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6BjZZu6hez6OUJbK-y6mE_SQc92zmbRuf61y6M6bBag&oe=69CE68D0"}, {"file_name": "ss 3.png", "id": "2445850529203820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_2445850532537153_8046651433486405801_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5fPqXYrwVMQ7kNvwG3f9aZ&_nc_oc=Adp6iDww2lpUnpl1T9_0s1X0Fi_WEFN4c4yLUKt8XFhKOC_s-Mc_ien7nA9HkoH8Z9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4wWt8WSjTLjpy5uDL9vSerN7xhd1Wa8xcCl-ralFZqQ&oe=69CE6F41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-An'am", "keywords": [], "long_description": "xperience the recitation of Surah Al-An'am, the sixth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the powerful verses of Surah Al-An'am in a calm and distraction-free setting. The peaceful virtual environment, combined with high-quality audio, helps create a focused space for spiritual reflection and connection with the Quran.\n\nSurah Al-An'am emphasizes the oneness of Allah, the signs of creation, and guidance for believers to follow the path of truth. It highlights the importance of faith, gratitude, and recognizing the blessings and signs of Allah in the world around us.", "short_description": "Surah Al-An'am emphasizes the oneness of Allah, the signs of creation, and guidance for believers to follow the path of truth. It highlights the importance of faith, gratitude, and recognizing the blessings and signs of Allah in the world around us."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "su
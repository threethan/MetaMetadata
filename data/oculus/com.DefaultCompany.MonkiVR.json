=7f20f&oh=00_AQNGBlYsBZiwVSby1PnLEmn5ZuaeCK_6Ifws-RTl3TResQ&oe=6ACD0911"}, {"file_name": "Untitled191_20260126111327.png", "id": "920131760543239", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296125_920131763876572_3207604026592582189_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdCWcsS3jRIQ7kNvwErLOzf&_nc_oc=Ado7kDz83Ra2AneW53nr7bRWSQBcJ42vlySmb4I-Byhc9Yq3Xw5a533TsYu2xu_0Mnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR8t5Fa8NFG_3UgM11awZBVzfhVIJ6w_m6RT3WNAjdXQ&oe=6ACD0FDD"}, {"file_name": "Untitled191_20260126111319.png", "id": "1179529554163486", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307451_1179529557496819_1025258091738442802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiCah_Vmk0sQ7kNvwE_m_4x&_nc_oc=AdoAuDxTar1_Bw8CcbTpo9Nk8VnXUTZ6ivN24lheSne1l0sbHPO0jhR3cs8GgGx5Mwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV_R7jAEvvA-u8lzkRXyvef_B2C4VYX8TWw0xGEwEuEw&oe=6ACCF417"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monki Horror VR", "keywords": ["Tantan", "Horror", "Tomo"], "long_description": "You awaken inside a sealed research facility where an experiment has gone catastrophically wrong. Containment failed and the test subjects are no longer human: they hunt, they tear through doors, and they kill anything that moves. In this fully immersive VR horror experience you must rely on stealth, quick thinking, and limited resources to survive long enough to escape \u2014 or to learn the terrible truth buried in the facility\u2019s depths.\n\nKey features\n\nVR-first survival horror built for immersion: tighten the tension with room-scale movement and intuitive interactions.\n\nPredatory enemies: aggressive test subjects hunt relentlessly \u2014 avoid line of sight, minimize noise, and use the environment to your advantage.\n\nResource scarcity and risk/reward scavenging: ammo, tools, and safe routes are rare; every choice matters.\n\nEnvironmental storytelling: unlock logs, terminals, and fragments of research to piece together what the facility did \u2014 and why it failed.\n\nPersistent dread: dynamic encounters and claustrophobic level design ensure no two escapes feel the same.\n\nWhy play\nThis is not a run-and-gun shooter \u2014 it\u2019s a study in vulnerability. The VR perspective makes every shadow and distant footstep personal. If you enjoy high-tension survival, careful planning, and a narrative that reveals itself through exploration, this game delivers a relentless, atmospheric horror experience.\n\nContent warnings & requirements\nContains intense violence, blood, and jump scares. VR headset required; r", "short_description": "A tense VR survival-horror inside a compromised research facility \u2014 evade vicious test subjects, scavenge to survive, and uncover what went wrong."}]}, "developer_name": "Tomo", "developer_privacy_policy_url": "https://www.google.com/url?q=https%3A%2F%2Fsites.google.com%2Fview%2Ftantanshangout%2Fprivacy-policy%3Fauthuser%3D1&sa=D&sntz=1&usg=AOvVaw0gmjLcBPcebaLFVi8JUCmO", "developer_terms_of_service_url": "https://www.google.com/url?q=https%3A%2F%2Fsites.google.com%2Fview%2Ftantanshangout%2Fterms-of-service%3Fauthuser%3D1&sa=D&sntz=1&usg=AOvVaw1iugAJhnVpU4-TgNrezPrM", "publisher_name": "Tantan's Creations", "support_website_url": null, "website_url": "https://sites.google.com/view/monki-horror-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
v/t64.5771-25/499312068_1366851732169845_183508902581862488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-wpLJB1Z1YQ7kNvwGGumxR&_nc_oc=AdqWPocsoEs0kNvHhVefn_TBrgNcwEldocVz2qn-gNfnCKsPILtJlozJnINN3ONP_oQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8xU7hHl7FZPdEi-XD9s1oXkAOqh-YkHWJdGDsXv4ALw&oe=6AC674FF"}, {"file_name": "FINALES_05.png", "id": "2562862047473135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_2562862050806468_3981593933838214279_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0BxM-o_YUEQ7kNvwE80tx4&_nc_oc=Adp8G4-w9c5l92T5w1ZqaJejAMbiy6tupsPMzEF9lYVqCazzi-mfPaz_PcICLnspYJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdizx7qAfx77EVKoUUlJ7YTm91rlRaVB_WseJjhO5w1w&oe=6AC66D5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Marenostrum.VR", "keywords": ["education", "mediterranean", "marinelife", "ocean", "underwater"], "long_description": "Marenostrum.VR is a free educational virtual reality experience that invites you to explore the Mediterranean seabed and discover its marine biodiversity.\n\nMove freely through an immersive underwater environment populated by different species of fish, marine animals and Mediterranean vegetation. Observe the ecosystem at your own pace and experience the scale, movement and diversity of marine life from a new perspective.\n\nDesigned as an educational and contemplative experience, Marenostrum.VR focuses on exploration and observation rather than complex gameplay or interactions.\n\nDeveloped by X-Trudio LAB 3D at ERAM University School of the Arts as part of an educational project.\n\nCompatible with Meta Quest 2, Quest Pro, Quest 3 family and future supported devices.", "short_description": "Explore the Mediterranean seabed in an immersive educational VR experience. Discover its marine life and observe iconic species in their natural environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eram.cat/wp-content/uploads/politica-provacitat-marenostrum-ca.pdf", "developer_terms_of_service_url": "https://www.eram.cat/ca/escola-universitaria-arts/docents/sergio-cuervo-giraldez/", "publisher_name": "X-Trudio LAB 3D - ERAM UNIVERSITY", "support_website_url": "https://www.eram.cat/ca/", "website_url": "https://www.eram.cat/ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ca"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1303459129520114"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1623200779203600"}]}, "baseline_offer": {"id": "1623200779203600"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790790900, "status": "PUBLISHED", "id": "1623200779203600"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1322818020917558", "version": "1.1"}, "id": "2138803010038703", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1285928187939875", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1322818020917558"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2138803010038703"}]}, "change_log": "Dear Meta Review Team,\r\nThank you very much for reviewing Marenostrum.VR again and for the feedback provided during the previous reviews.\r\nFollowing your performance feedback, we have carried out a major optimization of the application and are submitting a new, significantly improved build.\r\nWe have reduced and optimized the number of marine models and fish schools, simplified vegetation, removed unnecessary transparent materials from fish and vegetation, optimized materials and rendering, reduced scene complexity, and made several additional performance improvements specifically for Meta Quest 3.\r\nAs a result, performance has improved substantially compared with our original build. In our testing on Meta Quest 3, the application now generally fluctuates between approximately 54 and 72 FPS, depending on the complexity of the area being observed. This represents a very significant improvement over the earliest development builds.\r\nAt this stage, further reductions would require removing a substantial amount of the marine life and environmental content that constitutes the educational and experiential purpose of Marenostrum.VR.\r\nWe would also like to provide some context about the intended experience. Marenostrum.VR is a free, non-commercial educational VR experience designed for calm observation and exploration of a recreation of the Mediterranean seabed. It is deliberately not a fast-paced or interaction-heavy application. Locomotion and movement have been intentionally designed to be slow and limited so that observation of the environment, marine species and their animations remains the focus.\r\nWe have tested the experience with multiple users, and the current build remains visually stable and enjoyable during normal use, including in the more populated areas where the frame rate can temporarily fall below 60 FPS. In our testing, these fluctuations have not prevented users from comfortably observing the environment, animations and marine life as intended.\r\nOur main reason for seeking distribution through the Meta Horizon Store is accessibility. We would like students, schools, families and other users to be able to install this free educational experience directly on their Meta Quest 3 devices without requiring a computer, developer tools or sideloading through SideQuest.\r\nWe fully understand the importance of Meta's performance requirements and have made every reasonable effort to adapt Marenostrum.VR accordingly while preserving the purpose of the experience.\r\nWe would therefore greatly appreciate it if you could evaluate this new optimized build in the context of its contemplative and educational design. If the application still cannot be approved under the current performance requirements, we would also be very grateful for any guidance on an official distribution path within the Meta ecosystem that would allow us to make this type of free educational experience easily accessible to Quest 3 users.\r\nThank you very much for your time, your previous feedback, and for reviewing Marenostrum.VR again.\r\nKind regards,\r\nThe Marenostrum.VR Team\r\nX-Trudio LAB 3D \u00b7 ERAM", "created_date": 1790501217, "id": "1322818020917558", "version": "1.1", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1322817697584257"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1285928187939875", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1322818020917558"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2138803010038703"}]}, "change_log": "Performance improvements and optimizations for Meta Quest 3.\r\nImproved frame rate and overall stability.\r\nOptimized marine life and vegetation.\r\nImproved menu interaction with controller laser pointer.\r\nAdded environmental underwater audio.", "created_date": 1790165369, "id": "1316596571539703", "version": "1.1", "version_code": 2, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1316596134873080"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1285928187939875", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1322818020917558"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2138803010038703"}]}, "change_log": null, "created_date": 1788604057, "id": "1287530154446345", "version": "1.0", "version_code": 1, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1287529911113036"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
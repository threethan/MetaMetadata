.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhuHE-5_3PIQ7kNvwH9bEsT&_nc_oc=Adr9lwWr685FwOQvVqb-BUpy_cgHhyI1626x7upMogE1r3e0zg5LkwUJOGpfUm1z99o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS-i5IGJLjGAfjkUnDCukots7HrPuxB1sz4s33S8uz_w&oe=6AA01617"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu9ZSrSA-E4Q7kNvwFFTlvP&_nc_oc=AdpbsZQVxRvfi8i3bBvGyctdrdkgTlr6AHsxEwjJbaAa866YqhTzuLCFw5pSz0oVcBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgyh5UCSjYt5e7RyXZNTG58VeBEZO8NEOK5NBeccNVow&oe=6AA01772"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDo70DqNmFcQ7kNvwE2_1_s&_nc_oc=AdoEWfXWMNbKZz7wpVsM2MmP27SCAtWEoSprs8q_KG-5O0oYy3o1Oib_ru9OmaoOhc4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2wehXwQfkybqwmtkgf0RYwOwxzWb80nr8y41xjkIFvQ&oe=6A9FFD99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEgrpIMISQ0Q7kNvwHUzWKc&_nc_oc=AdpTN2o6TaxBn2Xq0xFQ8l77DhgFDTfQQYKWgzlzYxaPDNtouHZ72Zgekyav69RM9Bg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ2YHGdGNtd9Fs6tORLRSm0JNqF3Mf0Ox2Nsf0Chr5mw&oe=6AA022AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU7EA47Jcq4Q7kNvwFQENO8&_nc_oc=AdoC086SvgEpRXF69_A7KJ8RqbdploNgZAJ8sM_84OxvEeC5zggcDlO33_6ISh7TX5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqTRWa5tZy5ldCHiGe1glf81LEQuQpUgtPdeHWsmE8GA&oe=6AA02912"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v7chE5vJS4Q7kNvwGTAEJO&_nc_oc=AdoARz1rOgeEtbKwBwW5b4qmaTB4JUr0E4ySfjOnH4cYK_AelBmgMBed0SJbsDe5xGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPZyLXAOmqR0s8Gkuuv7rFaWgc7QyXQZOlzmxJAMbxog&oe=6ABFBA17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZq6JCBm5woQ7kNvwGwxWM8&_nc_oc=AdqolkrRiWjAqNbP-aAn9SKJAxfiJZcFXXinNsfxTA-a0i8IC4PxDcr--yvrDKFPq9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB2YyNG-YDNXccKb7FFBAukbWQdO0fZWoEBt5iZ4c95A&oe=6ABFBB72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56jjEsAosOEQ7kNvwFmHy9x&_nc_oc=AdpdSJKZvDJfdDdXn1ExlAsKLgNlJBiamvpfY33lwB2Xxx_PTxDBZQGg-2jn5xNB6SU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSiiz4qbdFbPEp8mtTBoq98rxEwERkUnbmKrQzagGYXw&oe=6ABFD9D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MKOj7MefdkQ7kNvwHAx65-&_nc_oc=Adr5GS-mNIT6fzgr5iDIV1frf_tsAB_oBLz3CpAm0Z1gQqpk_zrew3TLc73_VzIngTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXot3YtY49YHoQzvIOwJUBB0tFRWnuvfNdHqbvXSzf0A&oe=6ABFC6AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A70BoqiwVMQ7kNvwEX4Rat&_nc_oc=Ado6MCBhYBx1bpjmW1YjQ5Uxpi43IDgZUcH1fT8fv2oyfD5MgkAJXnhkq_n3BSsWlf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEZ8fdWVXcGUy15Y9sN8zF5Lhm2HB2SxgC9ZQtjamXQg&oe=6ABFCD12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
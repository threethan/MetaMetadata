.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_sTup1pp0oQ7kNvwGFEelc&_nc_oc=Adq944XP-V4FdFiXa1ndVg6lKwev5OGDKBPASWjql7dHPjIT10X5dJQKYYyEH8xBHGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX-E5ykIe8CGbz_7b2dl4V7rYPFM7iYKRiQJccBJi9_g&oe=6A831517"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2DpaNHGZVAQ7kNvwFowXjY&_nc_oc=Adpz6zeOAfUyXdznfFqsJKRVGOHJ4FVlHlp7K-sOgcUKbLrMW2U5FXgsR6W5VDeZvN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZo_lPUON6u_YbwLe7AQEI_ngLr7oumq0jKNiUSiLTEw&oe=6A831672"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgWWWCRz1QIQ7kNvwGFYcMh&_nc_oc=AdqpQ1qWUINLsK-lGKKk5wkzC_s14A7ElWDwS9-k1onvv6JMcPx12NhldEIebq7Lsqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_1n7_1-vg7cJOvY0U-lLwrGJIS8Gk2Zv_yncKsjUQCQ&oe=6A82FC99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jByPSzvKwUAQ7kNvwGoQrpr&_nc_oc=AdoFOlLi--fU_Nsf91aUOBQQGl4NxNH1JD1wXMJPu3Ef1VPicdEthy-H2I47LmKR0x4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu95i4Yx5oiPV56LGVpdBMIL7sHopUB2Uh7fqGPiqGXQ&oe=6A82E96A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FBKDh3SrQ0Q7kNvwGn1XZ1&_nc_oc=AdqGnTrB3azQY7zlFBTIJzy5nYkxGEoMY-sUDPpyuv8oRT4YaJveujjKtkjbYp_ll94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxA9koaZMKnAcJ7DtXC95WVmP52_K-EJ6-UHH0jM-5SQ&oe=6A82EFD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hwrwQb-91IQ7kNvwE_dF9I&_nc_oc=Adr1oaG0eSTvg5PN9mkVhKSzCaq80kHwL8jhD_YHU8tUdzOiTaQCylg4yO_sDouKrdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0dkHDyYGB3gNJ2GBsw7I_NPIeQA97jAoUfZ815xYqgg&oe=69D11A97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF3qUV8T1FEQ7kNvwEys_TM&_nc_oc=AdohLAySYwe6s_-xrAr2mkenWmEPq21shlqqJKLyl0J1h2c5SetFTrWLtzTw2fly20A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKzVOzckkTIWQ7YuPADZCSZzN8-Hm-t5IClqvDIgw3LQ&oe=69D11BF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqHr3U_0DV0Q7kNvwHlHtoj&_nc_oc=AdptJh7HlR1fjEUOmlu7LYu73y8aRzXwCe5kNQopc19D3w3ggtD4mhnINKF9ZCgRoqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZLuzgM4sE-etyR2K61avivrRA3NrPV5WTbJwclO_9oA&oe=69D10219"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fALicRURzvQQ7kNvwFfg2bQ&_nc_oc=AdrvQU5Jpye4FkqS2EOSqyruEV3I2KHHRwaoZyXBnKgIHhVBXAC0hsWqDFgPvpE_h9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxcht0-SZxhimBi1Maw3a0OfPP1N49ZFmslwDau0Q1F0w&oe=69D0EEEA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-T1X4hQFpQQ7kNvwFtCJ3g&_nc_oc=AdqSyDrD3nWt7-apWnQ46Uizfjme5yHF4GPH0d69vyAMMoGANPqIZMSvqXAT1gqRRlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrwcCHfUD3OfW-oRDdVWww5YgP51E0vjWVdU0UXHgJkQ&oe=69D0F552"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
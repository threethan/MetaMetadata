.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwAzRQx5nXcQ7kNvwE_0RqR&_nc_oc=AdoXN4vaCZNCReCwqW6NaTDRFvRb6dql5I1op-bOD950mtiMu3Q7EEB0JJfr0UQFsIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqw8ZWI3PYsejMHrmbEmJaAYPKTMnwWSW-_LC5JP7Zsg&oe=6A897457"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmNGRK4XFEAQ7kNvwEiD5PX&_nc_oc=AdoV5hCywMRSg-4_3NQE67cCIkMj235u-Ifp4d37SHQMMMlUvwTb2YunIUwOzJ9pMls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdnol5epFHn__1TpQCve12kpSFrZBaz41KAinCe67aQw&oe=6A8975B2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apWm4CiSUe0Q7kNvwFv3dBk&_nc_oc=AdoOh2JmXCr2UtNYQSUPyLcN2dq7PMdZBrFqTr5Yo_N4DfUoPpl1FAUQeHpmrMHChTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaHJJSHDmVdbgSSLuBPZfhMIksgMHd93Tx4yJnV8TmIw&oe=6A899419"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRuYvl-hcHQQ7kNvwE416pE&_nc_oc=AdqIN6HZwHAPmKzekfdk54xOv5scNRI3vsQNzX2iEtLAHKTH4qPmH7wzMAGfhalqrL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkTDmzWSSYEDvydPTQmwpQeeFbpOIgJXbRJUQjagdfAw&oe=6A8980EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTpdNe9UEIsQ7kNvwHXrEZU&_nc_oc=AdrB1Sb7-GljDI363rh1x-2i_tDeujdI_mBjUszz-EeQnFFlWS3KM9CxuURYjvS7GMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs-bTkASyxj7zyze7XtYFbtstVuQu0icIRBmbYmwiitQ&oe=6A898752"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
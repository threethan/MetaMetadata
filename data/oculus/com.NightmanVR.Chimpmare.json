.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDHmCARfA9UQ7kNvwHHpXNJ&_nc_oc=AdooR77nk7DYpx-TGNCc2jYQbBSLSqxBfct_OocoYAkS7U4sjrg1442TSpwK_XnwF8g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhCJJUT-vpohWlIGFzMksNXM_bVy1wlsTZypaErfPpzQ&oe=6A915D57"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbd_74e5oIcQ7kNvwFlyIq3&_nc_oc=Ado96CVgYHjfl37EVkqcmAP_gZVTfXE41wBIUKqmpmY9T3pH-GfcZVBz5tazMGQgr9E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeXxoWyd-GThCXhBHQpDrz4i5BVUqGI2NMie8thG0YJA&oe=6A915EB2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwk9yKb6TBcQ7kNvwEGWU9q&_nc_oc=Adr5vCkVMUfulMFK880zv_mv1GW4WudU_cD_xPasGdFGVAPoQ_DcyL-YFv9-glhlRyY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY06vcFzxdL3m2UB1VG_N4LgLrjTaW8bzt3dyshcWLOw&oe=6A917D19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtIrH8Ak7-UQ7kNvwGhXFmv&_nc_oc=Adr-HdOm9Y2SgMDkQNR6QeCrcv399Abm1aDbKXWORmK_OToRdBukwXj3SdmAuwIPxzE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN02lWUu2BzpgrX1ouB8K51gMlbrSPSnvVLDzbubSSfA&oe=6A9169EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phVOzjoK6zwQ7kNvwHNvjG4&_nc_oc=Adr4S3-IkEZon8fxioPaQV6yeXw8faCJzVp4rSzousiRGtCJH2QvJQEWIqVxlWKXWzI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpez679nO_RR7pY6TnbHCmNwpJWiLW5XV6z1_P5PzE5w&oe=6A917052"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkUmLji7mEoQ7kNvwHxviJ3&_nc_oc=Adq-iq6k46lLJLb-QXpH8iPv2BYzAKZxfM8lXkna5piHatr9-AXf7iZyfAbpdQPTrIE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbgaM6r7sKQGjFx4eBM9feR8tCyLNqv0MsapLH8aAwcQ&oe=6A54F097"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4--IzDb0DcQ7kNvwFCEpKf&_nc_oc=AdrlAe4z87VIAKeEEM1Oj_g2ixXz9PAb5KKyQOUMZKAZabBSzHXGlebE7bD7zDE7qZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzLC5aZplfEtpoXVyZ_O1rUPoWyZGY4MwELnOj7AIn4g&oe=6A54F1F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em0ou8uBriUQ7kNvwHQZVoY&_nc_oc=AdrKvMBfKQewmgUPIzkMxW7Bsp___6DiA7TLZysEqJ2Q58Hr9kZhBsGGjdaxBZG8tuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEvCxICEulyyWmsXQt3j5WsKbR4IsScZmmjFCvYGa61Q&oe=6A54D819"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRmtsKmIl28Q7kNvwGM9ocG&_nc_oc=AdrB72ihJHb--q-WTDP9TsRERWGi-ie6UgtnnWCfvfQhuq76Io9JeoKbMDFkBzHNdfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgLcj25TEKSmdkah3haMNKs_7_A7tMJegQlzQeBaAwVQ&oe=6A54FD2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFEvjY0D5k0Q7kNvwHdGYPE&_nc_oc=AdqGM_HUcJwQFK2MrV5aRngKWLuqEJMGRgiN0z_DF-hrYd9_QzEebEATe1P7K_9xpgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1AInH6u3j2fQ7DFzsdcEX5b6vSQpiVDGgtQBpnwfgsQ&oe=6A550392"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
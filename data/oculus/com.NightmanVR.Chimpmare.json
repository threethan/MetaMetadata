.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_tndsb4OvsQ7kNvwH8t2nY&_nc_oc=AdqrtLVuxrN2VtZWU3FDD4lnu1JmnkPAYGti7Vn2QOn6NAUV0F5RI_hqaEQ-PqjrqI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WYJcBvarG3LdcANsrZ4mxKu811OxVFjSSBGtSGm84_Q&oe=6A0F1117"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg_mb6Jg0wYQ7kNvwG_Rehg&_nc_oc=AdqpFK5RwtBHj4o3heVqdJ9Qre4b0qQ5wxt2huaDT8gl7YowFdWz1-Ug2J1TBXwYkMQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45LHeQyov00tpo4qqBLTCvFs-Jk0ghSGXW5Eqiai-8dA&oe=6A0F1272"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjglXnnCiScQ7kNvwEB1u-Y&_nc_oc=AdofWl3AUfnlodwfoUh9sw6GujC4U6aww00uFKrHZW1xeU66FKpusJJQWX23TEGdor4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44wpKudl_bXX39yNaGNb8oTDhFympksfEjJ4QAue7dTQ&oe=6A0EF899"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whYb8_-OACEQ7kNvwGorqdZ&_nc_oc=AdoLdvWok9fyEXy8u6BH5Lxsqq7hO1vkUC14NBF7QglaGhlYy2qT9Z4p5E16eZHjIz8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_nOGumiDZt-zdqqMQtGl1_jeH4jyxnCqIuK35RjaS-g&oe=6A0F1DAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwOfVAJnt44Q7kNvwFkHNCa&_nc_oc=AdrHKqdMDwQShP0KXByIRSv-gOvBmrspNkpfjVai4KC_B69Nx0jNbpMOpZSqrk07l1U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4az0OhRV_xZ5DJxDuhbnFm2kr4UFuKQ375o8eGDn5Rcw&oe=6A0F2412"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
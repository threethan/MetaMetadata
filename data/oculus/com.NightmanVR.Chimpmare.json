.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p_v26qf_9cQ7kNvwHKo5VR&_nc_oc=Adq_p1zJhR5O-QHssbPi5d4fwBCDCUGKySt5MHolvEepDx88zTo_ReB6sOvAgpmZ6r8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOssbpjNDVG_tI3OY5LdQ0QY8p4RnlkiqU1xSWbLPLG9g&oe=6AC50017"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yHxrNpw_wQQ7kNvwFXKbje&_nc_oc=AdrJN0qbeyw_ndYZHL257OM3LIXtbVVs40Ep64TQ2Ogd7x04JY16tLSK6x7sZf4t72E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUR7rciTi9pqb0Ev8Wthkdq5nVuifUpSqP7azVaFC6ew&oe=6AC50172"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE3buMgOVyAQ7kNvwF4yE0c&_nc_oc=Adrb95b5Ol_L_m7K7qdHm8gEI-RJDUmD2beJRPQ6TPUInv-azEALyZUE4ZkBmKrvdXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHAEU5l42SJ-m9rm-1FgvbdHC3Ha3wAOSiG9mWImKbxw&oe=6AC51FD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_m2QKmQimwQ7kNvwGAsbOP&_nc_oc=AdqsKQgfMIZfLX2RI_A9m-IpDYupN_ZwgFCc3o2t0pVi9Vm25ZtC8SfHI7Z9jGusOkQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj4XB1OLHV6r8I5FaSjM1ySEyMw_ltN713TfuWndJN7w&oe=6AC50CAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhIEiGmTt0YQ7kNvwGjZ-rt&_nc_oc=Adr0XbX65g2rmVeB0wcsecasTXtp_sBmbjznA2k2w0UH6uhj2l4f63qE_fo7ApRSEKY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Auho6t-WRAj8ISEhwyjTqo9sNURpWui9hYmDKsQaNg&oe=6AC51312"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
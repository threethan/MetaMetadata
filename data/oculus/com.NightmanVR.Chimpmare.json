.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1K6K2ne_pgQ7kNvwHrf8yH&_nc_oc=AdpPF0BQqBbj9HqqcapnaYG71T5lmE_UqwGoR9JcZWsZQCpZe1PreZhrdWzbzfhTh1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7FnsJo8XMXHdfE8eIW36qxLUCxJi1ranCQcRDudlnMg&oe=6A6B5A17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Tbba7mwDcQ7kNvwG6AtDu&_nc_oc=AdpjhXsFjqTzwsHabnBf_nLygFY6z0VNCYYONI4XMRuk5Uek4zmE75GtErbxSBTMyag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2ArBYxmI34A3WmU-9TjtCKD9_yfqpB0N3qnKhYlBKTA&oe=6A6B5B72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0VhUBcRuT4Q7kNvwFDXw5H&_nc_oc=AdrOEtCxyLT9EWNQ7UAP-YdDi-Si9Kkw3CRM-Y6G6HE5qJutIrlQXZISqPkEs3j6VMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgA6K28Hfr5YpdoFDKNH8ow-Mc1CVyLccciQhFgFrbfA&oe=6A6B4199"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8kkpP1Vg-cQ7kNvwEGVpwP&_nc_oc=AdqBqwG2OYV9i7Tv4bZ2snd-ZJL2SR8jZ9h8nG8JsM48i2lZTbjDwf1N7EMRhglr7j8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGCd0--795wtrhz_oclezcG69Ad-MxvVgujTgDpwtVSA&oe=6A6B66AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGXyoPBN8noQ7kNvwG3-_pW&_nc_oc=Adrro9A5z3fKiwRoJhxacDXVeIFR-Zmp5QGLXva6WERWg7-8O-uMTlGuKTXxnUyX7jA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_ybtum5i70BM_T4ibuhWgiRX2h859tokiTHMofbM04Q&oe=6A6B6D12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
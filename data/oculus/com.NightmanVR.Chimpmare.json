scdn.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_tndsb4OvsQ7kNvwEyJkzF&_nc_oc=AdovIk1rmGZkAzsqGlLvHp-E5P3hCyOk7kH_zrEz_A8p6CcnQ0V-bHdEt0LTETm1A1g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RBgLpxpQUfRxmoOgDVLBPFZMtZIp_wHJW64_lXbuX7w&oe=6A11B417"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXBAwBEsDX8Q7kNvwGif5pG&_nc_oc=AdolvVqGbcGyMDxxdi4mI12CDRYMDb2tRiFE2GHyEeJt1WLwJ4vlLRHxs2egGyA4CMY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af751t623QA4wyGmKDFOoO6ZbfHVnpPb0U2aXTO_vE-acw&oe=6A11B572"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44xEcoG6P2QQ7kNvwF4ltw5&_nc_oc=AdqQzmWCmrySa1U9mc3gd4L05xkn5aaFORlCWL3wOGlpP2qkvjtYNxHD4vRqug5nrJk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mS0Cr-vGzRAyx7EOBpnB_O0vBUnU3J-gj-vnLGtPMHg&oe=6A119B99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whYb8_-OACEQ7kNvwGEtYaJ&_nc_oc=AdqrRsi5WM1t7avs6X4w6DsjhbcaXXfSDBNs9OJifKIPxooGqaVKnE1Ztnzql8h4AnQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tbq49McDONrKMO_XTIDSrntZm5Yr-zqPrZWiganQDQQ&oe=6A11C0AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwOfVAJnt44Q7kNvwFQ34-0&_nc_oc=Adp2cPUmRUU71rpg84GDkUjpGVpBlhHQNEtlOVUeQ1GH7qHp82WOrPW6uffNgDWJ6Ek&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LgBq0ZqR8VAQxm3rGKg18ExdUPXEKxS3mLIgeDC3ezQ&oe=6A11C712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
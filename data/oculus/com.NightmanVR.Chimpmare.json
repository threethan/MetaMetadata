.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3K5LGJ1SeAQ7kNvwEV9MbW&_nc_oc=AdpQZM7T2v1CyUdeRpcNEahp_8VlXZLip4FYV2olPU_Z4pHb9o4C41TTzN8U-_CCkp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIwMg0BrrWsqDgJz3b7Un5heEZEtdnq_lak90GZt8ArQ&oe=6A60CE17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vxyc5jAAAgQ7kNvwHsygDc&_nc_oc=AdqoISgsvIIFM5ZFEYi0j4jyCMuVuMIvRBg4lORADkRSkTb-ZaPfiXR0fPpJwmmkiwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkrUNr9tKHiRUgq8aho2pGrlQMRL0DUvtwpG1L5jW9sQ&oe=6A60CF72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmvSn7-gAZMQ7kNvwHUCG0d&_nc_oc=AdoswtbDx1vZN9JUTOPzUaOXJBNOLv383NRZ2pR8l9lZIQWfjeaTaPpZ6xsgdavnXUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkvFr7nQBs7yZJhkPL9qQPvn-yrCWKeFmlr43mQU9_xg&oe=6A60B599"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIP2VaxMqhYQ7kNvwFYpf7n&_nc_oc=AdrsltpbitCIsBWy9Se3QlfIUpJfAaP6Ocxrz7OHjtaT1pNDHV4LW5AW_zBl7LqNlJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpIe6C8FvhlWwyhOedCzHT4G9VwOdIcVRHAZG7xHsThQ&oe=6A60A26A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8h0TFFVCpcQ7kNvwGYdbxZ&_nc_oc=Adq2P6CTNdFhu_BTttmFN5kYsIW39V4Hs31zKOSh5d4OdF0FVeO7qzll8fdDjiqjJLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-YbtDne0k9afVuzxjTl_nBUiA9SckZcIyYNenQmaaqQ&oe=6A60A8D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
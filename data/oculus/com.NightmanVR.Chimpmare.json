.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClfBc2QN0ygQ7kNvwErCBw9&_nc_oc=AdrAmGrxsM2xlIoYXtMmfCJznIHGsHjtslchrXRKoEeXPHiRN_PtVw0M4wS7Z0FUFoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHJvR6dB_6pQlj2VvDLv2bjil9EoB3i5LQ_a7oOyDS1Q&oe=6ACA4617"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHyti6Kia48Q7kNvwH3COb-&_nc_oc=Ado2fXWm9yK1v0yPAa4lSk5SV7Xy8zqFaFruCzAVzW-f9BMgn1f4A2Mbn3zREXTOik4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTX06siq9Uijp8rcd57pUQNWjE_GYMITVVYuGXdGxRvA&oe=6ACA4772"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bU1fuBnYrcQ7kNvwE3527U&_nc_oc=Adrvlg6eX6hgq_QB2ML11HkEGb-58l5ppgRblcOqAoAlJs1BSRoFbLl-PvJIoKV7BpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD4VwvF-mAYNLjFj2VmIfCpXAOOS_ua5qVuPdDQKYSoA&oe=6ACA65D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECBXVCTLKzoQ7kNvwHkJ97O&_nc_oc=Adpnt5qpP0BPiZ1MWKO98xEVQdVKw90g_rjaOSSHgaeH_ewfGaEl6ldS9oOJt9n3WhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkcc7ZEVmAhG7eFsdG6tV1FLm_Ynbj1nxmZrA0Si6UwA&oe=6ACA52AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIGURaFbxzcQ7kNvwHyv5Y4&_nc_oc=AdoTnp7spOSqu3z_uc8mCqnVsU1rTc_3yBUgzgvPyOgl24BdOcdfKlw7I9IXbIgwJLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUq7m4mbqw6L3vOTDvcdKfPGtoHZkJQeacfxptW-ZCxA&oe=6ACA5912"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
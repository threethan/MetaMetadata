.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_tndsb4OvsQ7kNvwEJHW_K&_nc_oc=AdrtdQOlS4CHq_BDjHyaa2Tdr6CZ_b8AuQdC8nt4eSsc5jc4mLB3FGJ6qkpih0QwQCQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WBc8Z5TqvsvArj-pWF4Lsp2bbtFFoD9MQjwR6qP7Aqg&oe=6A106297"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg_mb6Jg0wYQ7kNvwFznnbL&_nc_oc=AdpCUmIP2R021C1MnTJGNN1zm3kxX2ps3warL1i9t1h9-ZqnJspsDuNbXGNHgNPdhRc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aGLh3NzgY3_5LIhwWnvRq3Lyp8-akmcWWsLYG2mTq2Q&oe=6A1063F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjglXnnCiScQ7kNvwFzzCJh&_nc_oc=AdoSn-HgZUW4vfz46o7WbqtsDUdTSauvzbCb318B-FeVG37c7zYDJ6fDK5LRpvwCg8U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t7xhFDGEy05aVtku6LHD0DOaTuaIptLazhDkWwtt_4A&oe=6A104A19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whYb8_-OACEQ7kNvwGUM3v8&_nc_oc=AdqsggwD3x7QUL87rLVJN7JwzpB3GwGS3-Ru-HxHuO5r2zDzzC46H-fs59v-sGiJvFQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ro11ZPdqeNEj9otlQqFTosRanAYw9rnEPwAw3dRbAwg&oe=6A106F2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwOfVAJnt44Q7kNvwE8wXjQ&_nc_oc=Adr4eZrY97XjxLXD0qfqjWDedg_U6X3ZBVItHflYULaevmJiWiBJLtQpK8JE8BvkBhg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kS42tpCvVAF8UZ1RcVgF0gOZelQ7mt2rJI_qW-CqK0g&oe=6A107592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
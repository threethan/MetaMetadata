.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxiBse3BtgoQ7kNvwGDKPz7&_nc_oc=AdpAgqgz-CVzFkMg7IvZwm81v7SGx9QH9rjNWfkgre3DPAhxj29zmj-jhaojHOvnrRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDh_WJNjXbzMMjTD_4pljaomFVOL8EQk6ed_AmwGxfig&oe=6AE74717"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvf35TYreA8Q7kNvwEki2J6&_nc_oc=Ado4rChdsF4iu7uNG7xFDkqBLdVtRUR0vMKOr_E1n69mxx5fXBOMEBOjGk5s9Hy-efQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4tVID5lLnIoA6cAsvF_l2qHNNrVedzfdlyh77o-OJRg&oe=6AE74872"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtQkidr1jqAQ7kNvwE1IwjL&_nc_oc=AdoDivmTeEKww_1LXhRnXeT8TAXUUbOLTm-TmJWa7mfdBRLHnM3vb1Gj2S50QLdbGzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Y2h24tKd5OmoIdOv900e5hX-mDp9OsuxFU9xGGGdyA&oe=6AE766D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cDPKw59wMIQ7kNvwEv8cR8&_nc_oc=AdqfqUCpfD55l67LEwbGH-Aq39Sx37u88KeUYEkLPjDat8Ictru_VtSOCml3gycYp14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWXEyeYnqMpbHSSxCCu5MggvLGavVXF8H52UZXZmkIZQ&oe=6AE753AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcVyYfEPAgkQ7kNvwFwexg-&_nc_oc=AdpPj5SJCxzrYFasP2QBsBh_ewRyJ2Y8UJk2Y-5w7Gr6HFgeCHWQzGYfHQGZhBGr9io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhOWocFWJtiSryekID7gTk1AyjVof2rSb-UUC8WWU0rQ&oe=6AE75A12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utlnYsN1E-sQ7kNvwFYoG_6&_nc_oc=Adp-btHEWP9JvZ91mXHP-F3vpFDg8DbOcmFuq1xfFNTDo2utNeHcziB7Q58GFUJtKgE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rD1kJ-EbWcwLNb3XAGs72Skbyu6wWcVlIklyBf1vggw&oe=69D7B217"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FTCp7F2vsAQ7kNvwG_jea1&_nc_oc=Adq26ZxuZGuyujZkxEQASzByDQc-2FaPUWCIBx1wgvqEPWuYbxtUBnadYL8KgzTnL-k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oWyb-lNuzc1qfxRQJn0gIj4m8lWC80BgOHe77bkxA-A&oe=69D7B372"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSuhHhnCB-YQ7kNvwH-iW0z&_nc_oc=AdrS588GoB5j_VJ9V9P2M5Vk8p0tL2gFY_Q10KwUfn8VjVkMGZLECs73A9RsRyy2ff4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tm_ltS_97U7_1mgyU6Hx0iLkg1q2NTXx-Fj8LwILyfA&oe=69D79999"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v75Fv-nlaN0Q7kNvwFwUx92&_nc_oc=Adpm8B0Qs7_G-3V37C7tNbREUv05zW5CyTD1BiimIkZkIS1DKstxqQrVNggYkv9Msw4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PRTaWEdsMXgE0K18wjwkgsc_yK5yjLh9qXx_NIizoXA&oe=69D7BEAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_gvXuoiYU0Q7kNvwErIrQS&_nc_oc=AdpJpce8uc-jNrcMudnrGjKMcQTVBDCf620swZ3-bKjsQiB80eaF-q6gP-C2B5vK56k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pEnwQOFojsP4Nej_1Yfu6uYkCY8LAID_p8x3_7HasNg&oe=69D78CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
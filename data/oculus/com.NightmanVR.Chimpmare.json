.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAeIUI3W_OoQ7kNvwEROOAJ&_nc_oc=AdrOBXemo_8M7CqEss14QiPBa4ThbyiRqaw58g78urnFjbJCXhcrOQoKMc9Zc2aZJPE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPraM6ENP8E9Ufmh7xN9OK0I8NEpSlLE0PXTCjppPF1lA&oe=6AE20117"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YugNrTvKmKoQ7kNvwEA86hK&_nc_oc=AdrOj84ShNMIaH05riZQ3Ad02Nrw0hx6myMMeIf0rQPegv5kqbggPZrWf0rLRgmFMY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkdnz48i_1FAvgz0KWhp8TLMSN0lJq3YEnRIaSs7cC7w&oe=6AE20272"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtTzOwk8OE4Q7kNvwFaHtZe&_nc_oc=AdoQcrBjaQX05nviWW-ZOeCBe_6cTJr-nDqMA_4Ldi1bgx8XL6h6WEcuz80MeZ-0jkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpFE3-QBDnGCPLcJmOjgP7PNc9YH2FqDqmsy-4X_dTpQ&oe=6AE1E899"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QESADLN9CXUQ7kNvwFcxxJu&_nc_oc=AdocG4vwl-trcECf5rcI5S5Ep_xEwVAcSI5NnTvK6XZSjloIgx0d2c2ZsIisbT1kO8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmTYoErHv0PAU4P_MKu-fE5F0g25DBDQUQ4wnnpfu7bw&oe=6AE20DAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OnaQdNKMNIQ7kNvwEv7swy&_nc_oc=AdrhwENz-oskHMVQcsQQJpfMETLiI9pBi9lFYPcj4FfcOTFKz4Oz8Y7rbdC6wrRkyzo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-fzcdJRCtYPeOSMY-vj_Ph48oQ9o39nOf2YUGUw7XHQ&oe=6AE21412"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_8DuLrLFqwQ7kNvwGioSuz&_nc_oc=AdojY0WdYOm00w6DPtVhoa1eKRGF_suNnHh4j4JXhuZZxm6UthimUpT6ED85sXgadQM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PslADEUU_fj7uUweyzRUTtkBF6U4pvgXeyJ1QFTMs3g&oe=6A203497"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8jknTfuu0sQ7kNvwFpB0VH&_nc_oc=AdqySgXKB9WM_wA3lPAUzE9pd5Du3QnYi9kR2Ukqc2A7CB_b1gM5Vljm02q0HbbtlWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4txNnXvDS8JuovkFUhLWM1LO5gCYNOeD__j69x6k7h0Q&oe=6A2035F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDDtfnrVK-UQ7kNvwEyIV5m&_nc_oc=AdpXZrmKhEu0pmBybwhvh9xxJq49gw5KX1edLR2bQcKs3_bg5JnPJRjQPkR8xfWdROA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64KtEnyF--eMMy3a9TqA2qAU3xPiYH07LnVjQKL2u5zg&oe=6A201C19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aah2QtEXpyEQ7kNvwH-P2e2&_nc_oc=AdrTt5t8MNokBB1Rt3CRD8mTxQT8M_gV5Ek3BxxfQFqfBkM3jL4YRQsGWafzZBWp4E4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oUyOIKpseETVBOpIdDeuXwjkzZY0ehZCaGXcjqFMMFQ&oe=6A20412A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELws1BdTS_QQ7kNvwESLWuv&_nc_oc=Adqvy9Wm3tw2unDVRJKi7ra1AXGQ8dEAwexEFfCU8uD-btQXJwwrZ-lP0Abx2V-mcvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oB_XADjfUPCsbYuagQPBOCwYNdt-TYJwJfwiCowm6tQ&oe=6A204792"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
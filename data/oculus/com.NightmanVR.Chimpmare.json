.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roH8biCvy1oQ7kNvwG9ah1x&_nc_oc=Ado_Fmo5gXxa_5DqoBZeTeq1CyA1M8lue-9da-vUe9Xc44Vtfj6Tvv98l_ryZ9LfTdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpzsrgw2p9xWv2VaAaau9JO2OrNqx609ws3siwsgknoA&oe=6AA2B917"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu9ZSrSA-E4Q7kNvwHm5Ns1&_nc_oc=AdoCQxq57tx9hsIM95HS159PhfQUW8uc8gJIJIL1QEHu7vg8rZfh-wx9ZlroRKmYNjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdBWCxY-3jQP44o3zLHZMDoC85PWy4rZsITvBd5wjN7A&oe=6AA2BA72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDo70DqNmFcQ7kNvwHFavpH&_nc_oc=AdqlbQQnZaChICgBOPzOtjHaRAVrVGo1J552Sd2B1Z9MhlnSRSeH1eb3TsHfAXpRgM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDdSvT2OzOxjaFSFx25YlJCig_HM_aHpUtyXPS1e0AYw&oe=6AA2A099"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAD7ZnpgG_UQ7kNvwFZvPg-&_nc_oc=Adowuo48M-7viedxzlZCZ5TDZuFW5LXEMiHUqTfVzK7ybeJ_vYmopREyswgdS2xt99I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlhdeC6A0N558830TSgh_apmL6EJPdfoGryu3e1hH-JA&oe=6AA2C5AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpvQmmfjcDEQ7kNvwG-UZZE&_nc_oc=Adr6rwZ8BSpMuD1vDTzaYjH3q0EO2VbNA-xus8inEv5QlllVgloXwG5P70pv7oiQ8oI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlo1_ddttEZrRXQ1HX6ZaAT4Sn1u4QubH5EPU5_5wBbg&oe=6AA2CC12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZsrHnEXclsQ7kNvwEBLQrZ&_nc_oc=AdkK5KdFvpgRSACu2raYt3ICqlXUGxoaURxKgE69NhkR9ouoVU3CJjy5ORaQJFcHESw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs22Y1so2Fj-9t8rcloafiNwT0bWdzTdYqH1eM2ibJVxw&oe=69A83C17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qchOiLe_rgQ7kNvwFSoaQW&_nc_oc=AdnBX1qgc8GVNIFQalJdNyP-a4tgmg1YqSMmdxNiqAYHGaoCWhBz5NaykeLHt7G3ARw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuko9DckV1Mbze-OiT_rua7k3JrIoe4jHvH00xpHhGmnw&oe=69A83D72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuYvNsBXn6AQ7kNvwGkSxyj&_nc_oc=AdlAk3-kZyn0B47Gj-vjNG9UW0P1AAIrpt09RId1IXWunZGToQf_t7Qj_31BkQHaNAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftvHt863hDQkWe3PDSDlY7wKUCjjn1tIwZ6bP-ARtbXMQ&oe=69A82399"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYcX9AhT0ckQ7kNvwHMLDqv&_nc_oc=AdmGEnELRO5somgFPRhEFGlGdv0ja-TbfI96Y2rRkrRpfL2bIG97p1WYcdAFAH_LHiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsC5pYijkDQlOM14Epe7HRFD7htOVMOGVCNwGTBL5r0lA&oe=69A8106A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYew5TBmMGwQ7kNvwFk9Xwm&_nc_oc=AdnclqCYtHK2zuEj3brI5J0vjaCTMkN9hbVQt5dioVSgwqoe7iXVp10DTKqsCDKkNm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftptltkNE_S-rfRx7jOwgsdVYSfktbdR811l9qlSEuxOQ&oe=69A816D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}],
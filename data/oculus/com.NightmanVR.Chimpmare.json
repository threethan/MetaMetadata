.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPRSQI1ZiA0Q7kNvwGY7p__&_nc_oc=AdrgcqD6vr4euKtR-fYfRJKntsvqWLJuO9c_RwT43M2y49W0NlcLX_oMGEUxc2bug1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtonsBUHDtNUek8pJdFm7eAXz7Aw1_UZSzEh8ThJOXAw&oe=6AEB3B97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Zetw-qeHEQ7kNvwGm5kJN&_nc_oc=AdpPiAvuxdH7DkkFaEKmE69iOHcfsCNHlyIVOhk_neaq6a8ohG71pWblkvDaZom2xSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXEGTYvDsFlJ-r-PiHifpWqNHPdugknDVEI-QvUgytug&oe=6AEB3CF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S9k1eTLpL4Q7kNvwGL3-C5&_nc_oc=AdqIGfHF-av2cA2yNOOHRZWERr70cD_CNYIeIuXxuz3J4WjThd2FdkNMGTNyTOLBa38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuLo1oZ6fVTdP2_YY8w8aewJeN366LgOMOrMpe3yKE5Q&oe=6AEB5B59"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHDz3LHFViQQ7kNvwHhkDc2&_nc_oc=AdpsOV64Hg4IG3HGhPMgwYk2mncx362VQhzuGFwoGMV49agAGiR0D0kLDPOU2YL_ZxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxgR27HdlIoipB0FqSwxuHR50_qa7_KsqtS3OqPAcSQw&oe=6AEB482A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COz8uRokifMQ7kNvwH7YNR3&_nc_oc=Adry8UWmAO4_5-zsogeM2aEUXV9qtecTOdoE6h2U8sE5WPzj1mrAfNTg8_87iRJPjR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIs4TNYBGVebTO_rVicSHQZw8d6pQVs8ndE5vmP34OMg&oe=6AEB4E92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV0aau6CSZsQ7kNvwFFUX0o&_nc_oc=AdqCWy1lfMbkmg3PBClUBVFk_AwMxGcU0VGPNRicxUUhcismLtFjl786agvmDs3GCbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwYmwqudEedubDBqjP0X4YGfV0rXydRdh5PqKMz_QonQ&oe=6ACF8C17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ujXNTEtW5YQ7kNvwG1nq9P&_nc_oc=Adotpt2g9XsYe5iBNLaj_KFsiwkWDsekCAILXCld8VJsirk8A1JRJOCikDXs4nFzkKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqQ_nCcKF-kSm3xpMHkxFNCDbxtztmECpp49T6nHhfTA&oe=6ACF8D72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQPVr1pfk_UQ7kNvwGZB_C5&_nc_oc=Adrt3AQbUkvUp0DfiRHJ-shDxJkAIsbASPmnJ6AF6kWkEamCa4Xnz2PKwroju9EFq7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWDxg86z_LF869bu6857to0Qxfty8BvfKDmCI1d3xFRw&oe=6ACFABD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnD7OiB0SAsQ7kNvwH9ZgZH&_nc_oc=Adqp98OBvtEw-VVLeYhflenpiOpggQbLVx_RyIC5OgQd-jny0EDZw0vPXP27Ncg7KmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqqZy2rXhAUvo0j4YHG1oMWlw-wjJjyF3ivSzeZP4Cxg&oe=6ACF98AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOq22mvL_0gQ7kNvwFHnPJG&_nc_oc=Adp1S4bhJR9XFSlVcVgy2JWO1YDgByRH0rgqJXykE6Hb4X0WoCUVzhppz6C5fnLIh0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgj2u4wtfohSfmix654ZWvbQ883e1zKLVFP-LnyTKFzQ&oe=6ACF9F12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjz25yW5xtYQ7kNvwGfRHgK&_nc_oc=Adq4tLzBLDjg7LbmjSDll1kM9pRJiZi836_cUcnJ4oVPqS_oFLDPtJFB3lvUIkbBH6U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wg9mNM7Bga9ydG5AvqsGrOtQgmzB9Qp-PGNHBUtYpkA&oe=6A242917"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAepQxJDXb0Q7kNvwEwmZX1&_nc_oc=AdoRpL4ywkynOs7vsdWOeBgk5q3OocOo0mdMSDQYPy81C2AgpwZV3jtLadmQBnnp6A4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ys82zmEMkombNxjH-REmt4GUtd-fISE-QXncpfeAAZA&oe=6A242A72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nqyGFWXbJYQ7kNvwEDjH1_&_nc_oc=AdrI5Yu5NBe9ydFSpuqqG2j2nzvas4v1j2uKMeuxD_lp7LyrmQbfj2mM4XEa0drWpLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8ddY9EK8yM6shAcoNyppKwH6VF9zNwAt63wBcRmIftA&oe=6A2448D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvrxo29XAncQ7kNvwEHDzVZ&_nc_oc=AdpXpZ2iNLJEaInGstFTIxFIyg5Q0XSww_hFmLtH-5UQ27x6C3cr00nmT1PQrkfYu38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vhybkigK-meZhVMd_YJl9lSxaWTqlDm9cR4yBPjcXPg&oe=6A2435AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYh2k6ZxJO8Q7kNvwGcaEGQ&_nc_oc=Adoal378n-lAxt9P6m2U70Kq6dAhbplmClChi9TgswVCcZVEmW45VcQy9w-dXtriTew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VAvX0i5I180QcnKHPzE7gsI9rsTCn-iCg4NMBD_E9kQ&oe=6A243C12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
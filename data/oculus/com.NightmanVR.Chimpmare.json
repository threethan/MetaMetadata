.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuCb1QriREUQ7kNvwED3-jZ&_nc_oc=AdpsaTSM8UdYMqbxCiM_BvlyQ-riNsWD1OPmOhN5EsYc0Wr23ziwkyc-3K6o6KZP0xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xxg569gWikOORmI-ztrcCWCL8DHfy_RaqK-2Jcs8KmA&oe=6A37EF97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_nckxxyz8Q7kNvwGoVsH8&_nc_oc=AdqF8taEniUQhKy0M-uGjtjginECkn2tziFJB1aKI9xajOO4vT3KHQE-UbUv8g7J5PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A3w7opugj1yv70vt7-Omxh67zZFt76Hg3zDGYZ1C_yA&oe=6A37F0F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-wVInrZJQkQ7kNvwEQNsDR&_nc_oc=AdqFiJ1fVnr0LZRmkCYMN-54ZVO_zH77nzSAcHDbtO0xIhJaLsUUd-hhVFrpq2RfMuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-f-5_V7iCsr-NDSHkgAPghnJarz5857hXiEfiKEL-ww&oe=6A380F59"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i70sf9CzBREQ7kNvwGarhc5&_nc_oc=AdpcEIVzTl0521Rxvd2JHBEaSXJzQO_DZmgc-E5qFLzOxlMjUZgmcvZ1nw-XsJukCTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xEzM4qe1Bn3tfdbJzCbcTQ0DZThHiKhBUIaF6IQODNg&oe=6A37FC2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8Xzoev3eRUQ7kNvwE_XClD&_nc_oc=AdrMO1S7C2UigRhOlAU7jelhILQUR68Wkqi25GsumyvcV7nmBbbM3yOSNqWPsHDTMRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9In1fNAK9A7lZ_NDilIq7SqD5G49OugMi3UJU3yuAW9A&oe=6A380292"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
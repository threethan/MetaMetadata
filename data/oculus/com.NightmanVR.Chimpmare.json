.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEDnZYeh_bwQ7kNvwHAo8Sa&_nc_oc=AdphH4fR1vjsmK3K8-xoC7XAZ7I157m8pnjbx_mKdeixY4PGihZuOz62qdSt9hRrp6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCMEtY7MqTHjdopSmCW7ao043F7L_zjlXsAlPT_hlrSg&oe=6AD22F17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ujXNTEtW5YQ7kNvwHTQhlg&_nc_oc=AdqRFNV2x9wDUj8tKD5N90nZEYa4s4Y0wJpAgJRSLU18xkCbDt-My4NA6eqok-wgisU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0TlyS6BY5_C0PYcbjVwoy8BG1L8nb8k-cCtMFd5CO1Q&oe=6AD23072"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQPVr1pfk_UQ7kNvwE1_Bqd&_nc_oc=AdrM6YqwCbOsuZDVGcPWXKbUp_iMk1CoaE4s8dkVyCe62RcBJMEdjuujcUti2GaC8XA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPemUuL1DejYa5_AuuhgE5-qh9_jqqUdIoGFlo6ewSoNQ&oe=6AD24ED9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmMHu5rDQocQ7kNvwHBE8Du&_nc_oc=Adq6aWgbHzGPdqA26Zi-eZ0346TaPdcrqIlzTsX86puDXMdRfmNdOIQ4pLBeG9pol8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyqruR6-hOQ45XKpoQBQw0HyBR61UPtTCm8lIVZV4-vA&oe=6AD23BAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcaa0ln77g8Q7kNvwEHKPdG&_nc_oc=AdoyGJhY7frI6n3SK-VxCpFck4VF6azWe7V0rmD37Sn9rWA-ev-W_nTtf2eeqb8xLjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPue6WJKtmF_RWM781kIDrqT07NTHzmOoZzzOUoMf2zAA&oe=6AD24212"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeQCK8Pu_ToQ7kNvwEoGRdV&_nc_oc=AdmTmxV9DYHYJphpSXc6CKgQwAiFyL0gfsYZE0j5vwZQhOj9KZXYpZwaZuB7VZIjRjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt-LzEac1RiFEkohjtGpQrD7VrCCvKhnwTVmCJOwFMPA&oe=69AED397"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QP7bzZQ-zkQ7kNvwGikMJ0&_nc_oc=Adm6c2C_8W3CRpMeicguUDqj75aNh1dWFk7ZJtn7SHtUFkbNW9fV4gRozOlImithlsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjliatcSJcjhqTfXG-0wd1KRT9IKzXJjn5J1XvyIo08Q&oe=69AED4F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LgMnTbcLloQ7kNvwHXUg5x&_nc_oc=AdlKiHMy6WhyrUs3gdpf779vIa9vrfpry-MMk9cXeyTbv4QmzvK4AuKvqMTpWh4WERk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxZ3jQTva3iN0y8cdwFXKWYqernjb3dxSH9Vo-BFO4bw&oe=69AEBB19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP9cpjA7piAQ7kNvwFPZ_Qc&_nc_oc=AdnIKAhes6LenYz59IEf05U4Fasku1Nk3bQ_PQ7_v0sK-8OITIsM3n3EeZXQC4DROA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhutH7yxzgDWkGpLYy8UgdU7LTG-T4yfvvRq61W4xCdA&oe=69AEA7EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1uxhqAPgWAQ7kNvwEG5H0B&_nc_oc=Adm2o4CcWPTJAqr-vVKtCRW9ULzUK_8_ApnjZIgkpoKNu33G8C5OSZ9_rT9lZCWEnDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoVmxNJKo7ZqLFG4Fsna__BQcujH6hWYM-m6NMGrCpkA&oe=69AEAE52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}],
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uT-iA5BKNnQQ7kNvwGBkA_m&_nc_oc=AdrUJ1L3YPuj6LGdiHbGdYIZoVa1wv3AG7RCRrnsAn02NjpyU2-oHlZvxAs4EvtG92k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn4qjMvXNaHnOJMNfQwIILmfJIuNwyJsxNOILIBVkBFg&oe=69C3EB97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLNbGDS2y5gQ7kNvwE_dibp&_nc_oc=Adp6qRmpuGNWWpDLUqsXJtH6fhZFgbIW7FXV3Rn6AkTTXKNWOBTZThUgt7IFsGbgAdw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-np98XbgbDxDCHRQVfT3zU8loFq4yjCqfIMt7EH-fAw&oe=69C3ECF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyZmoi9SVG8Q7kNvwGKjX5l&_nc_oc=AdrPhKyV-AXTjMc3hg4Nzlq0JRomzBbvGM5heaS_nPDzigqSB0QKYIl7UpFU8NvLGbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMwiZi9HieCy4F-JUxuQCduL5v4xWkBu3WM74gCoznoA&oe=69C3D319"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMQvZFaSfYgQ7kNvwFvevmV&_nc_oc=AdoT_HwXRgUWzw6peYpcAMdoorbjanTpwdaImFKz-yUN7KbflYQqoaUJwCuxtloMWMI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkRgr8DduNAB4VamUGDlPH_PSRUMGpro8vKhsZFLCVNw&oe=69C3BFEA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fbkqkBE3g8Q7kNvwFBURYv&_nc_oc=Adpvg6_9rYgg6wHGG1dotUAew95siybVwpuYyrXbNmTjV-xD0cEq3Ldypa5XEkL7yf4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx32lYWeKWX1HJ92nP9RwwBOCo2Iv8hux3C311eUZtUgw&oe=69C3C652"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
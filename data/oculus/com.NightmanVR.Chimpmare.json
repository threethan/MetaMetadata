.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKJ3LQZ7pl8Q7kNvwEhRd0W&_nc_oc=AdpAG8NnSzSL8_0QEj_-37fLbNpBOH4Akq6BZ34hRPaT0hupkUmJO-hp7IMe4U_sfVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdwi3lZ3h_QYSeOgOgWjKjarBhedqEAo1iEjsyLLUMJg&oe=6A5CD997"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ_-Yam1vM8Q7kNvwFeQrq3&_nc_oc=Adpde8pUP4WVTi9wOnZLy9kcyWxsPfVyQ76hUHPWh1roVGboDk6HRDXfZ7n1L0E80gY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbe4lCbLVDJ2sljMie3aiEJjfeOGbcskrdcII8Irx0Mw&oe=6A5CDAF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx6bdPZFrMIQ7kNvwGrKnhZ&_nc_oc=Adp3kGIZPLRzvMguGTLmAJFDm46_kAOB78nWln5Y9T7N3SOr8eGhswEkdvMnUByAnsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn7SHihTLzzj2pd11hygK7pNiUV0KX8ItLFgxAdVZ3kg&oe=6A5CC119"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miLM9rHaHpcQ7kNvwFo1WCf&_nc_oc=AdoXo4V5V0DBnGBtRMcCnMzDcf81lhQvmphjEpArO9aQu4Ksy3T62-AISfGLchfql88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoYSIByxXikXi8OyHgbyRHLuKLbUMZbgRHRNodycTI8g&oe=6A5CADEA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmpkyPBtitMQ7kNvwFeO6yg&_nc_oc=AdqzUZEjYEcSlOAb7wst98x5Dbhzmv7UO5pJze11SXIFfuYaP27Q5cd6Fm2rrMGetco&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMp7kWxjxC82LkisOtEPK_FQakpndBYmoqlhxTerLtbw&oe=6A5CB452"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
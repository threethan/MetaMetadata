.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_SoIgzDb-0Q7kNvwG5vhzt&_nc_oc=AdokM_jpoRj0flxLSzcqG_VVgQWlyx77yRQp1_1UhT5C__3xigqgLGozYK1IMRvVdcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af911S0TxEcKNvIBtUIAo0kpoVVGJwSPrGwHqDJ5burUog&oe=6A2EB517"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVzHbD3DCtMQ7kNvwED4eSp&_nc_oc=AdotmrMcNTBAwCV1rpZVqLs2sigNCZsneVevlsto5u-PyD5wDHOjIHflFOIAbPa1LQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zRweFD2ODcWfmiGujrXcXFKoGBhcac9ROyTdlfFja7g&oe=6A2EB672"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h1tuwB8NR8Q7kNvwE_0ahG&_nc_oc=AdphUtLjC-0G8I7QZ9ugZNa2Lm1gy_Kis8AYliJvDk82QTRPJLdZoMnPnvny-Aq10d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TiVneVyzSAZfsr2dBp7OC--AbdotB47OnH5Xkkr38zA&oe=6A2E9C99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcQflJTGTMwQ7kNvwE0HsmM&_nc_oc=Adr9K6eI0AtRHC3RxPN42iKxAZ0FJ6dYrhnSy9d6D7Hl2Whu0BYk4IwYJpfSqZDoevU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FiFyS_Nlcu3p6ZByh3hNsr4YghJNWwN2Ay-U0attCNQ&oe=6A2EC1AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PADvZV4X1nwQ7kNvwFi8WyU&_nc_oc=Adrs3QS2R8cNlUlG0HQTzrgzxX1UwdBLwI0UsvGUVvyrOXVRTqKKgyL_qmCgz-i8uVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zy8ROGgsBnOvckAJjkgjin4-kP275-1T-LjjqKCwMEQ&oe=6A2EC812"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
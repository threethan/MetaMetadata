.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_8DuLrLFqwQ7kNvwGaszBq&_nc_oc=AdroqfJtGQg0-kfNKpvGSAK9fDwN3X0m_s-SB8XEspw1XB6fLTH4zxJSwVFgvYeAcSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PP1T6aV8XQ1ZbLKt82buwiaWAHVUVw8RUz4Yb7u5m-Q&oe=6A1EE317"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8jknTfuu0sQ7kNvwGiRLR3&_nc_oc=AdrvvK3SPEXkkv0BlYMW7y0jH5i5CXFIyC4Lm_aGhWe_9gP3GI7r_jzKDc45EjSbmRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bvJQVop9JtojpROgULvBoPVnhJQVObWplEqFR9KpsOA&oe=6A1EE472"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDDtfnrVK-UQ7kNvwHN8kZE&_nc_oc=AdrJ0sJiw7A6WwTQ8x8QM4SDjnmN6fnq25eCKEKdZsrm_7ve1YtojPA_6c6ljKlt3Yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L9ordTpU3AU4w4O8tbk14Xnpz-f5_XYB_lK0WgGNR6A&oe=6A1ECA99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aah2QtEXpyEQ7kNvwHlIFF0&_nc_oc=AdqoAt19cCm8yTx8Y5c1LZHbv3t5xzV8uwkOERv_DafB_lpPodkOq5ln6ib3QryOvrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46KAAbuH873Txx71Gg2_-eK9xpmxYoMOL3JsLS-hy_wQ&oe=6A1EEFAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELws1BdTS_QQ7kNvwE-TPYl&_nc_oc=AdqdA-uHPgkstvBkhHlMk8kz07DCDYMR1bSkdcttrmCUhiq1Qfcv1DLO62PzXSRmn9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CfpkM5lnrUXZrNrKC6_UgJxEItj23GHevJHXmmTNFmQ&oe=6A1EF612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
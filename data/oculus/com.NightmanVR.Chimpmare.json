.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kY1t8A2RdAQ7kNvwE2FSu5&_nc_oc=AdozvAALZn7gxDDUZ2nl4rhf8ta0wiVPLIxUzHou1-HxLyw8XlIqwXwMW70srfS5N8M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9O-WrRGZwqWwCS-e8xtknnG8UB-yGesmFu7cACR0akQ&oe=6A8822D7"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmNGRK4XFEAQ7kNvwERqw_I&_nc_oc=AdqgTLlsAsXXXvdgkYYoViTF4SsrMnEmwIk7NNeE4UZj01s5jNRmfo_LyWlXB0OVGTA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU4fEPhinbteDbY0t2HvdfygxxhKTtKMt_sHGGRci8Gg&oe=6A882432"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apWm4CiSUe0Q7kNvwHMUuF2&_nc_oc=AdpU8R9cZT8sMI24wDHer2xYkQP605dekNpYJSCt-1SUqzR2OUqJq39goQTv35bAyS8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErVeF1asPxsukkpQHoVrEzgJwa4jrr2ECqgfnTiMtXRA&oe=6A884299"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2xpOuYQwRMQ7kNvwGKWaeU&_nc_oc=AdrgGku8wBJrDqjsczdn0lhHBZ06J6AgG9m5hSAidObOgv2jere1BwbnVkh3GjGOtIM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOBeej30lmbfPxySD5jTwt3bT_dQDjR7VNWatwI4wsfA&oe=6A882F6A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKK1Rs81Op0Q7kNvwGTbi6E&_nc_oc=AdroQzrCm6pgUutYOLOlGmJxwmPT0Sb3zhMqPTZE6KKVCcLQpCw-pCRC29LGa6gPt-A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQI2dnKyIGbG24wP2rDU9cY6RpXgYHvIxeDe8YLueNOw&oe=6A8835D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
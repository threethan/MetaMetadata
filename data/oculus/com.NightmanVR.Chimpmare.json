.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhAJ6sujzTsQ7kNvwGg09CE&_nc_oc=AdoYkEdZuODP2j5rlTTWDgRQKLl1th9impzOz9VLAUpkljHG7i5jPi4ex3WDHQsdzyM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPczI-fvm_3kVhvEfAOGed6B01yt5Fyohtky5xtTIrxQg&oe=6ADCBB17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8XNXGVgjVwQ7kNvwE2zgpX&_nc_oc=AdoRfO94WAQtKBL8DNMSNhobsGdo_Ayo9jRPipHiC97pvV-rSHb5indyQxUTENMr8D0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPZeZVsaVXwTjx5yKneRG0PYV8_tLxAQl3PpQMHEj4hA&oe=6ADCBC72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P2vbRgTEdgQ7kNvwEMdgqA&_nc_oc=AdojJDl-hQQqLrZIekqN1GrXZP19EucyyrZ_wi0o2x4e2U6foVKqFRFZQLUA7E1Hv2c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-qSA-xh9B8GVs2yTJZo5ljn15MPdViBpev-77Oai63w&oe=6ADCDAD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqUmCCviyvUQ7kNvwHN6eM_&_nc_oc=Adp8ZwjRir06KSNU_QbfrGvSZPAyb6_I6CuTD8YrIeU6tIakncEmTbPq4wousp80I3o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfRLH6ze8SePnnQiCJ_k_JDR9bmvqIrJ2i_wuAX1qTlg&oe=6ADCC7AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk_d72YjLW4Q7kNvwE7MFU4&_nc_oc=AdraFx1nZm8wZQGOowTogVz8v1MVWpmHqPoTtmdtBC2pkDe6dOi_IaFK6IAjzHnY9z0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO__XA0V2uHZuo2St0EE0e7pYIQLqmOIvs25_BHU-I1Lg&oe=6ADCCE12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
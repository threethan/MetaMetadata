.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8uvAevIQdMQ7kNvwHoXF8M&_nc_oc=Adpl0dBwcnLtnblEkX1wLFrOiFVsuUzvo9UH58sSBe7VW_UyDmUNZ5XJ3AuDxOmvI2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HL3_sM4_6mBPvrlQFUngvzk0Cwk1MrZd_VeYkh2Q80w&oe=6A296F17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2f4dvMrfGEQ7kNvwGJEGpe&_nc_oc=AdrKwZRdTGrJmu4H2yHp0Lq6IChLDZABcHuMaRkfWy69G9nCCxnezbQ60GazjkMGfVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UQU4NuBiTsocUvRPRmIWir69Ici6ps_VYQJXwmZu__A&oe=6A297072"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5LcJ5_TuRwQ7kNvwHMNehY&_nc_oc=AdrpQS-FK1crG7NSUeGJx732OswhDsZTbpOTWqFEcnIlcjWyhVIrMfoWjLe9seQyMkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4i1tJJAwLMGY_N5V4-LzGM0HQ9QcJR9BzlKgCpFRkLQ&oe=6A295699"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJwgkCUQhCIQ7kNvwGOI6cf&_nc_oc=AdowDt9vuA4uwoOCtLhY4kx-VPW1JvxsvXZL3_tD86V-Pz2C_QexY-bA_kCCxgBHYUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vXvjqmqXfbXEEDIaiHD90IsGfWyyKbOsP6F3OP_-ulA&oe=6A297BAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nOsPxJEZYcQ7kNvwEBbqnI&_nc_oc=Adr0IFpAZrPmJtTw6oZn2TebEZOdegUsny7ZUmtaSsWFtyyhsP3II241WPFvpkIE-1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k496GfqBoQVNHqmMSAFaoTvjgHuPksc60ue2cATRp9Q&oe=6A298212"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
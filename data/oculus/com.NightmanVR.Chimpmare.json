scdn.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuCb1QriREUQ7kNvwESbOUM&_nc_oc=Adp9FjTIOKEwXMtlTgZN_J4ZreHFcB57XoUfoSs1HZLi5Y0WA_yR4LyIJO6sPE1-Uy8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U3CM5ucy8ars78PWoKzhmkFnMbHXTVmSswVGmxezklw&oe=6A369E17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_nckxxyz8Q7kNvwEnw0q9&_nc_oc=AdrGUHXA4cKhsupoDHnyE5DBsKVb3hYEcWREx3cAY_2xLajKHj4Y8BFha_LyrLyJNzY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A1nnLFx7OZk_jdx7gF7p6ElwHninLmLPJIo952mwOjQ&oe=6A369F72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-wVInrZJQkQ7kNvwEWObtu&_nc_oc=AdphCbuHJNaEUeV4_WsmWm6iHsoJohgYGJil437LkI8-r_0cl7WKYuh40qeqQkMzoV0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o_ligDKHDMuEefIMqiVAgYD9WIAFJ0b3A9aZHI7Tcsw&oe=6A36BDD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i70sf9CzBREQ7kNvwFubaqx&_nc_oc=AdrT0wV9rcaA_oG9CrEtSHf913Sm1UfyPSy1cOhjqy6nDIjIQg5veCXN7GCGasD0Dmg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86FmyYyExep7cDGt3jWrC4wT6hT-QXErBXrTml96uueQ&oe=6A36AAAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8Xzoev3eRUQ7kNvwG-mor1&_nc_oc=Adp_zRd8dc1WUvxvmzaIJSLRRsb3IpWRovxZZhxzJudQUs_Jr801Y26a11lCWNNFgKg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b7gSm2w5293NIOPxjaLFkC1q959vpPQpZBVV6G_Rjcw&oe=6A36B112"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
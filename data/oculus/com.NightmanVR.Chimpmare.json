.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yJqp5g0E3YQ7kNvwEyfjwv&_nc_oc=AdoA4nWCFRkcU8bRV12cnmOHl0Y7qtGzMosxg9DINW7bL94UFMPipyeEt-9QlxYNJ4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxESfORq8rV6FZnJipHjVUB-0Z9fz-WczXhESKegrd7Q&oe=6A7C4557"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFKxfPmNOL4Q7kNvwE5bw62&_nc_oc=AdrRV1IDXjddeOjAAHT1W0EubMvPOVJ2lLo6JnDo18eUoDzYdJs1ifyKoBtJDFph43M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfNpmNHgIWjbupZwaPoCwJg08QKIjN3YlUEArD5a0blA&oe=6A7C46B2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPBTNJau5fkQ7kNvwGnFwWo&_nc_oc=Ado0n5OJCmaQoPFLMz0LbeYjv7QGm9WZumg0wLyhghfCHXTeFV01KkyAicDD88_MMWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRGJLnTiV_ZqMc2u-xuKKFpSWOsl-BIkKTa1JEg9nndQ&oe=6A7C6519"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfEXfjyzNBcQ7kNvwHpn1yK&_nc_oc=AdquoHeAM6KoFuv_YK30SZM-9WWYYWXj8fLZCLgNL7Q_ulrDQzBciAIY4AxnRxo1RxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCn3Lq9HYyiaA4XgZjRmYdImC4wcu5XrspcmJc0KG1jA&oe=6A7C51EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB4XrnkXZCUQ7kNvwHF67Z8&_nc_oc=AdpbGlnWcCgD3FNwc0wUUkNCAcAhu5eSGS0_E1FTOVbLzXOkVxJgu0TUj2AG3CMMhuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExJRL6W12qZJxOdjBwbbol_rJSYjkFCos8Tq7C0Cx_HA&oe=6A7C5852"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
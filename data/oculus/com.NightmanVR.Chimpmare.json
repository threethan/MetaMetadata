.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Onvdczi8KOIQ7kNvwEzMPPR&_nc_oc=AdpCMrXhIEiMpOlYfZn_CoHLJ4BYTau7FflLIjd8aCkBFham4UkKbyggi9aOSu7Hj5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7inDOLYiSunJ96-yRXRgKq6rY41bV524JDqeBwj2OKRg&oe=6A145717"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXBAwBEsDX8Q7kNvwEk4pVF&_nc_oc=Adrq0QpRPsq4lQLbTn9QPsI9fYLTFUxUNUFcz4kODbARIXxrq83MJeeT_UNX1UAzNRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R8-Vi0qgjZ_F-U2CSBev3aWkrRs-ZEPlg53RVaojIQQ&oe=6A145872"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44xEcoG6P2QQ7kNvwHgfY0S&_nc_oc=AdpOF7NX78hs0NVeB6JW4wpTJQ_qSI6wP9iPv9G0cx2uDRA1RNQ3abdX3styQhQgGjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D-y59b3fYmAVIeJPwKYYwXvlcf50i2MZN72qCf9H7Mg&oe=6A143E99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfxWfik2zgsQ7kNvwH4duQb&_nc_oc=AdqQdJLcV7q-OFDmnp6Z-GISx37hkgQqL26UTq5w0ZMGxSKlHmRrQ6gx-dpC76oHUfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uBX1eHO1-bBc3RjhF4gE542VwTFroZEu6i1wWDPgGpw&oe=6A1463AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXLAXy8jolkQ7kNvwHUUN37&_nc_oc=Adrn1_LuC0z7rdQuRMOfl_4kKy-0p5SUhn5nbrUNPDdevZk-lnkKyK37cwj7ssFkv8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-usPDge4X4zfu4sRJwZnVOhFayaYXjSy6_UQU5ttCAA&oe=6A146A12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL_JT3PGI7YQ7kNvwFkRXvB&_nc_oc=AdrfWOWi5EDN9Wf1091myAwNRWY1QOxwVjtDmDwVIvssj6n3j5ZSQE_8MrRUHZBZXkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhWzwOU0AkjYXvL_l7hPHgipSTdxMn-JHwrEHKM82ncA&oe=6A50FC17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXNAvZkMHagQ7kNvwEx3ErF&_nc_oc=AdrNo4iJ0JmCjuKJPVFOcx3BUL0mxhinyoKDVYbPDmb1aPg5nV23Lp1ZgmdlAexIBko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxuR8_3DB4Wi7o2S3Lq6_7woGY0xLKCe-hAMJ0-BQqDQ&oe=6A50FD72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyco6UkRF_wQ7kNvwFagEp_&_nc_oc=AdrNmLN2xLIh_PQ02TQTzn0102bQboGHw0wih5yyizEEGkBoU6l8v_29dgAA2YltUec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrDNviGkiFXJKNqql2Ed6ZYcx5i7pRIkXeeUlzgMnjcA&oe=6A50E399"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLOgiwIrF_YQ7kNvwG6Ux3a&_nc_oc=Adq2CLAERlK_roBPa6ebtqeuEPmrF54kmA5a2i5AT0bWGEyTnw_LCew_NYldmTWwUx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXBfYaWOYJHnE0-ipv1fayaSZEkxPCyQnhRKzoO8DU7Q&oe=6A5108AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GPhfs0j37oQ7kNvwH4hflm&_nc_oc=Adof3v-zbGgQ4abxZ7s1ox62b8ykxYlji5nv3239XJMPA0GWd5uQY9DVtCEWCYciysA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnPTyuMoy3aoJmuD-7SkHhfKx_97t2XDU8L6AVYBQd-A&oe=6A510F12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
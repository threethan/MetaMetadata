.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5ldntEiBV4Q7kNvwEowKy_&_nc_oc=AdpzU4OVf_sBGjimerUiEAiXzvNLvBK8ROGB-8Uo3BqQhW1QgrUZL9hDPObf8ziR9EM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gBtNtP5v2KeRAATY4rWlJM-q41RE3_XCQAqvogFe2Zw&oe=6A427B97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykC83pfkRJcQ7kNvwFvNiBd&_nc_oc=AdoB2MmL7AR-Aj2oxv4hMmTAlsNTUXe16JOylkCeUBCXvamBEPvQEBjBtCFZMZWId2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L7JaZRh-vAKAXYC0ml2BO49IXtYeDGV7-VdkwrsFB_Q&oe=6A427CF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gggfr7uu23AQ7kNvwEUO9cW&_nc_oc=Ado-S2996iUSDG9_jiX4sjyLghuqNaCrG76OtZS5m6urUNuxJwtMYl_bslwe-M6MA2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vNQ4iK7cy-2qed1R2XMvA9VynC73GvMdZsICByLP-Cg&oe=6A426319"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yty68gO47aEQ7kNvwFI7QXh&_nc_oc=AdqMfXhVXdHznWIrjMXtgEgWAKdumaNH72g36QC1Yvw71IF7nUuLMPqPDAn1FUYh88w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OBWpRwWPyvKRHXXEp6FdYs_DxT9ffPrmmA3aFea3VSA&oe=6A42882A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nd6CdcsQbeMQ7kNvwHIOqGe&_nc_oc=AdrNVYUvNLv1wDP1C_LeWYzPyi43W1X7vze5yk4TTk5ZPwt9iPASoKFjoDyX86DBvsg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BdydVCZpyXXcNFLyqcRRfMVu5ca-mpUvdETT8l2zPnQ&oe=6A428E92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
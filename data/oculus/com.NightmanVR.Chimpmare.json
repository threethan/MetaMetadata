.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x-38CQxeGgQ7kNvwFRlvIP&_nc_oc=AdrIS6Oq8hjzbGAmhwyHo5CPYdiljmeOLVSplcovJt6qOjcnnYNRKARvhTVrmZwnCeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-BoPPUbOo_434DOTmaY8jpX5qbmBTxS3-1QR7QMmfBQ&oe=6AA55C17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sza6222FYGsQ7kNvwGdtkzs&_nc_oc=AdoKeICMY7WADwIDRdpldVg02a8e5NqZR-DwvCbMz1Z8dMUkDYF2Ajk6SpJkmo1zT0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYzQV1cjSGGJvntmhRM_Yxtl_QbAZW27p9Ydv9O5NjCg&oe=6AA55D72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSh1C9IIbcEQ7kNvwF6XxUd&_nc_oc=AdorubmAePQps6ua0w9cvJ4aO3SpKcJ57d-oquVNym2ovmaQGaaehRQ80FI5ugr-78s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUfb_BzyQeosHsTxRpAq2xBoRWuB7b2z5z1gxMN5RfYA&oe=6AA54399"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9tNJ0hB-ykQ7kNvwH68wwn&_nc_oc=Ado7LSk-4zATeNcdb_HmlnCVOeihjUet9upqbqzoH5K964_My74RuvSrMJGTVBXNA-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkfojGaarv6dbg7x1KlZqzgxfNkmBVMYph8nZwmtmHBA&oe=6AA568AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcHHxBGURT4Q7kNvwFATE4v&_nc_oc=AdqmKFxj-Z7txPP_t1Drsmuk-GyAyXM3IO3WsNY8VpdUB5q4KyCoxSzZTu_3653kqHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN86BGYVvRyO7nbAN3_zoU-H6C2zrDVRQ8dYoc6zzspQ&oe=6AA56F12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
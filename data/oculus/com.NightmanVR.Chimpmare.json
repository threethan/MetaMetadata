.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKEBN0ADWVMQ7kNvwG21E7m&_nc_oc=AdpYqhsAPqfTK2C-EjkECxBdEVnCEsucrjUDo6i-s2rxDIYN6FPyh7Jep-3FudFiZ5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM2dolmZtQfNAw93XVRv7JPOVc0v-ZRNolJkCRXyGHQQ&oe=6A579397"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4--IzDb0DcQ7kNvwGmAkTe&_nc_oc=AdovANEu5xAljyHBVAt_7OnPlqUULPYXPnDjMM9AO4YwhOyNnt24_HlLg0IXNH2mNSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_oG2aUyW0NINYW8Si8gg34rL4U2f_CsUKiUTCUo6Jzg&oe=6A5794F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em0ou8uBriUQ7kNvwGrsAwl&_nc_oc=AdriAMq9Q5ZrT4yHbNNQv7chguWyz076uEAcKOXH8ebWySERuY4xWf2Jj1ZLAz0p13k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcV6z3pTzRqIfpsR2eWif_Hs4zOA0Xr8T-H8RRoub_Fw&oe=6A577B19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4lHKcLJPOMQ7kNvwE633p9&_nc_oc=Adph6-b30aPFIeaH039jz6Z4a87RzZGXS0LPv59K-PB2KlfaPuB0G3fdWmcneoUk3j0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTgZ7Ap58O-7NxFKWdpW4wyiotFEh-NwrAc4t5yd3vCQ&oe=6A57A02A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THn7zjTGnlcQ7kNvwFgsIXU&_nc_oc=AdpRBprHFSViWzmjM9J1AOd9l3h4j-ohHSszb6TGGNKYNuvAQNideMaEXnCCTLxoh5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq2AH3-MAyditepQzhZ2tdyt43n7n5celP_8-e9RXjNA&oe=6A576E52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
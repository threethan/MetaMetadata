.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RdtsOHv-FIQ7kNvwFyHY9w&_nc_oc=Adq48Fn9-p1AnVP0HcGC0fhcLFvK5anVMqPihe1vDCGB298vdl9dPglm2dOAmBvDkrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrT86gWmLFhqT1-JQxR0xx92iP8YArTqmg2JlJdGFbLA&oe=6AB92297"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bZXT94FBdkQ7kNvwFSCSld&_nc_oc=AdoJ4FBmUL9Zf-Wa_molT2lKg6ZY7Ap4Gx1OsfUGPhLJzItlisEOSll_gV8tukHiSZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY1NKy_1pIb9ZEJjsUVLAKWumceYLkxUn45HGsgHdp4Q&oe=6AB923F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77gsgBjiDhQQ7kNvwENr_25&_nc_oc=AdrMzBPs-sgUI8tai0xB018v4b3I84p4L9sXDjG6-bJcU8Ong_9WQMpZNZMIGYENf1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzG2kn18ns8l306VJv1apWu4fFK_dNdR3x3_DMtQKWzQ&oe=6AB90A19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxTLzTQ_E4UQ7kNvwGU-bdt&_nc_oc=AdpT3tCRmH1M4bORQcb3a3mP1qtpTj3LYDgbKXbPXLxaTEQ1cayKNBITK2xmTh9BwdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4PYBik_bLzU2_ZaY1TaxDhLSa9JQrOfOvlKLuiqgiTA&oe=6AB92F2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2aM6UHvqBAQ7kNvwFie1Xk&_nc_oc=AdrDVPTzETXco7-7GicgeiWClbQ1PLQWuofKvSsF3nWbHwa7dJnL0xyxEsGOQj5c0hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6c6N0ycJGesEuyTUISm9xfjA0m1JkFYmQYNOst8jzzQ&oe=6AB93592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
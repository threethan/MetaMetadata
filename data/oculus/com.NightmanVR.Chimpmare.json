.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s46qtpydroAQ7kNvwFLP_c8&_nc_oc=Adop8QMBStvs8R34hUYsqS1aXfnjP-ZxmItYSixCoIfShzwO43U4sFoCKWoAVr8geNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYJHYujGJXbWwg-VQOZwlZEl7uAP1H3qfWW2UIbNEg5w&oe=6A70A017"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xm8zzbxQOQQ7kNvwGMENAn&_nc_oc=AdoJ8Brx1dwmZ-n1i6l8onMR2eoIJKw6X49W5wJgnn6Tnv67fScu_X3rAds_G597wX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVEHuRrt2KlR7PkbAOG1lLnb-6CzCdjofCFDg0iYl7zA&oe=6A70A172"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTnENYDqEpEQ7kNvwGGe-3_&_nc_oc=AdpGxJwB-i5Nkpw3VIQODRj2dobInj-lSn9ljxDxnRmmCsaoMKyl-CS3LXFDTrcHYzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-tmI-VFLw7peF1T26VBzIw6pwREmwCM3rpmm8bInY6g&oe=6A708799"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdvdjiFu5mMQ7kNvwFNEjgR&_nc_oc=Adpb74VDEv7KDNkO6zeZqVnLdo-EAHoLJkBbd-38OKos--XDsrBM3HrvNhenix8qHCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFED6fbMtxILnflbTAPrxVsvG4EL8UIQp_-5yE7QOVmKg&oe=6A70746A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYnAWid_H1MQ7kNvwFwbkub&_nc_oc=AdrOhScPwfVAVWPrM-pwYX10h8Gn4c3D2MGuWQJjtguRSwd69MJ4mDpLmjRhnqvrEFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ1UofvsK5JH8VxhXaYLwmBrM1Ks2fly49JzGoNup_Pg&oe=6A707AD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
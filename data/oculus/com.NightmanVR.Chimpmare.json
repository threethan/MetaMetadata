.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_sTup1pp0oQ7kNvwFEzTFx&_nc_oc=AdqMYUuYpmDX6wV8YgAiEA-mY_9kFcDzTDYHGjTFGvl4HUM8Q0h-mqRqSmWcBg7r3Bg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU3_4wVc-Zb8HFyeNeU_BaNbtExbUKidM_p5ChHNq-Hw&oe=6A81C397"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2DpaNHGZVAQ7kNvwGSNkgL&_nc_oc=Adqe34Gq2W5ruKVMNsZQmWDoY51FaMkrMm2mjcLEp1o4h12C2cWZ8fXR9SEU7WuqLwc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_n2Z4n-l7oLu1qeYCQbi2NKTLfu_GFfQdUAVBoIJb8A&oe=6A81C4F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgWWWCRz1QIQ7kNvwHUUhzj&_nc_oc=Adqdhp_0T6wJp0RaO9tWDrSN7rDgIQYxU6gmBXS4a6ZmIeiUYgQIT8ih8WNxLVx0E-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqhgrZdtmOA5LTcCxxPjhSpRUySMgJlRTBRACHv0jNtw&oe=6A81AB19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jByPSzvKwUAQ7kNvwFYayW9&_nc_oc=AdohhpAvMOEH5Dg-c_RFiBXClAs7HYW5PvQt0_fua4Wm5Ua3YtBS6vkTd2fFGCuKjis&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8WSVlehbPXHw41kiUiS7mIHOSmL5QVmFBLHmaIET_gw&oe=6A8197EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FBKDh3SrQ0Q7kNvwEx5lCT&_nc_oc=AdofqUJwjr6pxjvRCYr-BJS-wHoOfC1rssav20nyfzjhnCnITUeXHb3ngTuXuP5gIH8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj_usvw_7E76KNdIZ0inBkCrjl_A9oLzQpXxfk6GtnFg&oe=6A819E52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
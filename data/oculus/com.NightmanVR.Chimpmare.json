.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXcBnnpS6hwQ7kNvwGkDiGm&_nc_oc=Adqxr8LBkwod94MCsLwDWN4iHV5KbLmoBWKD2smZUQ09v5LeGDLoDYOio1yiZNmt1J4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nh0Cp4MWdaZX7i5w49gZJVstJktR9XYBOrqf7iXsW1Q&oe=69D66097"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FTCp7F2vsAQ7kNvwHSwjiR&_nc_oc=AdpUTeSuKpAfXwwfZCaK6Ssb9oPZ3qG_1dqmVlPRNSr7SZpiip1XfuaQL4cjPy-2Y1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17h7TyJG3Wpttrs4Pk82O10a1JUWRbZRJ1acJtb899pQ&oe=69D661F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSuhHhnCB-YQ7kNvwE6XyQ6&_nc_oc=Adre5qrgTf87VxsG5A6sny75P2iZJc7B4MNflFID5TBd3WTALijNn54qL7jP9_N0Z6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af326uF-d-Y1YJYYlc0YntxdwMot767_JLleBt9nwycT3w&oe=69D64819"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Is6Eq7GVwUQ7kNvwEihTJY&_nc_oc=AdqZ3VQCkBEBHo19oxO5eiR70OoZLiO45X_b4flb4OLYBQ1p4YGsOtZJjorhQNbdgdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lv1nQTKcCgkDe9t0l98rVhLKsrp2KDJphDOW0Kdycrw&oe=69D634EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuU29GO07DAQ7kNvwGwCAe7&_nc_oc=AdrpOq9YCYmJHBkxCz7LzMjKMbRfKau6JjXreTyC33pXK-6j5elfGfBKug5xlYbHHBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QfpqluXdOakj4WKrVaRRwZoNZl32xpbDwJZUkbpEkwQ&oe=69D63B52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
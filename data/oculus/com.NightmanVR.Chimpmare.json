.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Zaep6qufEQ7kNvwH6uQ24&_nc_oc=Adqb8Mgyg4mjrklcxkovc41N8ruBM5Q4U5MpVFOro6fA1JIK0NZI57YVlRe8423vj2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmhSNC2tFcTD_gU9eeQEF6-gdSunzF9MlNC0ZslTy5dA&oe=6AB52E17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQeTr-sp-KcQ7kNvwGAOSlU&_nc_oc=AdqQVMOW5WhDm5YgY93AndGipoUz6ptXHA1CKmyz13PzDFpmcIgmqPei_qL5SUTRW58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuxCCewpGWeFj7nFxDFP0MI7rk_MHD-GDRrMW_rvPjkw&oe=6AB52F72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEjC302b7Z4Q7kNvwHBj1zg&_nc_oc=AdrIwGythHQiU4EqMPdFpEF4V1sqsw30i9NlRwHqScM7kg5A_yLIvqx71Vevkh11Li0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNGWG-dyz6kByA95DvmcPPVOBOl3v0N88HLMoyw3yewg&oe=6AB54DD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-9AZDweWdwQ7kNvwFdAL98&_nc_oc=AdqTBSJ1ZtXVJwe-CyKdaCUZd_d54CnJIvZk0pI293IivX38KdPKJMhL44X2E4_oqNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFRp9u9p58dbhs5wW4JsKdzTeOf-7ABJsVyXn01Vt7zw&oe=6AB53AAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1ecIQckzZ0Q7kNvwEe1-_o&_nc_oc=AdqFrSNiMahURxPIiX45RovFQqfZbqPPFIKx1O6p1TqFjemen7LchZNoTpRHxtN6f3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7JOxgeXwSlsQPV7o-9alY8p9ygELDDZy5dj8FgyDVSA&oe=6AB54112"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Zaep6qufEQ7kNvwE7s5Pf&_nc_oc=Adq8SSislRofyatZDR_MNSXl3i7H5tdkz5jiPSvGK2ljxgGQjE3ZiKqxfpctbx0QDa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCTV5XHeeZcO-2r4Dx7X1kz-MpMho4dUKtuSdVAIBuTQ&oe=6AB67F97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQeTr-sp-KcQ7kNvwFBMQHJ&_nc_oc=AdqoadGqgr7DRdPTg-wN7dazXl94im6CqSFSoRGq5YBv8FvoqTDOCGWct3rrglOJ14Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnUsXo6_sie8B32ithzs4eLktgfsC15MNbaKtqeLNiig&oe=6AB680F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEjC302b7Z4Q7kNvwH5Fsr1&_nc_oc=AdrXWaTFKKH-KyKFgGko5oylQNAGiT99sObmDrizKjPBhzAccKarr5upSZO8HI-E-kM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImrC5loYEJ3HPHbLw6pY8h2rFPQxHeMkB3b6J56i0pMA&oe=6AB66719"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-9AZDweWdwQ7kNvwFUQA0Z&_nc_oc=AdpZEPucs1yplZ2SghDZVwlV-LKV3E9bK3Z1qK8ZHovSavo1Shv0rh2bZD4e6TOLCqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7ZRdDCSChkZ0OM0TPjKKjCViTE6gdMLmnqoJUd8HqNw&oe=6AB68C2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1ecIQckzZ0Q7kNvwEnroMJ&_nc_oc=Adr1D3H8yqX85fOnj8n-4ZeLi4Y6N4VV2XFsBYXzU86q5CPx4OO3pO0PYxUwthsr12o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjhSEFxPgYWRdXTr9T6r6YAkhePEpWQADAtgXAxNBxBA&oe=6AB69292"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
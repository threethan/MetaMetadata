.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVqcmrrCfQkQ7kNvwEPGNof&_nc_oc=AdphOSFf5guSQCL-EW8MtDdC9aGpUxA4vy8DmubfDlynfAh_DDo1hYUgzuoZRWn89kw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2tJ58t2dnc1_gSWodzY7Qglw7PQtj9U-6PEf39yP0cA&oe=6AAFE817"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrJx8JoaAVIQ7kNvwHwkbVF&_nc_oc=Adr1CwtjFqXRCxNWAaHBVJbUHIqZ1H2Cz_Ir19uVYrs3ABg-_NP-3TdPyiSTdc8ke40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeHolXAWR2dPnwqZNjRBMHNc_q2ZHtilJyyBxVjkXgKw&oe=6AAFE972"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8CemGKNsqMQ7kNvwFRba27&_nc_oc=AdoJ3CM9BedcpX2S0QATc5oNTbO2gOuCNfyg5-tJJyE-Bblcs9L2vaHCwJb8kTtFnC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK16OZSNPI0GAUYDqWjAUboP5JpF4FSe5tAmqczT5-dQ&oe=6AAFCF99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7va2q23ZrxsQ7kNvwEmxJz8&_nc_oc=AdpUwtjx_gukRNv-KpQ6TUNXhYkSjaXfTqtAPVmkf1FOOqim9e41rzK0HxdxNLzXsyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIz6JXQL60MEi2gPWC0SAt2aCHU_3XvjANdYAuGABHdw&oe=6AAFF4AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfzmO_lHPkkQ7kNvwFqOmIj&_nc_oc=AdoyEuo5EH528dmhlygM2e7mUOIlZUV1rR9DQUyOmB-MQC0mnj8rtGynxl-SVmlbPOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXZJ_Bko9RbcHsiuqVsGAZ5eF7GOVaW67D5EJ2aOUjLg&oe=6AAFFB12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
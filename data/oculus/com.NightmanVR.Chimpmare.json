.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C7pAvP7escQ7kNvwHuoN-8&_nc_oc=AdqhUKibUJFcDm7ZFq1LZxQYLgXwdQi02PGLDW-Zu5vSlHDkPOwGbD-7m6sJsCrBZS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vPlk4yIvbc5xnrljLuMBUAj3BSs7EK5EVifjhQlvHvg&oe=6A412A17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykC83pfkRJcQ7kNvwHMI6Ma&_nc_oc=AdqTt7HXLr22nyi0MEeZIAjGiuiRwvYZq0GpDxlGufR_wHzVgGMl4602W6neaU4oRBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ba8iTSVZedv37bzUTMKuuYKXeRer6_5zRkl7R0M9jFw&oe=6A412B72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gggfr7uu23AQ7kNvwE2mxtM&_nc_oc=AdpGrXZm2GtM2P9CRpgnTYZDslVmIeNKirXCQ9Ys0l8otuRCJPbZF4pfUzWDOrh-h5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80M5PX7OOtjHKEQ21X_Whm6KbOvaOiLSfMvAlkFM641A&oe=6A411199"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeMRBrKU6akQ7kNvwE_mWfr&_nc_oc=AdreCloNxAQS-OVQXim0Ce1ZoWv9ypvywx3dXC2Lnk3u9R_LdbvuIHx_ku90xLd0wAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vIaSAvUhGObsvXYydBUF0eOwVnZZ-fI8BPrCiSVQthA&oe=6A4136AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ham6AdWCnBgQ7kNvwHomnT7&_nc_oc=Adrqxb6WuxvLmLLJ2xwtmEDCRZIcKgcOcKkPWFAUT9TLHVz6LT8ZyWCOkOwSyLY2pW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hJHs61GRWrAXV8DwoOXuDthbVnxWTnA4e74706btoNg&oe=6A413D12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
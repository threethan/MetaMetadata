.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFIHzjK7q4Q7kNvwGiGlUb&_nc_oc=AdpWz_Xe90sod_ARsJ4HLgrLjifp8Mlo4buh1BG7_3ABWoQzS3zAlXzvanlWNbfQE80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51WrbuRSPC-d4wD3adw-6vrai8OG_YbKh2GZlJRqc-6w&oe=6A072817"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvbdYDTh3-EQ7kNvwFxG0TJ&_nc_oc=AdqtXPP2Fpx2eFY1P15XH8Nxpwy-p2cliP97bVUGfqbzyBqFV3SboOZ_bnCIh-RyCSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YHVQFFDeaRwd3q7sNl-KeuandYhPYulxdH2NLJGhQhQ&oe=6A072972"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wmZ3kgFglEQ7kNvwG7_FDC&_nc_oc=AdpGRkkckJOrECN28x-_DGMSY_BZMngUAKcEfzpJketq23QoPzXZy3IvHEfXSvl2NA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63e05EfXFd07CJPAR80I_25PTm_yC_3WxH6mtzleWG_A&oe=6A070F99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVkW2kb3fPwQ7kNvwGeGNNC&_nc_oc=AdrAKHTBg9PJADlPhUQos9go5_DpSTPPWwBufsvHOyzc_3iwZKALg8EqruDUnJxXwmI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af788GDmghJR_DOgiPkylxyg2n97XvPbomaEu-vHqMQsig&oe=6A0734AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY-dtoK7h_YQ7kNvwGhEVjD&_nc_oc=AdpqMihGw6TalJtVQP5JcgvDzZR1R7zv_A6B2gk249-phx4iaRrSBp0Yn-l2DHbq1Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IF8uiyGNIeOaH3lqBRrqM285AqOmEoFZqdjuek_fZHQ&oe=6A073B12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9RPj2w2V6gQ7kNvwHKUpV_&_nc_oc=AdrJ7GVx1QzWoUUKmrnxrhh7QU-kKoFR6YEuwcWYg8DI9AxU_NctRDfT6n5zx6eSswk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU57irlImXh4UDikxiDdLMX4eXSoKen7Zo2e1LUlY4ow&oe=6AF71917"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXrVXYCfKf4Q7kNvwFm-nMx&_nc_oc=Adp0kD5Ruo6VEsqLsFctglpdHtrSlwJ_D1Qrspq4a0p2u4k390rPspbYEQNrub2Qvl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdRdChy6kD98F6v4hQQs4XnTSXZ2cYVHxazBvUBv7THg&oe=6AF71A72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG3gqlwfNNkQ7kNvwFNYAxB&_nc_oc=AdrrUMf6jGLkh-IvvfcY2pNzTOekGQQFg0yzZQerplNk4qawgEFRvgj07tHGiOjdMFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzhyogG_dF_nsrj8OepACJdmV70zCY7biB3yo7DCt3gA&oe=6AF738D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTy8xKMdFLkQ7kNvwFN8iXX&_nc_oc=AdrM0a6Cqr-_2ENxAHGZ4Vfnrxvib1__jMrBSREiPuIFu7HroqjI4Cor6mF_6VSS8vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjnTkWnyZ2L9ScxACKFHrVGCqs67gArvrV850BYa991w&oe=6AF725AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9D0lZFUSy0Q7kNvwE_wl-Q&_nc_oc=AdqiO-9spuqFqm4dfnL_1pZZMJcoxNkgYw3X2DiVpiKO2-uhNkZc_l63XRwzlZrUobo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMuPY7LP-7QW8VwMdbmP3dbdUhMATreRC2N7t8i4PzwA&oe=6AF72C12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
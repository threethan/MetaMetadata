_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeQCK8Pu_ToQ7kNvwEsaUMm&_nc_oc=AdnAkQfOG9ry7WEpnsjSACwhF8iO1m_jdb6_f7z3Qhf1CcLCTI95MCQ4fVoCyGnEQNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRaFn9yVdpWSbJT-NYvyJqaGuMO7fubB2z9dB74Eu_WA&oe=69AC3097"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn57jyUPndMQ7kNvwGxNDNp&_nc_oc=AdkkKhVMTU_FLOmaR14WUoJLhFgqhBWk46BXo0miIuyzYO1Zl6sSVKq-u78OjC16rqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXCPqCqLq00Y00vd-n-xECqMaxYy1c1J6c8rHCo_ipKw&oe=69AC31F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7KP1e1ltgMQ7kNvwE839uq&_nc_oc=AdmSirSQ6iVbHAJA8BGeXE2PUKylRiMhvQnieasK8yuko4orjfC0yA0dNQORTN_Q6Ok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3gWda9veMAiZirMp7DUP-F-FAJcd2MnnDgqC2-3jpDg&oe=69AC1819"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP9cpjA7piAQ7kNvwG5-dfv&_nc_oc=Adk1XEFt9M0YGi8jZgBwYNjYBsxXgVY-CVvoeKG03hkFgQPQ5mstP9wgsPJv4aVwXEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpcnjjyA-LJNzv4HzlDDjWRPqz4aAQGX-dtnX4yYmG8w&oe=69AC04EA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1uxhqAPgWAQ7kNvwH6XQtZ&_nc_oc=AdmGmgKwz4nyJ-CR7Cv2bwBb1q3SZkglEWFATNh7xT9iZNiBSFelZ9pq6aiXle6Hx6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBfCPyE882-GzJA6jIZ6Vi1FsYBhno0q_hj8RttxkaHg&oe=69AC0B52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}],
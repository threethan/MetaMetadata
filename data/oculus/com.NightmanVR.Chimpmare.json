.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_SoIgzDb-0Q7kNvwGb0gnT&_nc_oc=AdobDcpk3vcpv0b8AiV2swxB0CIN4SRdH47kXYrt2qIMitl2JUGbQSfBsntUYqJVbmU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ViJsKYnsFA2rjg3Is0TT3pjRsjxXM-9GkkoQ7TyUVjw&oe=6A300697"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVzHbD3DCtMQ7kNvwHhnCR1&_nc_oc=Adp8jlL1jW8OVgrI5a3ray5lxE44al_HBNaJX1SdfgJ0WScLCK6cwNzqRngAo__st4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ph_KK9qbutUk1xGAyNYJLpDWuJGkDyjZj55gmKkl23Q&oe=6A3007F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h1tuwB8NR8Q7kNvwH9G0a-&_nc_oc=Adp10bjOmSCL9WdLP-ifnZ4ee_xrSeJB8w4Y9_QO_Oi6Z1uEko8SsotZGX8IVjmh0Sg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LCcuYk0nBitjFW7WBNPtR_UDaFbJZNmLnGGMsqWiS5A&oe=6A302659"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcQflJTGTMwQ7kNvwELxu5x&_nc_oc=AdpVPpgTi8BDjt1qL2exXwnsw6tS4Y-W07MttRj8BSkWFL-GuT1juSVNYUc1ZvARJaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nEGzHQMWarl-gEKW1kUYPdbEDEBxsmiX4QBrk40tgHg&oe=6A30132A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PADvZV4X1nwQ7kNvwGu9ywL&_nc_oc=AdrISZlEXn_HLkafqgnYCfcnTB7ykcDqClBQVB33o6ufX7zPzJCaHhdZ6Dlvf8t1v5o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m7V1amJro1L9IkbCN77xs8s9bFEJH4JbiIAwevh3btQ&oe=6A301992"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
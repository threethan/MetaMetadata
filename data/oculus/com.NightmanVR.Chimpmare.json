.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKEBN0ADWVMQ7kNvwE60jpk&_nc_oc=AdrXTd5KD2XYAuZmIUpAgmAxyUyQFP4RcyqZ1vLw3qzqkJatmumoLvONGrPbxZs0Itc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZycuObph8b4RcziHGKiJS6j-lk00SWOZrYMPi5R4fgg&oe=6A58E517"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QotVF4L5-PoQ7kNvwGReQXm&_nc_oc=AdrbMBHxP_Z9GTqtOqzzVZfs4nf_iSuF0_0959T91vkhCrEOXL0oR9z00msHh4CDrbQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWYKp23HH4Cw7Z9PRaxI0TafhYBtz15OZGyX-wRZw0vg&oe=6A58E672"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oewU4sgAmB8Q7kNvwGSK6pC&_nc_oc=AdrnM_m-5AlOFviTLFm53ByVoYA_iENhLfLifiyUQ-9JfIV3sr4f-5sBKOJ3InsADQA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuMu1LHND5gij6t3MDDMGKGNxG07Wj3SEaAXKey4Htxw&oe=6A58CC99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4lHKcLJPOMQ7kNvwGDhc3N&_nc_oc=AdolLTZsCEaR4Mkpnytt4Co_cbMi_qhNCSpBHTPLF0AdOwF-eJuApGev4WYBF9Lfqpw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9Jsi6LP_W9WIxb9XKyktOSeTK6DjIUyhqCRLMo4Lm1Q&oe=6A58F1AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THn7zjTGnlcQ7kNvwF2IVPJ&_nc_oc=AdqCI1iWbId9SlMLF8Z6RQH0UYQwsX7wT-VsdcqoNxigvCieOgP0azpYoMgW1pVJ19c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdjqhygTTrcuceomZMdz6eADc_Xi5tEYZv3iXgMjnAbg&oe=6A58BFD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
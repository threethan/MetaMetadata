.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU4hhoeI4iUQ7kNvwFTZKor&_nc_oc=AdobXVJ4bdVOlnA3AuAodD3M1RT0VAxsQSLoUZcGF3SN2owBphF1bugl6LmjTSaeb8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eTL_si7McK4M__GOOe81QYHDf8AbocoA6e0Mug5ecbQ&oe=69E0EC97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37pUzNROH_sQ7kNvwGr8BP2&_nc_oc=AdoKx5qBJZ5OZssjmt_xf_3j5XBye_Yg8SeA73G-a4mZNdKfggFiuYwaVGvygSkNvnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03GpLs1-l8Ip_wtOJiseSnp1gcjbZpowOB-KZxUhAVKg&oe=69E0EDF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOsCSyzrwc0Q7kNvwE7AVMb&_nc_oc=AdoyedgJq7m2Y-3HSffb6kiQSlPo69Ep_UgdKBr8FVgZms_Y-cEw7jQXbMFtus0-3W4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lVsAHPv5dyydO0Eel378dReMYof5EeuSU_VH5LZNdkA&oe=69E0D419"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn7j6Pse_okQ7kNvwFnFb98&_nc_oc=AdrycDc5N6VOJaPotItnxjhYkZOkxGsXdXj2q-T3QWJYtCTGAodRotE1i2RLtLB7wkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wIpoDPrLc0DnS9VQV1wvW5N-Ztre8YXUhRvwK5iEz7g&oe=69E0F92A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9CpCtDZNB4Q7kNvwEwKRYk&_nc_oc=Adp7_P3XYP6Vf8YaNmDW6VGUUNfOxaCMQCCO5FdQCaAkYN3lXDiXwRiHcLYwPYddQv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Su2KTszmhhS9fVW_JmWcPGIFeWo0YYupPpiLZWhqwZw&oe=69E0FF92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
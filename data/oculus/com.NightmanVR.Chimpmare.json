.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roH8biCvy1oQ7kNvwENurMs&_nc_oc=AdqB8d1CxM8HyGl85CMKsRtozUprslkRs6MUp8Ht47Ey0_Lf1Fz86335-DBSAEdslg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSGr-jj0KcJ0OVr2gt8Qwicn3i3vtvrF5pYx713hifYQ&oe=6AA16797"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu9ZSrSA-E4Q7kNvwEiA5ue&_nc_oc=AdrU1544pXLlm-7DWwLnBV9SnFtT-7XmSu7rQuKZ8x6l3hNDmF_FWNoEkA-6Q_nJl80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEWg-NQ-s0TemIx55ZgCxVhohYDBzCvkdSikQuUHM0yw&oe=6AA168F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDo70DqNmFcQ7kNvwHldl6-&_nc_oc=AdrD9i9BdTGI8TT_4fvz3wo8oqyMJCtQaa7qFkSRNsu1YlXx_PPUCfv_3Bk3ty7XjpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVAyCEZv9ki2UDXY1gJxj20bYwdPhzWjgmICX_xYWMjA&oe=6AA14F19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAD7ZnpgG_UQ7kNvwFEHYUU&_nc_oc=Adr54TR4apJOl01mFE3I0C0fODXeM3RphnZXKil2zIU5QQzemoiRFVoOeOe2UT5ov7Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJscBWjIyAep-jsaXAR338Ew1iW8uFIq_oAAvXb9H7AA&oe=6AA1742A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpvQmmfjcDEQ7kNvwF00ISn&_nc_oc=Adq5EegI14vls1tkq6ASuQSIhEv1oizd5l4QsT_hY9vUe0wLkYEVlKst34ucP2GyUC4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXJeM2mabWpGjMC_lxdA6KkBYD5V3wBfvM4AoJyVB5ug&oe=6AA17A92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
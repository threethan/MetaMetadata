.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6m3mjqunhgQ7kNvwHzYRzN&_nc_oc=AdqXqVKc_roAjW55GCCW8Odpbn74A7Sm2n4SXgap5XK8EH6C8wWY2hdgkiL-8Caj_Xw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEooZzeXRhacDvBU_Udja4gaNyNIrEIcxG1_CyabZFXnQ&oe=6A807217"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2DpaNHGZVAQ7kNvwEA3lyZ&_nc_oc=AdrwEs2zdDv9wIckxTIoF-CH32x15DoQjs8FEgzlaLCcKU5zYQfTpy794bZKt88IG8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-rLnWJnaCEX5OX0_GsIrSAbzG5neuRkuSo128sUZuFA&oe=6A803B32"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgWWWCRz1QIQ7kNvwHdaL2d&_nc_oc=AdpOk91xAGQhGQiqNYbzmURbIGWmTpUEe8ulQT2FhJqJQpAtKqRv_Ztgg5yGI-FfWgU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVjwRIaUykP79o5i12TKzxbVL1m3xkBE3srE_VT33h5A&oe=6A805999"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYbYY5EzDwwQ7kNvwGsZk22&_nc_oc=Adq6iRNYrHX8GFQ45DPaddFxW_51_gvxXHZY00H5EigBv3OfpXdCRR9RrnN7rZuPu7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwMMLDvJ7xj2txgZ0rVP7kYQy3fykT4293L8yPlfAOlg&oe=6A80466A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-86gvKv2BBkQ7kNvwF6izrD&_nc_oc=Adpwi4mOCq_3MYNdmqD20n-SDUDjiWLauaIrHFfmihl306VZlDAQikjAaAdh-qOHGqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3y3soIAxW5sJzzN-tvEXsLjOojdITQilP2lg5l2F69A&oe=6A804CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
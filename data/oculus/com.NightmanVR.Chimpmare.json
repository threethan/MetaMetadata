.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K43FRidZOEQ7kNvwGJmhqE&_nc_oc=AdqqE2jdv_lWQ3DpOTFqAjHGJsoKGkmK0YiyauCxFIzWLU8wjzNc7gMdV6vf5eD5hl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH22DIeOnhq0BYqciTko5ZaGzhNapS307QaXYfLo4sEow&oe=6A749497"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPIryaMFFUAQ7kNvwHIH4tl&_nc_oc=AdqN5AA9Sw_EniQBTFDm7cU5q6Ry_PURjsapHNo_uyARfOsl1IvYHyQfLxGRsntrTjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyKxcp1MTmolXD3bHPv7dlv4h4rGdKxCbOAepTfjqWCQ&oe=6A7495F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veWjHIMvieQQ7kNvwFCxaEJ&_nc_oc=AdqwYso4gZkFWen8a4YmCY3PXm5ju5e7DIBkNFPn_InbUeqY0FtOD8ZY4pCzRRkMj_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExDE7itRQZGs_Gs51g1Y6L5I1P3Ja7xXeVY7djHCEzRA&oe=6A747C19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCCWLpnlxJ8Q7kNvwGZc9LY&_nc_oc=Adq9DFji3Yt0PK7y1WaoJpTM2q_-ryVW1Qps93x-dm4N-P6BBw1ouBJ_KNQZFPI5edE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaTc6RXijnlD7jIjjhgSFNfA2I77Uy0_wsLxBy1Xn8Qw&oe=6A74A12A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcGkaaPbTgMQ7kNvwE1GuNA&_nc_oc=AdrXBaLHXMmnOGx5H_nqXEKOyR7af2S40wAopT_vs-VeHxwzJ-aemU_YV9b5KUID2TE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQDxNyUuJEYPW-cFArtfyb6WCXg1SDr9TUqUova-TTBA&oe=6A746F52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
ontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bioMWIG0FBEQ7kNvwFfoT7G&_nc_oc=AdovcH4mEjGmSyHHXguBW-mxxeGML8NroE6NyZ4FzVFz7MOsWkb0nNa66iQKtfPsML0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1i2ddFdiKp_71XbSUHPFQ4VSq0n-mIBDlUEdlnjJsLVg&oe=69F1F799"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJAaZlRLpncQ7kNvwFo8pZn&_nc_oc=AdrtzHsp0z0mJuATsb7Lvt5qjWTQLXOIjvshI6ereW0GQ1LKGG6mM_hZcdoC9z04Lhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0crlPIK1OMxKPAFHKSIlWARRyGeTlwRCtF-CVQ9FTqfA&oe=69F1E46A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRysa0QRGR0Q7kNvwFu1-Sj&_nc_oc=Adqmxk3D1k9yEzHzHRDZE8-Rcwn0Vcf6h0kueCkg2b7T-LRkv0kU_s_m_1bNhDSC9A0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PDtCeFduYZiT2OMEvkRZpncBQSjSdd4EUBbTOPNXyVQ&oe=69F1EAD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9631172856995074"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "678803478644034"}]}, "baseline_offer": {"id": "678803478644034"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748387460, "status": "PUBLISHED", "id": "678803478644034"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_t
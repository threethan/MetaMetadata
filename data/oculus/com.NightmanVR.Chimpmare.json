.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8uG2EfPhHkQ7kNvwErRgX-&_nc_oc=AdqtA7rDYfqpDG_GSUg60U1u4bBHRmyjXV41HjEZX1JmovCnBu9Nx429Wkkh2eUbnBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37gVaozt38JEvPJCiO5n5uxxhPcTXGJzb02nq5sXiaXw&oe=69F8A797"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwu6g8ZzQkcQ7kNvwFSYAkh&_nc_oc=AdqlaIVmgQNQW6NKp5OF-q0LJF1z-ZGwcAxRgQw70StHJQLG0NrsISyAQnLG2ZeA6Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HdC-W92Wuh1Gd0pH7oGkMC0LA774HPP433JfEHTBv6Q&oe=69F8A8F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUUgMFSV3H8Q7kNvwGTJcLW&_nc_oc=Adq1Sl9DaRJcT5iIQ_acVvikzN-YDbPFjW6s9LfuEoOsmRpXRRgiYyKy4sfwZ5xcKYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F79_I3rjbIJBt8YcZ7IS31TCafTtn5gXDp2WnhXPkuQ&oe=69F88F19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rDj8o0A6hAQ7kNvwGLVoJn&_nc_oc=AdpXvD6invTa60IYZi7zUKiNLLvu9I9ckPgrhMHv4psgfHwZidS6GjNzBFLejuD93g0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HuxreAholbjsarRBVRNF-OY7q7Akl35MOLfBHxe7Rww&oe=69F8B42A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-2zKKzFCa0Q7kNvwH1jwgU&_nc_oc=AdrQ72WsSVHmT7Od8xfFqifJg2s-jLnC2iG5Djs4QF9L3tGTtIBzZcJ6tDvU78h0LNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rIcqhmxE4Gi8-EHuLAK2L7lAmkv6SgJB7on9K13u9Jw&oe=69F8BA92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
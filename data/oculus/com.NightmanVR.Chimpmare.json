.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sddeFCe3_-IQ7kNvwFD3Mwc&_nc_oc=Adq23IHgt_uNZ4x5zXZvpdc-_rvTIib_IhXKf7uFLKVaX2NI7YQD3rBvrQ6QiaVugPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66hFpzjGlxDoYedeh7lJUhYwH7ZgjI_urKLxZ_JOBsaQ&oe=6A033397"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ei1-X7vUAAQ7kNvwHzQllE&_nc_oc=AdoeqbLPeRx325fGZn0TEsgDfIxjdUTljqE82w1aGUdWSL9qhUyFlsclRBPKzJG3p90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TAOvEOrjGms-plajgGK0D9FAhBbbxfWeKGxbp68qA2A&oe=6A0334F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzZCbJ5akWEQ7kNvwECS-Bh&_nc_oc=AdoZrBFk6oiuk-lIkeOdUQ5N4hE9OnCm-EtY5x5TK68HMf5iNgLaMlWQBBasOq3JPfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qVj3GoSuTPcgpOIQ_2OgSzKi5cen6YC5ePmCTqXWqJA&oe=6A031B19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVzI-US9-PgQ7kNvwFOj24v&_nc_oc=AdrNtbJupjEfC52K4OnVkvwmQ6tbTEEdAfaCXqediGzOcB4DRCSxBkM5CDMVkXNJCtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wguk7jcXs0jKhOgF6sOBWzYJiX4OaUSo9KXZCu8rJLQ&oe=6A03402A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU9voq2jQEUQ7kNvwFnNyAX&_nc_oc=AdoFaMwMbv0-iUDqP9kVakuNIDjckmx4G0DcqLE7vAb1_rxJPdyOhcKmfDOWhw3kvC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70-87RvdPrT6KdyblkEfrl6j2pW_y3C2Z7AKIjKlcsEw&oe=6A034692"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
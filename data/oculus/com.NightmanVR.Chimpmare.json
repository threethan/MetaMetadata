.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhAJ6sujzTsQ7kNvwEAoiH2&_nc_oc=Adr3GbWRl-QY8h_P_354EvZilNjzSE_dec7-t5gI9UU4yPskveqJsU7jJtmWqEP2sFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOavfP9AZ7q5dpMbqJWCbqstXTcgzfxrwrGIIZFxwPiWA&oe=6ADF5E17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YugNrTvKmKoQ7kNvwF6YxLx&_nc_oc=AdqZ5BGwi9BY8jnAIECzLrdaEpHaOMVsPGekgpuTwkxXyyKoddCLqXb_fk1D3T21xhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3oArA6i-Ca-KqRBPE0qYpBHlnMciTNxjkRgKCQjdmqg&oe=6ADF5F72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtTzOwk8OE4Q7kNvwFBC8fE&_nc_oc=AdpnvQDzth2pGLtj6i-IqF5YmL1Joat0rb3VcBJ-FQwqaK0h85yPc9ZjcaBlNF5YDrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLYdop77LVaCx3RLE-o9bEuEwAHWVGYr4B97bAzC2ybg&oe=6ADF4599"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqUmCCviyvUQ7kNvwH54Uac&_nc_oc=AdpqsgiHlRbRXxoCK7GnAmQr69okb3vecNzEJRKUOZFPJ0N6KqzTUU_oSZaHuFLi_ik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5bX6zGzfeitFP2kwcGZ5is-KAPSLw6Zg3hT3TS-DJeA&oe=6ADF6AAA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk_d72YjLW4Q7kNvwF1SGsH&_nc_oc=Ado7GbpyVXz12ZLrnC6ur5_C-7s8RM1bmsViOR1QTHPk0RKyY3NMk17_z8VK14XC_dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF7NzLoFvy2AKUi2oZ_A0UYE646p1W900R5hYHx3tAUA&oe=6ADF7112"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
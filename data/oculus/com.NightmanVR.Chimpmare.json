.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZX0TwuCJogQ7kNvwF0Vf-N&_nc_oc=AdoCiO6qizy_3-tuN8JC8qxQa8k2klbGGZdubDSp9BANZoxZAv82MQoOVvyChANMyME&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOgPj3PUZsQOFWh2Ionht7TUEbHz0YYuCgfMtHjzTihA&oe=6AEC8D17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Zetw-qeHEQ7kNvwHkCS0Z&_nc_oc=AdoKWfjGzdRcL7PGUl4oSmhsJRdBpKNBRl_lIu051wPpXUhoUCERjdnQPpAC6A6iyZQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjpIY5mKzRYz7u18BwP0H8fTQpK5M2r7vGcsGKR7akGg&oe=6AEC8E72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S9k1eTLpL4Q7kNvwGIs414&_nc_oc=AdqcaazGUKs6NBHh2PMYr-xS5P6cNi9De6Zd4USltt6GOpkCZqewS6gRgPyC2SaQcwE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThg2wRREaGioLw4kWIHwKRDApU8nbFL967qocOWk4zfg&oe=6AECACD9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z8hAn-V5QoQ7kNvwEt_lwf&_nc_oc=AdpzPq8IqFKpG17o3kF6Etv7Qmg8733rfSJaPkFby8JNrul2jc1rBv7ZaTJIw6nd-1c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJWKAtXW3Jy9m9pu4bcQJsuz1iNkNVrFs5qRLl26Fi0A&oe=6AEC99AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQaMftmzz-UQ7kNvwHEpE0D&_nc_oc=Adp6GO86AimSwyggChTOTWUutdMT7qxmq027J4UqsBWbMpiekCKm0aERrAfRtEH9hyA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf6hkrKmu-YT-i06lCkAo6RB9l54YfDRpBcotGe2icIg&oe=6AECA012"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
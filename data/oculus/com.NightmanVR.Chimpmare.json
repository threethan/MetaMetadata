.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxXUrO9_FmEQ7kNvwH_xCqR&_nc_oc=AdqYS1uva-is93ftgx_I1xp4VWDbCyY4TlB8qtfQZVZbsYQN5GNmeBcuXmU1w9BW7mA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jV73ctg3YW-Y0yFJEtAJWWVn8K5G-Z7owb1HAKrbEIg&oe=69F36197"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nESd43oeNwQ7kNvwEEmQmF&_nc_oc=AdqB7fsdLJgIUNpvVQSLm6SdU07FW-tirNpPHy-bGwxeHmFIv9CKDaVNH__J7A9GhQ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hIbjKH7QxRFcdr9cmT7VnyHVuD-sVc_bz4GMEHA1sDA&oe=69F362F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bioMWIG0FBEQ7kNvwEYDpmQ&_nc_oc=AdoJqD0ygax1-lc-GeEb5Qq_JM15s3d90Ce_9lo_E1L2RV0QJ-Ogh3CkSuBO1dOaL0Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-xihfSB-ahob6riNsKUVhjcGWMlyHqCnWr-8sMWpCWQ&oe=69F34919"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rFnKwP4SjQQ7kNvwFS1Wfz&_nc_oc=AdqFTo9HdsRNqrkRon-Re9ZBiF4n9kW8kUekNHPWYq8yoLjfF1VL40wE-ewmR2zpCJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1q0NNqCz_ySwCY4KR56kFpduJDiInfZhfq6EYXJlV8AA&oe=69F36E2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suHopV0DA0wQ7kNvwFAHb-T&_nc_oc=AdpYUflo_8jY2j-dXdenwAEQ5RuPpw_wbnoML3iv2Op3u0933uvXCB2ocHQ9GYKHgXI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1s8sWJmE1P4mradXHaRLmeoWj4lGiSjD4Ld_AnGC5k9Q&oe=69F37492"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
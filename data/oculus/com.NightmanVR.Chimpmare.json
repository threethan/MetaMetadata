.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg3xGbucIBkQ7kNvwHCGkE6&_nc_oc=AdqFIDWljlevG7isKnHDvqkAsEwTuhMqcLc3Fyr_OfBlwR14CGNzxQZ47rePNRRlplk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwc4VePr0MSD6Xp6r7qGm3HCzP50bsUaFtpiioXQYXCg&oe=6A661417"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcOyQKf2JpQQ7kNvwEWTtRu&_nc_oc=AdonTH4Zo2h-IAZZjJd8UXipJkZ4lKmbfs181YJwfohoGGusfFdvB1oI9vnFhWE0jtM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA745tzsU1RmOTjWUx_u2nA-g9vH9vW0HmkqSH6akuw1w&oe=6A661572"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id2QTaoM69gQ7kNvwFpFQyC&_nc_oc=Adrt-tKVhllaMBxmBCvSReKEsizjYcIkUnAoWWr8v9o1Bim78pG4OKvSgQyy0fQ4UKk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhkRRlyEQiN1GG--EhLw2Pbl3ZYP-CFLZSaUzO6Chcqg&oe=6A65FB99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DPCoRvqU7EQ7kNvwFjA6-w&_nc_oc=AdoeXQbzWkVUkSrkBNfKljYgJHzlQdS-JaH7-T9ceqR3dEdtF172fdfMvC0u5KyZy2A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9pmqvbr4T90j595E50b1uLy9pZv89MZNJ5FUi7P7IiQ&oe=6A6620AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu8wBzCk1D8Q7kNvwEH-KpG&_nc_oc=AdrtTGSUOuZFPerkrPdYiegQCwagoQsgYIk6Xg9_suW_4EXOGL0LhLNaVHSv0Zleu8U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg5GBhxL4XsZBJ4NdxayjvZMW-p_rfCYAN_eqcZknlxA&oe=6A65EED2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
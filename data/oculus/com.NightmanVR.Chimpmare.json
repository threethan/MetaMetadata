.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVqcmrrCfQkQ7kNvwG0rD2s&_nc_oc=AdoI3mKhjbWNpCmnCbX969A3wMg9BmFu7hgql21owKsFUUnThMNAwvMzN0A45aH3fmU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_O0xGX4RUcpeZiR3_emn1RE19KN189FSQj1AUantCgQ&oe=6AAD4517"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EqoklmBsV0Q7kNvwFZqS3j&_nc_oc=AdoU2AkFC6ys0Wbtaq_u9pEBo9eov1FqgoAPDPbpmrXHrNCbd4O5SBrBQu7bV1AlgxM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT8zJI819ONBj-Rz8pLPaPQutSUCU3PQ6eEUtGqqej0A&oe=6AAD4672"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_nzpfVsF54Q7kNvwE-saRr&_nc_oc=AdpUYaof7aTpQZAKNib42CYQ7WQZciyaE_qD8gicD95BsSbrGV5MQ-uRoIonsHBLg84&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKiNsA6Ftb_qv5LNDoisk_KPEvo2o6l1-2CJSEiR2WOg&oe=6AAD2C99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7va2q23ZrxsQ7kNvwG2bP6I&_nc_oc=AdobQRlgy91ItuswhTv57FrGB8S9Ya5_mQ5jmYqJc58kdyc9zIw5QzYHTv6Bve4tFBU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwi8MW_q5bK3TcIdvj8fvLPRTSsBz-8tNUELIDQjrSxw&oe=6AAD51AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfzmO_lHPkkQ7kNvwGxHYtZ&_nc_oc=Adod-wFuVEo4rL6krB0qNf9pFD4BNcBD5oypIH9-rifc5F-i8t98-bl18g99fJtq2BA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5qEhYg62WHjZ6cjFg-X28-UbfxsDJr9a-tBHVMVTA6Q&oe=6AAD5812"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utlnYsN1E-sQ7kNvwEvwhyw&_nc_oc=AdpTHsk6pIL8IgAsBLZhD7dJTvSUIOLbcW70RlHbVDgpZUOZL1iDT1N1Zj6aaWA8kF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AlPHip7V4c4muWe_lk-THWMjz2Le3-6HqwDAhWWP3yA&oe=69DA5517"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLiJCZXA5PQQ7kNvwFZBH-k&_nc_oc=AdoYcYjQF0g3Wff9ZebtyZBGJpAI_riF_dHOtQLqkjruUCdiS9zgWpjwJ_Pi2PXphvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q2fD44gNyKcT7GQozpyQuwIF-xKDumU_ytkAKzlUItg&oe=69DA5672"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izgRnEUm5v4Q7kNvwEWEd8Y&_nc_oc=Adoy73qw6QmV3Mvgn7TgAysSiXVYe1HOP6RpxDM8Y_cw-x0ztjRgikVcycQB-qW4B3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13rTu4ofUDtdcRV4pkJsz9iHdjZpng4Oax3qY1r089yw&oe=69DA3C99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v75Fv-nlaN0Q7kNvwFZzhoF&_nc_oc=AdqEsefGoBbS-cOjGseydfKJgvubg31e2-EliiXzeFGpl2JzRCtW4OSPht0R3jXL7Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gWOSAM5dddsikBWJ_vGls3dj1qfKwq-JK3LY6wUQ9SQ&oe=69DA296A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_gvXuoiYU0Q7kNvwGhKmB-&_nc_oc=AdpyBthz_ah_dpY3ulsWWKujWcL7y2ug6aIl2lXqDg0YmyqvX9Oawxlc8V5RmfnVfEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aDTAXP32y4oSgEWtHDhTYQJoFnXkz09TfIiu_xmnI3A&oe=69DA2FD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
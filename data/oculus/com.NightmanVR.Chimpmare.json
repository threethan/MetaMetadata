.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOk00pQpdxIQ7kNvwFJanVI&_nc_oc=AdqL9qcx1SdF-3H9Zyj2TsXgK8ameeWrG_EpQQj4rWQNE5MTZEsyZKUkEpq4NpDu5Bo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCA7L5DO4s-0QrutAlkc2xBIKwJm3h8evkrVnqx7PslQ&oe=6AF32497"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct944MJqqYsQ7kNvwHzZMbC&_nc_oc=Adow6Aoaheq9cHGZUCTy0YMP6Yobz8jB4lfuTLY9QL38DOlt1fa8geNaRsXbdxo2lYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpeprbhwmbl8GbDyNvpg_DbNxZmkct6qebuVpNRuZbiA&oe=6AF325F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZUeCTzgz0UQ7kNvwG1RWPQ&_nc_oc=AdpZplOhlm-fXwkOHl0oFNJJC2cSFaNEedhXSAee0WsndtvAzPRCVFjl1RzT2UULF6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ69J0n-FdjnaDz-FEakgSlVYc_YekHOSgh7H7z9D_RIQ&oe=6AF34459"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My08426KZ8wQ7kNvwHFOtqg&_nc_oc=AdpvR9if0EiP1HV8Z2EFP7P8OC9dDYaJR7OmnyUnhxxvelWS0T9gwcWCYlo3FSE4iAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRz2vktcBGWH9DdsehvGGP83RjhfN0Vw90xH7ye44zGQ&oe=6AF3312A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKTUFNlXEQYQ7kNvwG1sDat&_nc_oc=AdqC0dohCbVqxg5aPv7G_HF76pOoQzIFUD4V0zx0fNb8Q2CEO0mszzBVEDjjjFbQYj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1dlm1jps1QwXmJXcXOxXY8aEMMFMMLB2g-1hKvCEESA&oe=6AF33792"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
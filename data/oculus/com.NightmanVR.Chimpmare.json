.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwAzRQx5nXcQ7kNvwHLE1Va&_nc_oc=AdpsODro1mQbHjUsro19NmgsBgJu6-4uBlWQGfzrC08-ECwwGDvvgIYcHaTzsOYzwWM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHptC1pwt-PigGIVRI81tm9zi3zSQyuBmHls0nHZfMuqA&oe=6A8AC5D7"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmNGRK4XFEAQ7kNvwGsBOMK&_nc_oc=AdqlocGqD-mZN9AJwlMktnyK4ULsS3j06SiAtJOo9gRAday7apTlkSjyGNfhWZIn30U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0fp8aZhldn2xUhmZYKOgboOQwaxdp49Fp5jhBGjaEUA&oe=6A8AC732"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apWm4CiSUe0Q7kNvwEAj_Yh&_nc_oc=AdrhEL7yioLJBq-DuPVU20zFgJGEpiV5Ch2cgHzAASwbrdNb4fELpW-FQQMkMZcu-1Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIzMxQnOiU01KYicbGpyaV-erx0SNoOmkRha_AfSDK_g&oe=6A8AE599"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRuYvl-hcHQQ7kNvwGP3wsL&_nc_oc=AdrQuaR-5bwhCrjR7t5MUbP_g6qwyAZofQiE7s5ppWa0o5gEP3Fn-B6oS-8C8BmhhYI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfQ5q8c-XVy9VZGnh3lKD__grZeYRdX58_cCSvbDQhlA&oe=6A8AD26A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTpdNe9UEIsQ7kNvwEjfELi&_nc_oc=AdpdIShBcqbagIp6lyTbWIBcFVC8bswujfQ9YpwdXg9wEUMpPf9NPVIEp0l_Z-nHp24&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDCaUbzSEx6Bg-0MT49DuViX8pBomFEh5gBUs4MOWPOg&oe=6A8AD8D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
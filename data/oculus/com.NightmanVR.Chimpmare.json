.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnqCp-Hxi5wQ7kNvwGGaD0p&_nc_oc=Adrl1nyS3_4WADUGsznsb_rYR9UlUBLhyeQejdmT2nEzp-S_AaOJX1dk5ONUE-glsWM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__dMG-UR2Eh_io094gsabfaqi1xTIGnKgqT_0z6L5T2g&oe=6A3D3597"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP2GTcOitAYQ7kNvwGz4tB7&_nc_oc=Adq2VZxESrVONH087r0f2IWXMK0Z2FjP7opwMFTmELDrS6BF4IhWYje89OaX2dkpxzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cqlZyhIEv63ZTymE27Oy43BVwH4TvyRiA7jSQT2PUMA&oe=6A3D36F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY42xHDmh0YQ7kNvwE_Z_Lm&_nc_oc=AdpmwR7wCvASIFUS9mMk8bYJsl8c62pHixJOGbYTIcepVztq7k3JVAX4Kc9DNGRNR2I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t132ZKQKY9UJO73T5Jk12bsmhBxcMslW9jL_l73BCnQ&oe=6A3D5559"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ-e4Wj3m9QQ7kNvwEFsWi1&_nc_oc=AdoH_yVGpmE3rYlC1AK1LuOuYgC--0xMbuH9S5t3eZDsIC8pUHfbyhCUINRGMAxT6DE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7OKjN2T_RkrxqePA8yE1P6NELtzzcurrcvrTPv9xTxA&oe=6A3D422A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0uA3eZDVaUQ7kNvwGAkohj&_nc_oc=AdoWXBVKV_nUN43c5lxv6f36D3-OOXm5kCob3g5AbuCTWexd_NhFtq6iK8kU6IqaoyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fZce58jHzwY8Duvk2AmVGvGV3KqBCjtfDqMj_M9NYlQ&oe=6A3D4892"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg3xGbucIBkQ7kNvwGDbek4&_nc_oc=Ado0Q0b3dFNkgz_ces9cFXkVKrIw4dXUCnjooOtw_7aHkWTGXJxrsdQBMGA3M7HJyoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzJhcn94Gjz-c8HPsp3O34tmfm5XkSy-o27PWC1d8l_Q&oe=6A68B717"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Tbba7mwDcQ7kNvwEzT0Az&_nc_oc=Adp88wmFpUoxa8ispwttR5504kpO5u4Eiq4xa4FSbvZgWxg9CPL6I8_jKboDII7RKiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlBRIOiMzLkfP7Oczcxa7Trp5HTDVunCx-mVbAXX5dQg&oe=6A68B872"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0VhUBcRuT4Q7kNvwEi7Wt5&_nc_oc=AdrdlsLocCqrGB6asE5e5SFd564L-rLOELnWg7Fu9Q-mDk6TMgWDc0o3zBbZGFW7auk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq0Cje8XQflrpGgnn1nzarNjx85CM7C8uwdMffGwPZ8A&oe=6A689E99"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DPCoRvqU7EQ7kNvwE6hNiX&_nc_oc=Adp98V34M1nPRXmY5sKZktsCwlUcyfDGNNhlJfv-BJ5vEx5cnpqB8_WyIbloECRmRt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5DtwWY65ajnfhYrbpkW1ofQCUxFWd9reFPDcKGYeDaA&oe=6A68C3AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu8wBzCk1D8Q7kNvwFJ9wxs&_nc_oc=Adq_GhFdxj9ckKij83HVbdNQPjnsWqG2fkrbMfq2fi9CnH_yWwedH7R7kkm5xLMkb10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ_F65nYvvJIji1n3xrVyYsmQ_SQWCiBtCS3ZOFWzE-Q&oe=6A6891D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
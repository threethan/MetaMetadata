.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjcUApHZEN8Q7kNvwGkkrqc&_nc_oc=AdpDtjjTBBZYwpyP8V97-NyFtTJyBWcuxiEwgDaiLpGgXKRQspaslkyu0QHiGZjLOoU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hcTnJfbHRXEvkzZs0xkMXkfIaVt6hDliCPrpNtx4WbA&oe=6A1AEE97"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOv3hutYGwoQ7kNvwHfh1VK&_nc_oc=AdrP-IK29hDTMqF__QL_r1lsqxlKzlfT53ZMI1wbj6zaYtCHbhkq2hT2rLFDCwa6RXs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O2nWTS1HRNYZZ3Z3riWk6YRRoyRl9l89XUL1E8G2ISg&oe=6A1AEFF2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hMSAJ7EcvYQ7kNvwF3hLzV&_nc_oc=AdqSAHAyPiSVsAZrY2JHJY5xIMXbbYmySf5pn0mRyNxGKLReJJO3KRqXp5Dy6-qM7yE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fcsoFwH2ztx6EE1Jmc2dp2aX_vpl_ZzwclycdvFoZ_w&oe=6A1AD619"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2O17smWmmgQ7kNvwEiVNa8&_nc_oc=Ados5P_uJ_XiYLCuiBhOI5ld6JdwaY7hDGjcUHiD_4FXP_ck-pRwLhBHF9acbaQApqs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FI4lVUe1gO1_8q9ONKx53uiXxBtMsMZOPm55YqVW9gw&oe=6A1AFB2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxOtDG_MMzwQ7kNvwH_YTma&_nc_oc=Adqa3wp-6dvo_fJjm2LezDO9vTwoJlBpZIWUa4gHpoWCIwzCVtmy7tlKmhHEGtF9Wuk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NaE4La5zaMneJmMs0mUgFvN6eG0FvjIThm4m9autnAg&oe=6A1B0192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hchAR0VaOFAQ7kNvwHtmUnS&_nc_oc=AdpzLBzSaqw3TTpTVruQucE3wo9Ew_GrKfFFCrtm3CEj2T6APr1k_cBERlCSOxfjTvM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JBxv86SFaA3_7z7_F862v887XXYYNC2tKa3_OUUW_LA&oe=69E63297"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP4oHhuy5vYQ7kNvwHLKOXo&_nc_oc=Adpczs-dYy32W5B4D73E78koIbqpnTScy3GB82i7Ced1Nd8SFvTsIqc_GuvBjDuulk8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af175o2hugtmktPtvOkMsiBEhrXyLx1fB0G-RbOSdsyaVw&oe=69E633F2"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_hBZzN5AqQQ7kNvwGUQrSy&_nc_oc=Adqustab8e7uYDLI3b4omxXIMRKxngXds6MjqhReRbb_Z_Lf9qBzJynZFN2fx4mupaQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DVtoR7sh65hXl6JNUlo25n8QqZw8OvAl0fSX7-doUcg&oe=69E61A19"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6WD2qlmmCIQ7kNvwE0XRHu&_nc_oc=AdpSlA6FPuaoLq890XEDi1fT8JoweHdSC2f_cwBeo8PlrVgx_jMCCXl-Rck9bJQDaLE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sNZGrudPC1RWVyPN1I1JnO32ntPyKSmMwh344Gcb3Ug&oe=69E63F2A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU6fCUqIZdEQ7kNvwErCHtx&_nc_oc=AdpKcWm3szMHAQd3X1D1vTDsbq5GfnwOiNYdUDpvfB9YwHLXidiQo7i97qcz2j_XQgQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OSJ8PI604gyS-Ypb3mepZYl6DQGFoQ9VqUun-Dc2vvw&oe=69E64592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
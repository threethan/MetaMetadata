.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9YSjhS0FV8Q7kNvwHs_0oz&_nc_oc=AdpLRh4flt2wWzjIxzTAQYqTtOJJhOoB2BVEdIhWi3DvzwyZV0dxWHTH6ffscMhADfc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrtprbgNAj-IXfm7rLZUf2sSvp1OWJdT6BiwG2Z2JE2w&oe=6A974C17"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kb2zwlXbO4Q7kNvwHnFxEe&_nc_oc=AdrWpdfASqU-vt76AYg_m2eB_dSJaXg7CcCQNYWGTQMvYJaVBSCsbXJutDh16WMRmg8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHykR-wb-wswJ7Xg52RDJNPILQCF-MNwIGBbbSdQVAYHA&oe=6A974D72"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lma4Vtyp5AQQ7kNvwFFqSWZ&_nc_oc=AdoFf5CG3VC93ZhV9HL5prQNuyQafN0lef3KXOrkrnz534NmSDiqvn9baKvbu7-Et-Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1zEQAXtbaN2szG5-u_sw3GnzFuHGESUHP10RNARY_GA&oe=6A973399"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9_tGo2Ul_IQ7kNvwHdx5sT&_nc_oc=Adq4QYigDSK1yrvjkPsTl3xuLJDEdaBgP816_YTqmrfezhNTbebFGE5wIBH6bML-z2k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhKTUgfTOsRryyJYEDesf5Ckaw_4ln9HzLiKrfrsn4Tg&oe=6A97206A"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZcFxDzveTQQ7kNvwFv1yd4&_nc_oc=AdoqqdYRu4RIbRUdfqCrEAmHAFzE3bIEHbg_oZt9jyH02nRMQKk9gsLzN6I7KsLkyg8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI9Hya8uhS0WvxTzyCn-ojy-lzPdoDvAxqqugLgcM_fg&oe=6A9726D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
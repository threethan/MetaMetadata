.com/v/t64.5771-25/499300779_700442772351076_2605814617388952099_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v7chE5vJS4Q7kNvwE9UqZJ&_nc_oc=AdrNB94tCgjU-NUVbkJhkYT2nPjYLXApwW0Uimo7L5DkvePgqAtIlsYkzm-Qur6aMnE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3eh4jKtWSOl0fsYB8O7oKrVwjnKvgeFed-J8OyQMONw&oe=6ABD1717"}, {"file_name": "Untitled Project (7).png", "id": "2101016223700695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300640_2101016227034028_4475850513941264057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74ifdg5ZoJsQ7kNvwGnGFkw&_nc_oc=Adrn1DSKMhVQKMoFGhGoJF-aTummLgqEki4_8cb2rESnD1pDl1mttxFqnwU1BvVVxKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBZLBuAK2KLRXzDuMU1uLSCA3XpCQ3Wng_hPL3JxouQA&oe=6ABD1872"}, {"file_name": "Untitled Project (6).png", "id": "570207526122249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617699_570207529455582_8686930364319480195_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVHin91kgG8Q7kNvwGO17wb&_nc_oc=AdpJMX_vYRYJ18LZv7wkEJIBYmPlFJbEJ2U8kY0XtfARNeyNCBDnkGTxVoCHH_VDP2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnlWacOHqqpVuvHZ7vjnhBbUg31epdWegP8PRvFg0WbQ&oe=6ABD36D9"}, {"file_name": "Untitled Project (3).png", "id": "717370410685362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296494_717370414018695_6262854563332951257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MKOj7MefdkQ7kNvwHS907e&_nc_oc=Adpivp3K7Y3_8aHzVxNAioBVf7iXVP5dDt1Wdy3b8F7qMEVTAYIaUn_1qXTQ0EVyVi4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiE1_vBF19hwb-Z0fiSrbYXHHV0OG0S4QfeJ8T7To_qw&oe=6ABD23AA"}, {"file_name": "Untitled Project (2).png", "id": "24233615029578253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304845_24233615046244918_2003497461901909154_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A70BoqiwVMQ7kNvwGX9hhG&_nc_oc=AdofbLpe0SJej0NkA-VWr6T6Fc48l6mopKRUoq21o4kUeLtfb383xsciKBuOwY4zOl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuZe5SRxV-y1MImXgEN7xRZSCdg8cj6_1aBxPxmnq_4Q&oe=6ABD2A12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpmare", "keywords": ["Chimp", "Monkey", "Gorilla", "Horror", "Scary"], "long_description": "Welcome to Chimpmare! An unforgettable experience with tons of fun but creepy horror levels! \n\nChimpmare has 3 main game modes. \n\nA shop where you can deck out your player with loads of hats to choose from.\n\nAn amazing PvP map that makes players fight inside a volcano!\n\nAnd of course, horror levels to make you jump and run!\n\nInside the horror levels, you must complete an objective to move on. Weather its trying to find a diamond and avoid a massive spider, or finding a shovel to escape this place, the horror levels are the main part of the game.\n\nTo buy cosmetics in-game, you must collect gold around the horror levels to receive in-game currency, enabling you to deck out your player.\n\nFind it here in Chimpmare!", "short_description": "You should definitely download Chimpmare, an awesome VR game that has 3 awesome game modes such as a terrifying horror, shop, and intense PvP action into one unforgettable experience. Whether you're exploring eerie environments that will keep you on edge, browsing unique in-game shops for upgrades, or battling other players in fast-paced combat, Chimpmare delivers nonstop thrills. Dive into the chaos and see if you can survive the nightmare!\n\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpmarevr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NightmanVR", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpmarevr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
tics in VR for students. We are tackling the problems of early professional orientation and equal access to education. Schools with underserved or underrepresented students could benefit from our scaled and cost-effective solution.\n", "short_description": "Gamified solution, curriculum for classroom and individual remote teaching robotics in virtual reality for students"}]}, "developer_name": "VRobot.Education", "developer_privacy_policy_url": "https://vrobot.education/privacy.php", "developer_terms_of_service_url": "https://vrobot.education/terms.php", "publisher_name": "VRobot.Education", "support_website_url": null, "website_url": "https://vrobot.education/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "899631478099261"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458093_1307233903066462_6016657595753786544_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3Tye2YpzqIQ7kNvwGGdjKp&_nc_oc=AdnPL1BNEYd7UETLhpZv7kRPh41x1s2jqo2TJBEhaLHOgcXflDK54EZxIoFM5E-JgdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPEcsB_ZRiTjWhw3MhJPdxdO9iA_rSaNWLuZWEMpMGLg&oe=69A044F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Robotics in VR (DEMO)", "platform": "ANDROID_6DOF", "context_category": {"context
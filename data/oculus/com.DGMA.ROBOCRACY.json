uEk7HEqkDYQ7kNvwEOL4NM&_nc_oc=Adp6XhkyBNlJcO57fKrdtEgmtMk8IypbhBMIlptlKrVyAmPto0yQDeM17Zlr_hBMi7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlNfoE_SlSd6x5bjJAkPY1a9UYmWfWuh6xk4wj8yqzPQ&oe=6B033434"}, {"file_name": "Screen4.png", "id": "960186275874990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982508_960186279208323_2337064947745311296_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQjeJt65wxkQ7kNvwHuB71O&_nc_oc=AdpoENSkp6nkSELxLRM1Hgu3gJXCRXOTuGsMGkaby2J2gLwChbNfsFVkPtg4moAvV-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI3IPFbZ9Fm6yDaYoEj5uzqMkSiZCNlyX-C6US_NSpUQ&oe=6B0332D0"}, {"file_name": "Screen5.png", "id": "27733580852907768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_27733580869574433_6263553384650191409_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PioXK6QiR0Q7kNvwEKcIB5&_nc_oc=AdqKCnT0CnJ8TStqgWtv8DdrED-zXaYkqY1LyWjmkw5VsBzBWIyhnEtk01BRYxFqpo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShWmeIdQPGPn8FE5V5bvlYjtvMb70FtbfYahP3RmsBRQ&oe=6B032A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "533251622521530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031378_533251625854863_3181000300712893273_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLHD4n8-w20Q7kNvwEiPJFy&_nc_oc=Adpbji1lcKGHNxE_k1YHv9vGSSC1sF-54_jtEbuKiUWNCQmms9drorgfZZ8LeA6y02Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY8XWzrz3T1vTJkn2j4jBFxKSU0tp_UMvvWBgtqvshoQ&oe=6B030C75"}, "display_name": "ROBOCRACY", "keywords": [], "long_description": "Disturbing signals are coming from the edges of explored space. Rebel robots have learned to cooperate and are building bases on uninhabited planets. Their new goal is to enslave all \"bags of bones,\" also known as humans, under the rule of Robocracy.\nThe Galactic Rangers are called to deal with this new threat!\n\nThey've proven that humanity can rely on them to defend against machines. But this time, the challenge is tougher than ever \u2014 you\u2019ll be up against upgraded robot models!\n\nFind and stop the Robocracy before it\u2019s too late! Defend the simple joys of human civilization: cute kittens, breakfast in bed, funny memes, and internet arguments!\n\n**Key features:**\n- Survive three hardcore acts with lots of missions in the beautiful landscapes of the explored Universe\n- Survive three hardcore acts filled with missions across the beautiful landscapes of the known Universe.\n- Arm yourself with powerful blasters, shotguns, and rocket launchers.\n- New control mechanics elevate the gameplay experience to a whole new level.\n- Tackle different difficulty levels. Use shields, slow down time, plant mines \u2014 utilize every tool to reclaim control over the Universe.\n- Fight the Robocracy solo or team up with friends to take on the soulless machines.", "short_description": "Fight against a rogue artificial intelligence and save humanity from becoming slaves to machines! Put on your VR headset, become a Galactic Ranger, and journey into deep space. Blast through waves of robots with powerful blasters, shotguns, and other crazy weapons, just like in the classic arcade games!"}]}, "developer_name": "DGMA", "developer_privacy_policy_url": "https://robocracy.dgma.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DGMA", "support_website_url": null, "website_url": "http://dgma.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], 
6MVag1wNt4Q7kNvwFMpxAb&_nc_oc=AdrQb79WKfJEtEFrff4hPtbqPDK8DI5RtuTyaBnQHrp85RLjhpwt33dHFWWP6CddKdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGHDkBmViIcOThnOwU8grl8qLEzLwTPnVNHB5HE-1z1A&oe=6B0C6EB4"}, {"file_name": "Screen4.png", "id": "960186275874990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982508_960186279208323_2337064947745311296_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aueDw85hJGUQ7kNvwGc6Pbb&_nc_oc=Adqp5d6llqQ7pnUBU87A1WEfjJWE59gpCsFDe4SKF0WReug0ZZO4FKzVd0rA6EZnKvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwqFjkOsFJciEs0CL7HtnKgvZ7xzzWzsh-jbj-BhWsKw&oe=6B0C6D50"}, {"file_name": "Screen5.png", "id": "27733580852907768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031315_27733580869574433_6263553384650191409_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chtzZBQlPLEQ7kNvwESUEPV&_nc_oc=AdqTkdjhfljTBl21QUWBhtSDPoXs441tB_2tfn5obcI2t7e4GN5BV2M4eQzyTHEmx8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVwB7zQaZtExDnJmxXZZwJcfgJ1cHnQGSU78ie86iVYA&oe=6B0C6502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "533251622521530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031378_533251625854863_3181000300712893273_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOBsDWcZeawQ7kNvwFNjDVl&_nc_oc=AdrjjbkWMzDXqqTiNj38DqHohafdYrc7fko0_18QD9eE9jFIpmBM8rT6lZc1AqAxd_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSKmUOnxODc-hIcCqOe9afnGHttiypK-B_gZ7QJdiWnw&oe=6B0C7F35"}, "display_name": "ROBOCRACY", "keywords": [], "long_description": "Disturbing signals are coming from the edges of explored space. Rebel robots have learned to cooperate and are building bases on uninhabited planets. Their new goal is to enslave all \"bags of bones,\" also known as humans, under the rule of Robocracy.\nThe Galactic Rangers are called to deal with this new threat!\n\nThey've proven that humanity can rely on them to defend against machines. But this time, the challenge is tougher than ever \u2014 you\u2019ll be up against upgraded robot models!\n\nFind and stop the Robocracy before it\u2019s too late! Defend the simple joys of human civilization: cute kittens, breakfast in bed, funny memes, and internet arguments!\n\n**Key features:**\n- Survive three hardcore acts with lots of missions in the beautiful landscapes of the explored Universe\n- Survive three hardcore acts filled with missions across the beautiful landscapes of the known Universe.\n- Arm yourself with powerful blasters, shotguns, and rocket launchers.\n- New control mechanics elevate the gameplay experience to a whole new level.\n- Tackle different difficulty levels. Use shields, slow down time, plant mines \u2014 utilize every tool to reclaim control over the Universe.\n- Fight the Robocracy solo or team up with friends to take on the soulless machines.", "short_description": "Fight against a rogue artificial intelligence and save humanity from becoming slaves to machines! Put on your VR headset, become a Galactic Ranger, and journey into deep space. Blast through waves of robots with powerful blasters, shotguns, and other crazy weapons, just like in the classic arcade games!"}]}, "developer_name": "DGMA", "developer_privacy_policy_url": "https://robocracy.dgma.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DGMA", "support_website_url": null, "website_url": "http://dgma.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], 
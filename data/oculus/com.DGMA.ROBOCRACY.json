e": "556x164px.png", "id": "371542396028056", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982464_371542402694722_3697605967965050128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbD42__E0jQQ7kNvwF1_uNX&_nc_oc=AdqV0bFSgAJzfgzX-4I8AQKO7nXGaangOW8VC8Tj5JDPUSrUgsoSbntSxU-m_DO1fig&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg_MbYE3YEH3vZYaJJ2dhxMvRTDaELbXI5Ir8HyJ0dLA&oe=6AAE89D6"}]}, "id": "516507991330168", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "1188831972381702", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035426_1188831975715035_3925175930010327634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iK0iDCA1JgQ7kNvwEwjETo&_nc_oc=Adqrw6ghn6NEkLaohHpw8u9fgpuIPYcWx9_gJH--yZOKbJ_BfREMUmRVKilPMCLTouQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvoLW-Jh3vETRZNEFs2ZvzA3uz4DBzLHFFDGzz6vLe_A&oe=6AAEA464"}, {"file_name": "Screen2.png", "id": "813050900724904", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031378_813050904058237_303294129693474701_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Az6Ou_9QtJUQ7kNvwGJe_vY&_nc_oc=AdqoOElYxeir0bj22rzvDsgSIih77HB80ezkzOuP6ycupDmUvbIf88JK4LRV7Vi2OYw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6UXGopOgd0jhqScL1M0m_5GQSZPmuavQXg4JsLHPskA&oe=6AAE8A28"}, {"file_name": "Screen3.png", "id": "1060911008770007", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031612_1060911012103340_1380365596634120751_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-12Rv4_4rQ8Q7kNvwGiOH1b&_nc_oc=AdpYPhANTTFsA2q9fGL2QoGEnuYR4vZFHg_x4OuwFukM_sB6DIAh982TNihnix_hOPw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTj-M5Pc3CyuRaZxsCLWrxZeQaTkTkcYZk53eViR1EVQ&oe=6AAE9BF4"}, {"file_name": "Screen4.png", "id": "960186275874990", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982508_960186279208323_2337064947745311296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-n3RU5Y6FcQ7kNvwEYqJ5U&_nc_oc=AdobHED8X4V0CcE9y33uIT0_adnP84T5_Jcu7R3qBOXkaIDyyOR2cKyxHcNVYVTX_Rk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpH_EqbfOwgSa2g6gDl940Jc7yrf1w601ucrDS-oEQdQ&oe=6AAE9A90"}, {"file_name": "Screen5.png", "id": "27733580852907768", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031315_27733580869574433_6263553384650191409_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqWsOjVlpWkQ7kNvwEi3NnO&_nc_oc=Adqo66XoLRV9-s0Uk6HVuZy_HQCXvAihHGdpENltN5naIGD-tTWTAIjlHCW8NBUb8mY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ8dZv4-ud1FcrZEJ5JxowB8EDtu9LzU9IQ5cWIJHKEQ&oe=6AAE9242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "533251622521530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031378_533251625854863_3181000300712893273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM6LEEmhmiQQ7kNvwHuhlMc&_nc_oc=AdqdyBPOMtMipT_qApF3ES0E3DoCTeu00IEkgT3RkJWoyxpmo3ce10NF7YQllOgMWEs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqt8upmonRVR-UPHpd7wLY00oSjpl6lwY0RQKGqA-J6A&oe=6AAEAC75"}, "display_name": "ROBOCRACY", "keywords": [], "long_description": "Disturbing signals are coming from the edges of explored space. Rebel robots have learned to cooperate and are building bases on uninhabited planets. Their new goal is to enslave all \"bags of bones,\" also known as humans, under the rule of Robocracy.\nThe Galactic Rangers are called to deal with this new threat!\n\nThey've proven that humanity can rely on them to defend against machines. But this time, the challenge is tougher than ever \u2014 you\u2019ll be up against upgraded robot models!\n\nFind and stop the Robocracy before it\u2019s too late! Defend the simple joys of human civilization: cute kittens, breakfast in bed, funny memes, and internet arguments!\n\n**Key features:**\n- Survive three hardcore acts with lots of missions in the beautiful landscapes of the explored Universe\n- Survive three hardcore acts filled with missions across the beautiful landscapes of the known Universe.\n- Arm yourself with powerful blasters, shotguns, and rocket launchers.\n- New control mechanics elevate the gameplay experience to a whole new level.\n- Tackle different difficulty levels. Use shields, slow down time, plant mines \u2014 utilize every tool to reclaim control over the Universe.\n- Fight the Robocracy solo or team up with friends to take on the soulless machines.", "short_description": "Fight against a rogue artificial intelligence and save humanity from becoming slaves to machines! Put on your VR headset, become a Galactic Ranger, and journey into deep space. Blast through waves of robots with powerful blasters, shotguns, and other crazy weapons, just like in the classic arcade games!"}]}, "developer_name": "DGMA", "developer_privacy_policy_url": "https://robocracy.dgma.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DGMA", "support_website_url": null, "website_url": "http://dgma.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "8263558690393028"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "
nerA3WqOx8Q7kNvwGgp9QW&_nc_oc=Adqnjo0hNEXGWTk9uDvcC34KCFi-wXdeZF_sOzAYr1jxPiyLVHJFbIbsqDVJwQp1Pa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDvYqg2ISCkludWpFiWtM7UGHFzBnTco25Kyox09pbig&oe=6B09CBB4"}, {"file_name": "Screen4.png", "id": "960186275874990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982508_960186279208323_2337064947745311296_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbXzOUGocnIQ7kNvwF98Qb8&_nc_oc=AdrI7pRTz7X6_Rvp46pebQlPqrtp3Xcj2eHB0WllxZ8rNZ1L2DqW6I2XBaZCjO5MdJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIIMHHe0uPEaR03BjxqCE77ORrurLUT2inMtBE-Pfngw&oe=6B09CA50"}, {"file_name": "Screen5.png", "id": "27733580852907768", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031315_27733580869574433_6263553384650191409_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VfZaWpYwX0Q7kNvwFMRg-r&_nc_oc=Adp9CXRrq17dyPQ7Vl1Kjja0inngDIUWMVwOuEIz90TAGEEAbgnR6xccFmP4GnMQ17E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9zE_MTGnPd-7kJ0MvzK5rjriXvsS9DVRnjVd8JswFYw&oe=6B09C202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "533251622521530", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031378_533251625854863_3181000300712893273_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GrLFSYH8lsQ7kNvwFIo9JE&_nc_oc=Adpas2ZzQzBu5foPwWGxEiL8orypMh00lmrue2pF9FjfNDeJcR7K8cyofJvTKA1nE6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHT6PLoD8Mbl71F4EzTfckbKju9bd4e22E-3NcYDcrgA&oe=6B09A3F5"}, "display_name": "ROBOCRACY", "keywords": [], "long_description": "Disturbing signals are coming from the edges of explored space. Rebel robots have learned to cooperate and are building bases on uninhabited planets. Their new goal is to enslave all \"bags of bones,\" also known as humans, under the rule of Robocracy.\nThe Galactic Rangers are called to deal with this new threat!\n\nThey've proven that humanity can rely on them to defend against machines. But this time, the challenge is tougher than ever \u2014 you\u2019ll be up against upgraded robot models!\n\nFind and stop the Robocracy before it\u2019s too late! Defend the simple joys of human civilization: cute kittens, breakfast in bed, funny memes, and internet arguments!\n\n**Key features:**\n- Survive three hardcore acts with lots of missions in the beautiful landscapes of the explored Universe\n- Survive three hardcore acts filled with missions across the beautiful landscapes of the known Universe.\n- Arm yourself with powerful blasters, shotguns, and rocket launchers.\n- New control mechanics elevate the gameplay experience to a whole new level.\n- Tackle different difficulty levels. Use shields, slow down time, plant mines \u2014 utilize every tool to reclaim control over the Universe.\n- Fight the Robocracy solo or team up with friends to take on the soulless machines.", "short_description": "Fight against a rogue artificial intelligence and save humanity from becoming slaves to machines! Put on your VR headset, become a Galactic Ranger, and journey into deep space. Blast through waves of robots with powerful blasters, shotguns, and other crazy weapons, just like in the classic arcade games!"}]}, "developer_name": "DGMA", "developer_privacy_policy_url": "https://robocracy.dgma.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DGMA", "support_website_url": null, "website_url": "http://dgma.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], 
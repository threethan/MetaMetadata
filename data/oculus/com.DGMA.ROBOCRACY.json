nerA3WqOx8Q7kNvwGRU8g7&_nc_oc=AdpJt52OIp_IM-d_9cEkCMNQqs4DtoGvuJeJMD9jGkyy6m74Po3-e5KxjYTh2qLziHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEgn7J0DJxEb8rc-flQuiy9ON7VOiXORiJQBM2xJoYog&oe=6B0B1D34"}, {"file_name": "Screen4.png", "id": "960186275874990", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982508_960186279208323_2337064947745311296_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aueDw85hJGUQ7kNvwGhsTyi&_nc_oc=Adqa2C97TCP5K2pr8u7--Q_p_l35rpUKYv-Dgd49SchLUbtRfjd-v5vaxFLV6gEyovY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj3TSYcK6jOKm8Am1UTnK-VRgyFfAj1v60-HFLt55paQ&oe=6B0B1BD0"}, {"file_name": "Screen5.png", "id": "27733580852907768", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031315_27733580869574433_6263553384650191409_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VfZaWpYwX0Q7kNvwH6ozl3&_nc_oc=Ado7yo5uQ85KJOHhh0WJqlmzyZpNEQmZz_udAK7ys3MCDK6GkgnntDbj3SY1nb0Z22k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9L-QXy6nvwr21MGiv3BTMun2kcBNzwpF3S5fMWHQLnQ&oe=6B0B1382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "533251622521530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031378_533251625854863_3181000300712893273_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOBsDWcZeawQ7kNvwFgG8ig&_nc_oc=AdpJ_E9kh50ZTQmhtdHxh5cFthUNd2L6kUCF3aC7ZN2pnEiLqS-rZMuXck4d2CEYONM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaz4gO7_GTeRs-VXZwAichJU_bL7kzaJ_R-CVTk8fMow&oe=6B0B2DB5"}, "display_name": "ROBOCRACY", "keywords": [], "long_description": "Disturbing signals are coming from the edges of explored space. Rebel robots have learned to cooperate and are building bases on uninhabited planets. Their new goal is to enslave all \"bags of bones,\" also known as humans, under the rule of Robocracy.\nThe Galactic Rangers are called to deal with this new threat!\n\nThey've proven that humanity can rely on them to defend against machines. But this time, the challenge is tougher than ever \u2014 you\u2019ll be up against upgraded robot models!\n\nFind and stop the Robocracy before it\u2019s too late! Defend the simple joys of human civilization: cute kittens, breakfast in bed, funny memes, and internet arguments!\n\n**Key features:**\n- Survive three hardcore acts with lots of missions in the beautiful landscapes of the explored Universe\n- Survive three hardcore acts filled with missions across the beautiful landscapes of the known Universe.\n- Arm yourself with powerful blasters, shotguns, and rocket launchers.\n- New control mechanics elevate the gameplay experience to a whole new level.\n- Tackle different difficulty levels. Use shields, slow down time, plant mines \u2014 utilize every tool to reclaim control over the Universe.\n- Fight the Robocracy solo or team up with friends to take on the soulless machines.", "short_description": "Fight against a rogue artificial intelligence and save humanity from becoming slaves to machines! Put on your VR headset, become a Galactic Ranger, and journey into deep space. Blast through waves of robots with powerful blasters, shotguns, and other crazy weapons, just like in the classic arcade games!"}]}, "developer_name": "DGMA", "developer_privacy_policy_url": "https://robocracy.dgma.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DGMA", "support_website_url": null, "website_url": "http://dgma.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], 
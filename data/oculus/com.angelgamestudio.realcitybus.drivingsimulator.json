2964568_3598966352917393506_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waqqFVnjSrwQ7kNvwEMqmkO&_nc_oc=AdqvGHArl0wM5id57MvRjero1YrdITXsAip0SWWZogINmInBexm5KTVoDAwrJ48Z-fk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbZsr7IC_BiSfwnwaDMDKYyoraravtzxu79nwdwOGuUA&oe=6AFC6839"}, {"file_name": "Screenshot_4.png", "id": "2215634185626266", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821230_2215634188959599_4128661979064506494_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU5jolK4Rt8Q7kNvwErfNUt&_nc_oc=AdpbsqLjZSoVQqItA5w5zj-fFiwRwcCMPZFTiRV49F4E-kiq9m4tIrzvuh6ZDbpA-cw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8x1tSfHSXrvX62kQo9nixjmkUZky_1iOBE1Q6x9Tfjw&oe=6AFC80BB"}, {"file_name": "Screenshot_2.png", "id": "1146484727621592", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823270_1146484730954925_2303900105684945451_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osouYcb4efYQ7kNvwF9iOop&_nc_oc=AdpmAZ83tHSAm_OCLP90Yhs-MI4bBQR73ePdFffQH_ofhDt_CyJ4CS0StimVG1hykVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnby3BhYOAgNM3Pf361vdBzDlFxbpKpx9NtHR-f1asQQ&oe=6AFC7D88"}, {"file_name": "Screenshot_1.png", "id": "817118751101654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_817118754434987_7122032549325736035_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnou9eDJdEwQ7kNvwGiFvks&_nc_oc=AdrnZCG0HCb0DmIX4mL5yaIOBnd0oJBIi_7hA0_WIJR0EJJ_EXvTv6U918xSz2yqwnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL765Emw7YPzs6fD5sReH9oB9gjbybMmYlvKtn3pfUUw&oe=6AFC8F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real City Bus Driving Simulator VR", "keywords": ["CityBus", "CoachDriving", "VRTransport", "RealisticDriving"], "long_description": "\ud83d\ude8c Real City Bus Driving Simulator VR\nExperience the ultimate city bus driving adventure \u2014 now in full Virtual Reality!\nStep into the driver\u2019s seat and explore a living, breathing city as you transport passengers, follow real routes, and master the art of precision driving. Every stop, turn, and signal feels real in this immersive bus simulator VR experience.\n\ud83d\ude8f Realistic Driving Experience\nDetailed 3D city environments with traffic, pedestrians, and weather effects.\nTrue-to-life bus physics and steering controls built for VR immersion.\nSmooth interior and exterior camera views for total realism.\n\ud83d\udc68\u200d\u2708\ufe0f Become a Professional Driver\nPick up and drop off passengers across dynamic routes.\nManage schedules, traffic lights, and road challenges.\nEarn rewards and unlock new routes, buses, and upgrades.\n\ud83c\udf06 Immersive VR Features\nIntuitive hand tracking and motion controls.\nAuthentic driver\u2019s cabin with fully interactive instruments.\nFeel the thrill of real city transport like never before!\nWhether you\u2019re a casual gamer or a simulation enthusiast, Real City Bus Driving Simulator VR delivers the most authentic and engaging VR bus driving experience available.\nGet behind the wheel, start your engine, and show the city what a real driver can do!", "short_description": "Drive realistic city buses in a true VR simulator experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/angelgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area"
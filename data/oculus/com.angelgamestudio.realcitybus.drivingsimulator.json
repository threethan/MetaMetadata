: "Screenshot_5.png", "id": "1360502582034498", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_1360502585367831_1514485205061460445_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlBiP76CzZQQ7kNvwExcPNY&_nc_oc=AdoTY_HfUdJLeZ0cKo7u8q9d0oRGzJH-A8OVCJtYszK_pn2rxni-82WEqOeHsqFit1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Wf1vCTuXgyGfZ1JwgoGHSoidn4QGfmvMARwVObHQwA&oe=6AFC5DA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real City Bus Driving Simulator VR", "keywords": ["CityBus", "CoachDriving", "VRTransport", "RealisticDriving"], "long_description": "\ud83d\ude8c Real City Bus Driving Simulator VR\nExperience the ultimate city bus driving adventure \u2014 now in full Virtual Reality!\nStep into the driver\u2019s seat and explore a living, breathing city as you transport passengers, follow real routes, and master the art of precision driving. Every stop, turn, and signal feels real in this immersive bus simulator VR experience.\n\ud83d\ude8f Realistic Driving Experience\nDetailed 3D city environments with traffic, pedestrians, and weather effects.\nTrue-to-life bus physics and steering controls built for VR immersion.\nSmooth interior and exterior camera views for total realism.\n\ud83d\udc68\u200d\u2708\ufe0f Become a Professional Driver\nPick up and drop off passengers across dynamic routes.\nManage schedules, traffic lights, and road challenges.\nEarn rewards and unlock new routes, buses, and upgrades.\n\ud83c\udf06 Immersive VR Features\nIntuitive hand tracking and motion controls.\nAuthentic driver\u2019s cabin with fully interactive instruments.\nFeel the thrill of real city transport like never before!\nWhether you\u2019re a casual gamer or a simulation enthusiast, Real City Bus Driving Simulator VR delivers the most authentic and engaging VR bus driving experience available.\nGet behind the wheel, start your engine, and show the city what a real driver can do!", "short_description": "Drive realistic city buses in a true VR simulator experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/angelgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25799114616442935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_733497425667384_238190104992054848_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9SncONFLoYQ7kNvwGp7C_l&_nc_oc=AdoEE3xHwYwZHR4-UqCk5YYui1dU1-cd4-aGS0UI0ovzVOWp7k-vjX8cUC6IcctX3BA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSWIo5q6JLNiSYgQ9TIYQglwVnEmUUdKEtOcOwD_FnPQ&oe=6AFC7120"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Real City Bus Driving Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1762831320, "lastRevision": {"nodes": [{"id": "25296263543394714", "release_type": "SCHEDULED", "administration_status"
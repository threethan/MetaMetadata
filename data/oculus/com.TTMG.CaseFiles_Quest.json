_fSRNzp2MzKJoc1gTtBWpGw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe9ib1peePSmqR7Q9FK2KLUgAbgzmvkz8IwUF07pirvA&oe=6A8EEB1F"}, {"file_name": "Screenshot_3.png", "id": "1489124178190898", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974469_1489124181524231_5716740156718105765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQcCpdRnSPwQ7kNvwGw8hRD&_nc_oc=AdpuqSxWIcHSqy1mokEUEH-yUzxGFRi3ZtA-bf2hRx9LIzaufarCaWIzTYlJgeJj-cQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWnDyqefkXnqOJIIVwMtpzqfHe5zaFCvdHHhDA8eJhkQ&oe=6A8EC85D"}, {"file_name": "Screenshot_5.png", "id": "1140174713544580", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001726_1140174716877913_6490771454359944089_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yndZrNn9510Q7kNvwE0n-_U&_nc_oc=AdouYBk4nCmIp5H0rCg6JKAWusLRvzO-GijrgCCEqNTuaQJp3H1VI6CLVoQQsoNooQM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRfXqcm5-YeRVHhMlv8CAw9vsdqRb7_SDUewIXNz6zXw&oe=6A8EDA42"}, {"file_name": "Screenshot_6.png", "id": "1237689530369007", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001655_1237689533702340_7872628758300485951_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BNmqzJP1asQ7kNvwFINGlO&_nc_oc=AdrbMwLEULtXdnvNmmHrY_pSan6rL2riIae2YHnp27-Nfzpq2k37NE8lskT7tfYhfmw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZXhvqS6HlcIzyRgaOgu1NDdNl0aFYcxL4LqBLa6p5FA&oe=6A8EC9BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A real-time, police interrogation and detective simulator, where you control the course of the investigation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2018756915000471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974817_6040667449283328_6363323974724350943_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16w_FozKHK8Q7kNvwEh4o3e&_nc_oc=AdrvllJEoVlB_zRjiyZtKddwnRqx9eMKoyE2XREjJnMoAl7ANM4tTuTxv79fA_XNkhs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFPrcvzfsNTVmq-bHhmCz9kLfX8yvWEuNRCVa3gWCF8g&oe=6A8EC760"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Case Files: The Death of Paulette Williams", "platform": "ANDROID_6DOF", "context_category": {"co
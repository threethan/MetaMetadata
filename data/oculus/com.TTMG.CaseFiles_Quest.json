ns that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A real-time, police interrogation and detective simulator, where you control the course of the investigation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2018756915000471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974817_6040667449283328_6363323974724350943_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPRa-GCH3DkQ7kNvwF5QQ3R&_nc_oc=AdqVmfMRZoM8sElREWln2NQLdOXMeAfqqj-TNaXfREkbAPJQjD_9Smp7JKzQk8NKsSw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4atpImg7V0tUx3DkjSr2SeJVm3sC438OUFwVvwBGHxA&oe=6AAEA3A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Case Files: The Death of Paulette Williams", "platform": "ANDROID_6DOF", "context_category": {"context_cate
4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of FMV (full motion video) real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A murder has taken place in this real-time, police interrogation simulator. Through the use of video surveillance and case files, players take on the role of a behind-the-scenes detective who must uncover the truth and bring this case to a close."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
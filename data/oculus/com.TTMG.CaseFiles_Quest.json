t-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4ksROJ59YM8Fs3E-boSDzyQGpOx-ijUH06zQsK-e1Tw&oe=69B2C09F"}, {"file_name": "Screenshot_3.png", "id": "1489124178190898", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1489124181524231_5716740156718105765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfKgf698-VkQ7kNvwGqzQl6&_nc_oc=AdlZ3jvFDKXYdlzMxyEouWpy-DIhCJkOeUXvVwwxhEIGasPh74MA-S8jx-9Rrfx7t4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTsD4AIenU2inpC1nURphpkSqjmZDfot3JuhAuceB1MQ&oe=69B29DDD"}, {"file_name": "Screenshot_5.png", "id": "1140174713544580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1140174716877913_6490771454359944089_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gsgAOMmIkEQ7kNvwHtqP5F&_nc_oc=Adk3By812HNjT9MFw2NNmLnxHysPx0AKjKAKvqCsRWT4Y6ZEsM6llGd8lgkFDzJdaTk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbGJGZnkOIpudKeeOmoHDaRtrbGx1egIs-Uwd_8IGowA&oe=69B2AFC2"}, {"file_name": "Screenshot_6.png", "id": "1237689530369007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001655_1237689533702340_7872628758300485951_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kioK2ceVbukQ7kNvwEBr7hK&_nc_oc=AdkwEhrgk0071Sru7a212JUSSXJZQTWrp0pOKoD5c6kzu9HQvGQS9qMTB8JeNiOsTJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxt7ewhA0f5AhXMZ71e676eD5bRkGtMafT0_19aAWYC5A&oe=69B29F3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A real-time, police interrogation and detective simulator, where you control the course of the investigation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2018756915000471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_6040667449283328_6363323974724350943_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol43OIk6OpYQ7kNvwE5SAga&_nc_oc=AdmBzhyTk78LbhgbyJQkPV_bwQJvgHc1zU4nAhYFJyfTaMCDbDZGUzulxLTlPGBC8eo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwI8vb3Wrx5Mn2sj0Lr_w4w2ovnRVHBEo4AambXHjDfAg&oe=69B29CE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Case Files: The Death of Paulette Williams", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
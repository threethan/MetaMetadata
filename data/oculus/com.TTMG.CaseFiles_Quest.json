cdn.com/v/t64.5771-25/38974873_355088539833493_6989901154974729516_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-udLRbyjKIQ7kNvwH3_NfH&_nc_oc=AdqJi092Iy7vaP30qECcA949a7WSeizckS29gkRPYxVLXmIk4b075tRb1HM-_qhIBP4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92xq62dXCCdVfrUyoszm_3IGBDu9Hqu_HnPvofWXmQew&oe=6A22F8A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of FMV (full motion video) real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A murder has taken place in this real-time, police interrogation simulator. Through the use of video surveillance and case files, players take on the role of a behind-the-scenes detective who must uncover the truth and bring this case to a close."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "
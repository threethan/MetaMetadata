t-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-__hOvCUMNqGiKK9wwKQvKR-6LJqpKDditcsrrydXDQ&oe=69B9581F"}, {"file_name": "Screenshot_3.png", "id": "1489124178190898", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_1489124181524231_5716740156718105765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2AJiS07zrQQ7kNvwHqH7Ho&_nc_oc=Adn8t0CWgEUtjGzw80cQvXf9wd3rMIfwpG4RB8rvHfwQw2fsqDIUpt47bnuR5pv3ls0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPPuClXsi9ePj-w7aMme2kjYP7WH0bBBHixdBowH7sSA&oe=69B9355D"}, {"file_name": "Screenshot_5.png", "id": "1140174713544580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001726_1140174716877913_6490771454359944089_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR2pNIbNVCcQ7kNvwHA0Bef&_nc_oc=AdlUW_o5vhbhvdhifmvbiZrdn0YBeNHwBV5IKlYcV616ob-fHvy8GW1q3K3Qs1AN7U4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxC8xpdZ2rMtiw9fFL6u-8O2EeGZwmvlgvEpW-OsURO2A&oe=69B94742"}, {"file_name": "Screenshot_6.png", "id": "1237689530369007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001655_1237689533702340_7872628758300485951_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYx1n4r1IF4Q7kNvwExr_7R&_nc_oc=AdmD2N4HBzLWAUQYwpiR-FooNO6hLuTYCFS_rL_bvdGudMOFnsty2nUMNYmNdxgndZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmMJqeilZ1WXuEhD1o4BbfwG1mAJjouxeLTOtRBQM9pQ&oe=69B936BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A real-time, police interrogation and detective simulator, where you control the course of the investigation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2018756915000471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_6040667449283328_6363323974724350943_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=782KyxOABgAQ7kNvwFpJTzD&_nc_oc=AdlcX-GQxykExVyiuCBWODPbIR3c8fOe89LtexaQ0kfIK0njlCwI7h7qrwTNQmXFs0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQjiLp8r0UoTJk73e8aLzYYr9cnCLJ2nyWh1_v0lUzjA&oe=69B93460"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Case Files: The Death of Paulette Williams", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
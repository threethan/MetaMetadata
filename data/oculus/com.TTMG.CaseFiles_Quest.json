content-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw0EEaEX0LXikhbdN6FgzO64hilv39tYxUX2mlbSQlYA&oe=69AAD79F"}, {"file_name": "Screenshot_3.png", "id": "1489124178190898", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974469_1489124181524231_5716740156718105765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYBdNmuRgvoQ7kNvwHBxic6&_nc_oc=Adkyj8PRoC2sMh9tfkrVuvI-Sw0NuL_K2jLYniX5kdG8ZxwAxvZbV5JcpJE_2_IcP1M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkmMsS6UPZbg2I0kBeQJEeoo5ArFWsKq0UEpFSQkA7Ew&oe=69AAB4DD"}, {"file_name": "Screenshot_5.png", "id": "1140174713544580", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001726_1140174716877913_6490771454359944089_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mafyP-FQdAcQ7kNvwFkjQUv&_nc_oc=Admqdntzsc644ndnN54fTah-SO-UzhrMtGbOHZyCZIkWRKw9UxMD9W4HhhFDk62Hi64&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxM00DOEKUQVJGOIO-aiGICd9my8uLtYRr9rxRQtbtIwA&oe=69AAC6C2"}, {"file_name": "Screenshot_6.png", "id": "1237689530369007", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001655_1237689533702340_7872628758300485951_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j-XoaCmKJUQ7kNvwGViDu-&_nc_oc=AdnQWcQ4VmU5oSHYHS2-yN8dq4HKKQFEDpd4qcn5vedH-NLBgAZKAE0Dp4GbOlrlToM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afzid7s7ezsKgmwmB99IGeqGHzaGRq-e8usZvWdI4zrQkg&oe=69AAB63F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Case Files: The Death of Paulette Williams", "keywords": [], "long_description": "Paulette Williams, age 62, has been killed. There are only two possible suspects. In this real-time, police interrogation simulator, you take on the role of the lead detective in the observation room. You must guide your partner to uncover the truth. Through the use of real-time suspect interviews, video playback, case files, and your own wits, you must make critical decisions that will shape the course of this investigation. Put your detective skills to work, as you attempt to seek justice and bring this case to a close.", "short_description": "A real-time, police interrogation and detective simulator, where you control the course of the investigation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinktenmediagroup.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Think Ten Media Group, LLC", "support_website_url": "https://www.thinktenmediagroup.com/", "website_url": "https://www.thinktenmediagroup.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2018756915000471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974817_6040667449283328_6363323974724350943_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL1IMzLbsUgQ7kNvwHoO0ko&_nc_oc=Adk7GY9qf7yMWI3S1k2T8giPpayO3n9Sfb5Cj6wL-GYuM0WYiK1Pbtkzm5T9LSSf4eo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4bZFRTcxAtDNw0a4frcPfWTUtOXRjGEyyANjhALD_8g&oe=69AAB3E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Case Files: The Death of Paulette Williams", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
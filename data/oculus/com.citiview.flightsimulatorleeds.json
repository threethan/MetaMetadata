-25/594002350_1651959486564160_3251240181586908979_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01M4Poixfs4Q7kNvwEfDu4y&_nc_oc=AdpU6cM88ot5eHJ-Ap0W9BQOrnkQHP2hegoYtS2n-8JxJ8lJ2LNRmsf9bcRcwy2LX8o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6I8Cb_2xmb2muFIv8NEq2uyLYTm1SrDg2tWo9fhHyGg&oe=6AFC8635"}, {"file_name": "screenshot_3.png", "id": "1665043398673778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1665043402007111_5524902206025843959_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SAJ8WukRPMQ7kNvwH-3-U4&_nc_oc=AdriDi8B_w1ZnlaTYxPgfd0p0aZ1IK2BRORM8BmIkZnaUoij2SKFPoKOdR8OFJkgf0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGif0w7RRLySU6QQHlLcC8mjlx1gBKKpCX9Vk63P-Q-Q&oe=6AFC940D"}, {"file_name": "screenshot_2.png", "id": "28205501749131824", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593761155_28205501769131822_6771616031568167690_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc8XcildVJQQ7kNvwH_SmGA&_nc_oc=Ado-c80Ggn6otdGYtHo4c6wQ8nTjbVh01KUtRWz46928_UGYmnYN-8F70apTwwNc9tY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFx3O_LHTl23Uan0iMQ0o6SX-buNwPP4UJLeqlLMXYow&oe=6AFC8A8C"}, {"file_name": "screenshot_5.png", "id": "4082817058691510", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593854747_4082817062024843_6216244244084798595_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoeFsmXZuRkQ7kNvwF1M-Yj&_nc_oc=Adq8OHAk_QKVHvmOdIQXPZY1ZOyvv4GRyCfveuACfispoii9Dh45I2MoqjlUhN5xoTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBQZcQYXrJfI9BM5Won9j--NwTiXEpjSQoLd_sDldx3w&oe=6AFC7A19"}, {"file_name": "screenshot_4.png", "id": "1273442744923820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623111_1273442748257153_5852137087516105974_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTgHYddEKEsQ7kNvwGg-p4W&_nc_oc=Adp53GOA6P79x2fwXkEhBNE0rJ08WhIX7U5xjAYHxC-QB3niVQdfH_GLX31BuzulOLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYN-bFs4FBLTRNdu68U8pO0ikrmwpcN4TQxdUKPpI1Pg&oe=6AFC7B17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1799541104695150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1799541108028483_9073185086893684190_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHVXvo_dDNMQ7kNvwEdlPwq&_nc_oc=AdoHihiAPmHfJG4_ucJpfOWTPl7gGkN6PKdsRadmhbwyB1qOU7LTv4GqBgdGR_ii44I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRhgU8muARYw0N8wxjWNlehPQNBwK_msDNbSYqASHh5g&oe=6AFC64D7"}, "display_name": "Flight Simulator Leeds", "keywords": ["flight", "simulator", "leeds", "yorkshire", "jet"], "long_description": "Flight Simulator Leeds puts you in the captain's seat over the real Yorkshire.\n\nTHE REAL LEEDS\nReal satellite, elevation and map data: the Town Hall's clock tower, the Civic Hall's golden owls, the Corn Exchange, Kirkgate Market, the Minster, Bridgewater Place, Altus House and the Arena Quarter, the Royal Armouries, the Parkinson tower, Elland Road and Headingley.\n\nYORK AND THE DALES\nYork Minster and Clifford's Tower, Knaresborough's viaduct over the Nidd, Harrogate, Ripon, Fountains Abbey, Brimham Rocks, Bolton Abbey, Skipton Castle and the Cow and Calf on Ilkley Moor.\n\nTHE WEST RIDING\nBradford's City Hall and Lister Mills, Saltaire, Halifax's Piece Hall and Wainhouse Tower, Huddersfield's Castle Hill, the Emley Moor mast and Drax's cooling towers.\n\nA LIVING COUNTY\nTrains on their real tracks, traffic on the left on the real roads. At night the Town Hall, the Arena, Elland Road and Emley Moor light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar at Aire Park, the city out of the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, Vale of York approach, a sunset hop, the Aire Valley run, the Arena Quarter, York and the Dales, a Topcliffe scramble, Leeds by night, a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Leeds and Yorkshire, built from real satellite and map data: the Town Hall, Bridgewater Place, Altus House, Elland Road and Headingley, then on to York Minster, Knaresborough's viaduct, Fountains Abbey, the Dales, Emley Moor and Drax. Start in your own glass hangar on the South Bank, talk to air traffic control, fly the Aire valley and land at Leeds Bradford."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorleeds/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorleeds/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387091404487395"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4709333785972346"}]}, "baseline_offer": {"id": "4709333785972346"}, "is_approved": true, "firstOffer": {"nodes":
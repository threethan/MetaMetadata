6wFjW7LdJRAQ7kNvwEpyuwS&_nc_oc=AdqzFLpPhuxFbuBwkKe-xlJdH-QaetxgLxJEihWNzsnm7nQEDmNtJk4bfBfsTMCFHZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcGiXcoi9ZG6bkPCNL-bAEjCFO-lSnFMJcBfBZJQZQLg&oe=6AFF1E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1799541104695150", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1799541108028483_9073185086893684190_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzDvF9wD3dIQ7kNvwHU3Fo6&_nc_oc=AdpUb6B4lHoJRbN07QFjO0ZCICYD8l0JKqWCijTdUUcPeSCbdY7hTfKr8HJtWFai2ts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZW5C6o4sbwuyBgWrG77ZaQ-R-u6zUrA8taKe3D2uCHA&oe=6AFF07D7"}, "display_name": "Flight Simulator Leeds", "keywords": ["flight", "simulator", "leeds", "yorkshire", "jet"], "long_description": "Flight Simulator Leeds puts you in the captain's seat over the real Yorkshire.\n\nTHE REAL LEEDS\nReal satellite, elevation and map data: the Town Hall's clock tower, the Civic Hall's golden owls, the Corn Exchange, Kirkgate Market, the Minster, Bridgewater Place, Altus House and the Arena Quarter, the Royal Armouries, the Parkinson tower, Elland Road and Headingley.\n\nYORK AND THE DALES\nYork Minster and Clifford's Tower, Knaresborough's viaduct over the Nidd, Harrogate, Ripon, Fountains Abbey, Brimham Rocks, Bolton Abbey, Skipton Castle and the Cow and Calf on Ilkley Moor.\n\nTHE WEST RIDING\nBradford's City Hall and Lister Mills, Saltaire, Halifax's Piece Hall and Wainhouse Tower, Huddersfield's Castle Hill, the Emley Moor mast and Drax's cooling towers.\n\nA LIVING COUNTY\nTrains on their real tracks, traffic on the left on the real roads. At night the Town Hall, the Arena, Elland Road and Emley Moor light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar at Aire Park, the city out of the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, Vale of York approach, a sunset hop, the Aire Valley run, the Arena Quarter, York and the Dales, a Topcliffe scramble, Leeds by night, a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Leeds and Yorkshire, built from real satellite and map data: the Town Hall, Bridgewater Place, Altus House, Elland Road and Headingley, then on to York Minster, Knaresborough's viaduct, Fountains Abbey, the Dales, Emley Moor and Drax. Start in your own glass hangar on the South Bank, talk to air traffic control, fly the Aire valley and land at Leeds Bradford."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorleeds/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorleeds/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387091404487395"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typenam
ayywQ7kNvwGX2tWv&_nc_oc=Adl5kx9gwxNmfNPZIJfNyk-LWq9_Nn4-kWgMVGbSEEb73Gau2dbXADefA1yYv97npSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM63i6SxwEQ3VuNtKL4IJps4-rHc2W3eeJWVmMFDwUTw&oe=69B01461"}, "display_name": "Hanna in a Choppa 3", "keywords": [], "long_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in fabulous 3D VR on the Rift and Quest, rather than crappy old 2D Flash. Guide Hanna through 10 bonkers levels, each with hidden secrets and achievements. Train your pet elephant Stompy, steal honey from pesky bees, humiliate upgraded OXOBot at his own game, and of course, The Button makes a spectacular return.\n\nJoin the Discord: https://discord.gg/VmA5fWPryw\n\nAs authentic to the original as possible! This game is a labour of love while also extending the core concept wildly. It's also very, very orange!\n\nIncludes over 60 unlockable Oculus achievements and 10 custom animated items for your Oculus Home. Can you get them all?", "short_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in VR on the Rift and Quest, rather than crappy old Flash. Guide Hanna through 10 bonkers levels each with hidden secrets and achievements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/k7bxbiereh7x0liq094u1/PrivacyPolicy_TOS.pdf?rlkey=g3v0s8py80d7hzxpnfnjth0uk&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/1370/hanna-in-a-choppa-3/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION"], "has_in_app_ads": null, "intern
h=00_AQVObT7CZiRbaRJws-i_il3hQk4rWdbUA69o1MKed8aRPA&oe=6B106728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HannaInAChoppa-Landscape-2560x1440.png", "id": "297115872440120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363513_297115875773453_8263906783981114905_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAT8iVWHKVEQ7kNvwFFT-kX&_nc_oc=AdreXi1hmg52oGbZeiiaKI_Y7ppaq1GtOXOi7kXjvHDHLA-VIgZu8AYv8cykjyfJGts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUS-g_17bf6U1dXq6ftSD4nMgqxhOjNlim-u9iT3FN_qQ&oe=6B104D21"}, "display_name": "Hanna in a Choppa 3", "keywords": [], "long_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in fabulous 3D VR on the Rift and Quest, rather than crappy old 2D Flash. Guide Hanna through 10 bonkers levels, each with hidden secrets and achievements. Train your pet elephant Stompy, steal honey from pesky bees, humiliate upgraded OXOBot at his own game, and of course, The Button makes a spectacular return.\n\nJoin the Discord: https://discord.gg/VmA5fWPryw\n\nAs authentic to the original as possible! This game is a labour of love while also extending the core concept wildly. It's also very, very orange!\n\nIncludes over 60 unlockable Oculus achievements and 10 custom animated items for your Oculus Home. Can you get them all?", "short_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in VR on the Rift and Quest, rather than crappy old Flash. Guide Hanna through 10 bonkers levels each with hidden secrets and achievements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/k7bxbiereh7x0liq094u1/PrivacyPolicy_TOS.pdf?rlkey=g3v0s8py80d7hzxpnfnjth0uk&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https:
ABF"}, {"file_name": "Screenshot01.png", "id": "566940431317298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974471_566940434650631_1170701606254287921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJm2awivFLcQ7kNvwE04-xV&_nc_oc=Adq2-MvJciFWTlwPtQP-UfVKvidadF8PMcEqT6nIybEL-x-E7c5M66NGJ1KMZeX7AIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sSfHn2SaTPw6NsUMswLtnNYrNiL8qeBDOrIE0NC3Ung&oe=69F1F1A8"}, {"file_name": "Screenshot04.png", "id": "877282366505981", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974503_877282369839314_2263831993236563872_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgX0SUUwQc8Q7kNvwGx9VpP&_nc_oc=AdplKWHqbgiJvabpWlyZ7piuruZL7L-cUQX8V5KgNfJ7sT7eqIKgqC69dQAQ4PQGDZM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af11NDkVGhUh1a2sJG08iF1UQyAFgOOS3hnUhxfESTP25g&oe=69F1EBCE"}, {"file_name": "Screenshot02.png", "id": "324545289451118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001675_324545296117784_2246586455378850939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuVbG04Rr6AQ7kNvwGm6wU8&_nc_oc=Adp8dzX-zS9-z4tmMUMhewb5VyAAyNlECf_1Z4JpNJs0XpA55vf7ar88vzi0T21Q9IM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2fcKIC41CH8e6R0x-wvPRcIYNywJze-7-GY8DEWeutIw&oe=69F21968"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hanna in a Choppa 3", "keywords": [], "long_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in fabulous 3D VR on the Rift and Quest, rather than crappy old 2D Flash. Guide Hanna through 10 bonkers levels, each with hidden secrets and achievements. Train your pet elephant Stompy, steal honey from pesky bees, humiliate upgraded OXOBot at his own game, and of course, The Button makes a spectacular return.\n\nJoin the Discord: https://discord.gg/cVw7frwNSk\n\nAs authentic to the original as possible! This game is a labour of love while also extending the core concept wildly. It's also very, very orange!\n\nIncludes over 60 unlockable Oculus achievements and 10 custom animated items for your Oculus Home. Can you get them all?", "short_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in VR on the Rift and Quest, rather than crappy old Flash. Guide Hanna through 10 bonkers levels each with hidden secrets and achievements."}]}, "developer_name": null, "developer_privacy_policy_url": "http://deeperbeige.com/files/PrivacyPolicy_TOS.pdf", "developer_terms_of_service_url": "https://deeperbeige.com/files/PrivacyPolicy_TOS.pdf", "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/1370/hanna-in-a-choppa-3/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1008187520047517"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1051263312097321"}]}, "baseline_offer": {"id": "1051263312097321"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1639526400, "status": "PUBLISHED", "id": "1051263312097321"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5259562167414055", "version": "1.9.4"}, "id": "1061582857658606", "channel_name": "
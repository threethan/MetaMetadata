ng", "id": "371799531081111", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974899_371799534414444_3518279594274834273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8LKTEucI78Q7kNvwEF9-h-&_nc_oc=Admz-vtCOhcS0lvIEEhH97cZFGP6WHbsU8nFA3DyHrSaRlT01mRaqmYhDop-O6INXrg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ85OBuygItLC4VolmSaTK5rvu5SA86EniIupdDDUPOw&oe=69AAC9BF"}, {"file_name": "Screenshot01.png", "id": "566940431317298", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974471_566940434650631_1170701606254287921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-54HbzRcmy8Q7kNvwF--gAu&_nc_oc=Adl3tJdl3Cvju8AtvYU-qDFg426S8vSQ7HQuF9Y7hXrnBkBBE8rd3MXuYtZVCMldjJY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3wFKHM32WvoCEVTz4Kt3LgHnC9e41RB41IrJACuJvRQ&oe=69AAC0A8"}, {"file_name": "Screenshot04.png", "id": "877282366505981", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974503_877282369839314_2263831993236563872_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7dobAFmgpIQ7kNvwHe2GUE&_nc_oc=AdlUovFun1gLEd72Ido71uf8u7oVSCc6BcOAEAw6z_JvVlfMNOiZW-MmPyk-g5KQs0s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHePaPqpcKCWxrY9HRv7OizrqSJdnHYDEukSWg91aeLA&oe=69AABACE"}, {"file_name": "Screenshot02.png", "id": "324545289451118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001675_324545296117784_2246586455378850939_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buB_mHIsAXUQ7kNvwFkqWc9&_nc_oc=AdkkOlkJ2C_k50kwigCm3cHsC39o9Tt1ZzJyAXyQ8cVch0D_LP4cVBSvmmxm_C_Yy3g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYf2u8bVBQ_2zvdNecVZyBAbgH-5ixsrJipH5Lg9UsmA&oe=69AAB028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HannaInAChoppa-Landscape-2560x1440.png", "id": "297115872440120", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75363513_297115875773453_8263906783981114905_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXwd4-pt9QsQ7kNvwEAS5q6&_nc_oc=AdmeJt-ODHzBJ_B-elgz4NL1kvfeVbVvV9DLD2zBwQqYgHxTkpE41Cx_oYgALFfy_V4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeciN4qU87SJO78bxO_cB4Xtww4jEMuCNVRyGjHse4HQ&oe=69AACE61"}, "display_name": "Hanna in a Choppa 3", "keywords": [], "long_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in fabulous 3D VR on the Rift and Quest, rather than crappy old 2D Flash. Guide Hanna through 10 bonkers levels, each with hidden secrets and achievements. Train your pet elephant Stompy, steal honey from pesky bees, humiliate upgraded OXOBot at his own game, and of course, The Button makes a spectacular return.\n\nJoin the Discord: https://discord.gg/VmA5fWPryw\n\nAs authentic to the original as possible! This game is a labour of love while also extending the core concept wildly. It's also very, very orange!\n\nIncludes over 60 unlockable Oculus achievements and 10 custom animated items for your Oculus Home. Can you get them all?", "short_description": "Take flight in the latest instalment of the hugely popular Hanna in a Choppa series of games. This time, in VR on the Rift and Quest, rather than crappy old Flash. Guide Hanna through 10 bonkers levels each with hidden secrets and achievements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dropbox.com/scl/fi/k7bxbiereh7x0liq094u1/PrivacyPolicy_TOS.pdf?rlkey=g3v0s8py80d7hzxpnfnjth0uk&dl=0", "developer_terms_of_service_url": null, "publisher_name": "Deeperbeige Games", "support_website_url": null, "website_url": "https://deeperbeige.com/1370/hanna-in-a-choppa-3/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION"], "has_in_app_ads": null, "in
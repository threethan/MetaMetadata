_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNCpQYqtOQUQ7kNvwEqx2Kr&_nc_oc=Adol1bfj8AcKWXMpSrrtAzsjrulTwTJYqLkHGyP3G0U2gOSme5oVE35aMF7kO0yuTUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfGCSBfnMjp-TNwfTSvj4jIjH3hWLQ6SIjSt5ofHH_WA&oe=6AFDB50E"}]}, "id": "1620504676131597", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "1444382780906196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1444382784239529_3082429344027084534_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYezjznCLXkQ7kNvwEAczoC&_nc_oc=AdqnMH84yXy2aVEcqkL2_DHvpgvMXj4NXGT6X3pW4bi_pklhPUT46e8AYJSlmj3TW6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqrsWWXrOhedqRP1P9Hi47jv437L5T94UGxLm5ODeEzw&oe=6AFDBBE5"}, {"file_name": "screenshot_2.png", "id": "1590635456174164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673819499_1590635462840830_2574657858817641448_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk-DY7rzigQQ7kNvwFrgLBv&_nc_oc=AdoW30ZMD_41-ROjbBE131JLSTDd1D_tmaYWjK7c9EiohsJb54oSL-CtLdR6ZqlvcTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX82XRxO8lCdo0_Gl3PD1K8eCIjx8yJ1Xs-l3inSgG1g&oe=6AFDD236"}, {"file_name": "screenshot_3.png", "id": "1337245928296272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_1337245931629605_2334069628163384898_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9L0z8v2IyIQ7kNvwHqC170&_nc_oc=AdqnEIt62mFig_7GcfWvHmCVV_tYnkwJ3L3VRZytf3m_Dqkw600OdVESPLMr_13BgGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0k-xpJeVyQ4VEa9wr_iCJQt7eYMSoIBnD23paEyKG0Q&oe=6AFDC529"}, {"file_name": "screenshot_4.png", "id": "1569037927799208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/793139181_1569037931132541_4978153788187336879_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db5fnVAJS8cQ7kNvwFVXRZA&_nc_oc=Adru451HGEsjJJNtjD_sB0RGIGIIY26tfFOTU5YcM8vtt8c3HaxHoyEwGzjIheFHwbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj_OFsOA6wzJ06P6TTFONEUVkMDdz371ckaCwR9GYTvA&oe=6AFDCF5D"}, {"file_name": "screenshot_5.png", "id": "4638516253050285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673819499_4638516256383618_3071394885146304215_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1LEGDSVWM0Q7kNvwGZLA29&_nc_oc=AdqK0pS3WZjCjF4TOzuDGcKkw1ZZty65BY79Ir0Em7porDQiLBpUKhnJxHYEBDdS7KY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2ad6IC09OKlj-HJfDAvdccEE4FvK43nrt6MTpEZfRTA&oe=6AFDC6AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1269803931943714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_1269803935277047_7297995222214305993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM_XtbvVbiUQ7kNvwGIxiXW&_nc_oc=Adp2EabNhf6bVv3_S--oALp7mOCYcCkbXJvo6q3bpM6tyD2Ybc16etKO4zPEjoq6clY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoyLs3k7XQN-5mMwjab_qzFGkTeF4Vr1SpVwOjj6hA1w&oe=6AFDC710"}, "display_name": "SIMS LIFE VR", "keywords": ["life", "simulation", "family", "dollhouse", "sandbox"], "long_description": "Your family. Your street. Your call.\n\nA LIVING DOLLHOUSE\nLook down on your home with the roof lifted off. Dan, Maya, Lily and Max each have six needs: hunger, energy, hygiene, bladder, fun and social. Leave them alone and they look after themselves. Point your laser at anyone and tell them what to do: cook dinner, take a shower, watch TV, play chess, tend the garden, go to bed.\n\nSTEP INSIDE\nPress A and you are standing in the room at life size. Walk the house, sit with the family on the sofa, then step back out and tower over the street again. Grab a family member with GRIP and set them down anywhere.\n\nA WHOLE NEIGHBOURHOOD\nSix neighbour homes you can walk into, each with people living their own lives. Neighbours ring the bell, come over to visit and turn up for your parties. There is a park with a playground and a duck pond, a corner cafe, Joe's Garage with a car up on the lift, and traffic that stops at the crossing.\n\nWORK, SCHOOL AND MONEY\nJobs and school on weekdays, promotions, bills on Mondays and Thursdays, and pizza delivered to your door. Spend what they earn on new furniture and place it yourself.\n\nSKILLS, FRIENDS AND GOALS\nCooking, charisma, logic, gardening and painting grow as they use them, and paintings sell. Friendships rise with every chat. Twelve family goals pay cash rewards.\n\nDAY, NIGHT AND WEATHER\nThe sun crosses the sky, lamps come on at dusk and rainy days keep everyone indoors. Pause, play or fast-forward time from the home board.", "short_description": "A life sim built for VR. Stand over a living dollhouse as a giant and guide a family of four through their days, then step inside at life size and sit on the sofa with them. Cook, work, go to school, make friends, throw parties and grow skills on a whole street of neighbours, with a park, a duck pond, a corner cafe and Joe's Garage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/simslifevr/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/simslifevr/", "website_url": "https://citiview-games.pages.dev/simslifevr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345086835350846"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1375681808958015", "version": "1.1.0"}, "id": "1690234119341115", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345086832017513", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375681808958015"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1690234119341115"}]}, "change_log": "v1.1.0 - Big update: Sandbox Mode (unlimited money, build anywhere, set time and weather), buy mode fixed (items place every time, red preview + tips), flicker fixes across the whole neighbourhood, smoother frame rate.", "created_date": 1791735310, "id": "1375681808958015", "version": "1.1.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345086832017513", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1375681808958015"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1690234119341115"}]}, "change_log": "v1.0.0 - initial release.", "c
-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_391894672683477_903014125314048632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwnUL6QRfucQ7kNvwFQUtlY&_nc_oc=AdrgMyDv6ERe2jfua0gfiNjfjxlzfZZs9sze0vM-4uaFkQOyxbdgzV4Vd0rf7dG1TTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dx-YIY3TB4QZp9Ap9Tk7CLts1aC6m3j45YX4_BUEt0Q&oe=69DA3657"}, {"file_name": "38974526_330851525456671_7561793300223101704_n.png", "id": "2052779591550206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974844_2052779594883539_4267777520052577176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d7HMzTNv0cQ7kNvwHZEgQU&_nc_oc=Adq3mrMmv4vyxC9czeyKbVUIeTEf_xBxPhL3trV2YgR512jjfBWbWUYLVV68_H4eyEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VKTH1VFtcdhVp8LjV5AtC3L8Z7n9l_mAjHV1e7k3UNQ&oe=69DA2F8D"}, {"file_name": "38974526_225199582807726_7051625197716887568_n.png", "id": "4149070141861064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982552_4149070151861063_4620441470341218714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CivSdkPnT84Q7kNvwH-v8uL&_nc_oc=AdqsU1RhdxvL7XitHfcR4zme1AL9AkK0HwU1rqxlz3zU1goDLe8-YM6KnFU44gvzSyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pz6ldG6BI6WhzSEwa3KBI5Fae5gQTmZ7mLj6haA2Leg&oe=69DA4EA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Island Time", "keywords": [], "long_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality.\n\nFeatures:\n\u2013 Survive\u2026 Until You Die\n\u2013 Play standing In A Room-scale VR Experience\n\u2013 Craft tools, like a spear, from the island\u2019s resources\n\u2013 Use your tools to catch fish, defend yourself\u2026 and do stuff, like, not die\n\u2013 Befriend (or not) the island\u2019s wildlife including sharks and pesky seagulls\n\u2013 Foster a lifelong friendship with a crab. And, by lifelong, we mean a week at th", "short_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "https://www.flightschoolstudio.com/island-time-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://islandtimevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25818330824526055"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_652539472678193_1602126071920558352_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-El0mArh6X8Q7kNvwH2PRBT&_nc_oc=AdpaG-9ZjW5kBUPc9Ebm20OKiEkqV9TJCOOICGk82
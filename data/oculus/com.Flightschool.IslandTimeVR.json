cdn.com&oh=00_AfsNc4Jx66xi37G9QAy8GCl9JDCMQULp_SFOYWFI8OctRw&oe=699D8A8D"}, {"file_name": "38974526_225199582807726_7051625197716887568_n.png", "id": "4149070141861064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_4149070151861063_4620441470341218714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2As3InGknwUQ7kNvwFdQjYY&_nc_oc=Adk_jRoGwnifN1djsS8ZHqLBgd56-JH5Go9opucj2FfjM5hUeIalF627NFlevXoX3Nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4LdTYIbtXGyu-Aa-y0I7JtnYIsI-Vb1EGfaa9AN4XDg&oe=699DA9A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Island Time", "keywords": [], "long_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality.\n\nFeatures:\n\u2013 Survive\u2026 Until You Die\n\u2013 Play standing In A Room-scale VR Experience\n\u2013 Craft tools, like a spear, from the island\u2019s resources\n\u2013 Use your tools to catch fish, defend yourself\u2026 and do stuff, like, not die\n\u2013 Befriend (or not) the island\u2019s wildlife including sharks and pesky seagulls\n\u2013 Foster a lifelong friendship with a crab. And, by lifelong, we mean a week at th", "short_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "http://islandtimevr.com/privacypol
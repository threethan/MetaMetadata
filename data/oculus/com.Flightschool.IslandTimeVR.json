-dfw6-1.oculuscdn.com/v/t64.5771-25/38974854_391894672683477_903014125314048632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odPPHD9I-F0Q7kNvwGKs02U&_nc_oc=AdrgGTXFkOhbmjCG9bln8RCo_6V_c7w6p_w83o_9QCoOUN2mYfzWVTJkN7aYPiN7g6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AWMWv0vq6Z5xg3lB_09ZIfRJmrMWXpLE_hj3bSEJUuw&oe=69F342D7"}, {"file_name": "38974526_330851525456671_7561793300223101704_n.png", "id": "2052779591550206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974844_2052779594883539_4267777520052577176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Cpxkod662YQ7kNvwG8Or18&_nc_oc=AdpXk41ZcjVC0oF6yGOq_rTzoqQx6dMVwAAk31GmiBrzvSdjJZFHI0mN4RTtnp8Yvgg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XQEsVTWWb26OMbAf0sEMQq-kiHaKEF7WuZSj891lhbA&oe=69F3744D"}, {"file_name": "38974526_225199582807726_7051625197716887568_n.png", "id": "4149070141861064", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982552_4149070151861063_4620441470341218714_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6J63fdpTd8Q7kNvwEmQUe-&_nc_oc=AdohF3KjebsZawlOQTc8I8yg2HYDWf7posd-Hx5bhGvor7UksxI8LbvuElAYfrVB-Ek&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iTW1JEoNpXnvcGMtFp40lxK_yeVB2XCLipfsPLQFZ4g&oe=69F35B25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Island Time", "keywords": [], "long_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality.\n\nFeatures:\n\u2013 Survive\u2026 Until You Die\n\u2013 Play standing In A Room-scale VR Experience\n\u2013 Craft tools, like a spear, from the island\u2019s resources\n\u2013 Use your tools to catch fish, defend yourself\u2026 and do stuff, like, not die\n\u2013 Befriend (or not) the island\u2019s wildlife including sharks and pesky seagulls\n\u2013 Foster a lifelong friendship with a crab. And, by lifelong, we mean a week at th", "short_description": "After a journey at sea, you are shipwrecked on a tiny island. Using your wit, ingenuity and the advice of Carl the Crab, you must find a way to keep yourself from starving and survive. Craft tools, fend off creatures\u2026Or you could just give up and die? Just enjoy the sunset while you can. Almost makes you forget that you're in a desperate struggle against your own mortality."}]}, "developer_name": "Flight School Studio", "developer_privacy_policy_url": "https://www.flightschoolstudio.com/island-time-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Flight School Studio", "support_website_url": null, "website_url": "https://islandtimevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25818330824526055"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974523_652539472678193_1602126071920558352_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnIiMn3qrhMQ7kNvwEWyW7f&_nc_oc=AdqCMj9jDlv81Bg-MCOgMshi7j6AnqXkm-WF6eXuH
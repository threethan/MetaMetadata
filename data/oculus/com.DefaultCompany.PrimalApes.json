AE"}, "display_name": "Primal Apes", "keywords": [], "long_description": "Primal Apes is an exhilarating indoor game inspired by the popular Gorilla Tag, offering a dynamic and immersive experience within a state-of-the-art facility\n\nIn summary, Primal Apes offers a fun and engaging gaming experience inspired by Gorilla Tag, with a variety of game modes, including horror-themed challenges, and a lively player community, all set within an innovative indoor facility. Jump in now to explore the thrilling world of Primal Apes and see what adventures await!", "short_description": "Primal Apes Is a Gorilla Tag inspired game that has many game-modes, and more to come play for a fun experience and a active player base!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primal-apes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ape Horror Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/primal-apes/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26597755199811562"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974669_1504313316880479_5726095663119612441_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qsr4Om_EFcQ7kNvwGihkLh&_nc_oc=Adot1g6Ijc9AazhvTHe50Ns25_i8_Sa7mKu6M1AVOjsK6YQo9RdAK
_nc_ohc=Yb4dXh8PC2AQ7kNvwHhj_SH&_nc_oc=AdrZuDKNaPw-auTLXHGHkHdxgN7H_9ybOWaE0czLu-2ar1mI_9CR-7YZf-pzFaXyBRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SCzwZfhNV03XoJJmAG1Dlg1PM3yvFEsWOikWJULrbLg&oe=6A2ABBD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v7.png", "id": "960133216617913", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499302848_960133219951246_7897421966929237185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkTQxqnlwAsQ7kNvwGkiOAY&_nc_oc=Adri5tyU4rXC5HnCi5K1bNNih68U-HaZ2Adoj_SxXJeamD7RmULkJ87klMsIU1x8WgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wV9RBOWEZ7HAUEJmiJhp-x346CNnz2vwae4mis-uVHw&oe=6A2AB665"}, "display_name": "RealityGuard", "keywords": ["mixedreality", "roomdefense", "coop", "magic", "towerdefense"], "long_description": "**Turn your room into a fantasy battlefield.**\n\n**RealityGuard is a co-op mixed reality defense game where your real space becomes part of the fight.** Build magical towers on real furniture, shape enemy paths around your room, cast spells with your own hands, and defend your home from waves of fantasy invaders.\n\n**Play solo, team up online, fight side by side in local co-op, or challenge other players in PVP mode.** You are not just watching towers do the work. Freeze enemies, trigger special tower weapons, and jump into the action when your defenses are about to fall.\n\n{2043774679907302}\n\n- **Defend Your Real Room**\n\nTurn tables, sofas, floors, and walls into the battlefield.\n\n{981668424460238}\n\n- **Online & Local Co-op**\n\nBuild, shoot, cast, and survive with friends online or in the same physical space.\n\n- **Cast Spells and Fight Back**\n\nFreeze enemies, blast waves, trigger traps, and fight directly.\n\n{1354065929906380}\n\n\n- **Build Powerful Defenses**\n\nUnlock towers, cards, upgrades, and abilities to create new strategies.\n\n- **Challenge and Endless Modes**\n\nTake on story levels, events, weather, traps, combat bonuses, and endless waves. Climb the global leaderboards and earn rewards.\n\n\nRealityGuard is in Early Access. Join our Discord to share feedback and help shape the game.\n\nWebsite: https://www.realityguardar.com\n\nDiscord: https://discord.com/invite/jNmnz9PdVW\n\nYouTube: https://www.youtube.com/@RealityGuard_Official\n\nTikTok: https://www.tiktok.com/@realityguard\n\n\n\n", "short_description": "Turn your room into a fantasy battlefield.\n\nRealityGuard is a co-op mixed reality defense game where your real space becomes part of the fight. Play solo or team up with friends online or in the same room. Build magical towers on real furniture, cast spells with your hands, and survive waves of fantasy enemies invading your home."}]}, "developer_name": "DeepMirror", "developer_privacy_policy_url": "https://www.realityguardar.com/privacy", "developer_terms_of_service_url": "https://www.realityguardar.com/terms", "publisher_name": "DeepMirror", "support_website_url": "https://www.realityguardar.com/accounts", "website_url": "https://www.realityguardar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26683201498042040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626172_1014732757549592_411
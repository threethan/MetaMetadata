0V3cluzsxznS9S5oP5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wuAy3406OqTYFyWqsJQcEkzX4YFVRHunvqztvLO6fYA&oe=6A450804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440_ver2.png", "id": "8873886676068159", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303377_8873886679401492_4983181442950929829_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LayjFf_HQpkQ7kNvwF6dV7b&_nc_oc=AdpfEquiCx4foVSM7fX81EXqT9qGOTusGUsxXoAB0maCDy0S2_ah_naFonb70qR0j0Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gA1IMLsGrjCjhxA0NzQGSLC19f5asP-54QlrNY1bTrA&oe=6A45012B"}, "display_name": "RealityGuard", "keywords": ["Strategy", "TowerDefense", "CastleDefense", "Fantasy", "TowerWars"], "long_description": "RealityGuard is **a mixed-reality tower defense game** augmented by your physical surrounding environment. Join forces **with your friends** to **build terrain** with real objects around you, **set up defenses**, **cast spells**, and work together to **ward off enemy invasions**.\n\n{1209287737895270}\n\n- **Real-World Battlefield:** Strategically arrange the furniture in your room to create a customized battlefield in reality.\n\n{1502567324268314}\n- **Local Co-op:** Defend the world together with friends in the same space.\n\n{2956898677815985}\n- **Upgrade & Abilities:** Collect defense towers and unlock unique upgrade paths with special skills.  \n\n--\n\n**RealityGuard** also offers many surprising experiences, including:  \n- Legendary story of heroes and experience unique weather, traps, and level events.\n- Utilize periodic combat bonuses in endless mode, build the ultimate formation, climb the global rankings, and pursue lucrative rewards.\n- Casting a variety of spells to engage directly in combat like a mage to master in your own space.\n\n--\n\n**Learn More**  \nFollow our official channels for the latest updates:\n- Website: https://www.realityguardar.com\n- YouTube: https://www.youtube.com/@RealityGuard_Official\n- Discord Community: https://discord.com/invite/jNmnz9PdVW\n- TikTok: https://www.tiktok.com/@realityguard\n- X (formerly Twitter): https://x.com/realityguard\n- Instagram: https://www.instagram.com/realityguard_official/\n- Bilibili: https://space.bilibili.com/3546604550228346\n", "short_description": "RealityGuard is a mixed-reality tower defense game augmented by your physical surrounding environment. Join forces with your friends to build terrain with real objects around you, set up defenses, cast spells, and work together to ward off enemy invasions."}]}, "developer_name": "DeepMirror", "developer_privacy_policy_url": "https://www.realityguardar.com/privacy", "developer_terms_of_service_url": "https://www.realityguardar.com/terms", "publisher_name": "DeepMirror", "support_website_url": "https://www.realityguardar.com/accounts", "website_url": "https://www.realityguardar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1700921480735423"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24530063036689241"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1327985662619079"}, {"status": "PUBLISHED", "id": "1714817879645732"}, {"status": "PUBLISHED", "id": "833940173077733"}, {"status": "PUBLISHED", "id": "1611631746650782"}, {"status": "PUBLISHED", "id": "1117970600318
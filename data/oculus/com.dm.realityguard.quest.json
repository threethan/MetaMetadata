e": "\u6cd5\u6756-2.png", "id": "1686839618673582", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827786_1686839622006915_2727832190524749356_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wttvA5Ff3TMQ7kNvwFJ4D9r&_nc_oc=AdqfA2ZCbqAOry7rw-IaFybj88hYFi_q0bmL_WwOFYue5mrAPzj96hq8pMX3UTeTKyE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNQYJNXXZ07qfzvHrzLsmmOXHWc1wVVM6RQn69J9qmHw&oe=6AFB2F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440_ver2.png", "id": "8873886676068159", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303377_8873886679401492_4983181442950929829_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22iOATcT2gYQ7kNvwHLteHc&_nc_oc=Adr0QrPknjPN09zHsZNIVo9H_V-qic0D4rhgkzn9BpKLuE4OqL5rzOVJu5b4g11RqRc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnJ01-aRu_P3tCLr4NAt4TfA9eCrMctrDfI1P1RBXb_A&oe=6AFB286B"}, "display_name": "RealityGuard", "keywords": ["Strategy", "TowerDefense", "CastleDefense", "Fantasy", "TowerWars"], "long_description": "RealityGuard is **a mixed-reality tower defense game** augmented by your physical surrounding environment. Join forces **with your friends** to **build terrain** with real objects around you, **set up defenses**, **cast spells**, and work together to **ward off enemy invasions**.\n\n{1209287737895270}\n\n- **Real-World Battlefield:** Strategically arrange the furniture in your room to create a customized battlefield in reality.\n\n{1502567324268314}\n- **Local Co-op:** Defend the world together with friends in the same space.\n\n{2956898677815985}\n- **Upgrade & Abilities:** Collect defense towers and unlock unique upgrade paths with special skills.  \n\n--\n\n**RealityGuard** also offers many surprising experiences, including:  \n- Legendary story of heroes and experience unique weather, traps, and level events.\n- Utilize periodic combat bonuses in endless mode, build the ultimate formation, climb the global rankings, and pursue lucrative rewards.\n- Casting a variety of spells to engage directly in combat like a mage to master in your own space.\n\n--\n\n**Learn More**  \nFollow our official channels for the latest updates:\n- Website: https://www.realityguardar.com\n- YouTube: https://www.youtube.com/@RealityGuard_Official\n- Discord Community: https://discord.com/invite/jNmnz9PdVW\n- TikTok: https://www.tiktok.com/@realityguard\n- X (formerly Twitter): https://x.com/realityguard\n- Instagram: https://www.instagram.com/realityguard_official/\n- Bilibili: https://space.bilibili.com/3546604550228346\n", "short_description": "RealityGuard is a mixed-reality tower defense game augmented by your physical surrounding environment. Join forces with your friends to build terrain with real objects around you, set up defenses, cast spells, and work together to ward off enemy invasions."}]}, "developer_name": "DeepMirror", "developer_privacy_policy_url": "https://www.realityguardar.com/privacy", "developer_terms_of_service_url": "https://www.realityguardar.com/terms", "publisher_name": "DeepMirror", "support_website_url": "https://www.realityguardar.com/accounts", "website_url": "https://www.realityguardar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1700921480735423"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE
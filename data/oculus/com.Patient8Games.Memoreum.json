1888_503803602539697_582146855287224911_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi_sGN0YxA0Q7kNvwFali7D&_nc_oc=Adq45gwwsAqUYmVAV3392imJNI0dWd4PZkrRfwf5mgPQHqwUKA63cKZr9LJ2XuV4zMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gpEvBAxXd4BaCiolMzoux93MUlZZhZjENIcNJ8QP2pg&oe=69EF7DA9"}, {"file_name": "JunctionTunnel.png", "id": "1734180880478199", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391911_1734180883811532_322467256012116166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1yYaB6YN-4Q7kNvwEjOU3M&_nc_oc=AdqDeHnD_NtWTIOuNZ9ZSRjzPlvfPAduGrfK4kLEcgI5w9jhrNEX-NowFktXiwrWL5Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MB_-39P7_P7r6DZdkEx8z5wI27R88K3bfMpAM8qrlzg&oe=69EF52DF"}, {"file_name": "Tools.png", "id": "1286445899092559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_1286445902425892_8843259262414669717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4EY5-aEpbMQ7kNvwH8hnBh&_nc_oc=Adp8jQsxHphIPNR7rfSRC6hIQQQftFFs9SfUaF5lMBXyuLec2hx-eMMcezcVXdHsxDY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zHaZ8KQ2intK4yKYM8ia_Tclxl6GGf0bGqwMHNevOiA&oe=69EF7BA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEMOREUM", "keywords": ["scifi", "horror", "shooter", "Memoriam", "narrative"], "long_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality.\n\n{1387549889074762}\n\n# UNRAVEL THE MYSTERY ABOARD THE CENTURY DAWN\nThe year is 2311. Ripped from your stasis pod, you find a very different ship from the one you left behind. The inhabitants have lost any shred of humanity, and your only hope comes from a scrambled voice, guiding you through the darkness. Is this reality, or just another symptom?\n\n{1172087357760068}\n\n# FIGHT FOR YOUR LIFE\nTake up arms against those you swore an oath to save, build an arsenal of unique and powerful weapons to face the monstrosities of the Ichor Infection, and scavenge what you can to survive. But as you adapt, the infected will do the same\u2026\n\n{1577370656298360}\n\n# FROM THE TEAM BEHIND RETURN TO RAPTURE\nWork on **MEMOREUM** began 4 years ago, after the success of Patient 8 Games\u2019 hit Half-Life: Alyx mod, **Return To Rapture**. Inspired by sci-fi survival classics, **MEMOREUM** is a world that bends reality in ways only VR can deliver.\n\n\n", "short_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patient8games.com/patient-8-games-llc-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://patient8games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9135633773222287"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "2579143932470235"}, {"status": "PUBLISHED", "id": "1131115695619892"}, {"status
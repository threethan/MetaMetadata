48523_6764360121555720457_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPAG2PXXwIwQ7kNvwFWKIhO&_nc_oc=Adou6oQHv9o5ruFDMe_MV1eVUIk8jxLll2fI4H-mfcsYqGYnTedHL4MwrI4-wRTD2kI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nz7ENDsdHFUAkTvTSvyjrNZi5zxrYJ6bl_keSdbzXOg&oe=69EF5CEF"}, {"file_name": "Machano Corridor NEW Final.png", "id": "1282100396425195", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824328_1282100399758528_83948302049938470_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyqcOIk7Z0EQ7kNvwHQ9Pi8&_nc_oc=AdpRfzXzwicxkU6RZf567uAMfXTM8vnVNKckOvLi8T-vmAqGn6E12hJ3B3jfQhC9pMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PYa1vrE0siQ64RYgneyk8sM7tea7xQl8QpeEVI-7eIw&oe=69EF8042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail2.png", "id": "1894912327810504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1894912331143837_302306441627888933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRgd_R3g1_kQ7kNvwERiIHf&_nc_oc=Ado3_sDLr-9L1WO5XDCNXpl98qGn_OslMnmLSUA4_mrJm9_MbxZn_Rp3WX8LvqlzO6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pTbUkfhl3jK-KvxIPADpxD5FCtVMKXMIhES9RTwYwbQ&oe=69EF758D"}, "display_name": "MEMOREUM", "keywords": ["scifi", "horror", "shooter", "Memoriam", "narrative"], "long_description": "**\u201cBest VR Narrative Game 2025\u201d** - The VRVerse Podcast\n\n**\"The Best VR Horror Game of 2025!\"** - Beardo Benjo\n\n**\u201cMeta Quest Game of the Year\u201d** - CrossButtonVR\n\n**\u201cDead Space Meets Doom!\u201d** - Gamertag VR\n\n**MEMOREUM** is an **10-12 hour action horror adventure**. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality.\n\n{1387549889074762}\n\n# EXPERIENCE THE AWARD WINNING STORY\nThe year is 2311. Ripped from your stasis pod, you find a very different ship from the one you left behind. The inhabitants have lost any shred of humanity, and your only hope comes from a scrambled voice, guiding you through the darkness. Is this reality, or just another symptom?\n\n{1172087357760068}\n\n# FIGHT FOR YOUR LIFE\nTake up arms against those you swore an oath to save, build an arsenal of unique and powerful weapons to face the monstrosities of the Ichor Infection, and scavenge what you can to survive. But as you adapt, the infected will do the same\u2026\n\n{1577370656298360}\n\n# FROM THE TEAM BEHIND RETURN TO RAPTURE\nWork on **MEMOREUM** began 4 years ago, after the success of Patient 8 Games\u2019 hit Half-Life: Alyx mod, **Return To Rapture**. Inspired by sci-fi survival classics, **MEMOREUM** is a world that bends reality in ways only VR can deliver.\n\n{995272148640204}\n\n# CHOOSE YOUR FATE\n**MEMOREUM**'s narrative features **3 different endings**. Where will you end up at the end of your journey?", "short_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patient8games.com/patient-8-games-llc-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://patient8games.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
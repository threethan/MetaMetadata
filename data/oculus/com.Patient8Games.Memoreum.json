le": "en_US", "screenshots": [{"file_name": "Matron.png", "id": "598990043125902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393325_598990046459235_2539549648658157995_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etDoCNT5ltcQ7kNvwGpi7e0&_nc_oc=AdrYea27eP9LtgWmlnBoc4qYIOt0BmeJHiCdJsK3diGAa3gC56rxo8RjycRXvNr0fmA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRywYAR4u9JeIytrNWx2M3wfu8QB9ipqgY-QUh2-qvwA&oe=6AAEAEFA"}, {"file_name": "MrWoods.png", "id": "1644441526196515", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391998_1644441529529848_2928094818833410365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZvnJlOBHioQ7kNvwEnfv3U&_nc_oc=AdqiLKEadrALSu2r1Ueda4iO3OJatb-V2Cy8-SSGSsKQSHJimwX7IGEYuB2KdP4_X-E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfX0R5hd17NbO5cBF19sq7HL_d2U68jg6dlwtdhPbUiQ&oe=6AAE863B"}, {"file_name": "Maintenance.png", "id": "503803595873031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391888_503803602539697_582146855287224911_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLdBido9kUwQ7kNvwFkfdv5&_nc_oc=AdqFdJx5m0Fj3GluLa0Fdi4b5Md7Pb_C5b0UgnR_UhLugXu_3D5TjnZRDZzzqoZHHj0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs1F4sr7F4QZn9NbxE3aoKNb0fMqkuCcC6_e5Jj-RXyw&oe=6AAEA729"}, {"file_name": "JunctionTunnel.png", "id": "1734180880478199", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391911_1734180883811532_322467256012116166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXeB4qzaSX4Q7kNvwGNPlEW&_nc_oc=AdqhSEPsfxFeJLqLSmLFDD163z7-L8FRyFfaGUs5X49vx2ApQbj9F4KGvr08D28c8uo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdRd9i5pwQR8KMQ7xI9ZImTVG7hetdllJfn6QABOSzSQ&oe=6AAEB49F"}, {"file_name": "Tools.png", "id": "1286445899092559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391959_1286445902425892_8843259262414669717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUMmqXqdu4QQ7kNvwEnNiXp&_nc_oc=AdrkVto4PMxUSDTc8RmYRaSQpwUrgMJu8Nh21eqknj_lY9ps-3P_x03toNdzDmOeC7Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9UVXBP1nDF7MocMzifsnYQoKr-gpOJewfkg6LTz0s_A&oe=6AAEA528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEMOREUM", "keywords": ["scifi", "horror", "shooter", "Memoriam", "narrative"], "long_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality.\n\n{1387549889074762}\n\n# UNRAVEL THE MYSTERY ABOARD THE CENTURY DAWN\nThe year is 2311. Ripped from your stasis pod, you find a very different ship from the one you left behind. The inhabitants have lost any shred of humanity, and your only hope comes from a scrambled voice, guiding you through the darkness. Is this reality, or just another symptom?\n\n{1172087357760068}\n\n# FIGHT FOR YOUR LIFE\nTake up arms against those you swore an oath to save, build an arsenal of unique and powerful weapons to face the monstrosities of the Ichor Infection, and scavenge what you can to survive. But as you adapt, the infected will do the same\u2026\n\n{1577370656298360}\n\n# FROM THE TEAM BEHIND RETURN TO RAPTURE\nWork on **MEMOREUM** began 4 years ago, after the success of Patient 8 Games\u2019 hit Half-Life: Alyx mod, **Return To Rapture**. Inspired by sci-fi survival classics, **MEMOREUM** is a world that bends reality in ways only VR can deliver.\n\n\n", "short_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patient8games.com/patient-8-games-llc-privacy-policy/", "developer_terms_of_servic
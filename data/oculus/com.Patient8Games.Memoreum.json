dn.com&_nc_ss=7f20f&oh=00_AQTR8p06P6CPmfRNp8tPhXuMy1DC02_KSKDY4t5l7XcFjg&oe=6AFDCE9F"}, {"file_name": "Tools.png", "id": "1286445899092559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_1286445902425892_8843259262414669717_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWBcwQ8Rl2gQ7kNvwHfQneZ&_nc_oc=Adrl44nKsGTPvHQYsHUZ_kPqz4M9aPI7juH4LTPDCdONkz7ipcA0k2tPLhgoW95Nk20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyoj2dsaPb50a62KsH3y52397QHDBsA1bBhRJwX4tsrw&oe=6AFDBF28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEMOREUM", "keywords": ["scifi", "horror", "shooter", "Memoriam", "narrative"], "long_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality.\n\n{1387549889074762}\n\n# UNRAVEL THE MYSTERY ABOARD THE CENTURY DAWN\nThe year is 2311. Ripped from your stasis pod, you find a very different ship from the one you left behind. The inhabitants have lost any shred of humanity, and your only hope comes from a scrambled voice, guiding you through the darkness. Is this reality, or just another symptom?\n\n{1172087357760068}\n\n# FIGHT FOR YOUR LIFE\nTake up arms against those you swore an oath to save, build an arsenal of unique and powerful weapons to face the monstrosities of the Ichor Infection, and scavenge what you can to survive. But as you adapt, the infected will do the same\u2026\n\n{1577370656298360}\n\n# FROM THE TEAM BEHIND RETURN TO RAPTURE\nWork on **MEMOREUM** began 4 years ago, after the success of Patient 8 Games\u2019 hit Half-Life: Alyx mod, **Return To Rapture**. Inspired by sci-fi survival classics, **MEMOREUM** is a world that bends reality in ways only VR can deliver.\n\n\n", "short_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patient8games.com/patient-8-games-llc-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://patient8games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9135633773222287"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "2579143932470235"}, {"status": "PUBLISHED", "id": "1131115695619892"}, {"status": "PENDING", "id": "1149623807016493"}, {"status": "PENDING", "id": "635942589198692"}, {"status": "PUBLISHED", "id": "24243764481907362"}, {"status": "PUBLISHED", "id": "1912070786307241"}, {"status": "PUBLISHED", "id": "1801111597821752"}, {"status": "PUBLISHED", "id": "2495706760939680"}, {"status": "PUBLISHED", "id": "2101379697437286"}, {"status": "PUBLISHED", "id": "1081354308170192"}, {"status": "PUBLISHED", "id": "1504518577669093"}, {"status": "PUBLISHED", "id": "26898196706550150"}, {"status": "PUBLISHED", "id": "1511468710506822"}, {"status": "PUBLISHED", "id": "960180763394332"}, {"status": "PUBLISHED", "id": "1476989903855
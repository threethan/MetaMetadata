le": "en_US", "screenshots": [{"file_name": "Matron.png", "id": "598990043125902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393325_598990046459235_2539549648658157995_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGEGj3TYXqAQ7kNvwHwR3dr&_nc_oc=Adq50UVKp_Q52Tjy68lVkzhnfq6juZG8nMdamr_zxWXIKCnkou9H-cAoGUAinT8ckzM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6LvsXKGpLGwrxMe2LY44mXzvfine0iEyOvC6hcsNu6Q&oe=6AA968FA"}, {"file_name": "MrWoods.png", "id": "1644441526196515", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391998_1644441529529848_2928094818833410365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtOTcaK3hPAQ7kNvwEtrRH9&_nc_oc=AdroG3CPwoT0T9-SV9jlEmITbjELBeDMhWVlDtoozRJQuCmS6aSXmYmTu2MRbNVhkyM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnsZwg7TMuXmatuQ3uKcD4H_1OjKwgPRY9ltBDA4vSnQ&oe=6AA9403B"}, {"file_name": "Maintenance.png", "id": "503803595873031", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391888_503803602539697_582146855287224911_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaMO3REQlVkQ7kNvwHHmj5n&_nc_oc=Ado8PjqyL_PguO30TMzo7pzOYp0PHl1myTLMoKW14-plDnUHgyM0pRsm8L75vqC1RkU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMjRK4a_hBaA4mrOGX33VDCVbRA9z0c022TakzwdhD0w&oe=6AA96129"}, {"file_name": "JunctionTunnel.png", "id": "1734180880478199", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391911_1734180883811532_322467256012116166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HcE1sdzJjQQ7kNvwFCiGhu&_nc_oc=Adp4nUOQebLAeWV_c-Jy4Qzt3w8Jp1Er8jx8K0W3i5neD5OFiMch-EnCyp1IH_L0ttg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqGTeYNu6-lctwYpMynqUtDfm9h0SPlWNDOSH8laZweg&oe=6AA9365F"}, {"file_name": "Tools.png", "id": "1286445899092559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391959_1286445902425892_8843259262414669717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_j0nCieNDkQ7kNvwEELsMp&_nc_oc=Adre_PmW-tHRUEXoMuMl9kUwmJUNHso8A0MyE6w1r1TclKEGYjLAiGnIml9vi2Wz_pY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVjX1saMQaoIFmUEfSjtTRdRWOunJQK5HrJaZRRuhoww&oe=6AA95F28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEMOREUM", "keywords": ["scifi", "horror", "shooter", "Memoriam", "narrative"], "long_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality.\n\n{1387549889074762}\n\n# UNRAVEL THE MYSTERY ABOARD THE CENTURY DAWN\nThe year is 2311. Ripped from your stasis pod, you find a very different ship from the one you left behind. The inhabitants have lost any shred of humanity, and your only hope comes from a scrambled voice, guiding you through the darkness. Is this reality, or just another symptom?\n\n{1172087357760068}\n\n# FIGHT FOR YOUR LIFE\nTake up arms against those you swore an oath to save, build an arsenal of unique and powerful weapons to face the monstrosities of the Ichor Infection, and scavenge what you can to survive. But as you adapt, the infected will do the same\u2026\n\n{1577370656298360}\n\n# FROM THE TEAM BEHIND RETURN TO RAPTURE\nWork on **MEMOREUM** began 4 years ago, after the success of Patient 8 Games\u2019 hit Half-Life: Alyx mod, **Return To Rapture**. Inspired by sci-fi survival classics, **MEMOREUM** is a world that bends reality in ways only VR can deliver.\n\n\n", "short_description": "**MEMOREUM** is a VR sci-fi action horror campaign. The Ichor Infection has taken over the last ship of humanity. You are Dr. Otto Hudson, fighting to unravel the mystery behind the outbreak as your fragmented mind slips from reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patient8games.com/patient-8-games-llc-privacy-policy/", "developer_terms_of_servic
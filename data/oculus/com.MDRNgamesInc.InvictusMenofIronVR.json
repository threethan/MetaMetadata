6hnIyxVjdBMCYZ866zb0gnxD6hzYTmuzJCocthqfhgjwhZQjSHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFj2iZpl-NA2w0_CDxxLb-KHmO8OmrM3KRyB0Nju26Gg&oe=69B55B07"}, {"file_name": "ScreenShot4.png", "id": "3702977489915515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974670_3702977493248848_1005083544870533286_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4q97lGbnqwQ7kNvwG_dEcS&_nc_oc=Adn2tCHewk2yXbYK4Q7ASgrvoGWxWGxIjer-JolTvCaU3LPGyt9peZnbuHyV6RJebrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo4HNwHntBy9C7WGMUTyJK8fdSsqHJX1--ra4_VPj1tg&oe=69B53F1D"}, {"file_name": "ScreenShot5.png", "id": "1017394309783931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569452_1017394313117264_5103681682275133887_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2SZ-rjapcEQ7kNvwHHd5lS&_nc_oc=AdlUXI4QHIhIDAvnLdJEWbiJontlyqQ7kJ7WM8HALdKrPR_-5GTCgVo_5nfGEZ5ioVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs3EsX2OWyR5DsAYVmkw-zF0u8hJTOwaep_2pRDB_qwA&oe=69B5510A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "Arena Style Multiplayer Hack and Slasher"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hauntnseek.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8123201997756862"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3778807339028924"}]}, "baseline_offer": {"id": "3778807339028924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731354300, "status": "PUBLISHED", "id": "3778807339028924"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25898574759792979", "version": "Alpha_2026"}, "id": "508643728502031", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8025591244184605", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25898574759792979"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjGMisMe0F8Q7kNvwGMgIZi&_nc_oc=Adlok80OldNdD09cJEhEie4bmC_bMI3tTwgxpJrXKfAVUCGr9sz3Q06aG1gHIakExF4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftY4ETflkxIkvbzI-lm8PLCaUeED-sLnogzm9neEgMmXA&oe=69A5704F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze0boaTuoBEQ7kNvwHSvCPq&_nc_oc=Adl4UJ62iSRl8rgpqRM55qScEq7wOKPUJCY4yklXJoNt-IgTPPGUrjJJheDydaEedZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv6kOs99iy_BXs1NqdAt6lcyTJ87vBZm9Pcr4eDxZ_wZQ&oe=69A59DB7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSltXasK3_sQ7kNvwHZDoCF&_nc_oc=AdkoeeeWqamwgDMrByalkiibCupTbpsHaWXJvkY_vTbtaxauagB962AiSLghKHjuacw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft6qSpwP7irkUCHZti5lKowy3UjkdCvmFox84-kC-Ig-g&oe=69A57E5B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtaH8z26bOoQ7kNvwH63nCh&_nc_oc=Adk2NRwaIvUn6qv8Qdnj0pTzjmiFhzaV2NZRqSrksFf82zmQ-UxUKNAJAS2XBZpTaiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftJ1N4HIaT6mHaOxhlQ8pUoSZunZ0Xe_b-mFJMrZ4UMCA&oe=69A59441"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TONqgQyCH-MQ7kNvwFTClb1&_nc_oc=AdnhzS9X44ECcRtvBgstzp1UoLBy3Kw0Drpq3tLTd-bQNlxZG0Hkr0dCJadX-DcP5U4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfucmZ9Ss3voWnwPMB8ixBEbSp9JFFnnLcYIgvmtFYxCIQ&oe=69A57D38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
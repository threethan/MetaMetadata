om/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5-k7HSeuEUQ7kNvwF1_sJq&_nc_oc=AdnJzIfecTedUSENaW8gBXOkpwzfIETPwwnrxD_57jcTs4vlVzdQSzVKSoYOGM-mtaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGEoPRWIoXGiETmnoi-O0kHYQjAwEruCNWBsIVgmwh9g&oe=69B14DCF"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCVRHI8JVT4Q7kNvwFRoEPN&_nc_oc=AdkexL1T_x4QKUJkScR_pcvf52j2yWCYku8FbWPY_h1y20Sa3BCXxy2uRCJZNdl50Hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhHQbaRp_3A6QC6IjmLjW6yxf3ovlATXZ4ao-pIl_BUw&oe=69B17B37"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGb_KTWIszAQ7kNvwENKTYt&_nc_oc=Adkz0aiOm9pxPZR--MbZ3ikfZJvw8YbNYIxOLAG62io7Sgg1DfX3bUE-aiCjKHAEQxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk13Z1d8-GwRlxEeJaTQII81gZ3_1uN-aYfIg0Y26-OA&oe=69B15BDB"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZbbofThiV8Q7kNvwG4olGs&_nc_oc=AdlFkDrfeFgKvTwuR9BrPhcsqsS2CLGU4pz-Q5XapADkXMb2AewClWw4eaAp_B-PNY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRwp1QotKCyBk3HDRCZPidN1Dkj0jdF07EckJ6gDG6eQ&oe=69B171C1"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hGBfcU3naIQ7kNvwEkbkqD&_nc_oc=AdmJ4i1Zo67dRCFTJMzV0ALAtIhn3v7sP7zuHpPckA5PEZo5bUmkzk2uUEBTY7r0gYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRUhTrfRCIZ19A7PYBqAwzLc89UMSfiPzJx6izkXw2tQ&oe=69B15AB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
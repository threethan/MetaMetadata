_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaf-v8_0htcQ7kNvwGL47yW&_nc_oc=AdnKMDLK_PD1O71GHGa6JDYbDF-CZOe2VdKWbZ8PsTS5TlIpzydnF5PTnfDYbAm4cHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsn4lQK3JbXzNTKTehif6Hiz3kX6Dn7_SJRooy2JorrcQ&oe=69A02A4F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo8MjnDjsBoQ7kNvwG6_or8&_nc_oc=Adn2mrMI0S49PLAvlDB-LtmbbdaFzBv1yqSeUFN26bHZ2Z1bgoVgfuqsdnoDD2naIFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRt5jWXZ4ZTl4SGmc2wjVSEGsY0tSI9j3mb3iNghvkIQ&oe=69A057B7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-f_HLJ1kbYQ7kNvwG4cMsz&_nc_oc=AdkObudI-vJv0x29Cn1y5c7EDPD_QBTal4yqmO5S-x-FC0BZ8yfhRhPrdAVW5frAowQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuf6yaVUIAKjZTNGeYsyZJDZjlXCIKms16WeuNVmhLtBQ&oe=69A0385B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJMOQyUCFqAQ7kNvwGhg7bK&_nc_oc=Adn6sUsnEGU4Ka2IR6tZrqo55T6hVbtY48npcHgutc0qwij-y9yHTN7T2zBYdpZRYes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYMaBw0-MKGcj1Rl5DOSQbdas81v1jC8kzPkvq6OIVaA&oe=69A04E41"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp6idmd77XYQ7kNvwH7HcPw&_nc_oc=AdkPTP--S0vYCYyoY1VFuL1WdVb7AJaTkV1uKB6_RJ0o3GZGcKuZzupdiTsiwqQsLb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgQICO4_PbZaiJjOUP2-WLJW7imTbVtvnR1kSiuPb7fw&oe=69A03738"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
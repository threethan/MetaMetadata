5w&oe=69F5F487"}, {"file_name": "ScreenShot4.png", "id": "3702977489915515", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974670_3702977493248848_1005083544870533286_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnAvGg3MxkkQ7kNvwG3JCpE&_nc_oc=AdpGtudPNnj6Ex9sb2nknH3OIqYao1pPQMTqt0FRwTFePqOMX10ZWH1aKqjrGlqnGBs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JNL48bVqYZSBpVov0vadu7VPV_495YfUUHhgxLvEb9w&oe=69F610DD"}, {"file_name": "ScreenShot5.png", "id": "1017394309783931", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569452_1017394313117264_5103681682275133887_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6TG8obOqnAQ7kNvwFhYkjJ&_nc_oc=AdrdRtXZRX8ptF1fVi8wPhiLz2HsxG9XgqWOSBptNr1OYfXoh6aW-5KVAlAck65KOEE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WkWjYxttRQtn9JSGn86UdTyrv_8w_PkY5jW3hkvMOog&oe=69F5EA8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "Arena Style Multiplayer Hack and Slasher"}]}, "developer_name": null, "devel
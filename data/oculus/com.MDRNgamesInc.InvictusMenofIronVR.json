Yw&oe=69F4A307"}, {"file_name": "ScreenShot4.png", "id": "3702977489915515", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974670_3702977493248848_1005083544870533286_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMTc5R3-MrsQ7kNvwFJMrFl&_nc_oc=AdrL2F3gELVPY_R7346TLb8NHFEf7N-TgpIZshDlXb7VZpRUBT9eKO5SAA8Xp7-mPfU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n6tCXM_rKnob_cH-f5KwplgdJauwPU3sdlmTSwRZPCg&oe=69F4BF5D"}, {"file_name": "ScreenShot5.png", "id": "1017394309783931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569452_1017394313117264_5103681682275133887_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUMh-GOTFHQQ7kNvwEJZdsc&_nc_oc=AdpDNkR1_H_ARW4OZ8ksOF2ttMPM-D9GQaUs-hHnPWCvtA6MI0IGgv0FWJvBxF2zWuk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KpoyQRoeSZCUOtjfOSbhdEj-TiH3QPsGWVrwEZ55TrQ&oe=69F4990A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "Arena Style Multiplayer Hack and Slasher"}]}, "developer_name": null, "devel
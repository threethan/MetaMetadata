/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtIcNz4bMDAQ7kNvwEJNfca&_nc_oc=Adrg59XVbEs-q-qtdWjK5afQgf6UBNmxZ36V4I2H09pYsIuV4639mBlKYmdHdtkhn_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LCwU1oCTAUDo9G3g99QBiGJooVlE8zeEecpYuWm5ueA&oe=6A15B80F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ApP_Y4D0qUQ7kNvwH7Pq95&_nc_oc=AdpLd04w-bmhynytMmxElK63eLA-ufd2fhuk-mwMyz-XTUyGcqnc36lyiOEQlYTKHOM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D_zh2CbJrAmgfd8zaIlBAUG9EFvM8Y4gffa1ZN94_hQ&oe=6A15AD37"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDjdA02m45sQ7kNvwH--j_Z&_nc_oc=AdoSEf3Fc-VYYkIuKFOL1zR1pTDX9ZylWE6DGwJRfeeE3uquK7g-7KPzlTeNmh3x7jo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HDTYa4JUL9ida3qe0df2Y5pHiXVWUMg8jI6qwLrS__A&oe=6A15C61B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2BRmfjH7yYQ7kNvwGJd1FR&_nc_oc=AdpPrcyfPP_9dESquVz9ibgjp0_he9_RwjfepssQFAZmsJghXQ0Pragwny2nOOLInl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Nlak7MgQjFWLVsoj_JveFqDqdHAZb7C8fb8EaqThfQ&oe=6A15A3C1"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeV293lD1RkQ7kNvwFwLuv1&_nc_oc=AdoMowMVluZ8-VYGCePq4AiXHjJlA4AX-dB2pNPeUiTE6egkgFHqiA9qen4IXKUy-_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u6dQY-DUibUuINNoO0EV-AmOBlgnKysPB8wNKrkaobg&oe=6A15C4F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "r
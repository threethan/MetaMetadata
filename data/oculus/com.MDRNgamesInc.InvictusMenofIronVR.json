_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8grBazooLAQ7kNvwH8NAzp&_nc_oc=Adm_RrM_0_DyBKEPBiGOshFy2vpnWGz_9EnFYwEhEhjsff3XSjS7kvFNOGAQBtN-XUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu2TlN87oQ8229SoA_VOQzlM6Dea8srQ0xXKeiIorc0pg&oe=699C35CF"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eMwNMObVQAQ7kNvwHIZ4Uo&_nc_oc=AdlLt1AtnFIHwymDdZPdYsWWaSZOO195sL95s7F73OWBU6NV_SvatYNrEroLu8vEIe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3y3WjwFk0vUqWATvcyj1joL4EPIk6qneFFBS3_7vo2g&oe=699C6337"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SntHqXCYXPsQ7kNvwEvlz85&_nc_oc=Adm_VWKOvDz-KYf0UIMd8XJO-2G7kKT6e2poC5cHbvZuWDYEnJAthl3gXHiR0SEk3nE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuEityiLRP79A5zvY-pY_R7Cb1-Zeku_QnrWKCfkQM2gA&oe=699C43DB"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1lbyWuTu70Q7kNvwG0x-oq&_nc_oc=Adkzom2SbtWe8x0luP_yfvufzwO6goFP3OH5WxaIk70J8ZWLHzKXLECdCTG27BL77XA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfteKJbg_RLFasz2rpPlLi8OhvXnICK9DEYxZUjJaDu3Ng&oe=699C59C1"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKW43xYnmYcQ7kNvwF7DQzj&_nc_oc=AdngvLyHOqM21-FmppTJOwlrKtBP5BFgAvIE5SEyW8fk19Hpz4_BfWG6uQRa-H5UYG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvl90QhDbIKgSi6wdgTWG5bLibHi7--umBw5sdwYp3DUg&oe=699C42B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
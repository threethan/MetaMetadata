11105494", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003257_1039171214438827_3060709184930369487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B_ggYTxOcQQ7kNvwGc5v6g&_nc_oc=AdpUDMtYI0ggJBDw6WLglgVLIsz7B_7lmVD_BD0X4yhDIVp5NmVnxchTwDmnhLzUDZc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSlD_02V-B0lFBX5vzU6ysKPY8Pz198RMZMzlxYL2hEw&oe=6A660407"}, {"file_name": "ScreenShot4.png", "id": "3702977489915515", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974670_3702977493248848_1005083544870533286_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyiAb5aUZbgQ7kNvwFRMdRh&_nc_oc=AdpK-In94aIYIPrDgnNNpN0FFy2MfPmeNlftBGtB7Gt_UkT6Ue3ianWX3hKnXPLaoBw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBapxp2zJckpPaynmQAR6YudKSqwFy8NA31z_FSG1cK6Q&oe=6A66205D"}, {"file_name": "ScreenShot5.png", "id": "1017394309783931", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57569452_1017394313117264_5103681682275133887_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLc_Uh2XEzcQ7kNvwFG5cV_&_nc_oc=AdofdZ0mF3E35RJPauVcatTLff1XyTkG6KmnJ-7oJCrG0_mQsqdnAT4g22VFBmfC9lI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAgqNewxIHxwy5qxo_nZp27ik9eLkC-naNFgpQyJ9Tgg&oe=6A65FA0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "Arena Style Multiplayer Hack and Slasher"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hauntnseek.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8123201997756862"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3778807339028924"}]}, "baseline_offer": {"id": "3778807339028924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731354300, "status": "PUBLISHED", "id": "3778807339028924"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26237154919268293", "version": "Alpha_2026"}, "id": "508643728502031", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
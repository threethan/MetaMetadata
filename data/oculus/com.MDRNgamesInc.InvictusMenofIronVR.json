uscdn.com/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RInpYhvBJcQ7kNvwENHb3m&_nc_oc=AdkYrJbAcvk3-Zf0xk2ebAAW8MNlyAAkvaoJfwgbZlewKXzhf0BAJFIQ4mxF8y80t-U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbMaJFqvP2-LpNlHJd0r1BD0c-JrCO4sgk0icySNtjFw&oe=69AAB64F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxt_EvHKHtkQ7kNvwGjkrF_&_nc_oc=AdlgkwezU82UyyIfA-MOREBM02NfofCpAQXTxXRydJvwJ9BePaE_QydcR_ocmKJovNc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrNJ2HTy6vyqF1mw4nxLjVWiieQ_Oc8TRLSILdv5857g&oe=69AAE3B7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8n-zDMYiN0Q7kNvwFmuxiu&_nc_oc=AdmnmhYP5T2asRBi421a5nqI9mbbvhfH3-IVXPfI1qlXXVAtWaNbAlvX2SSNtpYLU_w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1r_9Ci4WSWeGT_FQQloCg3CWM8W0HO5--JTRxyvxoPg&oe=69AAC45B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1surhrirv8Q7kNvwH9RAXG&_nc_oc=Adl9noewmByR-v5U8PgIaoVpdwmG9V8Oe7tT8yy6rsGEKXK1d2m4QLwELJzJ0rKKTZk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfHoTPHwn3lttw9W1IagBHUhtTDTYEIcaMvyRa0l-5Wg&oe=69AADA41"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFnYvyHDUMgQ7kNvwFsqY2m&_nc_oc=Admg7ZaO8ejnXW_rPu-KREKamSKT8-ncdn4DZIveld8LSrzemejP_cOrSPCtsgTTbCM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyI_CVMXlAWmmL5nMgP9mHzaCPWuMtlwuzqBCvYfg3lDg&oe=69AAC338"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8grBazooLAQ7kNvwFasKGU&_nc_oc=AdmQne_-8ClzzutlkZEzdXxrDQgHkiUNftkDz2mjLN3Gal3WUQB6mitk9sVB7z4c7fw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsJC-31Gya1p3FHxBPn2XgZShIt--R4RnA_gw2f1yiC1Q&oe=699AE44F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eMwNMObVQAQ7kNvwH_95PW&_nc_oc=AdkANOZTDXpadWqGoYlGOknouDmllW_GhbdTrsuvwRyRfl-S8YMQdXYk11sn1LiSqE4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvJToW29EPrY0GK75j5X3q6-Pj3MR8q8eolU9s7xFYWQQ&oe=699B11B7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SntHqXCYXPsQ7kNvwHbVQd0&_nc_oc=Adn50tpU4WYl8JKkPDS3vzwqPPMRgelglR_IP9sNAiJw4x-V5j_m3cgDqFeCp1zgfD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs4VKzWFyVubRRNF_9MocirD7BTGP5UKdprJiIWcJLxbg&oe=699AF25B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1lbyWuTu70Q7kNvwEYTg_k&_nc_oc=AdnRfCUFnVeKJZOlH5h4rkWv1Eup4dOE-6jfxpmsT45VsWzi30WcD1162OV94a9Fkz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxQN3H00wCrEVVrIlRmZZUoTPdP2_pYpWvbumxSvJ6_g&oe=699B0841"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da5bsf07tfsQ7kNvwFnLeek&_nc_oc=AdnTDj57z5axqRRwR9_nkOHTTEd2K9ez_OgshPQe6LNCCWuIeirdryYqz2kI7ACtimc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuoCroilIIxhaYnQ4vn04w6z2kGM4DiaFYGVrCGMtD9ng&oe=699AF138"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
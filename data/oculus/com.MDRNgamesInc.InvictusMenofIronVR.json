om/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvsSSSg329QQ7kNvwF3x-V3&_nc_oc=AdlJrhjte8c3Vd1k4BFB5s1gjriog4uoLim5vdzsTtrxLNiTxCqYz6O1cQc_rSduj6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQTQhutBxh0NYmKZKkuDoFM1Vb764I8tkgTn2DJgptCw&oe=69B693CF"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImL4EqE2kj4Q7kNvwFO8hJt&_nc_oc=Adk6Y0E6BmWtHcBsk_jXqvkvI4SjSqoueG4I8o_p8MMWyWEMG6zjYJ7--gp7ti_Onqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMKqbEch0SJN2UYQEFJI3s-km9zc_htaq9vV08UW6QRA&oe=69B6C137"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug_U3fznoG0Q7kNvwEXsRgN&_nc_oc=Adn-6EzsUxCwW3XYMLv-Rj0oLAASxs3iyAxmDTdCWeCUdqPhSCf-CLm393oCriqILGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIbsQYqgzPL7HE-46ekB2WH62aOqCYxM070nldymh1LA&oe=69B6A1DB"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQjfHlr0SicQ7kNvwEGqUFr&_nc_oc=Adm8XPP2bp73DbStgeS2Zosq_T6tti82XvW2JJYKsGdEBgBACk3lgesChmfXLhEk4T8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx80gVM8kiy1g9Cy99tOJLoniv1BlCmfHIS8U5jG0NcLA&oe=69B6B7C1"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJarZnMK19wQ7kNvwGC5216&_nc_oc=AdmmikuGKeKHZ2iBoBCxPB3BlAA91PQ_i4sNX7MOlQT-XhhT6Tm597gcRS2OwPASZO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyClUrOa7F1wGr7MktmTZjS0jtLTUNqRyzqVcfFXKgYRQ&oe=69B6A0B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
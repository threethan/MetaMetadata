om/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvsSSSg329QQ7kNvwGK79I6&_nc_oc=Adkn4aedtZD0t3nt8Up8m4unwTJYiVNijqlyberCf4cWlD7_IvcHecgvvjVOmE0jUmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLAcMEeUdSkJhaKtDkP-RG_5l2w2JHKcFqm-oAFkTc9g&oe=69B7E54F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImL4EqE2kj4Q7kNvwGfxaRb&_nc_oc=AdlvKUv3W83fu3DWLyIP4C8AjC7-SbjQ7KPPr6CiekIZol3DY6bhBJkJRDrRpAHIDyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfylMVO2dTfNachf0mrgwfOJtTY3u8UomKifkHY8lIZ7WQ&oe=69B812B7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug_U3fznoG0Q7kNvwGOYVbC&_nc_oc=AdnUvlvdLpf_Ld7InyTpBzCml3jheYgehs3WVm3GR0_Nr14_Zy1m6Hhel8BlutNdOmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1ZzMtFpnJ2izIA6mlYcKv-5JZ6Z7k8oisttWQhUTkQQ&oe=69B7F35B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQjfHlr0SicQ7kNvwERB-p9&_nc_oc=Adl5396Gsj-duWW7n-e13FfHfa3FuIbK71CP3sCFutEWhpUyK5oi2JLWnZXogt5VhlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfRGCVBhaqmdZhCq3Il0WF3tGeKzBKPOb9gyGtJH1daQ&oe=69B80941"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8yrhDotLfoQ7kNvwGivyw8&_nc_oc=AdlB9sk6rVKY2uKW6WqLrh_lgv-N4nft7wDiK0uyWZ_V1AsQLNGjRjaeSKXKB-V7l3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzsn2RgxADcljuu1jkR9ttKvyZMdoYlvWEOL14qApa3Ew&oe=69B7F238"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
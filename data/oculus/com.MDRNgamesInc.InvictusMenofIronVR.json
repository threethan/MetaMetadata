c_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyQe4Hb8qM_TBoQPTGr7UNXBZdep-3FrwmmgYkzNlAqQ&oe=6AFB4101"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Oj8SC-ePEwQ7kNvwF69ID1&_nc_oc=AdpTqiMLsIKWC4tkQQpsKOQfVpk-ccbhncsXISaT7wsElH0v3gdYFKPQlEmPz68yyNo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRlRRJe-N64VkRW19JUn-8vAhKmS9gehJ7bgpzTecmXg&oe=6AFB29F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "10038991969511179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75303840_792051199742127_7095300489999632337_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZudbLvnCZwQ7kNvwE-P5KF&_nc_oc=AdrDt4LcQtZlzFLLEnnQWD3I3FEQBZorHhw0aEjQTQus3TyVXhPOVrtY52Ye9KtTD9o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSacKlORhDy5SkrDosvQalyobDT-_ckW3VZ0r9Kgw_oag&oe=6AFB202D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Invictus: Men of Iron (Early Access)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1731354300, "lastRevision": {"nodes": [{"id": "8025591270851269", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8025591244184605", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1572063706681783"}, "iarc_email": null, "msrp": null, "tra
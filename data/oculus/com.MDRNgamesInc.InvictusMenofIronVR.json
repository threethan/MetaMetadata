om/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5-k7HSeuEUQ7kNvwEf3Iot&_nc_oc=Adn9ZFDvm6TQzFxRWOwpp18Hd7RtDUEXO4NYlIgoj53nKwAiqY_FHGH2UL-L5C2Xo4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTaqH1QWzWxyjWwXDzeqTyYKYd1fwJ6c1xPaETn36Fbw&oe=69B29F4F"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCVRHI8JVT4Q7kNvwH1IzXr&_nc_oc=Adn6ZtLIp1AarG2R_OQC3GOWPUmY48qfJc2fblZHJZecnyiRAEdGziyuAgHFcIwV6CM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGbELdbZywaSzgvcfPBYHWyXgpyYEyGm5-fIIeSXGOXg&oe=69B2CCB7"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGb_KTWIszAQ7kNvwHpUZ2R&_nc_oc=Adkr8MOERZEUHMVmbmE3edGUl5MblOCY_BlvGuTWu5upd_WlUI8pqBQxKxaLlHFdfA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhd71nz08dVQA1EHbUHXFAhp2NVNBV1tk3uHlwTaXe0w&oe=69B2AD5B"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_pmbOIi97UQ7kNvwGe9fzr&_nc_oc=Adm8eJ8YHDVQyFzaqRn8H9_KnyliU21kOkwNyhFxh3X0u_55bUnZgZ37h0t18MbYB6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwm-kFD7jjO40VwuiIYYMGs846sDJBdPf240KwMV5qs8Q&oe=69B2C341"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hGBfcU3naIQ7kNvwEuD3D-&_nc_oc=Adm3Z8SdOjpY4ZN9NJQY2gDiYD_BZ4g0qcLLaGbcedFhmI0OkAdYqDb5hhU9k1_nkzI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwqy3kJ5gaHyefgMgEoPo8R4tyaMTGlwFtB9Gs6lRBwAg&oe=69B2AC38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
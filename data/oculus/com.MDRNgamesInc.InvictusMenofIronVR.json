om/v/t64.5771-25/499619829_1234866125094530_8599426723962661943_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RInpYhvBJcQ7kNvwHkyV0N&_nc_oc=Adny3LGTg1H50jHhL7Q9pGs6FUZNt4qGaKjHd4hrDc9q8ghOJJNLLU1GX89W9LY_y7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftkz5BcAM2XavPyRlQfaZeYafZMVmllz9t062DD2NQ_1g&oe=69A964CF"}, {"file_name": "invictus_vr_screen1.png", "id": "1618509312155080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295992_1618509315488413_584362620189733042_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kxt_EvHKHtkQ7kNvwEWEXGi&_nc_oc=AdmF8nt47z3Xz-paNVmRAjOb4OhC78CmD5Phf3FTcw7acaTP0USAh_u5gClVvr_2G-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftFElXvo4Mg0xCUj_tLWApvyK23FtwpyIu_1brvWebVlg&oe=69A99237"}, {"file_name": "invictus_vr_screen3.png", "id": "24555102070757164", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_24555102077423830_796092505117992550_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8n-zDMYiN0Q7kNvwHnc_D9&_nc_oc=AdlgpYPgX4-2-0wIv6C5_uzlv_Pr9Erhtvks3vi3P2iE0mg2bIbS1X4x8YkHn7qHT2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsfoaJGE6l0T23o2BS7S9DrvKvX2rC6fm0io_kQvdZjSA&oe=69A972DB"}, {"file_name": "invictus_vr_screen2.png", "id": "1257072742605840", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618085_1257072745939173_7000426127612579626_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLqlvln2D5YQ7kNvwEGOEwr&_nc_oc=AdnPSeRQcGpaICCxy2qmHkNLwuCWdKR0JgyLrpJKXX4VOoqcctci4frqZoknbnRl1S4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulrrGNoGYiX2k4XRMzSugpglHjAhuBAGweC4th5k3-uw&oe=69A988C1"}, {"file_name": "invictus_vr_screen4.png", "id": "1034699638765997", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831965_1034699642099330_5571220265896175594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFnYvyHDUMgQ7kNvwGEG0nn&_nc_oc=Adm1SoPvRh0R8fHQOKlmFROZgCkLZ1FFADBwzSJ2455oXjGiBY0Okb2mK54_a6KW2Y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCXSj3iRK21u0Dgp-vmgRpJ-JVA2qtfr36A-qW9VJYYg&oe=69A971B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Invictus: Men of Iron (Early Access)", "keywords": [], "long_description": "Alpha Test Multiplayer maps\n\n\"Invictus: Men of Iron,\" is a VR experience that throws you into the heart of an arena or battle battle like a real gladiator or spartan.\n\nWhats to come...\n\nFeatures:\n\nEpic Battles: Engage in intense combat scenarios featuring unique factions, each with its distinctive armor and weaponry inspired by ancient cultures. Dynamic Environments: Fight in varied and breathtaking landscapes, from rugged mountains and dense forests to dramatic skies and stormy clouds.\n\nDiverse Warriors: Choose from a range of male and female warriors, each meticulously designed with ornate armor reflecting their cultural heritage.\n\nStrategic Combat: Utilize a variety of weapons, including swords, axes, and master different fighting styles to dominate your enemies.\n\nImmersive VR Experience: swing, block, and dodge mechanics in the works.", "short_description": "(ALPHA X -EARLY ACCESS - SANDBOX PHYSICS ARENA - MULTIPLAYER MAP 1) \n\nCOMBAT PHYSICS ARENA / MULTIPLAYER HACK & SLASHER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://sidequestvr.com/app/36450/invictus-men-of-iron", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
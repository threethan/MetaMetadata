}, {"file_name": "02-imported-model.png", "id": "1614214043647559", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RxIV-S6GlEQ7kNvwF7IuYO&_nc_oc=AdqPs8clw8VrAdigOusp5TatHYuV8h3sSUH-UEMqoXT5NGYClEHirC4ex4JJfHrT38o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPleng54G0L0S6s90NTTlVdmmdOg5_wXz0U9BQOI-LHw&oe=6AC7BFED"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLpeM0aLwG0Q7kNvwE_Y3nh&_nc_oc=Adox4AsXVbmnSiQ07bCNCg0aO5B5w8sR1AedngBehPIJVuAd9tFFQj0YeSAYleZjRf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZkjfl2Fj6hYQhoXFjkwm8nA5zITlI4wefYrxZTuu_rg&oe=6AC7AB0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PF5Qg2Z428kQ7kNvwHGMR6J&_nc_oc=Ado_9HLUxU4cudh-FlX-MGfT1vHmNpjEV7pmwovxHKZHVKRXC-DVcdmmuOduonWF7xA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBNv7jPtXW2uWPDYpNelMkLTehpk4HNTRYnAtC8h10IQ&oe=6AC799A3"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1358838290648579", "version": "26.10.04"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1358838290648579"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Choosing a model in the library now always opens it in your space, even after the library page reloads. Before, taps could be ignored with no message.\nLarge models show download progress while they load.\nA download that stops responding now ends with a clear error instead of loading forever.\nMicrophone and camera permission prompts now appear in front of you in XR.", "created_date": 1791083645, "id": "1358838290648579", "version": "26.10.04", "version_code": 1791083517, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1358838290648579"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791078478, "id": "1358734203992321", "version": "26.10.04", "version_code": 1791078407, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1358838290648579"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "- Add models without leaving VR: the new Add button opens your files and loads models up to 2 GB right into your room.\n- Share from inside VR: send a link to any model through the apps on your headset.\n- Home and every model card now have a Share button.", "created_date": 1790865330, "id": "1347335088465566", "version": "26.09.30", "version_code": 1790811621, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1358838290648579"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 If the microphone or camera was blocked earlier, tapping the mic or Scan now opens the app's permission settings; switch it on there and it starts working right away.\n\u2022 One Scan button in XR reads QR codes and scans objects in 3D, with boxes that stay on the real objects.", "created_date": 1790693614, "id": "1341873619011713", "version": "26.09.29", "version_code": 1790692939, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1358838290648579"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Microphone and camera now ask with the headset's own permission dialog, so talking to Zero and Scan work once you allow them.\nIf you declined before, pressing the mic or Scan opens Model Explorer's permission settings so you can turn it back on.\nScan waits longer for the camera to answer.\nPlaced models keep their spot more reliably.", "created_date": 1790659190, "id": "1341159285749813", "version": "26.09.29", "version_code": 1790657929, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6MuwF8WArEQ7kNvwGW7qJ4&_nc_oc=AdoWIUANitc-sgdxFnpnWrIryBl0SPNtSkIvyu8PaYED-7OI5n1JDYPeVh8HAap4FQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXI2Fh4sgPPwiWfaasKr5jEv2ku8e5f8RwVnI06sbR6w&oe=6AA81707"}, {"file_name": "02-imported-model.png", "id": "1614214043647559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJ93sdua7UQ7kNvwEnyvkK&_nc_oc=Adr93aVAlPeNZ0K7cNx_RDhXOAsVE6yU10x75kzg3jPIwNwHAr9ZyTY7DnBK1w0smJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN-pKf9S8FaNJMraH-2qkd1z6-HIlrZMfjyVsZHsMyXA&oe=6AA81BED"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zypSTWAz90Q7kNvwHfLphh&_nc_oc=Adp5eMoU19V-IitDsgT_KOeeKVTv--OoJ7RAkC7W7pgmesDzdzq-6eoH8eumIrGvh2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs-hFOampaEocsWDSkrFu15STeSDVW7f_FyPKB50Ceiw&oe=6AA8070D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pS284a7XGoQ7kNvwEQkfr7&_nc_oc=AdppGJGbktjx-nZURicrmdO6gUsaEDEQZ0qvUcR-3u8ygA5KE_01ctFS7Oo9uPsKYao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7Ea6_kGgLD2Vvfkqp6prfYsOgr_QrzRkDyyWC56E6jQ&oe=6AA7F5A3"}, "display_name": "Model Explorer", "keywords": ["gltf", "glb", "spatial", "reality", "model"], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest. Launch directly into mixed reality with the included Titanosaurus model, then place, rotate, scale, and inspect it in your space.\n\nExit the immersive viewer to open the landscape 2D library. Import GLB, glTF folders assets, keep a reusable model collection on your device, and select any model to return to mixed reality. A successfully imported local model becomes the default for the next launch.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nAn internet connection is required for the first hosted-app/model load, analytics, and optional Gemini features. Cached app\nresources and imported local models remain on the device until app data is cleared or the app is uninstalled.\n\nTitanosaurus A ALT was created by sharksly, sourced from Sketchfab, and is used under CC BY 4.0. Attribution is shown in the model information.", "short_description": "Import and inspect 3D models at true scale in mixed reality with hand or Touch controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAN
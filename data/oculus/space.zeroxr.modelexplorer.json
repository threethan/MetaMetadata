ported-model.png", "id": "1614214043647559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQcDzKCYN2wQ7kNvwGSAVV4&_nc_oc=AdqKsPgYXthYKEpQOLH8LAc5V2aGTgUl75PB-va-SBQx5OkuZyBx1yrN8qp05ga_s5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv8LZYLS6jWUwSdPJw48V1xKDFNQRdh4m0U8dtlg-uuA&oe=6AC1286D"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqKRL0jIW2gQ7kNvwF-8qVA&_nc_oc=AdoEjAat-bg4TLQ2gh9PH_I4dfpeU8LTwZAzzTlHdE7aR70cZoeUvJGF3OTBJLJdo2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJtdqBTS1DBEABlRQoSxjQOieI4Mc6lUOcpMgr7WuCEw&oe=6AC1138D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LSOb711HIkQ7kNvwGctA0-&_nc_oc=AdoERM0c8P0Nl8dDBfA1B-Oevu-84Z4h1Ov06W5wTIs8lDyvNr84hjJdYDgCdfIDMOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9uTbWXfGq13ZFLunmUvZtWTE9VtJshEp3l0ZodagHqg&oe=6AC10223"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1340155719183503", "version": "26.09.28"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340155719183503"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Microphone and camera requests now show the headset's permission dialog, so talking to Zero and Scan work after you allow them. Fixes for long sessions and version naming.", "created_date": 1790605731, "id": "1340155719183503", "version": "26.09.28", "version_code": 1790605707, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340155719183503"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "What's new\n\n\u2022 Microphone and camera permissions fixed. Tapping the mic or Scan now shows the system permission prompt, including on older Meta Browser versions where nothing appeared before. The prompt only appears after you tap, never on launch.\n\n\u2022 One prompt per tap: declining no longer brings the same prompt straight back.\n\nAlso new since the last release\n\n\u2022 Scan: the centre dock button opens a QR code share, and the camera view outlines objects it recognises.\n\n\u2022 Real size: models show their real dimensions, with a ruler for measuring.\n\n\u2022 Sharper dock and gallery in the headset; the gallery now curves around you.\n\n\u2022 More files open: .blend files, more glTF extensions, and files picked without an extension.\n\n\u2022 Dock icons are cleaner, without the blurred shadow.", "created_date": 1790571227, "id": "1339407615924980", "version": "21.07.27", "version_code": 1790557818, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340155719183503"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Model Explorer model-explorer-21.07.27-1789262883", "created_date": 1789277388, "id": "1313022375230171", "version": "21.07.27", "version_code": 1789262883, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340155719183503"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789256889, "id": "1312702531928822", "version": "21.07.27", "version_code": 1789256839, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsse
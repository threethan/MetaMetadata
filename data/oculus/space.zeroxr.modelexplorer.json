}, {"file_name": "02-imported-model.png", "id": "1614214043647559", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-406RVWsVNUQ7kNvwHtJ9n-&_nc_oc=AdoGLiiFCksTfo7DYC-hwhy4rZZiq6sGR8nL-b2i1ZzQwDawitcRiExNJ3BuVNwlPq0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK1figVOiHMpbb0DANDyGR2eKSxNEfJGUtLreEVAWdnA&oe=6AE3372D"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t57ztyVp-aQQ7kNvwH6UU67&_nc_oc=AdrgogAkoOLNimWKfDI5OB_K3GD2sOA1iR98_b5OWAUL5MxdJRaOfbqz41jed1OMiAc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnkt_E8t-FcynB3d2AR7sWLp3GUNvdJq09LPYfhcmQAw&oe=6AE35A8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyMnZUZynX0Q7kNvwGiBB_M&_nc_oc=Adp0HmjBeolSmT3A36lE7B9e7L2sq33h0VDEwgGbTh7bsalFtTicu5aRtMVPU2zMQ-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIcVppjs81c1el7Kb58LtvVAd2glHTKAue2dNDUr1Fcg&oe=6AE34923"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1394531860412555", "version": "26.10.24"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394531860412555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Plus in the app, and permission pages that point at the right switch\n\u2022 Upgrade to Plus from the Account page, through Meta's own checkout, with Restore purchase.\n\u2022 When a camera or microphone switch is off, the guide beside the Settings page stands level with the switch to turn on, clear of the page; on Browser's page it says to scroll down to Microphone.", "created_date": 1792829551, "id": "1394531860412555", "version": "26.10.24", "version_code": 1792829375, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394531860412555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Permission pages: the guide stands beside the right switch\n\u2022 When a camera or microphone switch is off, the guide beside the Settings page now stands level with the switch to turn on, clear of the page.\n\u2022 When Meta Browser is the one without the microphone, the guide says to scroll down to it on Browser's page.", "created_date": 1792829165, "id": "1394524977079910", "version": "26.10.24", "version_code": 1792828031, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394531860412555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Headset cameras: straight to the right switch\n\u2022 When Meta Browser can only see its virtual camera, Scan now opens Browser's permission page at once, with the guide beside it, instead of after about 10 seconds of a black picture.\n\u2022 The app tells the page who holds the camera each time it is asked, so a switch turned on in Settings counts on the very next press.", "created_date": 1792816211, "id": "1394303117102096", "version": "26.10.24", "version_code": 1792813751, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394531860412555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Open with and Share now take every format Model Explorer opens: GLB, glTF, USDZ, STL, OBJ, FBX, 3MF, Collada, Blender, SketchUp, STEP, IGES, DXF, VRML, point clouds and Gaussian splats, G-code, and zip, rar or 7z archives, plus photos or a video to make a model of. Pick Model Explorer and the file opens in your room. Files stay on the headset.", "created_date": 1792423649, "id": "1386045251261216", "version": "26.10.19", "version_code": 1792423225, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394531860412555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792422255, "id": "1386010107931397", "version": "26.10.19", "version_code": 1792421747, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
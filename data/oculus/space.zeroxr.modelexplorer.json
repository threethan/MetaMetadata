CFF"}, {"file_name": "icon-512x512.png", "id": "1539651380409271", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595143057_1539651383742604_7669535111471346451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXG4yDakEzsQ7kNvwEKagTl&_nc_oc=Adpct68BMMy3GgijqOoLD7DtPgEVJzf7lncHxcHzzOxfCxnMDuUIpCxNu1acsZ3JSXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU5Kqc5K110U87iwPhvtK6ovjwzNbCtMWpF21bVFcifQ&oe=6AC108EF"}]}, "id": "2039834527418782", "locale": "en_US", "screenshots": [{"file_name": "01-model-in-view.png", "id": "1067940902699598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624851_1067940906032931_3947679670293966056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw3QPOPsEucQ7kNvwHXNaLV&_nc_oc=AdrdTUZIP4R77C-Nr8ZOmsxFtGYa7-mMcFHPaKHEqQKi5VBrFa9HpUL6D-NA73TsWiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ75rUtc5cmb5lu9UlvKoXwSyDfqrgyyXjnowlNXEczw&oe=6AC11CE3"}, {"file_name": "02-section-plane.png", "id": "1700154964407637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1700154967740970_5879019265012802024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t1x5wRdoBQQ7kNvwEtk9IK&_nc_oc=AdrJ9L4WU-xA4uA_BsA3jukgtoG9rpo4uZFVc07ClCMAwHODwQQBgc72vpqiQlYDAh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-8Z7zo09mbHI_iIDi03y80H0Xt0W3yHP8mSuKYf6cYg&oe=6AC116EF"}, {"file_name": "03-exploded.png", "id": "1584226122774576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628455_1584226129441242_4734014778441398579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQXgN4f_g0IQ7kNvwGzVUm-&_nc_oc=Adq97SFA9fcgphhCds4PxwjDt6jEThCROX6RVXeIYouNMUZWZo1tsvAM5beZAflxRmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy1Fpu308ALy9xO8xunCaKJNJf8qE2UWs561kgjAXzWg&oe=6AC1028A"}, {"file_name": "04-wireframe.png", "id": "1749314379455054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1749314382788387_7568667829644515917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RztEAScMjQ8Q7kNvwH6FoE3&_nc_oc=Adpg2nl0muAfPs49UA8QgQA2HTrZXXnnkPFxho9THGoc5WbRrOwZKyB-NiMZprEv5O0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhgLy1wnRP5p2FupTO_G5bs247edE7IjykkfxbNYvtxA&oe=6AC11C39"}, {"file_name": "05-library.png", "id": "949452350898173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_949452357564839_5310429385414299176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3pmQVVbj_MQ7kNvwGPmRMx&_nc_oc=Adop2_N5H39dltYeV5Dgct6i6cfrfVY4rejqfmbI_OtbJ67pVfiKB1gGDrwMYLR4NEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2NRVCneJyrVbqwOPUQEbWhG7wKIM7J78OesryqfM6JQ&oe=6AC12ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LSOb711HIkQ7kNvwGctA0-&_nc_oc=AdoERM0c8P0Nl8dDBfA1B-Oevu-84Z4h1Ov06W5wTIs8lDyvNr84hjJdYDgCdfIDMOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9uTbWXfGq13ZFLunmUvZtWTE9VtJshEp3l0ZodagHqg&oe=6AC10223"}, "display_name": "Model Explorer: 3D GLB & USDZ Viewer", "keywords": ["gltf", "glb", "spatial", "model", "USDZ"], "long_description": "Model Explorer turns a 3D file into something you can walk around.\n\nImport a GLB, a glTF folder or a USDZ and the model appears in your room at the scale it was authored in, so a chair is chair-sized and an engine block sits on your desk. Move it, rotate it, scale it or place it on the floor, with hand tracking or the Touch controllers.\n\nThen look inside it:\n\n- Original, wireframe and UV views\n- Section planes you can drag through the geometry\n- An exploded view that separates every mesh\n- Per-part triangle, material and texture counts, measured from the file\n- Animation playback for models that carry it\n\nUSDZ opens without converting it first. The USD reader was written for this app, so Apple's format behaves here the same way GLB does.\n\nEverything you import is decoded on the device. Nothing is uploaded unless you choose Share, and there is no account.\n\nExit the immersive view for a 2D library, and pick the next model there.\n\nReal-world size is only as good as the source file. Where a file was authored off-scale, the model will be off-scale too.\n\nAn internet connection is needed for the first load, shared links and the optional assistant. Imported models stay on the device until you remove them.\n\nModels shown are from Sketchfab under CC BY 4.0: Titanosaurus A ALT by sharksly, which ships with the app, and in the screenshots WOLF by WildMesh 3D and left 4 dead Helicopter by hafid.quispe. Attribution is shown in the model information.", "short_description": "Open your own 3D files at real size in mixed reality. Import a GLB, glTF or USDZ from the headset and the model stands in your room at the size it was authored in. Inspect it properly: wireframe and UV views, section planes that cut through the geometry, an exploded view that separates every mesh, and per-part triangle, material and texture counts. Files are decoded on the headset and stay there. No account, no upload."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gr
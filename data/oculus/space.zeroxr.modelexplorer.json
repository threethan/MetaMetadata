07F"}, {"file_name": "icon-512x512.png", "id": "1539651380409271", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595143057_1539651383742604_7669535111471346451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9aA-rKO6v4Q7kNvwH7t7Jp&_nc_oc=Adr0RUU6i8fno44b-rrYj7NtxGnZpyiliXvcP-n_P-W-RCNze7EjbQV35Bf1R0ErN54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqW13QuvEi4q3ZU1D-xYIiVE2W61ov9gcM7krn-wyAyQ&oe=6AD22C6F"}]}, "id": "1424647252927383", "locale": "en_US", "screenshots": [{"file_name": "01-model-in-view.png", "id": "1067940902699598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624851_1067940906032931_3947679670293966056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQNcZDuPRncQ7kNvwEEUujo&_nc_oc=AdovNJAv7N97kiGqJ1gvVcjt1NQ-PisXA9xLOB0eqeGgOkbtxY3iqpvwI0tLsyBhWJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEfDeisgYXzWNxZc8nPHmviHqM1YegpctQevjScWKoew&oe=6AD24063"}, {"file_name": "02-section-plane.png", "id": "1700154964407637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620559_1700154967740970_5879019265012802024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbZzWN5UqHEQ7kNvwFdWOhY&_nc_oc=AdrhPbss-Gn66itfO8NYBj_NWVs-DWlvJwKmr_OPcUangDCr-vSlWQoLPaid1omOMPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCow0xhqLN7ogCdbPubzZXhLCiHEAwR74jyEf2p9vX9g&oe=6AD23A6F"}, {"file_name": "03-exploded.png", "id": "1584226122774576", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628455_1584226129441242_4734014778441398579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1x9HaOmDl4Q7kNvwGCpuMI&_nc_oc=AdobhgWk9amdxSHCr5qcmcdW_X-1gOq8slDl2Gyhqcab5zcpQhBDXFqVnMV6KF7ZXlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFgqzdXjIVlvL7bpoAOZ_LIhTytpZeZMWzQ9V0rYON5g&oe=6AD2260A"}, {"file_name": "04-wireframe.png", "id": "1749314379455054", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622916_1749314382788387_7568667829644515917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EKcTAC-dIkQ7kNvwHiqaOm&_nc_oc=AdoTRCWImtVTN1B5NnNCIV3MuGAk5IHg5qsMYGXQOtUgC3lR4HyukqN-dpogAxOGyiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHQmMkU784RZyR1iP30yBMxoKsmENTLNyg6kp9dM9k-g&oe=6AD23FB9"}, {"file_name": "05-library.png", "id": "949452350898173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_949452357564839_5310429385414299176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL2LzKGDoD4Q7kNvwFHXvm8&_nc_oc=AdoIPY8wtIeaok1L1KEO0cK7z8N65UKC6uAWezqP7ZzNc5L68Q7TSdT63-rv5mIZaAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzyRz8a4c_kDMUF8gcgrE5T3563RbX4qeGnpdSh61nVQ&oe=6AD25252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vop7sQtt28wQ7kNvwG4mAvC&_nc_oc=AdqS4LmcDG6VZNTqTdPpjt5sBCuv0Y21-hF-ZLnO3OduUMYDN2HZietOwTcAhRb8DI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJHr47tqmCaqMwtz0cSqzBscbDgd79mx_RvYT2qF5y_A&oe=6AD225A3"}, "display_name": "Model Explorer: 3D GLB & USDZ Viewer", "keywords": ["gltf", "glb", "spatial", "model", "USDZ"], "long_description": "Model Explorer turns a 3D file into something you can walk around.\n\nImport a model from the headset and it stands in your room at the scale it was authored in, so a chair is chair-sized, an engine block sits on your desk and a house plan fills the floor. Move, rotate and scale it with your hands or the Touch controllers, and it stays where you put it next time.\n\nOpens what you already have:\n- GLB, glTF, USDZ and USD, VRM, FBX, OBJ, STL, PLY, Collada, 3MF, 3DS\n- Blender .blend, STEP, IGES and IFC\n- Gaussian splats, point clouds and ZIP archives\n- Models from AI generators such as Meshy, Hi3D, Tripo and ComfyUI\n\nLook inside it:\n- Original, wireframe and UV views\n- Section planes you can drag through the geometry\n- An exploded view that separates every part\n- Real-world size and a measuring line\n- Triangle, material and texture counts per part\n- Animation playback\n\nTalk to it:\nZero, the built-in voice assistant, can scale, rotate or describe the model in your language. Just say \"make it bigger\".\n\nShare it:\nSend a model to another headset or a phone with a link or a QR code.\n\nEverything you import is decoded on the device. Nothing is uploaded unless you choose Share, and there is no account.\n\nReal-world size is only as good as the file. A model authored off-scale will appear off-scale.\n\nAn internet connection is needed for the first load, shared links and Zero.\n\nSample models are from Sketchfab under CC BY 4.0, credited in the model information.", "short_description": "See your 3D models at real size in your room. Import GLB, USDZ, FBX, OBJ, STL, Blender and 15 other formats, including the models you generate with Meshy, Hi3D, Tripo or ComfyUI. Walk around them, cut through them with section planes, explode them into parts and measure them. Ask Zero, the voice assistant, to scale or turn a model. Files are decoded on the headset and stay there. No account, no upload, under 1 MB to install."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOV
uscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QdEWZ86PuoQ7kNvwF6Q_XH&_nc_oc=Adp1ryBvGZiDLuIFhuiHPkF1TqALgwxjcoeCZzaYvTC6-6KrrFTnuHL-TdBGZnVEyRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaQZ5ckMWfE7KG32xuC9PFoionVboFUovtyZjIKggwPg&oe=6A734B0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jMu1ktjPKoQ7kNvwGxU71N&_nc_oc=Adrnwu_2uOmhdR4Pg2YlfbKgsef_gwwUhNGDieYJgO8CZPikT0ejRryPRi7bUWzkays&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2yqJzCyjvIimAd6uYa93ZvAlL798lTbfiqBuZ_B7CYg&oe=6A7339A3"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1236823436183399", "version": "21.07.27"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1236823436183399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id":
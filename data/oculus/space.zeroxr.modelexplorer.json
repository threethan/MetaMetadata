}, {"file_name": "02-imported-model.png", "id": "1614214043647559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJnOiUhEMuUQ7kNvwFpqnDp&_nc_oc=AdqxbVe5XsL8rWu6SR-BLUQ03NGU03iiNw0bEj_y3kCq6hEjALvL2Ya5XXXoFWGAOjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEZD8exUPg1i63taNuewmMAhQWnnmJeWAwodfKJ2NUpQ&oe=6AD24BED"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlKoOHZzGbcQ7kNvwHEmteE&_nc_oc=AdoZLgmxEa1hOXBnSLzYcp4GpjG9hiljDUBZiyXX6dkl_jCGtw1vcrPI9-q3pxcPimU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyYzpJYeqqTgT7gdPSzQmMqJS7UkG6F-1X0y-IpPYjCg&oe=6AD2370D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vop7sQtt28wQ7kNvwG4mAvC&_nc_oc=AdqS4LmcDG6VZNTqTdPpjt5sBCuv0Y21-hF-ZLnO3OduUMYDN2HZietOwTcAhRb8DI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJHr47tqmCaqMwtz0cSqzBscbDgd79mx_RvYT2qF5y_A&oe=6AD225A3"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1368013729731035", "version": "26.10.09"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368013729731035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Camera permission fixes: pressing Scan again after closing Browser settings now reopens them and picks up Headset cameras when you turn it on. The visual guide now also stands beside the Browser's camera dialog, the one where Headset cameras must be ticked.", "created_date": 1791549770, "id": "1368013729731035", "version": "26.10.09", "version_code": 1791548792, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368013729731035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Fixes the session staying dimmed after the camera permission page: closing Browser settings now returns you to Model Explorer at once, and turning on Headset cameras is picked up within two seconds. Pressing Scan again reopens the page if the switch is still off.", "created_date": 1791508165, "id": "1367241423141599", "version": "26.10.09", "version_code": 1791506153, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368013729731035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Camera and microphone fixes for Quest.\n\n- Scan no longer shows a black picture when the Browser was only allowed\n  virtual cameras: Model Explorer now opens the Browser's permission page\n  so you can turn on Headset cameras, then scans again.\n- If you once chose \"Don't allow\" for the microphone or camera, pressing\n  Zero or Scan now takes you straight to the right permission page (Model\n  Explorer's or the Browser's) instead of failing silently.", "created_date": 1791349950, "id": "1363995550132853", "version": "26.10.06", "version_code": 1791329971, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368013729731035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Models in your Downloads folder open again from Add\n\u2022 Picked a photo or video? Zero now turns it into a 3D model\n\u2022 New formats: FreeCAD, VRML, 3D DXF, G-code, Rhino .3dm, .sog and .ksplat splats\n\u2022 3D prints stand upright at real size, with print size and volume in Info\n\u2022 Two hands: scale from the base, carry, and pass the model between hands; controllers too\n\u2022 Smoother: lighter room occlusion, faster textures, better memory use", "created_date": 1791182711, "id": "1360717513793990", "version": "26.10.05", "version_code": 1791182235, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368013729731035"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "Choosing a model in the library now always opens it in your space, even after the library page reloads. Before, taps could be ignored with no message.\nLarge models show download progress while they load.\nA download that stops responding now ends with a clear error instead of loading forever.\nMicrophone and camera permission prompts now appear in front of you in XR.", "created_date": 1791083645, "id": "1358838290648579", "version": "26.10.04", "version_code": 1791083517, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
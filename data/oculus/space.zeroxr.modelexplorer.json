}, {"file_name": "02-imported-model.png", "id": "1614214043647559", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620817_1614214046980892_4246686299787827891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTBW60rwSb0Q7kNvwHzYejb&_nc_oc=Ado5cijX7VyWfucjA0wdqTdu6Ai2uzupWu_pxgw4Hd3kuAo4LfGNIxtES1jimgvJ5yU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz0LQZ6pP3xRpXp_NAs7u4Jd88a4AGfdSFNbqPRkrBAw&oe=6AF9D8ED"}, {"file_name": "05-uv.png", "id": "4598662690459907", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604275479_4598662693793240_7132404583638515847_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbA-z0O3aEAQ7kNvwHsHI4z&_nc_oc=AdoXsXI7NJADFq-xYGXz8-bKsljbDWY9DweQDNvxHnpgI8wHMBswnY_lQRLIfp2sAdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp_dowWCK4QIRg77420V3UU4tBnI0dZGKSlbwSxxNKrA&oe=6AF9C40D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Oi1ud7Jo7QQ7kNvwGWRgsB&_nc_oc=AdqXkIhzmt8-dtfzvzPLoZYe5ptn_c6l19OykI8qnS3gBXtTkVWWv6YwU2wLSNkQu8I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsq1BE652mdLVhX2EmElXLaL3OjceXz3fghynMNkVl4w&oe=6AF9EAE3"}, "display_name": "Model Explorer", "keywords": [], "long_description": "Model Explorer is a local-first workspace for reviewing 3D assets on Meta Quest.\nImport GLB, glTF folders assets, keep a reusable model library on your\ndevice, and open a model in mixed reality when you are ready.\n\nInspect scale and form in context:\n\n- Place, rotate, and scale models in your space\n- Switch between original, wireframe, and UV views\n- Use hand tracking or Touch controllers\n- Keep imported models in local app storage by default\n- Create a share link only when you explicitly choose Share\n- Use optional Gemini-powered voice assistance with your own API key\n\nModel Explorer launches as a comfortable 2D panel. Mixed reality begins only\nafter you select a model, so you stay in control of when spatial permissions are\nused.\n\nAn internet connection is required to load the hosted app, use analytics,\ndownload shared content, create share links, or use optional Gemini features.\nPreviously imported local models remain stored on the device until app data is\ncleared or the app is uninstalled.", "short_description": "Import and inspect 3D models in a standalone workspace, then place them at true\nscale in mixed reality with hand or controller input."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1236656396200103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1233838032168917"}]}, "baseline_offer": {"id": "1233838032168917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785540840, "status": "PUBLISHED", "id": "1233838032168917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1431854990013575", "version": "26.11.08"}, "id": "27730518146616648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431854990013575"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Plus checkout: the store's whole error message reaches the app's log, no longer cut short.\n\u2022 Includes the microphone read by the app itself (one permission dialog).\n\nQuestions or ideas? discord.gg/4PrpEXtyEh", "created_date": 1794126904, "id": "1431854990013575", "version": "26.11.08", "version_code": 1794126807, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431854990013575"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Plus checkout: the store's own error code and words now reach the app's log, for a checkout and for the price lookup.\n\u2022 Includes the microphone read by the app itself (one permission dialog).\n\nQuestions or ideas? discord.gg/4PrpEXtyEh", "created_date": 1794125003, "id": "1431805476685193", "version": "26.11.08", "version_code": 1794124698, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431854990013575"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Microphone read by the app itself: one permission dialog instead of two, and Zero no longer needs Meta Browser's own microphone permission.\n\u2022 Recording runs in a microphone service while the session is in front; 16 kHz to the page over localhost, as the cameras already do.\n\nQuestions or ideas? discord.gg/4PrpEXtyEh", "created_date": 1794094158, "id": "1431092363423171", "version": "26.11.07", "version_code": 1794068926, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431854990013575"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Add in a session: a file whose size the headset's Downloads list has out of date (a GLB exported over the old one) is taken as it is, instead of being refused.\n\u2022 Picking a lone .txt, .bin, picture or .mtl says what it is and which file to pick; a .txt that is a model opens.\n\u2022 A saved copy that will not open is not reopened by itself; model files download in a stream that resumes; a share that fails says why.\n\nQuestions or ideas? discord.gg/4PrpEXtyEh", "created_date": 1793839729, "id": "1424737727391968", "version": "26.11.05", "version_code": 1793839651, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236656386200104", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1431854990013575"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "27730518146616648"}]}, "change_log": "\u2022 Object detection runs on the headset during a scan (NanoDet-Plus-m 416, int8, ~47 ms a frame at 10 Hz); the server keeps names, tracking, depth and placement.\n\u2022 Experimental build for testing: zero:deviceDetect=off or ?devicedetect=0 turns it off.\n\nQuestions or ideas? discord.gg/4PrpEXtyEh", "created_date": 1793757650, "id": "1422203720978702", "version": "26.11.04", "version_code": 1793757238, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
DFF"}, {"file_name": "icon-512x512.png", "id": "1539651380409271", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595143057_1539651383742604_7669535111471346451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7jomZe29yoQ7kNvwGKG3yD&_nc_oc=AdrttPmdC2XcwK6IREqggNDTnm0b4Idtj8ag_Y4cr_JC4bApvAIOwLYChbli6xSWfvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJprkr8C9UlG8vSmKZ2-uLANggxOgadN8cmxOjILrJtQQ&oe=6AB3D9EF"}]}, "id": "2039834527418782", "locale": "en_US", "screenshots": [{"file_name": "01-model-in-view.png", "id": "1067940902699598", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624851_1067940906032931_3947679670293966056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ8J5JVvOdUQ7kNvwF-MGAh&_nc_oc=Adqb_oNe8g635PxrVg8DN81ahLCRI92zDEDIPeV17Zd014zNCIo3kz0P-2BZrdRTHi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ5ub47Ysnfq4U4jptCwJTOOjaGGudrv101CyVr5UWLg&oe=6AB3EDE3"}, {"file_name": "02-section-plane.png", "id": "1700154964407637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1700154967740970_5879019265012802024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZgj4uCflREQ7kNvwGnxFkf&_nc_oc=Adp48Srup3-lCIFq6br86M8q4NOOYwDsNkYkouZaLZtbZb8ZauV4gqx8ymtmcsDRfx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOo6F7ZYzULqlsjD2hvkLB43bwpJ6NQ7VOTKJOdFiO3A&oe=6AB3E7EF"}, {"file_name": "03-exploded.png", "id": "1584226122774576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628455_1584226129441242_4734014778441398579_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeoE5jO-EmsQ7kNvwE0nl0G&_nc_oc=AdoFBwAvxXmWpNVi2eSMObpoYJ-yih5tpEITVuDR4Mi2veR_IVAYCMdz8gw9ysh0KZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnB-bsZLCHKVPXX9dDejZNVGF9RHPbg3H8NJbIO3UDOw&oe=6AB3D38A"}, {"file_name": "04-wireframe.png", "id": "1749314379455054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1749314382788387_7568667829644515917_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOd-DxtCqOQQ7kNvwGr3XrY&_nc_oc=AdrdcK8Q9hQTMBOKlNu76d9Lw_0EhAm8aG4quYPWT4Q28McKaToeGtnQvqzN_JT91vY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL17h0-mG7eIMYbSO4jx_MQ4aCqdHxzi4rK-HKLFJtdEw&oe=6AB3ED39"}, {"file_name": "05-library.png", "id": "949452350898173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_949452357564839_5310429385414299176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm3blG2waJkQ7kNvwEa6gcJ&_nc_oc=AdoKH8CpxL91Bgi6DXVT-kjZ2MBGaO8h73m_7mkMUKXsNgEUYx3jXY8IM3pPQbsr310&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTAKclp-NWRWQDV0POe97JEXgb7EEuEk0tSC5K7Dgwcg&oe=6AB3C792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03-original.png", "id": "1063391162859055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1063391166192388_4030653526203131285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwk8SlS8kGUQ7kNvwH63fiC&_nc_oc=AdodMCRkzaZlF-qvBdUPY5EAJ9FhPhlgNmiJSLviIlAzNZmTbgNtMTzWR1AUIVbgb88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLSOUCBGvQyk-bnvNeT9DsveJnK7bAe75-xrqEli394A&oe=6AB3D323"}, "display_name": "Model Explorer: 3D GLB & USDZ Viewer", "keywords": ["gltf", "glb", "spatial", "model", "USDZ"], "long_description": "Model Explorer turns a 3D file into something you can walk around.\n\nImport a GLB, a glTF folder or a USDZ and the model appears in your room at the scale it was authored in, so a chair is chair-sized and an engine block sits on your desk. Move it, rotate it, scale it or place it on the floor, with hand tracking or the Touch controllers.\n\nThen look inside it:\n\n- Original, wireframe and UV views\n- Section planes you can drag through the geometry\n- An exploded view that separates every mesh\n- Per-part triangle, material and texture counts, measured from the file\n- Animation playback for models that carry it\n\nUSDZ opens without converting it first. The USD reader was written for this app, so Apple's format behaves here the same way GLB does.\n\nEverything you import is decoded on the device. Nothing is uploaded unless you choose Share, and there is no account.\n\nExit the immersive view for a 2D library, and pick the next model there.\n\nReal-world size is only as good as the source file. Where a file was authored off-scale, the model will be off-scale too.\n\nAn internet connection is needed for the first load, shared links and the optional assistant. Imported models stay on the device until you remove them.\n\nModels shown are from Sketchfab under CC BY 4.0: Titanosaurus A ALT by sharksly, which ships with the app, and in the screenshots WOLF by WildMesh 3D and left 4 dead Helicopter by hafid.quispe. Attribution is shown in the model information.", "short_description": "Open your own 3D files at real size in mixed reality. Import a GLB, glTF or USDZ from the headset and the model stands in your room at the size it was authored in. Inspect it properly: wireframe and UV views, section planes that cut through the geometry, an exploded view that separates every mesh, and per-part triangle, material and texture counts. Files are decoded on the headset and stay there. No account, no upload."}]}, "developer_name": null, "developer_privacy_policy_url": "https://0xr.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Ng\u00f4 \u0110\u00ecnh D\u0169", "support_website_url": "https://0xr.space/support/", "website_url": "https://0xr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gr
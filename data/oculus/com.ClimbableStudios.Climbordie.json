n.com&_nc_ss=7f20f&oh=00_AQSHT0639ldeCw6wT7msXjSq4iu2M5auUOMI7AG_cQzXmg&oe=6AF1F175"}, {"file_name": "Screenshot 2026-09-10 101406.png", "id": "1640822880733103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831393_1640822884066436_5640433677908668689_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kZRl--_2hkQ7kNvwE6S1dJ&_nc_oc=AdovaMGfvWieBl6UAxuHBj_yxYeeu368YrMhDH89ZbX7f5oqNDYuXA5z_nTtIHXyfJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_jlcsBVB5V06r_ZAk772F81K0v9Nmn3Up4C6q4xMfbg&oe=6AF1EBC9"}, {"file_name": "Screenshot 2026-09-10 101420.png", "id": "38533834339594602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604385997_38533834349594601_8275358923603979669_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc9s9r9-vR8Q7kNvwFyWjRg&_nc_oc=AdoDrygKysV6-par5VOnK15kQcEkG4Y0wAvrb6Gscu-rj-UZrI7zSKq_xyPSohse5O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR__cGJ-O7VTBvAbmMoHPUShRbSGniUtYprXGTZbQHXYQ&oe=6AF1E03A"}, {"file_name": "Screenshot 2026-09-10 101435.png", "id": "1618207279839206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_1618207283172539_2242992429488557189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jr1KJmBLCYQ7kNvwFqBCTD&_nc_oc=AdoO_ApOFVDlOJRd5qWe2YvOwPuE6UDvAMOYHO4t35UaWFE5kZp2m1pA2E0qhh4vYKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGpOvAHs_HGTWvK6IS3DBTH8lkOTRKHJdth2m4m5xn6Q&oe=6AF1EB75"}, {"file_name": "Screenshot 2026-09-10 101459.png", "id": "2319741795462316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_2319741798795649_1060098556882185639_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PecDJylrMeMQ7kNvwFPVZNm&_nc_oc=AdoB7r2q3o0UBXEIRXH0_NG4llJe3xj4sYNWKHoKwvFbF21KWkpdwAcXk8g2_w7ctGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRORyAUj_jqoMi-frWtAEUGE2Ek5shKg18tRXRL1TAyxw&oe=6AF1D913"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Climb or Die", "keywords": [], "long_description": "Climb or Die pulls you into a brutal vertical world where every level feels alive, watching, and waiting for you to slip. You\u2019re not just climbing walls\u2014you\u2019re navigating a shifting labyrinth built to break you. Each stage blends platforming, horror, and fast\u2011paced VR movement into one relentless ascent.\n\nStart in the lower tunnels, where dripping pipes echo your footsteps and shadows move even when you don\u2019t. Higher up, the architecture twists into impossible shapes: rotating platforms, collapsing beams, swinging hazards, and narrow ledges that force you to breathe slow and climb smarter. Monsters stalk the routes between levels, learning your patterns, waiting for the moment your grip weakens.\n\nEvery new zone introduces fresh mechanics and environmental threats. Flooded chambers force you to climb before the water rises. Wind tunnels shove you off course. Bio\u2011mechanical growths pulse along the walls, reacting to your movement. Some levels reward precision; others demand speed; all of them punish hesitation.\n\nThe tower doesn\u2019t care how skilled you are\u2014it adapts. It remembers. And the higher you climb, the more it tries to kill you. Your only goal is simple: keep moving, keep climbing, and don\u2019t look down. Because in this world, one mistake isn\u2019t just a fall\u2026 it\u2019s the end.", "short_description": "Climb or Die throws you into deadly vertical challenges where every level is a new nightmare. Scale twisting towers, flooded tunnels, collapsing platforms, and monster\u2011infested mazes. Each stage introduces fresh hazards, smarter enemies, and brutal puzzles that push your VR climbing skills to the limit. Survive the climb or fall to your doom."}]}, "developer_name": "Eli", "developer_privacy_policy_url": "https://sites.google.com/view/climbordieprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Eli", "support_website_url": null, "
.com&_nc_ss=7f20f&oh=00_AQLjLFngEmEmK_rgpS7dcdBaMK56GtxiQwgmxEcymLMSmA&oe=6AAE990E"}, {"file_name": "38974850_902594431963143_2883818046108512141_n.png", "id": "1557386724973856", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391971_1557386728307189_1113403312633425090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIObCsfWOzoQ7kNvwEYIFsA&_nc_oc=AdoUYyBTHWk74ouWWvAMbUG9-y3OhzgWCtr6DAuq46azEuswLzyPJJLkB-QVDDPYNgQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK43rpeUbL9qzFEL3lpGyK4Jfw1U6lFMPKjr_RKpDBv8g&oe=6AAE88E4"}, {"file_name": "39003272_2051467438656826_5115587417276744533_n.png", "id": "569417202647987", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393796_569417205981320_8812757358380454028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHFbsYygamsQ7kNvwGlCpzw&_nc_oc=AdqXlf_TMls_P7ktQDqsN06brQ8AYWJ4wtE6L54xXenkUetFzoWe6OjA1F1vG-pPlh0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtyEGXMcuuK-bpbY9BG1K6doWr4m16DgPtIn_KgE2oSA&oe=6AAE93A0"}, {"file_name": "43931338_552670444203957_6159967347125465004_n.png", "id": "27991384830505219", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392034_27991384833838552_554729153935967498_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOvRgXcG3nYQ7kNvwEtzhfe&_nc_oc=AdqZ_8aEvNI-ExMGbDyotZ8TVPNJRZOoTsGr_-NFxUMhM9CL3ELTYwdj69NIU1UKtS0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRpXqmLpRyM236Oq_ndBvqZHksrd-kdtpwYN_78kO1lg&oe=6AAE92F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main_cover_3_yellow_word_demo.png", "id": "1805143670277387", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393890_1805143673610720_270807813600265652_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1atsvR86ZJQQ7kNvwGoexFi&_nc_oc=Ado-d_ZVjUeI83KNtdv8ezCnOv9BJuPnTh0pNqFhQtYF7txAHlqKsFGCrIyFIVE0jQ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Ut1LxhmehcCbDTwzlxprkMUnxqOwJy7HmnM84JkpcQ&oe=6AAE7E7D"}, "display_name": "Gun World VR - Demo", "keywords": [], "long_description": "# Try the full game to obtain over 1000 guns and attachments. Build any gun possible.\n\n- Build any Gun possible - Gun World VR has over 1000 guns and attachments\n- Sandbox Experience - Spawn unlimited weapons and build endless loadouts\n- Multiplayer Physics- Experience Physics in multiplayer mode with friends\n \nGun World VR is multiplayer sandbox shooter with realistic physics and over 1000 guns and attachments. Become the best tactical soldier and assault positions with your friends. Build anything in sandbox mode.\n\n \n\n# \n# Features\n# PvE Missions: Solo or Online Multiplayer Co-Op with Up to 8 Players \n\n# PvP Mode: Competitive Modes and Maps\n\n# Tactical Teamwork: Trust your teamates and friends\n\n# Procedural Compound Raid: Play different maps everytime\n\n# Breach and Clear: Assault positions with your pals\n\n# Tactics applied: Strategize your assault path\n\n# Breach and Clear: Flush enemies out\n\n# Sandbox mode: Experience physics and building loadouts\n", "short_description": "Try the full game to obtain over 1000 guns and attachments. Build any gun possible.\n\n- Build any Gun possible - Gun World VR has over 1000 guns and attachments\n- Sandbox Experience - Spawn unlimited weapons and build endless loadouts\n- Multiplayer Physics- Experience Physics in multiplayer mode with friends\n \nGun World VR is multiplayer sandbox shooter with realistic physics and over 1000 guns and attachments. Become the best tactical soldier and assault positions with your friends."}]}, "developer_name": "Alto Interactive", "developer_privacy_policy_url": "https://github.com/superdude12399/PrivacyPolicyDemo", "developer_terms_of_service_url": null, "publisher_name": "Alto Interactive", "support_website_url": null, "website_url": "https://www.altointeractive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274
.com&_nc_ss=7f20f&oh=00_Af-7zg2JNdXXdNsCoiGlJTEInXwsqLKlTe_kjdw1yeELMw&oe=6A39438E"}, {"file_name": "38974850_902594431963143_2883818046108512141_n.png", "id": "1557386724973856", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391971_1557386728307189_1113403312633425090_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7B-mQlA9FUQ7kNvwEI7aK0&_nc_oc=AdrLX2uLPl5JKvDX_k3ePWBUdPr9nZayO84SKo6M72B-qAmJvinmkbkoL_xp6jA3peY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y371W2mnuL-3kOeB9tUy1EHWUYRSpEpGNt8aXE-Brqw&oe=6A393364"}, {"file_name": "39003272_2051467438656826_5115587417276744533_n.png", "id": "569417202647987", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393796_569417205981320_8812757358380454028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc2K-quti70Q7kNvwEmEcQT&_nc_oc=AdqN93rrmcAVracwPSIeUEbEmMNFQn_X-IEUj5wn49nCA2zAlVeL6kxXzlbbPbt-GgU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IYFO_S5PwFwKIgbivXGAdy1Ek4vKLADwf0j7ugWWZlA&oe=6A393E20"}, {"file_name": "43931338_552670444203957_6159967347125465004_n.png", "id": "27991384830505219", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392034_27991384833838552_554729153935967498_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQT-jrN-kIkQ7kNvwEJPE1C&_nc_oc=Adq0oeEg4rck8orJEqBoFrD7hr0sKXmB4Yv5_eD7YwhN_LQGHVoBos7XnARXOisf_Fs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ImGL4Pyunat4mipdEzpU6JQkWHW9cXULNyZEXDkIFRA&oe=6A393D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main_cover_3_yellow_word_demo.png", "id": "1805143670277387", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393890_1805143673610720_270807813600265652_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL1DkXJtvA0Q7kNvwGRv35o&_nc_oc=Adq6C8_kiJkgxXjXavx-givXgzXMOON05419KdiEWjOCOLlMfnsRTchH2ymA28pqwjY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3RWgBfq8Z2Bxj7d1iBMSoUbqgAgonlsMc6zMFx-I3kg&oe=6A39613D"}, "display_name": "Gun World VR - Demo", "keywords": [], "long_description": "# Try the full game to obtain over 1000 guns and attachments. Build any gun possible.\n\n- Build any Gun possible - Gun World VR has over 1000 guns and attachments\n- Sandbox Experience - Spawn unlimited weapons and build endless loadouts\n- Multiplayer Physics- Experience Physics in multiplayer mode with friends\n \nGun World VR is multiplayer sandbox shooter with realistic physics and over 1000 guns and attachments. Become the best tactical soldier and assault positions with your friends. Build anything in sandbox mode.\n\n \n\n# \n# Features\n# PvE Missions: Solo or Online Multiplayer Co-Op with Up to 8 Players \n\n# PvP Mode: Competitive Modes and Maps\n\n# Tactical Teamwork: Trust your teamates and friends\n\n# Procedural Compound Raid: Play different maps everytime\n\n# Breach and Clear: Assault positions with your pals\n\n# Tactics applied: Strategize your assault path\n\n# Breach and Clear: Flush enemies out\n\n# Sandbox mode: Experience physics and building loadouts\n", "short_description": "Try the full game to obtain over 1000 guns and attachments. Build any gun possible.\n\n- Build any Gun possible - Gun World VR has over 1000 guns and attachments\n- Sandbox Experience - Spawn unlimited weapons and build endless loadouts\n- Multiplayer Physics- Experience Physics in multiplayer mode with friends\n \nGun World VR is multiplayer sandbox shooter with realistic physics and over 1000 guns and attachments. Become the best tactical soldier and assault positions with your friends."}]}, "developer_name": "Alto Interactive", "developer_privacy_policy_url": "https://github.com/superdude12399/PrivacyPolicyDemo", "developer_terms_of_service_url": null, "publisher_name": "Alto Interactive", "support_website_url": null, "website_url": "https://www.altointeractive.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274
n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBO6XRs7_g4Q7kNvwFj1i3Z&_nc_oc=AdpO1CvwBpHPNmhRQM4oFra7Ux3dg41Hj7dRAIFyalIcfvtBawLkDDYp80nkL5VW5rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgf1JJqe6h5riH1ju8AkyfesbMsB32pJ4tprPr6CkX5A&oe=6AEDEB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpT_ZDi9DkAQ7kNvwF_hFxi&_nc_oc=AdoaQHO3qU9dwcpf2pWG-yuomRuQiqp87z0vD9eBLO_4-K6PwbAerBkve5wYuJuZ_n8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyWn-KrPIih-Q0oyFIoXQ888MHNJ1_S0mlrgZ-fk-Q1Q&oe=6AEE08C6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holo
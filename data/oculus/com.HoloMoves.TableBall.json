n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2COk6xX44XwQ7kNvwFDQk1c&_nc_oc=Adq71PuTmHpzzI3eB1XOe6AFNAmDyo_oMSIUGW6pqyypBhsW_2pJZSXUc3WIKnDeF0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQONJH_Rty39Jfg4g6mAuNNKP1bGyYvdaR6fzHcE7PyVA&oe=6AF9C90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im0sH0J2zt8Q7kNvwG0WZWh&_nc_oc=AdqVeEUoTc-CO064FlOp3GhgrpLOKLvffDH6d7ZP7PlL2lVLZKFGqB9BVFsZjr4TvVo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0EB3ijQnkXQr9JCT_bC_Ez6g0tGHPFd8b_tjITDYGJQ&oe=6AF9E646"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holo
1_792831556007057_317040391184345828_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcLQePmWfysQ7kNvwH3YMgp&_nc_oc=AdrT3fIggXNYrEkcUx_EBhsTWf1DR6x0UGerUMyHlELt6fYgCPmFUmfc0qf82WX266w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1CLZ1Nd3DpPSoE-PS5TrjnXhjbelgAGx4ZfJdgnXc90w&oe=69F0CF62"}, {"file_name": "screenshot3.png", "id": "302981139432513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_302981142765846_4015045250399538610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkWfu7CSG-kQ7kNvwGZinFn&_nc_oc=Adqu9-brmOmO3mwLzHUeJeWuEHOCtTzpFOEqL41-FQTRYWy7RDt0RD2s4dBtNsmsAYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2oKYFyUznMPx7HD04axShpUHRuAWvUemnBPCv1h6-9VA&oe=69F09EEE"}, {"file_name": "screenshot4.png", "id": "697657545817259", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031569_697657549150592_9084133421503538669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtG_mVuPyr0Q7kNvwEZtZQV&_nc_oc=Adom0mEeYYe8F_RFGKNnYe2LdEt8_3QswjOmmFYZm_hE1XCjU2GQaPJei-db_xBUgRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Wtfyfhpt4ZBh4MPRncpN-ff4anefUBZMnMqLcUKd79g&oe=69F0C9EE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67bgyIqw1TYQ7kNvwHlLqIS&_nc_oc=AdpmGgxj56Y9_GGzIx0AaUmw9RzHquxVA_c3qAl2ozuSVOMtw4b4jKXlrEHo4CsF-Vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3W4dLs3PIyLeUS1P1qgwpZ3ONI4jCh93NqFXIIyQlIMw&oe=69F0CB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3-y2OLkEHkQ7kNvwGuQxuO&_nc_oc=Adp-xxbwL1O3NfVL10Gdglck1Vlg3-OmdeomxzWIF9qrmALEPoCnTbuOqql-NFvJxp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af121ApwWTjJ7nC9fHlC0zpXwHKdpbg3UQWfMb0TLhWWMA&oe=69F0B086"}, "display_name": "TableBall", "keywords": [], "long_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.", "short_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTIN
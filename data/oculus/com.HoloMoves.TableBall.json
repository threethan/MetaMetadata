-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcVLhywIaeSDZCs3FDq1ClTv9A04jXRXGgZdEtd8TIRA&oe=6B005EEE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl3YzVmXwgEQ7kNvwGWZyML&_nc_oc=AdrJmEVAR7ImGE5DpmhMQWa3nd3SXRX5ngHNmcs451ciEYkUx1U4AtVMqw_ksI5cp0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOKaEeQZGLWuKhwLxUgpP-mm9FUMGMn3U8qLps90slKw&oe=6B00608C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivQHUi6-v3kQ7kNvwFy37eX&_nc_oc=AdqJzWWOarwDGz4M719Gz4POZO9hzvS8Hgi8EJWpEf0uO6O-CC0eD62oHEskzwrdjVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKRd_DjNlqqjW0f2by_jt5axwsMureaS67ES0FKaNsyA&oe=6B007DC6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2COk6xX44XwQ7kNvwHsNGxU&_nc_oc=AdqR9SOiixvHFp9b207wL1u3coOLul-Hp9Rt6YIDfJIznuuMUYiMawYNPZefgavgWUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTer6ZjCHQS8hzAAN6rWAHoyx8uygE8UqKhEQiNbvz2zw&oe=6AF8778C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRWrqcvWKakQ7kNvwHqcx5O&_nc_oc=Adq3-I_aLNl9gB1dJ4fYA53rbN4xykeWcjQE7JqHSnPL21Lpl2qWEi0TUHXOFmaic_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlMwwe0ssy2yvCxPWQ1DR-XUX2tOUJSm8WL4kQoFLZYg&oe=6AF894C6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holo
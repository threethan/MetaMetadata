n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUT0VpD2orUQ7kNvwFRtWEs&_nc_oc=AdoeCEb3bzt5io_Jj-02YOOwyQO_a5WSmOEzfq5T7yyUaiO54IKEjz22LxTkeRLXHs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmeP1yqT4l9_lwY_2NfsBD1GAkkzUyGc9c9CRYYryroQ&oe=6AF5D48C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRWrqcvWKakQ7kNvwEEL6J2&_nc_oc=Adp_Tgedl6Lj5Gbemi554qPHguIYTHwPSYOiTyTYUJzL4e7n5wqKN9HB2-N3yKFKjD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgYoYplohOHYvSMaAf5KAyRYB2vFkjV0I94WRpdVg9rw&oe=6AF5F1C6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holo
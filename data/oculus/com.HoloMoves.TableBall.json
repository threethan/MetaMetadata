QDTtsLyCaDu3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpkfjhgLujhbNJbylByBqfH5n-8xTd3z7sjHg4iVKykQ&oe=69B2A0A2"}, {"file_name": "screenshot3.png", "id": "302981139432513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_302981142765846_4015045250399538610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdyljVs5UHYQ7kNvwH-tn-c&_nc_oc=AdlKbTkQfyvLsV9nlkej67EBOo4zY0g8j55ixrMkMq036JgVz453WNy8N3UoothG_6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMpxo6HXQHQ_B_IYm09TC9R2xsb2Ard76e1Ni1mLh_cg&oe=69B2A86E"}, {"file_name": "screenshot4.png", "id": "697657545817259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031569_697657549150592_9084133421503538669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S3C1K6K25cQ7kNvwH9UnVy&_nc_oc=Adm0zfR3q7Mby_FbwGO0yqk0cgtoImZpkeztWwHxf6mxjfatXvUVBWkd_vwKb8pUyvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGuZdHXc50vxSiCFbzJHmcoufv6h_eVO-6zSQ8uO2s8A&oe=69B29B2E"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l6fgBcprT8Q7kNvwE9Xk0h&_nc_oc=AdkDWWqMwVX_oo_3fYpApXADZMEKjiptkhmoDYuk9Cpr9n_DOZ-3J86TvrS1wPYI5VY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7j3bv5fC9QfytzPg0LB6vgUTd_esMUcpPG2QOzxhRRg&oe=69B29CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20tOMAz9DnIQ7kNvwF_dldz&_nc_oc=Adk8SYtWLyvpj4_KozCeIyfl3LcgtSX_oIRPL3LDjO5bJUPwYe3KBi-lRSZZIcYBUyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyI1JtzXgYvNkt9J7lXRK_zijTtu1L-PxGNBQkcRWDQdA&oe=69B2BA06"}, "display_name": "TableBall", "keywords": [], "long_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.", "short_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7132987440113407"}}]}, "scheduled_offer
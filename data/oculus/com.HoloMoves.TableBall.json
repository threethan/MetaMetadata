-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJXBvOsZAh3v2q59koAPwGbzmnttzVASZHRpmMr8jeQ&oe=6B0847EE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3_r1C0tmssQ7kNvwF02sug&_nc_oc=AdpaBWc5G2009KP764owLv8V9SU0MUykJRNxEKwzUmrb5_uX2G6kRc8dMcJNOTeFkrk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmiOZ17P2ODXb1m3MdDSG9k8VV6uMVnmGoGtKW4sN3yQ&oe=6B08498C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRQHWmI78ioQ7kNvwHqztTI&_nc_oc=AdrRo9VN4Wp4Z8WUPLPYiPJ0fJeIDS3m_sLYYkJCAm3BggVYLZCVPueTZZKmBi2fxRk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTeXWb-7Uz91u39VDeVEoCtHu2L4Zk6mAHmGeaM50wVQ&oe=6B0866C6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
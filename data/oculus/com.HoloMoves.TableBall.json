-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtsYkuVgojqo2qdys7e3H3Cz2gsFtrYfjBKEgF53ls9Q&oe=6AFC6A6E"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrTOpqdQAaIQ7kNvwFI3gJW&_nc_oc=AdqauWB_FN3uNlKjB-njK7G4gtkASh28UgL97sA3SKhNBcLoGJX5NtMwrPPuly4V5B0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGX-tjSjA5jOMfh8oPQjOjA_O7pEnBypP09FeaCtz6BA&oe=6AFC6C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im0sH0J2zt8Q7kNvwGiSJCe&_nc_oc=AdqG9aVCEqi1hpuxV1UmGl0w0Yw4Y4d-JbebAqoEBdMJqkZZ2hzDse2YgOgEvhgtO6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOXNlv5fnb9G-vQBwVmXvoWF6cEbA8v11Y4TlzRWcK2A&oe=6AFC8946"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
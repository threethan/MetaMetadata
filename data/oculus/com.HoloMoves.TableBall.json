XWUtjiGcQ7kNvwF7PpMR&_nc_oc=AdqvKASP5UXTZ4OoQtoZTBOCrMohPoJ9zg6N3K9kHaPlKUQRBWRUECd-eAT6K8WpYr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3VzxGsx1Zhbd2zL7Mn_cXKoewTuluNVLq2M78RE4LgQ&oe=6B10692E"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcwi52WTsYYQ7kNvwFnAtdi&_nc_oc=AdpbAZXuuettkdq9aLAdTgT_wSArg3aE9bzEnwUaXYd4dbIu6TJvAfGRpNclBiuLFJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWZKI7DRbq__TMgZEa_BQIA4FsQyHs3WDZ4QE4Q2hsdg&oe=6B106ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jMeZT3cirAQ7kNvwGG9Mz4&_nc_oc=AdqvsI0jYI-pI6nXqKfF1ZChs6U9DtlST-nOHy2VvBCABt2s7-EXw84hNkgmFdClHKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIPwVnIKsujXn5JiPx-ljycYHrBOdSXKkaVxkeynf12A&oe=6B104FC6"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://holomoves.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "nl_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28606633435655497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_976582714074080_1356851658336440168_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmBF2QyifeQQ7kNvwFltWwf&_nc_oc=Adrgtq2HZ1d-HOadpo6vObRbU84EfeR8vr4OKcIhCayjjpcGTPuqayG8wPENFGqJUMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCz--rUw6epAZnsvlUkfLWFOKNjA1773ijMN_eRdgn_Q&oe=6B1040AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TableBall", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1rPqlS4i-qdzaivGx8D5XLgTg8Q3v7oWOntAAJXYt0w&oe=6B01E8AE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl3YzVmXwgEQ7kNvwG4vi3_&_nc_oc=AdrFSmN4R-grOAkdZSxyi-pNzUjHRGPPFaPvdscEh2bqNXLrkhFae9pbKMX5z-3tVnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwF5RkPen46WpVb9ZFt4Hfq-UZRRBYM4OGsL1wm42Dxw&oe=6B01EA4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTmzo_ULig8Q7kNvwGJ18_a&_nc_oc=Adqc3-pOf3snKIT-e5r4vAa7jNe-i4CKoY16gzuVjrKrH5vdoNy_03xnWUAtRKS2FDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUrQkT1utmnTH3Rqqw0KkhAV8VhSGKi5TOAwrV6OCyPw&oe=6B01CF46"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
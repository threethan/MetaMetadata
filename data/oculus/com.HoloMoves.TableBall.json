ZKpgxtMOMzhrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSfjqTWBNVcG_FO2piXXw9MaBtT36l3TH8lbt_4ZWnXA&oe=69B3F222"}, {"file_name": "screenshot3.png", "id": "302981139432513", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_302981142765846_4015045250399538610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPxK20FCkV4Q7kNvwE3BMB7&_nc_oc=AdkSrnGUuZkYywpybGUvMuzS9roBxFJEfSfP6tB8qAQiqNfawuhJqKq2fraLqM2RAmA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwj7NJD07QFAjntoMDiWKSozeLw2HTFj2B8UqIXihotsQ&oe=69B3F9EE"}, {"file_name": "screenshot4.png", "id": "697657545817259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031569_697657549150592_9084133421503538669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S3C1K6K25cQ7kNvwGYUV9f&_nc_oc=AdmGLNAgzoZbcT3MseILtSzVMr8-FDuLNuact_7oNhSaJNBaNL98HqmRgYvTBFtrilo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwib78IMh7Brx_2jAa1x0nm4baVlnVfBU4kUriQcjEsVQ&oe=69B3ECAE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l6fgBcprT8Q7kNvwGXu6iD&_nc_oc=AdlCntCrsrhwVzNtk0WOeSEC9D8sQXuf0yn8uZm0PQ0lEgBBRsW52T2TotdGqZRATHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYBNftLVTDTNGbKAojMEURyrrBSjJUF3w5xm7YpiVfRg&oe=69B3EE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20tOMAz9DnIQ7kNvwHXxt_X&_nc_oc=Admp65vWDJyGoOMRv5iZliLLon8C1aUyFuvkWe5YvhK1oxqtKrRMAQscyUO_T1WVNnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzykA625dlqrsKrb65exoNc1hR2NhHuYkF5Adtams3Z6Q&oe=69B40B86"}, "display_name": "TableBall", "keywords": [], "long_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.", "short_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7132987440113407"}}]}, "scheduled_offer
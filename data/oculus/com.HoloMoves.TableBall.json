-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ95cAFjZpDLiEj1MgSVeF4oD2vqzWj95P5xWgsd2gXQ&oe=6B09D1AE"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3_r1C0tmssQ7kNvwHLSoDJ&_nc_oc=AdqyBpxlXWIkpLTiouHunE-EoREMMWXNvodFMRoHuHjKBQomS6O0tTFEZFa3TXCEfso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvMpWT-aAvoYiXc-lZcxmVIRHi3FQa_2QXuLs_V0IrPA&oe=6B099B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHCq5X92yBQQ7kNvwEKAGV-&_nc_oc=Adrfte5kqbjAeKg1-twZhUaXkdBfFyQZM-4jD1UjupuJpBeT8k2qF8x4Itw_b-Ggpjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBp6hSHokg81_Wq1JuoVKaBsFiE3khzH1wa93k6jdhww&oe=6B09B846"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
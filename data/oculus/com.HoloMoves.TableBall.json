ohc=SicswWhDeNoQ7kNvwFoubA_&_nc_oc=AdoLYL-Gh01DWpFKkdzAvaAbyQXafve0laMDxWS2rMwdXlTDXvks6Koh1mQjdPzjBNQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RgxuW7CTNbzQuzCX981N2pDLagYxxGNIDsSf98CbN2w&oe=6A0C6006"}, "display_name": "TableBall", "keywords": [], "long_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.", "short_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null
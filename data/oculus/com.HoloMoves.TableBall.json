-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjsN3LaZB-eU8PnEhd96cgc2ZoAe0dtH-OzONaxOHb1g&oe=6B06F66E"}, {"file_name": "screenshot5.png", "id": "894905578797895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3_r1C0tmssQ7kNvwEfqalg&_nc_oc=AdqYRFkVeDvVtd-1WnjgaDhAgpp1dJHM90RKBKWalIlusRVolg92LUYsowSo08L9zyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxnQbvGkYf0kmXntn_Q-tNlCXMWe7EMXiB_yx3gi5mSg&oe=6B06F80C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRQHWmI78ioQ7kNvwGmBZu8&_nc_oc=AdrQWpts4hRSyxplPzFJMcoFreJzp8vig69jWvil9o_YZOUSq7kP1-3wSf4sviW3_Xw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUXx1bygeO0_hLca-14mU27FgRsuKB18rOc1SsLYWIWQ&oe=6B071546"}, "display_name": "TableBall", "keywords": ["holomoves", "tafelbal", "holo", "moves"], "long_description": "TableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.\n\n**(!) Tableball is part of the HoloMoves rehabilitation package. This package includes many games for physical rehabilitation. Get a personal license and learn more at www.holomoves.nl/en**\n", "short_description": "TableBall is a physical therapy game specifically designed for arm-hand training 
: "894905578797895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269157_894905582131228_448450545322347244_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrTOpqdQAaIQ7kNvwHj9m0F&_nc_oc=AdpTbfeQB0P-ps6-m_hprW6U4Ou-o1_UpT4eZeEJo-L9RxQ53p8tWVFrsjn2BSovtV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHfVR-91afVkfP0ZOtRvHsrACKZfubzhiBFJ7QiK5rYA&oe=6AFDBD8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FirstFrame.png", "id": "347211281466264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_347211284799597_2383655566166517173_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivQHUi6-v3kQ7kNvwE3FqIf&_nc_oc=AdqDdNRZYz0qaZAkjTqgvuBlOrOwc8of65ooEFv7HYkxMBgvxpXc2CasZWxUjA96lSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEbTZ_DUIvuT2oXCSYT8EUbrN5rCQK6UFbeJHQlHPx6w&oe=6AFDDAC6"}, "display_name": "TableBall", "keywords": [], "long_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. \n\nTableBall makes use of a complex set of parameters constantly tweaked based on the performance of the player. With these parameters the game is able to assess the capabilities of the player and change gameplay accordingly. Thus making sure each player is training on their own level.", "short_description": "At HoloMoves we make games and applications that help patients regain their mobility and quicken their transfer from the hospital to back home.\n\nTableBall is a physical therapy game specifically designed for arm-hand training during brain injury rehabilitation. With a quick setup, the patient can enjoy an understandable and easy to learn game, while unconsciously training. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves B.V.", "support_website_url": null, "website_url": "https://www.holomoves.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7132987440113407"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "711208841273825"}, {"status": "PUBLISHED", "id": "2384115061795509"}]}, "baseline_offer": {"id": "711208841273825"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748856960, "status": "PUBLISHED", "id": "711208841273825"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28495319453453563", "version": "1.3.2.5"}, "id": "427561402936702", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7123283674417117", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28495319453453563"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "427561402936702"}]}, "change_log": null,
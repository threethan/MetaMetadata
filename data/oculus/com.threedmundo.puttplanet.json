aUqkocT6thdf3lMnajZk_2DREPDA7sP0GqSYsOg&oe=6AFDC689"}, {"file_name": "11_desert_cup_closeup.png", "id": "1883547862621169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_1883547865954502_1629189449945505309_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sblr94QriYsQ7kNvwHwpt2e&_nc_oc=AdqY9MVB6ZpDHpkD-_kpgs8-8vuRsMVwAgUG3k2O41R1thHgcjX9xIXYvglX3zj5Ex0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFvVE1eNtQse08MwzoCXj-bz8Yh8QHI97qTAkVvdIspA&oe=6AFDDEF8"}, {"file_name": "09_achievements.png", "id": "1076684715147845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312369_1076684718481178_5797633163003138331_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcomHKG2cfQQ7kNvwEgETKN&_nc_oc=AdoSdnHUI-FfLAmRtTu86HijtOCMJJwm-UWV_t9CsW2lMO3fhV2CbA1HEiyKTQsOi0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThF_1gfupPhSlqia4SM1X-66LAkHowqLvN2EfBiL88jQ&oe=6AFDBF09"}, {"file_name": "02_snow_putt.png", "id": "2170422813688556", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313105_2170422817021889_7730528162576461026_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RWCdzsClS8Q7kNvwFXzF80&_nc_oc=AdrFe2bHFLH-5tjVJjh2qPZq8dBSvzOBViPfa61brEJJPyr7-HHIv5G0nUsipL9aUN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPQZQjwt1FIGxboT4M2SRxV3GdF0mv1NJclwKqMioELw&oe=6AFDC8F9"}, {"file_name": "01_forest_putt.png", "id": "28938715735816391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303116_28938715739149724_1936597348630175540_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t19-TBJHNhUQ7kNvwGkxiza&_nc_oc=AdrQG96N3Rf2nhi9Dp_d5qTGRUBvXrHa7Srayd2U9Cme1jdHGZ1_F1wwPZSsKOVZqgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStOBaOtGIHOrwnaZBNlcGfY-n381zHuhs_v7KR7Alkhg&oe=6AFDB8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2852110838491584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294603_2852110841824917_3152015662747182213_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjloglSbLmQQ7kNvwEiZKuL&_nc_oc=Ado64ky1d4UKBeCZd3pqdTNiMd_zzKqbT0dTUsAMeWZZbeYls1CymI6LpoNuyki-Qu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj3fSnLsZiISJSu7uqkqx8yid3oJIa1jdnOVP_st3ilg&oe=6AFDC810"}, "display_name": "Putt Planet", "keywords": ["minigolf", "golf", "putt", "putter"], "long_description": "Tiny worlds. Big putts.\n\nPutt Planet is mini golf played with your own swing. The putter sits on your Touch controller and the ball rolls with the speed and direction of your stroke: tap it for a short roll or swing firmly to climb a ramp. You feel every hit in your hand.\n\nTHREE WORLDS, 20 HOLES\n\u2022 Whispering Forest: 6 holes of sunny pines, a castle gate and a sky bridge.\n\u2022 Frozen Peaks: 8 frosty holes shaped like the numbers one to eight.\n\u2022 Golden Dunes: 6 holes with canyon jumps, dunes and a sandcastle.\n\nSTARS, MISSIONS AND REWARDS\n\u2022 Earn up to 3 stars on every hole, 60 in total.\n\u2022 Take on 3 missions per hole, 60 in all: hole in one, under par, no wall hits, beat the clock and more.\n\u2022 Climb 13 player levels, from Rookie to Putt Planet Legend.\n\u2022 Collect 8 ball skins and unlock 12 achievements.\n\u2022 Finish a world to unlock its course tour: every hole in a row with a scorecard.\n\u2022 Replay any hole; your best result is always kept.\n\nCOMFORT AND SETTINGS\n\u2022 Teleport with the thumbstick, with an optional fade.\n\u2022 Snap turn (30\u00b0, 45\u00b0 or 90\u00b0) or smooth turn.\n\u2022 The game can take you to your ball when it stops, or press A or X.\n\u2022 Putter in your left or right hand.\n\u2022 Height setting for seated play (up to +40 cm).\n\u2022 Optional aim guide line.\n\u2022 English or Spanish, switchable in Settings.\n\nA wrist display on your free hand shows the hole, par, strokes and missions.\n\nSingle player, no internet needed. Progress is saved on your headset.\n", "short_description": "Tiny worlds. Big putts. Swing the putter for real with your Touch controller: the ball rolls with the speed and direction of your stroke. Play 20 mini golf holes across three worlds: Whispering Forest, Frozen Peaks and Golden Dunes. Earn up to 3 stars on every hole, complete 60 missions, climb 13 player levels, collect 8 ball skins and unlock 12 achievements. Move by teleport with snap or smooth turn. Play in English or Spanish, no internet needed.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/Hn2EWY3r2VdRpSrJw59q5t", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/Hn2EWY3r2VdRpSrJw59q5t", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1143737644759004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296125_2076825322929690_6569458348559697993_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzZx8ZsR21gQ7kNvwHiTFng&_nc_oc=Adqr2-z6s_gGBC0F3Q_gWJoeXL8CahuBDv19FteS7odYqPGDCvGo1eaYoFuv-2nC-7A&_nc_zt
name": "3.png", "id": "1502237937973051", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1502237941306384_5859348401817272728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvs9QDMsfBMQ7kNvwF-rFLX&_nc_oc=AdrCGrl3EnntAZgktY_d-hZfqHhOpI99EDepkmKdTBCZyTEVhaCI-Jq_y3tm3A9gZis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBieuSwOnrCtGy_vJUUjZvUEt_yQKgapp4glZbhJoHAdg&oe=6A69F19A"}, {"file_name": "4.png", "id": "1484606185892854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1484606189226187_3617687122106253372_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fIgjVrAz1AQ7kNvwHJw9Hm&_nc_oc=AdoXv_NNXv3PE85PlpomVF32o5i-jYl8_19NzmiSv0kzf-qA4r4KcdyeBRYrXDeZuqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbsGxklxtvG0ab0gZuHtnb4AzvdXw3XcSLW8RS4pq3lg&oe=6A69F668"}, {"file_name": "5.png", "id": "2864851830520991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_2864851833854324_8711515876514846322_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4b7tRs0rtMQ7kNvwEOrGvZ&_nc_oc=AdocRUrdHjsE5WKOV9D2WzpxRcU6r8DmL4ji4CFwYR7AV0zxUdDjvHG5jS9asqsElfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzZGv2zN6uWJv-yU7B5M0hncYt4Ns7jO0jLyjmnwihWA&oe=6A69E2B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Focal Point Presence", "keywords": ["livestreaming", "sports", "music", "theatre", "presence"], "long_description": "Focal Point Presence is a technical showcase for Focal Point VR\u2019s immersive live streaming technology.\n\nThe app lets you experience selected VR video demonstrations captured using FPVR camera systems and processed through the company\u2019s live stream processor and Segmented Fidelity Streaming workflow. The goal is simple: to show how high-resolution immersive video can bring viewers closer to live events, with a stronger sense of presence than conventional flat video.\n\nDesigned for Meta Quest headsets, Focal Point Presence demonstrates how FPVR combines specialist capture, real-time video processing and attention-weighted image packing to deliver detailed immersive streams within practical live distribution bandwidths.\n\nContent may include sports, music and other live production examples, presented as a demonstration of the technology and production workflow behind Focal Point VR\u2019s live event platform.\n\nFocal Point Presence is intended for viewers, partners and event producers who want to understand what next-generation immersive livestreaming can feel like in headset.", "short_description": "Focal Point Presence is a VR video showcase from Focal Point VR, demonstrating high-fidelity live event streaming captured with FPVR camera systems and delivered using Segmented Fidelity Streaming. Step into selected sports, music and live production demos designed to show how immersive video can make remote viewers feel present at the event."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.focalpointvr.com/app/", "developer_terms_of_service_url": null, "publisher_name": "Focal Point VR", "support_website_url": null, "website_url": "http://focalpointvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27430863603178559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_17139
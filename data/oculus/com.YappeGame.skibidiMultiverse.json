B69"}, {"file_name": "ss2.png", "id": "391059557210415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974635_391059560543748_8677387930682950639_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_6JIMJ95xoQ7kNvwHoEXJm&_nc_oc=AdoyTA34IBcgyzDpUsg4QJC7A6O1fIjFcvo4hEUsC6vi6yqzjCfkl4fWiegt34pqTmw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpmUH8x4H1hhySQXJnMyjMZpVAvdoNOtPlHD3jYV-c3Q&oe=6B0B2C3A"}, {"file_name": "ss3.png", "id": "384303254489520", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_384303257822853_2566801648190974262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9iWD54hhQgQ7kNvwFaQBl6&_nc_oc=Adq6wWzg5pTjX04TVX38Jz-_SxregVK2M0Pdriy1dCcLQATaw-4NomxQOag0YXKTLSQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpFGcD9z5S07lzGSI-oDt1hokFC0rGT09ofhw8qaz8jg&oe=6B0B2536"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "phoskip.png", "id": "919919656265313", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203626_919919662931979_1300921986767704861_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIMzX1g9hWUQ7kNvwGn-l4z&_nc_oc=AdrdQABzkMy8rN6gUrUHxN_LZmyl1CAftPMNbzLWneFssN6_-otoLhxnDPDAvmbA1QM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgw6HcYCfr6GrJidUdeGj9eTwoVCczByzBYMc6Dtbe9A&oe=6B0B2265"}, "display_name": "Skibidi Multiverse", "keywords": [], "long_description": "\"Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes.\n\nEmbark on an adventure unlike any other as you explore vibrant and surreal worlds, each with its own unique challenges and obstacles to overcome. From the neon-lit streets of a futuristic metropolis to the serene landscapes of a mystical realm, the possibilities are endless in the Skibidi Multiverse.\n\nUsing intuitive VR controls, players will navigate through dynamic environments, shoots, and engage in thrilling platforming sequences. With stunning visuals and immersive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7409320715791155"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "4404404303145507"}, {"status": "PUBLISHED", "id": "719732964030711"}, {"status": "PUBLISHED", "id": "742184502183500"}, {"status": "PUBLISHED", "id": "1445527009957335"}, {"status": "PUBLISHED", "id": "6844926085613889"}]}, "baseline_offer": {"id": "6844926085613889"}, "is_approved": true, "firstOffer": {"nodes": [{"start_t
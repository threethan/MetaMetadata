v/t64.5771-25/75203626_919919662931979_1300921986767704861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkU8Og2ppxsQ7kNvwHP7n7D&_nc_oc=AdpgLb3Huue-NvyQ0WAWQDUato0c-zIUJJB-cc67BEieTCfzmEUVyquonN2BZyrkfgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhtPJZIRDW7t-CBE3-EOb7RCGUm3nFhQuva0qnLYTO5w&oe=6A637BA5"}, "display_name": "Skibidi Multiverse", "keywords": [], "long_description": "\"Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes.\n\nEmbark on an adventure unlike any other as you explore vibrant and surreal worlds, each with its own unique challenges and obstacles to overcome. From the neon-lit streets of a futuristic metropolis to the serene landscapes of a mystical realm, the possibilities are endless in the Skibidi Multiverse.\n\nUsing intuitive VR controls, players will navigate through dynamic environments, shoots, and engage in thrilling platforming sequences. With stunning visuals and immersive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2
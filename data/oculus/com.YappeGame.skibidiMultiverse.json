sive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7409320715791155"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "719732964030711"}, {"status": "PUBLISHED", "id": "742184502183500"}, {"status": "PUBLISHED", "id": "1445527009957335"}, {"status": "PUBLISHED", "id": "6844926085613889"}]}, "baseline_offer": {"id": "6844926085613889"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765656000, "status": "PUBLISHED", "id": "719732964030711"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7417469474976279", "version": "0.3"}, "id": "1116764789336376", "channel_name": "LIVE"}]}, "is_for_oc
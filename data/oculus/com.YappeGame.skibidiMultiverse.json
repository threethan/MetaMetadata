1A9"}, {"file_name": "ss2.png", "id": "391059557210415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_391059560543748_8677387930682950639_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_6JIMJ95xoQ7kNvwGtrld2&_nc_oc=Adpr3UxMBSbz6CK7-2EUs7BOY_2HKYG3AUmJVuqiJBjnCNQCNquSHczLYN4qjok7v88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRPMNGja_XqnsSY22PU1u8KMs0swd_WV1HFttBLmgCIA&oe=6B09A27A"}, {"file_name": "ss3.png", "id": "384303254489520", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974858_384303257822853_2566801648190974262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9iWD54hhQgQ7kNvwFXNUUK&_nc_oc=AdqX8sIHOXWOG2Nt91IvkRBVyVHXbbOKLqLOTPkLqbuaLCbEG7psxtvAnVL6Zy0ErKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkJ0H1fKZg7QsxbexzDrFa4wfySb1AenV9c7mHVZadfA&oe=6B099B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "phoskip.png", "id": "919919656265313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_919919662931979_1300921986767704861_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCHGrWS8YswQ7kNvwHjSrKT&_nc_oc=AdrmYM_4Ehp_31Lh_5WlHFoRGNkRDJQ6BcDzEciVdBQziRd4kpO-9b-Ai3my5j3Ons0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTNakLp5g2-bxOqZ3IEY_7TdsEu_bMnouv99ve9g5vyw&oe=6B09D0E5"}, "display_name": "Skibidi Multiverse", "keywords": [], "long_description": "\"Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes.\n\nEmbark on an adventure unlike any other as you explore vibrant and surreal worlds, each with its own unique challenges and obstacles to overcome. From the neon-lit streets of a futuristic metropolis to the serene landscapes of a mystical realm, the possibilities are endless in the Skibidi Multiverse.\n\nUsing intuitive VR controls, players will navigate through dynamic environments, shoots, and engage in thrilling platforming sequences. With stunning visuals and immersive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7409320715791155"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "719732964030711"}, {"status": "PUBLISHED", "id": "742184502183500"}, {"status": "PUBLISHED", "id": "1445527009957335"}, {"status": "PUBLISHED", "id": "6844926085613889"}]}, "baseline_offer": {"id": "6844926085613889"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765656000, "status": "PUBLISHED", "id": "719
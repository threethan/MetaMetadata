"file_name": "ss2.png", "id": "391059557210415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_391059560543748_8677387930682950639_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUZj5z0V3QsQ7kNvwHiAlLd&_nc_oc=AdoHWVjNaJPM5FMck-FOl9jBGYR_NjEgPNnTjcG_cBjfvkjJ0t3QPnJgICSxywWseAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3CIN-PGJdaYARwpdmHIW42uQLapY_Wd6_I_3kn99Fjw&oe=6B030AFA"}, {"file_name": "ss3.png", "id": "384303254489520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974858_384303257822853_2566801648190974262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX_VbW1o-_QQ7kNvwEUuwmd&_nc_oc=AdoIaY61DhjXkBGMg7Mbj4hpwJhGwiJw3not7PxVnWzeBtNv-jrXTECoRvWQaZj49ao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9EgXNiEro56UeCkE_bToozRpR38zxac-aFPC4EEM9kQ&oe=6B0303F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "phoskip.png", "id": "919919656265313", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203626_919919662931979_1300921986767704861_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDMMgY9OBSgQ7kNvwGIjJnv&_nc_oc=Ado4aPa16baTCffHDBrnFJtcCwhGw2Vru9gEI7qEVSSD8FmVXtBgHZkg8XJtpDc1iSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF4I_vjOMYWJeaHfUT2Vvntpb6rBBOYliXf7vtZI4KgQ&oe=6B033965"}, "display_name": "Skibidi Multiverse", "keywords": [], "long_description": "\"Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes.\n\nEmbark on an adventure unlike any other as you explore vibrant and surreal worlds, each with its own unique challenges and obstacles to overcome. From the neon-lit streets of a futuristic metropolis to the serene landscapes of a mystical realm, the possibilities are endless in the Skibidi Multiverse.\n\nUsing intuitive VR controls, players will navigate through dynamic environments, shoots, and engage in thrilling platforming sequences. With stunning visuals and immersive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7409320715791155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001676_932498351615776_8597227352026858253_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1RAxEALe04Q7kNvwE-RyUR&_nc_oc=AdqcTXk1LGuEoOSNk9JHE1xdNgn3aQ9kDj_NizbdoDKojGnBCQu-nHp3aqXhDCr2y8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh
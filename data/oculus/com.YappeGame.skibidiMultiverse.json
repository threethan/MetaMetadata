nc_ss=7f20f&oh=00_AQQG-6KwHfOAqIr2zQcQMmWFfjofvCnody9TCviGXHLEAw&oe=6AFC737A"}, {"file_name": "ss3.png", "id": "384303254489520", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974858_384303257822853_2566801648190974262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKrTLC0Pc-cQ7kNvwGcm-uB&_nc_oc=Adoa6LmCRr12bc-Nay5dyIpSZRTLpOxOE8p8H4Hx58Ct2VEwZICL1A5qW_iE1qO6d0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVMmHQ8_y1yUUlGoXXCyHB-cwJP4yidMqErZ2dTJmQLg&oe=6AFC6C76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "phoskip.png", "id": "919919656265313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_919919662931979_1300921986767704861_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mby6CQDNceEQ7kNvwHdTRNZ&_nc_oc=Adpbd_zbI1DvajJBOs4eHe-dzbket8jHk9Vbwr4By2THMq3q-vmyLCHsy49Bvo-9Vj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvq7jkwZ7LA6DAcysJgJQtyWIfyA56vZ9zXynwmKfB5Q&oe=6AFC69A5"}, "display_name": "Skibidi Multiverse", "keywords": [], "long_description": "\"Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes.\n\nEmbark on an adventure unlike any other as you explore vibrant and surreal worlds, each with its own unique challenges and obstacles to overcome. From the neon-lit streets of a futuristic metropolis to the serene landscapes of a mystical realm, the possibilities are endless in the Skibidi Multiverse.\n\nUsing intuitive VR controls, players will navigate through dynamic environments, shoots, and engage in thrilling platforming sequences. With stunning visuals and immersive gameplay,.\n\nGet ready to unleash your creativity and explore the infinite possibilities of the Skibidi Multiverse!", "short_description": "Skibidi Multiverse VR\" is an immersive virtual reality game that takes players on an exhilarating journey through various dimensions. In this game, players will step into the shoes of a Skibidi, a whimsical character with the ability to traverse different universes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yappegames.wordpress.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "YappeGame", "support_website_url": null, "website_url": "https://yappegames.wordpress.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7409320715791155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001676_932498351615776_8597227352026858253_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enk53GI7IZ4Q7kNvwGjjLsp&_nc_oc=AdpQXnkZrA4DHRWO2vTAjR6_nKuucxrDm6anqO3Lo3-W0MGv-iu1WsiGqsSSerf9PF0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-B0s-tpo6CvX8ee_M8h6cH1nfGUyBYm7al-EJykA1qQ&oe=6AFC6FD7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skibidi Multiverse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 17105
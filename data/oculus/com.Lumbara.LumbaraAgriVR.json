ence_002_0202.png", "id": "2479806042389555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618435_2479806045722888_34202740635412357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rb6iy5uaKgQ7kNvwGqXa53&_nc_oc=Adks0cOwsDEd_WSMyBHntgF2h_NrZdV2_3H4sHREIbisPePvjpYKg45xhAFI_tbqb2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfycEJv4sOzCcvwiAQXRWJvTSsdL21FcPVgeq915cdhp-A&oe=69BBD975"}, {"file_name": "Image Sequence_002_0164.png", "id": "1444727413316386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619486_1444727416649719_9050930325655200231_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMLQ5ZSu59kQ7kNvwHihUFo&_nc_oc=AdkTaUMsAW5oH59o_msQ-YQ4G2R9-0n-U4FxUr296FFXbGiimcTaygKq63fdX5cF77I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgPI5-GYdtkPwWiNfRHffwK5zzKq8SFFBKAkDeNsENiQ&oe=69BBD99C"}, {"file_name": "Image Sequence_002_0219.png", "id": "1300982138362479", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_1300982141695812_1276467806814730156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SwjSbo1JUYQ7kNvwHyxbse&_nc_oc=AdkDUJSA-OkjJ8YCEV_tpec09Wvrid0PjHlw39qXKo03RcjDvkTi_l8Bruk_AFzlp1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxotqomXUfHr3JmrwnAfbXz_zvIF76inqXjpEL2INdLKQ&oe=69BBDD34"}, {"file_name": "Image Sequence_002_0153.png", "id": "1053558466935101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625998_1053558470268434_7716424703309304316_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApqqNi2I7rkQ7kNvwEBP9xb&_nc_oc=AdnOd8LrHCfMjlXtfwP4W4tazNdz-V1nW7n8VH61whu8dwOEONQVw3pIvfz8omTJB6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAnosyn2FXGCUF8G9v8q_43iJzqRoM_flNyL4yUbbwwQ&oe=69BBECCF"}, {"file_name": "Image Sequence_002_0181.png", "id": "1128984299053645", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_1128984302386978_7938653434585531751_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kik9mvxf5x4Q7kNvwEi7RJ4&_nc_oc=AdnFPKwOLemJcIv9Av_sCMnHAZyzU358jden6fBqfiYd6O3XDzO4-SAWIGchrTSyPOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrecTk2eWw8FZyYuNH50thu9oIko8olpr2nAK90fsmig&oe=69BBFA0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lumbara AgriVR", "keywords": ["lumbara", "agriculture", "learning", "agrivr", "lumbaraagrivr"], "long_description": " Lumbara AgriVR - Complete Agricultural Learning Platform\n\n  Experience realistic farming in VR! Step into an immersive agricultural arena with outdoor classroom, experimental\n  plots, and professional machinery.\n\n  \ud83c\udf31 Key Features\n\n  - Interactive Tools - Magnifier, microscope, camera, knife, planter, sprayer, soil probes\n  - Realistic Crops - Corn, wheat, soybean, sunflower with BBCH growth stages\n  - Disease Detection - Identify rust, pests, aphids using professional diagnostic tools\n  - Collaborative Learning - Multiplayer sessions with teachers and classmates\n  - Hands-on Activities - Plant crops, take samples, prepare spray solutions, answer questionnaires\n\n  \ud83c\udfaf Perfect For\n\n  Agricultural students and educators seeking practical, risk-free training in modern farming techniques.\n\n  \ud83d\udca1 Why Choose VR?\n\n  - Practice year-round regardless of season\n  - Safe experimentation with expensive equipment\n  - Immediate visual feedback on farming decisions\n  - Access to diverse crop diseases and growth stages", "short_description": "Lumbara Agri VR - Learn farming in virtual reality! Step into immersive farm environments where you can practice crop \n  care, identify plant diseases, use farming tools, and plant crops safely. Train with others in multiplayer sessions \n  guided by instructors. Perfect for agricultural students and farming enthusiasts wanting hands-on experience without \n  real-world risks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/91691489-8945-46bc-8b4c-2fc697542b8e", "developer_terms_of_service_url": null, "publisher_name": "Frontier Connect", "support_website_url": null, "website_url": "https://lumbara.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ro"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26074211918829903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619159_604003759413988_8843941979314298536_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94pBN8B1a-YQ7kNvwFX4s9t&_nc_oc=AdmFKTR8dAsfpTqwf5W5IzkuvXsDpaj0ft7kOSBFEDpxxRge70LGe2lFfyAU0-rXCRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZcDCFTFGkXbsPkJ1AkTxReXO7_F9hD0OyRs4RGXnttw&oe=69BBFF7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lumbara AgriVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1752588720, "lastRevision": {"nodes": [{"id": "24613005374950572", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24613005284950581", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, 
OwTa8dYBjoDjYh43-T3Dh7A&oe=6B0EF68F"}, {"file_name": "Image Sequence_002_0181.png", "id": "1128984299053645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1128984302386978_7938653434585531751_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFCWfZP8UyEQ7kNvwGJI-RI&_nc_oc=Ado3S4a1IXA5-5iB5WIU6_TeXHLRgbtiXoqUUBhu4CVOeyEv4TIqC_xpzyw0j9a9IIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUwBiqsijcGqOjfVEM08skTdTFKoXKCamnnSd-Oe0UWmg&oe=6B0F03CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lumbara AgriVR", "keywords": ["lumbara", "agriculture", "learning", "agrivr", "lumbaraagrivr"], "long_description": " Lumbara AgriVR - Complete Agricultural Learning Platform\n\n  Experience realistic farming in VR! Step into an immersive agricultural arena with outdoor classroom, experimental\n  plots, and professional machinery.\n\n  \ud83c\udf31 Key Features\n\n  - Interactive Tools - Magnifier, microscope, camera, knife, planter, sprayer, soil probes\n  - Realistic Crops - Corn, wheat, soybean, sunflower with BBCH growth stages\n  - Disease Detection - Identify rust, pests, aphids using professional diagnostic tools\n  - Collaborative Learning - Multiplayer sessions with teachers and classmates\n  - Hands-on Activities - Plant crops, take samples, prepare spray solutions, answer questionnaires\n\n  \ud83c\udfaf Perfect For\n\n  Agricultural students and educators seeking practical, risk-free training in modern farming techniques.\n\n  \ud83d\udca1 Why Choose VR?\n\n  - Practice year-round regardless of season\n  - Safe experimentation with expensive equipment\n  - Immediate visual feedback on farming decisions\n  - Access to diverse crop diseases and growth stages", "short_description": "Lumbara Agri VR - Learn farming in virtual reality! Step into immersive farm environments where you can practice crop \n  care, identify plant diseases, use farming tools, and plant crops safely. Train with others in multiplayer sessions \n  guided by instructors. Perfect for agricultural students and farming enthusiasts wanting hands-on experience without \n  real-world risks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/91691489-8945-46bc-8b4c-2fc697542b8e", "developer_terms_of_service_url": null, "publisher_name": "Frontier Connect", "support_website_url": null, "website_url": "https://lumbara.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ro"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26074211918829903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_604003759413988_8843941979314298536_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caWOc8SQ4NwQ7kNvwEZJTjq&_nc_oc=AdrbTbCvQ9PXLaoRpkTyM-yCalRnxyIDaD6PCsG8h5FABJzTsgY1nJTWo8wphYX8wWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzjb7lCDac9Sl5oK5hLKu6oHUfMtNLhuc_Hz8Lg6msjg&oe=6B0F093F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lumbara AgriVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "3
", "keywords": [], "long_description": "BooBot is a robotics simulator with the objective of introducing learners to the fundamental robot control procedure Sense Plan Act (SPA). A secondary objective is to introduce the concepts of assembly-style programming.\n\nProgramming is via a web-interface (easiest to access on a computer); there is a full programming guide and a series of walkthroughs. ", "short_description": "BooBot programmable VR robot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ictsoeasy.co.uk/boobot/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "ICT So Easy ltd", "support_website_url": null, "website_url": "https://ictsoeasy.co.uk/boobot", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598979734403743"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036641_1706210826393133_8692856859390660050_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WytXv7GH1wQ7kNvwGCY9-f&_nc_oc=AdkREUiwKxr4CQYx1P9qNXnJJtC7YjiAtLSP7m_Pq3swlM-kmpKoal1eKPNvyQydNzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqvMA2qZuztNfqb0ziFtVWd3dZVqm4xVbA4GltGW6eyQ&oe=69BBE5E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BooBot", "platform": "A
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoTUHIvN9tn81L4v5aVwJEgQ-IBRpmX9ejYQECJzmcew&oe=6AB92BDE"}, {"file_name": "EA_Screenshot (3).png", "id": "2035035440456541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_2035035443789874_7313858712742303116_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNYsZuMkuM4Q7kNvwHYU5Qh&_nc_oc=AdqiRlhz7jmySTefQ0MlA8tHJ9_QrvwDVInJwDGg7tLxn8DJ48ght1LweWqrOs1Es-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmYzLmSCPquGQw--iWpoZEYha7EZk2GC-z4RmVaSexSQ&oe=6AB934D0"}, {"file_name": "EA_Screenshot (1).png", "id": "4658226014503136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604317775_4658226017836469_6742450730016125823_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km08Yf2EVzcQ7kNvwEBZ7iJ&_nc_oc=AdrVXFbP0LnZg1c-DzofrxJmLhwCYq5XHnk7sTagLmg5ZttvusCdjpgWpoEtLJ8h84c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1pf6c5-eTe4UkyZ6Q-H2bvpdLQa6o6osEvz47B2Jo4A&oe=6AB92FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ElvenArrows_DemoRoom_v3.png", "id": "3537210129791017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_3537210143124349_7842276523308569970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBXuLclk-jQQ7kNvwGrpJyd&_nc_oc=Adqx_oWBiIMfe9pYsZVGftsZ-DScEl06JZykfxzxCONx09Ru8TApgB37qM6eeVq2zw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkS-EShUdHBLdD1WN9gfmVhlZiZj5VctyaDqM6vpKbsA&oe=6AB90C50"}, "display_name": "Elven Arrows \u2013 Mixed Reality Bow & Arrow", "keywords": ["Multiplayer", "colocated", "coop", "bow", "wave"], "long_description": "# 2-Player co-op: Turn Your Home into an Elven Watchtower and Defend the Realm! \ud83c\udff9\u2728\n\nGreetings, archer, and welcome to Elven Arrows, an auto-adaptive Mixed Reality game that transforms your entire room into a free-roam watchtower. Draw a real bow, walk freely around your space, and hold the sacred crystals against invaders determined to shatter them.\n\n{2166280104229798}\n###\n## **\ud83d\udd2e TRANSFORM YOUR SURROUNDINGS INTO A PLAYSPACE**\n\nElven Arrows scans your room the moment you start, then builds itself around your real walls and furniture.\n\n{1421774173202589}\n\nWatch your surroundings morph into a watchtower: enchanted stone walls trace your physical room, your own furniture carried over into the realm.\n\n{1043614835184404}\n\n###\n## **\u26a1 BUILD YOUR RUN, WAVE BY WAVE**\n\nAfter every wave you choose a new power, and no two runs come out the same. Around 40 augments cover crit and headshots, arrow stats, multi-shot, fire, arcane, lightning and traps, with rerolls.\n\nAugments also raise four shrines in your room: Freeze, Nature, Storm and Meteor. Shoot one to trigger it.\n###\n\n## **Why \"Elven Arrows\" Will Enchant You**\n- **\ud83c\udfe0 Auto-Adaptive Mixed Reality:** Your living space morphs into a lofty tower overlooking the realm.\n- **\ud83c\udff9 Explosive Elemental Arrows:** Light them at the fire torches on your wall and they explode on impact.\n- **\ud83d\udc09 Dragon Boss Fights:** Hold out against the dragon that swoops in every few waves.\n- **\ud83d\udc65 2-Player co-op Fun:** Team up with 1 friend in the same room.\n###\n\n**More from 2Sync:**\n- House Defender\n- Mixed Snow Worlds\n- The Last Galaxy\n\ngames.2Sync.io", "short_description": "Elven Arrows is an auto-adaptive Mixed Reality game that transforms your room into a free-roam watchtower. Draw a bow, move freely through your space, and hold the ancient crystals against waves of ruthless invaders.  Choose a new power after every wave, raise shrines in your own room, and light your arrows at the fire torches on your wall. Play solo, or in co-op with one friend in the same room. Let your home become the final defense."}]}, "developer_name": null, "developer_privacy_policy_url": "https://2sync.io/appinfo/", "developer_terms_of_service_url": "https://2sync.io/appinfo/", "publisher_name": "2Sync", "supp
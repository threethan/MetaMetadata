oe=6AB90E1F"}, {"file_name": "ElvenArrows-Screenshots-AttackArrowSceen.png", "id": "1292546961863102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391760_1292546965196435_623054347538308539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCObjuq3lPIQ7kNvwGo5p7l&_nc_oc=AdpqENOh4s1ERAEqFiGmBZ2ZSNAeoMrWvZVbg5LoGX2VYNWgN4czGYGM-CBcfnCthg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9YphBHIY4KOoMjY_ypR2u52Tnh6DUGIbFQd6_JCRsag&oe=6AB918E7"}, {"file_name": "ElvenArrows-Screenshots-ArcherScreen.png", "id": "657756370021433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391728_657756376688099_1408238841701365635_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_d1IJLGTK4Q7kNvwFufskR&_nc_oc=AdoOBeL3fBxfIz8qONFp9PPsnZmBaFoEiECYZjjxLA6yqybqjk-oA88-ZKaImcckqHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFO9k3X9EIlxhv_SMH4dKzGK2XJBKcFSlQ0qMiswVwFg&oe=6AB90B20"}, {"file_name": "ElvenArrows-Screenshots-WaterfallScreen.png", "id": "1273463780404033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391796_1273463783737366_6221652007476876772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnkd6dCqtw0Q7kNvwHHVogf&_nc_oc=AdrT5dBIsroDm8h-1QQR2pBfngnmDgVlrgVJvYWJQZEil4T7Gx5c6zUd9ZBJAGJMp2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSSaXs5LHa3yQ1RjZuPRQZrinuXWm_AdhuAetH03eVzQ&oe=6AB9133F"}, {"file_name": "Frame 52.png", "id": "914798120520066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391817_914798127186732_7947939488759346372_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2fZ5gbxLlIQ7kNvwGrfMaj&_nc_oc=AdqZ9rC_2i_fdnnbGBsiCKvKXOwOcoIoQocOvb52u9L6CbWk-6FBiN5vXprNQJ1E4gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1cLiCsF7GB2iKsfilds_SW9x06gzE_JFUuKPoxo5L7w&oe=6AB93791"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elven Arrows \u2013 Mixed Reality Bow & Arrow", "keywords": ["MixedReality", "Defender", "Bow", "Multiplayer", "Arrow"], "long_description": "# Turn Your Home into an Elven Watchtower and Defend the Realm! \ud83c\udff9\u2728\n\nGreetings, archer, and welcome to Elven Arrows, an auto-adaptive and immersive Mixed Reality game that transforms your entire room into a free-roam VR watchtower. Defend the realm behind your walls, walk freely around your space, and use your transformed home as the vantage point from which you protect ancient crystals. Armed with a bow and arrow (plus mystical upgrades!), you must guard the sacred crystals from invaders determined to shatter your defenses. Your real-world space seamlessly transitions into a magical battleground, where every wall and object becomes part of this immersive adventure!\n\n### \n\n## **\ud83d\udd2e TRANSFORM YOUR SURROUNDINGS INTO A PLAYSPACE**\n\nScan your environment in the blink of an eye and watch as your surroundings morph into a watchtower. Your physical room, encircled by the stone walls of an enchanted tower, marks the boundaries of your game world\u2014complete with virtualized furniture.\n\n###\n\n## **Why \"Elven Arrows\" Will Enchant You**\n- **\ud83c\udfe0 Auto-Adaptive Mixed Reality:** Watch as your living space morphs into a lofty tower overlooking the realm.\n- **\ud83c\udff9 Become an Elite Elven Archer:** Hone your skills and unlock magical powers to fend off waves.\n- **\ud83d\udc65 Co-Located Multiplayer Fun:** Team up with friends in the same room.\n- **\ud83d\udeb6 Immersive Free-Roam:** Move freely around your \u201ctower,\u201d taking full advantage of your space to find the perfect shot.\n\n###\n\n## **Other 2Sync Games:**\n\n- House Defender \ud83d\udee1\ufe0f\n- Mixed Snow Worlds \u2744\ufe0f\n- The Last Galaxy \ud83d\ude80", "short_description": "Welcome to Elven Arrows, an immersive Mixed Reality game that transforms your environment into a free roam VR watchtower. Defend the realm behind your walls, move freely around your space, and protect ancient crystals from ruthless invaders. Arm yourself with a bow and arrow (plus mystical upgrades!), coordinate with friends in co-located multiplayer, or fight solo. Step into the tower and let your home become the final defense!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://2sync.io/appinfo", "developer_terms_of_service_url": "http://2sync.io/appinfo", "publisher_name": "2Sync", "support_website_url": "http://2sync.io/discord", "website_url": "https://2sync.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25584542877799688"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4286250385027467"}, {"status": "PUBLISHED", "id": "826765150135592"}, {"status": "PUBLISHED", "id": "1754683901745222"}]}, "baseline_offer": {"id": "826765150135592"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766347200, "status": "PUBLISHED", "id": "4286250385027467"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39366040936316411", "version": "1.2"}, "id": "721838226686318", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25584542847799691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39366040936316411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "721838226686318"}]}, "change_log": "Elven Arrows is out of Early Access! Version 1.2 is the biggest update since launch:\n\n- Augments: pick a new power after every wave instead of spending gold in the Upgrade Store. Around 40 to choose from, including triple shot, crits, traps and elemental arrows, with rerolls.\n- Shrines: augments raise four shrines in your room. Shoot one to trigger it. Freeze holds every enemy in place, Nature makes stones erupt around your crystals, Storm hunts the weakest enemies and Meteor strikes the strongest.\n- Explosive elemental arrows: fire arrows explode and set everything nearby on fire, and charged arrows burst in an arcane blast. The further you draw, the harder it hits.\n- New enemies: fast wolves, explosive bombers and heavy dark knights join the fight, in waves that are put together fresh every run. The dragon boss comes back tougher.\n- More of your room in the game: new props, crates and pillars that adapt to your real walls and furniture.\n- New user interface: a new lobby, a proper game-over screen, clearer damage numbers and tutorial hints for bow, arrows and shrines.\n- Sync your rooms: scan a room once and reuse it in House Defender on the same Meta account. Asks for your consent first, and your rooms are stored in the EU.\n- Optional usage data: help us decide what to improve next. No account data, no IP address, and you can change it any time in Settings.\n- Better performance, new voice lines, co-op fixes and polish throughout.\n", "created_date": 1789232680, "id": "39366040936316411", "version": "1.2", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25584542847799691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39366040936316411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "721838226686318"}]}, "change_log": "Elven Arrows - Update Notes\nNew Features\n- Improved room scanning and environment setup\n- Enhanced auto-adaptive level generation\n- Smoother gameplay transitions\n- Improved visual quality with updated lighting and environment effects\n\nImprovements\n- Better performance and overall stability\n- Reduced loading times\n- Improved tracking and interaction responsiveness\n- More consistent gameplay across different room layouts\n\nFixes\n- Fixed several issues related to room adaptation\n- Fixed various gameplay and UI bugs\n- General quality-of-life improvements", "created_date": 1780935829, "id": "37150793487841178", "version": "1.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25584542847799691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39366040936316411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "721838226686318"}]}, "change_log": null, "created_date": 1765795877, "id": "33766176189636275", "version": "1.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25584542847799691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39366040936316411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "721838226686318"}]}, "change_log": "Elven Arrows \u2013 Improvements:\n- Added upgrade store for selecting and managing power-ups\n- Added new dragon boss fight for an epic late-game challenge\n- Fixed several bugs for smoother gameplay\n- Added transition haptics for a more immersive feel\n- Improved gameplay visuals across multiple effects\n- Increased overall security and stability", "created_date": 1764593652, "id": "33548712471382649", "version": "1.0", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25584542847799691", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39366040936316411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "721838226686318"}]}, "change_log": null, "created_date": 1755789879, "id": "31836561169264463", "version": "0.95", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
OFCZ9Udz-XbnuAk7hatUNBNhoJ05bVF54OVoI-nCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJElXPiK-qo0PpsFsgkYicNlcPT4P10u04o_xxChhjI5Q&oe=6AAFDE67"}, {"file_name": "ElvenArrows-Screenshots-ArcherScreen.png", "id": "657756370021433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391728_657756376688099_1408238841701365635_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUrBNWORGdgQ7kNvwEp6lQq&_nc_oc=Ado4D_3C9Mt7ABpcVLAd-zVdg48kmoqYKhFTFJR1aSeRYqDWXUucqniHq91nnuuo--8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ824NBNWSZDMxAXSQYQevjBSCWBX0TSCPEy6l4a6JSw&oe=6AAFD0A0"}, {"file_name": "ElvenArrows-Screenshots-WaterfallScreen.png", "id": "1273463780404033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391796_1273463783737366_6221652007476876772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1BoJcRY8-EQ7kNvwFYsble&_nc_oc=AdrpyGNuxfFYDk521kLYARI3OTbHyBZdp0VpXc1Tx0T1Ho-HBpLGKb5X4Vcc7KRn1wY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1JxofmuapH4kEDzQnrKUoFgH_dBNZWOS3zzjzddTXjA&oe=6AAFD8BF"}, {"file_name": "Frame 52.png", "id": "914798120520066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391817_914798127186732_7947939488759346372_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do3mdPEuDuEQ7kNvwEwGFm9&_nc_oc=AdrgsLKUQCyNnC-IT0t5cMDE6JrUKHKNAgVYenbWvwz3b0L7EYImwkreLRoh50Hf1Co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfV0G9wQa9E9SEKtGf8cTkIHl9lESlEB2MPRxLwuGFag&oe=6AAFFD11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (5).png", "id": "605574488956887", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391755_605574492290220_5498019332859625841_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lD0mqkTnNsQ7kNvwGFMkWo&_nc_oc=Adq2HZ4I8tH7yqnyaFZ_pzgRbgjFeaNRNkJAVWtcsRgTvCP1kgLV8l6ObO93jdAsn1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVbiv3qXnpkuxW9g1TNLkII5mtfkWrB6QD2XxFZOOIYg&oe=6AAFFB84"}, "display_name": "Elven Arrows \u2013 Mixed Reality Bow & Arrow", "keywords": ["MixedReality", "Multiplayer", "colocated", "coop", "bow"], "long_description": "# 2-Player co-op: Turn Your Home into an Elven Watchtower and Defend the Realm! \ud83c\udff9\u2728\n\nGreetings, archer, and welcome to Elven Arrows, an auto-adaptive and immersive Mixed Reality game that transforms your entire room into a free-roam VR watchtower. Defend the realm behind your walls, walk freely around your space, and use your transformed home as the vantage point from which you protect ancient crystals. Armed with a bow and arrow (plus mystical upgrades!), you must guard the sacred crystals from invaders determined to shatter your defenses. Your real-world space seamlessly transitions into a magical battleground, where every wall and object becomes part of this immersive adventure!\n\n### \n\n## **\ud83d\udd2e TRANSFORM YOUR SURROUNDINGS INTO A PLAYSPACE**\n\nScan your environment in the blink of an eye and watch as your surroundings morph into a watchtower. Your physical room, encircled by the stone walls of an enchanted tower, marks the boundaries of your game world\u2014complete with virtualized furniture.\n\n###\n\n## **Why \"Elven Arrows\" Will Enchant You**\n- **\ud83c\udfe0 Auto-Adaptive Mixed Reality:** Watch as your living space morphs into a lofty tower overlooking the realm.\n- **\ud83c\udff9 Become an Elite Elven Archer:** Hone your skills and unlock magical powers to fend off waves.\n- **\ud83d\udc65 2-Player co-op Fun:** Team up with 1 friend in the same room.\n- **\ud83d\udeb6 Immersive Free-Roam:** Move freely around your \u201ctower,\u201d taking full advantage of your space to find the perfect shot.\n\n###\n\n## **Other 2Sync Games:**\n\n- House Defender \ud83d\udee1\ufe0f\n- Mixed Snow Worlds \u2744\ufe0f\n- The Last Galaxy \ud83d\ude80", "short_description": "Welcome to Elven Arrows, an immersive Mixed Reality game that transforms your environment into a free roam VR watchtower. Defend the realm behind your walls, move freely around your space, and protect ancient crystals from ruthless invaders. Arm yourself with a bow and arrow (plus mystical upgrades!), coordinate with friends in co-located multiplayer, or fight solo. Step into the tower and let your home become the final defense!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://2sync.io/appinfo", "developer_terms_of_service_url": "http://2sync.io/appinfo", "publisher_name": "2Sync", "support_website_url": null, "website_url": "https://2sync.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "33548870404700189"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393558_1804659543656615_1216280233933660288_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKLubmyzCdsQ7kNvwFNGZlH&_nc_oc=AdpZvIERxoWUmCK2u6RXWfFDMEghYkGRd5Po-022QGjEx-SFnUGYbZqshv8E-dqukSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbIYdv2swd4R9_JWirxeVq4uT2NMKhkXbGnmgRwFraVw&oe=6AAFF7E7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Elven Arrows \u2013 Mixed Reality Bow & Arrow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "
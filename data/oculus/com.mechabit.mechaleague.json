a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a19ZXjgz2gsQ7kNvwGA-nCJ&_nc_oc=AdoXT9tQbuupapm33QXJjtxm1HviL4x-PIDLEP0mK6PEysc4wmoeeLjLo7xNxwhAAcE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14wRHJO41agNZneZjqIEqArmSUPSilsrnS2FFXaDPcag&oe=69F5F506"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-m4Rb-bceUQ7kNvwG6l84X&_nc_oc=AdqNDuN8b0pmsR8XcF5Vx5hkPLR_d_fPimEnMZAKQAIPqVdtDHOjxFcEQK10GacWoM0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qMA_ONEPGKBKHBeZNMY4nphQvhWocumq-fW_VmdEY3g&oe=69F5FE14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oURuNlJPL84Q7kNvwEh3Oi9&_nc_oc=Ado3oTlzwYZU2NN5JaSKVDqxl1di0aGxzgeSDzNoiwIi_SpuVG10p8D-LJ7Xuxbyhms&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kibdifjRygCP6Xt-XjbZ1hsChMtHBUJnyxj_N__EkLQ&oe=69F61B4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b8Jz6GSAvMQ7kNvwHYPLks&_nc_oc=Adp0vCXdWZb68ukgt24hyxtYMlOsgyoWVP-gLrk4VD1fpJSs5uhu7c2pTwiTjKnyfL4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0I786Bpo2R66VtdnZa4jx6StS8TPMX5yvScPKLrK5Xbw&oe=69F60A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7btJ3Y-Au4Q7kNvwEjiDbO&_nc_oc=AdqA-XuuvD0W_1voouvXceM1WpQNjbOf66X8HtWZt2HUaWh4sgnYqWoXopZZaqFovKg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p1xlto0-7yeXVa8BGMhPd4eYB-oYG66Qu76F24Qtdbw&oe=69F5EB2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
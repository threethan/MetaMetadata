c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0O5EbwbJuUQ7kNvwG3Utc4&_nc_oc=AdoIlaT-sLTN8LKCe1TyCdE4kSVZFEnYr7umYFv9BfghSkCoDQh3TL6eg6brvuFFIk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wYWZ7CuF9ZrIQOnozEaQoGeiB14R2VinXjNXZR_ZEsw&oe=69FF2F86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSgUfmZRqisQ7kNvwH1nuyu&_nc_oc=AdqEET9A60_5lvwM6bQdm5Nne0A8WuNzW0CTSHQ2mwK9qTUcyVglyl4oenFr-5Pnd7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WdDD6NhOE58nr3lOaYhhkl4ff41TOsegBB78FxGrSZw&oe=69FF3894"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uffr27ynpHgQ7kNvwFWfyMf&_nc_oc=Adpqt2oqmRRWCwtLjc1wSGX9VUBycqurw8lAypmsCw5T9F6XuVCgZonpv3uOmXb3JRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TC65zJ6OdD4rYc0C-fh6cNqp4mau1XKQ4rtvTUUCmcA&oe=69FF1D8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEX3c6JMzaoQ7kNvwEUWame&_nc_oc=AdpkH9e3bMPjotO9kkIStj_VW03c4-3oO4od2wG74E0VoZlQq5gJ8lQw5FccZLymW60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YWOIgJ-ceH9QDAxWwX8CVuMrJGe_lAjnVyVc7NPpcGw&oe=69FF4484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILeKN-0zjJQQ7kNvwFyBs6k&_nc_oc=AdoSFHm2wrylrZEC5KwL8HzfIGZhBsQN5s9NQkSSJg3xQ3bxTQUpnPS583rQwERlVPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UoYQSVORPFZ_hQl0388ZUuph0ylLZ4mig9Q2IkO3vyA&oe=69FF25AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
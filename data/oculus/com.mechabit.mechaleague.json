c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVi7vj3zyTUQ7kNvwFGBlsy&_nc_oc=AdrXKDFutH5AHljb-rvsEBhFAK8U3T_rbhXqovfGxVQ-T0J_DAH8jGfqrZivKepXg3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tqTd4NvFCtx7MChNwA6o3_1434gS56pPI2TS2peCTug&oe=6A2AB106"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGvyxWbMiOIQ7kNvwF_7l7b&_nc_oc=AdoEebra--3tIK1OMQiy14x-5n9h9WTzLr8zMXvAzfZVi82dTJi0fgKRYgVlZbXZ11o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uqlpLpnl_CcI5cHQqkUMRQwRP8Yn6iUHeVjRWfLWBnQ&oe=6A2ABA14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig7I_Tdj4xEQ7kNvwHgSgzn&_nc_oc=Adr71pTaWsLAp-Cfsvojkk9iYVtJHKsTBDCxh_UAse1oYvtqkAE4CDOVvftxSpf_TIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DS-QGNP_i7nYRkFbTy9jjXxZlfRVxHkAfLbxmkSk6_w&oe=6A2AD74C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jISuxLqIfIQ7kNvwFIeHF_&_nc_oc=Adpsv_5OxElWwq6jzSYlTPUrTwoYX475DGF0vvFnXiP0OQMKYf8n7uXlqLPST11x2AM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qHDogNbHyMeSdU9lt2_0QfSZI3IEKkhtDhiG2S_laNQ&oe=6A2AC604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fstzITsPn4oQ7kNvwEI7T9E&_nc_oc=AdqjMgBoZ7oI_RBUT3aRQHrKVHC7ZrvIf1gUdUMkSGOvHEhc1lqJieKVzU66b6Z7lC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v96ISR4_MfpDfsLT6XtXbzq8upglhvNeRabpVjK7Wag&oe=6A2ADF6C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d5-3.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXNF7MY01dgQ7kNvwH6t0a7&_nc_oc=Adph_5vUIMEnggh2icB37wG5jRLojwOfn5YYM0mSCn5nVvNPgmO8KoLQCymVaOTZOuY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z92uCswq7IrHaMp_nDcqXDYot0NzfstKxHyUZJmCDvg&oe=69D4FF86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QPsiR_UvyEQ7kNvwEiYs08&_nc_oc=Ado-e13N7PZG5b8eERkbs2jTXVMgNGi6ph4DHheW7JJRsCtjfM6RiSHN9l-jfHjL7f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13RxU0UANnD1C_ioJL-NJ_Y4YqHs0okcQqu_tbcO6UNA&oe=69D50894"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyIc48fTL5IQ7kNvwHc91XU&_nc_oc=Adpa8kmAAQNVJIBpPxvOu7lnlcZvow1Ns1TQhZTUiWthA5jKzUgh3GT2Iu9Ze4mosCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N5kKc0csp9KHl_Uj6V1CUwayJMXFRqtCOIUcCMoD1eg&oe=69D4ED8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZHY1OipNxgQ7kNvwEXsE0x&_nc_oc=AdpmT_Dm0Pbu0yX9b8fqPf6QZ4A1kWlmVuCYzJEQ8M8-aWWPopJveyn-QJWY2_Cdy0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H5H0ZBZx_GHYiYrdkm1fcTTmTRdNogNLBCs3yITyUsQ&oe=69D51484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTq_oxhwBOEQ7kNvwH5koks&_nc_oc=AdqH-x2ZbeM0oU_eGvnCefOOks0oUIFyu5f8C07qNGqIRf8maBrPxBMv-_lsPpqc788&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_HUVBfdI6YsfDb6s0SUFwb0azhlcUR_9kU74E45VaHg&oe=69D4F5AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
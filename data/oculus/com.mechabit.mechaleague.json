r6-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H1rgDcpcCAQ7kNvwGumPBR&_nc_oc=Ado74n0GMq_h3jbdRR6OZxIu9NyzXSJ93IQJ5UpNl_ZBU9gbq0l4fZxgo6c5DnkD_ZA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hu7oK668iGz4V2HvjSCjQzeO9YbIX845QWk5JVpz80Q&oe=69E22E86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeCU89heqiYQ7kNvwHhcXUR&_nc_oc=AdqYnsCvk9DGI9qAF1BygN9szFjMxiI5ngdUNfpSeIt4pmtVgXtvWRLoR5gAwS8Dcmc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rUXq8abmaB7m19vaKumdbNK-Uk7exeFZ-KbsHh_-L7Q&oe=69E23794"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIeOlzaC-UwQ7kNvwGhz0fa&_nc_oc=Adriq015fT7mpBQi7MqJWzxQy4ZU6NWxrqU-YAWSfWx4NguKNPHNdTTse2Nz0J-8l4o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fJx1AhZSKZJmNEumareskb3Qxne551jZkG1vBCSzvfA&oe=69E21C8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rva4CcpTk40Q7kNvwHEvU7J&_nc_oc=AdrxLIRXPv817oJFlhS9w2g0Y_mk8cu8Kuq_Oa1JRFZUuCxFbqF-jaexIcqdv1jQOWg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TbKdIeo6zr5_-KscxVaxs2YAcDwNk4-huDjpk5Xxjtw&oe=69E24384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-GwG_fdG60Q7kNvwFWHbvu&_nc_oc=AdqjSPLvHxirA8-AP298m8zETUJ9K5gmTogL4xl4-Shk8U7NBa3wUQ0mM1rJ4l67Exg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tZRbCpWzIaRDVltQpdIynpgnVTYA3r0iwg7sLR5Vl8w&oe=69E224AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYevOG2ufBsQ7kNvwEHu3jZ&_nc_oc=AdpLmYkCjK3KxuRzF-KvENk7RJAnzuK0V7JBGh9n39sx4tOu4j7SALZvBdpPwbYuqnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5AAMwVleDtCC01W8Pa8F1q-qKqpgDwPVJZDT_NNDKQw&oe=6A6C9C06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GS6qE0eNaUoQ7kNvwHnq5p_&_nc_oc=Adp5IsCbhnAg6jwQABh9SaYInJpXq8jorsxbNQ7NFhcLMD5ANdC3_98ed_jKIFwQKUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWs2moE-LXV89azIfBAcvlN3FAxqGwhnMcww0NIrlWQ&oe=6A6CA514"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FEnaP2-AREQ7kNvwGwvcvx&_nc_oc=AdqScXcjId3EFh2v0bWG449GuvYbVasxoP9S9XKcapbKpJZhHwmb0nY8GUm8h84OLHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2BVoz2Zz4zSW-IebJz6yLpEUtXriIDECoLO_M-bPUlw&oe=6A6C8A0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Uhi1AeXHA8Q7kNvwFAk-UE&_nc_oc=AdoZxePBpRyGPH4aULY91Vihav82G8m-EI4ZtTRbpWXEn0A7WlIMnjqFAL8ldHgT1nA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTafTEdyb-WUFUwuy1W0qb5oKoQ89GrL7pjwCS1bwyjQ&oe=6A6CB104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gq_ywCneWUQ7kNvwEZM9GW&_nc_oc=AdowqYPYUtIkfoUAHxxEp32Kd7TdSLGfiwuk_JplAaAY7WKCMaPy4_zRkvGVwi2jGfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS-gVLgdP1e9XerjH60V09jLPrgM8Um20nIBgg5n3JsA&oe=6A6C922C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
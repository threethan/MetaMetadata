d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmdGawET9m0Q7kNvwFvtS9X&_nc_oc=Adp8slI7nzXn9eY4WEzDJ2OE74Dzwrt2VuB28ospcTgMJEiu6NsM_Zq5IUbf4Q7NwK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2WIv_vyMT03px9HWqrWSQEXqKIHXy1sjzWEZezgsIZA&oe=6A3BD486"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlIjeEJiqykQ7kNvwFwVzpx&_nc_oc=AdpTlhu9SeXzT-hIR28gZ8wwsaoYCEXFOFEtqVjakoo3Qo4IVNSyVj5sye6fqw3flJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wY9sdvn2ZICGkJ75d17Y3dxX8G89wtdOrO436IkUs2A&oe=6A3BDD94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIIWl0Jcl1sQ7kNvwGi58o5&_nc_oc=Adqc_zw7FGdFd0HocBPV0MnwDwk9PA5y6YK_zCHYFrvewlzS61ISLGk2Z48f2DV5jT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7syXUdfxlptVihtJVjYB-9nKUhf4xwj3sSRd-Fmcjfw&oe=6A3BFACC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STAhmHsfwI8Q7kNvwHqkf_S&_nc_oc=AdqGdgtJ0trGufj_Mspa_0D7KyUzL7rD_4Ym11LpMPnr9Bxpt9iIo0otg4J37dJrcXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wz4L4BoJJBBmf4q8d28WKi6ttiUNXzaxOgQVcNRQIEA&oe=6A3BE984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7q7xEG7iksQ7kNvwGVH4zt&_nc_oc=AdpIORAvbfpHeDqWdFej5XAQrz6Tj1uZhDhq0Ly2cTXz71FUhic-OcXma3wwU5ZGKJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dS-kANn3MSBDRSQnkFCT1uo3z8M-CU4_EBqweJco4Fg&oe=6A3C02EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQu8pRS1mJwQ7kNvwGo2dST&_nc_oc=Adp65GhWx8Hn2OgIdoZJVoCMDMPtz4aZOGZbqVTv6xpOzXez2Nd_VIkxIxXnU0oGqk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AqswWT8z2i3VKLdT70bWPKwG80o4dxL2ytdr2-SrTLA&oe=6A25A346"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2xCDOwbIuMQ7kNvwGLCK88&_nc_oc=Adqlsj0Q3uDlTbd1rBePi7E26BWJ5M62MEY3uo9fYdjk4v2PFuExkwm4eZ5MqLGNeQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zcMJJCej5j-fq8wzBDjrRPbwKAc7d-yvrF0ZCf1yuLA&oe=6A257414"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Kxx9tSVXoQ7kNvwGaunsf&_nc_oc=AdoS00gu0phuPa2jA25J3rSd6Nd20Aj2IVZ9ErXTu9PZ35ie0V4_wGqI03IuJp_6X6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90PrWZog7uwUspxHpsBZrz9Kz4aumqeWpCC_Q3C6s8AQ&oe=6A25914C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kNMDAawzOkQ7kNvwFWY_Ul&_nc_oc=Adrzyt5XmCiLsJv-xYgVY_Qd43E0_O1TjuxhR8AGaWf904dZLRuwQsD_Z8BoLclhwWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UiE6PAA7aF9RLt7I_tI1_RojbeLhhOxnpDq1ycghKeA&oe=6A258004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj-qLC-mf7cQ7kNvwFoOWQV&_nc_oc=AdrV2AuXyrXlBxP-CAEj6VG1L8U76UcTVr11-KgspqEHHM3chsoW4TEJP35ld1EeVKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jaBU8D32CI4_UzZYhkoUvmvtc14JAZb6tfFL4BiMDrw&oe=6A25996C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
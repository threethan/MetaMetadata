sin11-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaTMUYCg68Q7kNvwEfTGvG&_nc_oc=Adp9gCZciv7oUJhN65Zr2heDIJ15uKPMTOCl4BJYKl4ba4VoXhil2Nj61OTowt-uSVk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MzZpJ548Ae0mzw8vzLXBKMEuiN7FNzgOVzOrJHaZqZw&oe=6A466086"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JQqdDdzzPsQ7kNvwHO62_6&_nc_oc=Adp2De_Nlc-sjzzGcdaJID2vm-22o4P09f0Q-CPQeIwh2LPoQYgg5hDCKkU34yOvIfk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a2sYWFaSLdAHWdE2jG2OlVJewx7_C4MKN8L56GEYUXw&oe=6A466994"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVnQz9BScUEQ7kNvwGeWkNK&_nc_oc=AdrboxTWeDv2-dL5VtQ1TRRny80SKeVQfBxB8IhZSOI6Fl8ZgDjAkqwHPblzmMDxBYA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cn7_MC6PrsfiaJ6PTNtZF6-Y1F8FX5uLFLXYmnwtfaA&oe=6A4686CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEI19bGMFqAQ7kNvwGjHhyY&_nc_oc=Adr4ipEIZ4YeIL_t2r00g2RzQ919H_FuWE-oJ8UJgWnqOaGInnhtif6OvAl5xMGJvsI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jyHh-N_aqi3qy4Z4iPesPhxTXIWWAhitUOLLgop7_AQ&oe=6A467584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnWAgYBi6_IQ7kNvwEXj16D&_nc_oc=Adr724EswkZ9ykkoPyJeeSObHVfgiJMUHVSyqq9io845IYIKJO0Uz4-wymdLySOtFSQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AbDiL1m58nD2My-gSgfWmtB3-3PdnnmCQsIIq9jkh2Q&oe=6A468EEC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
sin11-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC1z5S50fiUQ7kNvwF42uc5&_nc_oc=AdqeoHnic6z90sFnTuGg8J88l21M-41AFipWSdSepMacPaGTueghn9bko49zpAwJgIU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iOUcR0UabffvmabjWEBI6IBPUj3i72wujlPJv6WzSQg&oe=6A368E86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLrB6fEDWQMQ7kNvwE3RWXr&_nc_oc=AdrGv54cELzxfq0Eb1kVDdWfi-22kXhDFZ1XXAQCfRIN8ImmboTUz5GU4NK-OPay9hA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DUDp1vsO1BKqg62qjMwh86yr99CLhp7aA6cN0ksHmTg&oe=6A369794"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puDvV17C7LoQ7kNvwHIY-3F&_nc_oc=AdrHyzg7PpCmZxOyk1bC2B2G6hlRpaijNaaWIoSlZvOIRIPdRP-kdk6RRWSpWtFZGGs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RlYl4F9Fjgrynik_eaWMHUim5H5rJYLSLLqhkxKq89Q&oe=6A36B4CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcyfbssZwMwQ7kNvwGhLBGi&_nc_oc=Adp7NRqW3JahS--zfqH_k2phoJQs1XxpTRznvMnKmWTMwnd6UsHu_soK0qH6ue1TRSg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XY_JkvNLJrLNgJtwTE17h6OGv2mCkzlifXhVBBNhYeQ&oe=6A36A384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz_RVVZTsz8Q7kNvwFusp34&_nc_oc=Adr04rLO_RzvB1lnqGvsNzbacgkHWqDqWCkNUrC05RVU0z1HjKozJ6AS9N_7B2ZpD8w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81_Sb7TG7M9CR6UNDdqmkGpvhA8GXO60-Gw8qGXEIARA&oe=6A36BCEC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGz4PFE4WrsQ7kNvwG__eoi&_nc_oc=Adlwh9oDjDQDH2b-dqbyq07DOg5b6f7Vg9Cos90RL-KyPVyfeM7ZHCDYfbUtQsAvZ3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlbrENg5j2yodYpuwPV_US2x5HyQ9k9n-RLtC-zWpZYg&oe=69BBF306"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGRlijDp7T4Q7kNvwHr8WaW&_nc_oc=Adlj5aAo-dOfV1wj7ROL65SYtoteA146FD8pw1P77DOgdEAHiI-AB8cs-HvatiGtRiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxg-cPdIgAu_AtjShZ0NSBHEj4HgimMysc_qqH8hkt6mw&oe=69BBFC14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91gNG2q7F8IQ7kNvwFYcLjs&_nc_oc=AdnZFsUvijTlXx2pWmJfH2B5ewh99QQJFgDz4ZMzvOs41qq-Ad2eX8FxOwAcHRJnxRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHkEi4yQ8b69D4IE6-7QQ6I4MUJAtxBKv36UNnczQCUw&oe=69BBE10C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCatLjbou0cQ7kNvwFY-Bx5&_nc_oc=AdnVxfWNLRgtFiRQFPWDU2cTCFfJnjpMukGJWMX_hxaP_fHzwgcboZ7TdiCL1zb2x_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFAlGQmEEEAQHHb4smOwtS2-neFKOf1queqFIsAJs-0Q&oe=69BC0804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDxNCJYY5eIQ7kNvwGUrm8b&_nc_oc=AdlJBGBl1D4UouXGKMRCgmZ4Qp3KMEdGbkgl2Z3dSlpoDbRc0_C5KAGwsBRae8Z77W4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXeTIg8wKbsOuzOKnJThIGHd37ncho3vfdQ4yOl5VahQ&oe=69BBE92C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
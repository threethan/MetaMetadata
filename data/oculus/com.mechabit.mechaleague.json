a1-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kzP4nmCqvYQ7kNvwGcJZWf&_nc_oc=Adr29nTZFdjeczmLZb0t49lVBbWuKRW0mP2utiRr00G9F2qC8d9iQ8g5tvBbjPvfr3Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSsxISk3G4g-a-jw21y-TH_zcB4XpWp-Bbwb7U4Dnbww&oe=6A92D786"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upR5qeP-CqcQ7kNvwFRRH-w&_nc_oc=Adqlq77gNZjlh_qvgp3n4UQ8--954009gCN4ks4DYhA62O05oZAxAEp6pBCklXHcRYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpoQxZS7jZfkY-kH_jFZetqlAXurx83IF3pXn0L121ug&oe=6A92A854"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAKFvZ-kBwYQ7kNvwHMfU7l&_nc_oc=Adop_uRqf-rfqdKZSrTxHykHnjM0Vt46i4kojL7NN1Hur4z1e_XxwUo33SFzP1ecqrE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbbBAScrthUx8inamLFKjLkH1NYzFEHP_kHqtQcAT6Ww&oe=6A92C58C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHW_VADDsAwQ7kNvwGaE_Rg&_nc_oc=AdrJ33_JhSC3r1KVk-ZNlRXpPhem5zWPdNHV70qsvw9QQHuqka_InGwclQ1Jz0PmI8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdNgFclnt5xrMsTrvVlWZx7hc7M6YoJZ4gET_IWBhO0Q&oe=6A92B444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg_kd1dLu7sQ7kNvwEbzIFR&_nc_oc=AdqOqK0Kmqc7-PI-57IGWfxdi9KUMGxLgOUYu6tG78RM29lZTI5NyXl0H4tlnBvamFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE_W8RXjNDasNeyamHQd-IK9LcDpX8Pk-2om7Pr1muYw&oe=6A92CDAC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
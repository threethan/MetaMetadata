771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-7KWDNahHUQ7kNvwHS8aCG&_nc_oc=AdruWyD4rLc3d2PCQ3P62CisAq6r_MwBaKlP2soUkeIhvhIhFrJZoYaIAmPMmQr1bhg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2_fPT3LASByHBWTmBs8OkMrSfXVoIViuhu4uRrytfUeg&oe=69F20086"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1jiHZYn4z0Q7kNvwEKsjOG&_nc_oc=AdpahwJWNCExW0oVoCHbazwv0oNRU-LuBwqi6RvZRw8BnX5TsET-90jmoqPYRnFzkUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0tXQbqTwgdmuXzwbOCIrBxMEYD91dq2zOjb6jstHq3DA&oe=69F20994"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jxJOvrsv4IQ7kNvwFYrXwi&_nc_oc=Adol_zhXsoFaKXu2KDp8vsRUSR1XxJxOGEWnHnQtm02dKwA02IBUqtIBTSsG_ZUvFRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0g6Mtn9trusLSDcCwreEwo8KceQbKSUDNunGCd8Zzi8A&oe=69F1EE8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjA-J5srhVEQ7kNvwH-2UEX&_nc_oc=Adq0yknyLYmd-_Rwg4nURecLdzv6UJv0xNE5DamWhm3nztL1I_LLfqX4wIA_Mi_Lhug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fFzx8zeKr0Cz2I1Oq1ceh2bZT3r7vlo5gqQYjmO481A&oe=69F21584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyM0_VtO2wAQ7kNvwGBvJYi&_nc_oc=AdqrlJ3d7lLuQHCk8lHHgmFsFobAIHjK8dzgtp8XNDUSZCh_y2vqtAlOTcO8TUQhmL8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3_Lg_aEUm0c2wm0ZYKBCGD42r8U07lywr-C9RczhhMcg&oe=69F1F6AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
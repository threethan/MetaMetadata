l3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-S9bjH72-MQ7kNvwHhMzij&_nc_oc=AdqN7WnqSJ-fVEOSq4UzMS_BYorBr_JNlNaPIpld0oN2yBjShxe15R5gP8FFeXu1liM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAQf0b9KQhdWBIQhfBbZX5TV0z6_idyxNwhVXbCCVIIA&oe=69CBC506"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgFSEdWjmCkQ7kNvwEf8uuu&_nc_oc=AdodbUAHuC0RhrJCWGEs5XzJxIqWNqAipzUPFf3x_TJukvyHLJJT4sglfIfKY3wgFms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTzkfhe1xL7kYARRnAnFLsMM736stlr_kXbSoVehEajQ&oe=69CBCE14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0acT5vqvI_cQ7kNvwH90TvN&_nc_oc=AdoqLMLhg2Gi4hHyieROdbpLOBqyGcIMl-E75saygoG9OezTS30IKMO2HGslo3rVdbs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-MQa0u7HccR1ouClD7XFnyYzfdRahE3roNOCrchfRsg&oe=69CBB30C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORx01LdKOh8Q7kNvwENHITM&_nc_oc=AdrCXtiDCTZuMTSxoHVeC3HWU8sH1GKcgewCBIWRBrr1_uTgP3Q6RvD5jzdf07pkU38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDtV4B4JwtvVXB_uCIyQ1QvoheaDhyguEdGzPuTvyxKQ&oe=69CBDA04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCUL20lMm44Q7kNvwFLaVoZ&_nc_oc=Adp3BiEB3cJV1figGRuK5eeDxqhWlsSJWmSpN1IrI5LHGz6v2dqcotuJPu47QPrSCaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFSDUEIvn5V3YG_opRKlffL21BexLtKF_3EWkotvUCFQ&oe=69CBBB2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
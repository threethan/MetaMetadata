g1-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kzP4nmCqvYQ7kNvwF1uTmC&_nc_oc=Adpu6Jao2014R4NaL3a0toLf8PF2Owo_krUSkffpcD5Z4JjjjC7UREUNspTD8u28AuI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF--kZh2pyLCmaFi9qGn4h1La43NclYHTHpWv5Y6E8VSQ&oe=6A918606"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RwACamZKCIQ7kNvwHCs0Xf&_nc_oc=AdpTabLgJ-iFvssa_Z3YFbInXRtrD_pYqGaeNgNXRlshOePUc0-wdG_G2ORrcbVCUis&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXeslfVZGGirWtg5-TB_9g8NqWDgnJLvPQHNVnk-SnwQ&oe=6A918F14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAKFvZ-kBwYQ7kNvwFk3Ry4&_nc_oc=Adp9Vn3uI5Wx0DDZSZaLSHxdGWJxVFqI7EX91sMCJCwxRi2Q3n4G_-G8mbSwpuELhSA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_SCq94JaAb6eWQofeotHT5XM_lUe4Pf9O9RbCAKNTuA&oe=6A91740C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV-gY_bTBvwQ7kNvwH6Oolj&_nc_oc=AdrP2NBi-VInA-UJ-dB-gKgBdvw2BJARH2MLgToswOAOFo9dVPcDgPE5f528OMRZFU0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJVvpt9VQ6ho7pz8ePUP4xlycU8fxsP6BhoeK2N2NgUA&oe=6A9162C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovQEOeyavOAQ7kNvwF-MzxB&_nc_oc=Adpmr8Xjy5f4uvDzp-2j_TmV3LR2GlXet6E69qAI1CvoQqKrS4hsU-Trii15K1J4Q9E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3nV8xuj_2UHq7G2YzJZR1lE3kyJHRxNWnNospUQLDsg&oe=6A917C2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
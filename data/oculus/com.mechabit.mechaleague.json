a5-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Pw-uBFVL8Q7kNvwGVedkF&_nc_oc=AdpUu_vNMwtvQ2V1sp37UkquOWsncsp4FE_HMwQYMLkYtt85VM7CkMrSgtwODTjK1Ck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML-Rrh6rc6vOD_ixQ8aYKD6wWVOuPRzVhHESh2mBtm7w&oe=6AE1F186"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJGunHoXo5IQ7kNvwHPIq6F&_nc_oc=AdpNtziHOL9J5SycO8at7Dv5hWflXn-3MkJh19nZSaxhvnsGqBLj3ag7rALPFLJQ6XA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr1dfpeNNwnsPbpU76i7ueYn2kiIliJ35j81Xpq4o8zA&oe=6AE1FA94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFNvOpk7ppsQ7kNvwGJ6961&_nc_oc=AdqoZKw-abvx9oWjqmRVQUkmCdqy58qIqmw2IvAIPhDYqzxrSLM_3BXKtRoIjiWKBe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeJrvfQZydZGM5tHDVXaj9kzHN1NwQZ52UNKJ1-6qK6w&oe=6AE217CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drakUu77tscQ7kNvwHIvNsh&_nc_oc=Adq7FFBjqpONVR4Ij7gmqP0WWMiqgwgQPLAj2AUM1LWhpyTb5IXvV31py_epzJOQ_Ec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOcI1biTJdSOCMLFAC8wkzLDND5xlyLyLWx4DyJdA3mA&oe=6AE20684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AqBessUFusQ7kNvwFexqno&_nc_oc=AdokTopzdhDOtlk7kiPiUw4I0M2PNdeq4arVhWjHU5ar9koZ5oRC1tBLBGsth_7XeX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpnuqrpbq75ToD4tzRc06kNwNRtfOKScCAZdmypjP9gA&oe=6AE1E7AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
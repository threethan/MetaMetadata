a5-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOYK6SO-xOEQ7kNvwE1jNVw&_nc_oc=AdrpY3IR5ri2jmFR7bobx9VU-gZP8cGUZST85Ck4hhb00qr_vtxxpUgFDQ4H0b8gzE8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-y98UdtmdF0DBaNcFcXLlhPH6vY9LF0XHsKvzwVEsHQ&oe=6AF34D46"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SCDrK48TawQ7kNvwESDgZY&_nc_oc=Adpw1XBeHNCbSXK01VBCm9JApBa6PaHsbEEmkJs9FclN4eXDJdf7HllEdeJOq1pdH4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYmDuOmp5wUB5E2psV_oQJA-Zh6nhVP1T-2vE1EZUSiA&oe=6AF35654"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhQbCzlkGR4Q7kNvwE1cwbk&_nc_oc=AdohaRGtyeyUdmWypLJNI2msQ9C0KNkqGuSgH5cUEA2l7hv21zKExZssol_Ff-GpbZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeTBnYXSdvepmyCl1Vk8igYAF0E0Ra2C_Dk_af6r_Ahw&oe=6AF33B4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jsFRcWq6a4Q7kNvwF9EI7I&_nc_oc=AdpwWuOLJvF_v59BQ5ejU6h6xInD--exR8UAjkNpGgKNRdvuijwoicL0FbXXW_KU4tY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMlaw2dxJ5xxiso4nwnYkJwTE5pCNkYPJ-2CnyV5i15Q&oe=6AF32A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxIXBAGHpyIQ7kNvwG_2ISY&_nc_oc=AdrbzEspV3b5--24viklT54PPnonF4iyHtkKUuMYc40FszLrIYg_70hIO2RPEevA3XU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCkGVY_tXEVGdGaX54ixHzRwbrbrqt7sHQGVgBE1ZKaQ&oe=6AF3436C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
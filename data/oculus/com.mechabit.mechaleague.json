w5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6U1mJax-g4Q7kNvwHjOeFy&_nc_oc=AdpF-XMARum-JjvD5vY71RzslZHE4s3eQUh4Omg2EIsY650P1rZ3ElBFfQFJhIjiCXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YeIuaki06DuV6ocPT3gQFKxXj-vZw4EnzuZ1rAsSLiw&oe=69E62306"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AANZI3AGVCoQ7kNvwEm2u3T&_nc_oc=AdrVWDy2EIr8eSZzpWPC2OTIma0pAws8J-qSXV8ouZobONCdEvUJNgFiJKRF6n__T-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XZpeSoV4nT8lBaPtK5A0E16YKtUJqRnfoVkGVi0V4ZQ&oe=69E62C14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCEvfE7kR60Q7kNvwFto-gF&_nc_oc=Ado5mfPy9HWjnm4BHL3-XGEx8p7eMPad2MGXdSv6q1qmDUcDe9mQwljXOKsieahK6dk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KRref4btLyBZXUdG7ayBG4XPL8WfCmYtjSNNxBTUQBA&oe=69E6110C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nSHbTKEhqUQ7kNvwEXiqA9&_nc_oc=AdqHwSaOXiA1AcSKiAzlBdAwJq7vAjrdIzupuuTLPxzKUIMSuvtmVNLkiprqMSW7t3M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qLf2dh3hSpSOv2OxB9BiE9c_lhPXz3_G8ta8nojysjw&oe=69E63804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKiLTOWWrI8Q7kNvwFVrZ0G&_nc_oc=Adostwx4cDKruKZq_xyHA650dM8SDG63lUNpty93KBi15-gzdcUDCiqn8n0q7Ztcau4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RBbTZnG6R37-kHrKBtk-vv6WfDZlOHj2JyGHv6xO3eQ&oe=69E6192C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
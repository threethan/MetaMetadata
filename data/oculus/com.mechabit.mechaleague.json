o1-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu_c1UmBfO0Q7kNvwGTJfmZ&_nc_oc=AdqyJMAhJY9d0DTkQc_iy-UcozDIInn6XMdCDDxalv4SH4b1LJ5CW5iLJqR5jzBwkA8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j3Aau_3yWxOS19DED9gTy6m2ng7Pa_m64UYcbP4Vpbw&oe=6A09BB86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lT6KmSOk4awQ7kNvwGcz8Dh&_nc_oc=AdqwOAzKw2KdjAuvUOh38rmFsQ6OXSF537vfRWpXiyhRSTW1CN6lCmeBqu7sfgE0Wc4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fBqRe9swi_mlaln19El_kzaoQZ29njVvuDjJnJ85Sew&oe=6A09C494"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSM_iRsRrY4Q7kNvwHO0fPU&_nc_oc=AdqrBCJZX7XV61ieqPOQ6gyHghPgeyv6od_OvhAjbnI7E8_yaH_HAMFKKmaLTeG4i0g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58GaVKNSTiz5YVBSQ0RsV8Lnb8JrlTo0wzxBMmq_2Cng&oe=6A09E1CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoeQIte-qMQ7kNvwGtOHbx&_nc_oc=AdpTzgYPLuNQ-otfVcN-MArahBDSl6HSOHiPOBHsHAcB0oM95rTSYr2R4svVqwofqAA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56_AROR22tbTr-YDOzXNWUrzFSxQYXvjMfxru4n54hBg&oe=6A09D084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YupJXlfNZ3oQ7kNvwFLaeqx&_nc_oc=AdqgYpgRZ_MpmB8MFoLqu1vz8BgduPdrcYNILn7xGSMFXAmPn8W6WUz4mK856gr6o48&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QJlhjQ6YwVbs3lPVLOnLAkdYQELPUlgkIMJGEb76DJQ&oe=6A09B1AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
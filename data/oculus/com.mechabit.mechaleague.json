a1-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7iTsF_dCu8Q7kNvwFygLuo&_nc_oc=Adrwtx0iyucN5gou6prN3N6O8C8SACSmq0_3x8NoyLtTTBAJPQ1QT5WPMGkZM5XEyAY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZhZxr2sIRa5tvXW9fcwlLhM-XFpCW-wPkPS43HDno-w&oe=6A159906"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lue4BBraXpAQ7kNvwEACNg3&_nc_oc=AdrYDHuZUTCVYoleSWzEdRiMjpTGK1NzzHh-Vrngx_JSImPhdd-vKL5rNKZoQbfAQhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t2nuuawCGO2Am8Wc2rPhYNWBDWl5PNM3I2Qw15W0tCA&oe=6A15A214"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65Nc-m_DRPcQ7kNvwERFa7i&_nc_oc=Adq8gPhoNYZcgqgEvtbIlGVd3Ucv9WfVV6ParA-VaLv7_5Kz8wMHZd7EgMoIAISzv2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bIFjowPl6KG9ITn1nPWXENGIWEC4VfIY5Pi4me96p3Q&oe=6A15BF4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9_SlsXXHUYQ7kNvwHr2NDT&_nc_oc=AdqLRKdwbrG5RKhkEL3Rp-NI7BgIpjicGApTY3BU6L_jupWH7678e2H0DroAzAuRDKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pyZHhk9bIkZgeXZZpRFdqvMILjUd_O6nGggRBxlj1JA&oe=6A15AE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsuCm6qm7KcQ7kNvwF30dGG&_nc_oc=Adq0WejrjYznemMEtWjkVSvlFBAzUPF1EqlvkAZKMYqxpHKUm2slRAMExAZNusoFR6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lguc8iFWq3Qvu_6AbJwMpRgyM-Am2KXwKjWjoZKcdAA&oe=6A15C76C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
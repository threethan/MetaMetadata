d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDnnC6pAnncQ7kNvwGsLEmW&_nc_oc=AdosTXy0ZV33-MpYj8Ihw3ehS_FJPuNz_fKDKekbltWfChrB4yNoW5XECdE-twDPW48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXbRHZSyJzPB8fo_dC5-JZ4zwswsqz5VnxBF5tawjxAg&oe=6AC13446"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zfw3F4yDUcQ7kNvwGAzqwl&_nc_oc=AdrCspG7-_1Tcap9_euweX5j_u44DaNpJ8-f5t9OOQxi5rkjPmbEHjVdftatFc8TrPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhMv7qHnKVo5mr04tSPu8YaDSJev8l50rsaceWxrpcmQ&oe=6AC10514"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqZ9xhyFf5EQ7kNvwGBj8Ae&_nc_oc=AdoSBVLLu3e5cammCiCAdxWT4SGlkf7x9MerpZa1RMClXq5DgUgcD3qINFLnVGQR8Wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP2XZc7PmrSohzbYq7RgEdvf3XoFVLZX1STVZtTeOgtg&oe=6AC1224C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMzNJpdgtEIQ7kNvwHZNT_Z&_nc_oc=AdrywYcViuznLON47_MCd7e6chM8SqgXX8rtIVRzE3Dc6lKYTI4jNf-i3P8azuijUJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy7ZBijLeWdtVRm2nMeX33LpoKg_XeY3YoS7CwgWGMcQ&oe=6AC11104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROdbj-9awGUQ7kNvwEbWJ_i&_nc_oc=AdodXITA8hKLs3GAjW-mcxLv2DKLW3oP7HlLSpi-wnbCWz_aw02k2hCO3JBOnisgP8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVTOrIk31uud52gGCzJQhekEjmhAYaf1AYYARWkBjB7g&oe=6AC12A6C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDnnC6pAnncQ7kNvwFkkwCu&_nc_oc=AdrkThUTMSajelxVIyV8ymbP6uabjjPjL5O1uC-esmc1umWp3BPXnpM53MPAcEFWrwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPtAcQt8vEWeA2ZsrFcHEdAuXb58JlxX_8nzljEI17iQ&oe=6AC24D86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHTu_lpkE20Q7kNvwG4ZQO-&_nc_oc=AdpIKPrwZDmCS5WeMBiK2-tnTw26HbPbZo56qheaKYt9uIRT2YuhaVCEmFVuMSXl9Bg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKnP2OruhEeqy9jao61M6xQmmxnl-MeAv-xKZS8Cowtw&oe=6AC25694"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqZ9xhyFf5EQ7kNvwHeFHSD&_nc_oc=AdpmhHykX1Aqm4zksYYlPnb5ccasz3nNWTwtuCvJ5XeHZUgBgP8xGCdugXKq-tyI1U0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzJFWtaLalIcHt1hHcOFNY9hpm5sxWL0_nIESI4MnQ2g&oe=6AC273CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kCtU-p33CcQ7kNvwEA1n-Q&_nc_oc=AdqBFhxPVv0R-m2176Ip-Y6pYtT3oCOFKyDuR8g2Thb9vIYjkAduhX1QzV-oEKnidBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgA4gorWitu2TdQ95huRaDmS-4BHOAOPxWMHJM8X6c5g&oe=6AC26284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROdbj-9awGUQ7kNvwGofhPa&_nc_oc=Adq3uL5I-T7-no5SCfPRUOsLzNetBEcNmyRNJLaEIJFXEjJkf9l8afPe5WB9ai8HWuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeXZUfr1X03Aa9EkMNWAowx36nIY5xaOi9_4EHTj4TTQ&oe=6AC27BEC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aV9LOb_QvsQ7kNvwHGXbCU&_nc_oc=AdrhFVmINegw9zN6jHwwdVckAHWRKldD449YLv5nceeoUfkB2kyo_CWvY3_hq7JZG8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxvLMnxvU9uylPciqIq4QADX9JlE5C0Hm8_wyYv2a6sw&oe=6ACE6346"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afc2ScwXw-cQ7kNvwGhIIsQ&_nc_oc=AdoeIFQD0PptaMVIWaEAPBVxGeLpsQIyg7mgqMWPc6zBuxzADeXe0t2x8ZhL961MnkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGQV2KiWGvdxJcDSc8v8jMQ2WUYPpqIznjyF_o5l1VFA&oe=6ACE3414"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYwBNU3oLlMQ7kNvwE2EG5z&_nc_oc=AdoPUF3Vy5-_IGHIjQPP4zpjw20xsfL7U1UApbXsJK2Gwg3p5vtUSyRaZcraqx-UVI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoGa-5fpuTUP8Lq95oXgfXdMFprxMuIqb6hNBovbeOsw&oe=6ACE514C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4NRsfnvSR8Q7kNvwHizr3C&_nc_oc=Adre0NixiBr5sVRUr6Rrx4m8UHlwJZOl1WXYmyrEqXtchTg0vQr8vvsPGwoLEB1jOIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAfirUhItD5d5mArAVpyWIqC_kdfJx3sdHrb7XU3yNgg&oe=6ACE4004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spqB1943f0MQ7kNvwHgEG_u&_nc_oc=AdqNj6vfCj2RvPaaUR5IfJUfOS7KClxEiP4oWY7Pt-9fPgSb6bNCQiAfak4G4v9PBgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA5ziC4lR0gFGQyFM8A1szhfaZxzcgRItRmGYfmkcNxg&oe=6ACE596C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
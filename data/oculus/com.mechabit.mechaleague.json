d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0O5EbwbJuUQ7kNvwFbX0mB&_nc_oc=AdoKtwnXhPST1QZVuiDaXAPWvZ3jccpLXZwWmp11TJh1KWKgcAGVMqlmu9jyW0Rvsr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zYdCeecXbfU8wGyWMZW0nAeUabVvRdi3xezqeOl3LBQ&oe=6A01D286"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sptQQzpj_4Q7kNvwFDuSgj&_nc_oc=AdqNXFYlfk2Q47G_Px9cUbeOsPBCzYyNkBX7BOKpL11aEzdqz8DZvXb0o9otVxMc2vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R-1P2U5-qc6zpZXIUIfgh7ABvjy6ClkXYykMcNs8z-Q&oe=6A01DB94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jMMoYYo5aAQ7kNvwF-GIZU&_nc_oc=AdpS5h9kgj4689VmeiLX7dNhNEqtS4dvd4mwcWK0B6y1b6X-o_Ylwnt1gg8j7k33wGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IfWIVXypwYYtdX-fqnzq16inTVJgMP-o9iinj7aYI9A&oe=6A01F8CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2Z2CL6H3A8Q7kNvwEYV_nA&_nc_oc=AdrBWQLXK4GA_FUpPDa1tDMupl6Nj0aKWOiEjbunXp4ofnBUgcawAmnHv0OO7s4p88E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ur2hTQYQz595lM-MjfsdjbINYVOHaoQV8AquqTxAAXQ&oe=6A01E784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILeKN-0zjJQQ7kNvwHo8G0b&_nc_oc=AdrakiTduOVqtyOKpUvOSbrVMT8Aw-XmTyZMB6QLyW1jJN-OWZJeTjQ23SSmQ5uopoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JlfyBvZo6cmeyvMq5Z0vk1fFRFzMtnpnWVU8tsVxNHg&oe=6A01C8AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
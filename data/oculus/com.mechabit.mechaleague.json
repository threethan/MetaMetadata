o1-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04Lb4TlbtvkQ7kNvwE19hvj&_nc_oc=AdphY5N9l9Zprrx2F8M1aLI82LgXbiFvu4c5Qaq3VEj4R4Cp0oivXYbulKrvURcULVM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7gbOqhGIxGPtuiT80UyuYtFgN-Lim_ed8mRmnwtSCVw&oe=6A973C86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-lKbL6XmzsQ7kNvwHBNKY0&_nc_oc=Adof_RBas9Hnbh5n-9zHXS3C1S8_nDiTOQSnzOUKwDI2Gjf6b00TOzZ6r0sXpAhaqcA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY9M-b2RzWJqTectqTtrGLN3uY_utodzb7kdniJAEUZw&oe=6A974594"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAkIZ1Ib-v4Q7kNvwGNIxhK&_nc_oc=Ado16L_SIgkvkkGV9YcYy6qBsxQ53B8cv-4nL_94mL6KIiLE8XA-IbyJKSP4bJCLS2Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8i0-l-2uxatxgMS8TeYFE8MZqaRP0aaSo0HcAm93IXA&oe=6A972A8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULf6lmT165AQ7kNvwHxN79k&_nc_oc=Adr-WbVouFw2pMy8-x_-8TitRDJaFcc3j8Q4SYg4EHPztUrzMWsLWL3fp1IRWWEnY1c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWTPajbFDkEP6Q9W6y9awU2l0PH5BnPH2AHKceYwnvvA&oe=6A975184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qM5A_fJJ8y4Q7kNvwH2MAy7&_nc_oc=Adrn1G_Na89iuyIyvK0mvkOzLCCIdOGPN0s9rjY3gEU4tJn1CkSNvwec9kEEx6rPBGE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMr87zAAIMtncJPdiAlW0XBxpryiN4I2ItOaJF8Nrhlg&oe=6A9732AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
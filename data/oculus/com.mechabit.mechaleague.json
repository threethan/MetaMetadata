/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGz4PFE4WrsQ7kNvwGyIEQ8&_nc_oc=AdkjppvKS8Q0lGaQGtfM8VWYa8XuHc8lK7f28iwvHj94dwkWF1BN4QvwLPkX8biFNlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJL19F-yjIdJi_Jw3E7im8bmRxfBAIVPDdhgwWzwqfsQ&oe=69BE9606"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFLTvPas2Z8Q7kNvwGCUhm4&_nc_oc=AdmhdawrjAmvR0F48qjh7o90I7OD_Ua_WXDVgldXiVAjNWV2hEF51PTjnNPpBQZ-M7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK4fdhgWFXGSuUMhfNvbHuJi8yq-KXHjOMvFlE6GVCYQ&oe=69BE9F14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lOhZE2rJcQQ7kNvwEIS11c&_nc_oc=AdkMip-4ZYHWXIIXnFzG7K-CbDMs95aOC8gEK8Bjrf9PJFNuUidnrNgk799mw2LwiWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLs67_z2xzWpHuVdsnnvk-Mqf5ibRWII9Fje51Rlfb7A&oe=69BE840C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbeczJQo2BsQ7kNvwG1Pyll&_nc_oc=Adlk1ifUafnokUarN4iTMqmXJjL2IN36aT-156PoV2JMPVdHDuxHUYdKjY36w8v0cWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4qRWX3lhH9CmuDQUjzl3aia_Bt_QY_aWKFNVuwHCK7g&oe=69BEAB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDxNCJYY5eIQ7kNvwHugNQP&_nc_oc=AdmxK9T_JABp-P-pX6wu_MAeFlbU_75XtX1tv1u2oRInNrPJBI3X3kcn3qLaMmXGxh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiqeDM64iFIXc3R_5Lh8w_9HbD6NoUNN-bPfjWO0_CiQ&oe=69BE8C2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
d3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxk_0-HdbYoQ7kNvwEz3Pmr&_nc_oc=Adqg7x0LQKJPTGj0fGXoPRdd9wB9h_hvbLPCF0dDQ4kwtViWzZ2w1xWdsVTFXKtWpUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsrI9EERzws4Mj0AaLX47UbLIuc7V5uWmRq_OGmpa8ZQ&oe=6AE76FC6"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enY_z2D5lm0Q7kNvwHbaesj&_nc_oc=AdqoECRQI0Pr8sndfuuEWdGNj68-PdzNURo6EuSrlxaUI2IKdTCtdbMJxLdpklWNuNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBYvuR2eC4NWyL-29NCd-_k_bimAyx1N9b77galPRqYQ&oe=6AE74094"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwISoANLKIoQ7kNvwF8CrjR&_nc_oc=Ado1Iy8Toe9dd2ahoHxuY8Myufd9t_hntEgxeloxkmgclM43ddNrAiYLeDiXCvHQ0SU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROOrAP2CY5gTqK9YelCux_Pql1j3JxGXfytY1yuYJalg&oe=6AE75DCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YezDcMo94FAQ7kNvwFaWxnP&_nc_oc=AdrnJQMEn7r5mZpFNkGWtfEUR76vb9TcD6D68Kh-zeSmAhIOblnFaCPKeWJzBrNfQh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7HyY4JZLW9UApR_1ScFJmbPegpY0606N3lKa--IWpCA&oe=6AE74C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOIykp8_1gsQ7kNvwHKgJl2&_nc_oc=AdovlDXxAg9lzSaIjg80Yj1Lv2YEkWuQgNPxa8rx4rn33thQ5CvytMa2T06vNtpc4HQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG0MReQpc_74zpQdXIre0tY7Gaeki8hSGQe7sKEPG9HQ&oe=6AE765EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
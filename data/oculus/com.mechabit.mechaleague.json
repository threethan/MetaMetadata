d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCk3aC6M4zsQ7kNvwFppG-m&_nc_oc=AdofQodmWZPK-K2iItg4fqOVK1kKNca1OXCEfW7kDfdohVjizWNn9OZM-xnAHlF43nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd8arb79pS8G0rwrBNNVvQAc2dMfESH2-JYIuiGYjKzw&oe=6A4F9B06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paO5evIL5WAQ7kNvwHCMJbv&_nc_oc=Ado2yZMthRMvCBpBhz85VobtxcU-CFExT2VCt5veTB3dACdcomcsstNF-3sLq1U9lGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIgUWyzDIxyYk7zTEoKhQl4JBvP-ZfccbUhTo16lsX7A&oe=6A4FA414"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRgQ71MGlzQQ7kNvwEYiZ0_&_nc_oc=Adq2pAypjScdx_q9qrC8nzB18nnXiE2M6KHjoBtXD2K4O3LwvmpX8xoD1ease_8dK4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-_jVzfHbIzmIVjSBiBCS7GIu2Dmd-e7Fehh0GqAPDrw&oe=6A4FC14C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmZbNSF0CPcQ7kNvwGw6V1T&_nc_oc=Adrwj7b68ibDX_8hhLcVVWtFOhEMQoxFS_-zYHLimq3taK3D7jDd-PLNo4XkPMzjtbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFrdC9FcIiyK6vy3AgBTAqOnV7zqHiyKhBH1LOl9ibsg&oe=6A4FB004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhFDb_HxD7gQ7kNvwE_P-uT&_nc_oc=AdpBqT60SdmzwwJRA6r3Kzxm1MHcch9s4dMvEblOAQnLggGWXjRkKqaP7GJT_7lD6B4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOfOmNq-vqPEsdMlG7Z3qDfsmytJIx8Im1Vb3kvZGOFQ&oe=6A4F912C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
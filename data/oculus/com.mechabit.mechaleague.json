c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Pw-uBFVL8Q7kNvwErIZxv&_nc_oc=Adr62iq53TI77Wg5MzmYtcJ1whGzrNsNdF4QAU4SfR5XJZHT__sAJSEHVpLLULyLOX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4LlZ--QayV6VnEmfxjFoygjNFDlmObzQt4Mp9Gz-TlQ&oe=6AE0A006"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBp4jMSp7gkQ7kNvwHGSCKO&_nc_oc=Ado4gLp0tTlyCXhXfr3TbcF3Q-f29tSgmbwJJjRST_Y0Z_Z1BCj-ix7Abyf1G11MBEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ4VLq5KRbVghKoV3Eu0RNNIgU2Bzx49u5IjbdEGjeuQ&oe=6AE0A914"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFNvOpk7ppsQ7kNvwGKPHUH&_nc_oc=Adpji-6eZk4Qc-ra_iA-ZkivBuF5x59WCGUZ0mZr5s5nLzaID41mtyRnCvBYqFxuCrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQhcNcGGtIxEHe1cQWjDBsD0k0IMm1hIFP6dcaOLZu_w&oe=6AE0C64C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6AfJc3VAlAQ7kNvwHubyET&_nc_oc=AdpYlxy2aveBIPtzZ2jT6KYM_9AITe9X3r9VN1KvLfOBhVywCYnSTdCq66XQDJK4Kqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy6-8Ql39JojBtF62klrsN6z3OhQF72-zRtlC8M2a7Vw&oe=6AE0B504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AqBessUFusQ7kNvwFEKZSI&_nc_oc=Adp1R6N5ctQ-sY4vtCK97OC9yC-VLmgwDHrDkXIvNcGol_2SuDc5Au0zZBgpVCyw4Dk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcZ9ZqDOLKcwzKgvuP3wDrLrkGuimh8Vl1NRb3BAowQw&oe=6AE0962C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
s2-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCk3aC6M4zsQ7kNvwH6676u&_nc_oc=AdpYCHVYLfAJJm8zI_iG6AURcTaLpLYVCgGG5G6QeR_nOgDKQgZ0U-8KT4BayfbZsKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWv5R4nUFNwpxmWKc_r4TmKEzOF7fUWf6uj46hRLMIlA&oe=6A50EC86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paO5evIL5WAQ7kNvwHLg8-m&_nc_oc=Adpe8iNqzcdo5uPyuDdFj6j_MsMWjUpV9MlnhKSU-2lu5Hg1EiSXEEo82_h9vYRMTv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVNifVOQZM8AWds2hrRWZyiolglo1ZWppoWJfwZXjauw&oe=6A50F594"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65fJ-lHfRl0Q7kNvwHnEk63&_nc_oc=AdrNArxrxGw-hJpefGrN3alQVlUtIINS2yfKPmmpCrz40bgdSDdY3CF15oCksLgtVzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvuAFqxi4ahvhbRhKpgPkZfjbixoo4V7Qnk7TO6EACRA&oe=6A5112CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmZbNSF0CPcQ7kNvwGmufVu&_nc_oc=AdrU-bkRbtmxHl-sg7X7cwlFGXysm8PNnG5Ho67eu8NJ9lb8RfS_7wwtiZN8S9LocAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcTRjBc5AVNL9EI9GDCozy7-j_LgP8ORx3DoId0VB08A&oe=6A510184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhFDb_HxD7gQ7kNvwFyGEEm&_nc_oc=AdpNGVqp5QFed-cQKbx96B6fUbsnpuGxTLHlAlsmI5L1Hcgi0-RVqkHd7oTsELxrO-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQJI9MqNCcdASwm95GNEgbC6Y-DBooGadlR9ME0LCFWQ&oe=6A50E2AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
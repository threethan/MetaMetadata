/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCyqAXpKwbkQ7kNvwGWqytP&_nc_oc=AdkkNi2hMQqSoD6gBgk9KChWFKTcqVlsbmzmPFN92JBQC36Djjqnc3fEWrvuLks-bJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6CbWNsJTVYQ4FUGsQYU9NlB6hYcQGHZx0cAk1mj5xNg&oe=69AEC406"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4ulBJ62pc4Q7kNvwERq8NV&_nc_oc=Adn9Ub5sOeni6_zLEsG_Jof2yQu8_nck2ABDCp4Ngs5jg6qtIIMTceUupYTBTGN0Hng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2cgyHIzs3QG970vsRhTBLIO1n-jvvWZKlyX4fGo39yw&oe=69AECD14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWwxqFX7qy4Q7kNvwGj9Waa&_nc_oc=Adn3K1k8rPjJ4ySNcZTQFN6RzRFKUryROkXaquFiF8x95ukXKCaTW4379f8yMkrDJA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-5FhQ0IvB9K3UOHWfTNavZoDki7kSw3Aflno-wpdk9Q&oe=69AEB20C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYyl4bUOhbgQ7kNvwFqWV9U&_nc_oc=AdkbyxGGVoJaQEfWd4H-4qIfSi4qgiUuPTP_0LW3rAXNG-48z2Q2a6GgAXHnlCzUUjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDNh-0l3l9ouYWIiFOkSzFqSKmQN63pu0dezIZ0VZu3Q&oe=69AED904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr7-pBwjbi4Q7kNvwHJYT05&_nc_oc=Adl0GKIvpCEP7YECVMIUlERubgWyfoOV5TB_WcoMqpcoZAxSBvqMXDtHOlVRB9igUM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZCiIzSgTbHrCkrAu-MuVKdIHR-C1sHULWCbVlwRyjCQ&oe=69AEBA2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
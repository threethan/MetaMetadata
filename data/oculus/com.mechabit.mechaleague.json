sin11-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC1z5S50fiUQ7kNvwH0Vvzy&_nc_oc=Ado2hcxhdTQFy_XhfvRruo9tPNPccvXS4XHsZjBZMHoI9VCpssnzFhbY18IXNZhSCVQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TlcAhhymVXVPvkOI1XuUSFSnCA1BYJVTKotOgPEKlvw&oe=6A393186"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4wnJ_3KUswQ7kNvwHnXHh4&_nc_oc=AdrWqWlfjEf-uxkx8gnlo87njgyhmT-Bqmy8Oq1nyNe8zWT7CLXBY2v6qHl_LpKNOCE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_WygULr9clRkNzyAF3kQhkxxUiD9h9dsNjI-XIRwxlg&oe=6A393A94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIIWl0Jcl1sQ7kNvwHkE_3m&_nc_oc=AdpUxG-XDeVyA5YPaH5ECp3IPuNF2PL7jtrO6fniY96MO22lU-bKFrpG3k_ed7a3_vE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E5mZ639boHiZ-kpttlyelMLFBHSHPtUrZahSSH7MgUQ&oe=6A3957CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FciH7M6yi90Q7kNvwGc8cUQ&_nc_oc=AdpgAfRK0nO77RRDT_ljYIukW6xu45TwfOYvLwrA-84h7iKh0CbHyEVmsdILuFk8B1k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KbQZLpuMwGgtGH3cDeC8eKasfH8OGyOhO3kz9naZgPA&oe=6A394684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz_RVVZTsz8Q7kNvwFzce4E&_nc_oc=AdqkOcu1nwHnRI9czuTpA-A-ezWE9_tR_vj9146ve0Xa1kdmkW59fpX6DcseQGMTUzw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m64cBYjAqOVJEszMDuV1iUt0J-JteDkHha4uMe84yXg&oe=6A395FEC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
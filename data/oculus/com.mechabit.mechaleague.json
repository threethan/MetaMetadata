d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dH7yrnKTPVkQ7kNvwEEl7AH&_nc_oc=Ado-sGeaM1cg4YwpfcZ72r94fUagBC1-d17sMCGtook5Ob4YQr1BjC7VvKzBWko4lgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n-z32-n2G5ZW-OLvWM3ugfWkpHnP7mY1aactSzADjfQ&oe=6A1D8206"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g18fNh63poAQ7kNvwGZwgRG&_nc_oc=AdrzJEioCsQUwoKl9oGMo3gpCQ7TetPX7Gj-WZCcPjMKTEgBSHa0c-FLBTG50lZAlTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CtH7R5KLDz1acqUxuWRGZDnrUvB8sLglMQR6Ch6JW5Q&oe=6A1D8B14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfC-5Th7rCcQ7kNvwHG0cEL&_nc_oc=AdpUwhN9irqQJHGIEnAtOdmk_KO0P22f-2WtsyEvpy3UzNFvX_zZ8KbSsYMDS5Th4s8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mYJZkF12R_7d9uoElCcKvxy5XQS-EXXAALTJBZWHuQA&oe=6A1DA84C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEhr4uHdnbYQ7kNvwHACQ51&_nc_oc=AdqQ-4WAnS758AiOKMtFl3hvhUix6S8x3SgrEF1TyjWbvv4ldZNm2zZ8gwZ4lg7ySW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d5oPW7ubJPJqDYXyX4cNbxlJSZIGUL_K7l_YF5Co9PA&oe=6A1D9704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaUHEyE2GEgQ7kNvwF7viJk&_nc_oc=AdoOxI8uBWAaPzI6_xjydjAPM_OxXuvtqo2lp4BJY6J1YCtI0L3D4ugmPMuf5j15F5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jg5yicaF-JteTVQqIe2kuSJ-ZM7qyNgiO3VOmQAsy-A&oe=6A1D782C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
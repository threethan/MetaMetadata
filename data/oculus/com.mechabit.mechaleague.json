s2-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc2ZwiHZAC8Q7kNvwGAngHx&_nc_oc=AdoT9A_RjCiKYeED2YsiRfxNNz-HED7Q7S4sKouCLW2ZK0-tcWVpxRgkKzQ5F4KJ3zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AJ-6cBtYvwian8I26suSjLYYFv1x1gXUtHumLA3xdQw&oe=6A295F86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGvyxWbMiOIQ7kNvwFzjRBi&_nc_oc=AdoXDnSQIUlm8fd6rTAwobYVsZW6eikR5SvKXn_egNR8TzVwNn7aDUDzoQXX48fibUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yV7hCHApPFVRrXm2CsTjZ2ZYoyqEu4I2zYIjCm7Qjcg&oe=6A296894"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig7I_Tdj4xEQ7kNvwG4Ui6b&_nc_oc=AdrndKWiIFn2xeZ8HWGUksWPrSqhHwvlp5lfhfPxovpeNVWMcr21swEjMPGnhs1z9Iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DmxsMoYbF0BJ-lxSWBBIDpUFx4K_fOVMWk4TVxkmzNw&oe=6A2985CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jISuxLqIfIQ7kNvwGBAnXz&_nc_oc=Adqz7D9dwUQtmD0TNsaJ-P1W629XMZ67jr8A5TD8iGBYyhL00RD3D2KHHYlQoTBgcrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C-9KK9O1Uf1Fh1JHFrpRu35u_GprY3M_0CnlXtx2X-w&oe=6A297484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70JecxYxUmAQ7kNvwEM-xq_&_nc_oc=AdrBzB34gzjxmfBiPdkIVhfPVjOV01j-EHo6UWDBUuLYz-wgZ4vMhe3lpyaxemYv5uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SANs4Zouwbr3Dx9ByY4Gv1xy3dMvuKLO7DZdSG37TLg&oe=6A2955AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
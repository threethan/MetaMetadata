d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCvzKZjQ8DkQ7kNvwE2gN1f&_nc_oc=AdrhqBejEdzpLqr7IsK5OmrbncTOsuDkXeF5-0foHqwxZiQTvQTgxQqudCwWe8xR-ec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkva9MdABBMdPVgVJH2AelTYflYws7UGfqQ4Y2CvYv-Q&oe=6ABFAA86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zfw3F4yDUcQ7kNvwECAzgx&_nc_oc=AdpLjO5Eqzf-UF_CZcw8U2S14OqUHeh9pCZr_pfHIfIvxJch5CGjt_Csspe6mM5lDps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuHql0xFDpNwhI281xai8kpy3ABHjfWg5jrQIsD15XDA&oe=6ABFB394"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqZ9xhyFf5EQ7kNvwG26jRS&_nc_oc=AdrDR_sXrJR59dM1Ttwc4XM2u2QdHbmRK53KJKlwDVf8yTNJJYQ-fUQgmvx1W-brws4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa1Zq450H7vxOOxFXtcLzMRFQOhI5rY6Kr3PIQnUVxcQ&oe=6ABFD0CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMzNJpdgtEIQ7kNvwE-FW8t&_nc_oc=AdoRoYPp-Iw-65Ayc4No2nGCnOJfT-LccBmhNpWQDBaUfQjenxxsRCy_-etYV-CGZi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6XrjubJpKWaGHCDjPmY-TWpYr7IeYpCbuHCa6erfeEQ&oe=6ABFBF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iN1VL7s4FgQ7kNvwE1rG4K&_nc_oc=AdrCAiGb9EQHsZcjbjNryAoGB0NZ3g665SKWjsIs9XlXUNLcyzd5TQpnBgUy3e75mgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1pXRx0XNDhjY8a-RlaF0IdHdRaIJt1vsbb7HyvLwG0A&oe=6ABFD8EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
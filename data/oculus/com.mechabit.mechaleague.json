-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYjsuWFJBCkQ7kNvwFfZydz&_nc_oc=AdnFM4LqlAp9VuzfgRY2kTrzL9qnTL91Fb8_mxDaz_IInfL--FPQe9FKNIX-KZa2o4I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhdWkBi719cmpRKrTTt9lYrlnot2rjlSBzWIRQyZlzFQ&oe=69AACF86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtbHq9deqegQ7kNvwGySfjG&_nc_oc=Adltd4SC65NzkUEINKaxAhq9X7BbG-X9HkEdZjOr1LqB7QxMRTMKQ1CNorGdwUQIW6g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVcnCyzP52epzWsxmT3j8xA-hbZaDl8ZjexRi_UbfSRA&oe=69AAD894"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKp3Tv4FtxcQ7kNvwFgiLXl&_nc_oc=AdnyxHsr7nHMArNQmJmi0pSu94JdX2ETaE3ZeZWGOAW_lx1sU52KPWPpZZb58nWfnY8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMVIFNk0qDwx8Bi4qmpBeh_8qp5CCISfJrFiMMyzYAwg&oe=69AABD8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFkUV9WOjIoQ7kNvwHmn2vv&_nc_oc=Adl37sHQu671fmd8jfSRBESnt8Dgvi2W28IaXErbvWu6JCdcyoWyEUvTGZcxY-mp3zU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhR6Dom9ADt_gsYKoa5TfpFVn5ogKVpdlva2c4OAlUPQ&oe=69AAE484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keD72BzQeB0Q7kNvwG1wKDl&_nc_oc=AdkpWcTCewqU8mq9_K1Bn-FW-IhbpS9MsNtSgVh2rQX4RkgDgy6WjuL6jJdSSVSxFC0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnORLfcTGavsj1YTZUuofMAhnyDN8g1-BmkqdKs3WXtA&oe=69AAC5AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0Tx4C1_gGMQ7kNvwF4MtZE&_nc_oc=AdpmolSBR_5P7Ein7WXZTJwJIxlqaAyKIkryA9EagdKS8eyOLdvjO_5FRiLBDMf4o_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRacJ46Xvh11OTo7d_ZXgvgpB1vZF7hGuePFQK-6BbDA&oe=6A830586"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ3ENLkPVz8Q7kNvwEiGi5l&_nc_oc=AdpTtnRWmyrU9PDUDA1_9v0uJ_nUNZJ_rOzBNdi1GEOYy_NHxwzmSBYu-iOj67GeQKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLvBeMZnUdie7_HIcx_U2svULQ7_r_ioWhrMxCnEfE4w&oe=6A830E94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEwxJSxEU0MQ7kNvwHEP_Ud&_nc_oc=Adr1TBOHAedgGMtlAzIoO2Iz4-CXJF_iV7jvD-Ff8lpybxwx3iAtuLzMRcn83WgPWjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdk7wIxHEJc7Fnycp0g2DyEdWtTXZCTlKjWlZxg42bbg&oe=6A82F38C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eln2anbyqWAQ7kNvwHKdDXZ&_nc_oc=Ado8Re1ePuVee2vbA2y0Gqc9fOzQsuCwRiuZ6k33xNxK5C6EBHojTPoZQE-9oP8LxkM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCl83RfDJnzjXgn3QSNp515_TunpQuTkNhsScjD530Dg&oe=6A82E244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87cx_d6tcXoQ7kNvwG1_hHQ&_nc_oc=AdozPrkeUujzsJuOUVCpUtNtMeu3rQmd03LV8c3i6HCCZTlXvhlBNHQPHMVAGuRkOUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7vOYiLZGOh-Yg2InZbHeIiEeFskwww_uOw95ND61OjA&oe=6A82FBAC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7iTsF_dCu8Q7kNvwHoUQBc&_nc_oc=AdpzhaEAP5mGXLsdonaXxhZyyqmtim1mhLDNpCiQ-o2k6rkohEduk5udXOhDLmsF8n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vy7VM0TTLw3YQoBkmUv1oMtdw2L_Nn0iAiVMD7FJkKg&oe=6A144786"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lue4BBraXpAQ7kNvwHYs8LL&_nc_oc=AdofsuSDt0x_Zhzf21D3RaCzj4jk4EqBYJCblTgXbJZnIyU6hcsmxVY2VDisCdhsYco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZV668LS9QF8AbjRVZhzfmz33NNBFHaYVOnGBz_lrnxw&oe=6A145094"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpH24VR1s-cQ7kNvwFUWrAZ&_nc_oc=Adoo6yNeok8jkF8xf0_OEOXxO1y91sPZxWMV-ZLPP7pw9G2nwmvGFF7PwK7wcoZtIYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GrcG1R_3oP3G2gSu3qy-8dB1upcsGhol-e1ytSN7EZw&oe=6A146DCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9_SlsXXHUYQ7kNvwG5kuA6&_nc_oc=Adp2-BiTtkDDMFyP5ZWMQzHQMM8JWqvoE63nwl15OT0LlMmdlxRIi1NOFfHUJxeK8JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SWfyxWj8M6ZmjAyuDH4HgKVqt6MaZa8p-kMBxVBgz4w&oe=6A145C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsuCm6qm7KcQ7kNvwFzfA-1&_nc_oc=AdrJObstUpVoq0HKDh4TpKbLrR57e4eGO8iQNn5k2nPmjiECCgA9FlO1UuweZZJtXmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uE2HN95HACJ-1m8E29wP265jqfIxPjwpvu75ScRZdRw&oe=6A1475EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
w5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzH1v-SG0MoQ7kNvwEJoIaU&_nc_oc=AdqPM4p4hEHMloPpZQRg415o9et9IUSvwF70Y8Va5NZFih1sq_btnsiY3zABP8Wgkow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VzgHHTL1c8NyWgxhS1kLeZV_cmVIPdpAUtuF96XpfTQ&oe=6A0F0186"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0npYwhKsvm8Q7kNvwFX7wPe&_nc_oc=Adqx7FZfwNFtH_Hqnc84USJUmB8pe8cShrVXk1Pz757uQgSBW2Fp5g8ryG65AVJNqNk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qjag7GAOSKQtU1OGgTXBu3fPHalKt5wArMCUQnHMkpA&oe=6A0F0A94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdGNxOpcMN4Q7kNvwEO0fTf&_nc_oc=AdomSu3QBV3TBSaBktR019v0gekz9PrQxfNlPrmTdL-QSrd0bssY_sgdg1Ht6pz_myQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zwLMfT0jsqs1SKZ0rt8u9pEPU_9vi5IhM7OGQMFCCeQ&oe=6A0F27CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMa22WTPhyUQ7kNvwF8TYW0&_nc_oc=AdqaHwaPu7ACrQsLcaYdaWppKfaf5KuwtGN42Ks6TTXE3EwwFSn0md_j1amOm-8htao&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YhP2MBAiyy_u0aB3F4j_VqJaX1DoXy96q4he1HJPbsg&oe=6A0F1684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5swuzikWkdkQ7kNvwEeF4R_&_nc_oc=Adr5WnDq_9EwLZc6xyI1zuqz5zgDvGeCap_ZJwi8HwPSF5hs1K9Ao64yyPVOiH7PtIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45wkjBIEAhOSllfTeMq8khEgw4WEbNh8QEizsWT8ia3w&oe=6A0EF7AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
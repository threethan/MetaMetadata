a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dH7yrnKTPVkQ7kNvwFe4q1W&_nc_oc=Adrz6m7p1eKAh9mf22NVPIoxPvD-4tpb91YeLtXY4fbj57Od5ocG0ovmaYWhxrnVRyE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70023f0YZFnddLUicUece3s988QMdlxJ0NGDUKGoc4VQ&oe=6A1ADF06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-elfGfPUby0Q7kNvwFvPeCh&_nc_oc=AdoDNyhRlk_sqi_sNkwDU_ilDoIqD9K6iOVyAYP6d-0c613bTjtAcoiexSxM9jWifOI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rFfXunOLLbeqTJ4R0T5QCVMWCy0Pft9zSu29kZQQR-Q&oe=6A1AE814"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVltfKga2IcQ7kNvwEu8Dhb&_nc_oc=Adrm3ROvS7eoQoNBiPX-_tdHF-LD6fOS_4Qyp1xzPrblg7rXra2_SMrQB1PqTuz8gng&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ucekg4ubTuC8GSMsWsX4A7el3oGu2VITc2umIc0v5tw&oe=6A1B054C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBhZnG59m9EQ7kNvwFMWy0g&_nc_oc=Adot5zPX86c46CjkKI1yDpsd3MxkDwKxINGfqntX0Lqbw5BshZPSM1_3gBvA4V3XTeE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47sOYnmufgGD2tNTOj4Jw370mZlHeO3bhUY4RHUZ7ZkA&oe=6A1AF404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaUHEyE2GEgQ7kNvwFhamyK&_nc_oc=Adrg8ESmjhvhaBDNRJQ6iLWdBJXeP6lGTEknBEJdTVh057IgxX9hxF_Ot9k5XIZih9w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s6kYZ5CjFnDS0pv_blO8fsMx-MyJmqqOveb1-4P8IyQ&oe=6A1AD52C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
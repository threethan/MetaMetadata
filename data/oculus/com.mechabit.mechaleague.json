d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rULASe_HWt4Q7kNvwHtSal_&_nc_oc=AdrIxFZJYcVsFiC8oVqpYOrKvsj65kAJdzNyIJbalSSydVqswx2EFa0ItAuBwh0BHW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIpF4PzyZo6GELd7LYgJsP0_vX9W7j0J7QEkrJ28Y7yA&oe=6A4BA686"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTxiJ2ayVE0Q7kNvwEnImWN&_nc_oc=Ado0Nz3DYkQwee_del2xdkqJ3b7ZAAiyb_2kMKgFNeQZa4WN5qB2WBvAQO3GrXeKFjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD23n_92alc5Zn4V4BCmAvnwzugRezEMhNSYjhn2dWRBw&oe=6A4BAF94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcm96vwhaHQQ7kNvwFNSC1J&_nc_oc=AdrhxfswCLGB84M2FmanSmTIm4lKeNvLVZez3GSABIC-Mx2NADxSuVS97Rrz5hlqgus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdUcCwQFgqVAfijlMiX1wPMP1sfVVbICTTEjcYdiFKbg&oe=6A4BCCCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jh1NXOp-zIQ7kNvwFAAAss&_nc_oc=Adqtz_EVe7FbwWhsO3KK-xkMJNvJ42Wgh_8E7dSz6rJ97eKR_pu8--yQ5p-oAL-hkvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3UQEllGhq47w1k2Y9ozez3D7DPR2iiBRCCyxlkZg7Ig&oe=6A4BBB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3zWjsIfZQsQ7kNvwGdcqU0&_nc_oc=AdoiRyIjHCmPI9Sc3jQSZy-H1Jm7zfumq8qrDha7XXQ3LqgW_cKPjTDhtMMqgP-Wr94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjzVAWFsS1hzjFVVzCNur0glClknTPGcA2aE69IyRl4Q&oe=6A4B9CAC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
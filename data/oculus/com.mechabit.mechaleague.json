l3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8LN_PThobwQ7kNvwGbNDel&_nc_oc=Adp5YPJrF4P7mjmtU0QJ6WcbycP6L7qD5hsp9WGekH57tTJtbNqOnmEkq2l7ZqSy0wo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNK-YD4RbsZcnmax5hGQtGYxSvzbBR_7wH1A5rdxCHKA&oe=69C67F06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6JSh63ZK3kQ7kNvwGrwGwn&_nc_oc=AdpGBNzcQDFaNZumKlENoGFKhyljWQ8vZiqWkSrQUIzI79AJwk4qnkoiIVwegPja9yI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPes3TS3L27utjQ4trtbbAgaC3gOFU9JTr0zlIGHVxRQ&oe=69C68814"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBEznKUbjlYQ7kNvwEuRids&_nc_oc=AdqlwWEOBhp4UdIId0DgOolvzJSQpSdxfF_M6aKFc4xCP9TyXsIgOX2BseA-xih4So0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsvhKq7E0RYsG3B6yBNlIta9RL3wR3rQ_ClFiuuG1A4w&oe=69C66D0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfGeffDhJwoQ7kNvwGxtBsB&_nc_oc=AdqO3iFeTlsiDeWFIiN_6FX8phImKaqgmgtDXMOrT6hEWtdSFr1g4sh8AjrynJCesSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZvUHeMBffc9jwG_ALmcfg9BJ3NEoy7nS-F9xCx-cF9g&oe=69C69404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdSSaUnlycUQ7kNvwGLQmrf&_nc_oc=AdrVOY3TOm9d3OzYzAGRSSRix9wjDVnPStG5eeLKNPWHRpAZD8X9juD_Sx98co4EB2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIUYGs90UV_62SpPztWtooBOCA5_uMgl6tHGN2jcTMBQ&oe=69C6752C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
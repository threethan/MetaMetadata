a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTp0aqVgVv8Q7kNvwGl_GF5&_nc_oc=Adqy6fnNldM-yBy9iQlQvRagZ4ik7bGNNK9DQGK5-gC0HOLt-DhtyGpe1qu3GLF18f8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1V2iOzy2SFw9iDzHFFBkkSy5OXxp5h_hzmh22blz6dg&oe=6A329A06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IwgpXTYsmIQ7kNvwE7l9Vr&_nc_oc=AdpsyGL0jvSbC2CMjaxSRq3FyDwrGpfjs2CBqDvQ_pTt49Lce8BCIabQLqS_w2lDROE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91DK4PgRkSHX9ZPYAUsJl1sOV8TGyPEn-UfzT95oKmOg&oe=6A32A314"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiS3r2z7GkAQ7kNvwHXzs7M&_nc_oc=AdrObC1YXe-1oiL1kE8KMeudLNTi2qR3A2zI2hGPh-dapGoza0dpo-mA4EAzSz3i2Vg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mIdlFSGc6qoQCpf5veQuWquP3Mmpc_qWdL6WPB2aGHg&oe=6A32C04C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izwvekCD96QQ7kNvwFBstQ5&_nc_oc=AdoFjC1h2YC-oObGNL9CIIRILHrAG3Tkb9L4I3ZogGsTOi3QOx_uk0dAuRw7pom4KUY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uDbX15kCPK29GB1yF5YoKAJl5I8O0xbXUMnqKPZxL3A&oe=6A32AF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9OZHvwT394Q7kNvwHBbTei&_nc_oc=AdqdINHeY8QkQY8-bi4ZkdsmCuVJlyMcdcdnHFwj2BXSNG_fQSy3tiNwi1ir2346HkQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iGzKAdA1iiZxRTsOn40w3bwk-ytW9wkJymyckFxmqtA&oe=6A32C86C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVi7vj3zyTUQ7kNvwHbqdFm&_nc_oc=AdqHdK8V5SmTZVCVzmdjjGS1X4KoxPr95AG2KSLa1LoRFfGoXYUjl4oFiEgc5xkTedM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ToY0bgDQsI93kv-YseXBQiHeSQOH4UiljJWbuZ0fBQw&oe=6A2D5406"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVfjEKNRqhQQ7kNvwGNwX54&_nc_oc=AdrN5diV78bmBLoD5KFzzec6jw0tjR7cNgEUhaZilB3suoYcl0I1FW_7qDStl6AzXck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fQXzpM9cpAX7BMSOXoY_twYCBIIEoxEHHRBX1rgg58w&oe=6A2D5D14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa-JT_gzZ2MQ7kNvwHf5JRM&_nc_oc=AdrUIaCBPlOnXTk7lpONxp3eugDl2Vdn8qduZONJkfvklkEWiVpuF07uIDQlUxrOP5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R2lV80OOOAmihUOFcDFXQXac5Lcw_ETwVNqbMqQ4Lpg&oe=6A2D7A4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybs2FdK9mFEQ7kNvwG2v9f3&_nc_oc=Adr9j4hTiAiL1KeZEY1be3ZfQST-mrfOFNXzgeE1ZuweuVGBNEo5Oin4CXQmwMEA7ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZJOtH0ir4Rq6cbuL6kB2nLTenFz63PaDoN6vyJ1xNbA&oe=6A2D6904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fstzITsPn4oQ7kNvwFpQkdn&_nc_oc=AdqOZ4pkEyd5FRENoNouEWpo_bbJkqDivOm654Mq8RWCKkc5rwqWOVQRzsxur9T55EI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aFSeugoWexoUHbYX8JolAmgVFS-CvbzRK-IueR8xVYA&oe=6A2D4A2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
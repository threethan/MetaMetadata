d5-3.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nKjDgcHoWgQ7kNvwEgcsCF&_nc_oc=Adp-jNIVl7lvdhVnA7NiNTy1bJ4d1t9QqWnBVacwLiiZVtKp2-2WoTlDcpPenp2MaUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sH5cDP3TikReF-X62Fe4zsayRZSArPcnkw7iBqM1xng&oe=69D8F406"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPta6yG2plEQ7kNvwEck3VF&_nc_oc=AdrqtmhDrKTQufgnsGrfJetrsa4baYuYBu2Q-k_rlWGkK-J_YpVfiBDF8ePpZjbVfew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HbH5ti9BvlcZBUYiw1PNKi94hpbt9q9D60IlhDmDFYA&oe=69D8FD14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djB1xeyGAVYQ7kNvwHoj16V&_nc_oc=Ado35X_6HWQhVSpEQz6j2Zdz-ySmMQsZsrs12H6IP6-kZ61RVPbR13VSfM0qIubqvMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QBls4VvojaKVmSWCa-FplqnJ1o4BLyyzjzc_pgJhh1w&oe=69D8E20C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6GrprmfOFgQ7kNvwGKYQZC&_nc_oc=AdqtmM0nFfIRRS0E0wzQB_dt3jYA8ef0qrv1uWcMO2e5jgSAXJXJsYmMCcuvu0Uwjmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c7MEWr-y7UJayjIA5ig7k7mqufY7usFKjL7fcUPcvmg&oe=69D90904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hZot2N8hSsQ7kNvwGu39zj&_nc_oc=Adosm3PJzflNA1xq4LAytj4uSk_2ZMcG8hNr6xAyECoc9MZjKAfh6oxIMEqFQSeic6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20SWSq9Lfrq98Glsf38HV0Z2LJS5zGr_UzVSDAoOGmKw&oe=69D8EA2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
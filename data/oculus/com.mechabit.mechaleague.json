/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYjsuWFJBCkQ7kNvwEL6xVB&_nc_oc=AdkENkCKRW_O6-Pd_11LR5Iadm8RmfriS4q7sBq_57KI01IxuJ0P2BTP24oIk7fmdwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsEJAxpWKZnvgf2gNwZSUyhbN5fxozvsv5KeJ68utMFww&oe=69A97E06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtbHq9deqegQ7kNvwEoZXTI&_nc_oc=AdlxFWwgFLR1ni0LW9vqagpaySELEOpKokUGLVr7YgX82x-0-5qFKvDCOzph4Ql15KQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftH8SdDiQIhcvHOiDkmb-QKwKzgTEbLPrdnNMoAluFXXA&oe=69A98714"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVz0_sQdzHIQ7kNvwHPj5uJ&_nc_oc=AdnDdl-aPj35MfuFaKv-YV5uvBZ91TCQ6TAaPL2zjxEG3gwOXJ6BLe0mWbvMFxFxO7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfteRBcBu4OZ_U_uC0yhTlcMi07JyRPtLUvcK8FL7kTY_Q&oe=69A96C0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFkUV9WOjIoQ7kNvwEZf4x-&_nc_oc=AdlzxXFbmXDaU_NhOciIAWuSfPxlxNPcgbqXxYBh7ohcu9VULzzGfyx3hYSSaOoswj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftitm6eAQY-IUqQX6vWAwi35Q-CIU-wH1PPxGZdJe5mVg&oe=69A99304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keD72BzQeB0Q7kNvwEAMwUb&_nc_oc=Adl3ZHR2BfrfjK69gkt5LUNZXQNvtb0wBKMNHFGO6-_R5eerBPBtUbw_YqyUYbpQKII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuAQ6lOnBci5RTaxOiMp61Hzl1I9PTq3AU7wH5CeaCBsg&oe=69A9742C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
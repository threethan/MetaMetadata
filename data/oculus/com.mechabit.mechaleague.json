d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhNEQK5MHK8Q7kNvwEeHVoq&_nc_oc=AdqItFwQKWOjWUJceSt8miV9mqtjZwAqOpOWS_6StyDAIlJocg8-GsSqWJSK_OSEURU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzv0TYvzDhYBwSGLKF-APupjck29Kiw8LTISSW8GB6fA&oe=6ABBB606"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btmBJo2KmGQQ7kNvwFIibNQ&_nc_oc=Adpaddx-zp7bu7G-hwCPo3vW3WIjCpx3f-sv6xRfS-nP-2stbtGY1Q3TwsElkes_gVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuRW-S0kgmUB4Hzavtr1gId2C8iJ4mDu8Q2TsW2a7zVg&oe=6ABBBF14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGaHIueYVN8Q7kNvwFcX9br&_nc_oc=Adptz9JPkV-g0QyyWebUSOcLIEzfo55E3lmjuviCYxAaOn8MqcaNBSSOKpWidfZVHFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL250rsCl35RS44DI_NHUP5l7GxtmocXWM-Rn4wpxD7w&oe=6ABBDC4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfKPW7tSs8Q7kNvwFApiCR&_nc_oc=Ado0WhQBkg3LaG949q1_zeRF9HOuB2mG8Za811TwUqdC-I4hIit-3XF54GqwtDEyan0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwMb8oyZWbTcyWKgo77Npw2Bp3aTobvXPz7kleKoC4hQ&oe=6ABBCB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QlkMj6d1wUQ7kNvwGgqHaC&_nc_oc=AdrxNC2JkCggrSxDhqWkRBkl7IxoEox259dAPEjLVrIsnBdneNdiX2jKooYCzXtx0Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvzxrDhEUbbC3VU5nb8HhRX_CSyV1Pt-4TYU5kdMXPBg&oe=6ABBE46C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
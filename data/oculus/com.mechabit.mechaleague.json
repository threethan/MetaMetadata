s2-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT6FdKHqeoYQ7kNvwH3WxcA&_nc_oc=AdqqAGbXb-6GlrDcLKSgJ1yXYpX4wWyhlq9icP0R0mMMsX6Nl2pj474Dk9PXqZtmRuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P0upXbtH0Rda-T4zZoCyiNrw5nEWA9oeHvB9uT5TRyA&oe=6A0B0D06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lT6KmSOk4awQ7kNvwH6IfG_&_nc_oc=AdrWrlSGfJhQ97BvMgKDlssiCiCzsbEruNnC5u7Hh1jnnK-iwpHkOekX8U3HudF-ecY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LArAlvcKfrbVluxPtcfieP1bHXQtq-8cnQ5vFEWDDKA&oe=6A0B1614"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSM_iRsRrY4Q7kNvwGjT_M8&_nc_oc=AdqASkguKKn2xWSxAKg_oWU80GKwUPS7v92O2QeLA_VXXIRhOek6E-WVLx-nTVfn2pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NJB8wyFto_jHshbCns5ZnPyPmRlF0RzWoVc7qtE0prA&oe=6A0B334C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoeQIte-qMQ7kNvwHURe57&_nc_oc=AdooYnBWOni4y0ye29Eci4-fc_VoWT5C24SZNSIgbaT4TurjZrgkgh-5ZWyen_IMx8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gyTNzEIsozXQ9PhQ1S7huujvgiyLIs_VyVmXKvRWjYg&oe=6A0B2204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2hXI7XqqxYQ7kNvwFGrcxs&_nc_oc=AdoXgC24QoMzjIpLgRfHiio-e4VwbtN5j31-hXtOzAgeMo7xDTv0v2z-b-Y6gnMwVDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kRZFPgyPlH2po5aiXDln5xInlXrGRkI6sSMhJjW5MHw&oe=6A0B032C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
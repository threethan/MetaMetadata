s2-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H1rgDcpcCAQ7kNvwF_TdPh&_nc_oc=AdqMPig_faz9Qy0h3StsHbPuGlQiSPoICpndYlnt6xAYjd7r9PKPrpoHnXXn-JH48LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10yA0wJy6ui5w2qxVff8yKwcGkLOtO7paENudCI8CrHg&oe=69E0DD06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeCU89heqiYQ7kNvwGNX6qL&_nc_oc=AdqB3p0XbbDkI7FMHKmLzdbc-ZFiHStknbDJ7llDRorwG4kyu2--O0TH7dVj6S_M0uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QS1MoLD1CnC0pHE99-7X9QA0W1PsXQc0Rpe-jmeqtlQ&oe=69E0E614"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE3czz3Wk4QQ7kNvwE7y2Qc&_nc_oc=AdqH5OzYVCIqdC-vj69p_xxyF60EzlunF3ISYXWaIZYh-8VBEllc4B1Sis5AmmOlXCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3srqAKuepHiDBFnqS96k4UW9E9sk1LN3r-b3ivtRH3Gw&oe=69E0CB0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rva4CcpTk40Q7kNvwEuY5hz&_nc_oc=AdoQ92Yz1VLu65QhwIEPLDo_kt1Ze237eUzNreA8d1FkCIcP7J40muvzajF_Dlp9I1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nzZElfrcr-Hy3lEPGWJRKHCVKH_lWYhDSvPIjJSWpug&oe=69E0F204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-GwG_fdG60Q7kNvwG9gy37&_nc_oc=Adpcex2PUKag10JpsGtf2cpA7KsLEQFeQ_Pap-OBbf--qqffBuWRt7GcFhvxlKyGv8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32BWQ8cC6jDKKzI8WpRvOlk_e69_GHpZJ8gAv3eX1QVw&oe=69E0D32C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
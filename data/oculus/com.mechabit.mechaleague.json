/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmlrA5k5jfwQ7kNvwGFIoqW&_nc_oc=AdkNnKQ5NYkriHbBe_xo20IXjO0fUl-FExE-VgCQue5EgRJdz2zVVP4wSk8qrPP7DCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyac1pfQw5rHpajYWw5pVlUn521t-hjV8yY_sMwMArYyw&oe=69B7FE86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gc9vds1DCEQ7kNvwFkZvM-&_nc_oc=Adn1L2lI4VcGUL6sx5sL66n5IfQIDvEPXtflkdtt5ktbJG6LyXJ9WjuqTMMjYkzZPnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK43G4aQ9ltNtaKuCLjtOEqs351FHUK3Ninrkt2EoTww&oe=69B80794"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNuyW7SL4xcQ7kNvwFWyx9Q&_nc_oc=Adk7eoNTLlRFy4ltQC6iwe1ziu7-y6IuTmoWqzwupDCSr1XXFOssAGXLTy2NJIZdiUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6-P514bkMAW1uWRdccZpqQHkwHX_F8VCWpOz-TlreZw&oe=69B7EC8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6nTczcK-SgQ7kNvwHU97-m&_nc_oc=AdnmwJnzeHG6aX43LgTRnxQGRI2np_j7h8snFj_uG0Zi9oNB6g8077HMOivU_O23WPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxczH8SPrH52txRD_bttgPrhXSwicoubhwCuorrNl6kAw&oe=69B81384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2z1gmqFYp4Q7kNvwFl5_BE&_nc_oc=AdnuOgCK-pQCYE12ZhEOS1PIUSwYG6IVB3QJZYuTGFlmf-26JvopOWmYv6PtYUd7YQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfZnHP8AkhTbhLEj8zg6Vktf5sslGaQ68fKIy17HPjLg&oe=69B7F4AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
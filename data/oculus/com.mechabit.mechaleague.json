r6-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzH1v-SG0MoQ7kNvwGYNBEq&_nc_oc=AdrKNB_IHqZz5spvNRHVmZoDl7vDoGxqaItnH5vsUySyXBATyDzucgLMNLjJ6qrujHg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vorg0y7c5Z0tQ12S7TStu9EX0LiXzUwXZ5Ugu6_CfvA&oe=6A105306"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGqmokmzjPAQ7kNvwE8BB3I&_nc_oc=Ado3UZM5XHCya-5dOojl2l0bSWKquSyUQJp9lUvynbP1vlPzwELpOgTbb4gXIf-32zk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BRmbYbx8cFSUjn1wsj5iUI9a5TCSAMq-rMBpw1rzUog&oe=6A105C14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdGNxOpcMN4Q7kNvwGIaCcX&_nc_oc=Adq_lYpDnCof6fdQ209S_yoKcwhGjBhPdj-s_7Yz_KiXQKdo-76-Ge33oGAJJhIK0Yo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-mDqPglOYxMIC6zejScWnaURx-C3rQLvMocglDhJMbA&oe=6A10794C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3zjypCAMJkQ7kNvwGG094S&_nc_oc=AdoBvMt8RnatDv5b0yRwFD2gGOz-9K21Ay94thd_7mZziQRAUOP6bIzT0uqNVnyPkgU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U3S_cRIr6dUPRpZigyd6foV-tScAQDLNmpLZLekxPYQ&oe=6A106804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5swuzikWkdkQ7kNvwF1srkK&_nc_oc=Adp1PplFuzMa-WIern595w2m3i_xibAejr9BbzfeIC8JNWA8SSfcKCHpDDqLxN6mNjQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xF8fjRvEpqr84xvS61JnF6BWiMf3h86ScUIPBNuva6A&oe=6A10492C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
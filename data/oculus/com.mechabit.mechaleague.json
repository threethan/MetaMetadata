a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0Tx4C1_gGMQ7kNvwHO-RZL&_nc_oc=AdpkPMAD4c7GltbMPI-t7iZ15IGPrkAuG9cgpQXbJFt55R_lRrFRpZ0hAj5AAhcKMFA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY9vU0kgNEIn3_Gnw0QulQDHEiyzIM5gefJMIfB3nW6g&oe=6A81B406"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHxNG3zsCjIQ7kNvwElhn-u&_nc_oc=AdpOpA8VG2RG--z9wOgVCnrg-GXvpaapeAcuuKJdu5-ZX8DgGM96U8s7BfAmxMvL3eM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOetzhITo2U2oGz-kreBTVUGEc0ZcSdjGwijinINt7Mg&oe=6A81BD14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEwxJSxEU0MQ7kNvwEol8D2&_nc_oc=Adp4htvUz7Fl4uOkJXqBFhAR0Pmrvpu-X9_9LcHBWwxsClSyq50SQhARSG7Me9o-MT8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-cqvzc81BC-vvD4zP5WXoFfXugikODJv0vLlvKBha-Q&oe=6A81A20C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCJDhVsM2Q0Q7kNvwEB7qw0&_nc_oc=AdrzuL2kqGoI9ELruVjJnvZCLJdgr4NTFG9fg-19z1h-Pkezk97QzB8uHX54Sd62wck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERt_8xkOnur6-W7o-G3blNBvOuU6wGYqCWHTxJGPDUTw&oe=6A8190C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVlE7vwtVyYQ7kNvwFBr_cd&_nc_oc=Adpwnlvxhm1Ta0D7oQ-s9hzdC9sl8nM9M-Md0KEuF8PeAwgHkOnzRwAZX1V0lHUqRU0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcsoYHAFp-mjz6FLl2CRiAFUQjnlQ1nCnmEhNqF0KE0w&oe=6A81AA2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
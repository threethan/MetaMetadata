d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EVRVn9NEC4Q7kNvwHkkOPR&_nc_oc=AdqRRgeoY2UMWGmOmsROMlhkK2VvUoN_acYaACqhyRbaEw5mVIjojOF8zdgaGcQT508&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVLMzDbZius3LRRVdIUZBpF8HXnnecky3mq96_1sczPw&oe=6AF49EC6"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SCDrK48TawQ7kNvwHyw8xj&_nc_oc=Adr4ZOLkyett_dyZd9hEjjtpSQEIks2T3HgAHB0oDrl1UIDyGJq-lnJAXGFIG4n8rxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq0ILyXg40RJPxRnqNY3uPonQgd1nsJnHtJZQ3eJOESQ&oe=6AF46F94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhQbCzlkGR4Q7kNvwFHNlZ8&_nc_oc=Adov4plrly0gVxXwa4zf7SRyF3jzB0kONx5AKk1SyGCEPu8FLexTgxeOmYcplsxf1Tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpVk-I8HX4Up5j_y7MRVG6aCRgImvKCKUtFQ8LqqlYEA&oe=6AF48CCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jsFRcWq6a4Q7kNvwGFuCCg&_nc_oc=Ado4V2Ya9uRVp6HZOfKsNQx-JAJaSjpMvjY2wo-DW90PXU8SincXbdK7gOiGwwOhPQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD5eXNciLjVAZST4ZhlMIWN6HG3LNYxfkZDWwTuqnz2w&oe=6AF47B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NrgZPSKAoUQ7kNvwEqf7-O&_nc_oc=Adr2lmNdmFcPHsNCNqPAcT6urm7Fk_Z850qsQuO77J0vNDtR9XdVg0K1VLxtDpk-vjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTShwpSEmlycbnzmq5MAQ3ONlAvYuNypVr91OiGIwvdNQ&oe=6AF494EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
l3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmdGawET9m0Q7kNvwEprz2v&_nc_oc=AdrHGLStcpuB06KGQMzkOHEoTYma1IQ13wJJWwNfjPgPe_4tmyuRd_Fsy6usYF7WJEg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f6YT7VYiwkZA0KomFciFbLZ-kt-x0raFeoUTbnaainA&oe=6A3D2606"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlIjeEJiqykQ7kNvwHXOLqg&_nc_oc=AdrGLCVtNVz6G8WUDeO70flkGbmx7mKzgf15jPR_QYmpkyi8FK5HfDAIyzZrSyzcen4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90OmOM9o-smPc7n2KmR8B3fJRwvykTMgCY_vZsmvpf7g&oe=6A3D2F14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag7NQGh7raMQ7kNvwHIz1fi&_nc_oc=Adrk-2QgjcJfxFBjsP7JaehH4WhpUkXVfN4JGn32sqlJU0JqQEcc_U_NQzjSt5yQBpw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FChhd9WAP2tcX_x-zo4Ev2OW2CS2Vp1P-XdC5LvX3PQ&oe=6A3D4C4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STAhmHsfwI8Q7kNvwEzx92t&_nc_oc=AdrrUtXp1qBbEHEupZUP_qnIDIxP3WEf5Bot-SJ2qGAk-muYgw0s5wZQK5EuFV6mIQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ctA7OkvGGyshW3Eu95dGj0lNGWOIp3CnyhlVIJuhmBA&oe=6A3D3B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7q7xEG7iksQ7kNvwEcdrps&_nc_oc=AdqGqc9kYEfdto6rMQF5TMyCSmZCYyrDJ795Y-Ah8u3NIgMNyhDZMfJ7dDbqdcCQ4YE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gsaw938xz3B2PUPaHk2uFfNTx67cCTWZbKLTx9wCMYA&oe=6A3D546C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
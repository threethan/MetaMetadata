w5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwN_ZJVb1YoQ7kNvwGbGVW3&_nc_oc=AdqxNabKMEqtyi2Vdi8QSa0KZHH8vYMAfmFxH237XH6a5ZvxDMyYqeE2ABmFuYq5x9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMqbHFR5Tc7h3KjAUrjNdDlqYakg7rYoDAReH6SksjVg&oe=6AD3A946"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x52stJR2JIIQ7kNvwHl0Eoi&_nc_oc=AdoYmii4Ov9DAkz9LIDb4wQFMBfHSvsbqww59k_ZALZe3gI7EtH2IyyKK-K3kvmWhGA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfnZ3AZ_QMP2J9j0beyQ-p4dllqBB_hvNo_0wqZstTVw&oe=6AD3B254"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NeNud6j82AQ7kNvwHo9z-3&_nc_oc=Adq55O7HhY6in-ehZJVTq4oaQTdsrJRSaoqDxBnWNo9IGYhaaSpet8dfUwm74AkEwkA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZHgrLglEgns8uR1XAOfMXRcduPoacU5n-5yX8fwf_5A&oe=6AD3974C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-RX0MsIQc4Q7kNvwGQTyB2&_nc_oc=AdrQcELQboRE0M6JMhSBX8W9Dcae0wOj5E_acISjpIW6VHthTm8luEPLvqMQzqhQ9sc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDDtk-lAKPF0eQhNQ-wIeXfA60jTrXw0m7tPOr0GHPIw&oe=6AD38604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34iyssHsmQQQ7kNvwHvomLW&_nc_oc=AdqNlqLDpvkmCXrij8N0Ue3txyr2TyRqwwjTp0rkX7iCKWzG8IUOvBlvNS31i4gOfe8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQfJnmFmq4BY7c1NSj0pONOVQtDXZUN1BacZVvPAyKlw&oe=6AD39F6C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
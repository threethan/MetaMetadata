a3-3.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-_xAKfRy4EQ7kNvwHul6zj&_nc_oc=Ado2tvCkpA0GW2_mKSTOHLVNuE6dM4Ece517E2LBCPaVSoZoVHZ2-GVw-E0BjMpC6Pw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhW-9Wj-FlAPV801N9Z_L58lh1_9LeX1Tq5N14i78M9A&oe=6AC7CBC6"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCoAeMDGAfIQ7kNvwEINcFf&_nc_oc=AdolTiQ91mmnxxNUGVnYwXHQ4mMKtSW7IWvxxiCmDHYwScZ1QA8mBHBQBGmZCTvp_Ms&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZPcCZPieQl3E1UCxWtSUDqlFm4Ey66pvKYoccXL4BPQ&oe=6AC79C94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v63fAt7JiK8Q7kNvwFFdo8n&_nc_oc=AdpHy8E7MYRckyYwMalsfxNxaDUvak80ogaH5c4cUF6k-L0L-hMbQXGu5O46IlxRnwg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6rHEYZpN84oDgDO_rvuFk30NhiChFoYRyAw5p18_kDw&oe=6AC7B9CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBJzZ6d-yicQ7kNvwFKu5xV&_nc_oc=Adpj1iCtnXYxFK29fxTiak6xqUEi2nR3aekxsMYiHQfGRB6m2GrZOw1gYpugMOcjyEk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFQNZ2ge4SSSjR2zYpOyUFNQ9l9G_mmxcyyvVzJhhVWg&oe=6AC7A884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH4Iiqzsp3wQ7kNvwHXWvFg&_nc_oc=AdqmV_oHdfvZAt7W_n1qaqRrUHk2eef6b0NLaoOHaouF9u7VpdBc_Wkf4CcQ8KtN5ys&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtWTgkVYZ0QXc8lf9eixkUvcRBTafYtAQFjtmV7mschw&oe=6AC7C1EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
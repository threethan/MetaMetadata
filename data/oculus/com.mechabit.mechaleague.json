l3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHdVHG1YlD8Q7kNvwG5kwdG&_nc_oc=AdpVLi9aILikFkew_kMt47QjtABJMJzLnnhaOVtNHVuefZlDR6krupQgzUzcrVMzrW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPmbnmINsV9dpqx9xPjoZ9J8qmzIqrylP0cWL3KcO62w&oe=6AAD3586"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HOmqrvlAvQQ7kNvwHY1GXv&_nc_oc=AdoZ1pHv20bWYbtBMbcjQvYsMGILriy8v0C6Rlbb1ZgGTyT0jUlMTxlqRsqS18luEz4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtGOUjgUGZiDuQlmONb-vXe7UtdlbPIW7bLCpyR4Bhsg&oe=6AAD3E94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bln-2jvEBXwQ7kNvwFogb8N&_nc_oc=Adpmycp7qbn10ixaBnPtAQcALlbudGg-sIm-etz-9Kl71HLt_nDnEXiNO9nEcziaP8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItbOUOOcRLMrkUUPczD2so_XGG_hOWSvfbAHxzSvIy_Q&oe=6AAD5BCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRZVDwLOCG4Q7kNvwEastjX&_nc_oc=AdrHJ1IpZUUwzMMeVhlafdiHZvFtc0rm8ijLaOjuMWpJZ2UIxXrU7KjLLNJpgxTjG4w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3dH8TU_-LdYD1AKUBFCy3nXB31cYCkS6XsW-LY3PqKg&oe=6AAD4A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_ezleEb2p8Q7kNvwGrA-cT&_nc_oc=Adrpuj376YKUJUqtiQ6_dxWVBL7kSLmMMLP2LC01ivK679R4fVGlwXWlHbF59ntPrJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGTzSaVdyp8gQMK9wmiT_4SWYvrmAk2bxK79gMyL5lEQ&oe=6AAD63EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
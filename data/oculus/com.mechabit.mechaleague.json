a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csCv_i32Km4Q7kNvwF1A3_9&_nc_oc=AdovNZz8kuDaHS6QNvCycevbaE2D6YTX7paLJr4PW74V9cH1vxVf_tJVc2ycsVQCLa4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAikWpsedHnYsy25tvMWuVRVCNmyOUDtVLLcLcNxjFBSw&oe=6A563286"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGfmSvOuEz4Q7kNvwFEiJYC&_nc_oc=AdparcWvPtF0_s3ixUFANyhtzsOsZ9VRRTcrC1G4qEUcECpnRge1gWxbdk8Cq2FJB1M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXJXzzw-6Bq9ZJuvtSA4VEPSRnEp2wxmCtbpnzv0vtgA&oe=6A563B94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPKXoz2lFdYQ7kNvwEN7uXQ&_nc_oc=AdrwBxWYI0VnqBNHtyxDr-DamkCdmx3-Gxh-DwlezUhW0wjlssy23AdRRlzrf4zOJ1M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnnAnx8mypjlH9pIsO7CfHdcWdglIMcJAmrSIwLFQFnA&oe=6A5658CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKHxAd7LT58Q7kNvwE1XA38&_nc_oc=AdpSmbQISTgxj3Aigs3usS0jrakqxGp4BS0awLBm3qobpv8AGN6-ndJVzHKxNVG02xk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAIijFjDAsfOmXUn0z2rgG6-b7aK402Sqoe5aOHlqEoQ&oe=6A564784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPhWakEWryAQ7kNvwEANcLd&_nc_oc=AdpuSjWNTp7fkw8zLpxYbhih9Pr7NH36kGa86nuR8lDD2gXNDbNCCuvZRlZov30cteU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsjs5SFzpw5WJMwupavU0tUXU0PJPaZwcgWyAVWwEsPA&oe=6A5628AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
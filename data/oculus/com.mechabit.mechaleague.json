c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-vtUuCvri4Q7kNvwFEuIrI&_nc_oc=AdrY-pVbKzN9rwfuNbewWYc6_4g7DRtcPDHGzGSuQFOcjI3_Mag1pleJBv8cbb-EM3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjg-ZjfYdNFIIwlJDL7Qg8iEagBeoag-kvB5UMHfQi2Q&oe=6A772806"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MIgJs2kWncQ7kNvwFx5xXO&_nc_oc=AdpV0rScrrvcCBxaAZUKqnaw2tZYXAbEQ3oeAUsB3JOExPFTlLtWCP_34DQJnswkinY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeSp65xTM_ulHqGOK8gYkU8ITB9NrP_AyAY9empL9fwg&oe=6A773114"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=477orw10kFEQ7kNvwFJkuIs&_nc_oc=AdqwAWsoBTbMSVvZ0EKkhdapsQWXQtvPSvrDupnr-QfZftEFUrM5uEfThUPGi0G9YdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyWtV22dzpA4yzgjjM10jMhXwv1HuRoBl76-GNRSpbxA&oe=6A77160C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zatm08SjtEQ7kNvwF6eKAL&_nc_oc=AdpXT6K1KOE8nSrlIZLTwAHKnGcYRpiOsEE-5Y2czdKxCiqi2eCDuykb6aRLRigZfVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGfJADxXYdZUphA4lfZ24BvvQYUyZ1RfzDQk0qERSCA&oe=6A773D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmjWeChe_koQ7kNvwEAmZ0C&_nc_oc=AdpqFeJxyEsz39DBza4VDWPVryxTC2-xwtiCmyeYo48NTF5zdNwssq1wIZAEVb9qm-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYHQ59FEsxKvaqzjM-aM0ZWxcwOmr9Tyu78OV48rVDMQ&oe=6A771E2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
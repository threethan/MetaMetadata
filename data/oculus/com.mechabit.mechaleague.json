d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXNF7MY01dgQ7kNvwFuXxYi&_nc_oc=AdrIJvHGvcR9NtYfK9BLPK17q3kp-jbhqiibEyfJ4JghZherxUOBbqJWBLNPzgAh1-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dBMAhnO7x5ziwvpnQcjlr-ODwOKxDjw_kUF-7N1Kx4g&oe=69D65106"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QPsiR_UvyEQ7kNvwEC6yAN&_nc_oc=AdqwfqK1mKW8LO_EhIBsKZBQtiuEvvRa2M15Pp4yHdpJ6CjEXDGcJoo8NRxWiJhLaoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JMjXQtGNp4HS3FLP0t6hKVaph5YU0Cv2mSoFfDCpaUQ&oe=69D65A14"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djB1xeyGAVYQ7kNvwHC-LSQ&_nc_oc=AdoITazYdNUkuZ8hFcikLt2DDtnT3ZtyoyBfdjm1nZ64zwZdshKFe003f2o5Y7fxpR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01iYoWMlKzfZG67KWXu18ootVRMbr5ycXQmpRESEA8Rw&oe=69D63F0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZHY1OipNxgQ7kNvwGh0puD&_nc_oc=Adr5G1h5C4fqTLP-9NqJxrLLfW973tVYJWXAEZ6z2bdyl0qW_h0MoGXErYyLkDGj128&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ywzZJuEx0_OOG40TJj6SccLfgOkn8117xAvckD9t6SQ&oe=69D66604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTq_oxhwBOEQ7kNvwHBh7fm&_nc_oc=AdoTfHAA0pFLQV8pMp--34LGmZ32W0HOmssMu20y_Pz9Os7wGUre_CRwq67wqEaefKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E4a1u77vug-pdaHqbJ0Ku1h-XI8tQqM1P-7X5DtNDnw&oe=69D6472C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
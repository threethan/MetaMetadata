d3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2yBhv4e-iYQ7kNvwHQ3_U0&_nc_oc=AdojbUDLT42zc9espgGH5kXx76mfrxGMJsCjUHj-SfoF7IiKJcnNC7FlUKQib9ZCLEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPSvc6-a4URmepRJ-tFffkIHWecNdz5-TfiZfF74o9BQ&oe=6A7C6E06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrfuSUQ-LL8Q7kNvwHKpU-5&_nc_oc=Adoj3l7h3vUBk1saYRG6gsvuaIzlwTr0oKyanELuxcGJ3akuL9YIfty_zG6jI8gZVxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4dtGt9x49Vq0xTKh_z-_YeRxfVA8GoDbW_RppZdO6xQ&oe=6A7C7714"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mN13zjh4f0Q7kNvwGt1Y3Q&_nc_oc=AdorAT9BGKYfGiTMMuqpRrb4oaX2ge5Y5BeK8fjIyjwpPne8mJcIm30m5d_k44NDR_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMH8hyw31K8y8kRMbP1Kp8mODh9ZIZuHPCegq-QOMEuA&oe=6A7C5C0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nICFtXZ-pFMQ7kNvwH7-dkP&_nc_oc=Ado4u9sTydiQeSdjAI7jIXC9wyMIFbmoLYK7olzRDrLLJtO_C-xx-UQexduiZkkZBEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfXAVhGXNEU7OP8CPo_kkGw4lEuG9hN-rR_mBMiPTRQw&oe=6A7C4AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBg86eXrisQQ7kNvwGjwRis&_nc_oc=AdrsvDwciTgoALJHNQTfMnvDMEy0qrWKG8xXJi4Ux0TfqXimzs8za0zS-VyEXy-e1-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxQ_mU8YH4OrTBERsERr3zYjmaIa5dxBYpyqqx_ElJZg&oe=6A7C642C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
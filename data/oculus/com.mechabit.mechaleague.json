c6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eBr0dDkgKUQ7kNvwHZSL3o&_nc_oc=AdpcsSZCi_rCDoUHJzeQvHcmF93OYCU57lXca-HUt1U2Wbm0RbkTEWJkLmH7r3AXbVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKfu1ZnxyP-8XTHCFxZsTMx_tls5S9p8YMsrxD5tmskA&oe=6AB27B86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7El5sKSvlVAQ7kNvwHZQO49&_nc_oc=Adoxo2EudZniOqFoBGjRQhvIarBSKDEeojMaf8VZExE8ZFeSvheI8sTfbmIvzasrEW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUM3yw4k4X9jYFPWYQcXRzZA4c57WVZTLkmzgh-T1HTg&oe=6AB28494"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sx68Q1vcZ0Q7kNvwHNLNz5&_nc_oc=AdoF_ogiifqIy2JhW0GOMBiRr_lSMJJ3H8QBUuo1VQ3ykNfeHRYRv9S4eeYwEOAQAV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_NY_xCGPD96PaDD9UIohVOvIAFN7-KHc_1HLN9Vgk4w&oe=6AB2A1CC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfADnPub04AQ7kNvwEHsLPA&_nc_oc=Adqs3-e15oey8Tl3vZ4n_g4TEsVC7UhwKXRZS3CDshrkPV3-zkekD4aReQzh34tnzso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmiZQw6ZrhtgoRw3liXEqVVxQJA7NS2JHr9l7GC6zQVg&oe=6AB29084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhQae8apkcAQ7kNvwEPGyey&_nc_oc=AdoWoZdE67GB5iwaAwo8C0oWthZmrx28pfq085CcVtIT-hxdG865sKS-vxp7xuEtKvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzESdYrAmePcfUFnTYbRVSK_QqULzP-8BSZroSgdkF2g&oe=6AB271AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
d5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqqCkH7Wx-QQ7kNvwGz7Mh0&_nc_oc=AdohUvkCLFFCPDAbXrG9qeFpNnQUNHjHYFJQ53NQ_TqaYQokZk6wr9IHsClDrKLfDuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu4E605S-Jbtsiwc3-YCbunH6FyUGf7AONtSWIw0kUfQ&oe=6AF89346"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhEi7rNH9ncQ7kNvwHoPfC8&_nc_oc=AdqS6Tnxjhl-gO3jmt3P-kISBrk8sYGqv1WmS9i225ANVthCrfd3Dzni-XOxuNaJnvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfqrYyT0orfHB6o8DRuE_m5y2rQ1PlXljBPUH835e15Q&oe=6AF89C54"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMeT6tnvh0IQ7kNvwEesxAq&_nc_oc=AdpDHqVOa4qczWTilixcElv-N_pOQKWFSLRvL59vRjywE9xHx8E2HkEQHOWVj12AgI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ26hit6t59jyahjOnFaJ3dw2ki6ouaGY3Eg2cFAonMFg&oe=6AF8814C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LkQ6CFTLyoQ7kNvwH-4PC0&_nc_oc=Adqx7YazYQQVyFhd_82DRg9Z_Vqf1z5i3VDq3q0AMlUwkL9LmbZNiaygh0mz52kGfM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Y59Ath6hoqWrG5YIF7f-YhuGcL5BZgI1_HWHLUtnJg&oe=6AF8A844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwRg-vojP2EQ7kNvwG0Klb4&_nc_oc=AdrkhrCWJh6plXDw3P92K0QqrElxEYeiwfNXY5ga7rs9spi2Ua9O7NYTXlznROPput0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9o8302sHGPQL5tKoxP0vkvouU_XGYmOBLv2NGgBVGfw&oe=6AF8896C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
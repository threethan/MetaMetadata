/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP20CW5OFIcQ7kNvwH_CW5r&_nc_oc=AdnFGVaLKZK08LFZg9Td1a2dYI6jMaOGaJ4WdcSo_4_eLTqQRMoftLEPIoqyxJVy140&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx66c3YHrO8c3tw6cR9BnW_I-y_ORbARmYHE5hK8SuIfA&oe=69B6AD06"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gc9vds1DCEQ7kNvwHg8xLS&_nc_oc=Adm6JTJG_krVAzsrnS6Xq_3Zi95zFRLTFAmmlqNXeJkywtVO7dGvljLe0ega9kxZbT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsxjEWtTjvse78tdhX1T04SV3pLFlfCd3Su2vje3nP3Q&oe=69B6B614"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNuyW7SL4xcQ7kNvwGhferT&_nc_oc=AdkOG-b99993btzVnQLD6xPKQO1m6h-_YKXREHf-tEAdoF7euz0QJOs0MsCZFSa4QKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrzKz-CTkRoDfqC0TTZlhMKTTGTbeZ8-DhrpFl3kVHZA&oe=69B69B0C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6nTczcK-SgQ7kNvwF82uZn&_nc_oc=Adm1w7CI9neKT6NMu-EA-4Ou6WDOdO2GkGBH78OzVJgWw39pEg5B_Y2UkkUQNB67pfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afywn5b1lrD3EYlwqkvAOcWxAoUurevBuDXqW-9-PQx2_A&oe=69B6C204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cub9__y0VWsQ7kNvwHeMNwg&_nc_oc=AdnrP7MNdnhUZ6-BdpJ_L5cARTyjaPnzmG8HXW_2ehobsdtj--9TMePoNB1-PiGP__U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6cV_mH60pBFxYM2X1YJtM0DvhUMKEbtlNs-TLWxh93A&oe=69B6A32C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
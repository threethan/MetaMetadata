d5-3.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H1rgDcpcCAQ7kNvwHpmdJU&_nc_oc=AdoheRKCOv08SHXAwNVeagHtjsPMwoc1gWP-6bJIn3hco0MOSChLAvys94vR9pvtEz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LWMr0AJuksEkuiSQWSdD8JMtIbpdT3_pALxJHSnbHIw&oe=69DF8B86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxNSknc5kxEQ7kNvwHQVjmD&_nc_oc=AdoiX2v36JgJ3UuOXaiceWouDWd_w5_zTSgx7K3ig1SuACjeovruawL9hDwQPZf4Ajo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ImszzCioT9dEPBOEqSqsRYy8IRs7eG-By7VJcEmi59g&oe=69DF9494"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE3czz3Wk4QQ7kNvwF2Cth5&_nc_oc=Adr3xNBPZQDoteb4npsg-4oZhaaBralKWzLFvTO9wZuplZhq2AgiKD-c1ydm_BmGuFs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2heKESHB-2tKNQveF07--kpCiXhp2W2_LB-1KNhzuMLg&oe=69DF798C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7AZstjyiI8Q7kNvwGB1oWD&_nc_oc=Adp332gHDgda8J1HrnESxEbPCazeTRWTXNhh95E7g61n2MFyB1hJjjRzNlzr3vd-bgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QAZXGiz5WKAN5OdLA4LHQ_txVzUlfYB_IKID3MBMi4w&oe=69DFA084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-GwG_fdG60Q7kNvwH6Y9ut&_nc_oc=AdoZecvegFrXBd4ExfEBF0U--rkMQe4Sb6zhQYq3A2a6Nav06jsrbET5tObSSgf3X04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ecr_vZ-EJ_XqO0Lygim6Y-XDM6yM9BWfz4wl_T8iSlg&oe=69DF81AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
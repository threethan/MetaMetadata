s2-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1tO8po6a0cQ7kNvwHWBl0d&_nc_oc=AdqblPGsX37b3Yfu4gi4JZjHXibIk7GYjafCPqce4Ldu_brWkN25hVIdGJmm4FYJbDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DbJRbcX708Ki0TPSasgUphhY2z13StKcdzYQSjZB2ag&oe=6A3EAFC6"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlIjeEJiqykQ7kNvwGmwpxB&_nc_oc=AdoKIzOGPo7Yu3YoguL2vIOuRBEgFzZidtlVie9EzaGoBMR9cUhlAQ6x8WAFczyoNlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4lbb6KXW8aorsgkBUtcwP5fxOaBtjfJTYwzXb8DuhSQ&oe=6A3E8094"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag7NQGh7raMQ7kNvwE0yV5z&_nc_oc=AdoZtqqYeQEvSb196Q0sF5JFg-_ygxa34ZH3sb5R2OHp8E06Z41rtIpweSs5b3HZdV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bw0ty1QXfjtvvZ1haWjshnVxAMFksBGOa-EA4UOIo6g&oe=6A3E9DCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STAhmHsfwI8Q7kNvwFMdtfC&_nc_oc=AdpHCxc7d7ONaAbiMEky8Uz5ZBCe4Uvdh12oPASm8px9nTSZem9TrVvve89J5iNS7cw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0alBf_CU2eyvOgcxVr0gu7oSCUAKupl6yz7Xdrrjd-g&oe=6A3E8C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JewiVk1Kva8Q7kNvwHqGq4n&_nc_oc=AdqNvJufTHaobnN6-OKkmr-WLYaHfB2sFxbKjayZE5U5IykwpYr7jZeuDNzir_2TUWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ImUuD7nRrJQyBAlkrNDpLqtE0EYB3DudEOv_MInzywQ&oe=6A3EA5EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
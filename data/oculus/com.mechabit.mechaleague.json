/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmlrA5k5jfwQ7kNvwGMclot&_nc_oc=AdmE8lJh_J3rIaos-QU2ADp4kiNrKOcQQs3leNfTkFRQAQ5OVpiIU47Uc-absIPKQmg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymWOpHcFhnNThIXnEKxLoPOSyyorJvnPdDYlRiW4tJZQ&oe=69BAA186"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGRlijDp7T4Q7kNvwFee33j&_nc_oc=AdleRVoWSp8XZo_-UsNQF21Vyx4Zpg8kiskq7aypg60cWNXnat85-eiYHXo6hnYhCUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDZaCdTqLDrpFzlD4AbexPd8P5N1w_Zm05WZeOMTUqpw&oe=69BAAA94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91gNG2q7F8IQ7kNvwFGHVou&_nc_oc=AdmBjkPUcdblCqxVlVnFZIGV2-zb8zgs09cwg-Lj8goz9ZB5q2IWqpq9mZ9Y4tC2POY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKNNnKOk6CwY1JoFUJE4CXXkz8KlVTeQDSo7kVAdbHnQ&oe=69BA8F8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCatLjbou0cQ7kNvwHptWSV&_nc_oc=AdmmCCzWIoqa6yyS0OtbDmIuXDPNh7Jdf9fiUltJH3v1GKiyh8rZb7A55A9dXXMbC08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvSihf5fKFSf5ovgYMgyuqwUIix-kZ1k5JLNwBR8ZLOQ&oe=69BAB684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2z1gmqFYp4Q7kNvwHnL_ym&_nc_oc=AdmGYrtubGlYS2Ft0ZlDEXQrXSmVQp301hY_Nvu5rC7znl4lYrNmytCLh-919jbL5qo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyplp-v3KwKeI-g3uVkmayH3tyulUD3YsbhZzhkGev95A&oe=69BA97AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
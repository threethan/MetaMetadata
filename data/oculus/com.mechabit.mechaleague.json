sin11-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=976JUHD8pegQ7kNvwFFXRo_&_nc_oc=AdoYAmidof_SWw6o-ZsVzp8XY-AW0J7fgp99-5OMk8Ru8VzT0lHTvyxnR2BDFHf2KY4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuqBdtJakEoxg2Q0_1IYhNVTCB6PczGHn2Qo_LK6wO2w&oe=6A7DBF86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrfuSUQ-LL8Q7kNvwFB0p4u&_nc_oc=Adpeel2b9thS0A_xpfIabPGWx_bLxKGUGoRBsy4wuQ8-umOtT3cnGzTZsBbBIWGdrWY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-SCAM8yHbIQqxMB-7wqTPawGCg1CEr-7bqyqVvRd-7w&oe=6A7DC894"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mN13zjh4f0Q7kNvwHpYyIU&_nc_oc=AdofoUNAkWyUY9MyRqLMtN_X_P4jxppTKzfw-upFkO3z9myANcGy50jXHcTvLZksjgM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ07pBjrS2Jg4HBw4bsQN-1tOr33KYUDaKUIh8wI1ICg&oe=6A7DAD8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nICFtXZ-pFMQ7kNvwEH-GFe&_nc_oc=Ado9bUqwzH-f7kX4IL6gjY2yREpa6GxSGF7LU5-Bw0tVeAkiwlzZvIPHt5tpzW9sXiE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRONvqmPQQrZRR0tDCshzfY0Ie-Q46Iuu7bDXrVKWQlg&oe=6A7D9C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBg86eXrisQQ7kNvwE50pg9&_nc_oc=Adq_Xa05mynC6o2Nj2r7ZpeQmpr7CbptvZDDoGB4_rkKnfgrRmaFBtCjFSinuXby9sQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzh3cJtlTVwmtpvIN1HhrLYdO_e6fQ4A9tYSewqJbjOw&oe=6A7DB5AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
a3-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csCv_i32Km4Q7kNvwGTsGzO&_nc_oc=Adrc_jpwDpBxZQqgjo4EZeSI23XptqZEqgXavLWwtkyq6N0ZO8USSdyeKOpUjZzMU1Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE8Vd2L6TeIq6jgwv6bufos_YRCf22XzW-0M5hWYDLdQ&oe=6A58D586"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiiIMfAWOo8Q7kNvwGJsiaF&_nc_oc=AdrLlQ3ubMwzsVVUWQS0qugMCm3AXn4nTg7NORkzmFGFmD8PFm4y0h5j2UCs0L9B_0E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxZLTawjpaHRkAExJQIVwkVNRNdEygxeFO1uN1LhYu1g&oe=6A58DE94"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW_MHVkoTAEQ7kNvwFVNgwP&_nc_oc=Adp8o8ubUak32xOlV6LH2Tg1Gvuxgr3AqbiKgRPO0XKq6bV0jxuv1gswNdi0ylx_AIc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-sfFirQoVL04RXul5Q-ZzCwq70SPEzUqTLHw8AQL4w&oe=6A58C38C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NnFeHoDDj0Q7kNvwECy9cD&_nc_oc=Adqo7hFhzdribwA4K6cR_CXfv7_xk6Jo4x9DsnO_3SlImmMr97a4kTI-nv0gS-z2fQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnEaTkx0kLX_bJhaFwENGI0JEqbI6-qhcvqcGLq9cXsg&oe=6A58EA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPhWakEWryAQ7kNvwGXB1dp&_nc_oc=AdrrwVbAJfg7CD_1Gsif_X3_xDoMOuZrfV0Jle2lAXEuOaydpc8hQrIG1tdM7pQApww&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAV9PG0JyyBF_jwVMHca09LdtwR2V18YiCcThmrvgY3w&oe=6A58CBAC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
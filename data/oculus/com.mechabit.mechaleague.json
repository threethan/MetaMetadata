sin11-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQu8pRS1mJwQ7kNvwFwKp6K&_nc_oc=AdoiD5E52nCR-1eUuLQUsBaLHSzCNFzbKnnfampeL3ATmJ13Ek8DKlH_-jjC8BMycZw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yVsDPSIFrTILsQgVijGsmtYeZd3K_ir3mMEjLLslgEw&oe=6A22C806"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFWhFAdbB5oQ7kNvwHQ1gi7&_nc_oc=AdpwSoci9rfE0CTgRhx9FPTXTJi6gBjYarKsGMt9lpvv9OwLvI9pG2GHapCuipBtfQE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8drdOrJ7u3IdEOHcc4rAoLC673sP_zMQPsi19exP28og&oe=6A22D114"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wip1TpyZ6UQ7kNvwHwgkgo&_nc_oc=Adr_dVL29KBbAwIhF1mwhvReeipiwtU9rMtsYYKpy3yk_qTO0zn_p5oMbtEvLHBDEdQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iL72vtWSdzwfxtJs2UWvzMY8o2QhV0mt1rNLkW2rU7Q&oe=6A22EE4C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNnfd-qSWCMQ7kNvwFSeolQ&_nc_oc=AdrYoEMhvb4WrcPDyljxD0nU7SZ3ojYtaF00ndg8SQtj3pjdbWVBMtB_hKeRyngMA1U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EwRHJy8r21RFRKdS97P4su_iSSFBvekDr-Z-wqKS6yg&oe=6A22DD04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj-qLC-mf7cQ7kNvwHLWfdw&_nc_oc=AdrlGMARM_lBzZOHVV0fhAJ2E5v2m3XWOTyWHwwx-nMdYHq29tqYYUEc2tyPq8edk98&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b8Zw7tlVgVEE-HJSUzJvdAejZYiU0HKtyc-aawJmwzQ&oe=6A22F66C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
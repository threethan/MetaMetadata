d3-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-JYTcaSfdMQ7kNvwEMOrh1&_nc_oc=AdrAOhzqqEaQaGihhM8PSBhp9z5X3ezJTE2vVGWHEeO4RLVCtMF6ceLI1Ns_QwplefI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LaKTtJ0JZg7JciWjaQpDpzomg46KTE8WvIHWKps2mrA&oe=69ECBA86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_fsNHhhrGEQ7kNvwHjI0Ht&_nc_oc=AdohzuBWQZ99OkvOqCFi98acSXcxTaXx2B6w-DlMndMN5C-eThlicH5f1Q01DV-v1Cg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XhkjnOvfSs7tYYict1IdREa28nMvS5qDfPtP-q7h4Yg&oe=69ECC394"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4kN9xkKPP0Q7kNvwEksR4s&_nc_oc=Adq3-ZI3VMzXcStmxFLhPxJ7fWatHLQNJKSt4KAZuy1h_Rno1J2qi-UDiQbca3OIQD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rv8Svda9ZoKXukVeKIeFm_vi5jz6ag-INe-iV7FlLUQ&oe=69ECA88C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4E_l_MTnkgQ7kNvwHvHVlP&_nc_oc=AdoBYAHXL16lCJ_wErmUKSl2VPgW2tqD2ow0sly8so38BkaUztNb14GP2pU0uEzXUxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dx6MccdqFBjVtMQDiV8VQ1HglD_fcuBlj9tjKcck1ZA&oe=69ECCF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ikdy18eLEcUQ7kNvwEXh5y8&_nc_oc=Adq9WYHBako9YA_Tq2tajJeFnsnjqkXPOyKJmTvDE7v3NmhnXW2JDqKGSdwAxzgSECY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af095yXGcapUCRSFkwGlfdX71T1lD-fuSYrix9XISA6l1Q&oe=69ECB0AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
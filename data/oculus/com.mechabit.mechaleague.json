w5-2.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQu8pRS1mJwQ7kNvwH8SWB4&_nc_oc=AdrdK2euj4Jbo0nsKckUuyLOGOMn9lLc4AKssHSz7p03oiKmjidh46wQn0rbm4s7c5w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8120DYId0LafvfwHE3uZtJnC8SHWcwy30DpUPfsI6QuA&oe=6A241986"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2xCDOwbIuMQ7kNvwEWk7Xi&_nc_oc=AdoTwRDE7OoUYzQHYdu5FByBdoqzNSvrNtzQhMaLylrlKu685UFumCTF5sB1RMc6kEk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IoWZ8kUrATMgyC93BWrzDvx3_09cE_ZZNVCJ_aNU59g&oe=6A242294"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wip1TpyZ6UQ7kNvwEqi5jZ&_nc_oc=AdoK3LsnCDoBrNdjoWrloT4206mUQK_bKsCnNZglrIUJ228_VEO7IxFH03AStAVOqRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RR0e6o-27sivRAPYTkcTPTohQE99SCy7Yd4nPdZirQQ&oe=6A243FCC"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kNMDAawzOkQ7kNvwGgkEma&_nc_oc=Adq-5t_1Xil77Ex9H_6Z2UwALvoY1lsTw9wMt7ww2DAuCQglfHzaHFdDxrJH3JddZEw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_eyavibT8OjDsMYyxvWTNL2n1J4bO95uxWZ-0MBw_pw&oe=6A242E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj-qLC-mf7cQ7kNvwG9n2hQ&_nc_oc=AdpexSaYUq_H8fTOgTH6zUSX3QSfrSeSYb1w1RmUl7rAANveltLfMIW9sbx8LR8Ox-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jOoMSue7fk2Bv68EXY8piLIKPCQBIGeshbw2GjuJjMA&oe=6A2447EC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
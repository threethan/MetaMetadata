w6-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPQD6tNJdLIQ7kNvwFwSdom&_nc_oc=AdroMCV07BcxTmWjScKC2ivGihZIzP90h4g8NUx5w1ahlzhHC_o4JITd3bHwbn3eDuY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgu6rYLKJghAiFDkd_QssNBFRxCpkdX21eS2ej20n5iA&oe=6A8AEE86"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3JUOBbCvdwQ7kNvwH45chM&_nc_oc=Adopm1Uv5zTVxZCk6g7EZlx4KSFEopaVtWAaHFmg5XLYBsHemdIL4dDiBWGZ2iMgxkw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ9PX8-qNh8KUlHtLWB5OrgJmXuOgp3FL-smW-g78IPg&oe=6A8ABF54"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zS2VJvoTg8Q7kNvwGq8w3n&_nc_oc=AdpAcgPazCkd8p16ii2d50fAF9BubUkA4iS23NJujdk-uWcz61VD3Xr05GYXL-FH_LM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9vqxoTWV91Ss1c9g92sn2IwMrcC7pOBYyj3mJ3Aqdjw&oe=6A8ADC8C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAJDGRENtxUQ7kNvwE_1WRi&_nc_oc=Adps_CGLcq3vfsaobSmvUXW8GyJAGU50E8UGSfcZv439ff_hsrdYAADVTmzHY2Y2S0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFrcJIgkCDopQyHcyqW-DlS-hBqTDnjHLdJ4YuBbgrkw&oe=6A8ACB44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-c9M4sqCn8Q7kNvwHJd1M0&_nc_oc=Adrr0z9bVreenVN2blnE_lRlJp79rh93fjOOQqSbuAL1xkK5hdKmzb97bjO4RsuosX8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcGGImWIdNAGPNiG9iDWhpKNihaQfswOrYrKWbH5bnTg&oe=6A8AE4AC"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
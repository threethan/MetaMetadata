o1-1.oculuscdn.com/v/t64.5771-25/38982528_353844347030244_7123684992587203916_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kzP4nmCqvYQ7kNvwFjFYKc&_nc_oc=Ado_s3Prqlc9iQly9VLUIJMFa1f5vG0wbQLsWQ4Oq0IvSHTsrTZRpDgy4YUX_5oj2mg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcecS0azfAWJIjiK-4ONSXSVRfIJOEaOcsgooZKqTCDQ&oe=6A942906"}, {"file_name": "ML_Screenshot_03.png", "id": "1060268268428450", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974650_1060268271761783_7943001632488731779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upR5qeP-CqcQ7kNvwFlDMPG&_nc_oc=Adrzcl2YA79FuAOAc_wVs2CSyqUEKCzKi65N3GrakyqTamYoPKreGDePon8ZXuFSjRQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGru1y8U4kQvDodQ2Xv9fQyZC0wx6awMF4Y47cuzlcJCg&oe=6A943214"}, {"file_name": "ML_Screenshot_04.png", "id": "380923004441597", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982553_380923007774930_1228591233058235537_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAkIZ1Ib-v4Q7kNvwH5BKdU&_nc_oc=AdomKclbiGH9XFmXbeBUkBfxz-xz1NwQBu9oZ9w9RYtfTKw3fZ92ZxqJVzyuESN2ffk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbP5uTYtcPHGw5OZukQSI80WfccC3ppYScxpzkqLV0mw&oe=6A94170C"}, {"file_name": "ML_Screenshot_05.png", "id": "1537998253686087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982464_1537998260352753_4764487082241647087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHW_VADDsAwQ7kNvwFYt4tG&_nc_oc=AdqcvzyUlTIV1Ix7A4fDiGakCVTpqy1O5ddhzAxczMMkyraMz3XYg2sC4bED3RpWxcE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGehhy46SKWIwyGbiS9qrkrHcan85QSBXAfvv4kuGKeeQ&oe=6A9405C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ML_Cover_2560x1440.png", "id": "360618736436089", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974593_360618739769422_2070863691655243917_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg_kd1dLu7sQ7kNvwHUJpwd&_nc_oc=Adro_PFAwxtAgYkuZF4fHvWwmdosRzV_U5DaUJD_4A4FkRoh6bd4z5dggIUx6zpPRTs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9rl7_gRo-VSBeTR28iqL5ojdM7AeNqfumRwSz8pyfYA&oe=6A941F2C"}, "display_name": "MechaLeague", "keywords": [], "long_description": "Description:\nMechaLeague is a fast-paced online VR platformer that uses grab and pull locomotion, grapple hooks and air brakes.\nEasy to learn but difficult to master, compete with other players on PC and mobile VR headsets and desktop to score the most points and fastest race times.\n\nTriple Trials:\nCurrently the game has 2 game modes, Triple Trials and Custom Challenge.\nYou will then play a 3 round match consisting of randomised levels from a rotating pool.\nRounds consists of races, orb grab and bomb tag games\n\nCustom Challenge Maps:\nYou can also create your own custom maps filled with platforms and obstacles. \nBrowse all the maps made by other players and compete for the best times on each map. \n\nCosmetics:\nAfter a Triple Trials match you will earn XP which will unlock player cosmetics.\nCustomise every part of your avatar.\nContains both free cosmetics and premium cosmetics IAP\n", "short_description": "MechaLeague is a fast-paced online free-to-play platformer that uses grab and pull locomotion and grapple hooks."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "https://mechabit.co.uk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
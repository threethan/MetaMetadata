IuIQ7kNvwHKZ4J6&_nc_oc=AdmH9Cx-13rjKIUNnV-0dMxpBu0YR8sq2bz73Z7ll8femOenQIvGNmO4nFjZyfqyZ6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwdJyexzeoyxTR0P9MhjkKSVh2TzwNQFNrdnMU7nnpTkw&oe=69B7F8DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTcwvHE-5UsQ7kNvwHsZH66&_nc_oc=Adk1_C-861Ez-1oaghNO73k2MzYTm1UTKtYnKESEIrFeEwKjLlCMrUO-M614kW8Av8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afze8MTXi0yAKHKK0PNda35x9n-GyaCdIPlZygiGCJVNlw&oe=69B8030D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KVOCvw2uxMQ7kNvwH0ZAxw&_nc_oc=Adm8NmtznBNUJnwruw4Bqm-L_I8s1yezJ_ymUuzGRuBBq8_ylxcjNAG_sv2SbDn_j50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQXxmXYJIu_gUcEv-Z7k4C370r_rNi-wBaVPUIKgAjQg&oe=69B80619"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp8Vj-eDYzcQ7kNvwErA6nn&_nc_oc=AdmfBLRPn4_g-ii3JdjpXtVWOKyXCbqqY1Ecsb7JKLrL9hRtf_DnWHQ5EURTTqM3Awc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHQnbC--_yoEMAjKyC2actPz3E7BJcbSIs3Gf2-s47ww&oe=69B7E854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOrJqAoa6tQQ7kNvwHKM8rD&_nc_oc=AdnYJ7QzNdEbFWUeb8IyLlFxUU7CU3utP67njroRM4jqCWcu_bXNAi_SEyh6gCLtbYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwC1BGIPTbm9Azq0FHAPB___Jt5fucLkjs0egq7hOekkA&oe=69B80A80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFOR
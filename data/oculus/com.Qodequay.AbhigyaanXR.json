dRm_YDZIUQ7kNvwEKxb4K&_nc_oc=AdqROWGXkBRrelCSr_hg4SrfFRPzkzwYI9SA3PNZ0sVJG0qsNrOayKTD8_J37JjFw3o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3f-Yx65BnDXZ0OaaFTWY7NsWLCdjE35WdQztNW-rCErA&oe=69F1FADA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzKkSwWvr-gQ7kNvwHGZZ4K&_nc_oc=Adq_6c2MlvbpcJ_Ju8FFVEwzhIv1PfhqlreqVOrXxII28g4P7q--wDpXKz2_PFG7qJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af195UE3zJUXsuVd4m5x_A_InUAiQTpqJdg3y8lXtGxYMg&oe=69F2050D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6oDybL-gwQQ7kNvwHZKcQL&_nc_oc=AdoEUGb5lrcrO98Kfrr_4jcf8VkW03oJl7Ax1temJLr7yW2WmpEccm_eSMtoLdM7Aqk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07wB1PTREpxtH0b_j0JXXZQJA6I8ATcBg4u_QNdXG2BA&oe=69F20819"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W8eNvUoE1QQ7kNvwFqJceC&_nc_oc=AdpiC9YxDq8P5NBYxwkbGvgGanzyJRVwXD4OxFWGr6LyovXQs423aCy4dzRaV0y9TCA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HjHtf3WnNRJpD2vgwGAEI5cI15_hn3U5J2ttNQAZngg&oe=69F1EA54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tZaSpacdMwQ7kNvwHAyPOs&_nc_oc=AdpBMQ30SgtvoqdEsUuScXbWDqCbGwtSCR7NXbUI9ZxRISW8e33NqWEt4F5oscTmuhs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3q6-mWOTUJOcP5gDsiDWncdxCoD2L7T0xS1vy8p7i3_g&oe=69F20C80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOM
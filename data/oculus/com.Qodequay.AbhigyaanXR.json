-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHI7ZKfmfaAQ7kNvwEZ11dU&_nc_oc=AdkEFZoiwMH4fA9reECu3pV1H2ysG_uW_CnUvN-Xs7FTjPMxRWMlN-S5Phs2A5mE5Z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmWLiX4a-nKnAwjMMKOkAajMIKj9VwrAe3Ip5PYdDV1A&oe=69A6DF8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WpkC10BCq8Q7kNvwHT5yRg&_nc_oc=AdlFh211C0Trw-HCy3mkrz4DbWQ_3AKVQwiZu4tFqiry3NLgkFbJXGgDow7khoNsyVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsjsZDPOILa4Ed9i7Ni6lbhpMY8jByQ-QcPEpf86qD79g&oe=69A6E299"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdUoboPbxKsQ7kNvwHihQzi&_nc_oc=Adkw2ZWOWI3kVs23hBhG59x4zZZTv70JBlWKs37FxMxqXtANJXKT9jQlhdjNfwumop8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnDZxTClpMCV42DCmcSPvnvb1JX8ne5ky5cUnRAMtpPw&oe=69A6C4D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b64nn0SVoz8Q7kNvwHvkwCT&_nc_oc=AdkqF7fU2kdJ5Uc78qBd8urDE77gZV15eHnObDLlNoX2hSgf29-_5A-Xx6LGkOKTdko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm9wYhEpqPWwma2pzG_ml0N0XOJgNR7bDhR-hlFO7aGw&oe=69A6E700"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "
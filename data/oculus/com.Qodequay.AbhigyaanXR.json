vwHosWvT&_nc_oc=AdpBgyBJ5ZWvxEG6uXMYoKia-z3A4_OYWr4IJDFekIfY3oY-Fx8gei0wFF4tyJ5uzLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEkJmqkRVuLfty_yIKJ-uKL1KbvWChXI1RrEhtju8N7Q&oe=6AB7BBDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl6Ix3eyrVwQ7kNvwEJFedu&_nc_oc=AdriF6ekfptuuutul866t9gxLEJqJhkSI6xTt2gu-Y4BuwmFjGIzedg_8z-4Im-uojQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAKOJQ4F01GW7dmVxBOsWehQP-ol-Afa73IGs8yzErNA&oe=6AB7C60D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVAIAkSjHrwQ7kNvwEhG1WL&_nc_oc=AdrE3WTnv0Gbr5WuJm8mIOevq1zpiSz8Xcd00_Z9uweFdafOvcCSIodc4PhcyVw9wTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXFgeoVvPWqye8rOM3hNZ-8N1IbkSEArdykP3t0g9Qlg&oe=6AB7C919"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTy7tRR88j0Q7kNvwF1bBPO&_nc_oc=AdrqO-eFegyjYZIQDTy2bt-VCeQo6WBHl0tOTJlTtuGNV83tbLEltejs96w-hoK1tdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh8q_X_SNdiA8GT8YHrHxqyL1qb4FwPaYJkEJryufIhA&oe=6AB7E394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haOPXZZ4SXUQ7kNvwFaXU2U&_nc_oc=AdoDEUoadCcFVwLzu2dtvNwdBGty8XFaNyCg62moedOVxcDlaRPg1dxeVgLYQzFn9zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpvo4xX0TyT6SV8IvfmihjeWtldm7MuoDAU_fkeHBCDQ&oe=6AB7CD80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
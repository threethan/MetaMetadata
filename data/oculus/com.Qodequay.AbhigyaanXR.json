vwGh5HfV&_nc_oc=AdrsOfehjHzsEEQ714IuyqDKZpqcmImGaJZCjY60InHt_GCfTPcfQVXh2EpLYgGd3n8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0x2BvdpyoOGIjI0rgvV9h8kUNIP-46ZWb99OEwehey2A&oe=69F34C5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzKkSwWvr-gQ7kNvwGX4nZW&_nc_oc=Adq3Axhe1EL0-IbBTlpmUNqqYHXde-qSPxrno1NahV-U7yyZd7n2B9Bu4MaGGzAapgk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wthciZOmx8AeoyhvLFwTvr650MFb1LsCM7rfJ1FrEQw&oe=69F3568D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6oDybL-gwQQ7kNvwHQXRzJ&_nc_oc=Ado-j3HvV66QOHeT7HlqvDEddoKxLGZB9Z4W-evbLgLzdp2h31V3O9PlGyWLuW_OJrU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E1g5ylg2NFoewZi650YW6rJCUmz3oXpnWe0-6cLVGhg&oe=69F35999"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eFUzHQqfC8Q7kNvwGjvSWG&_nc_oc=Adox4dzK3rHnvwE4vA_v_-FYAJsdiClmjODFb443ip-kBN26eOURNnjsPlBrS-fcDHs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Yll6v1fuHl5Op1EAMfYa0cCpPHn0wnQkRcR_YjPP6aw&oe=69F37414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK8hYaQZGWAQ7kNvwEV1Bu9&_nc_oc=AdrYc7C4Z-XL1ZpduMZCZ43xz5PjCNpZLN_sUedQBL-FZKYD9o0HKya8xFFvhmMGLjE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ksj8wh7UNeLIJNL7ycrxpXLEjIiGHcb0hzmfxLHmyjg&oe=69F35E00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
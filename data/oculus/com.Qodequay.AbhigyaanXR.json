hWkQ7kNvwGC22v0&_nc_oc=Adn1iYYidFY1hRwhH_HCTJt-4HcFSKvOgFFjkzNkgXb2YGvIS8ufr6B_P4sjc6YmsUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxP1xe1oZP5Uq68EVRCzJfWVCVWwpsPidBT_kSoPYOJEw&oe=69BFE1DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4v5U9wt-lgQ7kNvwGNiL6g&_nc_oc=AdmypsMZofHLm6sELG2_CWlYPi_4RitJ_FGqOlcuGWBvnT7jeEgJvacyXUsNhwTwLII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4sOzQFSTeLeypP48Jjup41hzT86uxarE7p6hsbPGaeA&oe=69BFEC0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUcA3ARo-iAQ7kNvwEE1NbJ&_nc_oc=AdnCVqmGlhQTkgB-GTuYwN80ueCiWU-FI-y4iGO-e4mWSb3Zhnf0vz8Ay82MwNNHdp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWSMkXlOCJRxdVLVYLyqQg5rV6AVQ4Vtb2whp6GuSPBw&oe=69BFEF19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AcfMEz1Pe4Q7kNvwFoChsb&_nc_oc=AdkrZdkDlkRhZClIzoK-S4bl3AU_0N99dDEgIt2ng6SziRtBWq162drDat-JVgoM4lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_kr3DuTrhPikovkF1bxivba-Nnwm3qCd7Ho-6R0YC1Q&oe=69BFD154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLGq8E0toGMQ7kNvwFQdpMv&_nc_oc=Adm5MWY3eIm9YmA7Lr0NagQ82MfT0_tnVQ-ZxOQGE8Z-FvPQz3-ZDR0QfRQwrMBSdd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXC7HwrjubQzQ-yN23gp67Noa5y-4PS0gmOjZ38VjFkw&oe=69BFF380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFOR
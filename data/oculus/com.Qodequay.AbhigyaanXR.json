J7QgMB1_ozmRSE1zaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsW3T2vHStmAXlCQ77BtVQlmyl5on7SpSU6NYhNFAcF0g&oe=69A4325A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4b6rHRBSA4Q7kNvwHt2sm_&_nc_oc=AdlrWC3zerbgxdKuaz-iWoQ81zBt9KhUEHwQo0SsHsvL5WoRTXGrfOdPgMyedYPxcpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuIRRsTenI_EJUhL0dkkNdsbh7BM2GL9f2Qt4_NY0qffA&oe=69A43C8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFy2w6Os8cAQ7kNvwFGUC_R&_nc_oc=AdmMeGkQ_aEoUA1pKviQsZwJSrfZAcQY3hPtQ1gZhqxdZ3iRxJIHkfJLL9TWz_CcVQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthtnRUfrS0boTE-yl2zihcuWkl9l58sti7hbF1K_Fu-g&oe=69A43F99"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdUoboPbxKsQ7kNvwHKcOZ_&_nc_oc=Adm8kyJLUkmAeJx9aYFpPe1701FFHy_PbxD1YS5aNJCeV1KaNgmOBsDHQH3gbvqG-zo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsSCRQoF11AfFqfuPfIeRhUY52C7Mn6v5ux73qP7-XkFA&oe=69A421D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b64nn0SVoz8Q7kNvwHWwzAH&_nc_oc=AdmEUAAhMxYYb-stkoyIFrZXLPecxlRp11LgrXc5OMNm-E3agnhqz2YCOE_06z14kMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvyH2Dp8dSk-wtLel2nDDgXGmS7wJQsdnxAbzN1wAWx_A&oe=69A44400"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
vwHok8yt&_nc_oc=AdqmVnaqm0wcBl-X_A90i6-cYVamDv69-nX1OSzA8uB-llocnimVb2FL4rQMp9SW8fg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlfEfw812L9FIFMIzhXlsZkqzBmMyJ4zMq6aUE5GGaeQ&oe=6A9C0C5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZnJg-BTj3cQ7kNvwFzqCXX&_nc_oc=AdqLp14vPjBAcsF8fgOYggCgUl0QiWYGo9qU5OpwUEAaLqTTFwhw4KF8SXFPmMqHWJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfEYf6AJgZ5WuzRG_uvYefg-7cTfmHN0K76z3tnVTOtA&oe=6A9C168D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92LH6i8wn3QQ7kNvwFF3MaM&_nc_oc=AdrDZ6rnl8FchGFcsTgAzpYUr-AsQPQ3uZuOGofqezin4N7-1-G_iloluNE-TThEeGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzkcf65jEylTcK3I_DTwbij6zLS2GgRw9nJv9nVcl48Q&oe=6A9C1999"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePZXQw7zH8EQ7kNvwE_BGnJ&_nc_oc=Adpd59G8Anv_JIa3WF_ys1WvEPb_MS5YB0oqzHOd5HwtuKngQOfcm8_evVvaxlyPokw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWcy65hQ7-UXAmNDvrWOdD0EMLPh6zrgyu-xKRy56e7g&oe=6A9C3414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9c84M2f_xMQ7kNvwHV2ZdI&_nc_oc=Adq0sjxKfX237STYqZyJF3xZ_hUjeUYgQ5exMmjGv6mT5Iu3B-DnyCUwDMOic4Plqh8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEbxNanuWVYmTSKbAewMeow5XXEQGeI36dWeU-mh_Gsg&oe=6A9C1E00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
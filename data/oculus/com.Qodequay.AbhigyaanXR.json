vwE-JdAD&_nc_oc=AdrvY2OllEYXBGX8p6C8UClA-F4SgINTyXpt_mdNBfj-PTdlaD6MWdCrfx1gf2UUY5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC5M9nsBMma0gKRTdjbrbPBTuTJQn3oU3_v8z0eKWMaA&oe=6AE1EBDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZSNaHY4C4gQ7kNvwHY7evO&_nc_oc=AdqmOg10tyiFPhX8CFFMIpdRe-mbFgPxFOd-V7xcZYiVKjCzfFD4r4GkvcZg61Zv6a8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaF43N9aM52IQkFrVpW_NAEzPMXpJjS6SgGHkyiOJU6Q&oe=6AE1F60D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye_b62zzPVoQ7kNvwGWiQvO&_nc_oc=AdqmO-AMZdiXDLBX4AJWkgyGlgElqMhaDHvDxHkr68-sibusGf1bNuAgh96ugXJ1wOE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6SK8_zh8ixBG8V_MRryOWEkokcEdbthOLmnPRw2Wf3w&oe=6AE1F919"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UqGKzP0BYsQ7kNvwF1TOWA&_nc_oc=AdrfFeABfbHebmRe-GhLkFtEMmxbH3-cb491ucF6ju2k68Ib90uxYpHvGuhYeN4N5DA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw-9W-alhKo7Bk9Ckzud2bG8vprO7eSkJqYig8_33SHQ&oe=6AE21394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2cvwMGGQsgQ7kNvwHCKeHo&_nc_oc=AdoxdefKSJdsAkfXLAqymkMwIZcR65otPoNkatJXNeeZeTqwIHuTcytPspTbfPhtOWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_q3wujNCyNjFbT3kXanrbdVeEkke7X21xOnIxxbDhZA&oe=6AE1FD80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
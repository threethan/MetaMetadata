vwF-lkxW&_nc_oc=AdoTYdzUmy967J1P3Bl4a057SUbzoGSFwmOe2csBzq1IkKqovanJPTbYD1d0SUvFhso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IbonZ_-TkvYfVxmPhkW64cSDrFG6-2USt5l5rtIhltA&oe=6A3FC35A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSOkZCcd2-cQ7kNvwES0SBh&_nc_oc=AdqikwvACZujM6bWYi9IlEHRFQF1zQAZQLw6yInDxSRFoahzOQhmjvWyqMutG_JmgqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DwGRU7QEMwm9Q49jfeu64SpAM3yxFo3Iv67kMRLRC-g&oe=6A3FCD8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz1ksKcx6SAQ7kNvwE3l9MD&_nc_oc=AdpWWJgph2uGf5L0iMnktmWRtpXm-MBzKxyTT6KmR-S3apnKDmgN9jSXdwYqI-CahK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SnIxkt79SN8LEhH9m49ECo07OLCR1l-oNbs1A5EFKdw&oe=6A3FD099"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny3OspEO-DwQ7kNvwGtUvI1&_nc_oc=Adoq18vZQ6fS-bQjQCu1_cY0x5Z5_gTeOw88YVi4k8ZXp8G4j6ahTMhDEj9xNN-AQW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IOZDsSD38Y8eJEp6l9P1l2vR7ERKxVNJ_Rwb6TABkJw&oe=6A3FEB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTnMo1hZ14AQ7kNvwG38-1p&_nc_oc=Adp8GeqbpHdNmhhIrQKe8vTr_-MZNujWvlzn44J0ZDKmVNgGu6nbZ1IOycmJp5fWH78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MggPmk_1TG7bt7W-pCyeGiRfoZpcbOf7cxwj8vw3t-A&oe=6A3FD500"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
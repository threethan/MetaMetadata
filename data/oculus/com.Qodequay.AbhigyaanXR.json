vwGAPYXc&_nc_oc=Adqy2whcS-EH82aUVTItR2RHj9h2kdLQv1v53zXOSFplcrMeB-XnslUtbm38W2D_jfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2slQtijIRptXYl8i8HzLnUzor9itGupPjvYqKmNNe9zQ&oe=69E4CBDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYz3gJbef4oQ7kNvwGPfXiD&_nc_oc=Adp30CZu9KledQlsXQoTKPlR-2bBHUeiZjiGR02JtBT3NYvDpF-TtxsCuVLL0j3Y-9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vpMKl4kW3i6gk1J214cIRtlK5Y7uHg8SMWKD1Te_ctQ&oe=69E4D60D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eue9OEcaYLoQ7kNvwEysDab&_nc_oc=AdpBVXtI5n7zYl5LgQrKxOOqRFrCFuY9KgGr3CfDxvUf5QMtAhnWcPnZNf4inuDCswY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fQgelmi8RwePd2Jmqvz2HmhqHQRez78IUKHMu_-My5g&oe=69E4D919"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x75M0aPk6qEQ7kNvwHrHbyy&_nc_oc=AdqInJ5I8oo8G6pUE7Hszq6mVmcvqXLt6iCd4yZMTjdRoa4y0ZEpBtGZetHdFgRuOaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-2J1UtZEqWQFsbNpu6Dm3xbvKZs9vST2bdPkM8IL6Ww&oe=69E4BB54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNb7lPn3l44Q7kNvwEdlQvU&_nc_oc=AdpwEWtY1M4lFwmwjNEzu2pfNolOI9l7HdyxE3PKE7II4VdLickjVd4rgwJfWZ0QMVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vfTJEQvah4HqZcMF_iFFVcTSriBQq7YTaYlM5fSekYQ&oe=69E4DD80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
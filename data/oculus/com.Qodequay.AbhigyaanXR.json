vwEvFrcp&_nc_oc=AdqGQgBkBD5UHd4FfSftHTK9G2dI4RcP38anE_g9Oeen8IoJ7zt6XkjExgPId_9_PkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w3yHc7stW-3rjE7TNh5lJGxV3_H3ILpEXGff7Hh2K9Q&oe=69EB635A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WE3quDkbzBcQ7kNvwGUiZW9&_nc_oc=AdqORz8-18XhUezi6IZUcUWqXW96SyCElfQsOYHbRM-5tL990Sm3hM9431qzoN9_i80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MNksxeZS8z_eDRy1td-AWv9AwAV97Yfzq_TZVE-aVVg&oe=69EB6D8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0JbxmzAx1IQ7kNvwEFVTWX&_nc_oc=AdrstyMb6wHT08EOhqBXI0HtZ5tBxKH4LACSxwLKXot1On1UYsDeMzevXsTgUW1PzXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zdFrJlZ7gf42ILk_HIJx_-2t1Xxu1sDeEcmVYNPQGGA&oe=69EB7099"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unNHlIev6uMQ7kNvwEmJOFF&_nc_oc=AdpFl29SVFtUWCCysclxvoXodwbwToI4spP4IrPKXKs8L8XgPBMUqdAFmM8m0bue3aw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oYUjI6V5ol98r3ZlwiXoz9eN7r_RNXcZcMGSvhrZJAg&oe=69EB8B14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qqpcdGgzw4Q7kNvwEeQaH7&_nc_oc=AdomsibGu7NHZd0JOgU8WNpsXsZr_lJqyb0U52p5WftZvxhaHPjebCCMZdE8hTziZYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j05AiRscvtO5mWmW4OcAjLo_f6KoSkQIGcTLFKJQTKQ&oe=69EB7500"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
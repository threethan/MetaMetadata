vwEYEBwJ&_nc_oc=Adrw82fH-_zMT7F-tWyDF4y6VnGisdfIs7m8CnQ61Lf2sK6yFGLphzprqjMmx_2BvaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLdBaVsZ5IQqASGgF7Z5d3KHB6mHzKVh91Zaq1tleO1g&oe=6AB518DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Lhe3SvFjsoQ7kNvwG1R6m4&_nc_oc=Adp5q6unhw7H-5J2THsMb3wyDb7Y_qJFo5RqO039PsdTJ4Xq2MuIt2BGAQsDu05optw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKl_L7DX5pOk2FyNBH-5qYqzfYtizwboUqEry2kOJy1g&oe=6AB5230D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8MbNmfpoNUQ7kNvwE9UYOb&_nc_oc=Adqz03p3jruyHq03zqo0PDE0VtbWV3ihzqENIfzwgLMUn8DMx-zlQnThWJ1JPhSmEz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA7sdgpqkvxHB1TH2DkTZSSVJAJcJsk_eqblHzzaYyuQ&oe=6AB52619"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTy7tRR88j0Q7kNvwHJbwj7&_nc_oc=AdoHByHNUaD2wF1J8c0TfJsxtUE5NKynBzu8kcV_q3qPeuWqeXWDZ_kRPRgj-8sZ2cM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzYXa4_zIv4oeMqVIPZShFShoqzh5-2pd9P9rAupWwMA&oe=6AB54094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haOPXZZ4SXUQ7kNvwEKygVK&_nc_oc=AdotOUUC9KfrdumYQTHgZ-cseqn0Dc1pjcINP44mi_Eo88mqgU3c6gnI_3FxwQ5Ajho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcLk3lIArLWIg06lu_G3aljTuM18qY4CvfWKKgjMUZWA&oe=6AB52A80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
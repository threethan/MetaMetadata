vwE0E106&_nc_oc=AdqKA8Giujv0DqB4fsTsw_1tvluticEICqsDbYsPSox9qd1nfLek0V53lPAhfBWz-jo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VtJd-Itoqpv3T3-BsckOB6jrDXW-xt8hOki2H0AcjRw&oe=6A1ECDDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqKMZeAHj-wQ7kNvwFWQOeU&_nc_oc=AdrZ2mELLn2PHCgjPx8DEdMYFdMrd00sEmQ1Gu4NL3hNeukvNg7x9Ozz5NzQMNA2KUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pLQASxX1AlWnyeRwJuQB3lbY3kWJCPScFbKvxNB-oGw&oe=6A1ED80D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKGkVAd2-uwQ7kNvwGrorQo&_nc_oc=AdpfzGaYZicNM19wfq_4CH_9_mlkVOM7QxtUCYd7VGuGdnixYVCCwykoBYdDwjDFJxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pGw7Ez2aZY5gmsDbjLoHNp6Ng_DSuXNois4DzVXgfKw&oe=6A1EDB19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yUwM0KtDhAQ7kNvwE_ADfY&_nc_oc=AdpeTc5_uju4eiHmILIvORA7eW1kV0RTOcAkfq0sUuEbq98fsV6Hz0SDUUHvo5l-0rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-iWsdbrnpkmtJO-774sP-ED_5AKua6G_TCP0zFf1vWw&oe=6A1EF594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQBtICR4xy8Q7kNvwFpBO3N&_nc_oc=Adr-mGOT3-O-bCIjwoAoXPFpMr11yMPcra_8qrxYN7iD80XUQz6EAEB8YP7GGkd5tCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jLx5rHc-_872-qRliZATjIDWqSGRqAsCnBxvtBNXMUA&oe=6A1EDF80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
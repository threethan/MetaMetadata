vwFxeI3g&_nc_oc=Adr30xuIPXRzRAF3cBebFVxvh0_WdfHW2Tc2Lg31ija_JFa53qCxHxSkpfUhGH3k_oA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBABX3KWA7u7Tg6scIbYNAZuxJOAytbEi9Nv3jAmrfJ_Q&oe=6A69F35A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEJJhV1_0gIQ7kNvwHwtkjU&_nc_oc=AdptzbxLobEUz-F8CvabLzkm2pyb1vE-GcGwoXr8pwgGkrXF2xacx-eXIohecPJO3nk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyr7uwuloc6FCzSHYhYdOXSNZ932W-ekv-BBv-cHBlng&oe=6A69FD8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omn8UV_1sNwQ7kNvwFkmcTm&_nc_oc=Adoo5NaoxPqzpDZYwwuGldZnm_klRPJ0WVKg7xL4CCeEYqqkmJ6OxENQR_fjKSH9Frc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgzri9amE8iFJd4opFEuTl_KgIEI-qSD1EGk4hSVYWag&oe=6A6A0099"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcX33M6L-toQ7kNvwGy5oyX&_nc_oc=AdoY6pulxKsbyduMHMmCOruk2wCkS1nN9yxzyfbISbcgCFsRbEKPzLECg70a2gqjdFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG_CE78r_b_T06ChJjadnNqU7aBEy5oYVlW2vI18mAgg&oe=6A69E2D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8xzoebTdXwQ7kNvwFvtsIF&_nc_oc=Adpik5n8sdq2gBwN6ueettr6UFpydpZfP4Os5VBn_zIyv1HFvkLfx1Or7pHvnprD--Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK3efA0cd3rxwZ0ttbKK4Tz138TiVOyEuvfgq73abUxQ&oe=6A6A0500"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwEL6apg&_nc_oc=Adr3vBbIN1G_HwRGKYBMnMuq0cPd9iAkH9Qh5ZSRLT09PTXvECXohPWo7xPjyX6CDwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsd70HrjJ5Pkel59iQa3hL1MuAWwSO9c8q9lkkO4U60g&oe=6A577E5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gg9rskMCe4Q7kNvwGPZn3s&_nc_oc=Ado0Ff1tNkGN-EQsE_H0UTjFkmfaj581R04vqLThroBM2Wh20JhpRxMhS4GqkECzrBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjVqfZ0loypvnU5Cwj-vspTL_sW4kbrwlE2QtEY3XcIw&oe=6A57888D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHtPZ_BtQm4Q7kNvwHNFJrS&_nc_oc=AdrTtEmPutGh3HJsGEsmEUhH3HXqdVxdffpYyg_GLMLDSD5kARLXCquww3AjOxnCuEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWYkzfOK2WZOme540t68e_VQKbxElRQYDIn0u5g-ABGQ&oe=6A578B99"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F57TAVE7HjQQ7kNvwHMxzVA&_nc_oc=Adpk628mBAh3RCt8tYQyOFdXcSKggQOv7VPcBQMKhXdL3FVmtI_jB7hBuGvul2HWLgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcMyLdNqkbgaOWSHuRpxy2VHpH7hv4pUmmStRFqhJXqA&oe=6A576DD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fWGduuiIbcQ7kNvwFWqud3&_nc_oc=AdpYMLCO3hxzGorFJWQklcGKp9DRo7_TJDE2AJQtknhUGvPQ9BRc7mn3TvibjL9_06o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYoL8n8teWacdPWuApFATtlWT_a-enQ3iJT4K8w_I_Sw&oe=6A579000"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwEW9yAu&_nc_oc=AdqpoVQ_9_Om9I8dG2_ciAMW0wqf35i4GzpNOyDXayFgGZc05Qt9EbbkhW_8-M08dOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk4lDRwPMygmAM3SxOofB4eI9xXhtlA5hubIpmarrWQg&oe=6A50E6DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp7Q577Wy4QQ7kNvwFR5syR&_nc_oc=AdpaOlCxKkWR1UArqyf2W3fXvb0jhYSLRuvitO2DKOfq2W0VlNSnBumAwpGJFBwwFYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyFtvcHluqjG7lTXxXKQHJbQb9LFafAyePx8FO6KJV2w&oe=6A50F10D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cKB5jYVH3IQ7kNvwEoqhDU&_nc_oc=AdqJWLdfJx-RXIc49QSIbyRSdOeF60CLRSqtBNm_3ng1Gyt3N1OHKKcXkmlcgu89T0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARsF7caxBRAE6OxoSJRtrpEmCGUmO0TT6ZguXfxBvNSg&oe=6A50F419"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUd0jJec3kQQ7kNvwHB1Kpg&_nc_oc=AdoUe08QIogHrHW9uAgnjd3afcu78KWRLaMzsXW-LjKKKkbZK-LuUOQXbFGBH_YTIUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Mi_N6Vg9_iuDArGrSV1HvYb89sd9l_o5DFP-PuTOhg&oe=6A510E94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSdGu_g4L7gQ7kNvwElmHiV&_nc_oc=Adprg7kMrJNPYNUaCZlLoczSHdFFPO3Z99DeJWvCrNG-2AxCvQVI1LUz8sGaZ-1t6EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfRYkbK9b_cA_9k94qZ-DI9DnLl_0Bg0EcTcT7eIefHg&oe=6A50F880"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
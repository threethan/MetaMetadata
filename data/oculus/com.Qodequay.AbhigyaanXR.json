vwEeOi6J&_nc_oc=Adp8I4Rrb-zgtyGA11Pe5ZRmJpaQt-wcUFv_GMi_IL-p5WhKbYjk5aJgzF1Xtmj3qvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGLqQGXzQhbWT4Tl2fV4HEcQ1zNouhroQi7kDfyzfLbA&oe=6AF3479A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmkMXFnI_jwQ7kNvwFHamgt&_nc_oc=Adrivq9aQ2lpRNdKCDkDSKelnXDo5WUpvsidpcPVpO_OAHrDP8kjH4-WhCTQMsd-Epw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIMUk3kT_K9AjrLL2XgKh-1_tvHKZmfmp0oGC_j2m5hQ&oe=6AF351CD"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO-tj3biC7UQ7kNvwGLgt_g&_nc_oc=Adr4WrJqYkAmiWpcrl7b-G7gVTiOhAJ6purEV4I5SqnOwsHKSsgx0iUIE-2n6IPX7JY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQpzlskWLHmmnR-E9Y1VSfxh49R_d8ixavrI3QIPmvsw&oe=6AF354D9"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K2iUgclFFQQ7kNvwFmb5q2&_nc_oc=AdpDyxTZ62dhyH7IBqzvLM0INid9RT5__r2dG-qs_qpN50yZn49fnIqg7c2SaUOQGLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH-aXdiCNUfIWPmhGVBM1QXoAw-Mb_v4Xzg-aY7cNodQ&oe=6AF33714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em5LY5tzgEkQ7kNvwEuuiON&_nc_oc=AdpCrZt_2clzfXaaD5PclbatReHjkDV71bcTF4mgbh6zvHr5nSUV77xj5r1WNnZ4GE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCp2eEBUmbY6c1fxLZNlPr17DumwA9OnfPBf5mruu0iQ&oe=6AF35940"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
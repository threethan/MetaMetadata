vwHRuDEX&_nc_oc=Adr9hrJsoMJPesLpp1VK4tNANwlIRKp1BfMq-D9kp0fuJ2lHppcg00ga0OV2UW_nleo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl3PnHgvEdlLSiT-Ucd6_sGAWN_Zb3TbPkBEvqHuA3vA&oe=6ACA691A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewCMHFlKYBIQ7kNvwHa1KvA&_nc_oc=Adqqqhb7DiBW4w2rJZdGoyYFAcEpASqvYW6l_ELxKHLFKoOeqlGqqbfhv0KsVOl7u-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR8PoE3cCfGkV1GC_sWSZ94GSAWLx5Agih6SmQc-BO-Q&oe=6ACA734D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YMslEhgASMQ7kNvwGUXSnG&_nc_oc=Ado-NqGdSFhpQaVatX0RFVgJaQX_ZlHlvVVSjIP8eqZXOCkyBYhXbqtEHaesis9ssCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3tRnRecCRikZV49uNY3ETHc85OzHIakQpIcemZSD68A&oe=6ACA7659"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6akBW0Y7PYQ7kNvwG3PaKY&_nc_oc=AdpwdaDSRnSXTIHnBAQ2bfywThGNiOYFpIwQ9hr0vgMBuzKEo6f64b8F1bl_tbZvrgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxLJEvfaLzKmuiCrhYNgFQ8BdXOD4wzauDJ2R3rns2cw&oe=6ACA5894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1bUe3k1mPYQ7kNvwE7Rshj&_nc_oc=AdoaRb0mGmVlVstcV3Aev1nyWmRYbVZXwT9mrK2mWg2VDXjgj7M5IyxSvtA1zlChVZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtw6CGJfVmNxrrkCso5ej-j8BLNkN8kmLMnvPx6Yg_qA&oe=6ACA4280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
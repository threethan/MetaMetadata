vwHSYZiq&_nc_oc=Adrv9STlveixhwc9BquYLrB2y4bASk2rOWg1FbjSWqEVDMxUjedvcre6ETGuE_4HVWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cA9-x859qYx7FfKOo8s7HJNFyf5RDOPIp-0JP1DqZHA&oe=6A3EAA1A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcz9q3qxGaIQ7kNvwGAqJIf&_nc_oc=Adp_XCn6L9uO8_Q53aRF99lfeWMwOnyPzMkPqGJNb2xccWp7W9HaDb_t-SmSqYe37fM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sxV6v7eDjMVqwnScyqjLbdB6GAC_iFar5BkXK-APSTg&oe=6A3E7C0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ6YrvWOFmcQ7kNvwEhQK1u&_nc_oc=AdrS2trEhWYSviY3TXSy8mscKtoAjORV15YivYrVKrUuH5Vziya5qncIwcrif3T4q8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dLeyAJk28U7VCQHELXJR1P5YpEvNCa4fH4X-OWYtwCQ&oe=6A3E7F19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny3OspEO-DwQ7kNvwGhIfuk&_nc_oc=Ado5J0XQkgKrf3RfByJcrmtp1d33q4MhIAJd6bA8T_eTvB_9VyTOJyUzUwos1lJfHQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6YkXvb0rN3nZnkid5dpWB1ckbXOPijWH_X4QcY9dG0Q&oe=6A3E9994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTnMo1hZ14AQ7kNvwGX_tup&_nc_oc=AdqzH7Lha77n7BHmaQmYDp0qItMqfj33t3QFIh0qbx8_O8CaVRKbyeXsznU406Ys0yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bOf9w-ba57PnVwS3PN43vPusRwxs9URt9bev6QCMipQ&oe=6A3E8380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
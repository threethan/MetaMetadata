zEQ7kNvwFpdnDt&_nc_oc=AdpUktomOMBX_0X4PQogCTZ47DSPa9ck1MfiGuA5JsbQI5FZ9KImasCu3iaHDBjKiXY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-faIIEirFtVF2byC-X2EPMlsRz2wyPUfWicorJ5wQqvQ&oe=6A36C11A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR7Rb1gk2fcQ7kNvwFMQ5YR&_nc_oc=AdoVPuUXCzNImxXQbOynOiRpCT2elEjWKrV-c7K6oZ0sYUfkjCn2ROSRn3EQXlDp8Vc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QulprcyT0wGOxwjtI5SAcLClJ-6-tVR3LObHH5bpFpQ&oe=6A36930D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGqVxRcPkucQ7kNvwFXkcuX&_nc_oc=AdqLAF-wtsTQKjip-iSMGeHDgGbAZsSsjwsyhwFj4HqPMRhED-56fVVeXCHnWlvAfYs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fJuAM-e9yO-_YOr_fbJYpWOwRXikjaeACuCPY5FSTGQ&oe=6A369619"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbwGT40GDm4Q7kNvwGpaKs7&_nc_oc=Ado-fQ1VyqhXNuBaVFB_my3EjCplea-pQflfA4LW1gCDNBXjZKwSU-bMVspWsSy9sdE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3JwxYHDmaoWeId9Cfw3B7dEICPySpCUXI6gosUo8tkw&oe=6A36B094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkZ78s7sURYQ7kNvwG5oWAy&_nc_oc=AdqlHLCSPTuttSjTmgb5HFEUApihv7zhRgm78cBKAarpFOlnZP_sPQ0cWSVrs6weYBU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94SggOMaglwqk7JU-y9nqgbrRny_a_VWLgE-L6KH8olg&oe=6A369A80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "com
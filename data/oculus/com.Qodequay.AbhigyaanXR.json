&_nc_sid=6e7a0a&_nc_ohc=v_ftDNPz-_4Q7kNvwFYBgbj&_nc_oc=AdqEnG7Q5f_M1mfXjTsEJjJM4T3DNW9-2QaaUno7WIZWYhb7HHR7_eNvugkQ5gsquss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdXFE4cR2DJzeiFo72Y9o2DD7A9iKe-yN8rIaPFc_TGQ&oe=69C527DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_3H_rDnUQcQ7kNvwF9GIgm&_nc_oc=AdqGyQ7y7o-oVe8PDMdD7Xay9Wf_Qu6EIaDPIimUdtvTprE3NBPepjinSNdWQbc6PUo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgaKjjurNHl8jRQ63bvfEEoEqSdomcxvND3X36F6Llgg&oe=69C5320D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6g_u0-_ILIQ7kNvwGq2m89&_nc_oc=AdpDnt8uSE48A3xocpOgh76xU90WZRpncZssXUxguR-phJI7QG5nQMiJXj_hv1Sp6g4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9VAeOu1q7wSRSJLI-eJdoj-F50Rqyl3vp2kOC5S15cQ&oe=69C53519"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aETO0QYdCwsQ7kNvwFP39Eg&_nc_oc=AdrIb5-E8fODBWn6DF1z9lTKrbKb0U8DD2JsBiOphL_eyZO3GWGAwgDxrOAjoIL7fzI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpE2uXfY7Ey6i3k2dxmwu7X8Jgq9gRaJ-uEiRarh82zg&oe=69C51754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfYmSodKgfYQ7kNvwFloZd2&_nc_oc=AdpF54qNWBTeKcUkbXAQKcH4jBjziAjPesUbbv_riB8QaAFRidF0oM5OYFFWeI7o-jk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTyUNq9anY5rudOWQwfOfwre1f81gfj7PalKByt711tw&oe=69C53980"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9602696576428791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391904_9557377207608065_3493773536012673474_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fU2WB5KZkQ4Q7kNvwHjDG2p&_nc_oc=AdoXkj-VJUzjNDeKed9EDGleJfhcOdWxsMI4UnAYUSbuJF68taAa6e4WeOArj-P3laQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqNpyAKRpVzb8d6kb71g8YJAwRS8ttFpFD2aAkMFiulg&oe=69C543C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AbhigyaanXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1740298860, "lastRevision": {"nodes": [{"id": "9296459107052541", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9296459070385878", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "9094636730575837"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Cover Art-01.png", "id": "9557377200941399", "image_type": "APP_IMG_COVER_SQUARE", "ur
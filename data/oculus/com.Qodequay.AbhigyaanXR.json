vwHnbTmi&_nc_oc=AdptZwCRdKM1UITk2_HT6FCT8uFnIs1LNdeLexqaiMNHR_Mc7DSYAf1exVgNOc1Rk1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M0P-uEotk9Y_iFXnvTqMf37ufpgKnNLuwPg8RBsoqcQ&oe=69F740DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjGrkHKttl4Q7kNvwE-YuQ6&_nc_oc=AdqlIGYGQ0LLwu0vjdWx7jj3Pw5GbOlqkYvUDXZ4AsZusxP2HJ4HVPCohSsY9M4IP8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wG95e5HZD_9fqilE0pb6aTnE1bsx072sqRdtz4MknVg&oe=69F74B0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGupRTBEMC0Q7kNvwFw-am0&_nc_oc=AdpkULl8JdoFOHmdMwPBibuPpAQlk7VOF5Rng-lKAMH_qBD7kSf8ngAT5dY4J1hZkQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JaGi8JT5Rsp-6GsHd002rmfGMTgOZA0Aw3DU2yNOeXw&oe=69F74E19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEDRx0GW6DIQ7kNvwECk8la&_nc_oc=Adp4ed3PV5wGBuzF1UeqsQN7wOxaoK-xzXsaZUkImoGSj523cvKz0OpIJm2hfK4cyok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af197thDBpmczKLicdDGQmdvx2A2sO3cl0u315QQOJBcbw&oe=69F76894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNb4Ps9K6RsQ7kNvwFJvi3p&_nc_oc=AdruifMGNmfmoT-ASYdlKXrdufFW_iutHbwzFjBsoc3CD46ioMXaDwZC7rGrvspYgyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0C5W6dRJHU8zuFBDv_BuWOOAlBnt4oO6IULc1Yk3VFtA&oe=69F75280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
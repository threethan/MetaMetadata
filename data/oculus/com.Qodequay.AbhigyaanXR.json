vwFmB7uF&_nc_oc=Adri0RQqhpJ-ssgSVJqD4B4TqqLLpaR-sco7Uzd1SusVHYnm-7InQSmSUYBi1dFubZQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yPcXdq2KtsiSSj5U4hwb5YW4w3Qq5PkgouG_Y7j_29Q&oe=6A32945A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0VVSavB-JwQ7kNvwEopfT2&_nc_oc=Ado_ADJJjqNaOIuvvMWtO_NjGVBOaT0x6B-MqDggxdL5IRxbTuHG_tfUNSTNtdW0nYg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7B1K_8VZRb6DmVQsg_eZGgRncNzWL4ZaTv5frVMSF3A&oe=6A329E8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXDQU_hdhtoQ7kNvwEMKQJA&_nc_oc=Ado4rcu2hYh0ELWIW5K96E_2oVk07uWPDZLSEWstAaSFwQXksE7FkgujG6Re7pPiGPs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NYaQircBGPZOngcZE8MlX844SKjeR1FUKChzULU6TOg&oe=6A32A199"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J92zsBKpjFgQ7kNvwG3ywH3&_nc_oc=AdoAKZAKBSzde70fy9r7MxXXvYiDBpJXpNMSBF2QMpKWTV4DT3n-7ysgFCS8_leo5ME&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m4Rn95n--XrfjjcjaeoV719tTGcQRmS6pdIGvStGOwg&oe=6A32BC14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q40GQ1YzA84Q7kNvwEeARbJ&_nc_oc=Adp6rN9v59EkBPv-ptSDFLA8ut91byshXpH-Kc1qcmG4iK5kgtKq8xaDhv7yz4Vpdv0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RUrtS3dhWXx2XZr35KqSxIPHct6suBNUVO4UZqF3kxQ&oe=6A32A600"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
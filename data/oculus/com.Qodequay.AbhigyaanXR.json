vwF09K5g&_nc_oc=Adrt8PaksayXScd-ZUUlOZZZXV-pRHQ9gTGswHUATL78iWybrILlISI4d3f1n5_g_YQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrfAimM7S62oXurdM-n2BgMGR3wfZrfQngXrT66JKKaQ&oe=6A9736DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJXcIx-O_EMQ7kNvwEdRUiv&_nc_oc=Adq7Z6kDfKX1D_ba_TCRkHH97VGT1s00yET93HHhTGKmFheUSSGk3R7D6T3zBX2G73k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETmixjjkvLhJdRwKVAYI-FGGStjBcdW5gv0SNIZx9VUw&oe=6A97410D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxrwzkL7HFsQ7kNvwFEq3B2&_nc_oc=Adp9M5BJYxwjYJxGnDlC5YonJSFGXgHH6m1azGiVreXSF8LG_kS2Ix_Ei19NT9gkq9s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKrQsfSqV_RFFQfeQWTuyGhUwT0CmgYPw5zpBnrWZacQ&oe=6A974419"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIAnPzMVqyoQ7kNvwGLypjm&_nc_oc=AdpVvIRC97KiT_jcsnPVMdokBAmfn7hdCUf87DLKtTGzgyOz1LJ5Vj84tSzUT6rRWZk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN15Poj9oXBFC5TJ28vm99gT8vIM1tb380uYDV0Saxmg&oe=6A972654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_fWyn3IFJcQ7kNvwGt66-G&_nc_oc=Ado-64TjG7VO7Nff9XxmCibteNNuXQQ8dQMydGUBWJPj-4j26WyNBCKtxRsC3XI3T1Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeybvCDnk8r_7MML7ErJdG5kqWcdDvOus7E3jlvmmymQ&oe=6A974880"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
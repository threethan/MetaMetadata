vwET4FrP&_nc_oc=AdrmmGlYkYJiqFsGW7sArGmKe1m1PnAGy3hOftPkNbA04VaZN-MxcikpSdN_dqPr2So&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCysOS_kGGDk_iq39Tcyy7Zn__Z5fsyfrvmu5D7U8vdnA&oe=6A5E15DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfA7CHnDQG8Q7kNvwHhwlF5&_nc_oc=Adoe97uglv9s8rp-HVG-a2oR3JW5CwUTqRwDxmpAkSw913itrnNbqyLlTLMQt_fIN9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrPOk_GbA5vZy1lCgIk1ZjL-ZRkAPiNuyeibeRLYKOuw&oe=6A5E200D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biIbydtFM3gQ7kNvwFawm68&_nc_oc=AdpTMJu_IpjzaKaDGgn1-1JIQKQeszrk59Kh5d63_SnuJWripcdq7fy6HXtOej27VKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_VgpPdswKdQq8DyqyIFuZosFh9BysYkfEWIRM93_lwA&oe=6A5E2319"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGoroinAnsUQ7kNvwGELFw1&_nc_oc=AdotORWTOvMqlnsSXAgERufBHXAfJ1EJl6Q48-Q6zhQrlrSWIh7IJnIJOliOKwErsNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb-u8Pg06VERR0pm8VGcBiZi2cNVBX8ZWaEnK1R1-sDw&oe=6A5E0554"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJt4K6QMnCAQ7kNvwFtZCJ2&_nc_oc=Ado-Q3xcfmayGFUBVMICA4mqsMkKoiR7zT43koNGez96IIf2dPzzyECxXOkN2SDPLSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDAe0zz3OYbidF7Ur6XzIQQYDR1qruDUxcEiC-tK9xpg&oe=6A5E2780"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
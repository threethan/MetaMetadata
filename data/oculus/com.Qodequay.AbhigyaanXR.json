vwGDsoPe&_nc_oc=Adq4OQ-f9A20fZEr-CIwbGBw_naBCSlb-_wIX24qbgVBr1TLaeX04VzFbBM56ebXfY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bwywQ032AbVcLGLNKMg-wzScZCVojK6ebJFKEat7D8Q&oe=6A0712DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cssdXh9fKxsQ7kNvwF0bF41&_nc_oc=AdrvSHoJbIgvS5SrGveei3nBRDvgStxnAwPMHowvoNlP1wAwJDnSXjArZesMCXVw6Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i9gqBBwxDozwvzEDDraH-hhAjXUa_a2-sB5MKsT4mpA&oe=6A071D0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOmCaLNROV8Q7kNvwH5oW_L&_nc_oc=AdorbOHshA6GPJ0Z1QyynV-igJErMi5UkRv7Bb43Dhw8YZQ4ERg9-4nhbdkRgVVwfSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f5MU29aoQZsqg0vpslS9V248IgupcYxfXjaq5Lgl8Hg&oe=6A072019"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOcVMlMH1GMQ7kNvwHHw_CB&_nc_oc=Adr1bPojxjqu81OKfjKMq6ZzwZ3Lt8bgB3_H4pMkmunZGUvQ0kHmoKMqVXh47zOBRJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-_qBlpivJlslE-hDuIJ2ozMcsRFsj_ycJLosN_95aAg&oe=6A073A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL16cxL3IpMQ7kNvwEQNE_3&_nc_oc=AdrHqlFRBJDP3d7FWM__L8v6AVzDaLsu8xDYDgUN3z--yOMrOcVDNbioIQx-WawqEIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xVMFezQzt4h8LF8IRA8yuWdaNLE_-1SL5uwMGpAj48A&oe=6A072480"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
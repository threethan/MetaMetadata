vwEPaZI_&_nc_oc=Adq9yTn4z6_8JIt-010XCEE7i8dbI8S4EDVnEg5NtuBrQ9To_PikXk07o06_d7N-pbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq87uSQJGVdOU7J6_OfjgODsp69GeNgi_53rGzV2IHVQ&oe=6A5F675A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfA7CHnDQG8Q7kNvwFGj5CE&_nc_oc=AdozhTyu88HFcDtb2lb2ep-7TbwKrOH6h-3U-kPEymR0eMND6fCguCR5vk1POq214Zg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUqOW2UnfTol_mMn9xebUeuU3mAPuMumVB9tMN2Qt7kw&oe=6A5F718D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTvjsOXexWEQ7kNvwGV6RBi&_nc_oc=AdoMLV7k30Roci3ydWtI9R2n_-r4bAeIzV7IMumwM5TiPF6NlALrcR0YGY-Z7EfbQPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPSYi7hNXA3lraxQfltd_gmJGBb7iGo5Z1b0Vdep5CoQ&oe=6A5F7499"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGoroinAnsUQ7kNvwE4PnXP&_nc_oc=AdqZ3oC2rgeUx543IMJFjnKoMY9GFuivZDueKTy--sVcJFs_HaQKUKLgwaP7Zx0HcOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzpsBG4OuY7PwfyCQ88CJDmpmx-txIsG8QevTRaldGTQ&oe=6A5F56D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJt4K6QMnCAQ7kNvwF3qAb7&_nc_oc=Adr9raGf0GLLYJ8-Xt7bEJ-Shz5RZwSmmAiInTssC5RvhxiHE7cxcOdpbfhfpQ-H7qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0wvqFJP6zn4QMAp8XqSiszhODyNupRJ75nOWbIIBEqQ&oe=6A5F7900"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
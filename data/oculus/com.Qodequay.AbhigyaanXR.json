vwG5K_qJ&_nc_oc=AdoHCcbHndSyFiT8CubGKY1SJ3qDh5zCFjB93frEyNeYp7cShRk01s4-ooI7pwVNkQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdv9SiMI4N75q5E4e-NJ_OzThNN23BIf1o02kecrS2vw&oe=69C6795A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdkWUdUEbKkQ7kNvwF7bu4q&_nc_oc=AdqLuK0-dbboZMFdt7Pl5WKl84gYcgWn6RiHEhc8yrh0JrixeP2wME4NwjoHLkXN3hw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL7Tw-9RcR8vMqkc60g4QMYMid-1JilUD40saSpXs0tQ&oe=69C6838D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6g_u0-_ILIQ7kNvwGrh8P0&_nc_oc=AdqgghKTSXIFrMcQOe4t0rJ0TK2_FienUWuVcaMN4UiUFXI7oL73o2501wEiFlOsR0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5W9gdMY1QwrXE6_RmH2OkwBUwSNO7745OHxVwQbrCpw&oe=69C68699"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aETO0QYdCwsQ7kNvwFwGSJd&_nc_oc=AdrmDnXKolzF-xnsceyPH8eY04YNcxhiddJfOE8QbBQ8M_dBsCgtrZpDWk6tadrwDHw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7CLlVBApx4q_ochFIzu6989M51cgzbJ6lwFB5gbQ6pQ&oe=69C668D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfYmSodKgfYQ7kNvwGy1Ylw&_nc_oc=AdoUszYuSqteWk9mJGNCMbod0rQiE_Nk6EWoOdh8qox_Qr9r77mZRnvTIZhqC9Li4-I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZm9vw0ZERlV5QOAArkjDu2YBcLwz9d9kHYLNjBB5r1g&oe=69C68B00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
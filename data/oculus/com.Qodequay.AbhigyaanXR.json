-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-2cFqcKqjsQ7kNvwEsEeNX&_nc_oc=AdnfIxXNXAiIP4f3gfaxAZ4KCmLiLYdPHiDbV3fO8N7pJpemeCu5nVI76aIW0rXY-DM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsq9fXNqXGUWW9k45rnUb3Th6pBJQVi-4WpaxjpYGHUxg&oe=699B020D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hoj1SL9rWsAQ7kNvwHVHo3M&_nc_oc=AdkWY4K6s_FqrzEHyaWKre7pIcWTB8IS0E5zi4y3F3p_aS4_LMzk592Y33yxtrjLb-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvIVXqQ8P7ywVjUeyAi2qn6AF_9z0tVbDzPAz4-yY4ahw&oe=699B0519"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXmOtjzCmIsQ7kNvwFJTjIM&_nc_oc=AdlpWiOibMRBQFPUJ2Wo8tC1nHi7dJgQoRTQurV87KqiEavSe1n1lG_Uf2-UUh9nNXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJ1laTDZDxdBbmN6SBer6j_YgmavBhdrT0ztgwGZl_5A&oe=699AE754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mvKNqkVOIoQ7kNvwEYA_s8&_nc_oc=Adm3fWV3bb0TqHlmH1qNhSbKh6wkMaD2SGMkpXdmmmBaFu_GkBpO3ctkUMfUhIAV-uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6FT0Rx6NN_oJatVDmxqyUYEF8wU7lmwKM6fZV_O8KmA&oe=699B0980"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "
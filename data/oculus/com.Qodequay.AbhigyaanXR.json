vwGyDI7a&_nc_oc=AdohSXJhwGPPqFGba7e70_k1C2KDkXFExZBujWBXZDd3t_xjdRPYHqM6c1-2F_lZCMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2WjSD_4ZvC58LJi-ZYORcIorgeCaJ4D191jX6V_Tf3g&oe=6AC7C61A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVXY013XNiwQ7kNvwEVNqyF&_nc_oc=Adp7EKNHeqwXd994qrRG9nXVF3dlRisekMPsvDrBofbIMXfLWP0RdvlDA2o-Nd3qhe4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn5tMPbvi-F6bCj-a9EJDSOefXZxRgfQbc9I-m51mFiQ&oe=6AC7980D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y64qRT6ME68Q7kNvwF0utvc&_nc_oc=Adp9vbi-SmA6SGqsCS74TQFVZTk2kukGQPx6kIFH9lKXrQ1E0Rc02MfjaL5S3RFL_OQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjbfjbENdmOlGMd9r-wBDXlM1aUiy9IgwEi29WHVR2iQ&oe=6AC79B19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qowPhdxzBSoQ7kNvwEc2j3f&_nc_oc=AdqLgYvqUE9da45MEr7XfKtdKK-r5pLZ0DCt4GhpeJOOMvfnEPuRWVOHPG8dzMUya1M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlPCfWZkqUW5m1NsrbI_LojPzRkJVnPamp-dSgfTPt_g&oe=6AC7B594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCXiCmaR4OAQ7kNvwEWm0D-&_nc_oc=Adp_sAyH5_ypEZk6H_9een1cQ3gLMq9waeOuqW0cdFT6htAc2yTXr3ypY_7xcAOs0JE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcztAPA9mnYrPJOMNOcw1VHSK5AVPhFVPu98zjgO9lsQ&oe=6AC79F80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
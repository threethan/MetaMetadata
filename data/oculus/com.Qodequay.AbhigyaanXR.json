vwHeJC5e&_nc_oc=AdouCt1CdiHaqPMKTXzl_1VxwUQrYNDPq7tlXKOxcgWNQXNbQzdaY-ecm-rYOOrABj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H9C0oSMAOvGmO_9MkOY6OKFNiIQbXc21YjyfWSnI5wA&oe=6A01CCDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIftLkKq9fYQ7kNvwFd80eS&_nc_oc=AdpowlbAndEBwWGVVuGmS0_sDRAkGDHsTSs15o1i0W4yzhcHjDjEO-NKTC9jJcXfCyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zgwm0PmDCxMW8GiCRcNRGxN2UtJF-mll2f90yloJj1Q&oe=6A01D70D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2bWZYy-qjYQ7kNvwGR6PoK&_nc_oc=AdrSib12QEfxdjTkXePdOqpcsiXZhhm1q_fFB8y3f3WKRbQLCO3jxQT4qID03lM5K98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NGM0XaNBO-QabxmR3hfYVO_spKezykQeiErFfT6_KNw&oe=6A01DA19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y0sbmkYeYgQ7kNvwErn6wE&_nc_oc=AdoKoasjcVsCTCdYWkaF0cz0CTSF5tqSA9K1Y4mvFGhIc9lS6F1HFn3m4BB3onjbnks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vKwOplhH4719YYNkfE4cAYSNq085qLuSnPtwmwuYiwQ&oe=6A01F494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2a76AXxAcQ7kNvwEzpo56&_nc_oc=Adpt8SfbSG-1GpEUqPCseHOJJSpa0XUyrMN43HpviMpGFVx0i225PZ9xLM3dSQibL84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bndLU0LBbqU3AxGM6rbENlNpxuPJmux1Y7K5YQUPAcQ&oe=6A01DE80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
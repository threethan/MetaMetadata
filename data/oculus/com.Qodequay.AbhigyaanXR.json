vwHN-kqY&_nc_oc=AdojYVMqc3YnN-eQMXLEj8QzYY2YgkNdSYsLpGNRXMlFVHyx73jF3HuxWPhfZcuBwx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zeKI_MLxHThvFqsCc-XQOgYrTxswPstk6mm-wx8F9YA&oe=6A259D9A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRIPvwNEwVwQ7kNvwHTe1_O&_nc_oc=AdqSPzeoAZcxIf-1EBzw-5fIOT9Yaxh9WhsyfEJWxw71XHhBE3BO5MvkDc7bNEUTZpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VkR4q6OvHjo67ykg9H45ZL8zNPT5D95oCQwwBKlNtpQ&oe=6A256F8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKQjshaDV8AQ7kNvwFiN-xt&_nc_oc=AdquLeOiBsmvebGzQWBJo8W-o_NaqisRXk_In2unK3_lbG_ANGwXQ_wphyGzD0PulWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af992wY-3ZifRN0IszeIV07YgNm68797cLsDI0ZoU-a1gg&oe=6A257299"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gNpT3llvVIQ7kNvwGkSk2J&_nc_oc=AdoU8FW6RRskq4uEiW2xFipSUZi_8mEeyt4-_H5sWqUFAnn4KYgInRx-fDLLDjzhf7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C_c3fqJrRSB5IGzoFeHEzw-v3P7CiAWKSTqVgcgee5w&oe=6A258D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLQto7sC2TUQ7kNvwFeVdTe&_nc_oc=AdokvJ9Dl_W8GlBFnT4wQbj_XLMK3Bf4ZM0PkLhtehW3RLRCMZhHQC5fahgXyvvG1N8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BbrgyxtAAKut1bXDbBSw8KnBiMzYaIWHtaUM8Dlhi_A&oe=6A257700"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
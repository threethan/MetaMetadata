vwGlYJKX&_nc_oc=AdojXXEKORn21fiCAxVVWPJi8u9iQwxzDOcYTN_o-OSbZ5eJT9c61KUcIa5wmZfy3x4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZd5pXU5w-rqKERCKTtcqqWiyo_2POj7Zw0infR_xQrA&oe=6ABD01DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0s0ROj4pKAQ7kNvwG2Vonl&_nc_oc=AdobhxZoM-9mg75R9afIyJ6iFlue2BbOtd5zhKj7urKmEsbqYs2e7dzkAS-4dhP_mt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOTApGdCSIl4uh2iw8HV-Lk6DKPFTxSbhPX5XFQziWsA&oe=6ABD0C0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Q0yHUN0H0Q7kNvwHZLz9q&_nc_oc=Adr7GQyDeEiwzLGV50In1MkVMI4SP3fmMIUfpuLBbQrMzzIGlmDjBwaYQfDaVwz0seo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT8d0zfccv-LYKhZWC50T8AVn_TkwA7IqSwsgmD5hQtA&oe=6ABD0F19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVCQGB6JsCIQ7kNvwHr9kYE&_nc_oc=AdpI7bT3zuQG6Jy_jxurI-xAQQ-2X5I_wu3ZHY1holzXVuoTuVEoopHpTqJmnBzzDE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIChQw5wAUHBEjwOzDtAi0U-37t5KXgZwmfvndTJVd_A&oe=6ABD2994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksp1METaq8YQ7kNvwFQXpvm&_nc_oc=AdrwSXZaiqxEUEk5iXUOvCCs2viXrlZMgckOS0pj3W9OTfddO2jU6pFteRhzjKOewGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuYW-7BrsDbCdf6SONHNruVL0HY9a206vp44obnMzquw&oe=6ABD1380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwEJVf05&_nc_oc=AdotmHjh2k4HtA1WWO7DbZhX7JhHAlUtxZ7NQCN3ckYxytyX_Q0M5VaLtDEzq01TzDA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySieFBOZlu9PtY1rIWSIzcOam0SZmBYnMajGWFptNS1A&oe=69C3D65A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_3H_rDnUQcQ7kNvwEXDt6C&_nc_oc=AdozJeisb-X0z4uTmWD-wO5T0GwcT2Jxp3K3esms93lEqi9utQk9LqGdRMD3HPILPh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXrXWjlH7R872pA0jffAxrkXdWFTDPFmhkHTfm0ZJxOg&oe=69C3E08D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBhAjgdVXK4Q7kNvwHvFQV0&_nc_oc=Adp40G4BgG8we1c5ynO3raEcYniu7BCZ3NwJU-NnDWzvRXXrWqF3LUtPgC8oZA81Z4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfoVDHGK6rwoLkHujpzWBeTrkxjGllKxsoMoZl806t3A&oe=69C3E399"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aETO0QYdCwsQ7kNvwGbw_YJ&_nc_oc=AdoKDCp6NH51ESLkMeh21YW4vaq3PQkJW-2nU4YfkJl1g2X4HiDhwkCM72wnt09v4XE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws7hd2VhZFlTJ_8J9aTmkdPHBSWi_NPVbnl19fUY1irw&oe=69C3C5D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfYmSodKgfYQ7kNvwG51DVv&_nc_oc=Adp_z3mBBJqdHRgVEJc1YxHCGRXpa6GWgH6ycUr1NDwaIDQlHT5OCtbTsDkCF-xYMZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRZ9BUXN1tZ78Ff1tpGC-md74YpbfClJdOpnwFngweYg&oe=69C3E800"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
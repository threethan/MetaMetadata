&_nc_sid=6e7a0a&_nc_ohc=2Z2P2foShBEQ7kNvwGgAYCU&_nc_oc=AdrqHOcz82xVldR17vFK4bgbPfQ5_kUthao8lK57T-o9PNvZ8St41--5a1q0IrTRSOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A4u4m4KgASBha6n-Qx78EYdl_iPWTogB2dOSt_THryw&oe=69FC86DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joNNhwIwTMMQ7kNvwFHbpBT&_nc_oc=AdrtI2n70sT_1u5KvPiatIJDB_6CfYCw9rD3C0TSyEvdiCW3vUTyPCxZLhPPCUT0_Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ALAocIlMe3LEg7d2h98q5LJHYIAk-LEaXmHuQUS3bEw&oe=69FC910D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdUpsNEaROMQ7kNvwEglFMF&_nc_oc=AdrYvu1_d9A81JwxbLnXCL6KDFN5-0Ohy06WFRMbJ6CvWZA9QqzUgb4Y6ZnFFbw5Km4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sOsqFcJGol7khZ7g4_tCJtSauFLV9ulB7W9ec8Gc_FQ&oe=69FC9419"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR5YI7ZdZbsQ7kNvwFOmM_0&_nc_oc=AdqcJf3VMN9xrnktEX3jgcOr-I1WUVQ5bU0NrNCmmJTYaxA1dyz_Pb4cMdk3BuuidBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qraOgkqo9Xel08vZMu1Vm2QpI9iFmolh68kDpNcxH8g&oe=69FCAE94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JigzDcPU1EQ7kNvwHgzCt_&_nc_oc=Adrgwhw3OMbdj9dqa4ZQ8VMaxFhZ7FdQ9okR4FArojPfB3qJ0IUqR9_PvEKf_eZ10mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7duM9jMTyLN0J71fTGMcy0yauR2qIDsiIFONA9Jsp_bA&oe=69FC9880"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9602696576428791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391904_9557377207608065_3493773536012673474_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JsciR3oq_MQ7kNvwFTj3I3&_nc_oc=AdrJNW9YfOOcEz-5r_nhRq-OadNZECJd6olHAfVnQ5wvdGatSijKu-w-IAZPsNjYJho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xMSUG4pKtRFU6bqpnJNQF-atFmiReH7CmgGEovesttg&oe=69FCA2C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AbhigyaanXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1740298860, "lastRevision": {"nodes": [{"id": "9296459107052541", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9296459070385878", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "9094636730575837"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Cover Art-01.png", "id": "9557377200941399", "image_type": "APP_IMG_COVER_SQUARE", "ur
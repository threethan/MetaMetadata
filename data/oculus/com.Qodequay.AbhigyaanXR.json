vwGlJ5Be&_nc_oc=AdqAsZxQ6P9rD9ijjoMR6j7FKUQg1wKISfTaphUBhWCHnDrfh3HoL1MUH92YbpgTnR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nzIbsliKwQ88ogrQFQ8INIrFbSDOOa66qyVt3LLt6vg&oe=6A1987DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YVpNk_aUcoQ7kNvwHbaQ7D&_nc_oc=AdqAkcFeNagOF2Fx4b5BjSE41RjII5s3WZ6Q2PPV9c-eVsWypEFx5rHlVw-WgHWW0B4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ErLl9g0PLws1lgjkzhy-aC4zYJmQMkCf5WYQhHmm2Ag&oe=6A19920D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NorV72YkYxEQ7kNvwHTuwYl&_nc_oc=AdrMC1HNgfiiyM1Nr-ZMvo6g3FpNuixdTyTET2FJXWtojZnWFpZ0piu_Xne33y3rrtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FK_9Y8XaHt0rYDY7MqNmACc2F6hKban_ooN8sqN6aqw&oe=6A199519"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njDUZckdyBgQ7kNvwEGk39j&_nc_oc=AdqnD5V5H_RXK8ngJ6fvHYTBr4C0DqYCrz_4FXBkiRvNr8egUB_cPeaEa3KMRPhfiqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lqi-wrqWW1zVZsz0uXoNlz7kzMz6epFvrgEqn9lqSvQ&oe=6A19AF94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLIixhgbq2EQ7kNvwGWrKkh&_nc_oc=Adqlb_3-6Ho6pU3ASMNK9YalR5Vhn4WnfOEqQo9tT2HQv6vbVDhZF1S9s3as8FuyS0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7opWEjkr9e8OKPEnmc606JBn9fDg2wA_bJKT7Qwvzk3Q&oe=6A199980"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
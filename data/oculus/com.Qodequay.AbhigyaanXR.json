vwFt78qp&_nc_oc=AdqAoea8Zbyfir4b1xbwH7SDe0WBwCFwZf8OZTgvlJb9iUvhh5gMkQX9Jh48SITRPYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r7dtfqDDtb18XpT-1nX2uyJNTyIPm1OaKWD9eog6Lgg&oe=6A1441DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0bLwyfCNukQ7kNvwH0CgS-&_nc_oc=Adr4vGeAie4fCau70tnF9GywT1U6eFoWyo1ajsK99zgqu9STr9XduR3hkgMG3M8R47k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cKXUQ_cPzOdkpfZE9Lcom9Ugyhd1zFZtVPMiXxL-9jQ&oe=6A144C0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkxJDp5Y6lEQ7kNvwF5fE27&_nc_oc=Ado_xrzUAbRrenGWI0kn_cDFxORVijIT5bFlYepQmnqKEDyDINja6o-XvHtKRZK2XPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60sI9_z2cvtNbQdNfRXuEbvIKCbiM7rnPEGp1I0NZVcA&oe=6A144F19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM4uuK-KGeYQ7kNvwF3pY_M&_nc_oc=AdpowKpevF7zTRcFscBkrbM_di-rjtYO64dliEZ-ruHygWxeFauU2JoQntvzRoGzwWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65edSkkPSMYH4fKTsFQjozlxI1rqelB0uG5yjEWuWlQg&oe=6A146994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT6f3g2OtBIQ7kNvwGBYR-7&_nc_oc=Adq7ut1VJAbbaIiWa_bnKkoWp6bivC_V0V37KBk0Y_JO6ZiN1zy87F30_3sTNFnKJq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M2rpG3CL18l3PKLeyedDQUWQ-Q7wdvrEXmf76FnBuJw&oe=6A145380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
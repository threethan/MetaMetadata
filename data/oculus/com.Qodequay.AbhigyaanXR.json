vwHBbbF9&_nc_oc=AdqMWGBtHfj8w6QOCl3l25TFhGA9mVsEN5Ht9qg0RHecYU1iBTAO9u1qYMrRMDtPIVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPynGEU_CTgkCwUH_OBN9QRQUixKSphWcaXq8YsrEiUA&oe=6AE76A1A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhQxxW2We2MQ7kNvwGwbBw5&_nc_oc=Adq1ecMkND75nfmy4lh7_NsYV3vpGgGj9nhjsaG6hN67xDEZSNQi0IzRyNS-4YT1VAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuhhJYbyjgWzYVhvGe4U1MotFeOiH-VF1aK-VrsiNFMA&oe=6AE73C0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pSzqBPT9NcQ7kNvwF4qExa&_nc_oc=AdrOK7A7dkisl77X3n93UOwFUEOrIpNe_L8dqpcZkYxyqavFyjhrK8hgq6lu_gjpr38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8IxMzefzp0ehs8sGKKKtrCDDnbwidGhfQuPQkKb4ijQ&oe=6AE73F19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6Fiw8YXnEYQ7kNvwEq7ATo&_nc_oc=AdoVpmhNuO-cbJczh3evgXNDNyZoRYqdwMs4Kp7irQItK4tlzhgit2rP9oUBiNe5ssU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQizkiH2mIRLg0EC5UU_p3EMDehk61t4D0mqauG7Gktkw&oe=6AE75994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYcwg-PI3yYQ7kNvwGbHP0Y&_nc_oc=AdrrPP_Ys67hNN0GJEXHHWESzN8B4qcwySMRPpEqDCYCfhBslrj4K4IrUaXhBRVlM7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9C7zi3cPMRnmUEXgqZcQCldP5Hx1I58SwdLvFtClwJA&oe=6AE74380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
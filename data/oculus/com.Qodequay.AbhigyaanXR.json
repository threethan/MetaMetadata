=6AFF14A9"}, {"file_name": "Preview Images 2.png", "id": "2275228386203731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422373_2275228389537064_3650876296377627467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7oDYZotO1kQ7kNvwH7AJCY&_nc_oc=AdplaxzJyAKBeaiLTJ5nAWqVN2Nn8ZRP5SJTQ-wRtrWQNAieHTbpDn1-87RB_7WUSAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0a-igZe3Qo9fq2Iq07vKUipSyu1Wk8iHwCFcAAdg7xA&oe=6AFF251A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkbdPUuptIcQ7kNvwEzGcsd&_nc_oc=AdpfGTnwYwajxlsXO6Bb-JmtIOtNxHXUtyOQ3O4cE98Cp_ei0yiSHReOlpv9p79kN_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS03ygg_4GJwF50mzTBNwEDfOggOGOLWQGnlkbuw6b0xw&oe=6AFF2F4D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtffGP3yBYkQ7kNvwGo94dk&_nc_oc=AdoxG-AW1qCcNOIx_wUY2GbA3zq5ZvFsCbLl0c_Be8cpcBrogtw3kkYywBENU6Q8TXg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9SJl_jUT3eksLoH7FtbMx1G_AQZWVlCuLmCZFROckOA&oe=6AFF3259"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQD0UIXECaMQ7kNvwHmlXyR&_nc_oc=Adr3q0bACBp6VDvPkBcwcOYb5gC9kAjEhQWcP5Ge8shTspR9yr9H7GFxh86XBNgBiI4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-m4N8qSITlvgnOr4VtheK7DXgKhZO-EKlJZdEvL8xSA&oe=6AFF1494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzlqKDi2mM4Q7kNvwHdj1ok&_nc_oc=AdpUVHztgTdUf0ADRqNxKbnHUmNdyutNb-Ph2Ft90EeiW4-sRW5D4b_y9_t1CUB348s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBBaKhpTIgNQi3EP4QEvdCGegbV8s8KyM4IqODYPcFzg&oe=6AFEFE80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9602696576428791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391904_9557377207608065_3493773536012673474_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNxPNISq2cMQ7kNvwG_JW27&_nc_oc=AdruQXEF46wQsZI-7hNc7BJEHVZ6GR7PDZwC9RuN82f8VJxyr2_miVT5sutCty7SwsY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvB5RteKp5Tii30LRfYW5qAPqmPpg9FrhkM-lHFAPh4w&oe=6AFF08C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AbhigyaanXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1740298860, "lastRevision": {"nodes": [{"id": "9296459107052541", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": 
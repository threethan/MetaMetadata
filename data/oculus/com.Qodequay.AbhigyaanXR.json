vwFgLmgN&_nc_oc=Adqf-C3XQEXy0tUmuXBv1Spcf5n8askZi2EZdEHCFIyQr1HZkeAiluDNDaVMdWUENsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrpEWUQdWstAsf0gmgL-LY_T6SjLfy6vDxymONJPNsMA&oe=6A68A1DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEJJhV1_0gIQ7kNvwEliM5V&_nc_oc=Adq0okqRDysviRt-JhOXcoX-xZMCGxnblNzTkm3nRf1juCsXQ9K74Lad__Jyk3l3QXE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASNLnH_qPIgwX0qLP2043x4bBx5JnF1mhEw_9GEIo0qg&oe=6A68AC0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omn8UV_1sNwQ7kNvwHQxyqu&_nc_oc=AdoBu9fKEEaVHT5KVFrlNoAPSDYHCRTLkr--xC1PWre0gSpv_Sh5KmAde3QqPDTX2BU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6p7bUjQ6XwoS2DVxVvLXOqbE-wNjfuhGd4zTBG6nXkA&oe=6A68AF19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKm55kDSOLgQ7kNvwGFk0U8&_nc_oc=AdoNyE9pxCZLiyVc32IGHda024DhyvFpux9GHsyS0zoLyqSQiwajr6lSP9y1Zil8020&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm95UPNNkeQsKb7sTxKVEkRpWdDeHAC3fFHbIGbycKSQ&oe=6A689154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZpyRbXwsb8Q7kNvwEKsUKx&_nc_oc=Adrc4qK-EwveXKYyFbABhT14_IJPueJkcbDshsBVdbU6TP8XyYwt5Yx2F0zGP0flaoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKMaBIBJ-MXBaVQ4gXv64E8Vs_fz0zVhVq5YVON2IVQg&oe=6A68B380"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
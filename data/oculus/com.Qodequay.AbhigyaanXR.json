vwGpvtHQ&_nc_oc=AdoSOvd1GOnbHEziUfau_vg8nnPnb2rmDT9YzgYoML46Z-gH47FrOkSH72wY4OSMrW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyUzgsPw1KI-qcJMxNTjq19rvOF6GzUoEc4Bu_5R3w0w&oe=6AE48EDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZSNaHY4C4gQ7kNvwFJ_2De&_nc_oc=AdoZX1skzScMtMTytgRhKctqH3_vO763xzowj16Dvre8l-EGxWWTFrYLLJ3aB1MH49c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpNyG-8MdZp-5fOaoSg65KKQfB4Aj8u31NWgzjoE3AzA&oe=6AE4990D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye_b62zzPVoQ7kNvwGQSDi3&_nc_oc=AdpH_WvEJNYhBOZSPy29vkMUP6v2-cvL5OiRNcesh1lGY-Dpjxt5a1MPLy0OgsbVM-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHGYPzysw_HQSDSa6bRqO87bRDZmhpdCWk5UCCbRDwew&oe=6AE49C19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6Fiw8YXnEYQ7kNvwEl6Ndn&_nc_oc=Ado-_m2h879J3QYbww21rSMr0f2EwwnnybsSbWueU8Xrz_gOJXRd_cw-R7eH9Pn9IAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfuIvhU9oMzvy0mlkGz6Gfdi8_wCz8zHL71Bc_lBdlpA&oe=6AE4B694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYcwg-PI3yYQ7kNvwG5E39O&_nc_oc=AdqQ0Nsv5AdrbuoJGi1g9RDbFJAF9iGPdX0yKQuTPoqYYYyY1PdgmIZj51cz2o-a25U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdvoqIXV3g_rFVKJYWQvwl-khnknZlrouDLo70iSktrg&oe=6AE4A080"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCop9IQjG59VGj_qkUGQA_dgGhXXK5R_-iOaXp9df8xg&oe=69BD3EDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXkFGxVtBPEQ7kNvwHEkWsI&_nc_oc=AdldyAb9Czokb3SGge98YbFufJCOegTqHyemkKNl-rFvQYUfrOwHxHZ_tGj923CL9TY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWvKYEXqpsBii0cYtZ79dhRXQty6ZpnTRbglVQ7ezyMA&oe=69BD490D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUcA3ARo-iAQ7kNvwEKUpRT&_nc_oc=AdkPOz6bTbYc91GTEvrohRebX7VW69IhDuCqJ7Vkblk5OA6mjectSnMJo2Xt4q8OLLo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyu16BywQnHeyuh48cspeD-6N4GTHdZVUfYuuFUWSDlhA&oe=69BD4C19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_1c1XA9ubIQ7kNvwHQ0HiL&_nc_oc=AdkAraeEgkrCsxJrXbd9KpEG_obUKDXMXTeQXnkmL3n004ivRAi_5DUmqYFEMuvLvOw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUSiz-3ybcrZ72AV-bheqkd1uuDhUXo0jut2HByytEpA&oe=69BD2E54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqhYcGdMTa8Q7kNvwFMxF0I&_nc_oc=AdkcjvJb0DX-wu0ALj-acGa3e9isSvk20V_VIhIJiaxDrGzHN1qAU96KZRPnNiZMJc8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvIwfT4T1mxk3Mu2VnUgJwEusigsNJkRK3T4AKLquWyg&oe=69BD5080"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
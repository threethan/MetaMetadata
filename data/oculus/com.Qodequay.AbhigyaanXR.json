vwGHLfN0&_nc_oc=Adqa-6wqzvUYfyEL7Gei2J4smA8xmEyTmR4MFcvbuJ5AM90ze_7RHoSsp9N_DmBai_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7pzAjh4zl1v1MLvBY9_c_yaLVayjwX3AI1x434PJMjA&oe=6A3142DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0VVSavB-JwQ7kNvwGuWBEl&_nc_oc=Adr9tZxjF3RTVjCx002bNyIx1iK_oU8Uto8AMkbhIwz7MeFuYgx3abw-iuuHv_CUk7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9ZRZ36NprYavj8DaoACWkQfv-XnzPD1AD3HFnMdLsPw&oe=6A314D0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXDQU_hdhtoQ7kNvwH9glyZ&_nc_oc=Adra_HmYH4YjjrSs6IqKNj4aQX4qlDUByPonuiQ0lNIvpIeCrlrrRojYlO6uLkt6wBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wW5wHp91SkIcSyMEbxyCoZbGxjmbc6tJIFhbKYOQ0pw&oe=6A315019"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsbcUBAp_0UQ7kNvwEbym26&_nc_oc=AdrEVvokZ03eKLLv9k5bLL2AP210bqZ5O4FOfM1UXDD0mT-D24T5cCdJDDsPYYa-BS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_66judTqzrZZt4qpM4MbRUaG5OQ59NWbjoZCkxePAT-A&oe=6A316A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmj52qSRXZAQ7kNvwEGC510&_nc_oc=Adoiwr1zve4khPqB397uVM3fOCydmfp2pIMKjddV0PC0k1sQexCLiCIJMtDd--6YPBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S57uXYM0Kd6gGp0DEpU4I8fjakCgmI_-LjfpONyipAQ&oe=6A315480"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwGSVGce&_nc_oc=AdrXWGtiS90SgezF2ls8UZ_3MbzldD8PGYCbKyGujopeyrnGW6sGxrk0OGssbQgK1HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qGO_Gtmlgv8O7p0XKYtzfTfaUXtLBH2PHk2rknQl6pQ&oe=69E37A5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYz3gJbef4oQ7kNvwHMrZHN&_nc_oc=Adr9jLM0IAiYCvoz46blPm6zwIJtjFPKiPg3XR4IqO3WSP1nfcJtRaRszKrbPJ5LsAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af374nhXZME9rvelfvdZa33UlP_56o2du0LlihRnO28skw&oe=69E3848D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcjQlcxZex8Q7kNvwF5OjCs&_nc_oc=AdokzDQWroqw-gfx3-7wQBh3CQduLp-ggyRnxAHnQ3hniZSObIXbWAX-pCbWEYoXG38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ql01rkN4mlqjs6dkgmmxxBSBEHUiahrcVR5mjzJ7cmg&oe=69E38799"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x75M0aPk6qEQ7kNvwHVggfu&_nc_oc=Adqww38FqTHVIEGpjDdq1cFv3DOwV3-PhnbID32X9KSpG_ZyfieQSGcDnZc7leNCCTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AZYUlyJ00cXdSJzJLvzN9d47m7HG_rruKdnVM3GA29g&oe=69E369D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNb7lPn3l44Q7kNvwEbtS1x&_nc_oc=AdpbiFBSw7I7fWLyUtdmB0OnK4X8a8uNBCqv_O1hMR9IuL1bhauq6RCEAfJdMhXNv8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gx3mUC1rv99nPaCPnMlnivTglVKeiA4Gm1Izy2nZFdg&oe=69E38C00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
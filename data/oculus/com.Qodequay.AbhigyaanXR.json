vwGwgYws&_nc_oc=Adpg1duLl_Raa8w2ooxbqLj3DmewxBnFA6Y_iR-bMPik0FjXJ9RkcRPxCYglloJcvlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-Iafj6fkvB_BE8xaXpDalwyqgsLOQ72-mBWQ57IPQ1A&oe=6A7B16DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPpxPtmy0toQ7kNvwGT2LLu&_nc_oc=Adr70FaS_D0hg0Ka9HrR6Y_p7yhp_7NRhM78JPcwrUqU08Oqwn-YXRv1htr2A0pYpS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH9Ci09eR8SCUfHKRf0UOPsYY-lJ4MC0XUG3Y2mi6X4Q&oe=6A7B210D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xriN2yP4ImsQ7kNvwEkYftN&_nc_oc=AdrvUZZIQU283WJiT7L-A7_i5XLGth4ygCh5LJ2bYDi6QO6n7TM8gQJL2PG4OUBxRLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLU3uDTYMCFEWFMHBBcEdlWsNbDWTDinryYGHWiC0PEQ&oe=6A7B2419"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP6FZgOI4rAQ7kNvwEkqhEn&_nc_oc=Ado_urW53m8rYqz-OfVyZ8y-gJW3elLfcFYocsdzapyo7pFEkjLvMPy7NbAzlmswcQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_ApoDbKq2M6_cezEzjuJsrOogrfA8CzrAYC5M9crd0Q&oe=6A7B0654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQm-HQUc8r4Q7kNvwHy2QfB&_nc_oc=Adp33Bx0DIXMAIp-ta0LpPOBCzFcPLaCVe2OETIH-7mjcqgalL6a1SBYFP4He4R3Oso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqeOdvxnC7_TLImrrGIL8miyv3Y4kA92zKgG3EVGt7MA&oe=6A7B2880"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
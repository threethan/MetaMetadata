vwEcHrWu&_nc_oc=Adp5VbN95xWLnIDYqacNZfV7KmtvXCGL84vwyMUL61QLFTnrQTAnca2axVO18AUKXLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0lBvjQgvbmsj2doTKwQK8HeV068ZQ-Rn-nHTtI6lo1Q&oe=6A2AE39A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcyLPeXzRj0Q7kNvwEC7lUx&_nc_oc=AdpHhnFA2t7_5c2_TQqqyxguD-PcM4fcAMOFrpaWgS6vESPkm7t0D0dJFldioYMyI_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nbc2sWwHw0QI4VsY_4P2aCwdscfKwjKpkQ5IlBukGhA&oe=6A2AB58D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpFbNxIF1mgQ7kNvwGVVTNA&_nc_oc=AdoX8B5rU4VP8PKMBoOs_4BweT550q4yNpKO1t08uWbHpXaSry29inmpUd-YySifOPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9reAwwzlp-RH9esNsCFhsg3_o9VwQkuwOT1WE2pwF5Bg&oe=6A2AB899"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt8e2au_744Q7kNvwGqfdqE&_nc_oc=Adr_6sZPNcorsf2zdYKhu0ASD5RC-b6Ram4qpx_YsKhlMoDih-WFCSU29eGuZ98b4x0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sbkQQUIby6SXXac0I9AUOez9R0YTq3DSJwPz73quLTw&oe=6A2AD314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQUZVISSpVcQ7kNvwFnCtf3&_nc_oc=AdpHdvp5vL_n2T2q7pGLzwSdqPgecpdk5aIVIbWkqRASfonzHM7PFgCSSogYx9aoCAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-XO_26TtEisqiQyAVriI5o_YSb9eLN_EMr-X2CVcPqg&oe=6A2ABD00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
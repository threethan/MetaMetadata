vwE0ax29&_nc_oc=Adqun8xTfKKqGhPI7PB-5U4lAzdmCCxcETDJD7TjYq-s5TRr2bq04KcYE_ktkDBbNy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdDewgzqmwT89I_ejMcKBkJnRWiB9nI8lW-gZbaJCSDg&oe=6ACE5D9A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQJTdhSNdgwQ7kNvwHAKp3h&_nc_oc=AdrMVuQCINwg6CyJJ-G1RAa1GivwEGesr9etc-2TDm34OM17TNEjGZRbIwmI1ZtSBD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbKsHJA4PO3uwPzxaXQpKdl62fbFpTR02TIHiCErlqxg&oe=6ACE67CD"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCetcGWhiGMQ7kNvwFQ3Flj&_nc_oc=AdrpBxAHEq6mDpofaOEDWcr4RoZtgjIpleb2YUkLJRh4fq_YroIPEUMtUsdOxb8VRDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhboh-JTBCaPXg0KNQpz3sQ3npl65zIw2-31KZiJmwnQ&oe=6ACE6AD9"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6LoAGeVF-QQ7kNvwGpFxhz&_nc_oc=AdopAr0slBxLwsivfjeCzNSScIs2Kr2ri6Vh7zKfNtHW068P3clVI7RMU44JW2imrt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg2yLqEPEm0AaXocEZYNNLZsUaqj56w2NSg8fEU_pFYw&oe=6ACE4D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBEXgu6PA0sQ7kNvwHrwUl1&_nc_oc=Adpgz758qhUP75LtkwvRzRAmcpPBP2JtWqkMWM5sALCh_u7lHql08ZECitzhy7OJm5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbM8iFYpyYbDGwrdEZ-6-FmtCunc8b3ZdJ8__XX061fA&oe=6ACE3700"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwHXuz2M&_nc_oc=Adrc7aWVhC1mPv3DChI578z47lkws_nOFdmGpygS697eYKpfbsE94l4hotB1dyZIJMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPb94Zh68DdMqseBNLvu_SQLYfdJtT5h-OqLNHQ0vNIA&oe=6A6DE7DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmfJHDyHW-YQ7kNvwH_oZwW&_nc_oc=AdotWH1JSYq08aRUXS5IscBL5VmPeIZhDmfewKMYyzqdoF0gND13SKWr1FeHH7kFEls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4ju-TKnGWFen-IErGFnlAtelok8-n7uibCBUqBxdreA&oe=6A6DF20D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT-NNRYef6YQ7kNvwFfVh6t&_nc_oc=AdoaI1R_9xCoogDQ8txS9WH2_C3blCOJGrLXMFy1qAjD9SA65k9zUk_ilJpKvqpl90Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfUYT2XLTk085unWbQzDMVvIC8Osh_MbGJ3NWN7rUzUw&oe=6A6DF519"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izaxE8ig7aoQ7kNvwFJ8lsB&_nc_oc=Adp9QYsCx2GgZMABkQ9VwjdPilmIsJJiS_WcGbNt-E7g0VjeO2q6xHQnhFXJguaQAAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXHHAIgW-mCe2Xy6YskPYA_RKcxBYpbaX64aYmKuZB5w&oe=6A6DD754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRQ9K7VtFdAQ7kNvwEeWrSx&_nc_oc=AdqkNlv2PMa4gfKPBlJR8qmEujPwr9PX0AKPCt9fYOHv3D7ok33FuGaf7BaIPN943tE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs7t_YaGQDxYK6YKqbaHFogkptDYPdBRJTJflraASI0A&oe=6A6DF980"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
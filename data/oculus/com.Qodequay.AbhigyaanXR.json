vwHbe1DA&_nc_oc=AdoPA15kRgdJ9EfMpRYgV6C6elUXZ6iQPSi4t1C1868nV20153V5hhBP6gF-fALKRFo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDvJ19hW_IbXOoXx03jhjx-y_lKC4f0oQCGqLdX0pfRA&oe=6A4E43DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrajzAScySYQ7kNvwH9i_VJ&_nc_oc=Adoem_K_JU14bbheXew1D6AoZYVpW6bnTc3hUGnwELYlPZHdwATvIvXkSE_4dTyU2CI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8_iQuW7KYLNsbFIl1NbWjWNiBJ3T2wJAz4QmVtkzxFg&oe=6A4E4E0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJgp-xnDMxAQ7kNvwH31mhC&_nc_oc=AdrWFBz6107zOHQNjkUfZGQuGRPp6diTMhTBjVIB20Ay_5vfEzV-oeIeuHGcVaL7sLo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD94KvMLxrp2gCY1chlC3riUhdKz0f1BGcMkYizEYfO0g&oe=6A4E5119"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUd0jJec3kQQ7kNvwGx4EQm&_nc_oc=AdoDUwkSf6om0aOAIM-o4_3dUE50jFU9DqIik8b0W_lfYNrzAGIRXhM8RvEeqzsCK5c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBmD6SBprwS_w5kf7q8wAukLII6GzNoRUVt2HavYh56w&oe=6A4E6B94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSdGu_g4L7gQ7kNvwGXGC21&_nc_oc=AdqsKh3JboG1B44WlUAOBudPDMtEDvbw994q0w7Ba-Hpqw1qCi3fNFGo8NBRlEoFAhA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUagIhp7CyAMe8pR89_jtSTd6CURfHEkrbHvOIUs6fdA&oe=6A4E5580"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwEH34E4&_nc_oc=Adpw4ziro74gf9cJyfjEpYQ32Hb0QTc_cKL3qolWTkYeevVAXukcGk4UEy0RiyPxkcw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ENmi3WVMHxRng2NnG2Uok6s96mTtxXGhNLA2wEqXY0A&oe=6A1AD95A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YVpNk_aUcoQ7kNvwHxNQOx&_nc_oc=AdofUo_SZkDpdBU4Lf9-HLixelD3zW6xp8pjiSQMaVwrp1EtFEYLw7cvnzb0lsylUUk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RlZMRmU_cSCSNLnfJiFG031H-bm-3DXBm97M66-qL3g&oe=6A1AE38D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NorV72YkYxEQ7kNvwGejUME&_nc_oc=AdrlWv4Mn_v-mYm-ym6l2M6pKOQsTDZ8Rz3hadqUm6x1m293USnzON9gIUVwl5kL0Xw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YzES2ucNAS5BFWFyFCpuCZ48Z8c7bWmr5Iv-CTYRBPg&oe=6A1AE699"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkU_sALa8IcQ7kNvwEO3f8d&_nc_oc=AdqCtHyHarRL_QmIGBYF_M-gNceQEHkt_NPbhm0Ndz6pMbzXtvTMbEZNGviCZuRbAM0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V5UY8KkiccEWjoI4072UUbn5lb29l97tQR1IDEplenQ&oe=6A1B0114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBfanCR8sg8Q7kNvwGrq6hS&_nc_oc=Ado-j1yaqyj_5lu-FAnXU6vTeLoNiSz2pQkAtOVxoB3M_whSysv64JennC4YCb4xWiU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uTqjKHUbefkLWk1lRmT8ykH8j2ohlaCDI2Ig9Zu-gKQ&oe=6A1AEB00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
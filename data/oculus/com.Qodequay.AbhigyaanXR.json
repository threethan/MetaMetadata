vwG2etGN&_nc_oc=Adq3P_6Kars9pBARDv8EvtiBBbjWvhFTffME8b0q9YaAyfAVcYfwOXLM8unZ74Vp9CU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aTtXnd7C6wCN9_Y8tYLYYqHrX7lwGETNLhTRFCBBn0A&oe=6A1D7C5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqKMZeAHj-wQ7kNvwF8BpHn&_nc_oc=AdrEa22AnTk4YXDt_OISF0EhX8lIWiBXxG15JfWv72dPsv1d8oZTusI_QDNWLXZVVyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41kDXEz9iHlDsnf9pSy9P8miW2P3-zWgjHjlerqwfCQQ&oe=6A1D868D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKGkVAd2-uwQ7kNvwE8h6bG&_nc_oc=Adq9i8xX4KSil8MQIE_I4CnUTiLZgLlq89bPsv1iu31fkDBO9J9a4VrUot7hjHa7_gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QuTiaAUD0yiPDH5BFXz8pWPbPDRTGu6_SHdVEaXjv5g&oe=6A1D8999"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkU_sALa8IcQ7kNvwFscyqH&_nc_oc=Adq15jN_CaE-Hek-MKhW1PxSYOZP4C8aN4jWn6WMp0rcODqAM1Gs0yTb-gapDfNp6hM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68HejAEHt1CKU0-F3EaIDR6e3jn0NK5xV9a5m77dubnA&oe=6A1DA414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBfanCR8sg8Q7kNvwGKUk2S&_nc_oc=AdpvyfXzDAjq5D00TbKgBJb-nlTdvz0_BVhn6a67tmMChtEJcpy8MsUCSJwO4ApzXcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rbz__Ky-bwnrI640yMhum3prVfsy2XzEsNyQTQ7xRpg&oe=6A1D8E00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
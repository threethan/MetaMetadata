vwG3yIrA&_nc_oc=AdoP4kv5WTzGt9WYXHJn6NSfnqCHLfo8mMoINY_AXt1UdFjAxBmWKsnhBJnsWUPIVAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SbUkJ55ENA6R1v_VfHHBBR-_QK308_S8vrb90ACnmsg&oe=6A007B5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIftLkKq9fYQ7kNvwEC6yHF&_nc_oc=Adr2alsPmIoPXhczkotapzaTO0IVbdVstPjT7uRK2TdXqjA_5dOTK87x05Ngk4JPpbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40gPirmVuGrAgum_fGc3kbeKaE4rIoaWe2Q0l-_lAM6A&oe=6A00858D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2bWZYy-qjYQ7kNvwGVWPYT&_nc_oc=AdojaHTh6zKBuujgQ5AM7SUWvNnXKwW5rBzuLrNUuqfFBENd3_V_9IHoWTKG9xHLFkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sRRFniPgX9WCQMZU3uBr1FF3_p6fverrLBJssQyxjMg&oe=6A008899"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y0sbmkYeYgQ7kNvwEWLgwo&_nc_oc=AdrgBSRacKVRvzJtS3t9SGUkryWKFX91YcWiMNTGt1IYgBihsgfrEPDwX2l1NlPdWH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Virw_JmlRRAJvg8f8eman3emnTzSQY9YoVeSbKTrTKA&oe=6A00A314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2a76AXxAcQ7kNvwHPJS-p&_nc_oc=AdqDmrfhhjn67_mFgCIFuaayZ0ZNx1mnr4Nmd6nSRXA6g1iMMAJwDD6Me-B1-hEiYw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qcNlBHqtJFWmu9xhN1BfeKgXjG1GwY8xrtdOLXOKugw&oe=6A008D00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
ongQ7kNvwHAreN8&_nc_oc=AdnbFdWgFhN1zlxhmynsLfDyD-2AO8ttjrj42KP3GeAtaQIYB_vcmUv2O5d2bnop6zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZNJL85mvGflo0fIfLTaRdjAGP1tUtwRMqG6YTiziF6A&oe=69B2B2DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJsY_qFcWLMQ7kNvwHMDjPb&_nc_oc=AdnR2e17qC9C000JfI5U4JNjzr1TCBEYcC1XVcruN4NUi4-YyZ2tqeC-ZwKIn4ko8bY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsXMdkaPufhuH2-AEWCUYAPImhxMY3TrjgPdL0jZvg3g&oe=69B2BD0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxMzLlVXshkQ7kNvwGvq9KH&_nc_oc=Adlw4-geVh1AvrF5UT-1jDvsGhG3LpT7A0Rkrlx6uJKC5OfbX7Yb0T1BPmHwqSGhOPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyC-M-f9v7UAFXxvm-_tvscEX7yQmAa4z1xhgXihSaglw&oe=69B2C019"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfp5BJj1f-cQ7kNvwE151V3&_nc_oc=AdnjGW1pdHkrdD5mFqkWB08X_pjHxrli2gy_bOjcI5iF1_UZCRnKxWaS1FnP9du_tOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIGIke9ugs1GJNbAvKYz5dyKX2rnAdxYNWj68WtcaO5g&oe=69B2A254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo2oOSPOgroQ7kNvwEvhWIt&_nc_oc=AdlH1oJ8nHSd2SwOedkEEbdjePAmxjUtPtxXz-h0VWBjbXI3RHtg4HGVQwBoGRFejp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBInSIkAi7IWVAVzRQ2nvuvlkOwnRIm0p6XO5QD5w0ZQ&oe=69B2C480"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFOR
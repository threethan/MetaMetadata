ongQ7kNvwHuq99W&_nc_oc=AdkwoHaX_1LktNUlLsJIKgPTm54wec5jWnjPSRlnGFJSo-mjY2i-NQUr7fGKzpfh-1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyf2WGZbIgtBPVLaEPv3p2s-WCNe0mCVZWFf5SUy9LAHQ&oe=69B00FDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aaeo3O3s5tIQ7kNvwGhsB2g&_nc_oc=AdnYdd9dPEtVOn2MaRYGRsf2IxZkTfQpxaYaX4pzFobb7mFJgYHM84I8W6krxihiv4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXnZiSTY8JyUW5TjfXMaHulNiWKoNegvVhltWr5Rp80Q&oe=69B01A0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-2VUMRpBHAQ7kNvwEL7Vi0&_nc_oc=AdldylwS3J5w93GowKqY6Ie8c783y1DMsWUmjoESatpdVn2zE6IuAwly_xbellwcUeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJWbTmT0X--ItT4Ht4gj-ao7x7eRwcis4IBeHXYckwNw&oe=69B01D19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hfp5BJj1f-cQ7kNvwH-6HFp&_nc_oc=AdnpkG4A3QMj-M9NDj1qM4lBQ6hVuZm8LtETm_K5DWDEbwy0YIp591Vb0YvhYS0tuvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6T3cqokJdzBipYZKXeYB1wDa9P2Airio1L-PHkGRVaw&oe=69AFFF54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo2oOSPOgroQ7kNvwGYVahd&_nc_oc=AdkjZue9WdGHkdcsAuT1w7ChHlmIv9kYtFYNd-94TclUeu0c-L1bFzFicwWUwqMFIcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgLBszGHWBEwFj-TbNDuArPYWB_q6mFZJKJxbP68rqag&oe=69B02180"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFOR
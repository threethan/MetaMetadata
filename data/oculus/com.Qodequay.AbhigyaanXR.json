vwGqacHV&_nc_oc=AdpNXCYWzmUzpmOdGfVRNKtMmL-2imNXiGvVlwGbmZwXp--H1aegh9zRVWPsrxJXEfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBJFVUloIOHbe7SVwnT5U7hZMDk9tEByL4YCSyWnEBOw&oe=69CD10DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AasOKDNeWkkQ7kNvwFMY8eu&_nc_oc=AdqS_5Px2EwJGkJ02bMDoich3GwVAVLIaxc2w84CLyso0jnsjIrVCMRvoSMocwaZZDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBBu09y1Sc70rThIZCL18YiBR4l74oEt_mZabREt7Tuw&oe=69CD1B0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-u7NnEFTf8Q7kNvwGiQ8vj&_nc_oc=AdovGvDCaUGyGrFgPs6y8aksbX5BVPO-c8ELFTeTU8Omd_lYA0Jg741hT9FUx1sjf7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqNJh6n-0Fg9Y3fWp7l0Ph9_HdfuisZcU9vMowGOBJHw&oe=69CD1E19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDPBya_9hPUQ7kNvwF8vwci&_nc_oc=Adqd2D8z39CIM1c8KqEPqFZPxKKjVJWJLCciM19lB77HVtgF1u2KGgSbWSux-9aIqrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt8cNvj1MM9sy5PaJrfp2zbzjIespnh2iz3Dyx1pmlvQ&oe=69CD0054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou_1QFwJ6nIQ7kNvwGuAwxV&_nc_oc=AdpWOGsbpGUroW0e6OIv-kewqrSv8GLAWHs8M0JGqHl_Mw7u09N2VyZA37DS12pnecU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE6G2TraicgUtrdhXHX2Gtp1w2qSHJVI3vIf2o11bbSA&oe=69CD2280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
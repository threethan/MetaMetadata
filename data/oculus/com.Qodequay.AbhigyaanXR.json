vwHnwECX&_nc_oc=AdrXghT73htWCMJTNt7DgEVRSjs25Ls5OszqqfwXbTOGB8TUrCzw8JTa4XJQm64Ahg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7C8pMnepFHy9IjoYVnfrE6xkXvzya1SKCFtYYhzMmDg&oe=6A8AE8DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFM5n5J92msQ7kNvwGLi5nL&_nc_oc=Adp42whCw5FwaaQ8kPCsvgKDK_H4EGXdB0mQ-wyh3dkO8NJ3pJoglNawpEt-3YZexaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtz70QMKJ3CBZaJgkalB-z6vkiAKXwNQT25V5DDAXjDg&oe=6A8AF30D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGlN6q6PigEQ7kNvwEs-N9s&_nc_oc=Adq_DnokE7ZyWe4-qXtz0mxjwD2FfkXkxMql8UM-TLlVR035dlliw8kNOQOwlhOA0Wg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfcMVIsuMrKLJYcycUavw2obL_vx71MPhTcaQ-Gvtp2A&oe=6A8AF619"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmt5wNA4SzoQ7kNvwHHBRO8&_nc_oc=Adpvtfmi_KqaQ19PnotvMvnb3TfUAk6TgtZJOwccK1kL_e9tWoHXVF0IYbHBz4TMgVA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhm4DaO6iwV4qbbGZngtYi9IA1BuId8e-R6pdZqrLseQ&oe=6A8AD854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVe9ZIwbaygQ7kNvwERNd4D&_nc_oc=AdrEmR0KEVu5eD7XIihcQyOFF6sBsjeQ8dRmjaut_XJnU3R9MGzlpuFreNirkl94wcw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMk8x256_bJkjjwQUdBCA5HRsDwkZ37004AqzYWz8Mvg&oe=6A8AC240"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
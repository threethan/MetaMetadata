vwFkpr5t&_nc_oc=AdqaS-aWZl4uHDWLrv9TfKzBZEZo2HHrMSK3CrzCtq2yNv_YPA8QeVOcA2c-QV9TAP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YTF83u_I4KyjEFwFISN_YNK26Qf7Wg-jUtOYM8xpdTQ&oe=69E0D75A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYz3gJbef4oQ7kNvwEcTrr9&_nc_oc=Adpw-E6W3fl88yglJo7GiKR1-eohmrmTJ4DW3lgo53dXt-BNTdK077NS5wsZhF6gfgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zcaGwz-2jbSRb5-JQkML5M1-Y3Xwb92ofnrAyD8Oe3Q&oe=69E0E18D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcjQlcxZex8Q7kNvwFdmbiR&_nc_oc=AdqvTmvwWnlAVnagkz8uf3E9h4e06VHx8uvqS4j7oMYp1TGMBxIFCKoTrF1sVOWxAOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kBUGDRkiVwEI4QL2Qa6x6TjSKAZxD2Mfr4U04Sdx9iA&oe=69E0E499"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-To8SdkEL2UQ7kNvwF4Bhe2&_nc_oc=AdqMakit6DNe2ovKEpX7GkhDsmzddKRttzRQXQX9wdeiFLmbhlxdy_ZHbqnCbfFXaNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af141vPg7OzUKKis3HxRJ9cjNuQHVaHRcx2V0XCHtzAtTQ&oe=69E0FF14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzlUZChlessQ7kNvwH0sWFJ&_nc_oc=AdpOjparD2advxm6Sd3titJ7JOFYKOm5ST-8nZHDsKJyFuKClzjsQcijCnG0Tb51v-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QUo8J5lmKJyLhB46dafXqOoP1CUz90iiapMqmy814Pg&oe=69E0E900"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwFiYtVX&_nc_oc=AdqVFQkc3qMolqEYpQ1NNUf0Eo0R_y-eDcdjeqrmHLR9TX_WyUGwhcXQkvnNCaprgnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTb5FHon6TlRmuikGniyqp-xeqZxcqY2KY-iVoxrmKpA&oe=6AC6749A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVXY013XNiwQ7kNvwEHWIAe&_nc_oc=Adpt25gKUugu3WkgMw2M0kAReZKYNCswbw26CC7Cr5l5rUn3XcNscSiVfvQOF8wM8zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOEf9u1CdhCTvAiQNwQq6w29ujddJte9WUEj-HvspE4A&oe=6AC6468D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y64qRT6ME68Q7kNvwH2uPvV&_nc_oc=AdokMWH4v0jwzR86pEsCYSb_DG6QPTSrfNcN_CzKFL4DWe-7PU2Dk-_j158KsYHB8CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKBXfzcsSrVasxvzVJoguTyUXkNgU0_BrGgG6J-zf4Xw&oe=6AC64999"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qowPhdxzBSoQ7kNvwFCGHKN&_nc_oc=Adqd7cTVFX2wKgk_XC4e5stigj0azu3M7RN5OuXQHRRv9I9d8SHWmyJr3ixkEipHIs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcMwlovTUrI3S_VUwvcucxfuLnoXBPUZR4e9GbIVX1Gw&oe=6AC66414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCXiCmaR4OAQ7kNvwEcAgZO&_nc_oc=Adrodd-k_D2IkWb5BRSigwsBNbPr_7YqBNhz1d7ZeJuSb8UOWAcVNLrmft6hgR2z_Dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3W6MFuG253NPGw6cfBVPVUpSIdiq_Q_wU8qHNRRGNxQ&oe=6AC64E00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
i4Y7ewXVzXRzIznbG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4xNa7gc-aCLqWh4RMO_LlBOHiz4O-nIIzjiklrJN9nw&oe=69A2E0DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4b6rHRBSA4Q7kNvwGqrxbX&_nc_oc=AdmoF-DfHrqe4-XWo-k3haHJIQzbVMB6bXGiOVmM0rqPXOpZdfgg8wGb_4eCtPgRAeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstLyU1fxrAcxLaY5oaayODA5SICEWHuGXHaV28Alau8Q&oe=69A2EB0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFy2w6Os8cAQ7kNvwGICrfL&_nc_oc=Adn_qtKmtwiCmulmPnAPAnOlaB2bruK1AJOYduSl-Hzvp6mQ4Po2qCqh1pL20ypF83g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftt6EZwBxEEuH7EMilYdrjSHbHgAW82r_S49rZHLS0wCQ&oe=69A2EE19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUmNPEGimHAQ7kNvwEgj8YV&_nc_oc=AdnaijU4lAx876wKdl8vE54vqr-iyAoW40lRp6L04jR7e5CnERdSFPhlBJfSqtjT34E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvkw7BpY41WWMXveqezeQ-EuqYCqqXSs7DDlY01XmCZqw&oe=69A2D054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6dkJMm5BnUQ7kNvwH-Dt-1&_nc_oc=AdnMHlR5cgZLxju_UPogbb6Ybn1jAXVPRQu9ygZll6U41uL_OIgBoSfzGaAWuO5jmak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKFCSO4qBlW15lAu-HEg2AMVgQuxkmQF1KBAkO7qZi-A&oe=69A2F280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
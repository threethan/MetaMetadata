Y9CPoQ7kNvwHe7Rrm&_nc_oc=Adn83Ii40tZ_eqZec9OrumYmEb_Snyoj_ZVQKu3v1q8PUwxDNQhVAgvFNGdziC0MtZo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPHVOYO_2f3x_IO3AYXulIoeNigeFTv1zR2zGsGwq9fA&oe=69AAC9DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsnnEtzkqREQ7kNvwHIY3A1&_nc_oc=AdnNx7upEN-hdo_RzbkntWFrHs6ThGzkQaPjwLIfdUQpkqH0Q09ontuKxSLYGc7bTI4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-4ILkwyESFyb8EClGHGzCfz3Y-UJ3iF-vGoJPEFUgKA&oe=69AAD40D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaN4xGxwLxMQ7kNvwFrktC9&_nc_oc=AdngnS4XHYU8bqDAe0doLk6vAzrQkc5306Q0dYhnnih4fjE8G8H5FvLt_G1AkQNm3T0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyW_Np0rszqvg9Xll_G0sF2W575yAACtgNP-VuoBAK3Uw&oe=69AAD719"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn9u4WnPH2wQ7kNvwHNOXEx&_nc_oc=AdmEqWu0kGH6JZkYtzJmdAssxMCrJhCa5uBP-_vUgW8f8JdlfofQHY5zZ8qeDiTRgVw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afyj7uLg0r_P-LwYlB7DMEXIBOUezhj-IxfDl7SF7P7W0g&oe=69AAB954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAgPYj0sb1gQ7kNvwEBPue9&_nc_oc=Adme4K3CuOgCLbjEcFqLYuhrVCcXY98E2Zn9rJI1Zy3LbKQ6OslltU_krjRv3aARIvw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfK5M1q4xCKaPiAUgVclL4Wxrypv81KnPGd_Q1EM-5VQ&oe=69AADB80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "CO
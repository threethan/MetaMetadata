vwGtngkZ&_nc_oc=AdoLLkHg0S_YfXismhxn-R2TUpLaZkPprPjQMM6ysRYmhWqe3sSgmRQ98qsBkDUQq1I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Y6kvBhh2TRpmxKssMJnMJxJhL5ccyoWGhWfiydnJtQ&oe=6AC5231A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDdNKchzZYIQ7kNvwGfJfEZ&_nc_oc=Adop7V1ovaKP8uJEcmXTLeteBiC5QXCU7QvNthC6xQ4G9KONNhy-4_tcP2TtdC93DWI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8aLLsFaiZH3q1baUi6XSvRyh5UIJUrXLGJnLlv7h-5Q&oe=6AC4F50D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKLB-psU4SsQ7kNvwGAogRr&_nc_oc=AdpAP_WZsv0W4rJzXG7yryXG2uCf9yWId8SWORI5F5rmbs30Xe2gzazSphOTNTD1L4s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiVCzPtyKQV7hZiBA4bat5nlb3d_fSPC_FIfA3WJQUxA&oe=6AC4F819"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qowPhdxzBSoQ7kNvwGxaDdx&_nc_oc=Adpd3FtfgqAIR2A5LRZWIZ01UX5WEldTAKg4qHSVerqZKoEGko-oCmjBAsBvP7T7VnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIRkIrzYpkwXeeVSSr4p0v_Y6H6AlOOffzGwScU_1MyQ&oe=6AC51294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCXiCmaR4OAQ7kNvwEwADx0&_nc_oc=AdoeROPFGNFco5QSFahXTf-KrkEdpukf4tPm0qCX_soO5I_Ebblvf3WkJyZZvN4dHVw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZfAzuMMhr_kI5y4__1Lxrk4kdwPE8Rrnf3yKzmMwQIA&oe=6AC4FC80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
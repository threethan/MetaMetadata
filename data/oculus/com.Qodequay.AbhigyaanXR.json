vwEgvgwY&_nc_oc=AdrTOWH0fma-kwn2-WMmpouZaSKL3AjEobAynEeiS7fO2213SxwB2ezwUAbFoT-YYZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeNgqjC5dB3NV-F49ojEAiUOSImC572rtqQIgPNWLIbA&oe=6A84515A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dt8sJ3Sum0Q7kNvwEciNAH&_nc_oc=AdriI2tLsKrqMnkDKQdqKO7HMdGsjJBkkGnhTgFOwbuzfsJC0pbe3UKz1kLeqw-2l8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnTrMhc_P0x__eS7br-NsDH9OkHN-WkxQ7kD9CUBUG8A&oe=6A845B8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB7EPZlOETAQ7kNvwFFqX1p&_nc_oc=AdpEKgvTWycFSXt75KZsRmYax1Xj8E-f480iu-20ARPQ1SDn19vAnoe1784iPycZMOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSk5zWI2MpchiMIe3t-sTlP484nS6TSRIPVvHV0ZfVsQ&oe=6A845E99"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZnQ8JaiixsQ7kNvwGL43KT&_nc_oc=AdraCm3YALpUqqO7PN0AJX_V07DD3ZgdMDEHTrwyftxBwYi6ElHyzkt6jQzYvsK3b1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHhjJDKy1dq6o_qXC23kzL8vBcHCgZ6jEY0mqt65jiZg&oe=6A8440D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Al6vM79cEYQ7kNvwGavxTy&_nc_oc=AdoxxgP3ybqdHVH7lF_2BP7it8Wr_5bhV5mSU2fCY412ATl0sT68IjWwjHnHEkcpmE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN5v2cuFFAA_8RcgDx_F94MfZLAe3nM10CgvMu_JuFCw&oe=6A846300"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
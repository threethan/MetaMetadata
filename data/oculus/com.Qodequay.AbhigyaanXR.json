zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNoqeV8P7oizxvKiiGrNtx5V-JFYMCLVCOZGFY5TVSNA&oe=69A826DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHI7ZKfmfaAQ7kNvwH8DE3Y&_nc_oc=Adkcs7P1jQwpC8RHB1xeyD7h1s87xGfgl0E42mUuJlS3h4uSTOcMBU7j74SofAjRrWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYw-I8uWU8roKRASx7z6C4lv8dff1ulkdQxyTLmpzmCA&oe=69A8310D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WpkC10BCq8Q7kNvwH9np7e&_nc_oc=AdmylgkyjldjqKIp2xPtlVQPDIBnkjI8LFnmpI7oKMhbjIPtZocYm-TXmSrGH-fsZA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuTFyweAzGyct-RRAO0hgO7Sd3Hfi8JYF5vq0VzLrf4QA&oe=69A83419"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn9u4WnPH2wQ7kNvwEOMb_B&_nc_oc=AdlG9y72byZHkhKDD3Ujwc53aXLU5e7FhkqA7ma3AhoHdd3CCPx0HZ_a08FAX6BwUDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftcKFXA3KW0QSbJjGUgpGDCMjrGY0YKlUgxLjkLlMkEAw&oe=69A81654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAgPYj0sb1gQ7kNvwGkgSmK&_nc_oc=AdkBLBKQlv_cUuGffBPqv7T7lm-Spl-23K2BuoRWCnmKghF3FGoNlWebNYByhNN-1-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuR7T7U6wj9m0tqNVYIxUi-QYb1HcEoScp6h0cuEt-QDA&oe=69A83880"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
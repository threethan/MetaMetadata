vwH3y8Di&_nc_oc=AdrSQAVcyRe-q_saqr0ovx23_niqScRwn6NV5SAp-MK3pUSlOWgG9cq_-1CO7hXiVCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvwWmJ6Ct2gRvWhtwwm-E-QOBCteNbjPEZpuJfMCqtnA&oe=6A5389DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gg9rskMCe4Q7kNvwGu0PAa&_nc_oc=AdpcGIPaWiCtMLGBhJxEYu8qfqSCi8u4fQC5YzJ0dZ7HNo-s3IUq0YKEXWJiBqMuGF4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8lr4PyHnobJsKj7V5BAWkW8WFYNb7i55GXJzL-bIw6A&oe=6A53940D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky5HRcy2pJEQ7kNvwHbLz0p&_nc_oc=AdovLXCmgdD37rJYN-fNVb4hiQpGLl58g3IpB2jaNnoq_imlbWQCGOiy3cLjzth50t4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhb6omV0HWrOygxcTNJVQl_UUkHnplBqWdKYISqgLNcg&oe=6A539719"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaWtc5ec70EQ7kNvwHHRgV_&_nc_oc=AdoQ5SgXs7qSjnwagB5V61ZS7DNegHtHkDRcLend0UsdNiUD8i6FIkjlgKttY-A677g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg4mtb4JOVuaDKTDU5iPI4YD40jhWP2bljiusjFtQg_g&oe=6A53B194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osx6Ms85ZFgQ7kNvwHbbjtl&_nc_oc=AdrpJW7M2Am0jbQQfxtokA3Cddv-CXWCPq99HrsxMD1lpz3BkGMer_VNr01knbiuZi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQActBizWBLRcKf0mTi4Ma6YiXN1BtX8sXrS-I2Luh1oUA&oe=6A539B80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
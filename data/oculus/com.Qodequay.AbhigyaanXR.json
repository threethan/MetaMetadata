vwE8l0tn&_nc_oc=AdqP4nk-zrU5tnys2PUpBL75iA7ANMQmhXNvI3lVmiKA8B8gcRjx4SUzMAaw0R3WYBE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHroM6SVAiAlZaOj0R7uSXPRjzFORRRUNcLdaFgiSyHw&oe=6A562CDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gg9rskMCe4Q7kNvwFW1wKQ&_nc_oc=Ado03yaandvEGUm3kvhkNzzYkNSguwSWanTIY-ajEASXZ3F2-AnqKgXCaeICNdDBjIc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDncpiiExNJtY9aeRSmzZHx0OBcPdopJuiJBk5xXWwPhg&oe=6A56370D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky5HRcy2pJEQ7kNvwFuY0Z3&_nc_oc=AdqIb4_M775VYoyrSr86FO1UM7aQcy4fm6tP9vp5Wi5xvQZVCAHHz57oH9b1rpCeUnw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHEKReDs4hJ-Gao95CJE9xKtD7Z-2TmXpFq1eklwSLgw&oe=6A563A19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F57TAVE7HjQQ7kNvwE4cQ9D&_nc_oc=AdpS7sZMBYHhk7wO0wqqeaU4vDN2m9BF6DzGz1dJL7krAjU3fMw5IXasubkVeUMeYK0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9ZMv84Zt2zDId4A8tN_sviWY6tF9hGTNIZp72WSc6OQ&oe=6A565494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fWGduuiIbcQ7kNvwH68zz9&_nc_oc=AdqYs63ZAlEYZLQMaUeOGNCqSYTHczJowA_MXMDmNf5NBBg_L8vfKFg491ciAiGvOk4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAJJc9Tlexax8OK8uQRQe4VpdARKKCoT-7TZQMmuHacQ&oe=6A563E80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwFKEn5n&_nc_oc=AdqPg4noityspd-QKQVhBaicqCnetwzxAe2q5M2XIiB5yoRMoEIapolvlYO7m0sN6J8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_xoj9tlVRuWBUxyEnggjOsWLruF4_QNvHEzUD9YLtpA&oe=6A9AF31A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZnJg-BTj3cQ7kNvwEcLaro&_nc_oc=AdqII5ynB8xxsMtklcAJYuq4Mg65vSQs2GBJ5cdFTBFtOb0VAVEUC7CUntLRGnppFA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqAuYNzdiokQiINCt1oCzsBkWnVzLDavNrU9YPZ8jJuA&oe=6A9AC50D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92LH6i8wn3QQ7kNvwFcRmgR&_nc_oc=AdotpwoYDV3k9zsgDl3QcxemCH8kB9TEg_JxkUhDdB-5kboeU-gTV78R2ErJTpSLcHY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5kmE3TEjK3HatP8c9oEwYM5We3_d0KTuIldqy1SJxlQ&oe=6A9AC819"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePZXQw7zH8EQ7kNvwEqne0U&_nc_oc=AdpgUGQX_DbpuOm1__ziH116hR_9d4-eZthUsZWb3xQKkDrxlcZn8BYhm6FGdFi1EvA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJDklFkus2gBK7g2lIhTkVa3MoOlCPbuhxZhmwp0WYuQ&oe=6A9AE294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9c84M2f_xMQ7kNvwHKv2e3&_nc_oc=Adp8mS03FfFwP-gWVEwYb_oHS7NngSjdTqP9UeVa2i0Ag7GUR32wqNbiW1J_RUXHk4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSWIQyEt5Maq7cBAzqxVNir6wfSwMXL6YBvF25jcqhUw&oe=6A9ACC80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
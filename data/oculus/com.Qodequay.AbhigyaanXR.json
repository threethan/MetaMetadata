vwEXmrLd&_nc_oc=AdrihzrzE3D76qvyBCPXwQEc0mKTbplGdsApWS-IWwmSDlcyQjo_YHN6sfsbrBGmI5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL6iaFPKbp0WoNii0cR2v3saEmnsH2HIVmvQjk06CTuw&oe=6ACD0C1A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewCMHFlKYBIQ7kNvwHVELKM&_nc_oc=Adr9bdYoTmCblNgyDTq7oKGTfEcdol8QDfKajOxX3peLiaBlkoAkX55s_9VshJG6_Sg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOym4hb2WOfBQ-nnyFWPpsSMDgAlMHcnzOf0wGrljLk3g&oe=6ACD164D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YMslEhgASMQ7kNvwGCHU0O&_nc_oc=AdpC7r3pftdIuWPDpLVcffp2mQ-_1G2I01HEs-DrU9Xu5obbclYXuC1wmGH9uuOxpPk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2UHlxT_KU3crYRnr1Xd8--JjagUgZRDvydCN2NmCHgQ&oe=6ACCE119"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6LoAGeVF-QQ7kNvwHYhHO4&_nc_oc=Adp44-TGZy4_SSXQ6NIYtwuKfa_k3X78zJe2eYz8xgTgZaY8LygbmJgSt45fR0EVPSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe_7aRT-esFY98lAD9HSigaInG4WwR-mjj9C0JrbyQBA&oe=6ACCFB94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBEXgu6PA0sQ7kNvwHNeAOQ&_nc_oc=Ador-S3BjHV5N0fzYYsbWa7NkB0Zmastf_yKzw6nzsVjd4hCtKwKLIvy_L7NIoYQAHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUQoQUzEnv5ggRKbMaOuOBx6wMM5H4WPe1ceVqzQW4dg&oe=6ACCE580"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
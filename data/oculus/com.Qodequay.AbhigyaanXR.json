vwFd6dJz&_nc_oc=Adq1sXGthYjsI4aK_MDa0Wt2H5haM9n1cydgJrcW4t2evs6pGko2SI-8OEazjqtV2d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFe0NDcChFh1nKwRSLrSPU_4PmCqFBnBP2fSxKjxRwog&oe=6AF4991A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmkMXFnI_jwQ7kNvwE9Z0ZG&_nc_oc=AdodiFYgVtK2XGlPM8d5ctzl37uCFhLMGxtKARtCx3vJR2LDcKa8jHHyB4ZceVAqHQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk8ptrk6jBL_XNYlmEMxwBx6iVRhYu6p2ovgLwr72heA&oe=6AF4A34D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO-tj3biC7UQ7kNvwGKhNoz&_nc_oc=AdqmQsW1zzRcuDCD8GsZk_nVooAYw4whxVtzKVYcgyVXL2eAxWOzx5PuIBBdyZ2bpsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCny8esjvcAxyA2Hb4THLKq9Ed0XlfBXyKh5uTasodsw&oe=6AF46E19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K2iUgclFFQQ7kNvwFmqdEB&_nc_oc=AdrdrXdom_vI9Z5VSQ6G8--htVuleKlWCBXb_YukLgynvZ7i3H1O0dzGCAU-Q1Gb2Mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVJyUNsqAxPv_jXAOiZeA37TCe7GFo7MZ7_mtw3lZj_Q&oe=6AF48894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2kQdGgbXQEQ7kNvwHi4byE&_nc_oc=AdqdFOQim5kNigIWfMj3gXhgESs0H8xYD0ryOVjbfSEkA-_XjmwzOTbsgainS5pIjqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1G0z6mB6_ZV0G5XnQzHCryWedyKqycwj5p6xap7qMOA&oe=6AF47280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
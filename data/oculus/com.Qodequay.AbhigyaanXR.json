vwEnubDV&_nc_oc=AdrzzgsLr1ZjV3XAhoswXCqJ9JHHzQ_yR8PVGU1r6MLu4op7TU3jCerDQmzPTSl3Z0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDSRaXBDwQv4jV9l3QDLdWGv5ney-ay37JmZN_bQWtcg&oe=6ABE8B9A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94K9OOMloeQQ7kNvwEWe1FJ&_nc_oc=AdpjFYywcauSFHDF7Ky6PgFFc1Mr7jzJ2CuWk1qNsS6ATXthy45r8_Dh8wTVzkNKQbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_1K1J-ZpF0ammmoWvEvYUf-9FjDjdx6c_6qLhlHAy5Q&oe=6ABE5D8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBrDFd7YIeAQ7kNvwH4uhWk&_nc_oc=AdptkAg6SEUNVpD9he_dbVZl5x380HxMrFRzW3nzE4Cb7tAKc8HYb9QRuXgOXD9ZAFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzERyY4Q3iVkYpp8E3THS_w7XAiSfO_5Rq75Az4_M2xQ&oe=6ABE6099"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVCQGB6JsCIQ7kNvwFlXNVr&_nc_oc=AdoEAcenAqfwUd8lIeOmEepVc_vRBSQciaLVUCSBXMidlM_DEn2DcxS6eaxbbluTjIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBf2EByK11spEHfJ1T8sZgm4sCyk0163p0J7el1RS9AQ&oe=6ABE7B14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksp1METaq8YQ7kNvwF6G_Oj&_nc_oc=Ado6INQGCz2MwrvLt4ujuS7eJiZ7Zgx5CgBDd8RuwW6EnX-fkOVPABotaeESKa22dfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbqH-vrbd8aoRXEtbzlMKc9kZF3ZL82hrJavxYWzbKrQ&oe=6ABE6500"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwGR000k&_nc_oc=AdqPM6IbjxTjvDDFkdFA-_X2VgAx1Ul0IeeBPBxj_dvAslQCqQN6btHAS7PDFq2xkcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaYPKnrT-tS-svzvlrkC9_aZ6Lw1ZVALooCrDa8RO6Sg&oe=6A75D0DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G3d-gl7LcoQ7kNvwFNHIX3&_nc_oc=AdqZYmT6-aq2GhLm9npN8KJ8-hVHAMMbPdq5BND6U4m4XkYcmz5usfHD73-aCwkGOJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJIj1B0IZVZ_QV2jc6g4NirfgfNYumO-qLdDIhfdEnXw&oe=6A75DB0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P76Kgh6oc88Q7kNvwFTzXlv&_nc_oc=AdrzIwoSNZhaeyPHXsadaqNp_oSMcSrj-laDk4bItJ0p19-_tvOrm-ESlEmLiJwkIYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0-oGLRsQ4zPgrI3SpXOMwYob8v7VXrRT-FYJI8f7HTg&oe=6A75DE19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyX85igqSswQ7kNvwF7Izbs&_nc_oc=AdoEyaAC_rMUaPriMoGFRwPq3ITZao6kzvQITRl0IlsbZGebgTBnrmWTwHXzXJMIjho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdCLfcBlSJCdVJyB8UyyowoPxKvLWr9WGFVJ-WviGAQw&oe=6A75F894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDS_TNsXiEMQ7kNvwEoaxD5&_nc_oc=AdoRyXmICoBcuOiQVesPAU5f_Ouu8iuhAYI0VhEbSOHo6bEH4LILqQ2o9KMRVhEg1Lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyNxXB680wLSR54eOY0cXsLVJCEwjStdOstqpJYWyBAQ&oe=6A75E280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
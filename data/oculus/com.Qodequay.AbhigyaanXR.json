vwEZBUpF&_nc_oc=Ado-HwdRkiUvmfofeTJTnO76P-vQ7ve-BVcaoRUPwjBw1eXidbgblF2hZfzkrqekKtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq9EoTC3826yczwGH4qTZ7e7EhlClC3nN2SJQqXNkRTg&oe=69CA6DDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AasOKDNeWkkQ7kNvwEp_OyI&_nc_oc=Adp0qUp22SC--bEWq3jIiCuFj4m3pPLLLnON7Z-Z9GLzJwqhr9vmw7nfRxJ0jRNAr8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyfg9Kj8_pNQwY3wrnUR0DLBK3VVEdG5v-Qq0XfdTlzpA&oe=69CA780D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w5rOwNNhNgQ7kNvwFO8bxb&_nc_oc=Adoj2zOwJEWicJm0iFs3d9VwI-ezwJDn6oaDYtUuxav9GjnjlmMwwfrlO-AZRGCayGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMkBq6FCN8ScHJJUzdW7QHBdewtXp9nEeCBj6cPaCFiw&oe=69CA7B19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YinZqNWsu9EQ7kNvwFPdr1t&_nc_oc=AdomPGTMY5Fwz0nu6Mh89lZaBBgIKk5fO3nkgrTXJ5TL-YLvbwOGzVzeAlMBwcI_0HI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5fxT0b8Lkajim31RNVJokcvvH8XCBepV7evLZq7z5vw&oe=69CA5D54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhYs8rBq6aQQ7kNvwG6MoQz&_nc_oc=AdpjzhYc055QNPlUMrJw-1CXTrXs8Gb4_U9EXyyCZOIHj3w8oAz0whtLJuIengFlcnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2AfC7bU1RoAtlBPtP2dDZOCBYLwmbDSrYMbTXIH1rHg&oe=69CA7F80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
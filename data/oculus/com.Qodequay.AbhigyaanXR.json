vwFW5NJ8&_nc_oc=Adrz2q1dB9qDHE73Ow6q_mH7W9uRgOom2vlI5k44qbMQWOp2Hx7J2_FCBO5CYf-DtjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtBGcwOB5XkR2SD391IwHvuC9BK0_oWQiwB8PrbxTRUQ&oe=69D1055A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyQ2MBONLpEQ7kNvwHYqs7k&_nc_oc=Adp3Ho3NdpSndRlF75EipaKtMYWKTdABI0l-hXKx1wxXBC1CxmeWFaiFwSvr6A7pKf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLArnwJ9qeS7fZz7p8Bq8zM63Dspe4bVRrGiIcQQaujA&oe=69D10F8D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UvF2mDjstIQ7kNvwE3F4HX&_nc_oc=AdrEmrzlda-dxueCU1NlIGpQ3g-MaG1LiFH-ZAEJ4HXxMbpmN_-l_A9-gK6fmVkCpPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1fqKL2-UxV-MejgJGdjYQ18CBTLC39BkrIOpdbqrS2A&oe=69D11299"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBAUyhWlKSQQ7kNvwFCfvin&_nc_oc=AdrQU8gUFt5TTqCdw3DS-MwS096n-8cYQ8zgyf5tZCbosTWxh0s7oOB1F6EI7Q4wBXY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUPrp4EfDfhohU7oYGEo0pofKT48TaVR2pXLQ4FKXxWw&oe=69D0F4D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYwZdM3C2msQ7kNvwEbkCz0&_nc_oc=AdrzjvP5VFoC1WddgeWQ5-3ZaCjEg34RLtss-vETL22F0E6hruAOm8Xiq1_kDStYFxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyjmkt7oi80Lw_pqfbj1-jt3LxT_GkD_Vw20at7AsdDSA&oe=69D11700"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwG06_GD&_nc_oc=AdpGOvH5nWbAkrIJX2Qu-15uGCtu2xWBUH5Kv_W8KabQcXDrYWzScrVi6urbgdAyuz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv7RsknduefHXEfjFcG43Ro8J2HqVVl8mSk9r6nZd9hA&oe=6A4A4F5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWCS8np73UQQ7kNvwE4GJL9&_nc_oc=AdqjZEn6BE9eiya6LtNfbV7RNhob5eIUWGm88hRFDzGFJPDrb46MFXYXQb65Lb1g6Zk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB5a01_h2dABQ6N3DPI9TuFgs0H6uMCxSCHZmf9gK_MA&oe=6A4A598D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4z0dJWn6kwQ7kNvwGaeMJ7&_nc_oc=Ado2-4F0g3pxBhaeaerqMMV_mmKO8h8Gi8w59P30ywgwG54l6Y2v0X7aU-LQdDAB9UM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgUZwe6g2r1-b-K3wBwtPpXYWCEEF2ssFjgOGvCu-62Q&oe=6A4A5C99"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2spQPHcowOgQ7kNvwGJV4je&_nc_oc=AdrnQe-MYTgN1CVuYaYvKM0L7vIrGb00k5H9A5jD93PIDlA6V7-yyT_1wAd_ym-XqSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDChvjmpa8U3SVl5YcGIa5Apu2gbshnZVIrfe1p1xwZ_w&oe=6A4A7714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tYz8e-LbVsQ7kNvwHcWO6D&_nc_oc=AdqG1meC8G7ZgTh_xq0-r7sb05c3EzxgVMUKKM6pkBvAEtENY5fQvkH9L86UodETXgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7ocaRlXfzkDo6wYIcynlyUwiBPHTIohwC-CAt3F_V6w&oe=6A4A6100"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
AbzUTp5el4N-F5DVqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftyaml607tyfygNEdCiBDTrKXEib2AdfAvtozoVAcQMwA&oe=69A583DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4b6rHRBSA4Q7kNvwH68rRy&_nc_oc=AdlUBwduJjSWurpb9zwJLKTC-sNRhdktNpD2dL7_GT77o_ka4C5qH8_RmTd_TyCDLMQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu0svZs_Xzv9vjKo_DqGY6WsktjO6TgYzfZ51q-2BkIcg&oe=69A58E0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WpkC10BCq8Q7kNvwHz9DxW&_nc_oc=Admt6ynCtxtB0uWSog2wQCN4GKdqGj54r02Awx9vjxFVzWG8J9fDgECgwlUHMcNxe1s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv1uxSDNBh0ysbM3AO2PLjPBC4HpNUWbhOWI1bW-vJcxQ&oe=69A59119"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdUoboPbxKsQ7kNvwGovnB7&_nc_oc=Adlf8uXKSSmPMsWq-oUUrCA4FpLv1a7jd7DgacrheKa-SJQVT7vep6-8TYAc92-MNjk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftvgFqUAaLKiK_MkS_r2nFEqbIV3tQ-EsME7KkYlHeIrQ&oe=69A57354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b64nn0SVoz8Q7kNvwEcH_vp&_nc_oc=AdnltClBtLyjqsEQw7kLIdtQHXOBSVLzxAbgtvOELVaua9viRyucIzaVnPNu_BIXv1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvFymwM0aFokOSXua79h03Xn9R1cvBYs6rrIuvvFIv0Gg&oe=69A59580"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
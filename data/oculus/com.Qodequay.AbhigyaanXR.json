vwFlvpNB&_nc_oc=AdrjU46tSEdagednA0QYtWJtWyIvCc-We4Ci9D7Ry8k6PPK9BezZcVwjz_ByYTIkJOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJzOt_gJJoIBN0CpfZdmii4WkVSw0ccF7JWbm11RPqiQ&oe=6A4BA0DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrajzAScySYQ7kNvwEzZ7be&_nc_oc=Adrn892XYL6tuhp_QdUkOU-NAykbS5byBB2RL-pOvbqaG2qRLx0s07aIgDRpC76BfSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZOPSe25I0Pifs9fXfOjWfPCx8OQHkDsZNH4iEq4f9oQ&oe=6A4BAB0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJgp-xnDMxAQ7kNvwEDv4SW&_nc_oc=Adp0QlKCIOk9qWcSsyL_LFhMC72wGSkPSlyWCciV2scb9haBKEdujHHKyKoj8J44Jho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4pPNfW8jtObqHAVUFK2pIGY85D2QaPkHY2xVbQeK5wA&oe=6A4BAE19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2spQPHcowOgQ7kNvwHCQ4Zm&_nc_oc=Adq9piaIPmnh3IKFKsJfabw3dhBkVz7kO7aChRSv1ZDxATmP-LiosdYyTSQVUqgV2zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD29h-H7ynHsRYoWUwLuV4zn-RDuCi4VWQbbX0LCCQ1iQ&oe=6A4BC894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tYz8e-LbVsQ7kNvwHpWvm_&_nc_oc=AdpwJfMxgJtQRCpwq_OiPBvEGubZd2iGTklb4f557rGPzcIZ1TzBs6egz3rPpZDNfqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbXH6NAKIxJ73JYqOAnrzEXTOd3rrlTGAyKilLC_jb8Q&oe=6A4BB280"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
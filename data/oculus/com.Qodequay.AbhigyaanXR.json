vwF1wqHY&_nc_oc=AdqraguPjDBdDsY352xxyEWRgENeaeakEEVj-wvVhLu3TS4kkB3aHtdFwHKd39870RQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb6D8AmXu_945Hr3X91RmV7JhskVqw2wINPMCWzosA5g&oe=6A81AE5A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFtYZ4biMwoQ7kNvwGpoyNX&_nc_oc=AdrluFhbytflFxxfS839XrnznI99Z-dFduwWAaUy6aI9Pan8F3jyMMwhfXt6l2rcgf4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3HcrHKgE34jKR5lFpfbw0K4PAZa0RjxxYRAdjTg8sQA&oe=6A81B88D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ4lFa95R9kQ7kNvwHo_Jl3&_nc_oc=Ado-3ueH5RiAHvIRCMTy5Is0zD4C1YHHHit0fksFDfB4TJkEilHOK-Ww2MBLjldIhik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHai7qvg8ZBLEhsXbZNMVhaRqm_KknDrATfu1i90ng0ZA&oe=6A81BB99"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZnQ8JaiixsQ7kNvwHUwha8&_nc_oc=AdpXUSOT6vRjMo-DC_maAMlzxIhnXNLcAyLi0ez906tnqj7-NXvvZpCTXUa7mtfR3hI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBcO6l3wmPqLQQPzq69lCJs0VzsPdm-QB1f-J49DMxZQ&oe=6A819DD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Al6vM79cEYQ7kNvwG-SNrW&_nc_oc=AdqG2XUh5Lw9nN9vrJL2UCpOuwZ7yg0VObQLDnMTbKgV5BSzhGjhZymnE_aU5u_v_cM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdnlF95lx9arnAgeEMLaai-UOqQKfpbcr366EhrCnWGQ&oe=6A81C000"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
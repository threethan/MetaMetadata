&_nc_sid=6e7a0a&_nc_ohc=g3KSEYpkP3UQ7kNvwHQ_za-&_nc_oc=Adpo5xN_2hnbiEdK6q1nGyhybxebA3Rks0jQ3FCRGZNxjOKzwl67RYNpUyRaAD86vm0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54tqSENEAeJLBF-zyS_FXqqXirbXeEMy3Hq6P8RSktQA&oe=6A09B5DA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeM2MLCmDMoQ7kNvwHpy8-q&_nc_oc=AdoqSe8pmHjC7zsNZ__JfRpCV29ZpFkQ3CzKJqJZg8G7vlFWFsekpRjq8Q1ZEZXHrTU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ck3nOiBBGYqPo-z0QM9DKhBqGkhtibrHCdmNCvm6kCQ&oe=6A09C00D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epPgiCkdvoQQ7kNvwEyZqY0&_nc_oc=Adop6WaSc06-LwY97G-07w3vqAeOeRJim9CyasQnmGg_66Rg9jIk-2buliRf-FyfGMM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g-0KsYoTIFeNDnU2-LZGRleM9imwemh8Z1iHTh9zFhQ&oe=6A09C319"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOcVMlMH1GMQ7kNvwFWp7gp&_nc_oc=AdogKkmhnn0g2rXP-4YASaZb8yzgnrJbY1qSvT9pnQ5Q92NDUy4xfL2tYlugGZvl8OQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z3C8N9FZ8DmUxP3UcnPmhlIZDgk6DEa15i4MNv1fDHA&oe=6A09DD94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL16cxL3IpMQ7kNvwFiN20P&_nc_oc=Adrghrzn5fW64qTmvmXWijexqqbMO6YK1V0RT7-GOCUSrtIEzm79Tbj7GFwHNuokZVI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ma0SeDc7csI74_ZBeM-d03dLgoD1-R-dYDneFcQldoA&oe=6A09C780"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9602696576428791"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391904_9557377207608065_3493773536012673474_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faqPlPPccnMQ7kNvwHH7EkW&_nc_oc=AdolWGUoUZIjIoRYIa6w73t0TJ5elBeCWzO7O2-Q-D3soDpFR707yqyEhAYh98WtQ5g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45KCAJ3bjwKv6kx_QIuT-XOQ8hTYGzSpfHECofIRXUcQ&oe=6A09D1C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AbhigyaanXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1740298860, "lastRevision": {"nodes": [{"id": "9296459107052541", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9296459070385878", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "9094636730575837"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Cover Art-01.png", "id": "9557377200941399", "image_type": "APP_IMG_COVER_SQUARE", "ur
vwHXaco3&_nc_oc=AdqmyMq4gGBghanB_C6PC_deBX_zeg59855HTknsjefj4nbC1DKMwre1668KKWG_a6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADtsxjuOtX0PcUFjUeIHLKInsUUh00b225vPYRfwIJEg&oe=6A52385A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kp7Q577Wy4QQ7kNvwGlLbzD&_nc_oc=AdocuahZMGTuVDTuz3-6XjeSAYvLm5DMH4i9qXPLvPUiSzy7wrhPBbQ8cEQCdDr-Cog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKPinv3jKipjLTEUZdW1JezuM4FkqdPYe81jsJ-zLyaQ&oe=6A52428D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cKB5jYVH3IQ7kNvwFbml1T&_nc_oc=Adq92S-F6pfZmcyqVFyVmj0K7hf0nGuiSPa6il6mhgrauv_STblc0qfRkiD0757JNJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE8tV4EvDkIt9F3W7NsaqhFLebyrhcyOzfPLyvIXriDQ&oe=6A524599"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaWtc5ec70EQ7kNvwF9mDp-&_nc_oc=Ado4nQkg6_fjf-BrcYCz-m2NqoNpwlz0GRPowx9fVCe9kMekVGNsl7dTxtfg6HMMgiI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkQCiJ7lTYYNwrbeHDmTHy6ebA7zYQnK3sMNcBzW_cUg&oe=6A526014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osx6Ms85ZFgQ7kNvwEmRlyY&_nc_oc=Ado2DZhNh_0KWhykFZyRjhlWdfMfYInKd1Wq0MpCbPeqbwLZfpCLqH0v1uMzmqtdkFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArmMoh-MI-pjEgzB6EJ1tc09AOiV_ukwRwWUflfMnihA&oe=6A524A00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
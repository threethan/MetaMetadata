vwGNzj4x&_nc_oc=Ado6_7e8AtuTEUPLYErAVRZroQs4SVdMOk5u3HI9M0lgqpIcRalOOUinEMuE5o2-mEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_VHxeVOYn851gl7LLw4tguiI2Z7aYf9vNfSuwX8yAug&oe=6A635BDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quwPmajXKGsQ7kNvwHe4DS-&_nc_oc=Adr2QGdGC5cd7Ysw4A3XvcxdRASmZSoQz4QrvCfKDnv2TP4Q7c0dDHO5ETl_A7NoeUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMsMs_I-vrarb81S0gqvdm6bdKmN4pxvYtoswofPFHMg&oe=6A63660D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nff9VwcgU4gQ7kNvwEn8Yrn&_nc_oc=Adp1gZbWgWCOouu9YcSBO8-v3-blzsp1E8QXKmJTY67VO8LTIJuFREGnaX6U72_Dy4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACZZcwRNs7d-B941fUge6_JSGnSviWuNwKSz3paCXdPQ&oe=6A636919"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eonh2cUdJpIQ7kNvwEi427t&_nc_oc=AdqaHHp-WZWtP3vA68WdBxtk2UXx-AFrsSS8kbsdQSNXV-Q1Dk_0vvaFI8unoqw0HjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAesqu7d0ci54Spe2kVbHstA8uDqCeUcKNRwXiXOB2u2A&oe=6A638394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTxXbmgmtH8Q7kNvwFA3Vu-&_nc_oc=AdpJmQLNfP-75TPXqZCvOXje-b_U1LYwYlDepZzwwYw5pU5jUIUJyH6h_GQ8t0VL_5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm3jSicRCwH1Q7Db6JWp983UIrfCpIhW8tdVg4LbSh-g&oe=6A636D80"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
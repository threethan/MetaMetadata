vwHc_OKr&_nc_oc=AdpghfUuQgnnVhSr7h1CYprQ0HHXGZPyo3HvaXJtuNDRzIZk__EvB9l0TpAhepesD20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRv-lf4LzA78tUC9Elatu47n6lB_95sX1tYi16lUQ8Tg&oe=6A7C685A"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyYhr95Ty04Q7kNvwFIH8rB&_nc_oc=AdogsdK7oXNxivy3z5_QOIoLqIhoMdaq62_I6EoVkCYiIocxeWYU7HPx4A16m7JutNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEwfceHjX6Rlz-y7EvVS4pSVQtoFWwQV464-DShjYPYA&oe=6A7C728D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xriN2yP4ImsQ7kNvwHwIgLx&_nc_oc=Ado2QI61hOgrDFhaOL07mm9TCUBpFRb5ERsVMU0YfyamsptDzFY6LSDq7UT1D5FARPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnQHkPLE2NRgm6AapFTOfttuAFmeg-f8gW17ixscP9DQ&oe=6A7C7599"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP6FZgOI4rAQ7kNvwGg92I5&_nc_oc=Adqm0fkNNDyUW3Rqmqutj7FVB0rHgf1qH8mG52PiktR4KOVjef6ERUGm4Z3bDGw0U44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbPfck03MTk7VlDARtssmn-0t6zfMbC5TV9mAnEeI5cA&oe=6A7C57D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQm-HQUc8r4Q7kNvwG3dKhy&_nc_oc=Adp_7O0AMd-7pnom2ZW0C1Uxoq171huMq9scUABtTU-1j2XzCjRZ43KhtSATrjE4eLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFtTzIm1niTs5jAsHDMgBR1JtyP290ojb_JoWSj7cYJw&oe=6A7C7A00"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
vwE4HFJM&_nc_oc=AdqfxeGYtwNWF4RrYRHt4F9D-2LEvAT9IadJ9MlY4dSXO8N680SM8NmT24ofvvrfGqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iNP1QjAmDSFwHDGStMScH5SqWDD-20YbehRwIJ6U8IA&oe=6A046FDA"}, {"file_name": "Preview Images 3.png", "id": "1424223168547405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974785_1424223171880738_2989614449167361709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cssdXh9fKxsQ7kNvwHx366E&_nc_oc=AdoNsNc07OEDgFm5zwYk3IwniGccGqXOkaX66ZOWkKUNFHUtfgFEPrcV3PHbhCPSunI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-ua2SE-vjN_ljhRWWn6I0qOnGRS4jKWL4c5UWTy61Dw&oe=6A047A0D"}, {"file_name": "Preview Images 4.png", "id": "1494298437905998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1494298441239331_4906093751466127378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOmCaLNROV8Q7kNvwEHQpDz&_nc_oc=Adp5AA7XqJknUrjZkfLmNCtrYArJUWULCQfva8BNTqdshOFZNs3pgsD8YzXtyxu90kQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7smQgTsAaObeNCusxhOIF6cTj0acpqm0EqL5fKRBocpA&oe=6A047D19"}, {"file_name": "Preview Images 5.png", "id": "1279587743289540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003228_1279587746622873_7168024073514292045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uta3WywthcYQ7kNvwENRzng&_nc_oc=AdrgiXyi4c45WwSkGo069uLsuTKx165hcS6pO994VUHbH6hJFh07O6Rt7qe2Yfc6AbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oGfLoMvdpd2CE0xs_hQDhedIl2Lv5zIpdDHCqD4t88Q&oe=6A049794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "888820310070486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_888820316737152_6835150956992202540_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr6pN9O4ukAQ7kNvwFGLooU&_nc_oc=AdqjHNpPohvmHq8TScqMNXC_6HFjlM_Ai47tBh279ThABlFqn4ah74FZLo8vIoO7j8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kMUyY7mshUfBJP68XFgBIk4WUumCGngPtRXRgzDRPSw&oe=6A048180"}, "display_name": "AbhigyaanXR", "keywords": [], "long_description": "Welcome to Abhigyaan, an immersive educational platform that redefines science learning for middle school students. Designed with cutting-edge AR and VR technology, Abhigyaan offers a virtual playground where students can engage with science experiments like never before, making learning fun, safe, and impactful.\n\nIn Abhigyaan, learners can explore core science concepts hands-on, conducting experiments and practicing skills without the limitations of a traditional classroom setup. The app combines the power of augmented and virtual reality to create lifelike 3D simulations, providing students with a captivating environment that deepens understanding through interaction and curiosity-driven play.\n\nKey Features:\n\nImmersive Science Labs: Dive into realistic lab simulations and experiment freely.\nInteractive Learning: Manipulate equipment, measure results, and repeat experiments to learn at your own pace.\nEngaging Content: A playful setup that turns complex concepts into fun and memorable experiences.\nSafe and Accessible: Conduct science experiments anytime, anywhere, with zero risk and complete accessibility.\nWith Abhigyaan, we're committed to shaping the future of education by merging science and technology into a seamless, engaging experience. Whether in the classroom or at home, Abhigyaan empowers students to learn science in a way that's exciting, hands-on, and deeply effective.", "short_description": "Abhigyaan is a new age educational AR/VR based app, that allows middle school learners to perform and practice science experiments in a playful setup. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.qodequay.com/abhigyaan-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Qodequay Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "https://www.qodequay.com/", "category": null, "comfort_rat
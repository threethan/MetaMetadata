/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0IrknONd2IQ7kNvwFh5dbv&_nc_oc=Adp3SuziSwT_117HuKWhdH2t4sOwRyBWt4lNPaBRU26iuPzjotgOh-gmq9Pkf3liuQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KFSvl_RYWaZtjKisKA9bBTWmfA2hW69pPZ5tiNYTu4A&oe=6A2193CA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sarq9hxXVXIQ7kNvwFZQQYe&_nc_oc=AdqkDaPLe4L7sgbwudrZsHgByvOM5XlIE5s02HtQWWwm0tx3iJTm8w4fb3NkBPmafOI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xYHVYzrW1zICOvxkf_UoaYTdWS8VBpvWjmDmRdnSC7w&oe=6A21A4B4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fiU5majLGYQ7kNvwFufHRx&_nc_oc=AdpuHj_iQgvPKFjKbpGOUzp3blqZdJn2Zp_yzAQQIh00JGlOznCEFlyIq_Iz3YZNXKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FA4_e78T67YC05fnd-ZAQYHfsB3spLdZpzy6AiyIl9A&oe=6A2177AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAvapAn917IQ7kNvwF4jyKa&_nc_oc=Ado56Y7AG_MDkXSzAVspwPmCBTP45PpC-k9baNUQuthpbmHSptMSKH5CYP0z94ys3YM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X-xzhGjeytE2AKZBhnIE20580e674jBf9VNgUIXMR1w&oe=6A219947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs_OSJxIIa4Q7kNvwG7TRyu&_nc_oc=Adq25a9HxzD1AgNl3SaVyJdvBtErNRi-djeblraewqzY4lmou0PaBMEtfmq96oKnqTY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X_FQZ2sOYvxN7Wm6pkv_pJv3ZWEtByqhILztm2TyC2A&oe=6A219858"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
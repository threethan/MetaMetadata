wFvvTv2&_nc_oc=AdrqWSJndZeqOHCXGyQFaBV40PFcad-j8MTNgAyFtMql8lXhhvFeG2fLQnc-P1RKAVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVSHeG53DZN02vYpWVtNJSO_2Exm6CUftgHbcOoCdR9A&oe=6AF483CA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3GdC8KAflMQ7kNvwG-KOft&_nc_oc=Adpk2AXEUo-y_WO0YVHR2qWET0SsgEz6o-b1RGaAe3l35rIVdCSnPgvj81c9lcsUwnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwVA7KinUlGCP8N1ubD9Wq6gssRmPmTbsHLgOwONrarQ&oe=6AF494B4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9tLEY2eyn4Q7kNvwGObaOd&_nc_oc=AdrNJhbEyvzpw1YxBS0advf50JyLAy3kGQGEJwiNBkuPChKcGUFWU00eNUYU8G5Ta-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkfdStamBndgHcWxBk2NwtvJXgEbspMDdUX2cbPNklJQ&oe=6AF49FEA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0bxJrE9yhwQ7kNvwE_UMRO&_nc_oc=AdoT39dnWJjthAN8d4m456n_6cHUvYJfvsO8FdLJFKYe6tjEcjc6bL1QhujL07Mqy74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVhjKkxS2_BKOP2XOoWpL1a82BJuWJYE5ZYcPK4NB6tQ&oe=6AF48947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc510s8gx7MQ7kNvwG7OfuN&_nc_oc=Adp3-6t1zLv5bSJP0BStkEbv7FfISHurZx8psQpzPnHahYlFSnXxUUbxzGkpVXwj7N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1VVHB24DmtIfQ0qZbjeHsbiDak18ImF6AWfQjwTkRJg&oe=6AF48858"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
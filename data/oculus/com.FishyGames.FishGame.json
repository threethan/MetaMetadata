wEHv1gh&_nc_oc=AdrCDM2I8PmqWw1iE3cTVJZxhT4poKT8g0jzhmqDA3OT_IRGKoSCozObhg8syfB9epg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8n1lUuAUHWEpn6zsNU1wVQ5_MGcxdnbQQcqHAhpGXVg&oe=6ADF6BCA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J14GSUZkFnwQ7kNvwHx7fcV&_nc_oc=Adrxk4bDrEfMkkAvrH9V6iO-lVdz8GEgN5i8qKC7szFjrGVfu6jL_Ab5FfjJYV9r4SQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRXyLbxv63wtz1-xntf0xvUu9vZfj8UH6c3yKGkcxbxg&oe=6ADF4474"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-sNFbljPqQQ7kNvwHzxBoO&_nc_oc=AdrZ9Fh63Nh8QNYwkSPzsBMQu3sEcmNixLTKQBp9lTqNDmJzksaxrmXYCBEWV2vDF3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTQLBeAV6WvytPH-n5Jp-eF-t-dj02Q4QyQ39wHQHnTg&oe=6ADF4FAA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNPqr4J8FUoQ7kNvwFqroe5&_nc_oc=AdocZWb5hob6xPRj0bJDTd8nqeyBjNlFEbwCLf7TsFgHDpVSnqKf5IWHbRtzrMbu_kE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNusojgo-TSBT1_e02otdIwHOO8WxnzjoOUtWGeKjitvQ&oe=6ADF7147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocyNQDo_BKAQ7kNvwEH4hjc&_nc_oc=AdrJylTKx4Z6CrG9NgrcrTWFb0yvblLwCS657UNSmH_a7iw0mA_KED3eXk6eI9mcA78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOTUVFUSwtDTGqObNlyPczdyRuZsPsBudniC8_U8iGzg&oe=6ADF7058"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
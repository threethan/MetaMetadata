/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xuc3KcvBwkQ7kNvwHjcfcS&_nc_oc=Adq5KEkgP3aKvn-j5VHDj05JsCAZaP3ptON6d1mOYgwCKR4KvPfKO_gcCNQMF-2jDTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NqaufEEZ4f8i8D3yxwHRwh_dk2_J-qpYkvSkC4TC4tw&oe=69DA2A8A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHKTYRsBV-QQ7kNvwGt60mL&_nc_oc=AdpSZZslY-lBsZp2Y0lXqSjNiUMjkWbjcMl9W4ShOyEbO8COcOQCvgGIE22Upt6W8gg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qFpDHWqzl4MOeFAAqTXGJEqL8lqtBStxKG4Xj3Y7VrA&oe=69DA3B74"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz6_jpB_OPwQ7kNvwFLcZKl&_nc_oc=AdoYvThsOxGh72M3z3djVaXNgdWOQKJPnd4UFjfapGsPWK6I64Y9FWq4nA_w-W5X6yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sdT7TXUPp2vZmt78JgfO6zUzGl9WIwq9QC-N6n3fqIg&oe=69DA46AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm13nEofbyEQ7kNvwE8GCNs&_nc_oc=AdpsAu2k6IIU6WfByJV29bgMoi5m2SnUu5MXeiiWWj5Z79tsfv3ejzcDeFVHmsMascc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LhVcDzxt-1h5Hs1viuiGoZl9D2fYwAeDmkKApGilGFQ&oe=69DA3007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNF4fKlxT4wQ7kNvwG9pIAU&_nc_oc=AdoiL4KnGNhZWL8oqY7SSON_yp8cSEFjVxYUaQMht5U1sroahehBx-3r-yqJUmw9_mM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SrzDN-CNirrazZORrI2PWcUDrx8MnnL8DrRAfUzUTeg&oe=69DA2F18"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
wHXtgmD&_nc_oc=AdqKLrcBYxThYmFeJme4n4cJNjpnu6ZnumBmMhXkHaTjv7AJyWkrzDze8LkuDviolLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiOvykJfKEiry2ssPudTzsYwjnuKPdVGgGgTkWJy4e2w&oe=6AE4B1CA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Al4_R7GC8Q7kNvwFwzjia&_nc_oc=AdqdPHYOv7ItO8IAcE8UksWau31KaU9mnrvcBqcBsFe_C9Ccu5-vP8go-cWPLGKgp5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWK--JxRkKp0A4jBjVAeaacaccQZHRZohOnK9TaH-rbQ&oe=6AE4C2B4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7f1oK7ft5wQ7kNvwGXU-KY&_nc_oc=Adqvp-SJsfz2S1juRgisWgGpnFWMwrMJvXNeFKJnD7xF9U7ecIFajXdjlLDvirXbVes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL5txARjahmoJ1sass43P9guRQrLw7tOsadB1eJcTjlA&oe=6AE495AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imNX7uN0enwQ7kNvwGV7w0U&_nc_oc=AdrUaM9k8ExpFSVBahiWMFJLnfWC5S7iXCw9-jj3MW0P9MzQresZhFAoAxdvnAb6mcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAvVo598_FQisbDPmTGr3zRaxQoVMh3TEvplRNiO7-sA&oe=6AE4B747"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdX1aMdqVOEQ7kNvwH5LfYf&_nc_oc=AdpmSNOW5ei6GCXCuXjXvJsapq7CZrYt9VyaOxSz7kcU3TO8-TckIXoM41jq2X7Ch5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIqeK9hThPponUBAvfRnfONBvC0GWywFkLWqR7SnLHCQ&oe=6AE4B658"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
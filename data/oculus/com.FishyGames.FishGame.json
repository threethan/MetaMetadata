/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4GgnC4QGMAQ7kNvwEyVwQq&_nc_oc=AdobebQwXATnwofZWN-qWKBVKlJGutuy33X5nfVubNWKs6CZJDJa7DmfiygzMnM1cvA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n_AMTfvXS5BJiuDF_ohM7Wn4AkkdKJk-JUaB-oNbFnA&oe=69E7598A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwvbrP8MRB0Q7kNvwH-6PWz&_nc_oc=AdonRfY9Y7YMV-yu_1HUyN4YCvgxruSpgoLc_n46M8RKF7DGc08nrXQ_-C906lxE6i0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rjPgWIDXrKtz6ucpDNaut5fqw18lhTupLBxxbHyBM9w&oe=69E76A74"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUyw6DnLoTUQ7kNvwH5Hu4m&_nc_oc=AdpjVSpjR403VrYtF2jsNIIGfmm9fZx7ywjfVH85fFw3qlg1OquXNvp3I7qlnzebeGo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DEG4n3jO1F3KzYZ1VzSO0v98VQQwiZGuRtP7I_Q4QLQ&oe=69E775AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8vd0kRsKN0Q7kNvwGDDQJc&_nc_oc=AdrL-uYvT_78kBr9Ca1NLoBxoSbfsn_iu4jLutiOspY4bRun7717xiL_nwfj_Z5jehA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qm5Vroh6ZWv7JdQB9Ht_uQE9r9kLVrtBB68wYLBGLcg&oe=69E75F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckpVqw4Ie7sQ7kNvwEaoWRe&_nc_oc=AdoZqwgpJgQGV76JJwMIOk_RlNw9VVLpmTuttbDf4e20l62C2Az4zqeGpZNwv2wWtNE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kZd3cjRrlHSaBwMcFS-QoX3SQ2ILRj5s7Qm3odIPMkw&oe=69E75E18"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
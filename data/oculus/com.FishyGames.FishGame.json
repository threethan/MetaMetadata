_ohc=6YGIzcjQgUUQ7kNvwE7jSqb&_nc_oc=AdkjFtsv93ymV8Tvj44jHE-7UMpuXahKpcC9lQX03Md27GRGlE68WB0b5GWS54G9R-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4oYSURCZv3Sk5_ROfGcM9Pa7zDsa9hUhryTnZZjfWQA&oe=69A6C00A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUHn0x7KYrcQ7kNvwFxympn&_nc_oc=Adn946u13hS7lxfZkAcCLRzd_VzWfS7b6xuuTxpbGZPOSXilcmyOKipO7CgfwhDXcA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstHYZxmuZJ1TJFGIAZXrIG0vwN709WbiUrrxH59gsyoQ&oe=69A6D0F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIWv_r0aud0Q7kNvwFnl9dc&_nc_oc=AdkR2wcErzfgnZM8einFKdQCWNOzI8iC6EpGtu7zF50ePREqCAsvEMGH-wg0Uq-mSYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afty7nUZcfSBtXPKnuPABKdKyQtktg6FKfS6B9p3UFVneg&oe=69A6DC2A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qknfvOZa7Q4Q7kNvwH4Y_gq&_nc_oc=AdmiOgMmWVuczWY6EOveHAEpMgio7vsP36heQft5ckalC2SgN4n5pldtaPGPcHvGEoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuR0mXl0BXIRkpjSzhAYopBkItPYyze81zufrHaBm37Yg&oe=69A6C587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrRdfjDwLSEQ7kNvwEl-gUX&_nc_oc=AdkMdMPcsuNob_m8LzRn4hPVF-UVrn1_PgvtOwHAjqQhjMbOPIpQJVLcsU24C2E78s4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVRyddzrBndzDms6s5TPRKHuDi5cg_c77xxu5TKIxM_w&oe=69A6C498"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
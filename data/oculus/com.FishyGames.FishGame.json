/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4l8JvXiy7sQ7kNvwEDmeO0&_nc_oc=AdquvCgITSlfMlLTpDXeuyLc366EL6PNizFstuWhR0noH-1HV0_lHK1pWI_d3iHeqTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOq4_uF_1QJI-iEunuaRh-Vka5EGVDr9QzeE3wN00QDg&oe=6A7350CA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbVhrB66miIQ7kNvwEMM5bp&_nc_oc=AdoKxC4cA7JUx2VLQSOLIG5WuI0OtH8Ajmso3p50S6R8NIR51O0UFDeprFpRZNmw728&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs751iW_SlMkQsN5E9WbNDCssCu0AFuIqKAXPIygBPJg&oe=6A732974"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUE-eiK385IQ7kNvwGMNhwc&_nc_oc=AdrOrxkyghFBWlvTkQfDlor-qDY4-y5Q7l3B1Gd8lKx-9FwoxR_LlPczYtFmwUa0unM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGppphP__HG3rNBvlM-sYlZW9sDaDArfGVSOY0fNwa7WQ&oe=6A7334AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H2_DotGQQEQ7kNvwE4s9El&_nc_oc=AdpMMf87lyPv43svPQW6bOUy8gZpWzl7OR-FUO5f2_EbILvpvcmx8rKgl8tbizWNpTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrTUgdpYISAROYlyYancd4pq_V1jQlZAh1x28LHdLpHg&oe=6A731E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3VvYKwdcskQ7kNvwEfJo5u&_nc_oc=AdoBp-oYjRfBSELIdC6-kCw8t_L3ZAhIX2-RUbW0ZyHEg2GDEblZJ3eQuZzL5poo1f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmOSzzTSddjcEuCWZhONWTFMZdtDGwrrxgtFZ2j2JQaA&oe=6A735558"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
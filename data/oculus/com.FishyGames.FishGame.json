wHMHiV0&_nc_oc=AdpDWUozkFfOTqkmvj_dDuBpoGkrsTZ7pfNUsIDjmqvdcA5lcECehlxQdW0QW3rjW9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHy2wK4lyI_y9mGPQdOHApVnfr22_HbDsO1-zDPBoi4Q&oe=6AE3604A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Al4_R7GC8Q7kNvwGiKpv_&_nc_oc=AdptHnhi95dYxxkQcIm15Ay1DQ6kyT4xrFl-EXh6vKdDt_xK2dwG4L3SVeJh0lCJ5XQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-zJQ22eYsMeF0i4X09uIPYl7d6uxTEPadjKBc1MlDTQ&oe=6AE338F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7f1oK7ft5wQ7kNvwHGLjl4&_nc_oc=AdqLrWenv0TFBG7r5S7jDtnd1nrBUx8AAul8tISbUq57mlZIuFIWrnfeDFLZj-fNTbc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBFt_AcwYAnGOaypgribqbBJzcnUo9ID-F2Z9vWRHPXg&oe=6AE3442A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imNX7uN0enwQ7kNvwFXIr-_&_nc_oc=AdqxEDg5UFDzBUb10YiqGQFUaAfFdljSpJuP4P2vdCXLzFTrRENFVeX1nog01tp584Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Y6qDa2eewxbiy3idjbrl0eUDXxD4ionCWsIEKXIYMQ&oe=6AE365C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdX1aMdqVOEQ7kNvwH_Ogza&_nc_oc=AdrGqeAbap1uASMoz1z8LAqFg59vaw8UIrlyaZYTqy0zd4DyHNbfzHBj5kR5vMIDKnI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt5WeoNmnoTRzd39eCBbeIi7vcw6q7Q0pf4YGJoxwJ4A&oe=6AE364D8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
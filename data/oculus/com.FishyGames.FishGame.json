/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Cq19H1OWZAQ7kNvwFj0pwp&_nc_oc=AdoiO4dQw3Grvl6qfkYHgJm2R4jelY9-v34202s0k833lHtbe-jtV8Zo16x_b_e8qG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tjoX6zV81cTgdK5XMUcdKqGX54-sQqBXbQNnmEkqEOw&oe=6A009E4A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8HqMWm_95MQ7kNvwEsmqQq&_nc_oc=Adr_-9UKqLZN25e5UDmpGbG6Ne1VY2-SE8rWGk9BzOKuj7-feccizfCAmPYQeyBx7Fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yVEI-SATgemF71qXRaumkRPmgqJ0R4vL4zB0AynZD4Q&oe=6A0076F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2MxyN80X4gQ7kNvwENSux_&_nc_oc=AdrWnnd_ZCTxD4RZhso5XwPja96on3hmQpXfhs0RnnQ6uMBe3P3WbTL8gC3PWOi4jFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iAY25Zk4dlwyvZkT_xeUF9WXXou-s_QLl-eb8qEPQnw&oe=6A00822A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SQ0iY0Q5dcQ7kNvwGq2iPE&_nc_oc=AdrOpxC0VJPlj0tuDK8c-zoK1Uy3buao4fk57joMKx3xmMunnkZYftPgk2Ies170r6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LPw7vXihakTSurPbgS_QjqjU-tyOIpEB684Jwec63kQ&oe=6A00A3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3TFqJ3c1w8Q7kNvwHTqjKF&_nc_oc=Adp2e-lLcld1ke-01Po2Fh6oC6A8jdsm1J1fAzOWWSJ1Qrq_q1W1Y3SshA_xNeM1TR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6onhacA_ed4UvvZ3BmjdcbiecvbDBd5FvqjVE5y-Uc3A&oe=6A00A2D8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
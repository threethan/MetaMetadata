/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztsogTr3MkgQ7kNvwEsy20O&_nc_oc=AdrMVBmTt0x-u0zl3b5dm-evwNGxKvUw2LVnVjVPsVJZOZ1WuxXcE9OjKpHQ-iXhWuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7fDg8yR_QH_wj_R8x5uZVSitdjowHFYCBHV9ZreZ-eg&oe=6A89820A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1VNjVy1Q38Q7kNvwG-yZLV&_nc_oc=AdqvNPgS4j8s1FPW1aC9d9wAVRtljlv3sjvEVJtpyrQUOxKObd24jiuHV2efDCjj3a0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAwtFF5Sc5Suhd-cDmhAsHIQdWCWc0alxsuoC6iWZqDg&oe=6A8992F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-nXLbbMuZwQ7kNvwHWUtus&_nc_oc=Adp6oEcsZlr1n4WVkqAQBUW_hdfcAVvEakmh6tezxdY8XQJr3ealZ0gxGzwCR2hFpaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjZozYjVsciUOF67DMJs2KoKEst7U2hNo9N2o9R7Thnw&oe=6A899E2A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtmd05x6O50Q7kNvwFyH6tb&_nc_oc=AdrhI6VQh_xTklKQvfqyBPa6eZy28UhGbdM4DgEwwI_mcJektl8DrlUGtzgMRTb8inE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEITAQGO0xlscJBLuEHkPMTLL0kcq9hdkdgIGcmgqJ2XQ&oe=6A898787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIdiACNk2QcQ7kNvwHlWaSV&_nc_oc=AdoxAv1bktz1EGxB2aCDTKTmUvCVySVSSEEgVMHlIOE3zFZxX1wsS9OAK3vW9mO2vvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_jIuKfHzIWrVpNuhNr4XaA4OxMqOCPJ7huDR760XgHQ&oe=6A898698"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
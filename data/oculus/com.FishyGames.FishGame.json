/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuRwgLQO8vMQ7kNvwFRVtja&_nc_oc=Adpt26sTi6YIr5-6w_8DE2ipsCvZuhLmj5J6aLC3-n_NAXaZkwI7PEs0IVrBl1RuDfM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-RKgFdYLYR5h5m5K8zxtQD_Db9XCBx1TdMbe-yj46Ug&oe=69E24BCA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7tX8a-kp24Q7kNvwGT7Tb9&_nc_oc=AdqAAPYC-fo8jSarFttNxPpcAayKs7Luag7es5x9gbibLB4IeThvLDtbKx1luaGgVeA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hgvnbmSnTMT41Jfjm45288NiD8D5EjtMlmhkEH6Sk8g&oe=69E22474"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKGCcZbnmScQ7kNvwGqwcgS&_nc_oc=Adr0_x9hqPYZbvw0PTEkxk4GL3n_RRZoUTa1GF86EG-zCDzc5cjWIVerABoXcr7cW_E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-43FoboPa137d0DTyLqQYVgGZD3Dj8I_isvZeC91L1w&oe=69E22FAA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlrpEjmQ0mQQ7kNvwGyl24P&_nc_oc=AdqOlpobe-CNW61SuIUhTUoMgw_Z8o_eq3qKmWAKO8uCAIqvx02b85aa6l0aciL_Ba4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18QJx51pwPlR2RvFZF-q428IoeJLPXXphBKoiY4AjI0w&oe=69E25147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0ld59HxLKoQ7kNvwEeIGgR&_nc_oc=AdomveUcQ3JuTfS4zrU9aqjfGTgWxHqaqhcspXfSL4Y1owWexpOLS40gxf6lODbDf7o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06-BkTmXuJ6VMfbNLaOO-1PGIOeTMloSlSDBjxrV53-A&oe=69E25058"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
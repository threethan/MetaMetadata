wGPIiUW&_nc_oc=AdqCJ72DVbRWoHs5D6YF-rUCuawl1vUMAeET890jDmqQdKQRDAPbJK0Oy7p5J2pG--E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMND-BlUpkC271__5tr98g-o74X6PTjJ9Kf-Jge30zbyA&oe=6AD0EB4A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU9gzFsTveYQ7kNvwFgsYKq&_nc_oc=Adqw1dCcykSSqol2a7hg49QRM7wH1SJVkBkl0YhFjKDAW44jfKt8QmqctCxvYIWQ9CU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhNUgpLl5UCHQ0vA4OhCHHguFK9HtfAxvjkAiReIGOoA&oe=6AD0FC34"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsWcDG9_FiMQ7kNvwF_BNrE&_nc_oc=AdqNs6u0kHxkCfO7PjGwJluL9BiO6FGq9_Pa7UOawq36kAI_NKztYZecm01TGzJ28g8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEQb_-WtT5dE9xKmY_DB1KR4NMeJ4OIF5O62hTkyKxqQ&oe=6AD0CF2A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4kEHqdCngUQ7kNvwEIKOGt&_nc_oc=AdrQw2VQiMYsPUK0XUFK0MgphJ-_YKQtR7A-zVEot1ALk_imO_DaULqpn2EA4yE3p1g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmEcRSxyEq2Hlt1TOWJagNq67nTqiyZouVhpBfbPun3Q&oe=6AD0F0C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTZmN3-vBr4Q7kNvwGjc7Q8&_nc_oc=Adov0DLMYeaZb-mrvWNplGs2SYwpPkD5UcYa0LGMFtD5SiOcJPzbermNDqvhiZbNs4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTWMdes4w6BBIYqISjz7Em9Yo5XF9aqzeoQg3pTgMwkw&oe=6AD0EFD8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
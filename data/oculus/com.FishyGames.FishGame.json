wGtCEVu&_nc_oc=Adqz0BpJkG9m2hHbc9ufeC9g68aILsO5DzC4BqMGlnBWf1AbgnUqiTMHJYo2-F0FJps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4vE_DRvkfQnEYDA8i7qZowe4DRoHh9ku0vNTKezKGaA&oe=6AA80CCA"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btBpcHISOMAQ7kNvwG9vI7c&_nc_oc=AdoRl-dpPGF0xW9a4oLctvnCrDf5EKYGWnP9gNSco1Wi3H7oAnNZStOU8O6JAq6Y0fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRumRe4eWDFDo3j2dW7ckqaQ8PEO10xF1E3T9CB_IpkQ&oe=6AA7E574"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeOx4aW_fBAQ7kNvwFULEUl&_nc_oc=AdoQGe26mgi8tBCQjUzrOCEtMZH6vok1M7YJycNZa0BHv9Gr06qiDF4OPulBMW6hLmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEW4LczWCPzm1tk2lY2oM9FC51ZiMK0dBvCxR76Wcimg&oe=6AA7F0AA"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xJk84aRq5UQ7kNvwFCQaq5&_nc_oc=Adq8ZzEI16-JXz9Cxa0x5c-UVxRJQFTTutSyZEsqPkzt6NGqnr-o1h3atwTIFHTt83c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcJ4ucTtiFEskVJi2OcLsl3djBCwWSUpUnTyfSy6IorA&oe=6AA81247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKFGqZ_bP5AQ7kNvwGElB7u&_nc_oc=Adr3NcIsAYB5oDg6JeblsHrLg2Ra9lgwA8sducSs0FnuZfw7u-G0DDu_Fom6GC1tAEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpVQ7FcgUZ7ksa5sb5x6ZiRt5BNiqRPjVnWLcN01utGg&oe=6AA81158"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
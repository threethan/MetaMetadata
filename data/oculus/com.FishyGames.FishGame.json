8cQ7kNvwGTBx9h&_nc_oc=Adqlg8dnuDdIfocNu0sCWEqfdKXSJEW_WB-Nef7cnW7-BNO-jMQ4xrpAGyEJo61tID8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTYKzDgXgE-gQyCoWfobRL_tF2AcDSU9isRBMZz1wCtQ&oe=6AA4184A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUvZgOZ_j-sQ7kNvwHxGG02&_nc_oc=AdpZi7Ha_nSRsiNtij0WyXPb2kIEzp9kEXq7mGIXlD1pNgQjxABzpnClKmMpARjzcTA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIayTH2bBfyaxBKQAWl4J40L7wZB8BPrGmRyT7lY5P6ZQ&oe=6AA3F0F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdCaBoVs1VcQ7kNvwHugUQ9&_nc_oc=Adq9XSwXya4XpeFlEH9s_LiGFcO9we3phCVSO78IGgNfKknm4qx2SI9Z32QW6aiDEbE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlhCQ6ZCRTVyEXy1sU602HwOHyFuHolNT_oC40uAbc_A&oe=6AA3FC2A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiO6KPIXjggQ7kNvwGfg6hb&_nc_oc=Adpdb-XzSAE0lv7Bq9kNaV0faTdOlt6aX07_DWFou3fHdxxz98aaM3Bsu9tUeGZgLeg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzESkdmU4x0RMHctwFzKCI_Oxwb8T5ahobdKCNzrtO5A&oe=6AA41DC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0RmudCXzEMQ7kNvwEoMsOE&_nc_oc=Adqazdqi9yMbDxtSAl0UlyavO6Srno9Ezg3_SlVCSRjn2OrfitV7rCUgdATTR5b9i8w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7RB-lDjyGXWR_0vStqAlzAhd7Z1jSGS5nrig1AUrYmw&oe=6AA41CD8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_mess
/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRMogNAPZ9QQ7kNvwEH41JD&_nc_oc=AdooskAvTK0IsdZs9hwa4oLaKkq2ncDrzUMmblAk_n2spJDzlcsleEsQI5LiJ8XRtNM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GmHuUkjaSrH5yEXsxi4CCO6eAM_4k4gIe0YSe367gdg&oe=6A452C4A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKWBrpl_2rYQ7kNvwELRy9F&_nc_oc=Ado1Zog75Ty2zBjyLGwPMRS1cpk9EOYhoJzPSS19kUYqqmhlW0CBn9jha7Z2_WGMJfc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nY0ulKbaQFWWNWaNEf8Nj6Z8NnzrZjfiU0seKssGwGg&oe=6A4504F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9yECS6XWwkQ7kNvwF_48E0&_nc_oc=AdrnsJJi728e95MaADbow_iRoh1lnmfI3BtNO06zf9DX-s6carfv08Zc4z3X_JsZUX8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6ApVJGcFrXvpDmNxR7XbFuCLH_ft6H-eXrLp2U8_qfg&oe=6A45102A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rxNMEM_TZIQ7kNvwHhOJF2&_nc_oc=AdplqF7eNaowyi_92jRxOlpgUrgFf95zHDdVuBiA8qixJ90zwjVmQBQNz0klAHFwyws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e8HO35zdFJ1Bou_2TGLzAWmtmY385tlGLi6OH9XCXSg&oe=6A4531C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zF5_UWbmeQQ7kNvwElbvZ5&_nc_oc=AdpmEXDLTRYn5khlaCE4WKOQ4VOIOLe30MPH8EtIjF1ljDMdewtXycWb7MDWmsy7VkU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LKVotKoPXFWIxAbBPlhXSGn6mdl5cHlbyiP1gkLHB_Q&oe=6A4530D8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
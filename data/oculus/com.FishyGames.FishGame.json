wGUEzrt&_nc_oc=AdqNShE12_qOo2gZvTepN5Pg2GhwOYKS9HqnIJTfQVFqP2nz9FF1NfTdiP04aEes4lM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJXVuxKUtOC-txF3YQ7yQuEkU4BeW9bowTJ-_QdN5xKQ&oe=6A9C2F4A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOS-dSgryDoQ7kNvwE3gywl&_nc_oc=AdpDNEFQlkkkNuAGprYxnWUB0w8rG6AmxOvI_x-g_zZ_IM5fp-oZJhxHrUMZG3iXbAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMYaUa1lr_UDUimPbnzN1tPHAMw9X1ewGcJHwJHDcSXA&oe=6A9C4034"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAsJlWf-9rwQ7kNvwHi9lNs&_nc_oc=AdpApWfV1xxQkrNw9KcqLchJZn1FtCoHypdDyPXIn_uXVeENRdFY6yeBe2AvWmVy7kA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL-bdR3ZxLnNz154XxtFfSeKr7vm3gGyQXVyA17sdlFQ&oe=6A9C132A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx0NhU67gMUQ7kNvwFuD0q_&_nc_oc=AdrAbVWrpRaq9lteNaG6bd93DLfefoKinn6h6OvKuV2IF9RD_mUzE6aoylCyGoZ-iQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSnakyIMy0I80P0T6Bxxkfb8pPwdQFYfRHCN4SnT85xQ&oe=6A9C34C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df7yrP89IvIQ7kNvwGeCmZ2&_nc_oc=AdokHZbaFYM2s7c5L-10c0WuxmV0Lqn4-dUrD8nZUN12wR6XbTvpPar-T9LzcILoFIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKok8oHGve2gia7ysCRG1YaVnGYEEq8RGo_yCa8eYyulQ&oe=6A9C33D8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1252701098962077"}, "review_messages": [
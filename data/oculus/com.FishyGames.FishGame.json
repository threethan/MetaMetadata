/v/t64.5771-25/39031532_486975046253869_2232763401744419541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKz7d02BHFYQ7kNvwErf454&_nc_oc=Adog5k7Px2fFGbbydN0YdjT-9id42D10rDY6Powmt0umncU5tDCjgf6BZIbxAYeAVnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_CdGf0rBh3I3uCEdKbXyjn6sJ4NVI4B4i8VekwrJiBQ&oe=6A2D714A"}, {"file_name": "Fishy3Moon.png", "id": "1622231904792727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_1622231908126060_3573464120795560234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lEbEcCJQsEQ7kNvwFkqAV4&_nc_oc=Adp6mbgL4SMrOe40N7M5oRAv1bv4s8UQFAQslpYOAWll0LQcA4fW604TLPigf1hHmx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85xBqoNYwPRsPniGYVLDFx4hM1N4WVc780XiimyUfICg&oe=6A2D49F4"}, {"file_name": "Fishy4Hangout.png", "id": "3086841318236113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031605_3086841321569446_496464436233593359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xujYu6UJ-PUQ7kNvwFbM6AY&_nc_oc=AdrTaBrON2028cbgGh4rggexSMgxUvbEiyGr0VgBQ0tkgF5jh1K-B8iq-da8wSX3bQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qT5RbLPkHv1bmvCCcbRk0NvDlGVrF4yQj0oe3PZZSKQ&oe=6A2D552A"}, {"file_name": "Fishy5Carpet.png", "id": "952188878827457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_952188882160790_1451990759880653684_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgpqobb4cfgQ7kNvwGbUzEA&_nc_oc=Adp4FpFDlK5mTIxWWbwTGmyFJAEV2dATbWmiWdxF9roEWRSB0aJgVuZPDw4eNC0h0Mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oQQHplkIrLEJPlQHxzM7tbzHu3iO-tVyDco2LyVIQkw&oe=6A2D76C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FishGameLogo.png", "id": "1513283632457562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_1513283639124228_8382515463982883350_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCwhGMFoUlUQ7kNvwG-rHV5&_nc_oc=AdrlVmu39d-TWe0ULEVtwgF8v2WQvMaeagkWknPXdL6TKA8I3W3rIX80g_LJ5GdRHxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LZlRjsQDRvqswTzoN3_25OwlWDP721mmU_OUhNhKsmQ&oe=6A2D75D8"}, "display_name": "Fish Game", "keywords": [], "long_description": "Become fish with friends!\n\nSwim around - \nFish Game uses it's own unique hand based locomotion to make the fishy experience on top.\n\nPlay mini games - \nThere are a few different mini games to play on the different maps, a few honourable mentions are the two originals Swords and Boats.\nIn Swords you have 3 lives, you must hit the other fish until you're the last one standing.\nIn Boats angry fishermen are trying to catch you with their evil fishing net!\n\nChat with friends - \nJoin public rooms and chat with new fish, maybe you'll even find a new friend!\nIf you aren't in the mood to talk with new fish, you can always make a private room and send the code to your friends.\n\nThere's a lot more to do - \nYou can play the Sandbox mode where you can make your own creations.\nYou can customise yourself by changing your name, colour and maybe even put on a nice hat to finish off your look.", "short_description": "Become the fish you've always dreamt of being!"}]}, "developer_name": "fchb1239", "developer_privacy_policy_url": "https://fishgamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Voxoun Games", "support_website_url": null, "website_url": "https://fishgamevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
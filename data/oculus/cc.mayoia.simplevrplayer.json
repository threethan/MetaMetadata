i&_nc_oc=AdrSLoUMwIdRKUGoAPZJSMRbZ4EdWI08whzvS92gtGQFXceU_8afns7JPmpST5kFIJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRnDkZNigbfG19uDOAnXq4WyJCxxgt_20hnPLgrG7SLg&oe=6B0C832E"}, {"file_name": "03_video_formats.png", "id": "1463828768519685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_1463828771853018_6611593793145310753_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsgSAT1lYBUQ7kNvwHAFQme&_nc_oc=AdrwEazZrxEUxfLycjor46DZ951h2Gw3R49Iy1_8F4Oo6ZPvYoBP_7jsgjYc75x3yZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAlHoO2Ru1odyEIC2IT3RjH8dMMV7z1E7VcFIcjQxPkw&oe=6B0C8291"}, {"file_name": "01_file_browser.png", "id": "2219040225663857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585799753_2219040228997190_1582885710689484156_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcrO14rw1_wQ7kNvwGDXPc3&_nc_oc=AdqG0ABKtHTxjGtRoYZSaKzaEmHSrBPHBP1_NmOSBnNA_is83_K31wtZAYzZ9EL2bAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN8REn95LTF3W-0yfr_1kF-WpRtHcnEa-1XhtP2_XUCQ&oe=6B0C728E"}, {"file_name": "04_environment_color.png", "id": "3602575936594299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_3602575943260965_763231902966117258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfjAuCnhvScQ7kNvwFdPDSP&_nc_oc=AdpmyFk4AbMHfuLwmWwfMTIDbhyuTfiJBE1WMgJbLUBM6KVm4poQzII3fw1qju5xKPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzKTEy2ZzK10cpaf9684tWtxV-4uPdNOvCeGAoH4Q1IQ&oe=6B0C616E"}, {"file_name": "08_premium.png", "id": "2189026592009656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_2189026595342989_5620889470042024001_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zFt9D2Z6lAQ7kNvwExNnAp&_nc_oc=AdqYjPZPFOZTAfHu_6bCcEwCFzjR5tjAgWhmJdMc5aI2gqMU_-MLNS0SLroiKC3wII8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrXFYyQQaBia4-jIpUBMPse5CtxhzXhDSGUBb2ZJo9FQ&oe=6B0C6B69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SVR Player", "keywords": ["video", "player", "360", "180", "cinema"], "long_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset.\n\nA simple, fast, and powerful video player for Meta Quest. Open a file and watch: no accounts, no ads, free to use.\n\nVIDEO FORMATS\n\u2022 Flat 2D, 3D SBS (Half/Full) and 3D OU (Half/Full)\n\u2022 180\u00b0 & 360\u00b0 VR: 2D, 3D SBS, 3D OU\n\u2022 EAC (YouTube 360) 2D & 3D OU\n\u2022 Fisheye 180\u00b0/190\u00b0/200\u00b0/220\u00b0 3D SBS\n\u2022 Instant format switching & auto-detection\n\nCODECS & SUBTITLES\n\u2022 MKV, MP4, AVI, MOV, WebM; H.264 (including 10-bit), HEVC & more\n\u2022 Embedded and external subtitles (SRT, ASS/SSA, VTT)\n\u2022 Multiple audio tracks & external audio files\n\nCOMFORT & SCREEN\n\u2022 Curved or flat screen, adjustable size, distance, height & aspect (16:9, 4:3)\n\u2022 Recenter anytime, speed control, thumbstick seek, resume playback\n\u2022 Built-in file browser with previews & multiple viewing environments\n\nSVR LINK \u2014 STREAM FROM YOUR PC\nWatch videos from your Windows PC over home Wi-Fi without copying files to your headset. Install free SVR Link (elfenlied666.github.io/svr-player), share your folders, and enter the PIN.\n\nPrivacy: no account, no ads, no tracking. Your videos never leave your devices.", "short_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset. Flat 2D/3D, 180\u00b0, 360\u00b0, EAC & Fisheye, subtitles, audio tracks, and Wi-Fi streaming from your PC. Simple, fast, powerful, and free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elfenlied666.github.io/svr-player/privacy", "developer_terms_of_service_url": null, "publisher_name": "elfenliednyateam", "support_website_url": null, "website_url": "https://elfenlied666.github.io/svr-player/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435793502957452"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2645729195888134"}]}, "baseline_offer": {"id": "2645729195888134"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795147560, "status": "PUBLISHED", "id": "2645729195888134"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1449471471589655", "version": "1.0.7"}, "id": "1527677642503109", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1407967885740014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449471471589655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1527677642503109"}]}, "change_log": "What's new in 1.0.7:\r\n\u2022 New Environment: Cinema Hall \u2014 watch flat and 3D movies in a virtual theater with seat row selection (Rows 1\u20138) and adjustable lighting.\r\n\u2022 New Environment: Passthrough (Mixed Reality) \u2014 watch on a virtual screen in your real room with adjustable background dimming (0\u201390%).\r\n\u2022 Bug fixes and improvements.", "created_date": 1795556839, "id": "1449471471589655", "version": "1.0.7", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1407967885740014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449471471589655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1527677642503109"}]}, "change_log": "What's new in 1.0.6:\r\n\u2022 Fixed Red-Cyan Anaglyph 3D video playback and auto-detection.\r\n\u2022 Minor stability improvements.", "created_date": 1795492587, "id": "1447727178430751", "version": "1.0.6", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1407967885740014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449471471589655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1527677642503109"}]}, "change_log": "What's new in 1.0.5:\r\n\u2022 USB flash drive & external SSD support: browse and play videos directly from USB-C drives without copying files to your headset.\r\n\u2022 New USB storage tab in the file browser with video previews and playback support.\r\n\u2022 Bug fixes and stability improvements.", "created_date": 1795428129, "id": "1446056225264513", "version": "1.0.5", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1407967885740014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449471471589655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1527677642503109"}]}, "change_log": "What's new in 1.0.4:\r\n\u2022 Hand tracking support: navigate menus and control playback with your hands.\r\n\u2022 Video image adjustments (Settings > Image): brightness, contrast, saturation, sharpness, and color temperature.\r\n\u2022 Sensors overlay (Settings > Sensors, Premium): shows system clock and headset battery percentage.\r\n\u2022 General UI improvements and fixes.", "created_date": 1795321883, "id": "1443663345503801", "version": "1.0.4", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1407967885740014", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449471471589655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1527677642503109"}]}, "change_log": null, "created_date": 1793860205, "id": "1408019969068139", "version": "1.0.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
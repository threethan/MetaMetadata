W&_nc_oc=AdpsDLR0J4OIiZSMhfA3s7mwZ9AOpbpakPORB1m4WmW2dUOPyn-Ty7q4RJPJXWEh3uk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv8yszvES8XVPHDFblU6xqPeTi2irtApwd6oCglbkDGQ&oe=6B0EEDEE"}, {"file_name": "03_video_formats.png", "id": "1463828768519685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_1463828771853018_6611593793145310753_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdVTwfz8OWMQ7kNvwFYIxRo&_nc_oc=Adp7WLAQur2UUSCmF871yoNEMcb2IbFszLYZwTPatlwqXR1kSA5JO77QJoFnZC1aRcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgBYAkYrbayRM1VEQklsLxWBctTgUu9R_cdYk1obbqWA&oe=6B0EED51"}, {"file_name": "01_file_browser.png", "id": "2219040225663857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585799753_2219040228997190_1582885710689484156_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcrO14rw1_wQ7kNvwGtYOxQ&_nc_oc=Adoh5pvzjwLgc2k9swZOlHxwc9s8QB58UMy7Q0Imq19kdVPHdTXq2vLhWhTo7IlUmv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCbiWF1tiomT9Uh0ft4RQMch9913c0K25Zp1a97BMjXg&oe=6B0F158E"}, {"file_name": "04_environment_color.png", "id": "3602575936594299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604317775_3602575943260965_763231902966117258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHY0X0rf6LoQ7kNvwG-jqQn&_nc_oc=Adrx59qbrUaLSFYhnmQ8Iakc1T6p4ZZUrY4c2x6u7z4JXeMlMykRnqKjZR9wXEjvIwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-YsfIxMbAnaiRLxdFpcSfmEnkEnAWsSHJRIZL0c38Zg&oe=6B0F046E"}, {"file_name": "08_premium.png", "id": "2189026592009656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_2189026595342989_5620889470042024001_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxzNJ2Kg5eIQ7kNvwG4u0RZ&_nc_oc=AdrO6O-I_JOO9Tjb393YF_t2WtFpN23bWDf-dt5Fr9WSCQ29B9u7acWm3rn6z3vdbbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVt8RXJRgF2iKpqHGL2zaoGjnV9GqGvIrkAX-HPxaK8KQ&oe=6B0F0E69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SVR Player", "keywords": ["video", "player", "360", "180", "cinema"], "long_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset.\n\nA simple, fast, and powerful video player for Meta Quest. Open a file and watch: no accounts, no ads, free to use.\n\nVIDEO FORMATS\n\u2022 Flat 2D, 3D SBS (Half/Full) and 3D OU (Half/Full)\n\u2022 180\u00b0 & 360\u00b0 VR: 2D, 3D SBS, 3D OU\n\u2022 EAC (YouTube 360) 2D & 3D OU\n\u2022 Fisheye 180\u00b0/190\u00b0/200\u00b0/220\u00b0 3D SBS\n\u2022 Instant format switching & auto-detection\n\nCODECS & SUBTITLES\n\u2022 MKV, MP4, AVI, MOV, WebM; H.264 (including 10-bit), HEVC & more\n\u2022 Embedded and external subtitles (SRT, ASS/SSA, VTT)\n\u2022 Multiple audio tracks & external audio files\n\nCOMFORT & SCREEN\n\u2022 Curved or flat screen, adjustable size, distance, height & aspect (16:9, 4:3)\n\u2022 Recenter anytime, speed control, thumbstick seek, resume playback\n\u2022 Built-in file browser with previews & multiple viewing environments\n\nSVR LINK \u2014 STREAM FROM YOUR PC\nWatch videos from your Windows PC over home Wi-Fi without copying files to your headset. Install free SVR Link (elfenlied666.github.io/svr-player), share your folders, and enter the PIN.\n\nPrivacy: no account, no ads, no tracking. Your videos never leave your devices.", "short_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset. Flat 2D/3D, 180\u00b0, 360\u00b0, EAC & Fisheye, subtitles, audio tracks, and Wi-Fi streaming from your PC. Simple, fast, powerful, and free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elfenlied666.github.io/svr-player/privacy", "developer_terms_of_service_url": null, "publisher_name": "elfenliednyateam", "support_website_url"
jKmhQgtKAYBIsQ8jjNzQZAH2Q3iH-3vkVw&oe=6B09CF8E"}, {"file_name": "04_environment_color.png", "id": "3602575936594299", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604317775_3602575943260965_763231902966117258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REs6BC6XrJoQ7kNvwEIB2X2&_nc_oc=AdpWN_JwSmfMRKessNxcHIjkdyor5dre55j69r9yQcttnSUNvHRmdqULsGS1gLv2nmA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyjhUHEGQBLDnAQnIs-GQspdv2SoNWI2CmxXevQzgTcA&oe=6B09BE6E"}, {"file_name": "08_premium.png", "id": "2189026592009656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_2189026595342989_5620889470042024001_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zFt9D2Z6lAQ7kNvwHY_Fzw&_nc_oc=AdqFx648Byh-1GB11Fi7swXj-hesT6CUyKn19tY-TYdQW_m7ApnUKGW7TS74qDxpPVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVnlPMQ7t4sQn6xv3yQJ_wNckuG-G9SaIv6Px919PC-g&oe=6B09C869"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SVR Player", "keywords": ["video", "player", "360", "180", "cinema"], "long_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset.\n\nA simple, fast, and powerful video player for Meta Quest. Open a file and watch: no accounts, no ads, free to use.\n\nVIDEO FORMATS\n\u2022 Flat 2D, 3D SBS (Half/Full) and 3D OU (Half/Full)\n\u2022 180\u00b0 & 360\u00b0 VR: 2D, 3D SBS, 3D OU\n\u2022 EAC (YouTube 360) 2D & 3D OU\n\u2022 Fisheye 180\u00b0/190\u00b0/200\u00b0/220\u00b0 3D SBS\n\u2022 Instant format switching & auto-detection\n\nCODECS & SUBTITLES\n\u2022 MKV, MP4, AVI, MOV, WebM; H.264 (including 10-bit), HEVC & more\n\u2022 Embedded and external subtitles (SRT, ASS/SSA, VTT)\n\u2022 Multiple audio tracks & external audio files\n\nCOMFORT & SCREEN\n\u2022 Curved or flat screen, adjustable size, distance, height & aspect (16:9, 4:3)\n\u2022 Recenter anytime, speed control, thumbstick seek, resume playback\n\u2022 Built-in file browser with previews & multiple viewing environments\n\nSVR LINK \u2014 STREAM FROM YOUR PC\nWatch videos from your Windows PC over home Wi-Fi without copying files to your headset. Install free SVR Link (elfenlied666.github.io/svr-player), share your folders, and enter the PIN.\n\nPrivacy: no account, no ads, no tracking. Your videos never leave your devices.", "short_description": "SVR Player (Simple VR Player) \u2014 everything you need to watch 3D and VR videos on your headset. Flat 2D/3D, 180\u00b0, 360\u00b0, EAC & Fisheye, subtitles, audio tracks, and Wi-Fi streaming from your PC. Simple, fast, powerful, and free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://elfenlied666.github.io/svr-player/privacy", "developer_terms_of_service_url": null, "publisher_name": "elfenliednyateam", "support_website_url": null, "website_url": "https://elfenlied666.github.io/svr-player/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435793502957452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604366035_2589775338167094_4050875564458949457_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32vNRL-FIK4Q7kNvwFswIxp&_nc_oc=AdoK5tquG
NZ-fkA98Q&oe=6AD23A5F"}, {"file_name": "ss4.png", "id": "947838980965208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_947838984298541_4248113864390718661_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VueUd1FAz6EQ7kNvwHNUhXU&_nc_oc=AdorZRv1iqhPrIfnlCxRxRzTkIuQ90ryrNdb6ADSW96MkVV_HPdX0laaslE-qlBvcEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFoqYlkt14VmI6euiLvr5x1hQKsAkdqjeHW_OI5Lwzrg&oe=6AD2511F"}, {"file_name": "ss5.png", "id": "955733736959585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_955733740292918_1773206847860486940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2DR_x-3_qgQ7kNvwHp0WCy&_nc_oc=AdogTe3xAP_VXL22635mzg9FEWAkHdPEMrc2WUkWcqrDYVAx4SNX9q6pk_IpULQTFw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdI8Zw6ntNbfcqtVW9xcE-8lQMU2lZdBlY7nR6VWJmEQ&oe=6AD25B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1705978410817162", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311532_1705978414150495_7388208179778532965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYVVtdBj8hUQ7kNvwGXp4EI&_nc_oc=Adrr-YiebAh1ie2iHT5S8x38qbio7Eda3aF-AqHwxkLz9EBT1zi_wiOF3FNjgyyHaNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV9Ytqso7-mW-s17iVqh4LySzHpD7qxdW5zPl-8cngmg&oe=6AD24269"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26864657069796253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_969350152440111_6279003497671697718_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcnRIVnAZ_8Q7kNvwGkPwgS&_nc_oc=AdoFl22PljXyk8-ef41CZy35-tvvfIqwDtg5Kk7o1uo8ocLdIBvBsHwFd2chWa70EtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1W-kSz6X-_-glt0ZPjxi3jXkLuH0BHAVlIKI3u1Tb6w&oe=6AD247B8"}, "is_concept": false, "is_test": false, "is_trial_offer_
r1BKHHSTQ&oe=6AAEA1DF"}, {"file_name": "ss4.png", "id": "947838980965208", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618254_947838984298541_4248113864390718661_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1zTXON3ZVQQ7kNvwF3kPDY&_nc_oc=AdrbqvfIys623AdSqN6icUtEIRzbG-yhUlShy9gF8_ccnlXYwmYXEveW2lZhB1i5L6E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ3FwUuLNoxZSmu9OJVWPiQgZav5RRrrWmWkmdl3doXA&oe=6AAE805F"}, {"file_name": "ss5.png", "id": "955733736959585", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618254_955733740292918_1773206847860486940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=483oym4CsTcQ7kNvwH4YQcE&_nc_oc=Adpe42S9Mlkp4JMG7XsLCMvSJj7cf2RoVAHIGXeQKtyEWmgDSArlh9KJxoM92V5mOHs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuIEFji6HrFFGnFnjDx2UE5_LEYegqbN9UFdvEI41mBg&oe=6AAE8ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1705978410817162", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311532_1705978414150495_7388208179778532965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHf61k7jyMcQ7kNvwEPcO8X&_nc_oc=AdoxRQ3s1AC-Vp1g3BGm5cZUGTB1nYQHW0ReTELL8ORn3ohECpB4daFAd1inANOY-sE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgF3HMKQm7T_bWn25wXzzUi8DSqmuNn73gVAHktV4PRw&oe=6AAEA9E9"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26864657069796253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499622214_969350152440111_6279003497671697718_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylmn4bkcSZ4Q7kNvwGXReBp&_nc_oc=AdrsnDjclFV_FpIF95fQYcVbT9Q-1lujSxvErF5dlP8MXRkDMBe2c_aOJsZELvrDJF0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNw8pTeYQhMM8cda_aUlJHOYrUYWODDD550Q7n_px6Xw&oe=6AAEAF38"}, "is_concept": false, "is_test": false, "is_trial_offe
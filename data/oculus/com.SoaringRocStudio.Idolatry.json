&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rnZubCRYZ3y848YJ5vkQ50zpWDClUwQ-zsUvzYPISJA&oe=69E39682"}, {"file_name": "ss2.png", "id": "917031317763763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618277_917031324430429_5629052850127551850_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy1fFRaZWcUQ7kNvwHWCuVZ&_nc_oc=Ado0BU_M_koe0jf41vPuJGe4KP8qutPqNra2ndMLNLjhPDAEVbkC-IZ2bdaSWwpDCrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36xpuYEUOHT2L0YtBxcw2HunSCaga3olovHYNZqKIA6A&oe=69E39ADF"}, {"file_name": "ss4.png", "id": "947838980965208", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_947838984298541_4248113864390718661_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st9fG4X5AfgQ7kNvwELv9fU&_nc_oc=AdrtRJT5GnS9lKGYh7W-2cJ1c-51YVLObaw_IelFqHxSfvGGxmBFGzPOx-o0NZW3iCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-_y22M3MqSl9DMcOfOjI6JE5GyNl7vR9UFYSFOmqgFg&oe=69E3795F"}, {"file_name": "ss5.png", "id": "955733736959585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_955733740292918_1773206847860486940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZnXPWDluOMQ7kNvwHfwvrW&_nc_oc=AdoPbPADPO9HQ1smhAAjCXcRH12dRvB7RN63ZKyzP5xDd2TvffoROt7hLBMBoP6978s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16ZldIhgUliM_o0atdQNV9Uz5MnnTNaZ8CBBitXvT84A&oe=69E383BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1705978410817162", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311532_1705978414150495_7388208179778532965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XzwvwSCFFIQ7kNvwE4TP2o&_nc_oc=AdrPeS0Uly0THEyOyetOg0Vsm8EV_puFDH9cp3_v1m0kNe3XJW8qbUTxqL9zV__SUZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yl2CG3EdHmeuVt5z1pjgV0a2gpWka8DVJLvVKr9ECTA&oe=69E36AA9"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26
t-iad3-1.oculuscdn.com/v/t64.5771-25/499618277_917031324430429_5629052850127551850_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwXuKo8YyMgQ7kNvwE6_lv1&_nc_oc=AdqEe2MFNNARUB-vX0Uw_zghwlS7Z_9wUuTGBJbXiPcPJTleqBzxN6avMfYPXtHJa0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGnWQb501iPg0AiLBYgcJfdJLNY5jh1YpVCKhPkI8xrg&oe=6B10691F"}, {"file_name": "ss4.png", "id": "947838980965208", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_947838984298541_4248113864390718661_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLQQMAHudJUQ7kNvwGqUrlW&_nc_oc=AdqeK5Ai9UUbnDQ-02q0CWeAwjYindWTkqQtKnlup8JDNqDv1APD86D0yB5JxTLjSU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHswL55PSkIqtgK5Bwf4hV-82AZZWig3SllRzXXISqqA&oe=6B10479F"}, {"file_name": "ss5.png", "id": "955733736959585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_955733740292918_1773206847860486940_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q40iuqoNVlcQ7kNvwGhcqBC&_nc_oc=AdotfmMR2A3CCzzgz2TWVhsoNicMluj3oUrQl6SvY_ebg9uFHLolf0-oyig4ExpmhWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrSU1sK1t5hYCebONA8ZeokBqyn8sruz5ECD63neiQRQ&oe=6B1051FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1705978410817162", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311532_1705978414150495_7388208179778532965_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYahghmxSmgQ7kNvwGXfdre&_nc_oc=Adq2DDGUkU-5sjbbFwjhOog8BOBC8SOWPeovH-hucy1ip3-IOFzjuxrB_zyKv6_Wnbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCL6TGL-5gPw56bt8YHvusZID9H_3Kr52qTT1ka58Iqg&oe=6B1038E9"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26864657069796253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
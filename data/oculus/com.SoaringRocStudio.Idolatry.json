2965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUa966PVzS0Q7kNvwFFJz_M&_nc_oc=Adp-hues9weLtp7F5wANCIqjSiTF4R0qOK6AyJ-LjH1a01pnd9ntk4mi8lom_jM2lHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k2pVVvnNRqqRoNUupewJweLy01mfGFicaXGMtpBARiA&oe=6A15BBE9"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_ar
Ihim3D4AQ&oe=6AA0215F"}, {"file_name": "ss4.png", "id": "947838980965208", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618254_947838984298541_4248113864390718661_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Snwrydf6GkQ7kNvwGbnGQZ&_nc_oc=Ado7sd5lJvOAM4gn2vcjxu9gVP6Bgs2KUupDnCvOpjtXi07XO-Td-J8T_wNqoJRnUmA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdXYylY4DyYTNRJz4SnPZ_zjzE57tcSpwa96MF9cVI6g&oe=6A9FFFDF"}, {"file_name": "ss5.png", "id": "955733736959585", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618254_955733740292918_1773206847860486940_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EzgQsqpfGgQ7kNvwGO199j&_nc_oc=AdpmnyufTvyl7_cpcbwKRGRUi4mmycMf8SktwKT9UUmhanxpmTYyZ28j1ewCLKNZd-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV6VTh5WmwkqT3PslAK7CSsOxEpnpsby3LIKpDgi0ThA&oe=6AA00A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1705978410817162", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311532_1705978414150495_7388208179778532965_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJCj8yu_IAkQ7kNvwECBMqP&_nc_oc=Ado5Voq4iESMXuejdCIm-ySR2vOaXUnqtCgvC2utf6ZYXW9vHjwM3be62mEewz17qPQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsQXZrPkMV0jGlKXdUM8uAt5V4cPkafDjGSXyjU9JlkA&oe=6AA02969"}, "display_name": "Idolatry - Demo", "keywords": ["swords", "physics", "multiplayer", "combat", "fantasy"], "long_description": "Idolatry is a physics driven, multiplayer swordfighting brawler that tasks you with destroying all the other false idols in the fortress to claim it for yourself. \n\nThere's no i-frames or animation based attacks, the swords, props and idols are all physics driven and you must use these all to your advantage to win. \n\nThis is a simple, early access demo as we ramp up development with the community. Practice the controls, fight some practice enemies, then connect to be paired up with random opponents. \n\nOnce assigned an Idol to protect, you must attempt to eliminate other players and destroy their Idols to convert their warriors. What starts as a free for all 6 player brawl ends in a tense team vs team battle. Earn \"Devotion\" by destroying Idols and heretics, so you can increase your level and earn more weapons.", "short_description": "Chaotic, physics based sword fighting and tavern brawling."}]}, "developer_name": "Soaring Roc Studio", "developer_privacy_policy_url": "https://tinyurl.com/2j7sdkkz", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26864657069796253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_969350152440111_6279003497671697718_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msZ50aXGVPIQ7kNvwGL_ZeA&_nc_oc=AdpP2vDDzXLin3eknYpB9-pDOq1PErMLwpOyhnsgJzw73xit9rYh6HVsOheKlkYrw2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzUWxO3_CRKppf2T-0C4lUyJedAZ9Osw8qtKjEYTGyAg&oe=6AA02EB8"}, "is_concept": false, "is_test": false, "is_trial_offer_
274895286", "locale": "en_US", "screenshots": [{"file_name": "1 copy.png", "id": "892847503302391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_892847509969057_6006707184621063126_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXE3Ch0Ku74Q7kNvwHG4mfL&_nc_oc=Adl8zno3hJrPpw6Qc55a47t0cF1NZFePqZyZjp_G6vkkMuK99COufVpf-gyg_DMcKVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwrJ-N-VYVFNRGwdj5A2xuoY_DKgZRs7Kt6qnv2fgbCA&oe=69999EE0"}, {"file_name": "3 copy.png", "id": "1036483058643594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1036483061976927_5988734056843416934_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CTyXIuwwkgQ7kNvwEgLl2U&_nc_oc=AdmSZPW04NRY63T_pRm0BcjkBmYSvjT5q08yzeilpz2WIdl0Es6vyUunAAoOV6I8Zfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvA379XdICgEAncN6vc858bhT6i2yrD5alwId5tae_2-A&oe=699991F8"}, {"file_name": "4 copy.png", "id": "1203309734560756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1203309737894089_7387455252740330706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5-nRpcAkakQ7kNvwHaXfwh&_nc_oc=AdlF4Jbu1WJxAwcFoYjr3XZF9y7-O6PJxPBCvfJNNHQiaGn6mAx-mOL9zHC-QhAWOPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9jxfMkTFvLUZutBySfILZqarhWaWFcqQi7-W-hUTqWg&oe=6999AF12"}, {"file_name": "5 copy.png", "id": "885887073789510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_885887077122843_5115296367976783740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bVmhQsJvF4Q7kNvwG6vJva&_nc_oc=AdkwmbCYHyeH8BW0zXdKH4a3AkV0-TFKtjpr_YpbSoRPYTVXipCQTs67R-T0o57efQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsIbTt2FKCOCF9wKWuWyEtjTUHFxMazdBoVTlifBC4XcA&oe=69998D60"}, {"file_name": "6 copy.png", "id": "755282980936039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_755282984269372_2240727994745554594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYoPOUl2JKgQ7kNvwEnvYfc&_nc_oc=AdnSCULJuNS3n4Y-_YMUunC8jCe4munbsWEzRu1gav1rgzqbPHVszVRsFbZcVB-Kt4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9RW8Wm9Mf5L-9AOzADEPRIQoHMiSmiLzNL8aHza4ckQ&oe=69999C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6 copy.png", "id": "862905860004383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_862905863337716_1734955564600510101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7ne9rbCTHUQ7kNvwHmzRG4&_nc_oc=AdmAjWZCt6Wd4TTeLamz6JRWsENhOkY-6loL1Ebj72dDwqx19DIYkXuFbQF0zQx7g9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGeu_51vY4XCdikp10z9r5ma4QHFeeLZjlkR7wWh0EEw&oe=69999210"}, "display_name": "Modelspace VR", "keywords": ["model", "viewer", "3d", "inspection"], "long_description": "**A GLB viewer for Meta Quest**\n\nDo you want to view your 3d models on the Meta quest headset? \nSeek no further, Modelspace VR is here to help.\nBefore I made this app, I found it difficult to find a 3D model viewer for the Quest3 and get the models on the headset. I had to make some choices for the easiest workflow on how to get this working. \n\n**Why GLB?**\n\nI chose GLB exclusively over FBX and Obj because GLB embeds all textures and materials in the file.\nMost applications can export GLB\nIt can have animations and supports albedo, metal, gloss, lightmaps, etc.\n\n**Local files - Preparation**\n\nI chose to download the file to the headset for easy file access in the app. Loading the file directly from the internet is possible, but I had to type in long urls to load them. In the headset using the controllers this quickly became annoying. I looked into copy pasting urls, but Meta doesn\u2019t allow this in apps. Therefore I chose to locally save the GLB files from the web.\n\n\n**The options I found easiest to transfer the files:**\n\n1. Google drive (Just open your browser, head to your drive, search for the GLB file and save to your downloads folder)\n\n2. Sketchfab (Find the GLB file you like, and save the file to downloads)\n\n3. Over usb cable (Connect your headset to your computer and copy the file over to the downloads folder)\n\n", "short_description": "This app is made to easily review 3d files on the quest headset"}]}, "developer_name": null, "developer_privacy_policy_url": "https://patrickgoud.com/pages/haedspace-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Goud", "support_website_url": "https://patrickgoud.com/pages/headspace-vr-support", "website_url": "https://patrickgoud.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25986315644294970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_4325337944369517_3816929617410397714_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPaNeNUSTwgQ7kNvwEYBadg&_nc_oc=AdksVtYWC8vgYs7gXqdf-JUmuWQoVIHZk5RFTPsqqZ1fCdHr2qoL8zwjEkf-ODxrJEU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsscN5r361RHe25ITh0hHXGarm9XYpS3SYimZdiWtkfiQ&oe=6999B251"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modelspace VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1766577480, "lastRevision": {"nodes": [{"id": "25931861926407009
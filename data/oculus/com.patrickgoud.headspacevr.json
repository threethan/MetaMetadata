eZruXTPKQtsqaJCJi67UxFqzLxfBMSzUtL6AxN_wE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuWiZdDkz0ottcxmnrBA7HbhoY7TeiYbJWfDSFbNQ6vZA&oe=69A57984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6 copy.png", "id": "862905860004383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821696_862905863337716_1734955564600510101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRhsuK8zl0AQ7kNvwFuyXOV&_nc_oc=AdlgiLwUnSGe0GXhJbre47qbowIyB3FlLbs0Rame3ykiQPw6yywhG4yJFpBGRncgiyo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu7V9i_SZWzkyukVYNzME60md8M_AvpnKLao-DHO8EVsw&oe=69A56F90"}, "display_name": "Modelspace VR", "keywords": ["model", "viewer", "3d", "inspection"], "long_description": "**A GLB viewer for Meta Quest**\n\nDo you want to view your 3d models on the Meta quest headset? \nSeek no further, Modelspace VR is here to help.\nBefore I made this app, I found it difficult to find a 3D model viewer for the Quest3 and get the models on the headset. I had to make some choices for the easiest workflow on how to get this working. \n\n**Why GLB?**\n\nI chose GLB exclusively over FBX and Obj because GLB embeds all textures and materials in the file.\nMost applications can export GLB\nIt can have animations and supports albedo, metal, gloss, lightmaps, etc.\n\n**Local files - Preparation**\n\nI chose to download the file to the headset for easy file access in the app. Loading the file directly from the internet is possible, but I had to type in long urls to load them. In the headset using the controllers this quickly became annoying. I looked into copy pasting urls, but Meta doesn\u2019t allow this in apps. Therefore I chose to locally save the GLB files from the web.\n\n\n**The options I found easiest to transfer the files:**\n\n1. Google drive (Just open your browser, head to your drive, search for the GLB file and save to your downloads folder)\n\n2. Sketchfab (Find the GLB file you like, and save the file to downloads)\n\n3. Over usb cable (Connect your headset to your computer and copy the file over to the downloads folder)\n\n", "short_description": "This app is made to easily review 3d files on the quest headset"}]}, "developer_name": null, "developer_privacy_policy_url": "https://patrickgoud.com/pages/haedspace-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Goud", "support_website_url": "https://patrickgoud.com/pages/headspace-vr-support", "website_url": "https://patrickgoud.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25986315644294970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819323_4325337944369517_3816929617410397714_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEHtnlWxJVMQ7kNvwHDaICW&_nc_oc=Adm9_T5VbHzwYw3DH2PmfKHEDkMx7ngCTE4rv60E1ti0ui1KlEATYNiIRCROafO5VcQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu4aAolIQTyhhqxG2jbaYk-bNtf6mRxrlUoex8bxpFiMw&oe=69A58FD1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modelspace VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1766577480, "lastRevision": {"nodes": [{"id": "25931861926407009
274895286", "locale": "en_US", "screenshots": [{"file_name": "1 copy.png", "id": "892847503302391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_892847509969057_6006707184621063126_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fQARLFejyEQ7kNvwHoMa1v&_nc_oc=Adm_bSYJKuz0DusmeyiORrwEOaw7NowDzuhqDt73O3D0Pjovs-3scYo_lfIkHmeBiRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvszFnIXqsoAGtIvT_VjBddJbsu6uTY3Q2OjOU3iwy4Fw&oe=699D9360"}, {"file_name": "3 copy.png", "id": "1036483058643594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827063_1036483061976927_5988734056843416934_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuH4NNVtuWoQ7kNvwFx2LDa&_nc_oc=Adkmtr1ne8ywtkyMAxzUpPFhuFjLAml573_wQrG38r_S5iwlcU5bRjTizj2scJEoajk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCIiw4ovDEJ-NcDex0jryyxfPKAwDz_VH9noNov8gBVw&oe=699D8678"}, {"file_name": "4 copy.png", "id": "1203309734560756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1203309737894089_7387455252740330706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNAc-OmICswQ7kNvwHNd6TQ&_nc_oc=AdkUZ6headkq20Ru3bKiHry-ATKH_jKAmIgvW36qGSLWIjSXIAIDbTisQZQkbJ18Fw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv2nhggrlG6aaMcARnUhJRmAbUKqIokcCJJlDhI71Gig&oe=699DA392"}, {"file_name": "5 copy.png", "id": "885887073789510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_885887077122843_5115296367976783740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg8vnClAu70Q7kNvwFqbTwy&_nc_oc=AdnDziub-HCP19nTjTbGHVoCndtqzcaAny9cyQUoJKv61pYXy7TjN91ociMJmZ28GYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubxXWtxR2ib--dUJE6rghIpasKSMTH31wrseKyeOJFlQ&oe=699D81E0"}, {"file_name": "6 copy.png", "id": "755282980936039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_755282984269372_2240727994745554594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3kV9UIYY6YQ7kNvwFemzGP&_nc_oc=AdkMfojRqDSXM5fY7hwldsMn2GZ3LVLg1t1OB9RlcowI6bx2NbzIzspujOxNAy1D9bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRQmbeSUPOMne6CItc54K4sfdg4eznB0Z-455A6yduQg&oe=699D9084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6 copy.png", "id": "862905860004383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_862905863337716_1734955564600510101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5HnZwBwnWMQ7kNvwESBFmV&_nc_oc=AdmiReZzOiHy5BhGXRpaadBcmnYf6kiAWu2nJNPcsxth9rR53fBXZDEJrqaV-xt8U6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsRzeSy9uSwW4pC6cy1OngXhURn2v5vo1y0NL0FGc36bw&oe=699D8690"}, "display_name": "Modelspace VR", "keywords": ["model", "viewer", "3d", "inspection"], "long_description": "**A GLB viewer for Meta Quest**\n\nDo you want to view your 3d models on the Meta quest headset? \nSeek no further, Modelspace VR is here to help.\nBefore I made this app, I found it difficult to find a 3D model viewer for the Quest3 and get the models on the headset. I had to make some choices for the easiest workflow on how to get this working. \n\n**Why GLB?**\n\nI chose GLB exclusively over FBX and Obj because GLB embeds all textures and materials in the file.\nMost applications can export GLB\nIt can have animations and supports albedo, metal, gloss, lightmaps, etc.\n\n**Local files - Preparation**\n\nI chose to download the file to the headset for easy file access in the app. Loading the file directly from the internet is possible, but I had to type in long urls to load them. In the headset using the controllers this quickly became annoying. I looked into copy pasting urls, but Meta doesn\u2019t allow this in apps. Therefore I chose to locally save the GLB files from the web.\n\n\n**The options I found easiest to transfer the files:**\n\n1. Google drive (Just open your browser, head to your drive, search for the GLB file and save to your downloads folder)\n\n2. Sketchfab (Find the GLB file you like, and save the file to downloads)\n\n3. Over usb cable (Connect your headset to your computer and copy the file over to the downloads folder)\n\n", "short_description": "This app is made to easily review 3d files on the quest headset"}]}, "developer_name": null, "developer_privacy_policy_url": "https://patrickgoud.com/pages/haedspace-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Goud", "support_website_url": "https://patrickgoud.com/pages/headspace-vr-support", "website_url": "https://patrickgoud.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25986315644294970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819323_4325337944369517_3816929617410397714_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyM5vY9qjqAQ7kNvwHkHi9n&_nc_oc=Adko82VJxhQnIIO7OAMDX4YqxoZqMd-g-8l_tM5frvHPdoc6KUOuN4fFzXLAyrNPmlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-2FdQWGzZRs-cacTnnwI8AA-Wj67nseR4tO45-pm5uA&oe=699DA6D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modelspace VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1766577480, "lastRevision": {"nodes": [{"id": "25931861926407009
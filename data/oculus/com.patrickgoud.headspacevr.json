adi_hRLeOjVsb9nzOLyDGdZvEVC3XsbFA&oe=69FDF4CF"}]}, "id": "1824368274895286", "locale": "en_US", "screenshots": [{"file_name": "1 copy.png", "id": "892847503302391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_892847509969057_6006707184621063126_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crRMqW-C6PAQ7kNvwGR6_sP&_nc_oc=AdpTu8BTRcFQ30Ye5Bd6CAZHVe8xyxL8-pyDhh0dMOMYfXmFB-tBcdqFL9meApIZRoU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-as1ettpWDk_-y8YWHwTg6Y5Fzf5Sfc7BVKLuAZQ-YA&oe=69FDD0E0"}, {"file_name": "3 copy.png", "id": "1036483058643594", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827063_1036483061976927_5988734056843416934_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKXn1ort5tUQ7kNvwEZ9Bqj&_nc_oc=Ado28cGyLIZ2xzf2euscQ-O21etoLiW4j28y2tvJ5zfXgFRmIjEeupNP5thMJh_hJf0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T4VTG45Lyk4ysZU8FQqk0D2ZC_CcJRUWP-_BiESIz7g&oe=69FDFC38"}, {"file_name": "4 copy.png", "id": "1203309734560756", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820923_1203309737894089_7387455252740330706_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rmOVGMxs_QQ7kNvwF-0zHa&_nc_oc=AdrzqWSSlG-0BlKKPM8_Lj7ccWxxVIfSqkvxJn22_gjgAlsoml3vsuxT_-sj7-hyumw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PkXHMfpdEhh2oZIvvWfw8B52tr4tsNFPck2e5O6NajQ&oe=69FDE112"}, {"file_name": "5 copy.png", "id": "885887073789510", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825575_885887077122843_5115296367976783740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLZWZJIdZhsQ7kNvwGwhXBh&_nc_oc=AdrnMWfn7rBaE6JjbSK6LR1NxMaZ6PZIohj17uAOvVrVjx8g1K_W7RLFA7SuSg1S0yA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G6Tg49k3yWUAzGaoVnAOl4BPrHjj1-sW2TpOuycD12A&oe=69FDF7A0"}, {"file_name": "6 copy.png", "id": "755282980936039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818885_755282984269372_2240727994745554594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aECxImwAa7oQ7kNvwEHAJZd&_nc_oc=AdpIi8s4AVXUEYZ3SXndK8SNNQ3eTK5jrvbKWVuknpc5FmoFfO-8dG4pKXVnSvPc3rc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GdgyZXO9Vs8lyMah-hdjs8cxXiYqS9iBs9oszsLAcGg&oe=69FDCE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6 copy.png", "id": "862905860004383", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821696_862905863337716_1734955564600510101_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSXxnD23_1gQ7kNvwH_4zm4&_nc_oc=AdqbLaGHhRT62ZDBUZ_ULB9Pq8oL7S7j81vzEyw0N8Hgic24PdMeF6WXtM7l2fAoTaQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tnEUA8tzXh5LWKdYZfmASEvuOUGTLf5_S97-5V9qkvQ&oe=69FDFC50"}, "display_name": "Modelspace VR", "keywords": ["model", "viewer", "3d", "inspection"], "long_description": "**A GLB viewer for Meta Quest**\n\nDo you want to view your 3d models on the Meta quest headset? \nSeek no further, Modelspace VR is here to help.\nBefore I made this app, I found it difficult to find a 3D model viewer for the Quest3 and get the models on the headset. I had to make some choices for the easiest workflow on how to get this working. \n\n**Why GLB?**\n\nI chose GLB exclusively over FBX and Obj because GLB embeds all textures and materials in the file.\nMost applications can export GLB\nIt can have animations and supports albedo, metal, gloss, lightmaps, etc.\n\n**Local files - Preparation**\n\nI chose to download the file to the headset for easy file access in the app. Loading the file directly from the internet is possible, but I had to type in long urls to load them. In the headset using the controllers this quickly became annoying. I looked into copy pasting urls, but Meta doesn\u2019t allow this in apps. Therefore I chose to locally save the GLB files from the web.\n\n\n**The options I found easiest to transfer the files:**\n\n1. Google drive (Just open your browser, head to your drive, search for the GLB file and save to your downloads folder)\n\n2. Sketchfab (Find the GLB file you like, and save the file to downloads)\n\n3. Over usb cable (Connect your headset to your computer and copy the file over to the downloads folder)\n\n", "short_description": "This app is made to easily review 3d files on the quest headset"}]}, "developer_name": null, "developer_privacy_policy_url": "https://patrickgoud.com/pages/haedspace-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Patrick Goud", "support_website_url": "https://patrickgoud.com/pages/headspace-vr-support", "website_url": "https://patrickgoud.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25986315644294970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819323_4325337944369517_3816929617410397714_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gSKLDMd884Q7kNvwGgpnKo&_nc_oc=Ado0JeHcXzBnhhKRHwTABMBcRvLSXU-tr3msvBbNjy3OFn-hfAn7oeTBX1OgPQfIK04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wbEjJWEIrBKKzc5UvcJhIBlziJIJvXKcFaYYz8fejrw&oe=69FDE451"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modelspace VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}
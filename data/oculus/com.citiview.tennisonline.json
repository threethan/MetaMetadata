2ub-vkBU7yos&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2GPIz9BVs4Y0_6HkG84uonSv2LBxYn4CZGg7RJnEcTg&oe=6AF9E990"}, {"file_name": "screenshot_5.png", "id": "1047150151642398", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828087_1047150164975730_9076635879039936060_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkff7uIPT0EQ7kNvwFuVwes&_nc_oc=AdrlNd9KbNh8czeKEyWjNKK28H0kgIK9-QmzdfGB6omqk2QU8Mz74ZCiZI_ehq56ras&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJdC608t_4BJoKgnu7MursTKr4YuFSkjaw7Xl6HQsGeA&oe=6AF9BE93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1998780184144355", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823279_1998780187477688_6713452711736124074_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i__u2lh4I-sQ7kNvwHsbFco&_nc_oc=AdrVhEPk0xJNS9qka7kMbTlCQD3RriknMPJs_l2Gfk8OsIYYE5g_GsnkleIxtccZww0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV6VWbflaauD4p1OXLO-sR2rJCnaiSAC4eazP8zy6clg&oe=6AF9B5E9"}, "display_name": "Tennis Online", "keywords": ["tennis", "multiplayer", "sports", "racket", "online"], "long_description": "Step onto centre court and play a real match.\n\nPLAY ANYONE ONLINE\nQuick Match puts you on court with another player anywhere in the world, or opens your court and the CPU warms you up until someone joins. A private match gives you a 4-digit code for a friend.\n\nREAL TENNIS IN YOUR HAND\nToss the ball with your free hand and serve. Swing harder for pace, low to high for topspin, high to low for slice, open the face for a lob. Where the strings face is where the ball goes. The ball flies with real spin, drag and bounce, and topspin kicks up off the court.\n\nREAL RULES\nFAST4 (first to 4 games, deciding point at deuce, tiebreak at 3-3) or a full set with advantage scoring and a tiebreak at 6-6. Two serves, faults, lets, aces and double faults. BREAK POINT and MATCH POINT come up on the board.\n\nA CLUB THAT FEELS ALIVE\nA chair umpire calls every score. The gallery goes quiet before the serve, follows every rally with their heads and applauds the winners. Close balls leave their mark on the court with the call, IN or OUT by how many centimetres.\n\nPLAY THE CPU\nFour opponents from ROOKIE to CHAMPION, each with their own footwork and serve.\n\nYOUR PLAYER\nPick one of 12 players, right or left handed. AUTO-MOVE carries you to the ball, so a small play space is enough. Aim assist from EASY to PRO.\n\nVoice chat is optional and off by default. You can mute, block or report any player. Playing the CPU needs no internet.", "short_description": "Real tennis, face to face. Play a full match against anyone online or against the CPU in a sunlit indoor club, with a real net, real rules, a chair umpire who calls every point and a gallery that watches every ball. Serve, slice, lob and volley with the racket in your hand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/tennisonline/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/tennisonline/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1281820405023932"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id
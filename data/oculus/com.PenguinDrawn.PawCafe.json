_nc_ss=7f30f&oh=00_AQUlBYpwku3AdfbDGRdzoFIMkUvWeSkfhUpQ5oj_RBPSjw&oe=6B105BAD"}, {"file_name": "6_Screenshot_5.png", "id": "4222165264583063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835836_4222165267916396_1113000655186475364_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XrYN42ka8oQ7kNvwFqU6nE&_nc_oc=AdpWciGf4yNR70pHVy0y_tJMXZPmWYgRS-nVHWF9e6c1qJ13NFd9q9sCCnOPUN8CCMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWT4INo4wOFQLnGO8coOHI-ilSJKT7btrhXFDgo2SyX1A&oe=6B103AF1"}, {"file_name": "6_Screenshot_3.png", "id": "29209596715363237", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835819_29209596725363236_1303331527144726818_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o78pj_13wssQ7kNvwGwJtlB&_nc_oc=AdovxpepeByPGSP4WNGyNHuyQLRL7Amb_qO5cabmHsFUssAFG8jz5WbyuMZgA5TmpM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxroleszu-hbd6TqUtBybcZ6skHbcoMipVTMp8gjfsVQ&oe=6B10679F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8_Trailer_Cover_1920x1080.png", "id": "1354203133367059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835855_1354203136700392_8718584008819822377_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks5wVsHPDV4Q7kNvwFqlfd_&_nc_oc=Adr_YhtgkTyhPYoc_N9UtZM1zJj9GSIT5cit-_hnO_ygjU0Ug-sImxCR8YKhwYbvHjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0XdojxseScmHuoZ6gCUEHHOfl7Xts-qSsnY5peIkLhg&oe=6B104998"}, "display_name": "Paw Caf\u00e9", "keywords": [], "long_description": "Paw Caf\u00e9 is a cozy hand-tracking caf\u00e9 game for Meta Quest. A miniature caf\u00e9 appears on your real table in mixed reality, or in a hand-painted fairy-tale forest in VR, and fluffy animal guests line up at the gate.\n\nHANDS FIRST, NO CONTROLLERS\n\u2022 Pick up guests with your bare hands and seat them at the tables\n\u2022 Brew coffee, bake cake, make ice cream and curry, then serve each order by hand\n\u2022 Squish the fluffiest customers. They squeak!\n\u2022 Collect the cash and wipe the tables for the next guest\n\u2022 Catch the mice and raccoons that sneak in\n\u2022 Move and turn the whole caf\u00e9 with both hands\n\nGROW YOUR CAF\u00c9\n\u2022 Buy new machines and tables in the shop\n\u2022 Hire animal staff: an usher, a server, a barista, a cashier and a guard\n\u2022 Pay rent and wages when the pigeon postman delivers the bill every three days\n\u2022 Unlock fifteen skills that carry over to your next run\n\nEARLY ACCESS\nPaw Caf\u00e9 is in Early Access. This version includes a guided tutorial and a twelve-day run with rising daily targets. We are adding more animals, recipes and caf\u00e9 upgrades, and balancing a five to seven hour campaign based on your feedback.\n\nSupports English and Simplified Chinese.", "short_description": "Run a tiny caf\u00e9 for fluffy animal guests, right on your real desk. Pick them up with your bare hands, seat them, brew coffee and serve every order, no controllers needed. Play in mixed reality or in a fairy-tale forest in VR."}]}, "developer_name": "Penguin Drawn Studio", "developer_privacy_policy_url": "https://jasoneclipse1989-code.github.io/pawcafe/", "developer_terms_of_service_url": null, "publisher_name": "Penguin Drawn Studio", "support_website_url": null, "website_url": "https://jasoneclipse1989-code.github.io/pawcafe/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["HAND_T
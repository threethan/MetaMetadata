=7f20f&oh=00_Af-61vUpxrYGd00s0qUSC6IgqTAIrfyRDyI4kze7o1TeRQ&oe=6A43E919"}, {"file_name": "migrated_image.png", "id": "2734247443309921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974589_661395317699485_5778569568360333312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSPD50z5GmwQ7kNvwEXiUJb&_nc_oc=AdprqpRN8k_BeJQL6zo8I3s0-0kJf5QMR_5-KgHDhWQDlcKSA3zQ6URR91cYIHp8o40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Ky-IoP4bNAyhl1PkRySCL0jonK2TLKWW0v36mt0FAQ&oe=6A43D5EB"}, {"file_name": "migrated_image.png", "id": "594078311188275", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982525_2824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBzuiDVpAiwQ7kNvwFN4bzH&_nc_oc=AdrSfd0udqWBthJvl-1s2oiiIMmaUiAH2D3SCR5xe_l3tF1WTsJozWKA_2erm8DtFZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xMfapBagE89SFcAnTUOt2Ngnz4dtHG8tAQlGIEgne1w&oe=6A43BC37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1S0-1wFufoQ7kNvwGJ8f0f&_nc_oc=Adp7hcYfTSZ0BHaK2AQQQ-y34dMavEup8Gf_THlNLYHMRrgApiGTdw8dllpeXt2K78A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jBg9p0V72HOfmq_DYMjyU51OgK6QbTv65ZD3SgQ6vDg&oe=6A43C8C4"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "developer_privacy_policy_url": "https://www.realvrfishing.com/", "developer_terms_of_service_url": "https://www.realvrfishing.com/", "publisher_name": "MIRAGESOFT, Inc.", "support_website_url": null, "website_url": "https://www.realvrfishing.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1926611330874728"}}]}, "scheduled_offers": {"count": 67, "nodes": [{"status": "PUBLISHED", "id": "977612308562878"}, {"status": "PUBLISHED", "id": "26061553060212783"}, {"status": "PUBLISHED", "id": "1992216428344415"}, {"status": "PUBLISHED", "id": "1623239179095108"}, {"status": "PUBLISHED", "id": "850355854096995"}, {"status
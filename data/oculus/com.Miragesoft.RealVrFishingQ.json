nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "developer_privacy_policy_url": "https://www.realvrfishing.com/", "developer_terms_of_service_url": "https://www.realvrfishing.com/", "publisher_name": "MIRAGESOFT, Inc.", "support_website_url": null, "website_url": "https://www.realvrfishing.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1926611330874728"}}]}, "scheduled_offers": {"count": 70, "nodes": [{"status": "PUBLISHED", "id": "2401662750660059"}, {"status": "PUBLISHED", "id": "2989006001445851"}, {"status": "PUBLISHED", "id": "440944357603
824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Joe2h7V1mYQ7kNvwFFTPU8&_nc_oc=Ado8yLSZC7MP6lNqd1u6sk5yib6BeaQajI-nHVT6DB3pCkNkGomn65vlJY6TGnvCL_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvVgXXrre7oR4u51z1cQi2x9B7wAQzqlmv_WsMqjKK_Q&oe=6AA7EE37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB6naZtNlAgQ7kNvwFOfcBI&_nc_oc=AdogeJnsOK9ZVVydHm0mEyFrr3TUau_EXH4CDI2JEnpQzNuiMbDctN0JtpgqGB-E8Yw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuuEUWxTrpFx9cgbnHsJX4HVM3ZOvN9IGJbbMf0yjYlw&oe=6AA7FAC4"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "devel
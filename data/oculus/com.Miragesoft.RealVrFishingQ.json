824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4PwrIrN4osQ7kNvwEOwVPe&_nc_oc=AdoDyTcRY6SNltt9XwBblgG34OzUyObN9k_wyI7nCeuULnDWYPOpX6OT4bU_PzdXSdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjCk42IEywZiWtTpd1JGrGWJgkZTZntM-KZ4Jl7EOj-A&oe=6AF5EEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26AkV2UX-2cQ7kNvwEMoypL&_nc_oc=AdpjudEAQg9fxkBAIRHJ-VdXJavQ1Eiq08tHddwRvbhEfBuVRWBSFk9dv_oOt8kjglU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx_UnDcsJjX8z9kKGDi3ArkwsTIFMMp0SQX2ObPmLmYw&oe=6AF5C344"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "devel
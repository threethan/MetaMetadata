20f&oh=00_AQBcCPwWF3sJbRUJ1UrPLcf9n3I2GsmkkqI2KeiC93TBDQ&oe=6A5A1A59"}, {"file_name": "migrated_image.png", "id": "2734247443309921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974589_661395317699485_5778569568360333312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VFmD55c2AoQ7kNvwHkQbyy&_nc_oc=Adr_FudvTNSepN0pyDvL4LC7TIpgOICGGqxOvXO9PjsTsbqgVcYeop3nAPJiz1dOvG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBscr7UeOf1jkRcUdYF2BVc7fiEdNz0lzLNkF29hnzm4w&oe=6A5A3F6B"}, {"file_name": "migrated_image.png", "id": "594078311188275", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982525_2824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbiVsizo9RkQ7kNvwE4dfFC&_nc_oc=Adr53l3jhGnb42-JRZ-Da1y-TMH9PUxO8IJzIfhyjKlpSG_8FaIFSRyB_Z_e7pBnuhs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCb_2EMn1cnAdklnywlMSSYEyzDIrzLmJfOwBj5D--Ew&oe=6A5A25B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17yntaURkSYQ7kNvwHx-bVb&_nc_oc=AdrFKyljY2VK_WH2g1elQfueOnZlppAknnixwsWV0zjOqriBsaMRAAXhXhJlCdnNpec&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXOmY3fV3486bgcIot86G3B7x8XSVZYrcyseJa2LbWZw&oe=6A5A3244"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "developer_privacy_policy_url": "https://www.realvrfishing.com/", "developer_terms_of_service_url": "https://www.realvrfishing.com/", "publisher_name": "MIRAGESOFT, Inc.", "support_website_url": null, "website_url": "https://www.realvrfishing.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1926611330874728"}}]}, "scheduled_offers": {"count": 67, "nodes": [{"status": "PUBLISHED", "id": "977612308562878"}, {"status": "PUBLISHED", "id": "26061553060212783"}, {"status": "PUBLISHED", "id": "1992216428344415"}, {"status": "PUBLISHED", "id": "1623239179095108"}, {"status": "PUBLISHED", "id": "850355854096995"}, {"status": 
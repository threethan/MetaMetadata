nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPEI_pTaqZcQ7kNvwHN6YCJ&_nc_oc=Adp4YsMFQYgal4cq6bqbtkEyF-vlDCgley6SUion8VARIaArWixNnwYaO9Q0g6dR5hk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgyaA83T_xIQuGKXxGf2Zm5zryc44dCGXbnYy5cjhwGQ&oe=6AF9C4EB"}, {"file_name": "migrated_image.png", "id": "594078311188275", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982525_2824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3wvvQvoWw8Q7kNvwGbY4yB&_nc_oc=Adqc4iZcwOObnknvb6MpmwmkiKI7rzFL1VnmrLhAktHSRQHquXKvUBMq4rhY6QIPSRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2ezo-rV8sNXTyLwZysrS9-y_D1VpuGVCt9JUJyl7qBg&oe=6AF9E377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmuM25OW9-IQ7kNvwH35Rok&_nc_oc=Adoir6Cakum-mZgplVz21OTInX1KahzhbPbRiTcuPqCWPbLgjkutYjczGn7C0e4HMQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfYnppqIMymcyU_Q-JGJO8V7-NEUaJX1lUathaKlqkPg&oe=6AF9B7C4"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_d
{"data": {"node": {"__typename": "Application", "id": "2582932495064035", "organization": {"id": "1983432211729700", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "6635285643223819"}]}, "id": "1065760137914857"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2582932495064035"}]}, "id": "652241688519775"}]}}, "firstRevision": {"nodes": [{"application": {"id": "2582932495064035", "release_date": 1568271600, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 69}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29640163752247543"}, "id": "2663787176993925"}]}}, "binary": null, "live_binary": null, "created_date": 1792027065, "id": "29545528655044387", "is_initial_release": false, "name_with_fallback": "v111", "pdp_metadata_with_fallback": {"version": 78, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29545528645044388"}, "release_status": "RELEASED", "id": "2582932495064035"}, "id": "29545528645044388", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2582932495064035", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2268481463507685"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2409223612945022", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30ea\u30a2\u30ebVR\u30d5\u30a3\u30c3\u30b7\u30f3\u30b0", "keywords": ["\u91e3\u308a", "\u5b9f\u969b\u306e", "\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3", "\u30ea\u30e9\u30c3\u30af\u30b9", "\u30b0\u30e9\u30d5\u30a3\u30c3\u30af"], "long_description": "\ud83c\udfa3 Real VR Fishing\u3067\u5fc3\u5b89\u3089\u3050\u3072\u3068\u3068\u304d\u3092\n\n\u65e5\u5e38\u306e\u55a7\u9a12\u3092\u96e2\u308c\u3001VR\u3067\u4f53\u9a13\u3059\u308b\u7f8e\u3057\u304f\u7a4f\u3084\u304b\u306a\u4e16\u754c\u3078\u65c5\u7acb\u3061\u307e\u3057\u3087\u3046\u3002\n\n\u30c8\u30ed\u30d5\u30a3\u30fc\u30d5\u30a3\u30c3\u30b7\u30e5\u3092\u72d9\u3063\u305f\u308a\u3001\u5c71\u3042\u3044\u306e\u6e56\u3067\u306e\u3093\u3073\u308a\u904e\u3054\u3057\u305f\u308a\u3001\u53cb\u9054\u3068\u967d\u3060\u307e\u308a\u306e\u6d77\u5cb8\u3067\u8a9e\u308a\u5408\u3063\u305f\u308a\u2015\u2015\n\nReal VR Fishing \u306f\u3001\u3044\u3064\u3067\u3082\u3042\u306a\u305f\u3092\u5f85\u3063\u3066\u3044\u308b\u7279\u5225\u306a\u7652\u3057\u306e\u5834\u6240\u3067\u3059\u3002\n\n{1559442568587526}\n\n\ud83c\udf0e \u5e83\u304c\u308b\u5192\u967a\u306e\u4e16\u754c\n\n\u97d3\u56fd\u3001\u30a2\u30e1\u30ea\u30ab\u3001\u65e5\u672c\u3092\u821e\u53f0\u306b\u3057\u305f40\u4ee5\u4e0a\u306e\u7f8e\u3057\u3044\u91e3\u308a\u30b9\u30dd\u30c3\u30c8\u3067\u91e3\u308a\u3092\u697d\u3057\u307f\u307e\u3057\u3087\u3046\u3002\n\nDLC\u30d1\u30c3\u30af\u3067\u3055\u3089\u306b\u5192\u967a\u3092\u5e83\u3052\u3001100\u4ee5\u4e0a\u306e\u30ed\u30b1\u30fc\u30b7\u30e7\u30f3\u3068300\u7a2e\u985e\u4ee5\u4e0a\u306e\u9b5a\u305f\u3061\u3092\u767a\u898b\u30fb\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u3067\u304d\u307e\u3059\u3002\n\n{1262184301915712}\n\n\ud83d\udc1f \u6210\u9577\u3057\u3001\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3001\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u3057\u3088\u3046\n\n\u521d\u5fc3\u8005\u304b\u3089\u719f\u7df4\u30a2\u30f3\u30b0\u30e9\u30fc\u3078\u3002\n\n\u81ea\u5206\u3060\u3051\u306e\u30a2\u30d0\u30bf\u30fc\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3001\u6c34\u69fd\u3092\u4f5c\u308a\u4e0a\u3052\u3001\u5e0c\u5c11\u306a\u9b5a\u3092\u91e3\u308a\u4e0a\u3052\u3066\u8155\u524d\u3092\u62ab\u9732\u3057\u307e\u3057\u3087\u3046\u3002\n\n{1067400745227822}\n\n\ud83c\udfa7 \u3042\u306a\u305f\u306b\u5bc4\u308a\u6dfb\u3046\u5b8c\u74a7\u306a\u91e3\u308a\u4f53\u9a13\n\n\u304a\u6c17\u306b\u5165\u308a\u306e\u97f3\u697d\u3092\u6d41\u3057\u305f\u308a\u3001\u30a6\u30a7\u30d6\u3092\u95b2\u89a7\u3057\u305f\u308a\u3001\u52d5\u753b\u3092\u8996\u8074\u3057\u305f\u308a\u2015\u2015\n\u91e3\u308a\u3092\u3057\u306a\u304c\u3089\u3001\u30ea\u30e9\u30c3\u30af\u30b9\u3067\u304d\u308b\u6642\u9593\u3092\u81ea\u7531\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u3002\n\n{663152086699265}\n\n\u8ffd\u52a0\u6a5f\u80fd:\n\n\ud83c\udfa3 \u6700\u59273\u4eba\u306e\u30d5\u30ec\u30f3\u30c9\u3068\u4e00\u7dd2\u306b\u91e3\u308a\u3092\u697d\u3057\u3081\u307e\u3059 \u2014 \u30dc\u30a4\u30b9\u30c1\u30e3\u30c3\u30c8\u3067\u7d20\u6575\u306a\u6642\u9593\u3092\u5171\u6709\u3057\u307e\u3057\u3087\u3046\u3002\n\n\ud83c\udfc6 2019\u5e74 Oculus \u30b2\u30fc\u30e0\u30fb\u30aa\u30d6\u30fb\u30b6\u30fb\u30a4\u30e4\u30fc\u53d7\u8cde \u2014 \u6bce\u6708\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3068\u5b63\u7bc0\u30a4\u30d9\u30f3\u30c8\u3067\u5e38\u306b\u65b0\u9bae\u306a\u4f53\u9a13\u3092\u304a\u5c4a\u3051\u3057\u307e\u3059\u3002\n\n\ud83c\udf1f \u3042\u306a\u305f\u306e\u697d\u5712\u304c\u3053\u3053\u306b\n\n\u672c\u7269\u306e\u7652\u3057\u3002\u672c\u7269\u306e\u7f8e\u3057\u3055\u3002Real VR Fishing\u3002\n\n\u6b21\u306e\u7d20\u6674\u3089\u3057\u3044\u5192\u967a\u306f\u3001\u3072\u3068\u6295\u3052\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\u3002\n\n{1325245985200835}\n\n\u3088\u308a\u591a\u304f\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3084\u60c5\u5831\u306b\u3064\u3044\u3066\u306f\u3001\u91e3\u308a\u4eba\u306eDiscord\u306b\u3054\u53c2\u52a0\u304f\u3060\u3055\u3044\uff01\nhttps://discord.gg/sUwKtzFvnM", "short_description": "\ud83c\udfa3 Real VR Fishing\u3067\u5fc3\u5b89\u3089\u3050\u3072\u3068\u3068\u304d\u3092\n\n\u65e5\u5e38\u306e\u55a7\u9a12\u3092\u96e2\u308c\u3001VR\u3067\u4f53\u9a13\u3059\u308b\u7f8e\u3057\u304f\u7a4f\u3084\u304b\u306a\u4e16\u754c\u3078\u65c5\u7acb\u3061\u307e\u3057\u3087\u3046\u3002\n\n\u30c8\u30ed\u30d5\u30a3\u30fc\u30d5\u30a3\u30c3\u30b7\u30e5\u3092\u72d9\u3063\u305f\u308a\u3001\u5c71\u3042\u3044\u306e\u6e56\u3067\u306e\u3093\u3073\u308a\u904e\u3054\u3057\u305f\u308a\u3001\u53cb\u9054\u3068\u967d\u3060\u307e\u308a\u306e\u6d77\u5cb8\u3067\u8a9e\u308a\u5408\u3063\u305f\u308a\u2015\u2015\n\nReal VR Fishing \u306f\u3001\u3044\u3064\u3067\u3082\u3042\u306a\u305f\u3092\u5f85\u3063\u3066\u3044\u308b\u7279\u5225\u306a\u7652\u3057\u306e\u5834\u6240\u3067\u3059\u3002\n\n\u3088\u308a\u591a\u304f\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3084\u60c5\u5831\u306b\u3064\u3044\u3066\u306f\u3001\u91e3\u308a\u4eba\u306eDiscord\u306b\u3054\u53c2\u52a0\u304f\u3060\u3055\u3044\uff01\nhttps://discord.gg/sUwKtzFvnM"}, {"images": {"nodes": []}, "id": "2169758653616740", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real VR Angeln", "keywords": ["Angeln", "Realit\u00e4t", "Simulation", "Entspannung", "Grafik"], "long_description": "\ud83c\udfa3 Finde deine Auszeit mit Real VR Fishing\n\nLass den Stress des Alltags hinter dir und tauche ein in eine der sch\u00f6nsten, entspanntesten Welten in VR. Ob du Troph\u00e4enfische jagst, an einem stillen See die Ruhe genie\u00dft oder mit Freunden an sonnigen K\u00fcsten angelst \u2013 Real VR Fishing bietet dir jederzeit deine kleine Auszeit.\n\n{1457784691976542}\n\n\ud83c\udf0e Entdecke traumhafte Orte\n\nErkunde 40 realistisch gestaltete Angelpl\u00e4tze in Korea, den USA und Japan. Mit zus\u00e4tzlichen DLCs schaltest du \u00fcber 100 neue Orte und mehr als 300 Fischarten zum Sammeln frei.\n\n{652926801065371}\n\n\ud83d\udc1f Werde zum Meisterangler\n\nVom Anf\u00e4nger zum Profi: Passe deinen Avatar individuell an, baue dein eigenes Aquarium auf und fange seltene Fische, um dein K\u00f6nnen zu zeigen.\n\n{1371435557425520}\n\n\ud83c\udfa7 Entspannung, wie du sie willst\nH\u00f6re Musik, surfe im Web oder sieh dir Videos an \u2013 alles direkt vom Angelplatz aus. Jede Session wird zum echten Moment der Entspannung.\n\nReal VR Fishing macht jede Session zu einem echten Moment der Erholung.\n\n{1027843179354074}\n\nWeitere Highlights:\n\n\ud83c\udfa3 Spiele allein oder mit bis zu 3 Freunden \u2013 inklusive Voice-Chat\n\n\ud83c\udfc6 Ausgezeichnet als Oculus Game of the Year 2019 \u2013 Regelm\u00e4\u00dfige Updates und saisonale Events sorgen f\u00fcr immer neue Erlebnisse\n\n\ud83c\udf1f Dein Paradies wartet auf dich\n\nEchte Ruhe. Echte Natur. Real VR Fishing.\n\nDein n\u00e4chstes gro\u00dfes Abenteuer ist nur einen Wurf entfernt.\n\n{1375221783785762}\n\nWeitere Inhalte und Informationen findest du in unserem Discord-Server f\u00fcr Angler!\nhttps://discord.gg/sUwKtzFvnM", "short_description": "\ud83c\udfa3 Finde deine Auszeit mit Real VR Fishing\n\nLass den Stress des Alltags hinter dir und tauche ein in eine der sch\u00f6nsten, entspanntesten Welten in VR. Ob du Troph\u00e4enfische jagst, an einem stillen See die Ruhe genie\u00dft oder mit Freunden an sonnigen K\u00fcsten angelst \u2013 Real VR Fishing bietet dir jederzeit deine kleine Auszeit.\n\nWeitere Inhalte und Informationen findest du in unserem Discord-Server f\u00fcr Angler!\nhttps://discord.gg/sUwKtzFvnM"}, {"images": {"nodes": []}, "id": "2140460373211341", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real VR P\u00eache", "keywords": ["p\u00eache", "r\u00e9el", "simulation", "relax", "graphique"], "long_description": "\ud83c\udfa3 Trouvez votre havre de paix avec Real VR Fishing\n\nLaissez derri\u00e8re vous le tumulte du quotidien et plongez dans l\u2019un des plus beaux mondes de la r\u00e9alit\u00e9 virtuelle.\n\nQue vous partiez \u00e0 la recherche d\u2019un poisson troph\u00e9e, que vous vous d\u00e9tendiez au bord d\u2019un lac de montagne ou que vous partagiez un moment avec vos amis sur une c\u00f4te ensoleill\u00e9e, Real VR Fishing est votre refuge personnel, accessible \u00e0 tout moment.\n\n{840837138358974}\n\n\ud83c\udf0e Un monde \u00e0 explorer\n\nLancez votre ligne dans plus de 40 lieux de p\u00eache magnifiquement con\u00e7us en Cor\u00e9e, aux \u00c9tats-Unis et au Japon.\n\n\u00c9tendez votre aventure avec des packs DLC et d\u00e9couvrez plus de 100 lieux \u00e0 couper le souffle et plus de 300 esp\u00e8ces de poissons \u00e0 collectionner.\n\n{1398490101346372}\n\n\ud83d\udc1f Progressez, personnalisez, collectionnez\n\n\u00c9voluez du p\u00eacheur d\u00e9butant au ma\u00eetre p\u00eacheur.\nPersonnalisez votre avatar, construisez votre propre aquarium et capturez des poissons rares pour montrer votre talent.\n\n{658246716992683}\n\n\ud83c\udfa7 Votre compagnon de relaxation id\u00e9al\n\n\u00c9coutez votre musique pr\u00e9f\u00e9r\u00e9e, surfez sur le web ou regardez des vid\u00e9os sans quitter votre lieu de p\u00eache.\n\nAvec Real VR Fishing, chaque session devient un v\u00e9ritable moment de d\u00e9tente.\n\n{1893311271410175}\n\n\ud83c\udfa3 P\u00eachez en solo ou avec jusqu'\u00e0 3 amis \u2014 avec chat vocal pour partager des moments uniques.\n\n\ud83c\udfc6 R\u00e9compens\u00e9 \u00ab Jeu Oculus de l\u2019ann\u00e9e 2019 \u00bb \u2014 avec des mises \u00e0 jour mensuelles et des \u00e9v\u00e9nements saisonniers pour renouveler l'exp\u00e9rience.\n\n{1818854532294968}\n\nRejoignez notre Discord d\u00e9di\u00e9 aux p\u00eacheurs !\nhttps://discord.gg/sUwKtzFvnM", "short_description": "\ud83c\udfa3 Trouvez votre havre de paix avec Real VR Fishing\n\nLaissez derri\u00e8re vous le tumulte du quotidien et plongez dans l\u2019un des plus beaux mondes de la r\u00e9alit\u00e9 virtuelle.\n\nQue vous partiez \u00e0 la recherche d\u2019un poisson troph\u00e9e, que vous vous d\u00e9tendiez au bord d\u2019un lac de montagne ou que vous partagiez un moment avec vos amis sur une c\u00f4te ensoleill\u00e9e, Real VR Fishing est votre refuge personnel, accessible \u00e0 tout moment.\n\nRejoignez notre Discord d\u00e9di\u00e9 aux p\u00eacheurs !\nhttps://discord.gg/sUwKtzFvnM"}, {"images": {"nodes": []}, "id": "1633393411492702", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ub9ac\uc5bc VR \ud53c\uc2f1", "keywords": ["\ub09a\uc2dc", "\ud604\uc2e4", "\uc2dc\ubbac\ub808\uc774\uc158", "\ud790\ub9c1", "\uadf8\ub798\ud53d"], "long_description": "\ud83c\udfa3 \ub9ac\uc5bc VR \ud53c\uc2f1\uc5d0\uc11c \ub2f9\uc2e0\ub9cc\uc758 \ud734\uc2dd\uc758 \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!\n\n\uc7a1\ub150\uc740 \ub4a4\ub85c\ud558\uace0, \uc81c\uc77c \uc544\ub984\ub2f5\uace0 \ub9d1\uc740 \ud658\uacbd\uc5d0\uc11c \ub09a\uc2ef\uc904\uc744 \ub4dc\ub9ac\uc6cc\ubcf4\uc138\uc694.\n\n\ub300\uc5b4\ub97c \uc7a1\uae30 \uc704\ud574 \ub178\ub825\ud55c\ub2e4\uac70\ub098, \uc0b0 \uc18d \ud638\uc218\uc5d0\uc11c \ud3b8\uc548\ud55c \uc2dc\uac04\uc744 \uc990\uae34\ub2e4\uac70\ub098, \ud587\uc0b4 \uac00\ub4dd\ud55c \ud574\uc548\uac00\uc5d0\uc11c \uce5c\uad6c\ub4e4\uacfc \uc774\uc57c\uae30\ub97c \ub098\ub204\uba74\uc11c \uc5b8\uc81c \uc5b4\ub514\uc11c\ub098 \ub9ac\uc5bc VR \ud53c\uc2f1\uc744 \ud1b5\ud574 \ub098\ub9cc\uc758 \ub09a\uc2dc \uc5ec\ud589\uc744 \ub5a0\ub098\ubcf4\uc138\uc694!\n\n{689180270504366}\n\n\ud83c\udf0e \uadc0\uc911\ud558\uace0 \uc544\ub984\ub2e4\uc6b4 \ub09a\uc2dc \uacbd\ud5d8\n\ud55c\uad6d, \ubbf8\uad6d, \uc77c\ubcf8\uc744 \uc544\uc6b0\ub974\ub294 40\uc5ec \uac1c\uc758 \uc544\ub984\ub2e4\uc6b4 \ub09a\uc2dc \uba85\uc18c\uc5d0\uc11c \ub09a\uc2dc\ub97c \uc990\uaca8\ubcf4\uc138\uc694. DLC Pack\uc744 \ud1b5\ud574\uc120 100\uac1c \uc774\uc0c1\uc758 \ud658\uc0c1\uc801\uc778 \ub09a\uc2dc\ud130\uc640 300\uc885 \uc774\uc0c1\uc758 \ub2e4\uc591\ud55c \ubb3c\uace0\uae30\ub97c \ucd94\uac00\uc801\uc73c\ub85c \ub9cc\ub098\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\n{2813914058794893}\n\n\ud83d\udc1f \uc131\uc7a5\ud558\uba70 \ub098\ub97c \ud45c\ud604\ud574\ubcf4\uc138\uc694!\n\n\ubaa8\ub450\uc5d0\uac8c \ucc98\uc74c\uc740 \uc788\uc73c\ub2c8\uae4c\uc694!\n\n\ucd08\ubcf4\uc5d0\uc11c \uc804\ubb38\uac00 \ub09a\uc2dc\uafbc\uc774 \ub418\uc5b4\uac00\uba70, \uac1c\uc131\uc774 \ub118\uce58\uac8c \uc544\ubc14\ud0c0\ub97c \uafb8\ubbf8\uace0, \ub098\ub9cc\uc758 \uc544\ucfe0\uc544\ub9ac\uc6c0\uc744 \ub9cc\ub4e4\uc5b4\ub098\uac00\ubcf4\uc138\uc694! \uc5d0\ud53d, \uc720\ub2c8\ud06c \ub4f1 \ub2e4\uc591\ud55c \ubb3c\uace0\uae30\ub97c \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n{1743257429589084}\n\n\ud83c\udfa7 \uc644\ubcbd\ud55c \ub09a\uc2dc \ub3d9\ubc18\uc790\n\n\ub9ac\uc5bc VR \ud53c\uc2f1\uc5d0\uc11c\ub294 \uc6f9\ube0c\ub77c\uc6b0\uc800\ub97c \ud1b5\ud574 \uc88b\uc544\ud558\ub294 \uc74c\uc545\uc744 \ub4e3\uac70\ub098, \uc720\ud29c\ube0c\ub97c \ubcf4\uac70\ub098, \ud31f\uce90\uc2a4\ud2b8\ub3c4 \ub4e4\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\n\ub9ac\uc5bc VR \ud53c\uc2f1\uc744 \uc990\uae30\uba70 \ud790\ub9c1\ud558\uae30 \uc815\ub9d0 \uc88b\uc740 \ub3d9\ubc18\uc790\uc785\ub2c8\ub2e4\n\n{1726361528294011}\n\n\uc774 \uc678\uc5d0\ub3c4!\n\n\ud83c\udfa3 \ucd5c\ub300 3\uba85\uc758 \uce5c\uad6c\ub4e4\uacfc 4\uba85\uc774 \ud568\uaed8 \uba40\ud2f0\ud50c\ub808\uc774\ub85c \ub09a\uc2dc\ub97c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4! - \ubcf4\uc774\uc2a4 \ucc44\ud305\uc744 \ud1b5\ud574 \uc18c\ud1b5\ud558\uba70 \ud2b9\ubcc4\ud55c \uc21c\uac04\uc744 \ud568\uaed8 \ub098\ub204\uc138\uc694.\n\n\ud83c\udfc6 2019\ub144 Oculus \uc62c\ud574\uc758 \uc2a4\ud3ec\uce20 & \ud53c\ud2b8\ub2c8\uc2a4 \uac8c\uc784 \uc218\uc0c1 - \ub9e4\uc6d4 \uc5c5\ub370\uc774\ud2b8\uc640 \uc2dc\uc98c \uc774\ubca4\ud2b8\ub85c \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4.\n\n\ud83c\udf1f\ub2f9\uc2e0\ub9cc\uc774 \ub9cc\ub4e4\uc5b4\ub098\uac08 \uc218 \uc788\ub294 \ud589\ubcf5\ud558\uace0 \ud3b8\uc548\ud55c \uacf5\uac04\uc774 \ub2f9\uc2e0\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub9ac\uc5bc VR \ud53c\uc2f1\uc5d0\uc11c \ub2f9\uc2e0\uc758 \ud589\ubcf5\ud55c \uc21c\uac04\uc744 \ub2e8 \ud55c \ubc88\uc758 \uce90\uc2a4\ud305\uc73c\ub85c \ub9cc\ub4e4\uc5b4\ubcf4\uc138\uc694!\n{1775247389872768}\n\n\ub354 \ub9ce\uc740 \ucf58\ud150\uce20\uc640 \uc815\ubcf4\ub97c \uc6d0\ud558\uc2dc\uba74 \uc800\ud76c  \ub514\uc2a4\ucf54\ub4dc\uc5d0 \uac00\uc785\ud558\uc138\uc694!\nhttps://discord.gg/sUwKtzFvnM", "short_description": "\ud83c\udfa3 \ub9ac\uc5bc VR \ud53c\uc2f1\uc5d0\uc11c \ub2f9\uc2e0\ub9cc\uc758 \ud734\uc2dd\uc758 \uacbd\ud5d8\uc744 \ud574\ubcf4\uc138\uc694!\n\n\uc7a1\ub150\uc740 \ub4a4\ub85c\ud558\uace0, \uc81c\uc77c \uc544\ub984\ub2f5\uace0 \ub9d1\uc740 \ud658\uacbd\uc5d0\uc11c \ub09a\uc2ef\uc904\uc744 \ub4dc\ub9ac\uc6cc\ubcf4\uc138\uc694.\n\n\ub300\uc5b4\ub97c \uc7a1\uae30 \uc704\ud574 \ub178\ub825\ud55c\ub2e4\uac70\ub098, \uc0b0 \uc18d \ud638\uc218\uc5d0\uc11c \ud3b8\uc548\ud55c \uc2dc\uac04\uc744 \uc990\uae34\ub2e4\uac70\ub098, \ud587\uc0b4 \uac00\ub4dd\ud55c \ud574\uc548\uac00\uc5d0\uc11c \uce5c\uad6c\ub4e4\uacfc \uc774\uc57c\uae30\ub97c \ub098\ub204\uba74\uc11c \uc5b8\uc81c \uc5b4\ub514\uc11c\ub098 \ub9ac\uc5bc VR \ud53c\uc2f1\uc744 \ud1b5\ud574 \ub098\ub9cc\uc758 \ub09a\uc2dc \uc5ec\ud589\uc744 \ub5a0\ub098\ubcf4\uc138\uc694!\n\n\ud83c\udf0e \uadc0\uc911\ud558\uace0 \uc544\ub984\ub2e4\uc6b4 \ub09a\uc2dc \uacbd\ud5d8\n\n\ud55c\uad6d, \ubbf8\uad6d, \uc77c\ubcf8\uc744 \uc544\uc6b0\ub974\ub294 40\uc5ec \uac1c\uc758 \uc544\ub984\ub2e4\uc6b4 \ub09a\uc2dc \uba85\uc18c\uc5d0\uc11c \ub09a\uc2dc\ub97c \uc990\uaca8\ubcf4\uc138\uc694. DLC Pack\uc744 \ud1b5\ud574\uc120 100\uac1c \uc774\uc0c1\uc758 \ud658\uc0c1\uc801\uc778 \ub09a\uc2dc\ud130\uc640 300\uc885 \uc774\uc0c1\uc758 \ub2e4\uc591\ud55c \ubb3c\uace0\uae30\ub97c \ucd94\uac00\uc801\uc73c\ub85c \ub9cc\ub098\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4!\n\n\ud83d\udc1f \uc131\uc7a5\ud558\uba70 \ub098\ub97c \ud45c\ud604\ud574\ubcf4\uc138\uc694!\n\n\ubaa8\ub450\uc5d0\uac8c \ucc98\uc74c\uc740 \uc788\uc73c\ub2c8\uae4c\uc694!\n\n\ub354 \ub9ce\uc740 \ucf58\ud150\uce20\uc640 \uc815\ubcf4\ub97c \uc6d0\ud558\uc2dc\uba74 \uc800\ud76c \ub09a\uc2dc\uafbc \ub514\uc2a4\ucf54\ub4dc\uc5d0 \uac00\uc785\ud558\uc138\uc694!\nhttps://discord.gg/sUwKtzFvnM"}, {"images": {"nodes": [{"file_name": "Landscape_Halloween2026_Red.png", "id": "4436723866577215", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628454_4436723869910548_1794824831735987599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk8w51gW2M4Q7kNvwFMpD9U&_nc_oc=Adrp3Gz-oHL-iW45urNKz0Mcu6FS5uPppGDCIYmIlm_WcODOeH1Th47qgDok6hc-kKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc0FXDPmOKMeZdItOJGWt9Sgw_yH1NJ9p5pha-cm9nAQ&oe=6AEB5FF7"}, {"file_name": "Halloween 2026_Banner_1008_1440.png", "id": "2353479628772621", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622186_2353479632105954_143586019834517465_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5MQNz8-BmcQ7kNvwE1JDVV&_nc_oc=AdqrZSEw1zGKBJnPf1c0AMCpSV6L3FsgygiTXGP019pDHGlRn5X-ocae4WXPtrI9Dlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpQvNWp1UxJ2gRleXylSQwRL_-7ByZ_bbGFq4MDP4J2w&oe=6AEB3127"}, {"file_name": "Halloween2026_Red_1440_1440.png", "id": "1681043763383756", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620559_1681043766717089_5712512944039473645_n.png?_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV5bEMi-kDsQ7kNvwGaPN76&_nc_oc=Adq66NErjctD2__oC6n1i0d-jKpwg2RR04QxKWPuPq-qTuPxftM3-kv6iZhWBtPlMho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgjmEqqZat1yrxl-Fu-0eOIIefefvCmybZJGTO-0NwoA&oe=6AEB639B"}, {"file_name": "Halloween 2026_Logo_Blue.png", "id": "1637138394444873", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624069_1637138397778206_6532006148279080417_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7ldxmRG1IUQ7kNvwEb6SE1&_nc_oc=AdqRik3SNA7buxtXRexEbJ79cOdy
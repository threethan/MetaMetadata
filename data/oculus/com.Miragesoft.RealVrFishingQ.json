nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAWqTbwCqJEQ7kNvwEWqgrE&_nc_oc=Adq44oikyMYrzduF_jQxolYx_4pg4iLOnoeoSQf_mHy7aYg-iaovVacMjfRa7oG4QII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbVyUplAR60qM8X_x4sI5Gjk9kd_beCrh1IErZs12NHA&oe=6AAFF0EB"}, {"file_name": "migrated_image.png", "id": "594078311188275", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982525_2824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgbJgPoRx04Q7kNvwHkF6yH&_nc_oc=Adq7j521V9oxI6j8hpFBKEJkDSZ-c_eRIrRBXE9kF8_rY0GnQac3LET9uQLvHYUOPNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRSMTmOe8F0PY-gUgPbkMeojEdaErMJ6EniuLZ4L4nFg&oe=6AAFD737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaxtNI4Tv0wQ7kNvwFZS73p&_nc_oc=AdoAL45ySKRin4xdZllZhUWw0FNUoL7IssDqNaOlv8ibLBVgkk_-hOUPXVLTvUW-EZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIICWuS9AL-bm3f_LR8za2MQC2hMp9EBblba3hHW47VvQ&oe=6AAFE3C4"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_d
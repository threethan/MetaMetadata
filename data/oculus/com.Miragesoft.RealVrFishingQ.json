f20f&oh=00_Af97nfKTuM6Tkm3TZegELF46Er6agj-GfuXEZETv3T7R_w&oe=6A341719"}, {"file_name": "migrated_image.png", "id": "2734247443309921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974589_661395317699485_5778569568360333312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1b5KEL8qooQ7kNvwEZQ3Ly&_nc_oc=AdpbJe_FfG9do9IiK3vWRXwC041hS1cadu2-14BXQ1p1oLxd8zihTya3iyfwWSVunZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b2IieBC-6MZQRf9MhWLdWQGnJXu117WUT-jYDQhi93g&oe=6A3403EB"}, {"file_name": "migrated_image.png", "id": "594078311188275", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982525_2824541644273154_8698816286446059520_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMQgeAmBV7EQ7kNvwELn1sM&_nc_oc=AdorIbmis0o3JCS94s-pGSWMwXl3Fqji66AvtBPFXRm5WUt6QlJEVDLDkPlbDsyRPYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rYnNmA25_Bs9gU5vfrhtWJVJfuOG9Ncz7GJm3H7gy0Q&oe=6A33EA37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qycSJ3", "id": "2465508130337936", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982481_2465508133671269_6855444622542372864_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jITxXg4Zbs8Q7kNvwGGWO71&_nc_oc=AdrJyA07y4Qm9wvnwdOzlv2hZpmoKgc-psvlilwrkRRGaPLI54XFluCk9lpDFi6iTmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3nNeo2B8-rwEw8emtmW_G9dqtj2VDaaPe_XJpiB0Mvg&oe=6A33F6C4"}, "display_name": "Real VR Fishing", "keywords": ["Fishing", "Miragesoft", "RVF", "RealVRFishing", "VR"], "long_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!\n\nFeatures\n- Photorealistic environmental 3D graphics\n- 72 Hz Mode and graphics option \n- 15 lakes and rivers in real world\n- In game music player (MP3)\n- Aquarium decorations\n- Leaderboards\n\nMore to come (Subject to change)\n- Multiplayer\n- Multi Language support\n- 5 New sea fishing locations\n- Fishing tournament PvP", "short_description": "Real VR Fishing offers the most realistic and relaxing fishing experience. You can explore beautiful fishing grounds and catch a variety of fish in real world while listening to your favorite tunes in the background. Or you can just sit back and relax at anywhere you want enjoying the scenery and the sounds of nature.\nHappy fishing!"}]}, "developer_name": "MIRAGESOFT, Inc.", "developer_privacy_policy_url": "https://www.realvrfishing.com/", "developer_terms_of_service_url": "https://www.realvrfishing.com/", "publisher_name": "MIRAGESOFT, Inc.", "support_website_url": null, "website_url": "https://www.realvrfishing.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1926611330874728"}}]}, "scheduled_offers": {"count": 67, "nodes": [{"status": "PUBLISHED", "id": "977612308562878"}, {"status": "PUBLISHED", "id": "26061553060212783"}, {"status": "PUBLISHED", "id": "1992216428344415"}, {"status": "PUBLISHED", "id": "1623239179095108"}, {"status": "PUBLISHED", "id": "850355854096995"}, {"status":
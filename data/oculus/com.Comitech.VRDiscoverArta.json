_nc_ohc=DG2SmP2YwMMQ7kNvwEYRZwO&_nc_oc=AdlK7yewzND33VlD0X1lD-NASiWk0bFvIjBWQnVfL0mLPEUcuEGY9teu0ubCI70tz2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulMI53zu7Rdw2BUyGOQdnfJM9dvjM53a_n7DieH56JXQ&oe=699B0258"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCI4hP8Z_1kQ7kNvwG6DgFv&_nc_oc=AdkH1gzdderv07cz3BXz0Fk_uDsSz27AIh30mq49ng30mxj3uzTdnTjdXfOWiImd5OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsI7dGkvKHLzc-xb8OiuNbT_DWT9JYVK-E7k_TSmhBi8Q&oe=699AF516"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5QmHKJL4YgQ7kNvwGEOq0O&_nc_oc=Adm1E93Fmda8CGJJqDBvUilBhvxrvxnD-GioJHeSJPT9FFIsNkkw7_BDyUbCboMMN8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspkBr_iU0PxFG7kioa_m4cz0G77FErTeIMU6cKikHUPQ&oe=699AFF00"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N-B4r6_alYQ7kNvwEMlcgF&_nc_oc=Adkf4mQkmtJGajNSohi6XXlk5dEI-HQ9mSd8tQf0FQEcAm_mgzQUBtdc8DiI3HriLmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft6T5KvmEaX_pBmAF8sVabmQWX2hv8POZBWw2ABBcPdsQ&oe=699B0725"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F5z3bDpAyQQ7kNvwH20aZY&_nc_oc=AdlXOn-_nTSggjBxQ9vrFatO-qiLbOLNVqVpyidQsFbqbcdg-bnb7Tb8mAoHdUdrl8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oc
_nc_ohc=IEm0Ox4HmoUQ7kNvwGs5xnH&_nc_oc=AdmM2Tkvu01ebaJg4RhbwKAp3-SEmHj5MIDACsI5BP3lNDtWOCITRJqDLpbyFbYhqSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afub9KBHLN_Gfp9vFqO-nN2x0pjlaa1plnPpya2uoaaJig&oe=69985F58"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1juwzhr41DYQ7kNvwHXXczE&_nc_oc=AdnhuGtkdEcWK7eTxcvyk5T726G11snSh3ad7rm5doXx-EgF00we8YT2ko1o6oCizM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftkFODO5Fw9FD5_fBT17ZjGMsRV7UzOHPUJbs9q41vxcw&oe=69985216"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lJ5XopH1vIQ7kNvwFySjxF&_nc_oc=AdkUR5fajY7VL5LbhKdFV2_QnbP3O9BM0ncSdDLXj9kY8PtOrv62gJSIW6rU3JgvlqQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuUsfUblc4Tiv6FCY4dHgZ-S2Z6yTmGoEp7Z9cOfQll1g&oe=69985C00"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gZb33eqkXkQ7kNvwEra6FA&_nc_oc=Adn2nq741h5PVot-cXb6gzhevqZg5uxaOuUQH6beuGjBxsMoePapp0dsbFkVgdfjHLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftRdHuetFIHclzoaIMlcj-FFOMIWWsU_iE3UHU1IS3UGQ&oe=69986425"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wnfLyPV1sQ7kNvwE1M8eo&_nc_oc=AdlOd0-OJDfm27OMKQaORDor3k1VViW5jKOAxh9rF7L8hVETvS-tqT3O339O7LldELE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oc
om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oErhJPIkBgQ7kNvwGybseA&_nc_oc=AdqeSIRJq6KS_boc2_15m01lEtb_gWKrsRmCWpohOU9Q2s7NvdFiGJRYUw-d6enzQQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34Sfl89V6ZXGACZMkxBzIE0I0sx8J48UpEJmpAuW3aSg&oe=69EA1C58"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p3EHcI1yusQ7kNvwHmouCt&_nc_oc=AdoTdQO_RqhRqKXb4LbhOCUHf_kW2gyvzAtsXAA_lithGpqJIsDYADkKq4SiVHtGFSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AL8Md6ym3KR_RgHVzQbm344Yr8HaVVQPVRCu1y7Eiow&oe=69EA0F16"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp9kyLB5WscQ7kNvwGpy3sC&_nc_oc=AdoHl4fS0V8FE0-ftAHlJfl3cteaV6EG1uCgHA0bbaTcKtlCIzq6UJDOKV7F_Mqg_4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WE_U_OQ4K2cIe292uQ1sjC8uKQ6-iIgfjXjU0RomXag&oe=69EA1900"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvgAVSknWHIQ7kNvwE_sFCI&_nc_oc=Adql2Frvrho_NnvPbR1YXa4NOAHxaQaXjRsJMCL8HU2IRCPnM3oARLmwXqj0EcHh7Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rrin7utzSt_w1Zt_BG3zxyyRfcR3Zz6QZSuTUBuXpAA&oe=69EA2125"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
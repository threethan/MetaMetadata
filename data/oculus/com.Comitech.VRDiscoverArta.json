om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66KVmF1j3kAQ7kNvwHa7pID&_nc_oc=AdofoVXm9uBUtQYuro-h7bBFT0awhhflxd8Y8IfLwIsYnTeOm5JIBsgeBVb2B9aFHAg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE0pyNnI9wQ1coutXX-339bvfWKfQLf39FoqTvLNMilA&oe=6A5A2BD8"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51488TmfBc8Q7kNvwELUG9M&_nc_oc=Adphw9dM-xZZIOuLOvcr3do8cztdE15j2v06sB5fe8AkQl8cNUcVbsx6dqzG4H8O5fc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtos9G77cKbnaNLWWS1qpADBpJWt9k6nFQV6bT-b5OJQ&oe=6A5A1E96"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRRPwDEPJf4Q7kNvwG_MRmD&_nc_oc=Adrn90l6T_Vtl0k178da6myCUU_KniwmOUzr3659HipXai23hn8dqM0pVdcO8NOAKkI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEPJNB8orD505yVcJmlq-QpqxhNyiC8msra2FbMIabkg&oe=6A5A2880"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNRaRcZz_B8Q7kNvwEuGZz7&_nc_oc=AdrdGXtAZcDd6Fk4Q7JV8caf9NT9js15cD3qQ8bdkpyvlUvJwUbH-pTxdRxUJhJJnzI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDx9R6b3GN7XCCCwpQjSnifqAHYQvW3ebGkfY8ff5c0w&oe=6A5A30A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
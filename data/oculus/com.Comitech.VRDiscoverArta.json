_nc_ohc=4EvSV7zkQ4wQ7kNvwEAWd8C&_nc_oc=Adk3Yj4Rm2UAVWe_BXYvyRdxv-BeekfFq37oAYEFUkTD8Kuc2HO-4UKUbtEgwDGO72s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPraXYebB0mly0tw0J6UWnT7-VP03xHx8wSKo7MqOeqA&oe=69A2EB58"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5So2UwkWaIYQ7kNvwGiyUIB&_nc_oc=AdkvFcu63gv2_Sp9JQpphlUuL2sagQevrk6bcRL8058x0rpe3LHElTYqKch5ZUM_WKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfpJ4UHv89syLb64MQWKBrkyoCBdocTQClvLFjBHFMuA&oe=69A2DE16"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIF07XhHEsAQ7kNvwGkXVRJ&_nc_oc=AdneWBTb2fzQDgFFWUGlLhYzAHV-slSWwRtgDqGSUff8BjpwtC9MQCmuh5gL79unNoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumKMweJMBqB7hEZFiJpjrP5FZxGXgCeZCHc_NiG9T4PA&oe=69A2E800"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiiVZwE65ZYQ7kNvwG5Y6N7&_nc_oc=AdlE1aXJHXphI-Ie3fF3FATcRx_P0EJUy6_S24nxrY6L64MTumRsovoRQFyvztjEyE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_bMlhkvShlJemTS0DXs-m20-EJHmDIetbdK9TdTHzQg&oe=69A2F025"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0ie58aHSSIQ7kNvwGIPTpa&_nc_oc=AdlRebYQWzGmLnAiquhWNXp2oEG4e5S33stFsOZS_sDxm03VKw-BvoKt8OOB01hSn5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oc
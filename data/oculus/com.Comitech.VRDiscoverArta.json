1324110618948020", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb8k1LeFg9kQ7kNvwFAzsDW&_nc_oc=AdpkZCLv5bZ_RsYu3y1KwTctzI5YlMppnkavPujo6jlcbd_VK_d4TaLjdKscWrlpKy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSW2jgmSmzxDXp7nyGk25XbIHZPE8asTXo_CxQtEwUtJA&oe=6B0B3816"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IJrPUkm0tgQ7kNvwH0UlWn&_nc_oc=Adr6SuD7h1t9FSX6gqX7M4AwISYL1dzqGplZP3xGJSNaa5x_9EWffC3eUN0_QCrQDjA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThxwUfn8sP4eQTNjzWHms1xegpu0hYFCw_NGpQqEDQrQ&oe=6B0B4200"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUpKG6-eBjUQ7kNvwHTxQk1&_nc_oc=AdpGz_G5aHg-Jn10h3aEWDUjdUL-_JflxTQztFrYurHqSXV9OPiKcBX_aBtoeBYn9pQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcq3dIHcvhptI73Zghw5tKSBKnvWpnOfgHrHKbQFxXlw&oe=6B0B11E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1393654831938276"}]}, "baseline_offer": {"id": "1393654831938276"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735632240, "status": "PUBLISHED", "id": "1393654831938276"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9222065224527399", "version": "2.0.17"}, "id": "965401092067577", "channel_name": "LIVE"}]}, "
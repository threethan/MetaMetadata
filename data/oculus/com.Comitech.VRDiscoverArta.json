UZ4FcUjKPtkA&oe=6AC3B2F1"}, {"file_name": "64crop.png", "id": "8228457773921419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8c9SFd_m4sQ7kNvwG2QNCK&_nc_oc=Adq6BVGpg5992TBs06-5RgTi7bErOnbjvsSQEWYjjEPlUAeRU0ursbU3aDCot069ELA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN11_oIAX_yIFPOQtky0f94kYbqe12dnaioLcj8XbWRzw&oe=6AC3DC18"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5BhRZzGkKsQ7kNvwExyxu-&_nc_oc=AdooV0JK1HgDjnW6RlRYYP1cxViUZUUsz-kgUfCCgXEtVo5Y9ZMiGIIMtY9UmSS4ymw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAjDl1wjqnxnUhKY6G5nZU0LhQmiyHA8f-aA6cVzutrw&oe=6AC3CED6"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr3Ha-fFXrAQ7kNvwHRYuOT&_nc_oc=AdrlWGKnMd-U1hqCstvqCNhQ2ZjLAv2eTwhGGUnhXdKI2yHHYyAXke0q4suTWP_lADs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH-kms_c9A560OW_P578FBz6CJzx8sAoyPn32h_ch84Q&oe=6AC3D8C0"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjAQDiU6_CoQ7kNvwEePc41&_nc_oc=Adpfc9amH8zf1v2taGckIEAfQr7TEHe8hsq0qFTGSNhHq23JfR8jUKsosgbGPU2NNco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN95GgFurSos0OrTYXQjdEdozS5KEJiVlfPLxim9PvBwg&oe=6AC3A8A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ia
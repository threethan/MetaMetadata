_nc_ohc=OTuN7Y8AuOcQ7kNvwHcpIiE&_nc_oc=AdkUoABwR-FoNo27Emdu9vI9h9cM1BREPM728ZNxaU2Jlkw1ElgulJfaGhAceBi4vK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afst1dSN0RHyxGel95GpA2a3ebFew7A4xqxkWwCuCexD5g&oe=69A04858"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7TbhrOm4R8Q7kNvwGIwWhp&_nc_oc=AdlkPbuRXVg1gjG4oGhFK-yv0stmDKTOhLn-QPuUAJA5EGRJDSU5cCkAmvE7U7QuWQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgMe6vyTAwD9HDNqSAaDAFB94ZFSMxjgVB_7cUg0Kdsw&oe=69A03B16"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh-cWLiyUZcQ7kNvwFWD63B&_nc_oc=AdmeimUiur4Ky5GhX_Fkvmea9C5XBmDjaNiIyPUIS1Z-Z6OKDJeDiW5vGYmCVJcSVp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afve5EJYizcHgDKzvSTYgKHuR1GVepWSpmtUjNHxKErtlw&oe=69A04500"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4o0lQYYPZoQ7kNvwHmZmTd&_nc_oc=AdlXep7xYpT0UGp2lfI9PO-wGfCUDRohRH27EizI1k9Zs45uTgVQm_swVnBnhg7Vtrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7kiGWlrf2HjQKYVLng06V-YcF-I6j9mCle6Pz6wCluw&oe=69A04D25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkQZtYMHrNsQ7kNvwEHy-Nr&_nc_oc=Adk-oAutbX_5tx0oPfzB6l06fn5xyUqKRv-pnNOD5rhfYzmaJOelsYSNIIPzoU1hZBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oc
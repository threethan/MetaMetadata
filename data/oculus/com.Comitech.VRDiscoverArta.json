_nc_ohc=DG2SmP2YwMMQ7kNvwET2bUh&_nc_oc=Adlhv6SvntEPbmS-UpQ6DRhHCtW9zcDAuxBOalv5Tvbp_5KYA2T-SzyAB6JeHiIDCE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsXVV8cAEQglbrgA7XZr3LFBX6iFyiR4Jcwo5LICr4rhw&oe=699DA558"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7TbhrOm4R8Q7kNvwHHdW7j&_nc_oc=Adm964EZopi6EqOOMgMyhxRkpfk-88wME46rd4HdmFwEiI4Mua9glfg4F4ZrGsE9wvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu36hqEdSOlb-0DfLPTUx_ArMhZVJDiskhP5enPCuhFQA&oe=699D9816"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh-cWLiyUZcQ7kNvwHECmyM&_nc_oc=Adm2Mu7ql2kJW7YklWhrzsGqeCbkOQG3BA9Ul-a5q2XqxcYTV_mYTDUxCJMuzR19hS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm0Xp7c2sMpFODFTePEQ3snde_pKId5bKIUq9eWRXhwQ&oe=699DA200"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4o0lQYYPZoQ7kNvwE6rAbx&_nc_oc=AdkizcdtCEX3QK2vUv8AKlTjcy7BmU8ILknANvY7MPHB0-ns86lK66kcedS_jGW0Pmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftf57nrU8M7Nd2q_fC5uPA10sJYMecCjIUlfNh7CfwSAg&oe=699DAA25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F5z3bDpAyQQ7kNvwGEAZ2P&_nc_oc=AdmDQZ2IgtH_jPgdA412EZwSbdLbkYcE-62pjCE5u8w_9646W0JJddeSFNNkcn2_FKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oc
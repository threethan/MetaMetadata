om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvjFeT89e5cQ7kNvwE_F2c1&_nc_oc=AdpSV3MYQw0AsysVpSefNpn7-WLjaEIkL32-WSqSsAMgekFXumyLCqLWdKeOmQRUvxQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zcVQaWlKaeM_mAhj_-RbHpbMvg6krb3ItZUGY7ZKA8w&oe=6A12FAD8"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2BQznyhH-8Q7kNvwHtMKHT&_nc_oc=AdoodgyZ0E8R9LEEnGB7eKoWDdR4ma45CqcIg3Q9H1CkRAkTTmUI7RaabwrdDVLQXnk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LUEd5YugBx1IO8VIR3q2S7UkrTjPL9G3speCYvpDLAQ&oe=6A1325D6"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceUkgdjNjzUQ7kNvwHvHz3r&_nc_oc=Adq0VzWlSXC3ZUEH2tmRYWkIA34Ux5QNVegS0o8C165rcIsOTJb9Id2yYzO9LTFmpsk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f2HVCEbMAZGnZ0g5h-v12inOQ8WqlYR2do94qPWacJQ&oe=6A12F780"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DFhdLTyk40Q7kNvwEhfa1o&_nc_oc=AdpsFiBn1CRg4AJLNK7jR_c0CjvmolQbJkX5KJzagbARRnKWGIh8gOfOjV7W4Y6TB7k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hqjk806EpH7d6pWykBKPRwONpb2Di7TuRnlu-X_YeRQ&oe=6A12FFA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
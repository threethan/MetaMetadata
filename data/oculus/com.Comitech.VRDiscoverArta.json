wd340aO6pc1g&oe=6AD384F1"}, {"file_name": "64crop.png", "id": "8228457773921419", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZE97fWmGBEQ7kNvwFWCYWY&_nc_oc=AdoH67g1JU9m35QH2dqydbqXmX2X1uGvPQpugaGa5Sy_kV9NeUWYQeABw8qEGb5p1JQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPenVYFytCraPofvcaNBsFh6Z4E6LuxIt3MsY7sB6lxg&oe=6AD3AE18"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHEhYQSnQzwQ7kNvwG541px&_nc_oc=AdpYt2E1iyZZuw75Rp4XCKtTI8Mu3S9kRZ3ClpW2H2Du-9lvym2YwI5-yjoHdAAJc9s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4Bw7xV7xKZPD4TVk4qsAu4cBiIXLmfp8wSu9IlrVasg&oe=6AD3A0D6"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vatQRhLctQQ7kNvwF0n9rz&_nc_oc=AdoI3LsW193pNiPfgNZOCc5LiCbkcWwZ5DxWbXuLvTDLh84xRhbRALuEVmsLIDpx6gE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDS9--uTweXULVx46anRt2gXki82SyqdkX908d47KqvQ&oe=6AD3AAC0"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S80oMukI3f0Q7kNvwGyLDCm&_nc_oc=AdpUdYc2BuzRVtbTHMEM_Uzlv_f0pp1bpe82j91eFtQwkXgTjmv6bOucusDJgXhtJUs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOJxpDzc_PVZgjx7F9L8T1o69-PjUVHomShhaSaFcfbA&oe=6AD3B2E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-df
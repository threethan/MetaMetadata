om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1GdtgK5OWQQ7kNvwEDEXTg&_nc_oc=AdrxjmuDJcf-G2dijGnVfKxTWh-E3vsdMTrBpprAbro-r35labXlN-X_UZhn2nNjMuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WtdZGilrr-1b7E8C5iTdGy7EgV3vrwvJJWbH85Awc4Q&oe=69DCED58"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1S1nJJ-HvAQ7kNvwEApj9O&_nc_oc=AdoFdYKm0xoL9UiOM3sZWaT3uEvsgxU_HAQTWNADzO5m1kg2xsMbl1gSz55-hXGzFJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LmbYV9Ke12DNZPZVAeHdnQYT6VFA9ynlDnByXmk8hkw&oe=69DCE016"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14NurqD_77EQ7kNvwGgg7Nd&_nc_oc=AdohpPK6QsN9uTkAhpTwyHvwxecMBDAnE5k0k4NEdjYXUhzlcJEZ52swOfukFd33Uz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZIUKiSftfkRzXOjo7a4lgirt8R4regJ-Cq9zwzn0Rfw&oe=69DCEA00"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RvVxQqR7LEQ7kNvwFvYQSL&_nc_oc=Adr__GfjmF9_QSk2Uu-bgI4i8aXT99_GxRJfYGpNdlp0vXMknfty1m0AJ6r-MXXSHy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XZvlyCDQsTGKy2Y2TgTfNvnWWMYXmPK9mLRhUuyY69Q&oe=69DCF225"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
7787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I2l7KJdbEsQ7kNvwGkZkPj&_nc_oc=AdmfUhrDEezgw-jrMBituNtfjRn74Jn4Ca1Vt3o-XicnDSklSlEx8198dIRCEcZf0Ao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb6ev_xBIV0fpDCRtaIyaYSfyFo3PF_eDzw48gx264Cg&oe=69AEC8D8"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DL8VslVXp8Q7kNvwGfKMii&_nc_oc=Adl5UKTiosDXseI-1FIv9n_Ly3O2IWw9JLJuYWhdGDh6licQyP-4uMusdJo7mHf_uX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGp8_Aj0hYjvYbny-wqeXvimpxYUA9LL1EgyN2LOzqww&oe=69AEBB96"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1mYak9gtawQ7kNvwHr7VcI&_nc_oc=AdmKY5cP1XBjbkvFtPfPE3ZjwAPYC06i-XB47F734LlS9-FCvsL5jBY3kiR3ufBAmWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPH1MEAqGmyuWzJeBwnxShX_RaWL_hAU4-hdMdsYpUdw&oe=69AEC580"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6TbDo4SJBMQ7kNvwHSHfa7&_nc_oc=AdnRrEqYW-ppCJ8e9zNjDB0GMJaebL2051PRZlJuqzhgawZvV3NRIyXLYdWO0ql4KkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCch0AAcZe_si9PXgNfS5YGBy0OjgcKvMCou7hzJtFQg&oe=69AECDA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuhdGGyC7-QQ7kNvwHimcS-&_
U0Ipv5meJG_w&oe=6A7C49B1"}, {"file_name": "64crop.png", "id": "8228457773921419", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztTwupcfZTcQ7kNvwHAm35U&_nc_oc=Adpm8zAPuzMAo-VpM0oiRCVxvVzCucgWkGFu1cZJ2VEuyb-AiMW533ieqM_dWX7A7MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdurHr-R0YJnhrbEHNvsA6LU0PAtuOmE2gvCXUI_ZAXw&oe=6A7C72D8"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A648eKudlqIQ7kNvwHNHubZ&_nc_oc=AdqvNARbN5WOIS8fo7CATsIECfmGoFMwB6CDAw7MUeIzFeNfm0pTUlV7CGBS9hTbleo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI1I7qnfs1K7lI524sUALJ_nEnu6gCjUYbvIkTPnT49w&oe=6A7C6596"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXwFFz1xRyYQ7kNvwHMhxza&_nc_oc=AdqpoYW7N-M7E2uDBDQ0kGAAQfhYyboJos-n5ai7BcyNvYOxuBrFLgt-81pG5Osvogk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXAOaDrczOr-bgnqDR3CqSHA3-wWhBwuMWk-nw4_IAXg&oe=6A7C6F80"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8moJXMdu-qcQ7kNvwHq23QK&_nc_oc=AdqhMdRqNAK14mBO5lPE3fR52qVN_illFW4zb-v5cn8RbLBFBU_hoIe9o_xClX8MWMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECf_oSySAw4RgYGYma1diqlDv29_nYpVxZCFOlUJYYoA&oe=6A7C77A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ia
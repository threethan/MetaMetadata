om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnzQ_JrfaQYQ7kNvwFDzBCa&_nc_oc=AdoVSutDa4QY8p-gVKuwS-aPnBwOB_BF5lkDzHv-6AYhDNUUY-OOQLs6hcp_khLFbFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9Yrq329RPzOx7JhI0tQPaay2DcM7mPFwT_dDGxDBtoA&oe=6A490858"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6XEk9echUQQ7kNvwENbowi&_nc_oc=Adqrglt0yQtPaix-NEcIL-NTjCCFLIpEk2baroVpGt8gWsIeYEJGwAxvp_8mNXWCI3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApvDjzfOJ6fKdEk4UeH9GY-dmDokoA5w-xYnsEV7upTg&oe=6A48FB16"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdK5HhqvcFQQ7kNvwEkXazR&_nc_oc=AdoTybLnviCNaKnxPxlkXbxZIpsoVgvSlrnVzS8c9ev8a7Qj_qf-Gd0yXLomvXjChiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr_nqTPJaaRswqUUJSJW_hPVhNVvxM3zMQwcCFq5KNUw&oe=6A490500"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxfz7vzxNYIQ7kNvwEe3Ju0&_nc_oc=AdqjyYdL9J9h86QtwbqwIFMPojfZKgf_7Z2d-w6hpGvTTlEYPtwmq-U0bUmBrErsFnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCepPLB1u77t3xOioueKplWvrxoXgHvQikSLUzty9b8_w&oe=6A490D25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
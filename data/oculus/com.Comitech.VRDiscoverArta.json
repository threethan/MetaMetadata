scdn.com/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8hp-8jUlIcQ7kNvwFW-hcD&_nc_oc=AdoWUmQV5lue7v4O2pANnSu0xunYGMv3Me_ySjfApW2L7uj5SvPMwnqlwLZnlRb_FZQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JD3eTIK9z2KI3EGbfmG7tQZlIp2YjYBQxeaMw5_4ilQ&oe=6A393658"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J40MEEpHDoMQ7kNvwHvcSSK&_nc_oc=AdoEGYu3_u9xyLEvdS0Wqx7gbM5p7hrS53gl5Gm8TtpD_icxUPcjw_J35Isv9OeTwOw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PDqlnfLkd-YCQb9Dmx-JD0onYMuXamwaW8XLeMXHHtQ&oe=6A396156"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQAl8ryzgFwQ7kNvwFJmuGC&_nc_oc=Adr4SX2G5QCUJl5Khh6iSR3Qfd1KBRFOGYfRWksf9e7myyOA_Fp0zTat4ALkCTxmXVE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zq47DJSgIfse5fUVRfy82O0ddbRylhdJdJGM43jwUhg&oe=6A393300"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8VTcktgJDwQ7kNvwEa8wvQ&_nc_oc=AdqzWiPz1gcw88dAl-bGfrakOelctP3ZcrL6GUsJB9eEMJx2v8RV9zz2CsYEAI3b9AA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af870WJB1YOAfc1_rOD6iTv3k0bvRbHs8lLflMx9jGO76Q&oe=6A393B25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&
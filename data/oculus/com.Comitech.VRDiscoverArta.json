2d7vu3UXfD2PYBk-TGW10Aw&oe=69B01700"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6TbDo4SJBMQ7kNvwHaT6CY&_nc_oc=Adl2skWsCmeeEcX-dTAxi26-TxYWYRYsAh2E6y_Y9SOp5spaSYNO7G87rRsPK8K1zDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwML0CJVLd6TyK8OQ3-8Xs7k7sSMCc-q12Ks8QCTMMM7Q&oe=69B01F25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
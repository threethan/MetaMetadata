om/v/t64.5771-25/39031400_8228457787254751_3226732814620035493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDHD6showrQQ7kNvwG_S7XW&_nc_oc=AdpT05LHX4S2_eiqO5GktdOsg_NtZ9e75YRhV5hfW59wg8ob_TQ5Oy6cIQ3-IvODlvo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d5DK_XS4mbMWWhXqCCaN0Z9IuBEtJQsweOi3BgevocQ&oe=69D7A758"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwRl6jO6XsgQ7kNvwEs1kcw&_nc_oc=AdroBOZdgQbMCBBKt-fx4mp-2VmPsV7G_6By1qD4xAITud1KmmW_LEPIRWNXKF6mq7w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_WWd8xsRRKuBwq_2Jl2vuwKpwMh3jIqCdZQNMdhz6MA&oe=69D79A16"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ_sujYJqawQ7kNvwGXdStH&_nc_oc=AdoUK1mRItUDAMevx-O0IRIOvsX6vpMT_xn2DOq1gETclrBqzLiJq8Woo_l2D3MEB8Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30RSv4QE8X2alQfKUgDE9EcfuWMWHz4-IGEoTa4XEc2g&oe=69D7A400"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTKFaF2LqV4Q7kNvwFTiJzU&_nc_oc=Adr5I2G09S8n0uHNJxcp2QvBPzIK3KMmzyYQVS4pdKsrtO1CCcZua9-M_YeJriUi1E4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hAiJXzHIHmAoMdzDzGbNB3b9KxLJ7YNMfmLU5Cm23iw&oe=69D7AC25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&
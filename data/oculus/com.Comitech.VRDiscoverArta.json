10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn_XtVAQ9poQ7kNvwF1nbsi&_nc_oc=AdqU1QTXyQBqC_7wl62rNqnXP_Rk4WbHbumxRsUaUwG-NVT6tV_Vefb5WXETnQ05fyc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38oMimiFwXu4JwkZU6n7WaeFH2b132tvnAPVD_tAWwKA&oe=69F20558"}, {"file_name": "2crop.png", "id": "1324110618948020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982689_1324110622281353_3659838586201764427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5pu4rwFMTUQ7kNvwEpdciq&_nc_oc=Adog1i2dWyXGm3NHKhFtmD-TevkjtYR0Avehk1XKajHKwo9_K4ku0zV7_vPc-NjToSU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gB8f4RXfa6-MBcZ3ayuuPubkiQ3V_brBNQwzy-3A_pg&oe=69F1F816"}, {"file_name": "1crop.png", "id": "588116870259220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569424_588116873592553_7893651829968513013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm6Tm0Nut9cQ7kNvwHUrlPd&_nc_oc=AdoLP4qLKTa-vsdAEy3S8M1MSm-IfAF9bRO3-z7tfAWxEoWwjmUxO_7bGwjuHoSEx4Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af23v-Le3Ame00tQfQkSgn7UCCgAWXfdNgEUi-DLcKGjMA&oe=69F20200"}, {"file_name": "62crop.png", "id": "2000498370363604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86666493_2000498373696937_1244902855804760889_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghlfccfdNygQ7kNvwF82KnT&_nc_oc=AdqGPv6t8o1E64-h-Y9BbY1AYa0madL4-kYhAUov7Jfh18BjDDluL7N6Nl2DmuWSKNg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1PWhH8Gm3om-WUQ81J9HdnzUBMqQb5xjcHZqct-F2XMw&oe=69F20A25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discover Arta VR", "keywords": [], "long_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality.\n\nThe two monuments were digitized through the exploitation of photogrammetry, reconstructed and integrated into the 3D virtual space. With appropriate scenarios and directorial proposals, we created the virtual reality application which is available for use through modern smart devices and special glasses as well as via the internet and a personal computer.\n\nThe first level of the VR application allows the free navigation \u2013 movement of the user in the virtual space that represents the monument in its current state. In the second level, through the employment of gamification techniques, we tried to present digitally the legends that surround these two monuments.", "short_description": "Two emblematic monuments of Arta, its Historical Bridge and the Church of Panagia Parigoritissa, were represented in three dimensions and integrated into experiential applications of virtual reality."}]}, "developer_name": "Comitech", "developer_privacy_policy_url": "https://comitech.gr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Comitech", "support_website_url": null, "website_url": "https://comitech.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9259772954089959"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001686_562678036396043_1972369955915746162_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4pjppa3n_sQ7kNvwG6uqzb&_nc_oc=Adp1x6EauHN_AsI1YSph3Rytv-zuNR68paUnkz4eyYhsyD2s49
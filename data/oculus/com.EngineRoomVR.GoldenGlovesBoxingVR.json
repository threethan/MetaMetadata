27980777919", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821682_4328527984111252_4353480782940298169_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjme6CZPsrQQ7kNvwHpPeIg&_nc_oc=AdpH3D0KURQF2BMEmGZCoSNVS-KAl2Esm2Pp7Pvk2wfZ0nMOLb3JSbxm4cnD68CAkHU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLazPmGUCpS3_kGtecKWNYmGxPhGFBIek_X_kuJux8sCw&oe=6AB669EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled (2560 x 1440 px) (2560 x 1440 px)-8.png", "id": "1675777170303900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301236_1675777173637233_2850037635925175361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPnLF-PHNSoQ7kNvwEITmSC&_nc_oc=AdoSTStvwWNrC5Ey5bHX7H2xQKfMcdb-JIFe2yKsJMOXru8gHDEJE3lxP8Lczks9Nc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9-MlMGi_pGLpcab_B0zbCQtKQCrYdDaI_X8G6tYHKXQ&oe=6AB687DB"}, "display_name": "Golden Gloves", "keywords": ["fight", "fitness", "boxing", "fighting", "Training"], "long_description": "Step into the ring with Golden Gloves VR, the official game of Golden Gloves of America and the official esports platform of USA Boxing.\nTrain like a fighter in immersive gyms with realistic equipment, sharpen your technique, and get one of the most effective full-body workouts in VR. Work the heavy bag, speed bag, double-end bag, and uppercut bag. Each one uses physics built to match the real thing for an authentic boxing experience in virtual reality.\nTake on our viral Mitts Challenge: test your speed, timing, and accuracy, chase high scores, and challenge your friends. Then face AI opponents or step into real-time multiplayer sparring against players worldwide.\nWant more than a workout? Enter our cloud-based official tournaments, climb the rankings, earn prizes, and compete for a path that leads all the way to the USA Boxing National Championships.\nWhether you're a boxing fan, fitness enthusiast, gamer, or aspiring champion, this is your way to play, train, and compete.\nPlay. Train. Compete.\n", "short_description": "The official game of Golden Gloves of America and the official esports platform of USA Boxing. Train like a fighter in realistic VR gyms, work the bags and mitts, and get one of the best full-body workouts in VR. Face AI or spar real players in live multiplayer, then enter official tournaments, climb the rankings, and compete for a path all the way to the USA Boxing National Championships. Play. Train. Compete."}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://goldenglovesvr.com/contact/", "website_url": "https://goldenglovesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28624097480530825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819323_2168691320633285_2460888739820553095_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh9iadxqlj0Q7kNvwFgVKoO&_nc_oc=Ado_0ri-RJvHhFBo6vcv4_daDG6n4nHmsfvdSeKSbxbizdemMHpkG0aSoXe3pI8dyec&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQ
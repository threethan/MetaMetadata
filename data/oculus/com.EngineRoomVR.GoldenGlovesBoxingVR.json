23132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFufyL-w1JYQ7kNvwHQum_V&_nc_oc=AdqHKlr0zJ7mgxFPFqyftFhvqnKbu31DaQk1IvNchpbOVhpceevAqyz3pnfQ_X_pcOo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQQZaGllZA_0E8Ibm61uG-8xQAZcj31rNdn7fCCfiUJw&oe=6A8ED3FF"}, {"file_name": "Screenshot_GymScene_02_2560x144.png", "id": "449773693401688", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982563_449773696735021_610680784429811519_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcWCTZd8Mv0Q7kNvwEWJCNN&_nc_oc=AdofK12KpBZQTnLgBg978977J_nNcq_pOBQU_e3PgphUtmZtY1mTCnsC0DriW3RZPl8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhqzhSJdiS1pIFm2XH1yiznqiXobu0JMokVfLevqxx0A&oe=6A8ECFED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Golden Gloves VR", "keywords": [], "long_description": "Play, train and compete with Golden Gloves VR.  Building on 100 years of history, we\u2019re proud to bring the most recognizable brand in boxing into the digital world. Train like a fighter in our virtual gym, as you immerse yourself in the most realistic boxing experience you\u2019ll find outside of a brick and mortar facility. Starting as a novice boxer, you\u2019ll follow a career path, working your way through the ranks to become a Golden Gloves Champion. Developed by Engine Room VR, a gaming company owned and operated by a licensed and certified boxing coach, promoter, and gym owner, Golden Gloves VR is designed to create a realistic boxing experience. Learn the fight styles and personalities of each of your opponents as you advance through the ranks, perfecting your own boxing skills. Train for competition, using our state-of-the art boxing equipment, with physics that perfectly mimic the real world experience. Enhance your virtual training with our online support.", "short_description": "Play, train and compete with Golden Gloves VR.  Building on 100 years of history, we\u2019re proud to bring the most recognizable brand in boxing into the digital world. Train like a fighter in our virtual gym, as you immerse yourself in the most realistic boxing experience you\u2019ll find outside of a brick and mortar facility. Starting as a novice boxer, you\u2019ll follow a career path, working your way through the ranks to become a Golden Gloves Champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://goldenglovesvr.com/contact/", "website_url": "https://goldenglovesvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "SPORTS", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "764126677968971"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "2107268956578779"}, {"status": "PUBLISHED", "id": "1396858452489471"}, {"status": "PUBLISHED", "id": "2775864819461604"}, {"status": "PUBLISHED", "id": "1684886206175692"}, {"status": "PUBLISHED", "id": "953462480911121"}, {"status": "PUBLISHED", "id": "1341196874570209"}, {"status": "PUBLISHED", "id": "1955066225081297"}, {"status": "PUBLISHED", "id": "1305679284666743"}, {"status": "PUBLISHED", "id": "1366235927999315"}, {"status": "PUBLISHED", "id": "1351186236798487"}, {"status": "PUBLISHED", "id": "12894773991068
r4BEZTUxlh5Ptw&oe=69DE49DB"}, {"file_name": "Personnel Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "318606470607909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462203_318606473941242_2069377265779416031_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKaNsaMX4JwQ7kNvwEM5SAj&_nc_oc=AdoPgIwE18dN5bNvnISJw_i7TbnwJ1ndOvr1M8mtEf1ixmf44dz1ZHVrvVwrJf4xPq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34WcytcTXxeD6bNH8_Zp_ECadX4GtUmq-8A26YpyKy8w&oe=69DE4CBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Personnel Lift Safety and Operation_Screenshot_03_2560X1440.png", "id": "1262747585122664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982478_1262747615122661_7123573789308580412_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYSTz5bHAUMQ7kNvwF5nVrl&_nc_oc=AdqBHQ0XIAPx_alXNQ5icEh1gVNSNG4UZL9SqUr4S-B9I12Guc8RxuUb_ChDWhJWsA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MCbF3a2aoUa6zdVMTVgNDchlKuodGhAuVAWevGYid1w&oe=69DE4A9B"}, "display_name": "Personnel Lift Safety and Operation", "keywords": [], "long_description": "Personnel lifts are versatile and lightweight vehicles that help workers reach heights up to 50 ft. safely and efficiently without the need for ladders or scaffolding. Various industries, such as indoor construction sites, factories, and warehouses, use these lifts to perform tasks at height, such as maintenance, renovations, and stock picking.   \n\nBackground Primer & Activities:  \nAn overview provides participants with context and helps identify different types of lifts, related parts, safety concerns, tipping lines, fall protection requirements, and the basics of a walk-around inspection. Then, participants engage in a sort-and-match activity to learn the central controls and steps required for starting up. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.  \n\nParticipant Simulation:  \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a personnel lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the warehouse. They must then navigate through the warehouse, collecting task items and repairing them at different heights and locations.  ", "short_description": "Personnel lifts are versatile and lightweight vehicles that help workers reach heights up to 50 ft. safely and efficiently without the need for ladders or scaffolding. Various industries, such as indoor construction sites, factories, and warehouses, use these lifts to perform tasks at height, such as maintenance, renovations, and stock picking.   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1517532409004458"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
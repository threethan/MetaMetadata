4841_1477194853104726_852043408037924955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWD7AwdIsMIQ7kNvwFrHMBR&_nc_oc=AdprB-3pY2R-kKrysiLBGqDPZTeXpHghgAm0phe8JB7AkhNh3N4wbqNgfYwqSbyPysI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsCJOtux0hSYuI9IaBVOKqyVX0XXw0cLoQsa2AwU1odA&oe=6AFB461B"}, {"file_name": "Personnel Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "318606470607909", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462203_318606473941242_2069377265779416031_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aif2rrQn3_4Q7kNvwFD6AXL&_nc_oc=Adqhi32BmVyt9YCnZPUunwdJfAk5A7-2BftYmW97DdiH10VDlMeqoNRJHvKQCjMK-yg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwb8ZYlgMwknIF5Hg0iiDbD9uv8wB0QzgVbvoMWdlN1A&oe=6AFB48FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Personnel Lift Safety and Operation_Screenshot_03_2560X1440.png", "id": "1262747585122664", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982478_1262747615122661_7123573789308580412_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu7VMQgnUqcQ7kNvwHoZw2y&_nc_oc=Adq3R29_3NERzxEIJZ8OuWGBw6kVD78Llg420bVcPdZ7z2f70wGECV6ppkNKvumSJ08&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj-OnKaPh23S9fRcm5OPmW1eczYkm5bMGQHYkUF6DW4A&oe=6AFB46DB"}, "display_name": "Personnel Lift Safety and Operation", "keywords": [], "long_description": "Personnel lifts are versatile and lightweight vehicles that help workers reach heights up to 50 ft. safely and efficiently without the need for ladders or scaffolding. Various industries, such as indoor construction sites, factories, and warehouses, use these lifts to perform tasks at height, such as maintenance, renovations, and stock picking.   \n\nBackground Primer & Activities:  \nAn overview provides participants with context and helps identify different types of lifts, related parts, safety concerns, tipping lines, fall protection requirements, and the basics of a walk-around inspection. Then, participants engage in a sort-and-match activity to learn the central controls and steps required for starting up. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying.  \n\nParticipant Simulation:  \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a personnel lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the warehouse. They must then navigate through the warehouse, collecting task items and repairing them at different heights and locations.  ", "short_description": "Personnel lifts are versatile and lightweight vehicles that help workers reach heights up to 50 ft. safely and efficiently without the need for ladders or scaffolding. Various industries, such as indoor construction sites, factories, and warehouses, use these lifts to perform tasks at height, such as maintenance, renovations, and stock picking.   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
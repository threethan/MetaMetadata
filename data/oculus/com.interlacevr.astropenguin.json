5771-25/491822550_867871682253328_8259237567937196688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM5F1eTLzJ8Q7kNvwFkch_2&_nc_oc=Adp49tKnQ7b7XUbKGWGj-Ha-gzriswN42eT3ztfQXd1u8FMHGOjtlOBXBcZRCB89mnw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w29ioCym8muk6dXD9k_aIzVMW2r4EamNIeFV7aJDb0w&oe=69D7B2E9"}, {"file_name": "f9def9db08584e4584cae62766818a1a.png", "id": "1270205565147910", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827960_1270205568481243_3795161829109422694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_47g0-iUP0sQ7kNvwFr8WE3&_nc_oc=AdprXEazK4TB6YMbt-OIU2PUUDZAdPwbloTMGSiTMlpaXqOstCkHpWGh0uo3m_vM5WE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-bnr_BYQNMN28_XQzmTeQrBFKPhnLo2XKP0z8Ce7cEw&oe=69D7999C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f763aa0857754878a1aa0baa4c822193.png", "id": "1887493012186786", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304764_1887493015520119_8852669086761048292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYfSJaL9HAEQ7kNvwEIhmqH&_nc_oc=AdpJ45hZ__cSKttVWpAxlvvZ6GQqBdk6jKF_2Idbq0cFrj2J7xrEhoXcH8YNz1V2Ku4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eEg9t0p7zLoWqzHAWpgOjtZGQ6miopnS9vUOJKNx4Gw&oe=69D7B8F1"}, "display_name": "Astro Penguin", "keywords": ["platformer", "adventure", "penguin", "astro", "obby"], "long_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is an experimental VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings.", "short_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is a VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interlacevr.com/privacy", "developer_terms_of_service_url": "https://www.interlacevr.com/terms-of-service", "publisher_name": "Interlace VR LLC", "support_website_url": null, "website_url": "https://www.interlacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27674069382230626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820648_1528690981585532_3469938803066902405_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Udm14EegLYQ7kNvwHOgzic&_nc_oc=AdokXOXd6A2Z0Tj-qhlmffD5Lik4OBRGnqfrFn0m70wvK6gsyY5f2pebhBEyf7QVwVM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k5g9soJtjbyOZv-s0CHJPzB_9B9nle936-P1UUiqTFg&oe=69D7BBDC"}, "is_concept": false, "is_test": false, "i
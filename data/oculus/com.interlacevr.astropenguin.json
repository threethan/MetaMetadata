ontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1270205568481243_3795161829109422694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkeNDWodjUQQ7kNvwFb_lQ_&_nc_oc=AdpXeUQVFYTf5s2XRoymsVzDBDGV10QQUCL0c1PKlgjS7hc0xIpR_QH_tzJ_quAGWL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A9pDPHq57SBhBIop89RObLwnNc2dXPBPq0StnlEtKkw&oe=6A380F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f763aa0857754878a1aa0baa4c822193.png", "id": "1887493012186786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1887493015520119_8852669086761048292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teSb3Q-F5LEQ7kNvwH-pqIU&_nc_oc=AdqTPI7sjbjwZxbgVGWJ5iEy0wPR6EIevpKG4PYq63TnQwc-PM_bYhF4jr7yQhAHN6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hxGF3c3mXBp-M4SO-CQtcIr9yW6QE5UNWIuVsaWOrdQ&oe=6A37F671"}, "display_name": "Astro Penguin", "keywords": ["platformer", "adventure", "penguin", "astro", "obby"], "long_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is an experimental VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings.", "short_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is a VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interlacevr.com/privacy", "developer_terms_of_service_url": "https://www.interlacevr.com/terms-of-service", "publisher_name": "Interlace VR LLC", "support_website_url": null, "website_url": "https://www.interlacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28098991843071709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1528690981585532_3469938803066902405_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McZIn8KtAxoQ7kNvwF5A29C&_nc_oc=AdqeVasRNufecMvTwVKpsTM2kBEElI3Alm0Hnm0QMAmk5eZpEB5_nnYi4_wxEhrVmdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qoeCHSNvOwAdHoNf48a6aH-TSZl8VzVJ1Lo47T8YCig&oe=6A37F95C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Astro Penguin", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1764949560, "lastRevision": {"nodes": [{"id": "2652838063013284
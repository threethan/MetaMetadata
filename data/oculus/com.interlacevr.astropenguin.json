9587073614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG9WkvGNRtAQ7kNvwHF0nug&_nc_oc=AdrJPhMvSl-Y2Kt0Zr8wUJi8i8NT9HlNh4Ze15u--5E1O6HDuatDp70W1xuQY1wcm8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFq0lJD8Xvm__lsEWYzW90L9aos8c5CwXuaYf8CZXzkQ&oe=6A7328ED"}, {"file_name": "11f3c7f8197a42639bb8a88a1b3ad355.png", "id": "867871678919995", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822550_867871682253328_8259237567937196688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqw1HDz--qEQ7kNvwHasn7z&_nc_oc=Adp7aDpVqmaIFYCvqw2cYHT39zue1WEiqOgjdPyE9z4wdhDTgW_5NTc8vyREyho7r5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5exOUvUdusoJTnh7xiQJr4nWSnXD0ejmnZ-4KVsupFA&oe=6A7343E9"}, {"file_name": "f9def9db08584e4584cae62766818a1a.png", "id": "1270205565147910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_1270205568481243_3795161829109422694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no81fn6TKBEQ7kNvwGhsvwX&_nc_oc=AdrpkRMRUV2HiD4j6_Ksibqmlj9XpQkSwtXtVnoN92gbvcb7hCydrV0wM97_2c8yqfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-bTyzJndzX7koUjXU-UENAjYdGb3gN5ip2GYKj-6DEA&oe=6A732A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f763aa0857754878a1aa0baa4c822193.png", "id": "1887493012186786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304764_1887493015520119_8852669086761048292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uN1GgmLgecQ7kNvwGGWvMh&_nc_oc=Adrbf7Yc26R5tG0-3jTmtQCB0gflPGlQC5SYxN5atQJ0AgFKkXweXgSSCh2jkKbsXh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqR5HK9mX-5lCwlTgIOpsAE91yTv-O_Kjv2U7Ldw7-MA&oe=6A7349F1"}, "display_name": "Astro Penguin", "keywords": ["platformer", "adventure", "penguin", "obby", "astro"], "long_description": "They say penguins make the best astronauts. \n\nThey can slide. They can fly. They can swim. They can fight if necessary. They will discover the truth.\n\nAstro Penguin is an online multiplayer sandbox with a focus on natural-feeling movement, such as:\n\n{1257807626257613}\n# THRUSTERS\nBlast off. Or make a fist and thruster punch rocks. Hi-yah!\n\n{1000882252873172}\n# WINGS\nGlide. Flap. Maneuver with physics-based flight.\n\n{1621442326232764}\n# WATER\nSwim. Body-surf. Waterslides.\n\n{2558701827892774}\n# DRIVE\nPilot vehicles across open worlds.\n\n{1189196490023446}\n# PLAY WITH FRIENDS\nExplore the penguinverse together. Or fight each other. Or play disc golf. Or go to a waterpark. Or more!", "short_description": "They say penguins make the best astronauts.\n\nPUSH THE ENVELOPE OF MOVEMENT\nFire thrusters. Flap your wings. Carve through the air. Swim through water. Grind along rails. Ride waterslides. Drive a moon buggy. Go surfing.\n\nPLAY ONLINE\nStart on the penguin moon base. Play Disc Golf. Fight each other in the Battle Box. Ride waterslides at Waves. Or leave the moon base, and explore.\n\nGO SOLO\nMars is melting! Join Captain Pebblesworth and go to Mars to discover the truth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interlacevr.com/privacy", "developer_terms_of_service_url": "https://www.interlacevr.com/terms-of-service", "publisher_name": "Interlace VR LLC", "support_website_url": null, "website_url": "https://www.interlacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
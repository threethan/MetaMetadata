205565147910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827960_1270205568481243_3795161829109422694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If4v34rBvxoQ7kNvwEhiXN5&_nc_oc=AdqtB8c-jah5KDq3-3LILoKAgRRif4e8Loy_rPkpOUmeffDkF7-EKsohJfJRn6z52sI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY3W0sZPyTULHUzEiCdSxe_Qi19WqGJw3ykMHydoFW7Q&oe=69C5249C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f763aa0857754878a1aa0baa4c822193.png", "id": "1887493012186786", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304764_1887493015520119_8852669086761048292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHMNoEDSiaMQ7kNvwEeHmTk&_nc_oc=AdqYBWIwGt2bAOX0BmiRsjYZ75YhuoW6D-Wi_RkqUhsbTEe38aYqi9QG_p87aMROSmg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxNDdPUqH-xsXWbLIbG6jQT34G6lY6NwOwb_9LtguUKQ&oe=69C543F1"}, "display_name": "Astro Penguin", "keywords": ["platformer", "adventure", "penguin", "astro"], "long_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is an experimental, single-player VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings.", "short_description": "MARS IS MELTING! \nIts icy poles dissolve into vast oceans, and\neerie green light floods the skies.\n\nBraving the unknown, penguin astronauts\nCAPTAIN PEBBLESWORTH and MAJOR BEEKMAN\nembark on a perilous mission to uncover the truth\u2026\n\nAstro Penguin is a VR platformer. Penguin astronauts have a range of locomotion abilities. They can slide, swim, glide, flap, carve, surf, rocket, grind, (stay tuned for more!). Explore Mars with realistic-feeling movement: feel the wind on your wings."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interlacevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Interlace VR LLC", "support_website_url": null, "website_url": "https://www.interlacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27347532054884362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820648_1528690981585532_3469938803066902405_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7h308p3FAQQ7kNvwEwqqhW&_nc_oc=AdqVe81nKTmXSKrrYboUlYi7GKTvgFQGV-KwSOWeS4t6kMp600biTFj4bV0GVFN-Yzs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzL7GTuAjykWhSf3qz4zt-ZKhSAv19cRqzq3xAUNYNrQ&oe=69C546DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Astro Penguin", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1764949560, "lastRevision": {"nodes": [{"id": "26528380630132846", "release_typ
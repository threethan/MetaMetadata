92063_317687439587073614_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_v-v3daFfEQ7kNvwHF_zFx&_nc_oc=AdpCUmXVhZl8DPMElNKprcry81m2Fi5mRo45Yc8vRdnjQctOLPWiqhZyB0UneddOS4g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB4cJmd4cMAD3sYJ7tF69kmZfbDgcS-PAlN7ZE6XJnZg&oe=6AA3F06D"}, {"file_name": "11f3c7f8197a42639bb8a88a1b3ad355.png", "id": "867871678919995", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822550_867871682253328_8259237567937196688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liOcRSuMohkQ7kNvwEquzwT&_nc_oc=AdrnVcsrre1RKAbA0_rKFLbyIHf3Ma9964j7V4KKySRqtrGsP5oGhAVEy9ujq6M76l4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1FXAQv6ZeoyGSuLBCYGu2o2Gk9pvPGFh3K2av1k_VvQ&oe=6AA40B69"}, {"file_name": "f9def9db08584e4584cae62766818a1a.png", "id": "1270205565147910", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827960_1270205568481243_3795161829109422694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH6pQklZR90Q7kNvwFvmsKd&_nc_oc=AdpqUjZBN9xhizNw6E_41wLeSo7sdVsoYE3yMMfSDahyYc030rCi0aXRXNoVD1S4Y34&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpIaJ9fVdEai4yJmV4wjH68ngjlaB_uRpPUapolIJA4Q&oe=6AA3F21C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f763aa0857754878a1aa0baa4c822193.png", "id": "1887493012186786", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499304764_1887493015520119_8852669086761048292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWjRcoBhdbYQ7kNvwGTmQP3&_nc_oc=AdosMt_nN2rJOzkhHVjFsGJ-vg6xeGd3ElFK6AtYV-xdyPdUa8RGO9DygRtc6nzyBvM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKRs-LENp7SHsmOLQq6KganDjWQdy3b01Qjnu2vRyimg&oe=6AA41171"}, "display_name": "Astro Penguin", "keywords": ["platformer", "adventure", "penguin", "obby", "astro"], "long_description": "They say penguins make the best astronauts. \n\nThey can slide. They can fly. They can swim. They can fight if necessary. They will discover the truth.\n\nAstro Penguin is an online multiplayer sandbox with a focus on natural-feeling movement, such as:\n\n{1257807626257613}\n# THRUSTERS\nBlast off. Or make a fist and thruster punch rocks. Hi-yah!\n\n{1000882252873172}\n# WINGS\nGlide. Flap. Maneuver with physics-based flight.\n\n{1621442326232764}\n# WATER\nSwim. Body-surf. Waterslides.\n\n{2558701827892774}\n# DRIVE\nPilot vehicles across open worlds.\n\n{1189196490023446}\n# PLAY WITH FRIENDS\nExplore the penguinverse together. Or fight each other. Or play disc golf. Or go to a waterpark. Or more!", "short_description": "They say penguins make the best astronauts.\n\nPUSH THE ENVELOPE OF MOVEMENT\nFire thrusters. Flap your wings. Carve through the air. Swim through water. Grind along rails. Ride waterslides. Drive a moon buggy. Go surfing.\n\nPLAY ONLINE\nStart on the penguin moon base. Play Disc Golf. Fight each other in the Battle Box. Ride waterslides at Waves. Or leave the moon base, and explore.\n\nGO SOLO\nMars is melting! Join Captain Pebblesworth and go to Mars to discover the truth."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interlacevr.com/privacy", "developer_terms_of_service_url": "https://www.interlacevr.com/terms-of-service", "publisher_name": "Interlace VR LLC", "support_website_url": null, "website_url": "https://www.interlacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
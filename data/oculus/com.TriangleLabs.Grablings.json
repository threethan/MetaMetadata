V-kcRKZY_wBltdQ&oe=6AA7E64F"}, {"file_name": "ScreenshotGrblngs1.png", "id": "888966593909474", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_888966607242806_4682549124730315397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO164v16IR0Q7kNvwGvz881&_nc_oc=AdreK--LK8qGunvxPnoqkNuE5gjWgalWIDe9Ql8tA_l6XkIR1IpeW6YwT1AtX1iXjQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1BrpAuvvwTHQeeYbex7kYVV3s6_NSZ60FyouR0cbZUQ&oe=6AA81574"}, {"file_name": "Screenshotgrblngs4.png", "id": "1585316586309464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1585316596309463_2054302158906423850_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgHpyrd8K6QQ7kNvwEY8C5C&_nc_oc=AdqhNqRms5YWUBt73bi2bAx4aET6wfH_paWgg0f8lYwsX2fzcHcUd1KE4DKb3aSiCOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjOnXM6bcIORpeY7n82AzlfMlTHVQbZBxfTP31O3Cdug&oe=6AA7EBFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grablings_KeyArt.png", "id": "1729569155114965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1729569161781631_9197492430050597798_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuFsCW8CfiYQ7kNvwEZLEYx&_nc_oc=Adr4gMXZtqlel3aD5kDgDJ1f3N98M2hJQlsPNYYsn7642MIoy9Kq8bMHn5zOOR8quKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-aE9wM0vtoSU68e0Qpz17o0GjSL3W2A-6rdTBFCdrFA&oe=6AA80876"}, "display_name": "Grablings", "keywords": ["Grablings", "seek", "hide", "chameleon", "paint"], "long_description": "**The multiverse is up for grabs!**\n\nPlayers become Grablings, interdimensional creatures who live for mischief and chaos. Their prime purpose in life is to have fun and wreak havoc across the multiverse, which they consider their ultimate playground.\n\n# Paint 'n Seek!\n\nIn their first adventure, the Grablings play silly games of hide and seek. Hiders paint themselves into wacky environments to avoid getting found, and the seeker(s) aim to win by finding all hidden Grablings!\n\n# Adventures To Come!\n\nPaint 'n Seek is not the only adventure the Grablings want to go on. There is a whole wide multiverse at their grabby little fingertips, waiting to be explored.\n\n# Join Our Discord!\nhttps://discord.gg/xpUmRQh3ZE", "short_description": "Become interdimensional Grablings to laugh, play, and have fun together across the multiverse. Paint and hide, or seek those who are hidden on their very first adventure: Paint 'n Seek!"}]}, "developer_name": "Triangle Labs", "developer_privacy_policy_url": "https://www.triangle-factory.be/grablings-privacy-policy", "developer_terms_of_service_url": "https://www.triangle-factory.be/grablings-terms-of-use", "publisher_name": "Triangle Factory", "support_website_url": "https://www.triangle-factory.be/support-form", "website_url": "https://www.triangle-factory.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "2004335083612015"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825257_5154714704671073_6314522352831241223_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwvpeVCf4NQQ7kNvwHoJH0J&_nc_oc=AdphUz7pIdXwDhItHxFxhJc48_ro76TJcP2vGBzOLrCYyicORpRWxnMDLYgeYPMWFz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLalF-1RKAyvlAo3etwYSIRs07ka5Yx
ablings!\n\n# Adventures To Come!\n\nPaint 'n Seek is not the only adventure the Grablings want to go on. There is a whole wide multiverse at their grabby little fingertips, waiting to be explored.", "short_description": "Become interdimensional Grablings to laugh, play, and have fun together across the multiverse. Paint and hide, or seek those who are hidden on their very first adventure: Paint 'n Seek!"}]}, "developer_name": "Triangle Labs", "developer_privacy_policy_url": "https://www.triangle-factory.be/grablings-privacy-policy", "developer_terms_of_service_url": "https://www.triangle-factory.be/grablings-terms-of-use", "publisher_name": "Triangle Factory", "support_website_url": "https://www.triangle-factory.be/support-form", "website_url": "https://www.triangle-factory.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1990595841652606"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4596483893957181"}]}, "baseline_offer": {"id": "4596483893957181"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787831040, "status": "PUBLISHED", "id": "4596483893957181"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2057213691657487", "version": "0.13.17"}, "id": "831947226522685", "channel_name": "LIVE"
=m-X17NcqofUQ7kNvwGmmDxK&_nc_oc=AdpJ2nMKD4XS-E4nZKH4Je9pch1xkqIc_bCehJOTD8FaaghYvsItbLoFlk9a86E-hhw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-MTya6ErXixSUph8OJa1fOVaqy2FuP0jU7NqBIlO2gw&oe=6A85880B"}, "display_name": "pronoDR+MRViewer", "keywords": [], "long_description": "A separate license agreement is required to import your CAD models and use the full functionality.", "short_description": "\"pronoDR+MR\" is an innovative design review system that uses cutting-edge MR (mixed reality) technology to display 3D CAD models in real space. Multiple people can share the same model in real time and check and verify it with intuitive operations. It makes decision-making smoother at design and construction sites and dramatically improves communication efficiency. Experience a new workflow that supports the future of manufacturing."}]}, "developer_name": "pronoHearts Inc,", "developer_privacy_policy_url": "https://prono82.com/pronodrprivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "pronoHearts Inc,", "support_website_url": null, "website_url": "https://prono82.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25787224127556486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392127_2066441507152582_81256852906266808
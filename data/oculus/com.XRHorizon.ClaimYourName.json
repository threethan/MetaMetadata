m84-Ah2oCSDK9AhfJhsZO17FU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdaN7me9dv8q4hU5-wtj2jifudYtv0JXCX5uzaCH9NNA&oe=6AC509AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Claim Your Name", "keywords": ["VRCarnivalGames", "VRArcadeChallenge", "MiniGamesVR", "VRLeaderboardCompetition", "VRPartyGames"], "long_description": "Claim Your Name is a thrilling single-player VR carnival experience where skill, precision, and high scores decide who rises to the top. Step into a vibrant virtual arcade filled with exciting challenges, immersive environments, and intense score-based gameplay designed to test every player\u2019s abilities.\nPlayers begin their journey by entering their unique player name before purchasing a special game ticket pack. Each player receives 6 individual game tickets and 1 special bonus ticket. Every individual ticket grants access to one of the six unique carnival mini-games, while the special ticket allows players to replay any one game of their choice for a final chance to increase their score and climb the rankings.\nThe game features six exciting VR mini-games, each focused on different gameplay mechanics and physical interaction:\n\u2022 Shooting Challenge\n \u2022 Basketball Challenge\n \u2022 Point Ball Challenge\n \u2022 Archery Challenge\n \u2022 Ladder Challenge\n \u2022 Ring Toss Challenge\nEvery game rewards players with points based on performance, accuracy, speed, and skill. Players must complete all six games to unlock the special bonus ticket. Once unlocked, the special ticket can be used strategically to replay a favorite game and earn even more points.\nAt the end of all seven plays, the player\u2019s total score is calculated and submitted to the in-game leaderboard. Only the Top 5 highest-scoring players can secure a place on the leaderboard, making every point important. Players can see their names updated", "short_description": "Step into the ultimate VR carnival challenge in Claim Your Name! Compete across 6 exciting mini-games using your individual tickets, then use a special ticket to replay any game of your choice for a final score boost. Earn points, climb the leaderboard, and fight for a spot in the Top 5 champions. Enter your name, test your skills, and prove you deserve to claim your name at the top!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/Privacy-Policy---Fruit-Blade-VR/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://xrhorizon.in/exarplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26924660173821446"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2171204667009357"}]}, "baseline_offer": {"id": "2171204667009357"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780287300, "status": "PUBLISHED", "id": "2171204667009357"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26924642293823234", "version": "1.0.2"}, "id": "1357976986221986", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
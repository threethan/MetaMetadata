b=1-7&_nc_sid=6e7a0a&_nc_ohc=HEyJTJWdyHQQ7kNvwGTPH0q&_nc_oc=Adq1GdpjZqvo1mg1ADg8Jzs-m4foHipX1TdEr2T5G20xPdmOA4KPs2CRBNadsMtn59M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F-Cr2VlCyJwSQORVIopih7P2C5LFnYR0DfnJTJ4wV6Q&oe=6A15C364"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baRzJ26VRLgQ7kNvwHZiAlW&_nc_oc=AdqJAV7hJR81wHrKUkoiWjMx3uLftsQ8zm8F91680cGhvlSnCnG5bjAn-D4s7HPsPD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74VPkUTWfm3-16hMO7plGoxgCHyoqinVYBQXOf0ZexoA&oe=6A15C050"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "suppo
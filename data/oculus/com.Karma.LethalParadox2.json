n.com&oh=00_Afv53qZ6MzZSv7wFQTxZpD3UeOiX1xX320SjaSyDLZYCkg&oe=69A029E3"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-25.png", "id": "1034867675291401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_1034867678624734_4671566078028635550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNtZ3tk76jUQ7kNvwEXH-rY&_nc_oc=Adl3NkCb2aND0rEuOu71Qs1BfL8sQ_rphb6g3dXlOPWWBAllQ9ud42g9614lXImhKEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftA-9QVO4rR9kN9eMwoU_zKW0HZAq-z7jawzdG3dXXqqw&oe=69A049AE"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-41.png", "id": "992627282723188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_992627286056521_756431736786369932_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJL7KUGy5eUQ7kNvwHfsfxp&_nc_oc=AdmazB2pDHqspk4_qp-fcYAmjxXKqnWxPsiYdZ0NjfZbCUNQHR74rkJk9fhTP62O0Gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afswv0eGr2NHlb6piMsgiEf0N9KDE9lhZel6gAtBrBUgsA&oe=69A035A4"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdYlOFu3of4Q7kNvwGEmBxD&_nc_oc=AdnfLjxyAttp2hQQwua-MLqniXrdwmo_hsb7pgB2yve_1MAgz43Ud6c0eHqykqAWV64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaQdk9UnsvgAJRkIMMBjaDVLO0kFz7821PmiekACW7ow&oe=69A03290"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23867666206200287"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1422198665590888"}]}, "baseline_offer": {"id": "1422198665590888"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749488340, "status": "PUBLISHED", "id": "1422198665590888"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24157134593920112", "version": "Paradox2025Fix18"}, "id": "1004542291618509"
&oe=6A1991E7"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-34.png", "id": "727015053128526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830914_727015056461859_6119104034506610354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka8q6irlaTgQ7kNvwEFj5_l&_nc_oc=AdoZO-sV62jpmk5mZsdWMh6c_7FgtYLVaAO7x7z06bIBUXgUSC_ggblBWty5ZJymMbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pgrRAj9_97ntTdSMFWWwHH0BzFG21eK6m9Z-a7FKMOw&oe=6A19AC23"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-25.png", "id": "1034867675291401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830911_1034867678624734_4671566078028635550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rxKQAQAyTIQ7kNvwE2N751&_nc_oc=Adpxb66YNh7sYr75DBls0I47razAL9l8wBPYEgJIdaa7gbex5syf0VOxkQWbyERhmKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YA6Loi9-LrBghvKyioLup8MZX7-9isDjkXCnLbo0SXg&oe=6A1993AE"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-41.png", "id": "992627282723188", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830911_992627286056521_756431736786369932_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWHual2VCogQ7kNvwGcx49Q&_nc_oc=AdrD03H_rd0pFXC8Qixh3sBuYh_JrUuLhWASDi9O8PS7VhyXLGlWbMPUnrDmB7qDLvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MdL5oAHKYqbOUjFHHzOdqOS18igYXCPwEGdz0vO5DTg&oe=6A19B7E4"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNeqayk2AoAQ7kNvwGG0qxU&_nc_oc=Adovu5PZgLkTrDWB9ltIkqZwmbh17Hg-jhbYnwxT47ucjnSW9YNBMqEthmqGwE2XYOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_yDdsJeeoYZO-NpQnUr1UWHMQx4C5KS-OH_hRyG1q5A&oe=6A19B4D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23867666206200287"}}]}, "scheduled_offers": {"co
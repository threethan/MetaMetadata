&oe=69C68367"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-34.png", "id": "727015053128526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830914_727015056461859_6119104034506610354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxVaRLXPY7kQ7kNvwGo99v4&_nc_oc=AdpQfcS7XAHt0yTQffjJYB14kr7VcdzvjsEEjBs_7JUGP64K54L3-kjFWb_FQZrfmyI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG1Hx5piGqJ68nbuXqcMVH-7B_wNBhLJg-TZcRMdVsbA&oe=69C66563"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-25.png", "id": "1034867675291401", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830911_1034867678624734_4671566078028635550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDvFQoQTMggQ7kNvwGD-Q0R&_nc_oc=Adr8MNwmCMgyhXldxJws-o5Svv8GyLRqoQTMihfc3502ERGwt418RsF2K8reoOalHrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEWqBo2oJ7VJ0nexIq7cbmGf70hNQdHcMRMAlSNcuepQ&oe=69C6852E"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-41.png", "id": "992627282723188", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830911_992627286056521_756431736786369932_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9cXpA8_E6oQ7kNvwGc-NHt&_nc_oc=AdodXs6ShsIfBfSKvI0tfWNAxaTXBkP0p92osWt8sqU0jjHblgHtep9lcY0T7DAxLkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNnCnfs0jQYXKafv6HXPU7rhh7lapqjdJOW3EUVwxT8Q&oe=69C67124"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33HYrp0VZ1QQ7kNvwEvEtAY&_nc_oc=AdprHdKPkpOby1DhEgsGj82k6kH_37JMtuU7cdULElzewcyZ9bfDq104yA52e_khPWY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afya7wRR9A7xByfOQoWY2fzoBkm5IcQUF00ILoNWDqOn2w&oe=69C66E10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23867666206200287"}}]}, "scheduled_offers": {"co
FiZrvULP1673zD-2dyhs6FBfZwT7Fw9eKA60PP-Jbl4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwLvpNT1rGdOlPD_k-C01cN9sR7suCSxtE8qttyq11sw&oe=6B0DB16E"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-41.png", "id": "992627282723188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_992627286056521_756431736786369932_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJpe1inkZZ8Q7kNvwHk4v_P&_nc_oc=AdolQJElMcxZ05Vy1y-zbgCrLLCJ3HqoJ7da1oiZB2TqnAV3dxdqAqf7IYPDGICQtsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6eQNUaC9YWSIx2ZL7oK4-N9EiJmUCWGh-axKrA3gXmw&oe=6B0D9D64"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My26PcncF1gQ7kNvwGlNP1h&_nc_oc=Adrs_YUR7fp3obLh39lNkDv2DxDV_yL4o4B5UnC7KFi3kwXFMakbK2lPDDsY-xSvLiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtLpCtYhLpmpo-CT0UyPr1_RnLYaEof_fpcIU9Z4Fepw&oe=6B0D9A50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23867666206200287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618070_2541191712913513_906176665940684436_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGGAfiu9N9EQ7kNvwGliFth&_nc_oc=Ado-fdkGckGA1euNLpW6cT5TmOdsqy2cVistpxuLZ5ymNzPaEPi_4UeLgxOSxNc0eoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaDPS2K3IcZzblcPYu-Sl6gYrhKRmhCn5IcyJ-II7qnA&oe=6B0DC521"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lethal Paradox\u200e", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"
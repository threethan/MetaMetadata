&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw70hz8ywF0Q7kNvwFAlgZS&_nc_oc=Adp148b4DjYqpgFnMl_h0-WcWKwDxAXpu9piJq268dmmElFHIHZG--ukwkoV6s-oo9Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sSAz2gAJg8jV88fgbfbajni6q17dLJ-Qee3powjBt4A&oe=6A11CEE4"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR9wcDdsO4cQ7kNvwGpoBnq&_nc_oc=AdrV-ls4g4pZhJtgdLhS9adUrDrth4BfpfQVCLxrx-Jgp0Xy3cO1bHsIyYTXRTvja2c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50k6HCyiP_xx6bebl2iaFrX1EZGxotyfq5anSsa3rxYg&oe=6A11CBD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "s
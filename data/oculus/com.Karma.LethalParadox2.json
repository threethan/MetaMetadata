b=1-7&_nc_sid=6e7a0a&_nc_ohc=GDV0zfs0yr0Q7kNvwHEOCei&_nc_oc=AdquNrgy_zurZtgFhMHjsJSRIIAhxdCPF4u4CqLitpWy4qGqmuJlLmN8m7jFxVwazro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sffRPZi14N6pS_tkBl3_i_yCkHd_cI1UtFqS6VO9EIw&oe=6A3EA1E4"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk4QvvClJyEQ7kNvwFWm56e&_nc_oc=AdpeYRK1x80SEFcXkaxyHH2F1dxuULr3gVpbpOiMNKL1RHSIU8SwaH7R3MSGH0mJArc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af977bcmMFcDhKcHL-1eswTlmXbODismsYyFvxW4GPbzYQ&oe=6A3E9ED0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "suppo
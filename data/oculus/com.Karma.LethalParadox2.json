b=1-7&_nc_sid=6e7a0a&_nc_ohc=GDV0zfs0yr0Q7kNvwE6hnsX&_nc_oc=AdpxGatXHExu-G8EJU5QXh4Iv8tHAKRRfVitdyQFHMvOtMu5lHqjmDhKOKdD6NcrcqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Klj8FZChbcKlU9xgGuGsM2y2sxZsHXHaTTNW5s-FiEA&oe=6A3D5064"}, {"file_name": "SampleScene_Custom..._06.06.2025_11-47-20.png", "id": "1618880798800304", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830911_1618880802133637_113780530560373400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk4QvvClJyEQ7kNvwFeHdPA&_nc_oc=AdpkPF-kjokuYugixYoI2LfGwD5O1ovnzWS74DSVRDkaQRMV5mZ4sUn7ZgKWriHxg4E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nb_NqaEtFXteoUimgWljrDKZRwP3p3KqyalTR_gjsiw&oe=6A3D4D50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Paradox\u200e", "keywords": ["LethalApe", "LethalParadox", "LethalParadox2", "Horror", "Scary"], "long_description": "Lethal Paradox is an immersive, mind-chilling horror game that plunges players into a harrowing experience within the eerie confines of a sprawling research facility. As the chilling story unfolds, players are tasked with navigating through dimly lit hallways, abandoned laboratories, and claustrophobic storage rooms, all while evading a host of terrifying monsters that roam the shadows. The game cleverly blends psychological horror with intense survival mechanics. With each step you take, the atmosphere thickens with dread, keeping your heart racing as you piece together the dark history of the facility and the sinister experiments that transpired within its walls. ", "short_description": "Lethal Paradox is a mind chilling game where you run around a facility trying to stay away from monsters that lurk around you."}]}, "developer_name": "ParadoxProductions", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FiH07ETK3BEZmCmeyP0D8kFO7nhFFNI8CqY_qtbeYZs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Karma", "suppo
luscdn.com/v/t64.5771-25/491818938_756855636912610_6508348490901776928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0G8F-S_DuoQ7kNvwFe9ixO&_nc_oc=AdqZOwE5rpEjUCeWe_1UlHiDQ47c2DO3Jp9o7BoTXq8J1jNsidyXowd2UXjm5LQqR3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FV7a4CKnqYIwm1E2eGAWan48T0f6NNDuv8bMzr1MkTA&oe=69D246DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRHoops_Final_Cover_2560x1440.png", "id": "1989905538446393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307409_1989905541779726_5782201665747171734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgQBx91KChUQ7kNvwHK0m1d&_nc_oc=AdorH5EGrvV8jPZsrd3qm1nvj2UsKr3rE8tk9GJOVZeWiGIp-sn_LT437u4vynCAP24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F7VPWSs9mOZ41VL7-MKssxiFjXrvwp0oLS-Fm814ybA&oe=69D27CBF"}, "display_name": "XRHoops", "keywords": ["basketball", "sports", "mixed", "training"], "long_description": "\ud83c\udfc0 XRHoops \u2013 Master Your Shot with Mixed Reality on Meta Quest 3!\n\nTake your basketball skills to the next level with XRHoops, the cutting-edge mixed reality training app for Meta Quest 3. Perfect your shooting technique with a dynamic parabolic arc that guides your shot, helping you develop consistent, accurate form.\n\n\u2728 Features:\n\u2705 Parabolic Arc Guide: See the perfect shooting path every time.\n\u2705 Train Anywhere: Shoot from any position on your virtual court.\n\u2705 User-Friendly Design: No complex settings, just pure shooting practice.\n\u2705 Meta Quest 3 Exclusive: Optimized for immersive, high-performance training.\n\nWhether you\u2019re warming up, aiming for your school team, or just having fun with friends, XRHoops gives you the confidence to shoot with precision. Download now and start swishing those shots.", "short_description": "\ud83c\udfc0 XRHoops \u2013 Elevate Your Shot with Mixed Reality!\nXRHoops is your personal mixed reality basketball coach on Meta Quest 3. Visualize the perfect shot with a parabolic arc, guiding you to consistent accuracy. Train anywhere, anytime. Whether you\u2019re aiming for your school team or just having fun, XRHoops makes every shot count.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://media-showcase-patrickalexan11.replit.app/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ST Studios", "support_website_url": null, "website_url": "https://media-showcase-patrickalexan11.replit.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24564816076453408"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "722774733933279"}, {"status": "PUBLISHED", "id": "3781135298809261"}]}, "baseline_offer": {"id": "722774733933279"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753735620, "status": "PUBLISHED", "id": "722774733933279"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24847963491471997", "version": "0.1.3"}, "id": "1130681635453088", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23928964940038528", "
.oculuscdn.com/v/t64.5771-25/491830007_1621007711905501_6334712221872243123_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cty0ic-QCfMQ7kNvwEnrTFf&_nc_oc=AdrcMnkR6M_OJG9QcaDXJQkqYMtMf5x01KCuDI3pXPEWIgKT-ThnIE3OZqTRbP2txKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4USvhAMvVjpyyZb7bkg65WKDxsPoKK5ZtXAEV9BPjiQ&oe=6B07053F"}, {"file_name": "XRHoops_Cover5_2560x1440.png", "id": "500857166387546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_500857169720879_5761511677092858418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vzz2ri8OEcQ7kNvwFx8n6K&_nc_oc=AdozPblCymlQ8Oqgqrb5CRifa8bQethan7BIFY-RZHXs0iG_F7IAOdGp_WIE9l9ktr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFiSJiTtDS83fo7jjn0hIj2urniPE5cPcs466_Faf9hw&oe=6B0718CD"}, {"file_name": "XRHoops_Cover6_2560x1440.png", "id": "756855633579277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_756855636912610_6508348490901776928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAypadmajt0Q7kNvwEiukOI&_nc_oc=AdpYkA51Hivfeam1GbRWVSm536lVW_K_hF7RcYy8Ix7Cym49v_U9oR9fKncv2-Nteg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0txmw9KVISgsL6am-OG5DVkJsyTk_QYNYqF58TkZqpQ&oe=6B06FE1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRHoops_Final_Cover_2560x1440.png", "id": "1989905538446393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307409_1989905541779726_5782201665747171734_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIashZ6hdogQ7kNvwHLCF5T&_nc_oc=AdrYpCrNE7_lFZezNI2MHhbiyRTbo1XeSNcsbTySN-aWrZtsUrfReEwMzJC5BuXDHfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoqmqvBu-KAsPQFutQFOTvD2WrUqaKR5fmx3d1C8N8RQ&oe=6B06FBBF"}, "display_name": "XRHoops", "keywords": ["basketball", "sports", "mixed", "training"], "long_description": "\ud83c\udfc0 XRHoops \u2013 Master Your Shot with Mixed Reality on Meta Quest 3!\n\nTake your basketball skills to the next level with XRHoops, the cutting-edge mixed reality training app for Meta Quest 3. Perfect your shooting technique with a dynamic parabolic arc that guides your shot, helping you develop consistent, accurate form.\n\n\u2728 Features:\n\u2705 Parabolic Arc Guide: See the perfect shooting path every time.\n\u2705 Train Anywhere: Shoot from any position on your virtual court.\n\u2705 User-Friendly Design: No complex settings, just pure shooting practice.\n\u2705 Meta Quest 3 Exclusive: Optimized for immersive, high-performance training.\n\nWhether you\u2019re warming up, aiming for your school team, or just having fun with friends, XRHoops gives you the confidence to shoot with precision. Download now and start swishing those shots.", "short_description": "\ud83c\udfc0 XRHoops \u2013 Elevate Your Shot with Mixed Reality!\nXRHoops is your personal mixed reality basketball coach on Meta Quest 3. Visualize the perfect shot with a parabolic arc, guiding you to consistent accuracy. Train anywhere, anytime. Whether you\u2019re aiming for your school team or just having fun, XRHoops makes every shot count.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://media-showcase-patrickalexan11.replit.app/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ST Studios", "support_website_url": null, "website_url": "https://media-showcase-patrickalexan11.replit.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
.oculuscdn.com/v/t64.5771-25/491830007_1621007711905501_6334712221872243123_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw5jUEpBgrcQ7kNvwEnByKZ&_nc_oc=Adons-loJbKlqyfKa7VwU3Ea8RLY-d2VquPDQRF2r_1v2dvcGhOuLO0gO28mlgC6GHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAslgTiTr83puxEb30bBTDjx2namc7Kkb8Uts7VJqJQg&oe=6B103FBF"}, {"file_name": "XRHoops_Cover5_2560x1440.png", "id": "500857166387546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_500857169720879_5761511677092858418_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQIEGJwEkSkQ7kNvwGsDpD_&_nc_oc=Adp4_MPK8nnf7u7mID1L1pib7MQ_zyJDZrVWkQSO0unKVjfDltx_ro8YbAW0933e9QA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsIXQJGF5k7WpsDgnaqYe3bao9QAmOOTYpz3vOrieyKQ&oe=6B10534D"}, {"file_name": "XRHoops_Cover6_2560x1440.png", "id": "756855633579277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_756855636912610_6508348490901776928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFsTtQcIdLYQ7kNvwGGGFBA&_nc_oc=Ado_samU5GSZHRJQTEWbGpAMRKwfJEiVt1yVl0j9opRoTMaNoRc4Y42JX6z5_w_3mDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVuLq-w25FjowotQ_jphI8kwPpwTMvxCI9NzImfhMPy-A&oe=6B10389C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRHoops_Final_Cover_2560x1440.png", "id": "1989905538446393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307409_1989905541779726_5782201665747171734_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNsJJcXf6UAQ7kNvwHgxEF7&_nc_oc=Adr97qCWXhEmKPoNg0786M1H-HjpyEQ9OzECUm-yzjvqQjUfvtYGXkfHMM4a4J_vtgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV69vyqdXhitmD-w7Tkfz8zuOBpjheOSa6Q9edEVNHESA&oe=6B10363F"}, "display_name": "XRHoops", "keywords": ["basketball", "sports", "mixed", "training"], "long_description": "\ud83c\udfc0 XRHoops \u2013 Master Your Shot with Mixed Reality on Meta Quest 3!\n\nTake your basketball skills to the next level with XRHoops, the cutting-edge mixed reality training app for Meta Quest 3. Perfect your shooting technique with a dynamic parabolic arc that guides your shot, helping you develop consistent, accurate form.\n\n\u2728 Features:\n\u2705 Parabolic Arc Guide: See the perfect shooting path every time.\n\u2705 Train Anywhere: Shoot from any position on your virtual court.\n\u2705 User-Friendly Design: No complex settings, just pure shooting practice.\n\u2705 Meta Quest 3 Exclusive: Optimized for immersive, high-performance training.\n\nWhether you\u2019re warming up, aiming for your school team, or just having fun with friends, XRHoops gives you the confidence to shoot with precision. Download now and start swishing those shots.", "short_description": "\ud83c\udfc0 XRHoops \u2013 Elevate Your Shot with Mixed Reality!\nXRHoops is your personal mixed reality basketball coach on Meta Quest 3. Visualize the perfect shot with a parabolic arc, guiding you to consistent accuracy. Train anywhere, anytime. Whether you\u2019re aiming for your school team or just having fun, XRHoops makes every shot count.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://media-showcase-patrickalexan11.replit.app/#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ST Studios", "support_website_url": null, "website_url": "https://media-showcase-patrickalexan11.replit.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
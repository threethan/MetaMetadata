1351384006673497_5769451272195512472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOIoXEvVJW4Q7kNvwGnyCwV&_nc_oc=AdoQTdRmVh72mAxhWP_v1surGgeTceAIKEtw4Xri222qhAjJ5Y7ufgm-IM1UagzsI5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI9pBvhMxFVkiOKrMS-_tHUNgviR7aK7i5-QCzpxlwYg&oe=6AE9E29D"}, {"file_name": "ChatGPT Image Jan 5, 2026, 02_03_27 AM_11zon.png", "id": "919750850375731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_919750853709064_6106326519969178899_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIhS8XjNMD4Q7kNvwGxbI7J&_nc_oc=AdrT5tJO2oVYmISwoGB4b2361od0Zw0lp3IOmoU9mb7nDLW9rmlAuEGan7a4axc8PLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwlMAafNfK_P75GhByzxG838rVcQJbdCDsaBfh748C_w&oe=6AE9F1DF"}, {"file_name": "ChatGPT Image Jan 5, 2026, 02_03_13 AM_11zon.png", "id": "1590218401988463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821696_1590218405321796_7287140233934163024_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRB65SUvNG4Q7kNvwGq0K_A&_nc_oc=Adruf1Ga9-p6zNi05TIza8cwxhOLkx85Bhb5jnaY2sGa9VmPjpln3GKpttmJZhUNq3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMC8dAAzSH0A97P5wprUkHNtV3ah_YMWNr7kjJH9TLfw&oe=6AE9F878"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Yeet a Dude: MiniGames", "keywords": ["physicsbased", "minigames", "funnyphysics", "chaoticfun", "sandbox"], "long_description": "Well, back in the day, games were simple \u2014 no rules, no hand-holding, just pure experimentation. Yeet a Dude brings that spirit back in a playful, over-the-top physics sandbox, where chaos and curiosity lead the way.\n\nAt the heart of the experience is a fictional alien character, placed into strange environments designed for experimentation, movement, and unpredictable outcomes. Using a variety of gadgets, tools, and physics interactions, players are free to see what happens when systems collide \u2014 all in a light-hearted, stylized setting built purely for fun.\n\nAlong the way, you might encounter a friendly Chihuahua companion. He\u2019s here to keep you company, add personality to the world, and remind you that not everything in a sandbox is meant to be interacted with in the same way. Some things are just there to make you smile.\n\nWhen you\u2019re ready for a change of pace, Yeet a Dude features a growing collection of minigames, each offering a different twist on physics, timing, and experimentation. New challenges are added over time, keeping the experience fresh and unpredictable.\n\nThere are no real people, no realism, and no seriousness here \u2014 just fictional characters, absurd situations, and the joy of seeing what happens next. Whether you want to explore, experiment, or simply mess around, Yeet a Dude is a sandbox built for curiosity, creativity, and chaotic fun.\n\nJump in, try things out, and enjoy the ride.", "short_description": "A physics-driven sandbox experience featuring fictional aliens, playful environments, and unpredictable interactions. Explore, experiment, and enjoy chaotic moments without rules or limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSxWjE3E5AOPUprVD8t3zilPboyYbBK_E811zkM9x8QGU7kZM8jAEQWfEjJ3T4jyDxod5EPmaSdt1JD/pub", "developer_terms_of_service_url": null, "publisher_name": "RaulThatDev", "support_website_url": null, "website_url": "https://yeetadude.onepage.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
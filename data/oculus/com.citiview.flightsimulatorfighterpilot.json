f&oh=00_AQRG7PUIF3XkZSazmwo9CEbFT5gbr0nQ2qRNIPCLxy-ANw&oe=6AF32997"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1639003051141954", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1639003054475287_3810901772006785506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmAD8WXzG3cQ7kNvwFDhhVQ&_nc_oc=Adq9QPCUkF8z_0MdvrcWTR1yU3k4zR_Zq6kMVtczzpqZJm6uyCQs-TJkYYPiT-iuHsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm8PN_nk7z7Yf7Is5InY45CGdC93Z8voUTKqbmpbDJow&oe=6AF33A5C"}, "display_name": "Flight Simulator Fighter Pilot", "keywords": ["flight", "simulator", "fighter", "jet", "pilot"], "long_description": "Flight Simulator Fighter Pilot puts you in the seat of a modern fighter jet.\n\nYOUR SQUADRON HANGAR\nYou start on the hangar floor with your ground crew around the jet. The crew chief salutes, you climb the stairs and step into the cockpit.\n\nCANOPY DOWN\nOn runway 27 the canopy closes over your head as the take-off roll begins. Push the throttle past the detent for the afterburner and lift off.\n\nA REAL COCKPIT\nA wide panoramic display, a side-stick, a throttle, a gear handle and standby instruments, all live, under a clear bubble canopy.\n\nSIX SORTIES\nQuick Reaction Alert, Tanker Rendezvous, Recon Run, Coast Race, Sunset Flypast and Night Intercept. Each one is scored with stars. Pick one from the briefing board in the hangar.\n\nEMERGENCIES\nA flameout at 25,000 ft, a dead-stick glide home and a hydraulic failure, each with a checklist card in the cockpit.\n\nFREE FLIGHT\nAn island with mountains, a city, a coast and real clouds, by day, at sunset or at night. Landing challenges and ring courses.\n\nYOUR JET\nPaint it your way in the paint shop and power wash it clean.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.\n\nA flying game: no weapons and no combat.", "short_description": "Start in your squadron hangar with the ground crew around your jet, climb into a modern fighter cockpit, watch the canopy close on the runway and take off on full afterburner. Six scored sorties, emergencies and free flight over an island, solo or online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorfighterpilot/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorfighterpilot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1278534108685895"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1989564461706059"}]}, "baseline_offer": {"id": "1989564461706059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791294120, "status": "PUBLISHED", "id": "1989564461706059"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1292089673997005", "version": "1.0.1"}, "id": "1380106104278129", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1278534098685896", "is_con
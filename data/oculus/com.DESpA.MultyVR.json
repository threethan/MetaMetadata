JsxDlZbN0Q7kNvwHG1-hd&_nc_oc=Adqse2cAfaB2L-DJQk8u3DVD5OTnbgJuDyASV5GHEWNZjhWPyObIRXD7nuyHs5iNNwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2NukjVGznIKJ3YxlWa6ffPKnB4qx6WEkV6jMM1SVLvTw&oe=69F0BDEA"}, {"file_name": "5.png", "id": "7840729385990467", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974697_7840729389323800_2928318743993175197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEQl3CPJhkgQ7kNvwEABWA5&_nc_oc=AdoiyxZrJBtMD8lxc8CG_gB8-vXZ4ez6dFVTbeVrKLfNJ340D3KP3CMZ6uAdo7QNdjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0ziZTazEW5KjvNiu2xktE3PY7NaGT3u8Oxoqyx9MDPjQ&oe=69F0A090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "488541070265722", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451783_488541073599055_2189119519137881285_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2pTbHgBH6IQ7kNvwG1LNNv&_nc_oc=AdqdqUzVvsM8CnRZOIc2NRmidK0PyiQvOUh35xQxHHOldXzwBpcFV8Bz5LBygwh8M-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2CKQ0uP2JkctkhEdA-qqlbe0mwaFiZpFHpruaufbf_Cw&oe=69F0AEF3"}, "display_name": "MultyDani", "keywords": [], "long_description": "MultyDani is an innovative platform for education and culture in virtual reality that transforms learning into an immersive and social experience. We offer educational opportunities in various disciplines through interactive virtual environments. We have classes designed to improve comprehension and retention through visual resources and practical activities. We organize social events for participants to collaborate on projects, fostering an active community. We also provide the option to rent virtual spaces for personalized events. At Keep Going VR, learning and culture merge into a unique experience that promotes personal and professional development.\nKeep Going VR es una innovadora plataforma de educaci\u00f3n y cultura en realidad virtual que transforma el aprendizaje en una experiencia inmersiva y social. Ofrecemos oportunidades educativas en diversas disciplinas a trav\u00e9s de entornos virtuales interactivos. Contamos con clases dise\u00f1adas para mejorar la comprensi\u00f3n y retenci\u00f3n mediante recursos visuales y actividades pr\u00e1cticas. Organizamos eventos sociales para que los participantes colaboren en proyectos, fomentando una comunidad activa. Tambi\u00e9n ofrecemos la opci\u00f3n de rentar espacios virtuales para eventos personalizados. En Keep Going VR, el aprendizaje y la cultura se fusionan en una experiencia \u00fanica que promueve el desarrollo personal y profesional.", "short_description": "MultyDani is an educational and cultural platform offering classes and social events in virtual reality environments. We foster an active community and rent virtual spaces for personalized events, blending learning and culture.\nKeep Going VR es una plataforma educativa y cultural que ofrece clases y eventos sociales en entornos de realidad virtual. Fomentamos una comunidad activa y alquilamos espacios virtuales para eventos personalizados, fusionando aprendizaje y cultura."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/pdf/PoliticasDePrivacidad.pdf", "developer_terms_of_service_url": null, "publisher_name": "Daniel Escalante", "support_website_url": null, "website_url": "https://www.digitalexperience.cl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
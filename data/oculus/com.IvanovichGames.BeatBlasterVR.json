6e7a0a&_nc_ohc=OlncTHEMn0MQ7kNvwFYxPze&_nc_oc=AdpnDhLP_vP1YmHuNaRH9HFka5N_gHVrZpwLXTwzjXdtNsrPQKI-LB0ZW0YntwHLOuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr6PGsctlYvLDbFcI6I_lWYjp94K1b8TBVjt7THfNcOA&oe=69CE5F31"}, {"file_name": "screen4.png", "id": "859117427994217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75568729_859117431327550_6758189037787699058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKlz-iwWS3wQ7kNvwGTZgxv&_nc_oc=AdoTmTUs4V3qdfzioJvPivqxsl6F4qLgsEbfNiYLyiTwT0YcEiSTeHZcvAoNN0yvmhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBJy_zppZommYRDiQN3l9mo_fy7jm6uLU4eU7yPDt3WQ&oe=69CE802D"}, {"file_name": "screen5.png", "id": "511938266443737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269160_511938269777070_1067552805106397481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Za_03OgagwAQ7kNvwEw3OZV&_nc_oc=AdrQJAaMS8-riTTu6JNFea4uLZhzhJ84qNT7RTR61q-Y0cOpb7lcH8MkiCsLo3esof8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS9zxNVZIiMWahNugJ7LZ7Eg2cdTbK3z1_GHMUNDF9BA&oe=69CE5214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "4098828203474620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435287_4098828213474619_2522357510769576592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kxYlUVaOcEQ7kNvwE0HrDk&_nc_oc=Ado81-arw8xVG6ulgdSGSz6f5759pDND9-kq5x2ZThblZ91MtmOlnk1NTSbGceEpZ14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPxzzpgqSfCikoMbM6EOdOK9eeockiIHGCVt1lbVwkIA&oe=69CE6F10"}, "display_name": "Beat Blaster", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n4 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, the new 3dRudder, tilting the head or the intuitive and original control based on the movement of the head. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all moves in the game are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and a single life to dodge or kill all the enemies that will appear to the rhythm of the music.", "short_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ko", "fr", "it", "es", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8035441429848651"}, "review_messages": []}]}, "cover_squar
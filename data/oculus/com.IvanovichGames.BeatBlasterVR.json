6e7a0a&_nc_ohc=gll8A9UU9tQQ7kNvwFmXF7c&_nc_oc=AdoLJMkt2kraxeS6AGoLnIVckDKgIY3G-zBdnIum8na6kl3Z4-z0vXBrekRovKdAS64&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr6dykoA4hGwxKbDrVHbIV-jhf69eTQE-i4Y8D6O0YAg&oe=6A689EB1"}, {"file_name": "screen4.png", "id": "859117427994217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568729_859117431327550_6758189037787699058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnVVNcOVY5gQ7kNvwEHCpxs&_nc_oc=AdoGylPohtiyEfXbSn29xLZuYOy_eaMohSLskScxjIBCWhgC4lFVJDixKAqdd9N5CMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAntS-cKYwmF6I4BA7fVLV9c_ftF4ZxKdRZ434aELL3Og&oe=6A68BFAD"}, {"file_name": "screen5.png", "id": "511938266443737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269160_511938269777070_1067552805106397481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrUEfZi93RgQ7kNvwHasVqR&_nc_oc=AdpVyfjVr3PdaneiXcDOhwRdS64OPcl3DnCmLbxlN2inzV9PETPVAGvlU8tSaZF_xYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBqtCUp_DM8BM3W-jKP-4J-w7A5C-tFll_sjUHRbIULg&oe=6A689194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "4098828203474620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75435287_4098828213474619_2522357510769576592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mD2cwKUVn4Q7kNvwFmIlS7&_nc_oc=AdomlX-jy4kXmoH5Mkl_zyjTbXIl3AIcv7PjM2IIDtcVbD1_0DrwyjOr0J_UL9jbPFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Zdt5ejU-YIh2zNWWagWD0NuC2cxMqvDRhgH6SBq52w&oe=6A68AE90"}, "display_name": "Beat Blaster", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n4 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, the new 3dRudder, tilting the head or the intuitive and original control based on the movement of the head. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all moves in the game are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and a single life to dodge or kill all the enemies that will appear to the rhythm of the music.", "short_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ko", "fr", "it", "es", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8035441429848651"}, "review_messages": []}]}, "cover_squar
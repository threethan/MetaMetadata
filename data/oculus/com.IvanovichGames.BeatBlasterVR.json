zv5oU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsKjiWWv06MGzyjrctRCtw3cyh3dYNBFBbZryDFhHQTag&oe=69A5696D"}, {"file_name": "screen5.png", "id": "511938266443737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269160_511938269777070_1067552805106397481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLQkkxCLhoYQ7kNvwFi-pU_&_nc_oc=AdmmJhXK-JawnyirU1kq5YgBOQ7gF0fyXqT2j_baNVM6E--QiJjvd9RYWvZWA-OVc1g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsEkFtGZTb_T3x5J_vtZFjzZryh1zMhxakz91clFYGfjw&oe=69A57394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "4098828203474620", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75435287_4098828213474619_2522357510769576592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW_enqu2UycQ7kNvwGnRuAA&_nc_oc=AdmbFnRSboG9ZMZgyStGO8AaLRqRYs-Hp_IZW2Tt3u10QR2DtWNH3R5q7yNDb5aDcJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsdKwbxGttuAIW94rClp-WYfqAx7JjLOkKpCjEIMk3FfQ&oe=69A59090"}, "display_name": "Beat Blaster", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n4 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, the new 3dRudder, tilting the head or the intuitive and original control based on the movement of the head. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all moves in the game are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and a single life to dodge or kill all the enemies that will appear to the rhythm of the music.", "short_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": "https://www.ivanovichgames.com/privacy.html", "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ko", "fr", "it", "es", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "632383431182646"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "953351080685267"}, {"status": "PUBLISHED", "id": "1229979949155750"}, {"status": "PUBLISHED", "id": "1147361620312634"}, {"status": "PUBLISHED", "id": "580645088312628"}, {"status": "PUBLISHED", "id": "1351443706098614"}, {"status": "PUBLISHED", "id": "2106766526456521"}, {"status": "PUBLISHED", "id": "917405323842579"}, {"status": "PUBLISHED", "id": "1071210174498434"}, {"status": "PUBLISHED", "id": "4080115132010133"}, {"status": "PUBLISHED", "id": "482499126907106"}]}, "baseline_offer":
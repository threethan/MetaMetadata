MWU4jp9sb0GuUY5e0A-qfoQ&oe=6B083F89"}, {"file_name": "screen2.png", "id": "2825297704380463", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348045_2825297707713796_4280977966268630756_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRMr35SXRbwQ7kNvwFlgpHD&_nc_oc=AdpCDNGsRXaRMWWTbkMGxvpdtkBtr8VF7PE_YTcC2YCPvpArTlM-YlqmZpsRtonFSs4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsXoMDlfmkRhkVIZ1Vqe4HTeXiKjCaYT7j8zKdFyf0iw&oe=6B085C71"}, {"file_name": "screen4.png", "id": "859117427994217", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75568729_859117431327550_6758189037787699058_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P73njhkjQUQ7kNvwErS433&_nc_oc=AdrdHQBFi58xemVup76MQBHn7iS_on32XLgb25427k6M3NNnntVzMahEknuK9XCdLPY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl5Qt_2qo9IWfx74GcE5phy5dP1bvBQRydR5L6ptDkBQ&oe=6B08452D"}, {"file_name": "screen5.png", "id": "511938266443737", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269160_511938269777070_1067552805106397481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n-fAZ0EKvMQ7kNvwEMhLWB&_nc_oc=AdqNdzIPqMwROMKNlbfuvzb5LqwF-iNBTx_RnjajzZAKzh-dtEzDaETOZvnPM6ouEJs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOLVYyTNLjPvkwYkWqZ8r_PdytGlmIWPaWoWlgD1utNw&oe=6B084F54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "4098828203474620", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75435287_4098828213474619_2522357510769576592_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EhcK34jBmMQ7kNvwFJeZ-f&_nc_oc=AdrCmnJKwZ-gghgDzKg0Wx2elClI5wFkVyROUbHrOGvN7WHpC4hTuQg5HOUYakGFYCw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZwxJVqHzES3VIUgtEwRIfuzyxARLTtZ-jhoQruzStXA&oe=6B086C50"}, "display_name": "Beat Blaster", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n4 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, the new 3dRudder, tilting the head or the intuitive and original control based on the movement of the head. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all moves in the game are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and a single life to dodge or kill all the enemies that will appear to the rhythm of the music.", "short_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
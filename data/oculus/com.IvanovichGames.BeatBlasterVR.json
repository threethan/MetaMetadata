52frPIicu9E0YsK9_4XTyPQ&oe=6AFC6209"}, {"file_name": "screen2.png", "id": "2825297704380463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348045_2825297707713796_4280977966268630756_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPibBzLYejwQ7kNvwEEuOdv&_nc_oc=AdqVJVTKtUnYkLl0lx_TexUALPRRc8eOBTYvStbXcPCODNHLVhu2Tc3KnsJWapK3MlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPDlqUsdfaKx81CzIlkvf68FVH_E0SejTVH4qiqLaDrQ&oe=6AFC7EF1"}, {"file_name": "screen4.png", "id": "859117427994217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75568729_859117431327550_6758189037787699058_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewyLNvh6lMsQ7kNvwF0Pu_o&_nc_oc=AdpB0_vkzgpCa4VvVVVRHC3WpUm1g5HLna5RbGTNIciY_tmbo5FvfnCn-TwEqYnbEJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMGoatbdZFnyeEr06B5GrU5V_8cBWUHlwqPm5Vj2WqEA&oe=6AFC67AD"}, {"file_name": "screen5.png", "id": "511938266443737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269160_511938269777070_1067552805106397481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOFjVtRGhq4Q7kNvwGtyDid&_nc_oc=Adprd8XOr9KW0UT2uNY3u3rI9Oi9Jc_UEeEFIdclQQziesbBPj3Wqejb_99E-YksjGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr6_WyvgFg84EvlEOpX_GGl7Ka6FkaojmLPh2ln8iKrg&oe=6AFC71D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "4098828203474620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75435287_4098828213474619_2522357510769576592_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLgAXjy_eswQ7kNvwE-68S6&_nc_oc=AdosBbQcP7mmDLNin4MHY9uCYWAPuEzrbc-4TyKS5MKY41jenrTycDO7L_ZjlRBOZhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPX1MMH4DeisG-RWfO8NLopsSqBJfAyVdAldvM3wZ21A&oe=6AFC8ED0"}, "display_name": "Beat Blaster", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n4 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, the new 3dRudder, tilting the head or the intuitive and original control based on the movement of the head. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all moves in the game are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and a single life to dodge or kill all the enemies that will appear to the rhythm of the music.", "short_description": "Beat Blaster is a VR game of shooting, running and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
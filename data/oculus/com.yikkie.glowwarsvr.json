DzfNPfac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUweRr4vO5BE-kCGamBft8pl5ImXdgtLTBJuvEs9FG4Mw&oe=6B104B35"}, {"file_name": "03_story_map.png", "id": "1472450711496870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1472450718163536_8748214161866240068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0opRocEw9QQ7kNvwHRPBAA&_nc_oc=Adoq5-5Jp3pyHSDGF2St8BXcRb8fmFiqtC-3X_qZwtmvmrOWjY0zSDkT16mxiknIVaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX10chInba0_AtAlRqHnNnQQpixMYaddXo7WBg3eVjG3Q&oe=6B1057C7"}, {"file_name": "02_weaver_boss.png", "id": "1014776371698213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1014776375031546_1434629317992301983_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IHdtGFapkwQ7kNvwF5I0up&_nc_oc=AdrbuA2H1rTFAwwi3Hn1VdtfkNYWNC167TuR20vEgpG5BCuCCsSHfrFEw0KbyemTW7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9sRq63WasaWijiO7TkwG1jFa5lF3fopL7zADzbeSD-Q&oe=6B1044E7"}, {"file_name": "04_outpost_shop.png", "id": "1869696994483690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821746_1869697001150356_4614586916403736066_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzrCgNHuxmgQ7kNvwFYEXpV&_nc_oc=Adri7Qo7Yfko0G9my565ETa-TsH8AQGdAZAo8GCO2fy-ug_0JmLlnf2uFJ3QhHFEDBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEBpsXZJGsgn1oBwqnXfbPaJuZ64eK4YlzUn8M2Rd2PQ&oe=6B10649F"}, {"file_name": "05_ember_dusk.png", "id": "1550614010160380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828104_1550614013493713_477166103185177345_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4-afrr_NS0Q7kNvwGeYxgQ&_nc_oc=AdpaI6lmP4arI3UF5JvQ53bJMgRwSRxJKmbtusehLHJ7tGlLspqYYJHWofbBETB0_7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjmGWXGmCDVXzl2xMEARiaYCHv-RnHKsBIDG29mRcf_A&oe=6B105B54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spacetime Wars VR", "keywords": ["arcade", "shooter", "neon", "synthwave", "twinstick"], "long_description": "**FLY. BLAST. ONE MORE GO.**\n\nSpacetime Wars VR is a neon twin-stick shooter played on a glowing grid that curves around you. Every kill lights up the space beyond it and feeds your multiplier. Easy to pick up in seconds. Hard to put down.\n\n**STORY**\n\nSomething is tearing its way into every universe. Cross each one sector by sector, choosing your own route across the map. Land at outposts to spend the credits you earn on weapons, upgrades and extra weapon slots. Find the rift, destroy its guardian and seal it. Then jump to the next universe, where everything is tougher.\n\n**ARCADE**\n\nPure score chasing. The waves and wormholes never stop, and wreckage drops eight different weapons right onto the board. How high can you push the multiplier before it all goes wrong?\n\n**FEATURES**\n\n- A battlefield that wraps around you, sitting or standing\n- Three ships, each with its own trick: warp shield, time warp or wormhole jump\n- Build an arsenal of up to six weapons, from the Ripple Cannon to Halo Blades\n- Six bosses, including the Weaver's laser web and the Pulsar's rings of fire\n- Gravity mines and rift missiles that bend the grid\n- Easy, Normal and Extreme: harder levels pay more points\n- World and friends leaderboards for both modes, plus 20 achievements\n- Built-in training, and every button can be changed to suit you\n- A synthwave soundtrack that drives the lights\n- No internet needed to play", "short_description": "A neon arcade shooter that wraps all the way around you. Fly, blast and chase the multiplier in Arcade, or cross parallel universes in Story: pick your route across the map, arm your ship at outposts, beat the guardian and seal the rift. Three ships, six bosses, world leaderboards."}]}, "developer_name": "Yikkie", "developer_privacy_policy_url": 
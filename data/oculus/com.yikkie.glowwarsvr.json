=1-7&_nc_sid=6e7a0a&_nc_ohc=RsCYq_vmrK0Q7kNvwHGbpWp&_nc_oc=AdpBsfmM_geEE6oIF3XIeZxbucgLZWJOydXP9MJJBntsMrniOOe0vG8GVQzNagGYg2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtTsx4MkEwPr54t9KUJszYaeQO9kkjn33TsJoz8jeZRw&oe=6B106C85"}, {"file_name": "05_starling_flock.png", "id": "971134515756344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771254_971134519089677_8827727383328026043_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOE-jqq-C5kQ7kNvwFQkX4q&_nc_oc=AdpIIxZM7pZBz1FvtZomB_foeFfWMBt5kCgPNG34raS91N_blijWPVBgdI6MOPkTEIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfSydFmjRyMyPHiQlzTv-0FessEbDv5Ql88iHSTft5ug&oe=6B103B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "3387847028069688", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771314_3387847031403021_2817770307858873001_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igfD8QV3SmIQ7kNvwHZ0x_w&_nc_oc=AdpXgHyO8QNCy-GkrkaYbbkEq6Ma2rvABuNWK0cmXt2UTfZ3fchma2EowgxlJWmRw-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfxX9HTUzC4jEg5ByKH_DtZ8suaMbs-9fYxnSuVqNi9w&oe=6B106205"}, "display_name": "Spacetime Wars VR", "keywords": ["arcade", "shooter", "neon", "synthwave", "twinstick"], "long_description": "**FLY. BLAST. ONE MORE GO.**\n\nSpacetime Wars VR is a neon twin-stick shooter played on a glowing grid that curves around you. Every kill lights up the space beyond it and feeds your multiplier. Easy to pick up in seconds. Hard to put down.\n\n**STORY**\n\nSomething is tearing its way into every universe. Cross each one sector by sector, choosing your own route across the map. Land at outposts to spend the credits you earn on weapons, upgrades and extra weapon slots. Find the rift, destroy its guardian and seal it. Then jump to the next universe, where everything is tougher.\n\n**ARCADE**\n\nPure score chasing. The waves and wormholes never stop, and wreckage drops eight different weapons right onto the board. How high can you push the multiplier before it all goes wrong?\n\n**FEATURES**\n\n- A battlefield that wraps around you, sitting or standing\n- Three ships, each with its own trick: warp shield, time warp or wormhole jump\n- Build an arsenal of up to six weapons, from the Ripple Cannon to Halo Blades\n- Six bosses, including the Weaver's laser web and the Pulsar's rings of fire\n- Gravity mines and rift missiles that bend the grid\n- Easy, Normal and Extreme: harder levels pay more points\n- World and friends leaderboards for both modes, plus 20 achievements\n- Built-in training, and every button can be changed to suit you\n- A synthwave soundtrack that drives the lights\n- No internet needed to play", "short_description": "A neon arcade shooter that wraps all the way around you. Fly, blast and chase the multiplier in Arcade, or cross parallel universes in Story: pick your route across the map, arm your ship at outposts, beat the guardian and seal the rift. Three ships, six bosses, world leaderboards."}]}, "developer_name": "Yikkie", "developer_privacy_policy_url": "https://stw.yikkie.com/privacy/", "developer_terms_of_service_url": "https://stw.yikkie.com/terms/", "publisher_name": "Yikkie", "support_website_url": "https://stw.yikkie.com/support/", "website_url": "https://stw.yikkie.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
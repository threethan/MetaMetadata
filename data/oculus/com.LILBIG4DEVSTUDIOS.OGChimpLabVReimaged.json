less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jh0NV2ijC8Q7kNvwGQy7z2&_nc_oc=AdryFBsoT_ggaSiZxQFXdQJJPyDF20bE2DCRLAROVh1QZ7ppAaIi9CEyh4j8t94d3UE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIRY6UjOXnFfc-BftSnRzF-19whEZX6-sNZOMV2Abtqg&oe=6AFDDC97"}, {"file_name": "13_imresizer.png", "id": "24163869343314018", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821919_24163869346647351_5311270283110490660_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z1xLLdawbUQ7kNvwHQmVf9&_nc_oc=Adq8N3ESHDCioD3-ThpqPwSMuta-3eSbL6e5Lcq86mZK8TRQXK6J8OLYuwplY1DOtWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTExgcmfBEvKIiXnEopKzpfgECOXzxGJjFuaCWMaAOs0A&oe=6AFDD36D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OgChimplabReimaged", "keywords": [], "long_description": "OgChimplabReimaged is a Gorilla Tag fan game that takes the thrill of parkour and adds a terrifying horror twist. Players must climb, run, and leap through dangerous environments while being hunted by monsters and tricked by mimics. Survival depends on fast reflexes, sharp instincts, and the ability to keep moving.\n\nThe game features two main levels: the abandoned facility and the shadowy dirt cave. In the facility, broken machines and dark hallways hide mimics\u2014creatures that disguise themselves as part of the environment before revealing their true forms. The dirt cave is even more dangerous, with tight passages, pitch-black darkness, and echoes that mask lurking threats.\n\nThree terrifying monsters stalk the player across these maps. The Angler Fish uses its glowing lure to trick victims into approaching, the Sawrunner chases relentlessly with unmatched speed, and the Gus Zombie forces players off course with its slow but constant pressure.\n\nBeyond survival maps, the game expands with the forest for freerunning and Chimpshob, a tough obstacle course built for skilled movement.\n\nOgChimplabReimaged reimagines Gorilla Tag as a horror survival experience where every chase is tense, every shadow suspicious, and only the fastest chimps make it out alive.", "short_description": "OgChimplabReimaged is a Gorilla Tag fan game mixing parkour and horror. Explore the facility and dirt cave, where mimics and monsters\u2014Angler Fish, Sawrunner, and Gus Zombie\u2014hunt you down. Test your speed in the forest and master Chimpshob parkour. Fast reflexes and agility are your only way to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hidinginthedarkreiamged/home", "developer_terms_of_service_url": null, "publisher_name": "lilbig4dev", "support_website_url": null, "website_url": "https://sites.google.com/view/hidinginthedarkreiamged/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9871870732915649"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4233327966956132"}]}, "baseline_offer": {"id": "4233327966956132"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756836060, "status": "PUBLISHED", "id": "4233327966956132"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23941601388849347", "version": "1009"}, "id": "1692139354825406", "channel_name": "LIVE"}]}, "is_for_ocul
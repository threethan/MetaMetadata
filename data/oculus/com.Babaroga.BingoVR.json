iler_thumbnail": {"file_name": "BingoVR_Splash.png", "id": "399349199397459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_399349202730792_2841244862677283201_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_Wcs_neQSsQ7kNvwEsbaPc&_nc_oc=AdqPhOLr71_FXntQxMODUOTTyH5HW1YQ0021AMs0F4y-il5oPvw9ueXk2cpCoU7WX5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkUWJvYCq7HYxw1qh_yte-s4nzDYtftDEjVbwKQu2SxQ&oe=6B0F119C"}, "display_name": "Bingo VR", "keywords": ["bingo", "casino", "entertainment", "poker", "casual"], "long_description": "Aliens. They showed up uninvited. They are taking over. They are everywhere. Earthlings are in trouble. They need to push back and take the fight back to them, to the alien home-world.\n\nA stealth super-weapon developed at Area 51 has been proven to deliver on the promise. What is that weapon?  BINGO!\n\nHow can BINGO! defeat aliens, you ask? It would be too complicated to explain here, but it is awe-inspiring. Aliens don't like losing, and especially when playing BINGO!\n\nEach BINGO! gets earthlings closer to the goal of defeating aliens. Each card is a ticket to success. Make your way to the alien council. Close it out.", "short_description": "It is unheard of that a casual BINGO! game is a weapon of choice which drives aliens to their homeworld and defeats them forevermore.\n\nYet, it is based on a true story."}]}, "developer_name": "Babaroga, LLC", "developer_privacy_policy_url": "https://www.babaroga.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Babaroga, LLC", "support_website_url": null, "website_url": "http://babaroga.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "re
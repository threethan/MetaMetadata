259_4109752961264176646_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHIibvkaGfoQ7kNvwGLEKPk&_nc_oc=AdqLqw5D_GoTS34yXGShxbvm7brJ-uX3VtXN1xbKWB3D_pIUHP7rpXtSMDYGDGYT0nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWljq5YUvs79KZthgtssbbkrOXTO1dHli9TwzcmeBhY_g&oe=6B0EFAB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Otisdub Tag Plus", "keywords": ["otisdubtag", "plus", "otisclub"], "long_description": "# About\n\nOtisdub Tag Plus is Otisdub Tag, but better! With more maps, gamemodes, music, and cosmetics, Otisdub Tag Plus provides a better experience.\n\n# Maps\n\n- Outdoors: It is in the name. It it just outside.\n- Cosmetics: It has all the cosmetics and a few computers so you can change what people see you as in game.\n- Beach: Relax in the beach!\n- Horror: Run away from the monster as fast as you can!\n\n# Better Features\n\n- More maps\n- More gamemodes\n- An LIV camera\n- Music\n- More!", "short_description": "Otisdub Tag Plus is Otisdub Tag, but better! With more maps, gamemodes, music, and cosmetics, Otisdub Tag Plus provides a better experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://otagplus.otisdub.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "OtisdubYT", "support_website_url": null, "website_url": "http://otagplus.otisdub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
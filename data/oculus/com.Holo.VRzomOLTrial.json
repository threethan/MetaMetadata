ng?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEsZ9KMhiegQ7kNvwFFwwpt&_nc_oc=Adoi_xl3wtHShNuKzJw8SPG4wyjEpVT8OtMRRPRwSwqiGigWCqhuFiKbFZH5cxMgtBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNBR7zG87tI1MQ0O_ZydkKbJdBFy95f3U7yMu3mLH4yA&oe=6AFC63D1"}, {"file_name": "1.png", "id": "1149189347016617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619715_1149189350349950_8293807948130561885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCSQuIiQ3FAQ7kNvwFaUA75&_nc_oc=AdohC5nozZANwTGdaCuCdCXG0TMRGCnt21hFO5OtmuK0k6dS2AqjYVw1xwX9-qQu4pk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXUDnfahXIFjxirTzOTUTunAjYSpKFIW1CdPthzFXxKw&oe=6AFC9071"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GabPmNyOj9UQ7kNvwGnpmVA&_nc_oc=AdoYV5k90t9I6bcpmgvDmiZ0G28ipDRyvjBOWwuLK0K116576u1H85lOcOLqh7fI1Uk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwOAau7MITjcbJqpTNzrdYZkqvpsa7khbJLkxpKImB0g&oe=6AFC7BBB"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jxMCp3I9LMQ7kNvwEvAMsm&_nc_oc=AdpYn_4Y3v4oxl-raO-8tL5V9PLVPHBLKe7u4les-COyOCGxIipegK0uqpjQicDepoA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeMTBRaTtpt6wbXtobHaxAR2Lz4Wc80Qg1u4Xbp9cgCg&oe=6AFC6152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxn888dvrAQQ7kNvwFsRuag&_nc_oc=Ado2KYTrw_X6nsdtORL7J42ttssBPlwicC7uHrKWc7raGSg3bnobXKVjrLkELukHnsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLYuEdwI-4P04QNSnaHCGdfTf7z_DmB2RdBj3oRNj03A&oe=6AFC8D68"}, "display_name": "VR Zombie Escape PVP", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vr-zombie-game-g3ie2e.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
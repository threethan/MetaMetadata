ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBobbw1oqaQ5-H7RP7qcrKvWd2vXCJWBhcrr9ixz3ghtw&oe=6A578CB1"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj3gv71Pc6kQ7kNvwGjnjzM&_nc_oc=AdqG4z99x1sUHQ0AhZ4WKuNn6tgbBQ_15PWrobIIBDS76PGrNe9vemCbivLCYKebUj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9jYx0Pdgi2E7nhSgnLbspzE-cD1eewucnSkQtXERaiw&oe=6A5777FB"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft9jG6IaFGYQ7kNvwGH_ef6&_nc_oc=AdquwIseTpn4W4houx1MDbJrWPZJuVnecmTKWWuYypAdWu4KYdmE0GYAC-xgrxPtkhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0E17uPnbD5uy-nvI0po4qdEUIugx1tmIQFl26XoCXfA&oe=6A5795D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlF8a69ANfwQ7kNvwGLoci0&_nc_oc=Adogy5cE60fcKLnbCqbTli4JDhC4DkzdY_0LGwgW0TP0QNNur8ZSYSS9c0b70G-PXA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnJ5IOVSkLNaGmB0u_1RyvePBHFfQPMHakUPBf62luw&oe=6A5789A8"}, "display_name": "VR Zombie Escape Demo", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27542360275402406"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_1999752730865108_6494154587866268392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfbUG6K4KsIQ7kNvwFVO-vr&_nc_oc=Adon3Vec9vYuyg2XZy4YJ1TnQRizDxbje7GJjt1ei_fciV_p2UdadtmZC8il0nWIRxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.
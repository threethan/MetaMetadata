scdn.com&_nc_ss=7f20f&oh=00_AQRhGMfl3k9x5dA_0dFALa3Ip5i9kPw0XK-1-N1x1BSKeQ&oe=6AF9C0D1"}, {"file_name": "1.png", "id": "1149189347016617", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619715_1149189350349950_8293807948130561885_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-3ceat0mMYQ7kNvwG2FVNa&_nc_oc=AdqI2ogP7KVs-EtaMVmVLzKoaUCkQ-DK3DHaFVsJfAVgJ5tAoXvcTy4AyA2XkHqu8VA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmnqEP5Zun95F647QinrAG3dWLyboZtt6oEwsCkLKg6Q&oe=6AF9ED71"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAXI-Aor88gQ7kNvwGSRpru&_nc_oc=AdqvGaTvqhQQFtpOEk4a7ZhtSUAeqXYH49gmqBTLgVF-6jlgw-2wQDr-4Rzyr2ZB4fc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB4SphkhdVAfwRNOQ8KaF-yLyo01t9qWKbQd8e32dlfA&oe=6AF9D8BB"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7KxJLqgi4AQ7kNvwHgkdrS&_nc_oc=AdobpzoEA1RIAlDDB22AisqMBlgaOGEN3W_XyA2nNta3DIoqzhGYA8pNgBghhXYIrKU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgTO_qGQGcFhKkfedSgv9qRiMBq1hIGbAoTFWbLULMIA&oe=6AF9BE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxhXAZS8ZeAQ7kNvwHJXI1Y&_nc_oc=AdrpdQhyDEywnze8m9sfPxOc-4Mtp0bLbmHeDCs4catWGi70lY4fonKGI8eejcP8hC8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLQ_xGeQc7O8fef-83B4NRoRthbeVPG7k0tXvuqmsV4w&oe=6AF9EA68"}, "display_name": "VR Zombie Escape PVP", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vr-zombie-game-g3ie2e.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MUL
ng?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpGiuL3Mq14Q7kNvwHS9_h7&_nc_oc=Adp1NQ2uNciW0IHkv-G83fKNn9iP4GyWZUaa-7Gf3ImGTxqHnD3gMyifEKCjUbdbAM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2I9a4l2MiEfn33HND4cwbCQeQYHF1XmETKU9agFLS_A&oe=6B005851"}, {"file_name": "1.png", "id": "1149189347016617", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619715_1149189350349950_8293807948130561885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPx4bRo5EYsQ7kNvwGD-fNO&_nc_oc=AdqfILMQsvkUtvBluHnzWUo5uzJ21bZ1PtheTwLSiH1FGdY4Z1HFwQZQgicEkhJt-Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGLOXS6PsOyDhHEsmh1XPaOWVUTMW8h6sjmpyH2kQRYQ&oe=6B0084F1"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2nDsy2ICdIQ7kNvwGBfRTM&_nc_oc=Ado1yH3Cn6fNvA7pf49tYjmtOMPZctUQlpTKef3RkORpLEu1JnuK263jCDh-kXzljuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsbeDoGT7CUPgT85OduK-5o2jgVRqWcG6HWRM901xkaw&oe=6B00703B"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ciuJCZEsWoQ7kNvwGvnByT&_nc_oc=AdqoFQrW9kXJcMlaKlWQ2EMSFqCd-FXJq3v8zP9IiVNpqQPnIZfCUgrot0XODedEqrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2_uiHo-yJ4Pgzb3oGfzKayVKcEMWDAMLT_EtuQzeOKg&oe=6B0055D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhKNe7Qili0Q7kNvwGYkdxQ&_nc_oc=Adrdhrt71FNP6h2K773VUr1rRG4EiV9dZzWrd9ROJrB41rZs_5BfbSxRQLEfwbm7BZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy1lgSgXAP5sBpWcziUtRbfkiNCbpZADAArsqJ747t7w&oe=6B0081E8"}, "display_name": "VR Zombie Escape PVP", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vr-zombie-game-g3ie2e.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
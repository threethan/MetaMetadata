ng?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpGiuL3Mq14Q7kNvwFFxCtD&_nc_oc=Ado_2j3I3xpM88rdMeALavqHMFRoTvUgHr5Ht8LiV5iYgweHUdGH0rChMnmplQEZ4uY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5EYqgjfIG34ZG4lGlCoEOeDKKsgQadyBNOksLaemsKA&oe=6AFF06D1"}, {"file_name": "1.png", "id": "1149189347016617", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619715_1149189350349950_8293807948130561885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPx4bRo5EYsQ7kNvwFVLVb1&_nc_oc=AdrY6KZHLgGXekfeMaEUYd7b0XGrGwIykXgTRrcO2a0PKTVrPGTE1x6UFj_s25y-jVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBr5lY49oEBeic5uzus7Z2MyQAog1WaXvxda_b0_i_hw&oe=6AFF3371"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GabPmNyOj9UQ7kNvwGjS-xK&_nc_oc=AdpAejjRf3eHlAXLo2MuYsXUnBb_TsebrawoM8M2LYwCGoUi3AsgotO7D00CtqvVwAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3QD4FbEcOKVRWfs3z64FH_uiPr4q4ylYsvLXh1YbzwA&oe=6AFF1EBB"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jxMCp3I9LMQ7kNvwEy9IO1&_nc_oc=AdqnsRakV9OP41bdHjR0hH9M5KQUz9zxaKT2fkmhkOzcYWhH2hwH16CxroytayRUXDs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTochqYSzv6MuYrZPlqeVXI-EsXYQODOD6TX7BojFE-pw&oe=6AFF0452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhKNe7Qili0Q7kNvwF0nBsF&_nc_oc=AdpEPPGUm90ByHMy6hMaDWAwVo8qvm77g9L6NdGIei56QGCsgH5msEM0aWOv99JBnBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnwFmPYrTnw7e9NkVB6eo4mcqruNn_e-PaBcWOJQ8XRA&oe=6AFF3068"}, "display_name": "VR Zombie Escape PVP", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vr-zombie-game-g3ie2e.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
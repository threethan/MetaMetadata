ng?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpGiuL3Mq14Q7kNvwHhXbTC&_nc_oc=AdqsxZbqS6Y7pc3BuB4ZZCJpbt3mvueiG1p8Aw5-K2inej6mJ5qpiPm-FbvPjfK4dZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqbaH5EEwHu8-l5KbVMo6r1HD2jIFRNLzIfHkHHBfRjQ&oe=6B01E211"}, {"file_name": "1.png", "id": "1149189347016617", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619715_1149189350349950_8293807948130561885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPx4bRo5EYsQ7kNvwE_urFb&_nc_oc=Ado-j15FfLKl4VY7A7rLqi4z2mrLAfnSf7MnbKmi17G_ul3PBaSfHebyeVCoI58LIf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCmET63d3VoHyKa_oWZTNVKBXLqgXoFDgC9nzi75JS6Q&oe=6B01D671"}, {"file_name": "499619450_835065975558512_2747826044507617288_n.png", "id": "2239788803178693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_2239788806512026_9037851800198914742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2nDsy2ICdIQ7kNvwE5V9bH&_nc_oc=AdqFw_0wVIMNh8N1ADzGMSy6s9o8Yaq8eMdzooKthNwF8qQ7WuWYa0jVfps31EVNg5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrw33-ld7LOPBVQ4IO5JcQRSPMSnZI1DplfqVwMMCSzw&oe=6B01C1BB"}, {"file_name": "2.png", "id": "848766141116927", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_848766144450260_7511083305753347170_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ciuJCZEsWoQ7kNvwHdGJVx&_nc_oc=AdpnvmhR9g3YCVehBf2akGPZsRRSc_kaBIBfxvrfkSsjiXbH-I3qfbGRKGeXqR_GUnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB3_Kwquqwvzwd_Mm4FmSxRAY_pJKMmL_Qrv8Iq6APrQ&oe=6B01DF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhKNe7Qili0Q7kNvwGGaOrj&_nc_oc=AdpF9Vz7bowbTfgW_Eq05ruFe0hNi-LYh_PeWcN2KQ9PyJ-xLgzB3RF9VQj-W3NdrAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnd-sVDN0pzmPXefGOBDEMWAi4UVVVQ1gVpTmZm4Qx4A&oe=6B01D368"}, "display_name": "VR Zombie Escape PVP", "keywords": [], "long_description": "The VR Zombie Escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vr-zombie-game-g3ie2e.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
kNvwFLKBFu&_nc_oc=AdmJ_iM8ZVMbQCw9EkbF6-U_-2wNh78eGfpW0SVBU0SWp3booTrPN6Wipb1Nrrau89k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuy8grCPUKkU6zG4yQVBnlefcUIA3uhT5wRnpBMuwOCnQ&oe=699B16BD"}, {"file_name": "1.png", "id": "1823599864789996", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982518_1823599868123329_3086197029441937060_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z09BiXctOhwQ7kNvwETXyBs&_nc_oc=Adn_W9-dk924G8JbId2CXPyYDWy7qGizs3puiV-p1WAavR2JznGMjM5c7BJYnMRZh4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftgFZxp0gw7kQUzMJKW-_K-YBrfc19ceVIasUOI7NHf2A&oe=699B12FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "1154861575752039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974581_1154861579085372_2296516147183997508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLhv3TKeUIYQ7kNvwE5wDBq&_nc_oc=AdkcuXCHnUkjJCBxvZHJlB0dlpVZCho2HnIWcv43FZQ7XRsUAHiF9_xcu0oDvSETU4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsfSQI90PKW7iMNKcBPzfnQl_azo9sIF2pBxH2qAdKdHA&oe=699B0328"}, "display_name": "VRzomOLTrial", "keywords": [], "long_description": "The VRzomOl is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened"}]}, "developer_name": "Holo", "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "7850424621689264"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "26781769688076898"}]}, "baseline_offer": {"id": "26781769688076898"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719537818, "status": "PUBLISHED", "id": "26781769688076898"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25702750849363367", "version": "0.6.7"}, "id": "7552059071571728", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7821371324594594", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25702750849363367"}, "release_status": "RELEASED"}, "b
b=1-7&_nc_sid=6e7a0a&_nc_ohc=FDW4lZZ-D14Q7kNvwG_9Vx_&_nc_oc=Adp_Q9RAgjkEtFvfCv49_TrV32MmrXzFUnfqx3cupIf3oTqJTHsmboUdBtH-6ezJLkE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI71N3W3tS6ccX-uqCD4lMMRRmf3fS-n7QoiJuZjMftZg&oe=6AAE8591"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMmEhY9VFZMQ7kNvwHIeZCZ&_nc_oc=AdoDanRTg6Wo3f6luypblROlu7C8VOLP-GviRd1XalP9UsI9HMYENpy7X6pTdQvU-48&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr9hGm4TAOCIp8ZzQ7yzimu5vmV10qRtk5g8BvMkbX5w&oe=6AAE963A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNXB3t6kucYQ7kNvwEXEW5t&_nc_oc=AdqPGwo_ihUzbga8p4infBPUJhVOh2NqdO4JI3a6ZGeeMYpuXr_DkkK0VDaofNbHjW4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZzkrsquaffqMZC92_8EPjzbJrS4i7qRAiLTv7zeUYKg&oe=6AAE9A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOWbiA-hYKQQ7kNvwGGq4eT&_nc_oc=Adrq2ArtkteCm9SwPKOePWTa4apbwwcCEIl0YiidQG_hw6eJEtnSGMcwKDwKh36j9Ss&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfJZLtIPgPCZL0aq0Gh8ds6lv93Wu7nbJWACYa6Q9ftg&oe=6AAE8C27"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
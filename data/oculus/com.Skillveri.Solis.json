&_nc_sid=6e7a0a&_nc_ohc=O3BWa1YS9m8Q7kNvwEMW6GK&_nc_oc=AdoYMY2aqexuoQmHYusAFpfDm9fNKCVbvXk5BUeACxWgdZpyr69H9w_YNTEbQN0eBKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdv6TqkIpZi1BWi75_9rgauYYWV2tuX4WdlTx91hJm0A&oe=6AB66E91"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMRy73OhAaIQ7kNvwFvTvkW&_nc_oc=AdpJvWw-MYkXYlUwqG_vuKgbB6s_r4VS9aK6RaSCZSdWWoFLQ-DP583BIWTBNuWuaLM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI85kxfs0EfRbGadXka6Ked0IU09yOyfXK1XX2bWvrEKw&oe=6AB67F3A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dRGqhCyVwsQ7kNvwGJEQDY&_nc_oc=AdqJPvGrfRneq4o2DWDtkS2llT7ngiV-Bl3pvAWa_Sc0dsZHUTZg7AXy7vvWyaN21Js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEGUPXknW9FSZo2uKrDXp3pqD4ygR6hh63UiEy8WsPXw&oe=6AB6838B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcSZ7Ib4wVIQ7kNvwFWdhku&_nc_oc=Adrdnbr9ymorvPMySQ88arLUyFrQhXjAzKmc_Orxw7sngXz1SoEz2nrzarHH9W8vkhs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH8nq9GmFGegRRcPIEpHtAIfhuHjbhUGzwy-IBHtqDFA&oe=6AB67527"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
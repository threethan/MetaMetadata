0f&oh=00_AQRahgbuaq1PUEbFWpZRsIiPCpjHev0h3FHQBkEMRunbpQ&oe=6B085527"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGA1VZjsaQwQ7kNvwE7LNeC&_nc_oc=AdqvbtJnMLn8iPB__q-cdDHdWzQoB0XgK-viW5G4FIouYzk1bJIDcxnmYOs6WNBSsb8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTTltONa5tftmxGCBpUAcy1lAn_dxkZnowoQMVCmZbZg&oe=6B0863D1"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxwchp_EFkQ7kNvwGeVgWe&_nc_oc=Adp_HSx_SJYhY0ZQ1_9XWc1AXY18VN7nAqlJzKpqtbn1ksQiR5yggvllZxBXeiAH16o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv58IhBzjpFHdvkee2KvZfnIcfsDX2VcY3VUrUII7O6g&oe=6B083C3A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCSIkQsLqDUQ7kNvwHoWa7A&_nc_oc=AdogL78GK4aFqk30srFybHSLknc3Nv8RjkwmtyzWKXgJvdgku5qUQiYhAC1UoHTc8M8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReCYyGfHgmTeLQNFYgmRxW7N1bXGXgZtsHxjVK__uLHA&oe=6B08408B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykwz55Xqr80Q7kNvwG4lDdP&_nc_oc=AdpmLCTOIJfyzVlFuWrxGrXzM56q2FexqwhlK87gKf4gmB2PQPKwLAXDPVYcor19i-U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Gowp_YLb9O1My_rSZQJEYE3qaiQqHLPV0Hd7juBJSw&oe=6B086A67"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
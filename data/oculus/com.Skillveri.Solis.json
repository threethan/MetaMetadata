0f&oh=00_AQTxlIQX_MpxTdqhEjq7tO2h5RXvhCV3u76xj4y_MxqSKg&oe=6AFDC927"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwiKk4sE388Q7kNvwF2Rqyk&_nc_oc=AdqsvSwgn52PawODkGKYS-sMZFSCmTIT0U4FA27T7XFIBIqCTTCPyq12EJgFshYdBRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1-dwE-fxh1yeX-CxvFRBMmx5yH_Nzc12iX3WLSsRzXw&oe=6AFDD7D1"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOsjEuuqmJ0Q7kNvwF84Lwo&_nc_oc=Adp5PQPAf3vlfD_eSzI14tZr8ZPoNHcfpeC0g7EZVk-KsHmRMC8UTppyAMfyDBWTaj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFxfpM7UB-vWBOgd1UyedJ7OQtcK-DHKYSiAZ_mE_WLQ&oe=6AFDB03A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8IlGZgeaggQ7kNvwHDmNZ2&_nc_oc=Adr1BIrRo-ObUalWX8ZX9lSi3qHz6d0HT7aqAW60zvEfzke8BiXOklB68CEI43M6N2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFSgyiui3yqBjHd28XLYLFdkYOmRj7tE-AzlgU9GI6XQ&oe=6AFDB48B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnQlSoQ1-kkQ7kNvwF3NNdM&_nc_oc=AdqfJkkXAcFGtjsnhwonXLSSnGTwSEupM5oDT4yH8L05q-bo7fITOgiI2g-rt8jmF5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScmtT2T2XCRJ0rDPGA-RH23e826qlpWy2EsRZ3Fl5whA&oe=6AFDDE67"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
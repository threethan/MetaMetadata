b=1-7&_nc_sid=6e7a0a&_nc_ohc=TPnbENI1IzkQ7kNvwFtYex_&_nc_oc=AdpwH3OWpp02I4ZcRwRgX95vqA0fnnaLrF7OC31u626J--3qUmC8aKy76Kw76TaVcB8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m9MdcZGNv6QurmzTdmLBybwNmKeMcEhzZketFUn6ILQ&oe=6A22FED1"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJpoAWRuxTIQ7kNvwHQSlE7&_nc_oc=Adr1MlsI-LomDeeuu3dMCFa5M8PP3FfSlN0EZp_ZmOFxKmB3CFQmeZKZG4jIJlm1PrI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sS_WnJu-eyOo3J4FCiuGXXhrrUUPTlp4cP9mysuWkkw&oe=6A22D73A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcbJrpeYCGoQ7kNvwFm6ylO&_nc_oc=AdroxGPcT_J7_RAMSxmqdXfpqf87kpdU0h_9dL__xdh4EYkPc94Un7Vl5qc2SKeTgM0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80r9c4oCg75VkRD7VV85kHlFiAK6fQ_y6Bk2EP7qhTOw&oe=6A22DB8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqQK1C2UX44Q7kNvwHLnTT7&_nc_oc=AdpGjgxBiwKyiAglHu-2kQkW6IdUEEbP-WtWPOYsqKQ_dmeEmU7aqRJFivP9xNyPpes&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pn7SbDjmlnb0TvjxxpOHoZbGSCygEUctWMk7jzJLR0Q&oe=6A22CD27"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
0f&oh=00_AQTLwkqE8H9Xa_pH9vwYaiENQ7nR5_LrulJX81a-9kNleA&oe=6B01BDA7"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTDeIJIUKAMQ7kNvwGgLVth&_nc_oc=Adotoc70Yef5-eOKu499TmsjSfMjI-iylerLfDre3_YbNCQCTdF4OdDZVWaoYSt6QOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn9tiLgwdd7LEikdWDyJ4DxRPa-xFhX2DqrmY8noWFEw&oe=6B01CC51"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he993YF_oW4Q7kNvwGg2z9T&_nc_oc=AdrlDjv4NmtY8HxcEMi1vzs_zg_8ktyHOUWh5ikCBFc4s3j0VAs0rDZ8wwT4rrzofDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSubAb4ImceXuiIJIp5skJXWAqqIBdYioPPOx6eQXb7QQ&oe=6B01DCFA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afoawIrjZYoQ7kNvwGb4_1y&_nc_oc=AdoZjfFqsDjS-he9mjCU4IJjqpA84vp1Sv1rMUduZIdd5IC5oG_bPUYO6QLMbiDNJJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHh1LL9oLGRAO4wuIFQBkzqn_dnsUzE_GQmNSp9JJ1sA&oe=6B01E14B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCyxv4my5M4Q7kNvwGDyWf6&_nc_oc=Adqt_51drBiO1CWN4G70WWEjOn6pQ4jVXxdnSuUWyJYkwPgNC2K19gcn62PdcR0HUaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLUFod-0Jir6lWCB2KRSl-Uod2-58hpC6mLD5EWSZYOQ&oe=6B01D2E7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
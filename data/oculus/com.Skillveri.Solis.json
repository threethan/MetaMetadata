&_nc_sid=6e7a0a&_nc_ohc=dSozV6NC49YQ7kNvwGtQeTO&_nc_oc=AdpJyquO3rP0U5U9Ow4Fn9afhbe8dVJSoXRx9mx9J5GHTLtm8bfYKgZxLQ5kxu78XKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElcQvUu0Dvae95WzgIlUNqT6CxdhWATOAU6ael2pqo4A&oe=6A787811"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5MR8n44K5sQ7kNvwEUqEMP&_nc_oc=Adp3lo7GSJj6Nk334l_QMTuHeTMSYk91PodmR7XtCjN7bEBR0j09ZUzNelFc5xgAA-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Hxf47tEzt72v_ADsJE6E9WDrb2ZK2ZtpW0A1qog2Tw&oe=6A7888BA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMb8l-bXE9UQ7kNvwFjJ4uS&_nc_oc=AdoPTfTku3n1FRiyi2goSSlbPrM04rv1vPP1Wl8exe_gbKvJVolfrGAXwV4uDw5BhS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk770bRpjgo-hHbKmEMfa5UkOkrOHfw2KG3F_YVy873g&oe=6A788D0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVnh5llo5F4Q7kNvwEGswxw&_nc_oc=Ado3-dorIuhEbciaPcRP-9von0_OeHejjy0reyuLz6IpcmqcoFDramwhKGagv_qPkig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwhGpiCDuEF4BJTUydjLmthEOa2-fC30U6OeawZNwYYQ&oe=6A787EA7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
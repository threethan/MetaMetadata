0f&oh=00_AQTHSpho8UBtQppYWtCjMgqPRmCa3Xv6wAbhM-Dd_9nhqA&oe=6B0D9B27"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsmBxrJ77DcQ7kNvwEDfLnw&_nc_oc=AdohBcLr0_1YjYNGEYX_lNjmnmtFY6bNVk1nsleIRfB7zy1oa741iFLlzmMWVZGa8m0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVH7q8cKTmzCaVF1DClPlMiZqtpeq_sbHc-p-sMeJ4nA&oe=6B0DA9D1"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahZGMDYv3mkQ7kNvwEKkbAM&_nc_oc=AdoOgRhwFjjHyxgTQ4RAATfmJJAnNIYTPTLOWhbQ_aSFLt522oIrHxPvn6dSrlVj6jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMtiuwqdclv2IYeWjA6w_en9_-NAqD9MrOmceyPHQIGA&oe=6B0DBA7A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKe139GvHWUQ7kNvwHrGVJX&_nc_oc=Adr-AuCutIA6Ez_4elSxRahjy0gxy--3Kh4NpsEd5WadV6fYY_NuN_n4El9qSVmO8rg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1XCCMaSOwi7Pxo9VYDCoO9w8GYRHdULpIpluhbi9s8g&oe=6B0DBECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AK686HdAGoQ7kNvwGeoa1l&_nc_oc=AdoJ5VseGIKa-Wc4LF9LI6uoP2gQdtjxoK6SQBAD2fpXBcAaeLxJvEZ-TUteT6uxmQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSACpSicjht2_dLI5Fw-rEKu2Gx1cc6CsqVwAebXF4gvQ&oe=6B0DB067"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
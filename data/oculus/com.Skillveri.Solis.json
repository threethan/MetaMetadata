b=1-7&_nc_sid=6e7a0a&_nc_ohc=dy3x-FkXC5EQ7kNvwHltPR5&_nc_oc=AdpNODOIplikDz-p_NnmTQ50Fv0FNp7mJ1vbjtHouyXlDq4cndFv7Sge_PCehYm5dZo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuD3sKHMUwB38W2fBe418ygXoUU5Ywew0rqV_1Co_SLQ&oe=6A7DBE11"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp9LfuqsfCUQ7kNvwEV8jk-&_nc_oc=AdrXRUrIWm8a_YQ9UGvLV2IE_rC1R1w80iRW82gkMvj1ukG6bu6PaHEhXnjfGoehI5A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvH1ROaDX6qDU3wspjZuLiRwbI-bUft8v1Zbp2oXPKeg&oe=6A7DCEBA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PusFlFebTV0Q7kNvwET73_7&_nc_oc=AdofckHfew2UpPu2Qmu7TuYdmdeYrOYazPqU0WMpysZ0OYIPDLQ7OekZjUI0wox3ahY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwfoDUYyJkbvzotppogULgbVW_ikbhQuuMtbOANguGDw&oe=6A7D9ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW-odKqncdwQ7kNvwEG-6bQ&_nc_oc=Ado8yIPKKUrz6EWM2D3X4SlbsoM-Q6tpciqexqJ6JT8f0hRUoHrBeT41lDWp_t3LdSE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuSs3AkRmxGGRHgj4pHKXH-tNZLHvGlcGISY5yjpNBNQ&oe=6A7DC4A7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
&_nc_sid=6e7a0a&_nc_ohc=aUXgu63DgMUQ7kNvwFX4ZS7&_nc_oc=AdpvxypZ4NKCu-G2oI8a57_J2lCVam1d9kQimS_NQRpT5AnBxgYPhcpH9zuSwThbIUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYg8UvRnHxhwghBmuV5FtK1B-k0qEx2RBMXE7y8KeNkA&oe=6A5E1A11"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoG5g90qDcYQ7kNvwGR3jMB&_nc_oc=AdrXubl6x7eAwiASLES1y281d13P_imCepzhh7DerKEX4535PmBYxfZB9M-sl_lCyQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkDHrZZu3whv-hwy40OsM7EvIlj4kjTXoe3E0teV1GYQ&oe=6A5E2ABA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpVMQZujpB8Q7kNvwG5zqR-&_nc_oc=AdpYEclannurBeyra4Sc5t9VYHeEe66HVFYQG5R9aFkclnuw0G7nR-2ySPJwGugjJac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZAiyHvGjgK6_cq7ndrMmqqLY4DKRth8fZd-3EWhf4jA&oe=6A5E2F0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CCvbl6HrH0Q7kNvwGH9q9q&_nc_oc=AdqvyNhzoe1ALMG-Rj4GCqta0nw18TlqdTPy23-TysgMSU48QpqQCo5R2Qkkuens3uI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt4hZYLCNvcwqIy27Y2gcp81wwfeukNmRDCl4wskY_DQ&oe=6A5E20A7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
&_nc_sid=6e7a0a&_nc_ohc=rfu4pXanvm8Q7kNvwFQj9Pn&_nc_oc=Adr1h2nZQd9CCiEbirfSv4Dw-2f7pNBAlk3SuhijIb59Jpn8sOvmH81sE0s_bQryRoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0edxu_GVSQ64qtHPItLlWEtcSq8HfctxDlKPLXW1VYw&oe=6A2AAF91"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_bKV2BZ2yYQ7kNvwEYpqqo&_nc_oc=Adp1f506C36xCSG40Hx5TPDAeEKcTIHLckgqgGPk9-E5MfSWnB_1o4oBhbmbo1h3EZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fGUYkLN2nxTz3OYvVQvDfMLULXWuhUbhcMPCA8iV7_Q&oe=6A2AC03A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXutfKjKeogQ7kNvwEQrZim&_nc_oc=Adqsw9Upj-B1EERjChosF1BjT1CFfGaxmMCN_O_ugJtVcQ1vWSCGl93AlCzhr-D8gVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fG91Z_fhG54hl2Hg-KNNv1uYVjPytG7f_ezuOkSKyyw&oe=6A2AC48B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHHvFFHtwRgQ7kNvwFkEzH3&_nc_oc=AdoQhr7CViP_oh4yu_bsJEbTwDRLhgliE-WG7OVatSwgtlEVZojUiUWbtT5f-0p7MHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lv_NVY70F1As02rDtvb2PTf23JufhNnCbWfupxpvLoQ&oe=6A2AB627"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
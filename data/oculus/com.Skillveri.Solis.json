0f&oh=00_AQQd3HDsGURUCpZHPts8OjqoR8l2kAYkJU47VcwZxQB6dQ&oe=6B0460A7"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVpaubsewuAQ7kNvwGnAn_C&_nc_oc=Adoj5s4lq0y2IdnvQTu5LcuPThaow6c98xwsGmMosKNqVLun9QRMqJR76KfNScb6Yj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCbzA-qvYRq3orReQU93tgdUjlzpbnHmWQQvnfe0v7-A&oe=6B046F51"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_kydFiqiF8Q7kNvwGNqvTz&_nc_oc=Adr35Y820uPeBJgDwSl-UZZ4JstnLvt6sMIrIlXZCUYim3Qvo2D7PvPOwYvLu5Z2vjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvO98mAM66wifG47PQ-7jUwenZZC67Duu6NZuK9loH7Q&oe=6B047FFA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf9dyeO34jsQ7kNvwHs-Q4W&_nc_oc=Adqk9L2DW0aeTN1mR3G2pSghIxQqGxPKZK2h7mnSj7PV0bKTWkLgdgVG7m4vwYSUerU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbdHFyoJ825-E7rCPKbYluBDNaVM7D7TR2I83-h16Dyw&oe=6B04844B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpxkD8g9rxUQ7kNvwGWcoMt&_nc_oc=Adqq6oRkubiF8hQcacR4lsDmjBopmImXASQmB7-PJd30g5wbhvsMNE13z1C-oTnHHFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyfdS5NnRLqhjvx6BHhI2kcpORHa1jUdV1gxOiPubO6Q&oe=6B0475E7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
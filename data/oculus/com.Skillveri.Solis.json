&_nc_sid=6e7a0a&_nc_ohc=MtBnjATuscYQ7kNvwHkNPIi&_nc_oc=AdosWvmFgGtjGGjoYGpnJ5GV9fIhAra-bhrA01a-UYdWSLSVEE-X2oZhRyq_0XP47_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZw0phctiGoSiZpB75COfJkks_8tdl9sneSFfSSa0iFA&oe=6AF891D1"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CQ_VMI9pDEQ7kNvwH3TRpt&_nc_oc=AdpdGqBAg2qHW90nXXG4v3s7VpdyXTWASu1-oPHaWjYNOtVC9Wuf-r1zF5sCYAduF8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8uw9BpVOicGyoiqkyi26b4AmTGznoRtCSxXFNBorTtg&oe=6AF8A27A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5fNoPwYSr0Q7kNvwEHWt9c&_nc_oc=AdovTNqAPcRFRGXBmEkjptVyjzizOFgKJrrPChVJngLRfOSvvW5cuGdhgs_wcis7Lw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5egN_igUDOa1hUcp2lej-G1fYL6Ll_fpAYz097_W_ww&oe=6AF8A6CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM8oRRVX54MQ7kNvwEhItjM&_nc_oc=AdqPaQihoHdgP2k0JtfwBKocKJA7NItU94bwKPsWSBtrrUMYmbfYrUEf_az3JHMrx-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsJfMSC2qJG2lTfnwmM9SRBo0vpTUI-z0fYlrBGe7QqA&oe=6AF89867"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
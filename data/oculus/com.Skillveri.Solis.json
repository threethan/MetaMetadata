b=1-7&_nc_sid=6e7a0a&_nc_ohc=JqRGSF2bhpAQ7kNvwF_SSGh&_nc_oc=AdpDPa-gA1z_qoTpSWJ9zFTYSVy6TPo3R0EvfBai4Gd9wxV_GVkNJlFbID35fhhe4IE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dacdby34ISzqEdpj6bFMc8ubvWkj6pU-h2muUNVmx_Q&oe=6A11A311"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0m5yXb1dYAQ7kNvwFA97Nz&_nc_oc=AdqHR0eqqbeEnbqn-DNZxyVq6gfy4o-HWi6TXn1_4H54NxiEKofmgRTTWIsWFEFjZWE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qcKEVK929k7ZG-HXuzqx1r2-u1j5OUiZ9ju4aG8SfA&oe=6A11B3BA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf9CoZ6Ld4wQ7kNvwHELNYX&_nc_oc=AdqvWHrhVY_LSWA_1I_pP6Oa59gXVWS0L0ShqI6_E_UOibZ5Fqxj4673Re_eg7PS52k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uJM-SiuCtEbsbx3n7knm8bq1_EffKkXfvQ4UD3v3PQg&oe=6A11B80B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqkPGzTXJpgQ7kNvwE8qVs8&_nc_oc=Adojx_CR3AvjG22o2h6-JGrjj4jyAvRUg8ICJ8l5N7ni2AREOVLgBSwDagRXd5LyvGk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T1pXM14hxzlhS8r8dgeBesaDBUwmPju1BSuLevgijgA&oe=6A11A9A7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
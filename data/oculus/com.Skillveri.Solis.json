0f&oh=00_AQVA2oMjE_72kV5HIV7mcf1MMfOthOH9x5sX8Ykhny7YUg&oe=6B0EECA7"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsmBxrJ77DcQ7kNvwEvdB4X&_nc_oc=AdqtbNA87szH32JBUe3oX4jNhp1tt1qPBWdCgic7oi-HClfwD2muJMZY9Adw-qdsrTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXITwHwZfv8mpg_skHXRJn7qtUlSq0dLFai7Oe8JWcqhQ&oe=6B0EFB51"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahZGMDYv3mkQ7kNvwH32CjN&_nc_oc=AdqEidEdkvqkiDxvQ9rXle-HNT9picqyoP1qSQRgx0G_4FRg9UPO7zhyYcfOeQOe_CY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULfRATuhH3zmTA6nwPC3YXZ8WZi5DxcpLdZVMy0ECWsA&oe=6B0F0BFA"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKe139GvHWUQ7kNvwG2Hap3&_nc_oc=Adr3ZJkbH6RJJ9V9y8U6oqhmwDIIlQDhmyVfLk1G5jhji9gby6HP2eZOHhFtImZ0rlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXlhOJLPcpP8ox7obt2L1MGWKWIk0LlMQfPSJcQRrkaWw&oe=6B0F104B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6hBuIk9p_oQ7kNvwGS6yNt&_nc_oc=AdprM8W6HdYrCGQk6l2mriOLieqf1CJGlLYNULRNtvHMnENYu3-89WW4Cyp4mxjBlXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBRLWNLh34CGLIX1hn9Td6FpPqgx_b1Gglj2u5FSrhzg&oe=6B0F01E7"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
0f&oh=00_AQRY-lWikonrXtHz1QMNj_zUoytG0PWKssyYuWbnBcFrNw&oe=6B0B3067"}, {"file_name": "Screenshot_2.png", "id": "301638622382240", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982478_301638625715573_7163725450282475504_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGA1VZjsaQwQ7kNvwE4iu8g&_nc_oc=AdpvmVfUifSdYZTyMpW_7f7NhzJd_8HwfiDu4QtU-ni4pHz1hek-nleZwPHX3UeerkQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS81Of2PpMyVwChI04bSZTRow0uhtxosh2r7Wf-QT9Htw&oe=6B0B3F11"}, {"file_name": "Screenshot_4.png", "id": "291183827271954", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982563_291183833938620_4958241594163374519_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQxwchp_EFkQ7kNvwERHAJd&_nc_oc=AdrLiXBZP5uZ6w1lY_WfWdDr91FYzXpopqU3-4S64Ck4GIB10Dj1sqgI-B_wzzYhN00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPJ60KEnswBhGG1Pw4D7TYgYdLXCyq0Kv8CG2o6cQhOw&oe=6B0B177A"}, {"file_name": "Screenshot_3.png", "id": "905235604413483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974858_905235607746816_4122318181401596715_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCSIkQsLqDUQ7kNvwG_HwKb&_nc_oc=Adrr0SIbpEkteJ3epD-nu83eO63S0qZC31gUQw5RhMNcQ6TtvNjzdf32o2gvJ9Gfj_w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvhF7Xvi91wMqpXHTgYnuw86tRG3zYjT7H_UWXF0JMVQ&oe=6B0B1BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "748099210603191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375768_748099213936524_6117994805214965599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AK686HdAGoQ7kNvwHJVq2u&_nc_oc=AdpzsXJaDLRhsGkoZ5F0i2B0iOH9BAIRXmqXt8VmoUIBM4eVAVDp8v-71FrRqiYuhCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9TujgYqtnj8URF1CG_Vx8wKpHOxt8Wqp3Zi0nTnMuhw&oe=6B0B0D67"}, "display_name": "Skillveri Solis", "keywords": [], "long_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar Panel Installation. They can perform tasks like Site Survey, Panel assembly, Panel installation, Electrical wiring and Testing. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Practice performing the activities from the start till the end in a progressive manner. Inside the software you can  perform all the steps necessary to complete the installation by interacting with the various objects using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the toolkit and interact with the solar panel based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. \n\nPlease note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours.", "short_description": "Skillveri Solis is a virtual reality simulation tool designed to train students and aspiring technicians in the field of Solar panel installation. They can perform tasks like Site Survey, Panel assembly, Electrical wiring and Testing. Please note that you need a license to use this product. Request a trial license by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://www.skillveri.com/skillveri-solis-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
ger have to search the entire internet to find and stream footage from popular VR apps, videos, and experiences.", "short_description": "IMMERSIVE VIRTUAL REALITY MOVIE THEATER\nGet your popcorn ready! You\u2019re at the Virtual Reality (VR) movie theater and it\u2019s time to watch new trailers of films, games, experiences, and more. There's no better way to preview and discover new virtual reality content.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersv.co/privacy", "developer_terms_of_service_url": "https://immersv.co/privacy", "publisher_name": "Immersv", "support_website_url": null, "website_url": "http://immersv.co/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SOCIAL", "UTILITY", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "358582152453191"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139367_559762627566041_2107766638009909248_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHaSsviYWmoQ7kNvwFAJcWA&_nc_oc=AdpvG3GB5nU150e2GnMYc2MxNWk901jIvsTtXpCUiltqSRVYeC0t4hSG6UC4OsLMYSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3ekMwaj9H6gB5d-twozuXd7K5VBcK7xJ3vL1QDWbxeQ&oe=6B0DBE79"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Immersv - New & Best VR Apps", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1479888000, "lastRevision": {"nodes": [{"id": "6770021
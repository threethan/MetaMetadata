mbnail": {"file_name": "FB4CF611-063E-484C-B0CC-C837D2AC32D7.png", "id": "1652002352163710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_1652002355497043_9052594886580169973_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0vhty_GSPMQ7kNvwE84B7r&_nc_oc=Adp9djkBtb3vUDhO1lZLWmRP29qLiLFli-lMNyFxTpbsuMGO9YaY0dv8BNagY4dR13k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoUOG2QJSkXg3UCmdL3El86mvI20PMar2PRUAmpE8lUg&oe=6AE4B56E"}, "display_name": "WorldLens: All-in-One Virtual Travel", "keywords": ["earth", "fly", "travel", "explore", "world"], "long_description": "**First Time in VR:** Introducing 3D Google Street View\n# Google Earth, now with higher 3D quality\n- The ever-growing coverage includes nearly **all recognizable cities on Earth in 3D**\n- WorldLens delivers superior 3D quality, upscaled by the AI-powered \u2019Enhance 3D Imagery\u2019 feature\n# Street View\n- Navigate all **Google** and **Community** imagery on Earth, featuring 8K panoramic fidelity at full display resolution\n- Go back in time with **Time Travel**\n- Bring 360 imagery to life with **3D Street View Mode**\n# Multiplayer\n- Explore with friends!\n# World AI can\n- Naturally communicate in your language\n- Visualize your virtual surroundings and location for contextual assistance\n- Access real-time information\n- Act as your personal travel guide\n- Take you anywhere using only your voice\n- And so much more\n# Realistic Graphics\n- Natural time of day lighting\n- Lifelike adaptive haze\n# 3D Quality\n- Dynamic levels of detail enable fine detail, delivering unlimited render distance and smooth performance\n# Comfort Settings\n- Comfort Options (Snap Turning, Motion Vignette) help reduce motion sickness\n- Input Modes (movement controls)\n# Hand Tracking Support\n- Point and fly hands-free\n- Rotate with an intuitive hand \"steering\" gesture\n\n\u2014\n\nWorldLens is committed to ensuring the best possible travel experience.\nBon voyage! \ud83c\udf0d\n\n\u2014\u2014\u2014\n\n*WorldLens is a third-party experience, it is not affiliated with or made by Google.\n", "short_description": "Travel the World in VR with Google Earth.\n\nfor more info, see: worldlens.site"}]}, "developer_name": "Boe", "developer_privacy_policy_url": "https://privacyp.worldlens.site/", "developer_terms_of_service_url": "https://tos.worldlens.site/", "publisher_name": "Boe", "support_website_url": "https://contact.worldlens.site/", "website_url": "https://worldlens.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28636028402766854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_2587613498253528_8446861255019273821_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBe_djHihccQ7kNvwHd5Y0n&_nc_oc=AdoN47sMFmfcjE8aWmlJI_IgYztVAo8-a7BVGT8zi-066FMv9TLy6crmCyw_qFA3rDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0IV8Dbl2mifGgJizO6lo7Uy-ZD-33c3Jrg1m5YaCJrQ&oe=6AE48D32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WorldLens: All-in-One Virtual Travel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"t
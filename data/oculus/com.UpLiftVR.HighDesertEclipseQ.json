wBSdZiuuO5tUq_2jyrLA&oe=69A6BBF9"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvs68KeOw78Q7kNvwGEeA0-&_nc_oc=AdkflYHTfYI3PH4HZ7M1LPV0_yymBGhXh2g_dr9ZJrFhW1-D0qH1fVOzwhcb1IR1gUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvp38w8xzuVgWfP-tEBnCLYCFBVPjaMbInkWOkJ1ugxdw&oe=69A6D4B2"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bq4UQghU5wQ7kNvwE9P6AX&_nc_oc=AdldlnKw5ySdmsi5eJp6qe00A1BrGYUa_JC7r2QMKzpIVXpjAWtpB8HbaGlsZxG5fyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3xfXeQOnSAmLoGxLNUWZGbSN8cMS8QW9lmP0LlyKHoQ&oe=69A6EFF4"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zhs4q_NIGDwQ7kNvwE9W4oa&_nc_oc=AdlOlcLBWEt0uzFPtzFHStpmMp7Th2Ki_hxEidEmKTe09qOzczn1cp5D5--AjgNN9Hw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsdj9pEomYpEqUlTCFgjF61PmMFmy98Qs0zjEoVv4qAag&oe=69A6E8DC"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJWJkIoxoMcQ7kNvwF_L5j4&_nc_oc=AdljwKgsR6Ou8mVc5fwRooCVjULXZ4YFZ7UKRC6D1y6E3Nz0hz9TgUKFYCDYOocabJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuv6lHUY1YUaqrTxmqq2dSbY59OdAgikcetomfjAkmtfg&oe=69A6DA0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
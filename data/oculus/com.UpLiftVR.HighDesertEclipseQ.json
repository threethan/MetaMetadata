ate-TIme.png", "id": "516747656177237", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghl3qi_-f1sQ7kNvwFXKpxf&_nc_oc=AdqoPPvHngQph_COYPMNdlI5erN7ETPjQG-GA7ncF7G_ApeeIX4bSNhN1y17yjvfcpA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpjYUfculKyv5fUZxXZP4z2onLc-RI4gfAcxYPBnEJOg&oe=6A8EBFB4"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeGC0h4KHOwQ7kNvwF3hyOo&_nc_oc=AdppLqPIQajeylbJPF30PgjpHqDcXf0qHmwaIp3I-m3Y2w0DVY11SDe0HUxMiDgLE2I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLToSymzq_a29J1H4-W3qjKdvmfTirjRvKU9pe5quzvQ&oe=6A8EF0DC"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK42qHZ6t5oQ7kNvwHclx_H&_nc_oc=AdpPOITmqqycAsmZnIcYGQUgaWGuZAbFxasrkGEgFhY7GMJN8fkQt4DY-iuEmC0veos&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf8Ea8tquqrfE_IpSCKCYY22zHSAFwKpNnLJVbcaCRgQ&oe=6A8EE20A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "721925232159370"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "956510560105439"}, {"status": "PUBLISHED", "id": "26152807007664443"}, {"status": "PUBLISHED", "id": "892055756693175"}, {"status": "PUBLISHED", "id": "853386094317346"}, {"status": "PUBLISHED", "id": "4153774414892518"}, {"status": "PUBLISHED"
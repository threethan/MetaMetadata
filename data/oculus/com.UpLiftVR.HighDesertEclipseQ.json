XpWs737qkllY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Gkmd6CaojAXMUpQISEb-ZRYPBgOBbSV1i42zQwKNO7g&oe=69EF76B9"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUJchUY3BpwQ7kNvwHAFE15&_nc_oc=Adpt0FyN0yr9_kAJNDvrNlZl3gSJfEqrQK5KD-M6v7Hw_1Dqm9HskoGA-_Sne2sloa0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11MxnNirOqcrp49vQfocQFPavujT8X2L3YrNX9OomoQA&oe=69EF5732"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO5WjczJaMsQ7kNvwF8aNHC&_nc_oc=AdqpdSBgqqgmQ-X43BVAnAWhEJRu0HNjsWEVCoSJG8JvfnCiSeEInaqUSrjYbDe87cM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VbOvgxBui1SpnX3yffzHKmxReFf89PCOpH9nMtuSrLQ&oe=69EF7274"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NpoXABLel8Q7kNvwFEOwTN&_nc_oc=AdpMYwsn3rgtL-vijkYORe6AvBPT0nNNpCH_BGdb-3C6a7Mj3-daMITrNixQPOeHCmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TZFUhqGzUgrm78agPk9dZaKWv7GYUK7X46ZIoPpakDA&oe=69EF6B5C"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjZ1hrAnBz4Q7kNvwFv5BRh&_nc_oc=Adr-UkTZhnjfjJghR1qo8CuTLq6V2FY_j8Mu7VHjDsugG1e3hTwX-jkz9vJYpU2aOBA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tkJingpQIIJJtNwZGbH7OWeaD3x9Loys3iLmxvK13Yg&oe=69EF5C8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
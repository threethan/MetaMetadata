Baa94siYG0Jw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQjkoZ4V2nftQ0rjHhySCCEsByp5fSjQi9zBkZQpLDKA&oe=6A5A4039"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIm_GXkFwmYQ7kNvwF_Gm0Q&_nc_oc=AdoMe12tgwiB2KtP0sV_qhfLNQOnB-9up71UyTeQQQMBuj48M_RXQp9w_sjfzbVHHl8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATILIz3PMrFJlv1SoUhxUkR_Bl6p6nXiy2KnLJ88gDqA&oe=6A5A20B2"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shG39QbZDxsQ7kNvwFzJ64_&_nc_oc=AdoKmM_lPcuc3l8eenSTnrIA8FPQsBdpilBLyvalQH8VKx5J9Mg6D4L5X0oZ551ZbuY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1CJHwcvUg3_Dgg_iWwhTocZ8IlSRK0TdZfuyen3TAug&oe=6A5A3BF4"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HlztYjBTa0Q7kNvwFKVLGJ&_nc_oc=Ado8Ic04CIHki59kwB-_WmfLOxHQiXvso7kacGnrmPXn6ViapGrTgye7byOpsyi4XmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFIVeHEbZ1D9k_HbUZyO-daMh7jzlQchM-hHgXBgUHUg&oe=6A5A34DC"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SQbJo0f4xEQ7kNvwGKG0RJ&_nc_oc=AdpoFokuq38O6xbcZiBYlFTiF9uVw3SD2_fQ6njvBobq4C_vOqvOgi1ey4EOTvqodlo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD0joINSzFWwSvpnTxucBzBXWFdQYX6G73DYUIvzBwig&oe=6A5A260A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
vMjv-MbEGfb7W6I7H4Dw&oe=69A2C779"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCpSgPOuDw0Q7kNvwF5HR94&_nc_oc=AdmJfSrUa777Qc1h0hNbNJO5wg4vAIS8LXWWGw482R_gxT_ljZmb9rvSDsd-L65_Rq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbKbvLjmQJg0R_Tag_IlBv1eCamwkAK8PGlfLfbdu-NQ&oe=69A2E032"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLv0gDUH83cQ7kNvwEVyvlQ&_nc_oc=AdkauvJEJmO5HsyuVz0cbE0cOjuzKeKyIJLLSv-jm-hqe6TTCFzoOWyf9rhiox9tl8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_jSWHHNiX-hQTvoOKzvBrgNbB_aSaHuj3KQNtWWygZw&oe=69A2FB74"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9aEUEp2cmgQ7kNvwG_M0Pq&_nc_oc=AdmwFHCVXBdOLWmBu7RZoFZDgBJQAI0zq2Tlm66INk2yaR7_Z65GKmjSxuexHjoyLCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afte1ORN1KxNlwgpYuy733aHfBHR0NJbhXHOkMD6RufqIw&oe=69A2F45C"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bvul-9Y560Q7kNvwFfvUjz&_nc_oc=AdnMcwWR9LOAqgN3Z0ag_Q0AXNejRz1a-CfWZtMc0zZWl04j0oC3vvYIBoUkTQwIls4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvr6ioG7K13r-jbHRcQvahNEKM3nbnqYAjJddixzj6qiw&oe=69A2E58A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
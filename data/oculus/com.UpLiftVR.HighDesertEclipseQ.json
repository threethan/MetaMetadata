uF9cta1m_vrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YF_3SvfFGanrvW8p4qkQ9km6e89DKn6QD3IEfpeXvEQ&oe=6A0DC939"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qw1KM9K9FQQ7kNvwFViR5C&_nc_oc=AdrmOdBeYv7q0LYFBQ0QTC_FLUZJlPkWuu9U5TjUKRFfNu77N4EAWZMxBKi8bWY2kY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uFy0Pw7yj-Uq-aIpZWSt2hfpkrCpuYxRjzYoWKAC5ow&oe=6A0DA9B2"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7kHxE947WkQ7kNvwF-8Jpr&_nc_oc=AdpC4WYXq3ND6Lac4tsMyV0u55gqtefyiEb2fTh_Bxu6JwNnu3GXMoo--G3qK7OGVjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60ng6OG6Z8tN7QsJ1obiJKS5PJ7d48qCRCPNq1WXOyjQ&oe=6A0DC4F4"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7z6Y-QHdeMQ7kNvwH-d_ew&_nc_oc=Adq2vofTIMjjgE8LXDq3bs41jfTd-jwwjdmxWMRysYbKTHBQTJ0nF2PPplEIR-7bl_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XQ0T0i69YU-fW4HKF3ZPNo0GLPmcKxLjwJcZ9wQC50g&oe=6A0DBDDC"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRBsyU1nYlUQ7kNvwFsCa22&_nc_oc=AdrqgvPv0J9xXF8HDA_NKC5P-17G_tMgqL3w4cwCKfNtZ5bs20In0pHMSUN7t1DPoJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vUgJRdCo7YN4vnx63gOAkLNzzkIZ1Vtd7gH_1Wf9Nfw&oe=6A0DAF0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
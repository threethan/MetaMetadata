aoi1rU1vIb4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zMuagYEBR26QzweFoVsVs6L-fudMp18jujfDc6olOKg&oe=69D90D39"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2AbLQJMFtEQ7kNvwEnY3mn&_nc_oc=AdrpnoCi1sGse-Lp_eh0pKQbgaCW8TCmcbU2BywXGQYS4AdFGt6FwNgSzWh4rL_hxPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32lSKs2WttgzkBOLyVe3UsskE3McGSuIQKqvbLnKdvbA&oe=69D8EDB2"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF5xl8b3q90Q7kNvwFfZah-&_nc_oc=AdoJemZSQPlsK63wRPil-WedqbI4DMBm3gfGpo4y_XcwwUGjUXz9950nz1UUqhZYbaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yXScZOmHDUeszkPwxVHKosfUchnI-4K1q7Ri1awYcYA&oe=69D908F4"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWXGSehO7ooQ7kNvwFmNUSF&_nc_oc=AdpUJMsgqaX0bQYdoS6XhlXPt_oYRk5_mskFsdAY92kWajbu6agbAWkITBpX-i4sGbk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MnKGcDODba2TbsrjpItmypteX4CqijpUbi-2TPCsvWw&oe=69D901DC"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBAGK8NysosQ7kNvwHPfEmi&_nc_oc=Adr_vkY_J-_gOeXr2_ZH9nxRkfTzIUG4BaHbj_lR-pubRO8kXSpAgYHOGqxx2CS24IM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34rYfDE--OndSnPTIq8pi08Ck5jTBDtI2p9PIuzNcnqQ&oe=69D8F30A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended
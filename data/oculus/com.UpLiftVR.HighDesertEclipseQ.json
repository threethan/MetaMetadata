arJOYS6Aqr-0BBdFn8Kg&oe=69A56A79"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCpSgPOuDw0Q7kNvwGY3by-&_nc_oc=AdkQzzARGUqAXjJUttXLxew3ZS55CortU-tXbmlM0-oCE8dZkCcil9jg93zEAQX04ts&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvjHAO_Htl42OcUNXmbDoCq2Rh0rDO9RhVeGGTN29Padw&oe=69A58332"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLv0gDUH83cQ7kNvwGLWe0Y&_nc_oc=AdmsiEPgYjwSdVi1-r0OqtBPfJMx9pNnmnUbDDGUU6tmCAkpw63-X5DmaEqEqdPapxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuGPe14ZnBGRdUtdbFD2czah_enqueydA1Y5Ymuv-Q6yQ&oe=69A59E74"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zhs4q_NIGDwQ7kNvwFXnDEl&_nc_oc=Adkpm7gq95dsG7x94DdALrLTOodPTDRGsY0KZt-Can6f82tR9Jgtvrw74b5BhcC_rj0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvTb7c8sA3ExDuribZ0ErMY7CCisTkEhX-huwcYiuEFKw&oe=69A5975C"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJWJkIoxoMcQ7kNvwFDcLkH&_nc_oc=AdmNV7ffVW-DPQQfuoH_VkaMw1K9c6IkDUBiGmDHW2LnmImr88As2ixwm2z0iFqfC5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsHzRuzrA17nHiMjfrArArlySoy7PC-zYmvHv-ACBBciw&oe=69A5888A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
/38974842_2831177350482513_4280415891059675016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtBwVj8TAGoQ7kNvwH3O9eG&_nc_oc=Adq7LqC2HYjreLaFNLy00l5BzM0b_fVXVlZMApHPdGNtbdnHkfVkiq_Ld1xNo8ZLfgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2AnQbrgM25ejrk925a5HlxfkTJLFM_ImwuVd3XtLYeA&oe=6B0B2179"}, {"file_name": "HDE_Screenshot_002_Oregon_Totality_Txt.png", "id": "1433652393663231", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974786_1433652396996564_3434563937125923228_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DycA4xZAW0Q7kNvwE3MAe8&_nc_oc=AdrdlHwdWl_-Cap5SE9vjiGkt6VUiIFc7oynWcxAFxrHibbpS0Oe79YLdX0MB7JWybo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaBdhoMqyhy4XmbF5zGz1bpyc5FHA1mdhbGf2UudOLYw&oe=6B0B3A32"}, {"file_name": "HDE_Screenshot_001_Date-TIme.png", "id": "516747656177237", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_516747659510570_2818871018338142231_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNbiN6jgb4sQ7kNvwGVHfYA&_nc_oc=AdpT9KjYsnAQvtoXTLBumWY_6-dOIBoSOj3hte4uwZMambnsIltmO6dawwb4SXDbCyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgCzaLoGL-M_UpB2kyG3d7zaQwqay88r57M20TXy1R8g&oe=6B0B1D34"}, {"file_name": "HDE_Screenshot_004_Sun_almost_Total.png", "id": "494936264987140", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974628_494936268320473_5835636733049968803_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EEOz2KMl-AQ7kNvwEevNQV&_nc_oc=AdoM85aS-Y4mzq1IpHc3KmmVwZ7haB_e94-3cffQbNH6-hp2jVv_CMREDTZg_4fQASo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFQ_Ou4IOTMMfA2qriBtmTw2z5sapFT5rlQYn2cWYAew&oe=6B0B161C"}, {"file_name": "HDE_Screenshot_008_Sun_PostTotality.png", "id": "471859233926168", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974708_471859237259501_2846275422493783136_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqOc8ybzLl0Q7kNvwHq9YIM&_nc_oc=AdrdzWKz2cUfwp5yEQbeIWvgtSz3OiOQ0x6Feax_92dlx6rqpXU5U5WPRyg8Ean04Qc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWoepY2lsMag6mfzaDHEjFFA8DWu2e4aWWMrt6YOLXSg&oe=6B0B3F8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "High Desert Eclipse", "keywords": [], "long_description": "The entire scenic horizon becomes sunrise and sunset during the High Desert Eclipse. From your remote majestic hilltop, see the rapidly encroaching shadow of the Moon turn day into twilight. \n\nThe heavens and earth had to move to capture and bring you this 360 documentary short film from its unique vantage point! \n\nExperience the 2017 great American total solar eclipse like no other, in 4k 360 video. Feature spans through 2 minutes each of pre-, full, and post-totality from its remote location in the Oregon desert. The \u201conce-in-a-lifetime\u201d experience that users at VR events and film festivals love. \n\nBrings back fond memories for anyone fortunate enough to have seen a full eclipse in their lifetime and a rare chance to see one for those unable to travel.", "short_description": "From a remote majestic hilltop see the rapidly encroaching shadow of the moon turn day into twilight while the entire scenic horizon becomes sunrise and sunset during the High Desert total solar Eclipse."}]}, "developer_name": "L. James & J. Jackson", "developer_privacy_policy_url": "https://docs.google.com/document/d/1zuqPSTA6hfR4kUR-YyPtawIIVg6K81WEHidD7Vu9uzM/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1SRclnCGLaLrr5nRsZVQX0FyZaxxX5kZVuSsGiBn82fQ/edit?usp=sharing", "publisher_name": "UpLiftVR Studios", "support_website_url": "http://fb.me/UpLiftVR", "website_url": "http://fb.me/HighDesertEclipse", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "721925232159370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982473_205339164536100_4017073701083139165_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yglIpNuNbUcQ7kNvwFV7cQ0&_nc_oc=AdqQbptseCtZoqqp8sboeu5Yd_Hl-9qz7sBPBdicT6j93WqF5nzwXXgeJ4RBfZ7F_tk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTF7v0iODjxnghseNEK9v0yTzuq_9TvJB_sTtYZBYb-TA&oe=6B0B1487"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "High Desert Eclipse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1637709007, "lastRevision": {"nodes": [{"id": "1410892949281390", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5486799141392429", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "504177103610156"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HighDesertEclipseLandscape.png", "id": "986349608769780", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-
://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974727_298146017720119_8665599687983628288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQH9_7CwBmgQ7kNvwEmWf1L&_nc_oc=AdokrprZ4MXa6C5KEYwgmPLLsBCDUgpMd1j1-yJlBh6VDzxY5NUB_trQrceRLfqBq2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I4BTIWD6kSR4B7vaphd6wXoc7d9P8e3LbrWrZ3pDEWQ&oe=6A453807"}, {"file_name": "migrated_image.png", "id": "856360128170907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974756_1471757992957648_2845304112910696448_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9ghzX7WI_gQ7kNvwF9A6Mq&_nc_oc=AdpYbTh45yFB83Uib2eOYvWA-JVk2YdJZCs7111oZ0KHeMzuJNhQAH1OFMbt22f8pfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pNdlAl-NoDrtrU94T2R5C0Asg2cSWsVLpk5q1t1fJvA&oe=6A452637"}, {"file_name": "migrated_image.png", "id": "914567398962003", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974637_2383721068367162_3223429808130097152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6cQWnyIt9QQ7kNvwFNPLHV&_nc_oc=AdoFrrOyrnez4ZW__lgEshAcW5OeCqHNN5a3qEUoknIBh14YQ4RFwoX8t-KnuHfn11U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OApdbb1jO2TN1CZcN2hbr3QxlzaOj1m3zZ9B_KrVojQ&oe=6A450199"}, {"file_name": "migrated_image.png", "id": "2478904725772577", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974677_735844253482591_4466757844582006784_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izsHJCxfb7sQ7kNvwEVVVWG&_nc_oc=Adoqd3_bIItMg8NV7H2KIifHS1Mb5GeTpT9qqF5NQf51AiI2J7iLL3916OkuL37UphI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pnd10iX4Xk4-xC8HLL_NNFoUXoRJlpODYcP-qQcN8IQ&oe=6A450C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxity", "keywords": ["Galaxity", "Indie", "Social", "Multi", "Friends"], "long_description": "Create your avatar\nWe have a variety of hair, skin, clothing and color options for you to customize your avatar. Show your creativity avatar to friends in the virtual world.\n\nTalk to people and make friends\nGalaxity provides a voice chat feature. You can communicate with people using your own voice or use various character expressions to communicate and become a friend with people from different nations. \n\nPlay various mini-games\nWe offer you a variety of mini-games, such as soccer, baseball, and multiple survival modes. Have fun with your friends. We will continue to update different game modes for you to play with your friends. \n\nVisit the theater\nYou can create your own movie theater for your friends to play and watch on YouTube. Prepare popcorn and pizza!", "short_description": "Galaxity is a wonderful virtual world. In this game, you can create an avatar and customize it with a variety of costumes. You can also talk to people and become friends with them. Join Galaxity, and enjoy various mini-games and fun videos together!"}]}, "developer_name": "MAMMOSSIX Co., Ltd.", "developer_privacy_policy_url": "https://www.galaxity.net/privacy-policy", "developer_terms_of_service_url": "https://www.galaxity.net/terms-of-service", "publisher_name": "MAMMOSSIX Co., Ltd.", "support_website_url": "http://www.galaxity.net/", "website_url": "https://www.galaxity.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "660325955228287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_4675935
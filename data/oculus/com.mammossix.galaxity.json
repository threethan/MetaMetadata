://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974727_298146017720119_8665599687983628288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vkz7ufhTYhkQ7kNvwGQRzuD&_nc_oc=AdroX06POxww-P73-ETRzCgYtZZIKewyJ-Q-ZlSidzwBiRaXoYMH4-6qng44qmGAVd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlBAOM1RCATP8K_rbLVBUGvvcdQdWgeXpMJdoC0-MGeQ&oe=6AD24887"}, {"file_name": "migrated_image.png", "id": "856360128170907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974756_1471757992957648_2845304112910696448_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mInttEw8nXUQ7kNvwFpONui&_nc_oc=Adp6nrYFGjMSp1q83Ay3Urqvr88jFtq1TgOykLBluW1NfAQQkSaVw3Fd0kUbkv_Hg2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2QuWxbWUbPyL7TgzYq818fhhdg8Hz5y4jkD0R9B21Kg&oe=6AD236B7"}, {"file_name": "migrated_image.png", "id": "914567398962003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974637_2383721068367162_3223429808130097152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_B7Hg8hoyMQ7kNvwEjdtz9&_nc_oc=Adok0nJ3Fq08FgHQ9Y990DEgt0muMGnt9LUtao9wvEXFQsrIYPpLgS2Z4Vp9CnUlA-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtTfddxNbpP75o6NN7pjUg-kll2uhoJqZgYylzFB8C_A&oe=6AD24A59"}, {"file_name": "migrated_image.png", "id": "2478904725772577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974677_735844253482591_4466757844582006784_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3hj6m7lvhsQ7kNvwGIkQez&_nc_oc=AdpFWckIwtLqb0JFRgturqNEbXLajiel1VnMnxxtJqpGLzGiuLPgmq3PiFkB9l_9wgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_Fmar1Yw2IAsc_sT1Y2BB33QdsRbXaH3ZfRvDsffMIQ&oe=6AD254FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxity", "keywords": ["Galaxity", "Indie", "Social", "Multi", "Friends"], "long_description": "Create your avatar\nWe have a variety of hair, skin, clothing and color options for you to customize your avatar. Show your creativity avatar to friends in the virtual world.\n\nTalk to people and make friends\nGalaxity provides a voice chat feature. You can communicate with people using your own voice or use various character expressions to communicate and become a friend with people from different nations. \n\nPlay various mini-games\nWe offer you a variety of mini-games, such as soccer, baseball, and multiple survival modes. Have fun with your friends. We will continue to update different game modes for you to play with your friends. \n\nVisit the theater\nYou can create your own movie theater for your friends to play and watch on YouTube. Prepare popcorn and pizza!", "short_description": "Galaxity is a wonderful virtual world. In this game, you can create an avatar and customize it with a variety of costumes. You can also talk to people and become friends with them. Join Galaxity, and enjoy various mini-games and fun videos together!"}]}, "developer_name": "MAMMOSSIX Co., Ltd.", "developer_privacy_policy_url": "https://www.galaxity.net/privacy-policy", "developer_terms_of_service_url": "https://www.galaxity.net/terms-of-service", "publisher_name": "MAMMOSSIX Co., Ltd.", "support_website_url": "http://www.galaxity.net/", "website_url": "https://www.galaxity.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "660325955228287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_4675935
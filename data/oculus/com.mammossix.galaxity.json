://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974727_298146017720119_8665599687983628288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5UiknyYObUQ7kNvwG4zmii&_nc_oc=Adr2bHXZyjYHnnistTtfxicdnzSXYB5GZd33EfpwqHQpNQoKUtd8VD1CUwCDYDYPBMY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj_dh0Uc6XtalOSLxljkAb9eLv4KwdXIU1lDECA18bBg&oe=6A5A17C7"}, {"file_name": "migrated_image.png", "id": "856360128170907", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974756_1471757992957648_2845304112910696448_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz7uLkDadPIQ7kNvwHXs-nz&_nc_oc=Adq5oZ4A9Xq9F5aIfnUe3TNaxXLEQy0rtL1KVXl47Xzsdl355wuJdx4unAoHBE-mv-g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj0_tDKQTEL0pmadhKktDoTkGB51uC2m0zXneHnKaBlA&oe=6A5A3E37"}, {"file_name": "migrated_image.png", "id": "914567398962003", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974637_2383721068367162_3223429808130097152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMPUpChwjTgQ7kNvwHpP-bv&_nc_oc=AdqgFWYx7AB3mYVB_cpOvVh5nFZBIMBF-9dA0iAR5Ug3yO9XTZCl9Vkk8xlCFBMwrhM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI2bcE-ZQNWl5iId5uHhP5Baxav6JQl8DlKaH9cs1M6g&oe=6A5A1999"}, {"file_name": "migrated_image.png", "id": "2478904725772577", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_735844253482591_4466757844582006784_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiuJTJX1EuIQ7kNvwFQ4mNJ&_nc_oc=AdpesPe1XSV1e4stBdoWFZSWyyJGrj6PQpWVz25ozpcpxErq7nqGIovJuJTQlo279GI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0O58mjGb48OapyXywIAPup0GfBPEoFhMbc96Cm1tJHw&oe=6A5A243E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxity", "keywords": ["Galaxity", "Indie", "Social", "Multi", "Friends"], "long_description": "Create your avatar\nWe have a variety of hair, skin, clothing and color options for you to customize your avatar. Show your creativity avatar to friends in the virtual world.\n\nTalk to people and make friends\nGalaxity provides a voice chat feature. You can communicate with people using your own voice or use various character expressions to communicate and become a friend with people from different nations. \n\nPlay various mini-games\nWe offer you a variety of mini-games, such as soccer, baseball, and multiple survival modes. Have fun with your friends. We will continue to update different game modes for you to play with your friends. \n\nVisit the theater\nYou can create your own movie theater for your friends to play and watch on YouTube. Prepare popcorn and pizza!", "short_description": "Galaxity is a wonderful virtual world. In this game, you can create an avatar and customize it with a variety of costumes. You can also talk to people and become friends with them. Join Galaxity, and enjoy various mini-games and fun videos together!"}]}, "developer_name": "MAMMOSSIX Co., Ltd.", "developer_privacy_policy_url": "https://www.galaxity.net/privacy-policy", "developer_terms_of_service_url": "https://www.galaxity.net/terms-of-service", "publisher_name": "MAMMOSSIX Co., Ltd.", "support_website_url": "http://www.galaxity.net/", "website_url": "https://www.galaxity.net/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "660325955228287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001717_4675935
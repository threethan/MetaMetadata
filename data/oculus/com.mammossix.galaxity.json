at=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcs0n8hud8QQ7kNvwF33DdV&_nc_oc=Adp2Q3mndtl_ZnSSwX1UEzCF3uzVVG1vKNTNnbMKKNK_UpvXF0GBHQReyNTT0jdf8h4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQea9Lif3x3MpVHSoIMRRnPFgZf4zZgkKNcvM2aDpoL4A&oe=6B05D72C"}, {"file_name": "migrated_image.png", "id": "2367068440060117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974751_250197319181968_5017245718465740800_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RblIivZnyoQ7kNvwGmvmnh&_nc_oc=AdpijX0Bl1BXmpSaw-aIHA65tGa-2_jfvLXATsfRfqvgdI5cUAx3pduJkVuXee1hfWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7dwlH6YtVZm2ub_bTJS5YdkSCmMqPAiTOmC4Wnfe8Dg&oe=6B05A3BA"}, {"file_name": "migrated_image.png", "id": "223903002349289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982485_326100368171638_8593810486452027392_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOTT6NH4Np0Q7kNvwHVt0IQ&_nc_oc=AdqyUopSY4gFFOpJyv2-HqF7MCo9lUEumnpw9EVTwBtUtTERe9u7ncgrSlP_Vy4slPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuwQoLf6YQTXBQtftD9H-yEosjOuPNW9tvepT-zr7o5w&oe=6B05A480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/eV4tnU", "id": "351800288713433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974496_351800292046766_6534266010369785856_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YHYxRRbLeIQ7kNvwGr1ASF&_nc_oc=AdqkQ25dCP1K5DuWn_pw8qcInciV1xSS4Ze4Z0DahNuVEwlOzx3xbXBMPoRFmTL8o28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_uz1WyistU19FnVfLuGJuDKONbCs4Xd7N6hP_TPx0yw&oe=6B05B30D"}, "display_name": "Galaxity", "keywords": ["Galaxity", "Indie", "Social", "Multi", "Friends"], "long_description": "Sign in with Facebook\nDo you have your Facebook account? If you connect to a virtual city with your Facebook account, your data will be stored and you can play at any other VR devices.\n\nCreate your avatar\nWe have a variety of hair, skin, clothing and color options for you to customize your avatar. Show your creativity avatar to friends in the virtual world.\n\nTalk to people and make friends\nGalaxity provides a voice chat feature. You can communicate with people using your own voice or use various character expressions to communicate and become a friend with people from different nations. \n\nPlay various mini-games\nWe offer you a variety of mini-games, such as soccer, baseball, and multiple survival modes. Have fun with your friends. We will continue to update different game modes for you to play with your friends. \n\nVisit the theater\nYou can create your own movie theater for your friends to play and watch on YouTube. Prepare popcorn and pizza!", "short_description": "Galaxity is a wonderful virtual world. In this game, you can create an avatar and customize it with a variety of costumes. You can also talk to people and become friends with them. Join Galaxity, and enjoy various mini-games and fun videos together!"}, {"images": {"nodes": []}, "id": "253008409058767", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u94f6\u6cb3\u57ce (Galaxity) \u6d4b\u8bd5\u7248", "keywords": ["\u72ec\u7acb", "\u793e\u4f1a", "\u591a\u91cd\u6e38\u620f", "\u548c\u670b\u53cb"], "long_description": "\u4f7f\u7528 Facebook \u8d26\u53f7\u767b\u5f55\n\u60a8\u662f\u5426\u62e5\u6709 Facebook \u8d26\u53f7\uff1f\u5982\u679c\u60a8\u4f7f\u7528 Facebook \u8d26\u53f7\u8fde\u63a5\u5230\u865a\u62df\u57ce\u5e02\uff0c\u60a8\u7684\u6570\u636e\u5c06\u4e88\u4ee5\u5b58\u50a8\uff0c\u5c4a\u65f6\u60a8\u53ef\u4ee5\u5728\u4efb\u4f55\u5176\u4ed6 VR \u8bbe\u5907\u4e0a\u4f7f\u7528\u8be5\u8d26\u53f7\u8fdb\u884c\u6e38\u620f\u3002\n\n\u521b\u5efa\u89d2\u8272\n\u6211\u4eec\u6709\u5404\u79cd\u5934\u53d1\u3001\u76ae\u80a4\u3001\u8863\u670d\u548c\u989c\u8272\u9009\u9879\u4f9b\u60a8\u5bf9\u81ea\u5df1\u7684\u89d2\u8272\u8fdb\u884c\u81ea\u5b9a\u4e49\u3002\u53ef\u4ee5\u5728\u865a\u62df\u4e16\u754c\u4e2d\u5411\u670b\u53cb\u5c55\u793a\u60a8\u7684\u4e2a\u6027\u3002\n\n\u4e0e\u4eba\u4ea4\u8c08\uff0c\u7ed3\u4ea4\u670b\u53cb\n\u94f6\u6cb3\u57ce (Galaxity) \u63d0\u4f9b\u8bed\u97f3\u804a\u5929\u529f\u80fd\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u81ea\u5df1\u7684\u58f0\u97f3\u4e0e\u4eba\u6c9f\u901a\uff0c\u6216\u4f7f\u7528\u5404\u79cd\u89d2\u8272\u8868\u60c5\u6765\u4e0e\u4e0d\u540c\u56fd\u5bb6\u7684\u4eba\u4ea4\u6d41\u3001\u6210\u4e3a\u670b\u53cb\u3002 \n\n\u5404\u79cd\u5c0f\u6e38\u620f\uff0c\u7cbe\u5f69\u4e0d\u65ad\n\u6211\u4eec\u4e3a\u60a8\u63d0\u4f9b\u5404\u79cd\u5c0f\u6e38\u620f\uff0c\u5982\u8db3\u7403\u3001\u68d2\u7403\u548c\u591a\u4eba\u751f\u5b58\u6e38\u620f\u6a21\u5f0f\u3002\u4e0e\u670b\u53cb\u4eec\u4e00\u8d77\u7545\u4eab\u5feb\u4e50\u65f6\u5149\u3002\u6211\u4eec\u5c06\u6301\u7eed\u66f4\u65b0\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\uff0c\u4e30\u5bcc\u60a8\u548c\u670b\u53cb\u4eec\u7684\u5a31\u4e50\u751f\u6d3b\u3002 \n\n\u53c2\u89c2\u5267\u9662\n\u60a8\u53ef\u4ee5\u521b\u5efa\u81ea\u5df1\u7684\u7535\u5f71\u9662\uff0c\u4f9b\u670b\u53cb\u4eec\u5728 YouTube \u4e0a\u64ad\u653e\u548c\u89c2\u770b\u3002\u51c6\u5907\u597d\u7206\u7c73\u82b1\u548c\u62ab\u8428\u5427\uff01\n\n\u5176\u4ed6\n\u60a8\u5728\u865a\u62df\u4e16\u754c\u4e2d\u91c7\u53d6\u7684\u884c\u52a8\u8d8a\u591a\uff0c\u60a8\u53ef\u4ee5\u6536\u96c6\u7684\u8d44\u91d1\u5c31\u8d8a\u591a\u3002\u6709\u4e86\u8fd9\u7b14\u8d44\u91d1\uff0c\u60a8\u53ef\u4ee5\u4ece\u5546\u5e97\u8d2d\u4e70\u6f02\u4eae\u7684\u670d\u88c5\uff0c\u5e76\u628a\u5b83\u5c55\u793a\u7ed9\u670b\u53cb\u4eec\u3002\u4f60\u4e5f\u53ef\u4ee5\u8d2d\u4e70\u70ab\u5f69\u70df\u82b1\uff0c\u751a\u81f3\u7528\u7279\u6b8a\u7269\u54c1\u6539\u53d8\u4f60\u7684\u53d1\u578b\u548c\u670d\u88c5\u3002\u6211\u4eec\u5f00\u53d1\u7684\u5404\u79cd\u4efb\u52a1\u4f1a\u4f7f\u60a8\u7684\u865a\u62df\u4e16\u754c\u751f\u6d3b\u66f4\u52a0\u6109\u60a6\u3002\n\n\u6d4b\u8bd5\u7248\u6d4b\u8bd5\u670d\u52a1\n\u6211\u4eec\u5df2\u7ecf\u5f00\u59cb\u8fdb\u884c\u516c\u5f00\u6d4b\u8bd5\uff0c\u4ee5\u4f7f\u6211\u4eec\u7684\u94f6\u6cb3\u57ce\u53d8\u5f97\u66f4\u52a0\u5b8c\u5584\u3002\u8be5\u670d\u52a1\u5668\u5c06\u5728 2018 \u5e74 11 \u6708 30 \u65e5\u4e4b\u524d\u5f00\u653e\u3002\u4f46\u5177\u4f53\u65e5\u671f\u5c06\u6839\u636e\u73a9\u5bb6\u60c5\u51b5\u8fdb\u884c\u8c03\u6574\u3002", "short_description": "\u94f6\u6cb3\u57ce (Galaxity) \u662f\u4e00\u4e2a\u795e\u5947\u7684\u865a\u62df\u4e16\u754c\u3002\u5728\u8fd9\u4e2a\u6e38\u620f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u521b\u5efa\u4e00\u4e2a\u89d2\u8272\u5e76\u901a\u8fc7\u5404\u8272\u670d\u88c5\u5f70\u663e\u4e2a\u6027\u3002\u60a8\u8fd8\u53ef\u4ee5\u4e0e\u4ed6\u4eba\u4ea4\u8c08\u5e76\u7ed3\u4ea4\u670b\u53cb\u3002\u52a0\u5165\u94f6\u6cb3\u57ce (Galaxity)\uff0c\u4e00\u8d77\u7545\u4eab\u5404\u79cd\u5c0f\u6e38\u620f\u548c\u7cbe\u5f69\u7684\u89c6\u9891\u5427\uff01"}]}, "developer_name": "MAMMOSSIX Co., Ltd.", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "MAMMOSSIX Co., Ltd.", "support_website_url": null, "website_url": "https://www.galaxity.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1093177907891370"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id
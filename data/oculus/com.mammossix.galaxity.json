uscdn.com/v/t64.5771-25/39031493_556473005329295_3253650484512989266_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSPlK6Fc1fgQ7kNvwGAqOAO&_nc_oc=AdqtDAuV4022ix1QpvwKB49jO6F-8DjMItxd4GZeLWIedPS4Z0JDPU6McsPTnLSHj3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OyNtJhE9IYMeeffDZ8wtjP1idmqeQj8NPIewtSbPqUg&oe=6A1D9841"}, {"file_name": "screenshot1.png", "id": "462409584779219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982715_462409588112552_1084457204882473841_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUCRQOz9_SQQ7kNvwGaz71n&_nc_oc=Adqd7Tcn3pNWJrTkzcFadyEQsSVPqcKSiXlF0VAdRBUZ2aaQU5GcQeRtdnplK1a0OgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bvNQCRHQ_OoEVwb9fGK40_a-ek95AbRmo8Z6WOSCP7g&oe=6A1D9AED"}, {"file_name": "screenshot4.png", "id": "417357872684519", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974558_417357876017852_3546431798915484762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUkEU3xKWggQ7kNvwEFZpJK&_nc_oc=AdqLkcjhL9fH2CAbJJX0UuR_tLUz49JsmHSbrWRwDW6Lv-KP-7dwO0OkjLBayvNyitY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yg_UrXnp8P0EpqZ4e9okgv-4sCOhDX2bYT-EBrvApBw&oe=6A1D8B6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Galaxity", "keywords": [], "long_description": "Create your avatar\nWe have a variety of hair, skin, clothing and color options for you to customize your avatar. Show your creativity avatar to friends in the virtual world.\n\nTalk to people and make friends\nGalaxity provides a voice chat feature. You can communicate with people using your own voice or use various character expressions to communicate and become a friend with people from different nations. \n\nPlay various mini-games\nWe offer you a variety of mini-games, such as soccer, baseball, and multiple survival modes. Have fun with your friends. We will continue to update different game modes for you to play with your friends. \n\nVisit the theater\nYou can create your own movie theater for your friends to play and watch on YouTube. Prepare popcorn and pizza!", "short_description": "Galaxity is a wonderful virtual world. In this game, you can create an avatar and customize it with a variety of costumes. You can also talk to people and become friends with them. Join Galaxity, and enjoy various mini-games and fun videos together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galaxity.net/privacy-policy", "developer_terms_of_service_url": "https://www.galaxity.net/terms-of-service", "publisher_name": "MAMMOSSIX Co., Ltd.", "support_website_url": "http://www.galaxity.net/", "website_url": "https://www.galaxity.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "890088195009268"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3213940178730110", "version": "1.39.1"}, "id": "754073701880934", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2337801553010648", "is_concept": false, "latest_released_bi
C9ZgrgMM6l7nltogpx523QF4mcoDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3WEAct99wJrM9vA6s4BoViHvvx391RiV-qV7tHZ2mGA&oe=6B0DA739"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer: Formula Car Racing VR", "keywords": ["formularacing", "racinggame", "drivingsimulator", "formularacer"], "long_description": "# F1 Racer: Formula Car Racing VR\n\nGet behind the wheel and experience the excitement of high-speed **Formula Racing** in immersive VR.\n\n**F1 Racer: Formula Car Racing VR** puts you in the driver\u2019s seat of powerful formula cars, where precision, speed, and control are the keys to victory. Feel the intensity of **car racing** as you accelerate through challenging circuits, take corners at high speed, and push your driving skills to the limit.\n\n## \ud83c\udfce\ufe0f Race. Drive. Master.\n\nStep into the world of competitive **racing games** and experience an immersive **driving simulator** designed for VR. Take control of a formula car and put your racing skills to the test on the track.\n\n### Key Features\n\n* \ud83c\udfc1 Immersive Formula Racing experience in VR\n* \ud83c\udfce\ufe0f Drive powerful Formula cars\n* \ud83c\udfae Intuitive VR driving controls\n* \ud83c\udfc6 Challenge yourself to become the ultimate Formula Racer\n* \u26a1 High-speed racing action\n* \ud83d\udee3\ufe0f Race on challenging circuits and master every corner\n* \ud83c\udfaf Improve your driving, braking, and racing skills\n* \ud83e\udd47 Push your limits and chase the perfect race\n\nWhether you're a dedicated **Formula Racer** or simply love fast-paced **Racing Games**, get ready to experience the speed and excitement of Formula Car Racing in virtual reality.\n\n**Put on your headset. Start your engine. Take the racing line.**\n", "short_description": "Experience the thrill of high-speed Formula Racing in VR. Take the wheel, race powerful formula cars, master challenging circuits, and become the ultimate Formula Racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310859122106531"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1041459845622141"}, {"status": "PUBLISHED", "id": "1677098560716234"}]}, "baseline_offer": {"id": "1677098560716234"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1041459845622141"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1373983555794087", "version": "0.1"}, "id": "2798572517175138", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310859115439865", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373983555794087"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel
9447858708", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1766809451192041_6778446134551545867_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F9_T_BFKvMQ7kNvwF0Isz8&_nc_oc=AdpwaPA47S4-zH4QeceX-cOku253-Y7g6o8r7vb3hb43hwFZc02GvUdVYbQcP4Bv5iU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJA5OiYNGM-SCCpWJycTDIsLJp5nBbtgVg48Z0ugyHaA&oe=6B0C55B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer: Formula Car Racing VR", "keywords": ["formularacing", "racinggame", "drivingsimulator", "formularacer"], "long_description": "# F1 Racer: Formula Car Racing VR\n\nGet behind the wheel and experience the excitement of high-speed **Formula Racing** in immersive VR.\n\n**F1 Racer: Formula Car Racing VR** puts you in the driver\u2019s seat of powerful formula cars, where precision, speed, and control are the keys to victory. Feel the intensity of **car racing** as you accelerate through challenging circuits, take corners at high speed, and push your driving skills to the limit.\n\n## \ud83c\udfce\ufe0f Race. Drive. Master.\n\nStep into the world of competitive **racing games** and experience an immersive **driving simulator** designed for VR. Take control of a formula car and put your racing skills to the test on the track.\n\n### Key Features\n\n* \ud83c\udfc1 Immersive Formula Racing experience in VR\n* \ud83c\udfce\ufe0f Drive powerful Formula cars\n* \ud83c\udfae Intuitive VR driving controls\n* \ud83c\udfc6 Challenge yourself to become the ultimate Formula Racer\n* \u26a1 High-speed racing action\n* \ud83d\udee3\ufe0f Race on challenging circuits and master every corner\n* \ud83c\udfaf Improve your driving, braking, and racing skills\n* \ud83e\udd47 Push your limits and chase the perfect race\n\nWhether you're a dedicated **Formula Racer** or simply love fast-paced **Racing Games**, get ready to experience the speed and excitement of Formula Car Racing in virtual reality.\n\n**Put on your headset. Start your engine. Take the racing line.**\n", "short_description": "Experience the thrill of high-speed Formula Racing in VR. Take the wheel, race powerful formula cars, master challenging circuits, and become the ultimate Formula Racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310859122106531"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1115371640857559_6614744726933110380_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wLdbHHBWBkQ7kNvwEglwkQ&_nc_oc=AdrPtWSzIIbdmfLAouNpvw9k4j72hF_y4vF2nGb50CQUQdKosX1F8NEI82At58W1rmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzZ8XzqjSxmyyErbxmCTEpIYeTfZiEdBE4W4tqYOscDw&oe=6B0C6FC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "F1 Racer: Formula Car Racing VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
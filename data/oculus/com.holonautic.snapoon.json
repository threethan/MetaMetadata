8hH7CFAM7Y3DIEeTsZKqZn1y7xySLA5Nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIVUzBbrMs6J6Gbaty8uzbn30m4tMoACucxWa0HG0XZw&oe=6B0EFF30"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl49YuioCmQQ7kNvwEbfJ3d&_nc_oc=AdoF1X0yJSr6TeON8v1BR47-y1y5FTUh9PNb7u_woj32K-bPg6VKpMQ-Mo357a-1WTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU5aYU4iv13n2wrz9zwdQxgj0Uns1b-CNhUVpbqm4OUpQ&oe=6B0EEB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQow5DPxqEAQ7kNvwHgooBk&_nc_oc=Adrmz-Qhry8GDglT3MTtiXCvNA6D-b9QNjOotlysyJ64PxON0Q7uaebcZ_Fq2QOC3iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1RiwujEVZKvDM_y6eSK8Y5qOiSG-JT_9xlpon7iam0g&oe=6B0F0516"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
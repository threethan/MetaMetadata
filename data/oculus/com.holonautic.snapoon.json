rGu6fuokMoPzDqGUXnoRBC9RBL7qZ6RgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ70tYMZkxZ-y93tZcUgzbtK2VxHn1h37E0WaqFH4HEQA&oe=6B09B930"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdgCv5aZnMAQ7kNvwGcU1QN&_nc_oc=Adovd92gx8Jytf3kDDLuT25CsDFQtRIdvPIQNOCFdxoFW4Husw60lcH7yHYIRYYAweE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsjfBH0Zv5yUju-KPkzSWFz4jZeb-S221bcwHQDJgN_A&oe=6B09A570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Sw8D6ROm4wQ7kNvwHJb4yw&_nc_oc=AdpjKEiUPWB1TA82scFU1FySnEmX8NXc7ow8opzJNcXnbT5KMf2ZFQAHUSPsdOO7U84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb78R-nrtoeaDA-1xA1ifkDGY3m86TJvk0Ss252Y7f-A&oe=6B09BF16"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
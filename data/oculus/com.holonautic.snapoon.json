8tPdMK856VVindb4xOEeZuYVl-KvT4hPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHwOO4JvAozn_HjrOxJLOvGcMW024dSfiNPhXYhiomFw&oe=6B0DADB0"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl49YuioCmQQ7kNvwFFdo3N&_nc_oc=AdofxENWqOrFE4BcprxbX9-BUd5HlXRKGSieLZTxuERki7WNUcVOnd_d_IeI6VQzhzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0EFt6rsMdEyyazBNhKM_XxgRf-XHGUVHnBqr80h5cdg&oe=6B0D99F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQow5DPxqEAQ7kNvwFPTpRk&_nc_oc=AdpvzSLye8cJXYzN3rU8ByXOz5WHegKsulbEOQdQN3K9qTjGX86BwQ8b--FfXdz-q8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLPetLe165i0vVmnj5cCP0dunHCEPzYrMGwvwBTZAXDA&oe=6B0DB396"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
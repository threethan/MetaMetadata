eB89g7ha_gtFgCG1_YKaXINnAoW1ZsnhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdYx62B0hlkxFiuKzgW_yxpS6oK3jty2F2lT_5tGkWRg&oe=6B0C5C30"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdgCv5aZnMAQ7kNvwHagseB&_nc_oc=AdraVwfc9W5RFZpIx-fyfTDer6utxN5csdZg6tX10tKKvpL7tEmGhV-tMtahU7yGMbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_1PusGdsi3-MhFofz_kRDuZ4zyuShdCd3YxD4uxIIFw&oe=6B0C80B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Sw8D6ROm4wQ7kNvwFr63md&_nc_oc=Adq9qTopmAP0WO4XM3BgpPGIpzB1AZS1nYmQFmo27U-haYFFssJO0K7YbsKwtbU8rAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyMiWOBYQQ17fsTAR64f9sMVGvOQTjqcHmGsJstkh-3g&oe=6B0C6216"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
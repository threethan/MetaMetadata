MZmOAZef4T9Hf54kdCVIBGQsh3HfqAcMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsh3XBM4789Xi-rhebvfIzlp3MGnof5zocET-TDV7lng&oe=6B007EB0"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fIxc2utF-sQ7kNvwGK1XHU&_nc_oc=AdrPUFYsqS61bAIQ3K0iASVeL2w2OOzqimupyM_5rz7yBMRl6LixHO-Krak-3Pq7IUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDi8-NoKKOYn4M9n7WjMF82f5KCqPiR9WZg27XgJc3uw&oe=6B006AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssLWmcYiFE8Q7kNvwG5A6rs&_nc_oc=AdryNzNhxkHHDwD8sAqlWbRctyV54yWnR5-yveaClEDN5m5oi76pCSJVuLLHgDk6v04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbQc1HNPOr_u63j3Rd1I4eB2FjMVZf4AP5ltaCi-Hy1Q&oe=6B008496"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
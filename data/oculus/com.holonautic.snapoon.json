gck-qHHLf-_WW8nl1BVleppItQny-6Xys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGvizAcPh8gYzryRipQF835o4K5h1NBZ3gXBjRzMXcjw&oe=6B047330"}, {"file_name": "beta screenshot 7.png", "id": "598710522972649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh4s1llC45oQ7kNvwEXZTWk&_nc_oc=Adqhg6fHOlJjm0NUWL6N_ISMVWL_NOZSoI0R0bdqMkImVNXaNOPmJ7JO6gHd6uDpDrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXNp9x_KcSP2uU7tabiv3ZfBSmeBOQmz-cLm3efKxMfg&oe=6B045F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZlmvK4S0ekQ7kNvwGLS_q0&_nc_oc=AdowMI0WZqpBCJmNepr40UwBP47pAwmSuypkDeD8sx7jtVHLPevbBoHyxOsJmejTql4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7i5s7hlOVkiT0FXBZ5liR7_Kt0oKeTJdfF4FJ50jOvA&oe=6B047916"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "s
73391896_598710526305982_8583315661401564119_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVuO7UPVEwcQ7kNvwEdw-mi&_nc_oc=AdrtPRzoWfJsCPg6So_z-dRqMPvsOfXkyzMm0Sp9vfLtiU_pxZ6s5-XD6j4YKJZdw2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5TLrZ-g0jTXkhzVhpCmFWbBZd5OGMlak9qj1zw1-J9Q&oe=6ADE23F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUbNC1bbv-MQ7kNvwEbV1yu&_nc_oc=AdrVms_9WDAvvRIsZkJyy8IJxkDSh8kCePzki4c-SNBtB2nOCRjGYANzKtNxOg4vzs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYhUc6-qWjjopwxOi9ZPU51pfGbZ8_SKB11VkSBvTSbg&oe=6ADE0556"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Combat", "Simulator", "Animals"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "short_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policies/boom-boom-hamster-doom-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1700921480735423"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28667644169550127"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_2248196615576713_1675909981876142158_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLmP9nqRHSQQ7kNvwG5xBNc&_nc_oc=Adq41PK5D0MXYGmqEmQ4i5WobD75xMLoEJbL4hCCpdEtT3oeapsRLgzatq74foScwzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu5vIYYj_4Ks_DXybqFleJi2kYNQWtl3ZUW8jEta-6QQ&oe=6ADE2825"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boom Boom Hamster Doom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Action", "id": "459781504968480"}], "release
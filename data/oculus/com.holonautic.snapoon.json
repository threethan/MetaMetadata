ideo_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1164069315130148", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393859_1164069318463481_4487469559262807344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N77QCWXh-3wQ7kNvwEOlhzR&_nc_oc=Adpaly7JMGs2JuhDMZyyJcILd5Bo8jPMoP31W3VluixxrdGMKUbQje9_2tOT6_YhHH0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_fXocRmyPMwyQWNl_rIXLAgSWzbZCEsmZhdWMWLs3hA&oe=6A8EEB56"}, "display_name": "Boom Boom Hamster Doom", "keywords": ["Physics", "Multiplayer", "Worms", "Combat", "Simulator"], "long_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!\n\n- Skill based combat system\n- Up to 6 players at the same time, against each other or team up\n- Physics based multiplayer with destructible terrain\n- Procedurally generated levels for unique gameplay every single time\n- Multiple unique weapons to choose from\n- Single player mode against AI Bots\n", "short_description": "Lead the bravest, most fearless, and undeniably fluffiest warriors the world has ever seen: Combat Hamsters (Cohams)! Armed with an arsenal of powerful weapons, these feisty rodents await your command. Strategically maneuver them across procedurally generated, fully destructible terrain. Dodge deadly mines, trigger explosive barrels to outsmart your foes, and fight to be the last Coham standing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policies/boom-boom-hamster-doom-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": n
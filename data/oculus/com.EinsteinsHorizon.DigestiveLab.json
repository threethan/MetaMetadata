"}, {"file_name": "digestive_4.png", "id": "1278372187617846", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620429_1278372190951179_633179897488000586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc3m3Mnr79kQ7kNvwEwtFnF&_nc_oc=Adpsna-0CzGoSw78uW_UIyuMz2MxT2ckzCkK5Ipt6Ge6k5Lf_XzLDf--rZd8k43opc4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXpvxLhweaOKzRXYsWp0C_ApSVzGLuqhUzIFviQb9kmg&oe=6AA41652"}, {"file_name": "digestive_6.png", "id": "1347566520606414", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619836_1347566523939747_359513899009637352_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKC5hQUg5aMQ7kNvwELGbLQ&_nc_oc=AdpWVW_kzkucPesXZXDKkVKLadMgXQT-jOJgMFxqKS-Wsqav8fgEnBFJbePpDFfGgpI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXvYMZ7XGOyrzu8DWvr2r7uwHyp_JhdMLjyxdwYvRqEg&oe=6AA40242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "2201322690631751", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/604275479_2201322693965084_2904465919439342491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0tWhHEe2Z4Q7kNvwH_s97v&_nc_oc=Adp55EsukTH_NY7MKnBq9bS1r_XEY3Y_jHhKIDiY1GUtLzbGwPRNiCc7GDPESJQGV80&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxSiCTutyNtCwBo8YU7ZSGio73WfALGSN_v30YeOOmEg&oe=6AA3F808"}, "display_name": "Anatomy Learning Labs: Digestive Lab", "keywords": ["digestive", "medical", "anatomy", "biology", "learning"], "long_description": "Step into the Digestive Lab of the Anatomy Learning Labs series, where the organs responsible for digestion come to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Digestive Lab teaches elementary, middle, and high school learners how food is broken down, nutrients are absorbed, and waste is eliminated.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022\tTravel through medical imaging views that reveal the digestive system, similar to a CT scanner\n\n\u2022\tSelect any structure to hear Dr. Hana Sato, your virtual guide, identify it by name.\n\n\u2022\tUse natural hand-tracking to grab, rotate, and closely inspect objects. Examine the structure of each digestive organ. \n\n\u2022\tStep into Mini Mode to shrink down and see the stomach from the inside.\n\n\u2022\tAssemble the full human digestive system in a guided 3D puzzle. \n\n\u2022\tTest your knowledge through audio-guided quizzes led by Dr. Sato.\n\n\u2022\tPut your skills to the test in a fast-paced Knowledge Knockout challenge, where you must quickly punch the correct digestive organs under time pressure.", "short_description": "Step into an immersive VR digestive system laboratory and explore how the human body processes food in stunning 3D. Travel through medical imaging views, examine digestive organs using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name. Assemble digestive anatomy in interactive 3D puzzles, test your knowledge with quizzes, and reinforce learning through engaging challenges designed to make anatomy memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119
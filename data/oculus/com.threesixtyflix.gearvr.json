 multiple client brands.\n\nFeature Rich\n360FLIX is a powerful platform that lets you distribute your content with ease\nacross multiple brands platforms and languages", "short_description": "Publish Your Content Under Your Brand with 360FLIX"}]}, "developer_name": "360FLIX", "developer_privacy_policy_url": "http://www.support.360flix.com/", "developer_terms_of_service_url": "http://www.support.360flix.com/", "publisher_name": "360FLIX", "support_website_url": null, "website_url": "http://www.360flix.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "607523917007737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3194531967299238", "version": "0.37.2"}, "id": "202248060482955", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1930437420375372", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3194531967299238"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1588807145, "id": "3194550980630670", "version": "0.37.2", "version_code": 118, "release_status": "RELEA
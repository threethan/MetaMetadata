 Publishing\nFully configure your apps, projects, subtitles, and branding on a per-platform basis in minutes. Add as many languages as you need.\n\nFully Featured Content Management System\n360FLIX gives you full control over the publishing process. Geoblock content, schedule project launches and manage live streams. Join multiple teams to control and publish content for multiple client brands.\n\nFeature Rich\n360FLIX is a powerful platform that lets you distribute your content with ease\nacross multiple brands platforms and languages", "short_description": "Publish Your Content Under Your Brand with 360FLIX"}]}, "developer_name": "360FLIX", "developer_privacy_policy_url": "http://www.support.360flix.com/", "developer_terms_of_service_url": "http://www.support.360flix.com/", "publisher_name": "360FLIX", "support_website_url": null, "website_url": "http://www.360flix.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "539079917644011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410441_232633180703418_6511636098270101504_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R3gw3nxA-4Q7kNvwGSJ0KP&_nc_oc=Adl-hXvCzZdy-bg6vOvJN88pjlhAvvlDmlscLD5HY7J9bzCblDrYt-EN23GRtYg0rf4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvb_mtQdGW0GigSJzv1nFggY8P99hh8KUL66YROjOHd_g&oe=69A56EB4"}, "is_concept": false, "is_test": false, "is_tr
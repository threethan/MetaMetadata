_mexsrUtwQ7kNvwF2diZP&_nc_oc=AdojSRI1q5NTi6BF7ZQyBu2vjhBh4aVmgRhKfZJ_A2g98E25Xti5XwQB1NM4226BVHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gy08qEfXenuWZocwLZIwjlez3MdPWpuBbsCZ3p-C6ig&oe=69FF203F"}, {"file_name": "migrated_image.png", "id": "816799752137236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_1894373214195865_8866813459782696960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-O2vTe1gVYQ7kNvwEwAaJO&_nc_oc=AdpvFLJ9ipbao6tIxRSqZLp3oYODPxs4saoQlDa41QVAQl8G3CB4XQ0jCRKwc6Ma80k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b8aiaNQftgpp_jSeHMvcVBhNAD2h8SWLKui0sU7xhcw&oe=69FF4DBA"}, {"file_name": "migrated_image.png", "id": "2617466715167016", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533846_1822259934508673_5925958517948153856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQKopyYPCSAQ7kNvwEx0Xhf&_nc_oc=Adr8tFIHOUqQCntPZp7iSa8_ctdG52VKronSvNlP5acnH2OXTE7IWeXG4icsSKCjqLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zOj2LzxHNgRRtkDsZmKmlL_vcUgqfPyGpz3dsSYFQJw&oe=69FF2D1E"}, {"file_name": "migrated_image.png", "id": "506130863600700", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410355_385903115267509_3495952084426031104_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbjvtxmecHUQ7kNvwEW-Ua-&_nc_oc=AdrzxnDKhJNOBbxI7Febv_wKJuFeINTuGHMsa2Kl-p9dCGpWlJd7t4HyRgOjashDEFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zu0wZQ1bRYvRIot3yEpHvAXKZmnctF2m3TbNNdHB_3w&oe=69FF1F09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360flix", "keywords": ["VirtualReality", "360", "LiquidCinema", "CMS"], "long_description": "Publish Your Content Under Your Brand with 360FLIX\n\nHow Does it Work?\nLink 360FLIX to Vimeo Pro or any 3rd party video server.\nConfigure your branding and 360 content.\nDistribute to 10 branded app platforms.\n\nUse Your Brand\nCustomize your platforms with your logo, splash page and about section in multiple languages. Recipients download the 360FLIX apps which automatically rebrand and populate with your content.\n\nInternational Publishing\nFully configure your apps, projects, subtitles, and branding on a per-platform basis in minutes. Add as many languages as you need.\n\nFully Featured Content Management System\n360FLIX gives you full control over the publishing process. Geoblock content, schedule project launches and manage live streams. Join multiple teams to control and publish content for multiple client brands.\n\nFeature Rich\n360FLIX is a powerful platform that lets you distribute your content with ease\nacross multiple brands platforms and languages", "short_description": "Publish Your Content Under Your Brand with 360FLIX"}]}, "developer_name": "360FLIX", "developer_privacy_policy_url": "http://www.support.360flix.com/", "developer_terms_of_service_url": "http://www.support.360flix.com/", "publisher_name": "360FLIX", "support_website_url": null, "website_url": "http://www.360flix.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "539079917644011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_232633180703418_6511636098270101504_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHTi-7KgQDMQ7kNvwGe6SmC&_nc_oc=AdqisI8hfU5oL1F3CPhal8xYVYPTZar7pIDgEpt0_XZAFi78Om5egwmxlQ2XhSOivdo&_nc
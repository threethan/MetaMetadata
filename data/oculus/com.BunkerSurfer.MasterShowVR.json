t the stage:\nDancing girl, dancing boy, bear, happy face, led costume, female choir, male choir, mysterious choristers.", "short_description": "Enjoy your mp3 music controlling lights in your stage or fighting against opponents, defend your stage, use your laser weapon and your baseball bat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bunkersurfer.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bunker Surfer", "support_website_url": null, "website_url": "https://bunkersurfer.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5751643674891049"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5978305512209214", "version": "3"}, "id": "1215863489341977", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5957586430947789", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5978305512209214"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1215863489341977"}]}, "change_log
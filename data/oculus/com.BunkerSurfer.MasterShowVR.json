om/v/t64.5771-25/75375080_589825096240088_8175559679801304324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F66FgPqC1F8Q7kNvwHZfKTS&_nc_oc=AdoaI4JxZfxxqDMpovMqplYj-NOLnlCdlDS6yHK7MXgJ6EVmCto2nSF-n0HFJUMzCIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UJzPYnxV-NAfGaXqnaJ238t0ho1VrEvbZk7G3OVL_Kg&oe=6A2D58AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4hd.png", "id": "547545114102142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_547545117435475_1246229626582265110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSwrZVP1CAwQ7kNvwHwsovT&_nc_oc=Adp33F62oIjuhgV7wi6BNNZvNO_6Hv1JSJtn8c-0rUTYMMW8Y-nbJ9EM-wOQ4-DJkh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gGQRQvzL6_Jt2-YbGGWviq3hrHUxB9fV5yy68sdyqqw&oe=6A2D5068"}, "display_name": "Master Show VR", "keywords": [], "long_description": "Two game modes: Stage simulator & Stage defender\n\n36 characters to create your stage.\n9 musicians with these instruments: electric guitar, drums, bass guitar, music keyboard, piano, violin, bongo drum, trumpet and saxophone.\n\n18 singers of different styles in two genres, female and male.\nK-pop, pop, classic pop, rap, reggae, ballad, rock, guitarist and pianist.\n\n9 fun dancers and chorus girls to set the stage:\nDancing girl, dancing boy, bear, happy face, led costume, female choir, male choir, mysterious choristers.", "short_description": "Enjoy your mp3 music controlling lights in your stage or fighting against opponents, defend your stage, use your laser weapon and your baseball bat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bunkersurfer.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bunker Surfer", "support_website_url": null, "website_url": "https://bunkersurfer.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
om/v/t64.5771-25/75375080_589825096240088_8175559679801304324_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOJFfT9IbdAQ7kNvwFvdcGc&_nc_oc=AdpMIEdnZO-w6qpZjyxjrsX2meZO3zVxQ-OVYdv5Woev6es9dOC9xN5An9SQ1G5XU6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn7VZLgAC8o0_RkSwESh-mf-1cEIjIQ1nPL9VY4WDiUA&oe=6A4BAB2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4hd.png", "id": "547545114102142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_547545117435475_1246229626582265110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5O3tTOetFAQ7kNvwFL0vMk&_nc_oc=AdoG-7ZYVd0coLI12v8yEt2wYQq_LzkgRggXOFKcHjShD-wwYgABokAVmlX4OoebcAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgQGxzT3MX9SX_B6oN38bjawfk50T5hmIfC3tIp4yj4g&oe=6A4BA2E8"}, "display_name": "Master Show VR", "keywords": [], "long_description": "Two game modes: Stage simulator & Stage defender\n\n36 characters to create your stage.\n9 musicians with these instruments: electric guitar, drums, bass guitar, music keyboard, piano, violin, bongo drum, trumpet and saxophone.\n\n18 singers of different styles in two genres, female and male.\nK-pop, pop, classic pop, rap, reggae, ballad, rock, guitarist and pianist.\n\n9 fun dancers and chorus girls to set the stage:\nDancing girl, dancing boy, bear, happy face, led costume, female choir, male choir, mysterious choristers.", "short_description": "Enjoy your mp3 music controlling lights in your stage or fighting against opponents, defend your stage, use your laser weapon and your baseball bat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bunkersurfer.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bunker Surfer", "support_website_url": null, "website_url": "https://bunkersurfer.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
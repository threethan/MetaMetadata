fZXFvVmx3D0J7iov4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jX_EW3DoKhqvGJgjjoBK8ciBYE5G40bo2ZmCVQpcziQ&oe=6A3EA9E8"}, {"file_name": "3.png", "id": "755896143712767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830599_755896147046100_4223091567552209149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzgG038NtbwQ7kNvwG4-bpZ&_nc_oc=Adqi-0jLpkZhf3rCeVhddL4swdGMc0Oh_vPa6d3skRteNe26FgM4KtHrYvKe5uVxrQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M4Fb13_-4FpCJt0491D1SMsoyzulGEw9BnK7A6NbuVg&oe=6A3EA278"}, {"file_name": "5.png", "id": "788400797198535", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_788400800531868_626867103320428733_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGzM3o1eCywQ7kNvwEKVPCK&_nc_oc=AdqGVwKzLwg-CXsok7Tr_dgVntIfF9ZZX-zeRWOZXJTBVczQLdIoPVi82qekIQLroK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87EQp6enXAHHN_z-kuV244W929JaAUIw9_Zx6M4jriVg&oe=6A3E8255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battle Start Party", "keywords": [], "long_description": "\u0410 collection of four vibrant and engaging mini-games suitable for all ages.\n\nArchery Contest - Test your aim and become the best marksman! Shoot for the bull's eye, hit apples, and skillfully dodge arrows from your opponents.\n\nTeam Fishing - Become the best fisherman on the coast. Navigate the ocean waves to catch colorful sea creatures, but be sure to avoid the spiky sea urchins hiding in the water!\n\nHarvest Time - Show off your quick reflexes to plant and harvest dozens of vegetables faster than your opponent.\n\nDiamond Dungeon - Explore the mines and collect as many sparkling diamonds as you can!\n", "short_description": "Explore a delightful collection of four vibrant mini-games in this family-friendly VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battlestart.com/privacy_policy", "developer_terms_of_s
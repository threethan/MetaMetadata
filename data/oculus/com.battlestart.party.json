E5HU6ifjjYZFU66PY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXiOqvyOs6HfsbikK6b50C8K4JsnDTHtIjY99Z8uy2cw&oe=6AEF52E8"}, {"file_name": "3.png", "id": "755896143712767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_755896147046100_4223091567552209149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHI-OlNsCc4Q7kNvwGwY-JL&_nc_oc=AdqGPjYb5ScZy-yoJ2zdm7wSG-TudUyPGofokDKvtQyNwrY4sW_IGj-ohxJNA8QxFp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpyRTYraxTFEIVRUAoqfXEmfT6kWtD7n-henwjk_sfmw&oe=6AEF4B78"}, {"file_name": "5.png", "id": "788400797198535", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819934_788400800531868_626867103320428733_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lkKIV9G0KoQ7kNvwFo3aPa&_nc_oc=AdpVFbRBvUUVTH-QX-3r--xnpEVYZ6JOc0mI7s8xIcsfORrD51JsZ-ZXAFfmomkzyyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI3oAGgAA6UeucwbWtWgw76RMnoEu48ckyvbSdn1HqfA&oe=6AEF6395"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battle Start Party", "keywords": [], "long_description": "\u0410 collection of four vibrant and engaging mini-games suitable for all ages.\n\nArchery Contest - Test your aim and become the best marksman! Shoot for the bull's eye, hit apples, and skillfully dodge arrows from your opponents.\n\nTeam Fishing - Become the best fisherman on the coast. Navigate the ocean waves to catch colorful sea creatures, but be sure to avoid the spiky sea urchins hiding in the water!\n\nHarvest Time - Show off your quick reflexes to plant and harvest dozens of vegetables faster than your opponent.\n\nDiamond Dungeon - Explore the mines and collect as many sparkling diamonds as you can!\n", "short_description": "Explore a delightful collection of four vibrant mini-games in this family-friendly VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battlestart.com/privacy_policy", "developer_terms_of_s
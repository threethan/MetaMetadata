_lenYKDbJGCcMc_ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4zbZa9HIeQ11fc0LW0iD4_fmnXPAxCoBnUfP-XMzERQ&oe=6AA2A3A8"}, {"file_name": "3.png", "id": "755896143712767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_755896147046100_4223091567552209149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9DuKAx8gxQQ7kNvwHF63Xx&_nc_oc=AdqK1VUcgBsvnIFIAf9ddqQJbPGlVcATrHrW9La_eivrgPsnSF5voS4pfCQuvKnnqHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJspBArMx8zHOEMj1Ien22ei0xsXPsKMjWkd6AC2lxzA&oe=6AA2D478"}, {"file_name": "5.png", "id": "788400797198535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819934_788400800531868_626867103320428733_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQTURIMXv8Q7kNvwFIzJ_r&_nc_oc=Adrn--Zb3ZVadYOYKTQtW543brA73k-Ba8T9ezEa_Eed_eBmfvYaHcbYl04C2rtkyuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC8-ivvev7aFXtWBKims1FxMpQrtqCflPuWHpLXoJq3A&oe=6AA2B455"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battle Start Party", "keywords": [], "long_description": "\u0410 collection of four vibrant and engaging mini-games suitable for all ages.\n\nArchery Contest - Test your aim and become the best marksman! Shoot for the bull's eye, hit apples, and skillfully dodge arrows from your opponents.\n\nTeam Fishing - Become the best fisherman on the coast. Navigate the ocean waves to catch colorful sea creatures, but be sure to avoid the spiky sea urchins hiding in the water!\n\nHarvest Time - Show off your quick reflexes to plant and harvest dozens of vegetables faster than your opponent.\n\nDiamond Dungeon - Explore the mines and collect as many sparkling diamonds as you can!\n", "short_description": "Explore a delightful collection of four vibrant mini-games in this family-friendly VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battlestart.com/privacy_policy", "developer_terms_of_s
306173068496855_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE9sloTYVMIQ7kNvwE0Sqcm&_nc_oc=Adr_wIbHoSMg8oVK_b5KhczlUlxgVRttvVMuQIuwxCSQm4MPgvGNeQmRWsDCL5z27lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWLJkgBOoCQTOo58PTaO4_90wNeBityuMQA5hGdc5dJQ&oe=6AC657DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "milo taggers", "keywords": ["parkour"], "long_description": "Milo Taggers is a VR physics sandbox. Master the art of locomotion using your controllers to navigate through the environment.\n\nFeatures:\n\nPhysics Movement: Use your controllers to push off surfaces and leap across the map.\n\nSolo Sandbox: Explore a stone testing area built for movement practice.\n\nSkill-Based Controls: No buttons for movement\u2014your physical arm motions control your speed and direction.\n\nStep into the world of Milo Taggers and see how fast you can move!", "short_description": "Explore a physics-based VR sandbox in Milo Taggers! Master unique movement, climb walls, and test your skills in an immersive parkour world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rsTMCQnSIzUVuKHrwWmjpJaeOrU2K8Aht7AneJtC9lA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "personvroffical", "support_website_url": "https://discord.gg/DDNkMKZkyU", "website_url": "https://docs.google.com/document/d/18EhtWGMt08-X8TRZWAh08oA0f0S_HblvpHDE7lM35fs/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
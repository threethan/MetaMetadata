t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQywQei7u0_IzY6poGY8_gyH_O_ZDufzzoJqSm7Azu7ow&oe=6B06F3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss5.png", "id": "505736522179444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462955_505736525512777_6892212070865107814_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXI_YTtXHUsQ7kNvwEMHlRS&_nc_oc=AdrMXVn8JgMmlw04F8orcdXIckgBJQYTk5UaZaR_fiUJqHQbyahRX7MqQ5Z5-iPZ1VM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj--C-sF74cljJ0fw_5xbZ3UVGeKLTNZAkwUjPvqPrww&oe=6B06F787"}, "display_name": "Dragon Breakout", "keywords": [], "long_description": "Dragon Breakout is a thrilling maze escape game that puts players in control of a powerful dragon trying to break free from intricate labyrinths. Your mission is to navigate through the winding paths, avoid deadly traps, and uncover secret routes that lead to freedom. As you guide your dragon through each maze, the challenges become more difficult, requiring fast thinking and strategic planning.\n\nThe game offers a variety of labyrinths, each designed with unique obstacles and puzzles that keep the gameplay fresh and exciting. With smooth controls and dynamic visuals, Dragon Breakout immerses players in a world of adventure and danger, where every move counts. Will you be able to guide your dragon out of the maze, or will the labyrinth keep you trapped forever?\n\nDragon Breakout appeals to both casual gamers and those seeking a challenge, offering a mix of action, puzzle-solving, and strategy. As you progress through the game, you'll encounter new mazes with increasing difficulty, keeping you engaged and pushing your skills to the limit. It's a perfect game for anyone looking for a fun, dragon-filled escape adventure!", "short_description": "Dragon Breakout is an exciting maze escape game where you guide your dragon through complex labyrinths to freedom. Avoid traps, find hidden paths, and use quick thinking to lead your dragon to safety. Each maze offers new challenges, requiring skill and strategy to overcome. Can you help your dragon break free and escape the maze?"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/dragon-breakout", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9919056681444656"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1191919643409922"}, {"status": "PUBLISHED", "id": "25852413681122370"}, {"status": "PUBLISHED", "id": "1893796411288293"}, {"status": "PUBLISHED", "id": "25667960402868576"}, {"status": "PUBLISHED", "id": "747154028297951"}, {"status": "PUBLISHED", "id": "1205028727484963"}, {"status": "PUBLISHED", "id": "3969621009953501"}, {"status": "PUBLISHED", "id": "685055553877301"}, {"status": "PUBLISHED", "id": "957282036502696"}, {"status": "PUBLISHED", "id": "1126973115612692"}, {"status": "PUBLISHED", "id": "1198683301457205"}]}, "baseline_offer": {"id": "685055553877301"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1796155200, "status": "PUBLISHED", "id": "1191919643409922"}]}, "liv
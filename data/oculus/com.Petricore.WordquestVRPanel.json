t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKs2Z_otfqYPZjimn0vM87vl2X75yQ4kUqTvIQ6Hk9Bw&oe=6A986024"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAEodOBq_EgQ7kNvwHkqUeO&_nc_oc=Adprk61c_iR_KZj3vl3KGHwVym5KAnM6QxfNhJu428f0DQP-afV8Itv3Z2xl9Enk9-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI968WDGzeKU9k1I-qYulGpYEzYtt6ybhFAlwBLlHV8iA&oe=6A986043"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5i2VugEMT4Q7kNvwHw3UG2&_nc_oc=AdrSGWJGK4ZmpH2FLWKsLNPrb3zk2zQo0YF7etdNFV4Jb5A3FeO7pigu7p51v-JxY6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJeR75eLeCXdscQwDjcXbBwS8KOOk9xGcv3uuk3fom8A&oe=6A984A12"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Qr2NpEC9R8Q7kNvwFpWsx4&_nc_oc=Adrx2pIOYn3ZTlytB3QWRZbeHYSjyCBqOS0IZQV0YDDinHuiHHweipHZTVZnfA716tU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFi1DzkJRQNPciCdKtIspiuFbS8Fr1K2DdNTttz9_iLw&oe=6A9843FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIhi0v22mFcQ7kNvwH1-cSp&_nc_oc=Adp3qqQCRonH1qdeTufHcHxM3R0HQ36REObAxX_i76UsZo00gxDNHEwJPwA942X36HE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-BcstOAseJFdljh3JJYN3OEOVCl83cG4ETvjSCOXC4A&oe=6A986407"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
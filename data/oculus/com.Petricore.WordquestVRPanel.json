t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M0RljljnfZAItT1L6bactJWh5IvBMn-FVJL_JA2s-6g&oe=6A3FD364"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwYUqeuRiXMQ7kNvwGlMS7Z&_nc_oc=AdpCWx1cdyXS_uoQWHXD0p-F08Vc1ieD3ECkeG6b1_JuT6TfzwUqgLUpB5hQKxugvUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iXIzj9PcxNGOGtJNLTX_irIZ4GvEoPlMgfDoP6fItLg&oe=6A3FD383"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBWGD6Q4108Q7kNvwHg55u7&_nc_oc=AdqCJ9cLNlubBG0fPeAg1I-4r8Ix4PDZ2xXbUDcwaS9Ftb6JItfj3dBhBTHCI4W-Wso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8La3yfqIcfcNIxNygn6KxiUxolr2V1MPH35bl74C6qwQ&oe=6A3FBD52"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeCBTxcUOiMQ7kNvwGGmh7n&_nc_oc=Ado2Wp-LPQIbb6dXmJ5r-cai9D94tUjxbxfqfOGg0j3ndaodO7C2ctIKebPzePXVjjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pZZ3jFqvpsIP9T6s2gQ_DsGlAqmzFiDlYqzvbVDm6ag&oe=6A3FEF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7a24XhpGKtUQ7kNvwFOmIAE&_nc_oc=Adq_cYQW0RKcD7T6hz2mJXu5oI6QuWEvWLr35Jcca6799El5PTPvA7CUPWveakjisT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XR3Txb6zDidR_wkPCmSXo3JUaEZFEyISI4rtrqtypYg&oe=6A3FD747"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
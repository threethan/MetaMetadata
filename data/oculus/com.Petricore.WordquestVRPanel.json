t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVzt4q2oiilQWDkO8Jup5TJvxIsk4vNMu3XnSzXibMxg&oe=6A9ACAE4"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAEodOBq_EgQ7kNvwEW_h1v&_nc_oc=AdoZ6I6YTS4S8FnPsIYma1UBZW-6vNH-ey3hUESBHU_bMlxMO_zsMbifGWe7PUVTprU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQs3tbK9HiZjub8n2zNBDi5o5HYNabWgHDqTh9M_57dA&oe=6A9ACB03"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZdShvVZwDIQ7kNvwHFMblB&_nc_oc=AdrgIJ9KaFfs4XrRNjZ6Nl5JuaSGROknL-muTnYccCnM7U1qk4Qr7r9AWD5-aKtVQDs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX9gn25e0sOoeIAZJkoNT62q_ALjnIAnFVqWOmHzRV5Q&oe=6A9AED12"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aer5hAnWHkUQ7kNvwFlyCxQ&_nc_oc=AdqoBSAJONkGH9zXOEc8Q0_IYTiX0vezSjQaxGf3n83MekbrJNR973hQi4jaLGJGiFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg2DRX0B8vVtdqf5aEZ0iGeSkjXMDGKzFL8z-XTD798Q&oe=6A9AE6FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyDAdr5Pg3oQ7kNvwGphL4a&_nc_oc=AdqN-iUoRyW-9tTRxqxlwsAgIQFLZnqhudsQmJ_eq-gNdA0DphjJYhcHwIIZswYjqCM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiZBgsHDBneX3pLStRsbKOsgVec8EhHmnVJEZhpZHsdA&oe=6A9ACEC7"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
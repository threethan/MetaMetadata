t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3EfsRvKO2351l0NWKLi2KcK-3ogm4TsSosOoOUeXKBg&oe=6A81BE64"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYhKfWDdOmkQ7kNvwH7Yt03&_nc_oc=Adq3h4R71Fd9CbHouBJMRI06nxIavBTiRCHeW9NuHCQj00TKjvpL-CNarcEXfHj82ak&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmIogyXo-pf0Flvdwm42WOkoVW6lS8eH6V5r6m-CQVLg&oe=6A81BE83"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58DKFS2LOwcQ7kNvwFqsXQu&_nc_oc=AdpKmCX0p42w7Gp387B8G889rfQi3EawskY78VdyPQIdRsi4TkosX6KGhhTAFxIsSqs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6AutO9y6ai7AmOZoR4hyg5KWTF8CW8N6B0W3-x9Vw9g&oe=6A81A852"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbLStRurDxIQ7kNvwEM_ahQ&_nc_oc=AdrEqV1CCKK_i67S-CCO63MYeOh4oYUEgKfKy4DsQEyh2PG04l_iDuw-u5gLsRnsEIg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-TKnEaO9q4DfqP6_UueF-tLU-8jT0Xl9y2cS6IyspYA&oe=6A81A23A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4EMGyUTafIQ7kNvwHpSTpE&_nc_oc=Ado6-qH9NzHOgj90QCPLIKbjYLa7pUSahqnpyEB-Zw252MZZfQ5Sy33LTJaD5mxNxQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6XaxlrHFSDs_LK9MLplHsmJBrA6v4Ql37-pb5Ex4hzw&oe=6A81C247"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
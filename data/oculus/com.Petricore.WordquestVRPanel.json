sts_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ph1Q2e866YQ7kNvwFxRk6P&_nc_oc=Ado0EXE7BstOzX2_vpshBlWLqfR1ImujNUY9qqm_ZFMB1uBiBJ2qsEFWQx8wgp6gIak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqwCmOiSNY0DvYrx6quAyZQd2VpwuLOQyWSGJSXKGR5w&oe=6A5F7783"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be_CuCVE8ooQ7kNvwGpo0-u&_nc_oc=AdoIPAZj07RkJd6Q4lzJ9NASTC_3VqXXyni86qDq4--jiucrFQpYc2BNDEAqr6oFM6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpTRbZeezyyOxpgKirJcrMYMlrdXyA7qV5CGQTaAkyow&oe=6A5F6152"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDCcvSwb5FkQ7kNvwFkW5hL&_nc_oc=AdrYF9BS1l9Y_0ZqaqYKlF2CgFe4i0Wt5xVW0FVcYPCtmhjTM8OGmbd2vH8KhrxWV80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv5gZwcaJNDZm4dMEZRgpDKGuT8sGP44RPepf4XYT4Vg&oe=6A5F5B3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blFrxdZ2JSYQ7kNvwFIVW4G&_nc_oc=AdqPNMup-AX4saCSGk-DgIKxHn7-XQz_FPw3A1xmN5aSGmzml66SGMpxi6svLQtTUfY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPewaOwEFkVrkbwSuI3B90rnZHIZq_I6V8LVJDN5szeQ&oe=6A5F7B47"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
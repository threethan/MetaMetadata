sts_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41OZVJ6XQP4Q7kNvwEoFH5o&_nc_oc=AdrAZP9MMPnZPYSanL3CxGHaYnZ0IXkxuu55Dp3MiUQ3Oub7pm0arVx97rQTHGT-8OU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pk728pG5ukFUd5C-EC2z1_MR8Y1p36FnYSprCxH39Zw&oe=6A202F83"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjzqVPsRlysQ7kNvwF_ZsQu&_nc_oc=Adq6Ox1Gq0mr136U_uBXBykyj6B1rkbTwdgHwZLjjJe4Lo6D-XQbTPsojjzZb_1X2rM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ScyoSaP44mBfEjF3DBgEHL0sXEKHtn1Z1vvXliNQABw&oe=6A201952"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfoEmlaZYFkQ7kNvwFs00FX&_nc_oc=AdorVN919iWpyxeeKQcslEDFUfq3jZShW2aBLxQ49vNiMVbgRWkiyxzW5tcTNKlUw5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LXuswdjojq8L2paRb2oCBCQkIUrNezqZLLp0IDUqnHg&oe=6A204B7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Weo82jfEsngQ7kNvwG1_kAL&_nc_oc=AdouruLlgBCIKGHrNmNFN74gKasp9lThjFb2jPY2VTBz8RXPtjKBc_lxjBtlGEGK3Io&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pC92Ei-Nt35C5sOJfjgzYyEQwUQL25ywMxp63fdOM2A&oe=6A203347"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
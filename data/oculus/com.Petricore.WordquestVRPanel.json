t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpO0HDRB_GqFpvws_CqIHg9e9xLRuxK1BHWIda3AlT1Q&oe=6A5A3164"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ztTNHFYfqIQ7kNvwFPqlhS&_nc_oc=AdpXAx4_fpzlcBcEWow4o3GlRqH0cB9qP7QSe1MtErie0ovBrjqYAQ2cIZPKHdq2wMc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHhmp0LrPODnJ56tqMu6j-fv9NFxOtCD38tpOjcKWshw&oe=6A5A3183"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBiQ-aWNc2UQ7kNvwFqX5DJ&_nc_oc=AdozYG21-n0nEwVRU87Pd2AWlLM6_1oWoklwEVuPRJ2yhLS0iohy-2XRrgtJAfeWBNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_CJZ_Mqq4zNsKKiATYzdVFxjwEwZpatPZINIvMW55tw&oe=6A5A1B52"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kdNLmRkf6gQ7kNvwH6oyxc&_nc_oc=Adqru1UlDr3jGjHnuvf7vGA0cVz9z9ZGLsb7EK3U47Sr44IQdZC4GtDRlBI0v0Yc-XI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgEsuzADiTFO3t6EzaaMKgTvddSddgmK5xMxikKEXapg&oe=6A5A153A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rogf3ABBKfoQ7kNvwHr7rdG&_nc_oc=Ado_YcsBHEa02kOEa9ckqE58WRvVgD2ndP5NtWvdhLlmbKUY0sH-BEnkcV335zzPd64&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkPAqGbjMEfJaGuP3Ag7eyAR7qigwY-2M_1rGg_LbLow&oe=6A5A3547"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
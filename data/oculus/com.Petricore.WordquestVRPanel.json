t-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7AMEEArcuspsJAMRtdSW0FFjAjsSzGop29RGcm0ZHMQ&oe=6A58DFE4"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ztTNHFYfqIQ7kNvwGhRDuK&_nc_oc=AdrqQ6F6RxZSQ3R96-VkhrT9ht5J4qc6HbRVbeA7eecHIZ-FrVaAeCVMOlY-iQhMXhA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOpkk7bWzw_rOyuLCLL04WDtfAUc3CAciRbMWdHW71Yw&oe=6A58E003"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spJAty_GTvAQ7kNvwFkf6hE&_nc_oc=AdribjN1hFEV_u9s72kdUuCg0PT7-pxKCe2AzyVGwbtkx7lrkZV_2_TjdXbk_TvclRA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWcdiUKgKNtWoJ0WSWMFBzwPzwXk0Lh-MyaqKCnCwj4g&oe=6A58C9D2"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kdNLmRkf6gQ7kNvwGZLZHI&_nc_oc=AdqAfecE-Qulfr6mQpxPSuek_3P8YgU4xM-iNLgOa_Qc4-7y_4uBpYZ7YRwAKg2pwaY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASz0C0s7Qhkpx1BF6AzkxuDZJdjWKXevqchXCRb5Xivw&oe=6A58C3BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygPE7qA0A4QQ7kNvwGSCTnu&_nc_oc=Adqogf9RzoAnyRDsKf2lVz0HbeQEMLCrdNQ3IdXEPYgTBu6ZPUjgQxeQ-dW2YHvO1AA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7zH71voQJ6koR8e89UD6wstiIY7d1AfU20fofBecrJg&oe=6A58E3C7"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
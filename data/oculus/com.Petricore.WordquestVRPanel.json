t-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzeqYX_c1LoNb0NPzLtTcyTZbXE1Stm1kittXYg0C1xw&oe=6A919064"}, {"file_name": "Wordquests_screenshot3.png", "id": "1420736926069065", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491831968_1420736929402398_3687970619456067935_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D39NtOtTH2QQ7kNvwFsVTPb&_nc_oc=AdoJl6DffBuQUPkNuffIRwkt7_GaPVpb7XrCsvXWRBoXVdfeHwrwjOxEFa6-ZjLOFn8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlOTDgmYkmFFO3xAQy0FIcPyK7jNe2t8SwnKYPZ86OXg&oe=6A919083"}, {"file_name": "Wordquests_Screenshot4.png", "id": "2423286998132911", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499295566_2423287001466244_1483651506382498491_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJobAm3YusAQ7kNvwGJPHKw&_nc_oc=AdrH8OH-eM7Q0xItPFgmry-ElIys0AotDAt8cHmr8ygJa442u2wCrus5jUfS1CmLFis&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwVAHP3HJBsjiZfXaCyOXw62tC3rAvibc8ILdAjhQW5Q&oe=6A917A52"}, {"file_name": "Wordquests_Screenshot5.png", "id": "2051473415637341", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499304938_2051473418970674_1406665001066259768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yhso6IrAnKsQ7kNvwFOaCH_&_nc_oc=AdozmyZkZpkpNp4evRA0rVi0YmgTXD3EL43EhWbj0dkJjOjeGrwC37KOSjso50DKOfE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESdlme4sa2iZYTS-ID2-UIFxUDSiyO2eXYO3oaULIXbw&oe=6A91743A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WordquestVRPanel_Landscape.png", "id": "1634809677947916", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/604317775_1634809681281249_7595634130615971519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSVArUloZUMQ7kNvwHkQtbK&_nc_oc=AdqfmwowvhO7SxsiKWCudQgNLIJ8SDZNfaTAAtA3W9izKUtHfdKuV42AN4qBvvPSkWM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8pw2QpbGdFPshzktWev_HI3JxoA-HsNDYQlFzp_qNKw&oe=6A915C07"}, "display_name": "Wordquest - VR Panel", "keywords": ["wordscape", "puzzle", "logic", "crossword", "wordsearch"], "long_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game built for multitasking on Meta Quest.\n\n# **Solve word puzzles in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Spin the letter wheel, discover hidden words, and progress through puzzles while watching videos, chatting, or taking a break in Quest.\n\n# **A familiar word puzzle experience**\nWordquest \u2013 VR Panel features word search style puzzles inspired by classic mobile word games. Progress through multiple levels, unlock new content as you play, and use hints when you need a little help. All content is included with the premium purchase, with no in app purchases.\n\n# **Designed specifically as a VR Panel App**\nWordquest \u2013 VR Panel lets you enjoy a calm and satisfying word puzzle without pulling you away from what you are already doing in VR. Play at your own pace, for a few minutes or longer sessions, while keeping other content within easy reach.", "short_description": "Wordquest \u2013 VR Panel is a relaxing word puzzle game. Solve word search puzzles using a letter wheel, progress through multiple levels, unlock new content, and use hints when needed, all in a lightweight VR panel that plays alongside other apps and experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
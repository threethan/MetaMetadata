-3.oculuscdn.com/v/t64.5771-25/491822450_1082064493943619_2182037172037033536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmnEuwXRGDUQ7kNvwFWCWAx&_nc_oc=AdqxwP64o2ydSZUObh3pPs8t_1rpsvUp6CO7pJXmhnQ3OAMVIqSgjI__MXl8LhF7z5Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0vjtd4E_yjMOBMuZbUvzdhn0kfWQ6djpilMRr7pn5Dig&oe=69F1E8FF"}, {"file_name": "screenshot-4.png", "id": "2435426376811614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824937_2435426380144947_2127448804878194858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IW6CQRyaVOoQ7kNvwGpuUtB&_nc_oc=Adrcz6rICF9qTbiD75zGEYzLA-40SsJoTrefRcmup_UxgsrDQjmq84Pi6xbPIUaoI34&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af309ydndrcVh5eL1fMONR9Jyuf-zYbGZjuX-zt37tqy7g&oe=69F20771"}, {"file_name": "screenshot-5.png", "id": "716118864176020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823984_716118867509353_579047908278972784_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Upp960yj4noQ7kNvwGTDU9Y&_nc_oc=Ado1lcU35VQydDZ9K5oqwFcL1YpCWVzvy24LLjCgJ8dmMJ6vpP72UV62TwWTTOwhcc8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30VDKbXrivso2iJ-XAdEVVJxki_L6BoLlbMUphMFiAyg&oe=69F20480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "2942506825924088", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824530_2942506829257421_7854453133422527306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGQ0iQ72tkkQ7kNvwGh1Nub&_nc_oc=AdqNBW_qgsXTaJArsIjXjRIkW92DLdfdpUhDq1PgTdWDKLQAknHRqRt5bzyPFqVT-ZE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1z0Ouj-FW9Ant9OJifJ7_qPaXo9saLIVkAtocCJ4PuPg&oe=69F20CF3"}, "display_name": "Jungle Hunter VR", "keywords": ["Jungle", "Hunter", "shooting", "Adventure", "Action"], "long_description": "Jungle Hunter VR, allows players to hunt realistic animals such as male deer, rabbits, ibex, goats, wolves, brown bears, boars, and golems. Players can use both hands to handle a pistol, remove and replace magazines, and pull the slider to reload. The game features health points in the jungle for players to heal after taking damage, and both the animals and the gun are designed to be realistic in a stylized forest setting.", "short_description": "Jungle Hunter VR allows players to hunt realistic animals such as deer, rabbits, wolves, and bears. Players can handle a pistol, manage magazines, and reload using both hands. The game features health points in the jungle for recovery, with realistic animals and weapons set in a stylized forest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29123693393945664"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827864_640505735481068_8443256505149586768_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfAusoExzwgQ7kNvwGTRWgf&_nc_oc=AdqvyFNiObn-C6-ZB-8D2IOaGWoeHdItbEd3iYe3Gy0gf--H1jfDbcnlTyOjUcRpEsE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1qPpoDL_zpXFI_yK_rD2aTL7NiIR7hXXe09VzR0qTjwQ&oe=69
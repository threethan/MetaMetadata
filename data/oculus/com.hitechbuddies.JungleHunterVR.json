t-3.png", "id": "1082064490610286", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822450_1082064493943619_2182037172037033536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4GOmIhv9y0Q7kNvwENfcjr&_nc_oc=Adq13TA-CutiQZZ3igcHR1M69uI9D8lA7twaL4wziks7p0yUyOzInsRt845_t7B4RYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtBHHpCuZfhc2boOb_xeydKy2b_Dk77t7lIvDqNkLk4Q&oe=69C1217F"}, {"file_name": "screenshot-4.png", "id": "2435426376811614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824937_2435426380144947_2127448804878194858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMYtbtn3ibcQ7kNvwG3UpiU&_nc_oc=AdpJuCTwasL9mavVBYeyNxE3mNJWVD4YH82UmRRGZ4CshH8wGMztQZiYAeikeGnUZzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnCrk-zoA0mNgP9gfTxvBmXCZ7Tn1K0gvJ5-WlBsYsNQ&oe=69C13FF1"}, {"file_name": "screenshot-5.png", "id": "716118864176020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823984_716118867509353_579047908278972784_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6CHc3bbOaUQ7kNvwEaEuN8&_nc_oc=Adq24w1ZaVmn5U311FCZ69CEIbxj6I9ALG-mCXsisQ18mRyfZ5tViClLsZzD8d4lc58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw88X-erqOyX125PlyzfpK2v-2w1Qg8g9mMunE2AtljDg&oe=69C13D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "2942506825924088", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824530_2942506829257421_7854453133422527306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxCo3OFPXNUQ7kNvwHmQWPG&_nc_oc=AdoSrJr43KKCiCeHICsj1N2IIPsPEsQp4t8rXEdXpq3LffIZo9dHypOiJhSDIME38v8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIZZRbs6NRUwpq3rlWRQeS9EIxwS9ztig3stPm_5jCIA&oe=69C14573"}, "display_name": "Jungle Hunter VR", "keywords": ["Jungle", "Hunter", "shooting", "Adventure", "Action"], "long_description": "Jungle Hunter VR, allows players to hunt realistic animals such as male deer, rabbits, ibex, goats, wolves, brown bears, boars, and golems. Players can use both hands to handle a pistol, remove and replace magazines, and pull the slider to reload. The game features health points in the jungle for players to heal after taking damage, and both the animals and the gun are designed to be realistic in a stylized forest setting.", "short_description": "Jungle Hunter VR allows players to hunt realistic animals such as deer, rabbits, wolves, and bears. Players can handle a pistol, manage magazines, and reload using both hands. The game features health points in the jungle for recovery, with realistic animals and weapons set in a stylized forest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29123693393945664"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827864_640505735481068_8443256505149586768_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg_SGZ_IutAQ7kNvwGl_eiV&_nc_oc=AdroX1-PDs8ZyHoaBuu9ksee78d6jO5xx7jQx0jwAPyw5W-2vI4drv3ieZgpMms62Hk&_nc_zt=3&_nc_ht=scontent-atl3
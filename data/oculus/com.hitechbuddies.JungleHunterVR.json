t-3.png", "id": "1082064490610286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822450_1082064493943619_2182037172037033536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN5D2eeW_zAQ7kNvwHZ_5R4&_nc_oc=AdljLVRzMik_bLPYJ1LcFhiHwcuJYU1wT7Xyet1LLfs4QwjT3F-W_nF8_x6MModL6uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmcZVl6ZwGWqTaBgFAZpk_l9lhvzYp5e16IAC8ep4Gyg&oe=69AD5AFF"}, {"file_name": "screenshot-4.png", "id": "2435426376811614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824937_2435426380144947_2127448804878194858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhRvn0mO_FcQ7kNvwGHBgv7&_nc_oc=AdkoNVpaP3ZwpV-KNuUI-In__P3XGV0Mxea_LDJy1mz1pGxPNvdm-sBFgPeacA9GNQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdDf4vE2wO0vkGhyqLyYJb8d-UxcWF3mw0XcmjWz-SKA&oe=69AD7971"}, {"file_name": "screenshot-5.png", "id": "716118864176020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823984_716118867509353_579047908278972784_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-udoNzlwVicQ7kNvwG6IGQN&_nc_oc=Adm5pw6l1z4yW8g7WqZ1Hv1F6zwng6pN_akmve_rEP4U7sF0k40vSxdlxVRH_LSWZ-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVEPj8f1Ce7q1_lwxGtii682KM0-X0_Jr19zppIpLbkw&oe=69AD7680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "2942506825924088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824530_2942506829257421_7854453133422527306_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yu0KutyK7i8Q7kNvwFiXE9h&_nc_oc=AdnpHgDwWMGzSG69MLK-grqgzjQ1EpHi1jYByK8p1jPkUASGA20BftCKfx-k-UOTwdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMBOKkODa--EeV4u1at6Ujqugpc2J1pAV3pIhbiG01Ew&oe=69AD7EF3"}, "display_name": "Jungle Hunter VR", "keywords": ["Jungle", "Hunter", "shooting", "Adventure", "Action"], "long_description": "Jungle Hunter VR, allows players to hunt realistic animals such as male deer, rabbits, ibex, goats, wolves, brown bears, boars, and golems. Players can use both hands to handle a pistol, remove and replace magazines, and pull the slider to reload. The game features health points in the jungle for players to heal after taking damage, and both the animals and the gun are designed to be realistic in a stylized forest setting.", "short_description": "Jungle Hunter VR allows players to hunt realistic animals such as deer, rabbits, wolves, and bears. Players can handle a pistol, manage magazines, and reload using both hands. The game features health points in the jungle for recovery, with realistic animals and weapons set in a stylized forest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitechbuddies.com/privacy_policy", "developer_terms_of_service_url": "https://hitechbuddies.com/terms-and-conditions", "publisher_name": "HiTech Buddies", "support_website_url": null, "website_url": "https://hitechbuddies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29123693393945664"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827864_640505735481068_8443256505149586768_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es-1gF7KDAkQ7kNvwGv_f31&_nc_oc=AdlwgHtmvhvXX5R4dB2sm6_MRmLZUsG3oVWHpW5tlVGPWrm9WKpnVd9Q8hQhR6uVK5o&_nc_zt=3&_nc_ht=scontent-ams2
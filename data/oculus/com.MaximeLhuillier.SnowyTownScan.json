b=1-7&_nc_sid=6e7a0a&_nc_ohc=1LP6EI_c450Q7kNvwF6XtUO&_nc_oc=Admy04HKL52PCTiCbd-krYtiWr3I93ym0TkyeLxd_zm8vQ_PMhsOSNhIXmZ5LjE5aEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIXkVzgSr3ARktcQo3pVrw8C2pzbm0uEyf1rzClNNs8A&oe=69B2B4CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM5KOjBkpkMQ7kNvwFDUTu4&_nc_oc=AdmuZ4fpOztIdvpNsTCoxvk7ogqFo55094kPK-ZebYRuA5sustgLm1hEkKZ4-mxp2rA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUUkbU0-aCMk3p9_Bn49CcXp-GEFoFknbRbCc6CG2LGw&oe=69B2CB53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u_6AdMlx8EQ7kNvwHFqT5Z&_nc_oc=AdnO3uXNEhzxT_NY-rFfZKwr1YTNKVrJxYjkUugXrIvS8aonCKq0GKDOjf3F6Erz7Gw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAZNCoy9kIVZjBW9H2j3SrDng6-rPJze7DNbf54M_MuQ&oe=69B2CF11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ6rqx92V8MQ7kNvwGpsrrS&_nc_oc=AdmfixM-XAoIyZd7P7_TM16CMUXVWnDF14XEZyuaB5yh_UbG6m12d0pK_39QwmV9xsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afywk1urqif0TnOfEde4f6hjzJt-xsdafKDip8RF6bc0rQ&oe=69B2B3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5jnyJmNjM8Q7kNvwHd-OeD&_nc_oc=AdnAkqqSfWCZwPccKT-jEfqTX6ZALANljhdDVFEkw8b3AnOfY5DPQA_t4gmsoLsowh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjzK0e7bejFs7Zg-eIVZ5z6tcKfdKiCvc60qH6s-oUMA&oe=69B2A3AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzcnTiaTFGkQ7kNvwFkERlf&_nc_oc=AdrmZGs7cWzSEqsrgNkFM2ABj84hisvZT3NVO3o5keDnNGQ_jVDnvle-pjb8_q0gVKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7YBtIXjpN_rAMGE6alOMJB2oHKoTHEgDqT5cdY3BdSQ&oe=6ABE8D8C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEOOaABGp0AQ7kNvwHVxA_u&_nc_oc=AdpmnQgIAJWuJ1TTub-MeY3Jy4aO9Pojp58zFMXjtAp-dwM9gwKfg3RlTUdNr2dFc2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR4v76FumYolBpjXWZJgQo1NV8MtyDRa37mi8Vmi4zAQ&oe=6ABE6BD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9HDXAYIrjEQ7kNvwEXahEA&_nc_oc=AdrgGfdwaapdP9ijndzDQKjvixodkrSnssYa3rob9kiIaSQ7Nc--Z1SYNBSyD5Sd0cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0oThgGUUo9S2bnX3V7l8UjTAl-M3jDmZ2W_iTIUa0Xg&oe=6ABE6F91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvGT4f1XoQsQ7kNvwEsOfJ7&_nc_oc=AdpPoRz_0Dnppzw8W06rr20rct1b-Tde4J8j8MsObCs6uZUBU6cw0ebriZ1XKCGXUcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWjE_wbvXhHOjcLoGpG0eYjdoZFB0OxePx1YRobpWqoA&oe=6ABE8C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTn60n5ufE0Q7kNvwF8ZbRG&_nc_oc=AdoTVtUqq6HpJv1XX1z-AuFQwaYzGdRTsuUTTH4_Vq8zQN-b6G5aRu7XH7m18KUyK9g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmrjO4A1OqHK82s9gYN5lB-jcmhMCyLk2lQN-3uJACgw&oe=6ABE7C6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
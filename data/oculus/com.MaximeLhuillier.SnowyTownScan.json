scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXMcdpTWvHwQ7kNvwHRsc0p&_nc_oc=Adp3bA9GVbYt6-ruBfDphj4X7gQ8njQYLxA1-IqTY20oUrInDSHd2FVt5GuVNwSzrlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZxYXfgGl_2uH9eRRE8XX4gx1pa8a8ij1qvc8PRCUQtQ&oe=6ABFDF0C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEOOaABGp0AQ7kNvwGfdmds&_nc_oc=Ado7mO6JcQmugO1FawSPFTV7XMBXJpDy2z590HkckhRSwUGUyfnRhvQWKV6riB_IY-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHE59gUzIaGfLRPrRPTPVn0jNk7_7TPckw2vokZK1JFg&oe=6ABFBD53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9HDXAYIrjEQ7kNvwHmhK9u&_nc_oc=AdqYgxb0ZR28ifuN4k8xNQVxfkqVKsmBr8AcYhHc8lrRaVCSnYL_1ai3yYaLKfKTvOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcx9kff_KoDrjJ6w6cTWWe6iEeMm_pg_IVLwaoJBTD_g&oe=6ABFC111"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvGT4f1XoQsQ7kNvwHd53oU&_nc_oc=Adp8vNNBFp4YqE9OyD48hUkfmaevZPan6Nqr6sFtMyHEKgzO1k3hMHKQPumhNbj2kzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmwf4UwqB6tdT48BFNqSGWJdN630QhPN2cab3dntH5xg&oe=6ABFDDF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTn60n5ufE0Q7kNvwHymBhf&_nc_oc=Adq5hTNwUp7PK3-SQGNtViR1aogyFzvWzfDKh_nDZfFk6aRaCFhuR0yyUq-71J_iGiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ3ekUgLTXNEHRR8XtZyG3qNomuu8qTdkd42CHqyFLfQ&oe=6ABFCDEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq12I2xHAxMQ7kNvwFfAgak&_nc_oc=AdriafKLisat2t7ZR86gS0DUD7M0hhpZ-x9lm1-NnGqGAAKhRTlyI4LQwDtAH-sK6fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9j5hbZGxrRjHIITl7GZT-NRTx4zEucom7PuZnJiAYBQ&oe=6AEA0F0C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzsSXx_d9HQQ7kNvwGCve3K&_nc_oc=AdpGYhH79oONcr9dd9eijOWURwrObMAXdhnQ_uYHVDyQ8FA8aCHKDBc4W8R3ayq4mUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBqC8Up9eRtYbpzlV4wXwxs48N_3VqqVnwPnRP8hTmfA&oe=6AE9ED53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qijsn9lnTxAQ7kNvwHsNoac&_nc_oc=AdqqwDO5rOiVlO7PmmlUSpZneiQPBy4E72SpIB_418CCMxWCyGRi2luM6c8PV7RNiRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq0WQp2Vol6EqHDr-lZCN7I35PTckFBlJwMgmVAg-24g&oe=6AE9F111"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVT93kJB3TEQ7kNvwErybIT&_nc_oc=AdqkypykzNOe5wf8vWkjDdnQzeeXvdxo2qyLDUBMNa7KuCcZZcYw1AvFX2v_tyFLsxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-y8LL3U9vekQG-p3Bch-gH2Mc6Av4WLHgDCKhMPhLcQ&oe=6AEA0DF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2mUjnaK1_YQ7kNvwHQ8Dpo&_nc_oc=AdouO8cgLZDLUwXAPIELrOQ68p8RzD4pWSJd77dMJ4-k1lyC6A4qa4QhgWK03bzSw3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh6l1Jl9wNurF4jUEegUUPppBXLLCZI8G6_FZM5FCE0g&oe=6AE9FDEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
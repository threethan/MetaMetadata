scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0QvIvTScg8Q7kNvwEoZwiH&_nc_oc=AdpzriwSfNk42zzTAWyC0XRpuywOR7LYf0uMkHXg-XkY0D87GZ0wS6vscK1txpT8XZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Krqf_dMelpThiAtKt0-4hilyMmV8FqHtmm7ktiZGVg&oe=6AC6768C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G80YzNumI3kQ7kNvwFeU1U7&_nc_oc=Adr3JAUgJKRYdhF6_UJO7Oohm9hLNdcM3TlPun8mF1C1vkKZl_v_Cq8cg4D7xMuBuXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw7Q66mE7fwxdnaZp8KTWFUM0NQK8-BC1W8VF2tm9k4A&oe=6AC654D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z4IcTI89i0Q7kNvwHygu74&_nc_oc=AdpfUURzcjELnDS2t0nMFtYH19PydqD4lyguWVYksB18Dq8Ja3B9fJkORoctAO8VvVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqJZnX86wn5Hd83jKWMoHNt6vJtS0uVdnjXDqmTSRcww&oe=6AC65891"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D36KiOzrDogQ7kNvwEaWxt6&_nc_oc=Adp7rkBj7LndvEE222rD6OEzcpkCE-oLK1WXHJqMXGOTJynAOmIDdn_Cb2JmpWf785k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9YCMklpU84nDvjdba1ulC-26Aj1uyirDkwVvfIlNKhA&oe=6AC67572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y5Ukr2OaxMQ7kNvwEhCbeX&_nc_oc=AdpVm4OVeSmv1ErG9H5I1cFgW2OW2giCH9-izi9PQxhunuRwlbGfkEdvTGPccE-uWLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAkThGwPKkzo02GHkJvdnCYbZ76woDvcoZI5jT41sSWQ&oe=6AC6656F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
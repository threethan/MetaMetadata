b=1-7&_nc_sid=6e7a0a&_nc_ohc=NoW4OhrBUhcQ7kNvwGIGKJo&_nc_oc=AdkgvjHwkmz1K6O9Gljtr_AUgXL2ygZOU24yVhjik_Yb6tECRrgYkCtGfNB94aK9w5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5elpVjd124jBVK3WaZH8X2Ozao4Fk32I3J8UlI4kKuA&oe=69A97A4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIcnAMtnP4YQ7kNvwHyuDGE&_nc_oc=AdnOL_4ZT3PeDggb-XzmJmLmEsteeNyhhQvij-JESRDZGjHvBnBWP4plRZXcnMe5S58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft85gjTnnT7erm3vhlYk34jJIkB-sAu2tATYU52iSaCtQ&oe=69A990D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1o1gaji9xMQ7kNvwFwT_ha&_nc_oc=AdnGVphJxtWMbBh9gcI0BIe25tAu1IA3pBq3Dh7u150obCIf4wRfTinZN7we_pZgACY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftWNzpG6rdzcpznhfd03v9nGZpaqU8Tg3R1zgHaLak9tw&oe=69A99491"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJjHalWzVEQ7kNvwHG6Iig&_nc_oc=AdlBOXjrNPtBQ2CfPTXb40pw_N-eLC3uyd-S9KS5i47GYkyTFChd6l51glNJmFFN3WE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqP0tsWKZIJIw_Td8060d4D4bPjooGTsL7pmS8XcHv_A&oe=69A97932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb-tzCn8YDwQ7kNvwFCB-Ak&_nc_oc=AdlT10zu9ArkyQw_kwGhnSPlHvoKjP3fimoEmySZJtOljGWpfRMMIFZ238fxig1gWmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvxqb183xAnOXty7MqMB5cbJ27jBUQucXOIgQmL4YttvQ&oe=69A9692F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
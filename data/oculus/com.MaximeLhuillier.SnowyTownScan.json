scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LVP3oGWWGkQ7kNvwH9xZWw&_nc_oc=Adox4faKU1Dglnba9eLgty8MJQe3GcyQSYeKEbYztEaTpgq6XrkCfjLHFfTr5qUopfg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pGQqHwVMXEAaBzvu81EBz7xK8gqUUOCjGfiE4QF5iuw&oe=6A2FF34C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X60AeMRuKKMQ7kNvwGulonE&_nc_oc=Adpkdq2gLEXI2h5DQ2JKkZPnv25EJTjtifKAEKsdWOLkN59QvTqJP0ru9wqJajmCs4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zdpE6TQzr39z3_CYcHJzIRMCyv4oMjNqCD1lC-PjKXw&oe=6A3009D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdMvMRtTG2gQ7kNvwFk32og&_nc_oc=AdrHS2Fbqgebrk3RvrBAi2L3uLxiqDvV7sSaBNOrdZUu7-_MmM3Jw0corm70GnLC8-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HVEO9xAir9dXiDvRD-pDPo5R6ZBs7VXu8_AMihiSYUg&oe=6A300D91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-NHGcIKWF4Q7kNvwEnO27O&_nc_oc=Ado2P_2muj2Ffstz5qP5MxTAvgMZOOFtAb_EqNfUoUo7VKGciaLDt-dgBq9ebsFz33M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IbmANQvAx35duXw2PaUdMluLR5wMQz7Fkma_VB3dJQQ&oe=6A2FF232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72G0NI0hlFYQ7kNvwHGNo7y&_nc_oc=AdoHic2clxMg2fI2xx3B8mSH73KiPmJJfrWF74O-joCVSmer0_I1bc5wUVRNHEQ27yo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TRMXTNI6oQ-yb87o8rPHqy3tU3sh8_aFkc1FYk93EqA&oe=6A301A6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
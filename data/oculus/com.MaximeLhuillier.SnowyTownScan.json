b=1-7&_nc_sid=6e7a0a&_nc_ohc=1LP6EI_c450Q7kNvwH90H4u&_nc_oc=AdnFzI99nY7uChbJNVGnHRytN6ZXWMbbec5EEmIfawSis1QfAsvfQwlkfDzWhslYVDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNOSTOgDlfWdVQSbNj6gfS9rnsQ81_jg6BZHWqV9PrzA&oe=69B557CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1EXzIGEFmcQ7kNvwHFzWLn&_nc_oc=AdnjfKi5BWDHoN9YbQVhqPK2VOBwR3BBMV2j1skLkWxsJjy5hImlklUeEXuHk7nLRkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC4cseG6V_p7oY9JSuB8MJcCwoNr3zb8MAbt8y3TDdBQ&oe=69B56E53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zSHb6cqIIQQ7kNvwGmwuYN&_nc_oc=Adm6oiEj_ktOfS24D6TD45-nfEoIRXQlsAIYFpmcjjwTBQkJE7uLkckhiV658HM8a_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzfoh85TVmoQeUNzx-jhh7E1mzZiTsroQXPBAA2lJwEoA&oe=69B539D1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXXN64jcGecQ7kNvwFuOV4i&_nc_oc=Adm3hJohJz5mS6Rn9cgwRa-vSwb8IjaYS1TZ3FW6r8fSPzjHlNeYmZraE7Wp0s-Udk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCy6jfyP-dYsWSv7D71kusIUtflZDzRxkXhnWbprNEjg&oe=69B556B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghXWSl4WlWsQ7kNvwG5k_kp&_nc_oc=AdloNKRhHjTtjDBgOt9KMlmpvZMIBmaxTH2H-4mX08B-er8iJvSUmy5Pi_Za1jRqQeE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfykzxVRok3MEDCHy5ct0DhG_452lkV7CkYi8wVGzqchsw&oe=69B546AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9FeuJAaUzYQ7kNvwHJWM-L&_nc_oc=Adq0pkjJOJA8SsBD-m3LhCNIE8oSELacvmhPqb7BOjc3PpDgA9U1HY-5hLtIQT7ZxTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o24u6TMSwkFQpZSO6_Fp4mWVQF8Uixmse_0o3Zmwcyg&oe=6A0DAC4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swivlc-O7mYQ7kNvwHXe-A-&_nc_oc=Adqv1jZrECPrcUKtYOlbPI7uuGJB460oHhFfLe2Eu_GsHWgvsYxWrV7k6Av9ePkjAQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oegZaAJFV5yKHrOlHIga3Ogwzhl1OOnLMxN5JoFmFKQ&oe=6A0DC2D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPLvGtwDC7QQ7kNvwE_mDBC&_nc_oc=Adp84UdffGRHx1J_q9V8zugSe_DkAyrFxha4FZ-4OZ3Fj_HRIhjTLkZyE6VpRrzm7yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nvGdihN0AY9Zie8nI4b8WdyNKKdUrQTIHe_ne41h5KA&oe=6A0DC691"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZU18BpM5XAQ7kNvwHaTQKe&_nc_oc=AdpVsDUhhTIwTxKXPWaO50sYaiflccYX9sm-KBNnfRypVnwb3aryo4cYhcIY_NvnFII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wz3DEP93GU-vvU4omhyhsoS5NyHkL6QlftzeWvw46lQ&oe=6A0DAB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBCcZhqlaZ4Q7kNvwEpXMtx&_nc_oc=AdqCUzKngdM15WrC-jgVKDGtIPboFx1D3H3sUFtM6iNS8USeCQl5W_-qXoJ0HdnGz34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J41_3lVbdCLzCns_6lUPFNUzye_PyKVJ63Rn9135AlQ&oe=6A0DD36F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
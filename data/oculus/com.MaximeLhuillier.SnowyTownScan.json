scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7kcfSU49boQ7kNvwGU2QtL&_nc_oc=AdpXTFmEHyxJsguD0I9SKP9zS99gR2B-JwFFmCE7cnM7X5AZUcqXci1X-VWpzK3_lR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q7I1xvE956utRxerqeu_rULVfQAysP-G52T-TyfwwRw&oe=6A1ECFCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnqU3gYFzNIQ7kNvwFwe7Eo&_nc_oc=AdoGyWNfMI98nD64PCb0OoizpEOcjs2jVjwowjkF6MCavWVmVU4xiYf_9_6pnhlSKjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZDYmdDcuIVWwU8bcLB0QKN_BC3HtPRJUjbbUcYb3GQQ&oe=6A1EE653"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhCCmWU0QkQQ7kNvwEDZ5ZW&_nc_oc=Adp2Q0vaK1wLSn8sh3uobaZIY2fK-lB65UutetwCUFqFLefTQe8ldsHyDxEVmABGi3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZzuGI6fprCBdj9mekITTRobGS7JqW0Zk-DkG3SMh8XA&oe=6A1EEA11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC8iQbJw5okQ7kNvwFdxODa&_nc_oc=AdpBnz5dHZu76v5bhz0OkqyvTmWO-yM7KZW-ejyy0ZAqr0QecTjSQPNG_VwNsOBwAxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58vzntz7ZAOAhS46k_MClqMnFVPnOVzKCrsB-8I7-YBA&oe=6A1ECEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j-BtqfA_JAQ7kNvwE1zyU_&_nc_oc=Ado_z_-DEnny6xlgdZ1tMGSj2PWenRSPFAOE0Yh1KDZP-PSxKk7cVgzp7STqTT99wl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qU6jM1El-ZbqySvBkVHQbEtFN0BS-mcNDhM7xOEmt-w&oe=6A1EF6EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
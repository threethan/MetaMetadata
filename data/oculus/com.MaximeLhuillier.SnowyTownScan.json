scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDArvH6Alg0Q7kNvwE4Z-ly&_nc_oc=AdqnLjWWba0-yKqthRR9bCGJBW6Til5H15sYe0nFCokfNfvpMnauMkfSFHCjhJyQQcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzb9lRfz3GhDdmothh4L6OmR7xTb4SDXPBy69YJ97vng&oe=6AA548CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIzMVCCX7DUQ7kNvwFBI0bX&_nc_oc=AdrlyC3W-qtSYNRGZWfjxF-M8hRqEGpmAfCQF8-cmA_S0azVPHWr_fIQv0eeqmGENSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg1uxFG4LmcJoy6CG1Aj0A9MBZT8ejVQHvo26z2dRNmQ&oe=6AA55F53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOTOZNzPYXYQ7kNvwExf1Uy&_nc_oc=AdrXo-Sur1VCVC9Hmdj1yWqHypHT72eMdY1zTBP65hwqhZUIOz8wkkRrzET5Lw5I-W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbW5TuNGK79epODv8z8s0IeNnIfloAuJxStpIVZlKF9A&oe=6AA56311"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXqRVi-iTcAQ7kNvwE_KUNc&_nc_oc=AdrDi1mMG1yNQ3hrKiGe733Iwinkmwah7qvPDrDp1lce4l-Nr3bY3L2uolVInE7OFow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeNKK7dlPlAO7rRFgOw50zTOQvFUoMfhoHUb5BZl9J3A&oe=6AA547B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfH5S9Xyju8Q7kNvwFq8AP1&_nc_oc=AdqFOHKx3ze8Rbq5kNHzbRanoDkmw8xYPfc22r6gp-3KYzCpeBBqpCRLbLoyynuNGr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuiZRP6Pw2jbN8YVgRP3K81x3Nz0ILbu65iK7I6eQmxA&oe=6AA56FEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
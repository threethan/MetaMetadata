scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzcnTiaTFGkQ7kNvwEfwqQO&_nc_oc=AdpNUytKMCJE0PCeeXzNn2Ioi6O8jHf-amFuN0HGDW7M-WWvkP9Zc852JTvfs1FWFzM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgrrpGz9JqWy7jkcMU_W9aV1PWkahM3CB7MLO_SWJ6ig&oe=6ABBB24C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESK3cjdw6mUQ7kNvwE38k3R&_nc_oc=AdpUXspUNSBYLy6pdIUI876_zlNLAwKUh3NVYZolgzi6o9KAFdAhSv5bzXiE0RRpCXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdpEN5lVEl0X9dpa7Lak8c0JP9OEn3VlsJpfGTxQ2neg&oe=6ABBC8D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFEG_bVtaO8Q7kNvwEuT_RI&_nc_oc=AdqJm8n0JUhpochCQKyZ88EKblGLszxHekVPUSLOSpR69gAceLoToo08NP9NfoOfwdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCmZNPYVodghFL0BcSSumJkSw3vkQUwHqteIxMhecZUA&oe=6ABBCC91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9quv7_dnyrAQ7kNvwEFtUmI&_nc_oc=Adp3B7NGSV1DnxZHaVtg5unCGwN41-LNOca3-MtwWyoHMpCsHXoRt4EHC90pLOHzTL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4iS87Li6xTCBmyOhdHoQSepvIT2Tjv1Nj6fbal4Uexw&oe=6ABBB132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0HLjUtLAxQQ7kNvwGJzDSW&_nc_oc=AdpN3hMmqngDwH40TvoAPQuup9Uaj3ADkhC0Ej4oB1gFptrjyOP_rqb9rVLC8sQ3mC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhviBHkQjYxjWISsHZt5UN0SvOUvhdgekMyTUSg8Mrvg&oe=6ABBD96F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
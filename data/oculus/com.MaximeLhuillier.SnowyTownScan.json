scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS_q7B7RNXwQ7kNvwEdXFKl&_nc_oc=AdqoLoqz7gbej9F-DYozkvn8e7rwIedHmaWlHJ5wdYf-C_KJ1vZeTN7culxc8EOGobg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVKjdacvxR4OzJe6wD_gP66RNwQDEfYDPSiGhiTa9xHA&oe=6AAD31CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr1eXkyvU38Q7kNvwFNkNTq&_nc_oc=Adp79Fxk1xO7JQY7K6HP46mXyWeQWGBoP0CA7UtnJHqAb4ekDrgJbnn0YC6CJd_zpmk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPLcHDjsHci6WWjMadVrCd1bl7VTWy89rGmGvcs-6TBQ&oe=6AAD4853"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThQalIewZfMQ7kNvwF5v-fE&_nc_oc=Ado5u0TK_2k65uuk3i9yyY8wByPVUXxwI7R-kvyyHcp7d5urVxgr0EZBLq5GPVaPveg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPIw4IAc538sSC-zxIWTZ5GDuZOG9o57d_gJUw0_0S-A&oe=6AAD4C11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIVlp0UCeSYQ7kNvwESqha1&_nc_oc=Ado6FHAmsodeUHfXmi5DNzPiDYDwhgxXPDgOcglVLMyyQYzuK-UIepJtPi-svptJbVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1ZNbxX2pvb9OVJEeReMPrzxM_KvodqURaE5sKR3lXUQ&oe=6AAD30B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KyhM5mnsSgQ7kNvwF6h9_-&_nc_oc=AdroMxVvqFblMS0wCKaN6VQcbCO1mhlTKTpbEyzA7M0KJNT_NqM8Dln2XVNlePSQZ2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsfFmAQUkbh80sqO_QPaxIQYNa-uzfXcS533iYyuOOgw&oe=6AAD58EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQq4hIAh9X4Q7kNvwE4wRDs&_nc_oc=Adq-75UWGzI9vWOVvsCd_P3M6uvLPXcNMzqjykmr0W9FhwYoaCeGfnXCvB3WKqB0VIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cHrukoiskwo8PgMrqPby8bcNKjew6Yrw9BeESbwcm_w&oe=69D64D4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJsF0TvYUYEQ7kNvwG1s-kL&_nc_oc=Adr1WYeQ1a6TlF5oyhX5xjaHj2jqyAdq9PK6yY73rIY0b-rIfmIs4WWzbx06d4g--Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N5mskNwAtAzbW62VVMsUH1-EOZcJDfioePufsGx47ag&oe=69D663D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3-D66Fgo5QQ7kNvwFveZEM&_nc_oc=AdrkuL0WW-MUuKa3JHE7ZedKBFk0AjU1hHLxEuze22BnzDvq4iGVSnvmq1AFauVsZpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Yf2qQjCiLILIJZvE4P4W4NGLK9s3edpXUaa0jC5wybg&oe=69D66791"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNi2tqbaAvIQ7kNvwGQ3Khb&_nc_oc=AdojCarjDIbhFW3hpg1Pwqn-KF_h-SkOnKT-MIBKcWClIMTv0qoDN0Pp4zJ4x_Fnm6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38sP80Uy2E7UtJha4FLBqjsE_Ku85F5s6AXiFDQzS39A&oe=69D64C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcfQ0vL2DRoQ7kNvwGTcfXV&_nc_oc=AdoNDN653WuOteT4xzExksCgtcdmkPzaJ394oohPaqau-eA3MamKAPG5646rHWKf30U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hll15PVGEWWEwcTF7gIeKky9JIeBM7XGcjIguriULcQ&oe=69D63C2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
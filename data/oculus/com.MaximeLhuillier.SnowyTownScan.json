b=1-7&_nc_sid=6e7a0a&_nc_ohc=pfTf0XN4PYIQ7kNvwE_nG1_&_nc_oc=Adncbi5eZUltiHFoaKTYY5EcKwHifJ9AcDL7T3u-F4taKPqiWnNt7fdFdjCOqiz3H7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxldabn-7Ye_fGDKwLWd-dtKszuJ_WqsZcnqz41PGYHDg&oe=69B011CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEePqRVoT84Q7kNvwE0Qe1v&_nc_oc=AdlckgVgDIrU9p3macbUSsKyLyZw_IfmRi7a8cDbgjGdAmAW7PM1CH80DnxTMl2e1zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4C-Tpn0XgNbw8bJz_uPC28ILzo9D_eNh8bkyyoDUGWQ&oe=69B02853"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u_6AdMlx8EQ7kNvwGFtg7E&_nc_oc=AdnUvuX47K4HRmSFukF3_cghGZlEFh4RV5GjdN-QfChHxhPku202zcF63d3aT69cXrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVMSONxIsSOmE65VeHl1rq7oX5HWD8335U0mN0Y9ckSA&oe=69B02C11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ6rqx92V8MQ7kNvwF6aH6x&_nc_oc=AdlJTjoYm6bQpV3x12LwGUBaT2Z27vabRoqx63E3vQAvUk-HWJBxLra35Rra8G0Q5Bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzGH_XRpDU9oukqaH7T1vdYSSWZiUz-UqtSAEw2QtB6A&oe=69B010B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5jnyJmNjM8Q7kNvwFCpH60&_nc_oc=AdlMvcYMbijez1LTgnYfF8KjLBGNq9goymjxQUgIUz5mj2jTBWjbWcFAUz0qBILR5uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0mrWIB8_UIArYLooIlEGk54jKx5KKwku-8a2JupCitA&oe=69B000AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q50zLy_hR6oQ7kNvwHry4hE&_nc_oc=AdoGH8exhaC2rTdjosCd0vg27DG9pGPln7vYP5OzYcxlpIzqSGu-DywB69Xl9GujDrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ5juWD6UGgREKaqGDkjQzdk3NN8DVZkIqAWIQZ_funA&oe=6A8C3C4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7rMvRNe1I4Q7kNvwF5L4Bk&_nc_oc=Adqk7pRyuaCjuh6Kk4p5OYOPLuwBJ_huNZj72v9sVo7bz-cUSSzu47dHRxSFfD5n6os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbb1wBe6jSg8oQeNz7_eoG1UGXph44uNhNnKR4PXb5Zw&oe=6A8C1A93"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EirLIe-ol1UQ7kNvwE5n-c3&_nc_oc=Adr31ShcAeBxqfgXGRscoRbAJ_0cABh_DFgNL_bhw6jA-IyNdYmw7EP5R95gmpMrWVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGma8qYQaiTEODg5oCSxjF82H6M3kRFNwNwDTqxJgoFxg&oe=6A8C1E51"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lljXsmb9BgUQ7kNvwHH5ZbA&_nc_oc=AdouncvwxTQvWkeW_GZgaURbVvoXwPPF6fjVNmbCjT5Lp8Y550pYwy_zbfswFHrI84g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdJQLQG36obw88lh_X6UdnEpWoqWfx5E9mfw-O7NbdwQ&oe=6A8C3B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdIr02dO8dQQ7kNvwG6B522&_nc_oc=AdpR6ujF6U_BcA0Y6EKQDzdUl56HeJDGTDtxYiNAd0jHHgHIpdbE2HnUDbfFDHtALJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYhIXZD4tYvy8c8yPN8qv1q4VGz7cIrif9Dib6d33JgA&oe=6A8C2B2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
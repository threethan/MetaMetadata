scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2nZ5lMWKkYQ7kNvwFqQJra&_nc_oc=Adq4g5RbF0PBsSujt06WQ9Cg1GYnAT3TeMNueUFleovGmtWYp2t0VfrdMWGycBg0g4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8SR455KJF9pIEJpxQqL7sSshBcU5mn27tbWa9ZBqoBA&oe=6AE5E24C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i42TIBexXnwQ7kNvwHnGjQO&_nc_oc=AdramFLksNVMIFSsLqNMSVyfHm8Eh2KOWE6Hr_EdNcNLLOEEc9yPpB5s3cZfzwsH39I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlUznJYEGoGwRBLvuU__pVp8MhJbqQYfE24jugvuF54w&oe=6AE5F8D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmKZII93aAYQ7kNvwG-4Qjm&_nc_oc=Ado3uIsyR6y5i4juJfJVnaCqf-A8Pk-4ir67gU2vY-oWZUv9ZZaKtkwqH7V7-_uDudo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpz5bTiGHt9hb9AVrT--C4fJrLulsHG-WkdFNKmpIHVg&oe=6AE5FC91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76A0KoyDalQQ7kNvwF-dS8g&_nc_oc=Adp3lK8vDngu7FwLADt0978KAmnejh1uJMSjLCz9R_Zl2pPeIT-f1ciWdl7dV346SQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLNOtpJL07GAz68bO6Keo9abRUD93r4sfK0lY--3sNXQ&oe=6AE61972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjMJmED-VusQ7kNvwEk7ih5&_nc_oc=Adq_qKdXBD_0LlwSxcoGj2pOL_EE3NSynOQQSoQgnHgOWe41Cd5uIHOeYn-bilpx9Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdjIfgPyX7ftnz1qaei92wbp-9XcpyMt5h8fLqEfA2iA&oe=6AE6096F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
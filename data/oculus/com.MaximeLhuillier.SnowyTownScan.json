/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDArvH6Alg0Q7kNvwEsE1cK&_nc_oc=Adp1Q_heLK5xQzjQxJET7fjM_aRmOONvZkzf8SeChSMxjoWEbq-8VcArXVtaZKLgvCM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjoSY-MOzgMBVPEqySAaUuAKVbD27xg1aPetBaRHRKTg&oe=6AA3F74C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIzMVCCX7DUQ7kNvwHl3LDl&_nc_oc=AdpcrqMJsEcVHKQC2px9brsaFUSMvDJdiQUSU-IB6dKq6qDfeXekWrdqNbuUEP2eDhE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIccOthdPNoabzXccroobffw4ZRmcbYynjA1twSn6VYpg&oe=6AA40DD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpzskrLyXAIQ7kNvwEw7F8E&_nc_oc=AdpiWyUFC1rYl3NdYEzisyG9eW2Sg2lZOqHB6ao4gOIYYRjTXLV9vlxC03f99A49PoA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbke5A_o9uy4HSwJ9VQQOvFSKWRec0EyCvNkZFoWbtOg&oe=6AA41191"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h2K2BnJvdoQ7kNvwHDM-y2&_nc_oc=AdoJiFRww6cs3zxArvVQvTAV3XZ3Tzwb0HpZtq5bfRM9dWZReuEdyL0dCt8cOtRnQgQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsIWFnKv3YOIdsQ3yaXIWcKoeem5OuEfEmvtycz95y8A&oe=6AA3F632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pu7WRbAb54Q7kNvwEeryIv&_nc_oc=AdqdLol6h4Xx0HyfCI_0cVgMCUkhgFz1xkpmCvAKb89qucDOUV-ggRRgsc1t_Fp1AlI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5U5cNxK2X3Zq3T52flwzUszSzEswUrRCZaLzLjRlVzA&oe=6AA41E6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb-V0jTwzgEQ7kNvwFE0leR&_nc_oc=AdrO-X0VlcQJIC03WJtxejU1o1M7pZAMJ3RN-yg1KnAb4j4KAqPAxSgc8XogSE5ZvmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThh0FXy_tYaDy8wSdLDTmenFG9utoMATUhqMjBgJ1S9w&oe=6AF5EC8C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ2PxsclF4kQ7kNvwHDxGGo&_nc_oc=AdqbFgo8G7j3R1WqBHgDCRmjnmcISpD06FKr3J_OhFi7R9vuPjQmfPcZoQby9oWLOKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQARu0Dvz9vCgaMv1a3tqhgWxRzLArGsJ9kLF0YaRwWjg&oe=6AF5CAD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaYaf9NurjQQ7kNvwH3E721&_nc_oc=AdpdxRErt3S5dNksI-dj72zEvDeV0Mogu6Y6qK6MwLSAI0FFjs78f6SoT1Eq8vcKuEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1_r47NHYZZVHktqVs6Ve6uBJWbVkizcqt2_p7xrfK6Q&oe=6AF5CE91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UWQaNyjV_gQ7kNvwEHB1u6&_nc_oc=AdoZt3o0mUmrwqaC_Y7mdqmsDnxn-uTEyNj4QD2L-5d8_DhmBRCOvepvxToeee0PMEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREScQViSyj8-ALWIYSbFhD_de90qwh6SD3B3rmf7L2aA&oe=6AF5EB72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTdERkAQFhYQ7kNvwGjhpRs&_nc_oc=Adoz2GtvZI1ZS0fvEgoAfV0EMFCWos-Fk8dOuvMAufB693F2Un_qkWE10bXFe-JRS14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAjcKOpioyl8MI182k4zAK5IbeBnxGm1gZd7uFnqPyDg&oe=6AF5DB6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
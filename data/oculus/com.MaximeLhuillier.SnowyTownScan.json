scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4yJMMnbNu8Q7kNvwGHSbkH&_nc_oc=AdphV-n-yKOQvvqPe2ekNo2QKxIbJOt3FXfnQ9lf4ubUe4I20ZvtcR9YR97NNhSh5lI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51xqE8m7OY41TBQETHPpHs0Si6P-VEmGRY0HAeqp50jg&oe=6A16E6CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk1lIlUlV1QQ7kNvwFxDBBM&_nc_oc=AdoLH7e13QX0LpJd0tEIa647hgFE8przJ0I5_E8kzPfLrFwbjwi38xJQXRSWM5j_uDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QGX9AScxkkHiEHYo21GRk2EwvuJDgD3lpige4kF_4jw&oe=6A16FD53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wnJ5RBpbtkQ7kNvwHpz9Ef&_nc_oc=Adqkm7ZwMiEiDALUYQ0r61h_lw8G-yMculXde6Zqw4i1lXhG7qdXq4MNmuVFyCALnWQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41n_rvYfrjqA1CijBrnw8U7M4CKwUmfmJT1jwqwCyvkQ&oe=6A170111"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6suyN1SrHUQ7kNvwEY9mu4&_nc_oc=AdrKWirMYrCK4PMmEsmQGE5lzs3IMqgs3nZ0Oay9rhevQlJlRG7n547DF7WuM3W9X7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n78z0OCM5h5V36bz7glZbaU6vPQza-NnLYP5yZGLcTA&oe=6A16E5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bimsolku1UQ7kNvwEephpL&_nc_oc=AdoVjJcq60c0QsfOgCZ65chYGa7L7mXP8cnriJ6-H2-_bfqio2HuI_3O84IPGx4gmiw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w2te8TtgjoTPeRMYGSlWud4YFz_8PjzsGLHzInhRZhA&oe=6A170DEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
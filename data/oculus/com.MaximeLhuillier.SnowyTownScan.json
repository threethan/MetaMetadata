scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZAKL_N6qCgQ7kNvwEXtd3p&_nc_oc=Adqrw9xVMilm1QReK7OIiSogLdMTUc9Lk7AmEyPjSZek1EJgS0gBHYUYv55odDjZYlo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9YlzNOLLd17FThpZeMzujwEsgKdFpIbhzaSOCzMWUHw&oe=6AEB608C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzsSXx_d9HQQ7kNvwFYXLAY&_nc_oc=AdpRqPvdo1II2gFcPDdCfnyFujbWeuon_cAElHfVHeaf1Y-DTbkvHoQogA8-qbno1Do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT26n66fNDOwvSa974dYkc5gqOuR5Q5iO7FqHa7MmVChQ&oe=6AEB3ED3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qijsn9lnTxAQ7kNvwENTSBC&_nc_oc=AdqNPjbN97_9s1ho38LrY1BDgrc9Z6zhL6emUg_Y3LpJQ0cpEIcLIAPizVR1dah5taA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQHghwgwoYO4xcPMqyVSLzL0ZA85JFhYygv8W9q_2mNQ&oe=6AEB4291"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVT93kJB3TEQ7kNvwHq6by2&_nc_oc=Adp2FelDAjY346LYXfJb3omzTTyzMO5ko2hYCyE7wozC-KPRFwVYxULytIRoWBU2L0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOKEXjyAYVvdr8uejCAGCVzw6PJ0QpRqTj2tsYGX3-1w&oe=6AEB5F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2mUjnaK1_YQ7kNvwE_vIeV&_nc_oc=AdqMfNGQt7yGFFGDlTeLIilfT7I-iNrjsWNUFrTbGm58T_3sCTb2u6wcsleUByNQs3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-xLgAD0uyKAAEDSB2Ud2dbGiIuNW0HzJ77Q8xY7X-cw&oe=6AEB4F6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
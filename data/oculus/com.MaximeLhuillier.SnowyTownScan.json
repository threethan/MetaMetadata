scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XJbKpn4w2UQ7kNvwHqH46V&_nc_oc=AdoJCx1hXQdg9FoZuywROa8Xjn0lJ2FbIQGe5OL4irzdIh6o-5NczGRCs1iqjJ0GYWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eFKB3qVvUJDtFweAMXtJKaaNWP_bPoWoL9tBf-WIzVQ&oe=6A26B8CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxfvjIh6t7wQ7kNvwHM-YKT&_nc_oc=AdpEr3ExCFaloWYymyQMDwFg2oe4P-n-6JasVg1yT2AENsTj5fxBXPGwG9GeM7ggb5A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af968zwuBTMlnAQLWR6QoPw86fMHYYjfH1bFnHlWbK5jaw&oe=6A26CF53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azO2rOV48koQ7kNvwENOMbb&_nc_oc=AdoY5_g4ebyQkptj-otuMBPjhr6haJAu91bg57FwkGkpDAr81SULKOB9rK1ZWSJVJ_w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97XrTQY_wklRPCidrEHOZDkKOfGZRcDpFWnMx1kBifgQ&oe=6A26D311"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG6BVm8n8XYQ7kNvwHGsKLE&_nc_oc=Ado9z8U8bvZ--AUDK2PXZ-sTFq7IIGCf6R59EFNOnXUxkQ8IAMKC88hm1pmZJKYu36A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wO2i8b8OVkuF439sYp22TutkjWvx_0Su0D4Fu1MlKww&oe=6A26B7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX_CPimezAoQ7kNvwF8usD0&_nc_oc=Ado3SCjB0yZDwm6U2J796z7pxYSbL2vZ3LTgLRgUodlaT35h5loQj6HV8ReR6GJIERg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OQAgnXwgyszlvFiwtnTSXKsqxhM-u6_Qw90Uza3S7HQ&oe=6A26DFEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
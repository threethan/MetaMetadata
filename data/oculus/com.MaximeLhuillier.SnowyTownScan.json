scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQq4hIAh9X4Q7kNvwGYeF-b&_nc_oc=Adr0exJhvnKEqzJQqjcLxJXekWfVbONDBbc6rIYC1dcR3Byp7MzrHFZM3zvaBBI1MkY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WttH_76-VMiNmCuIgAxqwYBZGsAufgGToqMT0_19-WA&oe=69D79ECC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJsF0TvYUYEQ7kNvwG44BxW&_nc_oc=Adplpbo8qVkjzfTzzQsAe0qFeuRlu9SIq_RnFWpHpzdvoOUOXZVgfxhrX47QyiyRx1k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ONnqwqD2exUHStLh1ZncknANlLRcqkDsz9o7F7H_-xw&oe=69D7B553"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EarGtHP8-rwQ7kNvwGpu-jt&_nc_oc=AdovoZoeNlTmB6O6xa51qT8jEM9HWZWPZlmjmS3lbAomUxeBislPfMiJgUi0pjaiF8c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aYj1g51vH7Y8P_zB8ZBDsowUnX-bifoW9xy_PVTIFPw&oe=69D7B911"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTeJ6q1TwgsQ7kNvwEAdSUn&_nc_oc=AdpDE1JZ_dzLyXzSlWko-s_FKH5APE8Bgso9iP58Qguomvv95qkRNquNolxqnBkMTYo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ibOAL82I0WLDdFFsJ2gexrn3RyfhMXnLQ3dqDblITNw&oe=69D79DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etYV-fRCwy8Q7kNvwGdvOC3&_nc_oc=AdpVkIaYi2t8dpQz4t29rFdAcURNSgRBQZ4b8Syl34yKIf8-vqjvpbGRpqlWBGl2x9M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xyPuoVLlxqByWla70S8mwKgGVkhrNq897yU-y0o8RuQ&oe=69D78DAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
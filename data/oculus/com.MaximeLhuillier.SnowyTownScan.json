scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VogtN3dCgEMQ7kNvwEdyg6G&_nc_oc=Adr1JIQuSLRwztu6_1EAm4LmVp99_u4cWNNMA37x8ICT1g8JCsvFU_1S0hqYQCpaVJg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnQqoboddNagkqqkQGFIMqqgrwown-sKuIrqktKK6Mpg&oe=6A81B04C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSgMTHuhKHIQ7kNvwHPIuc_&_nc_oc=Adq-UUTeLPafMmhQKDRJjYu1ccncqKvJNhkKoHGEoqmF6G-RH4rcG25IdxPKTDXrUKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIG5LwNzk6kXDunx1SK02xddJxcREFi_twm-TtpDwHNw&oe=6A81C6D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDO6AIvZcKMQ7kNvwFocX-b&_nc_oc=AdoWPN8k7lCuHFtiJkuOw1L_zYMkOdVUDUrGHqvwFza1VPleSstzYFZ4E7NszN2Y6Tw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO-o6KWqBHpKKcwVbyPwWnrTCDC_jL4pc1aXx3NXXwww&oe=6A819251"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCJWkbCR3U4Q7kNvwH45c8l&_nc_oc=Adpf4-H5qh48gf6cUZc_ejFfeNksL43nhCfipitukrtwoPcUUJQCq1knF9Kcgh9VKZg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMOmPJ9eOWi8b0m9g5A5xOYF8vOmTEZEESbI2nSNSkHA&oe=6A81AF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd0J3htJ19kQ7kNvwGYXdBe&_nc_oc=Adq1oBtgQrViuRTmPC3Ftltwt08nJrUANeYN0fK-ETML4WXV5IBcSnv_2pIDlPQ7Ezw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhlhlINJss5L6RZhVnBYTnUiZ8s3fy4ZaW_tLbG8CZdQ&oe=6A819F2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH0H-x6jvFUQ7kNvwHmp4Cu&_nc_oc=AdoXa1C4JxpJp6ZtULOd_4osNUE_X9zhrS4Lv_U2eB_Xi_hrT9HhhMXJJ_ACcbINN2U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fJvM_NFLZ3MgGBIouLPRTZmBJXceS75_v5qkqgzFX4g&oe=6A2BFECC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS_-8NZH0bAQ7kNvwGL8dMV&_nc_oc=AdoJcjBW333dkJbE0U46nVwUQYw_Eu4SHefuX6QM9Q4-i8z-TBL31ZUflniPRMEtUY8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o8xbLn9ReVPKPtFy8AsYq3o_Zh-I6Ka-xhJHdRdrGTg&oe=6A2C1553"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=654mJl41SQYQ7kNvwH0KINR&_nc_oc=AdoCTBsR3dHiyRXOtkn3001Sk6xMrIcViN2GxfSTayA-66I5-XfghGSz6vJ5-e5a_ZU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W9FKCxo1A7bckdC_T1460D_SEOJph-pXrzOjbcjsc2g&oe=6A2C1911"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyRwpzx9LuIQ7kNvwF5CY57&_nc_oc=AdqEGM-fqSbdAIHyV4fFeEOdS6Jc04DyZM0AtbQgWZPD1ub5aenPvBMmy0WZRP3sQdY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2wSn3LmcshjeigUyED6e609hAe2cIOlTSH4AGkdjZIA&oe=6A2C35F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOVveCiR_i0Q7kNvwHTS2Mr&_nc_oc=Adq7FPpj95gP_s-XYs-XABnUGJFoz34-bgEijrBpW8qoxwekYCmIsDD5uI_QzijGCTQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZA2l87--4z9WKb25FFwNvbv0ZVbkEGAxYKyNey0NebQ&oe=6A2C25EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
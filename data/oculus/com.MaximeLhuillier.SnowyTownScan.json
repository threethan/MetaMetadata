scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpKpq5hUpCIQ7kNvwHoXZlz&_nc_oc=AdrG_nyNnIH16j5IDe8f7qsFajmCBAJSuugMPwPhf_FQ6m_s4yoMOif6-AEP-V30ngE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4R1Wr86a2DASBYLsFAe9Y_q2rx9BgsBq0IerZt9limg&oe=6A4A514C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLH9JJvwqR0Q7kNvwGc7Szh&_nc_oc=AdqoXphvImuQr_O37R1ax8weMSjY_xVPHCXUxvNOySIMncVbEdvhq8gy6a5Fdbe7hdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG_HxLW1yolbLMG-mwpZoruYMf8QvT0_xTeHumKVD39w&oe=6A4A67D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUeJF2jMxZ4Q7kNvwG5VVYN&_nc_oc=AdpZkTNLmA3AeaaxDXZwtSc33T4GLAzyvFRiloBGmxf6VMH5F68-nEwgsiWBEH-AsNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9z9oK4-h6CbAqBg1K9awoMmfIqorbkzDRBVQe-tF96A&oe=6A4A6B91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXDp8wrbXkoQ7kNvwE1CZGr&_nc_oc=AdpGbAgu4_cGM_1mG7vVfpBCqUXzIXPO-MS_V2F1594H5mNQ7mEdKXvuaeFL28le38o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3OqqffIgPLEdiH9syU-Im_RufIl2jClw8nLXO3a4FQA&oe=6A4A5032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqIeRxcAiF8Q7kNvwFX0v6h&_nc_oc=AdqsC0qZg_egqtvRxxcKMujT0SVCKz-cxaSulKMMYxvsljodL40eghQgJ_SumDEKPNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2zw8zto2f14qdu7_5qYJQUiZb01pmMqGjQ97B110RUQ&oe=6A4A786F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
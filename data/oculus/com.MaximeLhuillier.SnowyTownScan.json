scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QsHoKBuCogQ7kNvwHVQc6O&_nc_oc=AdoTAFgK-cnpLIV6ZyC6N6ryKEPK8nGk6fy4hRil1szqeuvr9oq6FDiz7LCcUS2QAGw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7D77bg5JY2XYXWjyWJ_hJv5syGJF6NZ1VY2dEA496VQ&oe=6A9738CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzL4JSiQaQIQ7kNvwHg6SM0&_nc_oc=AdoltKf6GQiiQNeTa9NQEqF1jMfdjmFLnOaTbPSSdJUzJw2c5JMUyXN-33V1ZXYs4PA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOhgMA3h2ffac6gKeMIhGX3rVoO1NrH5sU9tnFIh80ow&oe=6A974F53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mvlsiF8egoQ7kNvwFm_euZ&_nc_oc=AdpS8hrIuR_l9Szo21Xh9QOA2WgUNwvdGna6kASlkzaQyMbpQk7C_qBDwFsahHtecd0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI5kGpPOaDG_IaaVgJV2JhY9c5QQg9tQvrvnNLOP0Zig&oe=6A975311"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfNQkO24FIEQ7kNvwHfmeEf&_nc_oc=Adrl4FbxIRLmgj1wYlrewmM92hMdv1GRWtBKS5-JINg0--EksMhJ9Qk3zsQNn3QDCGQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVMu5WPs9OKnf_kKX5-yqfa4EO-hA1bkqzYEFyKmqdPw&oe=6A9737B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f8cydGO47oQ7kNvwG9-K6g&_nc_oc=Adq5hNaarN4IGjm7aOW69Be2DLlZmrfQRblb-p4x-5rMfgOUITAUz2YiPkluBEin1Cw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMnaoa1Sj2PYtgNPIwc-TTCCKo_TEsy_C1Fq-3KkZa-A&oe=6A9727AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
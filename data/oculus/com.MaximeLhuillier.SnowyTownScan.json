scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n_kZCy3P84Q7kNvwENZiBD&_nc_oc=Adq_T6TiGnwGBsbDpmx4xHzpXQUgzdDXfL_tOcl0hshr6cdIxJEPRU9RCi-gnzcuV9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VFWZF0rrlQJhEmnS0hjCf2Gva8YEoyBiydloKeUpsgg&oe=69EB654C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moN-CdeT7QoQ7kNvwHW5zDy&_nc_oc=AdriV1ij0pKJlPLiyarybimeY_9vmf_32l0d21wz0u2fvudioHr0c9yl6S3jZMrjzf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2muJ9_zqkJlrKPojAKc-cPfgv_qvlvITCbd7oKwWK1eA&oe=69EB7BD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOd2SFU8XxMQ7kNvwEvNWCh&_nc_oc=AdoB5AUZfwyDI3Oc-6G9M_UDa1kQpK8KjwxRFL-sQ2Xb_EAId8z4xwhII6JTGtz6E90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FFhijkh6vimWymVbJffdVSqdsg2IdD7BuBQbgBBvmHA&oe=69EB7F91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMI5ylvODD4Q7kNvwGk95ds&_nc_oc=Adrsf-D3x-KYBEMNakg4ThjBJpiIyrg69Y3IGLSviPiVgXUuNMPMPFD5Ukw60rmqMS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00ojHs3teaF_E4-vw_fd4nKGbdlEeiHIWXp_8IqcGgGg&oe=69EB6432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tASHAUX8HVIQ7kNvwEKPCg0&_nc_oc=Adqw7pH5HmMB7V2JotOJp7oS44HcgLyt_rbaze_U7dzuL07gSwyELTZ-SbwSPnvnnK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o7Sp4t6bK8ICQ9i6NTHsHQ16KIH16a5Q2g3SIXI7CCw&oe=69EB8C6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
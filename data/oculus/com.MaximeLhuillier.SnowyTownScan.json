scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a0fSDXJZ4gQ7kNvwGEySYr&_nc_oc=AdoqlhFDYNxc2Xr6LuhJ7YhkkIJ7GILjlJ1u7MUXL0mYNXmec9YNpSaHGN2EeGaNHb0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zNSGeky5vhAQwfq8SNi-CguWy_IECu3-V2EKUBomGGg&oe=69F34E4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGw6XrP_CqcQ7kNvwEaS899&_nc_oc=AdrkSa7zsd5AcNERb0B8_0qIE71TH-CThQ92NbotaYz-exOhkdfACezvSe25TNUB66U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kMVaaSm4xzzg_D86kQytRsbr3529a2W7dlS8gPLo4og&oe=69F364D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sXgaQdEXG0Q7kNvwFsu3e0&_nc_oc=AdrYbuyKA_7AWDKE21fB8XYAJkPJGHSBVvMhknu6fGwBlmUMoMwIhcPq1blnl-8XXjQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vldOzR25Ry3QrhTajnTgQZLU7u1_NfFLdm5UgdVf7Ag&oe=69F36891"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTB93ogHMjUQ7kNvwEoEAJf&_nc_oc=AdpbjbDGsOR-WryRG8kQkvOOzI-76F1Oq5hxnZlETUvtvRHx_96q9gmGp_c0SuS_jAY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HXI-mWS5Tz0JS_eFSvnLijB43i9FcWexez7Rgv1M_aQ&oe=69F34D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfiJvg_LmtMQ7kNvwHr7sJQ&_nc_oc=AdpK6sxxQRQoRq0ztggXFA9ASlh-eU3vK5zBAT2RSWhSfTw5kME7xKIMxGaB4qbTVuk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rbekPzDCfi0j3cQRRzgjca8_bWAvHAVyTDyuldzzQdg&oe=69F3756F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
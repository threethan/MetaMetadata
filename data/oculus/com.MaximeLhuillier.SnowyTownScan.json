scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j29JbAIPwt0Q7kNvwHU6wS3&_nc_oc=Adpu2mxqnVm1nOY6fLdu4DhCa7r3HHdMHEC_S-73abn7otQ2ryG0i6WTvTpSyBNJsNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cAFs8jkZKwaPbA8JHt8aB_8UUz0sX8qVJc8qkzRepzA&oe=69EE084C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkvD9-MoQ0kQ7kNvwEj4VPv&_nc_oc=AdopgLJlYoplfpp32sBx2BBCXmFVHHPcldmVO8l7XroKtgTHjGGfSAidyV44mSG7_0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x5GgBiZURIraOr_RPuu4Rvvgzy_DffgourXujGQsvpQ&oe=69EE1ED3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOd2SFU8XxMQ7kNvwHCCv_l&_nc_oc=AdqGtMTEqVNZWalvVRjdGoGFgDAuXSFAe4a5YoZc9TW2AXlwQfE8lW-w_G6lNvRK0H8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LTxlD00nfSWnZQ6ETHFjZJKTCmvoTZNZVbj6-1d6dXQ&oe=69EE2291"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMI5ylvODD4Q7kNvwHvpxtU&_nc_oc=AdqkPgfn6OzWx4xtnGQFFazXiGUq52r8qslijhHDwXive9OIMuznqkD3kUeDlzxKDkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QDh30CbEXp98l-G01Wmk9EuG2u-tQBeBnxmeCIPjK0A&oe=69EE0732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tASHAUX8HVIQ7kNvwHY0hgM&_nc_oc=AdqJR0wg3DHmIla6O2_a52A_Qb_jvuMp8V3Dys3ZqwR4SN6-9-TyrgYjstHvm3MqCII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DsQXroDjMMdcC-2KbxKtKKe6rnNtImiBEIRYkeqnGNw&oe=69EDF72F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
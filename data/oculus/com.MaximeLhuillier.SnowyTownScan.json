scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LVP3oGWWGkQ7kNvwGXvCFm&_nc_oc=AdrFBB6oxmrD9laOgDbnCLaKAz2MZ6RZhskBOUU3r1FL6Tudxeb0FoVmMVUzyml8KwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZYAtnqmHsq1VMrWctA5UbBCxw7RXWEOqoZg9Oj9xBYQ&oe=6A2D504C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS_-8NZH0bAQ7kNvwE_tdlx&_nc_oc=AdoBBsp_wflMSZ5tKMhfl5i6D2TIrz9IpUBqxmHIVoi2DlVPf2OqVa7W0YiccnklUic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z_fATVN0bBTkuaUMu89p6JMH44Ik2PFFHSp5dbLu3Jw&oe=6A2D66D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=654mJl41SQYQ7kNvwHXaPGz&_nc_oc=AdpWYzMQk_KPyybyLariWEAMLCs6OBV5Kt0QsRWZw6or6rbNt7WCYOhdsga0OQ9o6tA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kqgtCuBymfU0lqXU7BIUUZNAflHsF30eeAlV7DBZYYw&oe=6A2D6A91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyRwpzx9LuIQ7kNvwH5Qmlz&_nc_oc=Adqoy6ESIM_E7bPtG-IR8GrqwIUwz0mSFKge-tIHiW9yb9dMQXV2p5U8D7EyWGrYeSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bg0cKmwq1sIPbmmGTFv2CqDX_3Kfs69L3mnfUNVfWBQ&oe=6A2D4F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOVveCiR_i0Q7kNvwFBBHL1&_nc_oc=AdpZQPqQr2NonDowIWeeGJyG1fKK1UxMc2BPO3OrSZb7lOH1HsKwEJKzdJE0pLZzkss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pl-Oo4Rxn9R9U67ScB_tWKFobA3UW-kkcHrvjEqqokA&oe=6A2D776F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
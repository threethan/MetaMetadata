scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyhlOura-ngQ7kNvwGxj_Wx&_nc_oc=Adp-VD1EHN3kwnYVwn2dlIrlFdbu1cC7C0_kqA9Hw4tz7RrIyw8d7odg8GkNgg-LSEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDqMKZoayiEb_Vc50MkTXEPMCWcJLD0HtEteMmhCgsNA&oe=6A620C4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZN7AZ-kLssQ7kNvwF7WfJN&_nc_oc=AdoRRFvkhyAcc0rDP9RwNmaLNf2shuqW03Q3I3BZJ7LQcEstVK0ouaxoiRz2fu0QQ_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPD6WbY9EkogsqbhIw2o3TFL2YHx2WRBhFHbh2ZK9qow&oe=6A6222D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xno-Iti-dEQ7kNvwHxbJh0&_nc_oc=AdqDrN5pScdPZL3VnMW0k1jhj4C5cIrx5Qx2SOaoc3Pv5iVBXG5jYCjPWmauEaEfgKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATTNlzYETmz9NMqVlpSp4uhIvQ-oKV-zLDF2KdASCy9A&oe=6A622691"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf2EQDsJloMQ7kNvwFDYdyW&_nc_oc=Adq-IkAInDrwMpvx160VoNsIWxCVFf4tWKSOugHsZ1qAWRRwtC5gRPgw41s5NJqac-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1UkkPv1vWUPnuWpOQWHlr3VDxAq0V5FRpenbO0Nbwlw&oe=6A620B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCd6BRiSc-wQ7kNvwGrENPm&_nc_oc=AdpJyQtUgBM6GHPIlY9DUa_A5ELaDsf7JZv8aofk5LeSv0HE4V7W4yrI88nWern-Rso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsDt4YtsagSB5lF2XAYVT8pCw-ajPBMk7XYdGRI0irvw&oe=6A62336F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
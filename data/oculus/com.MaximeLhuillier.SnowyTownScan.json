b=1-7&_nc_sid=6e7a0a&_nc_ohc=Ujju2JOKNVEQ7kNvwEheS6N&_nc_oc=AdnkLcLyXtziDzm0L1UUj0ZfjIlsHSaBWEM9Z38CFaet-whYflbmnEJH8Y-MtJdNZog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBGJOTa76vxAIjUk7-HDlsQdJjqGjhKJRl1OO7HKhfnw&oe=69BE924C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdqK4eVzWXcQ7kNvwEB_U89&_nc_oc=AdkFyCi7P9dpEQBJs18u-fcYvvzV3Xpl6qPCiCFfBBj_Y3HDSyaa87WaHifov_Zw-Xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXILgOcYadvmkAXVce88_xYlWxw9aPq1-9x6CMHqg-ag&oe=69BEA8D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYLJbVYfZSAQ7kNvwEKw3pZ&_nc_oc=AdkV6V_cPrlrV1ulN9reAm2W_Lr01Nrn_WhKpVH-hYiF1oZzXA9iGwaOnmYipf1zVnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfznEfmZidxfCSAui-DJKN7iIPlymFWl3SOGMxbKuQWbCw&oe=69BEAC91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vrJ_VJYxz4Q7kNvwG31yH3&_nc_oc=Adm1PgYnm490Fw8Ya4XylV4l0akB6lsHcYJtzC36QKqzuG_BhZ5-gc8K2kEeFxVA8FM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIZ6RauV66fVZmfCAqtCRsJdxbC8ouvCMjUkjAF_lImw&oe=69BE9132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOHFSlbURkcQ7kNvwF5GDZ9&_nc_oc=AdlaQ2g04sqT8hhlr1QKWPVHPWbtbDncmaEhIVGS2l-EtEBwqiehkgspsQIvKNFpNUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweJTuORVv2br5_Sh208M6caxIcNZGxhfbE_JUNo9_0CA&oe=69BE812F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
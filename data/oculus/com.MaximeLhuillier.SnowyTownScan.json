scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WSnEZz7sh0Q7kNvwETLmfV&_nc_oc=AdrpGxhu1sgcGQVrmLWEmZJf05PTvDZPhAI0cGlqZOSFg8P1Q3s05VgWQnn8CKkHW60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE_VmzsA3wzSCLbERjfJTUo9TuX5MrDju9VOHpt_k4Kw&oe=6A7B18CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX4Dp3na0HUQ7kNvwFBrShr&_nc_oc=Adqcnj7gnreW_-Y-LVDj29JdYi1dkpyaaqtwVRE4W1N9m2MDERnaGv16LXZJbbpGm5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf3-3sRyOMgYH83M5B7HOc1gzkCJsGn-SjMHDkeMFGdA&oe=6A7B2F53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijazb_dh2x8Q7kNvwH_2hRL&_nc_oc=Adqj-1JxxMMPvhDWV57g8s0onH1JFg7wa0zJmBN_UqrlH1BH3vwz0TtyuwH8ZH0WyHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSRktEJs0M-pAvNMa9nrDd8v32M1ZbanCxIYTdjXWT1w&oe=6A7B3311"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI227-LIBFQQ7kNvwHEErqq&_nc_oc=Adp5NQyFRxamDnDz_uPz2Spo2n6hE0wLA9olFaXU7Oim9lzrToh8pCdm2jVgtoN7-9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcDoFD9iuuO5iUW1Yk2JiUg-l8Ku4Lz3wnL5sK6ZwUtA&oe=6A7B17B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMAfz-FwM08Q7kNvwGKOG-f&_nc_oc=Adr-myaJCFDvROri5s8YQVRwEPJsPdbeeSmNvV1axShCHvamVjq4vHSVSeCF4AJZwlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfkrfNcR7ulGpdKOvJm6MXuPbeBcUKxP-zSeAR-pSHKw&oe=6A7B07AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
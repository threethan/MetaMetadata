scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH0H-x6jvFUQ7kNvwGE1iLD&_nc_oc=AdrLnv1N25j8hMUNXx9FxMZRGNef6Mx-3auXro8kg6e3hALmgSqcJi1PN7twAhOmvcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QbyuQAkFizt9ze8ArPRDtEWOTPamZCnn6qTr7hRtNNQ&oe=6A295BCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8eSa-CDdhgQ7kNvwF8s-8E&_nc_oc=AdrRX-B8yywjOfawPppeayLlzKLZJAuwlmkYu8mDDmON7Y_y7wcnR3Xtjm6nlmKjdGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v8ByYqoSZpektuA1nqyTOK7XEnpZuwBrDpqiIGSVX-w&oe=6A297253"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azO2rOV48koQ7kNvwGu2fmy&_nc_oc=AdplhU6OUQ7rJS46dCmXO1R3oD_SJ9H4pfxRXgyYjYm1wQ1klhASPY-s9z0lKNf2eg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87WaTpXzqo7peBYM5cbqJ7ItFqYb6j8oByq0ct7snwow&oe=6A297611"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG6BVm8n8XYQ7kNvwFahDvd&_nc_oc=AdoFfzd_U0oc7EhyJ6FglAW-uFzLR83SszYig9ZBP8XMS0YcbKFBTQwqcHDYsydnDN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JK-5M8wG4C9F8wNFOAk08T2HXhsmdZ6Z45VpCZNYZ3g&oe=6A295AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX_CPimezAoQ7kNvwGWXR3G&_nc_oc=AdoONuEfPc1-DbzB1EgOnKVGZHxRiU1hTdrPfNVjsLGIofCGG9wbueum4g4Qz82uE-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YRPTbdKOTBr0_jaDLfsYpeexBljOhTT-AnYLIbM9Wew&oe=6A2982EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
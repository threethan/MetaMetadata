scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh6fhm19tKcQ7kNvwEODcAR&_nc_oc=AdpBgipef2Zl7bRvc0E4lO2H4XkhUHSEkw8Rmc0zVBqw0LLoaDxp9X-HU3Nna3EgLR4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCApNPkAL5j_SbipxSxLiRKBWB32fkTQfKQSqKwU1L56w&oe=6A6F3B4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trRr7KvGJx8Q7kNvwG0Ow22&_nc_oc=AdpunUDrf3t6sP4wcIfEh8dQJ1LjKl2SbDs-CN_WDqPliRRvGYlti7fjNQz9bwCzWHE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfT37y8Qk-SSMzD1JiVAnvB-du-UJ0yP1jkRq0QjC05w&oe=6A6F51D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTtpHaYrAcgQ7kNvwGufaGq&_nc_oc=AdoQA7htFwOQQHYKBzzgKl9netIYlzvM7zyPlSckw-KhO_5qPY2jTymcejnrFEqhob0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwozE-jvNQDCXCZIM4pML7pFTTVHMi7_0JmXbhDHlrpQ&oe=6A6F5591"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQP0ecv2IHAQ7kNvwExbJkh&_nc_oc=Adr8zeyt9VN9Fx3ihxIYSowbn52q3DTyqCKWO53z6oLZrgL5vErsTjaB5guU7TnaRgk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMiTqgNOtZv84lAKDB_pw7Joer4vqxKNLn-r_aZvlvqw&oe=6A6F3A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ZJI8Egl1IQ7kNvwHPvjzA&_nc_oc=AdoyV9Y05I-voxWBwkcJsd7U1xwH3O63aCwfQK6S1WxxIfIAhIkmLOixSiQTrygrt0o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-ucixBsVT3Y7ys3p13pgkD2gH3H0xtI7_OIt_DyOHSw&oe=6A6F2A2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG89ZG6YKtwQ7kNvwHryK66&_nc_oc=AdpwAUmtcGfApIsz6N0044QChMRayTnLt0mD3ciEBbl6FckfkXYBfcdM9QBeAuSt94w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PtKYVyELRxKe6HrnBaczhhlGrg-2j-5V4aWqomy9vgA&oe=6A01CECC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNKJ3pcbVkwQ7kNvwFJ6g4J&_nc_oc=AdpeeoKv5cFTkVyEse28g6MYI0XAWUTnNDxthyfB9uH3hiCVdi0WuMS4owgOYessVp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50zs-SZl_x-yKwcKpQnwJ_BCsN9GUgYzTn4CbjZ_V3Iw&oe=6A01E553"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmceTdy21uMQ7kNvwEBMTl1&_nc_oc=Ado6UmAIGzXU1Y2HnXBuTRcWxv4iIAy4NTmvtDn_KehTeTzKAukaIbvdf_h9XteOQJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H6oryPBuOKWsMiyHKBbi2Y2z42JpNVg-BNOmjhKW7YQ&oe=6A01E911"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGEp5ojdQSIQ7kNvwENDTYq&_nc_oc=AdqyXOnMfG-yv-ArU_QVdNH1DDz6fNBleRHJGjvFq366Lyy8u_3QxAx08bZiByE0Lo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZlAWlyKM3oSCbLQoRLu5ZKcAQ1E_TdPUudiIZNo1CiQ&oe=6A01CDB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4bIFEBIjYcQ7kNvwGUa4ej&_nc_oc=AdrSUAFmdRgwgf8bIT3HpHYa36gSwz8KiWFnkCPsf-Mx9ixkmZq3BE9pvd6YiEj04cI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XbPbrEs1mabglSNY4HdwJDdD8YM8zrHLIaKjdRT3ztQ&oe=6A01F5EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
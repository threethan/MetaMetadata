/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyjHf6iBtqEQ7kNvwGUUHtg&_nc_oc=AdrAPCaP8ZHiWRnKaL_aCD16BLmIIV053pfmzfgFqTWb2NHHOkD54gYK73zu0uME55I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X_1cUvezefWr6l0ko2sbKFtGTb6vhMjIEBdivY076nA&oe=6A11A0CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6HKK5uFfhwQ7kNvwFmjhob&_nc_oc=Adoqs1QWT1Ax-TnIUx76euOvlfRxPjP3JTK8DeC2bgzry9WZA5OjY8qlwBhBAVi1rRE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NIBkolbjZCAUx7gTdovMkKnwAZmpRNccmurrAh9TOkQ&oe=6A11B753"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDESiJdZhVUQ7kNvwFm-M1q&_nc_oc=AdrJIm124W19yJThaXWUoSS3AY-Mg-1TK-9NVdri_5pUVMbpbClJ2HqySj5zjNxqBJU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yKjBACzMXKUEaUeXsSCPRRGr_rGpeFMsbSPgholSivg&oe=6A11BB11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFy75QMFJWkQ7kNvwHVCEmw&_nc_oc=AdrN6r_whouJ4tRNgyTq5lcZEBpdKPTwQ0avatthVQEutR8wLZe7bFfbf0QreU1Cjno&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VMg5_E2FWzgSSuwDXRPrxfW2KV3RxOzNphX8nS1jMmg&oe=6A119FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IhK9q1OHFcQ7kNvwEt5gDw&_nc_oc=Adqx5DuqI6zQ9GHct0Nrtdpt5H7tf4O60PMOQHxl-ELCTkgdb87AG2gAAFL5qfLYmgI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NbKYCwr6AyobkJI_ZF-B2k424q7Ksn7NqO4HnAFjjbg&oe=6A11C7EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
ntent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOYcRnVRYVcQ7kNvwGnW9yv&_nc_oc=AdqkzjsYcP6SXRTLA1DZ9GC-B-ncvZowMINAK4EEn58539N7OloZNIBav_bKFP3p_rI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKMvefUH5Uil6sM6A1odW01mzMTpLDHhsD7RZgGe82vQ&oe=6A85A4CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoR7hPTezp4Q7kNvwH5GMGj&_nc_oc=AdqX2WWBq-0GFd5JlmI3Rcl0N8xbYAriu1eTEF7IENKPVr0V83NITOWodEhawNIo9kw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP1LWVZi17zX1DK1hNU12MqnTqXQc6IBPAWV2RndIeDQ&oe=6A858313"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGDYaAb8FecQ7kNvwGKpddQ&_nc_oc=AdoIhvjTOwuQAOpnuJ7qOtS-glP7dIDtNoeKQ1CULp-CfkQOR67xF6UeQ1NIPPr5nE4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP4FJHU5g6OeKbXBKVNI4xeLHF5EtdHL88MJ9se8tUmg&oe=6A8586D1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBDhX97T5VcQ7kNvwFYWErt&_nc_oc=AdoImyvQbCui6Mdrny8_0fsDiUJ8ribYFzAZYSBGxFtvVNXKIMbhLcsry1QCt4svXHU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRQECGh8vbBv3kFw6XnZ_e4v4l1xWf9skl4ACw6iFurQ&oe=6A85A3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky8SU58EkMAQ7kNvwHvJviK&_nc_oc=Adqzpl3tHHiBmZec4M7INho_BNZsAMbBqaCIy1ylPVFBThgEjde0bTBkEcflV6gd2XE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1UZVXSBs95tbK_kX7nllLpiETKI4B9o161FXsONxZEw&oe=6A8593AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_
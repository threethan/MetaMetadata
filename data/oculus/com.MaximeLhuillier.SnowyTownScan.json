scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVWsyfcq-QsQ7kNvwE06nD6&_nc_oc=AdpHdDGJjH5ycXZxkRwDZv69EMqhVsUthqkQvIR1fYOW89ZS1Etag1E_waPGNxtosOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vv4SAlTEjE4oAY-moASaoviObOn1ONBvkqtFIqcb5ow&oe=6A0B094C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4IwlCRehvoQ7kNvwHUMtli&_nc_oc=Adrm00d-EoYVR-zMcqhovaM5TaWd3dOnoyHmszNa14zQCLTVHWL9XxYcpMfBApMlMBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BRhoRiaWkIpasWx6emFMewRtCFt8Ule3ERYxFSQ4ImA&oe=6A0B1FD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPLvGtwDC7QQ7kNvwGjctgK&_nc_oc=AdqlbptjMoO0_TlQZYIslbedRKKa4Btzt6hnSCL2IlsY5kj2TdOxCu3_wKOqJDI5d2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nhGvFMqXM1M0CJDFa9eZHNsygJi7bP47-gsAjQT2o1A&oe=6A0B2391"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZU18BpM5XAQ7kNvwGMyR-t&_nc_oc=Ado-r7GaxxLYps0KwF-8ky01GR2dv7Lv-Bp828c5y_hpAC1qzwCPtBmOrW_p8KuJ1v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SoLmObxMUPyCzhjAu8eQc5KfbCX0NFAPj07gjbBNgjA&oe=6A0B0832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBCcZhqlaZ4Q7kNvwFtwcxM&_nc_oc=AdoeU5gxiWOYsLJl4lNjYkhYb9lujH3O9WE2TmL7AzUpjkWYbv6_rOEmbfWbtcHPt6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n3lktQ-pYrkc5WKztZngTenq-Al12R90nZdFWzk5rSw&oe=6A0B306F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE8Q6kDD-eQQ7kNvwERQSBh&_nc_oc=Adqad1pkuzFRUQrVa-n_mAbTqPZheEMc-wsa-68f3YsuxzrnAs5nrTsqpRwPA29JLIM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArIa9faSKOepLexasVKj5Ex4YIYY8b3nCE8dZl7FhlGw&oe=6A58D1CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbUlwtBmvMQ7kNvwE1fSTg&_nc_oc=AdqFMjvxOVLYzs8BWPRN-vHgkpvr3nssXCgVB5TSQd9GVDHkJxhK2PvXqlZnIM66p2U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsijW5lQlXkGxFAL_CWYLKXZUmXA-yxZzGJadQFYgg1w&oe=6A58E853"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v91wElREwXIQ7kNvwHF9mI7&_nc_oc=AdoYAT3P2gI3YvXaP-ib4bAiX-P4oSQmfFGkR1-6ISWAiwy2LMB5A3y_qeEIdaQJ1iY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOgq-oF3Mz9t-RQIbusC9gxZk6nSkU8Z31vCO4mwSvDQ&oe=6A58EC11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OZCjAZk9fAQ7kNvwGzO2nK&_nc_oc=AdrrGkrG_PMB-luTC7athEbIDBhvJU3hIrBtnBJC9Y_2S5uWEcdvyFJ0LSXCQABrcus&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeIl5L11rQ1w36qBcvwR9HhzbpjW1pVQStB_z5fWIOPA&oe=6A58D0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1jYAYnkoHcQ7kNvwF_1maB&_nc_oc=Adp9vqPH5Rx1TZ9A3bvIEZHcGltYVCdNcupA4zbnjMVEOJAyzBEg8qVynuVe6w4cn2s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCed9dQICtnKGhq0dV1jPkps85m0ZgN1tb_7yWR1rleUA&oe=6A58F8EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
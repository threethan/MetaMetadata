scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyhlOura-ngQ7kNvwHxjy4n&_nc_oc=AdrUNDY4TRVzH_1pKgjtgTFfMIQpOWfC9Jn0BPAEiW7aKQGDH4yZY9gG8ghNW-kcJw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo9nyUN6aeE98cgXFyW2PT-0_vUQosPVrFTK4MhCa_WA&oe=6A635DCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVUeCf-g6A0Q7kNvwFOsk3g&_nc_oc=AdpvLNliZWj5itoWhglevCk8l29WjKrHRYwHrlEiRRFGqTATBIhWCwSK9SmmE1yJ5oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSjSjJX5vmq4otH8L3cvb5DHVnsTIqVhwLlndLZ7XAOw&oe=6A637453"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xno-Iti-dEQ7kNvwH4jzSa&_nc_oc=Adq9JozoudJaqFpZaLLe2EngdabxfY7mqyHo3yWxu-EptzNBnJcnvFv-IGKqbk5ESRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClhhBpocBdtSSdOTUG1w_qv0v1aK1BoJ-_iND967kXqA&oe=6A637811"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf2EQDsJloMQ7kNvwF38OSC&_nc_oc=Adq7lpzo0mef2pzDeRvL3Y_3KjX9zlprB-zYxjcPUOTMZrL3dTeE6AdwJWDaP-vX7sM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXmZe97uX-YNpK4wQENRAghusSORA8LcuBCyuIK_prFg&oe=6A635CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCd6BRiSc-wQ7kNvwHcCaUK&_nc_oc=AdrnLFyoBX40chEduCG6YHV9FX4Wm0db7z9X3lhSUXgUXVCPC6jORYwDsvJZ6tVCoQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8WKJ9vkE3DqdgTL84Qy4yajmMdSIF1-gr4fL42smMWQ&oe=6A6384EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z6ClweQSMsQ7kNvwE3hcUl&_nc_oc=AdrpwWKTn_4LMFNFcMc3ZJVKIqLl57Gev7-6SGo2He3X3Bi7vq21_-oj5tUtGyfCHWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTzkF5v2V7Z1xBQJVdOHTU7XdVN_DPNWv5em5D1FPqrQ&oe=6A50E8CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bouf55SyOOEQ7kNvwHtqpZO&_nc_oc=AdrxV4yV0jQTU4B62855CYAv2_mMup9wTp5TESGa4htHvJlBbBbxoWtOoPG3E7SjU_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANAJJANb4wC6ZrR1z1jEP0tIWYvZoDjF4Stx4c6tPt9g&oe=6A50FF53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0xOHOJxSbYQ7kNvwFGURnK&_nc_oc=AdrWRRd86NSwIqxf5VAvTRJQ3VFWzlV8y0VMcEMqYUfbFk28FoBvb4VRmEL_e3sW0BY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB42W1L6Ek7p-std_AMyKZkNl1dPvHFMTiVRldS0luigA&oe=6A510311"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ7BRi9K5nIQ7kNvwFTLe5A&_nc_oc=AdqOTi70aaYmjJFU1KII3BBL_mJQF64r3yd6_fq9xrZXuJLTbFXmcXDGFtlBftlBRKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA82ODSW50TrnrW_gkeUqweKCCvWQdbd5fFgGwhRulmFQ&oe=6A50E7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9a7DrsA02EQ7kNvwGBRVwf&_nc_oc=AdqpL7pIGECN-duaRPv1ZXn5med3UeRMf9Bj-cpVSWOJMdBrxrqaDz1SjKZ9BknyXM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTLjeZ3yI1Fz-OZZY4UF7GibNShMiwHv0TwscOoK7HeQ&oe=6A510FEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1xs9anDtRQQ7kNvwHH2JvA&_nc_oc=Adl0Zy_6RbfnWk-JepPzsj0NDJEdfxhj1VwTE0DqUP-68TA7-Rqsys6EjbRG1HAqk7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqpG51vNKu5VmYDQW8xr44otMjXjH9D1IvoQh5iTG0wg&oe=69AD6ECC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEePqRVoT84Q7kNvwE0SPTI&_nc_oc=AdkRZ5JPo3CCD4w0FpEq0AHV8EM-96mwt4IVJyfvE45x8KkHH4pUC4WL4IM_OCxWQBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ8hztYADre1ITP9u9AbX0SZR4D-DtYyKblU8v1_Y7Ng&oe=69AD8553"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5yk0_M_wqEQ7kNvwG1bvNc&_nc_oc=AdlZjTVxnjZOCTjT4YdMjk771AcncfG2oYpFX_7JaN3CtQPxBreiFRFqLO4NNXZl2Bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwR7Bm3RriUpib8nE7H0oLMfqOt0m_LjBL2DDervwcZA&oe=69AD50D1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqV9yl26RKsQ7kNvwFLpoAq&_nc_oc=AdlYO_2PqV4yWlUni4wPBF-INNmlNNLGelejQQz_RVCxlypFoxn9Jils2hCdNcTw52Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_EvieybDi0oehZQgiQjKvPasdAzzcdmNvExlu9IOCNg&oe=69AD6DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAAMVge31ikQ7kNvwE5STuX&_nc_oc=AdmnN2SktLLB0PxIB4HayaiHdVmXSck5QkoDsWHeBbNRlRHTvskFErMcusqLDLPEJmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXcRw4FNQ7Z5Kf10V8j-Ai-WLuIq09aGOM7Jy-c8Oa0Q&oe=69AD5DAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWuJkBWUW8AQ7kNvwEr3DUI&_nc_oc=Ado1Cqphi7oXJj7a9ah_nnSTQSvkBG_2X26bSFMYQZ7CFB8r9Jpp_nl5k23VtAgDU6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4-OnMGmRMlckWK1aIfdJ5NL1jJcsPx9SzQb1Uu8hWTg&oe=6ACA6B0C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30CJ8hnte-gQ7kNvwHK2pbI&_nc_oc=Adp24t-2G48tGNlneqHJ3-FOMSopQqwxpocLF5GfG92nBBw3FmThePFEdFdLaVgxAdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX_evK7ppqq9roxECNn1IjzK5Ttd0fyYioCh0Drh5mpQ&oe=6ACA4953"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrftA3tiSA0Q7kNvwGZwFXk&_nc_oc=AdpKL5YIyVSQi4B2SQswKy-Gu-a6z9sCjgyBED4iu_o9XwCvSHRh112nYbgCCcFUMLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc1bmDpoMxxPq5OoZDwZidtQ4IsqLttLokIuE5jJJ5vg&oe=6ACA4D11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTqTppLMl9wQ7kNvwFGtuZK&_nc_oc=Adqxh2I33vr7tN0BAvpPMm90bxZoat8EjqIDfgOrZevswUBUY-IkkAkthtSjZGyr408&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRNSVwqED0KVACW6nTj_ki1Sq5l8awdZHbMc54kcik1A&oe=6ACA69F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au5V4hn8nScQ7kNvwG8F_dK&_nc_oc=AdrdAuk4QKYfgZWUeYa7zp7MiufHpNy5M2jntihhB8f02fCRkoNRuEW6j9mUQdzQR-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlkO9ikoXH6i62w8n1jwmz5wyQKJ0qUVdrlfTepQs6aQ&oe=6ACA59EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
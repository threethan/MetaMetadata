scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njC-75UG3oIQ7kNvwFBQogx&_nc_oc=AdqPGQhlEIhYhWAy4vhqgU9pKdWifPreqDofcTqPG-osqGWiLlo3DFag2WjnkrlnS3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFySANRB37meOq9C-HjkH99GDB-jLaWi9Xv66P_624xw&oe=6A9030CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaTxOfbW7AAQ7kNvwERoZ_v&_nc_oc=AdqVuWfuqYtd1NfsnKlCMiZOjVtydf3oka7JK1Iow3qF_i54qSMdj567544nLPWPTO0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWFkyBJe3PeXhNJchc1H5yTAMFx5OtpI4W15luLUUdsg&oe=6A900F13"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Rb60N3y3cQ7kNvwHbxMN9&_nc_oc=Adr00NqACd494Lst2muxrYrvhgRjI-B8AVNetF7flczBFgQHTn0iwh5IpT6QFlqfUGo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv6u3fGtNRbVn8aMqo8HJ0vsfSzjd8CgNRPXBwzIdS9w&oe=6A9012D1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wka2mmhhIxAQ7kNvwFot_BS&_nc_oc=AdrI4nx-Kp1OpsQrfPOzdmQ4a5CgPX-HplFRVhpjv61MfTc4Ig8SSleBbIk_P-ScZxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6-st__D8VG8ELJww111v9zBAZkOEzdrjCKmdKlK4Hdg&oe=6A902FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88GpbrqeGnwQ7kNvwGd1Yv8&_nc_oc=AdqsDU_kKEsU6EhLJSaPR60dQq_LSDnfYoht-yjq2sET9jVKDO5a-VfrAEXZWUwZeBQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdSS3ttBx5C6y-Cj_Uh_d-oQgqxdj2Epx731Y8Gtf2Wg&oe=6A901FAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
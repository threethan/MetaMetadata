scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crzQGQhtaQsQ7kNvwHPzeYj&_nc_oc=Adog23TPWpCmVC4VqS3li101IW5snq5W0RxCEWZrz7O55FczoJpiHghY_OI4A3ROkTo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H_BxY4s1n45xrWLL0C9B8iEF1d8TYIEzaVKsS4ulddQ&oe=69E61F4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s0QvFWYZgEQ7kNvwGdnGti&_nc_oc=AdpARYjLvng_tsSG8xLkFqllfeb0flgMiTAr8TIkG2Ih-91de6a0y3_nmBYtd7PxvkU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R5hXPTA6AG-jnZ_gV_7JSW-QsjVlaYLpStu5C_zVD9Q&oe=69E635D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntZAuGAFPGEQ7kNvwFabMZm&_nc_oc=Adqi1r41I-xPRWm_JfVXyuIv9KAbgPJkNUoPvr7ZXQuBHMxl22h1IduLaAa7sh46lJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WsXaAHFNq--SltecEMctqcC4t_Nekllaio_0n7G-ejg&oe=69E63991"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7VXYDX5PzQQ7kNvwHWAWEW&_nc_oc=AdqJW9cpiFKxPDyvAozy5GQSeESeV3WqHG9TmrLIWriOL5ZRv8XvSSmX8iTfWhC7CmA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V-swGmi4m9skuMaJSBNOXu_z9CWtrUqWcA7fUynZsBQ&oe=69E61E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc5ouXYh_C8Q7kNvwEgc6Dw&_nc_oc=AdrnkvHTE-puhEyZextdNiWxdks4ypz3DXCO8ViUlqmSfd47mZTL0T32WncwGRzBRXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K-4Ev43eUJZexNAOKbpOLT2N25TGk07IutfNG3uErRQ&oe=69E6466F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4ouwahFlzsQ7kNvwEbmwQI&_nc_oc=AdqBulMJR-JiPAcHdSxat1RiJuhXPqBow9EJ32YzBueyZXNzrIof6fbzWYOaLaU1ii0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZgNSAVEGF4eD88UNWWvJ6te0uELfEKqTbafdlQelV3w&oe=69D1074C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ex-b5P_vukQ7kNvwEEB_GU&_nc_oc=Adq3UPGZH5nMQ40Z3HoxTYN6O0QEVdoe-Vnin05TjspNM4ZCvzllSLBeJbr8ef1-3r4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOAoge2LznuCbmuJGBZWxegiS4rq6Mzo7vPS70RTsdWw&oe=69D11DD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tLLKuRrjlIQ7kNvwEwP8Av&_nc_oc=AdqwBK_bJYcCnXJfNhlPjbSwOEFiluO5egdpxA_JpJSdF1G7Sh_hmgIUDNZrUIf1shg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afweja0xpM3YyOxsKTIhrUg94HHItVmmNm35ewlS4UffEg&oe=69D12191"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R75EMO_29EwQ7kNvwHWZqDM&_nc_oc=AdrAOrX3Bx9WpqmOp-nHPdiVxrp2wfByjDsms7uj9GRs2vKLKvazZrodeRN1F5dHbe0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQtDrpetmq2NbJfkSGWZgGyG4k_09Vk4Z_aTAvAAIt_A&oe=69D10632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v1fOdMFYoIQ7kNvwH72N5M&_nc_oc=AdouExSN4_YSNVfQhVHHORkYBx04bf4ImctHZM7vhsGAp-7Ce6UbhdKvYekMfKF_m84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXg-kPEP5LuIN5fBZFCUCMxE5c--9zL1P9eYzQOYEG4Q&oe=69D0F62F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
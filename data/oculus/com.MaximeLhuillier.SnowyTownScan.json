scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4NG28LqQ7gQ7kNvwEYqJDP&_nc_oc=Ado-8eX-Eao2cy-sbWzcTw8wFp6nLNQ56hl470dabIQHU9Lgs9Eq_Q7kLWIYwsKxFPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0pGX4nHasNtybGxK4Clu8YKkSbPkKO267gw4EHNZnxQ&oe=6AD1028C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d55cmC0VLRwQ7kNvwERCQUt&_nc_oc=AdoIFYuefKFDHjY4KDuH9r4rONU6vgwT1z9_EYqhDGBFe-yEAt7mRnqsFtMwLcvcKLA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa-4N61QOvaAIqDQTEIBmnFKjivm-DHubQBfEjmSxQOA&oe=6AD0E0D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CarzNpdlQw0Q7kNvwEM9rZG&_nc_oc=AdpCqF1hmDdr5E1XdHXwOL7My3IriVWdoRL4E0YJv2n9l-d8BUrUdOxn8QfqDks5hEU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFgxmKtLTSQQYY6uL5mnsbKqSiqYNC1TH7iUmgOJ5siQ&oe=6AD0E491"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6q0iYCx-2QQ7kNvwFxSkX_&_nc_oc=Adq1GywhDQiWNA4ySVj6mHt7ILIc4rGDdztJ6BdVholdjvqRMXmJquB5cnYedS1qxIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3mS7K5k4xlnu_n2Bwkrtwk0cZpI1Dfb9PkpFgdEGlPw&oe=6AD10172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g80NQ1U0qEQ7kNvwGJNQ-t&_nc_oc=Adp_OIC_Hjmxq94j3zUVcUKf_dSvGJ1dRihdzqqoJrEb8LsMS46MGx39p_-SvisvoS8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Hd2_GHsCjB7beJ0fqRoflMDmDAwKUJFEybC__Dm6gA&oe=6AD0F16F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
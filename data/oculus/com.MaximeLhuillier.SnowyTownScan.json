scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-coAO95fv34Q7kNvwEwZKiQ&_nc_oc=AdozveFJgd7eu4hYFDls8slP6vGHvkyEDXrdENbMhs3JtzWFBTIijueMzUULC38nT7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--Oos3UYaBp8CfHGJB-znw-YJ-Y_0IAuUa51EucoMMWQ&oe=6A2172CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWx1QyNxSQ4Q7kNvwHq7SFG&_nc_oc=AdqJqcwKDT5gXE1iNpS9_DtNpnTkaIiCNbYdonC-xVm3miNu8LcHzLXRKsScNosydNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q32pyW91yspZQ4cb9SksXuunodTS4Xt-9yoxr0dEjZg&oe=6A218953"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhCCmWU0QkQQ7kNvwGgdzfk&_nc_oc=AdqJzVDvDc66O-amvNMo19dCADvEVtGAPMhMBD8lqOYxeSphgwMd_sEWl8NktHvO258&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83uHGUnMMjJMgdCRm_tWqkm3vCteF4piL6FCslxYxRdA&oe=6A218D11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC8iQbJw5okQ7kNvwET10UE&_nc_oc=AdqKDfpDQa2AeKNT14VD7-7LhzUn2LDjB6qX_VfIHlaEmNv90PqKfiiuAgJ7PnTAAvM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_toQ-2-W6ovQiQZ7EoNP5lDW8t58glns8WqvMzF_d3yg&oe=6A2171B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j-BtqfA_JAQ7kNvwF4-Qeg&_nc_oc=AdqP-itLziyTRkgyiRnYGy--westHY-5v9rsDPtf3M8O3ZqLXr1YjC97iy-5idVCeuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I_maL7BbQxbh-aCkTTcQnBLMZwKRncgb-g2gaI80LBg&oe=6A2199EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
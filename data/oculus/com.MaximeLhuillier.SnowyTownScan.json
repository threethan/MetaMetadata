scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n_kZCy3P84Q7kNvwG-yMpp&_nc_oc=AdqyVg85RPNnb-GJ6nGQ_GHDDwhuLKNImCd_vMGz67O0v_ndUACHVOozuJYpMYjO6XA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FRABR-KFqZp4TA-52vm6TkSzbrielGfyHTzsG99-Rsw&oe=69EA13CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moN-CdeT7QoQ7kNvwHRzczP&_nc_oc=Adrj21L1q0kFNOC4KwVt1U0rO2KmG-nSn5nDoxn-Osu6pVudJRh7Yw_e5XKi_YjcQ2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yHTeTz6FfVuL4zE-F0vcLsGz3szwQzqIj2_hngGy90A&oe=69EA2A53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxtA1tkhISIQ7kNvwFkfpoq&_nc_oc=Adrhymmc5aJfPHI094WI8lYiCkSXog2AdOuP_EbS9TMfSaOIO4CmEmrF5dJHxFnQsPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_sSo1VirtEiGkkOzVQ9xNUyOsgLOfp7-T1MJC4yAsDg&oe=69EA2E11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XfTSmxXGe0Q7kNvwGIID-d&_nc_oc=Ado0W-WouOEoL3_QQGXrBxzllh3qiNUtvWoWleEX2GNmOWcm01NQCB3_YTlOOohRlN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30fbsEB-S7PQVzR1-YnmFU79tXO6XkqII-lbOty-es6w&oe=69EA12B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br5EeRAKsfkQ7kNvwEJSHYD&_nc_oc=AdoZjzraZqXnkAKmtjuuB5hO5C4fvI2QlJ0wSWDtVJKoEV4r6nUDxDVsvg64ui1W1H4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2o7XBmHyfdpD30Xy36zKlsaQmeUDwDofVmRRwPyvrKYw&oe=69EA3AEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
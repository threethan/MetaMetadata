scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O3eRaSHDCwQ7kNvwG41tGQ&_nc_oc=AdqR1cydVdzyt3RWX3KF9hi58RCccd7s0MjvP1-f2mNACIHlb77SxsUjo55rThMm26w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKPSJCqOx0z5HwIb8juY02rC9kpDisSkPVbKioeSPKKQ&oe=6A6600CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVUeCf-g6A0Q7kNvwFCI3dG&_nc_oc=AdqzaLZSQ0u42ZbPEJ1l7rMGxmKNzX4pevbQwQREwnWbz1-e6CMrh-LDsLJByDGCTWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH3-wxu2BDi3jg9j8FzCpasTRB1i8IgcEcVgzjSgvWoA&oe=6A661753"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vEbnTjg4FYQ7kNvwE1Rnyo&_nc_oc=AdqgRljAUrQ7SMXDIP2RYmDgpSy7gUpxGM_ehaq5aXAQkwYVygtCT_5WgHTvVhl79KQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8GGZUo0QEYTKG5goastWLmJ2eUgd3hsL7zjpvpG4wWA&oe=6A661B11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LhdPODo1acQ7kNvwEDXiRn&_nc_oc=AdqVIGTwrUfJGF8utcIvrpesiowHIzmt3tTO5Cubtn9qAV7HqHbps8dwTLZPyBQrrhw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRdU-Vb2dzod4U1PP3s1uXDOBMxVS9fJ42LckrciuGrA&oe=6A65FFB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNPwALfCWp8Q7kNvwEfb5Sf&_nc_oc=Adoa_1aQrpAVUztHO2ssIJNTiZ4kBdCCpgZgubCBsCyVE5X0dJDgCYxdmhGMAagTK2k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2YGwaVhR8VcdhXCCvqEXnnDdZY0A0Lg7jxR9ItvA69Q&oe=6A6627EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
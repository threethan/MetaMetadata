scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IbtpU2C0x4Q7kNvwFilZ7G&_nc_oc=AdrQAsvJlUliU_Cx6ifZOCPdAWhuwvPZyTA4khHECJFNKdDdGV1j0yIlY_lnS5NiZj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7txYDcfZRzAsWaRJ16fkzWmYYNTN67hsIvJGNfQ_WaA&oe=6AE1EDCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6sXcNfzK98Q7kNvwHDS_cF&_nc_oc=AdoogcAzkzaGstA6M_fegM-cYEQmPr3vNRr0jyRj-Nhl0lHmbC3qr6vr2YuQ4LSPeuk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP29QoSu_oyMSnhAJ2Vl9QRsu3jPwlO2SqFxhX86ZcNnQ&oe=6AE20453"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTPaMTmCvI0Q7kNvwE_i6Qz&_nc_oc=Adp-CKzJDkaQT3HKwl2NyNl_xwaCwgTyjmnnAdch0D3zGhPE5yezSkVzJwhiw0IuUyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPflT2Lgl3p-7ueqF9N9qrmf8Bv0ZMWD6WXdM3_QzzRTQ&oe=6AE20811"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6btNTA1GcQ7kNvwE44yIw&_nc_oc=AdrT8nCppqlrsjhlco7RNWYIYzoN6fL-beiKBwDqg8aG-PlGgTyUPy3eItVDw504IlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVlmhKJJmOGsVfOX_exR0QO3YfUbLIftzl_B2xwqpiJA&oe=6AE1ECB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_uPxTG-I8oQ7kNvwFvDxht&_nc_oc=AdopajUP4-X4MwEZF2kizoPybPMUEGNcvO0deJXcg1eYAzmfEaAXJ1gcSElGJNOhqao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-dvN-zGI4_Y5hhYjt9QDknTxpnUjKf2OhMQd-bZZjHw&oe=6AE214EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE8Q6kDD-eQQ7kNvwGLpZBa&_nc_oc=AdoE_bD18_vasASyCeERK1_9rBLGPeybYUnp67iSPHV0ulJQtLiPQInUkaR49WlFqRw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDamnGunvZkyimmOEUPFsk3t5gvQxUmkRIC4nR_-fl2YA&oe=6A5A234C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbUlwtBmvMQ7kNvwFoWNH7&_nc_oc=AdqiuV9NMEAg6Fg6PfLh_po8NUzhL3eIGwNION_M05C7soDjQ7igG8_IJJ1r5LIpJkg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtqRugo9QAZaOBV0C1C61DPeeFn9hgq_kOM4M3AFcYRQ&oe=6A5A39D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVtwu-Fwr7MQ7kNvwHcTwU1&_nc_oc=Adq2WALwNMVcorzQEkWjyG-3BZbZmaVtLWiOGIpxEC3uviP4J__kruUGBzhdgTY8bq4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnIWBAd8oSlDBzsQOH_nTA7k0nF1c3x6gsnMt7xBZ6tQ&oe=6A5A3D91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPcrxKbFsDcQ7kNvwFlx7qP&_nc_oc=AdodII9LQupFSGJDoCQRpoW5mQNcceTbQkDxusUpVtvtXw9fBjjukWXz_t8a7ThZbbA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ant39jEqTxmIYJMNN3ymJEyYK2NwWdVbPpcr2YSQ5A&oe=6A5A2232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fucp3jmRcoIQ7kNvwEtfeRo&_nc_oc=AdoIFCUXZohHXR4TzXpagNzI4EEXeVnt2_N2seIQ2e8Q8_JIhwqE1XHKozXhmRK-cHw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHwY3nGgVdnmWwK0yY4x7UvenQQK3abo90OwnIQVHFIA&oe=6A5A4A6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
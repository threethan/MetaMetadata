scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDka_GgUDl0Q7kNvwF5O4t3&_nc_oc=AdrH7NmTzEGKzEc5wKT8SdFVEW3lXYrdBh8HNedbSusDVwQXVHgjVHM9l5cEONVuRD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeXlpP45JmEprid-_mHpEI6uFoaiuDh0dCxSXhQFXiaw&oe=6A4F974C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bouf55SyOOEQ7kNvwHxsMmL&_nc_oc=AdouZjW-wZAvXNAE8dFHjr_5NuibeQxJsVjYDfQTgLxj9HqbM_tgCrzKcDvnQiNyqC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9PI_aMm1WrWMf2J5voiCXevAE4RSFfOgD5rwN7-O-hg&oe=6A4FADD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0xOHOJxSbYQ7kNvwHs2QgE&_nc_oc=AdpOCsuBU-JHeAuawK7UQIebSkw7Y8j5Dow9MwF75VC44NhAv4RTXe8VePUWKC8mGsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKRNV7YfARY-MlwBzu4gSDRVn5-KHaOmG3EkYZ2Y0Z1g&oe=6A4FB191"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ7BRi9K5nIQ7kNvwEyctm0&_nc_oc=Adr4Sv5fLuqBvHO-FurrOp8Cv3c1a7PDePf9eUVc3YpOFwF4_JfXndUNSXPcVhW2ZWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXTGVM7lLaKNXjBpLoBXoBbFsQilxGbTjKpmOUgcWQ2A&oe=6A4F9632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9a7DrsA02EQ7kNvwGcPb1F&_nc_oc=Adr5wMA-3XqBS9RsSz4tX5Eyb-85ILMckEStp1uR_pv0h9WgKMESHbcngh83ijFX5eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhEwWmgzLeLgqZu3y7G1Rz4UH2lcxWdsUHMkuR8OG8oA&oe=6A4FBE6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
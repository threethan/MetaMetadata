scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4NG28LqQ7gQ7kNvwEZ_CKv&_nc_oc=AdqN-Npcx9-sPlzuReMv-PVpOP0Opq4QXrCnZ1dbnjX2ybsX2Pubh11PmabEYs12YXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOoTP1iFIl9iyg4AeqZ7Kjk4prsBuUFEc7J_09G6BUhA&oe=6AD2540C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQdk6w5WLWEQ7kNvwGPAmvY&_nc_oc=AdqrZQNBBSC8jEHF4QBnqpEnl-pbSqW9NYNSfkLQYoKODu-H2iwJKSVCBB6o_SLF0ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE5atL0FaL6_H_uTO-ZuQBBkLI96-kYb0ObKgHr7MPnQ&oe=6AD23253"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CarzNpdlQw0Q7kNvwFISrnh&_nc_oc=Adpfl3UYxKlrrYxrJnVZbqcKrb7w7aMdCovhHjSmKtxXKzDs3NIyDIxZDroxEmokMMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8f8xTLTBvYqovagwRe71OrWoNtv9QD7Be2VJQE6wUXw&oe=6AD23611"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6q0iYCx-2QQ7kNvwGIzcm5&_nc_oc=AdrgJsVO1uiOuTAisF6juGtJqns5CXTKg3nvKbYNbr0GWjoABRtQx7TLW1Anjp-5Tvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONfBWtyQF0fTluEjFowrzWirD4Z_hhzhCkhF84lnGD4A&oe=6AD252F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g80NQ1U0qEQ7kNvwFAFv9G&_nc_oc=AdrPl2WpjCN_edbLhhlTn-s9V8OL0PvuMtncbkT18cQLy96_ixGAXIMjHyY_aJCoBdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhUyEVFR-eW3kQvnWaTga7tebiOBrMwykuLsJYQdxFHQ&oe=6AD242EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
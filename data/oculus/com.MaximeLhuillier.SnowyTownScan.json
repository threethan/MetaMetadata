scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9FeuJAaUzYQ7kNvwEQmn7w&_nc_oc=AdoGnMTCKzzmb9zhd6iVciAairmNSZS44HWU7lCjg6RD60frIK0BAD7z0aaWn70w0CA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X4B7xMmURZ2JTPABTsO9f2JFZ-3OUPTOYIdZ8apZCcQ&oe=6A104F4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6HKK5uFfhwQ7kNvwEaAKoe&_nc_oc=AdoSKXaYhIlJxv2h3su75CmEp8oAJT8uIug_RHWCiVufCA1klSguxsEbxsKkAAx8T2Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a-PR2HR8ZzOhvaxVsbpcssT1pRSMRrgem1w4QuJTp8A&oe=6A1065D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDESiJdZhVUQ7kNvwGnkJyg&_nc_oc=Adrbo-jgblguhK2GPHyAbKIxT6USuYUiErZORlrxp8db4cglUZujzJl_i2nTt31bbfA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54dOyenqH7totxw6pIX7vAmfr1aRx7-m7GC8_NYBhDWA&oe=6A106991"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFy75QMFJWkQ7kNvwEJ-NFq&_nc_oc=AdqVdbUmyZKRwZq2ay0ThLHWwB1xrUOSQJTkY5ZzmrXLqyUm0hS5-Rc9ikB0jgvM8Ic&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76mv9uToqxuvkB1hHGwX99eo1U5NH4pKgTMz6RjTwfLQ&oe=6A104E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IhK9q1OHFcQ7kNvwFz_2ha&_nc_oc=AdrCdLmHD5b4T-KY8UpNKVrQdGhLyVwbevup1Oz_80NAkihA8s7i8a2GwG4rGyC6nuM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eaAmoUt3JZOSluEmo_-EKTiEvmJv9gKFn8B9YVu6szA&oe=6A10766F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
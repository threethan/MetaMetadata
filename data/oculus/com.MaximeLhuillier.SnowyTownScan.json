scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCZm2AZFLKcQ7kNvwG2ixt1&_nc_oc=AdoPx2B26sHOIVeZciLz-n3K7UF_ThNEUb0dJxhnVf72MLaqWic8NQ0LgyASCEbfS2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxMBFQQYm020GqTjrYSxNurOXn70Fkc-GByiNSK59zXw&oe=6A5F694C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZN7AZ-kLssQ7kNvwE9-JG2&_nc_oc=Ado0dItqYNCeHodNX99V71uJz84IynICw8hDhJVQSZQ_EoUVSC3DCSGfd66A_i8J03g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVRzcmvR0vnPwq1ssl-DdbqpOn6pgD5F40QnAvL1oqgQ&oe=6A5F7FD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwXbSuQX3MwQ7kNvwGaBgRh&_nc_oc=AdrPy-8w_8uv8MCDOfg0D6-wc0uXZK8HSOdCGLrd35AbfupqWJbeD4WgNDYcqJJmGMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnqdBIgIiVGKqP5yOWYNFCswIVal8-b5tynBpmxkX1fg&oe=6A5F8391"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wux6ZvWkzO8Q7kNvwHCiJKr&_nc_oc=AdpoRdkoppM7Orznh9NEb4k5ZfY8o08d5115Wyj3hR-_djHMLMJ13Ver-e7gNTkp2r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyzf_5SpQbBy3pMGmrqU-T01_6HUZvX1_sZt46lXpRkQ&oe=6A5F6832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wcup-CATFYQ7kNvwF5sLdn&_nc_oc=AdpI2I2EDyjx5Pb-hodf2_AKFg34DAddz62oiOo0vU7_Sh3bXCxwzzTWhXHgaM3g5pU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAACoK3pYPQ-Qb_RiQzkk5ev9OsS3y9UCqIGWdd0P4QWQ&oe=6A5F582F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
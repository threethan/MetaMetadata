scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4K7pmPh4Q0Q7kNvwFaMFBf&_nc_oc=Adpg01BVlyrzi_Ss05neCl6oN_ksU8GlJmP3LNiCpt2kzvfkjItFv3rGmnWkJqax3fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QELk1KZLsi5FhERFWVTy9Z6RYlCYtpirbubvyHlEmmg&oe=6A007D4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNKJ3pcbVkwQ7kNvwElC7-8&_nc_oc=AdrH9xCMDxG6xFzxVHFbYPa5sC6sx_jJMshZPyyE8OUWNOJqB52w-c5OlKvUQSgS6EQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZONPTBkx0Y6K-IRzk4kZEMWeNhdiY6zXTOhpPPhSabg&oe=6A0093D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmceTdy21uMQ7kNvwHAlQe4&_nc_oc=Adoks8S3kG709xOtFmGiVVfjzpIDGCw3F9mJeDPoPYq0upRbxDShhVlIL_dTX3-y7mQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pJtKpPne4eIUKU7ZsqkWed7PxeNQomFlRJFB8jyRCbw&oe=6A009791"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGEp5ojdQSIQ7kNvwFfR6AF&_nc_oc=AdroaNIvDKqty0ZtzqFpCX31dVwcAPNTWeQ_BhdjOYZW_11Cg8nuitbrvcs0TDFC_tY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A0wT3t9BvTfbD2v8Ci0LSET_l-nHQs47xa1c50dGAgQ&oe=6A007C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4bIFEBIjYcQ7kNvwEX9akJ&_nc_oc=AdoKrsKNRkeBOhCQVzKuCRsOq0UY8pC-rM6uu5-V0ujAnSFGMk1EVjvOhrVw6ev8Iic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M8-UMbVRvyfa_amvgeBv5PrxlrrG8Sdsy7PYFLkvxqw&oe=6A00A46F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
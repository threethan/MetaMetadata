scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJeL7ku5owkQ7kNvwHN4dZb&_nc_oc=Adq5iBKRAh4xMioAUJifWIbvZEf_zwKcjyhoOll95q-8PrM8WoCUgVXxD4oENMcjbTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sSvT4Alf20LanFBf1iwHg9pciroKlJZ6tEsM_cC2ZqA&oe=6A450B4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYcjBNcXCacQ7kNvwFpzdT5&_nc_oc=AdqgGjMXBbIDbpva21H79COCWmxyKpHpM8jEiKCP89XMcUN1MiueEzfd0HNznFYEMCc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UNjtmJP_oRADCNqYkRRXeG--FuYeZkb2kxhtBfL8Oyg&oe=6A4521D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd2t1X_VwLgQ7kNvwE4nWHf&_nc_oc=AdrdSKwQv2EA1x1fCX0NA6ozfIJTAkFRUKSEtp4vmBFsGAUKolx0OWKi0IWwDw9kyjs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JE20y9wP5UL2_WKGMXydK-2lSHS_pbGjmL5iRypQXEA&oe=6A452591"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IBTezNTGNoQ7kNvwFacel5&_nc_oc=AdpUjYfD5zt7a3vwM-h7Fw6ArzLTROPMcD6ERZlJ6AMZmfOK6crS8YJS5641IpCL1tE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NKdshMb6QjcLdA0JxW8TUGfeJN0MISF2QlvEfDVRX4g&oe=6A450A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_RZ2JytPxIQ7kNvwHAh4Wl&_nc_oc=AdqNGk-PeLjIQqcaLqoop_-iDyxmJRs0PukYWDv9JfRdft6w7wHmKB9ZM-j5NdiUZ68&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99uodbF2R6sfzkyeIKynECJH-lYqubkEv_qvb24NHTkQ&oe=6A45326F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
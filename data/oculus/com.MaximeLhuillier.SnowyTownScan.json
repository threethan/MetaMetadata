b=1-7&_nc_sid=6e7a0a&_nc_ohc=NoW4OhrBUhcQ7kNvwGkVz2-&_nc_oc=AdkPdkmfqiL5MHujUxm8Vl1tFIPe-3nX7ncIXvc9tTQmVOqYNiMFjNrhveYYP3TNJhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsf3eglnJC9Wgi9gPBg7-8_bstpgkzLJr2NLiB2nK5IiA&oe=69A828CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZW9s2JT1gcQ7kNvwHa42o7&_nc_oc=AdkYusFArxQj0fC9iHcUaB3Oakl29SCeN_Lp2TtJn9svXMp9ZZGymyPS4eNpd3JGe2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuR9DqZn0iX43yTctsAsYeA_BjW0ISPabi3-UB3rcksmw&oe=69A83F53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1o1gaji9xMQ7kNvwEYaDvC&_nc_oc=Adnughssfx7qotpfwvrJKF71QKBHDAPkxfz02NOIdo4dHAiIM-efX1xX5xx2KlpqJow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfueO2PALtGDqZ1KxBaGHFkFx_tc_Q2XABxyFeIP9dbpAQ&oe=69A80AD1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJjHalWzVEQ7kNvwGSr-0z&_nc_oc=AdmMliitHOyH412BLxOrdKQ3tsEr0LpgNjPke2iMsBjCd3UPX9IgrYxmxUaio0WUgcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfukK74L9Sw6QLJtgk507HsNbHV5lfLgBF1hD_lQb77ghA&oe=69A827B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb-tzCn8YDwQ7kNvwGplwvh&_nc_oc=Adl0iIQPd0oaUd23laK5_3ENeBUM3xdOJNbqX6k32kdJLPCIVJG3EPS5xj15YmbKj4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft6hSDhUT5wkopyKjPPgvTu4XJKBvOrnwFya_RcBWuuhg&oe=69A817AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
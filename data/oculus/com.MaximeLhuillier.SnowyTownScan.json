scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hYaZNKwcJMQ7kNvwEBDDgA&_nc_oc=AdqZ7pvH91LR5_OVOd3lToXJ7zucaTcg5ubAdCGfN1rqOYSrfYzPXguxhyBJ_uNEpSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA9_Uorwg-FGPjZPuByAmrrVggOJy1jB02TQInkCBQXQ&oe=6AA002CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5gE7tt-eNMQ7kNvwFROMlh&_nc_oc=Adr7zWOLK_YkvyuNpNAQJ44rdJntF8c2li1LJcPUGxQcVO3Vs_iJrbse9K6lohJn9o8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5bauiXrkPZUkOqVgfKI7-RbKb6g-AceX_oxRcXxYycQ&oe=6AA01953"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSPmzVVMbrkQ7kNvwHfkP03&_nc_oc=AdpQWI_hAE7CPwZlw3PZ5PA_XOh6Y4-KNwRkqEB7QxSwq-vKWkF7yDxVPJPUPRWHLkg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK45YXarEBql2L1t6DtFlEFXNSUkwVNHzxgzi6kGV9xmg&oe=6AA01D11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1zBylvlx8sQ7kNvwGHTVmd&_nc_oc=AdqSZCXy6uQTjh01X8n8ZUkjtqrTg35uIIFADDEDnHYQNj7kTXocM_JS3n-QUucwYMU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn1_lxE9IKe_sGD9qHuwbfBcDYJ8af_CcYRlanhDzYXA&oe=6AA001B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P2Khkz8m6EQ7kNvwEz5bRp&_nc_oc=AdrryhJ9__JjSiuedMN26mZWwjbfMJF0Vg_C1iePM7CISxkcEiRM5UuvSoTYZQXS8Nw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9gOiIIzpJbmq_7isW8yZNOC2UT1NcSSeTopw63qVmmw&oe=6AA029EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh6fhm19tKcQ7kNvwGS0gB3&_nc_oc=Adr7rtyEL4PiJEDkEu0afOGm_nrFr7iZbY-i-8X1vmf4bpLgGkcnJ0xFPyMv-fgBZfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRPS_vww7ocBQ9EmdPRvCuSQ5rxqNvWbz4stladUdccg&oe=6A6DE9CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbBj3BWphX8Q7kNvwFDhoCm&_nc_oc=AdpZ5ZNpZwnPr4AbcSBfdvVmXZtVKnxx1yZDzI8E24mhYxPwfXiilO426jZtxoik6Xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC39AKe-uXl97vehx_8QKQC6BHVA7sYaAo07wkd-AErOA&oe=6A6E0053"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTtpHaYrAcgQ7kNvwFMIHUe&_nc_oc=AdoNn77pMizEPfw8dj2194b3I8Q8iI3meLYnUgcq6eoFUAnSiY6j80_kNXV2J8h1B44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNaI_HZrUrBRbtKGO2hyrnFNgPgSpyPXJH59Z-B4CTDQ&oe=6A6E0411"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQP0ecv2IHAQ7kNvwHpfyPB&_nc_oc=Adq_niOfQsYYJJOn8F7_m8709dcDm5rjaew-DU5huOUb3KTDAZo25umDLKG0E7V2DrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx0ACVcSL1-93N_10AlI1QPQjo4W9Q-moV-7dMxFQLcg&oe=6A6DE8B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2ZJI8Egl1IQ7kNvwE85H1-&_nc_oc=AdpPInww4ngxRG6lnDZzagekIhpkoTg8glEr1yVRw2Qqh0QSu1FK4Cqw6gM_h4J5H_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsTMYO4ZSlPsfzvlRRfqzH1f3AiHsXoB6LLfFtEP-d4g&oe=6A6DD8AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8d6L0iLFuoQ7kNvwEX3doD&_nc_oc=AdrAUAeOi0Jq2A9aDQvegQQ_X1f_R8j5FVivgjGXVLRMA-3o6W-81Kqp0TheDV-yUc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCikftnWpzynn5vJKHwcj8TEoT_kQJN5cYcAWfbCDbnsw&oe=6A69F54C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvW1voF4FNwQ7kNvwEJZ7e3&_nc_oc=AdoNFZy_ThitsdasxpXqzL2JpxVDyaaYeMm1Gh3GYu8rafbii9Qvhfmho2OXHdCDMDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQv1I8eNHf3eFVrVWe6_4qwk5RBmHMugixMnfp_Z8RvQ&oe=6A6A0BD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pdJ-YGjFMkQ7kNvwEGviwr&_nc_oc=AdoYG-pBgXitO58CinGnxHqQlTVBgI7uYm0T6h-h4EYZHjgDtDjRidgEPrCtjn8hVbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH2FLA7wjk83MvtHlM0Yj0G1zCR8BO-mbB-Ph782zl4A&oe=6A6A0F91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvlpUCgBTncQ7kNvwGO8bxV&_nc_oc=Adrs6lN7yWw-nuN3aKPMKKrd4b8I06ahh26fwWr9IuWhB8JNmd_h5UnNvAYMicknxcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBP4t4ukEY5pRTzWghAmhc3vAlPuvkEJRamVpm77TZAw&oe=6A69F432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGRwZPSrRzoQ7kNvwHuHKTK&_nc_oc=Adpp6Tnf8_XiXNXjqXIKgDbNXGNUTDuQCmqfavRkjL3SI9pl-4sdyRnvXxVhY5oPOZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjyWzEEDk0KJCPl-r4pOCqUHI1aZijEbITJ47TumAfpw&oe=6A69E42F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
b=1-7&_nc_sid=6e7a0a&_nc_ohc=xdv7zczx8N0Q7kNvwG6lKFv&_nc_oc=AdklNZbELUEQvXm2MwEOC2k-kE5_wrguMPN-3tR8UhhVjIK9ZDqifZ6jYNaumHkvrEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSUAkcEk1Wlf5PdbXvq49IhM-UA7BQ7gNf-IZvARxlng&oe=69B94C4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFChgeFGsWAQ7kNvwHuGIYj&_nc_oc=AdlZmO3I5CuFlRhxeOSaCzsks3QG_t-AdcIpzKT8qlCjamxpp_6tA0afoiXO4iZgT94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdHhzv04BlISgMcrHqiJoBOJe1ljcxUmZ7OtiTv7Ig_Q&oe=69B962D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJrK2XRcG00Q7kNvwF5DoPq&_nc_oc=AdmijNJS8jcrbo_qpbtG_vcG_cOFz1WpwJYNVtrnCyLoA6hl6HyWYe84NIJZbFKzJ68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNjgHOtltPGEtM5lcifVE9mP9Rkl9p_4t2to96-Rn7zQ&oe=69B96691"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDq2HJzgSboQ7kNvwG3Sl_L&_nc_oc=AdnYVKtb0r4EtBfkc8PMmldKAcBgoHzZvT-UXnBeUK-Ow8IlH52p4pwPecWdjxeVpBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkB2nULfs3vzxFMSaRVKw4ENfhdLWdsXxbopIRHxeP8A&oe=69B94B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDdXTdQuAgQ7kNvwHjqDQ9&_nc_oc=Adkz52Yq1asQmsd071Vkp32eOKaDq4NrHYzsl-fbvzXdCx_HNhNyafzYFnT-AtdCKzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPB67X8Yr6TAs1pOJ0CdtldNxmVjKgD7R32X29UUJA_A&oe=69B93B2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
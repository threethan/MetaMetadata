scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-coAO95fv34Q7kNvwFbujPb&_nc_oc=AdrRa-p_FuxIwWoebj7wP_6KPTKeCCqCoMmh69DBO3szTvPjpYHH9YI488V17GhAS7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z3p3qvRXzaHrenuEXUZMo9nrSNU1-k7dGdq6-UxCkaQ&oe=6A2415CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxfvjIh6t7wQ7kNvwF1tts9&_nc_oc=AdqWW33w30UW_fV4wGp1hUFEdC22eRAaXyZPhaASv4ZnqWHewRL_5Uh7GcRfLJr9cRc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b2tLycNE2eI5cHdxykFXY0JJG1enP3ZZUSTMKtPm8kA&oe=6A242C53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FyjY5N3h6UQ7kNvwHt6sIf&_nc_oc=Adqy2JkX9y8Z3b4WTcq_4fgparLoYVlbY4qxgpFYM8T4EwgCd3ukIgXSd538KDPHvqw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g4PS_d_FMrj0aXL52QfQfs7eK37DGlZeIdkGYkqTHHA&oe=6A243011"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVVYaQH9xjgQ7kNvwH820L6&_nc_oc=AdrFBH5IqnC2dH7RVqO8x0M5PmUOtMTmh7glgZ92XDSBzSZ2xxJKzDUZvjJn1Uk1rak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YvK4rESCBhKDydP78X69NWdBUnGj2mShxXzmvHmVqLw&oe=6A2414B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrFC6boi6l4Q7kNvwFa1pRD&_nc_oc=AdpHyujtgoQfpy-7zczZenvl2jSGzwxU178HzjJVqKZLGqTpswdPx8jgFQGRC-QFziw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tIj3ppCebuiu1wMnLN1MLWEd3hxuRmftTjH5-f99zKA&oe=6A243CEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
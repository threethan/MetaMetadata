scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zASw23EecpsQ7kNvwFVWBBS&_nc_oc=AdpnB3kc3PUVBGbVtatxVvusPNIQZjsS6NvHdtmY_tLuGbxCRC1zVriCVVOoYTYH-TA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMPyzEaaRbUtP0L_9xMgyYQYmhhkVrOHa-2J1FqIDj_w&oe=6AB66C4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxdYrhbaZ_YQ7kNvwEpKT78&_nc_oc=AdrC-u2iYou6ut_eTNY_UjtifaEB9JPXNdfjyBUZxvOPtJd7vRqMOogsX2ZKD7j2Njk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSAN5v06YIdXex_Og0Uww5yJ4z3ISE_SU9WNu5BIghnQ&oe=6AB682D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-mGrwRRsNYQ7kNvwHrGEOp&_nc_oc=AdpzSyjSdQaCcKbtMgify3XTnnuSi4Bj2Xlj1N2UU79AzahwnVRzte_vw8WsWSQKppw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRk6FieJ1PfGVmwLWzKBa-LrCSTbVpTkXOFCGoE7TA8A&oe=6AB68691"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4O5vTMiyngQ7kNvwFbjbxZ&_nc_oc=Adr7rVuh3MZVdb2WARF-EpUgFbRvEZm3ZijHpm-yR6PbSfP4VSwXeGFY4wa8Isv_Iyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL09_ozyh52OM3MC_suSTPv1HL0vWhFVaDDQchGvTo50w&oe=6AB66B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paQ_Ox1THsEQ7kNvwHF7ao4&_nc_oc=AdouY-jJtFJnAWT1s3wScOfFKRW4GrT_sDy3m7rjBdOJEw7SQWfmgLzvgBnGrvzxXds&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1xiLug3jTd3M3MCHwOZE26XYzNqMlUF40P79YMowAkw&oe=6AB6936F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
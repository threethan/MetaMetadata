scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QsHoKBuCogQ7kNvwFh1p-9&_nc_oc=AdqxBELubUAKDeYcCAwEvFrdoEiTdpmZ9Gols3Vj_UBEcZ2PfETdQzVLs_Ida6bkcps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwsEctDMmYsKCenHbqJLPW-Rk2fDGZfKOIpEDkcm8iAg&oe=6A98520C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzL4JSiQaQIQ7kNvwHnQ_Eo&_nc_oc=AdomRu2UmtpalcKMyAyg7qkOjA64Xtbzx8nKKA0FWBzhq3TR8Hs4cyPci-o5blhQFnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN_z6QbxRJKTFoo7kHDfoSbH6BmUfEo3JdVYIry8lF_A&oe=6A986893"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mvlsiF8egoQ7kNvwF6dsAe&_nc_oc=Adqd2UPvCpJUADepQySojIHUliwsEG37tj8XWmXQpbPSWxCGwicbaIcHrWN4I3J6HFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo9rZDPxPconzMVusFKZclJTc6z1smt1oFRy7LQJh0lA&oe=6A983411"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfNQkO24FIEQ7kNvwEBwy2K&_nc_oc=Adpwk-d9G5uoRwv_TmuZ6_B5RMkUcTrZDBPUJ1zi-hAdS6Kd-DIN2FMsqA4mXZzuCFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKastcDN4GYo2KM7zF9V9bN8KYI8NMtdFEMbBjYTTgpyw&oe=6A9850F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f8cydGO47oQ7kNvwFGCnfS&_nc_oc=AdqZcMbTI_TVonEN0C-gd_KfaIZCrIx0_u8jW0cLlKHIc3MLb_3ug3wFyJCP-CKnU50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp7Wsq458pwy-4LvEfoeVLjZmbnR22C-bEt3uGLHpWbw&oe=6A9840EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
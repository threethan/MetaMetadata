scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb-V0jTwzgEQ7kNvwFuxVb9&_nc_oc=AdrDAURCbUkRmTX4ozYjC-f9PKwIAmvZkntjehxOTKKPgRDmVZMHHXkXxWU6-oyjluo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBFsC4OOuTvoA9yVMuy-G18Vl8HICSDkcPPlovVl1Bqg&oe=6AF49B0C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6BP_58y8PsQ7kNvwFUMmrb&_nc_oc=AdqA4E3Tnzb3g8EUvrD8HtCwPw2utF7vqIg6gk7jmZE2uY2_QfDxh4l_W_aYaRBZSFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNvNFoQMM55bz1PbUfJM7tBpalrerznY64NbA5SHiVCQ&oe=6AF47953"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaYaf9NurjQQ7kNvwHxCqKY&_nc_oc=AdoCgYb0JlGAqWcoRmuEUKXJsevrjbcNYL0JLBa-uV6CVcir2Orfl6PlhOV_lv1NMnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZPpvIpy9yRo8deaZuazVKZsTbZvMNaV-esv6DTmbvvA&oe=6AF47D11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UWQaNyjV_gQ7kNvwGD9uKq&_nc_oc=Adqe0vWvf68j55szSB2Ef9mZrob_Y7lNS_6otER9ZZh8AG8kkrk_8Dgism5NHchY2Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXsYz6Ld6GjYkxKDQCoIshhI20x0bKpL3D-K2man0zdA&oe=6AF499F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTdERkAQFhYQ7kNvwFbD2ee&_nc_oc=Adoez2niFZ3012EWT94rZt4r7MuhaF-ICql1VdnL8Oja0xgaYqleFEnYatp8NGe2zAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLZ2wOnDInvyPcWyeAaynl7hHnmgg9x8T8QGhLTWbIyw&oe=6AF489EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
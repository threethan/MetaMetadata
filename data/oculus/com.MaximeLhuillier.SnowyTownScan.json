b=1-7&_nc_sid=6e7a0a&_nc_ohc=8WmLDM4FnrsQ7kNvwF2MVAm&_nc_oc=AdmrYgSza8lEwh4WcXrqUvLUoKjQw0SFjSIXju7OYsdkfDLEekyQjqmRfTvRfka8R4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIx6nkYGa_DweQzMXm38c5FSawQK3ruFaEw7lHqIlXtw&oe=69BD40CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdqK4eVzWXcQ7kNvwHZwm4K&_nc_oc=Adn7_Vy7AA2EtJTzYWDkGZYIgCFMTxPxJvz5E3u4d6FItuJbPmhnWvyzb7qlKKfWxEE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgX4awdXPXvP28-krnnUFQnKUV6K271pdE8y98BmLpwg&oe=69BD5753"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYLJbVYfZSAQ7kNvwFqjCPP&_nc_oc=Adks4ltH-ZDfJk3gVRvxo44tTdrSZ_BXtZhK-9kA8RhUrhs-LQnCz6qpy6dV7UU9HUA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEDTwwHaey2ir-5jeNwQbgbMae9yW2jhHlOXG2WIYmlg&oe=69BD5B11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vrJ_VJYxz4Q7kNvwEqnCVm&_nc_oc=AdmLuAKHlbxp4CmUeXHdwod8FmBEf5j11356l-ieNY_XZ3LWLagkhMtXwxDcEzd_osw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl-fc7vmpuiApvbkE9VS_lcPhknxQQ46ZmwHuf0_MaEg&oe=69BD3FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOHFSlbURkcQ7kNvwGngWMQ&_nc_oc=Adl3DBO5GJbNMXx5Pyf0HSyhS4gm8JIXQ7Sl5cA67b0ZIygGNpUQUCpPXraP01NY6b8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZd8jgYX86h4p_poJJEV3eozhPoDAjaXSocqZDoPNUIA&oe=69BD2FAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
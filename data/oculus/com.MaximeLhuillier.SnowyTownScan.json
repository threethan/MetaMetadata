scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrSNccvwp9QQ7kNvwFric97&_nc_oc=Adp2-Q1L2OrB4F1_WN3x7q1OZBkYl6ys50VlScZ7y_XDlrUQ35XcwRVscd7nk_d-N3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z6laat_fT4mhgoZuTpqpYqfrVepVu0P78BwoIovMwUg&oe=69DB934C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu1sj-eW9c8Q7kNvwE2y1OY&_nc_oc=AdqMyoCyQcj_3Lce7GAnlsjPSFzLaqYutkou3g9y3H9jgQgrNvhfn0jW2pQA-fNiVuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tp5_IOmgr3BsdWD1eJk3W0hS8U_tU5-9SsDYfb8rbnQ&oe=69DBA9D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeULO1TQoH4Q7kNvwHoPwuD&_nc_oc=AdpuxmskjmgUNZ6FyQVEVlT8y097A98r-keh_uZgA1BETZkQz6U1L31s5FF1gaYGQxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IN_BDmpHihzVioIxPyZjlmeim6230__0nb79g3nWesQ&oe=69DBAD91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AumxwjnQ3hQQ7kNvwE6QmsD&_nc_oc=AdpKmbFKTd43516mBt5Id_fmbb5E8V8fKAkpbP7TvvRHJmzHg23C-JU6KMmpF9UOGoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VzhQihKvGhjGk_ziAavKD-0fxMROGdcx-QTvFEA4veQ&oe=69DB9232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaVFaMXDXi4Q7kNvwGstqAG&_nc_oc=Adr6YXyhQEF9QxYu9Od8M-t-BtdlyFV-4wtiYp2EIux9Eihn4ZzaMGT8wvFNH1OTf8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HahENz0ltfI9Z3Mv7OaNJph_9NhsrHYCeIv63vTilQA&oe=69DB822F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
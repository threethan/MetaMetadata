scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWuJkBWUW8AQ7kNvwHJErir&_nc_oc=Ado_jTnrNEtfgCl7g-jotRWqFItYD0SlEh0qf3UGHM_NQHyE9J1pffjk54Rnxhr6A40&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKo68k9La1-4gaeAqMBpUpionOjrGS8gU_NraQBu9Vqg&oe=6AC7C80C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G80YzNumI3kQ7kNvwFnHiTo&_nc_oc=AdrUWVKkLFPtSjTUQUzNQUVH_ttjG1XshyjQUHvapXaF3Ub4Krtyry3bvXKuHQAf7Is&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnXdPgdgkPR8EDNTcV1tC3AOfF62qj3wPSWWCfb4XKdw&oe=6AC7A653"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z4IcTI89i0Q7kNvwH-wFVJ&_nc_oc=AdoaOmvlVM9KTYVDjvpPycBbZZBslumPlFLFa8oWGJ0ooOIg_QfxmtV_Ah91WkYvoe4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7gEZkN3-z4GrVJZwHWeKJ0sQrN29DSQXtK8ZsBttcFQ&oe=6AC7AA11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D36KiOzrDogQ7kNvwFfD1ml&_nc_oc=Adp9daV5MR6vs9P0Q0Ujk95u1vDRzHAov9eAEysJ0_q9JLsIDz7Ng8mpIMByzyr3_YA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN7BLE_bIy_xGsYcG7ShTyJX1AoEu2aHk2cldWYCBIpQ&oe=6AC7C6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y5Ukr2OaxMQ7kNvwGyROeJ&_nc_oc=AdpOlhbCnf8sjt0-ghl36n4WqDuQQ36f-XTV_935ZQrrs0z9Y75ZGZPOOloGtsQdJmI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjTxL6rRp8zux_7leiS_SDJ02i5xrPEDjXYfKYcqhxQg&oe=6AC7B6EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
ntent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q50zLy_hR6oQ7kNvwFPV-GH&_nc_oc=Adp4KjhNp46DjKSZrI007TJeX2OoNl3dhpKThTCf1TbAbp3NuFwWN8IencPH1S_Jpuc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOGSk4EkJbU8zFu6kpQKmCxQw56iPG-8DzngFw01CRww&oe=6A8D8DCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7rMvRNe1I4Q7kNvwGuoeDf&_nc_oc=Adp24nUaZ1UcG72m-h--mQzV4Jjg7m6deTyo_Y04iNDpRIHZhtuWSeorh_fPjr3hHOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9xi2bQYvmNEgGAuerH66F_EnOHmSlwxsu704q1tVrSA&oe=6A8D6C13"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Rb60N3y3cQ7kNvwFEwK5j&_nc_oc=AdqmwkqBKnuJ6_vG6JNl4cNYLsM4I9Rw8_dO1LNZyjj6siEQOUyZao4-B8bPsl20Zqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsb58AcNQ1CgeDb4rAACX7vBvFNC0KIXD2g_NeR2L1Qg&oe=6A8D6FD1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wka2mmhhIxAQ7kNvwFa3qPf&_nc_oc=AdqgANRDE0atwucf8K2XNewY0-2mWDsnIgP30KDVwEH5zKukvAxRsqIrWv7snq9iHwY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfBUJcxbCmCKKiGPTGKhN5_22f0OuKU8FlNFl9IvOjjw&oe=6A8D8CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88GpbrqeGnwQ7kNvwHE6VhN&_nc_oc=AdoTQcTTeOwdPYuT5Q41nAYj3vE3ABkl_tgdHs35M69k8Uyww4x1d4YdcxookCq9dcM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg_-boj6IPYPnUxNMFNo23TAjxY4SeWR-hMm5cVCkmGg&oe=6A8D7CAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_
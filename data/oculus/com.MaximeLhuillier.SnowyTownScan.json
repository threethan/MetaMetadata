scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C4SrNHEvCkQ7kNvwEBgfhB&_nc_oc=AdpFVbumZRgjeyAgw3LckpXR68pvIAJiJ-O9UpwBU0KUC1J47NrUed_an_OaxMLtk24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR0LcL5RA86sa1h1yOiMn3-9pYTS1jhqw7ETPkjosGKQ&oe=6A89994C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU0iUvxIqfsQ7kNvwHQXAXQ&_nc_oc=Adrzobnuy6hoSLA7Q4XtgeRZJ-6PiKBjUFcg2o3KyRt1dd6ETXpnxX6u-cMMVhlZg0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYSnZQkD8nXsihfqo7-3WHuI3o5Pjg5sbAtQDhqE1yqw&oe=6A897793"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EirLIe-ol1UQ7kNvwFZEFPe&_nc_oc=AdpIMvjL0L4n0JnZ2rgWMz_EDgHvD7RnwLtb3KBa2FmSRBepHDoQpG_5kS8TncQSktc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9I62WsvvkJsTkJNGJPu-n_X6NXav1u1Q7ldwNdtikTg&oe=6A897B51"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lljXsmb9BgUQ7kNvwH2kiuU&_nc_oc=Adq7fqePRD2hGTfkrzwAMJYv0e78axPSA3RXmHnahGhrr2jnReUWNttMsekkzt59Q0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLbaF1dFKYQwHWTDGvgDZtwR2QRPoXN7XcWA8ZL7Hj3Q&oe=6A899832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdIr02dO8dQQ7kNvwG2HzA-&_nc_oc=AdonD-X9VLY4m-mE2T12Z6fewxjvgMXQgDbw-2niPUrRSIT_5uguVfgCxBBtXsjpOmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSidLc5-PPtLpFwdaRJjKJNNaq4Rx24KsrzhfMix240A&oe=6A89882F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
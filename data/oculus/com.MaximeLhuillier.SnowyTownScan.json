/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJeL7ku5owkQ7kNvwET2LJT&_nc_oc=AdqWnZ5kLSqs_rLiMp2CQdIQ3MWPDdTW02Krj7qeZ_s9D10N6b2zNlWiId6zdOAKGKQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jm9Xl3BFJJfyj9bo1Whi8TWZ4boZayZTTFAJjA1kd1w&oe=6A465CCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYcjBNcXCacQ7kNvwEGWMNf&_nc_oc=Adru2GXmKvCSVj1PZYnJCe-gIvKs_h6FFYXGTh56tILp_uD47DG5bAumV9YR8NGXKQU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gsru90eb6PocGX8IJYbJL2txM-y97PmFIWObus_O6cA&oe=6A467353"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lG0pIDDD_cQ7kNvwEvbHbW&_nc_oc=AdrXZiPyR3FuEdJist7t-Evh8Fv77GVWRd9tR7Y2OO-sirW16CnH8XwP9v4jCakq1X0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J7K89uzd7hI2HKgBIZAnEA6xOg4vObt_8UUso01scVg&oe=6A467711"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1JtGYBHnjoQ7kNvwEbK4-f&_nc_oc=AdpUQDCfjpGAH1IYzELxI37FHL8BD6UXXXbMN3WothlNljUC4RIRn8vsbhJXAoZ6Uo8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DB8D6KKuxviG2bU3Xfw-gmhJrogzDTKoXEynN1PCv0g&oe=6A465BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZejiIzOxjkQ7kNvwGl-QDl&_nc_oc=Adro5C9_zRawQQJoRN4nFPtVUVEmh7dj09ju3sI6oSBoHtvOTyg5NtnjgSUe7uESgJU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IcuvASoKyooe2CiHN5vIDRHor0BOLOESr_fxjOtCDNw&oe=6A4683EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
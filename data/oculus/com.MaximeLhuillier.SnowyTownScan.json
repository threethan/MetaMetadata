scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XJbKpn4w2UQ7kNvwHmBXND&_nc_oc=AdrGcShtZwY9M51C_UyzjE7dku6IhNfEGhJ4LHUViqz8CJ0Nfj4sWytp3GcDyzKXdlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87fEBI5LWiB1saYPv_b4SCUZT6l_0SJNMPbN7Vycm4ng&oe=6A280A4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8eSa-CDdhgQ7kNvwHCdzr-&_nc_oc=AdpEaroC79c8aY55K1K1CKzERfF0LPq3FM3XYUPoiV6of3DhO7bY4WpxNw4I05JFysU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ftlXgKBDSYQ4wXqn1fZikmJd3TS1OStwGHqbrxJeF_g&oe=6A2820D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azO2rOV48koQ7kNvwF0rvEd&_nc_oc=AdotvivkIALKWoDUjZGPvZFNRdwf2yBbL3kESOjYZhz_8i2Xcb9xOHHVW9GREU74BcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0wb4MOgkEVzcw5Y2wwoQHWj1Ay37VSMcCnOPySQQpIA&oe=6A282491"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG6BVm8n8XYQ7kNvwHVuHO9&_nc_oc=AdoHEaq0l3SPTDqMKWukps58lxB_F2swB1Mt8PxVzKS6xl7QR5t4z4Ay5DD-RWnBjD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xicFvl4BioMF7jREhmeq5AgrtEfrcGzkY6z5lBIu8BA&oe=6A280932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX_CPimezAoQ7kNvwFdrEdK&_nc_oc=AdrMk63tomc1tNnUc6HXgv0VNAShK3uqfMmlfRkUSFky0Dp4aJwu1sdAVDRa1flMCfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-StWXVXhGlLe1oyFbIxWZzBmUXfJin9wdDlGJhY1QuDw&oe=6A28316F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
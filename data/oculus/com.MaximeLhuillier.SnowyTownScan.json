/scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-kCjK4BJtwQ7kNvwHmY8Rr&_nc_oc=AdrgnVeedKF80ZdTrKAnI0OmQzIbXoWDvNchjeo8qtxTDjItQnkh5AtqTTccAD6XQn0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dLMdw_b4n8DPZ-GOGfSY24YsmXztp-D08PMenloWQxQ&oe=6A392DCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYUWc37OTg8Q7kNvwHL5PXr&_nc_oc=AdosVa5YZs2EHSne3504VHlN6srnZi5h7M-sf9xV-ZP-n4PZ9dyljOx_nJ4KD3obzYs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7Mqt6GvLfQP8_aGajS-LO0CnY5R3k0gRWe5ovSsoFqA&oe=6A394453"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-FcSzPCPVcQ7kNvwGGNr2h&_nc_oc=AdqRz9FMbR6ioYm76IuidAuPjgzWpuoQUqVgKy9vYGaJ64ZNAmr2CDLbZ75BPVeN8Oo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af829l_52ORPQRhJOnUqrhCPQpe2Rieo2JqFMYkrVFNq2A&oe=6A394811"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQvPiET0b2IQ7kNvwEeDyzL&_nc_oc=AdojMPVN2ZHzcK0rjgTANvG_MlAd3t_iZe4sPyhhtwisds2EgGDCYlaYQ_WXvlN1y_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82NPozyPhCYyapgPgAWEZH9lG_F1e-78k9jvRRHoAkVw&oe=6A392CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfUhS8a58y4Q7kNvwGdPBi8&_nc_oc=Adr3sEOCp2hzrCmG7ZtTe0U1ynrcUSbyGbXs_rA-inb5eMSVdlPkGIAjR9O4kvDPJYk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YktqLP-nAhd2s8luZ8BepV902pqndW9SRDfZ7B9Vhvw&oe=6A3954EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "exter
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zASw23EecpsQ7kNvwHqRBl2&_nc_oc=AdrrbzK-JjbZDXZ_hoB5MeGnd3EC7htVtHO0CiGqf8SdVAweBf28hAYU42WzZN7nwAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsAUOHdKB0BfQT3DV-yvM7kKrodcDWsM7SDFppX9XMbw&oe=6AB3C94C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-mrNsuTyJ4Q7kNvwEBa5Gp&_nc_oc=Adoy3EKFMe5i22_XHP-MIAtnu-TnmbzjoNWH_qRja-EvozV8g0LVX98oEl1GahcjRqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdC_er-e45sdkCBDAhUIIy9c93JflfXYoGcs3O7Wx1tw&oe=6AB3DFD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wQaaJTYuX4Q7kNvwHOQKzu&_nc_oc=Adq3rk2p9sDzJbbHwgYh2Gzb6eR307PQdvGDBSZQsXll2fGRNmzz8O5knvjlKpcszd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQdf7uKkGsOxeMaBgz1Lb7a19KxHJzyqfDRYn_P2G0Lg&oe=6AB3E391"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssjKvUvFN9EQ7kNvwHhhsLy&_nc_oc=AdoBzVDIsiN6u1tQfFdS_Hy8hdLdGv_Tp1aGM_9RKLSvzfn8dXgf6nulHLnMeSdUh4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDmgM811JoTdIyXT0POCeRKHynumqoj2bQOMgXqmTZZA&oe=6AB3C832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-aPHf1icWEQ7kNvwFFTK3E&_nc_oc=AdoB7D-1MfTxB-Z6gJYyE438vRpkWcicqHyE-2uJPDzZ0mjPDeI3a-l7DeMlxoWH_Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKByNpXnDyTbiyJIK6WqHMJawivySxOR3pBRmV7mJWfqw&oe=6AB3F06F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
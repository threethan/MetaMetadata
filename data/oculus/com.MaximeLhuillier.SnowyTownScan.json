scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WSnEZz7sh0Q7kNvwG5WCRx&_nc_oc=Adq9zdzNQf7g9UEGRB__rFx9Q_Ixp_b7PEuF4UZwirmyWSMt8wFm-fOUdEG2ulmps-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz5Ej9zf64BnK9NOcQ7B6pnB_wnm8ca65gS-dUhvA8FQ&oe=6A79C74C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrsDj9t2j58Q7kNvwEby4Hp&_nc_oc=AdqtWs33vaA9Hyc0MSX3eSHtzQmA87bRNhic3FBSxq_IwwF9u9TbnkYuDvMGinkpcFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOfyFVN7NzEe3Zrey4Hrno8Y7DUNoGwkz7zoppMPQrwQ&oe=6A79DDD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijazb_dh2x8Q7kNvwFcw0pD&_nc_oc=AdqRojiNwkY-RH3fr5Z6gff-e6QcQDKdaVZ9Zngr-_EVfeHgQGEIM7jptYICaQGYJmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuQ-18aXKSDeGsqN0wNysle_sGEyS2fMyJt3UCtx5Rzg&oe=6A79E191"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI227-LIBFQQ7kNvwEESz4V&_nc_oc=Adpafm7d93Ro_2s4hSpQmtbjsYanWaaptcDjemgvkOnlJ1OTaulMLxHCI2ZJAJkR1JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERIiecRipKRyIX1cc_Um52kCe4i3M-wwTVb6LvqFk0gA&oe=6A79C632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMAfz-FwM08Q7kNvwFSYOLK&_nc_oc=AdrRSwkcUPoZX0-CBWYjxkoD3NnsOUMIGLzNklzm1yrvor_94LJG1ywQiUoDQURWnAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEutDIYMjBIvmbkgVM45eeI7ydowndmQ6BtMqaan7Javw&oe=6A79B62F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
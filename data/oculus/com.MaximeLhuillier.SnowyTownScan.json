scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8d6L0iLFuoQ7kNvwGEXNsM&_nc_oc=Adr_yWmSY7lmX3WmBAGCtgU1oyYUE9TTstDvlalau6XUPQveyVfxn0aGRUMtUlaEepY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn4OTvOO3JvDdW2LpRNBI6mCbkbyS83fZWpR0ZSPFovg&oe=6A68A3CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvW1voF4FNwQ7kNvwHKP8Nt&_nc_oc=Adq6ZUKoa0MtLtZQBZjA9vd2V0FkKh9JO1iDgcQF8L4tCEqzzxcXwNrxlra9hSK_Q-4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRrqkGo7AjW_1u36MfXqbvgR-9lej1f3CnLdJj6kHtdg&oe=6A68BA53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vEbnTjg4FYQ7kNvwGWjrPF&_nc_oc=AdrcLS8wGYbFG87kmJh_BLxfPdeInSBJfz2z9_FJeCk3YM0GQg-DlUriEFLTTAOWMu8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-YfhNhi5KAAsf0mrsr5beP8mbwleTBcKcv9AVq6Q2dg&oe=6A68BE11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LhdPODo1acQ7kNvwGs1LSS&_nc_oc=AdpAGk9dgGllPe6LB60RC1R2R1PVPVv1jNpkMb1VcLslLMaG0pAqY-nqUyzREPGUg00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkqlX_yaEY4v8cyb6Gm3s8Z5F9x1DMeP4n6NGBLQpFWg&oe=6A68A2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNPwALfCWp8Q7kNvwEMYFHX&_nc_oc=AdoSn9FFEIdXCcQYLUFnVCNR7e_OeXLfZrzKHcLTPIcw9cIoI_MZo2WCmirTw93NAjs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7wyKLX07Gb-jBGUfQ-hGbAIjJpafkjLvVNoJkCAW1bQ&oe=6A6892AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
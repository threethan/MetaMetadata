scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Dg8l8zxzGIQ7kNvwH41D6Q&_nc_oc=Adp6Mz0W621He3AHeSH3OPqOxt6nbrpFlXtuvl65bTpsq1vtVGTDUx_R7mLK6WrAR2I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49L9p_tR-3S9Gn49flZI2mwyDNvKbN-lLocivQ0A7DHA&oe=6A1C2CCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnqU3gYFzNIQ7kNvwFaDbsO&_nc_oc=Adp2P9-f622zFOmYI7HObLyAlA4WvBVTEX8bPAivWbXxFxZr6qQNXBaHR0wNJShsFzs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D4Q-h2rkEUEDQut876Bixo0-CweEbY-jtk5XanXqGjg&oe=6A1C4353"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiS0nXjyankQ7kNvwGY4pex&_nc_oc=AdqoEB-wy_A3asCBou-C-2Moi0BLCOt2t2Ab8z0pCxk9YLRkrtT47VqzyL43fv_2vRQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sOZT5J5b_lh0njr_9beRWDIxeInL1luBYraZzZnNgHQ&oe=6A1C4711"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES-oAHEZykgQ7kNvwFc9d9B&_nc_oc=AdoN10bUs61wGkZFlUNZ9nblUR-St3DDL9nB1npJmaYxAw0ey0P8NQP0Y-sUPfQhUhM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bpfPm9-4o5ZN7sWVA207DD_Ugh2DAp9XCwQXYLoCBVw&oe=6A1C2BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLoT76tXT1kQ7kNvwFzOLTT&_nc_oc=AdoD_J0HDy7cI4vNiLKvYdplilM-K6NxxINQZu-ODEJyQvAs7YAbHevmXqs_0aghMcE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lw0psHtGiuo4iYt4RMhm2TOpp7YbSBl3ypMCKNWeiuA&oe=6A1C53EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZguMwIUDbYQ7kNvwEaSEYp&_nc_oc=AdpzVaSfgMI-0HAnH_JrPVLAR94Wz6Tkqtl5nEQzffpf1YCDfDmKPlclC4GL9S9HULU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxETN-oXzB6Y3Jlhf1rkb0PBWxfXpXqLy89lqFW4t6TSw&oe=69CD12CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p3KWKMtgJMQ7kNvwEmadPR&_nc_oc=Ado46s0IxqJICdBzvnttjFmlRrfIfOBNW77NkuH9yLKRGoxwb43C3aBQs99fx-x6fZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj1gcFk8xhUI6U9SBwXTW_hDZ1WExadSVK86FZkMoPDQ&oe=69CD2953"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kioCeS0rhQQ7kNvwHfN7uI&_nc_oc=Adr4n6GvBa7fJOAdmEFdsjwOnZ06-pkJwyzLuFqKHN2JuxiMAsw0mYdumlttisue49U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwM8kqdzmmtvh3WooDxzNi2t-2-yrTZlQrW7uwxLznmkA&oe=69CD2D11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjCwUR-CCVcQ7kNvwFbJxlJ&_nc_oc=AdqdvRor4GJ9DoMX_6YtljJCunWH469U01-sLH-ibH3tMQSl4_a3KJJr9opLH5a8P8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzinf1UIEcL8WQOCe_5Mriori7nIACUXE8-FUR1SXTWtw&oe=69CD11B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5Nz6a5NVmIQ7kNvwHmH5gu&_nc_oc=Adr3VpGVkoT7CSQ7IdibeuXZ5Tx8GojLk3ob-h7Yi1iEdpmRQy4Q6H1CO1dlWX3QoYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnAG7uMXeRBI0TKkqse89F_qTMb_2C-u-tRtO2Td7Gdw&oe=69CD01AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
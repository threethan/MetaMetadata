scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JZfpUF-xSsQ7kNvwE-6taJ&_nc_oc=AdoPf4FpcZzZ6UZHho4V9gIZrzOdn_u9jutZFyg1CvF-ZbcRq8YaaV2YPJze_wf6pOI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eU0fWflyAeKENxyY2ohR5jiRLYU2vVpqqqEDyUffQtg&oe=6A32964C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X60AeMRuKKMQ7kNvwGaPDsx&_nc_oc=AdrNzZvNBEIBZC6HcTCy85j5W0Ry9Bk5A95dXlDwzCBtSc8AfIMs_3hB4RHkgTmlRzc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99ILNKASO-t-eZNi2ySaiMXSCXdsnb5_l0P_M-CwMGOg&oe=6A32ACD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCGPFVR35osQ7kNvwG33G0i&_nc_oc=AdrYm0zvwpFp2012yqwEC68CEBfTV5P19DxD165iphvkns5TIaV0Ra2Wq-C0TWH4ers&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AWbDyofIpMfpzz6aWJURfR82BkT-KDBU3d1-K3Rc6kQ&oe=6A32B091"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6t4GnbV2-wQ7kNvwFjGqBB&_nc_oc=Adqt_7uJTXdoW66TfwOKIEDzStP9WW6vZzr77dNp4bP6hY0jId_t1HBim2uzxm9VUyU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--zcWAc8-U-_UakQifPIQBEM8cUtqnzWC4UBJiM2iAsQ&oe=6A329532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGxcInPgms4Q7kNvwHbP2ag&_nc_oc=AdrwdBK0Y3D0DqTjo1LcjP1DJXz9v6lLKJR4zU7hy5eKNumBDxIi8QPzvkuuumVt8EY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lIlT4JA6o3pV9mLohTpIMovo6FmoSYxP6E0_i5Vjacg&oe=6A32BD6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
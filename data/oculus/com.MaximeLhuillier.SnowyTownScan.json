scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thu10OQdYTkQ7kNvwFU9HWC&_nc_oc=AdoZJWV0L58q7UUxcN-UbzZaHmWAO-ZOIFNNm_EFzanfSKW-DmXKZEL6wnFNyg4t1qU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3UowLERF3HdZnWRbettidCo2fyKsOGDyUVTzIOjukTQ&oe=6A9EB14C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5gE7tt-eNMQ7kNvwE_j_Y3&_nc_oc=Adou5RooEYig4Yn_AXycvqWKDsj_BtVA0AqsCD4Pa-447Q5OULUxLflmgOHb8WGWsu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrnC1qKyPrEu8ZTVzpSAT7QNTnmmP9UYxx7LEdUT8y7A&oe=6A9EC7D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSPmzVVMbrkQ7kNvwFiO4iU&_nc_oc=AdrklYe2h4qneDnonk2IWe2oDkBnguMV1QInY3gxLl5rRw2ZdnTPCVjZI9G4KWmp-F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv26PsW2DQIs5VQbMoTAFRDL7u2_7k_BcFwJsR6iBzYQ&oe=6A9ECB91"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1zBylvlx8sQ7kNvwEGvLR5&_nc_oc=Adrn727zDuj7J2aJ3q6hY5mTTonYG2S1KMnjaDXWJg-K2VGI1EKwB5Aeryu9JFdFg4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2piYOCv6nREGt23DDkFfFe7CU_84iWTA3fAsLwzHESQ&oe=6A9EB032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P2Khkz8m6EQ7kNvwHweKQJ&_nc_oc=AdrHDD3G4zPfkKW8WcSvn2Zx75WEpd1PkawtSB_nO0uHBG_pQBo0OLCZ-qCOthSZtoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMf-O-EerysVSv6_8twhsKVWMhk1MDoO5ueVeBQuX1RA&oe=6A9ED86F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
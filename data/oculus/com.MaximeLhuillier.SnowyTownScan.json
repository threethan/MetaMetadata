b=1-7&_nc_sid=6e7a0a&_nc_ohc=8WmLDM4FnrsQ7kNvwE_R5Bm&_nc_oc=AdkNi9n3vc24R1KHf2DoIB3QcMVchiVfYhw_iaz5u6uSOidzAJ8QA3wXKG6cv3qKDN8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFi7jWopdK1hRvhePo-WAUPUR2xk1Ye2-q7Emrg2BgAQ&oe=69BA9DCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFChgeFGsWAQ7kNvwE4IcFj&_nc_oc=AdnT051M3wo83wt1spG1VxpaVJjb6FbVil5OcwzRx6YrBa17Z73bDhhWvhAMjEkz-D4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy9DUeY2l6WVWTf2qQ5_J4XslI1_p7ms2KXRjYFoRsHTw&oe=69BAB453"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJrK2XRcG00Q7kNvwFe5fLl&_nc_oc=AdkQAzdkGH4Z5lpg6dusDY5AqJvaIhiXXL_Ry5kLp8PCIx3KBNvgZLxzKilvVSAwj5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2dq5dD16E5rMBe0t_NpNaMWwaklG1tlo5waSZrxoFVw&oe=69BAB811"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDq2HJzgSboQ7kNvwGJBIpe&_nc_oc=AdlA2ReW04xOq4idUoaXePpylm6ronq8nXUsQI-8eXQ2DPsZmr6w10LnbRV9KzwMsxg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCTgrgP4XPS0vLpmPbhQYR7KC6UyfjoTBrSZWwe3wZBA&oe=69BA9CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDdXTdQuAgQ7kNvwHeIZGi&_nc_oc=AdlTVJjNHZXl_LPT-wLY6XvkXCffGtIklHt21eAywWUoAO8OINglJpGxNPbFuAWQUQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afykcgf8XlC-tN0HzGQtB6Dw3dIS4lGbGllMPVvDDvOK1w&oe=69BA8CAF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
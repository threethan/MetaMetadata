scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WSnEZz7sh0Q7kNvwFeX5DB&_nc_oc=AdrjdTCj1diHPbHlMrIAjg9ULXKjzCYVeeMjiNtqrSpbagYaptFw13XP7mXqw5IQMsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeBCZqn_KrE5hoNnXAKcIvpTX8n-FRTKClRyQKmhnXGw&oe=6A7875CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrsDj9t2j58Q7kNvwE5R3aK&_nc_oc=AdqqzpBbE0hzO9Tm1DQDKFZscQJdtbi2V97kyYe5e8nRL3T4F4bHiQuVVs-TmhZdeMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFyqWCjTCGeAHUG6vYhyrezr6QWIzFfq9jfsSOFI6fiw&oe=6A788C53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zon9GfVzneoQ7kNvwHWR2K1&_nc_oc=Adpc7YQ4L1EY4T5Z-gXn8Y2-Xj6xJ1pHV3k_LSAikU3tJv-g7_0Fxuie5lWvlRkdCg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMySp8aKXJLMtUHA3zAM10e1IiWsrAZ9AfjjEoaviQIQ&oe=6A789011"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V28gLRRdN9cQ7kNvwEDOxu0&_nc_oc=AdpAwff_uQWnkpv2fKKKTeFABfJGOeJYwCDJPVGWKynRPqhKe8TJeJZ8wKXlX3pJrG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX69-O_tcLewe1_ZYomB5NKGh013oJlgvhQXbwL7AUew&oe=6A7874B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKtsPcH5-9IQ7kNvwFHWDds&_nc_oc=AdrcmJhyzTJdvuRsSgj2tfr3SOlG7VS2GumWta3knT5O6PlgJCFTxwNz9Yn2txro3vU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAgs20_X2rIkokFZb8MphgrDphbkmXC76cvdFdBRKfQA&oe=6A789CEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
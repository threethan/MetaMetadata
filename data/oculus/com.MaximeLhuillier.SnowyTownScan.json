scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njC-75UG3oIQ7kNvwE6TiSa&_nc_oc=Adpx3TwpX2CVo68dwfiSB43SG0JgD1AqNBwJKdR4rrlIO0ajSe7eM1WL5aNnb5vOuVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwlhnEVknzYngGGBNtXsY5pOxOmyhjdCRUgNm-zTDIcg&oe=6A92D3CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfyNuz0Bq54Q7kNvwEuW9yu&_nc_oc=AdpnxmwjzDf8MwZlQ7wqYisvNJQyNP1_RYhODgTy5sGcUQRgkmrPzhZqzS1q6J-F6TY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4ZfhzBvMoJm-hCxa-qsKypiD3_qbuRi6DiPVwVrvajw&oe=6A92B213"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpqsawHpIUEQ7kNvwFdMQeB&_nc_oc=AdqHtYAtdg1sSGKy5r5URnVDR7mMavkFqF3c_n_Zyoq1AkB-k3x15FqCz2JO9cClb2g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLbWbGM7qqx_6P8ASMErAE1ezBT_hdlPw7XA-tHtfrgw&oe=6A92B5D1"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkc4kuXYyQUQ7kNvwE5Ev2T&_nc_oc=AdqaohgiwnY5PHAeoZJBPcCQIrEzSPfu_X5S1bTU-YbdT7vRmyic5tqUfTAhulnWKe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3P9JNkyu3A51o8xbJql12TUHHJzFPY-4beUByLNHYpQ&oe=6A92D2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-vS6rqUI0Q7kNvwEvDh7K&_nc_oc=Adpr0CXqw3vMgy0mTTUDTuqoSBSllvPjTisn13CMD0zRBpM3oLykuGkuzxi9mMMpWBo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDbFBFcN3ODp-lt66uroUMTcqqp0ffdYPK6w9ucD58jw&oe=6A92C2AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
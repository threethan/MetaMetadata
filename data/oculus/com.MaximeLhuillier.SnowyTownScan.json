scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TG89ZG6YKtwQ7kNvwEUTTcO&_nc_oc=AdqemtbqBxAIOHOG0Q1ME1gyrE5S7Vkqj2N3Z1WpVIYwvuyfTb7iOacpbod6uYGxOW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NyZua_PKLeiN5dXItt5P129NgUnLo12S3zmO-wQvtTA&oe=6A0471CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4jgYz9z3pIQ7kNvwFIaY0j&_nc_oc=AdpRcwhljMY7_g4ZNSmZ3kWoUMj47pnCP92kH14H4qDkeIDLK_kOuwPjvq19ytngp9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RQT-RKmhfGkqjhD400m1BWbt91jOhc2l83Nu0sejq0A&oe=6A048853"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69QMvgQrWDAQ7kNvwHmWVtX&_nc_oc=AdrGZkyvdxO0yYalHi81FNlPU2C1-b1CNYtvLC25094Q6-517dYJeOKr0yglkxM-THw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SeWn9ao0PWxqg1cZq2tt8Pn3u_l9CE0ZLx5bfu2HRAA&oe=6A048C11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAWGNOfRjjIQ7kNvwGF2hmR&_nc_oc=AdrWZ4JmzhB8HlTPzGNKAUQXcC40T299bbAFH90s-eVUmNfx-b60KRdPIT8aPk63xF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4feb8azdofHbsgF-axzTydHqdPIhLHooqBJCEnGl6eZQ&oe=6A0470B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jg1qRigNMcQ7kNvwF82wp4&_nc_oc=AdrvcHg_JWt213GPt_3DH0aeCAL93Yp4nLLNwPC88wUsCq80XoatAAGCDMi9nTwSuYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pMgf5H6GWWPjcPKRSS3JW4X9dIcB-XujynzxRs1DNfA&oe=6A0498EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
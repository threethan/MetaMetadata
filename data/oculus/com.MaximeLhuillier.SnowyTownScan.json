scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a0fSDXJZ4gQ7kNvwFBr7Kz&_nc_oc=AdrObOTgO1lV9uHyIhKmBL8SdRQ0vTf7gJ0Y2jEX97zv8FrfbKnAj76cvH1aiKL5cBc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17qzPHhEM3u5xAI3NmImUnwFJig5tFP8q0Kk50xS0PMA&oe=69F49FCC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSy6mycnwTIQ7kNvwH-ML1H&_nc_oc=AdpwDzGMNxwTqM3Tb-UlPp0EXVG_cvAw0cMlHW_vpiii-ftn6IdK3nbgiZoGyEyDMEM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XwFAKQWnYAgIY3TJ3Xw4LMPfDsctdHZWgauqFtydyyQ&oe=69F4B653"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sXgaQdEXG0Q7kNvwGI8iz0&_nc_oc=AdrZfsFBsq3tX-3pO5YumfyKcy8oaiwRdn6az-YNJzwUtNbcYM_LiJBkLigBLjU9agU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IKYlJHFzUAKCllqLWwXS5jgZFnUbcSbs6to5v7zbsZA&oe=69F4BA11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTB93ogHMjUQ7kNvwF8IPLU&_nc_oc=AdrkcjuFsB-1rb5PhxwCm3gToEtz8qgePFlo-RRcdOyDVCtEu2huu4l1bkeGDlAVQTs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EJ-POUHqFz9pr6FPca8fdl9v9Uh0vlzS471k4pvaD-A&oe=69F49EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfiJvg_LmtMQ7kNvwEAt8yN&_nc_oc=Adrs6LTItcyfgrfxf1GolsH4blHYC5TvNZ7T-RoQEWbCmhtrycNDv7ye7Gqg2Crn9Jw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WAcuORoN6mExQaLk8iqr4GNYF1vAOch6lWyZYXW3-5g&oe=69F4C6EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZAKL_N6qCgQ7kNvwFISLzh&_nc_oc=AdqtUZlXMc0kIV9NfTu4xk23bzwJqSmTpVR-94PYNjjPCsFXQxRqjCk0KBhcu6KcGjg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-3KNYERVHI0EZepP9qZZ4JiZtYGdHfDX1Fdchf_ohLQ&oe=6AECB20C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzsSXx_d9HQQ7kNvwEXsQmC&_nc_oc=AdrOQalyB1ldAFp3XpzB8mDGTwx-HN3dQKr93SfjRsFUD0JIVSpO0YIUlrAXOeN8scU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC-tuJ0GivzaACKsBCr8nf39ReEVVH5RtdfgVgPkLf7g&oe=6AEC9053"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XdMU0JaVYwQ7kNvwE-vzDl&_nc_oc=AdoDeR5QyzMCJMRTXIZQAcWIBygkfKQAyoXF9kyGthiJRT5TtP3JOVXA2Q9qXbTJ8Js&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_gVtQhKGjNuki6FkaBBzyz4b7qVRyw-w4s6FIVDSWQw&oe=6AEC9411"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pma4Rzv4gwQQ7kNvwEgfO4Z&_nc_oc=AdroJBQCiD3_XUguPuZC8gesH6f-rNU6AHkrLLJdWW-r79mVJIO4xqCsfqKd-HxZmng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Ts9jLiFTbHGJExV8yd-xzgeLoOF1eLwi-rctHGOWCw&oe=6AECB0F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI-Ed4UFECoQ7kNvwF5nzpj&_nc_oc=AdohPsCui-Lg_X0NKbjchaqdNHD8tALyUz9ynN7QnRw9OCjJTU4UpliLutXKwti-5pU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDKyvPEZ9ekrDSYIqaENtTx0K0wQVbGEQVDqPGDD58sg&oe=6AECA0EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
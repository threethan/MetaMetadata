scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L5FQSBA63kQ7kNvwHiP4r9&_nc_oc=AdpMn2MSdw59qlrDRxlx8NZXWy7i_5FG0tqG0JPTODA_xwlwONtIMG2NLAhQkwt3Q4U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoQGXBVBdDmu16DTaySnMleT_w73TiOwMGasNP0b99gw&oe=69C529CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1KnlaUHgAIQ7kNvwGTFR0h&_nc_oc=AdqJED61Bqq11fO8p6FEaYa5GaxfKjtgEAE47R1G9QcRqWQ2eSLwklfdBf2HTRpfSHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoTzzy27r1jugKc0GGgPTDNrpU1Fx-sbfxb8JDidAsfA&oe=69C54053"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oG4lrUI_WUQ7kNvwGyoW7k&_nc_oc=AdrKnDtFxB0Ss4ditEBKUaOiiJJrGnHbRsG2mGDPpr61SeJqF6vNnwNs9ys5_xvwHVc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8xl28sBOOV_TI8OpVEYRLB3j-q71oejFmFRmUy3MZXg&oe=69C54411"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n62V9-KYTG0Q7kNvwGhygIc&_nc_oc=AdrKlMsZR3MzJUjOrwQgxNxB6vMGScDekKD9e-0dEvpCSiGyxLiQr-K6AhfSLYetyrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWdXfvpTCctYr60ygUorcMeD7-GvMCwDdRbaOBBlM3FQ&oe=69C528B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PN1_0OLnhgQ7kNvwE9xNww&_nc_oc=AdrifkTZCS4vhIkvcHyZVq6BW1HGhdODC0avh6LV45tVA0jzXNlGjY5Sd17Gsksk_C0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylCZt2tuv4-96kWSDF9QO-rm_NP_x0Szd0N08ZZf-FRw&oe=69C518AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
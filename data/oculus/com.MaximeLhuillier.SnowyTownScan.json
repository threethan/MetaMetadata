scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCZm2AZFLKcQ7kNvwEqw8bZ&_nc_oc=AdoMTWqZ0nFfuO7lnxq9V7FlB9n3bYynOt8D2wlvxX_mGvpoozBkFqHzLtQ0lOgzzVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtqOdeqxlrglqbMazpEquLNc-Abaah1m0rRE2NnibiZQ&oe=6A5E17CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi8ApCohe08Q7kNvwFgoa4c&_nc_oc=AdoTVZWVfNjXUndGCOUjDRGaAVdj_-W5vvjRjst9BwfMd_7B7k5A6Aptgpy16GLCJrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7b6RlkgirJvViNYxRBDId9JVs-j18Y1hsJYMc9WVhaA&oe=6A5E2E53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwXbSuQX3MwQ7kNvwHMNRc1&_nc_oc=AdrC8PqsdC1bTHoXXb3W1Bd9Kb9HjSi0ZAA0lsSKf_t1EwLpoVg17MQTWQhtB0_DiFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_qW-e9qevw0xXcGJe0Cc-LwzUVuP8EF7azAf0Kyrodg&oe=6A5E3211"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wux6ZvWkzO8Q7kNvwFxRt7e&_nc_oc=Adr1jlv3Wp_d9jRgt26jx4XjYBnz1z5Mel44Y1kDNp6r8AHHOPFWoWwqVG6eHFvCQVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf36Hsog5BDTiyFJtRwEltDuAtVCTk9nTblPwA3dnJNw&oe=6A5E16B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wcup-CATFYQ7kNvwHVzOCa&_nc_oc=AdpGFXubCX4tQGxf4AMf-6U2tGJRFU-VZeRgreWWaH7Kdz7AwQz_-bE5LyQF-0OWSW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAPlxy6G7en5D24yjvJo_nuQWmlnb1lhlvLJp92DHmvg&oe=6A5E06AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
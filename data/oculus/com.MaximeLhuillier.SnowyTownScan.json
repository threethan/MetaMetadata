scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdYUZgsvy6YQ7kNvwF3mrei&_nc_oc=Adonxodz3lWPNaAC9IzF7PRtjYLCZBImh3vy2RTX70B19qiQr85uJFVA3E4SQOTWcNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm1To2A87YAGpyMKDZXOniFM_t82JIjL8nrObS9jEZ4w&oe=6AF1F80C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6BP_58y8PsQ7kNvwGiErZ6&_nc_oc=Adqv8RU3VvUWjNkRJlua-IDYg1CMHBJLtb7QZu2EgQDIJqn6P6jGRJdx4cC7VCKLWm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVcSBtvnn10RaTV2LdSU5geX7QgXTLiYZZkp-Umfv-9A&oe=6AF1D653"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyiVFsp_NCcQ7kNvwFhnyGB&_nc_oc=AdoK4W24gj2Qss5MRvuUKBTwXCnN2xBbAPrpJOty32bEOL7sxlXdO12vlUQmA7A-mXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGEXPBI2F0hxyZAHHSqK3o7k8qa5Qso_lFwxnYWOpEag&oe=6AF1DA11"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sofvaU-kY8MQ7kNvwE2SN22&_nc_oc=Adq1gU094dGXYhlK8hzlJAX34izeroBwsmvjAyVX8hMTfQegz3E_Ff2ve33FCn8DSbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS_XwyQZG4SCS_q9uo1dxVD0HqqVzeOd48k8zA_MDk7w&oe=6AF1F6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSs_v0OykHoQ7kNvwFqqmCg&_nc_oc=AdoduyZBmFT1TYdjGAEBb7lieMr9a6pGmVEKmfOs3Tbs3YFCPrypVVKxeFGa_Rpt1fM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTBDlAG7oAzoe9l_aH5Uca_sUhIuUdjwSjxIasI8QrDQ&oe=6AF1E6EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O3eRaSHDCwQ7kNvwEIrx5B&_nc_oc=Adp5xcxfUXwj27-n6fj1ctq3N_LfGXaWXWCI7Efpu3NdJ4pFLleJ1LfIGCP5JEoJcE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARKuUUWkuJm6tWsEGVYEioQGcS61G1WGr3GjfVtEuPAg&oe=6A64AF4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVUeCf-g6A0Q7kNvwERqAqZ&_nc_oc=Adr6s2btyEDXiD67SoKm1AG7HmVvVmlu_mJhzKFaztlUSnBG49u2Aw9TNZ16bVhFcEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtTm2DLFRFgcHR6tzNT2f-hdZaod-eHzeknpWN-nAItw&oe=6A64C5D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xno-Iti-dEQ7kNvwEQP-La&_nc_oc=Adq70FaWqbHPJiOYMSpQVhcXxisdIoBGNJi30eHEnFo9wG8o4S0yKpal5qDCwzJwr78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1HVdL090v9AvRorpy0YAsJR2fmJb7Lkdu4EcM9JhK9w&oe=6A64C991"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf2EQDsJloMQ7kNvwF1aOya&_nc_oc=AdpviiFRqtz6oxJpOlCDqa0WveWqwjkhfCts1yNwy9h1ThT9NIXRV4CSHgwE3weERvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqpvtSwwTxF8HXPcxKx73zfD1COgMBVski8z-X9Q38QA&oe=6A64AE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCd6BRiSc-wQ7kNvwERXbzr&_nc_oc=AdpkmIglktEtI65Vkqo2oMroh0vppf4Ls7bfa7ycwBuClTm-8YP-v2hZPhfaeWIoaHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjVWq-Hh_K8vLmLMnoFFwNW2lKqrlNywGSh5i4L8L0Xw&oe=6A649E2F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
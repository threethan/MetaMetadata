scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QsHoKBuCogQ7kNvwHUDNvj&_nc_oc=Adqm4XuUNcIA5PRokTyxMmi2HetwYLiFE5HfwMo7pIavlwg_yRzUF91FKxwgOpsPl18&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs_bJRKds45vx-acrZfqov-nG0qhoEomNzO3RTgISoGQ&oe=6A9AF50C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0PhRqyUk4IQ7kNvwFN-T19&_nc_oc=AdqUw-2xVzGJlVDKD8ASQBw2durUXVd9j_1f96mM6c9-7lL2e3NwTAy042z-EyKjEps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCadIj9cFrpnWgWc78vuiIFdZtBMYEKZs2a5E7DkzsCA&oe=6A9AD353"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IplBbSyofMQ7kNvwEdpsYk&_nc_oc=AdqqnJppcfDk4LuAyrwZ0qyve2sR9aOl83A8kj96HiXkkiZBnp9iQXhXwLUlcQSKPT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLztEgNWBOPts5a6LB8pg69tB8PuTq9XcJeqhifxtv7UQ&oe=6A9AD711"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViWctD8hZRwQ7kNvwHHWYFz&_nc_oc=Adri7KJLcosvwf5HblCTb5Tt074E00Fj81Nj7mcP1WkcinnO_JxUS7O7CqEWScSX9fc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg_c7GKtj9-b5-b68HyYfN9rLvFbYLHgaNNEAHKWJWwA&oe=6A9AF3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nljGkGi_ltIQ7kNvwGHS1wB&_nc_oc=AdqXVhNy6557viMspfe1X3YIJ3mS6Mv2MrRtCYVWjeDbfGNM3NmcHMMfDDStTB-eHoY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJon_7rqDh3yJNicJPRNil6OX7gwbk77M64Jb4fdZhQ5Q&oe=6A9AE3EF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z6ClweQSMsQ7kNvwEBOt5L&_nc_oc=AdoEUMH7TANda6bbFJjf9nU1FM_q4DZdM28-FekykKYx7_koIb5AXs9kyf1Ye2rcnyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY-ietmDJNPGcjGd9-ENxqJiUSHXqy8_PBu9J3BNKhQA&oe=6A523A4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bouf55SyOOEQ7kNvwEk8gIk&_nc_oc=AdrudryiT-_N6iCCE41zipBzKFG0Tge0KW1TiSdG8qyTgo5KANbJB9D0cjmGFtwI9Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9wSy0Yh1dzbKD6hK0Wc2CNJq-im7C6JlL6SkupP3UbQ&oe=6A5250D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3m64C9CJVQQ7kNvwElfs7b&_nc_oc=AdrLy8SGr767X4CArIFWzIEdToAT_oHNnismLTsb_jO7mPDIeqPIg2GFiuKAulGdWf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbg6vKjO2beFHOoFhqn6eUQVM1MwJIPQZRy5eM00mdHw&oe=6A525491"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bxe1pQK4ugQ7kNvwFTnLRZ&_nc_oc=Adp9b9I440nZmUeQxThDlH1buYS62YEVr7ZoCgAkCwStbKvgZj-XN_mYIsAkMREHA8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGWzHF-ok_u7C4cxLyl-cQQ8cAXwJBbcCrmMxzg8xDpQ&oe=6A523932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgt90g86YscQ7kNvwHtQd4X&_nc_oc=AdpGfDm24C7XZ9nYBG2vHQLQ8-muqsW68j0QTZjvlYamvPOpBm85HynMqHNMGZfCXXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLs75ze6aNHE0HNxl8UREgzkJDc1PQYZaSpGVrsd5BoQ&oe=6A52616F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
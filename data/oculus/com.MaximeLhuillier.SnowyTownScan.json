scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xz3lHNYeR4Q7kNvwEZ37ZK&_nc_oc=Adp3q18jFx9jr-mROWyv9BH2w_98HrRvSs0NfJWcEEBmuZc3L-bvMX4an38lkQOsjTM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e4RdYmJEDT9Wc6i89x6oHYGnoVV511rYaDBiGyv20Ag&oe=6A4116CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5auEFZzwznQQ7kNvwGzKOt7&_nc_oc=AdpC6hFmc4cHrl5ZmYe_o-rH_naFr_HgPRpeL05rSWGvRjIhzI-SaY7EdD2bA-NNweY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7nq_yBUOZE-mDb4X5iaj2k8cUN2DgRQTjO31TRwoGlQ&oe=6A412D53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdSR3iQ-r3gQ7kNvwHkdwJ4&_nc_oc=AdqJ_w0CO6QnC3oRsqVE9d4XUST2CXclcTNtnYZLSEBV8n2AeC_bRSPG1bQe73ZLN4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MFiFwe7FHZTt__zVIb72EY2dgI9uT3GXod504dj20-g&oe=6A413111"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRZxoMNXjGMQ7kNvwH6OVs5&_nc_oc=AdpmqznM2JSz2W1UIEsNKkpYuxDOOXXYjXvqdby91ztZ3M4cIKZGouTmd-YBdwmcw6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C63XOQ5wZ63EWZf3kJAHPn9R-QQoxZSjiqF4sT760TQ&oe=6A4115B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piUd_I0jrVEQ7kNvwE8cYiu&_nc_oc=AdohyW5F-cwp-rQykWG3bh1OTJu5s2Wwf16VAypT4V5KsvGp6QAiYrR7QAEaeJeXSZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pcbu0UvEsar-9SGfH9LM3GCZsIjLKMQX16g3RoEbrOg&oe=6A413DEF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n_kZCy3P84Q7kNvwH2Z05J&_nc_oc=AdrPg4nk80mIoSxQv-GvKC8Q8PO80fynihwNkU0aMgP-zEIGVEBZ4PhZdPp76GPdKFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mNZbNawNAsF54OHGZEQFA-tNb-KfaFWy8B64xDuSu8A&oe=69ECB6CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkvD9-MoQ0kQ7kNvwGM2guK&_nc_oc=AdrSHrPBbs1wJ4voHzALPIR3HO87Ec_ZKQqG0aL6jmgeyaLUfAxdPIoswcqSPyRtrUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UmKKvR9BDO-pfxf5dNzXHXn6dj4gYTfIjMLbh05KENw&oe=69ECCD53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOd2SFU8XxMQ7kNvwHa96v3&_nc_oc=Adqh0RdMLxSKP_tAu-09Okjz9yxKYcJY7Dg3QleaRPHV_D3JT_Bc7pvkjfKbZlJ1_HQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CKu_vi24h-Ff4YsH5gCQ2y7GY1SickmhQaNIBHOmwbA&oe=69ECD111"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMI5ylvODD4Q7kNvwHDw_1n&_nc_oc=Adr8w128nNpYJL5mTuKds8PloNwZtLmAWVi0PKo-D3YscWg6M02Ez6FrmiDMPvM3PBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wdVEDiLn7IHgmVFUn5T5kSRZnpWJFsIt0jF2L22CDUA&oe=69ECB5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tASHAUX8HVIQ7kNvwHmkHzh&_nc_oc=AdqFay1XBLMvz-CqMJkCdcYDV8uBShSR-nEOCYreIjeO2Qfk7-QKyo4X3rWWoHxTh4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DmJOxk0P9ruXShrBevWSjDxPL-S_yT-8N1-MaTehFnQ&oe=69ECA5AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIA8aYcPjCMQ7kNvwEKtYUA&_nc_oc=AdrPD_y-lQOSbWIOZ9Dm0J7kN-0ZLe8kGvWe8l9nhCygLqeW2pIBIyvQYMxxQyhR2T0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LHKujmwxz164PoXlKY4u0v1fc_cfHzl8qL1Xgb_4oXg&oe=69DE364C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg5t88cGymEQ7kNvwH9Am9v&_nc_oc=AdpCoc0XRVSIvs-_tkyEsmS-y5Y7TPrrSzfVb07pI2LfvT4vi9RzEqstOeSO5m_OX14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tPS2ngP97auRb2oyBJs_d6LEwBPq7xtO8HF22JXed9A&oe=69DE4CD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeULO1TQoH4Q7kNvwHpUgAq&_nc_oc=AdpUQGYlRiTGmJ8VCXy0NF5dA0pTaWMC09S15JNYU6tnpPSqDQMqFwidWqzuu_QXbEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oKEUQ54DbGBHyL9VDccNVa_Vj2fbalMT6U0wDaz076Q&oe=69DE5091"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AumxwjnQ3hQQ7kNvwHfZmd6&_nc_oc=AdocK6tFHLqaBSwgE7n8fHIahxXunZIOMVPzWLE7D0O9Y8HZo49SIRGnY_uaL71eUcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21cLyPcNLJhegqj-T-xTGecd9ZBeYueC230_4gtXT3hw&oe=69DE3532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaVFaMXDXi4Q7kNvwEIIBr9&_nc_oc=AdrzsfIWWbePynrxs34F1_XgCYP5GGYqdF6xsPSfPOKt48T_UAihO5ZrOg2oLD855RM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MOm-Wsn190dza-A7u9kTLox0tmZy7XTwDspPQXBAWXQ&oe=69DE252F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
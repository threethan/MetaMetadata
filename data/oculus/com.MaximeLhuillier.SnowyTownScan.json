scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIA8aYcPjCMQ7kNvwHxIbGl&_nc_oc=Ado8ZhuaaIjPCHjFbT1i8Q0ysw7e5GlDya2s1OU02fOM8yQZvTP2ACsOcT6KjVo_8z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KrcQ7PBjNv6pjlHc0oCyi3a_GrhbflfMjjny-nl_51A&oe=69DF87CC"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg5t88cGymEQ7kNvwGS-S8r&_nc_oc=AdrucURhtowIvEpdH_kOFCc11s4mhEs9PKSIYSLHA0cKowFqWQNPnBAfF6KTpk-bdAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rhb_LimAZ2x0zAmuQeWchJskuKfe2RaPfTMu2k_qBIA&oe=69DF9E53"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qKKMQcI6YsQ7kNvwEMhACZ&_nc_oc=AdrhSxUfOUqUTiIVQpc0GPDMoMWegazBx8BKc8Zcb-2DE2oDZyOZDuj3jDYLudhgRXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af215Ua5SSm-h_7EkXn1T8T3GeaUEGN43ea6YTRQB_B3IQ&oe=69DFA211"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgQoI7mCDh0Q7kNvwFfjwLW&_nc_oc=AdoJp2j--hH86vSOR5W5ZC51Qjv4azmDtRuzSOX90qI7P5P0Mw8p4j1-TgnitpNkDjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12_GKVI0qwjgH3Al7k9X5oTLmM4kznDwb1bkha7IuYsQ&oe=69DF86B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPu66xjn1TgQ7kNvwGS_rCh&_nc_oc=Adpy1P8iZew0P-Jispx41naHMw34PW0Wbz5L2s7fGmBo_W32vf8wIjbbsEASIQaPVbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MQkhepvkcELdBxOzJYrG9X6sxXsHOv5qhH1KG8AeTUA&oe=69DF76AF"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
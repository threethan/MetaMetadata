scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UmUsbpoPtYQ7kNvwEhMp0I&_nc_oc=Adq_FmpkF8qrJFHwgC6EsVnJ0aajQIDbXkuogiVXfnuRPCC1Fn8ryk_9XNfPRW5ziyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz1Z0inVWvZtB0cZs94JZRVm_3O8ixLOLFfMQFNZpKgg&oe=6AB1264C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3-B6Kq6Kx0Q7kNvwFOcg3n&_nc_oc=AdqhHU3S24cQXthgH6kIzUJnH0KVhoOl2ujuob1GsbePajjvmn9PTGGS3YTlmRrM2Fk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtc7GE37fgKK1JgUGScnW82J9pIrYzAEoENsiHhFFR5A&oe=6AB13CD3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wQaaJTYuX4Q7kNvwGxM5aM&_nc_oc=Adp8lgP5OtnoFs9u1gWbmmYuXa08aOJTljCNK0lFE6O2Eb3IFkObpiXKEJVhfgN1qos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkUtXzHHzmcogIXt4dNvvJbw0yWHkUYDa_-DxVK5Mlug&oe=6AB14091"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssjKvUvFN9EQ7kNvwG69m0s&_nc_oc=AdpHof25rcLwqhCeuM4dJzMnl1aaG7Pb1gXielRPMmD0pfsjtZbuX6sShqe_QcREADQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRvf54YXosrRRPBc915rZgE18uSUgaJHJsM7GVWKlMDw&oe=6AB12532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-aPHf1icWEQ7kNvwFdMn1Q&_nc_oc=AdoiYe9JoOnQZZSui3p5suCPfttmbrUlqBqcI6H27I9ig4NZkbkCfeH6G5RYLD4VUew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6M9fwGtALAFKtldwBlPgA3zb-gC2tpYLIoWeDwOjHYA&oe=6AB14D6F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
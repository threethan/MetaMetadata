scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2nZ5lMWKkYQ7kNvwHUT5Bk&_nc_oc=Adr0P5MSACZyOQCsJpiP8Z71ieqN9FWovFAudjM5FwyZ-9r0M57f66KreieicwgqP9c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFS2Qag_r_Kbh9O1yv0YML_k5o1HVaB9rwhQMiVdRSig&oe=6AE33F4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6sXcNfzK98Q7kNvwFwNE5_&_nc_oc=Adr0YXmB844_TSdsCVFhNOZnNK1hrOSAStmOnNtm8oMn-niKywa0XBT_openWeDES5A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIvTmv32UsS_MJWclLrY-CpzcG9UvyTpjbFZwDIVIMqA&oe=6AE355D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTPaMTmCvI0Q7kNvwEY1F0h&_nc_oc=AdpFmoDRBktC80yEYJUGJ2AEqQmpv_I2WLq-JB5XOskarB2OVbeMBWAg-8c9HmmnX1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5yVoS_mX7tzdVHxdf5NsjKMGpLoC0s9BM8CvgWQD60w&oe=6AE35991"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6btNTA1GcQ7kNvwFecNrn&_nc_oc=AdravL_N0T5kh35ebKao8PwP-PgDlMMmGs3kPl36lFn3uF-yieVkHetNZBBHCEYskro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMz4CopXnWJk9Mehw9oQyRvYvJQDzDluN7tvFKBcMLYQ&oe=6AE33E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_uPxTG-I8oQ7kNvwGLeiBL&_nc_oc=AdqfuOp_xeu58EaftvdDcyISrxtgcynL9id09E_pEunnhpIyZsGl074P7aNhNg6N0jw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIAjH6BkeXJ4QifeSrkf7mfV_mtHjEbzhEugbKdM05rw&oe=6AE3666F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thu10OQdYTkQ7kNvwEq0IRS&_nc_oc=AdpVBhTOnbHwCKzAlvS7QNVHyz2fQLCWzf1N_Kf3B70AaAnQmfOop7jcZZAgh6HJcng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVc80WXSUwLG4YmtPNEX8iz8l9X91nRVm0W0B2q3OcgA&oe=6A9C0E4C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0PhRqyUk4IQ7kNvwE_zs2i&_nc_oc=AdpveamtC5ItXHptRp5kx2cTfSR0sIjhhARZT_X6qYSPXFqsn346-Goh088wHtE-DeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhKvVOOG-axMk5Ly12BgOqDRqj6suOpCnumZnBZCeWFw&oe=6A9C24D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IplBbSyofMQ7kNvwGI-YYW&_nc_oc=AdqXMb-RS8lEsv94fAsxuNZ3bHUcCC_xn0HUd8PBXoGEAZ8-hO8UBnNltk2rUT8ZR6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoHEW_9oOUZx8WBsl7Gn-8ThDZcI_kzDBLbLZl3E9AIg&oe=6A9C2891"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViWctD8hZRwQ7kNvwGuxju_&_nc_oc=AdraV4KmGrt8poWUghfHat1dDOm_690KVcOsRYakzRZ_ZoGqDuM2zOuIYKwrAMpTugU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHTm879MOZy4zli5rmOpZrnBAlgalmwYWEVaQLaW4z4g&oe=6A9C0D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nljGkGi_ltIQ7kNvwHeeqMS&_nc_oc=Adp-oBirRRdZmKgbjqpeCr1wC7yvi2GI1nrNak_sPvwZTBKh_6z6zmBBg8WedC4ARPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXzf4TjeiBXsRjCc3xtsBsDku5nVWLNK7jdw1dVnjqFA&oe=6A9C356F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
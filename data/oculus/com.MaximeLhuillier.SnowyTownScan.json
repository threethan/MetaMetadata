scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njC-75UG3oIQ7kNvwEyv9Le&_nc_oc=AdpE15j9CLbKCPosEh0bGIn7sicIfN2RrHMb5dk2BIssvAJMn5wRLV4BXBzYha69b5E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV_q7YZm9HRmLrGKIOg8kJpB6kp556ZILspdbft-7_Xg&oe=6A91824C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaTxOfbW7AAQ7kNvwGIMkl-&_nc_oc=AdqiCQISx9qnOoUeHEIVnyFFkb-Z3qbJ0VE__B-8jdvNxO3EFPGVMerzDUSPRHhhIH4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu3IQk4L27667b1dVD7celQrDDO1G3oRrTw75E4hq5pA&oe=6A916093"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpqsawHpIUEQ7kNvwHJjbiS&_nc_oc=AdrKVoWG_aK6Xfnqa9o3YJFsC9Rs9mnbBRyRhGEVKBn_72IYXx8L7cxfCz0AXZKOSek&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbExzgliBEenQDXLF2tpXSMTf4Fej6L3t_CdM9g40p6Q&oe=6A916451"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkc4kuXYyQUQ7kNvwFTmyN-&_nc_oc=Adr5oTYBnGS8FhFSb1lvgDT-PxrhsdXBSvveaamuJMQ1aDoPVLuuUgjdujN-MbCOExE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnN5dxV7zql4MJJP1UxUMGl6AOB60FhrGjyu6XWA-RUQ&oe=6A918132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-vS6rqUI0Q7kNvwG_Bdrz&_nc_oc=AdoGgsLWhjJsw77BlLCHXBdZAur1ulNDWYPj-w-QnpBFBGPj8uy0xzES81Bgpacq-kU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq0mk0g7QGqH3qPlATmQAkEXwYmtPYMhZb0eJYIhZORA&oe=6A91712F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
scdn.com/v/t64.5771-25/39003242_586367522959471_5282683893066263987_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJGRzOzaI2EQ7kNvwGq-Uy0&_nc_oc=AdrmPpY1vNUiXPBZcJ1lIFS-Mdb-ol-t_yK365cwCWGwli5Jeeh4qs_2kkyUMck7Tsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oDhV5kw28lA9udC1mhLjNQqRASJAlYbI5c74iCRTlPQ&oe=6A38148C"}, {"file_name": "Screenshot2.png", "id": "582630293360190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982541_582630296693523_6117141187659797588_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYUWc37OTg8Q7kNvwEvHBCq&_nc_oc=AdoDbCuCSaFcb80nJpHJnkeg3FrDJrnC355vpvRza5vMhTl0CZCU8T3VlxdD1n3K9N8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LcYEC37rt5mUR65jSmjsTc3UpW_dSQXGtKIq7zpY6zw&oe=6A37F2D3"}, {"file_name": "Screenshot3.png", "id": "1615302805533708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_1615302808867041_8474953266952880772_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-FcSzPCPVcQ7kNvwE3-zBh&_nc_oc=AdobxKX4a1UhO3EJs6hLTC0bc3sSxMDeSIxNlCoCHDlS0jvOCR4Ak9l_hqknUNWsRwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bKHKYaX9bmX2VHE9kaM8CL1aJJfvaEj1wOhaLWMtpbQ&oe=6A37F691"}, {"file_name": "Screenshot4.png", "id": "782483226108424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_782483229441757_2357525884853135287_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQvPiET0b2IQ7kNvwH8ZkKh&_nc_oc=Ado2YzQcDcjzy2GKY_swjTNb9dnzwGIB_9FVb-I8N_cpRgIFS8z2lhRbB17bi83CPSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j_3_BzjSahDfrVBrjOPB3J77N2e0Rg9Z2Wz8VjVDQaQ&oe=6A381372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "782023966478773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_782023973145439_749891387670287731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfUhS8a58y4Q7kNvwGzjBMf&_nc_oc=AdrTvnLa89xMLf4usvkzYc4Fc5p7mGqnl2qYPNHsMIu9sEW6P1neKa23C52UruDP5e0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qDxiXGzoAkMOZ3kVQFg5mdKNOX015YAIrqpx9iS8NqQ&oe=6A38036F"}, "display_name": "3D scan of a snowy town", "keywords": [], "long_description": "Move like a pedestrian in a snowy town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 670m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.", "short_description": "Move continuously like a pedestrian in a snowy town, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 670 meters in a town (Laschamps, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT
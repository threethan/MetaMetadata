6917791015769_3204834042481983649_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Vqzw-2GuNUQ7kNvwHbtw52&_nc_oc=AdrCEr8BprOc_AD6UiLNJ053KHh-0POtWFh122ugPv0wRqPRvhK3KV0p_jyBoo9D-qY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcK0lRxk8oy6ZXsnc26sWDgSjSFJkD0bsR05ep5cj_GA&oe=6AA003EE"}, {"file_name": "b84a56880b7e4bc59b1f73e1221f955c.png", "id": "1069948915158925", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619187_1069948918492258_6323477313382185656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDQkC-X2z0wQ7kNvwHTlEcW&_nc_oc=AdpwqxK2w4U2Xtc-GyEqFqJsTlnVKjFkfG54yXzjvLHFQ34MGEtXGsrxpk5p_y97Wdo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0z9iO2-h_x0RGvSmgaczB8zlgy5sh8wKHF5hGSFmIRw&oe=6AA01F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "960759816919931", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298219_960759820253264_9196691632062401007_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UttScOdokIQQ7kNvwEZxFNK&_nc_oc=AdrvspV9zb9fqReNPzJjMWmzU3MP1nPl1lc2CaovufNE3_z8j7e-U0e4l9H_45hobFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL76QPpueBYTNWlqm9H9c7-5SFTfbYXCsp3foQuCvzumw&oe=6AA014C9"}, "display_name": "10k Science", "keywords": ["education", "ai", "learning", "biology", "health"], "long_description": "For minds not limited to the mundane world... see what is beneath our visible reality.\n\nBased on real data from practicing scientists, 10k Science brings the world of the unseen from 100-million-times normal human vision directly before your eyes.\n\n10k Science is a tool that:\n\n\u2022 Engages you in complex science no matter your age or experience\n\n\u2022 Guides you in an intelligent, Socratic-style exploration of scientific problems\n\n\u2022 Challenges you to think about the world at vastly different scales\n\nFunded by the National Institutes of Health, the National Science Foundation, and in collaboration with the Lawrence Hall of Science at UC Berkeley, we bring you an ever-expanding library of experiences - from the depths of the ocean to inside the human bloodstream. \n\nFeaturing advanced, scientifically-accurate visualizations and AI capabilities, and extensive testing in authentic educational environments.\n\n10k Science is a living platform: we are constantly working on new content, and your feedback is taken to heart by a small, bootstrapped team.\n\n", "short_description": "Explore science at every scale. \n\nFor minds not limited to the mundane world... see what is beneath our visible reality.\n\nBased on real data from practicing scientists, 10k Science brings the world of the unseen from 100-million-times normal human vision directly before your eyes."}]}, "developer_name": "Dynamoid, Inc.", "developer_privacy_policy_url": "https://dynamoid.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dynamoid, Inc.", "support_website_url": null, "website_url": "https://10k.science/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "EXPLORATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28809649078621639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618069_1567990264567290_8745318604986316046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=
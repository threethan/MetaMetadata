e7a0a&_nc_ohc=E70lAPT8xZ8Q7kNvwHr89-D&_nc_oc=AdrKMIHnXEFLyy91rtHWtcBAi7unxkCE76UXsyaVrKVMOy6skSF48GDAd4DdAh5J_cc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrVmtOJeDt55olpxRazCMwCAZch5nSqYL-UQD15Vix-g&oe=6A9FF976"}, {"file_name": "screenshot1.png", "id": "630368912346090", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974649_630368919012756_8616995335741971611_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAOUQzTHvZwQ7kNvwEPi7MO&_nc_oc=AdpF-R7rfpCBI-iis1ekDYUE9tKcQEqgIQMkalYCkqm-q7rsqeQZuMmIAnaDP58lL3Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4-gF9X6GKghLWzlZ_M4RcGeJA8NEAi59ZQl1hzXypkg&oe=6AA00ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot1.png", "id": "1000892247693178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_1000892251026511_5866412470062943128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBWzkQsH3sMQ7kNvwFKLN0a&_nc_oc=AdoJUvBkHaBeb6KKJ8M9fsWf3qt5bA4W_FpgQkL99gV-yXwONEuffHf8pokt0Agytro&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0i2vKhOkS45doG2xMIes5TBgEru1OTXtpkaibkPbCzw&oe=6AA010CB"}, "display_name": "10k Science", "keywords": [], "long_description": "Embark on a transformative journey into the microverse with 10k Science. Our immersive platform offers you a front-row seat to the mesmerizing dance of cells, the intricate structures of molecules, and the awe-inspiring processes that are the foundation of life itself. Every experience you embark upon is meticulously crafted based on genuine scientific data, ensuring both accuracy and depth.\n\nOur ever-expanding library is a treasure trove of curated VR experiences. Unravel the enigmatic codes within DNA strands, witness the cutting-edge CRISPR technology in action as it combats debilitating diseases, and navigate the myriad of phenomena that define our natural world. Each exploration has been designed to not only inform but to captivate, offering a rich tapestry of visuals and insights that can ignite curiosity and deepen understanding.\n\nBut 10k Science is more than just a tool; it's a portal. A portal that bridges the gap between textbook definitions and tangible experiences. Whether you're seeking to reinforce classroom learning, satiate a personal curiosity, or provide an educational gift to a budding scientist, our platform offers a fresh, immersive perspective on the vast universe of science.\n\nIn a world where technology and education increasingly intertwine, 10k Science stands as a testament to the potential of VR to revolutionize learning. By transforming abstract concepts into vivid, interactive experiences, we invite users to not just learn, but to live the science. ", "short_description": "Journey into the microverse with 10k Science. Delve into cells, molecules, and intricate processes, all rooted in genuine scientific data. Our expansive library provides diverse VR experiences, from the mysteries of DNA to CRISPR's groundbreaking approach against diseases. Seamlessly blending education with immersive exploration, 10k Science offers a unique gateway into the vast universe of science. Dive deep and enrich your understanding."}]}, "developer_name": "Dynamoid, LLC", "developer_privacy_policy_url": "https://dynamoid.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dynamoid, LLC", "support_website_url": null, "website_url": "https://dynamoid.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "EXPLORATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jhlx3VzI8EQ7kNvwHRG0vV&_nc_oc=AdpcR5m1jfJIsgjcVGnzt2nCHCEVZ_7b58YI0SbJlNGpCOFGuwJ9BLwQAlRLnhbt0Ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTru7gXIMpesXFsw3gst9nYvEp-W-3oc9LKuRqrkVeGFw&oe=6AF20670"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37J47R1TrNMQ7kNvwGPSIHV&_nc_oc=Adp4JlZd8-OlbvRB5QcK5zAG3tMqhL66n2GNYP6u0jiGZo2H1SEqYxto8VVRE-AA-lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCMzVG4wbjWNBWDS4cmA7IJP8oCbGeOxJh53t5aAIcCQ&oe=6AF20A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvUyUx1u2-kQ7kNvwFLEvIe&_nc_oc=AdqXMFXXMIfVN5S2J3G--QcK2HjazFnsHXqHuZRvrqA_oveTqNc3X9Gzr8hSHgKuyS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqxzk68b-KwEX89puEktKr7Pv08gTg-y9WHJmTWDe_lw&oe=6AF20993"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it 
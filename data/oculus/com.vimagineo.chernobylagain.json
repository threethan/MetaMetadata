33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-FRUU5TDeEQ7kNvwEutE40&_nc_oc=Adrdga7pLiniwoburvguzvXlD_7otGlJrHn_Ddz6O5LuKrDHLrDloHb9NncPk0AZ24Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9LRFJBeuJp_xC4sbm7kBG1B9n5W8-pcPxDjyZh6QATg&oe=6A974730"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqAnuQgwMPoQ7kNvwEoDNfy&_nc_oc=Adqa4-nmPr71wLBLQ7dQHkkKrp8n1FaL1sQfoiTmVhuoXvmB64ceCkhPG9CnHkHHUu8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHSW-kWMPygde1wf8cuQ_DBOTfZztQuazeRvTSfm4cEQ&oe=6A974B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmycaUeiU1UQ7kNvwFhwc90&_nc_oc=AdreKTV_zw3KMzFw28hDno-ZCHjsVkOtyOLAfjshQ61_0vACySUqG11V20VMVgczu60&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqx0sH4vkxmTM46bIzGVGYMmxDEFJrK0nO4CbhsrJwLA&oe=6A974A53"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it best. To the world you are Olena Ponomarenko \u2013 a successful Ukrainian scientist responsible for discovering time traveling. But deep inside you are an adult woman that desperately wants to once again meet her parents, just to tell them how much she loves them. This was the driving force behind all your scientific experiments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chernobylagain.com/ChernobylAgain_PrivacyPolicy_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vimagineo Sp z o.o.", "support_website_url": null, "website_url": "https://vimagineo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7177225272377657"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1543178829914038"}, {"status": "PUBLISHED", "id": "1096958862034550"}, {"status": "PUBLISHED", "id": "1023191370457368"}, {"status": "PUBLISHED", "id": "2434428833647047"}, {"status": "PUBLISHED", "id": "999220409457313"}, {"status": "PUBLISHED", "id": "1497367775396721"}, {"status": "PUBLISHED", "id": "924602959919664"}, {"status": "PUBLISHED", "id": "1515846239898391"}, {"status": "PUBLISHED", "id": "627547803645887"}, {"status": "PUBLISHED", "id": "780651174593853"}, {"status": "PUBLISHED", "id": "1081844887150525"}, {"status": "PUBLISHED", "id": "574506912333622"}, 
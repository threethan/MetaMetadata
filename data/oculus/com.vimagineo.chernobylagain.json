33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbt-IANF-1AQ7kNvwHAFMqe&_nc_oc=Adpw7eb2Lxdhw1a36rpnv9qL0tsI4O9Cg4hS61VBNURBHHMHnLVI8G85G7PusuBB7ik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Qbsv4uqfE4iU8LNeVGXQ_zTG2tG3MxLsKCG3KqLLKQ&oe=6AE0AAB0"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrWn3Y8JDGIQ7kNvwHkdhVf&_nc_oc=Ado-y1cNeYYUE6BREvlUkwXHLZz_GmTdzMDFDC-mTWhVRncQiUJuWB5nytvoqHmjPm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONkKgWBrB0w1jDSNFEZAMq6dAp954Z4fzBQixBIwIUeg&oe=6AE0AED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TvnRkXJxwoQ7kNvwH-VoI0&_nc_oc=AdoFlsSZogc9uYLJlIlsexceZW3x2MB2wQTJWudSPnUdFgFVH8jGov2doY_hA7YIX7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN43dcutn1jwulOAurJALjRFhg7Erg_K1InCb513VJz1w&oe=6AE0ADD3"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it 
33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-FRUU5TDeEQ7kNvwFq-eeX&_nc_oc=Adqak8cTZzVYaneu9a49ScjwDvoAGN-WRpW8He-WUSNL3JCDBe3tnrJTvVBtRnH-Q0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKfceQeSMjwQZetQ55AkgsxXD7jXlg66fkJvNlAf5m0Q&oe=6A9979B0"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqAnuQgwMPoQ7kNvwEO2fZw&_nc_oc=AdonwpPg4B6uNJg-kELumE0oysuZtR7UhAzwCZuuIw9y6i6wZCJ62SLDAvIcgUCePRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlynLOdOvZQzba_tJqjhKgdi1Oa4iJ7PN_jG332Ep1FA&oe=6A997DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmycaUeiU1UQ7kNvwFJNzf6&_nc_oc=AdqMASDuMbhOM9QFaKvCvvdxRcHcLtCCWF1yb8w9C2O3u2oGgOE0fb0TveWIfdLL7zE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBs1wkzVG3EqqSMJFy8uE-HNnVo-_kLHr_AJYMCbOswA&oe=6A997CD3"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it 
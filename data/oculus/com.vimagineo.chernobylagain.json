_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah8IUH9BMgkQ7kNvwFu9IPB&_nc_oc=Adr8dsiXI0D8mJpPpjuttAdRzvSwQ6CYV-iKUvwhf-EoUhioaCNwImgoJzrTiEtNe1Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Sf2OyvshEbaSpJdeFahUGTE0GhPWlEPa4FZ5UZStuA&oe=6AFC7BC4"}, {"file_name": "CR_v4.png", "id": "1239661780576122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462207_1239661783909455_9059254212825459325_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLN7ZsuLaawQ7kNvwERGPPH&_nc_oc=Adr6HjnJNSe_rNwZcVREsdNLp7joBH5ndBApW3CO7WbrENPPaYtkrBSVyEv3-YhsM_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXMtwq69hemBTu-IXVr-OmDtfsHUsVvJFa9I0x0u9MVA&oe=6AFC6EF8"}, {"file_name": "Pump_v2.png", "id": "1541826546699588", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031309_1541826550032921_8092091982540356178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S86GpI61tOsQ7kNvwEqfA_2&_nc_oc=Ado1tKTjS9z1pT_I3Pak5AECQeJeaDdjRrKQGdb4cQrCwrhu9suU3xhBLXy_C72pfNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaQK7LhzqzP6ueC-3chst4IWk-dG8CZQqgBEVpWKViCA&oe=6AFC8328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "1087173839533742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1087173842867075_1077347659963634598_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BWLCRYJzfgQ7kNvwEwgalE&_nc_oc=AdpSo-atPNv3znts8R3fnk9fPh5YN-cBtnb32iuoAyOMSmFeIEpHP5MxWX1s7djEXPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlVgxG68MWyX9VTIf7vtJJW9fHJLOlXXUbRqw9389jXg&oe=6AFC7520"}, "display_name": "Chernobyl Again", "keywords": ["puzzle", "adventure", "spy", "radiation", "timetravel"], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it best. To the world you are Olena Ponomarenko \u2013 a successful Ukrainian scientist responsible for discovering time traveling. But deep inside you are an adult woman that desperately wants to once again meet her parents, just to tell them how much she loves them. This was the driving force behind all your scientific experiments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chernobylagain.vimagineo.com/ChernobylAgain_PrivacyPolicy_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vimagineo Sp z o.o.", "support_website_url": "https://linktr.ee/chernobylagainvr", "website_url": "https://chernobylagain.vimagineo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "pl", "pt", "pt_BR", "ru", "uk", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes
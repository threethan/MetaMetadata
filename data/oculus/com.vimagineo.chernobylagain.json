_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufRREKWcJ-gQ7kNvwFCMLLV&_nc_oc=AdohUgWV0dUVlybJ6A8TItjZxKrSYMnHzXxLAwmFgLUQ7srIFj09kROBseI11oMnONo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuLJE0sc4Vc9PuKdloqpFMg6VXEsidQ-VRR4xu9lc64w&oe=6B01C1C4"}, {"file_name": "CR_v4.png", "id": "1239661780576122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462207_1239661783909455_9059254212825459325_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCNg89OuHr0Q7kNvwHboWXh&_nc_oc=Adrhyhxu1OtlHBos9ElPibKu2xc5LAhbnVWczj2DLfS_LA1iLED7EWNCC1UGOhYJ2lM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegvsqBpBjzczpmf-IbcDuyf15H6e1l4ocbBlgb6A_DA&oe=6B01ED38"}, {"file_name": "Pump_v2.png", "id": "1541826546699588", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031309_1541826550032921_8092091982540356178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Yjw7pXnhFMQ7kNvwGMZfBN&_nc_oc=AdoDQ61l1K05izlgAVznzivtWt1T-hNjdvY3T8nyCLv_cMjaHnSwaVTaHWbAddhCiNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlIsP_wNgaEt-7RhehMUuFelI6HC1vbZ0g0aN_Ld-CWg&oe=6B01C928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "1087173839533742", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974829_1087173842867075_1077347659963634598_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDzM9skKiz0Q7kNvwEwBr02&_nc_oc=Adr1k1r_eM_IBxFjoxqQ1PryaAzuPABfhWXOyn-uh5JFm3dImI65fxs6jI1qRIfCr3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_yI8AwryF-N433eTe3QHhEUi0UXW3YCGyUGqU83ieMg&oe=6B01BB20"}, "display_name": "Chernobyl Again", "keywords": ["puzzle", "adventure", "spy", "radiation", "timetravel"], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it best. To the world you are Olena Ponomarenko \u2013 a successful Ukrainian scientist responsible for discovering time traveling. But deep inside you are an adult woman that desperately wants to once again meet her parents, just to tell them how much she loves them. This was the driving force behind all your scientific experiments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chernobylagain.vimagineo.com/ChernobylAgain_PrivacyPolicy_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vimagineo Sp z o.o.", "support_website_url": "https://linktr.ee/chernobylagainvr", "website_url": "https://chernobylagain.vimagineo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "pl", "pt", "pt_BR", "ru", "uk", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes
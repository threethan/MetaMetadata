: "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462207_1239661783909455_9059254212825459325_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDcxObs5ILkQ7kNvwGZbZKE&_nc_oc=Adq-MxKmZRUrZJTCs0IFXB6lfHxKGhrXQtdnFedrDJN4aGQJOK4zMVHoa1QVHu32fYQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHanee-1GkXXrknhlB0ZhMtShc6OXQgt0DU4jMt-AxDQw&oe=6A8AD5B8"}, {"file_name": "Pump_v2.png", "id": "1541826546699588", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031309_1541826550032921_8092091982540356178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7OEyzAP1nkQ7kNvwGPsplR&_nc_oc=AdqxjHvX6bCvhpecK0KPr-Okomn2BBTfH2xnTA7Jhx6dZVQ29ckgdOfMAgTBGQvkA0E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnQOLukbu_UgpAhzX8yrZyHmyiWiys3KapsB53rJ6azw&oe=6A8AE9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "1087173839533742", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974829_1087173842867075_1077347659963634598_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FjZkq1cVYAQ7kNvwFo52g7&_nc_oc=AdodgCmJSxK3IzpEQ1qkPZL8Hxrc_1QIpkHZ0AT51LXWusszrHLwOr4GRT6qXqdfKLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM38OO8q30s0SNsiQLXbnrPiforbKct0HvfZj_G2rtQQ&oe=6A8ADBE0"}, "display_name": "Chernobyl Again", "keywords": ["puzzle", "adventure", "spy", "radiation", "timetravel"], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it best. To the world you are Olena Ponomarenko \u2013 a successful Ukrainian scientist responsible for discovering time traveling. But deep inside you are an adult woman that desperately wants to once again meet her parents, just to tell them how much she loves them. This was the driving force behind all your scientific experiments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chernobylagain.vimagineo.com/ChernobylAgain_PrivacyPolicy_en.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vimagineo Sp z o.o.", "support_website_url": "https://linktr.ee/chernobylagainvr", "website_url": "https://chernobylagain.vimagineo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ja", "ko", "pl", "pt", "pt_BR", "ru", "uk", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26933855962954628"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982626_1052476712944912_4831381487361557549_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TrHaYCv1vEQ7kNvwGuRrK9&_nc_oc=AdraswoyL27abJtcEWwKj9d5U5Nk3jUFO-nU9VBppZQeYakSj2Q9CMkxJZMddBZ6xks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.co
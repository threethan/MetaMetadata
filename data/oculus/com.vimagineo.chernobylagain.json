33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry1KQoWvCm4Q7kNvwGRfOs_&_nc_oc=Adp9wK0NDLUmsH2X-XL4COEg6CQBTiICnDgb4JBQHg27k8FFJM86gp_JgrjGn5LxTLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOCUPjsj0NjUc6gAT0_oXa6YuniVi9oIkRl3L5j1KURg&oe=6ABA6F30"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfFq7uqhlG8Q7kNvwHmvVFr&_nc_oc=Adpym1eel1Y6cG21IwzX0g38h6LwK1hXzwSMnZxyiPhiKLShyyGY2uZy-xvL9wiikBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRAaQRY5WOJURErw7-E_Y9Y4WHF7gcFeYwsXfAi2S12g&oe=6ABA7356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWq3WOGTGD0Q7kNvwEzYM2B&_nc_oc=AdoDvLCzbTJetBeqly3JTBP-j1nllKUKCsWlaiD7gDcs9p4rkOl__UD6veJF4FS901M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhIM9FBPYsu2v9oCxZXAMuSkL_yK49-o4a6qlBTuEG-A&oe=6ABA7253"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it 
33216_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWq2hE_J1AkQ7kNvwHqHHnC&_nc_oc=Ado2aFhykl86828qBy6p5Jf8r6NLtJDQSfpL8D3fxIGCD3OTRglb3EUFdRP-lAVPGls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyCCLjejA3Mz2OTUSNYF17-aJXVhEGPQcThVUT_vK9IQ&oe=6AC3A9B0"}, {"file_name": "DUGA_v5.png", "id": "1466821260708095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572943_1466821267374761_6415709384416036575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snMGCn7YSDAQ7kNvwHVerha&_nc_oc=Adqa-GYmY-o3MM9JsZ3fn1CydslgUi_uw5YX3V_g4m2CMAfEz2PhbGPmuSidOsvWekk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKkruBp5Fpechs-zYzo_hZz_SDgujd1o5dMVapXfNvQQ&oe=6AC3ADD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChernobylAgain_KeyArt.png", "id": "3647629912233771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031656_3647629918900437_8164619944999043534_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSeS7HZXKBYQ7kNvwE3ZsPE&_nc_oc=Adr2mjxLcXDtsD7VjuLbg06lya__E-Ipkwrtit5fWbojWa2idB7ydT86_5B_3g-DqJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtlkVjFftqMJcW2v9mLWdhFY_YOtP_7-Rl7ARf2xbLCg&oe=6AC3ACD3"}, "display_name": "Chernobyl Again", "keywords": [], "long_description": "Chernobyl Again is an adventure game created for Virtual Reality headsets taking place in the 3D-scanned Chernobyl Exclusion Zone for a more immersive and engaging experience. You\u2019ll get the chance to explore the Zone, feel its dark atmosphere, and follow the plot full of unexpected twists via different kind of puzzles, you\u2019ll get to solve while traveling through space and time. Your main goal will be to stop the Chernobyl Nuclear Power Plant explosion, and the consequences we know it brought not only to our timeline but also to alternative futures that became available to us thanks to your time traveling discovery.", "short_description": "Living without parents isn\u2019t easy. You know it 
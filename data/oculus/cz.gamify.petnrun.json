9AECC15"}, {"file_name": "stillG2_1.1.6.png", "id": "3817644168496330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982531_3817644175162996_7610643169509628658_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQf9cppSazMQ7kNvwENgwzU&_nc_oc=AdkPoKpw52ns7U3SXBPU4RYCsr8G3ss2noCpx9QsmSrZD2ACUTXEyM6xmjXkFkyHtmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAp_AG0aKwYr9zKhnSKE7afF0-CDoVnR7wxKlQDQWrEg&oe=69AED741"}, {"file_name": "stillg9_1.1.14.png", "id": "1645383776016512", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035452_1645383779349845_484993158188607454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbTTZFGFsoQQ7kNvwEJCsM6&_nc_oc=AdnDB1IpCbNH6hIL78TwUtkDxpzI7hQdn6dHuvXUH9fmkd-6FpPyHYETkbZrDIDZCuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7e7dLUDK8TQZGmmDK6ZzUsTgpfwrj29kfyFwF43RPSA&oe=69AEBD63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape (5).png", "id": "980532947431726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75322595_980532950765059_8337113048821043407_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJNNZ8SeAZYQ7kNvwF4YNej&_nc_oc=AdmSGrkMVeW7qrxkg1rywnOaBvCeOqaH78IKGoUeAaz3mElRUeWtgYB7TxlntOkVjiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSgcvQaykZEYrAZOoLh66oNj5aSHnmRkErF0VLm0BDtQ&oe=69AEC31F"}, "display_name": "Pet'n'Run", "keywords": ["pet", "animal", "gorilla", "mixedreality", "animals"], "long_description": "Pet\u2019n\u2019Run is a fast-paced Mixed Reality racing game where you take control of a daring rooster, a nimble spider, or an energetic small pig as you dash toward the finish line! \n\nSprint, scuttle, or squeal your way through chaotic tracks packed with obstacles, jumps, and hidden shortcuts. Use hand interactions to pet your racer and boost their speed to get then first to the finish line! \n\nRace against friends or other players in thrilling matches, with more quirky animal racers joining the fun soon. \n\nGet ready for crazy adventure where your hands-on care powers the path to victory!", "short_description": " Strut, flap, and sprint your way through chaotic tracks filled with obstacles, jumps, and hidden shortcuts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-petnrun", "developer_terms_of_service_url": null, "publisher_name": "BRAINZ GAMIFY", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8771886149562076"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1287810279304338"}]}, "baseline_offer": {"id": "1287810279304338"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734870000, "status": "PUBLISHED", "id": "1287810279304338"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9194268233990530", "version": "0.94"}, "id": "1997782834076015", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8771886126228745", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
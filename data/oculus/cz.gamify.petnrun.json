//scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75300187_3795656333983081_3145471744727496585_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V7ygWgYccsQ7kNvwFd_bgc&_nc_oc=Adr4utpJPyDUTMaAq8Da-XpFP1LaB4K1VwHE4xdAZWz2YP88p4mXuKNcqukLc-qLWs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkPay4-KdJxLFjzqQsPU-lpHTlLYIM5qhKT9B7UcKnEQ&oe=6B0B378D"}, "display_name": "Pet & Run", "keywords": ["pet", "animal", "run", "sandbox", "platformer"], "long_description": "**TURN YOUR HOME INTO A CRAZY ANIMAL PLATFORMER**\n\nPet & Run is a mixed-reality game where players Run, Jump, & Build their way through obstacle courses for their favorite pets.\n\n\nThe gameplay is a mix of a platformer and puzzler with a twist.\nAlmost every object in the game is interactive so you can experiment and find unique ways to finish every level. \n\nExplore new levels daily, create your own, and challenge friends or other players in thrilling multiplayer matches.\n\n**The free early access version of the game comes with 30 pre-built levels, 3 animals to run, crawl, squeel & jump with, online leaderboards and a multiplayer sandbox mode with more animals and content joining the fun soon!** \n\n\nJoin our Discord to become part of the Pet & Run community and help us improve the game.", "short_description": "TURN YOUR HOME INTO A CRAZY ANIMAL PLATFORMER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-petnrun", "developer_terms_of_service_url": null, "publisher_name": "BRAINZ GAMIFY", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
_hOHR8JrWYzOm7wo9ZlRZDSJ85F_MiQRV2Vo7AOJ0a2dxtLEpa_8ZlxQnNZvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5BJkubhSmyU20ywUM4LNanS05G6rbE2Zi-7E083n6qA&oe=6AFDD85F"}, "display_name": "Pet'n'Run", "keywords": ["pet", "animal", "gorilla", "mixedreality", "animals"], "long_description": "Pet\u2019n\u2019Run is a fast-paced Mixed Reality racing game where you take control of a daring rooster, a nimble spider, or an energetic small pig as you dash toward the finish line! \n\nSprint, scuttle, or squeal your way through chaotic tracks packed with obstacles, jumps, and hidden shortcuts. Use hand interactions to pet your racer and boost their speed to get then first to the finish line! \n\nRace against friends or other players in thrilling matches, with more quirky animal racers joining the fun soon. \n\nGet ready for crazy adventure where your hands-on care powers the path to victory!", "short_description": " Strut, flap, and sprint your way through chaotic tracks filled with obstacles, jumps, and hidden shortcuts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-petnrun", "developer_terms_of_service_url": null, "publisher_name": "BRAINZ GAMIFY", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
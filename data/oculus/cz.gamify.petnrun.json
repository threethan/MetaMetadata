C&_nc_oc=Adn2jIIXKWuG9cc2n76ZgJLH9js_NEvqdxQzpsH0tcbbG6p0JzhFahEGkwtH07yJ-2k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBITThrOmdY3wGTWnmXzamjAjJzIbhE8LQQJqTNJvK4A&oe=69AACB4B"}, {"file_name": "stillG7_1.1.8.png", "id": "1304500850569347", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031588_1304500853902680_6159109253667770421_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGLmuKinczUQ7kNvwEiYad2&_nc_oc=AdljGeCMASYMEcvUDt0GPAtbpwl7g8mT-3FLGy7AVJ0m8uKUnlmAJdxUa9hvRHloT4s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxCgnZaTP-1ms4wpbxrp6_cJRXiIzHjio5P2hHc_niFw&oe=69AAD795"}, {"file_name": "stillG2_1.1.6.png", "id": "3817644168496330", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982531_3817644175162996_7610643169509628658_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr0KdyEintYQ7kNvwH3XAUt&_nc_oc=AdnUxsdvnnRMW7lbKZbbH84H0IWsnPhUKEdHUi7ll2kYF9eiOHmnAg7Ed3heJboC0r8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1h6lpPcrnib1LlE_lkmgpSGaNFG98Nune9iMi-Vvfwg&oe=69AAE2C1"}, {"file_name": "stillg9_1.1.14.png", "id": "1645383776016512", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035452_1645383779349845_484993158188607454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soaLiPIkFRAQ7kNvwGgb-CO&_nc_oc=Adlz9cSV8eVqZQc4MQKiWJZjzI7yMOoQ0j2eayqqPI6mwLn9mmKcJ6QgLMkh2vOIJgg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-Ks4rpq13A56PIDG_TsXgCsPe5hP-NxSrpxHkmzYryA&oe=69AAC8E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape (8).png", "id": "3795656330649748", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75300187_3795656333983081_3145471744727496585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bMjRQ6mVP4Q7kNvwExWC15&_nc_oc=AdmuEhWTl73Q73YMjZfEHEUsxtoCTeo4zHmV8iFw_iYOc_odnzVd9gpQSLs8K9L2J6M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxs94ieClLVqn5mdmSYiwW4id1LcWKooUlpgNkNAFmupA&oe=69AAC68D"}, "display_name": "Pet & Run", "keywords": ["pet", "animal", "run", "sandbox", "platformer"], "long_description": "**TURN YOUR HOME INTO A CRAZY ANIMAL PLATFORMER**\n\nPet & Run is a mixed-reality game where players Run, Jump, & Build their way through obstacle courses for their favorite pets.\n\n\nThe gameplay is a mix of a platformer and puzzler with a twist.\nAlmost every object in the game is interactive so you can experiment and find unique ways to finish every level. \n\nExplore new levels daily, create your own, and challenge friends or other players in thrilling multiplayer matches.\n\n**The free early access version of the game comes with 30 pre-built levels, 3 animals to run, crawl, squeel & jump with, online leaderboards and a multiplayer sandbox mode with more animals and content joining the fun soon!** \n\n\nJoin our Discord to become part of the Pet & Run community and help us improve the game.", "short_description": "TURN YOUR HOME INTO A CRAZY ANIMAL PLATFORMER"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-petnrun", "developer_terms_of_service_url": null, "publisher_name": "BRAINZ GAMIFY", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1990104051447093"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "910061
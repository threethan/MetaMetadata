02681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs3kL2oSjyUQ7kNvwFzXP6X&_nc_oc=AdoHFpmHozKfaJ8YU32vo-kCU4b2P58u8vBpLiQFx6sukFl8_0sjthqCSYHpWSehObE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZpC3LAToQw1ioFQ7oR7rxxph_KcKO5j5HKKlnibUfFQ&oe=6ADCCB03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH97Qt93OM0Q7kNvwEXPsAT&_nc_oc=AdqePThyycGTiwEwtfnhbYMnJlvta7F0IGS47GZpo8N6ouS0Ok0rEIp_TnltOMezQjs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8KKbosARZXq7oT2Bghp59qOvX2Z2IVCV8nAYQZpX38g&oe=6ADCB001"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "A trombone, in mixed reality.\n\nHold the trombone in one hand and grab the slide with the other. Push it out through seven positions. Pull the trigger to blow: the further you pull, the louder it plays, and a sharp pull puts an accent on the note. Point the thumbstick to change partials, the job your lips do on a real trombone.\n\nThere are three difficulty modes:\n\n- **Beginner** snaps you to the notes with auto-pitch, so you play in a major key.\n- **Intermediate** turns auto-pitch off. You find every note with the slide, and can slide between them.\n- **Advanced** turns off the HUD, so it's just you and the trombone.\n\nThere are no songs, lessons or scores. Play whatever you like, without waking the neighbors.", "short_description": "A mixed reality trombone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_
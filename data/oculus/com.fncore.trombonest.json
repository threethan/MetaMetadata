zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkUroecGgVYZ8uNkqrXb5c7LMWd_2lemA9drfxrHoxpw&oe=6AF72A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1122116437460891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628893_1122116440794224_4575586154876569219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyrHaB8OcqoQ7kNvwFWoqo9&_nc_oc=AdrrKx7-T2-Mw-DW79oI5mtgzNPoL1mlkzSxjkk-MB1DNmKGxkzbjHUYb9ftPWWuW4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAfV4eym-RR_LiFwuYgi42HWLkkR-MwAsJn_wZ6Mq36A&oe=6AF72FF1"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "Pick a song from the music stand and play along. Each note shows up on the slide as you go, so you can play Ride of the Valkyries whether you\u2019ve held a trombone for twenty years or never at all. 44 pieces to choose from, including Beethoven and Mozart.\n\nOr skip the song. The slide works like a real one, so you can pick out any tune by ear.\n\nNever played? Turn on auto-pitch and every note lands in tune. Already play? Turn it off and find each note yourself, like the real thing.\n\nPlay whatever you like, show your friends, and don\u2019t wake the neighbors.", "short_description": "A mixed reality trombone. Pick a song and the music stand shows every note on the slide \u2014 or just play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED"
C7PYnj_MCShdh7B4GLp5IEd9RQ&oe=6AE0C4A0"}, {"file_name": "05-toward-the-window.png", "id": "1120098224273464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499624592_1120098230940130_8380703836272249650_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ijqdl4Z124Q7kNvwF6Vj2O&_nc_oc=Adq_p2_TOep9k0WjrKw9HM56PklWPMNcRA2VYEpssvfw1hZFW07Bjpbd3SKna2Lm6bQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyL1mcNBitXarbn7Tp2jIt8aYboA-zYR2oWDgImZCutA&oe=6AE0ADEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncaF1oiOtlkQ7kNvwHG3Ajf&_nc_oc=AdoFBEPvGiEW53bVermzXFTABpPv0S02ahWovqSRRccFQimz7pwvVcRXyRFPHKelgHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0ZqajZXQl7D8nDZEhYd0vUVjsrl4s3Ak2SDIDOVFDXA&oe=6AE0A481"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "A trombone, in mixed reality.\n\nHold the trombone in one hand and grab the slide with the other. Push it out through seven positions. Pull the trigger to blow: the further you pull, the louder it plays, and a sharp pull puts an accent on the note. Point the thumbstick to change partials, the job your lips do on a real trombone.\n\nThere are three difficulty modes:\n\n- **Beginner** snaps you to the notes with auto-pitch, so you play in a major key.\n- **Intermediate** turns auto-pitch off. You find every note with the slide, and can slide between them.\n- **Advanced** turns off the HUD, so it's just you and the trombone.\n\nThere are no songs, lessons or scores. Play whatever you like, without waking the neighbors.", "short_description": "A mixed reality trombone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_
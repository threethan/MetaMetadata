.com&_nc_ss=7f20f&oh=00_AQSlWuEBSCoFgSr8NxVkLYYlmYv7DwzR0I0MItKyZI2Tdw&oe=6AE766E6"}, {"file_name": "IMG_2308.png", "id": "871272151355015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982728_871272154688348_7042354902335487275_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nowMKiV_iFUQ7kNvwFG0nbO&_nc_oc=AdppwVewHILBIZO-UQPCkHIxB2voPRL_I808A-e5kAF3sGGGq7LZJiSqa4vKlsgbZ7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy4eKII6rKahO9PbDnRwOQRViPmyZr8Z1EVcj62b2jtA&oe=6AE751B9"}, {"file_name": "IMG_2307.png", "id": "421042843687870", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982538_421042847021203_8908044085356263319_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHqB1_sNuKQQ7kNvwGI3bsl&_nc_oc=AdoEajhruH4dFkcfNoPpBKAFn6oy7FwUV43gwOIR35yNhzJrv9nwvKwKH5D9ich0tow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFu0HFOa4aJwfo5F7UEjbZqr7NxsI4VHiIiyundrYykQ&oe=6AE741BE"}, {"file_name": "IMG_2309.png", "id": "1050655896014987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982640_1050655902681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiSnaMK2F18Q7kNvwE2Xe5k&_nc_oc=Adreej2FzQXuz7_Oh6MzzGoAgIpRV68xQvjIzsW5LP7QNiyNl9mSNqjRL0sIQ0gkAck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNKIlwN9n2CLQrdrgtaM9Y4tQfzbqKmRQwV5SArKkdQ&oe=6AE75703"}, {"file_name": "IMG_2305.png", "id": "410278031495927", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982695_410278034829260_5886097420940237187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5lbMj__cMEQ7kNvwEgnaSh&_nc_oc=Adru7SBSUH6ozG3YBzorQZqgX_nOiNQp-SVT9NLCGfYbNHI0ie1aErc9-8rBW_yhioA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjpQaKrd7S7tZP2SxoQia2aF6YaouQ9kBmdTkaV0qCug&oe=6AE75881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM7mZ84eJH4Q7kNvwHku30A&_nc_oc=AdoXILKZ5FEB5D1pPM9DLoJhEB1MYqsAnC90KvGNM4PZvO9ex1Q3ZIQAGXI4u2peskw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxJM231gO2ozHTtgvSITVrsI19a22wZmOyGN5B-Sep5w&oe=6AE73C01"}, "display_name": "Trombonest", "keywords": [], "long_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting! Whether in the quiet of your room with headphones or sharing your tunes out loud \u2013 play your way!\n\nEmbark on a self-paced musical journey. Whether you're a novice finding your rhythm or an expert perfecting your craft.\n\nTrombonest Features:\n\u2022 Three Difficulty Modes: From beginner to advanced, master notes with perfect pitch at your own pace.\n\u2022 Embouchure: Use the joystick to mimic mouth movements, unlocking a range of notes as you play.\n\u2022 Visual Note Indicators: Always know what note you're playing with immediate visual feedback.\n\u2022 Music Theory: Learn how to play notes in a major scale.\n\u2022 Passthrough enabled: Play in Mixed Reality.\n\nYour musical adventure awaits. Step into the shoes of a Trombonest with the most immersive VR experience yet. Discover, play, and let every note tell your story.\n\n", "short_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting!\n\nIn your room with headphones or out loud for all to hear \u2013 play your way!\n\nSelf-paced discovery for novices and experts alike.\n\nTrombonest features:\n\u2022 Three difficulty modes guide you to play notes with perfect pitch.\n\u2022 Simulate embouchure (mouth movements) with the joystick to play different notes.\n\u2022 Visual indicators show you what note you're playing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "supp
tatus": "PUBLISHED", "id": "1291338439838088"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29800604739526518", "version": "1.4.3"}, "id": "222012607382595", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29800604739526518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Fixed: changing Partials in Options now takes effect right away. Since 1.2.5, the trombone in the menu kept picking from the old number of partials.\nFixed holding the trombone in your right hand (Options \u2192 Slide hand: Left).\nSaved videos show the trombone's bell again.", "created_date": 1792801929, "id": "29800604739526518", "version": "1.4.3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29800604739526518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Sharper menu text. Added More Apps by Fncore to the About page.", "created_date": 1792624885, "id": "29769555339298125", "version": "1.4.2", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29800604739526518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Your hands now hold the trombone the way trombonists do: the left hand grips the slide brace and wraps the bell brace, with the first finger up by the mouthpiece, and the right hand holds the slide brace lightly between thumb and fingertips. The hands are now see-through gloves. The note display stays level and turns to face you however you hold the trombone. No more loading screen. Fixed a crash.", "created_date": 1792590221, "id": "29763165506603775", "version": "1.4.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29800604739526518"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Record yourself playing and save it as a video: open the menu, press Start Recording, play, then press Save Video. Fixed an audio bug.", "created_date": 1792372694, "id": "29725587373694922", "version": "1.4.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFi
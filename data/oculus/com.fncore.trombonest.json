2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ_01alE5ba_mPgJ2hZpqIqSbW_Tl5Wo3Ii1iRuWLF1g&oe=6AFF305F"}, {"file_name": "screenshot-5.png", "id": "3533995623438103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620559_3533995626771436_4778015771533360075_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-xEx-uNvvQQ7kNvwGe5K87&_nc_oc=Adq7R8b_16EXlIfhKRJoVSy5uuQH2bLx5YMwirUuFvr2-uA8iXIckwE8jQB75T0H0Hs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPJIGYJUKQaxi1_CkWy9aeobj8Psg_bS08LbusTo1-4A&oe=6AFF138C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1122116437460891", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628893_1122116440794224_4575586154876569219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3ldZnE8r4sQ7kNvwHNB_Ba&_nc_oc=Adq64xtVKvIXcasZdbf8MfMlgU1mxRZcXVEXjm6Zp5n7cpPadGEi5IG_kVN0fGjO0T8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnkZFGtIoGzdipgEHikxxQXPf8XL7WZgCtC1ETDHewMg&oe=6AFF18F1"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "A trombone, in mixed reality.\n\nThe slide works like a real one, so you can pick out any tune by ear.\n\nNever played before? Turn auto-pitch on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 44 pieces, like Ride of the Valkyries, marking every note on the slide as you go.", "short_description": "A mixed reality trombone for Meta Quest. The slide works like a real one, so you can pick out any tune by ear. Never played before? Turn auto-pitch on and keep every note in tune. The music stand shows you how to play 44 pieces, like Ride of the Valkyries, marking every note on the slide as you go. Play with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30004416169145373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593734382_922405957470929_7140447334570095576_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jThmJr1kOwsQ7kNvwHS44XS&_nc_oc=AdqO3-DeSRMetOmMKA5csxPw6FHU-xnaAxAxTZLoSctYs0sK2K9buZ3UhOIn1SJO4Qs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0vnlYlWFg6C-B5dx0coVGEYqZz4u21m0YurraqLrAYA&oe=6AFF3326"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trombonest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1709047860, "lastRevision": {"nodes": [{"id": "734259906
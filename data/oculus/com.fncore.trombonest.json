uluscdn.com&_nc_ss=7f20f&oh=00_AQRnwYFyqswIgJlNQNlKRsqsTVb_PntRcjQkFJ5AMdExjw&oe=6AF723B9"}, {"file_name": "IMG_2307.png", "id": "421042843687870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982538_421042847021203_8908044085356263319_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON73WzOXQgIQ7kNvwHgc1TO&_nc_oc=AdqLbzFVWjj4ZuvewJvadafnH69mLDE-nSGbFu_3E9elsTYihS3P5HYH4gILGNRQ38s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgvfP-PacW10VP2lu8Eaf97YdYUE9Ww6g9p0GNh91snQ&oe=6AF713BE"}, {"file_name": "IMG_2309.png", "id": "1050655896014987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982640_1050655902681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZ72gE0FBukQ7kNvwHsouTj&_nc_oc=AdrGNCGpqIRPGlFBl-wNFX5JaFoMgGKMsq61fOeRGLkY6Doo6qCRr32VOT_paHSdDrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIVRKiHCoKwoLLve044KIdbMWnea3Url_gT0ttJfaiDg&oe=6AF72903"}, {"file_name": "IMG_2305.png", "id": "410278031495927", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_410278034829260_5886097420940237187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRcIgV0OyvMQ7kNvwGi_9ym&_nc_oc=AdpkHMTEMoVFb_sFyr46Koq2ur-jQyYoXCwKM9ZLzdJ29gBSWa0ewQZG5K0Vloyo4FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLftxD0DE9dJUCVqL2XrnYXqXY3rf4Puvgq8Z1CIXeQA&oe=6AF72A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kI-oqE8LcIQ7kNvwH4uWcQ&_nc_oc=AdqmpVfw1rnYszr0MYz2Tr6C4PY-m77LFLinNcNQcCNh-d-8s7Fs33ghA_LTy4IwTbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ569QLH_251zfyBRLGUkeCZfcFFi0dwKFKqrgDi-OhTw&oe=6AF74641"}, "display_name": "Trombonest", "keywords": [], "long_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting! Whether in the quiet of your room with headphones or sharing your tunes out loud \u2013 play your way!\n\nEmbark on a self-paced musical journey. Whether you're a novice finding your rhythm or an expert perfecting your craft.\n\nTrombonest Features:\n\u2022 Three Difficulty Modes: From beginner to advanced, master notes with perfect pitch at your own pace.\n\u2022 Embouchure: Use the joystick to mimic mouth movements, unlocking a range of notes as you play.\n\u2022 Visual Note Indicators: Always know what note you're playing with immediate visual feedback.\n\u2022 Music Theory: Learn how to play notes in a major scale.\n\u2022 Passthrough enabled: Play in Mixed Reality.\n\nYour musical adventure awaits. Step into the shoes of a Trombonest with the most immersive VR experience yet. Discover, play, and let every note tell your story.\n\n", "short_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting!\n\nIn your room with headphones or out loud for all to hear \u2013 play your way!\n\nSelf-paced discovery for novices and experts alike.\n\nTrombonest features:\n\u2022 Three difficulty modes guide you to play notes with perfect pitch.\n\u2022 Simulate embouchure (mouth movements) with the joystick to play different notes.\n\u2022 Visual indicators show you what note you're playing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEME
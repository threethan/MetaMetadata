nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFjHdm9sBnDOxvZiN5ZYCEPlbfdGzgi-C-n-CRWkcuBw&oe=6AF3577E"}, {"file_name": "IMG_2309.png", "id": "1050655896014987", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982640_1050655902681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLFcKXej0OQQ7kNvwEnQ4fP&_nc_oc=AdqfGrTWCkKLXgvt3ONUijIefXQH9aLza8bE7Fktb7wAdY4kRgQZNed8uEeTwijHMMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiVLahFL8EWCxUxqpErp9975T2sdETKAATMCjey0Anlw&oe=6AF33483"}, {"file_name": "IMG_2305.png", "id": "410278031495927", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982695_410278034829260_5886097420940237187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIY8YylU0iIQ7kNvwFjLeUs&_nc_oc=AdoyZAodPtQa3WMfU0ag1og1YpF1-lORnq6Oy3mtCD3wpVyBR8UQpBkbtgKIsWz27n8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROdfmVRQLXwq7m86696BblsfaxDQV0WA33RMNH9tE6Jw&oe=6AF33601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fC3FXDthUkQ7kNvwGA4s3i&_nc_oc=AdpSMhHipo2g6r4BY6fpg0ZH1hSgqJQ7sU7hDNykmPa5vq7iF3-L-BQzg4KCsX-FPkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy7DHAZ_PLW1ix3MuskfKtLSA4wiakni1RkaWUm1w6yQ&oe=6AF351C1"}, "display_name": "Trombonest", "keywords": [], "long_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting! Whether in the quiet of your room with headphones or sharing your tunes out loud \u2013 play your way!\n\nEmbark on a self-paced musical journey. Whether you're a novice finding your rhythm or an expert perfecting your craft.\n\nTrombonest Features:\n\u2022 Three Difficulty Modes: From beginner to advanced, master notes with perfect pitch at your own pace.\n\u2022 Embouchure: Use the joystick to mimic mouth movements, unlocking a range of notes as you play.\n\u2022 Visual Note Indicators: Always know what note you're playing with immediate visual feedback.\n\u2022 Music Theory: Learn how to play notes in a major scale.\n\u2022 Passthrough enabled: Play in Mixed Reality.\n\nYour musical adventure awaits. Step into the shoes of a Trombonest with the most immersive VR experience yet. Discover, play, and let every note tell your story.\n\n", "short_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting!\n\nIn your room with headphones or out loud for all to hear \u2013 play your way!\n\nSelf-paced discovery for novices and experts alike.\n\nTrombonest features:\n\u2022 Three difficulty modes guide you to play notes with perfect pitch.\n\u2022 Simulate embouchure (mouth movements) with the joystick to play different notes.\n\u2022 Visual indicators show you what note you're playing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7839768739370100"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id":
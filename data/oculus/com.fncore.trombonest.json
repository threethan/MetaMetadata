t64.5771-25/499624592_1122320277011462_8048760091517155165_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUtY5ldJTmoQ7kNvwHdNh-z&_nc_oc=AdprSi4-Gu_qISSk4AC3tz-HCc2Sy0VPAwDInNA1PoyyUnsCHchRpw84U_b_sNiNcQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9nmupcDrOIWzVNH3rweeVs8TORGewxNeNQ_IlmllJ9A&oe=6B0C5F5F"}, {"file_name": "10_screenshot_5.png", "id": "1427408566048113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839701_1427408569381446_9111603033197298507_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dS6r6xkYUgQ7kNvwHMgxna&_nc_oc=AdrtFk3F4X2V6vpIDKQYXt707Hr4oV2Y0PAyBdd66Lg71ylVgGOLzrC80mtv41qM8bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1EfSQN-itgJnLkRxTXf8gB5r9c_wRqjbDFtMKk0D_ig&oe=6B0C5860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1122116437460891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1122116440794224_4575586154876569219_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jozlyJKKGU0Q7kNvwHxRcxh&_nc_oc=Ado1SuLIV9v3sYJAK6d-86GPBWJC8K40GdevvGiwIRr26rzslISxnXu0Kk0RxX-ONYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCDuXWVJP5jjd0SeLKzKLmHoeasyJZJze7Qtea5qSnsg&oe=6B0C8031"}, "display_name": "Trombone", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "A trombone, in mixed reality.\n\nThe slide works like a real one, so you can pick out any tune by ear.\n\nNever played before? Turn auto-pitch on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 44 pieces, like Ride of the Valkyries, marking every note on the slide as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night.", "short_description": "A mixed reality trombone for Meta Quest. The slide works like a real one, so you can pick out any tune by ear. Never played before? Turn auto-pitch on and keep every note in tune. The music stand shows you how to play 44 pieces, like Ride of the Valkyries, marking every note on the slide as you go. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30248657461387908"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628016_1678348213828826_2781921913289459819_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0YeyM5lGNMQ7kNvwFaT9Io&_nc_oc=AdrvGm5QF1MCDBye1d0nE2eSX0y8TxHDe04lXokE6Lhv7t88q0mHsdLga_FhF4vQyEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5M7Qq7NG5YbTonPdae-a4Qmy8Qg-UNTo
nt-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK3rGMvVB3uhwkJJuugiIDkE7PVzC61I2Kxruw8ctT3A&oe=6AE8933E"}, {"file_name": "IMG_2309.png", "id": "1050655896014987", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982640_1050655902681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGWPPZcolF8Q7kNvwEzwlU0&_nc_oc=AdrDutn1XvW7tu8xqEU50bNJuhv06Q3EGqa-x2o-BIbEZ_OsO-jxP0LcuBIxQAnJ86E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCzjhgkANBOy1KhC0ChlDc3hkgSrPbjDhF2kFGBmnbXQ&oe=6AE8A883"}, {"file_name": "IMG_2305.png", "id": "410278031495927", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982695_410278034829260_5886097420940237187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5lbMj__cMEQ7kNvwH--gog&_nc_oc=AdrX8laYZ2VRWAN2HPbEEksn3yIaYFhYdSzDendr2tGQR5l5lWsOJEchzbICQ_poito&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3DGyDYK6GvT6cQUZcKotCoP_O2UPC2dgRYJ_LyRE1vQ&oe=6AE8AA01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM7mZ84eJH4Q7kNvwGRyOYX&_nc_oc=AdpXK-aBwN54XEuy2qi2Kvj44JAqUvWw02bKEZO8Zk1vh_w9bg2fmKP6zod5r9gB2fs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoJcdlJIZViOzwzSNxor07wYVe_piJAJUEIoYDsSKE2w&oe=6AE88D81"}, "display_name": "Trombonest", "keywords": [], "long_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting! Whether in the quiet of your room with headphones or sharing your tunes out loud \u2013 play your way!\n\nEmbark on a self-paced musical journey. Whether you're a novice finding your rhythm or an expert perfecting your craft.\n\nTrombonest Features:\n\u2022 Three Difficulty Modes: From beginner to advanced, master notes with perfect pitch at your own pace.\n\u2022 Embouchure: Use the joystick to mimic mouth movements, unlocking a range of notes as you play.\n\u2022 Visual Note Indicators: Always know what note you're playing with immediate visual feedback.\n\u2022 Music Theory: Learn how to play notes in a major scale.\n\u2022 Passthrough enabled: Play in Mixed Reality.\n\nYour musical adventure awaits. Step into the shoes of a Trombonest with the most immersive VR experience yet. Discover, play, and let every note tell your story.\n\n", "short_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting!\n\nIn your room with headphones or out loud for all to hear \u2013 play your way!\n\nSelf-paced discovery for novices and experts alike.\n\nTrombonest features:\n\u2022 Three difficulty modes guide you to play notes with perfect pitch.\n\u2022 Simulate embouchure (mouth movements) with the joystick to play different notes.\n\u2022 Visual indicators show you what note you're playing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7839768739370100"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id":
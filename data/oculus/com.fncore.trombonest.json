1szZuH4dbBSD9TBLN9kXgxg&oe=6AE76431"}, {"file_name": "05-toward-the-window.png", "id": "2313409272787249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593714175_2313409276120582_2065833234755679436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guKAj2CP2ZsQ7kNvwFYDURp&_nc_oc=AdrJXwFjcdS0OXNsXPCoom6LiD5EubZHw5BVaVxZ-CIPwdjsnAp68vvgTy7j19xtXSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmDCRJTLH7hnw9WMuFmO4loypHLuMY4PIAmSz3mK-fpQ&oe=6AE754DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trombone-preview.png", "id": "1426516125667848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620532_1426516129001181_1781586510123128115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz5Q6xAbTdMQ7kNvwFRdfig&_nc_oc=Adr_3At9bQ3NsNU70WXz-Mk2NXnDe7rIWQOx8NaYMETCxmgdeeITa4nFbDZbSH_1OS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvtX2sgb51CUk1rUmD_kxveEGYL-gPh8iu3e1wA7leKw&oe=6AE750BF"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "A trombone, in mixed reality.\n\nHold the trombone in one hand and grab the slide with the other. Push it out through seven positions. Pull the trigger to blow: the further you pull, the louder it plays, and a sharp pull puts an accent on the note. Point the thumbstick to change partials, the job your lips do on a real trombone.\n\nThere are three difficulty modes:\n\n- **Beginner** snaps you to the notes with auto-pitch, so you play in a major key.\n- **Intermediate** turns auto-pitch off. You find every note with the slide, and can slide between them.\n- **Advanced** turns off the HUD, so it's just you and the trombone.\n\nThere are no songs, lessons or scores. Play whatever you like, without waking the neighbors.", "short_description": "A mixed reality trombone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_ter
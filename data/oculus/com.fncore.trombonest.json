zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyF9nlO-fxgJ9UIY_08cp54YEuSDsTs7HVAVEir-Llxg&oe=6AF5D90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1122116437460891", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628893_1122116440794224_4575586154876569219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztE3cpBeVS0Q7kNvwH7IXHu&_nc_oc=AdolgD80pxovdUQouveA1C9-AaMOJFd2m0P_IdbR3FIIO2HN2qIf7h1MxG3Fos7d_zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTChfzoNOascKF4gF8tULK8K5vb2mlwF0-IKm0byRm2GQ&oe=6AF5DE71"}, "display_name": "Trombonest", "keywords": ["trombone", "music", "instrument", "passthrough"], "long_description": "Pick a song from the music stand and play along. Each note shows up on the slide as you go, so you can play Ride of the Valkyries whether you\u2019ve held a trombone for twenty years or never at all. 44 pieces to choose from, including Beethoven and Mozart.\n\nOr skip the song. The slide works like a real one, so you can pick out any tune by ear.\n\nNever played? Turn on auto-pitch and every note lands in tune. Already play? Turn it off and find each note yourself, like the real thing.\n\nPlay whatever you like, show your friends, and don\u2019t wake the neighbors.", "short_description": "A mixed reality trombone. Pick a song and the music stand shows every note on the slide \u2014 or just play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED"
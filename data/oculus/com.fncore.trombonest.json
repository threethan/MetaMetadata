771-25/38982728_871272154688348_7042354902335487275_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf0uDxWPAtsQ7kNvwGrXG3S&_nc_oc=AdoUtT_4cucSvZ3RF0jFUFwlmwoaNLXlC1pnHcWT_XTjfiuup9IzLepqgHMAkDr8Dks&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK3sEFvupH8FIFaLoeG_Ctv-tVOyn01PhwguKzAlrMGQ&oe=6ADCC5B9"}, {"file_name": "IMG_2307.png", "id": "421042843687870", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982538_421042847021203_8908044085356263319_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbDfzLNYdEEQ7kNvwGmcAFP&_nc_oc=AdoIDPsopUJDV5WRCIa8wR69v5Ad8508TcBbe35hFeJbK654yPVcJFXaU12I-8kuuQk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM0T15kSl70FO_nWTOE4mIsmdxSjeN203X8Y981vNv-A&oe=6ADCB5BE"}, {"file_name": "IMG_2309.png", "id": "1050655896014987", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982640_1050655902681653_7224036735796915478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs3kL2oSjyUQ7kNvwFzXP6X&_nc_oc=AdoHFpmHozKfaJ8YU32vo-kCU4b2P58u8vBpLiQFx6sukFl8_0sjthqCSYHpWSehObE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZpC3LAToQw1ioFQ7oR7rxxph_KcKO5j5HKKlnibUfFQ&oe=6ADCCB03"}, {"file_name": "IMG_2305.png", "id": "410278031495927", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982695_410278034829260_5886097420940237187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCpfAh0f5iEQ7kNvwHXQ0a4&_nc_oc=AdpDeCuYVnWA6rshQSBc8DEMHP8cteN3fawauXz3QTfY_rL_QuFxgq18IwQdHSTnCSE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPasBFQkY0PKlfOUd1yYM_KoCYlBt_pl5vUnXEnJqCiQ&oe=6ADCCC81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_2306.png", "id": "2339971483059481", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001696_2339971486392814_3198424105276136026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH97Qt93OM0Q7kNvwEXPsAT&_nc_oc=AdqePThyycGTiwEwtfnhbYMnJlvta7F0IGS47GZpo8N6ouS0Ok0rEIp_TnltOMezQjs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8KKbosARZXq7oT2Bghp59qOvX2Z2IVCV8nAYQZpX38g&oe=6ADCB001"}, "display_name": "Trombonest", "keywords": [], "long_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting! Whether in the quiet of your room with headphones or sharing your tunes out loud \u2013 play your way!\n\nEmbark on a self-paced musical journey. Whether you're a novice finding your rhythm or an expert perfecting your craft.\n\nTrombonest Features:\n\u2022 Three Difficulty Modes: From beginner to advanced, master notes with perfect pitch at your own pace.\n\u2022 Embouchure: Use the joystick to mimic mouth movements, unlocking a range of notes as you play.\n\u2022 Visual Note Indicators: Always know what note you're playing with immediate visual feedback.\n\u2022 Music Theory: Learn how to play notes in a major scale.\n\u2022 Passthrough enabled: Play in Mixed Reality.\n\nYour musical adventure awaits. Step into the shoes of a Trombonest with the most immersive VR experience yet. Discover, play, and let every note tell your story.\n\n", "short_description": "Become a Trombonest with your very own VR trombone.\n\nGrab the slide and start tooting!\n\nIn your room with headphones or out loud for all to hear \u2013 play your way!\n\nSelf-paced discovery for novices and experts alike.\n\nTrombonest features:\n\u2022 Three difficulty modes guide you to play notes with perfect pitch.\n\u2022 Simulate embouchure (mouth movements) with the joystick to play different notes.\n\u2022 Visual indicators show you what note you're playing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trombonest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fncore", "support_website_url": null, "website_url": "https://trombonest.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cate
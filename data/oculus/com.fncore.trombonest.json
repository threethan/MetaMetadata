4550386", "version": "1.4.7", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29917032714550386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "A new trombone model: a smooth bell, round mouthpiece and slimmer slide, all in brass. The How to Play card shows it.", "created_date": 1793230519, "id": "29870165815903743", "version": "1.4.6", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29917032714550386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Improved tutorial. Improved sound quality. Improved Trombone HUD.", "created_date": 1793156527, "id": "29857323470521311", "version": "1.4.5", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29917032714550386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Fixed slide proportions: a bug moved 7th position further away the more you played, so it got hard to reach, especially with long arms. That came from a feature that stretched the slide to fit your reach, which was not well thought out. The slide now matches a real tenor trombone: positions are measured from where your hand sits in 1st, and they're 8.2 cm apart growing to 10.9 cm. New in Options: Slide reach \u2192 Set moves 7th to where you can reach.", "created_date": 1792818332, "id": "29803187642601561", "version": "1.4.4", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29917032714550386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Fixed: changing Partials in Options now takes effect right away. Since 1.2.5, the trombone in the menu kept picking from the old number of partials.\nFixed holding the trombone in your right hand (Options \u2192 Slide hand: Left).\nSaved videos show the trombone's bell again.", "created_date": 1792801929, "id": "29800604739526518", "version": "1.4.3", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}},
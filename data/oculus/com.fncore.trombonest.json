7373694922", "version": "1.4.0"}, "id": "222012607382595", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29725587373694922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Record yourself playing and save it as a video: open the menu, press Start Recording, play, then press Save Video. Fixed an audio bug.", "created_date": 1792372694, "id": "29725587373694922", "version": "1.4.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29725587373694922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "The stick picks a partial by the way you point it again, so any partial is one push away. The menu-button hint now sits on the \u2261 button.", "created_date": 1792299775, "id": "29712985754955084", "version": "1.3.0", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29725587373694922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "A quick, sharp trigger pull now punches the note, and a note starts the moment you pull the trigger. Trombonest no longer asks for the advertising ID.", "created_date": 1792281697, "id": "29710255605228099", "version": "1.2.6", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29725587373694922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "Trombonest 1.2.5\n- A more accurate slide: with auto-pitch on, notes hold steady at the nearest position, and the slide's reach adjusts to your arm as you play.\n- Play left-handed: choose your slide hand in Options.\n- Pick your difficulty right on the start menu.\n- Simpler, easier-to-read menus, and your settings now stay saved.\n- Notes start right away and sound cleaner.\n- New players get hints on the controllers.\n- A much smaller download: 37 MB, down from 98 MB.", "created_date": 1792263615, "id": "29707555545498105", "version": "1.2.5", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7342599042420408", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29725587373694922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "222012607382595"}]}, "change_log": "\ufffd Bug Fixes\n\n    Ambient Lighting on Trombone\n    Resolved an issue where the trombone\u2019s material did not correctly respond to scene lighting, causing it to appear too flat or washed out in high-contrast environments. Now:\n\n        The trombone\u2019s brass surface accurately reflects ambient and directional light sour\n\n\ufffd Other Improvements\n\n    Minor performance tweaks to reduce audio-latency spikes when adjusting slide position.", "created_date": 1747584853, "id": "24325897390330641", "version": "1.2.4", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
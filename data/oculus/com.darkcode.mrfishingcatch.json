com/v/t64.5771-25/491823386_893223140306052_7247777023707274697_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrQGE0CJGuoQ7kNvwEUvGxG&_nc_oc=AdpuUs5vW97So0EF8-eepDPzU38e5XHBIKVF73Z6jIm6Jd3hc70VvW2BWC__LEijD80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7V7PzJLcAJ-_xJZ7h_Ajo22IXi15XE_i8TnyuF4tpWg&oe=6AA6A97B"}, {"file_name": "store_screen_capture_3.png", "id": "1484525676363030", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1484525679696363_7274616992819143480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5RruZGyMbsQ7kNvwEB0U6f&_nc_oc=AdowyCwzJmmNeaBqD_oZMUQsNf1HhUNtUE6JEtdrC1ZboM765VC5OsJGXywZY5UXBGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCoX6-eyLwnFSWSXM9dA-eab_9buxqo3G4JLRMMjUYRg&oe=6AA6BDB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Fishing Catch", "keywords": [], "long_description": "Dive into an exciting mixed reality fishing adventure right in your room!\n\n**Gameplay**\nMR Fishing Catch transforms your space into an underwater world. Watch as colorful fish swim all around you in mixed reality. Use your hands to grab the fish and drop them into the basket below to earn points.\n\n**Features**\n- Intuitive hand tracking - no controllers needed\n- Realistic fish swimming animations\n- Score system to challenge yourself\n- Family-friendly fun for all ages\n- Immersive mixed reality experience\n\n**How to Play**\n1. Launch the app and look around - fish will appear swimming in your space\n2. Reach out and grab a fish with your hand\n3. Drop the fish into the basket to score points\n4. Catch as many fish as you can!\n\nPerfect for showcasing the amazing capabilities of Meta Quest 3's mixed reality and hand tracking features. Whether you're a VR enthusiast or new to mixed reality, MR Fishing Catch offers a simple yet addictive experience.", "short_description": "Catch fish with your hands in mixed reality! Grab swimming fish around you and drop them into the basket to score points. A fun and immersive MR experience for all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aplai.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "\u5409\u683c\u7dda\u80a1\u4efd\u6709\u9650\u516c\u53f8", "support_website_url": null, "website_url": "https://aplai.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26499446372981355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619465_1383444926421093_3697121317810730619_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33BNELcs2hEQ7kNvwGgclsI&_nc_oc=Adpfv1Wtbn0sv0NW3NSjr-4fovsrCqHISlt1IKOLt2PNBEvN3H818uogwgRN2jGOzBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAC8o352t5Mxq-M0cYaEwqg4yNnwbGADpN81f7Z46pEw&oe=6AA697D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MR Fishing Catch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1770879300, "lastRevision": {"nodes": [{"id": "26499446436314682", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86659800_280890753926353_5856658782069019058_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vdc4lZPrd8Q7kNvwFTajZ1&_nc_oc=Adrkns1Mp7PAfdHroYD2ZSJ7BoXi0mo8DKMz09rsJGA3_LM99Nu_ikeLXiNQy_cknU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcHyGn8roYuCMan5Dd1euIIqyazGvqpC3VNnUFMWwjUg&oe=6B031AE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kitesurfing VR", "keywords": [], "long_description": "Kitesurfing is an extreme sport. It is quite complex and requires some advanced skills to practice it. You can get impression of what it looks like, have some fun, face the obstacles, perform some jumps. The kite control is the key to this sport - it is required to be practiced, takes time to learn. With Kitesurfing VR you can develop some skills even at home.", "short_description": "Kitesurfing got popular last years as it offers extreme experience.\nGet impression of this sport, have some fun on the water, improve your kite control skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meltingamevr.eu/privacypolicy.html", "developer_terms_of_service_url": "https://meltingamevr.eu/termsofservice.html", "publisher_name": "MeltinGameVR", "support_website_url": "https://meltingamevr.eu/support.html", "website_url": "https://meltingamevr.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
ontent-atl3-3.oculuscdn.com&oh=00_Af04gVBWORlJznEHS7OU_dtObfpd_xmJHIOMCYjJLEUTqQ&oe=69F1EE9E"}, {"file_name": "4.png", "id": "370672288349932", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210391_370672291683265_7529186512780721112_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKqh5et3xV8Q7kNvwHoxrZl&_nc_oc=AdrjsxXrEJXDIlS0GbnTUlcLX3Fgxfu2woFG6qJpJbQuwG7eeySjnSoHYP_BLSHkVYk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2TWTbKmbhm_iOOeRpuCtaJQCvslWDJeDaM1AvbsQ_NZQ&oe=69F1FDB8"}, {"file_name": "5.png", "id": "335544215455728", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/227814954_335544218789061_5657980759783090633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgzcIvTHqRsQ7kNvwE1ZH2-&_nc_oc=Adqy21JHll1VhKWUcKvFJZZYlbMhBet62DdlVYfc6AMC2N-qBF50br1KkRC0DJO33-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0Bb9vTxBRBPDWku48My-Y2fdD8OvJJi7TU58TPLmRc6Q&oe=69F208AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kitesurfing VR", "keywords": [], "long_description": "Kitesurfing is an extreme sport. It is quite complex and requires some advanced skills to practice it. You can get impression of what it looks like, have some fun, face the obstacles, perform some jumps. The kite control is the key to this sport - it is required to be practiced and takes time to learn. With Kitesurfing VR you can develop some skills even at home.", "short_description": "Kitesurfing got popular last years as it offers extreme experience.\nGet impression of this sport, have some fun on the water, improve your kite control skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kitesurfingvr.wordpress.com/kitesurfing-vr-privacy-policy/", "developer_terms_of_service_url": "https://kitesurfingvr.wordpress.com/kitesurfing-vr-terms-of-service/", "publisher_name": "MeltinGameVR", "support_website_url": "https://kitesurfingvr.wordpress.com/kitesurfing-vr-support/", "website_url": "https://kitesurfingvr
0f&oh=00_AQKCZ4ifeVTE3JweArPVGedtdTn2zsnhjQDQJMltmrxIwg&oe=6AA3FFB9"}, {"file_name": "Screenshot_20241222_180943.png", "id": "3683783575172400", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974512_3683783578505733_4427759407961061066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tG5HabG_EcAQ7kNvwEZuuzx&_nc_oc=Adrst-Sz5FRf--2ESSHK9khtLDqOG_N635oaVEq1AwAk_cL30mFeVa07XE11Q434rZY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLQ4wsUuxKIx8Cw2RakwLZPfH2SvhDGT9Z8KEV-67ojQ&oe=6AA3F8FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Artboard 1.png", "id": "574687648623500", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974692_574687651956833_5536425736422327310_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBloDQWbP_AQ7kNvwFiDC7M&_nc_oc=AdoFE-DqOpYzFjluk3dUpACWzkqMzo3j2Tlc2evIevC4VdvALXPND_gO5zPp7zmGu-U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1kk5fembEssaEqzmttFtU-Wwce275gIRSzu4CwdBwwQ&oe=6AA3F86A"}, "display_name": "Circuit Cinema", "keywords": ["video", "television", "vod", "movies", "film"], "long_description": "Circuit Cinema subscribers can now stream our collection of festival circuit favorites and contemporary arthouse films in VR and without commercial interruption, including our growing collection of exclusive movies and TV shows. The first live-action primetime series filmed in VR360 is premiering in 2025.\n\n{556319797388194}\n# NOW PLAYING: You Are Here: A Dylan Brody Project\nA Circuit Cinema Exclusive. When a middle-aged LA sound editor (Paul Provenza) gets wrapped up in conceptual artist Dylan Brody's (Michele Martin) quixotic quest to make an impact without making a name for herself, it sets the stage for writer/director Dylan Brody's bitingly humorous take on art, commerce, film, and name recognition in Hollywood.\n\n\n{888633240122847}\n# NOW PLAYING: Bad Romance\nA socially awkward, lonely guy, Rob, attempts to track down the man who killed his wife -- but not for revenge. An inventive comedy and ridiculously entertaining mashup of neo-noir & romance, with nonstop laughs, a meta spin, and mind-bending plot like Memento or Shutter Island.\n\n\n{1958515834616062}\n# NOW PLAYING: Homecoming\nMadde lives the single life in Stockholm. One day she receives a letter from her father who wants her to return to her childhood home. An emotional weekend changes her life and her view of the rural area she left a long time ago.\n\n{3648330798792505}\n# NOW PLAYING: Forty Winks\nFORTY WINKS is absurd, bizarre, wild, entertaining, funny, bold, heartbreaking, and human. This dark psychological comedy features Susan Sarandon and John Turturro.", "short_description": "Circuit Cinema subscribers can now stream our collection of festival circuit favorites and contemporary arthouse films in VR and without commercial interruption, including our growing collection of exclusive movies and TV shows. The first live-action primetime series filmed in VR360 is premiering in 2025.\n\nNOW PLAYING: You Are Here: A Dylan Brody Project\nA middle-aged LA sound editor gets wrapped up in artist Dylan Brody's quixotic quest to make a impact without making a name for herself"}]}, "developer_name": null, "developer_privacy_policy_url": "https://circuitcinema.com/privacy", "developer_terms_of_service_url": "https://circuitcinema.com/terms", "publisher_name": "Circuit Cinema", "support_website_url": "https://circuitcinema.com/pages/faq", "website_url": "https://circuitcinema.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvngLiihm1n_14Q0PDqgN853UgLD_UTnGY3gI_ehW6ZA&oe=69C2A196"}, {"file_name": "ApplicationFrameHost_FLZ4PDhMEM.png", "id": "8827026900695535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57574727_8827026904028868_6926863569744680898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cyhAt18tnwQ7kNvwHAk269&_nc_oc=Adrv9nYcQP-OvkHZRpVKDTZpyURKpdYrjcq4WhED6h94yez5L6WEXNvolb-KhR7yGGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwewsqO72jt4qU_oa-koDba5zcGNqjwVNPtj1kEoNRIng&oe=69C26D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "005.png", "id": "568354598943726", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75469623_568354602277059_3985165393310419772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLTVO8QW6GgQ7kNvwEHjsU-&_nc_oc=AdroBX9xT-pThjV9DsVg4t9K80rLR9r9OmFXtVjnpA6GlBTkEvcQEdf9-qfwxuAt7fg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyfhu91hBFQsDUOaWXkWYPoSgZagD1WoNjwUBzpHnSNFw&oe=69C2794F"}, "display_name": "Wind Power Energy - ContentsDA Science Experiment", "keywords": ["experiment", "environment", "wind", "science", "contentsda"], "long_description": "1. build the wings, which convert wind into rotational energy.\n2. Build the transmission. The gearbox will amplify and transfer the rotational energy from the wings to the generator.\n3. Build the generator. Install the generator to generate electricity from rotational energy (magnets on the rotor and coils on the stator).\n4. Build a steering system. The steering system allows you to control the direction with a controller.\n5. Make the wind turbine generate more than 1500kWh for more than 10 seconds. You can turn on the fan by pressing the red button.\n6. Build the wind turbines in the back in order.\n\n- Understand the structure of the wind turbine and how it converts wind energy into electrical energy.", "short_description": "Delve into the principles of harnessing wind power. Learn how wind turbines work and their role in sustainable energy solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8588015394587549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57575352_411838301803155_8139306592247753758_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hidpDNhUgX0Q7kNvwGkr5Ne&_nc_oc=AdoDfylzvzuOlR420qbcCTsUetLEMmbckQcQDgyvVMLTCY_YA0ebvT6tgvmCI3fLDzE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvJKGdrnbrjco_82xkiBGLr3WyeFu620vqq_mFcz93jQ&oe=69C29652"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wind Power Energy - ContentsDA Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1710878100, "lastRevision": {"nodes": [{"id": "72422104625013
sKld2FJeeh0-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jjb6I73xtc8lNgppznijtc5TMP-wzxAZyZIukli0Bbw&oe=69D3C593"}, {"file_name": "screenshot_20241015_221844.png", "id": "544496221604458", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75250457_544496224937791_7555452040001700922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pag7PP-xmFIQ7kNvwFJz_9A&_nc_oc=AdqpQN7LJgeOWrcYWhxKelESsLCqrMr3p4aZ_YhcPUt6BRGXpO8JVVj1YolpVK9ovRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0efwh7IKTSU_-OTUWMpLhX1spfWDifaUnEgPVnsuz-jw&oe=69D398A7"}, {"file_name": "screenshot_20241015_221649.png", "id": "570037052069059", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569430_570037055402392_4039269136698728753_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Okeg9_tBo0oQ7kNvwEzW0vj&_nc_oc=AdqB5XP48XcP5Rok0tcLPQVnEoW9AEUcZtqaoDpFf526UZlCQHt7lWus5LI5Uc337YY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jtcv4R43bLSbmZ9sKO4NRRUwyWxLolGsQLXpg_H8YHg&oe=69D3939D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Discovery 2", "keywords": ["build", "craft", "mine", "block"], "long_description": "Explore a giant world made of blocks and modify it with your own creations. Construct houses, build entire villages, cities, monumental constructions or dig deep underground.\nPlace torches or design complex electric circuits to light up your creations in the dark and enjoy beautiful day and night cycles.\n\n\u2022 Creative sandbox block-building experience: Create your own worlds with more than 215 unique materials.\n\u2022 Mixed-reality tabletop mode: Built your world as if you would play with bricks using controllers or hands.\n\u2022 Jump into Virtual Reality and experience your block world as if you were there with incredible 360 degrees immersion.\n\u2022 Crossplay-Multiplayer: Play together with your friends and family in VR and non-VR.\n\u2022 Inking system: Customize the blocks with 16 different colors.\n\u2022 Build-In World Gallery: See what other players have built.\n\u2022 Easy accessibility, Simple controls", "short_description": "Unleash your creativity and create impressive worlds in first person or mixed-reality table top mode. Share your creations with the community or download and rate worlds from other players. Swag GFX make your worlds looking breathtaking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://noowanda.com/privacypolicies/discovery2-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "noowanda", "support_website_url": null, "website_url": "https://www.noowanda.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1676485315806614"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8734464593277828"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2004956743695852"}, {"status": "PUBLISHED", "id": "1412410923092428"}, {"status": "PUBLISHED", "id": "829791966720861"}, {"status": "PUBLISHED", "id": "25079321365082534"}, {"status": "PUBLISHED", "id": "1479999426380350"}, {"status": "PUBLISHED", "id": "1427229888501532"}, {"status": "PUBLISHED", "id": "1466481911181539"}, {"status": "PUBLISHED", "id": "1293250122472262"}, {"status": "PUBLISHED", "id": "1298475784824052"}, {"status": "PUBLISHED", "id": "1117253239741736"}]
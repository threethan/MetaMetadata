15_221559.png", "id": "1536594320315143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001673_1536594323648476_4452510121254547919_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDYeA8x3uBwQ7kNvwFUS9Ys&_nc_oc=AdoomRnYTK3NytEV4AJxeVyoNtPGNDKKOAOhIlxH3wEzFT_LuYTRBBm78UyhWPuzn-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL8pz0YmkJzlx5-3PvmFkL_Vmcb-o95RowiJYMbf2oew&oe=6A54DBEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2650_1440.png", "id": "1103267984780240", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036651_1103267988113573_8467438018005738135_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiVL4U5CFCYQ7kNvwGZIXfR&_nc_oc=AdoQI6fTZPqdvqYdpq_A50QgoiStMoAxBN_ylmCXfiIhpKfmbCZPTeBrfFDbesWhzlc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATnOoJSuswMhAx1H868TDzOCPPImNMRSXbwt3gvYn-zw&oe=6A54E104"}, "display_name": "Discovery 2", "keywords": ["build", "craft", "block"], "long_description": "Explore a vast world made of blocks and shape it with your imagination. Build cozy houses, bustling villages, sprawling cities, monumental structures, or delve deep underground. \nBring your creations to life with torches and intricate electric circuits, illuminating them under stunning day and night cycles.\n\n- Creative Sandbox Experience: Craft your own worlds using over 215 unique materials.\n{1324113942093944}\n- Mixed-Reality Tabletop Mode: Build your world as if playing with bricks, using either controllers or intuitive hand tracking.\n{915581407342346}\n- Immersive First Person Gameplay: Step into your block world with incredible 360-degree immersion.\n- New Engine: Enjoy cutting-edge visuals with HDR rendering, realistic materials, and stunning modern effects.\n- Crossplay Multiplayer: Join friends and family across VR and non-VR platforms for endless collaborative fun.\n- Inking System: Customize blocks with 16 vibrant colors to make your designs truly unique.\n- World Gallery: Explore creations from other players in the built-in world gallery for inspiration and community connection.\n{1119967412813155}\n- Accessible and Intuitive: Dive in with simple controls and easy-to-learn mechanics.\n", "short_description": "Unleash your creativity and create impressive worlds in first person or mixed-reality table top mode. Share your creations with the community or download and rate worlds from other players. Swag GFX make your worlds looking breathtaking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://noowanda.com/privacypolicies/discovery2-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "noowanda", "support_website_url": null, "website_url": "https://www.noowanda.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1676485315806614"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "9060112077379743"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035358_965644492073606_3614916947412427318_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhUOELUqAPoQ7kNvwHixjVD&_nc_oc=Ado8vjCxSXkefDg-l9Ffe9xiUs-7YniONdQEBKfCR3C8eVb0kbG0Wp26tQ6EvWZgFrM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAESCl2OLt1MMJxAqcRLvv8OhRbLI7t_o50IFIgh6rZlw&oe=6A54
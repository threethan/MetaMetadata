VxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg_Q0hm5Uj-utwZl1r8wTN2J2PeK812Zg8GXTw2lV2Lw&oe=6AFC8A87"}, {"file_name": "Screenshot 4.png", "id": "1645502727221984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1645502730555317_6710768601449753746_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCdl8S4anTQQ7kNvwEs4NTp&_nc_oc=Adr2yLpB9rN-gCWDfoIx3WuI-w5fe2HeGL-IAl-QvaQ7np_Tz7hTfsbusEvSnh80G4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd9BSQ14wGVgIlITZmBGpx0VoF-qW3GhFag93p0mA51A&oe=6AFC7AD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RTX Lethal Ape", "keywords": [], "long_description": "RTX Lethal Ape is a multiplayer VR horror game where you move with your arms. There is no joystick: run, climb and jump by swinging your hands against the world.\n\nSURVIVE TOGETHER\nExplore a dark underground facility with other players. Monsters roam the halls, landmines hide in the rooms, and lockdowns can hit at any time. Stick together, talk over voice chat and keep moving.\n\nMAKE IT YOURS\nEarn gold and spend it on hats, shirts and more in the shop, then wear them from the wardrobe. Pick your name and color at the computer.\n\nMODS AND MENUS\nUnlock hand menus packed with mods like Fly, Speed Boost, Long Arms, Platforms and more. Change your size, play sounds from the SoundBoard, or show off with name tags and bundles.\n\nPLAY YOUR WAY\nJoin a public room in seconds, or type a code to play in a private room with friends.\n\nRTX MODE\nTurn on RTX mode at the computer for sharper, richer visuals, or switch it off for the classic look. RTX mode is a graphics setting in this game and does not use ray tracing.\n\nRequires an internet connection. Optional in-app purchases are available.", "short_description": "Swing through a dark underground facility as a gorilla. Survive monsters, landmines and lockdowns with friends using voice chat, then unlock cosmetics, mods and hand menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rtxlethalapeprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Lethal Ape Ultimate", "support_website_url": null, "website_url": "https://sites.google.com/view/rtxlethalapeprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1463713573484833"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1472959232560267", "version": "OGLethalApeMods"}, "id": "1117935577385245", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1463713570151500", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1472959232560267"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1117935577385245"}]}, "change_log": null, "created_date": 1793631100, "id": "1472959232560267", "version": "OGLethalApeMods", "version_code": 87, "release_status": "RELEASED", "status": "APPR
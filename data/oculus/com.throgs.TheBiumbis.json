ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21ZYEZ3vhcYQ7kNvwFLO_kU&_nc_oc=AdrDSvr-MULtsfRxF6J5jMpP5vmmCHpOeiwzxgNDrUUI7YA6cYft6tI1ewC1AtQ2LjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3PjVdbji5VbrL0ji5F3IRPkc3IqWtI1EtvU9RK7YqQw&oe=6A50F2C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1gUn6dw6RcQ7kNvwHGav-u&_nc_oc=AdpdwEVU7TCeyW968PYNp2OAbsDID47D1ekAg6wbVuOTEZ7VYSZtzMvZ8Ao_9XpPzZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYx7hvKDMf6rbY4Mv1AteQbgI6acidwaR6FlcH5az0cQ&oe=6A50FAED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zeGVPKbz0cQ7kNvwFDS-Wk&_nc_oc=Adqt_pMwVvTMafmBSRjvSGCMmoCwje97Wp9HvUJlkGTBlSRifHAnl0geC2ZQi3ONYpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANF94uj1N7xPSSo4uw26AB7Q8PdjaSrccO1hcz0KPxaw&oe=6A510E50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCwePcEBkykQ7kNvwHDMt7k&_nc_oc=AdraH0VlAxgQsghveOq6VuGo5cTL9ozCr1R_0sZlpBPQtKVJUGXxp8UTXuwKm0SYids&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtKK5mQrCCty38heBaLGeimwmRlZzBA54c8_cBZrKDdw&oe=6A50F3D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
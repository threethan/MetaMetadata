ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cH2lHgV3_kQ7kNvwFBGZj9&_nc_oc=AdpeRnYfHvzBXzSZUL0zP5fGRBUnP4YzOsum6sHR6Z_3AMzbMo8EiWpdTimKnxCDKaQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af518pJov3vHdhCXIrO8J31OxZ3jQBVY47s51AqQ89dzKA&oe=6A0C64C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEGqLHSSSxUQ7kNvwE9NN8-&_nc_oc=Adq_74MZ6RZK6yIncHthHYXAq7vM5oBFhRUk_qSgwsBOAJMwCNwy7-jnLRtCZYENd4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Uu4X4G8iCabzZaESA1xWWbDVG3TvfgcEovzBpmaucg&oe=6A0C6CED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_Hk7drA1qQQ7kNvwHHdTLZ&_nc_oc=AdojmGwKVgjn6B38s7tQ-ddG4fVr5GgeZuOSsJIlac1ios6NQwTcAalpmj4DtYfhT14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ed_bZi_GfoAznLBKyPjJ65ToDZ6hbfUY-qew2-wHOgw&oe=6A0C8050"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXqbNgXvc6sQ7kNvwHRMnVP&_nc_oc=Adp9C36l6D36Cvoe2lPfebTQ6_xBZv3zeY4lzkA3O4Ge4mjf3I4O3jvHyIXvMCUaSFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vi5Xskle36bNfF5WhRxalw6VS65MeXc-UTAblDnTsAA&oe=6A0C65D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
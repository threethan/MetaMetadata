cb=1-7&_nc_sid=6e7a0a&_nc_ohc=k43_mPAgx-AQ7kNvwHVcK71&_nc_oc=AdrXSz7FPZ2_of8Q1duSH-8wV0WFyTyof-2uhzz5UZN1QXw8gqc1xkXyqd4xjJOj4Dk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw56ekGpwTDcGaWxuS66G_Ye0MbAqPxbOyXB3ve1LB-ZQ&oe=69C14D89"}, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nPlayer has to collect pure drops as ammo.\nWhen ammo capacity is completed, the player must aim at the enemies.\nBeware of toxic drops and obstacles.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "https://madewith.unity.com/games/the-biumbis", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics
ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QZSbMP1jTwQ7kNvwHsIlTr&_nc_oc=AdqUQgM4f0Bvs9Uwbz5Hp6AsdO0oogp-818ApO2HWWVlnmmZr7U2r18CBXE3P4Wc4vQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hXM2NUZSAr4dGEYWn6DPxMtyUvBnGKXzcAW9X74qhNw&oe=6A43C3C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8F1tStqqgkQ7kNvwFrRvyV&_nc_oc=Adq23X_iC5jKC3yl0yvq_N-9GY-G3FWyLxYGOJ_s2uVCP8eI8zdtQFCsOMJnp3H5LK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K7BY2npTIGW6CYi8qzULGpasOgApe8DzTD3kKX8YUdQ&oe=6A43CBED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc09Njr-gqsQ7kNvwHheowu&_nc_oc=AdrpiKiii020THQ8wz0qc2Ck0vaB885Do0EoVOx6in4dG76sf6-N6teLZ9dyvwzSL2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q3sxppZQr4G-2rPijnFZyvn0YHRJ9cNG4cwgzVQ_rNQ&oe=6A43DF50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdWt0U7MTIMQ7kNvwEnMFNS&_nc_oc=AdrocY2jXLBlRISbUXfTWcei-cu6TpJSWiWNOnQ0wTSaZ7U9WzwTp90lo-ZyUmPTpn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tA1JcwKcChqALd4JfyPdN7FljnwEiF0L4n4fGEwy_ZQ&oe=6A43C4D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
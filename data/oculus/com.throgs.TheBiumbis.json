b9FBlmQyRntZrRXD2jCEMwWYaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdIBW3adA8OSu-i1xxEjWq4bm221cAFZvCD0hQfw-5ow&oe=69A2ECC0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpmS9iz4l6gQ7kNvwEJj6Ml&_nc_oc=AdnathB96AU7a5Y-TpCsOHLLuvMINbYqRT0x-ybP86k_Jy2Te7TrrvxCwOZhmsC-cLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvHRbS3-b1oXwPv0KImTuUkvDr1l8WOGzaZEBxBSFjlOQ&oe=69A2F4ED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0kf1494S6gQ7kNvwE0Oujk&_nc_oc=Adnc63YMsmuKHak8er-Xt8PHyQuyJdoUvZF6MG0NcILAYYuGEdRBE8f5LsHUmbw_nSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugIyR70D0VWESMX6__Fa7klyPFMtUM7OTCDFU09t6kyw&oe=69A2D010"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3w1C0Il3fQQ7kNvwG9PKRz&_nc_oc=AdlCGYaO63G2xKqHoDuT3KYuNbEQAabITTzrZNOyDRhbwwWmmo6HMXqenVBklyrZDhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsv3drIemUNfMim7NksQa_Tu2h0SPF_LoPWdmGNaEKvRQ&oe=69A2EDD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1099941983394935", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc
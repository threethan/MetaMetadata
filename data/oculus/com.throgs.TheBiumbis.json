ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gy_3G8K07gQ7kNvwF0X9jL&_nc_oc=AdoOSt1gedofHomvTCULVqsswymMPMOpj0PWVbqlFqEUKSIINcOlS8NK2P4MpcTnGP8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_FG9qpvmgbiMspAfKLKYWKJ0_C2nF8PHQ5bj0It_0gw&oe=6AF9EB00"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVoWJ-l0DwUQ7kNvwGo0c27&_nc_oc=AdrDnGEz2M5M578Q1s-lk3oYIRfAj-sALPSYXFX6Uv7mlOzB0bj6VcIaGnSa9KHxcA4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrcBTbDZ6R9DTCe5oo6hfzZTRzo2YQ1naVVmTAizlMTg&oe=6AF9BAED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8U0w-Q0X1YQ7kNvwEiUHho&_nc_oc=AdoW-dk20zqYks4grQIqqd4EKOW0kKz_-XDbtmRFTdZgeTurSbQULfv_PjVutveMs30&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5N6VmBVd3ph-RlCLnkRGlfoWTuFnGvECz0M5WDWWwTA&oe=6AF9CE50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_J53AeLEW0Q7kNvwG8Bq8J&_nc_oc=Adp9CsdnU8EPW_UGIMD8RRjqiGwvIZl979yA9-sdVA6W0OoM1a9mB920xLyARAAC3CY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWhVrwCQSaiP___j81JEOxzxcs05awj2ix1lrkSV0_hA&oe=6AF9EC14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
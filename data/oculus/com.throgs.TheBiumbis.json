ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3Q2hRcrzA4Q7kNvwGBbTtD&_nc_oc=AdoxzDL55AlKGtJVkomTfJ2kya2xWrctZuIo-C8LRJg2YhyWoHH1VnTD629bkK-7fsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRYauK6moyUQJYjS2ccJ-JthmFF7JMaFP9mljnbbfNlA&oe=6AE1F7C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDuDu81JeyoQ7kNvwFaLm9_&_nc_oc=Adrk-59TiUn3v69_-irjvz_Gwkxe5SUbBeczOZWQbV8uCA-Bh8MlQs4of_tA3yN4M_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYheHemPfawdeHoX1VCxG3gPjhypVAZIjGR7gjBYj0cA&oe=6AE1FFED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUX-T91plUQQ7kNvwH3DfY1&_nc_oc=Adqs3KPtMiMxOaDfpEAQR43VaK_h1Dqy-LHXW04DrnDN0dEQjytatw5zLeDtCmKE3b0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5_ZgazNCYWhpsGkQueTlB1iHhvtvOgiMbOsld2zsz6w&oe=6AE21350"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Sish_9cIK4Q7kNvwGIYgK2&_nc_oc=AdpvZyAIPuqar5BkeAQsptRmhRv-mrU0st7tmLaxdEJt44h_8Kyyq2CplQtlgCdx4cg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdZ-ACQF1PVJ0Rxssq6PeZcmFATK5OhTKiOmxOsYk69Q&oe=6AE1F8D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
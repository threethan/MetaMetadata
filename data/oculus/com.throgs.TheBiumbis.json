&_nc_ohc=g_MWBu_0ALYQ7kNvwHWXjD7&_nc_oc=Adk4092IJq2aDa0ZxkolGBBPlHZazOOMOxpJtmeQEWN490skYpfxdM0j4i52wAHSjJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2w0VMCwlp4RAeg6CsUrv5TV-KdcZEWBcBCzJ7Z1_mLg&oe=69BD4AC0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8__s5lyeiLMQ7kNvwFq7qRr&_nc_oc=AdnJznrnvm2dglmqECexAMFigcugXHOaV57yB_WtZxC5z4_te_3_3zaHa-0Y16toMTI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyr4uO1AfIGzjlGajzlJVK1LFTLvA6oOIzBevVKj3Zy4Q&oe=69BD52ED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NZtk_4gMXgQ7kNvwHtOdNB&_nc_oc=AdkzKD1DYG1ZQoPxOMCGEDkCkeAxFIOu-Ozy1oejbudwiTpW1sMpuwR5F1CM5VpNZsc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhq0NWV-Bl6ZHdDjL1MmxLPvLTTfka1yXqHF9IT-H9Eg&oe=69BD2E10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiEsk5K2jqUQ7kNvwEW602m&_nc_oc=AdlH4PiEX9sMR5mDW2qCmksssKY6YD2nIMnBzK1Dj6-Q_1i03Sf1elS8oHWVLCJB9IA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHG-q__9M4-M7jQQxvqv-W6VPSYV5fjlZTGvcIAzoY6Q&oe=69BD4BD4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1099941983394935", "is_fi
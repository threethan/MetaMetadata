ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pufg9zq0KpsQ7kNvwEO-_qZ&_nc_oc=Adr8cdM3clQ8msvD0foV7EWKdrKni1KKfsAXwlmq7vVoSi4yKAF7g6cibMbmuLXYhZc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeOHN5gLh3p5_-Q72MLtZEpkIRW3n-ORHdH0zhMoyG1g&oe=6A8068C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hixSqGCOXhwQ7kNvwFNDGAX&_nc_oc=AdozABnZ4hhpsFKsjHeW5E6x9TdMGZGeGpegtWcBnoXGfZIRkNBQpD5Mc1EmLu1MUA0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELXYyNwZSblNs5p-n1yYnYS2tkQfzHQPssEU1eQyoZzw&oe=6A8070ED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncgd66Ir5moQ7kNvwHKpSIJ&_nc_oc=Adro-2Gt_B2-MWQ_cE6rSOV5Up3j5xRQw55S687LzRaCZWjO3i_vEkrYCo8wugnD-1g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5P2XLHgqlkAGtT9E-lZByFR5wBar89JRZ9G3jig0Eng&oe=6A804C10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGBvBhf1X-UQ7kNvwFC5ehG&_nc_oc=AdpMDED9wZ7A7Oy7N1ss2Z_ddRpFmiKCYsHiaNvs0nu5lUIRD9feOmSRQBAncf9qVbI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeo38wBytW70dnOPZv-1V8zz_uUFu5Hxa8pHsJiB5arA&oe=6A8069D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
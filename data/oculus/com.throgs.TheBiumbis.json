ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1hiLCtX3dkQ7kNvwEsboJs&_nc_oc=Adqw7k5K6zmgjlmVsYpVBzTkMCjJLgJKtsup6ZJBt5VvlwEffaNV8cLU4GXN9BS8h_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y7usd49ahwyFK85csXc1jRNe8bb_d8EBYsJWdpt2y8w&oe=69E234C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsBwrfkF67UQ7kNvwG51ASP&_nc_oc=Adq166Eno5RzLV6rJy1tS-gnX-WhxhwXChU1-r-iVDsjotYZonAUvEif5VIcdBLNEkA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3szOkucND3_rV-yiudAiGekVKX5MT26ps5KwX68JwKPA&oe=69E23CED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg12p1JmhWgQ7kNvwFVUntZ&_nc_oc=AdpV3L7DN9kvjTdmJGUxe5X5oILf5xQGRTVaDQs7Ew461n3yB5LV5vHVlmAHUjgklts&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vhB2I4tZOB3ZG2BP2ZvqexsPcVuov3qaNRdwlI1LtKg&oe=69E25050"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ug6CuRAOFwQ7kNvwF4mpmp&_nc_oc=AdrZCu5m0B9yJ-nXsno3L_KpfrSYHSihTyu9wiKKcmizFedcJNbHfyzBJgyAFE6BreM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sfL7Lm5F2oT6DmVU0C6w8WeoRdamLWLwYIAtKQTkRIg&oe=69E235D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeS7TuBv1OEQ7kNvwEyaKhf&_nc_oc=AdpSpoSz0ktugElUHegd43D7kMDnPEBdB3PhA5YnCcKbHrXhekf6Ibz6gv6oEB7NR8Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7oQPdg5JZXylnPJPnIABRvSefe-_xNkZwZ4unI4V83g&oe=6A8AF4C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkIKudssOwYQ7kNvwFnVbtN&_nc_oc=AdpATQSwSgpYeCiJRr5P0Mk2qJXXWK6XwLDmOQbFcwiDKSSDIy7mdZ1ZulIroVxi0Uo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmpJNi4MoO4oa_Me7ifthJDqX75pY2mT-vp4K99-UsIA&oe=6A8AC4AD"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtIgiaevlQgQ7kNvwHl5H4g&_nc_oc=Adqzxr02S4cYlhEGYUPjdacDnUi-xxLrzlqt0LTYTobzrcMsykXqt6aLzVejCB_Mb8c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgIGyosXDYqVx9_tJ2-iVEWR2Vh1hMUTzV4mPLD2S5iQ&oe=6A8AD810"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tlk3WTxbX4Q7kNvwG64L0i&_nc_oc=AdpireS694gU0h0iG-9UyGu1T5b-90EGoyAw4jHEaTMl35WWe-DUpd2YRiIN0xtUvhE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_K2j_Aqj1JLDcxl_SRAGsV2cEIQLD3P5ur-CTC7NdIg&oe=6A8AF5D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
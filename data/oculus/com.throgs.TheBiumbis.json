ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geer96kZ2YYQ7kNvwG-hTna&_nc_oc=AdqoN9QkLAhpQ1tFhN_Sk59QrmAkSIEsLi2C-MxPOTklTEokM5yafs7k42hsVi_8h2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUzNvydwp8XFTGxlIYwX8_2kXyJHNoJxOXRdmNGmQkew&oe=6A7096C0"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMULJS2yXNMQ7kNvwFSkcG8&_nc_oc=Adp-opq7eJjRG8QWenzgFB62gP5FIrKCjA2Xjp867KtlYkYRXJ0ujVKmDDOuXKVwoJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMEIN0jiysLIeeH_zjYDQRM3mceM37vwP1F66_JZWPJg&oe=6A709EED"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGxIB-rYAUgQ7kNvwFAqAom&_nc_oc=AdpudU_s9n3UuwAUBc6EntjjYVzIsfmZf1O_39Lhj0CZAf85d0u3vs-VhAM3VVf2tGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4dZwq3TOrfFIAqDVeXF9rPdbBtVjc8rgvebbiHqt7OA&oe=6A707A10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRFc728p_04Q7kNvwEMRAMy&_nc_oc=AdoTRdezwepErH3PPbrKAqssGttOfIG1Kx9vN2OMIx8FVMnEAb9eAxMYte_fYrZllk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlVQFYdoyyvXJHZzLIbR32LTvTDso2rT9wBAikLCW52g&oe=6A7097D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
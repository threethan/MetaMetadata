ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cH2lHgV3_kQ7kNvwE7CU1n&_nc_oc=AdqrVj4h2tFsCigQhjkMbUSFhNAHIh7X505z5mKfGkBfdYRhkwPjVxrcurU5saLsDMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HZQTDpawPxoSohO-OtTwDx0hEaopmQX-Eezr2kCWmcQ&oe=6A0DB640"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEGqLHSSSxUQ7kNvwHi1wyH&_nc_oc=AdoW2t8TnwwYjfbu7eNL89AuotqnQMvh5Ecj7whFZWaQ-B8TI1u6sU4fOKdHpLhYV5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l87HPNS9xyM-ipOw9_97bQOpkk9jCkgWiFchjDoz29A&oe=6A0DBE6D"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_Hk7drA1qQQ7kNvwG36JB0&_nc_oc=AdoBePKadBEbIMuXYjH639CmULUuqoKewtx3VkQXE3ZxN_59Hnuop5U9zvPix3mLrQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70hipz6ReO6oV7oIHV_mC9GHwXjKTs9ifUs_iJueO_yA&oe=6A0DD1D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2a2dcbTn-cQ7kNvwFo_xJ7&_nc_oc=AdpkEU8yV8uow1FUJ6Zwg9MbrB0ROmFTBKgggC4OnjJqbKcefA2ZNoAlm64HhBcE81o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MRk87YblJehjmATOReGJWCZugTYMoFDqjxLAOIsMhJg&oe=6A0DB754"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZF6FacIsIgQ7kNvwEwINd_&_nc_oc=Adq1AzdSMjEoWvBH1KG3dpSiBpXuNUKwMiIuhdVSFuvPiSFyUVFfU0QStN7tEap0FCY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU8uqhmQlh06rM7S7vGioJW_O7kKSX8fmRzv7klMGVag&oe=6A918C40"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV9CaUpkmZwQ7kNvwELgccT&_nc_oc=AdoBVZrc6Y4DgLmCntELlUq5paz868Z2bmGbA5miVfg3yLXNcaqZQI7AKLSik7L4WyY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElIw3mp8W8j_1ye-OugJAqR1Qzod3NnqS20ZlkkRF-DA&oe=6A915C2D"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru4-0G-8TowQ7kNvwFwRDCD&_nc_oc=AdpaijWfd8H3mTNO3qgn7PRDQTTzk1Kz4DB8t8Rn0eGrsV8LVIH10vRg5OsZ4esnLvc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtX-H27GYTkVmP8W7Jjv8cGyBhiE8KOx95G-Imzl8_ow&oe=6A916F90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSTOuKh_wRAQ7kNvwH4Ni0D&_nc_oc=AdoGiwxSI9BThoMsJWaq04fOq0ibEX804eSGWZac1Pv5OYnMz1czA57Oq3j5sKGTiv4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPKrrnULBfXX_M_KIpNoCeYLPaPCDC1jDu55EfiwArmw&oe=6A918D54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
ATjGgxn7OvTX7sGT4rkZFnzlbA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvlD7-ccnxqbS02BapX7RE2h9IFI2nq80Duju8xqkCv-w&oe=69A19B40"}, {"file_name": "migrated_image.png", "id": "493696087969078", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12386303_213373389116874_5498028029777018880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpmS9iz4l6gQ7kNvwGiLG-s&_nc_oc=AdlgG00bpWTYVLhYqtbdB23Slxorg_xN2jHTDgxeceqf1XyJ68gUC6TJ0XY1wbFqHbo&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afta7Jqv0U-rD-z94Dz8vgdj0Qjwd4ohl678rAgU9J1ymg&oe=69A1A36D"}, {"file_name": "migrated_image.png", "id": "211341890214221", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410271_1837431673169286_3518523159768727552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0kf1494S6gQ7kNvwFJacFr&_nc_oc=AdllUkzX9twdih_KQwg5lweuHwa6_pAJ4K6igDBhBhghKAtcMc98b1C_kxVAspp23nw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs2wkEuqBfz8KsPT_v3D9qkyEV8eYEbbnKqpvc00mnsgQ&oe=69A17E90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Biumbis", "keywords": ["family", "kids", "casual", "toon", "fun"], "long_description": "Story\n\nLong ago, in a very, very distant world. A race of little creatures, the Biumbis, lived in harmony with nature, spending their days playing in the woods.\n\nUnwittingly, while a group of young Biumbis were racing in the bark of one of the giant forest trees, the clumsiest of them hit against a branch making one of the enormous fruit fell down from the top and release a dark being that begin to contaminate their world.\n\nOverview\n\nThe Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage.\n\nGameplay\n\nHead movement controls character's flight.\nBeware of toxic drops and obstacles.\nShoot using Tap button on GearVR.", "short_description": "The Biumbis it's a fun and inmersive game where the player will control a Biumbi with his head and try to defeat all the enemies between him and the magical seeds at the end of each stage."}]}, "developer_name": "3OGS", "developer_privacy_policy_url": "http://www.3ogs.com.ar/", "developer_terms_of_service_url": "http://www.3ogs.com.ar/", "publisher_name": "3OGS", "support_website_url": null, "website_url": "http://www.3ogs.com.ar/sites/the-biumbis/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "372676468072343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12427628_441615026315372_1978792227559702528_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-HRno9MZtoQ7kNvwFEVyHj&_nc_oc=AdlUAu7AQkHwdr4P5eBRC7ksNNl46S4ZRtJiMkForpNR3nT-bOfO8PyCHqFG5bo76sY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvRJG61piLBBTyN-wecKqPEuoWfEdlkvpCcSga63bmyZg&oe=69A19C54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Biumbis", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1487750400, "lastRevision": {"nodes": [{"id": "1763341253905518", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1099941983394935", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc
f&oh=00_AQR4SoWWxip0DZJfcJovpABMCnaL7Bn0sUhPlo3D32xTiw&oe=6AFDDFDE"}, {"file_name": "Screenshot_20261109_230310.png", "id": "1149181101128998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_1149181104462331_8822374935409038523_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1yR9IJ-tPQQ7kNvwG7M-ns&_nc_oc=AdocnkIDZyXd1qyJBkKo9-EYp7fiyVlLrxwoeujr32gwo6i1fw4orK4FI6-NQ2ij_2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTWL_8Rq-m5nhi6O8C1vE1_6tjeE7adXvjDO87l-nI5A&oe=6AFDD4CD"}, {"file_name": "Screenshot_20261109_230853.png", "id": "977479758770721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624577_977479765437387_7804649934155478434_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U31wgtdTguAQ7kNvwE1DmvS&_nc_oc=AdqQsiwx620t9VUqUrC5EuCH_V1gEBv-SLU9wq5odmqhr86SlVCzMt_fQ672UpQLqyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDlMFz6aHmu0wPHFBVF9KsHaVnNelI6UXgugcOS4TL_Q&oe=6AFDBE2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SendUp - Send Files Anywhere", "keywords": ["filetransfer", "filesharing", "vrfiletransfer", "sendfiles", "wirelessfiletransfer"], "long_description": "Move files between your Meta Quest headset and your other devices with SendUP.   \ud83d\udda5\ufe0f \ud83d\udcf1\ud83e\udd7d\n\nTransfer photos, videos, documents, music and ZIP files between your headset, Android phones, iPhones, Windows PCs, Mac, Linux and compatible web browsers.\n\nHOW IT WORKS\n\n1. Open SendUP on your headset and the device you want to connect.\n2. Connect using the displayed PIN.\n3. Select files and transfer them between devices.\n\nPEER-TO-PEER FILE TRANSFER\n\nSendUP uses WebRTC DataChannels for peer-to-peer (P2P) file sharing. During normal transfers, file contents are not uploaded to SendUP cloud storage. No SendUP account is required for basic transfers.\n\nSUPPORTED DEVICES\n\n1. Meta Quest headsets\n2. Android phones, tablets\n3. iPhone and iPad\n4. Windows, macOS and Linux computers\n5. Web browsers\n6. Android TV and supported Android XR devices\n\nAn internet connection is required for device discovery and connection setup. Compatibility and transfer performance depend on the devices and network.\n\nTransfer files between your headset and your other devices without cables.", "short_description": "Send files to and from your Meta Quest headset. \ud83d\udcc1 Share photos, videos, documents and more with Android phones, iPhones, PCs and browsers using a PIN-based peer-to-peer connection. Internet is required for device discovery and connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sendup.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Shivam Srivastava", "support_website_url": null, "website_url": "https://sendup.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134678502751260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_2706100363140228_7608863861019838027_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZMMJ0CeUlwQ7kNvwGcwbEn&_nc_oc=AdqaHfsYPBlOdn7lCn-WDf_4PaLu
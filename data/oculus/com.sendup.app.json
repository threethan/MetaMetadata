i6O8C1vE1_6tjeE7adXvjDO87l-nI5A&oe=6AFDD4CD"}, {"file_name": "Screenshot_20261109_230853.png", "id": "977479758770721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624577_977479765437387_7804649934155478434_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U31wgtdTguAQ7kNvwE1DmvS&_nc_oc=AdqQsiwx620t9VUqUrC5EuCH_V1gEBv-SLU9wq5odmqhr86SlVCzMt_fQ672UpQLqyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDlMFz6aHmu0wPHFBVF9KsHaVnNelI6UXgugcOS4TL_Q&oe=6AFDBE2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SendUp - Send Files Anywhere", "keywords": ["wifi", "sideload", "filetransfer", "wirelessfiletransfer", "sendfiles"], "long_description": "Share files to nearby devices like phones, PCs, browsers & VR. Fast P2P sharing.\n\nLooking for an easy way to share files between different devices? \nMeet SendUP - your cross-platform file transfer and file sharing solution. Send files between Android phones, iPhones, Android TVs, Windows PCs, Linux, macOS, web browsers and VR headsets like Android XR and Meta Quest.\n\nSendUP makes local file sharing and internet file transfer simple. Transfer photos, videos, documents, music, ZIP archives and other files using peer-to-peer (P2P) technology.\n\n\ud83d\ude80 CROSS-PLATFORM FILE TRANSFER\nOne file-sharing solution for multiple devices and platforms.\n\n\u2022 Android phones and tablets\n\u2022 iPhones and iPads\n\u2022 Android TV\n\u2022 Windows PCs and laptops\n\u2022 Linux computers\n\u2022 macOS and MacBook\n\u2022 Web browsers\n\u2022 Android XR headsets\n\u2022 Meta Quest VR headsets\n\n\ud83d\udce1 LOCAL FILE SHARING & QUICK WIRELESS TRANSFER\nShare files with nearby devices on the same local network. Transfer files wirelessly without cables or complicated setup.\n\nDiscover compatible devices and send files between connected phones, computers and other supported devices.\n\nShare files locally or over the internet, between supported devices.\n\n\ud83d\udd17 PEER-TO-PEER (P2P) FILE SHARING\nSendUP uses WebRTC DataChannel technology for direct peer-to-peer file transf", "short_description": "Share files across phones, PCs, browsers & VR. Fast P2P sharing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sendup.world/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Shivam Srivastava", "support_website_url": null, "website_url": "https://sendup.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132073173011793"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1976786483297858"}]}, "baseline_offer": {"id": "1976786483297858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794347040, "status": "PUBLISHED", "id": "1976786483297858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1131796603039450", "version": "1.0.2"}, "id": "1817407506048942", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1131780973041013", "is_concept": false, "latest_released_bi
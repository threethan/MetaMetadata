7nMVMceD3HyqtLQXYo1bhOe_vZ8wspnoXc1tHtmOBMYPBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg281TFcI3f-lzFc7z-98Swe_CN_6c0K9sbEMzEHpdPw&oe=6AFB2F63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Mania", "keywords": [], "long_description": "Gorilla Mania is an exhilarating VR game that immerses players in a lively, fast-paced world where they take on the role of agile gorillas. Set in a vibrant, whimsical jungle environment, players engage in a thrilling game of tag using intuitive VR mechanics. The game\u2019s primary objective is to tag other players while evading those who are it, all while navigating through dynamic and interactive terrains.\n\nIn Gorilla Mania, movement is a key feature: players use their hands to push off surfaces and climb, simulating natural gorilla locomotion. The game's emphasis on physical activity and dexterity creates a highly engaging experience, combining strategy, speed, and social interaction. With its playful aesthetic and fun, competitive gameplay, Gorilla Mania offers an unforgettable VR adventure where every match is a test of agility and quick thinking.", "short_description": "Gorilla Mania is an exhilarating VR game where players become agile gorillas in a vibrant, whimsical jungle. The objective is to tag other players while avoiding those who are it, navigating dynamic terrains with intuitive VR mechanics. Players use their hands to push off surfaces and climb, mimicking natural gorilla movement. The game emphasizes physical activity, dexterity, and strategic thinking. With its playful design and competitive gameplay, Gorilla Mania offers a fun and engaging VR expe"}]}, "developer_name": "Valo", "developer_privacy_policy_url": "https://docs.google.com/document/d/1WOTZx6faWjqLcJDYqAffD8Dk6Q2AphCQtwFLEYPkgow/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Valo", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillamania/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7911809825595465"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974844_8203497993103636_3650858636530310300_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ObUSb5uNq8Q7kNvwEaCLEC&_nc_oc=AdqQfpPUiEfDzPWs0TXNpfdrIIH-0ttp1aHbJ7g2AfmcEEudTqWIFoVhBCX_ym51zGw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwAzhftBwnY2pYnbGeUcdSwLwf3m2n-SUi1j3ZQHBbUw&oe=6AFB29DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1693325059, "lastRevision": {"nodes": [{"id": "6229830197126778", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6229830180460113", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2246007952265001"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "dapuchinnn.png", "id": "3875619182659108", "image_type": "APP_IMG_COVE
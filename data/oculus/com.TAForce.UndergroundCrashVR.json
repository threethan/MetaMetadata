73_1475823633180920_5614559182913663092_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsfh-K3JcH4Q7kNvwETNLYQ&_nc_oc=AdpkmjCrOKedjKVuS1HnHkDtKpyTzuyOt3UIRH8_MuNGrvjFAH_kRR3X5qb3DjzKxsk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_cuUMWYc5xGlo3AZmKaJuH_jW1h1PuwRdkyOuB5Ou5Q&oe=6A0F2870"}, {"file_name": "Screenshot03.png", "id": "602840488602123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036684_602840491935456_2570779489528208999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyFDVMOkx0QQ7kNvwE8pnj-&_nc_oc=Ado38lbhTbS2HBVQ_wgATPYmw1SUiSxnsAuw56saM4hbCOD_qfTGeDfD6JQlK8RoEvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af655hhznigNriWwNFRyHNoGY4p7X0YGcvwAY2qx_6A_Xg&oe=6A0F11F8"}, {"file_name": "Screenshot01.png", "id": "328414582849150", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984440_328414586182483_9072463244655187499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kqfDmBe7qMQ7kNvwHj5OUB&_nc_oc=AdqzwZIFwj4zTxXaI2kt6cOVPdTWAN8nN8fkdGDgpNLlamI3GfOlRpb_qOKRdhShqrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jp59EifnZmTPZ4DTnZKdDAj0TF1F1KUhwRPWT9OGLBw&oe=6A0F2A92"}, {"file_name": "Screenshot02.png", "id": "963151288299739", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57574725_963151291633072_3657109185494096988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU0gwmnVWcMQ7kNvwGtdFI9&_nc_oc=Adol_WY8LOJMbHICS_TTIrX91fOZR7O4lHsKjuuGiRRvFK5s4T221pVHxJlQUleDAkM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k4TuAUcDD2jlImIEEvA_zB6IBPQYNQwVQ2Ls9uxnDPw&oe=6A0F04D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "827812195512538", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036614_827812198845871_5512007600466865513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5KMyt0qRQ8Q7kNvwGe2O7u&_nc_oc=AdrypKA2KrsLY7I11L2zavUQXqmNLK4TZwgsdjCpvGb_VGP4kYoKspsxbvL6HA0EKjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KrtsgIAAeuw7xrvkmWuyD-03HiSziMU_cWuJ61IQdWQ&oe=6A0F05E6"}, "display_name": "Underground Crash VR", "keywords": [], "long_description": "\nJoin Discord : https://discord.gg/g8GkEd7whc\nImmerse yourself in the racing scene, where you will burn your dreams with passion as a underground driver and challenge the limits with speed! Here is full of all kinds of racing challenges. Keep polishing your skills, earn prizes in events, and upgrade your car! Different play modes and vehicles are waiting for you to unlock.\nFEATURE:\nRace: Tense and exciting race, experience the realism of racing simulation, drifting nitrogen acceleration allows you to overtake on curves.\nCrash: Smash the enemy's vehicles to pieces until they can't move forward!\nTracks: Well-designed tracks for beginners and veterans to challenge different difficulties.\nVehicles: Different styles of vehicles, realistic, sci-fi, cool and cute, satisfying your various fantasies about racing.\nWe hope to grow together with you! Come join our Discord server to see upcoming updates of Underground Crash VR. We need your suggestions! Yes, we need you!!!", "short_description": "Welcome to \"Underground Crash VR\"! Where all your fantasies about VR racing will be satisfied. Upgrade your racing car, Take down your opponents and become the God of underground racing!"}, {"images": {"nodes": []}, "id": "975566887028719", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5730\u4e0b\u78b0\u649eVR", "keywords": [], "long_description": "\u6c89\u6d78\u5728\u8d5b\u8f66\u573a\u666f\u4e2d\uff0c\u4f5c\u4e3a\u4e00\u540d\u5730\u4e0b\u8f66\u624b\uff0c\u60a8\u5c06\u7528\u6fc0\u60c5\u71c3\u70e7\u60a8\u7684\u68a6\u60f3\uff0c\u5e76\u4ee5\u901f\u5ea6\u6311\u6218\u6781\u9650\uff01\u8fd9\u91cc\u5145\u6ee1\u4e86\u5404\u79cd\u8d5b\u8f66\u6311\u6218\u3002\u4e0d\u65ad\u63d0\u5347\u60a8\u7684\u6280\u80fd\uff0c\u5728\u8d5b\u4e
73_1475823633180920_5614559182913663092_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgqTr9yQkVsQ7kNvwF-lkn9&_nc_oc=Adq_IUTVz_ZGpGadbjvTDTf_G6R3pOTzw034ynY7PFoP1iZeij2X0qgIyo5BgrlyHmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAYjCS-Sws_leYM8_dAbqP18doFsXbwiH6YiZ0d0PgCw&oe=6A69E7B0"}, {"file_name": "Screenshot03.png", "id": "602840488602123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036684_602840491935456_2570779489528208999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XGQx_X8eVoQ7kNvwHmJnhJ&_nc_oc=AdqBB0jvfoWpNfhBZqB8yhFnZnWYjMLCj_zrIJ-U85NnyEDvyVb6if4jcTEBMXkH6jE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuFuPKz46qGZo4LZ7Aq5AgxiLyW6FCrBOsdem4EcEtlA&oe=6A6A0978"}, {"file_name": "Screenshot01.png", "id": "328414582849150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984440_328414586182483_9072463244655187499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTGzHAwslHQQ7kNvwGhsDRJ&_nc_oc=AdrzG2eRD7AsvAVLrHxxeQ3PB8yE-0crt5kOsgt8INgKyzaoL-oZxcTLJWDtsrlqgL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3HENP4rjDm37BIkTenLnw0qlgKeP2A8SbLO3u_AytIQ&oe=6A69E9D2"}, {"file_name": "Screenshot02.png", "id": "963151288299739", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574725_963151291633072_3657109185494096988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr9RfxM1MU0Q7kNvwHKk9QS&_nc_oc=Adph2cozPLpuXfX_AmOtn6i7Q0NdFlekw1b-_wtYKO36bYXJt8ny3SCWAV8w13eb_34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ6ygYHbKxqQ0QcvRLTcDrHSVzjQsl-ilaSkdKb7ZJWA&oe=6A69FC54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "827812195512538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036614_827812198845871_5512007600466865513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaaIwpSC_TYQ7kNvwHVnVWb&_nc_oc=AdqUqCa9jwV-OA2T_e3PzVDIBOtDbdxmYcMc2arQCnLRhvmm7xHmTruysJbk4zBvVpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD57LDjaFmUq17fpfN56EPwagsCSBU4IF5qbiOfE7LAIw&oe=6A69FD66"}, "display_name": "Underground Crash VR", "keywords": [], "long_description": "\nJoin Discord : https://discord.gg/g8GkEd7whc\nImmerse yourself in the racing scene, where you will burn your dreams with passion as a underground driver and challenge the limits with speed! Here is full of all kinds of racing challenges. Keep polishing your skills, earn prizes in events, and upgrade your car! Different play modes and vehicles are waiting for you to unlock.\nFEATURE:\nRace: Tense and exciting race, experience the realism of racing simulation, drifting nitrogen acceleration allows you to overtake on curves.\nCrash: Smash the enemy's vehicles to pieces until they can't move forward!\nTracks: Well-designed tracks for beginners and veterans to challenge different difficulties.\nVehicles: Different styles of vehicles, realistic, sci-fi, cool and cute, satisfying your various fantasies about racing.\nWe hope to grow together with you! Come join our Discord server to see upcoming updates of Underground Crash VR. We need your suggestions! Yes, we need you!!!", "short_description": "Welcome to \"Underground Crash VR\"! Where all your fantasies about VR racing will be satisfied. Upgrade your racing car, Take down your opponents and become the God of underground racing!"}, {"images": {"nodes": []}, "id": "975566887028719", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5730\u4e0b\u78b0\u649eVR", "keywords": [], "long_description": "\u6c89\u6d78\u5728\u8d5b\u8f66\u573a\u666f\u4e2d\uff0c\u4f5c\u4e3a\u4e00\u540d\u5730\u4e0b\u8f66\u624b\uff0c\u60a8\u5c06\u7528\u6fc0\u60c5\u71c3\u70e7\u60a8\u7684\u68a6\u60f3\uff0c\u5e76\u4ee5\u901f\u5ea6\u6311\u6218\u6781\u9650\uff01\u8fd9\u91cc\u5145\u6ee1\u4e86\u5404\u79cd\u8d5b\u8f66\u6311\u6218\u3002\u4e0d\u65ad\u63d0\u5347\u60a8\u7684\u6280\u80fd\uff0c\u5728\u8d5b\u4e
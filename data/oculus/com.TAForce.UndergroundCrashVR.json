1-25/38974873_1475823633180920_5614559182913663092_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTIE33EbSDkQ7kNvwHPqH34&_nc_oc=Adoq-Se9swqYUc5PlkUcWD7CK2vQjbk4XqBPRJvHjXn3jQJolAaKgGLsiGIQMWRiDQE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP3pP4l4gcQ6Q87hKfTmyyE7IYt7GvUh7E-o1kmJMXVQ&oe=6A859730"}, {"file_name": "Screenshot03.png", "id": "602840488602123", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036684_602840491935456_2570779489528208999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgVhoi0ba6IQ7kNvwGOaKTy&_nc_oc=AdohkifsQcf6OTXCwbbHhrSSqbxr3GYBywLivZlsK7oUKawe3pv9JJAMXKkF584R_zw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9jJ250YmWPk2-AHpbnTshbo3G2SB19un9qZaMP2Lwkg&oe=6A8580B8"}, {"file_name": "Screenshot01.png", "id": "328414582849150", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984440_328414586182483_9072463244655187499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOc6uUGeA1kQ7kNvwGSyFjT&_nc_oc=AdrkeQJphlNRKhulzPXq00uw4rvB1_a0AE_BfKB3_SwKygyHVqz7gAcyjtoJlfW7Vyc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTlPh0B7eANl0sMKMyEVJMbQhW1M_TOorsvwOvRIGk_g&oe=6A859952"}, {"file_name": "Screenshot02.png", "id": "963151288299739", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57574725_963151291633072_3657109185494096988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeGLfeC438MQ7kNvwH7HKtv&_nc_oc=AdoXEJQHI_qmzHF-7pzIKGJ1yTev3oR5WI3sy_2Tb6gc8N7KBvRNQX5fgmL9RmFnZhE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUChfD8zLQGQu1wVPE1p7tqvqBtz2a5xf5BwX2KV6S3g&oe=6A85ABD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "827812195512538", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036614_827812198845871_5512007600466865513_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp-lWCPASb4Q7kNvwEU7gfU&_nc_oc=AdrcPcE3e30Hzo0YEBdwnG2f-tZA__E0wELchcJytUXv0MVm34jsyD4O5wEljYLoywI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVKgKgSiYQ9kOUqav4-VN372RYgvDAgXJoo1EIynVF1w&oe=6A85ACE6"}, "display_name": "Underground Crash VR", "keywords": [], "long_description": "\nJoin Discord : https://discord.gg/g8GkEd7whc\nImmerse yourself in the racing scene, where you will burn your dreams with passion as a underground driver and challenge the limits with speed! Here is full of all kinds of racing challenges. Keep polishing your skills, earn prizes in events, and upgrade your car! Different play modes and vehicles are waiting for you to unlock.\nFEATURE:\nRace: Tense and exciting race, experience the realism of racing simulation, drifting nitrogen acceleration allows you to overtake on curves.\nCrash: Smash the enemy's vehicles to pieces until they can't move forward!\nTracks: Well-designed tracks for beginners and veterans to challenge different difficulties.\nVehicles: Different styles of vehicles, realistic, sci-fi, cool and cute, satisfying your various fantasies about racing.\nWe hope to grow together with you! Come join our Discord server to see upcoming updates of Underground Crash VR. We need your suggestions! Yes, we need you!!!", "short_description": "Welcome to \"Underground Crash VR\"! Where all your fantasies about VR racing will be satisfied. Upgrade your racing car, Take down your opponents and become the God of underground racing!"}, {"images": {"nodes": []}, "id": "975566887028719", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5730\u4e0b\u78b0\u649eVR", "keywords": [], "long_description": "\u6c89\u6d78\u5728\u8d5b\u8f66\u573a\u666f\u4e2d\uff0c\u4f5c\u4e3a\u4e00\u540d\u5730\u4e0b\u8f66\u624b\uff0c\u60a8\u5c06\u7528\u6fc0\u60c5\u71c3\u70e7\u60a8\u7684\u68a6\u60f3\uff0c\u5e76\u4ee5\u901f\u5ea6\u6311\u6218\u6781\u9650\uff01\u8fd9\u91cc\u5145\u6ee1\u4e86\u5404\u79cd\u8d5b\u8f66\u6311\u6218\u3002\u4e0d\u65ad\u63d0\u5347\u60a8\u7684\u6280\u80fd\uff0c
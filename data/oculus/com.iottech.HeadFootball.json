oculuscdn.com/v/t64.5771-25/38974887_1145548630289537_4209926742940046298_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WloqB5za7kgQ7kNvwGSzYL5&_nc_oc=AdrNOao_NpKb8Rz5sFiXXk9MxXNwEPAvRlHtKTRgio8RCFlxGj1rHjrWIcPUnaRCLPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_JOHLDNLNy5YxrHTkUbTX5zBi4HgB1oUS0HcnDDYVWw&oe=6AF32E63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-30 160911.png", "id": "386849631154124", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001725_386849634487457_7171654925455359206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOne9LjgMjAQ7kNvwGygAWb&_nc_oc=AdptOfehp8UTHCLaYmgJy3rqhPFPv4btsPMiy7NRD1jtn_p1b0po5KWn3r1T5hz39jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZD5e1Zv7CsUs6PTuymJnIusQ-ZE0cZRFghnVgGHtDMA&oe=6AF34A6F"}, "display_name": "VR Head Football", "keywords": [], "long_description": "Get ready to experience football like never before with VR Head Football! \n\nShow off your skills, test your reflexes, and enjoy the thrill of this unique experience. In the game, make accurate headers to hit targets and achieve the highest scores. Step into a world of fun and competition to sharpen your football skills. \n\nYour goal is simple: Time your headers perfectly and strike at the right angle to hit the targets and earn points. But don\u2019t be fooled\u2014it\u2019s more challenging than it sounds! Quick reflexes and precise timing are the keys to success in the game. \n\nEach level introduces new challenges, constantly pushing you to improve. Faster balls, tougher targets, and unexpected surprises will keep you on your toes as you progress. \n\nWith every header, earn higher scores and climb your way to the top. Compete to secure your place on the leaderboard and prove just how good your football skills really are. \n\nDiscover the new face of football with VR Head Football and become the star of the game with your headers! ", "short_description": "Get ready to experience football like never before with VR Head Football! \nShow off your skills, test your reflexes, and enjoy the thrill of this unique experience. In the game, make accurate headers to hit targets and achieve the highest scores. Step into a world of fun and competition to sharpen your football skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iottech.com.tr/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Iottech", "support_website_url": null, "website_url": "http://www.iottech.com.tr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "de", "fr", "es", "sv", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8826857614092172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982658_648302619982213_4843873274966281493_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM1pTOhFZ50Q7kNvwHzEW0X&_nc_oc=Adrfz9ycKYRPeP9hWWjaaWUaMgpRrieHHgWgSVmGe2h894ywFr-DgsRHGPsTQ-sl0Kk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT52YbSQadr1FG8VwzHQVZag7K5XBYvR9Ag_ZD48rxEcQ&oe=6AF3467C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Head Football", "platform": "ANDROID_6DOF", "context_category": {"
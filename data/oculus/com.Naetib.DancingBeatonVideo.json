wEshTc8&_nc_oc=AdpsTQ_guAQdiZXiLy5O0P5TrEyDq1bVFsVQSkf39tfQYsTLMLy8IGS2W8qmpuhP_F8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7NzJ-JlYVT-D4cG013m_Zn7d8tEAJN2EGQYj4OIoNHQ&oe=6A8D6A4B"}, {"file_name": "ss5.png", "id": "424017539154215", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/227864397_424017542487548_6318361129991840326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8rrpt5cpNUQ7kNvwEI6_Cs&_nc_oc=AdonqiNgD7Iuvqj41h4GHvG5HBE9ZU_M0ZbI-gviHqQhFw2OTXv0S-Jng2byzGUkmII&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_CFKD2zRmPBoycLZtqLXEMJu5zG-jEB0fc_1jzWrsXQ&oe=6A8D6322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MovieDancingBeat_2_Moment.png", "id": "263801118918752", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031398_263801122252085_2116618039480190141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC99r3q6Oz8Q7kNvwG0Dqbg&_nc_oc=Adq8XwVbiVr2iXv7zNwRYf-20YioZTZGsk_evwwFau9lKazTCAotWhPmhDsBE2VnwAs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBK_Uz9SKqsfKN8wgfFoZjqEJ78HzYjSL82cZFY1QKZw&oe=6A8D6E19"}, "display_name": "Dancing Beat on Video", "keywords": [], "long_description": "Dancing Beat on Video is a rhythm game base on your favorite YouTube videos\n.\nHow to play:\nYou can copy URL or ID of your favorite YouTube video (from browser) and paste it in the game. Or just select a trending video in the list videos in your selected location. The game will analysis and generate notes based on beats of the song. \nHit notes to get score and finish the video to win. Miss 50 notes lead to fail.\nYou have to hit the note with a moving controller. Touching the note in too low speed will miss the note.\n.\nNOTICE: \nThe video will play online so it requires a high speed internet connection to avoid lagging streaming (or try to wait for loading, press \"A\" button to pause and press replay to solve lagging).\nThe videos have age restriction is not allowed to play.\n.\nHope you enjoy your favorite videos in Dancing Beat.", "short_description": "A rhythm game based on your favorite YouTube videos"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.naetib.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Naetib", "support_website_url": null, "website_url": "https://www.naetib.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "304027231765308"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4635702486514434", "version": "0.6.4"}, "id": "515666796196252", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4317751888309497", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4635702486514434"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "515666796196252"}]}, "change_log": "Improve video loading time\nFix bug", "created_date": 1638605161, "id": "4635702486514434", "version": "0.6.4", "vers
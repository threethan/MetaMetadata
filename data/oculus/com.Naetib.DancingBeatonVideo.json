-dfw6-1.oculuscdn.com/v/t64.5771-25/38974913_402544111218336_4756779520793979634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxK_2rbF9KMQ7kNvwFRCQEs&_nc_oc=AdpYf7bIEsXP6R_D-pA8pLJ6RT5VIn1t0mUheCOvQ6tOYIXEZa69JtOFVRBGXZx9yJo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxI4Q0cGWQuSzufZ1z1VF8Yvv2A5VqRDCPBoyqFnk4qVw&oe=69C51D09"}, {"file_name": "SS4.png", "id": "724826745031718", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982552_724826748365051_4260320704752987789_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDOgnmfoXwAQ7kNvwEm7lfx&_nc_oc=Ado2LS8o3p6_6SSeOMUPh6e8Ws52ks3sB9Gmttl6yC1u3uYd6b2B4Nrqah7RHXO2FBY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_7_Kpv5XxUV3Iiah9uWLyHewo-U4VPQz1h7jij4gqvA&oe=69C5318B"}, {"file_name": "SS5.png", "id": "552751239288043", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974580_552751242621376_4682754797562942074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKsiRbNcBxwQ7kNvwHwwQtW&_nc_oc=AdqvJwZPUG9GgLY6i-9cCfiDdq2FEUwQRapB_LyUVl7RwR6sYtkH7FjRMxkYiaClz5g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZvmqBTmKc4JDqipNiEljd64bDlW4wLbnjwnCNs6IWhg&oe=69C53E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "417580673287478", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035420_417580676620811_8357530107499312898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFDySy-3_q4Q7kNvwHwlPEg&_nc_oc=AdoTlyr0xWzgptsC0-uyDMFXVJ8obcrahvUg3gjDkA3_9jYI_eL1pqbu5cSahgKaIqE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM3eMhPljbjD2dKDDF_hWwB4Hd7ORjlHpesJSc7mNA7A&oe=69C52A89"}, "display_name": "Dancing Beat on Video", "keywords": [], "long_description": "Dancing Beat on Video is a rhythm game base on your favorite YouTube music videos for dancing or fitness\n.\nHow to play:\n[Please watch the short video to see how to play easily]\n.\nYou can copy URL or ID of your favorite YouTube video (from a browser) and paste it in the game. Or just select a video in the list of trending videos in your selected location. The game will analyze and generate series of notes based on beats of the song. \nDance and hit notes to get score and finish the video to win. Missing too many notes will lead to fail.\nYou have to hit the note with a moving controller. Touching the note in too low speed will miss the note.\n.\nNOTICE: \nThe video will play online so it requires a high speed internet connection to avoid lagging streaming. Tip to solve lagging:  try to wait for loading, press \"A\" button to pause and press replay.\nThe videos have age restriction is not allowed to play.\n.\nHope you enjoy your favorite videos in Dancing Beat!", "short_description": "A rhythm game based on your favorite YouTube music videos for dancing or fitness"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.naetib.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Naetib", "support_website_url": null, "website_url": "https://www.naetib.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "MUSIC_VIDEO", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "663638322374996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622022_878332519460954_4177742659666314065_n.png?stp=dst-p
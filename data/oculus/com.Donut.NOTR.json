4208607936275666_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKMYKWnGRC4Q7kNvwH51qhA&_nc_oc=AdofZuWYLjQLDAc4AHAZvzt9JjszDKwzjRSg8pKbDI-GVa2lX8xSv97vXxZ6-x_ZNSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jJHW4IudWF-1Glp98jY8qEs0uvpULDng4_fcTFiGuag&oe=6A280D9E"}, {"file_name": "ScreenShots.png", "id": "1431223302366154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1431223305699487_5604392677587260549_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa9JPYFmBdoQ7kNvwHHLqrp&_nc_oc=Adoa7ftQPxXQs8ZxZav0SI-BhIcMiHfk3uqK4BzVJJ_BpbYExZyC0TPu_TaOdZrIhQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nAicH43KQZzgysfEx4Gk_RoiajTND2WD1yo6v2w3l5Q&oe=6A281180"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night of the Rhecia", "keywords": ["puzzle", "magic", "fantasy"], "long_description": "On the seventh night of the star Rhecia, the Zalea journeyed from their home planet of Zylosia to the world of Rhecylios, bearing gifts of magic, knowledge, and compassion. Though initially welcomed as healers and helpers, the immense power of the Zalea soon bred fear among the locals. Rumors twisted into paranoia, and the villagers violently turned against their benefactors.\n\nBound by a sacred oath to never cause harm, the Zalea could not fight back. They retreated into the shadows, waiting for the stars to align once more to grant them safe passage home.\n\nKey Features of the Experience:\n\nImmersive Puzzle Solving: Interact with your environment to unlock the magical seals protecting your essence.\n\nRace Against Time: You have exactly three nights to explore the village and find all five feathers before the celestial window closes.\n\nA Pacifist Journey: True to your oath, you cannot fight. You must rely on stealth, magic, and puzzle-solving to outsmart the remnants of the village's hostility.", "short_description": "Betrayed by the very people you came to heal, you are a Zalea, a peaceful being of magic now reduced to a wandering soul. With only three nights until the star Rhecia aligns, you must explore a hostile village, solve intricate magical puzzles, and recover the five scattered feathers of your essence. Time is running out. Reclaim your spirit and find your way back home to Zylosia before you are trapped forever."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/night-of-the-rhecia/privacy-and-contact", "developer_terms_of_service_url": null, "publisher_name": "Titiksha", "support_website_url": null, "website_url": "https://sites.google.com/view/night-of-the-rhecia/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35030716179907507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1540428730794314_6114406576669225499_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9MPJzz1mpkQ7kNvwHyrcRq&_nc_oc=AdpLAOkqbNArDECMRKo8MBIqnheAeiN5H4xX9EKByxf-ZsT4fAJwwzdurXZo_2I-egs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OGE1kgH_e6IYYP8zE7OAoOM_cWdgJD7lBDZ8asJ_GhQ&oe=6A280693"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Night of the Rhecia", "platform": "ANDROID_6DOF", "context_category": {"context_categ
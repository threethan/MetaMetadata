-2.oculuscdn.com&oh=00_AftdG4ifNsqHK5w8_8OC7Kwnljjo3RjQarGfVBpM4QkLbA&oe=69A42B7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Music Ball", "keywords": ["Music", "Relaxation", "Meditation", "Space", "Experience"], "long_description": "## **Music Ball**\n\n> A floating sphere that dances to the sounds in your room.\n\n\n\n### **How It Works**\n* **Listens to the Room:** The ball reacts instantly to your voice or music using your microphone.\n* **Built-in Tracks:** Comes with pre-loaded songs so you can enjoy the light show right away.\n* **Make it Yours:** Click and drag to throw the ball with realistic physics, pinch to change its size, or press the trigger to make it float exactly where you put it.\n\n### **The Starry Ceiling**\nTransforms your room into a planetarium. The ceiling opens up into a portal, letting you gaze at the Milky Way while the Music Ball lights up and showers your room in colorful fuzzballs.", "short_description": "A spherical music visualizer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustrious-kitten-1eaa1a.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Self", "support_website_url": null, "website_url": "https://illustrious-kitten-1eaa1a.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25473278595634345"}
mEPjS3dDL3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXW5sRv3cuViEJAIa-FjHu35_KGx5FoGLtGcQdcUWNvVA&oe=6B104739"}, {"file_name": "photo.png", "id": "1422936986205548", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618855_1422936989538881_5250867878255403193_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu8i8-W3QiEQ7kNvwH6t2x_&_nc_oc=AdpXdzJAigsvkRF1PbHn2QJPQvyB1GYwzfIOyPjXawHKubR6RvuKJB7zP_9bXS_J5g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDQ_DYQn-LO6l2dxCY3Bzd3JQjHNwtYPV6pjW55ulfQA&oe=6B1041BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Music Ball", "keywords": ["Music", "Relaxation", "Meditation", "Space", "Experience"], "long_description": "## **Music Ball**\n\n> A floating sphere that dances to the sounds in your room.\n\n\n\n### **How It Works**\n* **Listens to the Room:** The ball reacts instantly to your voice or music using your microphone.\n* **Built-in Tracks:** Comes with pre-loaded songs so you can enjoy the light show right away.\n* **Make it Yours:** Click and drag to throw the ball with realistic physics, pinch to change its size, or press the trigger to make it float exactly where you put it.\n\n### **The Starry Ceiling**\nTransforms your room into a planetarium. The ceiling opens up into a portal, letting you gaze at the Milky Way while the Music Ball lights up and showers your room in colorful fuzzballs.", "short_description": "A spherical music visualizer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustrious-kitten-1eaa1a.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Self", "support_website_url": null, "website_url": "https://illustrious-kitten-1eaa1a.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "43496192621
Q7kNvwH5G1qx&_nc_oc=AdqpIb3WQqa-lhwBQ_gQ8R7D-blJ7lWg8C2aYlJZKe-i3NBrR8NvmQK4WuUMbJUk5r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQKL9X9r_DUoMuISmerACItrY16bJVc0LrwU6D6swNQQ&oe=69CE5B7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Music Ball", "keywords": ["Music", "Relaxation", "Meditation", "Space", "Experience"], "long_description": "## **Music Ball**\n\n> A floating sphere that dances to the sounds in your room.\n\n\n\n### **How It Works**\n* **Listens to the Room:** The ball reacts instantly to your voice or music using your microphone.\n* **Built-in Tracks:** Comes with pre-loaded songs so you can enjoy the light show right away.\n* **Make it Yours:** Click and drag to throw the ball with realistic physics, pinch to change its size, or press the trigger to make it float exactly where you put it.\n\n### **The Starry Ceiling**\nTransforms your room into a planetarium. The ceiling opens up into a portal, letting you gaze at the Milky Way while the Music Ball lights up and showers your room in colorful fuzzballs.", "short_description": "A spherical music visualizer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustrious-kitten-1eaa1a.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Self", "support_website_url": null, "website_url": "https://illustrious-kitten-1eaa1a.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
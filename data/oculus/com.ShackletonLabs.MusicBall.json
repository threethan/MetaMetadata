com/v/t64.5771-25/499618855_1422936989538881_5250867878255403193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF2Fr034PJsQ7kNvwHM-ZT2&_nc_oc=AdpBR6oXdl42hIFObakJ4DKvtTTuduF0NE-Xl535w1o3PM6xpsOReGqvM7c0NrmQEFg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HV5pNSxzM78knzVDgW6sHkB8ObND5jXlmzfgNLS9H2g&oe=69E767FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Music Ball", "keywords": ["Music", "Relaxation", "Meditation", "Space", "Experience"], "long_description": "## **Music Ball**\n\n> A floating sphere that dances to the sounds in your room.\n\n\n\n### **How It Works**\n* **Listens to the Room:** The ball reacts instantly to your voice or music using your microphone.\n* **Built-in Tracks:** Comes with pre-loaded songs so you can enjoy the light show right away.\n* **Make it Yours:** Click and drag to throw the ball with realistic physics, pinch to change its size, or press the trigger to make it float exactly where you put it.\n\n### **The Starry Ceiling**\nTransforms your room into a planetarium. The ceiling opens up into a portal, letting you gaze at the Milky Way while the Music Ball lights up and showers your room in colorful fuzzballs.", "short_description": "A spherical music visualizer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustrious-kitten-1eaa1a.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Self", "support_website_url": null, "website_url": "https://illustrious-kitten-1eaa1a.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
69F8B892"}, {"file_name": "bondb.png", "id": "249055410447691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974511_249055413781024_7984143215891450126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7BcDX1g6rsQ7kNvwFX0rkk&_nc_oc=Adp7EHVJdfcrufn-ldB-R8BCp559hYS5dKl9YUThaSphjQm7hwWdGEyltUTHP3zlc10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bQ_bTtD_VHt4dhOAGyGXe1_eClXfwdsii9595syyf1A&oe=69F89094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sds333.png", "id": "410361600840253", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035322_410361604173586_656555067191375832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX3C9nYHgy8Q7kNvwFYvUwb&_nc_oc=AdpJKyyitB0-ysrinb5nOLHut7MU8xkyYxlNItVnb16estCor5ooxG-XbQI32oPJDjE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MQbIkd312m_QSxxWPxgkVe3s-r2GTMVeb3bS3THVgJw&oe=69F898D7"}, "display_name": "Unlimited Playspace VR Minigames", "keywords": [], "long_description": "Minigames for massive play-space sizes, one of the first series of minigames that allows you to play with up to football field size levels where you have to be agile and on your feet, dodging enemies,  jumping across gaps, crawling through small spaces, and making it past deadly traps.  Extra Large Playspace VR Minigames introduces a new VR mechanic for height based jump detection which is used for when you jump over gaps.\n\nStanding mode is available for the minigames if you can't find a place to place either indoors or outdoors.  Please read the safety guide for set up and tips to help avoid damaging your headset.\n\nThis game is still very experimental and the Quest 2 is not meant to be played outside and played beyond its normal boundaries. Avoid any direct sunlight and only play when the sun is not visible. Cloudy days can work, but not all the time.  Best time to play is at either dawn or dusk.  The lighting conditions must be perfect in order for the game to track.", "short_description": "Enter into a world where you yourself can physically run, jump, crawl, shoot, and dodge! Experience absurdly large play spaces."}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445197177335259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982532_290500446449239_8506482610225145324_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eO3V-oXACesQ7kNvwE6mpdK&_nc_oc=Adp94ghkU9862Mwib_RxNx983bDevMcrRm9qi8M2D7FTIvE8GlZJ10cA1uPfMoA9K80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EN8NsFXsvg9v1ZnV_cI7F-PAAYXKt6d5mKBSIDsrxPg&oe=69F8BC60"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unlimited Playspace VR Minigames", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1645682400, "lastRevision": {"nodes": [{"id": "1164185994063908", "release_type": "SCHEDUL
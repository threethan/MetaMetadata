.com&_nc_ss=7f20f&oh=00_AQRgJHpK-hJ7G5bjZqRsP-rKFcnYPkbkjGRvuYB9lWYLDQ&oe=6B05B72C"}, {"file_name": "guntot2.png", "id": "3276902569212788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031342_3276902572546121_7986927784895149253_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZWWBYnKkYoQ7kNvwGgCK5I&_nc_oc=Ado6GRzdUJJm-eGxJHTngEJQ2Rh_dey2-L_x0Il89lh9eQ9NYxyUIi-cnvE2kJ0XLOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqI7uWpLWWL8hokqDknmWn91sP8Yez0TBC9CWsITie1A&oe=6B05AA92"}, {"file_name": "bondb.png", "id": "249055410447691", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974511_249055413781024_7984143215891450126_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQfgbBIR-c0Q7kNvwG4W9hB&_nc_oc=AdpraaxE5Zb_wJEf1P06JJ97U9i7YrzGNUeeQE6dL3gg6uxkqkeZqCI3jLhY1_cz7NY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQycDG4Uz7PAFmKC6uu7kzcMZFgoFF9MuYx0GvaLqh-Yw&oe=6B05BAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sds333.png", "id": "410361600840253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_410361604173586_656555067191375832_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tocxz6ZkhbAQ7kNvwEea0HM&_nc_oc=AdrxOKQknxDePNnKnLyS__HGylVVsgfC-zHvrGuN0kH0s4QU1TH59_kPDzxRcUw8XNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBBEAaW3YKizxrsTYt78mArpm5cf9YbMLq9OI-JD3yMA&oe=6B05C317"}, "display_name": "Unlimited Playspace VR Minigames", "keywords": [], "long_description": "Minigames for massive play-space sizes, one of the first series of minigames that allows you to play with up to football field size levels where you have to be agile and on your feet, dodging enemies,  jumping across gaps, crawling through small spaces, and making it past deadly traps.  Extra Large Playspace VR Minigames introduces a new VR mechanic for height based jump detection which is used for when you jump over gaps.\n\nStanding mode is available for the minigames if you can't find a place to place either indoors or outdoors.  Please read the safety guide for set up and tips to help avoid damaging your headset.\n\nThis game is still very experimental and the Quest 2 is not meant to be played outside and played beyond its normal boundaries. Avoid any direct sunlight and only play when the sun is not visible. Cloudy days can work, but not all the time.  Best time to play is at either dawn or dusk.  The lighting conditions must be perfect in order for the game to track.", "short_description": "Enter into a world where you yourself can physically run, jump, crawl, shoot, and dodge! Experience absurdly large play spaces."}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445197177335259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982532_290500446449239_8506482610225145324_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0haVVxCrnEQ7kNv
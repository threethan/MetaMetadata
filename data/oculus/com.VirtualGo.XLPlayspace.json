=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqClbMEK7X8Q7kNvwEy7FZT&_nc_oc=AdqM_rpHpKtPZ4kA8PfV-PXG_jNMfKWMyP4f-3PqOGHj8-AnIhfp6ksNLH38hcd6pio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC4akK17plLVuXpYdJcSGPBFMTWSemRzGXBGunfZfOfA&oe=6ACE4B92"}, {"file_name": "bondb.png", "id": "249055410447691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974511_249055413781024_7984143215891450126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkxy4diOwR8Q7kNvwEDJYsL&_nc_oc=Adq4vO19-ozAKwZsZONluvTok_KBg4LloUW0A3AvIt7UeLjyr47q5c7a_WcN3uOAvSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQsMtvniMw8UmNU4tg9bPJ6pPx190f-7aBAIUxslrCmA&oe=6ACE5BD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sds333.png", "id": "410361600840253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035322_410361604173586_656555067191375832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkA77Zw0EJYQ7kNvwF90SoI&_nc_oc=AdoYvpBe3S2Lk4beXkHH2g48GQc3iYz_6M3Ya-QTDIPLYP3w_Yc4dZ832UBZ3p_nwf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXPpDhtgc0WCUPWa-U95N2rhYyuFfcsobdbx0Ulb1BDQ&oe=6ACE6417"}, "display_name": "Unlimited Playspace VR Minigames", "keywords": [], "long_description": "Minigames for massive play-space sizes, one of the first series of minigames that allows you to play with up to football field size levels where you have to be agile and on your feet, dodging enemies,  jumping across gaps, crawling through small spaces, and making it past deadly traps.  Extra Large Playspace VR Minigames introduces a new VR mechanic for height based jump detection which is used for when you jump over gaps.\n\nStanding mode is available for the minigames if you can't find a place to place either indoors or outdoors.  Please read the safety guide for set up and tips to help avoid damaging your headset.\n\nThis game is still very experimental and the Quest 2 is not meant to be played outside and played beyond its normal boundaries. Avoid any direct sunlight and only play when the sun is not visible. Cloudy days can work, but not all the time.  Best time to play is at either dawn or dusk.  The lighting conditions must be perfect in order for the game to track.", "short_description": "Enter into a world where you yourself can physically run, jump, crawl, shoot, and dodge! Experience absurdly large play spaces."}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445197177335259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982532_290500446449239_8506482610225145324_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKMRUN5rPDAQ7kNvwF4iJPi&_nc_oc=AdrKsEkNhAmWFZFv-zzY2GBG3YRJAeOidHZspkhaFActOyR-aZwmE_WGnwLOLVMb9WU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOip3qFTUzFPZMDw00IsikkjBgXbsAzpvJxAsDPGyGfgQ&oe=6ACE4F60"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unlimited Playspace VR Minigames", "platform": "ANDROID_6DOF", "con
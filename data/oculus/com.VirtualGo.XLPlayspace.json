=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmoPFXkD6hgQ7kNvwGCeuFQ&_nc_oc=AdoPMeajiWuu-AElEnZMWgfZcYs1RUgMatKwuG5kd4VQKfnPQsNDJ0n00QE29p_rEyo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnmDf6RgAkAUjDBFFi_QKA7qjcqgh8tz5NNWVFJRJxMQ&oe=6ADCCC12"}, {"file_name": "bondb.png", "id": "249055410447691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974511_249055413781024_7984143215891450126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qjeuk7HHukQ7kNvwEwhgST&_nc_oc=AdpDmQxLB3wwHRtkJIfvh3qf8CxSLOJDjmtBm8sl9hNJWc0M4nSWuhsxFxgNzBnrjgQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJw8XMJbLrIlANOW22X7HMaO6f-cTh0_8hHxy8sDj7PA&oe=6ADCA414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sds333.png", "id": "410361600840253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035322_410361604173586_656555067191375832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkbILhIEEQ4Q7kNvwH5QS7c&_nc_oc=Adp6qa_LbJqj8zvNQqN5VuZolcu16d3ZfecU7UxQ934-XaFz9pREnxVdy6Z1CuSHCRg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYq_OmviBX3H23_ZydZ_FCZ8ENqVoYpd-63e3PjzGhkA&oe=6ADCAC57"}, "display_name": "Unlimited Playspace VR Minigames", "keywords": [], "long_description": "Minigames for massive play-space sizes, one of the first series of minigames that allows you to play with up to football field size levels where you have to be agile and on your feet, dodging enemies,  jumping across gaps, crawling through small spaces, and making it past deadly traps.  Extra Large Playspace VR Minigames introduces a new VR mechanic for height based jump detection which is used for when you jump over gaps.\n\nStanding mode is available for the minigames if you can't find a place to place either indoors or outdoors.  Please read the safety guide for set up and tips to help avoid damaging your headset.\n\nThis game is still very experimental and the Quest 2 is not meant to be played outside and played beyond its normal boundaries. Avoid any direct sunlight and only play when the sun is not visible. Cloudy days can work, but not all the time.  Best time to play is at either dawn or dusk.  The lighting conditions must be perfect in order for the game to track.", "short_description": "Enter into a world where you yourself can physically run, jump, crawl, shoot, and dodge! Experience absurdly large play spaces."}]}, "developer_name": "Virtual Go LLC", "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Go LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445197177335259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982532_290500446449239_8506482610225145324_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=267Nkxu54AkQ7kNvwGGyk5U&_nc_oc=AdpVfEkjkYf-6AMXA-mpxZnMeUUdwLo4Xn94pwf2YBjVVM9yR_TiBbn31C0YZi6tKKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2NO9lg3tfLYK_kn7QGMx9AuSmY8BKJ_2Xu0B0cqW-iQ&oe=6ADCCFE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unlimited Playspace VR Minigames", "platform": "ANDROID_6DOF", "con
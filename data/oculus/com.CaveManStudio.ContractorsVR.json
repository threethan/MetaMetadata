qRfrfXaUKXYob42JQwCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afui5vKBbVqIpezDPzC-gQC2u4CCorhii3wSz4IyIHBQIA&oe=69A6C985"}, {"file_name": "Screen Shot 2021-11-05 at 7.18.19 PM.png", "id": "602087107579823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036680_602087110913156_4974182995452516198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szvlUe8Zb3oQ7kNvwH-5sbc&_nc_oc=AdnfY7IIWRtGhAiAQ2rT4QhWmgfzPayp2m0gc6Ryx2Dv5OifwRc7x6ecZRXfyMKV0RU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuE_Ve-PYeNrNvhXTkBHAu4qFyC7B53kuXkP7nSBXz_bg&oe=69A6BB9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape-2560x1440.png", "id": "1283396339327628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974821_1283396342660961_4480697088885388835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfTaETZmuN8Q7kNvwFTDnpQ&_nc_oc=AdltWUH141OTalZ_gBEdzBbJk9JrcUYxm9kPt8aRUVwh0zTthFIyxdiInKZAiUJBszQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurjQmMbn2IWJ7pUlYy3hfWLKL76fZGbW0X3WMJkj9fYg&oe=69A6E01D"}, "display_name": "Contractors", "keywords": ["Shooter", "Military", "Action", "Multiplayer", "Simulation"], "long_description": "* Modkit and Player Count Update! Ground War and Rush modes now support higher player limits, and vehicle components have been added to the Modkit for even more customization.\n\nContractors VR is a fast-paced, tactical multiplayer shooter that brings intense VR combat to life. Gear up with lethal weapons and dive into dynamic firefights for the ultimate VR battlefield experience.\n\nKey Features:\n\n1. Extensive community-created content\n2. Variety of casual and competitive modes\n3. 16-player Ground War battles\n4. Offline and online co-op missions\n5. 4-player zombie survival mode\n6. Over 30 distinct weapons\n7. Unique WWII and Ninja loadouts\n8. Fully customizable loadouts\n9. Cross-play across Quest and Rift platforms\n10. Integrated cross-platform social features\n11. Target practice hub area to hone skills\n", "short_description": "Contractors is an intense military shooter featuring fast-paced online competitive modes and immersive co-op missions."}, {"images": {"nodes": []}, "id": "412460908605819", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Contractors", "keywords": ["Disparos", "Militar", "Simulador", "Acci\u00f3n", "Multijugador"], "long_description": "\u201cContractors VR\u201d es un juego competitivo de disparos con tem\u00e1tica militar y multijugador. Entra a un campo de batalla de otro nivel en VR con tiroteos intensos, misiones cooperativas, armas letales y equipamiento personalizable.\nLas caracter\u00edsticas incluyen: \n1. Modos de juego casuales y competitivos. \n2. Misiones cooperativas intensas sin conexi\u00f3n y en l\u00ednea. \n3. Un desafiante modo de supervivencia para un m\u00e1ximo de 4 jugadores.\n4. M\u00e1s de 30 armas diferentes. \n5. Sistema de equipamiento personalizable. \n6. Sistema de juego cruzado entre las plataformas Quest y Rift.\n7. Zona de campo de pruebas.", "short_description": "\u201cContractors\u201d es un juego de disparos y de tem\u00e1tica militar con modos de juego competitivos y misiones cooperativas en l\u00ednea."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Game Studio", "support_website_url": null, "website_url": "http://contractorsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
082233837009528_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvvzvrOqIMcQ7kNvwGAwHj4&_nc_oc=Adp6gVZuQiM7aS2Hkts2qvMnj1zku4vu84YnzE81cnuyXnhd2oSLKq9p3EGIbswa8Go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR_jzu7NUzvjhyoU2IAWvY88ah8F6fRu80CIM5msiSnA&oe=6A82F405"}, {"file_name": "Screen Shot 2021-11-05 at 7.18.19 PM.png", "id": "602087107579823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036680_602087110913156_4974182995452516198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHPICyE_DXcQ7kNvwGtU2Sx&_nc_oc=Adq18ne5v5AZHTm5RejM_qta8fsbLyvVJ18uuVYLFQnloEzoRipznramUyteU66zKng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGddQ9OqvVWH5yGPA5Z4MlfBm_kg6cTDZOwhRw3mQtiqQ&oe=6A82E61A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape-2560x1440.png", "id": "1283396339327628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974821_1283396342660961_4480697088885388835_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGwVusUraRAQ7kNvwFmdgNM&_nc_oc=AdrNvvwibEwGBR9ayKRnm0DqgVlaqljGtfbFpkClKPPVAazGaH6eB5qws-ftgEJ5xCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwW2QzbH54vjAoI3jf-qz2rTHc8eRQKjOl0G8dcU_QOw&oe=6A830A9D"}, "display_name": "Contractors", "keywords": ["Shooter", "Military", "Action", "Multiplayer", "Simulation"], "long_description": "* Modkit and Player Count Update! Ground War and Rush modes now support higher player limits, and vehicle components have been added to the Modkit for even more customization.\n\nContractors VR is a fast-paced, tactical multiplayer shooter that brings intense VR combat to life. Gear up with lethal weapons and dive into dynamic firefights for the ultimate VR battlefield experience.\n\nKey Features:\n\n1. Extensive community-created content\n2. Variety of casual and competitive modes\n3. 16-player Ground War battles\n4. Offline and online co-op missions\n5. 4-player zombie survival mode\n6. Over 30 distinct weapons\n7. Unique WWII and Ninja loadouts\n8. Fully customizable loadouts\n9. Cross-play across Quest and Rift platforms\n10. Integrated cross-platform social features\n11. Target practice hub area to hone skills\n", "short_description": "Contractors is an intense military shooter featuring fast-paced online competitive modes and immersive co-op missions."}, {"images": {"nodes": []}, "id": "412460908605819", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Contractors", "keywords": ["Disparos", "Militar", "Simulador", "Acci\u00f3n", "Multijugador"], "long_description": "\u201cContractors VR\u201d es un juego competitivo de disparos con tem\u00e1tica militar y multijugador. Entra a un campo de batalla de otro nivel en VR con tiroteos intensos, misiones cooperativas, armas letales y equipamiento personalizable.\nLas caracter\u00edsticas incluyen: \n1. Modos de juego casuales y competitivos. \n2. Misiones cooperativas intensas sin conexi\u00f3n y en l\u00ednea. \n3. Un desafiante modo de supervivencia para un m\u00e1ximo de 4 jugadores.\n4. M\u00e1s de 30 armas diferentes. \n5. Sistema de equipamiento personalizable. \n6. Sistema de juego cruzado entre las plataformas Quest y Rift.\n7. Zona de campo de pruebas.", "short_description": "\u201cContractors\u201d es un juego de disparos y de tem\u00e1tica militar con modos de juego competitivos y misiones cooperativas en l\u00ednea."}]}, "developer_name": "Caveman Game Studio", "developer_privacy_policy_url": "https://www.contractorsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Caveman Game Studio", "support_website_url": null, "website_url": "http://contractorsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "es", "fr", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8506452589483509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75282160_864118475916857_4806844242140916965_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDx131Y43eYQ7kNvwEII4UE&_nc_oc=AdrO4duxFmJwGVzj4S38uJlMNzK3sxm4upk-AmJ0jk3btnCfh0OD5ssrJmpZIQy7hIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE6CGs7PWit-ev8vZ2DvtJvF2RY3LtXOgkN5FeICor8w&oe=6A8309B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Contractors", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1607018400, "lastRevision": {"nodes": [{"id": "2403260236594312", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2436897736439055", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "304496867117951"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "icon.png", "id": "708315873138591", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031618_708315876471924_7177707036370087253_n.png?_nc_cat=109&ccb=1-7&_nc_s
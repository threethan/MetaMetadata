_874055554641858_8335044487825237678_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=delBgR2rzq0Q7kNvwH7U5Js&_nc_oc=Adow2l38RwGh8L3jnMWvSlDnJ9n9UB9Frw8h-b6bF_QxAv-xAFIRz1mfiRumQwHg5QQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWufrJFDPHaQ2ujD89wGt_wamVkvun30K44Fitkf3hJQ&oe=6B08484F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AI_2560x1440.png", "id": "222074150975637", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75395598_222074154308970_4127088874619536992_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCsDnLNpDzEQ7kNvwGapZ0i&_nc_oc=AdowhDDhEWWUQgCDlcxy-QdORTRdrHToEPnDeafrfG5bN35XEMlaZqXumTP1Fwo5K90&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIxyFjUIU_PzTWvguwCwsNpFXp9VibJ6Pf2wQY0m88Og&oe=6B085ECE"}, "display_name": "AI Image Painting", "keywords": [], "long_description": "You can create your own drawings and use the power of Artificial Intelligence (AI) for generating new images.\nYou can draw hands-free on the canvas and voice dictate or type your prompt. AI will work for you.\nFunctionalities:\n- Make a drawing with pencils and brushes of different colors and thicknesses\n- Speech to text prompt\n- Keyboard writing prompt\n- Use different AI models and styles\n- Different canvas aspect ratios\n- Generate 3D Object from the AI Depth Map generated of the generated image\n- Save your image to your museum gallery or save it to your headset gallery for sharing.\n\n", "short_description": "Generate Images with Artificial Intelligence (AI)"}, {"images": {"nodes": []}, "id": "386662211137744", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AI Image Painting", "keywords": [], "long_description": "Puedes crear tus propios dibujos y utilizar el poder de la Inteligencia Artificial (IA) para generar nuevas im\u00e1genes.\nPuede dibujar con las manos libres en el lienzo y dictar por voz o escribir su descripci\u00f3n. La IA trabajar\u00e1 para usted.\nFuncionalidades:\n- Realizar un dibujo con l\u00e1pices y pinceles de diferentes colores y grosores.\n- Mensaje de voz a texto\n- Mensaje de descripci\u00f3n con teclado\n- Utilice diferentes modelos y estilos de IA.\n- Diferentes proporciones de aspecto del lienzo.\n- Generar objeto 3D a partir del mapa de profundidad de IA de la imagen generada\n- Guarde su imagen en la galer\u00eda de su museo o gu\u00e1rdela en su galer\u00eda de las gafas para compartirla.", "short_description": "Generar Im\u00e1genes con Inteligencia Artificial (IA)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonstreetview.wordpress.com/2024/01/22/ai-image-painting-vr/", "developer_terms_of_service_url": null, "publisher_name": "VR Red", "support_website_url": null, "website_url": "https://horizonstreetview.wordpress.com/2024/01/22/ai-image-painting-vr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26267910909519697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375761_1085331365935281_3655449381467477898_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-b3R4J9FTgQ7kNvwEFX3on&_nc_oc=Adoe6Alb41iB7t_Ois9dW-jDsqj6TvXsq9StvXNBXekZdHKea8hQx2SoiNDBtbyDq98&_nc_zt=3&_nc_ht=
laYDwl8szOiYECZgMOFvtQ&oe=6A8EC60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AI_2560x1440.png", "id": "222074150975637", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75395598_222074154308970_4127088874619536992_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HctDLzRiHHUQ7kNvwHlYU-7&_nc_oc=AdoWF9yBvvZC_a2FgOvyjXMmUkpnzGW517lJ2F79L6Vb36kys5X0CiEdlkxvtvGJCCc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi3tFiKr7mvq70N07pBEulFv4Dp8DkT5GCkGbFb7Tqlg&oe=6A8EDC8E"}, "display_name": "AI Image Painting", "keywords": [], "long_description": "You can create your own drawings and use the power of Artificial Intelligence (AI) for generating new images.\nYou can draw hands-free on the canvas and voice dictate or type your prompt. AI will work for you.\nFunctionalities:\n- Make a drawing with pencils and brushes of different colors and thicknesses\n- Speech to text prompt\n- Keyboard writing prompt\n- Use different AI models and styles\n- Different canvas aspect ratios\n- Generate 3D Object from the AI Depth Map generated of the generated image\n- Save your image to your museum gallery or save it to your headset gallery for sharing.\n\n", "short_description": "Generate Images with Artificial Intelligence (AI)"}, {"images": {"nodes": []}, "id": "386662211137744", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AI Image Painting", "keywords": [], "long_description": "Puedes crear tus propios dibujos y utilizar el poder de la Inteligencia Artificial (IA) para generar nuevas im\u00e1genes.\nPuede dibujar con las manos libres en el lienzo y dictar por voz o escribir su descripci\u00f3n. La IA trabajar\u00e1 para usted.\nFuncionalidades:\n- Realizar un dibujo con l\u00e1pices y pinceles de diferentes colores y grosores.\n- Mensaje de voz a texto\n- Mensaje de descripci\u00f3n con teclado\n- Utilice diferentes modelos y estilos de IA.\n- Diferentes proporciones de aspecto del lienzo.\n- Generar objeto 3D a partir del mapa de profundidad de IA de la imagen generada\n- Guarde su imagen en la galer\u00eda de su museo o gu\u00e1rdela en su galer\u00eda de las gafas para compartirla.", "short_description": "Generar Im\u00e1genes con Inteligencia Artificial (IA)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://horizonstreetview.wordpress.com/2024/01/22/ai-image-painting-vr/", "developer_terms_of_service_url": null, "publisher_name": "VR Red", "support_website_url": null, "website_url": "https://horizonstreetview.wordpress.com/2024/01/22/ai-image-painting-vr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26267910909519697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75375761_1085331365935281_3655449381467477898_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4HfrvTe7m4Q7kNvwFzTWWX&_nc_oc=Adp_CilQ2-AtsGhmsCoAeV00-CgZ8rd_R_bdj-IWqZwaQOKe3Y2MhyNctmxMTKBjn7U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP0YMGtnoE6q3V71c4zQZMYZMYq1dVcmSBEXiF-ug6yw&oe=6A8ED806"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AI Image Painting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_na
5076571648108_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QLX6jr4JbQQ7kNvwEEtZgS&_nc_oc=AdqYpXjJ5rLbuUTbBmUsvVigpSlZM1hTLgATpG4Tlve01Wrlddi0Qd0JWF5qA4A2aa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcwH4Nc3Jz-xrwM7waIw9T3Wx55uSwRwLHG40QS1iunw&oe=6B0DD0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover 2560by1440.png", "id": "2071922026493440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_2071922029826773_11792982035537030_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW7uLIJdKhQQ7kNvwFbEI-_&_nc_oc=AdpzXbm9pYsANMVCZTtmpWlZx8RJFVFhu9ki5h7o8xDMy-EjOXW96T5OX7QFLPyLtdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShOHBH_Aj0hMyRgeWB2QFAAkmJUaT0IXqyPIZOd9kMtg&oe=6B0DB778"}, "display_name": "Portal Hoop", "keywords": [], "long_description": "Step into any rectangular room, select two parallel walls to hold portals with movable handles which are both at the same height. Control an endless-traveling ball, aiming to guide it through a ring that moves back and forth parallel to the walls. Utilize portal hoops to teleport the ball strategically and increase your score by getting it through the hoop. With a 1-minute time limit, anticipate the ring's movement and showcase your skills to achieve a high score.", "short_description": "A time limited MR game where you score by getting an infinitely moving ball through a ring going back and forth in your room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/portalhoopprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech", "support_website_url": null, "website_url": "https://www.xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "ext
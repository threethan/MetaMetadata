5076571648108_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QLX6jr4JbQQ7kNvwH20FU5&_nc_oc=Adq8Ik98P19Je-T_pKiy4m3HL-ocK0uUAfe3EIW-AyBOcfzP5y2mrTXBoQ6wQqvHI_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQj1H09CAArCSsAyAs-emzbopsFaKKR5ETmoIqR9LsUEw&oe=6B0B2DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover 2560by1440.png", "id": "2071922026493440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575360_2071922029826773_11792982035537030_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA_5QhzEUyAQ7kNvwGw5S58&_nc_oc=Adp20fdrl3WVLWIxW3725i5jfVWuHB_Ki9mo1n-K4A5_rEHNsyrxgMOOsaqWazQCJhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUwANNVr-jP1jS5Qw8hi4hSsYK0eYWQIj1PyGiCMpfKA&oe=6B0B1478"}, "display_name": "Portal Hoop", "keywords": [], "long_description": "Step into any rectangular room, select two parallel walls to hold portals with movable handles which are both at the same height. Control an endless-traveling ball, aiming to guide it through a ring that moves back and forth parallel to the walls. Utilize portal hoops to teleport the ball strategically and increase your score by getting it through the hoop. With a 1-minute time limit, anticipate the ring's movement and showcase your skills to achieve a high score.", "short_description": "A time limited MR game where you score by getting an infinitely moving ball through a ring going back and forth in your room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/portalhoopprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech", "support_website_url": null, "website_url": "https://www.xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "ext
5076571648108_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm8QuG_Hei0Q7kNvwH3fuYP&_nc_oc=Adri4Hmqj8nTRnNHQFrBT34GAoqf6_BtON9o6TgsSmxFENfKtyD_Ckn8Qgcy-wKz3dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWhS9c-vmEzdO3ipuDB8MGdNT9MBubDAjidEXokCULXw&oe=6B07012D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover 2560by1440.png", "id": "2071922026493440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_2071922029826773_11792982035537030_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbKZNGjwDCkQ7kNvwHyIrgR&_nc_oc=AdrCRJTCbRdH6izsKcB6OZSvsZriqVnwu5HDVnAGJozl-xpj44iAjew1ouU8IT1ND4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIhZscmrvnvJHUipmOlz9PBeD5AwyTX1y3RRFiobnSoA&oe=6B071FF8"}, "display_name": "Portal Hoop", "keywords": [], "long_description": "Step into any rectangular room, select two parallel walls to hold portals with movable handles which are both at the same height. Control an endless-traveling ball, aiming to guide it through a ring that moves back and forth parallel to the walls. Utilize portal hoops to teleport the ball strategically and increase your score by getting it through the hoop. With a 1-minute time limit, anticipate the ring's movement and showcase your skills to achieve a high score.", "short_description": "A time limited MR game where you score by getting an infinitely moving ball through a ring going back and forth in your room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/portalhoopprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech", "support_website_url": null, "website_url": "https://www.xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "ext
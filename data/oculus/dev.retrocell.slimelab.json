_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tt3rQ1mrS4RkO8aPEOtGFkq5xIyXuG_vk3IZkFABHHA&oe=6A1AE9ED"}, {"file_name": "screenshot_jars.png", "id": "1230887501863375", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499297031_1230887505196708_2905840956184969931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Nv8YxrzeNEQ7kNvwEn6n2K&_nc_oc=Adrh0JrGCYe5MH8qcprJBrLgbOcXcUC4XiUCTBSWR5Vywrb48pdeeBtEGTjoVsgTzgY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VTjXZ4UcjCEGRsMXxsFXd2Qfaq167WcxG9Oc514fGow&oe=6A1B0705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1222560222587822", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499331933_1222560225921155_6608136759030554411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3VQ-1RqwZ8Q7kNvwHNMRoN&_nc_oc=AdpynoGWBY0lTDZ62bpV8MoIhZW_0rLpPrUoDAa31TqrRGTvBAhxWRi84IUUBCDcbXs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jgt--y11teOTTWlAFjHA9N1Y06NaAecUDGObhUBQWcA&oe=6A1AE000"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# \ud83d\ude80 Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# \ud83e\uddea Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative\u2014powered by a real-time fluid simulation system. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# \ud83c\udfa8 Customize Your Slime\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling\u2014cozy, creepy, colorful\u2014you've got the charms to match.\n{2494793384204689}\n\n# \ud83e\uddfe Fulfill Customer Orders\nYou're not just creating for fun\u2014customers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# \ud83d\udce6 Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in a playful VR sandbox and get hands-on with the most satisfying slimes! Experiment with fluid physics to create endless combinations using unique colors and charms\u2014for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9934153409995570"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1312153897724693"}, {"status": "PUBLISHED", "id": "881580658053874"}, {"status": "PUBLISHED", "id": "1200447231483672"}]}, "baseline_offer": {"id": "1200447231483672"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1312153897724693"}]}, "liveChannel": {"nodes": 
.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRjMH3BTuZYQ7kNvwEX1lJi&_nc_oc=Adp9--uvNXrmGeLugOf2lFTuldNeZi-7JhG-ZP6BaD4iIbrqdA_hUR__vdFiTTHPGD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbSQ4QxA83_uyzq9eGUm3mIIr5en5dpN-ftKI_N4Asiw&oe=6B0DB8EB"}, {"file_name": "screenshot_clear.png", "id": "24093677916917359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617715_24093677930250691_8067623188663977889_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5kpWTwC7KYQ7kNvwEnA_90&_nc_oc=AdqKAgvpCi5Cz4qZQe8q4IicRbP3Ky7XDiWRl_8WbJW3UXzfTbcLXBKUIBDc6ygW8_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPj001uQM6r0Qhz6rjg2xMFZLTSLjVPZT0aoFQpp6TGA&oe=6B0DB62D"}, {"file_name": "screenshot_jars.png", "id": "1230887501863375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297031_1230887505196708_2905840956184969931_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TweYqMn8_VwQ7kNvwGb0pSO&_nc_oc=AdpUwJjRLRnNX4_7Mj1_G-Bee6Z2uIIFsZrPvNtc2FZKmz5Vn1chNpCue3thJNR1vhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3VniRuVLbsxEUCjySlurf5quaYxmvtaDwOLroxMnpUQ&oe=6B0D9B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1222560222587822", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331933_1222560225921155_6608136759030554411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhWP3Q7do-kQ7kNvwEDJ2wa&_nc_oc=Adolphbr4WHIZyK9WwSO2nbPF7ee7ZVuP0k-DiDCB-cAkaYNKuYJawMios6zTXvKtaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8PPC_u_SCIR0n2AViFjwVRRdj1aPcfZ7nB1Mj5EKNDg&oe=6B0DAC40"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# \ud83d\ude80 Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# \ud83e\uddea Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative\u2014powered by a real-time fluid simulation system. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# \ud83c\udfa8 Customize Your Slime\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling\u2014cozy, creepy, colorful\u2014you've got the charms to match.\n{2494793384204689}\n\n# \ud83e\uddfe Fulfill Customer Orders\nYou're not just creating for fun\u2014customers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# \ud83d\udce6 Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in a playful VR sandbox and get hands-on with the most satisfying slimes! Experiment with fluid physics to create endless combinations using unique colors and charms\u2014for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
-1.oculuscdn.com/v/t64.5771-25/499309415_576870225445608_6117826693491174534_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azldZdC20D0Q7kNvwHLYHm3&_nc_oc=AdoNhjLus3S9snhEmFolMvmivuELzqmoJWz1wNMexV6xYSZjap86Y8VpSm07Chj_KSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_tAR_UnXlRaPbuZ5Ap8NBRyEPNvVp3NBRxP_TrAg2aA&oe=6A2D4D3B"}, {"file_name": "screenshot_character2.png", "id": "992327603087762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307623_992327606421095_8044899395856213470_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybopDnfsPHwQ7kNvwFSAZAw&_nc_oc=AdqBgzDiTvvsrOUcKM9BLOApP-2anBEh7Rpp3AMwr7W_NTwlTIiHn_9ijOBcv_lgTnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-3keu00sfl0G1xDRDmQrIbwnsMh8X-YGBFs-E-huqTQ&oe=6A2D765E"}, {"file_name": "screenshot_mixer.png", "id": "1042290780622019", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307370_1042290783955352_3867768433214104641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKXtXppNDAEQ7kNvwFG0FzP&_nc_oc=AdpJ2Z5TJ-LIJ6vxUVKZpBQJ8ub3esv0O4Divb25tn14DdkNVD2llFS4G_n_MGpkYos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SHhMm9bw1-WM-nSxcI7daeCLq97FDews0bVX7-yxXBQ&oe=6A2D61AB"}, {"file_name": "screenshot_clear.png", "id": "24093677916917359", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617715_24093677930250691_8067623188663977889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adjrv8VB7FgQ7kNvwFHIATq&_nc_oc=AdoYUsYmLAcXSjndWGzt_a6N8g0lqzzy5j8nfHVockIPM92YqPCwhAAdbsySHnrE8KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O94iWMAeav2yr1H89je6CQTHrRDv5qySBkdi18YTQnw&oe=6A2D5EED"}, {"file_name": "screenshot_jars.png", "id": "1230887501863375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297031_1230887505196708_2905840956184969931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rUSm6ACAzcQ7kNvwFnQn0P&_nc_oc=AdqkCpgEMJhT0GJXYIqqmeq_uUH0Xjxvk8X4o_yyFLfRqLZxsvBfdVUkQs_VXjoBlsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lOhskf50EsIs6KH9nOHDyc5EbuQQOYmIEfXnTGVlSRA&oe=6A2D7C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1222560222587822", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499331933_1222560225921155_6608136759030554411_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUhDHjsA3ZAQ7kNvwE-zRl_&_nc_oc=Adqb6xxOK00iOreG9hlKEiOL10HAoaJouZbojlt13qw0i_OuatDhCaKfgFXZaIuNVe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pb-W2VgQX8jH3yeeMUuQK-trITpykdZlShOEHshJIIQ&oe=6A2D5500"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# \ud83d\ude80 Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# \ud83e\uddea Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative\u2014powered by a real-time fluid simulation system. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# \ud83c\udfa8 Customize Your Slime\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling\u2014cozy, creepy, colorful\u2014you've got the charms to match.\n{2494793384204689}\n\n# \ud83e\uddfe Fulfill Customer Orders\nYou're not just creating for fun\u2014customers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# \ud83d\udce6 Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in a playful VR sandbox and get hands-on with the most satisfying slimes! Experiment with fluid physics to create endless combinations using unique colors and charms\u2014for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9934153409995570"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1312153897724693"}, {"status": "PUBLISHED", "id": "881580658053874"}, {"status": "PUBLISHED", "id": "1200447231483672"}]}, "baseline_offer": {"id": "1200447231483672"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1312153897724693"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26016530144664640", "version": "1.1.2.44"}, "id": "1426870485339394", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9683157651761815", "is_concept": fal
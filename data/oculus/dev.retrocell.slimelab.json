B01D473"}, {"file_name": "hand-mixer-SS.png", "id": "1546148420582578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1546148423915911_160206877918154451_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU_bcmUCHtsQ7kNvwF0fVdI&_nc_oc=Adq2WO1dYKuQrXq6E_8WdYxnEZblmquwqThohmbO3AaunM-ScCvfTe5oK5NxOjdB_Ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-JOuxIB_9mQOdT8mdJ8irKc62rWcLwxK5hhT9Z3VtA&oe=6B01D215"}, {"file_name": "chem-app-SS-1.png", "id": "1074239301705483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_1074239305038816_344923585608452461_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT6nRBTFr8YQ7kNvwEUDIAE&_nc_oc=AdogxQWbDr_CCT_cmp8Izw3idPxvIJ8e0oP5XyYONHohUcb7rfnsNCXScvVcdJeRH54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsEZNpKtVsjo21TaD0Ivk6MS52CHeeidrJVyfuc0EnWA&oe=6B01C04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2741999839526834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604302364_2741999842860167_2339668119681247350_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXCrBjsUeOAQ7kNvwFXFTcA&_nc_oc=AdqTCzhUdXH6oEpV7-_pstAlFz6hc-m_sj9tlGaCpZ6rT3_v0ATGSyCrFgnxdcFr9MM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy_ch64QGc4lFrJcUv4MLGfJee_RGFzSZ8M2Qj4aIvnw&oe=6B01DA04"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# Customize Your Slime\nSlime can be anything you want it to be. Shape it into food, create slime pets, or make something entirely your own.\n{1216737270219064}\n\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling, you've got the charms to match.\n{2494793384204689}\n\n# Fulfill Customer Orders\nCustomers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in your own lab and play with the most satisfying slimes! Experiment with fluid physics to create endless combinations, using unique colors and charms for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "ja", "pl", "ru", "es", "es_MX", "es_VE", "es_PR", "es_PE", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
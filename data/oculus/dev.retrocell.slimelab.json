.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLN-UwWc76IQ7kNvwEH8unb&_nc_oc=Adop_zP5cIfIUoCPUz0mW2yfbe0epK0L-Ljkyp6LF92Avmu9TW3GH0eZN6i59ZKl-PM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHn9T-ugl1w-7PGG2XtBNHXm9f8OGkGYx8iYq8aUl7eQ&oe=6AFB43EB"}, {"file_name": "screenshot_clear.png", "id": "24093677916917359", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617715_24093677930250691_8067623188663977889_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0B9pd-zF0wQ7kNvwFRneSt&_nc_oc=AdqWuqPZna4RnDIVBAlDGvZGaY1yV9IwGZndFv8UIl0J49Nq6BvipfiQvF2_e9QbKaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLdMAN7YOEiH-gIzjm5u7bQ_XSg8PBIMWueqYzFJ7AJQ&oe=6AFB412D"}, {"file_name": "screenshot_jars.png", "id": "1230887501863375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499297031_1230887505196708_2905840956184969931_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJMOmNh_0JkQ7kNvwFc9Psz&_nc_oc=AdqeUIMHJZC0DxK2mu978cLQ97t_9OF0uJnsiA3lHBClR6Hja2X9oUG17xe9ffAfz38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgnMZHlMhPMyrvdXMZvUNNFwmZvBxLkEfJT8-tlh-BPQ&oe=6AFB2605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1222560222587822", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499331933_1222560225921155_6608136759030554411_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z7q4p5t_LQQ7kNvwHLx_gg&_nc_oc=AdruQGEjBHxMzJXZVSvG-gKWAl26gc5a4zQBJQaUxH8gf0mUQwS6dgsu0l0cuzS3gOE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkGcpPL-7E5FX5UqGiIiXnfjNLdS721_eAkylxO0RCMw&oe=6AFB3740"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# \ud83d\ude80 Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# \ud83e\uddea Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative\u2014powered by a real-time fluid simulation system. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# \ud83c\udfa8 Customize Your Slime\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling\u2014cozy, creepy, colorful\u2014you've got the charms to match.\n{2494793384204689}\n\n# \ud83e\uddfe Fulfill Customer Orders\nYou're not just creating for fun\u2014customers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# \ud83d\udce6 Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in a playful VR sandbox and get hands-on with the most satisfying slimes! Experiment with fluid physics to create endless combinations using unique colors and charms\u2014for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
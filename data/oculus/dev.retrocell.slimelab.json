63977889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9892o9bsTvkQ7kNvwFxXPB_&_nc_oc=Adpy4DCVnPr2knxD91h70mBVrSQUZVNhCIDtfsqST4sNjtXFO4cYW33-aMBf7gVIdcU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tt3rQ1mrS4RkO8aPEOtGFkq5xIyXuG_vk3IZkFABHHA&oe=6A1AE9ED"}, {"file_name": "screenshot_jars.png", "id": "1230887501863375", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499297031_1230887505196708_2905840956184969931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Nv8YxrzeNEQ7kNvwEn6n2K&_nc_oc=Adrh0JrGCYe5MH8qcprJBrLgbOcXcUC4XiUCTBSWR5Vywrb48pdeeBtEGTjoVsgTzgY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VTjXZ4UcjCEGRsMXxsFXd2Qfaq167WcxG9Oc514fGow&oe=6A1B0705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main-cover-ribbon.png", "id": "1409401860918559", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499620444_1409401864251892_2942258325523106507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htQYtubDuSwQ7kNvwHmGNTu&_nc_oc=Adrc6Q7Mt9AmzxasvRWwBa9CogBoQPD92oykhCxY7t0Ew42NP7g90_zYWR5_AyMhqJg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58hyRW4n1a-KFtou4-eSfsT4NBaMNG4CFtSAVag79VRg&oe=6A1AD9F5"}, "display_name": "Slime Lab", "keywords": ["Slime", "Fluid", "Liquid", "Simulation", "Physics"], "long_description": "# Optimized for Meta Quest 3\nGet the best experience on Meta Quest 3 with better graphics and more advanced physics simulation.\n\n# Become a Slime Scientist\nThis is your own lab where all the slime-making happens. You\u2019ve got everything you need to mix, stretch, and get creative. Combine ingredients to create your own slime from scratch. Experiment to find your favorite formula!\n{1327579508539307}\n\n# Customize Your Slime\nSlime can be anything you want it to be. Shape it into food, create slime pets, or make something entirely your own.\n{1216737270219064}\n\nThere are endless combinations!\n- Play around with tons of colors\n- Add charms, glow effects, and tweak the stickiness\n- Melt it down or freeze it into a new shape\n\nWhatever theme you're feeling, you've got the charms to match.\n{2494793384204689}\n\n# Fulfill Customer Orders\nCustomers are counting on you! Match their orders as best you can, and see how your creations measure up.\n\n# Run the Lab\nKeep your lab stocked and running. Order supplies, upgrade your tools, and unlock new ingredients. The better your setup, the more you can create.", "short_description": "Become a slime scientist in your own VR lab and play with the most satisfying slimes! Experiment with fluid physics to create endless combinations, using unique colors and charms for yourself or your next customer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrocell.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Retrocell LLC", "support_website_url": null, "website_url": "https://retrocell.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26023804630603858"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618444_2117313142351158_5156542491625924833_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXh7IS_w8GcQ7kNvwELxiLo&_nc_oc=AdoBjIf_sX5hPskp_3LEWftRIt9xGVX1HQ19rzoOaJmLScl1XCl6SWgl8
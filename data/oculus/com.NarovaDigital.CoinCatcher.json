ZojEq3i68-2ayOop__29DiGaENXoRF7r03sqjDPUKJd6E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTho7j0JlvFBHgWqBA1bYswGOFwHl-i4WknanaaOU8MJg&oe=6AFB4080"}, {"file_name": "screenshot_04.png", "id": "39353007827678319", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307303_39353007837678318_1853572688096407368_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cvq3-Fx4ywQ7kNvwF9Hrv7&_nc_oc=AdqXnRoDJlaVxFm8VNRj4DvxbIEnC7X6W74hzqqXIRyDjxSeeR-f9Cd4gPkM_D3gwSo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTELIgq_KGsr_JQQmKpwcNCtIUm72w12RHP9q5ou5poBA&oe=6AFB3BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_06.png", "id": "2267082147409969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_2267082150743302_828872856397088299_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynwUEYxlFcQQ7kNvwGfCsSi&_nc_oc=AdpFMapRQgCng9TpNF4ZMrlOnoIABEzNoy3oA3hXCInGLe-FvYll9-MulahnjLIB09o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoV5100m4QkDNCrAbo9h9mnYwOnGBvEkBfIA8kSvyo_Q&oe=6AFB4A59"}, "display_name": "Coin Catch & Fit", "keywords": ["passthrough", "workout", "fitness", "coins", "arms"], "long_description": "Turn your room into a dynamic coin-catching arena without even leaving your chair!\n\n**Coin Catch & Fit** is an energetic Mixed Reality arcade game designed to give you a fun physical workout right from the comfort of your seat. Watch gold coins roll down virtual ramps in your real-world room and test your reaction time, precision, and endurance.\n\n### Key Features:\n\n- **Sit & Workout:** Enjoy an engaging upper-body and arm session without standing up. Extend and retract your arms to catch every coin before it falls!\n- **Immersive Mixed Reality:** Built specifically for Passthrough MR, bringing interactive virtual physics seamlessly into your actual environment.\n- **Intuitive Hand Tracking:** Experience natural controls using your own hands\u2014no controllers needed!\n- **Fast-Paced Fitness Arcade:** Combine high-score chasing with a light, active cardio exercise that boosts your reflexes and coordination.\n- **Quick Physical Breaks:** Perfect for a short, invigorating session during your work day or casual gaming downtime.\n\nDodge traps, rack up high scores, and enjoy a rewarding fitness-arcade experience right from your favorite chair!", "short_description": "Catch falling coins in Mixed Reality without leaving your chair! Coin Catch & Fit combines fast-paced arcade action with active arm workouts right from your seat. Extend and retract your arms to catch coins rolling down ramps, dodge traps, and burn calories in a fun Passthrough experience. Perfect for a quick physical session!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/CoinCatchAndFit/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/CoinCatchAndFit", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1282104394995364"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1129322939656707"}]}, "baseline_offer": {"id": "1129322939656707"}, "is_ap
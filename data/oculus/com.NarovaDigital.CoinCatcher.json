3ySj5&_nc_oc=Adoti3orcs794S5KDfdz-AGswDeiAeRA8h4oaoc30Ic3DL3fb8ZYisR07DQ9WY4u6cM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLZwHXFIwjyoyUWCQb1n4pdGpArG-AwuPTbgv6i5x2kQ&oe=6B0B19AE"}, {"file_name": "screenshot_02.png", "id": "1123799207272752", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646438748_1123799213939418_6202800813357131519_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAlFR2WgWg8Q7kNvwGkL69E&_nc_oc=AdoJgZNy0vibyox_OzZiL1n4vmLQuYctrgP3wV_c8HovfN_OJ6XgeWq0KhuFzsVHIYw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTj3ygNTMIrfEI31raIJaJwXfFPFhFn3Rk8VanUm81GZA&oe=6B0B1280"}, {"file_name": "screenshot_04.png", "id": "39353007827678319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307303_39353007837678318_1853572688096407368_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMbbcR6vMXUQ7kNvwF9qSxS&_nc_oc=AdqaI5kHhIf4k85o3-eum8b82GWAI43G-mOVlzSposdN_rsFyCD0UHun1BRi19dgQo4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRa1SGOlsjt7vK7P4_V-c5SwUL766jUXu5qT7eSF3hoqg&oe=6B0B463B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_06.png", "id": "2267082147409969", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308026_2267082150743302_828872856397088299_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC7M_TZ33FAQ7kNvwFpsKSx&_nc_oc=AdoY2Uq4Csg1xPJOsVJ7hyv7y5xxfyfumIofLCto1LvfSklzt5gWPwVLW-ArNlmpzO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjTKe0klwLJXVRIaPXX_LniRcHFE5BngkO5IWg8U-8ZQ&oe=6B0B1C59"}, "display_name": "Coin Catch & Fit", "keywords": ["passthrough", "workout", "fitness", "coins", "arms"], "long_description": "Turn your room into a dynamic coin-catching arena without even leaving your chair!\n\n**Coin Catch & Fit** is an energetic Mixed Reality arcade game designed to give you a fun physical workout right from the comfort of your seat. Watch gold coins roll down virtual ramps in your real-world room and test your reaction time, precision, and endurance.\n\n### Key Features:\n\n- **Sit & Workout:** Enjoy an engaging upper-body and arm session without standing up. Extend and retract your arms to catch every coin before it falls!\n- **Immersive Mixed Reality:** Built specifically for Passthrough MR, bringing interactive virtual physics seamlessly into your actual environment.\n- **Intuitive Hand Tracking:** Experience natural controls using your own hands\u2014no controllers needed!\n- **Fast-Paced Fitness Arcade:** Combine high-score chasing with a light, active cardio exercise that boosts your reflexes and coordination.\n- **Quick Physical Breaks:** Perfect for a short, invigorating session during your work day or casual gaming downtime.\n\nDodge traps, rack up high scores, and enjoy a rewarding fitness-arcade experience right from your favorite chair!", "short_description": "Catch falling coins in Mixed Reality without leaving your chair! Coin Catch & Fit combines fast-paced arcade action with active arm workouts right from your seat. Extend and retract your arms to catch coins rolling down ramps, dodge traps, and burn calories in a fun Passthrough experience. Perfect for a quick physical session!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/CoinCatchAndFit/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/CoinCatchAndFit", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recom
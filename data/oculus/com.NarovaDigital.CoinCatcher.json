o6EV0&_nc_oc=Adp4bncVAIHdPin03hG0Z95shUpe2F4czZGPsOQPmRASmPvHDdXLDu2apBG3OeRErUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4GCO8ern2PpTLx4NgvvB2rY0yqPYKCKz47ot3L-ywIw&oe=6B09C82E"}, {"file_name": "screenshot_02.png", "id": "1123799207272752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646438748_1123799213939418_6202800813357131519_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpkL5En9QqAQ7kNvwFMGe4t&_nc_oc=Adr37Q-z3KxcjbUTLn-_lHPL_bRpj87pWxIWXVYQzJkpTDT680l2CCA1VfHdIypCFD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTB-ZvHzb2Ib5nlNIJs1IrsZf9xaR2ao-6jKaHYmX_-A&oe=6B09C100"}, {"file_name": "screenshot_04.png", "id": "39353007827678319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307303_39353007837678318_1853572688096407368_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMbbcR6vMXUQ7kNvwFMDsMK&_nc_oc=AdqEuhVA3oOv7AkpVT-sZfuDOkp1OssZjtU5wI7TAixi2oBemjha30S98_kzIOhHKJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPQcPvAvtRHgZquT8tlvLwEhoKFIb_aSNkMJrOCsAfIg&oe=6B09BC7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_06.png", "id": "2267082147409969", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_2267082150743302_828872856397088299_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC7M_TZ33FAQ7kNvwGCF03p&_nc_oc=Adqwc3Zk4cn3ALg7_jfl3mwwY_h6KNIhmuAmeJ-1XKWv0rRQkC54IgJ5Nz2e0h0Zklo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Ds98nzfQx4hXFQA6vP0pAD7s0tKJ-U2q3HlV9uoA2w&oe=6B09CAD9"}, "display_name": "Coin Catch & Fit", "keywords": ["passthrough", "workout", "fitness", "coins", "arms"], "long_description": "Turn your room into a dynamic coin-catching arena without even leaving your chair!\n\n**Coin Catch & Fit** is an energetic Mixed Reality arcade game designed to give you a fun physical workout right from the comfort of your seat. Watch gold coins roll down virtual ramps in your real-world room and test your reaction time, precision, and endurance.\n\n### Key Features:\n\n- **Sit & Workout:** Enjoy an engaging upper-body and arm session without standing up. Extend and retract your arms to catch every coin before it falls!\n- **Immersive Mixed Reality:** Built specifically for Passthrough MR, bringing interactive virtual physics seamlessly into your actual environment.\n- **Intuitive Hand Tracking:** Experience natural controls using your own hands\u2014no controllers needed!\n- **Fast-Paced Fitness Arcade:** Combine high-score chasing with a light, active cardio exercise that boosts your reflexes and coordination.\n- **Quick Physical Breaks:** Perfect for a short, invigorating session during your work day or casual gaming downtime.\n\nDodge traps, rack up high scores, and enjoy a rewarding fitness-arcade experience right from your favorite chair!", "short_description": "Catch falling coins in Mixed Reality without leaving your chair! Coin Catch & Fit combines fast-paced arcade action with active arm workouts right from your seat. Extend and retract your arms to catch coins rolling down ramps, dodge traps, and burn calories in a fun Passthrough experience. Perfect for a quick physical session!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/CoinCatchAndFit/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/CoinCatchAndFit", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recom
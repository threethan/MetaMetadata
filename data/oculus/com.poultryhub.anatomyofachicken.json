t-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDgRQ7MVpUAQ7kNvwH_Sl4J&_nc_oc=Adpvp40CaZ_-fu8za5QW51N4VNuL5cN76IDNCukkGY6CdjmL5R_eI05WPlWp_ySBUD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRVa2Cw7peRebMcB4qeoULslg4IfdgtIZnxD5ohx9WmA&oe=6A5F675C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCcm3gEuRXEQ7kNvwEkhkWj&_nc_oc=AdrzXKFwOPFyXwrrNg4JESzHTSOe8TaC4pxRRZ15AgEhbsUH3xzir9CcJkARHtypBdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrT8XFCltQK-a2P3LyLxEN1FB-efmG_et7UPLE7dgqrw&oe=6A5F568A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TquhVn_yIbkQ7kNvwFiJ8jG&_nc_oc=AdrAcbE6HeVA2Oxzq0Vqg6l88PswHkdt_bk23HQmYyJO7iz7em2RZkHbmKxuSm9O_lg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBZMTFM54SrgqgH_ukK8cAagHlPvos79uUqiZvNcI3Sw&oe=6A5F5502"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoGztCSKwG8Q7kNvwGkoDUp&_nc_oc=AdrJwtReO17zHmcTBw05bpvaiFpfjPXP4pfxsUybYDByk7E5tews1ZZ3Z90KdsiQs1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFKnWm3Qu2tCqTkwFXmGEpuFkA11r2LsmczaWYwEZTgw&oe=6A5F59CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tUhUKANsu4Q7kNvwGjzzNr&_nc_oc=AdrHHr75UGKrdGu1fVw-TUM5O6fOoo1DHb1XCo-cBxgMGuxCMY_GHFt07RJzQKKggcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2dmKzpdz60tTWE9m77aFo_kE1hKDfIjQnvTUu6D2lEQ&oe=6A5F6141"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
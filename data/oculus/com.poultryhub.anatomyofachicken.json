t-sea1-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sup2r5oSumUQ7kNvwFgqMmG&_nc_oc=AdpK0qOdHqj6repwJGq_Q7hSY6TFX7w6-fZewG3G7i-S75QhZykFZr1iBTIwsukrvkc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q-yerUovveLDoknrBiDB4t3cGHYRQExVjdK2ym1894A&oe=6A45095C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftSZl_U7k5oQ7kNvwGtaNpN&_nc_oc=AdqVRJysW7y3H-QNszXa7sa3Bjp3gBP2WJ33Vt8xoNWym-yrZTOA0rGznQKQXCrK9lU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m0h4OzF56AxnVCLBDpqIuByUCI2rBJpVWmJpBLXClfw&oe=6A4530CA"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-jAv4AE1n4Q7kNvwEjjoOB&_nc_oc=Adp121q_7-8d06fHT3qSTNdCMWvcc0_lBFQZUPsIzJVRWH1skBHGhUHWFuPBoFL-tPg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gIHYTf6GYEa-mcsSTRtPr4zFbeB8-SdC16k8nppNkyQ&oe=6A452F42"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa9q5E8ujvwQ7kNvwEztSXE&_nc_oc=AdpdLYS9D3k1L9MagzHKsOWipjs_dhwsMygqlJU92daynuzcg4yvIk-OTdyIbLwHeys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rbYun5iNmgI_fKMFeoxd31HPmNoY8esj2LbvDVlmMNQ&oe=6A45340F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj_m5L1ZE9EQ7kNvwHhCuz1&_nc_oc=AdoXH7PQOUqqqeMeh6P4vt3fcn3xKuoYHYLKK44yxQvkuADk8hm3rtxB_x2oRaRGVRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DpSuugPDzf1_oDyMaXqs5uSGqGeisRzHLHiWcudCkbQ&oe=6A450341"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
t-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_Mec015DlAQ7kNvwEVpGnJ&_nc_oc=Ado5JfR4p0ioHKacHtnnNHTpslAj7E20_1f62ACy-o6MzQdp5E-yiglZdj0qQLVCO2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaSavG6yr1GBXpiCEjDeG84k1NSuHOJI51WZM7A01V2g&oe=6A52385C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St66eEkUdXEQ7kNvwHSOJF8&_nc_oc=AdrAVr61ccuf8HLxp7KetrsSlqUc4lgKlCm4CokZ_hD6JtI_1IOl6dtzOPgWdiPcagM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvDiSwNIgNBKoKnDmMzSXSBu77q5vOxGf0jxkC0brTsw&oe=6A525FCA"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyVsbQmwZycQ7kNvwGPLWOH&_nc_oc=Adq0Xama9nZu5mL_4b9y0CfCesqL68CxRggP90acsMwt0IqpzwrUF6_m_xfgEkAvoWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwNflzT-xZx7zHPHL1svPD7KK3qkLWRbrDu8cFBh8k1w&oe=6A525E42"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mbe0P4bOD0Q7kNvwH8IGsR&_nc_oc=Adqt7ul0GtxYOUtuXjGyKpu3UypmFK9MOi3pAFYoMr1tVdBFxTgsEt4-PvyNFEI4FNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPE0r3GLvBLtwvi0AaVjzUKyuFRwqSxfW6dTfwAe_JRA&oe=6A52630F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciRPcdmIqWQQ7kNvwH1Ud__&_nc_oc=AdpM8NzbehsYaPVtjMEBAVVG9vRBIl1mmk-L9I6HLMjCnGPine11fFbUvby4xNWnJI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSomXSHrkoOA-9Bwlu-IiY0vl5p19BUtNZYGv2L_HJQA&oe=6A523241"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
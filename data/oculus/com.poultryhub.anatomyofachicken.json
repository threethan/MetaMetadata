t-ord5-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAhXOSobFAgQ7kNvwEnZhHi&_nc_oc=Adr-yDsaAeVQfGr9P_D-WjhiN7MPcEtM47HLuTMcKwn9qqUyWRzuQiwDFkjIf8ZgKVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxlUKxh8rG8eqPEvh72CRvsKjuvVkTz-yXhqpWyvtewQ&oe=6AF73C1C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz-PHN1eNnwQ7kNvwGMWxC_&_nc_oc=AdrzfBmfnHIS8J0W00UJaExbbLZ_rTSnh9rxM9bbOM7FrHfxuwTvPC-bp2aZPfLGZ-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVs3m-6UAbMA4c-qgDXA9dL5JcyJ0KsU2ihJF-iQqPyA&oe=6AF72B4A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAxDrrioLj4Q7kNvwHFzGtw&_nc_oc=Adq2FnraEimsS7WBqSb2Xx-_2SRrNIz9iwrCO88joAHHfyh-o7xWu6aH_-QASCoxRHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs-vyGE2YKV-S8WtQTXBn7hZfbK59InzsDetXraho80w&oe=6AF729C2"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFYwpyMClcUQ7kNvwEGSlJT&_nc_oc=Adp73JZMp1zfEI33e0w_PdZTi_HPGJKmaB-bNYoUIyuiEez0MoSkZ8KjdynDDRKySVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_TxkjOqwOi5_L-Y1DTZy19dZ2a5SolwyKvBSBhPXWsw&oe=6AF72E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdgL3r_Zl-EQ7kNvwFuaccH&_nc_oc=AdqeZUlJVR1ZxKghMIgFTH9fM5fqiSNTA7h5TMRFy6i4Wn6mJEeqfwLiapMlpny4zig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwl-PecuvAZXbDmnLKjXYpHYAYwgFQE-D8VG21i8AZCw&oe=6AF73601"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
t-iad6-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MEMACyk9BEQ7kNvwHZP2-h&_nc_oc=AdoxXjJuGYvtwzFGhZe78nXXPCyuxHvnSrNVp7FJNVrXMBVwjRP0gadLIKD7usSNd88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SE-1IQlbE96EcVURWt2daEE2neNgbfT_FGmRfTc_QjA&oe=6A046FDC"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzE0K9zk_FgQ7kNvwFXmrIk&_nc_oc=AdqRaF51oWANI0w6yes8HHvDwyKQElKCZquYrf6v3ibE7iTFuXx6JS5KkMQmhdDVBFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j4DV2YNybdw8c7izWhnnQDO0LSu4Gdat06rcEzwC3Dw&oe=6A04974A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZvC005hYF8Q7kNvwG5ORoE&_nc_oc=AdryvMxe2DurwATyGG2rlr1nNyBCp6eB9iqYT-G5Q0xFxylTWHds6SSJ28RivNjSwpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af747G778v9AZ-rDAOVXu-WVbo87GG1S5cCv9euo-TZKXQ&oe=6A0495C2"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHbSRH2oSh4Q7kNvwGUyJ8X&_nc_oc=AdriN24s-01B7lhN1Ho-dwwLsCy3cS-DzzJ27pbCUFveMFR7jgfpFcFc4BzMeohVWd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u38Tx5gjP3UPCf4PxsAy5RGqBMJta31-HZZ00ye0w5g&oe=6A049A8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-EHwd70wKAQ7kNvwGCLv9S&_nc_oc=AdoNxLnQ5auTatuJOOP75h8ppyqbixECZiK5A3qiUqqi_2G3kTYzibRYzlLIMrBg5cM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tLWLKsixbFwKWTKmhW7tezZ3bHZWJbufEVlvWcnV_hg&oe=6A0469C1"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
1-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfJhgF4nj_kQ7kNvwElYhjT&_nc_oc=Adln41Aw6fkV3Umu_p0zeRvYny956_Qe2cInIRie-V7hN23rR_D8EH2XMNy4duNIMAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydNQvKg-_cxL8xw_RPZs7hf2KoBkElD3rPaTsxKiTZTA&oe=69BE905C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvimZUT_keUQ7kNvwGUM-yA&_nc_oc=AdnP1LpaZvqqZrooddy-gNsq3-6HQIz66QrRHlTVAOtb0dt15Fh5mcmML1hs6z6qMf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI59yLlck_9IxVW1LrEpI550EA9tWxzerwyNMdyPepcg&oe=69BE7F8A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6smPKPmAtHYQ7kNvwHIiEL3&_nc_oc=AdliLvPF3OzYj1bXHjJKJg1eEWsKDSi31lygmWIyCnbp1_W_VPPuZa3FUSz159mdNyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-VelHNhVoIS0GyEJ5eNMbJXr1a6ZLk6XgeGi3tywBKg&oe=69BE7E02"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-hVyWgaf4UQ7kNvwGBtU1c&_nc_oc=Adl8LAseAMPPoSmqnXrt1UwiugD4UVoVB_0XCJP0l7LeOpPd8cUTpi1l66738eXBb8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4ItvGZjGxxTVmQhmndTyQ_mp_4Li224ypRneS6kMI8g&oe=69BE82CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dOvs4XXr5gQ7kNvwF8eGqb&_nc_oc=Adl5o2iAdx8BhHrqCcK19iAjgoYBrllTm8lYggzD1V_LWTEDi2PUjWRfMVGfaiv5R8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrjE6qq6y9ZYDlLbJjxTIrSPTw0KFbywoBClUZaxYJwQ&oe=69BE8A41"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
t-atl3-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJzgL1Vt9vYQ7kNvwFRGwk8&_nc_oc=Adrz7-1BTWRdNKFHU0sc0RlIkZu_49bxFOA3XqnTbShP9TIKqM-ROncO8OmUifREVAI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-Rg7QbPcoMPJYPHcZlhzBs63dfq0hYbuZx_Fmi-LvSA&oe=69CFB3DC"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKySa6Tt2fkQ7kNvwF4r_g5&_nc_oc=AdoUrfsaTAR0w-vl2FNFv8VCOKnGwywZ63wF5a6XRq7vsHxTyyszKxzHbyD1-GCigW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNjFVVsBQulyEC1wpas6LHAREvGIlY_bWaiSdEVuDMTQ&oe=69CFA30A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2XC69rVpgMQ7kNvwFI6RGo&_nc_oc=AdrGuKIcgytZhn3wFk-q1_jrgAGd7p3s37mNVD1UqqfhyclIzcporl63oZuuDaZRlg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygP-1CFmGCoKiERkDFwuA9TvAI84-C_gQvJ6MO1jRdXw&oe=69CFA182"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp3i55y5AFYQ7kNvwGyzXGo&_nc_oc=AdopLR5mTs0uKvQ-rLa8gvRMiiaw28sw3jJDoNw_JJepwJMQA6-VjISri7tbwvg6k3U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwM6SgaX76CWSe7gVawDuoVk5nThFqMKW6NFWffu4b1RA&oe=69CFA64F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xka68AK-Bw0Q7kNvwEIhSGn&_nc_oc=AdplI_ROPWPF6PE5Mb98piCinMYYK9IdAf1NquFDkOJNt725CCR0IoKfAe65hP0RasE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzE5qHIeQ3Ttc72sZBhUiWwojt0ooKS7fO9e-6Hn-MJow&oe=69CFADC1"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
t-sea1-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t0BgU52gnoQ7kNvwFv1CSh&_nc_oc=AdqAAJCqX-lVYryGVT8hHVmYqVrssKHnGE2k9ANiYpfVINcMjsRsv3dkhs0TyXXr6ZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH68B_bjMwXdxFCo56FVWQbQOvAQgi63PdFesghE-W0Q&oe=6A92D1DC"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf5c42KBqEIQ7kNvwFaADg6&_nc_oc=Adq76VaP9tqrYuFQ2s5y1657qlNTVT-iF3sBetD9yyBGPOAy7iHRRkiILn-j62mRknU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz5iCDfxaDTPUuLiCeI8b-pnDW4qZKM8fKzZ8Rg4opuw&oe=6A92C10A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGH4WSKfo4IQ7kNvwFgGTMT&_nc_oc=AdojJ1m4v-PRpeCdstycamdukTmM6kFEIlG2BHjH1rHax-4eW95Uo1kfxczqrNOIz-c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv9DCP9JTrvU4o48fnfx-qgIFAkaimK66npVzobOwZ9g&oe=6A92BF82"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hZN-c2nBUwQ7kNvwEiQi2I&_nc_oc=AdrJvzW5XrH4-LScN8Jvm_Qn2NzCEzucjky4n_Lc5CoguFyqnfyx9ub7bQ014q_zDIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmk-B540JZvVZb__UW0KS0ZOnyyMp-HMXStqb1V5iQRw&oe=6A92C44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE9yrif09XQQ7kNvwE6sWWq&_nc_oc=Adoj6qNg2YsUnp0lEUxt_Awm4rgLOcJaXXZPM1gJBD6rg_2-u49bJiqOx0tPvYtlFW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbOwtmntrqpcwxLIt9ikcVzAHSZeTyFUzeCVhscaXvVA&oe=6A92CBC1"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
t-dfw5-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNEkt479_HAQ7kNvwFILREZ&_nc_oc=AdrBAfxKHtAl019meo3k4sLPIdkQCPNavj65cT148oH_nu-jgz_hdM03o75VE_-p310&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsCaX8kkqaeoK-7LY-jwxZztP32OrI-A-lMn-Pco_wpg&oe=6A65FEDC"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5hFQKCfLowQ7kNvwHsRlay&_nc_oc=AdonP1sARlnMafv8E0TH2lvbWdtBOqGK7E_hl1gYZjo3D4sz90zWWduSKiII1Ugr9PU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPs5SSRK8plqBOzPgJeDTt21eNaj-sK2tYzLEaN6EDKA&oe=6A65EE0A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8Oe_zSD7KIQ7kNvwEQkZ9B&_nc_oc=Ado3VKLmzh2ruzOQAc3RkGZZyMln7epwhDly2xhzW0On4XLnNUP_2HtnHgBCjEvPhUg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd22MX4KVN0WOXpYNbJygoCOMSgSkLIfgofRV79nq4bw&oe=6A65EC82"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGCqBNZHBxQQ7kNvwHe8e7d&_nc_oc=AdoZ8bf887QK5lBettr07zfui5nzKePF_dE2kQ3f9cx-wh4hpIl4w9FzTpGELBfMy3w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4_6RFLHNQJEJ4P9n9SEc9OX0xvoQHEvB2q3rfF2UoDQ&oe=6A65F14F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myiyan1Qc1kQ7kNvwEd1Grk&_nc_oc=AdogFiLqBW1ZpcCYoaQZRrfYOgyiCnr8TerUYK6Oo94eI6vMMW7KAswvwVdVrGmp2ks&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTHdBpGxOpljLTbzSYIRcAXaf_aIXzNw89GH75uWK3AA&oe=6A65F8C1"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
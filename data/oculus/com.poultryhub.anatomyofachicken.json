content-sin6-3.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=195ig6a4I0IQ7kNvwGrH3ZL&_nc_oc=AdpxMRo-S0fdRGSAW0R1x1AH6gEb8WEBJEDd-TjNoW1iqe7Jr_xlU4Lgq9dYNopH9Qs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtvbbmxg7Xw9s04eWl8b8X0s8dLmNRxuk0izVZmbIZ8w&oe=6AA3F55C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShSJXDxU-P8Q7kNvwEtSHbr&_nc_oc=AdrI4ijpkJDIBWGa3I9LfG3SqD3dEIZ2n-FdcpY7lbtiZdlfRuIMGID5LxbbTI2qiSQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnMWC7ZvLEUeX1VQhfxc5GpgWS-q_TO9thDat63Xx-zw&oe=6AA41CCA"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W5MeN1_40QQ7kNvwHab4Vr&_nc_oc=Adpc0KU4sTyY9M0ac3g1O6_lcXD5iKoBXEBWYKzZpzTAJeasDbDDIeC9XmFOaVzGl8Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNXjsT9g1kOip4DAUa0d2yJ2Ys-CGff21d3nJbaxPkCQ&oe=6AA41B42"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFKqvtsGjqwQ7kNvwGp7gH1&_nc_oc=AdrS9oiwpBSJZex18BjbCmlz9FjulDmTC0FGQ1FQrPWtNLqBhkEpNDiaifHwKhWHOSI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9lr6m0-C9rMYYbAiwm3_zIyfxak1KK8Im3z3yLDIRuw&oe=6AA4200F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkAFlL-zg_QQ7kNvwEuF402&_nc_oc=Ado_6UsMZLJnpl4N6kNpiYoJPOEBMnSfhdqAK8DzJp3U6a2Ax6RqOwh-e2v42isPflk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzmaLTOtukyqY3Z1gWHusEqWEVX8zlci45jWIc2_HzLQ&oe=6AA3EF41"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
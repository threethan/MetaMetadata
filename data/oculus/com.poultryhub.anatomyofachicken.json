t-atl3-1.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtH40jLxprgQ7kNvwFlLyo0&_nc_oc=AdpzA__gR4ysrqQstbPfEJEShYdK8BlzU7x7zIJfrgwbrGBI7IVtf1krXbfZV-oOziM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIMHf_uoWvsnlcWxeaqQLfW6PdbuFfpqCa3A-D9DIFNA&oe=6A9AF31C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMPJKTELiVMQ7kNvwHuCUtG&_nc_oc=AdonK22U2-DovYZTanPzDP7725FL-zXY_lgvfXnrD49bp8qFshSojXTGZKeyttuJPNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIp_WLVVVEIcEGP2s-A_ZT7cIXJD3Yq3_RC8UnK9BUDA&oe=6A9AE24A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANV6axkbR4oQ7kNvwEcYLfD&_nc_oc=Adopf77oudMTVYucxgTtKgBSDhkah-NJC3IaGJVSfpTZqNQEwob7ibKri6mo8Vg8sss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWqbSGR8yLzw-xUWe0srxd7sUw-G-JUAKikJHyMyEy6Q&oe=6A9AE0C2"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlvqYxJq5gIQ7kNvwFGl8U9&_nc_oc=AdrAQkh7UW6LaZ_HDJ1EUO1Hn5Sk8IMxZuzRI3--lhNyRa235EWApDrATqNurJrkFpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4-oMrYS9XzVDHSj8oMk9s5oqVb7P6pXsGafKgq8W7pA&oe=6A9AE58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyGQOuv8DXoQ7kNvwFcOU9T&_nc_oc=Adpkj3cgrK34TaiWepOVLoF_Yc8egjOM7OTHbfCI_UsZIOo-3L8SYBeuM1b-IGZpa4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTgvafS20-DzwDcu3fdZ0Zgw1JCDLPCpUgHjNPTMrZgA&oe=6A9AED01"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
content-sin6-3.oculuscdn.com/v/t64.5771-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrN_tT3MBGQQ7kNvwGjZb6E&_nc_oc=Adpuet0j3kkDl634qyKlG8qXtoMNcaBGre0zrQ0IiYCNEWIeNU3gXIQ0rIhC_hv1Bqo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sKAY97mV14eI5ZQETmuK0pHiM98GOIxMK-hHnGPBbXg&oe=6A36C11C"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHLKOyUmUAcQ7kNvwH7XLTY&_nc_oc=AdrPO6NS04h-yWKc-_MhbLdbIkv_Pe4XsSQL3whRj7QGVmQThBs1t7aFTvJuVsd2QT4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-F4WiZuMaKR4wPRfs0fW22UIIIOI0oDA-rdGCoP9YsQ&oe=6A36B04A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wYuSlcL96IQ7kNvwFEhqif&_nc_oc=Adqf05FxWrZx5SEoUhj2EAdfkidJg1NV2RxRdHBTmhEppDolqU4u6EXzdbDaBd4uGnw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bAOonYjOzC8GL2milo2ctmLJb2toLTHTVlQNW5Zkdvw&oe=6A36AEC2"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mHRms38LykQ7kNvwEHf5AM&_nc_oc=AdqGdA2sS8TaVdG6Shy2iBebkzZ4ZKOwNSCC_77pyibf9z40Cjt2S3jijK0zDwavKcA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V4ltNymwoTUW_FWgVM4gflSo7r7eE2SMcFNBo3TiZjg&oe=6A36B38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cCItXx4M9gQ7kNvwFcz-Ma&_nc_oc=Adp55FOQ06S2_aVZ9jD6JcWlCi4GM7r0zyzlYs7k7bamEfMb5yIusfS5GH6eybf6aCw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tZgXesP4fwN7feXeYuIDjpRYoOuIln-AW4HCe1K7tjw&oe=6A36BB01"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
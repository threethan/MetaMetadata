1-25/38974647_5576252032430922_3004261951187553537_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfJhgF4nj_kQ7kNvwGs28-f&_nc_oc=AdkJYeVGV1ArvZDV6KKq4e6xOVAuUCfz79ntpi5We3GJWPuWfkuS7bdrWDOwLMssX0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDGHKX63B2wKOR72UospAjIURlsQuM6XTJ2ZDngawY5w&oe=69BFE1DC"}, {"file_name": "screenshots_v2_06.png", "id": "629280891945509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974660_629280895278842_6648502104688427717_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qciph-NU630Q7kNvwGp9gPr&_nc_oc=AdmIG_QtGYTb6aUpAFGKmh-mYsr9qycKiiM4k-CL9bOIzC3RjoprL3Oc9XKU-RPcp9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUc_ifArEmI6JYubQHkkgRiHSwX4UfZf6t49zuD7yJqw&oe=69BFD10A"}, {"file_name": "screenshots_v2_08.png", "id": "584554336479353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404381_584554339812686_7320563523661474914_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4Nm1Z2fcZUQ7kNvwHLdBte&_nc_oc=Admzu9_snJU_s7LQt_0Egt-myVAgfO1Xw_3POclEL90HV9KGZpRuvBv1pF0ESC2_pzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwH3WhAhpD29WL4HNBrBeQoGZ-9uPEKiRyKHgLO2mX5Gg&oe=69BFCF82"}, {"file_name": "screenshots_v2_09.png", "id": "1427230664447675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974876_1427230667781008_993936481344057767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sew0pCba4UcQ7kNvwGpoBrT&_nc_oc=AdkFiZNrPGSGBnbXCT2rTRjXqOqZdbeeutrYiw-5TIhO17-VoQVv0kn5vlkGutHQFz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJrf_1CrU0V-KrMAgqCcRIUohS4Z9l2sVRVg1aujo2mg&oe=69BFD44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poultry Trailer Edit (final) cover image.png", "id": "763282998234424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974911_763283001567757_9063701743215479700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dOvs4XXr5gQ7kNvwH6WnC-&_nc_oc=AdkFCoORc4aeEETfq1RHzOPpvvEYLq206bk-KOS0xVvlOXWC3H8h3lsOpEjNvwE5lxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9F8BW42GSGqoSPGJzYgCa__Nu7EM96EpqFxeSirLbbQ&oe=69BFDBC1"}, "display_name": "Anatomy of a Chicken", "keywords": [], "long_description": "Following exploration of the anatomy of the chicken users can test their knowledge of the parts of the chicken in challenge mode. Challenge mode tests knowledge by engaging the user to extract a nominated part out of the chicken using tweezers, just like a real dissection. Feedback is provided automatically when the user places the part on the dissection tray.\nPoultry Hub Australia (PHA) is a not-for-profit organisation that focuses on challenges identified in the Australian Poultry Industry. An important aspect of PHA\u2019s activities is to build capacity in the industry. PHA commits to building capacity through resources that connect students with industry.", "short_description": "Anatomy of the chicken allows users to develop and test their knowledge of the anatomy of both a broiler and layer chicken. Users can explore different layers of the chicken including skeletal, muscular, organs and reproductive systems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.poultryhub.org/about/privacy-2", "developer_terms_of_service_url": null, "publisher_name": "Poultry Hub Australia", "support_website_url": null, "website_url": "https://www.poultryhub.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
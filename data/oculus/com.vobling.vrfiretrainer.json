9512760864797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222937_869512764198130_7213767653143120284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNOJN9QlfBcQ7kNvwFuMyxW&_nc_oc=Adq4FB0thJUvccz_rTYmiARiu6DNLzVRmdVFPmO83OzNUVcUWkpEv9JEVur5WDvKkKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2K6xyysoicwc_0WeVGKCVEuaa1d3NHoBwFU_X-nVTEA&oe=6AEB428D"}, {"file_name": "Screenshot03.png", "id": "666496435139586", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974642_666496438472919_7143117315437408531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk_wdD7b0UEQ7kNvwEQBr8z&_nc_oc=AdppDFhKX9AM_AiAEur1LHHmNXAQsnpAONNXPcKCau4CHhiEYFrfgqsOpzwGqB-Towo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmv7ZaErmN6gH7FM_Qv75IYrB52Tvbc1k-J6f68kVXoA&oe=6AEB57C2"}, {"file_name": "Screenshot02.png", "id": "842285420383737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361357_842285423717070_7490169957207892331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFg0XEFO31EQ7kNvwFHcMFD&_nc_oc=AdpUunUMud-k3tF394zYzSwwBFJK1VPEjyMq2jJlIlXE0hZTMtjlbAQscQwxpt2SQAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTObrBYuEfLMHPnxPPm2Va2SbZPZCogNLrxhH8-Hrf0JA&oe=6AEB38B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizon Landscape.png", "id": "1413969113591718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1413969120258384_6960818522378191892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UrCyhqNAi4Q7kNvwFDsMRx&_nc_oc=AdpS4RdbUv0uMMuuIQdqpXsiDHOJqArHtcLNstUstOH9HnkpW2TsCN7WkSQmsyfKYzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp8c3urYzYsRngF5GN-ej0zc2UvZYvQ188PyxXOvBhuw&oe=6AEB5C33"}, "display_name": "Vobling VR Fire Trainer", "keywords": ["fire", "extinguisher", "firetraining", "passthrough", "mixedreality"], "long_description": "Deliver safe, realistic and accessible fire safety training anywhere, with just a few clicks.\n\nThe Vobling VR Fire Trainer combines immersive virtual reality and mixed reality training with realistic fire scenarios and an Interactive Extinguisher. Train with multiple fire types, 3D environments, different types of extinguishers and extinguishing agents, as well as a wide range of training programs to suit different fire safety training needs.\n\nMeasure training performance in each fire scenario, including how much the fire spreads, how much extinguishing agent is used and how much smoke the user inhales.\n\nYou will be immersed in realistic fire scenarios, experience fire spread, feel the stress of the alarm, and see smoke formation before using the Interactive Extinguisher to put out the fire in VR.\n\nLearn to operate a real extinguisher while training in virtual reality with the Vobling VR Fire Trainer Interactive Extinguisher. Before putting out the fire, you must remove the safety pin and press the handle to discharge the extinguishing agent in VR. The Interactive Extinguisher is connected to your headset, allowing you to see and use it during training.", "short_description": "Deliver safe, realistic and accessible fire safety training anywhere. The Vobling VR Fire Trainer includes multiple fire types, 3D environments, different extinguishers and extinguishing agents. Measure training performance in every fire scenario while experiencing realistic fire spread, smoke formation and the stress of a fire alarm. Use the Interactive Extinguisher to put out fires in VR."}]}, "developer_name": "Vobling", "developer_privacy_policy_url": "https://www.vobling.com/privacynotice/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": "https://www.vobling.com/support", "website_url": "https://www.vobling.com/vrfiretrainer", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "51408770786878
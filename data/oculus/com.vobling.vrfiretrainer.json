o6wKUtCUWQGqjcwdHwcg2H0APeS2SA4_0amzovK-uNmrzfa9Xq0kkNPG0Ao-FAQsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXHMKiG46bijUr5Owgl2IAxFLYzB0GwRJYPq3gE4V7Gw&oe=6AEB2E14"}, {"file_name": "Screenshot04.png", "id": "869512760864797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222937_869512764198130_7213767653143120284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNOJN9QlfBcQ7kNvwFuMyxW&_nc_oc=Adq4FB0thJUvccz_rTYmiARiu6DNLzVRmdVFPmO83OzNUVcUWkpEv9JEVur5WDvKkKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2K6xyysoicwc_0WeVGKCVEuaa1d3NHoBwFU_X-nVTEA&oe=6AEB428D"}, {"file_name": "Screenshot03.png", "id": "666496435139586", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974642_666496438472919_7143117315437408531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk_wdD7b0UEQ7kNvwEQBr8z&_nc_oc=AdppDFhKX9AM_AiAEur1LHHmNXAQsnpAONNXPcKCau4CHhiEYFrfgqsOpzwGqB-Towo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmv7ZaErmN6gH7FM_Qv75IYrB52Tvbc1k-J6f68kVXoA&oe=6AEB57C2"}, {"file_name": "Screenshot02.png", "id": "842285420383737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361357_842285423717070_7490169957207892331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFg0XEFO31EQ7kNvwFHcMFD&_nc_oc=AdpUunUMud-k3tF394zYzSwwBFJK1VPEjyMq2jJlIlXE0hZTMtjlbAQscQwxpt2SQAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTObrBYuEfLMHPnxPPm2Va2SbZPZCogNLrxhH8-Hrf0JA&oe=6AEB38B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image (5).png", "id": "6046907238661431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_6046907248661430_460419466619949527_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBY5r64BBB4Q7kNvwEjfz68&_nc_oc=AdqDlluhBzwz096cp-zHTqiSoDUIb4cdahvEDCY1ZxDNu4epWqH-1T-yD2XgXQ2ERHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuNajytdjdbHjxUtqM9HxkuIq0IQj--xD3IaytQPAtuw&oe=6AEB49DF"}, "display_name": "VR Fire Trainer", "keywords": [], "long_description": "Deliver safe, realistic, and accessible fire safety training anywhere, with just a few clicks. The VR Fire Trainer Application includes multiple fire types, various 3D-environments, different types of extinguishers and extinguisher agents. Lots of different training programs that will suit the fire training you will perform. Measuring the users training performance in each fire scenario, how much the fire spread, how much of the extinguisher was used and how much smoke the user inhales. You will be immersed in the experience of fires, realistic fire spread, feel the stress of the alarm and see the smoke formation and then use the Interactive Extinguisher to put out the fire in VR.\n\nLearn to operate a real extinguisher while training in Virtual Reality by using the VR Fire Trainer Interactive Extinguisher. Every time before putting out the fire, you will need to remove the safety pin and press the handle to discharge the extinguishing agent in VR. The Interactive Extinguisher is connected to your headset so you can see it in VR during your training. If you don't have the VR Fire Trainer Interactive Extinguisher yet, buy it now from us or any of our local resellers at www.vrfiretrainer.com\n\nBy subscribing to the VR Fire Trainer Application license you will get full access to all of this and more to come! Get your license key today at www.vrfiretrainer.com/application", "short_description": "Deliver safe, realistic, and accessible fire safety training anywhere, with just a few clicks. The VR Fire Trainer Application includes multiple fire types, various 3D-environments, different types of extinguishers and extinguisher agents. Measuring the users training performance in each fire scenario. You will be immersed in the experience of fires, realistic fire spread, feel the stress of the alarm, see the smoke formation and then use the Interactive Extinguisher to put out the fire in VR."}]}, "developer_name": "Vobling", "developer_privacy_policy_url": "https://www.vrfiretrainer.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": "https://www.vrfiretrainer.com/support", "website_url": "https://www.vrfiretrainer.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6000542910014238"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "750985073058394"}]}, "baseline_offer": {"id": "750985073058394"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1676418180, "status": "PUBLISHED", "id": "750985073058394"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28286866020941481", "version": "5.0.8"}, "id": "1143178083232463", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5720757854645619", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28286866020941481"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789389243, "id": "28342774682017281", "version": "5.0.9", "version_code": 
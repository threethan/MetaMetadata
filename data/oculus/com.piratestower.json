er": null, "video_trailer_thumbnail": null, "display_name": "Pirate Shooter", "keywords": ["kids", "shoot", "hit", "family", "super"], "long_description": "You\u2019ve escaped the battle of the Great Pirate War, but the enemies are still after you. Get your cannon ready and defend your island!\n\n** Aim and Destroy **\nUse your cannonballs wisely and shoot accurately!\n\n** Unlock More Levels **\nEarn Keys to unlock new levels. Beware of new enemies! \n\n** Compete on Global Leaderboard**\nStay alive as long as you can to be on top of the leaderboard!\n\n** Collect Treasures and Gold **\nGrab all the loots, one they you\u2019ll be the richest pirate in the world!\n\n** Powerful Upgrades ** \nAll the gold you loot will Improve your offense and unlock mighty Powers!", "short_description": "You\u2019ve escaped the battle of the Great Pirate War, but the enemies are still after you. Get your cannon ready and defend your island!"}]}, "developer_name": "Tartine Studio", "developer_privacy_policy_url": "https://sites.google.com/view/tartinestudio/policy", "developer_terms_of_service_url": "https://www.tartine-studio.com/pirate-shooter-terms", "publisher_name": "Tartine Studio", "support_website_url": null, "website_url": "https://www.tartine-studio.com/pirate-shooter", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465477818589720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculusc
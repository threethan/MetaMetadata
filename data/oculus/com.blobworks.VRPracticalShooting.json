9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZvdF-e5h24Q7kNvwEj2D8Y&_nc_oc=Adm3Y-zaEWoT4rkjwOw423X3_pR0kU2JL8W7K7X1D1WtcTMVQXtzzwo_411WF4x2k64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxobpyVZC74OH4xUFgzNXwlCM-k0vOiut5YYCcih3w8Bg&oe=69AFF678"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7byI2w1ZYasQ7kNvwG2d92b&_nc_oc=Adl-H5tnn6tVLLEfuXpT2d5hxHCP3wzHRhLUjJaUOyDVYnMkfz0caDyyHoYZi0R1hvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQB6PHbaT9gAiBctRCMvqB16sKNir7R_IN64efJSGvFw&oe=69B029B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDUi2BahO-cQ7kNvwHgOmE5&_nc_oc=Adk8m8TvJb0ZFNhugcI775aGVo0-0ecTbO4pOpQcFu3xcj6EpAmh7CjKJU9zkt0Uwv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3o80QQqqAIaNAB6kbsyTfgDKadu8colZg5NvgjPD6Ng&oe=69B029FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
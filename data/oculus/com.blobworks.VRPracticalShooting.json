s8XwABUP1HVLVQgE-3awYdc9chSm-l-03Lx7ehfs3GMA&oe=699D8178"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndZCYxNG5NgQ7kNvwFto20P&_nc_oc=AdnOIB-z-1L1f81MyOu9ArTLhuOdE2O6ALcPWxztFyTe64F01vKItwG1BTliEXGl0mg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEF902AyViwYGa4tjFsOVBt0CF1dFAQZrAHRh1JK2oqw&oe=699DB4B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSgspGlX0toQ7kNvwFNIoHY&_nc_oc=Adlq1zYsxechGisqqTD3cpxhJlLLbg1f2dQDSJ0GGfyFTbIoAEY5YW2xf-0lYW2PRtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPWIlYHyOJZC0lGMww9LwR2kbY0PkUGjnirzx1D3cqXg&oe=699DB4FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/80c15757-0ebb-47fb-9432-c62c43503030", "developer_terms_of_service_url": null, "publisher_name": "blobworks", "support_website_url": null, "website_url": "https://tinyurl.com/blobworks", "ca
9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bU5gq-A81wQ7kNvwFR-fyv&_nc_oc=Adk489NwjF4fcWFEYlamgk83wXNL0Nh4ioGQ7oSyb0IQ83na8SIYGNRZJTmP3Cxdu74&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5N2IQ06Icjm3jTo4GXuYNQqH6CJ7vEmnzQp4svADV8Q&oe=69BD5DB8"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cKCrIoKOCMQ7kNvwHlsjjS&_nc_oc=AdkMel3CBNDnjvnplYhbR14g3iYps8c_GkFXPU7YGfQ4VxzZi1SFZL39cIslkwnXKD0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHgSsnNbNO_Tfe-I9SXJONoMhwdSmcsVz0k_6pBtEe2Q&oe=69BD58B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFoIuvFFxUcQ7kNvwGArGtJ&_nc_oc=AdlBdNNGsTtsVW9IeyBxhUjnDAVRheIevGZH7bkfn3qSXQQH2ziBJ8m8Txy3x-3dAGI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnACPNMhj9gBl_iDUmh3sNzafz1Qoh0NqO12Z9eQULmQ&oe=69BD58FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB0UeTSUwN0Q7kNvwFV8TYS&_nc_oc=AdluJKAci6S1bsqMopndukVl7P63p07vzKksosJC507Bh8CGM8x1sU-2x-uzKMKtLZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxdcai-iTeiJucwO7FBhetCLbvIb3M3b3kxh5M9kzilaQ&oe=69B3EAF8"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE6Mo-Qc5uQQ7kNvwH0wlFU&_nc_oc=AdnkbnFd-8tYpJKRg9blNaVKoCzLu7x5qK-nejYuCXzf6bnMDlXCAJgm2XsmxEHAaK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8AK-b5oDXGp4igKkGH4jq9tDDBzbCGqBgEMDozpdZGw&oe=69B41E36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEudrlHdkqgQ7kNvwEk06ft&_nc_oc=AdmuhqS8ETAxE4oaFQd8tk4yUOPnWFZEQMnnu7GTSp-QbhW7h3Ck4q93pW75V5r4hFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXQqN3p8pJkXpOeV6eDjFIYR6dz1pzcmD6-sW4emJSSw&oe=69B41E7B"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
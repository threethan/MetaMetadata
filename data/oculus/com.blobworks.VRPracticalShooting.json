9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bU5gq-A81wQ7kNvwHZOgMC&_nc_oc=AdmhhWtbBbr6jS9m8xqtrtCFC2SFoqCBttp6Md7q7rANZZc2k8pVhalVXcGCAXLdIA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwE2_lvppTo1DKakb6hCgSJyVNMekOp25N33L9y7Wf2nw&oe=69BC0C38"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cKCrIoKOCMQ7kNvwEya0yT&_nc_oc=Adnj-hLHTDSxt5dDqfBoHNEY6vtvN7kTI5chKS8USoZwBoDrdLvMda1YLZOf-ZbWAYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0oIYALqzVApFsnW-VtWFj9urwu80N225H97pfJuKztQ&oe=69BC0736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFoIuvFFxUcQ7kNvwEB0Q2e&_nc_oc=Adnr3aUXUJ2Iu_7_yp-M34zJWZyi7l9vn7r5bBluXoj8wKoafz6OXOyAL5EO9ujfJ6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgxUYNJhVm2ZHEPx1twnJ9R3lRCtGxLrtXVXWxOrZAfA&oe=69BC077B"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj-MlT84rkUQ7kNvwGwJHZc&_nc_oc=AdpWLlquI7Ll1cts18CuWS2Cq5S3QQS-xvwcPExlqI1ikx4KoiCU-YSKf90x9xLbxq4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2_wrvAfKkawSUdsEPiJmfX2qNHk3t6tasN4JF-hDBdw&oe=69C15238"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGPAHn6RwiQQ7kNvwHLD6DN&_nc_oc=AdqzagjhRWJQLHfWtvO-FLhKkvmPc4YGGWvjJIERqePMwafA0WpeZRd45KJcbLDyAuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwS65jq4V3wQs4jVHATX0o4CdAoe3Q9QixV8JDt_cLhIA&oe=69C14D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJXjmRyztncQ7kNvwFd5RnF&_nc_oc=AdpNwEbNhIYQBHpFkC_iI6adBKrjahi_Vsfo4KWA9lCegJc5MC8TZPsXBw8o4W-bvbg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwD0YMwCEO7R2MFAqrQiWddNSDjaclXrS550SKnAI0nqw&oe=69C14D7B"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
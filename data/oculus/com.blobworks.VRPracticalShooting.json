dn.com&oh=00_AfuPWIlYHyOJZC0lGMww9LwR2kbY0PkUGjnirzx1D3cqXg&oe=699DB4FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "Release date 20 November 2021\n\nVR Practical Shooting is a sandbox experience built for those who are interested in competition shooting and sandbox shooters. There are various free ranges, competition mode with detailed scoring, all using realistically modelled firearms and innovative controls to closely mimic the real thing in ways that feels natural. \n\nJoin the discord server for feedback and suggestions: https://discord.me/blobworks\nJoin the YouTube channel for frequent devlogs: https://www.youtube.com/c/blobworks\n", "short_description": "A VR trainer for the competitive shooting sport and those who enjoy plinking with firearms. "}]}, "developer_name": "blobworks", "developer_privacy_policy_url": "https://docs.google.com/document/d/14pHKxrzFG41PSdfGDhO_RdH_xrsvYfEL6LY-Jnhiikw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "blobworks", "support_website_url": null, "website_url": "https://tinyurl.com/blobworks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6910700558971940"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974504_182503983649147_4501678355258067762_n.png?s
9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ND6rY4Mo8sQ7kNvwFKcchP&_nc_oc=Adl4UyG_OiMXB5zi4LGwFz8mwwVywfITm0ddavRJV5nHNuyVwMTWtI4iksRn6wMfYvw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrPAGeOYIV5GPf2RLrsJxQs1zM_2CtaY9ZJQzxmO6T8Q&oe=69B7DF78"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDuc4pLl4LsQ7kNvwHL_9NU&_nc_oc=Adl3HX_3wKIO-zrxLTinzICv48V7izy0ukLEJ-osrqJ79IA7slGcjUeF014lZanVgIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhReumEVBIIWSz3EmzZXUh2Pv18pQCEE2O3sSZz6_LPA&oe=69B812B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAJ_JXJbfw8Q7kNvwEjhaxK&_nc_oc=AdnUI9H31lZP7836SvBdHnfmrUSJ38eARZ7RtR3q8d3TT8WtNmrIMYNX5tNmH8MqI9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_Z3pZd5Hel9sFT54OemFbkPdkievHnMz80RLp3DI8cg&oe=69B812FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
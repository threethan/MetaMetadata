9464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vIty5TFheEQ7kNvwFz_u0u&_nc_oc=AdmDdiwDj7RM_0b8fTqbh0IWRdWvZb--R9gcGs6XGcSscFENySmuX4021vLl0mKwqAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsP31yhvXpnKab-em2n4wIpRo_UuStxQrfKDXSEWzlDEg&oe=69A80D78"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQYzQhi21v0Q7kNvwFgztPH&_nc_oc=Adm-4oQ_BWg7fsTDuSzPodWCHFVJ-prWQQUWBtevhdFHkFfKsehQSLHKTq4_6DNtOl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfssuqnE-NFhhAPFxep04-8g8u-XGjOUK3U0lDjjqU-hcA&oe=69A840B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKpkpyNnaNwQ7kNvwHAEDSL&_nc_oc=AdkR91nMI0MTP-i_rf-FBcPFcp2c6VnDssZWZpRms3tvwiPFYVt43KaOGhidPXkiheg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvBV8IJckzNQVpUANRF2zKOPHZR3ZLCGzsNVnsHCH3_8Q&oe=69A840FB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_
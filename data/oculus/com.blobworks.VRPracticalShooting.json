f&oh=00_AQSbAHGdQoH8joohzrhljV4B9EXZ0UePs8w1LqrQjucv0A&oe=6B033376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpmeukF7I-QQ7kNvwHZTo-R&_nc_oc=AdoqwbkVfbpN3L0zY1iQGggMESsPCxcBtAw1TjgIaBTvubLITlx_ehVeqN3950qpBSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKIfquiQGAMvLl_lgGasielAnU_Krg9jxowPXEgWYudw&oe=6B0333BB"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "Release date 20 November 2021\n\nVR Practical Shooting is a sandbox experience built for those who are interested in competition shooting and sandbox shooters. There are various free ranges, competition mode with detailed scoring, all using realistically modelled firearms and innovative controls to closely mimic the real thing in ways that feels natural. \n\nJoin the discord server for feedback and suggestions: https://discord.me/blobworks\nJoin the YouTube channel for frequent devlogs: https://www.youtube.com/c/blobworks\n", "short_description": "A VR trainer for the competitive shooting sport and those who enjoy plinking with firearms. "}]}, "developer_name": "blobworks", "developer_privacy_policy_url": "https://docs.google.com/document/d/14pHKxrzFG41PSdfGDhO_RdH_xrsvYfEL6LY-Jnhiikw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "blobworks", "support_website_url": null, "website_url": "https://tinyurl.com/blobworks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
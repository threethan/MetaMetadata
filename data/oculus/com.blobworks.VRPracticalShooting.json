07", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_506013490800273_1160939464028821919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz1jy1n5noUQ7kNvwEB9633&_nc_oc=Adqp06NwKNnJVoTXKpkjU3YFFBfcziu7evbqQwkK9b1VhKFfJjdNfnGFJOMuH-jzsds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Cc96Ttiml9di4ng0VmRPt6D8NV9vX_LABn779hqPwg&oe=6ABE7238"}, {"file_name": "Practical05.png", "id": "1308348672870572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003233_1308348676203905_6268088337758980308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUdoW4R4GewQ7kNvwF9Z3wk&_nc_oc=Adqz8IPAcim7P5dKntsPfUQnUYLKXEq6KiSpqohlgfzV2mNaBfoZzAcrHbH1mRZ8QQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9DHDxJlWd3z3ae13Aps0ugzMMwGH6p05G1zOe2QszXw&oe=6ABE6D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "4236058733127537", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001694_4236058739794203_843853504506656205_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZUHsGvmZzoQ7kNvwFldcwl&_nc_oc=AdrNaY0GU93TdppCAVLYd9gmclGsK6_BswxRTBIpwTsddtvUeaSOxGPKBG_iCsSRVBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVp0s5lurLQ589OwyqyMLToeGe3cFcZDHvYRBdefCS4A&oe=6ABE6D7B"}, "display_name": "VR Practical Shooting", "keywords": [], "long_description": "This app emphasize on using only one controller to mimic more intuitive grips for practical sports shooting in the case of handguns. User will be able to freely shoot different handguns in a free range, or go through competition style stages where scores and time will be shown at the end, with various penalties and range commands to follow. Features so far includes realistic ballistic, accurate paper scoring system (so even if a line break will count as a score, based on size of bullet hole that matches calibre of choice), haptic based trigger reset, physics steel targets and more. ", "short_description": "A VR trainer for the competitive shooting sport. "}]}, "developer_name": "blobworks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/80c15757-0ebb-47fb-9432-c62c43503030", "developer_terms_of_service_url": null, "publisher_name": "blobworks", "support_website_url": null, "website_url": "https://tinyurl.com/blobworks", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1880523522336520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "160326949517164"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1628563200, "status": "PUBLISHED", "id": "160326949517164"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6350391388357687", "version": "0.1.230514"}, "id": "131373588865765", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3875542155842635", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6350391388357687"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "131373588865765"}]}, "change_log": "- 
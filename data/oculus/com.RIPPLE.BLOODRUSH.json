keh1ol9w&oe=6ABBCD28"}, {"file_name": "Shiny_Gorilla_Chasers.png", "id": "2154660065314738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_2154660081981403_3889938875142799195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFCEMRq7R7sQ7kNvwG2gllG&_nc_oc=AdoP3mSaTESv67BqvnLgw8juHCjBoSycILeOACIJbxGHCTyHeqkvquqv34J8RN_o4Z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2BCb0VNKnhZAHMVN5nTqWz-FXdaEioNoMsTgatHs7rg&oe=6ABBDE99"}, {"file_name": "Gorilla_Chasers.png", "id": "994101560054398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_994101566721064_75658797433728703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcfeF384GaoQ7kNvwH1vAZ9&_nc_oc=AdoCMipv-nNVswnN_WcvOKuBcIP4dbasMSWNHlsM2U9MRsgU3lfo_L1Jc2-Ym6cahzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoDjbr3WDSiF3u1RCJdVOlkpvHTlVuueJVjv2jQx8wjA&oe=6ABBD4D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Tag", "keywords": [], "long_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-ga"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1n1BGY97-1GIVr5-3sqzEmORXE2dvZzUOxO4aIU0W60k/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Direct", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1roWAsCqObZGE4y1dgyuEXqxl-ECy46063wB9GMwpEgw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1152651841273112"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1347578420772913_8985441086994035061_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdvTNBflqZQQ7kNvwH6Oqaw&_nc_oc=AdrtPF5rYFj2b7H7AKGcknXQazPaJ__av-pS7nPhmRAeQSM1-uziRavZglkDyzOUYLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZQVCytG9VnNi-RHoIvnwXYX0W83zmIkcLPuUXbWmjA&oe=6ABBC170"}
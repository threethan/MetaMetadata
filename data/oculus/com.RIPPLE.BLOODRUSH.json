2KE6IvbQ&oe=6A9ECC28"}, {"file_name": "Shiny_Gorilla_Chasers.png", "id": "2154660065314738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_2154660081981403_3889938875142799195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h7Dm8WKYngQ7kNvwGqG5zV&_nc_oc=Adpwdz2CbCJHvixTWegJDOIfdJTYVeT1GMeN_O7agcY0Rcivac_DGjlZ-Cc9VBi_vCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsaEUvHhoD9NTTOJVnm4-rU5EjJFpJ9B6hBHMsx2YNhw&oe=6A9EA559"}, {"file_name": "Gorilla_Chasers.png", "id": "994101560054398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_994101566721064_75658797433728703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEHoP36OlIIQ7kNvwHKDGza&_nc_oc=AdqNA-6jVEv1XbJTRNgedmqcyk0VOMZT5gOV3seopjyNprMQA3WJd2Uzyj5R_DKKMEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXj3H206tTr0pBoW6zoe8ez_Z4OghoLmUbDohyldge5A&oe=6A9ED3D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Tag", "keywords": [], "long_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-ga"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1n1BGY97-1GIVr5-3sqzEmORXE2dvZzUOxO4aIU0W60k/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Direct", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1roWAsCqObZGE4y1dgyuEXqxl-ECy46063wB9GMwpEgw/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1152651841273112"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1347578420772913_8985441086994035061_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SWsg-u5uyoQ7kNvwH-qMCi&_nc_oc=AdopVsXqV4Jm7Eo-p8HmHXBEuaOig4tC78q09f3J000t9pRUnRc5oeBVcfIy3q51D4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_z99hurcNL75VFy2atrbd-I2jWeVfxUXk9W-h4xMgGA&oe=6A9EC070"}
43fs8tOA&oe=6AF720A8"}, {"file_name": "Shiny_Gorilla_Chasers.png", "id": "2154660065314738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_2154660081981403_3889938875142799195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B55WSXrKC38Q7kNvwEam8eu&_nc_oc=AdoTnIcNoImZlEr_aCbD4OG9a3ygwBNeoixa34zI4tQW-BpnlMVwOd7Snt8NQcOw4ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdNsTqPgLDXOeBKPz0LkuPRGi0TxdHsGlmLy1nD5LuYQ&oe=6AF73219"}, {"file_name": "Gorilla_Chasers.png", "id": "994101560054398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_994101566721064_75658797433728703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OgGR6R_YeYQ7kNvwFoF_Sb&_nc_oc=AdoeDalAhkIsg2wt4GG9lx35DfDd4WN3Ogyi_udYiqcrruN2-Y4rDWHWAdSU4PAosR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1n6T5XJf7DuRprrpm1W-q3SWBrcLL6Yznek5uf1xmw&oe=6AF72853"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Tag", "keywords": [], "long_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAG\n\nSwing, run, and
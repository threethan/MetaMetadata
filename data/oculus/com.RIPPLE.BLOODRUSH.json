91mvgKiQ&oe=6AA2C0A8"}, {"file_name": "Shiny_Gorilla_Chasers.png", "id": "2154660065314738", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_2154660081981403_3889938875142799195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulKwFOU46jAQ7kNvwF8jp73&_nc_oc=Adr_Hc1-ut6uTJSTw84Si74v6BIgLxpjGTf_yGHyt2iZVZsLtPHHZ4Nrc_0xQzamRMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJriSdDmaU7qLN7g3qwC2W9OqrlxO6rDH-DeBFunHn2-g&oe=6AA2D219"}, {"file_name": "Gorilla_Chasers.png", "id": "994101560054398", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_994101566721064_75658797433728703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODxI4EsmSpYQ7kNvwGqvPQc&_nc_oc=Adrpv2_6DsWl_zhYzhq0-RlrQH6Mcyb_pgroXPCsIxXnCCFyRJ5B_7c-CvCDkknOQts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbYYfJBBN09NuOdzVGbeODsrXpuadNY7tcGKostNAaSg&oe=6AA2C853"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Tag", "keywords": [], "long_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAG\n\nSwing, run, and
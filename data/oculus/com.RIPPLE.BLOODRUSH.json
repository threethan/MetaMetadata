Lz_mNQww&oe=6AC8FC28"}, {"file_name": "Shiny_Gorilla_Chasers.png", "id": "2154660065314738", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827611_2154660081981403_3889938875142799195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xozWAImF4W8Q7kNvwGswqSo&_nc_oc=Ado2mBxchZtFp4Jf8H-ev0wuDAwobptSYCwmYtb1O6f8OU4IxTcpGG4HbcpOCbTTETM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl_fcM6CGxrv3mbUHuVxQTsntUmxRpD9QKLTBtuJUg9w&oe=6AC90D99"}, {"file_name": "Gorilla_Chasers.png", "id": "994101560054398", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_994101566721064_75658797433728703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7wtVc5nq4sQ7kNvwGyFUA0&_nc_oc=AdplzHHb4SEkPqfc5SZpz96RmwLxDd01IH-EVO1nueW2RgzOcCerkdedjI9sm7gybvY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRfSb74UiTcUtpWGOvxCrUAGaDzmuHo5SVmXp4RqP8fw&oe=6AC903D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ripple Tag", "keywords": [], "long_description": "RIPPLE TAG\n\nSwing, run, and scale your way to victory in Ripple Tag, the ultimate fast-paced physics-based multiplayer tag game! Created by Direct, this game takes high-speed chase mechanics to the next level with incredibly smooth locomotion, customizable lobbies, and non-stop action.\n\n\ud83c\udf1f GAME FEATURES:\n\nCLASSIC LOCOMOTION: Master the iconic physics-based movement where your arms are your only tools to climb, jump, and escape other players.\n\nSHINY ROCKS & COSMETICS: Earn in-game currency as you play to unlock a massive catalog of epic cosmetics to customize your gorilla and show off your unique style.\n\nCUSTOM ROOMS & REGIONS: Instantly create and host private rooms using simple codes, broadcast your lobbies, and hang out with friends globally.\n\nFREQUENT UPDATES: Dive into fresh features, seasonal map rotations, and exciting new items designed to keep the chase thrilling.", "short_description": "RIPPLE TAG\n\nSwing, run, and
7PO43mWlAcarOr9zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6FUEfhTHK5ESNJQiLdBDrY2rEbHr9daHizTQJFpZzYA&oe=6B070BB7"}, {"file_name": "HOAME_SCREENSHOT_5_FINAL.png", "id": "3103791439863638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_3103791443196971_7229641991268106940_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBDVkJWZlXQQ7kNvwHX5aJC&_nc_oc=AdoV2D0I56aMMfiXS7ZLkcvxhLIW94wcrzb4313Is47lJapWzHKslNPdS8Zk2A-pPvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHz9UAeEt2SjRDWeJUkDp6CmIv3DUpSz1REmc2x8xzyQ&oe=6B070B55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HOMAE_CoverImageSafeAreaTemplateLandscape_FINAL1.png", "id": "295243349277898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_295243355944564_227383089990940290_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8oBOwxRfoAQ7kNvwE4fDE5&_nc_oc=AdrEORaqg8mE0ZMjONXfwBKokrVzyFSYDHgehGIewXnaZXnnQvTkLfKOoEV6K5qFUhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7qPC8p9bFAUnknY2s6DJUNbfEvuZ-fGUVNElVkk0JJg&oe=6B06FC46"}, "display_name": "Hoame", "keywords": ["meditation", "fitness", "yoga", "sports", "relaxation"], "long_description": "Introducing the world\u2019s first virtual meditation studio!\n \nTap into the power of a real boutique meditation studio from the comfort of your own home. Experience the feeling of presence by dropping into a studio class or unplug with an elevated meditation experience from our on-demand library.\n\nGo deep with our diverse group of expert instructors who will take any intimidation out of meditation. With our vast roster, and over 15+ styles of meditation, there is a mindfulness practice for everyone.\n\nOur goal is to help you unlock your full potential.\n\nMembership Includes:\n\n\u00b7       Daily studio classes\n\u00b7       Growing library of on demand experiences\n\u00b7       Breathwork practice\n\u00b7       Monthly events & workshops\n\u00b7       Expert instructors\n\u00b7       Real studio community\n\u00b7       Progress tracker \n\u00b7       Mood surveys\n\u00b7       Sit-set customizer\n\u00b7       7-day free trial  \n \nChoose the plan that is best for you and start today.\n\nSee you on the cushion!", "short_description": "Introducing the world\u2019s first virtual meditation studio!\n \nTap into the power of a real boutique meditation studio from the comfort of your own home. Experience the feeling of presence by dropping into a studio class or try an elevated meditation from our on-demand library.\n\nWith our diverse group of expert instructors, and 15+ styles of meditation, there is a mindfulness practice for everyone.\n\nChoose the plan that works for you and start today.\n\nSee you on the cushion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoame.ca/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Hoame", "support_website_url": null, "website_url": "https://www.hoame.app/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "675534173587494"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1246648886433878"}, {"status": "PUBLISHED", "id": "608120273824579"}, {"status": "PUBLISHED", "id": "1327357811333076"}]
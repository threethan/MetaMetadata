1268106940_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5MUgMDaedcQ7kNvwGWPWg5&_nc_oc=AdqlCg61AoUcBhWwV56zET79MoLt5njdaU-R4PD6sQ7MiEYb9MjCSmIwOLDp4X201T4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW6TnWIwaMPjbbiIi8haigEA4cVtBQ7JgbLJU5bk3GGg&oe=6AECAD55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HOMAE_CoverImageSafeAreaTemplateLandscape_FINAL1.png", "id": "295243349277898", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/10000000_295243355944564_227383089990940290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-Yl8gJDVakQ7kNvwG4ZIos&_nc_oc=Adrbnp7B4EAdgBQLf0nQ9-ckGdXXjGfjWXTkWHmmaRriSw5WwogAq60SaoN8V6H7CDE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuV67ute8gJZzqPSURC6GFxv-ATJxrE8-6qPlvoYgoxA&oe=6AEC9E46"}, "display_name": "Hoame", "keywords": ["meditation", "fitness", "yoga", "sports", "relaxation"], "long_description": "Introducing the world\u2019s first virtual meditation studio!\n \nTap into the power of a real boutique meditation studio from the comfort of your own home. Experience the feeling of presence by dropping into a studio class or unplug with an elevated meditation experience from our on-demand library.\n\nGo deep with our diverse group of expert instructors who will take any intimidation out of meditation. With our vast roster, and over 15+ styles of meditation, there is a mindfulness practice for everyone.\n\nOur goal is to help you unlock your full potential.\n\nMembership Includes:\n\n\u00b7       Daily studio classes\n\u00b7       Growing library of on demand experiences\n\u00b7       Breathwork practice\n\u00b7       Monthly events & workshops\n\u00b7       Expert instructors\n\u00b7       Real studio community\n\u00b7       Progress tracker \n\u00b7       Mood surveys\n\u00b7       Sit-set customizer\n\u00b7       7-day free trial  \n \nChoose the plan that is best for you and start today.\n\nSee you on the cushion!", "short_description": "Introducing the world\u2019s first virtual meditation studio!\n \nTap into the power of a real boutique meditation studio from the comfort of your own home. Experience the feeling of presence by dropping into a studio class or try an elevated meditation from our on-demand library.\n\nWith our diverse group of expert instructors, and 15+ styles of meditation, there is a mindfulness practice for everyone.\n\nChoose the plan that works for you and start today.\n\nSee you on the cushion!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hoame.ca/privacy-policy-vr/", "developer_terms_of_service_url": null, "publisher_name": "Hoame", "support_website_url": null, "website_url": "https://www.hoame.app/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "675534173587494"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1246648886433878"}, {"status": "PUBLISHED", "id": "608120273824579"}, {"status": "PUBLISHED", "id": "1327357811333076"}]}, "baseline_offer": {"id": "1246648886433878"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739288340, "status": "PUBLISHED", "id": "1246648886433878"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24384151937865595", "version": "2.609"}, "id": "25362866285
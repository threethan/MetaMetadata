uVrKd71jc5bnH1-buVJwXbuud7Bg&oe=6B105242"}, {"file_name": "CityRunVR_EN_POV_20261113_121722_08.png", "id": "1635127751418701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842244_1635127754752034_3939741592033112847_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcRYttVqF20Q7kNvwF6KKLo&_nc_oc=AdpHotU3d1aRVM22r-H0DZoSJ6wrvZCBKgdBkytWnDBuzpMfLnqIrl3QU_tXVclaKtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1clEMHk7zZr1n7KxNRvIaOHRNbavqf5zS23l_fpKSgw&oe=6B10351D"}, {"file_name": "Screenshot_5_Piazza_Auto.png", "id": "2185232149046179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842279_2185232152379512_1036507728789351840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTuzSDeS2CQQ7kNvwFmxOG3&_nc_oc=AdqfQen2qR7IrqCQsDWYdeqimKeStUuttvvyutXd3Cy4iAclAyq58JSMEDPqSrjAdUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpq8fqKQAA-C_uZYrHH869Qp_Zg21O4z2Hz2FEXp8V7Q&oe=6B105370"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Run VR Ultimate", "keywords": ["Fitness", "Running", "Cardio", "Workout", "Jogging"], "long_description": "City Run VR Ultimate is the next-generation indoor cardio running experience designed for Meta Quest 2, 3, and 3S.\n\nTired of boring treadmills? Put on your headset, jog or run in place, and immerse yourself in a vibrant living city with realistic pedestrian life, traffic, and dynamic weather.\n\n\ud83c\udfc3 KEY FEATURES:\n\u2022 Natural VR Locomotion: Responsive motion tracking translates your natural jogging and arm swing into smooth in-game movement.\n\u2022 Real Cardio & Calorie Burn: Real-time sports HUD tracking instant speed (km/h & mph), active distance, elapsed time, and estimated calories burned.\n\u2022 AI Running Coaches & Ghost Competitor: Run alongside interactive pace coaches or challenge your own personal best ghost runner recorded in previous sessions.\n\u2022 Zero Equipment Needed: No expensive VR treadmill required. All you need is a 2x2 meter space in your room.\n\u2022 Multilingual Support: Full support in English, Italian, Spanish, French, German, and Portuguese.\n\nStart your journey today with our 3-Day Free Trial and transform daily workouts into an addictive fitness adventure!", "short_description": "Turn your living room into a high-energy running track! Jog in place, burn real calories, and explore immersive 3D cities with your AI coach."}]}, "developer_name": "FitnessVR", "developer_privacy_policy_url": "https://fitnessvr.it/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FitnessVR", "support_website_url": "https://fitnessvr.it/", "website_url": "https://fitnessvr.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR", "pt", "pt_BR", "de_CH", "fr_CA", "fr_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1533945923125010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842206_1688034922837056_4753108528194589215_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beEPKy7TaCsQ7kNvwGzcvIR&_nc_oc=Adrk80kGMSB1L-l5mTF8oOE5K8F-IhB-zVfhZ3ufefcvokInCQZAbRNRMSA0mxA0
": "iromie_crayon_1_1_en_icon.png", "id": "1368172978532306", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499623370_1368172981865639_4630787676750546907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNa9hfGZA5oQ7kNvwHbgfTY&_nc_oc=AdpATd7sdeBJIv0YffUR_FFo-L_PJxRZKSeSnMF0Rq0ZezfV_2KuzF63hgcZp3kTT3I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk62QlVGsCcrUMw8dAoSoWT9zZ-xGkRwfDztXIK8UE_g&oe=6A8D7B84"}, {"file_name": "iromie_7_10_en.png", "id": "1235369711818803", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618499_1235369715152136_6694243468494022066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvnn6OexjaAQ7kNvwGVWoYm&_nc_oc=AdqVbaXKF_KqL1EzMwzplubpMtZRxbLRrNfxt8oc5C0_2MWqiiU6sSOxFDvjiNmfhyU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWdUX8WaBsrsOl7rzMK1y0RyfJUBeVsI3GAFi958tDQQ&oe=6A8D8F80"}]}, "id": "1527022122377464", "locale": "en_US", "screenshots": [{"file_name": "image_title_en_2560\u00d71440.png", "id": "850171714070777", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499623314_850171717404110_6215161134799896212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek9IMCrzdRAQ7kNvwFoQtMI&_nc_oc=AdpySpZeJ_srOK7VjqivCxs9jxxTqNWbns8rv8gTFtJg8ThhIysPeUBQu4_eJ1fWGRo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-dmdTkNHpGHN49o2dd6BrDm0NWmzz7UTtc03w8nhSAA&oe=6A8D7F16"}, {"file_name": "image_Common_en_2560\u00d71440.png", "id": "1734637207503661", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617847_1734637210836994_6200374147244188287_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnXdcFLrzwcQ7kNvwGqWrON&_nc_oc=Adq5c5hnP_fvVl5KMjWjOpSKLd9LosauVNt-LtT18PJq2aJ590KOC8OS1rGkrKTMhVc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5zqwjQ3kgFogSUtfwc3CjB__ahFQvNtnsQBn7p2a-lA&oe=6A8D8AD5"}, {"file_name": "image_Protan_en_2560\u00d71440.png", "id": "2490896251344988", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824210_2490896254678321_78089891004512786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnuD6jppOeQQ7kNvwGad1KH&_nc_oc=AdpO9Vr1sh1jxjloHJKFdDO0sVtjT3BDggc7nScHVt9turhZQvgD98ea8EglW6vxQz4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5nQVEvBag8URca9XTrvhC_Gv0Q3uGi3BDckfOK3ecQw&oe=6A8D8B3B"}, {"file_name": "image_Dutan_en_2560\u00d71440.png", "id": "2811375802548176", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618515_2811375805881509_8346001052332955169_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeZ1J0MUMCQQ7kNvwHuqcil&_nc_oc=AdoDddiNVauiWwzPHrveCF_rGALxo_TAeb8F7p4ZE15ZAxOOXSzbWyfEWUXOgIi1nLg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGynXyocwl7XhG1A8xmhPrmxgP5JmM9n1d38_4sWLGIlw&oe=6A8D94C6"}, {"file_name": "image_age90_en_2560\u00d71440.png", "id": "1945941046026935", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822931_1945941049360268_7637566023011906598_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6icWaOW3t-EQ7kNvwHQVVoI&_nc_oc=AdrkbkR-ngeoMFk60Wp68hsvezfG8DJsgVNGXT2ejPyWzNS-MehXNKuuCY9-xcOPwUo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGujsusIP0PVjBik43abJp12qu8Ir29gmTfMJ5jKpSLpw&oe=6A8D6FE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iromie: Color Vision & Aging Experience", "keywords": [], "long_description": "\"What if you could see the world through someone else's eyes?\"\n\n\"Iromie: Color Vision & Aging Experience\" is a Mixed Reality (MR) tool designed to bridge the gap in visual understanding. Using advanced Passthrough technology, it simulates in real-time how your current surroundings appear to individuals with different color vision types or age-related visual changes.\n\n[Key Features]\n\nColor Vision Simulation: Experience various types of color vision, including Protanopia, Deuteranopia, and Tritanopia.\n\nAging Vision Experience: Replicate the yellowing and clouding of the visual field associated with aging.\n\nIntuitive Controls: Seamlessly cycle through filters using your VR controllers to compare visual differences instantly.\n\n[Technology Credits] The visual simulation technology in this app is provided by The University of Electro-Communications (UEC) in Tokyo (Patent Pending). It delivers a highly accurate experience based on the latest academic research.\n\n[Who is this for?]\n\nEducators & Healthcare Professionals: Enhance empathy and awareness in accessibility training.\n\nDesigners & Architects: Validate universal design choices and color accessibility.\n\nPublic Organizations: Test the visibility of signage and safety routes.\n\nUnderstanding the \"difference\" in vision is the first step towards true inclusivity. Gain a new perspective with Iromie.", "short_description": "Experience visual diversity. An MR simulator for color vision and aging via Passthrough, backed by academic research."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coyote-runner.co.jp/iromie-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "COYOTE RUNNER INC.", "support_website_url": null, "website_url": "https://coyote-runner.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
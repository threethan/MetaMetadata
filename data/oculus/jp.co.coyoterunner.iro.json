n_1_1_en_icon.png", "id": "1368172978532306", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623370_1368172981865639_4630787676750546907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjk_gRf8g48Q7kNvwE0s_VF&_nc_oc=Adqu-zyL51vSSrSefuC5naej-pP6S3P263lGVmOludKfWKfU7DVlSGLv9Z-x4isRkX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB21lxIZb1kTMNmQ36NC_GfozUgTLI1Ob3FbWS_OJdQGA&oe=6A6383C4"}, {"file_name": "iromie_7_10_en.png", "id": "1235369711818803", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1235369715152136_6694243468494022066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjkkPWtVFJgQ7kNvwHDW59T&_nc_oc=AdoPXQJrfXCndziwP9-S-vgWGD6PrJ_jWZWuIVdE_O0Mr5DQbwC-wxj7hZwXk15twFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVCcZtT58Kr8PKEXKSriC0ufXifIvwWR5GAaSHS3EJ1w&oe=6A635F80"}]}, "id": "1527022122377464", "locale": "en_US", "screenshots": [{"file_name": "image_title_en_2560\u00d71440.png", "id": "850171714070777", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623314_850171717404110_6215161134799896212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qn99ZY7MElAQ7kNvwFAvPaC&_nc_oc=Adr7bGMTG--8HiT-OkQ83PNfd082-yM21mUSX-IOGN7ysfT8pMFBd7s4l059xqa63mc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIStVwsMl-JLi2LcUnMFbAZzU_8_-zNv_sunzf3XKQHg&oe=6A634F16"}, {"file_name": "image_Common_en_2560\u00d71440.png", "id": "1734637207503661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1734637210836994_6200374147244188287_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w71tNWzMOd8Q7kNvwFMWR2b&_nc_oc=AdrmsrrNu2la59WHGlDHFD1oZubNZItDW2biWemMLFFlsZFBdNdfJ2qXrMbCXT4cwm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi9SRj_2pRiz_bE0vFfxw9qwN_yzxKENbxVTEOvjQb-Q&oe=6A635AD5"}, {"file_name": "image_Protan_en_2560\u00d71440.png", "id": "2490896251344988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824210_2490896254678321_78089891004512786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tkN7JxE2FsQ7kNvwF5waLZ&_nc_oc=AdqPq1_0dbIspPI84VM64aGzDeQyW9RqmiZV5X0yuCqTQ0MFu-vF9xLHC1UwxxdEtO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbos_1mR08O6NArd2oVyvbKmiPfbCiWWItLR6CSw-9Lw&oe=6A635B3B"}, {"file_name": "image_Dutan_en_2560\u00d71440.png", "id": "2811375802548176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_2811375805881509_8346001052332955169_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5N9etrhMBMQ7kNvwGNVt1Q&_nc_oc=Adp-xIDbjD9Cv_i39WtHSvu2uazkhHhPGlAskO4NRXWm8FSlycNKhxp0gpyBD6E4VtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2EhjLAH8hgJ9s274eSU4PklaHp0GTqyRyK5WK7sRWbw&oe=6A6364C6"}, {"file_name": "image_age90_en_2560\u00d71440.png", "id": "1945941046026935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822931_1945941049360268_7637566023011906598_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiYjJkd1HSoQ7kNvwFwU9De&_nc_oc=AdozGAT2zVIeKTtIIzB3zs8VGFRKmdML86zylEXKbOLf_M6jqEztZ4mpqn4dOyaEiKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeGy5nnLzbNB26Ttdah-xj4RW308psL1TJAkS1OoFsfQ&oe=6A637825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iromie: Color Vision & Aging Experience", "keywords": [], "long_description": "\"What if you could see the world through someone else's eyes?\"\n\n\"Iromie: Color Vision & Aging Experience\" is a Mixed Reality (MR) tool designed to bridge the gap in visual understanding. Using advanced Passthrough technology, it simulates in real-time how your current surroundings appear to individuals with different color vision types or age-related visual changes.\n\n[Key Features]\n\nColor Vision Simulation: Experience various types of color vision, including Protanopia, Deuteranopia, and Tritanopia.\n\nAging Vision Experience: Replicate the yellowing and clouding of the visual field associated with aging.\n\nIntuitive Controls: Seamlessly cycle through filters using your VR controllers to compare visual differences instantly.\n\n[Technology Credits] The visual simulation technology in this app is provided by The University of Electro-Communications (UEC) in Tokyo (Patent Pending). It delivers a highly accurate experience based on the latest academic research.\n\n[Who is this for?]\n\nEducators & Healthcare Professionals: Enhance empathy and awareness in accessibility training.\n\nDesigners & Architects: Validate universal design choices and color accessibility.\n\nPublic Organizations: Test the visibility of signage and safety routes.\n\nUnderstanding the \"difference\" in vision is the first step towards true inclusivity. Gain a new perspective with Iromie.", "short_description": "Experience visual diversity. An MR simulator for color vision and aging via Passthrough, backed by academic research."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coyote-runner.co.jp/iromie-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "COYOTE RUNNER INC.", "support_website_url": null, "website_url": "https://coyote-runner.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35685838631061648"}, "r
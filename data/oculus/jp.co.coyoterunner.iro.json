_crayon_1_1_en_icon.png", "id": "1368172978532306", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499623370_1368172981865639_4630787676750546907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqGNpP15iVwQ7kNvwG5v0br&_nc_oc=AdoJEzSjSoYwkmOcIebyNZsZJTjxYmGXdbcRbGg75Ea0X5srXzp5bHsdiNhmyF0kZZI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SlnrDVYgrW0XV4H5H_3a-oncBIeqpuIvEc8_zZmanOQ&oe=6A4682C4"}, {"file_name": "iromie_7_10_en.png", "id": "1235369711818803", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1235369715152136_6694243468494022066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga79QweZGSQQ7kNvwH2ofbH&_nc_oc=AdoVuKZZ9BPSBmeX5yEcpTh1eCikviTgMf80XfgxaKcgqzq41K2_u9tLtClEsEhoIDs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qFQ5_sHN0fPLT7gUN2XG3pWokcXaOruEbpcW8TdCDLA&oe=6A465E80"}]}, "id": "1527022122377464", "locale": "en_US", "screenshots": [{"file_name": "image_title_en_2560\u00d71440.png", "id": "850171714070777", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499623314_850171717404110_6215161134799896212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBGAXRJreVwQ7kNvwHzXiV5&_nc_oc=AdpDFG2wmBYLSmA-igN3BKOx2_-haV8SGHX7DoYRN0knhtgE5aV_MyRRzSOuiIaiFQQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EOjNEVTYFUA7vwMAiLq9e0am2YyFqSaN1SR7mFvf1lQ&oe=6A468656"}, {"file_name": "image_Common_en_2560\u00d71440.png", "id": "1734637207503661", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617847_1734637210836994_6200374147244188287_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7SabkTF8akQ7kNvwEy6FNy&_nc_oc=Adqboub_3Sca83Qzm-RK1IOdni24x8EzF5Xbnlu8OB50pn-wzNLEYE0TkpMHRIkTYD0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b9aMa65kA12F-x3Ye31VnSJmyORLw10GBz_MJq4LsTQ&oe=6A4659D5"}, {"file_name": "image_Protan_en_2560\u00d71440.png", "id": "2490896251344988", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824210_2490896254678321_78089891004512786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShxoIIvSI8MQ7kNvwFEA8lR&_nc_oc=AdrzdYga0HHC40prol1QNTRPbmxMdbiiu3lmd2cc00OJU4vwCCNSY5hpc9SX7vYMfWM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XnVeQpAr89tu2GSViwy0R4jI6XpMEPv9FKimM8AnZgA&oe=6A465A3B"}, {"file_name": "image_Dutan_en_2560\u00d71440.png", "id": "2811375802548176", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618515_2811375805881509_8346001052332955169_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGGXrbmhJroQ7kNvwFfGJuC&_nc_oc=Adr5X29m-hVXU1iBP2Ivg0BMYidUJyin6S_1O4B7qaIMvJS6JeJ_yH6Mc0ZUVwQ-sZs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ieYXGnRq2qGb22DiZjFB7UCZlOtC9tbe3ldRQbxVyGw&oe=6A4663C6"}, {"file_name": "image_age90_en_2560\u00d71440.png", "id": "1945941046026935", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822931_1945941049360268_7637566023011906598_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtSb9P0yuWEQ7kNvwFinSNU&_nc_oc=AdqThyIeM3LxRS-sQ7aslkj4ax7vrpqXmcye6JQVo6gCtvkbKUqTIPBe0nkbHU3gbxU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n8RGlEGJLr2RWMorKLea_xI-E8Qlc2InqrZjMcaGEmQ&oe=6A467725"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iromie: Color Vision & Aging Experience", "keywords": [], "long_description": "\"What if you could see the world through someone else's eyes?\"\n\n\"Iromie: Color Vision & Aging Experience\" is a Mixed Reality (MR) tool designed to bridge the gap in visual understanding. Using advanced Passthrough technology, it simulates in real-time how your current surroundings appear to individuals with different color vision types or age-related visual changes.\n\n[Key Features]\n\nColor Vision Simulation: Experience various types of color vision, including Protanopia, Deuteranopia, and Tritanopia.\n\nAging Vision Experience: Replicate the yellowing and clouding of the visual field associated with aging.\n\nIntuitive Controls: Seamlessly cycle through filters using your VR controllers to compare visual differences instantly.\n\n[Technology Credits] The visual simulation technology in this app is provided by The University of Electro-Communications (UEC) in Tokyo (Patent Pending). It delivers a highly accurate experience based on the latest academic research.\n\n[Who is this for?]\n\nEducators & Healthcare Professionals: Enhance empathy and awareness in accessibility training.\n\nDesigners & Architects: Validate universal design choices and color accessibility.\n\nPublic Organizations: Test the visibility of signage and safety routes.\n\nUnderstanding the \"difference\" in vision is the first step towards true inclusivity. Gain a new perspective with Iromie.", "short_description": "Experience visual diversity. An MR simulator for color vision and aging via Passthrough, backed by academic research."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coyote-runner.co.jp/iromie-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "COYOTE RUNNER INC.", "support_website_url": null, "website_url": "https://coyote-runner.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "356858386310616
_crayon_1_1_en_icon.png", "id": "1368172978532306", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499623370_1368172981865639_4630787676750546907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbUt06V8WzMQ7kNvwFIIdix&_nc_oc=AdocNrJUYEypXbt1Ocz9UrlbVGJ_AZU_KMR5TYqUAoBiLjM97IOS4esJKTIRp15vI0U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIDkFcA06_h1XKrqxNaqZ6jUT7PGsMd3FlYGmhu2wc3g&oe=6A7DA984"}, {"file_name": "iromie_7_10_en.png", "id": "1235369711818803", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618499_1235369715152136_6694243468494022066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc1IRwtliIcQ7kNvwH0UF7p&_nc_oc=AdpDJBFxM0FtWJKxdrEIzf6RQV3fNJowy7SLwxx057NcQ0t0FrILO94sV5OVzRUjcMQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmZQ4IAg7rLIY18YmkA_gEglqfshUtVIEzstz7hWzVPg&oe=6A7DBD80"}]}, "id": "1527022122377464", "locale": "en_US", "screenshots": [{"file_name": "image_title_en_2560\u00d71440.png", "id": "850171714070777", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499623314_850171717404110_6215161134799896212_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIf_BKZRx2AQ7kNvwF3PO9L&_nc_oc=AdrgjS1qXOAHEm8BRlJrBRFDuDQlFLp4q8HZYdXOFKyjafhUvDkDMBg6nNUPHWQeOxk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOT1xs5fMzxpHj2tgjpYMRaznB6xOdDY3peqvUhFOqiA&oe=6A7DAD16"}, {"file_name": "image_Common_en_2560\u00d71440.png", "id": "1734637207503661", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617847_1734637210836994_6200374147244188287_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGXO3YHxz2oQ7kNvwGbNP8J&_nc_oc=Ado9b8CNZkEY10GJkQZaXTk-dTbXDAoD2H2hMMMBd2hkePESMYVgfErVXq_3sCDzslg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWDffBDY__bARZe9I3VWS1RgEg7WDPwRqWaLiihD5vgQ&oe=6A7DB8D5"}, {"file_name": "image_Protan_en_2560\u00d71440.png", "id": "2490896251344988", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824210_2490896254678321_78089891004512786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6hfGZGECxkQ7kNvwG_X9Rn&_nc_oc=Adoxzb-fiQFJX7YqEZF9XzUVj2ZgZqF_m8ipuqr7LKlJBnivNHodcbSbpkNzXLmmnYY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUXGKJclAHjoRJb_tV_HinQtMlS2LlTf4bcZyC9gOYlg&oe=6A7DB93B"}, {"file_name": "image_Dutan_en_2560\u00d71440.png", "id": "2811375802548176", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618515_2811375805881509_8346001052332955169_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFqNXYTL5doQ7kNvwGyA6Nz&_nc_oc=Adrqxn7DTHBjBoLYG6PIDb7_JDgdQKMQx46Usq_C5G3oJxyTE1cY_xWgSC1b6YOrc3o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGLMjTwZpLil6GPsZyRY9TVKp5DsjfszCUYj3haaQORg&oe=6A7DC2C6"}, {"file_name": "image_age90_en_2560\u00d71440.png", "id": "1945941046026935", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822931_1945941049360268_7637566023011906598_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgSmsrnb710Q7kNvwE_S_fu&_nc_oc=AdoVM6qInuSOOgh0VyLMlrquvS38MxdKYJSXV8vVdEMHvyv2XdmSxBF4yB-3DmkMECk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFF6z_VTTs9QMeG7k1CCN3JsG86xmRRCFpmshLMdAN6w&oe=6A7D9DE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iromie: Color Vision & Aging Experience", "keywords": [], "long_description": "\"What if you could see the world through someone else's eyes?\"\n\n\"Iromie: Color Vision & Aging Experience\" is a Mixed Reality (MR) tool designed to bridge the gap in visual understanding. Using advanced Passthrough technology, it simulates in real-time how your current surroundings appear to individuals with different color vision types or age-related visual changes.\n\n[Key Features]\n\nColor Vision Simulation: Experience various types of color vision, including Protanopia, Deuteranopia, and Tritanopia.\n\nAging Vision Experience: Replicate the yellowing and clouding of the visual field associated with aging.\n\nIntuitive Controls: Seamlessly cycle through filters using your VR controllers to compare visual differences instantly.\n\n[Technology Credits] The visual simulation technology in this app is provided by The University of Electro-Communications (UEC) in Tokyo (Patent Pending). It delivers a highly accurate experience based on the latest academic research.\n\n[Who is this for?]\n\nEducators & Healthcare Professionals: Enhance empathy and awareness in accessibility training.\n\nDesigners & Architects: Validate universal design choices and color accessibility.\n\nPublic Organizations: Test the visibility of signage and safety routes.\n\nUnderstanding the \"difference\" in vision is the first step towards true inclusivity. Gain a new perspective with Iromie.", "short_description": "Experience visual diversity. An MR simulator for color vision and aging via Passthrough, backed by academic research."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coyote-runner.co.jp/iromie-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "COYOTE RUNNER INC.", "support_website_url": null, "website_url": "https://coyote-runner.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "356858386310616
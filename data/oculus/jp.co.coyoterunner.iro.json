m/v/t64.5771-25/499617847_1734637210836994_6200374147244188287_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1mnwfG2zE8Q7kNvwEvPAU2&_nc_oc=AdpnRClgKpkEMxmaMsMgLz3oOQG0hRsPb9Zwd7NuaApk9hgYFqd5lb-rJSdbH9nRvpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDFCi0AhKubyIGKzGuYRs4ErhUWhVdBTqcNehQrMgh7Q&oe=6B046A15"}, {"file_name": "image_Protan_en_2560\u00d71440.png", "id": "2490896251344988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824210_2490896254678321_78089891004512786_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz_NVgAKKtMQ7kNvwFN5LU1&_nc_oc=Adob1p6U2asQwrUdxpfWy_x_WFhdjSx5lf1oC9wDQWc2s4z9kW_DJyajueTMIoZUjxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE16wTMG3LCtbIzvSZ0mKyxE7iql_rq0ihnEJbHebK3w&oe=6B046A7B"}, {"file_name": "image_Dutan_en_2560\u00d71440.png", "id": "2811375802548176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_2811375805881509_8346001052332955169_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84Xm82HSH88Q7kNvwGNpQrn&_nc_oc=AdqyjRfPI4nOP7FVhamQABbfpD2QiQUMG_DPzvfSIfq9Iws_P-diYlIyDSijxyCNh00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ZcFMrJQzBGOl8qFjQC3dASAaBlBcgHD-YXX6CF-24Q&oe=6B047406"}, {"file_name": "image_age90_en_2560\u00d71440.png", "id": "1945941046026935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822931_1945941049360268_7637566023011906598_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RORiNitpYN0Q7kNvwE5WWJU&_nc_oc=Adpp1XmDe-5-bjtj9A4YvIyGL_uvOnFgPq8PCGOFFEDGQcon8tI2uQsYU7WWRvmvG24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0XGKqwKkGcceOSgLWI8AjobGpb3km9-dLfhWmyt82VQ&oe=6B048765"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iromie: Color Vision & Aging Experience", "keywords": [], "long_description": "\"What if you could see the world through someone else's eyes?\"\n\n\"Iromie: Color Vision & Aging Experience\" is a Mixed Reality (MR) tool designed to bridge the gap in visual understanding. Using advanced Passthrough technology, it simulates in real-time how your current surroundings appear to individuals with different color vision types or age-related visual changes.\n\n[Key Features]\n\nColor Vision Simulation: Experience various types of color vision, including Protanopia, Deuteranopia, and Tritanopia.\n\nAging Vision Experience: Replicate the yellowing and clouding of the visual field associated with aging.\n\nIntuitive Controls: Seamlessly cycle through filters using your VR controllers to compare visual differences instantly.\n\n[Technology Credits] The visual simulation technology in this app is provided by The University of Electro-Communications (UEC) in Tokyo (Patent Pending). It delivers a highly accurate experience based on the latest academic research.\n\n[Who is this for?]\n\nEducators & Healthcare Professionals: Enhance empathy and awareness in accessibility training.\n\nDesigners & Architects: Validate universal design choices and color accessibility.\n\nPublic Organizations: Test the visibility of signage and safety routes.\n\nUnderstanding the \"difference\" in vision is the first step towards true inclusivity. Gain a new perspective with Iromie.", "short_description": "Experience visual diversity. An MR simulator for color vision and aging via Passthrough, backed by academic research."}]}, "developer_name": null, "developer_privacy_policy_url": "https://coyote-runner.co.jp/iromie-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "COYOTE RUNNER INC.", "support_website_url": null, "website_url": "https://coyote-runner.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119
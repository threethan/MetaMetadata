com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56K0b78kR90Q7kNvwGzlOcY&_nc_oc=Adr2AWmb8j-rcstQddL9FgCl41fAnZRKlrsto0q4KQQm0EKaIlUCvuJYYsT3ELLn-PM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu88kCWSzVP8TdlQHWgwV-XBLahs9MGmRDlgK15Z9b1A&oe=6AD3954F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkIOo4EmeCgQ7kNvwG6FPTb&_nc_oc=AdqNUB0k2vlxoeXDUCkVOMFdNUsLmp4brHsa7bh0BIGf948CHsZHV_tGMIXbEdgwAws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0AKrnsac2Ku8Xzp0WLvw7tgqf7zAQWKRkdyHDTzWYTg&oe=6AD3B7AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593790560_1765446514890901_9117201444357012327_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLZH1Vlo5yoQ7kNvwEAKJpP&_nc_oc=AdqF_GfBSbeCVMLlNvGrZoaU2u_fohHse_tZpLoyh61TEPzybdYkMzlqEt17_yW3dFE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-8GQBAywHAPEX3eZCjz1z9-LO-YvfZqYQE7_qC5cp0Q&oe=6AD38F55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Weavs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1783896660, "lastRevision": {"nodes": [{"id": "24799744829666956", "r
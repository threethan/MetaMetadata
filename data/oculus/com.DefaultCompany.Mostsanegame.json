hc=Vn5gmR2sr1cQ7kNvwHfbKFf&_nc_oc=Adodp6GNNHAFOKO9H8i0F1w3-_quxHGJpbnbcdETYMern75N79saXTkwOH1cZD8VdYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQO-fDuF7-Nw3IZuJluwyOqKu37KH1weLPQwdos1PhY5Q&oe=6B0C7100"}, {"file_name": "weavsgameplay2.png", "id": "1685686235992862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNs7Gz7-xcIQ7kNvwHItgrU&_nc_oc=Adqi87wdnAPkS5Q6yOrZ4Ca2zvUx_x-jMXRhFpgCVC9th_4WR2dVhcNHYWSTvM9IiS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0NTCmyf2bYBUFS1N7X3S4E5kCigRoTPZ31Q1aOcP1IQ&oe=6B0C7E0F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1BpO4KP7tkQ7kNvwEudIVz&_nc_oc=Adqce9RNDWcSZI5IYFVlVj-QBSX7Xvvjg_xZvIBDvT5fjXKy2EfJ82Yjxr2oEOhjSIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8EIE25O0UKz_192MAd6Dn7gOgrTq2iZiw48WQdaVclw&oe=6B0C682A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593790560_1765446514890901_9117201444357012327_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WwMIe2XBEUQ7kNvwFbAx2s&_nc_oc=AdppxMqZIXps6B1SVsPsS2ubRaLRy6wl1uWv_8IVpdpa3LBnmteYiBxe4c_AseEPoSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTwrl-O7I8io3S19cZZ4BL32Y7-WjSQmJpzC1I9g6YKA&oe=6B0C7815"}, "is_concept": false, "is_test": false, "is_trial_offe
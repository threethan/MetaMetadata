hc=D_5bQH2LBmYQ7kNvwGcMMqq&_nc_oc=AdpaBOB0xoeEuEYKU9sIfIR0IECW5Ut92BU0REY89xpboB-KUNOmZW8z6dB5lZEvCg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfKU_MVaesrypUzqVgePR8KTNzFbti9r_8MhXSDQgCgQ&oe=6B106580"}, {"file_name": "weavsgameplay2.png", "id": "1685686235992862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODqrd3amCAcQ7kNvwGiDHAx&_nc_oc=Adpxqll8Z9S7Hw9FoXmx50ZUSJ-yxKjgTheIt5vslVr1UQSu8IbMykjRhsC_HOGSRTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4mgFHNHaI7SpwVnm1uHPDU35qnPY8jEY8FBR4oPwO2w&oe=6B103A4F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sivTiiAPJswQ7kNvwGOEWKb&_nc_oc=Adrs4jT4SwaElThwsJOauKC-njO8qlM-aH4Q4Z0BaWuie75DttbFoTMfCIuYuX_GEzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUa1IVA8SZldG50C9DJtwkhk_EdHxN9AVi1yoP8llsRIA&oe=6B105CAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593790560_1765446514890901_9117201444357012327_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PXc6b5yzqEQ7kNvwG6fakR&_nc_oc=Adr5Z-xI6RVmRovRw2RvsL3Tvsf8pJ8eZ8srg-n53IK95CsvWve9_y5ozUVdzN9Mqyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6416MRqaw6Ew9p_e5memtoKGrg2IgwEhMbUcQkig-HA&oe=6B106C95"}, "is_concept": false, "is_test": false, "is_trial_offe
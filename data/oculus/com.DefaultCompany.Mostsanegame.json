t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlG3orkY6QGoP3e3Yb8zrbPb-W4x5QsMKDM19bFAVidQ&oe=6AFDB840"}, {"file_name": "weavsgameplay2.png", "id": "1685686235992862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huSQFPc5x0UQ7kNvwE7raFO&_nc_oc=AdpNB2eFeFm2ZkcXnYm4LYcjxlqQjVyFkLRsiAhUi9D-qSifAHBiEoaJeyQ93EJ4N_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh1mJX0SK4Hy_TdJXHcShKjTOwQ36KaO9ZOgdTUBD5BQ&oe=6AFDC54F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymMAOnPZnNoQ7kNvwG_Y3is&_nc_oc=AdonaethlWxf-NnNFy8-YT7V_M4Z7NxTdKIidHZxXdLzFGP851dYpw-12mcn_ZBHxnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHFLLaxWzjZjkj_fQq7vABN5mOzJkwoC-j26mxKMyqoA&oe=6AFDAF6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593790560_1765446514890901_9117201444357012327_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRNzjcbOM_gQ7kNvwGb7ivJ&_nc_oc=AdrrfxU3APpoPmOaS4_8_RQVUyI5V_W5bxTgUALp6LJ5LJ5dP35YEesdCcB9g9x7ZKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8WlHm4SFdi65dV3fd3w1_Cm0PRLVfDfT_Absodm-U1g&oe=6AFDBF55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Weavs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id":
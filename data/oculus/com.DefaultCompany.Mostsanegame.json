hc=Vn5gmR2sr1cQ7kNvwF6nCiu&_nc_oc=AdrI71YF0NNUF7lL2d5nl-MK6gUGYEuQPKZBESWVfTqmR1cg9UK_6mz183mwaZIwuaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-OaykAGROQYeeyCL5uSUUKI7H8hZHeKGvFFs-luasuw&oe=6B0B1F80"}, {"file_name": "weavsgameplay2.png", "id": "1685686235992862", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZPlWI3weiQQ7kNvwECnZPx&_nc_oc=Adq5U38JZXwaguypgnCnyF4EBPQKboG0nI_lKTdb5r12XkdJSpjNUiwUDzvVOE1vBQs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfglyWiwST2bMYu6ixu-TrwRKZ03dCpwYV-1fyJSq3aQ&oe=6B0B2C8F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1BpO4KP7tkQ7kNvwEsazm2&_nc_oc=Ado9xUWVGHeWYteUc2Nn_2MOJ1Llux2AYz4CFvJl-VPsxU6KGiGpmuFsuN_8LrfZAnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVIFf5QN6dp5mbOP5bWkOJKgTb1x_CTy-KXt9yxTWSdw&oe=6B0B16AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593790560_1765446514890901_9117201444357012327_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WwMIe2XBEUQ7kNvwH3gQE_&_nc_oc=AdrSl4Gws_A-riXbxADti80yb9yQQFyJZ6D02o2k85TdEw8fq3nMX-9oTV9Z_mg-Vis&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQE3EZSsQlzMEwAs9NGM40Pi1W8VuZexEtyZc94n2cvbA&oe=6B0B2695"}, "is_concept": false, "is_test": false, "is_trial_offe
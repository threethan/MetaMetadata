7f20f&oh=00_AQDoTnpgV7O5ljSYkk432mbWKKm5vC11OTgO7GZr7JlR2Q&oe=6A64CA40"}, {"file_name": "weavsgameplay2.png", "id": "1685686235992862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313107_1685686239326195_2724847118907299034_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2ePrMoBgX0Q7kNvwGGZmGX&_nc_oc=AdrMenRLKuQzLpzPkijdAAyPMzp_6HYqnp0yvOHFXsEw5-JtDq5W28Nh9wen0iyGM8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMJf7jbXJPm3Q-IBkFd8OvIt7CqN95QwpNaqaqIRRrug&oe=6A649F0F"}, {"file_name": "weavsgameplay4.png", "id": "1721323605844266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_1721323609177599_5557427694007438209_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuMQcX4JvgEQ7kNvwEU1WYr&_nc_oc=AdqahjK1Gtao5C6K8nZcIfH91o50swgyiLd42sPs-AQ3wzleGE-LOa1mY2JPXGviNdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArjICaDZr443GZRY2x5zDLleUU8TXSmxALaexsgjwXOQ&oe=6A64C16A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Weavs", "keywords": ["weavs", "horror", "scary", "building"], "long_description": "# Weavs\n\nWeavs is a VR game built around chaotic minigames and a tense build-and-survive horror mode you can play with friends.\n\n\n# Horror Mode\n\nThe horror mode you and your friends prepare during the day and fight to survive at night.\n\nDuring the day, you build and upgrade your base, place defenses, gather what you need. When night falls, monsters come out and attack from different directions, forcing your team to defend what you built. Every monster changes how you need to build your base. \n\n# Minigames\n\nJump into fast, replayable minigames with different challenges, goals, and ways to compete. Each mode is made to be easy to understand, fun to replay, and chaotic with friends.\n\n## Features\n\n- Play in VR with friends\n- Compete in chaotic minigames\n- Build and defend your own base\n- Survive against waves of monsters\n- Use strategy, teamwork, and quick reactions\n- Try different difficulties and survival plans", "short_description": "Weavs is a VR game packed with chaotic minigames and a build and survive horror mode where you and your friends create a base, fight off monsters, and try to survive the night."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mostsanestudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Most Sane Studios", "support_website_url": null, "website_url": "https://mostsanestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27498983026409776"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "821913413981027"}]}, "baseline_offer": {"id": "821913413981027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783896660, "status": "PUBLISHED", "id": "821913413981027"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27555319634109448", "version": "1.1.2"}, "id": "1881117332835068", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24799744783000294", "is_concept": false, "latest_release
ile_name": "inDeath_SiegeOfHeaven_Screenshot_Halloween2026Map_01.png", "id": "965344149548817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_965344152882150_3007122432113263990_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoUebU64YyQQ7kNvwHfeQR_&_nc_oc=AdoxCeiZ-vrFXzfCt9ngex85sSIqb0dQqw1rK36SOAvyEIFm8UQNdffdlsWmDv8EpkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkTnXB62oi5EX1xgn3tmbRQpkjELDa5xe9ocYP8zuzog&oe=6AFDB555"}, {"file_name": "inDeath_unchained_SiegeOfHeaven_chapter03_level02_01.png", "id": "1125202706614113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1125202709947446_1828762875789449272_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JH40zTgk5MQ7kNvwGBI4Ul&_nc_oc=AdrXYsCFIOTUNLwtUmfojXZBpVNnvgiunpbQ8eix7hHpE5H-76W_QnzEfFaYM7FFlN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFM2-4Hhjc8PqNZH3pksnxHrD3jpCfWRgL3Qv4U_iDlw&oe=6AFDD880"}, {"file_name": "inDeath_unchained_SiegeOfHeaven_chapter01_level03.png", "id": "2561851344329897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_2561851347663230_3514118213875403403_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5cLhO5SkGgQ7kNvwG6H2qW&_nc_oc=Adq6sVGu34F8PABit1Y7tfgGKvqVNEtLKaZLq5-V6f1j-DYTa1G5Jx4wJVbNnFpxTz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbXx_v8aexZNU5Aauy9ugMYRXeIqlNKW2aIgecjG0_2w&oe=6AFDE35E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "inDeath_SiegeOfHeaven_KeyArt_C_01_MetaStore_Landscape.png", "id": "1455556856702806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_1455556860036139_1500993832661216068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYQ3vUKgGj0Q7kNvwHf_qaP&_nc_oc=AdpBQJbEtp3AeM52pRMYH-I7J_ABD7RvLIf0CApg5qKhi5e5-1nPAk35b6S3T3J7bgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnHOs54GemZG5hv-NiA86MAI3f3Lc6ehXycdPOY7FGZQ&oe=6AFDC2D2"}, "display_name": "In Death: Siege Of Heaven", "keywords": ["archery", "bow", "Fantasy", "best", "arcade"], "long_description": "**Siege of Heaven** is an arcade-style stationary wave/gate-defense game mode built on the core archery mechanics of **In Death: Unchained**, now available as a standalone game. \n\nWhether you're new to VR or already love archery, this game gives you room to learn and have fun and has plenty of depth to keep you playing for years.\n\nGot fifteen minutes for a quick round or two hours to climb the global ranks? **Siege of Heaven** rewards a sharp eye and a steady hand.\n\n* **Pure Archery Mechanics**  No movement controls or weapon switching - just the fluid, satisfying rhythm of drawing, aiming, and releasing with VR's premier archery model. Great for solo high-score chasing and sharing with family and friends.\n\n* **Built around rewarding skilled play** - Rack up massive scores by chaining and mixing many of the game's trick shots -  combos, head shots,  long-distance hits, and many more.\n\nEasy to start. A joy to master. One more shot.\n\n---\n\n**FEATURES**\n\n* **8 Beautiful Maps:** Handcrafted levels set in the atmospheric world of *In Death*.\n* **2 Difficulty Modes:** Approachable fun on Easy, or a challenge on Normal.\n* **Global Leaderboards:** Compete worldwide .. or with friends\n\n-- -\n\n**Note to *In Death: Unchained* Players:**\n\nAlmost half of our players enjoy Siege and love sharing it with family and friends, so we gave it a home of its own. If you own *In Death: Unchained*, you already have the original Siege mode in the main game. Thank you for your support!", "short_description": "Siege of Heaven is an arcade-style stationary wave/gate-defense game mode built on the core archery mechanics of In Death: Unchained, now available as a standalone game. \n\nSiege of Heaven puts you on a safe tower overlooking the Sacred Gate. Enjoy the view, pull off amazing trick shots, and chain huge combos. \n\nWhether you're new to VR or already love archery, this game gives you room to learn and have fun, and has a lot of depth across 8 beautiful maps.\n"}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "https://superbrig.ht/Privacy%20Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Superbright", "support_website_url": null, "website_url": "https://superbrig.ht/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "de", "ja", "ko", "pl", "fr", "fr_CA", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30087350507519807"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_29018534721139942_854075496687626992_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hllLkuEVAawQ7kNvwFAXSfK&_nc_oc=Adq5qJiejgpoa-9eLMvj0MDiqnpOVenqM4v9SuOzeDN615QbpNbq2aY3Dj0CkiXeBMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPBkTV_EY7qybVzoBmUEDWLJy9aYORTlNd564YRLclhg&oe=6AFDC684"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In Death: Siege Of Heaven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id":
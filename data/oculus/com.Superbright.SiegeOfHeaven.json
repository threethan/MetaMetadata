ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_1455556860036139_1500993832661216068_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYQ3vUKgGj0Q7kNvwHf_qaP&_nc_oc=AdpBQJbEtp3AeM52pRMYH-I7J_ABD7RvLIf0CApg5qKhi5e5-1nPAk35b6S3T3J7bgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnHOs54GemZG5hv-NiA86MAI3f3Lc6ehXycdPOY7FGZQ&oe=6AFDC2D2"}, "display_name": "In Death: Siege Of Heaven", "keywords": ["archery", "bow", "Fantasy", "best", "arcade"], "long_description": "**Siege of Heaven** is an arcade-style stationary wave/gate-defense game mode built on the core archery mechanics of **In Death: Unchained**, now available as a standalone game. \n\nWhether you're new to VR or already love archery, this game gives you room to learn and have fun and has plenty of depth to keep you playing for years.\n\nGot fifteen minutes for a quick round or two hours to climb the global ranks? **Siege of Heaven** rewards a sharp eye and a steady hand.\n\n* **Pure Archery Mechanics**  No movement controls or weapon switching - just the fluid, satisfying rhythm of drawing, aiming, and releasing with VR's premier archery model. Great for solo high-score chasing and sharing with family and friends.\n\n* **Built around rewarding skilled play** - Rack up massive scores by chaining and mixing many of the game's trick shots -  combos, head shots,  long-distance hits, and many more.\n\nEasy to start. A joy to master. One more shot.\n\n---\n\n**FEATURES**\n\n* **8 Beautiful Maps:** Handcrafted levels set in the atmospheric world of *In Death*.\n* **2 Difficulty Modes:** Approachable fun on Easy, or a challenge on Normal.\n* **Global Leaderboards:** Compete worldwide .. or with friends\n\n-- -\n\n**Note to *In Death: Unchained* Players:**\n\nAlmost half of our players enjoy Siege and love sharing it with family and friends, so we gave it a home of its own. If you own *In Death: Unchained*, you already have the original Siege mode in the main game. Thank you for your support!", "short_description": "Siege of Heaven is an arcade-style stationary wave/gate-defense game mode built on the core archery mechanics of In Death: Unchained, now available as a standalone game. \n\nSiege of Heaven puts you on a safe tower overlooking the Sacred Gate. Enjoy the view, pull off amazing trick shots, and chain huge combos. \n\nWhether you're new to VR or already love archery, this game gives you room to learn and have fun, and has a lot of depth across 8 beautiful maps.\n"}]}, "developer_name": "Superbright", "developer_privacy_policy_url": "https://superbrig.ht/Privacy%20Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Superbright", "support_website_url": null, "website_url": "https://superbrig.ht/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "en_US", "de", "ja", "ko", "pl", "fr", "fr_CA", "it", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30087350507519807"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "29508860585464324"}, {"status": "PUBLISHED", "id": "1048894934830116"}]}, "baseline_offer": {"id": "1048894934830116"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "29508860585464324"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_t
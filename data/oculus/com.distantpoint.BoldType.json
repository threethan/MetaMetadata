=P5ojy1fORiwQ7kNvwHICgSJ&_nc_oc=AdlwfpeyJq9vyNka_y_JgtPvQ2WklPUYQZahM4LD_I16AfT-Rh9lwxyCqxeLIDR_5CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRWLFsE-GT-TqEctBE6lq6cCM8x7V8h_pZ8P71a-13_A&oe=69A41C62"}, {"file_name": "Screenshot10_2560x1440.png", "id": "1111474860379436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462959_1111474863712769_1383897103581622385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic-2M9aAGV0Q7kNvwGgwAqn&_nc_oc=AdkZa-YJpskT2SOey6xF53jInck0xo8hdLlE9NFyx8SSGgwtnFjp73_tmoblYB14c3Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv96GHcoZjM8rMildw2FyWea6J6NmdT4eCS27hZTQCtaA&oe=69A424BE"}, {"file_name": "Screenshot7_2560x1440.png", "id": "558269733718610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_558269737051943_6901004042255900869_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3BtDkY0OI4Q7kNvwHpHFCy&_nc_oc=AdliHxQ5bs3OmuBe_akDxiWG56C95Eo0Mf_LNuL2YNuqYHVv3TYZLeQWC1J-KfTmRdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuEdv1lDWD6gZyAzHgVsN9LfMySZIckcz_40sfLbbyxAw&oe=69A4220F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bold Type VR", "keywords": ["BoldTypeVR", "Puzzle", "Bold", "Type", "BoldType"], "long_description": "Choose Your Challenge: Tackle puzzles at your own pace with Easy, Medium, and Hard modes.\nCustomizable Themes: Personalize your game with vibrant letter color themes for a visually engaging experience.\nHints to the Rescue: Stuck on a word? The Hint Menu is your secret weapon, showing all the words you need to uncover.\nAchievements & Trophies: Unlock unique trophies as you meet specific achievements and showcase your word-finding mastery!\n\nWhether you\u2019re a casual player looking for relaxing fun or a puzzle enthusiast seeking a challenge, The Bold Type offers endless entertainment and a fresh twist on the classic word search game and an unforgettable experience that challenges your mind while keeping you engaged in a stunning virtual world.\n\nStep into the world of the Bold Type, a cutting-edge VR adventure that redefines the classic word search puzzle! ", "short_description": "Dive into a thrilling puzzle world \nwhere words are hidden all around you\u2014can you find them all?\n\nImmerse yourself in a fully interactive 360\u00b0 puzzle challenge where every turn and corner bring new discoveries. It\u2019s not just a word search\u2014it\u2019s an exploration! With the power of VR, you\u2019re not just solving puzzles\u2014you\u2019re living them!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://distantpoint.org/boldtype/BoldType.html", "developer_terms_of_service_url": null, "publisher_name": "Distant Point", "support_website_url": null, "website_url": "https://distantpoint.org/#home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8930914513703465"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974468_610782348300348_8462631125661345376_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4ONIn8vZZYQ7kNvwEF50Ln&_nc_oc=Adk7-hCwJ6fkchVuAyQCMP9BijlHBCrhZOg8RPk7Na6UKzg_7DU7yjulKVu7fQY44jY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftPJLJCUzpiOhLv82lD6Q62_nAv5zgNKtRJrDFxbWSZDQ&oe=69A43E5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
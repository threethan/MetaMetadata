uluscdn.com/v/t64.5771-25/39031490_942595080690924_2920434848975867417_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpXCOfOD-MIQ7kNvwHbOZB3&_nc_oc=AdpMZZcYUjNwXgTzvS_cuZj6ralwu5WCfmJtwfGLF4IBhFmf4S6p47LchaDQQdRpZX0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I0fH2k4zBGb7XJrBxqXafVmulWuUqECZ1ksY-rj3dyQ&oe=6A467D22"}, {"file_name": "Screenshot10_2560x1440.png", "id": "1111474860379436", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75462959_1111474863712769_1383897103581622385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO4M-MZti8EQ7kNvwFmNEgJ&_nc_oc=Ado6rH8BXby3AtXsJDEhTz-V9bC1SkfZZ8FwqmoLD-Fo3c4mTyBptzIp1piYz6ZNbE0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GNjAZevar3b1lonS9TPLHYZuf4MioTTpGgNTMXvJKCA&oe=6A46857E"}, {"file_name": "Screenshot7_2560x1440.png", "id": "558269733718610", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974562_558269737051943_6901004042255900869_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzVg_aYuLkkQ7kNvwEsuwKI&_nc_oc=AdodQ4j7lKU-8dHgo4jDFJ8RuhhCm20pw48NtodrM36dNT-9qddC3FPrIW09UDuZO7Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FDXQVrrCi3zHgMZYKURmbBP7gAfIbKTuMRVt4ao988A&oe=6A4682CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bold Type VR", "keywords": ["BoldTypeVR", "Puzzle", "Bold", "Type", "BoldType"], "long_description": "Choose Your Challenge: Tackle puzzles at your own pace with Easy, Medium, and Hard modes.\nCustomizable Themes: Personalize your game with vibrant letter color themes for a visually engaging experience.\nHints to the Rescue: Stuck on a word? The Hint Menu is your secret weapon, showing all the words you need to uncover.\nAchievements & Trophies: Unlock unique trophies as you meet specific achievements and showcase your word-finding mastery!\n\nWhether you\u2019re a casual player looking for relaxing fun or a puzzle enthusiast seeking a challenge, The Bold Type offers endless entertainment and a fresh twist on the classic word search game and an unforgettable experience that challenges your mind while keeping you engaged in a stunning virtual world.\n\nStep into the world of the Bold Type, a cutting-edge VR adventure that redefines the classic word search puzzle! ", "short_description": "Dive into a thrilling puzzle world \nwhere words are hidden all around you\u2014can you find them all?\n\nImmerse yourself in a fully interactive 360\u00b0 puzzle challenge where every turn and corner bring new discoveries. It\u2019s not just a word search\u2014it\u2019s an exploration! With the power of VR, you\u2019re not just solving puzzles\u2014you\u2019re living them!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://distantpoint.org/boldtype/BoldType.html", "developer_terms_of_service_url": null, "publisher_name": "Distant Point", "support_website_url": null, "website_url": "https://distantpoint.org/#home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8930914513703465"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974468_610782348300348_8462631125661345376_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTgGWsTfry4Q7kNvwF7naud&_nc_oc=AdqNxUda4VsH-4HAuDeOjsczXXB0XYN6f2qIC9vA9YgHsnaHZz5cF_Dyfax-scFMMrs&_nc_zt=3&_nc_ht=scontent-sin11-
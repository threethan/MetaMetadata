uscdn.com/v/t64.5771-25/39031490_942595080690924_2920434848975867417_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwCu5azjq_MQ7kNvwHJDoEI&_nc_oc=AdqVaYehdIp1BEiUSJbb4E2hk8jP645HH1NRT4vqZlHz34yAre7cLyVVzFks0pXhCW0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOe0YI0zfVGmLVyB5z1gUTWZQt2JEQQkVw1zTL8AldZQ&oe=69CF9DE2"}, {"file_name": "Screenshot10_2560x1440.png", "id": "1111474860379436", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462959_1111474863712769_1383897103581622385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cA82wkg80sQ7kNvwG5J1fg&_nc_oc=AdqZP4cd-xfsxKKej1sRuTpnoXeC_KTdVJMEg8quBF6ZkYmh6kJzhEWFiU-JX0IwbeA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXshZo6450VL5FWJ3wv31J6VfcYXA-Bczi0nB93J9NaQ&oe=69CFA63E"}, {"file_name": "Screenshot7_2560x1440.png", "id": "558269733718610", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974562_558269737051943_6901004042255900869_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AKP2WGr1QYQ7kNvwEYNyuN&_nc_oc=Ado5Icnd-gf38Q8z96wOQXJ6Jx8JxfBKj13938-fS7pCb6Ozb1U1DTgbNUngX8sRd3A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiRW4eQkj9R6xbHz-0_0Wr7Kr_d0gD0TRGnz_F6ozUvQ&oe=69CFA38F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bold Type VR", "keywords": ["BoldTypeVR", "Puzzle", "Bold", "Type", "BoldType"], "long_description": "Choose Your Challenge: Tackle puzzles at your own pace with Easy, Medium, and Hard modes.\nCustomizable Themes: Personalize your game with vibrant letter color themes for a visually engaging experience.\nHints to the Rescue: Stuck on a word? The Hint Menu is your secret weapon, showing all the words you need to uncover.\nAchievements & Trophies: Unlock unique trophies as you meet specific achievements and showcase your word-finding mastery!\n\nWhether you\u2019re a casual player looking for relaxing fun or a puzzle enthusiast seeking a challenge, The Bold Type offers endless entertainment and a fresh twist on the classic word search game and an unforgettable experience that challenges your mind while keeping you engaged in a stunning virtual world.\n\nStep into the world of the Bold Type, a cutting-edge VR adventure that redefines the classic word search puzzle! ", "short_description": "Dive into a thrilling puzzle world \nwhere words are hidden all around you\u2014can you find them all?\n\nImmerse yourself in a fully interactive 360\u00b0 puzzle challenge where every turn and corner bring new discoveries. It\u2019s not just a word search\u2014it\u2019s an exploration! With the power of VR, you\u2019re not just solving puzzles\u2014you\u2019re living them!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://distantpoint.org/boldtype/BoldType.html", "developer_terms_of_service_url": null, "publisher_name": "Distant Point", "support_website_url": null, "website_url": "https://distantpoint.org/#home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8930914513703465"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974468_610782348300348_8462631125661345376_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Rd9wChSyAQ7kNvwHWn_Ib&_nc_oc=AdpS2168j76Ofu2o2gwCX2FCYroilSlaW5ad4vwVdxxj27DkHB3v82JqadrGsaoPJIo&_nc_zt=3&_nc_ht=scontent-atl3-2.oc
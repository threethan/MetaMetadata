ols for immersive gameplay\n\ud83d\udee3\ufe0f Multiple routes and driving challenges\n\ud83c\udf24\ufe0f Dynamic city environments\n\ud83d\ude8d Drive different types of city buses\n\ud83c\udfc6 Complete missions and improve your driving skills\n\ud83c\udfaf Designed for both beginners and simulator fans\n\nClimb into the driver's seat, keep your passengers happy, and become the ultimate city bus driver in Bus Simulator: Modern City Driving.", "short_description": "Drive realistic city buses, pick up passengers, follow traffic rules, and explore a modern city in an immersive VR bus driving simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/diamondgamesstudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "DiamondGamesStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/diamondgamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1202764682931103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507840144_1068228862621985_7127577523165689589_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVWw2aSILY0Q7kNvwE50sgW&_nc_oc=AdryEsm9qPkz7uO1UR8af0ZiLadNUoqiaQnvRHWtkQipWou-AvMrKXanwvH7hSsqxzk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f
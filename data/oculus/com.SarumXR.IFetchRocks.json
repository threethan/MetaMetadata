name": "label_maker.png", "id": "510691753810226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001687_510691757143559_4272398475938808392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkt09u9qEqkQ7kNvwH1HqxZ&_nc_oc=Adp31nip7X3v3JnhmzUP6KVZAuUw6KXdOcA2__iPHjM6axQmreYoYTGNA2mmunLSboM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiR17-0paTkUST9Uhj_tsS_-s1L03PbfB8tklPRpjcgw&oe=6AE9DFF8"}, {"file_name": "dark.png", "id": "294485389441819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_294485392775152_3398830198699120944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1xeW4bAnnAQ7kNvwE7ip83&_nc_oc=AdpjNDkIE8q-oMQevRKekG4OggV-qiGGi_rCw0RVvfLeY2wxNNLJ_uRVgtVKRj2odok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQQXYbxBDYa6torgbRz8WxWfQgLdWLOhcKSN5hMwWe8g&oe=6AEA086A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cockpit_processing.png", "id": "513516810110514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_513516813443847_8652589313076468317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRrqqNzuQzcQ7kNvwGueqe-&_nc_oc=AdrVHr7afz-i2-96dgX6AE4vQI2TRJyvR8wZQZODDCp0J77zdPVOQYZkIpvqNVCPyHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmYcmc5Rq3TgM3wxT92G80jQ2ZFGxUQAmE_J2gMgkxjw&oe=6AE9DFB9"}, "display_name": "I Fetch Rocks", "keywords": ["space", "logic", "programming", "flight", "automation"], "long_description": "Embark on your asteroid hauling career with Veritago Fortana. Start with a basic ship and earn credits to upgrade, customise and repair as you try to fulfil larger and harder contracts. Built exclusively for VR, use your own hands to build, wire and fly using 100s of interconnecting components.\n\nA stable Singleplayer experience with a work-in-progress preview of Co-Operative Multiplayer.\n\nThe year is 2150. You\u2019ve successfully landed a job working for one of the many mining facilities stationed in the asteroid belt between Jupiter and Mars. Using a company issued Asteroid Hauler, your job is to search for mineral rich asteroids and tow them back to the primary mining facility for further processing.\n\nBe warned, this trivial sounding job will push you to your creative engineering limits. The asteroid belt is extremely dangerous, radiation and cosmic rays will continuously degrade the components of your ship. Over the course of your employment you will need to become intimately familiar with how all ship systems operate and fit together so that you can rearrange, rewire and reprogram them as they fail around you. You\u2019ll need to get creative to survive and get your payload back to the primary mining facility.\n\nAll components can be connected using red cables which simulate power distribution and green cables which simulate data flow from user input and various sensors.", "short_description": "Embark on your asteroid hauling career with Veritago Fortana. Start with a basic ship and earn credits to upgrade, customise and repair as you try to fulfil larger and harder contracts. Built exclusively for VR, use your own hands to build, wire and fly using 100s of interconnecting components.\n\nA stable Singleplayer experience with a work-in-progress preview of Co-Operative Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sarumxr.com/i_fetch_rocks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "SarumXR", "support_website_url": null, "website_url": "https://sarumxr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPACE_UNIVERSE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
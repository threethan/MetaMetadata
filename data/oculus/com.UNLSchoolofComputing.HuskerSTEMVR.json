ZXM6yA&oe=6A7DB7F9"}, {"file_name": "Drone_in_Memorial_Stadium.png", "id": "1413531007113951", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619174_1413531010447284_6509542025368196577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdnQqkbEq7AQ7kNvwG-2GOO&_nc_oc=AdrmsKp9apxL7VHtiaa5eELKaDpVBq3NT9fhJ4mfTHd2W4vK8BgNTRCALUI_9c1vPbM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu1eAYCFJfzKiPmKJAUn_idK72HNv07jJxC9Mw2vDhdw&oe=6A7DB5FB"}, {"file_name": "Kiewit_Hall.png", "id": "2370655443411697", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618432_2370655446745030_2092105872958025947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVHtVmlRKFkQ7kNvwGCBvKb&_nc_oc=AdqBR-mMSYZRLyOHjzklGspt5G8hSztXCiot4RvwhUiKJW0ggOupPcyVBbcgvAQByRA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjrUr29ejlvgjD0Q99dIMrV3MtgUEEbpXhZcWyqC3vcg&oe=6A7DA387"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Field_16x9.png", "id": "1520808819769314", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619681_1520808823102647_9084357811865592576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU3LiCnRG1wQ7kNvwGG9fKd&_nc_oc=AdrLajtN1m7rqjMyVVDM8dRbBIGRR1NGyxROnqiByaezg5mJsNi2T0UrMokBszJIJys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9n4pYjsMondRaaGsbGNf7SbQ46cpxQuWeRGDZzXLmcA&oe=6A7DAA73"}, "display_name": "Husker STEM VR", "keywords": ["Husker", "Engineer", "STEM", "Computing", "Robots"], "long_description": "The Husker STEM VR project is an outreach/recruitment app being built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment. Students are building a virtual reality Oculus Quest app for UNL's School of Computing and College of Engineering to encourage STEM outreach. This app will help to make learning fun by creating a virtual reality app designed to create an engaging learning environment. Additionally, we can promote more diversity in STEM by creating an educational environment that promotes inclusiveness.\nSTEM Activities:\n- Computer Science\n- Computer Engineering\n- Software Engineering\n- Electrical Engineering\n- Chemical Engineering\n- Mechanical Engineering\n- Robotics Engineering \n- Civil Engineering\n- Biological Systems Engineering\nFor more information:\nhttps:// www.huskerstemvr.com ", "short_description": "Learn about STEM majors at the University of Nebraska - Lincoln through a fun, interactive experience! The Husker STEM VR project is an outreach/recruitment app built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jfalkinburg.github.io/huskerstemvr_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska - Lincoln School of Computing", "support_website_url": null, "website_url": "https://www.huskerstemvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27297304903290486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618254_848878471563114_5516133272708463697_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAhvxoCOFugQ7kNvwFQQ7ef&_nc_oc=Adr2lthTnuWmaqJVS
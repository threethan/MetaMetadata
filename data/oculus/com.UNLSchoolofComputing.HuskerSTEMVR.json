6A2D4C79"}, {"file_name": "Drone_in_Memorial_Stadium.png", "id": "1413531007113951", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1413531010447284_6509542025368196577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_KJ5eBcMD8Q7kNvwErG-UB&_nc_oc=AdqT2cMLMnjy7LWKiPSshtTC99L4cpHZHL3cVYLAy_jD3QK7-yOkFcV-QSQUxhfb2qw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nPJIBFUKhGOdARW19nCksDThxBASPEu-aEWlqoufmXQ&oe=6A2D4A7B"}, {"file_name": "Kiewit_Hall.png", "id": "2370655443411697", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_2370655446745030_2092105872958025947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxvphVLu9WQQ7kNvwGJi-tv&_nc_oc=AdoUb1n1Mp4ks9fTSVDGFhkOIjabkgR2Ygc8qoVazBmV-JzUMQ9xlIN4fJznAmrWa3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QBxTONVi4Np4ZkT7NArm-YWUdp4NXiY9jBt3KRb35-A&oe=6A2D7047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Field_16x9.png", "id": "1520808819769314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_1520808823102647_9084357811865592576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O05fwUqrNSEQ7kNvwGYazwr&_nc_oc=AdqqheY89i19RzUHr5WctuOb-Z2Bdo8hmyDW5mAwqnni-SV9zTULo1ATwz-971ckobs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_addOiG5vi7yuLEW-CkIsYycFmS_yw301JKh5LuyU4Sw&oe=6A2D7733"}, "display_name": "Husker STEM VR", "keywords": ["Husker", "Engineer", "STEM", "Computing", "Robots"], "long_description": "The Husker STEM VR project is an outreach/recruitment app being built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment. Students are building a virtual reality Oculus Quest app for UNL's School of Computing and College of Engineering to encourage STEM outreach. This app will help to make learning fun by creating a virtual reality app designed to create an engaging learning environment. Additionally, we can promote more diversity in STEM by creating an educational environment that promotes inclusiveness.\nSTEM Activities:\n- Computer Science\n- Computer Engineering\n- Software Engineering\n- Electrical Engineering\n- Chemical Engineering\n- Mechanical Engineering\n- Robotics Engineering \n- Civil Engineering\n- Biological Systems Engineering\nFor more information:\nhttps:// www.huskerstemvr.com ", "short_description": "Learn about STEM majors at the University of Nebraska - Lincoln through a fun, interactive experience! The Husker STEM VR project is an outreach/recruitment app built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jfalkinburg.github.io/huskerstemvr_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska - Lincoln School of Computing", "support_website_url": null, "website_url": "https://www.huskerstemvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27297304903290486"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_848878471563114_5516133272708463697_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UII4tj9_ecEQ7kNvwHyjpAC&_nc_oc=Adq_kUlzI8kgeHVspVMA0HNBgLrKPJo6
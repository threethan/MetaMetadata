E0D579"}, {"file_name": "Drone_in_Memorial_Stadium.png", "id": "1413531007113951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1413531010447284_6509542025368196577_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dHOMOjKQEsQ7kNvwHQziyZ&_nc_oc=AdoTv6WKotPCdgrlUeoUL0uEwvVOEBtqG7lgY9Xjr9u5c2_f1c3_QjqLlGOEHdPxQbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SL3y6llZi4xjGG8l9G8c9XALQjtMOMarD2qyqjJ0BFA&oe=69E0D37B"}, {"file_name": "Kiewit_Hall.png", "id": "2370655443411697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_2370655446745030_2092105872958025947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKLfaB49NN0Q7kNvwGGDz6Y&_nc_oc=Adqy7nuR_QgNLf0jcwOa7sgyjdiRj2hdieH-c1Tj4h6kyqnaaVPKdO2koMVxnW8G3LI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MQFA3EB6aKB1ZXo6q9lQXDgEZCZfG9WuB4aziICfhPg&oe=69E0F947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Field_16x9.png", "id": "1520808819769314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_1520808823102647_9084357811865592576_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0L-LQJp7MoQ7kNvwEBdhXR&_nc_oc=AdoU7-r4kQ9PWIQ1PMEahgb6HbKhtQt2PumX0RAlJxkvnZU-_nVe0J6FAQVO01xausM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kFZZ_7mXC7sAHk0NbQg78D2fQAwZF_hqA8QY24McJBQ&oe=69E0C7F3"}, "display_name": "Husker STEM VR", "keywords": ["Husker", "Engineer", "STEM", "Computing", "Robots"], "long_description": "The Husker STEM VR project is an outreach/recruitment app being built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment. Students are building a virtual reality Oculus Quest app for UNL's School of Computing and College of Engineering to encourage STEM outreach. This app will help to make learning fun by creating a virtual reality app designed to create an engaging learning environment. Additionally, we can promote more diversity in STEM by creating an educational environment that promotes inclusiveness.\nSTEM Activities:\n- Computer Science\n- Computer Engineering\n- Software Engineering\n- Electrical Engineering\n- Chemical Engineering\n- Mechanical Engineering\n- Robotics Engineering \n- Civil Engineering\n- Biological Systems Engineering\nFor more information:\nhttps:// www.huskerstemvr.com ", "short_description": "Learn about STEM majors at the University of Nebraska - Lincoln through a fun, interactive experience! The Husker STEM VR project is an outreach/recruitment app built for the Oculus Quest, iOS, Android, and Web App to creating a fun and engaging learning environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huskerstemvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "University of Nebraska - Lincoln School of Computing", "support_website_url": null, "website_url": "https://www.huskerstemvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26632596976427952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_848878471563114_5516133272708463697_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcJCQL0735cQ7kNvwH53A7k&_nc_oc=Adqnwx6adinirSRbx6bKq_VPxEqoR2OklrPOnWpfQB0NQ3siS8Vy_
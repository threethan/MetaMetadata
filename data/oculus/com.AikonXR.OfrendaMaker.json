wSiQrYEgx4iuq3kW4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaBPr-2A-VeRkUxnrBACmHXlrVD2PZugj6vHmiCKCXg&oe=6B01BAF2"}, {"file_name": "SCS3.png", "id": "831584875947435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822823_831584882614101_3608592478564703742_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeSIENxWb5YQ7kNvwHVGxES&_nc_oc=AdqGBBrE__DuF0qx3U_5tFEdh6N2YqtSkURKcxOW-xs84j_6a5YvUnYCVd2nzZF1PxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRJUQJ8EVgM2TxPS1qcH_FFSzKD7FAwhd6k3yPdYxiNg&oe=6B01E9E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ofrenda Maker", "keywords": ["maker", "ofrenda", "builder", "construction"], "long_description": "Use your own hands to build an authentic Mexican offering. The more meaningful elements you place on it, the more points you'll earn, but the real reward is creating an altar full of color, tradition, and soul. Every candle, flower, photograph, and offering you add brings you closer to the maximum score. Don't leave anything behind, your creativity and dedication are the keys to impressing those who receive this tribute. Craft it with care, build it with heart, and unlock the highest honor. Are you ready to create an offering that no one will forget?!", "short_description": "Use your hands to build a Mexican offering. The more elements you add, the more points you will get. Make sure to achieve the maximum score.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aikonxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "AikonXR", "support_website_url": null, "website_url": "https://aikonxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type
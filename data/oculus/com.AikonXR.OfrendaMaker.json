25/491822823_831584882614101_3608592478564703742_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh16L8ZoeXIQ7kNvwFbcfiQ&_nc_oc=AdqaWmkBxpcBSnM6ARwuoZkJ7B6cPkH7ada140hgDl02x55NCw4u6tisdHL3U778I0U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhGABuiWc1UipJCLTdVAimXxLT0m74-3oLQlM3OuGEig&oe=6AA95D26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ofrenda Maker", "keywords": ["maker", "ofrenda", "builder", "construction"], "long_description": "Use your own hands to build an authentic Mexican offering. The more meaningful elements you place on it, the more points you'll earn, but the real reward is creating an altar full of color, tradition, and soul. Every candle, flower, photograph, and offering you add brings you closer to the maximum score. Don't leave anything behind, your creativity and dedication are the keys to impressing those who receive this tribute. Craft it with care, build it with heart, and unlock the highest honor. Are you ready to create an offering that no one will forget?!", "short_description": "Use your hands to build a Mexican offering. The more elements you add, the more points you will get. Make sure to achieve the maximum score.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aikonxr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "AikonXR", "support_website_url": null, "website_url": "https://aikonxr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
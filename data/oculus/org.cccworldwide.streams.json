DDRgQ7kNvwHGfVPY&_nc_oc=AdrT2RZAlzt4mTRL5gqEC9Pi6-f-RazH9bpdEXv9e13105qZjBnmFnS7JjSiLYIGm-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7KC8ZFL_GGNXI6rc9SKXPObqPhWFti-rOr3I7GX_Isg&oe=6AE9E8A3"}, {"file_name": "final-screenshot-2.png", "id": "1149466691363056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673773677_1149466694696389_899233623019254684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB_sW1G8i6sQ7kNvwH7eHSP&_nc_oc=AdoJ4kAVMew3mL4zF8DMXF3WsuaPYFqCHtuTgyexXdi7kWlB69hDSrCbhFehoLbSmp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCz5_flL6pFn9OGDwpoClxPH-SIvowP69DK_hiyfsqkA&oe=6AE9FD1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Celestial Worldwide Livestream", "keywords": ["church", "worship", "sermon", "gospel", "livestream"], "long_description": "Celestial Worldwide Livestream brings Celestial Church of Christ (CCC) Worldwide services to your Meta Quest, on a large screen wherever you are.\n\nThe app opens straight into whatever is on air:\n- Live service: Sunday and weekday services, revivals, conventions and special programmes as they happen\n- Studio 2: live programmes from the CCC Worldwide Community Hub studio\n- CCC Worldwide 24/7: past services, sermons and hymns around the clock\n\nWhen a service is live it plays straight away. Between services the 24/7 channel plays. Tap the picture to show the title and player controls; when more than one channel is on, buttons let you switch between them.\n\n- No sign-in or account needed\n- No ads and no purchases\n- Resizable window: watch big while you relax, or small next to other apps\n\nCelestial Worldwide Livestream is the official player of the Celestial Church of Christ Worldwide Community, a church in Chicago, Illinois. More at ccc-worldwide.org.", "short_description": "Watch Celestial Church of Christ (CCC) Worldwide services live in VR. The app plays whatever is on air: the live service, Studio 2 and the CCC Worldwide 24/7 channel of past services, sermons and hymns. No sign-in needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ccc-worldwide.org/privacy-policy/#our-apps", "developer_terms_of_service_url": "https://ccc-worldwide.org/terms-of-service/", "publisher_name": "Celestial Church of Christ Worldwide", "support_website_url": "https://ccc-worldwide.org/contact/", "website_url": "https://ccc-worldwide.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403087012884889"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593727470_1166560522601760_8605023276718423326_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ2lzST04pYQ7kNvwEjIfLZ&_nc_oc=AdqYJA7I9GVbENX5Dzjiy7u1sjT7Pu5MMswPePJGKfD632OPVDbh87BL2GCY9AtAptI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcJQletGCWE0-uhsuLDLzLgOdmtJNBGX0v4EILizb1HA&oe=6AEA04A4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Celestial Worldwide Livestream", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Events", "id": "2687655338230691"}, {"topic_name
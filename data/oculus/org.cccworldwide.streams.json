tle and player controls; when more than one channel is on, buttons let you switch between them.\n\n- No sign-in or account needed\n- No ads and no purchases\n- Resizable window: watch big while you relax, or small next to other apps\n\nCelestial Worldwide Livestream is the official player of the Celestial Church of Christ Worldwide Community, a church in Chicago, Illinois. More at ccc-worldwide.org.", "short_description": "Watch Celestial Church of Christ (CCC) Worldwide services live in VR. The app plays whatever is on air: the live service, Studio 2 and the CCC Worldwide 24/7 channel of past services, sermons and hymns. No sign-in needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ccc-worldwide.org/privacy-policy/#our-apps", "developer_terms_of_service_url": "https://ccc-worldwide.org/terms-of-service/", "publisher_name": "Celestial Church of Christ Worldwide", "support_website_url": "https://ccc-worldwide.org/contact/", "website_url": "https://ccc-worldwide.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403087012884889"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1595741708907978"}]}, "baseline_offer": {"id": "1595741708907978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793298840, "status": "PUBLISHED", 
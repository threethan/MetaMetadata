CeRNsAeafJ5tgjJsFL3Yw_evIXnhAFTM37R09Tjw&oe=6A98469F"}, {"file_name": "screenshot-03-2560x1440.png", "id": "1634906030936182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620429_1634906034269515_5715550309398040045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=purhjFUDKjEQ7kNvwH0xDpr&_nc_oc=AdpoKNuHHOitoSAcMuMgFwbV7gePG8V4OVJhSFixdS_Sxm04e9NK143XuG-VMCvpGNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5vzTIG-4hgdZ9SEcC1i6G-LBe0ET9DB38pWKNIjrvbg&oe=6A986647"}, {"file_name": "screenshot-02-2560x1440.png", "id": "36686332714344533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_36686332717677866_6541508153723797967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHLJ5HTJ0LMQ7kNvwHECP4G&_nc_oc=AdobjnvvD9zyS9OQqIUM-vfsOLaYURZZKew8YOE8jbylmTCyxarp0x3moALVOQG2fi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgft18aVPhl3yOOOt9kBrN5R7CFPzB80qXxSUi3AMw9w&oe=6A983528"}, {"file_name": "screenshot-04-2560x1440.png", "id": "1718461369479341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619078_1718461372812674_1837457305565319555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxlhkG1p7LgQ7kNvwFjM0vn&_nc_oc=AdoW62uGXX6Pr4t__rp6Fr6KP3Nx1QX5JoBTCVL7jfYeEWFeWTqSJxgzTvvteTfxQmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxdXijU7y8JDjOmP16MMH4PKWyCoU_1zNr6mPehuvqFA&oe=6A98359A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Amblyopunch_PDP_Cover_2560x1440.png", "id": "1681200539653003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_1681200542986336_3341731286883225861_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nro4UExFgGMQ7kNvwEW51Cn&_nc_oc=AdoEpf3p2m8y4fkOuCAc56DYnsdpen2LRga-NStY2w7G8-2mL2xv2e5hqMsYVHDp6ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRZQY3tE3xcETu2pBHm65jafo9dWaEv2NidT_AtKbIdg&oe=6A985C16"}, "display_name": "AmblyoPunch", "keywords": ["lazyeye", "amblyopia", "visiontraining", "strabismus", "binocularvision"], "long_description": "# Amblyopunch: VR Vision Therapy Game for people with Ambloyopia\n\nAmblyopunch is a **Meta Quest VR application** developed by Seven Sportz to rehabilitate **amblyopia**, or lazy eye. Unlike traditional patching that isolates the weak eye, this game  utilizes **dichoptic training** to teach both eyes to work as a coordinated team by a fun and engaging VR game\n{1077821367903035}\n\n\n# Core Game Mechanics\nThe app functions as an immersive 3D game where players engage in active visual training:\n- **Punching Gabor coins**: Targets use specific patterns to provide high-intensity stimulation to the brain's visual cortex.\n- **Dodging red spikes**: Users physically move or duck, which rehabilitates **hand-eye coordination** and depth perception.\n\nThe **Target Spawner** tracks player movement, adjusting target size and speed based on performance.\n\n\n# The 4-Stage Journey\nThe app follows a performance-gated path:\n1. **Monocular Warm-up**: Builds basic tracking using only the lazy eye.\n2. **Suppression Breaking**: Dims the dominant eye\u2019s view to prioritize the weak eye.\n3. **Binocular Rebalancing**: Gradually restores clarity to the dominant eye to equalize input.\n4. **Fusion Training**: Merges misaligned images within **Panum\u2019s fusion area** for 3D perception.\n\n\nThe app is meant for 13 years and above. Use as structured practice with breaks; not a substitute for professional care\n\n\n\n", "short_description": "Amblyopunch is a Meta Quest VR app by Seven Sportz for training amblyopia (lazy eye). Using dichoptic training, it teaches eyes to work together through four clinical stages: monocular warm-up, suppression breaking, rebalancing, and fusion. Users punch Gabor coins and dodge spikes to stimulate the visual cortex and improve coordination. The app adapts to condition severity and eye alignment of lazy eye, such as esotropia or exotropia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyovision.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyovision.com/legal/terms/", "publisher_name": "Amblyovision", "support_website_url": "https://www.amblyovision.com/contact/", "website_url": "https://www.amblyovision.com/products/amblyopunch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "fr", "de"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1266003946586376"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622214_1608653780787268_5371829472089239458_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkriKzCfQ1cQ7kNvwH0c3PI&_nc_oc=AdpUc7seWzDhO92nJxI78j3IHAoiTKSBF76UECXwmvQXoDQcmGDEK3j_4he3qHdtygs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQSkPDETfHXDXHCcdIR8nGyrLH7LQ2RH5WLrAN7nXiew&oe=6A983AB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AmblyoPunch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1783741920, "lastRevision": {"nodes": [{"id": "1239507495902688", "release_type": "SCHEDUL
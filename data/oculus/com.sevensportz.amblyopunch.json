450846430103_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvZnvv1HMr0Q7kNvwG7hkkP&_nc_oc=Ado7p07n3iyADz_Vs0Px4F0WRG87Ij5L99h5Hm08blzxGdupAiTAmUxbUsJnUtHmuEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc2cjLWwp_v8Gh1qtHiJ6aWKgih82o4GOiTM53WCLdZw&oe=6A98541E"}, {"file_name": "screenshot-07-2560x1440.png", "id": "989428170653419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604298355_989428173986752_1517988599429273351_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikZn9tkDAlEQ7kNvwF1h_r0&_nc_oc=AdqaGV7n9rWjUPrY2peJqj9NmigO1Obvkj1DYPGfHGwtgh84evW6rxL_lQ_6zdLmy40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINg3CeRNsAeafJ5tgjJsFL3Yw_evIXnhAFTM37R09Tjw&oe=6A98469F"}, {"file_name": "screenshot-03-2560x1440.png", "id": "1634906030936182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620429_1634906034269515_5715550309398040045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=purhjFUDKjEQ7kNvwH0xDpr&_nc_oc=AdpoKNuHHOitoSAcMuMgFwbV7gePG8V4OVJhSFixdS_Sxm04e9NK143XuG-VMCvpGNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5vzTIG-4hgdZ9SEcC1i6G-LBe0ET9DB38pWKNIjrvbg&oe=6A986647"}, {"file_name": "screenshot-02-2560x1440.png", "id": "36686332714344533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_36686332717677866_6541508153723797967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHLJ5HTJ0LMQ7kNvwHECP4G&_nc_oc=AdobjnvvD9zyS9OQqIUM-vfsOLaYURZZKew8YOE8jbylmTCyxarp0x3moALVOQG2fi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgft18aVPhl3yOOOt9kBrN5R7CFPzB80qXxSUi3AMw9w&oe=6A983528"}, {"file_name": "screenshot-04-2560x1440.png", "id": "1718461369479341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619078_1718461372812674_1837457305565319555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxlhkG1p7LgQ7kNvwFjM0vn&_nc_oc=AdoW62uGXX6Pr4t__rp6Fr6KP3Nx1QX5JoBTCVL7jfYeEWFeWTqSJxgzTvvteTfxQmc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxdXijU7y8JDjOmP16MMH4PKWyCoU_1zNr6mPehuvqFA&oe=6A98359A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AmblyoPunch", "keywords": ["lazyeye", "amblyopia", "visiontraining", "strabismus", "binocularvision"], "long_description": "# Amblyopunch: VR Vision Therapy Game for people with Ambloyopia\n\nAmblyopunch is a **Meta Quest VR application** developed by Seven Sportz to rehabilitate **amblyopia**, or lazy eye. Unlike traditional patching that isolates the weak eye, this game  utilizes **dichoptic training** to teach both eyes to work as a coordinated team by a fun and engaging VR game\n{1077821367903035}\n\n\n# Core Game Mechanics\nThe app functions as an immersive 3D game where players engage in active visual training:\n- **Punching Gabor coins**: Targets use specific patterns to provide high-intensity stimulation to the brain's visual cortex.\n- **Dodging red spikes**: Users physically move or duck, which rehabilitates **hand-eye coordination** and depth perception.\n\nThe **Target Spawner** tracks player movement, adjusting target size and speed based on performance.\n\n\n# The 4-Stage Journey\nThe app follows a performance-gated path:\n1. **Monocular Warm-up**: Builds basic tracking using only the lazy eye.\n2. **Suppression Breaking**: Dims the dominant eye\u2019s view to prioritize the weak eye.\n3. **Binocular Rebalancing**: Gradually restores clarity to the dominant eye to equalize input.\n4. **Fusion Training**: Merges misaligned images within **Panum\u2019s fusion area** for 3D perception.\n\n\nThe app is meant for 13 years and above. Use as structured practice with breaks; not a substitute for professional care\n\n\n\n", "short_description": "Amblyopunch is a Meta Quest VR app by Seven Sportz for training amblyopia (lazy eye). Using dichoptic training, it teaches eyes to work together through four clinical stages: monocular warm-up, suppression breaking, rebalancing, and fusion. Users punch Gabor coins and dodge spikes to stimulate the visual cortex and improve coordination. The app adapts to condition severity and eye alignment of lazy eye, such as esotropia or exotropia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyovision.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyovision.com/legal/terms/", "publisher_name": "Amblyovision", "support_website_url": "https://www.amblyovision.com/contact/", "website_url": "https://www.amblyovision.com/products/amblyopunch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "fr", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1239507492569355"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2119721185625865"}]}, "baseline_offer": {"id": "2119721185625865"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783741920, "status": "PUBLISHED", "id": "2119721185625865"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1280526928467411", "version": "1.0.1"}, "id": "1273347221328084", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239507485902689", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1280526928467411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1273347221328084"}]}, "change_log": "AmblyoPunch \u2014 Release Notes\r\nAlign Eyes\r\nNew Align Eyes therapy tool on the wall board.\r\nOptional self-report for eye turn (none / in / out), then a two-pass dichoptic test: white crosshair + red marker, roles swapped on pass 2.\r\nMove the marker with the left thumbstick, Confirm each pass, and save horizontal/vertical alignment.\r\nSaved offset is applied during training so targets sit closer to where your eyes fuse.\r\nRed & blue fists and swords\r\nHands and blades now share a clear color identity:\r\nRight = red\r\nLeft = blue\r\nFists show knuckle color rings; swords use matching blade colors.\r\nDual-wield swords are available from the start (same left/right color rules as fists).\r\nGameplay updates\r\nCoin targets carry a red or blue ring (lazy-eye channel) so the weaker eye must contribute.\r\nFists: punch with the matching hand \u2014 wrong color does not count.\r\nSwords: cut with the matching blade; many coins also show a direction arrow \u2014 slash that way to score.\r\nWrong color or wrong direction registers as a miss; dodge spike balls with your body as before.\r\nUpdated in-app tutorials explain the new color rules when you switch tools.\r\nReset All\r\nNew Reset All control on the start/quit action row under the therapy board.\r\nClears progress to first-run defaults: profile, scores, world unlocks, clinical history, alignment, and adaptive therapy metrics.\r\nUseful for a clean restart or shared-headset testing.\r\nTip: Run Align Eyes (and optionally Vision Check) before a session, pick Fists or Swords, then match red/blue rings for the best dichoptic practice.\r\n\r\nTraining insights only \u2014 not a medical diagnosis.", "created_date": 1784542177, "id": "1280526928467411", "version": "1.0.1", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239507485902689", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1280526928467411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1273347221328084"}]}, "change_log": "Increased size of buttons on wall menu for better readability", "created_date": 1783916311, "id": "1268896972963740", "version": "1.0.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239507485902689", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1280526928467411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1273347221328084"}]}, "change_log": "updated hand tracking for smoother clicks", "created_date": 1783865007, "id": "1267959136390857", "version": "1.0.1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239507485902689", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1280526928467411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1273347221328084"}]}, "change_log": "Improved hand pointing for menus\r\n\r\nWhen using hands, pointing at buttons is more stable. Closing a pinch to select no longer nudges the pointer off the button you were aiming at.", "created_date": 1783841072, "id": "1267474896439281", "version": "1.0.1", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239507485902689", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1280526928467411"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1273347221328084"}]}, "change_log": "AmblyoPunch \u2014 What\u2019s New\r\nVision Check (optional)\r\nYou can now run a short Vision Check from the wall menu before training.\r\n\r\nMeasures each eye and both eyes together using a clear letter chart in VR\r\nShows your results in simple terms and updates training difficulty when a check is complete\r\nFully optional \u2014 you can skip it and start an adventure anytime\r\nUses familiar controls (ray + pinch); voice answers are available where supported\r\nNote: Vision Check is a wellness training aid, not a medical diagnosis or eye exam. For clinical concerns, see an eye-care professional.\r\n\r\nAlso in this release\r\nTraining can adapt contrast based on how you\u2019re doing in-session\r\nStability and Quest comfort improvements for menus and setup", "created_date": 1783782443, "id": "1266403609879743", "version": "1.0.1", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
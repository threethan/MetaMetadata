iA3OAA8aEbQ1g9rD2tVGzXB_CF-hfW2QdRuIQtlx3pdkB2lr9TNpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW6pt4LnwAqqfqpDFUsQ6tAAoGmfzy9JUCveNX0_zsMQ&oe=6AECA69F"}, {"file_name": "screenshot-03-2560x1440.png", "id": "1634906030936182", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620429_1634906034269515_5715550309398040045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY2xWBwtn_4Q7kNvwFRlP7X&_nc_oc=AdphifTiPKjzxaGWGR0rft77F-LQaOjpeMAPJbC0cJEYhZJM9UNH2ko5iNYnv7fepVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW1DUfuwpSwzrew8dieX5Nf2TlpTFBmRtV21E6MtdGuw&oe=6AEC8E07"}, {"file_name": "screenshot-02-2560x1440.png", "id": "36686332714344533", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620817_36686332717677866_6541508153723797967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnMlRHbETG8Q7kNvwEVZItQ&_nc_oc=Adpx8iZvkAlcuTGeLDnK5Kq6UK38BLP8mBki4nJqULJTvz_-DU_T7utveHT7_NkUF4w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpzQiUb3I2CxVwVbCuJZMRiVNynmQ8dEWHbo-IYfnUcQ&oe=6AEC9528"}, {"file_name": "screenshot-04-2560x1440.png", "id": "1718461369479341", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619078_1718461372812674_1837457305565319555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzTWurVq4IcQ7kNvwGCtqeC&_nc_oc=AdpO8Wi87G0p3CoZ_H5BvQDaFR0wtQtUQTAD0XOkWEsYR3cwRPRH-talM6-v3klu23o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq8TSH6WMcYhR8hrANJJFl9a7lSj1Mw9rHrpPAcLBckQ&oe=6AEC959A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Amblyopunch_PDP_Cover_2560x1440.png", "id": "1681200539653003", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/618758916_1681200542986336_3341731286883225861_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETaQ03sFhJoQ7kNvwGqYRp-&_nc_oc=Adp-CNL49JtQ5OPnxzncbKPsa4psKodnRQQzfi6qTD1RtRr7_rdoVrEADFuRYKvsDi8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCERLKo__vxZ1Bn0J3txeUeIGVJgXaZKTuNdp9uKxxJw&oe=6AEC83D6"}, "display_name": "AmblyoPunch", "keywords": ["lazyeye", "amblyopia", "visiontraining", "strabismus", "binocularvision"], "long_description": "# Amblyopunch: VR Vision Therapy Game for people with Ambloyopia\n\nAmblyopunch is a **Meta Quest VR application** developed by Seven Sportz to rehabilitate **amblyopia**, or lazy eye. Unlike traditional patching that isolates the weak eye, this game  utilizes **dichoptic training** to teach both eyes to work as a coordinated team by a fun and engaging VR game\n{1077821367903035}\n\n\n# Core Game Mechanics\nThe app functions as an immersive 3D game where players engage in active visual training:\n- **Punching Gabor coins**: Targets use specific patterns to provide high-intensity stimulation to the brain's visual cortex.\n- **Dodging red spikes**: Users physically move or duck, which rehabilitates **hand-eye coordination** and depth perception.\n\nThe **Target Spawner** tracks player movement, adjusting target size and speed based on performance.\n\n\n# The 4-Stage Journey\nThe app follows a performance-gated path:\n1. **Monocular Warm-up**: Builds basic tracking using only the lazy eye.\n2. **Suppression Breaking**: Dims the dominant eye\u2019s view to prioritize the weak eye.\n3. **Binocular Rebalancing**: Gradually restores clarity to the dominant eye to equalize input.\n4. **Fusion Training**: Merges misaligned images within **Panum\u2019s fusion area** for 3D perception.\n\n\nThe app is meant for 13 years and above. Use as structured practice with breaks; not a substitute for professional care\n\n\n\n", "short_description": "Amblyopunch is a Meta Quest VR app by Seven Sportz for training amblyopia (lazy eye). Using dichoptic training, it teaches eyes to work together through four clinical stages: monocular warm-up, suppression breaking, rebalancing, and fusion. Users punch Gabor coins and dodge spikes to stimulate the visual cortex and improve coordination. The app adapts to condition severity and eye alignment of lazy eye, such as esotropia or exotropia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.amblyovision.com/legal/privacy/", "developer_terms_of_service_url": "https://www.amblyovision.com/legal/terms/", "publisher_name": "Amblyovision", "support_website_url": "https://www.amblyovision.com/contact/", "website_url": "https://www.amblyovision.com/products/amblyopunch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "ko", "fr", "de"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1266003946586376"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622214_1608653780787268_5371829472089239458_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxPx9kUm2nYQ7kNvwGjYVhy&_nc_oc=Adr7Cn_45VeqvO6F1st11SwGUoZiRDQlUKQeCf6S1VkCy084ttWcU8NJwAuGGVLWAqs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdK4bx7z1cJx2AQXrV1e1egkhkrEbQmO99RY-GnEo8Vg&oe=6AEC9AB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AmblyoPunch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "4
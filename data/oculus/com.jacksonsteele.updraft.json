ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626808_1634861725319984_7346626335156397262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGGycArx5KEQ7kNvwGucGzu&_nc_oc=AdrZeRKAu3AUdC0XKcpyPfj-h_oigC19OiM6j8wN3lIDO7q5ebJooIwLmB2O_t_0vy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2z8LTxgKUVxAnyo6t0aD2uZD5R_tVYSFTPNrbOxYGzg&oe=6B0DB088"}, {"file_name": "updraft-5.png", "id": "2191494224772325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/831531831_2191494228105658_4515268848979215989_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YFCE96exnwQ7kNvwEnUExe&_nc_oc=Adp2sp5jd6Gc49T0kxmR3T1YOu50FRnif8_k8Z8C5eTad9rOYrbGQOiisbEQW7VoPr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSR_HBp6KeXj5VH_LDSKEKG61jTU6evyDzO4I1JPLdHQw&oe=6B0DB165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "updraft-title.png", "id": "1496442715922959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619374_1496442719256292_1593125284786065656_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGgSrbOLzEYQ7kNvwG-Xy2J&_nc_oc=AdpMqwfSRoWMbuJ3eP0cRHeUvZilSmy9nN_RW14h4ZJpTD8D_U9I5g-vdhqRovFCcGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjIPEdXagvlBZY6Op5qrmKO0sVRu4o-0C1nSp31Hg6Nw&oe=6B0D9EC1"}, "display_name": "Updraft", "keywords": ["plane", "airplane", "flying", "flight", "casual"], "long_description": "Updraft is a little RC plane game for Quest 3 and 3S. You fly it around your actual room in mixed reality, using two flight sticks you grab with your hands. Tilt them to turn, climb, dive and speed up.\n\nIf you\u2019ve never flown anything before, start with First Flight. It walks you through one control at a time, and you can\u2019t crash while you\u2019re learning.\n\nAfter that there are nine levels out in the open sky. Each one is a trail of coins to follow, and they get harder as you go. The first few are easy. The last few have loops and corkscrews that took me a lot of tries.\n\nThere are also courses in your room. One of them is built from your Quest\u2019s room scan, so the coins end up around your furniture and up near your ceiling. Your walls and furniture count as obstacles, so if you hit the couch you start over.\n\nEvery course is timed and you can earn bronze, silver or gold. If you just want to mess around, Free Flight lets you fly around your room with no coins and no timer.", "short_description": "Fly a tiny RC plane around your real living room. Grab two flight sticks, chase coin trails through the open sky, and race for gold on courses built from your own walls and furniture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jacksonsteele.dev/updraft/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jackson Steele", "support_website_url": null, "website_url": "https://jacksonsteele.dev/updraft/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1451462104717291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593761155_1540339761575940_240296098255960202_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHBH_3kEJ58Q7kNvwGIDQ-r&_nc_oc=AdrKrYNUMLe9Km4RsIxpoCWeI03D
dEGpejmeYaFmR8g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG24bJEMQJAhlA_Wy1I1L8zz4IfFXdJDy-f_9g4ETp4Q&oe=6A65F0AA"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vto8oHwpLUwQ7kNvwHUXHur&_nc_oc=AdoRV38dD4cct4h0DeQ_biZ3xfyO-veVtonUBnRG1hdhvONoLA837vu6EVIU-wI4TmQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsTh_8jZaGlPkF56xMy6MO3CsK5yYl5kJ0td_u1fyj8Q&oe=6A660050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "egolf ab keyart pass1land.png", "id": "2077110656039018", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974876_2077110659372351_5802009972693226193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH2NMh-FkdgQ7kNvwGAhaNu&_nc_oc=AdqG8aprOBoSI6Bfu7S3mZoOTqundHzde_Q0o98Ro4IstkCR1HImSLrEkeuNacd6EO4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHwk839JyXn0kkGL9injBpoc-m1tU9P4ovvYm-2-F81A&oe=6A661D7E"}, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Multiplayer", "Survival"], "long_description": "#                                                                                                                                                                                                        \n{1143896187585540}\n# **Fight Off the Ridden**\nThe Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. \n\n{874210834178242}\n# **Upgrade and Customize**\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n{1223888265699744}\n# **Diverse and Immersive Maps**\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more!\n\n{1040387070873437}\n# **Epic Boss Battles**\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n{1432121080833086}\n# **Multiplayer Mayhem**\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. ", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on tons of maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "30405426185771008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75588061_408839462256933_1037721495971829759_n.png?stp=dst-
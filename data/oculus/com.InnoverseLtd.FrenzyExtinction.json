4.5771-25/75530717_1573146123274050_4310339754583532284_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RjKyXeg9iUQ7kNvwE2qefG&_nc_oc=Ado_GtysnL6JdqLlv5Bsh1OJb6S2Lx29dF_n0T4n-6JYDSau9pWWIovfiJ3-06yX-eE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F3eEBL_oZ1q7gbEX8a9q-BwLKXqZ8gKK1Fk9fMohPiA&oe=6A22EDAA"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ0kTlWinGEQ7kNvwGM1yVQ&_nc_oc=AdqDN3fu7UxidpbTUVOpC7RVPMj6tQCjyOzU4qb_3ZUx5ROKAPVcnVS3ZFsCDWr4sFE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HvL0XR_0eaPb7zIaQG-E5fo3W5GkfaToOd-c6z_jSkg&oe=6A22E6F0"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6jQlJYMFn0Q7kNvwHy5c63&_nc_oc=Adogat8EdeOq-AkEUFFECqTsOnNqNZs-23ECspHGVDtT0ShwF78cBPw3daI6nODiLDY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8COKbkj0Us0ZeSssBbRCAs-XGnSyT5XgMSZLCR0_F51g&oe=6A22D482"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5fFSasBGtEQ7kNvwHaF8yv&_nc_oc=Adr0sDF-D3q8NZ18g4pJHIThL9csHNMz0rvggMnmY7hCYil37D1oTW9FCfM9K8_RAR8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lpWbUfiPmew4oXkQ3ipKbAst6NBU7DwXU6lK5XctBng&oe=6A22FC10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": []
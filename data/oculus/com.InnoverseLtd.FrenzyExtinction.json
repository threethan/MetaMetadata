1.oculuscdn.com/v/t64.5771-25/75530717_1573146123274050_4310339754583532284_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lITSGZDeeKkQ7kNvwF4wVXw&_nc_oc=AdoLb_7ljplgm-8bFhVZYKDBrh3p51ICKsN9kbKRFfQGACjcEXtjmGNWLCgcF8rEMM8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzcudOYoBrpXVP71BhkkdqDKG6X7pFP-8k-SATMy1C_g&oe=6A8ED06A"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72BugvtDhOsQ7kNvwGg_Tp9&_nc_oc=AdpQjf7Sw7Qf6nc3jNPVMnALVuhLRQ7NkwwV_X61wZ_9mBa5ZFLWu3mBblFpYvBYXkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyKjrlacxhPC_Z2Jp5XFVpETlmyWCnlO5ayZmfYdQ4WA&oe=6A8EC9B0"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32AhTlZOEKIQ7kNvwEGZoe2&_nc_oc=AdpA_by5bDIedbfatGpfE0F864jC8Dg_5UO7SPTI2tJsGO_rXYrbQ9TXyZrbE2RzU5I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdCxo3q5rsFqbpcJUnikx_quRB39nRPh9s5H9ZliuDgQ&oe=6A8EEF82"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLcu2cZAQasQ7kNvwF6ptPh&_nc_oc=Adq7NnrFCYa-tjBdCzaSq0yCdeJKMSMWogu1aocJDYq02HnbonFhXJtMLZ1D7Rd5xWc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQYzXyivxZzik1OnQD7ymOtITSPofVg0IW22mpQG50A&oe=6A8EDED0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", 
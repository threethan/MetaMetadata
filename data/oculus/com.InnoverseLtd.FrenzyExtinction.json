_395550319741785_222760401454065762_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi4I0qdfIv8Q7kNvwEFTyTC&_nc_oc=AdrYr7NfiIzcmDMDNBrhGxo06qGAriOad2Y2OLX-P80CMZ4D_kvCvTvtLaj5j1FyAvs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSitffho8-7JmbfaEnJ2x6g-3ApGaE7aq_CtDRvhK4wwg&oe=6B0B3F63"}]}, "id": "942445960664195", "locale": "en_US", "screenshots": [{"file_name": "ss5.png", "id": "477555264958134", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375751_477555268291467_2374736760519112248_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZiFET1hpQsQ7kNvwHX7UyU&_nc_oc=AdojHmXOM2NwfL-Wk6QmXKjBFyeWhsqgYudFEHgGGRfpRSZGntckJC5Owa8aO512MqE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwcYw95vcYC0_xKd_nTn_zPCK2hfkkzVVU38RFgTI4lQ&oe=6B0B2722"}, {"file_name": "fess2.png", "id": "1573146119940717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75530717_1573146123274050_4310339754583532284_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_urFhKyQIIgQ7kNvwG9wyT2&_nc_oc=AdrCs5u4X-i9g7HolrpQ6h7KcyqTPoxJ-Dpe-EwhpxIKBEDcMlF_kJMVak3A4BntsFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJTFL8oRq52aCKjxqS3Z_7gdYbcPorM2ajecf_L4FYOA&oe=6B0B2DEA"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t2rkNzG84oQ7kNvwEBSO2O&_nc_oc=AdpDCSqMR_iwfype6zhMg8Cn8vx3Qkgujl1wZ8GdsWgTv36yQkPhPPKuo8fDnVHn7Q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxleAfS15jjtPMlTsQRTU3MPyTVnC_NhVtBwnsgq2lIQ&oe=6B0B2730"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHzBkz5Dc9MQ7kNvwHpKByw&_nc_oc=AdrtobNie-ZfzNVfUp1_npDVILG_tQmIQ0j68iLCTqO7r_jv8RkDPSMd7pXdy-3qA6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZ72wMP8ir8912nMTv9vjnxEKangxP5vEl6tH3UZZiXg&oe=6B0B14C2"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cieM2PBwbv4Q7kNvwEM0-Y7&_nc_oc=Adr3BlqWmDQZK8DfbkUVdyL1nVYaBQ0tLHkaRUxV5mzP2zRFRXUfEzj9hxGkb-tpzjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoT0CQl42Ii7gAxWqvVPTLPpw1BoRvZsE6KcFoG01OHw&oe=6B0B3C50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25176949395285406"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1842780237039263"}, {"status": "PUBLISHED", "id": "1018121754585316"}, {"status": "PUBLISHED", "id": "1396199225673803"}, {"stat
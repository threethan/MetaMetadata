file_name": "fess2.png", "id": "1573146119940717", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75530717_1573146123274050_4310339754583532284_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT274lJpj4kQ7kNvwHlva_p&_nc_oc=AdrZjh4HGYM_1EiKAkM5ENnS49e3WB9I5DKoD9BPrwqSIOEVEcg5NdxS7aUql2loMzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6DtWxBohoG1ZgNpNlMQZLhvHqCYj5gU_EbMjCURcCEg&oe=69C3C96A"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exrOWhQ7uxwQ7kNvwHUtu82&_nc_oc=AdoOtVjLkloHS9Ym8nskAHGUMqhUMOOVQPQ3tiVqTz3OBXaf9uhf8h7Unlmi5eg2zKY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyubn9j0hplCfZXsQ6iIEl6JNE8DK4-LtxT-n9I-YYXw&oe=69C3C2B0"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWeUFqAaUJkQ7kNvwHq_Nlb&_nc_oc=AdrgZtRH1lg-C2YpJP_J3rJnMKoQXy86tgyotDFvlVuPNBuN4QyCE-NXGwVUHSYpSqw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcxsIBWpQcHhUaybXVM89Ah8ZC9hj-qkT-IfJS7cbdHg&oe=69C3E882"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjXahOJH6UIQ7kNvwHFQQaE&_nc_oc=AdoIGVVpPLRPD4TuRE_olQvL0zcnDsNo7ZmRpSay3HJGsmOevjZy2ONKzVbDVgeLUaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1Yoc3K0I5wu5qkWOzLPIjvHyO3FDbwePo3VM4vQK80A&oe=69C3D7D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25176949395285406"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "831724333259293"}, {"status": "PUBLISHED", "id": "2466738487103428"}, {"status": "PUBLISHED", "id": "843126365264105"}, {"status": "PUBLISHED", "id": "1199590038761753"}, {"status": "PUBLISHED", "id": "1352257429942499"}, {"status": "PUBLISHED", "id": "1237628294697556"}, {"status": "PUBLISHED", "id": "687408730560022"}, {"status": "PUBLISHED", "id": "1177880277126771"}, {"status": "PUBLISHED", "id": "1597355591146191"}, {"status": "PUBLISHED", "id": "1290047835663564"}, {"status": "PUBLISHED", "id": "1268987520902727"}, {"status": "CANCELLED", "id": "583068977437434"}, {"status": "PUBLISHED", "id": "902316485100750"}, {"status": "PUBLISHED", "id": "1022719439342451"}]}, "baseline_offer": {"id": "1268987520902727"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "831724333259293"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27806984305615222", "version": "37"}, "id": "436360922199966", "channel_name": "LIVE"}]}, "is_for_oculus_key
9A57030"}, {"file_name": "Overpass.png", "id": "790022673361050", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310739_790022680027716_5626696771335008739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlZltmhuob0Q7kNvwFlvlhb&_nc_oc=AdnIlQ6EYqCeWAFQ07_NJsu2VwGUNDyiycMH6_BlTQjndxlMfYNhEJoPdDpoZ4lD_20&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuiJTGQ5RN7288y9pbQWPeo_UUuj7zSr9kvQnu1lOxyjQ&oe=69A575AA"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4z8p0rudTwQ7kNvwGai2wY&_nc_oc=AdmUJxKBwF4VjKh4VlrjF8NkBFWs4RFJsMtku5PAEcluDzcIj9z_h_jhm1J8CFABllQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvvflf0tYq-RSJafd1mnfj-j7AsD8n3dpRi6yDJP8gUzg&oe=69A58550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "egolf ab keyart pass1land.png", "id": "2077110656039018", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_2077110659372351_5802009972693226193_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVlsyQr662oQ7kNvwH9ZLbu&_nc_oc=AdlW5XyZTxARodqztlqMDGC_MyCyet7R3XLVuR4ZOhwvf_RWrwfBMHJ3vVIwbjsafFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsbNh_BqqQhbNpLlr2MB_32Sx2iLRHLd6jM2874HrcQHw&oe=69A56A3E"}, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Multiplayer", "Survival"], "long_description": "#                                                                                                                                                                                                        \n{1143896187585540}\n# **Fight Off the Ridden**\nThe Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. \n\n{874210834178242}\n# **Upgrade and Customize**\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n{1223888265699744}\n# **Diverse and Immersive Maps**\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more!\n\n{1040387070873437}\n# **Epic Boss Battles**\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n{1432121080833086}\n# **Multiplayer Mayhem**\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. ", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on tons of maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [
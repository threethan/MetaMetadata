-7&_nc_sid=6e7a0a&_nc_ohc=bwuleq6NUN0Q7kNvwH4FM3H&_nc_oc=AdkAP6lbOJ8IyMEkxAui0MzTKVGFB1Jq9dI0i_nuhUztlZsJR3U3gbDyYpAMo8_op3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsr-kGTCQZGFwJ8IagjV1ujx7Gl6qOkKnf5Scy0ijEzYw&oe=69A6C86A"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFIFL8EBZ2MQ7kNvwGysn6G&_nc_oc=AdkL_cWge8DOEXKc3r1x1azQsOiod-AkkUgjkUPUyKMd3Pmu_mx0-tJNrkJXQNOuVew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfYh6XhK0tPx95wSchTa-FdOXVZeqOK09BxtljK0MH8Q&oe=69A6C1B0"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLIsEmfZZLEQ7kNvwFQB1Rc&_nc_oc=AdkxoKFvCVdmnBnMmErVCjykgofABwcZwRaJJGeuljCj1dedJoYSSTDOknUoS3xWVYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsoUZa1GkBwGu6btPC4_wyhqDMBVhkWtAQTs61hNEdNVw&oe=69A6E782"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4z8p0rudTwQ7kNvwFn9p1C&_nc_oc=AdkBRQ0OIzjJ_Pqyqo7_K94iSoTv-uxHLJCYMmpYW3b8w4dY-bPzPkQTIMxcsK2meuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-ildxJlizg1A9iQWVUlS7OMZXQqmBUtPAa_sUbao9Pw&oe=69A6D6D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "37
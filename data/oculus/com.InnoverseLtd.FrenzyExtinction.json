hSv0A&oe=6AA95FE2"}, {"file_name": "fess2.png", "id": "1573146119940717", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75530717_1573146123274050_4310339754583532284_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilEPxM3SFZoQ7kNvwHV4ndW&_nc_oc=Adrqp6y0M-Daird4vSOx1PFjhozZ88swIZNRDUoHLRgNwfBGt3GlSbVcpMboglYSBNE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTY7hlVP0N1Uu5hX6kvukKIuMUwTuyPTT1fG0-o8CYlg&oe=6AA966AA"}, {"file_name": "ss1.png", "id": "474136575300959", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982676_474136578634292_2367709692022450363_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBJzhZoo_YwQ7kNvwE3dRfE&_nc_oc=Adp9frTRHRPiB8NHWBJiDTGbtXLMsSm6mf63jMO6yEBSj_E7PCZRJ0QIsRFYXvfV6WE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh5iRJ9kc02qkOBbW-VcJxfh2jiY_uF80qwW3G6EInUw&oe=6AA95FF0"}, {"file_name": "fess3.png", "id": "832451812223411", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982491_832451815556744_6666122954197467457_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY80isaeb9cQ7kNvwFQxWXM&_nc_oc=AdqHwx8pc9FLJu19JZIroCT4JiI463vKm3wg51xmP6e6-78n4Y29VJ0IB7GTYZqIHJg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsmqgNrHBFq-JLKXjmkra31IruzWXOcP_PRh3i-4mTsQ&oe=6AA94D82"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUw4Fh2JOWcQ7kNvwH0Z4Sc&_nc_oc=AdrnBNtrAk7cJuKFh7oQ-FMe9fRUADPnwPp5KzakA3QY1o9ARg0_KPJEy4fcsimJ30A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH3XrVhF-eWchZGWz-u_Vy0ENCR2Ib8lImB-xi3YeSpg&oe=6AA93CD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Extinction"], "long_description": "The Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. Immerse yourself in a fast-paced, action-packed VR experience where survival hinges on your ability to adapt, upgrade, and overpower relentless enemies.\n{884670816818563}\n# Key Features:\n**Intense Horde Survival Gameplay**\n\nEngage in thrilling, physics-based combat against waves of mutated monsters. Each enemy is designed with unique abilities and behaviors, keeping you on your toes as you fight for survival.\n\n**Upgrade and Customize**\n\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n**Diverse and Immersive Maps**\n\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more! \n\n**Epic Boss Battles**\n\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n**Multiplayer Mayhem**\n\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. \n\n**Progression and Customization**\n\nGather scrap, a permanent currency, to unlock new weapons and upgrades at your home base. Persistently enhance your character across play sessions, becoming stronger and more versatile with each run.\n\n", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on 10 maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "web
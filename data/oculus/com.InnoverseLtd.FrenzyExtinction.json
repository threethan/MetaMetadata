Qjx68EQ7kNvwH07lJL&_nc_oc=AdqXXqPyKk3v-TmY0FMETTKVizDi4S8I3rtTs8fdVK_l1T_xy3t5v5LhdbwldmmS29o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSk8Rz8iJk7RAKR2ygMgrD8s4JN7dFQXtk1IPcO0ZYcQ&oe=6B1034F0"}, {"file_name": "Overpass.png", "id": "790022673361050", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310739_790022680027716_5626696771335008739_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SCLdGsuNVAQ7kNvwGlYAuJ&_nc_oc=Ado-piEgZn99Iy3dbFOUiNgkKdu1tYIYS-b7blWpLJ13UZjauNFTD1DHCOhkissKRtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOpRaq7mGa63w9Au3GWSssTXUONbNTrE9EE4sIp4L6ww&oe=6B103A6A"}, {"file_name": "fess4.png", "id": "937590288172907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75608442_937590291506240_1781024231375164692_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z3184mF9nsQ7kNvwHLcx41&_nc_oc=AdpA2xLLJPksJ0FDbnlA5R-Hmf0XIGmXjtluCIcSU8aHgf1iAHl84R5DE0sjg8wprUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXB3Ql6V2nVJCG1jDAFi6lm6R4-dcnN9mISGNgGReANww&oe=6B104A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "egolf ab keyart pass1land.png", "id": "2077110656039018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_2077110659372351_5802009972693226193_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h9lCGU-VRAQ7kNvwEP7gc6&_nc_oc=Ado3-JP7bhR8iQyYhcL-YojgvjwjCMkdbUBFWhdi1O7PiBXAcaKMeA87C99NhbhnMqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6_pAbf0BpIlEPL5Fbl09w530LgEy-mdgt_X8efnbF1g&oe=6B10673E"}, "display_name": "Frenzy Extinction", "keywords": ["Frenzy", "Zombies", "Shooter", "Multiplayer", "Survival"], "long_description": "#                                                                                                                                                                                                        \n{1143896187585540}\n# **Fight Off the Ridden**\nThe Frenzy Virus has mutated, unleashing a new wave of chaos. You and your team must now confront hordes of \"The Ridden\" in Frenzy Extinction. \n\n{874210834178242}\n# **Upgrade and Customize**\nCollect Necronium from defeated enemies to upgrade your gear, unlock new areas, and enhance your abilities with powerful perks. \n\n{1223888265699744}\n# **Diverse and Immersive Maps**\nExplore 10 maps, each with its own atmosphere and challenges. Survive in desolate cities, eerie forests, and more!\n\n{1040387070873437}\n# **Epic Boss Battles**\nFace off against formidable bosses throughout each map. These fights will test your skills and teamwork as you survive their special abilities. \n\n{1432121080833086}\n# **Multiplayer Mayhem**\nTeam up with up to 3 friends in seamless co-op multiplayer. Strategize and cooperate to defeat the hordes, share loot, and defeat the boss to extract. ", "short_description": "The Frenzy Virus has mutated. Now, you and your team must defeat hordes of \"The Ridden\" in Frenzy Extinction! Survive waves of mutated monsters as your team upgrades their gear, powers up with custom abilities, and races to extract after defeating the elite bosses. Using physics-based combat and dismemberment, take on tons of maps with 50+ unique weapons. "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": "http://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connecti
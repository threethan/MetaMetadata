56ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8-ZEWjN-FhJxWHuGfo44LRsnOy9KoZy--RyHRTbmkfA&oe=6A6DEC57"}, {"file_name": "Be A Vacuum 4.png", "id": "1499920478249082", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_1499920481582415_3891370836892953395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYEMRz5Xj0wQ7kNvwEkcAoD&_nc_oc=Adp138RBAEb5FAfd6Ea2A-hj71aM7DYP1dB1hvylqpfydv14mpCoifAyx3T40FY0bOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3obt0t8CQrD1ELPqAXcubWa-gJpzB7vtx9DEW_VqfAA&oe=6A6E0547"}, {"file_name": "Be A Vacuum 7.png", "id": "796123406625144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617719_796123409958477_6534286396876858588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaIYkDNi03cQ7kNvwFg18Hw&_nc_oc=AdoArbsl8UjPsAd8XQcH0wxUhtRxU9SPrU4tmGdKnaxBABtEpyir4Wv4X_c2KsLZxf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGBNJzKIucQXOqiEKENToXCeTaHUiq0FboouPud6uvag&oe=6A6E03E5"}, {"file_name": "Be A Vacuum 5.png", "id": "25828612653480296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_25828612656813629_8817952122205081524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJS0GnP_SSEQ7kNvwFkG0sZ&_nc_oc=AdpFjHpWG5pHelhZoZ77XrbHC_Iwsj1ytMhB9KUM598fVSwzUgjtJFf4-cGWSFgrivw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEW870mQBta9_slZLlqtjeRGfZjTu3qV8PXCAPnTnntA&oe=6A6DEDE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be A Vacuum", "keywords": ["Cleaner", "Simulator", "room", "job"], "long_description": "# Get Ready for a Chaotic Cleaning Adventure Like No Other in Be a Vacuum!\n\n**Messy Rooms, Clean Fun**\n\nControl your vacuum in a colorful, cartoon-styled home and suck up everything in your path! Explore rooms, clean up messes, and watch your vacuum\u2019s power grow.\n{1145823431940610}\n\n**Suck It Up, Toss It Around!**\n\nCollect everyday objects like fruits and toys with your vacuum, then launch them as projectiles! Aim at walls and windows to create chaos and have fun in your vibrant home environment.\n\n{941615682175361}\n\n**Tossing NPCs Into Chaos!**\n\nEngage in hilarious, physics-based mayhem as you use everyday items to toss and disrupt the environment! Watch as NPCs tumble and furniture flies in this slapstick-filled VR adventure.\n{1158960619643671}\n\n**Clean & Chaos!**\n\nGrab fruits, toys, and eggs with your vacuum, then launch them across the room! Watch as everything tumbles and creates hilarious, unpredictable chaos in the living room.\n\n{26538568815797349}", "short_description": "Welcome to Be a Vacuum, the most fun you'll ever have with a vacuum! Get ready for a chaotic, physics-driven VR adventure where you're not just cleaning \u2013 you're in control of the mess. Whether you're tackling cluttered rooms, wild mazes, or bizarre obstacle courses, your vacuum will be your best friend as you face challenges, collect items, and have a blast doing it!"}, {"images": {"nodes": []}, "id": "24759435527087741", "locale": "pt_PT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Vacuum", "keywords": [], "long_description": "Be a Vacuum", "short_description": "Be a Vacuum"}, {"images": {"nodes": []}, "id": "4426981007521455", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Vacuum", "keywords": [], "long_description": "Be a Vacuum", "short_description": "Be a Vacuum"}, {"images": {"nodes": []}, "id": "3005165389692756", "locale": "zh_HK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Vacuum", "keywords": [], "long_description": "Be a Vacuum", "short_description": "Be a Vacuum"}, {"images": {"nodes": []}, "id": "2324775238008540", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Vacuum", "keyw
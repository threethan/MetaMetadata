b9k-A-DQ&oe=6ACE54BE"}, {"file_name": "692557656_27503094039295560_6963330425273252625_n.png", "id": "2428042037681280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299745_2428042041014613_4411453780503813063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYM0gTYYuzwQ7kNvwFH0gvQ&_nc_oc=AdrTdEZjeGR8CveSZeMX0jdC0uNCRotX6NYRG91lQEYIkRaXe9GjsHbcX2JFILi_7bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2WdXB_1i-qwcAp_ECg1uZuLW_XSzSs93XIPJuBjG3Ug&oe=6ACE4EA4"}, {"file_name": "693432794_27040314778898641_9020610261563199894_n.png", "id": "1264787202381340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300661_1264787205714673_8337675991765499192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67vrjSINn5gQ7kNvwHJ8LSg&_nc_oc=Adr69ABsVezm5dJ3j-8rZeqCOjp9IIiCtk4qFVID-Yl6_vbeTqAnhYvY3yMcQiHxVeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdlqfIZe_2N1KWUU3LOTXT1Mf6EOmRjkRtglivRlMlyw&oe=6ACE38B2"}, {"file_name": "693365332_27053511974286217_8113084433579141861_n.png", "id": "1780866153279742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1780866156613075_5448946404167309312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2sbY_tfc_0Q7kNvwH_SZgL&_nc_oc=Adrr51zxOsW5d_XNgSJbrDre1E1oo5XYuUwbVd-L9Ii7ER4GlKaPpv8-1T2guRfgO7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdgZrTuWdYIF7qGAg7RmJWJAn4KbNwz-iwC5DdEn1RJg&oe=6ACE6315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Planet Voyager", "keywords": [], "long_description": "# Planet Voyager\n\n**Planet Voyager** is an immersive VR experience that lets users tour the planets of our solar system in a visually engaging and educational way.\n\nDesigned for exploration, discovery, and wonder, the app brings each planet to life with a guided space-tour feel, allowing users to experience the scale, beauty, and uniqueness of our planetary neighborhood from inside virtual reality.\n\nUsers can travel from planet to planet, view detailed planetary environments, and learn interesting facts along the way. Whether used for education, entertainment, or simply experiencing the solar system in a new way, **Planet Voyager** turns space exploration into an interactive journey.\n{990820583891622}", "short_description": "Planet Voyager takes you on an immersive VR tour through the planets of our solar system. Explore stunning planetary views, experience the scale of space, and discover fascinating facts as you journey from world to world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bradysbit.com/planet-voyager-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36606646758934538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_995961812805908_4187061900132185084_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hItQlStC38kQ7kNvwG9vIXU&_nc_oc=AdrUr5_ecIawT_EKffN86mgedFfd9-vcgQbf98yLd-NuyvV2JlDYRM3xLV8NE_gw-YA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvVxrjbGpZYZz4lrBI2U5W3sCGRr8HW8m4YdsJFjP4cw&oe=6ACE3809"}, "is_concept": false, "is_test": false, "is_
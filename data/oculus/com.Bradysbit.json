UTOTUdVw&oe=6A0B36BE"}, {"file_name": "692557656_27503094039295560_6963330425273252625_n.png", "id": "2428042037681280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299745_2428042041014613_4411453780503813063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_szsar-9PxsQ7kNvwEIszP5&_nc_oc=AdrADfh8G1X6AIXsK7S7nsOk6vhLnibvIs8lZHCcwMvN0Kmu4s431F7aLY8JlCGluKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7evzDuk5eqXruJ9B3AQPdnPJl9tZT46geuqtYlqfOCfw&oe=6A0B30A4"}, {"file_name": "693432794_27040314778898641_9020610261563199894_n.png", "id": "1264787202381340", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300661_1264787205714673_8337675991765499192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyp9F51xlZAQ7kNvwEXbjzb&_nc_oc=AdoiHxGnADOkGnBzT8X9a6H0G0lcyYct01cFL2I_3HZ25ECclNcdVkkxJlk0YDb1gUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zq-lZwssualmI2G1bntYf5VOWpETESiZdvGZNLAM9YA&oe=6A0B1AB2"}, {"file_name": "693365332_27053511974286217_8113084433579141861_n.png", "id": "1780866153279742", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299845_1780866156613075_5448946404167309312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj5mHubpLGgQ7kNvwFd9_yW&_nc_oc=Adp1rBIA0H4j3q_aLLYxtPzjiWlvDQEKsacz4J8K_Ag4s7kW5jsCftOwCiWGR-YW_d4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W09v24bpO19syxJdB0ZgJc0aimxnrBSEm9CYOb7SiFA&oe=6A0B0CD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Planet Voyager", "keywords": [], "long_description": "# Planet Voyager\n\n**Planet Voyager** is an immersive VR experience that lets users tour the planets of our solar system in a visually engaging and educational way.\n\nDesigned for exploration, discovery, and wonder, the app brings each planet to life with a guided space-tour feel, allowing users to experience the scale, beauty, and uniqueness of our planetary neighborhood from inside virtual reality.\n\nUsers can travel from planet to planet, view detailed planetary environments, and learn interesting facts along the way. Whether used for education, entertainment, or simply experiencing the solar system in a new way, **Planet Voyager** turns space exploration into an interactive journey.\n{990820583891622}", "short_description": "Planet Voyager takes you on an immersive VR tour through the planets of our solar system. Explore stunning planetary views, experience the scale of space, and discover fascinating facts as you journey from world to world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bradysbit.com/planet-voyager-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36606646758934538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299051_995961812805908_4187061900132185084_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIRlwfzB_MEQ7kNvwFxvjfJ&_nc_oc=Ado9AM3CRRvMQhOjK471HFRLron62T2yfeDQdeQoLJV9nTy9yW2a-PApQ1W_Ebm8eCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X8B2XIv4Xl9PESIaEtpCofNNvNXTfhgOro4DauuaFxA&oe=6A0B1A09"}, "is_concept": false, "is_test": false, "is_
hgEATHIw&oe=6A3FF2BE"}, {"file_name": "692557656_27503094039295560_6963330425273252625_n.png", "id": "2428042037681280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299745_2428042041014613_4411453780503813063_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTjM3Zu0HMoQ7kNvwEy-lfx&_nc_oc=Adoqpoqc72ekJFDuVxJEMQsQtlpVvkfjZbK3h2FU24wxR8UOqo6JOCY2BuPOe1mQxKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ON4zET_PUSIh5y1Vegkalr6hXS8QN3WUWkK2M9lAL4g&oe=6A3FECA4"}, {"file_name": "693432794_27040314778898641_9020610261563199894_n.png", "id": "1264787202381340", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300661_1264787205714673_8337675991765499192_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paeXxhOtMqUQ7kNvwGMKMHc&_nc_oc=AdrffZ0UGSZv25A63obKDl9StuhTeVfmy28KDzKbZNlLzRQ9y-HYhAwM-AboGuWaFUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af954FtPNedrHWtXwI1y_5fTJZkTAkuDQhbOpV07WhCZSA&oe=6A3FD6B2"}, {"file_name": "693365332_27053511974286217_8113084433579141861_n.png", "id": "1780866153279742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_1780866156613075_5448946404167309312_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pManXpa_V0IQ7kNvwH5VmJm&_nc_oc=Adr2jynVrJ_qzcDfv39t01P5hol9ryq2QoPEpYCsJ2pIdlh4HqN8xvWWAe8tt4vLWkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-63tuDti5pNajb-JVLNMs5Rx7PPfRaHM0ZrcgoVzlGQA&oe=6A3FC8D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Planet Voyager", "keywords": [], "long_description": "# Planet Voyager\n\n**Planet Voyager** is an immersive VR experience that lets users tour the planets of our solar system in a visually engaging and educational way.\n\nDesigned for exploration, discovery, and wonder, the app brings each planet to life with a guided space-tour feel, allowing users to experience the scale, beauty, and uniqueness of our planetary neighborhood from inside virtual reality.\n\nUsers can travel from planet to planet, view detailed planetary environments, and learn interesting facts along the way. Whether used for education, entertainment, or simply experiencing the solar system in a new way, **Planet Voyager** turns space exploration into an interactive journey.\n{990820583891622}", "short_description": "Planet Voyager takes you on an immersive VR tour through the planets of our solar system. Explore stunning planetary views, experience the scale of space, and discover fascinating facts as you journey from world to world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bradysbit.com/planet-voyager-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36606646758934538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_995961812805908_4187061900132185084_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-vAf0JYzlQQ7kNvwHV6G6r&_nc_oc=Adpm9Xz9X9fBYqJ4_V--nXURJiphAYQxnPDAMCPG5dib9yuwzAEQ106XMDaXoJJ7BJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5yfcdYAwTEYiYBiWAwrl6nV8wHYy1Jt9_JwwLx7fJgw&oe=6A3FD609"}, "is_concept": false, "is_test": false, "is_
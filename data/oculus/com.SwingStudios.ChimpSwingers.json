0a&_nc_ohc=qhXJv-iLBBIQ7kNvwGTfUDH&_nc_oc=AdnJF_HSXuUU80oOZzbzRUs7MPrGCd5HzHJECnFezge81-c6y1ovjI2aOS5972MFEHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-Zp2x4-Khu7var30VKESm8Qw3TmFi2du3S0j5j9Loaw&oe=69B7EA9B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vb83AwgD-JgQ7kNvwGCpq3_&_nc_oc=Adkyo5LAV6xhxUa3909FPqT3Os5OjAkIBRvwGrbEDYAI6gbV1wbndlzJ1g9O-fS7ASI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2ZXdyEoA02xnpukRu9_z9F3JBsF1EUaI71dleWcCP7w&oe=69B7DEFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/dyi
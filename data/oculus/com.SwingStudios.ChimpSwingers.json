771-25/473393491_3606319783009987_8458876917306594072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qOnCw4Ia-cQ7kNvwHFLq7x&_nc_oc=AdpMIl2A16pDFeITpjsBxqM0aEmmZzdXjgqMr6CUTBem09TCm6BI227hw0KprG8fWKY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6YnGYGfAeQfG53NACGzC9PoiIgG1I7NEamr9wjlUaDA&oe=69C2769B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9HO9qX4aeQQ7kNvwEktqRd&_nc_oc=AdoSSJrADl6GimXJ13fNKPbHPJrZzFtf-iJxqvzKjN2TJds0_foqcKm9aVWQp9-JJHI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXU_MTIF7IlepOy8J0Ob9uvW4FAekkq_QXBkU3DDqZTw&oe=69C26AFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publ
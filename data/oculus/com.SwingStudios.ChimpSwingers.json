0a&_nc_ohc=vINvjAjsALYQ7kNvwF43TPD&_nc_oc=AdmJkijz0W1pFlGxrTpPyaLNxjQ5BZ3lcSlN_DAjUMTWIjtjYQeerLlDwFQCr7E7cQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvyVoPSgppPH9tqqG2dC-Qnani5XwGlNg2hSSGcVRkjQ&oe=69B5479B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9tqOjSe2VsQ7kNvwFLr9dg&_nc_oc=AdlwyzaW_hTF1SjsLzBdFFZRKU9c069gjoH5oNrgmI_oeKrGVelHUfl8zJHRCxjqfp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx35jQUerkMq3EHaXgHhebDvbDiO3wIAVVQXoWT_iCxTw&oe=69B53BFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/dyi
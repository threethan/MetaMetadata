wingers V2_Custom..._05.04.2025_19-30-00.png", "id": "519716751190493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_519716754523826_1767316021766907892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln1O5-_G2W4Q7kNvwGuheQZ&_nc_oc=Adn5bdRIIT2yrs6bIuH5pPythj4Hw02t5ixkP39XsWWhxHda2GvszOCibGJgd0mcVBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv660N1lYd3i9uOGB3mZV7MScFgKSQ7O4b5NGzdn0pVSw&oe=69A6C6C3"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-23.png", "id": "1723875461876061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1723875465209394_4203548443581642061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u07xXBxtxWEQ7kNvwHTVFWx&_nc_oc=AdkSmo33rYftymlVNl6bIGNr5w7aZALBUt31IZ_7g5UB11skBcfT4d9lB-Im8dbyAX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPJrscPjVZTFX55z8mTbtq_6feeWvYkvRrSORnmDAijg&oe=69A6C175"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-41.png", "id": "1048765557097295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_1048765560430628_3383552754875951812_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2f-RAX-cDkQ7kNvwHdwdwE&_nc_oc=AdnFtEiZLiVzEOxGWVVFDUpGtyGwULnnVtpDvsEU_yr5WZU93POV606TfLvu3SmQBf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvI2ImOxFxCKV4FabnhxeU5evQVEWpVzFj51SIh8jJ_YA&oe=69A6CD53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "A new upcoming good game  variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/chimpswingersofficail/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpswingersofficail/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9468246076616430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1210225803976232_1225744860442128377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWXy7wJDdMQQ7kNvwGNev2X&_nc_oc=AdmC__Eq74AR5clo-ZZDH0XQdeGwDvVEhRb2F9A0MnhcPr_faFGv6y8nZAa3Y881j3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsce1Xo3AONt_DPMq2t83hLpcItD9swkmi7B4TAkhe5Hg&oe=69A6C860"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Swingers", "platform": "ANDROID_6DOF",
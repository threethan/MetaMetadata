0a&_nc_ohc=mE_PFsgyRL8Q7kNvwEfSxwm&_nc_oc=Adpk_wWNqj0BXEAugDlEItigexXJnhvGIfZ0tFTcvGE5h9UbePoq0CULQivWBm5WJ14&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoUObcIYK4X3bYsgukuECwX_C83KkPo_P_1vJ_dVFpWA&oe=69C1251B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9HO9qX4aeQQ7kNvwHnN9ow&_nc_oc=Adr4xM6erBnOia3Dj31jyASOYZ9tc2Dof2kxgOmfbdR8uNniW4aJhqFIxRchzre_u8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDpla2RTXjTf86oPBUU_YkT7HcJjZ9dF5fXt4DHRW1Hg&oe=69C1197A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/dyi
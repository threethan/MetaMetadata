771-25/473393491_3606319783009987_8458876917306594072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETwj1ws68fgQ7kNvwGFlasQ&_nc_oc=AdpeVBppDLEVb913mO5MYaew81w3GqSKoKx8gYFcjMHkxh6gaQq2Y1ZKB2xP4N99qwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5st5SaNJpzrlD3zWSAbcJw4LocJpG4XMXSx0yNNdjpDA&oe=69FE025B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsfCihCTNGcQ7kNvwHs_CVO&_nc_oc=AdpT_VPLYoOGmMbM7vRJM44mvfC7ph1iIwJvSeov4m8ctnmxWzeod8VqqQUvrqdg49w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6weYxo51D-N5h7qJtfqYPLR3ugzljKhycIj6e-BIjehw&oe=69FDF6BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publ
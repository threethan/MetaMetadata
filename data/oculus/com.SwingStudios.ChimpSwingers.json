wingers V2_Custom..._05.04.2025_19-30-00.png", "id": "519716751190493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_519716754523826_1767316021766907892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7T3Lt0pJuoQ7kNvwG7kS7U&_nc_oc=AdmADm7Nh0w7-0cDTvMzFNoBDbY7NON0lg1j2qn3BGkudsjgOSEy00REE-UUgiS3pUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiRZfLHgwiYS0AmpJtM_38wPET5CZEqlqa7Czq6vn7zQ&oe=699D8C43"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-23.png", "id": "1723875461876061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1723875465209394_4203548443581642061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZedwetFBwLYQ7kNvwG01Uy7&_nc_oc=AdmmC_D7kfKZ6s7JMsQyT0JOzSOHAMtwYFXh1EPJfrw0c8BSmcK-E6Nqb6V5zGEc4H8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkMf2dFT5ZnzALapkoVI7pbrIjgH5HO_o15T7V-CBA5Q&oe=699D86F5"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-41.png", "id": "1048765557097295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_1048765560430628_3383552754875951812_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXOP0xPQ6DkQ7kNvwGV8pB2&_nc_oc=Adn_TBaJE42pqrw121ZuXuHBcyXnB_tyhbbRnE3QHuLRLAm7ooZX5z8UxRx_Sz7Qfj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsK85CA7JWkKDttYLwAmCQEXsN3ngvKMzKZEXZs92mLlQ&oe=699D92D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "A new upcoming good game  variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/chimpswingersofficail/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpswingersofficail/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9468246076616430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1210225803976232_1225744860442128377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2tXPrHCaf8Q7kNvwGUhDz2&_nc_oc=AdnoFHYlidCU1YpxcImYITO2xUuoIDW-73U8CrBQBtRW0bNLerYHhZ6u5Yn84CXihrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvO5ZW2bQb9zzFkFRMVBXZ2A-ep1PRkIJNVb2tfsYAtpQ&oe=699D8DE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Swingers", "platform": "ANDROID_6DOF",
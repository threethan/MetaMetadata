wingers V2_Custom..._05.04.2025_19-30-00.png", "id": "519716751190493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393589_519716754523826_1767316021766907892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrHULhxh02AQ7kNvwGWYclB&_nc_oc=AdnHq4VKavFl7pgbYRFGD4eoP1cjfMdTx5nGGdY7kdoxxwOvPvw4QIMVdFC8JKuWcBY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb3uK1v4vZUTGaSSVznEA2UAv39YbfJ7k_jCFr3rZJtQ&oe=69A57543"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-23.png", "id": "1723875461876061", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391883_1723875465209394_4203548443581642061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UJ42TxhnVYQ7kNvwHq5qf6&_nc_oc=AdloXMRJdGQ8YrZ8o7QeFfcd2BjOMv9cWWpQX4Z-e4nIu6O4hPfhSCDBKSNJjPeKTnM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsoIdKwIR81RlTOja6OzBA_W1aaL4EPwyT1vQqIFwunDQ&oe=69A56FF5"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-41.png", "id": "1048765557097295", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393432_1048765560430628_3383552754875951812_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2f-RAX-cDkQ7kNvwFg2KFf&_nc_oc=AdkIbAaGDWm-leiiPUkuiLkKIO24KsHupqNA97HfgB0kUCBnVTAb1OaQ8wzOewnv36c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftSErmVttMOUtNwCkF7TZG-Nstxyl6EuScB6gK3dg822g&oe=69A57BD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "A new upcoming good game  variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/chimpswingersofficail/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpswingersofficail/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9468246076616430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391888_1210225803976232_1225744860442128377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWXy7wJDdMQQ7kNvwFe1tEd&_nc_oc=AdlVR7faNTX-HX7HGIhzFjTm0ijhELJhsscuWmYbSwx89ICPUuvxvHHV60_1ukZCY3o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsekBfoE6M0_RzzlGviWEnUDvl1ddoB676VUMqmF0nMOQ&oe=69A576E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Swingers", "platform": "ANDROID_6DOF",
771-25/473393491_3606319783009987_8458876917306594072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJHyH2ztw28Q7kNvwGIfOhm&_nc_oc=AdoMdYRrRTbd_iI5z-gsynPewd4x1Vd5O-ADb6chXptZC7bif8iVMZJ6EAIXPFmhCoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RPi16py6ApuUyq4kub3F4-e94PXOK078ZUud__ambdw&oe=69DB831B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjkAqqnzH3wQ7kNvwH23Mhv&_nc_oc=Ado_zeNdyY8P1QFKUHvVptpP1Zo_pn55zwPgKll1_jTOcf_rBj-iQafzGjLmhMAhut0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E5_3pY0isr1fN5ML_b7LFfJ7w7UgVEuMwxzOp9aZULQ&oe=69DBAFBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publ
7&_nc_sid=6e7a0a&_nc_ohc=Bjjro044REUQ7kNvwEFZd8t&_nc_oc=AdnjxWg6AoOvJFI55UHWzTe3pRYckz0Na1s1RbLJ1KrXpmX8WUDCCq8H-29V9ZFllo8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzN5DK7qVZminP9kRDG40HI5NoI4BvY8BH8UqfZtLDyNg&oe=69AABB9B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsIsjct6-UUQ7kNvwGPouLl&_nc_oc=AdmS6qkaYfYAA-2N8LpbVuMbt7O4s6h_Q9OU7Hg5HHOdLXkVLZ7qDoomtO7sFmexeb4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_bhOQBE6W1ziVmgxGoVH-tdT_Rr3urEtKIiQBZeJmQw&oe=69AAAFFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.googl
wingers V2_Custom..._05.04.2025_19-30-00.png", "id": "519716751190493", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393589_519716754523826_1767316021766907892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-2qdgCzHAEQ7kNvwErFyct&_nc_oc=AdmoqhSZx_QW0G_jLHAl8ZoSRANOjccrFmz13dSbw3EWORAUw0Th5V96wDNo_HsXUjk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftPJdjuypeFcneP-9PD1qb-1oO-ZpjDN8USpsz4CIRFUQ&oe=69A180C3"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-23.png", "id": "1723875461876061", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391883_1723875465209394_4203548443581642061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwEXy7jyKqMQ7kNvwHooVkd&_nc_oc=AdkVdOEjtTb4u9Y8SrJGjJ50VsApCiVbUI8c_TIDTOPL3OSFhPIq6vh38oMdzBDmVQE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuoQixYAR-gLnEK2lY2h6OgIx2aAAtgVk-nrzj7vbAjHQ&oe=69A17B75"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-41.png", "id": "1048765557097295", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393432_1048765560430628_3383552754875951812_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpySfkg2zU4Q7kNvwFOLGXD&_nc_oc=AdnWv3r5BKe0w183od4KIlFptmwVR0wdjS3acElAymJJ0epUMn8TkjG99rDpg0U67VY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvmgCT9EbFb3WfC_oZkKBT7ga4gBI8fXATLkbH6cc_RnQ&oe=69A18753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "A new upcoming good game  variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/chimpswingersofficail/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpswingersofficail/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9468246076616430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391888_1210225803976232_1225744860442128377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE7EdInBfI4Q7kNvwGVLENo&_nc_oc=AdkRGtVpDxqL4jGN7esQnwye6fV505bU0_JVyGF4PHVAdsNkUt8rwy2RUc9r9DSJe88&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftMPxb6aK7zGXURKPTgodX27jLHLm284Kr6wl6NigWwgg&oe=69A18260"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Swingers", "platform": "ANDROID_6DOF",
0a&_nc_ohc=V1_q8ZXjF20Q7kNvwHrsYjP&_nc_oc=AdlrfySY-k1v2JY0YwbyhemABsRVHYQQrLgj_w7J-bb5FYbM2CDnj9MCK8X33kkPWQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoiuxhY78Qa57RgW2BKBmIm-kvuuHsxC7cQh47fcCD9w&oe=69AEB01B"}, {"file_name": "NewScene_Custom..._03.03.2025_22-26-05.png", "id": "490360200789455", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_490360204122788_695454515600681886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHPziZt3EMMQ7kNvwGqTaqO&_nc_oc=AdndlCwNl9Yzmod_SZlhyidnqE0j8OoGadpgHc_DCSnyYqw7QR80jw8OUV7U50fEdro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzycJKXbINjP8BDxj5pMyp6d2aBDyMPzjewUEVc98OE5w&oe=69AEA47A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "This Gorilla Tag-inspired fan game offers a variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/dying-alive-official/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/dyi
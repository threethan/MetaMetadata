wingers V2_Custom..._05.04.2025_19-30-00.png", "id": "519716751190493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_519716754523826_1767316021766907892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lcRgre94egQ7kNvwEdO4ep&_nc_oc=AdlGs4Ux65SCQWoDhbhaOJIG14mrBBOMQQGs3e93OfdybSOyDzjBHqVxuEPyIktPDps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkHlQdaR4BFz6xCs_DIti1gfVNXMRKomK2TMLzqW9_AA&oe=699997C3"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-23.png", "id": "1723875461876061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1723875465209394_4203548443581642061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuxlX9hXCLkQ7kNvwE_bIPa&_nc_oc=AdnSTQnuy96yIj77x0LV6ckieIjE-jVCyE5Sb-No9kdhphEkWJXXOVfJyF36NWcnrOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugMBEglVAzIk0V1BdYfiZ7gVkv-qzizvhPm1Nh15QAlQ&oe=69999275"}, {"file_name": "Chimp Swingers V2_Custom..._05.04.2025_19-30-41.png", "id": "1048765557097295", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393432_1048765560430628_3383552754875951812_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi9cLRFxLHwQ7kNvwEbTrb8&_nc_oc=Adnc2bxURy8hODFl3LtE3pCxyee-rdRf4eiN864d1CYYBuPGxDMkW019xLDCxvh-MBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftX0kZCR64E75lASOEBA1Je_zSJ-k2crNxpTpOnR9ch2w&oe=69999E53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Swingers", "keywords": [], "long_description": "A new upcoming good game  variety of exciting game modes for players to enjoy. You can play classic modes like Tag, Modded, Casual, and Freeze Tag, along with many others. Each mode brings a unique twist, keeping the gameplay fresh and engaging. The game also features a cosmetic shop where players can buy different items to customize their characters. You can earn in-game currency by playing and completing challenges. With enough currency, you can purchase cool cosmetics to stand out from other players. The movement mechanics are smooth and immersive, making climbing and jumping feel natural. Whether you prefer competitive matches or casual fun, there's something for everyone. With so many features, this game offers endless entertainment and replayability.", "short_description": "A gorilla Tag Inspired fan game Has Game Modes can buy cosmetics and earn money"}]}, "developer_name": "Turbo", "developer_privacy_policy_url": "https://sites.google.com/view/chimpswingersofficail/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Turbo", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpswingersofficail/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9468246076616430"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1210225803976232_1225744860442128377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vmWm_tTlU0Q7kNvwF8t6m3&_nc_oc=AdkORsHFmMEwwE6jFXvA4-KrRMU_hjOqsbSi4FaTvpRTiDbeypDOkfztXCY7U3PiDsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft80kaHO0xTBbQrxh_8dne2uMDQV278Sh4KRKYAQZRl4w&oe=69999960"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chimp Swingers", "platform": "ANDROID_6DOF",
 uncover the layout of the area around you and send it to Lobster CO for them to map out future projects. but when you go down you wont be alone.\n{762608112827751}\nH O M E  B A S E\n\nThe Home Base is full of items that could make or break your run through the area. instead use the homebase as a reset and a way to stratigize with others on the team to come out alive, or just fall deeper\n{1666221137368041}", "short_description": "Use your trusty Lidar Scanner to uncover the mysteries of Lidar CO"}]}, "developer_name": "Bootleg Inc", "developer_privacy_policy_url": "https://sites.google.com/view/zero-blitz-temp/home", "developer_terms_of_service_url": null, "publisher_name": "Bootleg Inc", "support_website_url": null, "website_url": "https://sites.google.com/view/zero-blitz-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24586623891007386"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1271542111360680"}]}, "baseline_offer": {"id": "1271542111360680"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758047400, "status": "PUBLISHED", "id": "1271542111360680"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24680181721651602", "version": "5"}, "id": "10027158270667231", "channel_name": "LI
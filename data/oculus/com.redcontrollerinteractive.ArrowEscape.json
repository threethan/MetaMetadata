n.com&_nc_ss=7f20f&oh=00_AQSnwcmE8NUxMc1oz5kIeECwKxCg5Ps8eLiC6DtSh7_hSg&oe=6B08479F"}, {"file_name": "arrowescape (4).png", "id": "986188807229674", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499618274_986188810563007_5076590434606391057_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGHSI8pVJ90Q7kNvwEeB8WH&_nc_oc=Ado8fVDUsWrbe9aOYVJFHVJXWo-p0dU2bG8VrqeByHBDEYJJwpYDjuTzg29lsnKduPo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtFmYwpuXU18GERQqzJVdCPy9b5mO3v-LgY5XvyLaTUg&oe=6B085DA1"}, {"file_name": "arrowescape (3).png", "id": "1417541570402126", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623370_1417541573735459_2065371477531233317_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuIWRlAd5GEQ7kNvwGpn6-x&_nc_oc=AdoJO7SfpHh9V3KHRDIGgG_QnQCX3Q1Z_L3sOcYpJAhlFeB2qJbQtoRTQxuY7s-u4vk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe-hXPUDkLCypumCTDosi7sKOOEOvAKj-gonkkUBgOCg&oe=6B083BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project.png", "id": "1472379167699474", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304115_1472379171032807_7073529286812565600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RHF74SAWJkQ7kNvwFOyDQ_&_nc_oc=AdqJSdv9qbWnVzirP1aeWN7wJdojz2dGzhQ3HKApkxNMHSD7z-1uNXxmoFwWHlh87cs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT55eAQSfvNiP3_h0Zwg9cCa14pPcTg3EygzeKZhQ9ILA&oe=6B083ACD"}, "display_name": "Arrow Escape VR", "keywords": ["Arrow", "escape", "puzzel", "casual", "relaxing"], "long_description": "Enter a relaxing world of colorful puzzles in Arrow Escape VR \u2014 a unique Mixed Reality brain-training experience built for VR and hand tracking.\n\nUse your hands to interact naturally with glowing arrow paths, solve increasingly challenging levels, and enjoy satisfying puzzle gameplay designed specifically for Meta Quest. Every move matters as you clear arrows in the correct order and discover the perfect escape route.\n\nWhether you want a calm daily puzzle session or a challenging brain workout, Arrow Escape VR delivers smooth, immersive gameplay that feels intuitive and rewarding in VR.\n\nFeatures\n\u2728 Relaxing Mixed Reality puzzle experience\n\ud83d\udd90\ufe0f Natural hand-tracking interaction\n\ud83e\udde0 Brain-training gameplay with strategic thinking\n\ud83c\udfae Hundreds of satisfying puzzle challenges\n\ud83c\udf08 Beautiful neon visuals and smooth animations\n\ud83e\ude91 Comfortable seated or standing gameplay\n\u26a1 Quick play sessions perfect for anytime gaming\n\ud83d\udd25 Increasing difficulty with addictive progression\n\nEscape the maze, train your mind, and enjoy", "short_description": "Solve colorful arrow puzzles in Mixed Reality using natural hand tracking. Relax, train your brain, and escape through hundreds of satisfying VR challenges in Arrow Escape VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://redcontrollerinteractive.com/arrowescapevr", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35636853509291840"}, "review_messages": []}]}, "cover_
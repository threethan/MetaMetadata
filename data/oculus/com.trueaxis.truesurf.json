.png", "id": "653478134124488", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_653478137457821_5458112418876366809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4z-a-O45Z_YQ7kNvwGU8iAs&_nc_oc=AdlooT7fllZLguGvJmavtTdnjHuAhi__AjXajRLqk9J674OV62wXNRj43PMmRCrHfpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ-TMdA0glnN7ogP7UP1oYcvDQ0HfigDiNDHLSECv3Og&oe=69BEA893"}]}, "id": "1169340504716103", "locale": "en_US", "screenshots": [{"file_name": "007b.png", "id": "3260901480741252", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_3260901484074585_5899300670669420545_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9VaYa5uL_cQ7kNvwEAO__h&_nc_oc=AdlUtVjbLyBNCtRRlCxmOEj8jlazyKjaJdnge9ynFF3wrLQp98rJxy0oMpAoKUeJMy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyM9CLYSK5hrYzKfRPRTcuO_Dg9RHOTLv5KgDTj1eI7vA&oe=69BE8F84"}, {"file_name": "008.png", "id": "837146485912209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_837146489245542_2074176973414640307_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btqoU7lX7UMQ7kNvwHatarQ&_nc_oc=AdmMIbN1DVBJGB5YcpLrn6IEzZga21IOhrTDUZInXevC50h41qSUAvqtxJ3N3QhB0no&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSewIqNWiqKuprRhwhXSlS_AkEd6hHu-oq5_0HRBXv0A&oe=69BEA925"}, {"file_name": "002.png", "id": "1928261387730595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_1928261391063928_7240850795307307332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nye7gUAMfcQ7kNvwEzwTIp&_nc_oc=Adn63GUkdtaKtVyhY8Li8utQH28C1_x2v2nhQoqfGUJwqNSCTseWTnSl4yjZUchMv3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsMUcERnkcWPOsaYYihZiUkteKteLl6900dhBMzh_MgA&oe=69BEA17F"}, {"file_name": "001.png", "id": "1535119994172532", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619145_1535119997505865_4009198314036636963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeMb7PiJoo4Q7kNvwFlI2Yh&_nc_oc=AdlTmEV4lhueE2F65VhQzXzaHwIwITUYa2EV_Dj3rOL87Rlol8yJO-eQFoxcemtAVFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM5qY6U7XDerBX_is2dFhnM-oSWf0gdmvsULbQ4pQ24w&oe=69BE9EDF"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuzft9zbrbQQ7kNvwEUxfn3&_nc_oc=AdkfYTsDFMpyKRvzR7cq-POOcbtYx3lMtoFgBYLS4-yMVhXbl1-hi8Zq6o09SuwC1Ko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc-cB0NBECw0lljgrveOyKsh_t99qFBf0-djkPbSzpIQ&oe=69BE7E8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_016.png", "id": "1374509167599243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1374509170932576_7907392765280961534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P3g0U1tW_AQ7kNvwFzIhxV&_nc_oc=AdmrPh8YMAkX2lKwK5INNyzrrtE4YI8-_MDEGWo3MDoCGuLbwdCeFQekFY-_BELkD54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwodkSqICcaasVhaLp1HUV0SzMx86uQceXQkE48ioZMsQ&oe=69BE9BCC"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.**\nTrue Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{2572101493173541}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!", "short_description": "Welcome to True Surf, the ultimate surfing sim. True Axis' real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
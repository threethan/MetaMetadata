.png", "id": "653478134124488", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618277_653478137457821_5458112418876366809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBTdlNG5elMQ7kNvwGTZtUi&_nc_oc=Adnu6GQIUKrvjPvB4NAk3M_IhSGcy3W-AUF5raOit16vwq2MimHhxWLo3HdZ1etc8KA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOhthuIw0Fe8AY5O1J2aUxqFgdtxTbwfjx5bI98nGQbg&oe=69BD5713"}]}, "id": "1169340504716103", "locale": "en_US", "screenshots": [{"file_name": "007b.png", "id": "3260901480741252", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617831_3260901484074585_5899300670669420545_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9VaYa5uL_cQ7kNvwHUup8S&_nc_oc=AdmSgf7RpT7O7UcIEyCUYyhW3dPTJDJd338yIgTo0o_54VMXQccWfUr4qdJpgQaUKas&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypTKBvwgiK5fwaAU6vY99YyBow8jeYSxwwmCO9DevEIw&oe=69BD3E04"}, {"file_name": "008.png", "id": "837146485912209", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619680_837146489245542_2074176973414640307_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btqoU7lX7UMQ7kNvwGPZvIO&_nc_oc=Adm0dXI4N5wx5mLpX0gPF54onlIyzER60o9QoVLO9aCIh2Zx6CbREIx3FlekisNThmE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyxty7B0-SsWbTpLwsuPYwQFmNmSkrB9xHVYAVSqNKqSA&oe=69BD57A5"}, {"file_name": "002.png", "id": "1928261387730595", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618297_1928261391063928_7240850795307307332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APziMq6X3m8Q7kNvwGKKtvE&_nc_oc=AdnKgdbwkKmOnudEafdN48FewN-sdFKtwQ3xLB-KRkNvkhhNpe03AXg-z7YnJ1g_E7w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuUKlMP5JVrTCtzLwYPKi8nWEOY4M4LaHkdOwqrJOBmA&oe=69BD4FFF"}, {"file_name": "001.png", "id": "1535119994172532", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619145_1535119997505865_4009198314036636963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeMb7PiJoo4Q7kNvwE-9lqE&_nc_oc=AdnMv3ij72n2w_Dc_c89UjeyJGZ-S-c4T_0DiVz6tv1Zy_U3VXrw6y2ok2rAuCSCglM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYpClP5prmRnjrIU94PprWE1H_wcFey9PkKrPNPOaYmg&oe=69BD4D5F"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuzft9zbrbQQ7kNvwGk6GJK&_nc_oc=AdnR3O2Se3VW1ZASKUoma44qOPKfvCafCJxVIymNan6sGE7LC7wWY1FLJKEir_9k7ho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwwu9drGFREQUnAJN9SPdeAZBXFutfpeiT53suZm9ilpg&oe=69BD2D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_016.png", "id": "1374509167599243", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623370_1374509170932576_7907392765280961534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-2nknQWFTgQ7kNvwF5YBaK&_nc_oc=AdmAt3v4qwLA23Dpky2DlSxB-d8v5oh1tiI4DPNEzS9xejhaF1zyK1H-AmAh2SrApgY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUO__VSfHWBJr5vQs1BPNKAURdsx5EC-ibBMO9R4_OwQ&oe=69BD4A4C"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.**\nTrue Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{2572101493173541}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!", "short_description": "Welcome to True Surf, the ultimate surfing sim. True Axis' real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
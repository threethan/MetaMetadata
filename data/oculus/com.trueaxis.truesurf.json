dn.com/v/t64.5771-25/499619145_1535119997505865_4009198314036636963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuigTgYWP8QQ7kNvwHBs-2D&_nc_oc=AdosFfgOxDf0Ozp9cYZTp12_DQXv1GrocWupDvPQrT1EZ1JacbloatSexHDmG-rPSN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEQ-OVtZ45wMs6B_9El7ssRiN_K2jz0C_8_MRQosQXKQ&oe=6A9D6C5F"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cp3jyvCoh8Q7kNvwEcuWm1&_nc_oc=AdoWvw7fjPRhgNMvwR3JoFBZUom7lqwTEl9wjhYzxdFwiGkbSIhCmFbM05uCqaiHFNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfUpDbxZmCPFaCnCDGF0XiP-wLPb-Fnd7XF4K2EbUbQ&oe=6A9D844A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_016.png", "id": "1374509167599243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1374509170932576_7907392765280961534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ElEbwSSFp4Q7kNvwHPsIAM&_nc_oc=AdrU1eACw8iGt9ypmRv7D8qgG1ODzePme9FNL5b-Wa7ZLJqFB5dI5xaawfzlr8e8caY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb63lKp9qqMmdNfAorLiVi8FMLkKiJFyhIPN7WpUveig&oe=6A9D694C"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.**\nTrue Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{2572101493173541}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!", "short_description": "Welcome to True Surf, the ultimate surfing sim. True Axis' real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
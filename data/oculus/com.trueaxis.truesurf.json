.png", "id": "653478134124488", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_653478137457821_5458112418876366809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBkv0qdh-S8Q7kNvwF4egDW&_nc_oc=Adm9BqDvWYVQzAMKU4j1A1u01Nh69fRHplK-t8s3rBALs64SbvC2IjQFGDTc76hv0hc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDJVriGJ8L24CdSfPbg7iVONiAszkQmzWQCDnE35WZVQ&oe=69B17993"}]}, "id": "1169340504716103", "locale": "en_US", "screenshots": [{"file_name": "007b.png", "id": "3260901480741252", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_3260901484074585_5899300670669420545_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSmWp4PHAx4Q7kNvwHGgl_i&_nc_oc=Adl5ERtsMpkNbdhxMiXzsrQVd3Bywt5BFo9pCpSDrODNDvFfR5bVf3ltlJHKPi1vw84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySA8fGzNkFkX5EhOOKO38v9rlg7FYl0louU9wEVbZ0Jw&oe=69B16084"}, {"file_name": "008.png", "id": "837146485912209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619680_837146489245542_2074176973414640307_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HzuYJ39RGsQ7kNvwFCAYDh&_nc_oc=AdlgyF6IDtfTqUJFaUCoJFgIAgFHzY1zt1jip85DbBCeoSQVnzJ1UojNESAymicD1g4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzT4yvnrb08zwFSqDLFOW1dvjNx7TuVBruEzscp8NH5JQ&oe=69B17A25"}, {"file_name": "002.png", "id": "1928261387730595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_1928261391063928_7240850795307307332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc1Bqc7U2h0Q7kNvwEeLp-w&_nc_oc=Admg7492G4yKRxOhqx49mKqxIByIkRlM5AV4QIVoesNSLtxNBFSCU-a2KMMq6JQ5woo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk9J13gIc_2Ptp5P02ZP1CzOBasonwoJ9KQyZ6Uq-0Mw&oe=69B1727F"}, {"file_name": "001.png", "id": "1535119994172532", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619145_1535119997505865_4009198314036636963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVusEiax8VQQ7kNvwFwVU8j&_nc_oc=AdkzAkZWMp0W0H9Ai2Qbe_1Gu7b9QJx-cY9HKK6pmi68RncxxWpZtc3HTdeLg9RD7_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynJt7ZBCbfXg1t3WZzqdb-lGdvdieilCi_DxHsCge7Mw&oe=69B16FDF"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2mAszncvgEQ7kNvwH50ci_&_nc_oc=Adm6KNwFKKhozo3r9AeP7UB2j6bkelnZJof9FkKXUJkyYKiwJvIqhp9CauOTqAa8oLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTPoJ5P24UizbwqLR6rksWsN_Nvz431jYaWWU_03v2wg&oe=69B14F8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_016.png", "id": "1374509167599243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1374509170932576_7907392765280961534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UJRAExWk20Q7kNvwFPr6oz&_nc_oc=AdkZZLnnFvchhUJPqxwAvp0rf5RETC9N4s7xPq9BRzwjWkEKnWIIuu5Nz0R04vVZ7X4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2oGkM0DZjGAHYv_3-_9p9QkHeh0xCsOmnb54DXa6SNw&oe=69B16CCC"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.**\nTrue Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{2572101493173541}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!", "short_description": "Welcome to True Surf, the ultimate surfing sim. True Axis' real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
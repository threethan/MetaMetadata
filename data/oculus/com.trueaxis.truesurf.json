cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb1JiYkfJnUQ7kNvwGc7CWM&_nc_oc=AdrgaZ4tc5zxVXy5385G7yQFE__uVf-GsLxeKgB-byMBKcrlfc6yjkC3_neOAtlKBV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36fVm-wbmMXS7R0f39b3QrJu5iLZlhJfTuDQ2DjWIQ2A&oe=69EA205F"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om7QSOwF1ZsQ7kNvwHpCilP&_nc_oc=AdrJGl1ogLU5d4lSDJoBbfcudjsnUTjW4oS69u65-mIh-Wr0VNV9pTdeYnyJLozDap0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ojJMmsITK1izt5FXQ0NRRUvsB6cUwftx8rpZXlA4fHw&oe=69EA384A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_V3_001.png", "id": "25847703744824652", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618277_25847703751491318_2899279762184415061_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0akkf3cp18Q7kNvwHxEqMN&_nc_oc=AdqUxCbHxtHIakjyt2fApnv2Yro6clFSm0kj78vYPKaYqCInuoRVXqQfR2qAJrKFrN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nsTRfOhPjp6Dmux2S0bu5X-_ahuMEvMeXTrlB8KEQOw&oe=69EA2C22"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.** True Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{762511689581422}\n\n{858909919992608}\n\n{1284489806772162}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n{1524276435491850}\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n{1279822320617242}\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n{1539464040584028}\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n{2572101493173541}\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!\n", "short_description": "Welcome to True Surf, the ultimate surfing sim.  True Axis's real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
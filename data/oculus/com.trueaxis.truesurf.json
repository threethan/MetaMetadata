.png", "id": "653478134124488", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618277_653478137457821_5458112418876366809_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkjAh0RUZMsQ7kNvwHkadvx&_nc_oc=AdnJMih36t7wthGTMKBxQbgES4JNF5DWvaMQDKoIpbj_cZXLG9snef1-3owMUiukAEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGuAXtcWfPvJO_oapxOFcyB0J4wAkCBUM5Y--fX8dwmQ&oe=69B56E13"}]}, "id": "1169340504716103", "locale": "en_US", "screenshots": [{"file_name": "007b.png", "id": "3260901480741252", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_3260901484074585_5899300670669420545_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ff3cPI0BJMAQ7kNvwGTdd4w&_nc_oc=AdnpHk4Xm0Pg7w2eB0rYu_0U70-PNLNNDKLuhFjg04gvgQZsM1ZHgxc_n3UcGQ0Aj2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfOUr074FwcfZ-lh-iYZY6JKLEzZH-zsGG9b8KF0BscA&oe=69B55504"}, {"file_name": "008.png", "id": "837146485912209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_837146489245542_2074176973414640307_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZfPMO5FchAQ7kNvwF0re5k&_nc_oc=AdmEO6kmYI8fNyT45PXSBHQrj9iHdwDeaJFZc_uqS_1kxfPUeKsuUEo1MO4aY6BNDJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPf42PwT4MqUs0hgG78xnt9p073xUcfLArQV4Zu-jqiA&oe=69B56EA5"}, {"file_name": "002.png", "id": "1928261387730595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1928261391063928_7240850795307307332_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhZMNUO14lsQ7kNvwE6vYHo&_nc_oc=AdkPtOEBJOS7nXhzpd_PwrGYGcdDWYpwf7dHfiuE9GGP0MqPsa-3-YQ5NBz4bljerdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdI6J13l3WcUrDyKVwinJ0amT-u-iMBvJcfd-pbgEORw&oe=69B566FF"}, {"file_name": "001.png", "id": "1535119994172532", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619145_1535119997505865_4009198314036636963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReqMBmvBuDkQ7kNvwGNfyf2&_nc_oc=Adk2NMexMQCQzOem6T6Co2Wxc63IkXkERK7fr81TOeg_7tMN_iTD5tqPP_DnNApe1BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwp8yTucg55e07PU6UmSJoA3BhTUYL4WMm-VjM_xcq4Pw&oe=69B5645F"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbMXG0KoquYQ7kNvwF36IZ_&_nc_oc=AdmsQ3dz-hi1xoM1N-uYa_5GbrgNQ4M4R5L3lOYrB7orzP5BqgZEmjdjRnbFK5C4pD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyIVXcBWGYLcaC5ygdsU5HOkeSkFGIJR--ZuLrgbQPhw&oe=69B5440A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_016.png", "id": "1374509167599243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623370_1374509170932576_7907392765280961534_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXeLvNyYezIQ7kNvwFvAslG&_nc_oc=AdnR16NOPs_P0kem-KvSrnB7wN36ZixwH2lSX8k0HxflFt_f12nJWiK9uWjcPpSx6MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyU0Is6yq08v-TqhRBBFQLr-x3FkdLoRRlhg2HgIR6W-Q&oe=69B5614C"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.**\nTrue Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{2572101493173541}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!", "short_description": "Welcome to True Surf, the ultimate surfing sim. True Axis' real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTI
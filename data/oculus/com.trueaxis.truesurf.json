lJHyKCbohZ6FoSGcK9e8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft0WniCtIo9qLW_lv56ifP-IkPdvPoQvwDLlDIO2TO1Aw&oe=69A5925F"}, {"file_name": "006.png", "id": "4349813078675519", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619646_4349813085342185_2481074008975818482_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIMlSs1HhDoQ7kNvwHlsqbO&_nc_oc=AdmMYkmNYOHMvj0A3FgncZ-0nzaKp2-getAZ4F2PSrzQO5pmoXd6HWM228egvAeC8Qo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu7Sj04n5sFP3plvo2zF9H0-9RkZwQ7aDPL71ZOOQlpCA&oe=69A5720A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_V3_001.png", "id": "25847703744824652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618277_25847703751491318_2899279762184415061_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS1SM951AJUQ7kNvwEJIZy-&_nc_oc=Adkn9B_cr1Tc5bSNYzEp3ldPI-MVKc9Rh8xjZ31y8AoflGvybs7NBwFY_Zcr99O9T10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv5ipJlaf0N33eknjNPqlRhk2gywMaAhBL65qrzM-VnJQ&oe=69A59E22"}, "display_name": "True Surf", "keywords": ["true", "surf", "surfing", "waves", "water"], "long_description": "**Welcome to True Surf, the ultimate surfing sim.** True Axis' real world physics engine, enables &#129327; **realistic wave graphics never experienced before.** \n\nDrop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots.\n\n{762511689581422}\n\n{858909919992608}\n\n{1284489806772162}\n\n# Your HQ\n&#129517; True Surf Tower\n\nTaking inspiration from the coral reefs of the Pacific, escape in your time traveling surf machine.\n\n{1288111046417067}\n\n&#129416; Wildlife\n\nSurf with dolphins, turtles, fish and more..\n\n{1524276435491850}\n\n&#127758; Real-World Map\n\nNavigate LIVE swells on the map, then pick your spot in the lineup.\n\n&#9889; Perfect Storm\n\nPlay god of thunder & boost LIVE swells.\n\n{1279822320617242}\n\n&#127940; Character & Quiver\n\nExperience apparel & boards from leading brands.\n\n{1137259105252895}\n\n&#127918; Settings & Stats\n\nFine-tune controls & analyze your performance.\n\n&#127942; Leaderboards\n\nClimb the rankings | battle with mates.\n\n&#127909; Replay Editor\n\nWatch & edit your greatest waves with 8 x cams.\n\n{1539464040584028}\n\n# Surf Spots\n\nGrind &#127919; missions & generate &#129305; shaka to unlock real-world surf spots.\n\n{2572101493173541}\n\n&#129470; Powered by real-time surf forecasting data from Surfline. \n\nIncludes:\n\n&#128305; Waikiki, &#127462;&#127482; Bells Beach, &#127467;&#127479; Hossegor, &#127482;&#127480; Lower Trestles, &#127487;&#127462; Jeffreys Bay, &#127475;&#127462; Skeleton Bay, &#127474;&#127485; Puerto Escondido, &#127467;&#127471; Cloudbreak, &#127477;&#127467; Teahupo'o, finishing up on Oahu, Hawaii at &#128165; Pipeline, the most iconic wave in the world!\n", "short_description": "Welcome to True Surf, the ultimate surfing sim.  True Axis's real world physics engine enables realistic wave graphics never seen before. Drop-in on a wild, water wonderland to feel the speed, power & flow from the real-world's gnarliest surf spots!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://trueaxis.com/tsfvrpp.html", "developer_terms_of_service_url": null, "publisher_name": "True Axis Pty Ltd", "support_website_url": null, "website_url": "https://truesurf.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25907982805551739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618264_744450258488344_7948616064017541609_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msypy_azeOcQ7kNvwGS1-cV&_nc_oc=Adm0-_-oYQcTI3d2ZufMDdQI4Jlxcrq8zf5heNL-AYSBIPfZ18OqshBBK7dxSOFYCoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuSK8ZiUmTC49sFPZUP5e6kGJAH-9e36IZH4zcDK60Ngg&oe=69A589D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "True Surf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1766077200, "lastRevision": {"nodes": [{"id": "5770505766392740", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5770505763059407", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1365187958319076"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Icon_017.png", "id": "4133348603578646", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619448_4133348606911979_385154677757063986_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ7a1jX79GQQ7kNvwENGG5H&_nc_oc=Admv1VPg4AMP2JxWSgRHC98uUhvmiKgw1EYm7qJmTkZ6vjXe57II6cqSi5bBNLqXHWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftL6Ztm-G_b71GsiI3uRYpTo_LsHrlQyfULBGDaGJNtbA&oe=69A58FC3"}, {"file_name": "logo_truesurf_bigger.png", "id": "1994251604419133", "image_type": "APP_IMG_LOGO_TRANSPAR
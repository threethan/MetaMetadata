eo_trailer": null, "video_trailer_thumbnail": {"file_name": "Photosynthesis_Landscape.png", "id": "1065641101430716", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575348_1065641104764049_5161386440167904318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCwut3Uk3BwQ7kNvwEY9EUx&_nc_oc=AdmdqmVIdmgA4Tr9mHpEqsLUOEDKXnzdJVYXNs0khh9_X50x1VNTbp58x8ZUYJgiClQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvVINNAaMMpwUjS3OJHKvpMugLHbVk8ouaX0J51pd7VIw&oe=699B0AD2"}, "display_name": "Photosynthesis Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "photosynthesis", "science", "contentsda"], "long_description": "1. lift the bottle of BTB solution\n2. add BTB solution to 3 empty glass bottles\n3. go to the lake and catch a black horse\n4. put the black horse into the 2 vials of BTB solution\n5. close the lids of the vials with BTB solution\n6. cover one of the vials of BTB solution with the black horse with a black tin to prevent sunlight from getting through\n7. observe the changes that occur after a day or so\n8. remove the black tub\n9. observe three bottles of BTB solution alone and three bottles of BTB solution with black horse, one covered and one uncovered by the black canister\n\n<Conclusion\nUnderstand the change in color of the BTB solution\nYellow when there is a lot of carbon dioxide\nNormal green color\nBlue when there is a lot of oxygen", "short_description": "Illuminate the process that powers life. Discover how plants convert light energy into chemical energy, a vital process for the survival of most ecosystems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_c
hesis", "science", "contentsda"], "long_description": "1. lift the bottle of BTB solution\n2. add BTB solution to 3 empty glass bottles\n3. go to the lake and catch a black horse\n4. put the black horse into the 2 vials of BTB solution\n5. close the lids of the vials with BTB solution\n6. cover one of the vials of BTB solution with the black horse with a black tin to prevent sunlight from getting through\n7. observe the changes that occur after a day or so\n8. remove the black tub\n9. observe three bottles of BTB solution alone and three bottles of BTB solution with black horse, one covered and one uncovered by the black canister\n\n<Conclusion\nUnderstand the change in color of the BTB solution\nYellow when there is a lot of carbon dioxide\nNormal green color\nBlue when there is a lot of oxygen", "short_description": "Illuminate the process that powers life. Discover how plants convert light energy into chemical energy, a vital process for the survival of most ecosystems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "872913
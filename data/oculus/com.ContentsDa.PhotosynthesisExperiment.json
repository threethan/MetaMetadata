q4rVouQ0M.png", "id": "588542793520397", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_588542796853730_4681242734162513594_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rToVAsylPicQ7kNvwHjwez1&_nc_oc=AdmuMLI7mzojA-mslp36DghQJ0I6HSFPyPAWbV3t1wlEsRst7AcU_SmcKqo4_PL4Zpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaL6-Uf-8EM777g8py1wDVVU-Hzwg8rR4fwUDCM5dRaw&oe=69AC1BB3"}, {"file_name": "ApplicationFrameHost_OwjAKPbMh4.png", "id": "803174841858797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75339313_803174848525463_2024198106918458177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZInE2NaeDDkQ7kNvwHLfbVq&_nc_oc=AdmXN9k7tr1fdjlgzsO1oYL31FOMZVY1wsGWBINGBtzU3iFHfY2sHQUJdVy7kln83oU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxscMujPFvZ0r41cNh58_3ZMGgJsKVZfPQwxAAHpysjlQ&oe=69AC179A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photosynthesis_Landscape.png", "id": "1065641101430716", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575348_1065641104764049_5161386440167904318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdewojX4f90Q7kNvwHT4N1g&_nc_oc=Adkp2DekTwzDWEWraH_AZblbq7hi1YcbKqXMIM6xIqOV-v5ZajcnzIsCg6TbmXC2Yn8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUMyLn5txH0J3Obuiqsfpkf_LdrvvqVuNuEB-OC0crdg&oe=69AC2E52"}, "display_name": "Photosynthesis Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "photosynthesis", "science", "contentsda"], "long_description": "1. lift the bottle of BTB solution\n2. add BTB solution to 3 empty glass bottles\n3. go to the lake and catch a black horse\n4. put the black horse into the 2 vials of BTB solution\n5. close the lids of the vials with BTB solution\n6. cover one of the vials of BTB solution with the black horse with a black tin to prevent sunlight from getting through\n7. observe the changes that occur after a day or so\n8. remove the black tub\n9. observe three bottles of BTB solution alone and three bottles of BTB solution with black horse, one covered and one uncovered by the black canister\n\n<Conclusion\nUnderstand the change in color of the BTB solution\nYellow when there is a lot of carbon dioxide\nNormal green color\nBlue when there is a lot of oxygen", "short_description": "Illuminate the process that powers life. Discover how plants convert light energy into chemical energy, a vital process for the survival of most ecosystems."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8729136560500031"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_920144616437481_7911941723416784004_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0lcA7Trif0Q7kNvwGBsX_7&_nc_oc=Adlb_GBNrZyi5sIqVpXdiZHhl4eB0S9zlDbe7BRH3l1xT7B8iigbqOFfsg4XYmBAhBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzwpZQD8hjVK6iCF5JzDZ4Bo2NDaLQv7CnRhb8Cvd_7A&oe=69AC20A5"}, "is_concept": false, "is_test": false, "is_t
h encounter demands smart moves and strong attacks.\n\n{33433724246241795}\n\n**Boost Your Health in Seconds!**\n\nGrab health pickups to recover instantly and stay in control. Keep moving forward without losing momentum.\n\n\n{2606850776353627}", "short_description": "Step into Animal World - Adventure Platformer, a fun VR journey packed with jumping, exploring, and action combat. Collect ammo and health, smash obstacles with powerful hits, and take on enemies across colorful worlds. Discover secrets, interact with objects, and keep moving forward in this lively platformer adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25385691327757143"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "27444305298572422"}, {"status": "PUBLISHED", "id": "830905062938975"}, {"status": "PUBLISHED", "id": "1567968170902556"}]}, "baseline_offer": {"id": "27444305298572422"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784882520, "status": "PUBLISHED", "id": "27444305298572422"}]}, "liveChan
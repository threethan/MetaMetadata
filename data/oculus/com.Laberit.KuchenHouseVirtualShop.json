710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl1U-dFCLcgQ7kNvwGZihUr&_nc_oc=Adl1HPb24u1rxn2sELha1WxYKwfEHMYV3zYr6A1ufMF58aDiAUod059QivjmFbp9W04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftcMtR_I6tT4lO6VUbAuGGbVt_1A8lM3GByqa0gXK6rXw&oe=699D8BE9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtmd5Tx_GuQQ7kNvwG10-eS&_nc_oc=AdlFW5tAe6khc390UtH0vJ0qhNoTTDOldrnXkhhRNsPLzTUn1nOFZqvtn9EXz_Hbf5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstnmjTYJ96aRxnqdebThe4I7fOOfjzF5oor9gn4Hl_vw&oe=699D8E2E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ8tLlOBnk8Q7kNvwHHanFe&_nc_oc=AdkebpTS8FzkZJMr4HmaOccGBFb7_oCoTLg5xE5dTqpVq5P2qz3NbggxENqfF7rlkDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1wWY97Jwmx3FmvktZvyttLPz4Nz4s-tHke7oshTRaNg&oe=699DA88F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MvEKw0CXiMQ7kNvwHrDNXm&_nc_oc=AdnPa1m2l-Cnmwd05R4kjJHwSr4hWpRe6wye9OfplUiu3dLYC9M-5kBQDWsKegbRAcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs90aB2E_sl-0qfs1KjH9ynGLa35uhHVZvrJhGbzk2AaA&oe=699D9CCA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0yW0axBr9kQ7kNvwEwxe2a&_nc_oc=AdkhYNCr_-uTu7YxJ7xty0hSDhECzge_d2joam7nqjQQAAQCSRy2SZtDdv9Z2NyiivQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMnCbvJqSrW0MbKEF5HoauPO0iyE7BUpKZfXwPgEuG8w&oe=699D938B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sngxw0NmvQQ7kNvwFSljgL&_nc_oc=AdlEE3SO0zxqtIdydYEuOngjJ5qFvUBWK7k2k0NnUssUpI1Nb6jvMn3R3K_bTpBgHm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsU0CGrIS3QqfcA9PnUfQYpTTc6QQ2B_GMF1Shx5-ZnxA&oe=699D8C87"}, {"file_name": "TemplateSquare_Experience.png", "id": "858325294890094", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
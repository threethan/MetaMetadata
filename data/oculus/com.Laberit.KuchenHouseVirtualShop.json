7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkkmfvi-kjQQ7kNvwF6SoM2&_nc_oc=AdryxKwVo2ahNNFEMuXWl2P62yrD8wAgzIx_oEtvj7sUQqG3CW0VzIWSu7yJ3huSS1w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QyHRlWip34scru4q5KJjnFP1IscfEwVpfyjMBA5ahzg&oe=6A22EBA9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBN0tUF_zjUQ7kNvwEAtmdj&_nc_oc=AdogAkb49eqB0BB5HT4oQsb9QJ-9TzBMJEAV3drqUl5kqwYccI5u5aVcZ9H-UGFr7Os&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nxroxQdNoJ67UYhMbQ2Rp5mAn4b3xtzVXJENe5I9bUw&oe=6A22EDEE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K2XsxlKy04Q7kNvwE3oklS&_nc_oc=AdoJr25MOcjsSWyojSY_DRWRNuFrDIEJifAvU-L6ouwjhcZ7vbCPbU5Jk1Ji3Qn3lmM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e9myTYWVmbAh7NK6mhO-SHKuXhdSNc8XJIcGVtJk2gw&oe=6A22D00F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVibAYjhFTUQ7kNvwELFbMk&_nc_oc=AdqftncKgz7zTGxFb8VUPwoLOWGIj-9N9zWPHzhGC5uRLBvOFhPkoD-D0omlIPFXOXo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cr1iy1rBf7BvWH7TXfdEi0Y28L7I3MYgwOnQWh0It_w&oe=6A22FC8A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTJ7tK6fTYIQ7kNvwFWOpKv&_nc_oc=AdrEh9ajAknApJunZXdIkCm9qI7ERz-82KTOl5Xnb1B4ikm1-3k1KbV68ZWk6OdVzfQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U1-Vg_X2jsEoecSxceiWaeHE7lTs0GvCGa1Yz9HTKKw&oe=6A22F34B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_myeAh7ij0Q7kNvwHYZ3NM&_nc_oc=AdpIOGP9A6MfvnmT5_9B8fCerQdroHoYqj9bjv9FNABxU64vUPjw5WCIUyc5l_yUUM8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SW9dxy_4BT5EcsegwgSf3f0QwuD-7AJ
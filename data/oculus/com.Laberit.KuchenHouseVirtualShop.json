.oculuscdn.com/v/t64.5771-25/75241703_502525944388098_8684532306439208597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw5c97d9fI0Q7kNvwGjWnt6&_nc_oc=AdogXJKIKF9iEPToY3XpVhdQFAOBSREclkw_k5-Jm_y0ee7BCaN-zyxWKTCdMSQ0d84&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xj0VEX5Nr8ttDgHYDkqGI-JCxIrpJJNtz7fnZpBk6Hw&oe=6A369476"}, {"file_name": "Screenshot3.png", "id": "4070164089748818", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39036693_4070164099748817_4958600411214037724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P85yvSc6ZWsQ7kNvwHXGn_-&_nc_oc=Adqu0rGDyX0FEwehmbb6h_rF7E56I25y15qfYSBPPxlNyO6wVNGxin9zJXDgitur3vA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q-6DPfytHgwTY2bkd8XQiJxcxMJsC1Cs2wFk9cZZYBw&oe=6A36AFA9"}, {"file_name": "Screenshot4.png", "id": "2873024056341024", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031428_2873024059674357_2218767016706941645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m5OP5n_PMsQ7kNvwFkNlDs&_nc_oc=Adphere-_9-o6BwkgbLXWFTcgXVjTsUG-LzIsLoBYf_fsa4JYoLckiEKxLJT5mG09jw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o29ChoRQElRSRaOt256Gc2AFKofJOAg7sqCDRFR4ogw&oe=6A36B456"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Virtual Reality Experience", "keywords": [], "long_description": "K\u00fcchenHouse Kitchens allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. You decide, on the street, from your Oculus Quest or both at the same time.\n\nYou will be able to walk around and interact with the kitchen elements and shop assistants in real time, as if you were physically in their kitchen. You can even talk to customers in your living room or in one of the K\u00fcchenHouse shops who are physically in the shop viewing your project. \n\nK\u00fcchenHouse already carries out interior design projects for the customers of its official shops with this new 4D technology and the customers of K\u00fcchenHouse Cocinas have already assured that K\u00fcchenHouse's 4D allows their customers to live an unequalled virtual reality technological experience.", "short_description": "A 4D virtual reality experience unique in Europe and developed by K\u00fcchenHouse Kitchens, which allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. A unique shopping experience. You decide, on the street or from your Oculus Quest."}]}, "developer_name": "L\u00e3berit Sistemas S.L.", "developer_privacy_policy_url": "https://www.kuchenhouse.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "L\u00e3berit Sistemas S.L.", "support_website_url": null, "website_url": "https://www.kuchenhouse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "961317924486784"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1826111418260092"}, {"status": "PUBLISHED", "id": "195710946075481"}]}, "baseline_offer": {"id": "1826111418260092"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754900400, "status": "PUBLISHED", "id": "1826111418260092"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "
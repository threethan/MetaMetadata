7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YLU_Uuhf94Q7kNvwHsooRQ&_nc_oc=Adqp6WrGdw2-sd7N4hAEAZbQNt8hY9tNqGQeDLaT3dSujzIxOxhUUDTBepTeTsNtCvs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF6AlyyP2VvO2rCKcrBGY6rJO7P1DdMp597mTVmqjfPQ&oe=6AAEAAA9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbqYqn2Hp4kQ7kNvwE5GqVE&_nc_oc=AdpBtAUHJvsiqODCGK_691wCk5GQFB3B3vNt9p0XCXsbFr8uzgX_T-JA2-7WDJT9Xns&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnoJcV0Ix0S1_VgivbdQ-v4osFXXbic_BSwJP8BB8WYA&oe=6AAEACEE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrPwm9Ej98sQ7kNvwHOvcRY&_nc_oc=AdrKklkrpeMZyI_RRrOoSp0h_9BfG-8Yv9eWgQx9rCxJp8YC_Mvn3xaGBrL74Z3oXIc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImiEo3uMc4B2nmzwsfxm90Yxlbgs4388KGH9kYSW8cnw&oe=6AAE8F0F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXehXtKltNwQ7kNvwG8WHu0&_nc_oc=Adq0dBhyMG4MDgtxrnAKS9kvatHkHCsPcFWGtgnbHAk6Mimx5LodZg_zz5dmC3OX_hk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL6FLhHtCDzsgW0mAZnDW2Ja5Z-twPzIszNuH7oxtTxA&oe=6AAE834A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjmbfGUHoOEQ7kNvwHZurKP&_nc_oc=Adp76B9b82hY4Ke8Q4aa3pD_9QU_3ezIhK5m_YNoFyX1-1jeuShKWXr-or_JUHFrtGM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ959iQx-7Civvf9qLSwJ6OU6Gr1exSXE0BYDARsNBWpw&oe=6AAEB24B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xpc94DaNKsQ7kNvwGnPYDb&_nc_oc=AdqusRsKruqhpcUHjSfMgQBst44OjOMdkzXnkC_dsBFh9o1guuYql7_FwvLs4RSpjHk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkV4VQEyIH5wR6RQVpAjw30D0ALv1axK
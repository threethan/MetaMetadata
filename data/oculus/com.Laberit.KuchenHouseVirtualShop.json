h7nNqdWL-cq2fkXhjM_Bp4XL0G-uCsvGUGVIqbzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af17yeBu2DGxxuwLqxG0KIPuPoapZy7OnwQ8szOHJjdQLw&oe=69F20676"}, {"file_name": "Screenshot3.png", "id": "4070164089748818", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036693_4070164099748817_4958600411214037724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMK3aMZpfzEQ7kNvwED2GGM&_nc_oc=Adrp43IV9_04JDW4320lj5sd2HCscWSzGClLKrJMMk4JOp4ZTeR7V5AdtihLsLIOwXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2tsy99MLhZzW8RGszJUfq8yYHxVxvAzpW6HnxuwmiIYg&oe=69F1E969"}, {"file_name": "Screenshot4.png", "id": "2873024056341024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031428_2873024059674357_2218767016706941645_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SJCUqUD3F8Q7kNvwFEcvI-&_nc_oc=AdpDuPXe3JSz_x5EA0R60rMFM0CGGtbbOmpmUFNfJzsmBggFfg6g_FDiQhJnJYIbl9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1ooSHH0QBaQSSfevybrZFPw-VUfbIpJFIXAqpp-ZC9EQ&oe=69F1EE16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Virtual Reality Experience", "keywords": [], "long_description": "K\u00fcchenHouse Kitchens allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. You decide, on the street, from your Oculus Quest or both at the same time.\n\nYou will be able to walk around and interact with the kitchen elements and shop assistants in real time, as if you were physically in their kitchen. You can even talk to customers in your living room or in one of the K\u00fcchenHouse shops who are physically in the shop viewing your project. \n\nK\u00fcchenHouse already carries out interior design projects for the customers of its official shops with this new 4D technology and the customers of K\u00fcchenHouse Cocinas have already assured that K\u00fcchenHouse's 4D allows their customers to live an unequalled virtual reality technological experience.", "short_description": "A 4D virtual reality experience unique in Europe and developed by K\u00fcchenHouse Kitchens, which allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. A unique shopping experience. You decide, on the street or from your Oculus Quest."}]}, "developer_name": "L\u00e3berit Sistemas S.L.", "developer_privacy_policy_url": "https://www.kuchenhouse.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "L\u00e3berit Sistemas S.L.", "support_website_url": null, "website_url": "https://www.kuchenhouse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "961317924486784"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1826111418260092"}, {"status": "PUBLISHED", "id": "195710946075481"}]}, "baseline_offer": {"id": "1826111418260092"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754900400, "status": "PUBLISHED", "id": "1826111418260092"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8325927724149218", "version": "2.00"}, "id": "509571100106855", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", 
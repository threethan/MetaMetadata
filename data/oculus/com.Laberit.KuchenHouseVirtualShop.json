7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RUVUIFOpxcQ7kNvwFOs4i2&_nc_oc=AdotBQYxhix9KLMWYTwVEoEbcJAvhRrbYHfgvmicxpKOw6pLjUW6oLtb0_whvQUFYf4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zR6-a9Io1cjfps1SSVXh1rOfROfCo7ABGwWiDjsM9OA&oe=6A11C829"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIpM2Q_jUsgQ7kNvwGfE0cc&_nc_oc=AdpszCcgQMv00O914Xx3ouhOGTr-VsqipAGMv0KJGQBc7TH5pW0uPYlLXCWcHF2IYbI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_x8EzpTEDSgMBVvWtYh-Gesowh4LbJrhFq41_W6f9PQ&oe=6A11CA6E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIhF0N4Sb-0Q7kNvwGyQ9bM&_nc_oc=AdoMzLS5rXOZxQ9A8hCt-drpQy3aTQCwk8idK7sn52PwFl_Js_OUiMQllvX9pCyAVEw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ls9f3JUbsmnb-kwpE2omj6gj1YMU0H9GSflEEonDlsA&oe=6A11AC8F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOHujbFvVbAQ7kNvwHRg-gI&_nc_oc=AdrIa4CtZEJAURJQo_fcZLfqh9Q5IBzhmq4JmcZhAeJ_kHH37TWHqizgTu-xFP7nRC0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vhBsgZtMIJjpH5ARmzHqOIYZxvMJMc-wKNmQZ9novsg&oe=6A11A0CA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPEmJVFikUQQ7kNvwEYk2YN&_nc_oc=Adr9EyULO-YS8DyY3YvN50CvAigfCurQquhdtSRJNuD1YECNCb8SncoZEXsXeg98APo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57zwf-POITTRxiXfKwzLpiIu4sSGOp6moWDGN8PZhGbQ&oe=6A11CFCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK7W_AyE-_gQ7kNvwHD2cH9&_nc_oc=AdqQHHcFA7XDJUdNB7C_SlOvoNSFz4FzhN1ggCU7AoierF2PinCBuQ7wTaIQT2IC_hg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XkTXddYdhLJkXb6RbYUyj-zds9ACkFz
7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5-MtJO4gdoQ7kNvwH8cPn_&_nc_oc=AdrHxMgdEdkhNE5mGkLZOS6Nk7sxjxRSeapyvH66i1xU9sCSnw7WWaAYw0SeOLp8vPk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bxeEGMen0W66GIEtCfu45At7ri8LUcYcG0kept7rwhg&oe=6A468429"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnkJoy0fkWAQ7kNvwH-K-nm&_nc_oc=AdrgGvhsfysjvfey3e5Od6hqWa60dVKXs73Kp6jxpyk8e_pV6P5DJMEPrFxWYWWepjY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t2AXpnnjCi4DAka-T4UxkQ3w65fy02A_NMXKfOpqLgA&oe=6A46866E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn4Jz-RUgyoQ7kNvwE2L0ya&_nc_oc=AdoVdsmVI2OoE53s1MqidOMPDUyVjYQr2nC33T9wWWfi_0pjX9BUfY90S8E1XXUiPKU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YALB5TgOfUUt7QoC3bWWN1A71GJPOAW0KruPtG0gqPQ&oe=6A46688F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTUTNm5LoQwQ7kNvwH_ywQB&_nc_oc=Adosw2vzs3iZuiJChBiCTXAmjOe_87RKlJWwPLjvKQCoZ85LvZhX-AX0dgGcz8qf-cE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-92gxS81uZmC4GPNsBkRE_aKvLH0g8FxNXqJ4_tbGaQ&oe=6A465CCA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGktR7LOZNMQ7kNvwHS49XX&_nc_oc=AdqEif6HP3E37SlKqpajdq031BvDRvhDDH_Jw1YX_KxV1DZUtpV2izHyQnrQz9Z6e-c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q_DVFDwpJvRpDjIMRgwyHn80cjcqEZ0tQIqnhS-b3Tg&oe=6A468BCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUtxMtK8suMQ7kNvwHrxA9u&_nc_oc=Adp4oieCEW1fYBm515oGOPZkRUdSiyxyqR_O-7ZCdG5uD6dp_EFcQYOrthkOE0d3vVs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k5bDTd-HRkiXSKDungCwbOpvJflB1P2
t-atl3-1.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAg6Th7a_McQ7kNvwF_-Oky&_nc_oc=AdrcHjwmd1f4c9vIl7ZLJlen6x3ZfnsCUQxTQZV9xtDlOoKxAyGI0G45lEgo-6dEl-E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDVzXa-SoeObCLLFlHyuX9IN1u8QU4OQKNkqv2uzvpuw&oe=69C12469"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZBridyzGa0Q7kNvwH7_3nv&_nc_oc=AdqGp_2s7tUDRdkEPVqFGovBuKXgNia9wCAjvXvGn-5TEmvQRXa-oM9AMyMIAufIiLw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK9U8zigpmA4z_eVtHTkr00PBg_i-u4-SHD-ZsGpTj5w&oe=69C126AE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUa-RDK9ChUQ7kNvwEWEV2h&_nc_oc=AdqSLqnKtvZ5C_oB5IF1czDAgLjGTWVGIh5nJkjDou0AnGVFrg20XEUg2G_lEMUGh6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyISfrfk84qxt94hwczAswQeWCWqjdGv2BsRQGJnmeggA&oe=69C1410F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg4Glg1zSHsQ7kNvwEI-_Pl&_nc_oc=Adoq0He3MgsSrYNcGDbXZ4gJn0TRD_3EzOMbPjdwr6j7YBOD_5b8itUEO168hbVUAys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2hUO2YScBtvFe0gKcXcCrrEALuQEF2XJMm6xrnBbE5g&oe=69C1354A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcPKJiO9P18Q7kNvwFreQ_g&_nc_oc=AdoTp8KM_BhZ17QyfwPEjJrszmDskCShYpLFNRCa0IduKYIsFuEwCNO82WE6mUY7xlQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqmUbpdHrFn2teKohtu8vRZleLalaxo6_1pbybH1NaLQ&oe=69C12C0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9HJDUhFxzgQ7kNvwH5FcrS&_nc_oc=Ado5-sENEhFESUJeGNvTapl33G98yYTMcISigLONClFcPC9agnU0IoNvWzGWzbiG3Ns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_yIA6ahypHzBcXaW8lbvCC28c3RXQJw5kKAEesZsypg&oe=69C12507"}, {"file_name": "TemplateSquare_Experi
t-ord5-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwmOs2lQh-AQ7kNvwFtIvFN&_nc_oc=Adkcvqe6UuWCnfDTOIefNzLUOdxnyLUVDKc_Pozb0XQ7AqoZ8jyVAFM8m4s_OHA80d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTmFDXd20Sp1xDTvFotV1k3RIGow_wApxlL0XvOBxLZA&oe=69AC0C69"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGiugzvpT-QQ7kNvwHcIGY4&_nc_oc=Adny9vNwNbzRE7Pi0lSYar9jZLHvY5M3B0DFz5cf7F5uYOhlbxoosRr7tCDgFxRP8X0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwP3t7B7WrCH6aWJJM1MWZPbi1W2k1-pY-h4WUtngDO4g&oe=69AC0EAE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifIX8VZ5WmQQ7kNvwGR6YjM&_nc_oc=Adn76L68alvBwLv8k23QlttTBuhP8-Lt-yYrjM4N4QsHiyorcd4VeLkZrOpdrvrhgnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPY4dxJGGnOx6QDF_d8V-yKfUzfDH7ejxjGfL1FBkZ-Q&oe=69AC290F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lHeeCDytgsQ7kNvwEqIEJs&_nc_oc=Adl7PAcNdLQIvaDe7DXeQdC9RS60043kU0md66aORvNmHCisHA1YTGILtS1FYAsA1aI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHg7oWialD0xA8fq9oQrhiPcQOObefGUxuQkzrQPnbSA&oe=69AC1D4A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwloPVdRev4Q7kNvwE42kv1&_nc_oc=AdkxSkNYSJb3IOyyKfTG7V5NaVYdqQbYgH-e0rH_cEyYiPXPBDdke8QlM623kAUjWVw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_Fq8G4S6KQF8eq7fTWLhOydGBD6tghhaCZqeOfymuUw&oe=69AC140B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LchLTFvu3f8Q7kNvwFkkFYG&_nc_oc=AdmwcgBBne1qdgXKTp-7UP3V7h82Ko2g7ksVObT3wvJ6EkLmUYVaWxcm84CkAwzx0F4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8o1Vlcw2uOxQa4u7GnGFRXmyLhyuelWZCKHIEYMdm1A&oe=69AC0D07"}, {"file_name": "TemplateSquare_Experi
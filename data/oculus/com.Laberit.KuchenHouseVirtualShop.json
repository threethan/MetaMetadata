7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5pGQKT7-TwQ7kNvwH3FLqB&_nc_oc=AdolDmnWvPYaL9hqLtctDw23e0-PG049E5JToAW7Jp6z8n_pAR8wyEFwlUkpVFAVesw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs_i62A_wmGQjPcZw0lsLrN0eAauNQgirH7IyZXM3i_g&oe=6AA964A9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7u1cl1WlJYQ7kNvwEwthyf&_nc_oc=AdqkIGomjDjHmva71EpvslQEqZjKXHYOL0mdpu4eOKYoqMYi4YEfnzsEwHoVfIM0Nog&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_o9aSXDUk0UBabg39etKEUC-cVknpWK6KDWi4gIvobg&oe=6AA966EE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFewcs3LY1QQ7kNvwHY4U0G&_nc_oc=AdoFjRb9vjcBlueAG8dlZzYlLg6_h8r21IifHyGR0ZYR5vYevUFe1-pOOxlQEhhWn7w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKke5E6vR0MMG_-4YH5bZgzsurOwKuNcUu0sQj-Jn8W4Q&oe=6AA9490F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXIHEt0TjfMQ7kNvwGKqfme&_nc_oc=AdooMDEVhnAjNQmrk7Jw8ZTo-vBA4N6C9ehGWvZTNsngVXvQorQynR5JfZFCAwnW-WU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcD3Sw8IT_86mSHtwrvTqCkzYyPD2PjGNA7cZzD8ouUw&oe=6AA93D4A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFWmu9JicyMQ7kNvwExoM2y&_nc_oc=AdrkGieaOpKepRt25-MM28R-KOzbykRrB3dxZ2woslN3fGHgBUlvdmoEK9YvAQ_kp0c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3L4w4ZdKgoufHsA8o_84tuMa-KsdG4egGK2UNffHsfw&oe=6AA96C4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gBS4V2PWqkQ7kNvwFwlTwU&_nc_oc=AdrQKLurMVhbhqMDNM6Q2NjZ4EJudK2EdctXcmKBh2neTfWP-l07PjHLrj5cDyqANQ8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU70WTcTUlTONpLn_bRQPHUwwFuWADun
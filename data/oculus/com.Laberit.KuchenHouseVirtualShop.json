710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6Pib_DuBNEQ7kNvwF0VBE0&_nc_oc=AdqUya6S0YXAtDr6ZrqyAf5-qGHfigpDrez9yuatriU0i1P0IUHTGu_bpcyE5FEfkHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2e_vIsaaI8496vm7LdCA_7K6Czh6UB8sjkkZebLmsMTw&oe=69F09A69"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWkaRc9VxLIQ7kNvwHg2S_p&_nc_oc=AdrW3ZgRPfYUPcEAUNYhzt0puR91uvL3Lox9whR3muDSZcVNZImFDpPRaNeQUjab_0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af36zScLndPzu-7m2Klyf7oem48d7DGfSi7vvxEk9ujTOw&oe=69F09CAE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_sF1tvnPNkQ7kNvwFuql9k&_nc_oc=AdrFzMU0W7W5qDklOW8IDhS1-aB8goq55OFGWb5mMHJDMmCMSu16rWElPBbdtY_cXVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0zrFeGRuUtzYv_T1DwpUHmOMjXKXoPUbbMQ5mhTP-5Zw&oe=69F0B70F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzO3SUTrTzUQ7kNvwEdyTPx&_nc_oc=AdqJKM7Cva7FuCnIths3yBp-wF03n8da8ees9pVENyaJgCsREJpMCWFIglIv4JfIQTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3iZS1F3KF8IuirRNFwfXHgdjU9w2bMGANLOGT7zcRvcw&oe=69F0AB4A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HP7x53eKYp0Q7kNvwH6u3Li&_nc_oc=AdpCF3eyvxPDgWiS2dNklGp_IvNmvZqOeIlxzRX7QbAVZA8cMU9YaP7HFOL_ZkP7APU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Jg89gm9AoJA75jtLN5OPMvbTAUiwpWd-gvBvK4KLpPw&oe=69F0A20B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPA1yhlcuzwQ7kNvwGEOLUq&_nc_oc=AdqbyBHMzrez48HBdGBieKe-UbgimK4zTIfaCID5cWQBQaTFKcQPb0LXzG2Yc2jWjx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3LPUJIoEVa0lMRWTTCn4vkTjmBrKw_fkQukEBwW5vrMQ&oe=69F09B07"}, {"file_name": "TemplateSquare_Experience.png", "id": "858325294890094", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
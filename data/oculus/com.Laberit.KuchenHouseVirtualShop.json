CC8"}, {"file_name": "Screenshot5.png", "id": "223481729654293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_223481732987626_5855929950328641515_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug1I293TsPwQ7kNvwFLRSMC&_nc_oc=AdrP4B24kt58DDv2GT5LFLigdz5VH8LMc_nIkeyRSfaj_h0qRJ0Rq5oPpxaCJJmChjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD9_uj3iUDY_wB9191kOHfVIoV-bh7yZI36Gq6GP9C1g&oe=6B00546A"}, {"file_name": "Screenshot2.png", "id": "502525941054765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241703_502525944388098_8684532306439208597_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khHMqYhkBU0Q7kNvwHv3nM5&_nc_oc=AdrMWbA5dLmsMDy-9ZxVmhTdFb76hOuzcjbK40ozEW1Hv0uq346HNtOy7cv58NcCc-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThPsrHCr3iQz568ZbHdxj_DNQV4cDkWfeDVhdMHddNmQ&oe=6B008236"}, {"file_name": "Screenshot3.png", "id": "4070164089748818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036693_4070164099748817_4958600411214037724_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AIgOjDpNOEQ7kNvwFrwYkh&_nc_oc=AdqicWZTtsaCAQ_sme_vunh4qX-T3N3Mj_yHYbPCz5Ffc8Ie_nTK4qsSeIrt15EiLTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3ZEMiwmg1-TxyTv5VgHOgfeu84MlCcyegHffEmuePtQ&oe=6B006529"}, {"file_name": "Screenshot4.png", "id": "2873024056341024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031428_2873024059674357_2218767016706941645_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwlAXbEHolwQ7kNvwElLHCv&_nc_oc=AdojrLcwJUyQfpk_icSqBTXI8UYr3BN-cHQ6iEDYQdRv76Tfffx0dc772Hd1kUc229c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyPIMTr0uqVIFzJhh2hMC2DAWl-CBE2f92xT4QDOoxCA&oe=6B0069D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Virtual Reality Experience", "keywords": [], "long_description": "K\u00fcchenHouse Kitchens allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. You decide, on the street, from your Oculus Quest or both at the same time.\n\nYou will be able to walk around and interact with the kitchen elements and shop assistants in real time, as if you were physically in their kitchen. You can even talk to customers in your living room or in one of the K\u00fcchenHouse shops who are physically in the shop viewing your project. \n\nK\u00fcchenHouse already carries out interior design projects for the customers of its official shops with this new 4D technology and the customers of K\u00fcchenHouse Cocinas have already assured that K\u00fcchenHouse's 4D allows their customers to live an unequalled virtual reality technological experience.", "short_description": "A 4D virtual reality experience unique in Europe and developed by K\u00fcchenHouse Kitchens, which allows you to enter a 100% interactive shop and see your new kitchen, bathroom or dressing room from the sofa in your home. A unique shopping experience. You decide, on the street or from your Oculus Quest."}]}, "developer_name": "L\u00e3berit Sistemas S.L.", "developer_privacy_policy_url": "https://www.kuchenhouse.com/politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "L\u00e3berit Sistemas S.L.", "support_website_url": null, "website_url": "https://www.kuchenhouse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["OCULUS_TOUC
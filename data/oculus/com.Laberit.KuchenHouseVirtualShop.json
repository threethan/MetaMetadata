7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj_YKI6ck_8Q7kNvwFlc4m4&_nc_oc=Adribwp_sOiz-Z2QUZmGDLyL5KpdNNk53x6jahnOGRfVLvSMZHEVRROBzpR-PhfpKhc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv8vlhqsPKE0_SOuIfH2yMPPgxVkGB2x1BMSygxZmDmQ&oe=6A7DAAE9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4mWAtyrkhYQ7kNvwHBQpul&_nc_oc=AdqT3yiwpCaEeKnizg54KFUW-mEKFgNvaC_cbFuhtCWCSc5MSS3vM_TTKvUmXtb_L_A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJFSks5T_i4yDr8WtR5wB9tGaDIKG6S6PslDh0keqQ2w&oe=6A7DAD2E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J66kCyuGOzgQ7kNvwFuhT22&_nc_oc=AdpyGkgbnpFeL7kR9shJYjfYoG2Cnlg1qh4GCsDSsswt74gPu9Et57TpYhjQk-19dFc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQXMCeeil15zcS0LYaQDGEX-TAnXv19mXggSGijKic6g&oe=6A7DC78F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtnDwOmATNgQ7kNvwECB1UA&_nc_oc=AdotkShJZBc9ESHY0kUbyEd-IMTDs9tWg3c9qgK0xz0FeTZZ4AZ2abFqyfqqsKrhCEE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeNMN2UGwBs3OQwraaixxcwlHNlXlboVnTa0wqLfu3gA&oe=6A7DBBCA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0E0UWyAGIIQ7kNvwEbImOv&_nc_oc=AdqP20hPX1xqQMTDN3XFhDIrXOrwnCrNHbx5hkCoSDjgW-P2zgABBS_osm-BnJ1SJpw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOW3fHSec_eui5-X2NONyr0LNGwX13RBV1pbAswIa7Yw&oe=6A7DB28B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLaO2enz2_kQ7kNvwGB2eeS&_nc_oc=Ado3PsRUQSddjPgXRGIzD_oGitqZlLMYSGa1LLalbCIMxJRl2tpGZ0klZxy3ooUvDWE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm3BV_gQyGWmbxDliBIPA2Syjv0tVfYl
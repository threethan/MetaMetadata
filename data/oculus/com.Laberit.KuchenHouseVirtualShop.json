7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmLL_zBBGyoQ7kNvwE617Z_&_nc_oc=Adr9hSsU9meY6HY9V6VV6yjVc6kf8dyj3V2kdAHAiLnxJ6da1wlQrMuwdeTthhaKb3s&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ZGh52wLt7sEe9eTphXUWgbXpVjFAPmnSZSlD3bwujw&oe=6AA41EA9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd7qOw1GlBMQ7kNvwHjzXni&_nc_oc=AdqeOoGP5FvaxPwSSf7gGjQUebyRIgiCYY2G_7JvI7en21PdPlyLZRS_WgECkOzE7MU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK8lSmMZqimaLDbfd1GzDOJ3IV5BOv1GuGNvlWVav2Dg&oe=6AA420EE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td_de1Hk6bAQ7kNvwG_Wxjr&_nc_oc=AdqqV2_agIOqzac_MR8AkR3eYBlO6gcSLroKjVyYVZQSSjXzFlcvJA-KAM3CPVoC2r0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQjJh2jtk8H3hS-mOQ0RkwGdXpDIK_KcbOUUgvmO7UCA&oe=6AA4030F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqDI0Bs0Br0Q7kNvwF0XFMO&_nc_oc=AdoJY1aSoZ8lXXP0mf7rMIuV1uQGhR4-zAzm9LhOrat1YR6cQ-BlpS-2odrG71oom4g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz8YFO2ycOQlR75ty1MbtJnEe3mjsEZip3dnPVeBWsRg&oe=6AA3F74A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PBzT4AyiTsQ7kNvwF15KIC&_nc_oc=Adq2nmlzx2kEF6bcIJNrNcpRQnPzODiHq_6oh-ZKCqREYpuzx2MPpLQMoqoQ2GMhsxU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbS8mDizC9e5X5HiDN_xYcO29V5WjnjdjbyDQ0FfB2ZA&oe=6AA3EE0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS289Kz2d90Q7kNvwEbxZN5&_nc_oc=AdpG_xqCqkRBRTz8IyU0j0JAQNcYctuf96gpaYe0O-mnGRwxH7QD3fnmxWbv-pcWS3w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_wyoVmFMeK1QVb0_DK0aQd2gElwg55O
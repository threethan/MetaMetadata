710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mIgMYmL8BQQ7kNvwFRdU4A&_nc_oc=Adm14vkwTogml5OP9gR64JLiUR7o4QES8mb-MnBs4iKRlux4Fg1wxDdq-3cmcV-LE58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvVArvrzoFAoeafpEYO3UWDe1zuwTepIr4tVV4862zmVQ&oe=69A6C669"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY7QrueQHe8Q7kNvwHygX-J&_nc_oc=Adlmrp1-PA0hHlgOZu05beWv_OUqaLa1SZxLQn4C_us6ABwGGAVsCQHghGF6fpZFC3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxlgYwlutEQur8GyxYKMUDWaOFR57WiPTMjS5081e-Dw&oe=69A6C8AE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l016Wj3sUL4Q7kNvwGJTMDi&_nc_oc=AdmAVMJUXm2_-uBp--X7XdpsbU3dkDWBofG34tH4GiNkgFrTk6-WeXOQavWvYMxuimM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhVlkMYJJsaxuz14VnCECRsoAGKtkrOvr7sD-Bwfea-Q&oe=69A6E30F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61tC4dNhwu8Q7kNvwGmv5fn&_nc_oc=AdmwynMkXa9LBi0OHV4Q3jCFny5GytJ9neboR0Bq6tgYEJMfNQjO52cVBSm4C-1RiV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmgZ3QnSOWdc0vHet6BTaWKSbUh4AVFMNhhNXnhDRIWQ&oe=69A6D74A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h1ehnSF5toQ7kNvwGgkQ9n&_nc_oc=AdlhbNBJ9v6aJ5HxTCZDBaE4vuOsBnl3O5vt0GIul9BhqlX8qzR2IUA5ZwYtXm1Fayk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvS6xMwFDSWrTDkv77ZwhNMC9EWRaH8_FiYEu5MeJK8_A&oe=69A6CE0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcxrjjkOStUQ7kNvwHH5NvS&_nc_oc=AdkHeBCiNQMJJhVj38-PP-8AvtUNR9o4HLa55guz54aTUwHW_a5o6EQYO2cQARsgxzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUSUsI83M4LtEA6M_HsurvIE1Cjzzl9i_4rfVbbtViEg&oe=69A6C707"}, {"file_name": "TemplateSquare_Experience.png", "id": "858325294890094", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
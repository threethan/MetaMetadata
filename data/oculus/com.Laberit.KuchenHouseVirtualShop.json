710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwS6cIMgfmcQ7kNvwHnvwj6&_nc_oc=AdlSuoYMl598YOw_iJcwymwdRkxB1miP7ByCxIlXQ-PBmcDsi1EzvVRpmq24a8s6Gvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4knweYT98F3XdFw9uMwaG3Elv9jG5Sm3hsK1aptuDfw&oe=69999769"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzskRneSODEQ7kNvwH0g454&_nc_oc=Adk_tEgD2uoY1hM9PbTqmiuyGGArIpWijHqoMl-DBVV4SqleGUaDfoo2EbwEDfBU8Bs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAKtXdsjtREy6VIIjzTi3-RsQYtQ8NlE2aRT8QuqGnbA&oe=699999AE"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiKmQ5fqURsQ7kNvwGbND9h&_nc_oc=Adlg6nKJ3eAmQ_4xP0oKB6yjyuSY7qdMm4RojdC9XuLGpVszGVu_2b556lWf6qE78Ak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOHPFiCsxX21wkMFlpaSwzucGnRdDzCiL39-_SQcrc8Q&oe=6999B40F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX6Mxrhzn90Q7kNvwH3Z_Vh&_nc_oc=AdmCK0tOkEmwqPE6tO4xFMHHafwW5yxz19_9hQyrMmYBNJ1vpO1L481RTMKxB1HsT8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2W8Hnoh64qPJg1vKAZWSoEMCKj6o-pL1Ki1Sr8552Gg&oe=6999A84A"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX0NkteOsGIQ7kNvwGLMRP7&_nc_oc=AdkSOazT1W19iaoOizkQ14paujaCo9PryoN2FNkCA9647GvxGrlQCb4xQODXBZ45G0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftW8LoZkJ6qARigANT-SD8lV2jAZKe_Lji7onVp925gfw&oe=69999F0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA5Vkg18tzQQ7kNvwGwAR8P&_nc_oc=Admlebecmq0ifMy7seU7649BLeFx24HOjQdH9GJVAPJXsc9yNfUJLMBu2l3Q5hQLuWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvu8FNXKpn0_P3sKfbKLV2s0XnYqDhJNkq28o4mC-ORRA&oe=69999807"}, {"file_name": "TemplateSquare_Experience.png", "id": "858325294890094", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
7615502316", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_4w4r41OdcQ7kNvwGQutx8&_nc_oc=AdpYQWcPjLXvZvDj4SAOWFgFk3w7TVqypId7qbvVUMIF0qwbv5OuK5sfghL-G8slxLw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_osJk-JqollWyWTpsQliNMh5s7V1AYXuORPGn-vyB-HQ&oe=6A395529"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD2fE2Q5bpYQ7kNvwGXf3ex&_nc_oc=AdodndmXo9Xe_FJIC0aX1d9nByYLMlG4gsctUVM8hlE61qpg38E5whnwfI7_4Tw0GhQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jBaRhwFaOr1G1mLkn8ctqaD65YAvQb8-ULugnU3-aLA&oe=6A39576E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97Z-VMdI3LQQ7kNvwECKAUv&_nc_oc=AdrWxfQHol8JgPnz7Bewf5Z8Fm6d4qwXq8gdNR1v0rE9xX1WDJLMcdK_3CzB-r4BlL0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bPg8URCTC9GpHUBn-6Wgf6Q-6Z3WhkP2SGJWE5AoFHg&oe=6A39398F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RODsy8t40QQ7kNvwH6IQMW&_nc_oc=Adpk6ifR6oxvaPC9WIehr-0k7PdM5dU8FErDW7Uv3NQias6vm9-CijP8aqVr3HD9Gbs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ue90tzXNi9Qo1Si41oNOJJ3xvoTqXnt0LwJgalVBZhg&oe=6A392DCA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fhldzmw8P1wQ7kNvwGJElR5&_nc_oc=Adqp9mbvFUZFc_VYk8RwGgAuy-VW1FuRXLwW8ZgWkt_8mQCOilHN9F9doox86V4UKpY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HKr4EZdY-Xlk2Y56T1Yc0ZlIAnHvEVGmPn2kz87Ax5g&oe=6A395CCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIXUsvZoSkMQ7kNvwHnykTn&_nc_oc=AdoaOjEW4-mC0YRUmm65anODSdoLtK-A40ejkMGIqvZbODyZNUsOvb9V9GGraWhIExQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vh4nLmd5bVR5PF81UQ6KwlOp7LM4dbh
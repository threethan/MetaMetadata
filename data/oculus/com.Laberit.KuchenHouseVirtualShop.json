t-atl3-1.oculuscdn.com/v/t64.5771-25/38982701_329717618835649_3595264917710667698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ9_7KzLjrgQ7kNvwFrmb6Y&_nc_oc=AdlJj01WIdvh7kjZgmOKSzhoK7rKbKsKwtfhe394z4GPiUjTFx19er1FfpGXPtSkvjc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXhtDALkVa0b5Mu-WhU_9kO63p4GUBeocjwSLdtioXzw&oe=69BA8CE9"}, {"file_name": "Screenshot5.png", "id": "347149060193881", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_347149063527214_6506781264827073999_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAuIkBCqCeIQ7kNvwELKCsu&_nc_oc=AdlBVK8vqvyX_X0u797vmH1qZykVYF6vrDzFjM3U6KSmVOhJXW-QAUc2U7MDqy-fpfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9Z0Kx5HN4nnNl7qtTP18pOLf9NIhrNMFI4ra6dZPVKw&oe=69BA8F2E"}, {"file_name": "Screenshot2.png", "id": "341492830983682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982499_341492837650348_1431390971110318647_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vu9qqd2zNYQ7kNvwHgexed&_nc_oc=AdlwTCoCknqTU4atJDKdLZ0hsnac3H0MwtVS_olGJkYOznEHPV0DUI86JLGLLJqUctQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQ7M-fJIIpKvpGs38QWfQBfSoKtD5wrD4EOYWy1A7WRg&oe=69BAA98F"}, {"file_name": "Screenshot3.png", "id": "360134722291902", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031440_360134725625235_130902617701255663_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyekakhgGxYQ7kNvwGKSpZC&_nc_oc=Admf4uAdF794EZVz4NkP6eKuLgxspETD_S9aSq3T3Pf35Bl8SlzFDWwA_lQ6oV7Rwnw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfznTfFlpNYbj80jVvOKI54JqyyXxVGDi9tlzv2dwhOvtA&oe=69BA9DCA"}, {"file_name": "Screenshot4.png", "id": "674341743965659", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036651_674341747298992_8873345438955638229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu6li3_oEfAQ7kNvwGy9FcG&_nc_oc=AdkkzUIHFcJZy4Ocb_go3kFNd8OHT2OBOxmLordBH2f_HRDUyzenFvVXAL7BqPdaj0k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdICCJ210KreZeKNWN6kfdm7d4_n1RT2k4m2h_QVXVxQ&oe=69BA948B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "KH Cocinas 4D", "keywords": [], "long_description": "K\u00fcchenHouse Cocinas te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Tu decides, en la calle, desde tus Oculus Quest o ambas a la vez.\n\nPodr\u00e1s pasear e interactuar con los elementos de la cocina y con los vendedores en tiempo real, como si estuviera f\u00edsicamente en su cocina. Incluso, hablar con aquellos clientes que est\u00e9n tanto en el sal\u00f3n de su casa o en alguna de las tiendas K\u00fcchenHouse que est\u00e9n f\u00edsicamente en la tienda viendo su proyecto. \n\nK\u00fcchenHouse ya realiza proyectos de interiorismo para los clientes de sus tiendas oficiales con esta nueva tecnolog\u00eda 4D y los clientes de K\u00fcchenHouse Cocinas, ya han asegurado que el 4D de K\u00fcchenHouse permite a sus clientes vivir una experiencia tecnol\u00f3gica de realidad virtual inigualable.", "short_description": "Una experiencia de realidad virtual 4D \u00fanica en Europa y desarrollada por K\u00fcchenHouse Cocinas, que te permite entrar en una tienda 100% interactiva y ver tu nueva cocina, ba\u00f1o o vestidor desde el sof\u00e1 de su casa. Una experiencia de compra \u00fanica. Tu decides, en la calle o desde tus Oculus Quest."}, {"images": {"nodes": [{"file_name": "TemplateLandscape_Experience.png", "id": "1207820729685690", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001699_1207820733019023_8611322447486291117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndxCnrC4wUQQ7kNvwH-pj2q&_nc_oc=Adl7yTOab5IAii7W0oiNOopxMFwpOc69vibQO705zvUpwl8wdjCLyzqic7qJk_y9esc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAP9NiVZg-mRwmBcgaBkjfF3cd3jCLfaQu4XspH4OAsw&oe=69BA8D87"}, {"file_name": "TemplateSquare_Experi
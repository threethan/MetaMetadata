_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGwU29XN5WYQ7kNvwEuUpU7&_nc_oc=Adlamk7udXBF4bXu4uG-nn1e6tHyyyUz5lcvFSAf-EagDc6EKSQs-iKVOh34WppUlw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPLbOr8FQM-duyzm5OXdPd055wd3rO9oszh2KiZppBEw&oe=699D9B44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DecoVR", "keywords": [], "long_description": "This app lets users visualize models created in the Deco Design app. The licensed users can edit their furniture projects in Deco Design, and pressing a button in the app, the room model will be transferred to the VR Device via WiFi, and navigated using a teleport model.", "short_description": "This app is a companion app for visualizing Deco Design models in Virtual Reality. It requires a license of Deco Design software."}, {"images": {"nodes": []}, "id": "215028304023359", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DecoVR", "keywords": [], "long_description": "Esta app permite a los usuarios visualizar modelos creados en el programa DecoDesign. Los usuarios licenciados pueden editar sus proyectos de amueblamiento en Deco Design, y pulsando un bot\u00f3n en la barra de herramientas, el modelo de la habitaci\u00f3n y su contenido ser\u00e1n transferidos a las gafas VR a trav\u00e9s de WiFi, donde se podr\u00e1 navegar por el modelo mediante teletransporte.", "short_description": "Esta app es un complemento para visualizar modelos de Deco Design en Realidad Virtual. Requiere una licencia del software Deco Design."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.acaes.com/decovr-privacy-policy.php", "developer_terms_of_service_url": "https://acaes.com/aviso-legal.php", "publisher_name": "ACA Espa\u00f1a S.L.", "support_website_url": "https://acaes.com/contacto.php", "website_url": "https://acaes.com/deco-vr.php", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category"
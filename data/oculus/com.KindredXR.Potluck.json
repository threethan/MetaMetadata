=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf7zZHfR3_p4oJgMNLOiLH3iFz-s7XMW5rddh7H706Og&oe=6B05D874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Potluck_Cover_Image_Landscape.png", "id": "1253151675910744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391971_1253151679244077_8922243029079456651_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjy50PCv8WcQ7kNvwETLkue&_nc_oc=Adr_KUWmtc7pafP0QwruTORma1fmEAU1TTo17nqj4cOOsWZ6i0qnJJau2OtmS7oLoA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw-GcWG37qjEgZSSe5t8xRNTmiqCKgnsXYq3HWtWijbg&oe=6B05C2E2"}, "display_name": "Potluck | Early Access", "keywords": ["Cooking", "Chef", "Travel", "Food", "Recipes"], "long_description": "# Learn to cook with chefs from around the world!\n\nPractice recipes and learn about different cultures through food. Potluck partners with real chefs from around the globe to bring you hands-on instruction with realistic virtual ingredients and tools.\n\n# Access Virtual Chef-Level Tools & Kitchens\nEnter beautifully designed virtual kitchens with all the tools and ingredients you need.\n\n{1309596630232758}\n\n# Interactive Learning\nCook with renowned chefs and receive real-time guidance as you complete each step, with feedback on your technique and adjustments based on your skill level.\n\n{796904005958811}\n\n# Food Stories\nLearn the history, traditions, and stories behind the dishes from chefs who are excited to share their culture, making the experience richer and more meaningful.\n\n{1352874509481766}", "short_description": "Learn to cook with chefs from around the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.potluckxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Kindred XR", "support_website_url": null, "website_url": "https://www.potluckxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
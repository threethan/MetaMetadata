68826897052_8155229199241420453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVrBtxJWoGUQ7kNvwHA7_pE&_nc_oc=AdrY5aPfOVQeRdBT9DDA0cS36CZKbci8O3jB455Hqgpfr0GlGzGXM08qoMKjbHjXnpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KA7hUVgjWkVZLgje3qVC3ZcT3JsrDuJwt2X3oZ1IeNA&oe=6A0DAE02"}, {"file_name": "First Task - Step completed_2560x1440.png", "id": "1363251734687413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393545_1363251738020746_5344844993909225465_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwJGBayEB6sQ7kNvwFWvwcj&_nc_oc=AdqqHtS6todxdg7Kl7Ax_iL7k_y17G9wbV975zeisk2zjxsCYjXZfZ7GiDQedkCRUkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74uyUlsis1mALn9nh8yczx25VRzomPLM1c3gLoZMhdsw&oe=6A0DD530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "H-Verse", "keywords": [], "long_description": "H-Verse is the solution designed to improve various phases of business processes, with a focus on innovation based on specific needs. It is a product of Hevolus, an international leader in Extended Reality and Generative AI, specialized in creating unconventional phygital experiences.\n\nWith H-Verse app you can manage all the different scenarios available in Hevolus platform:\n- H-Store for retail, virtual shops, product presentation\n- H-Onboarding for new hire's experience\n- H-Collaboration for training and education\n- H-Fair for fair and exibitions\n- H-Project for real estate and interior design", "short_description": "H-Verse is a cutting-edge product within the Hevolus suite, designed to revolutionize the user experience by blending physical and digital elements. It offers customers a unique app for shopping experience, expands exhibition space digitally, catering to the presentation of complex products effectively, and much more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hevolus.com/en/privacy-policy", "developer_terms_of_service_url": null, "publ
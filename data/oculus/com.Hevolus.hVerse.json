68826897052_8155229199241420453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz6pdOaVENUQ7kNvwF_BM8O&_nc_oc=AdqJfQ43Y9E3zOtSBwhekH3CUKL99VMXucIMCe6VNnWI2jy2wFPYCHYmjtv9JDNi30U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZCUWx1i3Y-zZgDN8AAvOmqf9TpdUFYtpqCFYPcJoIKg&oe=6AA7ED82"}, {"file_name": "First Task - Step completed_2560x1440.png", "id": "1363251734687413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393545_1363251738020746_5344844993909225465_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90EP_wSTJ30Q7kNvwGXqU__&_nc_oc=AdokXHG0wN8xw_4z28l_cJVAaZOUE0BwBxRKLFxCbh1zQSMCt4s9Rpo1kImjOVMRIOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWiLZNBbwsSFDniTn3jc77B6Y0JJ8ZaaM1hKrkjAc38A&oe=6AA814B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "H-Verse", "keywords": [], "long_description": "H-Verse is the solution designed to improve various phases of business processes, with a focus on innovation based on specific needs. It is a product of Hevolus, an international leader in Extended Reality and Generative AI, specialized in creating unconventional phygital experiences.\n\nWith H-Verse app you can manage all the different scenarios available in Hevolus platform:\n- H-Store for retail, virtual shops, product presentation\n- H-Onboarding for new hire's experience\n- H-Collaboration for training and education\n- H-Fair for fair and exibitions\n- H-Project for real estate and interior design", "short_description": "H-Verse is a cutting-edge product within the Hevolus suite, designed to revolutionize the user experience by blending physical and digital elements. It offers customers a unique app for shopping experience, expands exhibition space digitally, catering to the presentation of complex products effectively, and much more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hevolus.com/en/privacy-policy", "developer_terms_of_service_url": null, "publ
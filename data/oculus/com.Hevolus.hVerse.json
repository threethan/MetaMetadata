68826897052_8155229199241420453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2udY820LP4Q7kNvwGS77u3&_nc_oc=Ado4RtkLlsSDrFojDGvzHOOBOvYnyKVo04FBWELdRD12MIBPVlwrp4g2lo3Jq0JB_0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jHfv8-Z2xBG7oWt2JGbxvbdVHnNfz98HTA_5qREgWkA&oe=69E8C402"}, {"file_name": "First Task - Step completed_2560x1440.png", "id": "1363251734687413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393545_1363251738020746_5344844993909225465_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MtMzk0h_WUQ7kNvwEpGf70&_nc_oc=AdoaHvnyF7L2UhHN0zPNODv0UJfCrro4mNA1Ghf-cVQnRAjUvj9KLhjn-DNqMjQXCLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30kme6McIPaApQV_XsHV5eyfCjC5oi3qhHVITdNa135g&oe=69E8B2F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "H-Verse", "keywords": [], "long_description": "H-Verse is the solution designed to improve various phases of business processes, with a focus on innovation based on specific needs. It is a product of Hevolus, an international leader in Extended Reality and Generative AI, specialized in creating unconventional phygital experiences.\n\nWith H-Verse app you can manage all the different scenarios available in Hevolus platform:\n- H-Store for retail, virtual shops, product presentation\n- H-Onboarding for new hire's experience\n- H-Collaboration for training and education\n- H-Fair for fair and exibitions\n- H-Project for real estate and interior design", "short_description": "H-Verse is a cutting-edge product within the Hevolus suite, designed to revolutionize the user experience by blending physical and digital elements. It offers customers a unique app for shopping experience, expands exhibition space digitally, catering to the presentation of complex products effectively, and much more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hevolus.com/en/privacy-policy", "developer_terms_of_service_url": null, "publ
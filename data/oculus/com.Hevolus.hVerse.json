68826897052_8155229199241420453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1F62iI3MIoQ7kNvwGFl5gS&_nc_oc=AdpQq4SjTo-YEh_KKiL6gp22zZUHqIdBXMp40SoNHSWCe3r8mVP7E3Y0VqtH8zFTPJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIbiH6jKrhgqIx_22sskpvxy8Tt_W8OiCvEBrd4zNLZw&oe=6AAFD682"}, {"file_name": "First Task - Step completed_2560x1440.png", "id": "1363251734687413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393545_1363251738020746_5344844993909225465_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oidfYbX_gUQ7kNvwGXZILX&_nc_oc=Adp51emB6dh0-KU80Z9GAwuJnw5XD5X-S-m4NqsaVNjHNXn7tUTikiZf9UMV6f0RtqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZybVIRnyg4-1JwyTuBirbLmrGY7WDXck3TKiFI7DAIg&oe=6AAFFDB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "H-Verse", "keywords": [], "long_description": "H-Verse is the solution designed to improve various phases of business processes, with a focus on innovation based on specific needs. It is a product of Hevolus, an international leader in Extended Reality and Generative AI, specialized in creating unconventional phygital experiences.\n\nWith H-Verse app you can manage all the different scenarios available in Hevolus platform:\n- H-Store for retail, virtual shops, product presentation\n- H-Onboarding for new hire's experience\n- H-Collaboration for training and education\n- H-Fair for fair and exibitions\n- H-Project for real estate and interior design", "short_description": "H-Verse is a cutting-edge product within the Hevolus suite, designed to revolutionize the user experience by blending physical and digital elements. It offers customers a unique app for shopping experience, expands exhibition space digitally, catering to the presentation of complex products effectively, and much more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hevolus.com/en/privacy-policy", "developer_terms_of_service_url": null, "publ
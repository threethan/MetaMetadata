\u30fbKeisoku-ji Temple, Nagahama\n\u30fbNorth Lake Biwa Firework Festival, Nagahama\n\u30fbSakamoto Cable Railway, Otsu\n\u30fbAvenue of Metasequoias\n\u30fbJapan Birdman Rally VR, Hikone\n\u30fbLake Biwa Museum, Kusatsu"}]}, "developer_name": "ytv VR", "developer_privacy_policy_url": "https://www.ytv.co.jp/privacy", "developer_terms_of_service_url": null, "publisher_name": "ytv VR", "support_website_url": null, "website_url": "https://ytv-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en", "zh_CN", "zh_TW", "zh_HK", "ar", "fr", "de", "hy", "hi", "ko", "ru", "ru_UA", "es", "es_AR", "tl"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "201716628806745"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1914662015285214", "version": "1.0"}, "id": "2198659803792201", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1908238092594273", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1914662015285214"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2198659803792201"}]}, "cha
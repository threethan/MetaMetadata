ideo_trailer": null, "video_trailer_thumbnail": {"file_name": "BikeRushVR_Trailer_Cover.png", "id": "1140359292086412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_1140359295419745_2649124074351316786_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhk2vMzFEQ8Q7kNvwF5sWIP&_nc_oc=AdrTdzM-1KFKuPJKIbXnG8IZtn4BnjuMMnYSMtcBwSbvd52aIo0ATuuL_1nyQ2JT6qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXt4ZPvas2zeOi4R6HwENhss89gn_97B9jLL58JfrvZgQ&oe=6B0EEFA8"}, "display_name": "BIKE RUSH VR : Wipout & Downhill Biking", "keywords": ["bike", "downhill", "wipeout", "racing", "mountain"], "long_description": "**Grab the handlebars and ride.** Bike Rush VR is a first-person bike ride built for VR. Twist your hands to steer, pull the triggers to pedal and brake, and yank the bars up to hop. Duck, lean and dodge with your own body.\n\n## Three Courses\n\n### \ud83c\udf0a Obstacle Run\nTen zones on a seaside deck: Hammer Alley, Spin Cycle, Tightrope Towers, Bounce House, Pirate Cove and the Haunted Pier at dusk. Seesaws, wrecking balls, crate walls, ball pits and hairline beams over open water.\n\n### \ud83c\udf32 Pine Ridge\nA high-mountain downhill from the snowy summit, over the swaying Sky Bridge, through the misty Cloud Forest and past the waterfall to an alpine meadow where goats, sheep and cows share the trail.\n\n### \ud83c\udf0b Lava Canyon\nDown the switchbacks, through narrows between lava falls, across bridges that collapse into the lava behind you, along a rock spine one bike wide, to an erupting volcano.\n\n## Ride Your Way\n\n- **4 bikes**, each with its own handling, from the fast Downhill Pro to the high-hopping Dirt Jumper\n- **Paint jobs** for your bike and rider kit\n- **Coins, stars and best times** to chase on every course\n\n## Comfort First\n\n- A solid cockpit and a level horizon keep you grounded\n- Comfort vignette, head knocks and refresh rate in Settings\n\n---\n\n**One purchase, the whole game.** No ads, no in-app purchases.", "short_description": "Grab the handlebars and ride. Bike Rush VR puts you in the saddle for three wild courses: a seaside obstacle run full of swinging hammers, sweepers and hairline beams over the water, a high-mountain downhill over rope bridges and through misty forest, and a volcanic canyon where the bridges fall into the lava behind you. Steer with your hands, duck with your head, and don't look down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therationalstudio.com/privacy", "developer_terms_of_service_url": "https://therationalstudio.com/terms", "publisher_name": "Rational Studio", "support_website_url": "https://therationalstudio.com/support", "website_url": "https://therationalstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1477303645459804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1101049832720946"}]}, "baseline_offer": {"id": "1101049832720946"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794842580, "status": "PUBLISHED", "id": "1101049832720946"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1489249667598535", "version": "1.1"}, "id": "1839442777256318", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
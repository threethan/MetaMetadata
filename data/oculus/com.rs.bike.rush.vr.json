rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWu2xRaK3AUQ7kNvwGiYW49&_nc_oc=AdoM2LAhO5fZNs0CxjOeQNGdgpZgTV6OwgflTvSIOu22OMehWP-je7dm89SNjtoNzJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzCogwmX9bXUBJrsO46GDKtk6LkeCj1SjX-qXgr9VR_Q&oe=6B0EFF22"}, {"file_name": "09_pine_skybridge_b0_pov_downhill.png", "id": "1811365033437375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298219_1811365036770708_8824125688985216614_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3EUy6yVR04Q7kNvwHdHMHf&_nc_oc=AdoRONpDyT72mQ7_ZOrMGzZUpISPEHbejK1m6fC6TLlomkq8S35_Hp8gt0HXdDYffBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHh3zG_NzCs68tbfJ1DpeipcAmwSUbTSq67QAKj3xQkg&oe=6B0F1749"}, {"file_name": "13_pine_meadow2_b0_pov_trail.png", "id": "1759342268483664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298900_1759342271816997_6671383444537999498_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eTqv-eotuIQ7kNvwF5KGmv&_nc_oc=Adq5FWJcPvQ-e1fj-dfRW32yMPb98h1o6zuCbLBBqbtXq91UdKvfs8QuHaPEu5mKYt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVX_8AZj2HoF0w96OyqxZl1CPaLY2c5GVtE-7ysEGTQ9w&oe=6B0EFF47"}, {"file_name": "14_lava_narrows_b0_pov_downhill.png", "id": "1831352267892141", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302348_1831352271225474_8045659179281979624_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhTu3b6VW88Q7kNvwE8ViOh&_nc_oc=AdqAUrFTv20PuY5t1ZlI5PKuTkBRTX1bYyWR_INi9zx0bhEGZUlZDg_RnHd-Pnw22tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWD_9DuAku_PGgRkaukVNtKHr-UXTniI-2kNdWpzLrgg&oe=6B0F0ED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BikeRushVR_Trailer_Cover.png", "id": "1140359292086412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_1140359295419745_2649124074351316786_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhk2vMzFEQ8Q7kNvwF5sWIP&_nc_oc=AdrTdzM-1KFKuPJKIbXnG8IZtn4BnjuMMnYSMtcBwSbvd52aIo0ATuuL_1nyQ2JT6qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXt4ZPvas2zeOi4R6HwENhss89gn_97B9jLL58JfrvZgQ&oe=6B0EEFA8"}, "display_name": "BIKE RUSH VR : Wipout & Downhill Biking", "keywords": ["bike", "downhill", "wipeout", "racing", "mountain"], "long_description": "**Grab the handlebars and ride.** Bike Rush VR is a first-person bike ride built for VR. Twist your hands to steer, pull the triggers to pedal and brake, and yank the bars up to hop. Duck, lean and dodge with your own body.\n\n## Three Courses\n\n### \ud83c\udf0a Obstacle Run\nTen zones on a seaside deck: Hammer Alley, Spin Cycle, Tightrope Towers, Bounce House, Pirate Cove and the Haunted Pier at dusk. Seesaws, wrecking balls, crate walls, ball pits and hairline beams over open water.\n\n### \ud83c\udf32 Pine Ridge\nA high-mountain downhill from the snowy summit, over the swaying Sky Bridge, through the misty Cloud Forest and past the waterfall to an alpine meadow where goats, sheep and cows share the trail.\n\n### \ud83c\udf0b Lava Canyon\nDown the switchbacks, through narrows between lava falls, across bridges that collapse into the lava behind you, along a rock spine one bike wide, to an erupting volcano.\n\n## Ride Your Way\n\n- **4 bikes**, each with its own handling, from the fast Downhill Pro to the high-hopping Dirt Jumper\n- **Paint jobs** for your bike and rider kit\n- **Coins, stars and best times** to chase on every course\n\n## Comfort First\n\n- A solid cockpit and a level horizon keep you grounded\n- Comfort vignette, head knocks and refresh rate in Settings\n\n---\n\n**One purchase, the whole game.** No ads, no in-app purchases.", "short_description": "Grab the handlebars and ride. Bike Rush VR puts you in the saddle for three wild courses: a seaside obstacle run full of swinging hammers, sweepers and hairline beams over the water, a high-mountain downhill over rope bridges and through misty forest, and a volcanic canyon where the bridges fall into the lava behind you. Steer with your hands, duck with your head, and don't look down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://therationalstudio.com/privacy", "developer_terms_of_service_url": "https://therationalstudio.com/terms", "publisher_name": "Rational Studio", "support_website_url": "https://therationalstudio.com/support", "website_url": "https://therationalstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1477303645459804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_1026182020504360_1333330588322971450_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nE1Hwf18mlMQ7kNvwHaIP6q&_nc_oc=AdoJg1oLoGHmmPbzQZSoEF88_XGFuJ1SjwWnZab-aqh_XuWq02524oVLQgWTKadO0d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVutyhpgIqrzXttuGSJqddiZFjCW52V1Z4e-iW1cOdQ2w&oe=6B0F098E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BIKE RUSH VR : Wipout & Downhill Biking", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date":
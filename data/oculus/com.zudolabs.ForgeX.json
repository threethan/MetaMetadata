 "SCREENSHOT-3.png", "id": "471373126016146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392293_471373129349479_1414614975792624739_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Ni7_NdHr8Q7kNvwG9P6DF&_nc_oc=AdpMkirxuF8TFbU9--c9uWH_toJOWSx-KYIvGQ7PX_T21umIFzVtO7tsAWi8GbISr7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXftjgfMNuHYqoZOGbexEL4xb7PMBas7r8BgF_E3qACA&oe=6A733847"}, {"file_name": "SCREENSHOT-4.png", "id": "582610221286027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391853_582610224619360_3639952440148742219_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsWBpapl864Q7kNvwGkwQ4p&_nc_oc=AdqlMYwJYm8DVt4tLtIG6o5xw93ptwlNDmMxu49owkn4Co4UQkzwYC-tgQhCLOztGcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq1K7ovJzLMNKYe7T0xfnTmzZW8aUJ-yxFdi_u3nB_zg&oe=6A732241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Lanscape.png", "id": "1277012686862220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_1277012690195553_2322926928140657600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5__Mg0UY_JoQ7kNvwEaL_E4&_nc_oc=AdoUPkGZW7zAklZm275sVory7f1Gxehu31StD0ZUY6gX1gwdoYaaa7h6Hc7buFXLXog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlIalP_y4f1_qAL_IohpZ2kLSOWEKtv79Psm9smk48iA&oe=6A732D33"}, "display_name": "ForgeX", "keywords": ["forgex", "welding", "simulation"], "long_description": "ForgeX VR offers a groundbreaking welding simulation experience, allowing users to master the art of welding using four major types of welding guns: Mig, Fluxcore, Stick, and Tig. Designed for both beginners and professionals, ForgeX provides a highly realistic environment where users can explore multiple welding techniques.\n\nThe application features various environments and plate types, enabling users to practice in different scenarios. Each welding session is followed by a comprehensive analysis, offering insights into accuracy, speed, and technique to help improve the user's skills over time.\n\nForgeX is perfect for educational institutions, professional welders, and hobbyists looking to refine their welding skills in a safe and controlled virtual environment. Prepare for real-world welding challenges with detailed feedback and an engaging learning process.", "short_description": "ForgeX is an immersive welding simulation where users learn and practice welding with various guns like Mig, Fluxcore, Stick, and Tig. Experience realistic welding in diverse environments with multiple plate types while receiving detailed performance analysis and session reports."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352777728107398"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1545976423734694"}, {"status": "PUBLISHED", "id": "3340427572754320"}]}, "baseline_offer": {"id": "3340427572754320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1545976423734694"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
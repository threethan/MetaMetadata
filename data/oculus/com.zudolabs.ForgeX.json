ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2oLUFU8pjxZDRUNdDd0m2x9lu8hNEjPIO6Nzjhtj9yg&oe=6AAAADB4"}, {"file_name": "SCREENSHOT-4.png", "id": "582610221286027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391853_582610224619360_3639952440148742219_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKMDLKptC-8Q7kNvwHRm7X4&_nc_oc=AdoL_nXdfUIzmpXYh7hJIJm1KhSO7nsDjT3pHst24N2cYSR3Bjtyj6SEwczZ1PBwMsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYeQISXNDxk1HAN5R4GKQ3HST45p6jth9g7QLFjhfOBw&oe=6AAAB981"}, {"file_name": "com.zudolabs.ForgeX-20260729-105645.png", "id": "2615170192273964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825575_2615170198940630_8677968863163150478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mT-2t4TXIcQ7kNvwGVCQeY&_nc_oc=Ado8Lj9YOuxmdye1TB2vo6SliAegI6rQIyrdnW5Yrmpt5MwIOWiiNthLZcsNO2XPvtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwtjQztNaaXuyAu6g2wrUFCIGhWpFSkqoLQEhKgZ1M0w&oe=6AAAAA1B"}, {"file_name": "New Project (2).png", "id": "1583494056464809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823949_1583494059798142_4156798651641942059_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO4dWWAMfeIQ7kNvwFxKrJ_&_nc_oc=AdpeO3Dj5Q5-6V60NF9H0L1E0LgomRWUDLpx3l8trs__417QNdv5V3bv2PpuA__2hr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNcBqH6CsOr3YE0oe6waNRWYeu9cZxD8dviq28hLu2Iw&oe=6AAABE9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Lanscape.png", "id": "1277012686862220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392000_1277012690195553_2322926928140657600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybbxq0SpgF0Q7kNvwHRZzlD&_nc_oc=AdoWpg-_g3UElEV4btIN7iNdDyMLTeWW7KCi-Y23fIvMBUqGgkHdN5PtBCMTPqBPjnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJykZNljFh4kJFwK0pMvCgQXHsmdr1vJapYScg9lMzSDg&oe=6AAA8C33"}, "display_name": "ForgeX", "keywords": ["forgex", "welding", "simulation"], "long_description": "ForgeX: The Ultimate VR Welding Simulator\n\nForgeX offers a groundbreaking welding simulation experience, allowing users to master the art of welding using four major types of welding processes: MIG, Flux-Core, Stick, and TIG. Designed for both beginners and professionals, ForgeX provides a highly realistic, risk-free environment to build muscle memory, perfect technique, and prepare for real-world trade challenges.\n\nKey Features:\n- Complete Position Mastery: Practice across all essential welding positions\u20141G (Flat), 2G (Horizontal), 3G (Vertical), and 4G (Overhead)\u2014to develop comprehensive, industry-ready skills.\n- Extensive Plate Catalog: Access a rich selection of standard joint types and environments, with an expanded catalog of specialized, optional practice plates to simulate virtually any scenario.\n- In-Depth Performance Analytics: Receive instant, detailed post-weld feedback analyzing your speed, travel angles, arc distance, and accuracy to accelerate skill development.\n- Safe & Cost-Effective Training: Ideal for trade schools, educational institutions, professional welders, and hobbyists looking to refine their craft without material waste or safety hazards.\n\nStep into the virtual booth, explore diverse setups and positions, and refine your technique with precision feedback in ForgeX VR.", "short_description": "ForgeX is an immersive welding simulation where users learn and practice welding with various guns like Mig, Fluxcore, Stick, and Tig. Experience realistic welding in diverse environments with multiple plate types while receiving detailed performance analysis and session reports."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "
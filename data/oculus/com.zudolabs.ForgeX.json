lay_name": "ForgeX", "keywords": ["forgex", "welding", "simulation"], "long_description": "ForgeX VR offers a groundbreaking welding simulation experience, allowing users to master the art of welding using four major types of welding guns: Mig, Fluxcore, Stick, and Tig. Designed for both beginners and professionals, ForgeX provides a highly realistic environment where users can explore multiple welding techniques.\n\nThe application features various environments and plate types, enabling users to practice in different scenarios. Each welding session is followed by a comprehensive analysis, offering insights into accuracy, speed, and technique to help improve the user's skills over time.\n\nForgeX is perfect for educational institutions, professional welders, and hobbyists looking to refine their welding skills in a safe and controlled virtual environment. Prepare for real-world welding challenges with detailed feedback and an engaging learning process.", "short_description": "ForgeX is an immersive welding simulation where users learn and practice welding with various guns like Mig, Fluxcore, Stick, and Tig. Experience realistic welding in diverse environments with multiple plate types while receiving detailed performance analysis and session reports."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
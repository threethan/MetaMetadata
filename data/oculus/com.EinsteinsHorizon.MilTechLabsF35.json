2162061934335797_5089515534103159427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6s1wkQh4TwQ7kNvwF0eMmR&_nc_oc=AdqlFCwR6X9vJ_diFEsiQgsPGXUmy2aQA9LzIvFdygvUBGkk0wmZYq8TfacG0-rXCiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt_Xr6s_LsXmpHCHAhrm7qq7MvwIriJ2w3XmLut-5G5g&oe=6A635AD8"}, {"file_name": "Screenshot_2026-07-01_23-22-24.png", "id": "1318060033749212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_1318060040415878_3216918058407956889_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UUhGeR8vqkQ7kNvwG4uprk&_nc_oc=Ado88TzVAVgIl0shfY68QYJkwtbFpGgzpVO0oo4AQoo5pSNhgkenRFbEqTENOfbsMNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8TVvWimcS7ds8Xts9PjkBhN4jw_pwI0QSevHdziE29A&oe=6A637C98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Military Tech Labs: F35", "keywords": ["military", "technology", "aviation", "engineering", "f35"], "long_description": "Welcome to Military Technology Lab, an interactive aerospace learning experience centered around one of the world's most advanced aircraft: the F-35 Lightning II.\n\nUnlike a flight simulator, Military Technology Lab is designed as a virtual technology museum where curiosity drives exploration. Walk around the aircraft, a turbofan jet engine, the cockpit and F-35 helmet, examine the systems up close, and select individual components to learn how they work. Your personal virtual engineer will explain the design, engineering, physics, and purpose of each part, and how they contribute to the aircraft's overall mission.\n\nDiscover how aerodynamics, stealth technology, propulsion, advanced materials, flight controls, sensors, and avionics come together to create a modern fifth-generation fighter. Learn not only what each component does, but why engineers designed it that way and how it interacts with other systems throughout the aircraft.\n\nWhether you're interested in aviation, engineering, physics, military technology, or simply enjoy learning how complex machines work, Military Technology Lab offers a unique opportunity to explore an extraordinary aircraft at your own pace. Content is intended for ages approximately 11-18.\n", "short_description": "Step inside a cutting-edge military technology lab built around the F-35 Lightning II, one of the most advanced aircraft ever developed. Explore the aircraft up close, investigate its systems, and discover how engineering, materials science, aerodynamics, sensors, and propulsion work together to support its mission. Through interactive learning experiences, uncover the science and technology behind modern aerospace design in an immersive hangar environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1204822412714852"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "27096097610089176"}, {"status": "PUBLISHED", "id": "1843444620374298"}]}, "baseline_offer": {"id": "27096097610089176"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783848420, "status": "PUBLISHED", "id": "27096097610089176"}]}, "liveCh
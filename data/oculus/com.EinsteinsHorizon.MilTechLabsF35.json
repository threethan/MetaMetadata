m5I&_nc_oc=AdqudDOmLavN2w5Zdk6aYgZ7LGnj9vx7Rwd7Ip5MeBICIQK_lqlogZkc77OosNzaeCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqMDnHX-02cVygiW8ydGRiCOHK7pCuV6EId1T38B9dSQ&oe=6A63752E"}, {"file_name": "Screenshot_2026-07-01_23-07-57.png", "id": "2476595882846527", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620429_2476595886179860_5223421825534748529_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xo0IbGCOHUQ7kNvwEqm-JO&_nc_oc=AdoAEjoCjOzEwJ84FHfXVu7A5JHjwY0WBuEuNVfeB7nksGMyJPXVZpnljKiJQCGf1_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXBFjNYIISjvKICAdqeWAYR4bcFaVNf21HXBqO8NY41w&oe=6A6375BC"}, {"file_name": "Screenshot_2026-07-01_23-18-41.png", "id": "2162061931002464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620856_2162061934335797_5089515534103159427_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6s1wkQh4TwQ7kNvwF0eMmR&_nc_oc=AdqlFCwR6X9vJ_diFEsiQgsPGXUmy2aQA9LzIvFdygvUBGkk0wmZYq8TfacG0-rXCiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt_Xr6s_LsXmpHCHAhrm7qq7MvwIriJ2w3XmLut-5G5g&oe=6A635AD8"}, {"file_name": "Screenshot_2026-07-02_14-16-22.png", "id": "2817580261934622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_2817580265267955_127024462318229716_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0kYbQLtOzEQ7kNvwEJdC3r&_nc_oc=Adrxwbzi1FHOaeqmShVYL5vRpOs2RWfShsO6Iuuvb0YdJHdtD76i1tobQFW3adpEK1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16DxlKi0VX_3tt_rEGoGLyOEFcC-9kzh-U5UDHRzbwg&oe=6A635077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1184584350522642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_1184584353855975_8115883661267186209_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8h41LlvC3QQ7kNvwEZMxaJ&_nc_oc=Adozu2lfyGDPSXA04Cq3ZIn1o9TVGVYQnHCAk7lz21o6XohSH3eiGuQEt5P4teTtFWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFWYyV64PgKBKW7zZS4ZJJP_7NQcshOtiaEIprb0MtHg&oe=6A638569"}, "display_name": "Military Tech Labs: F-35", "keywords": ["military", "technology", "aviation", "engineering", "f35"], "long_description": "Welcome to Military Tech Labs: F-35, an interactive aerospace learning experience centered around one of the world's most advanced aircraft: the F-35 Lightning II.\n\nUnlike a flight simulator, Military Tech Labs: F-35 is designed as a virtual technology museum where curiosity drives exploration. Walk around the aircraft, a turbofan jet engine, the cockpit and F-35 helmet, examine the systems up close, and select individual components to learn how they work. Your personal virtual engineer will explain the design, engineering, physics, and purpose of each part, and how they contribute to the aircraft's overall mission.\n\nDiscover how aerodynamics, stealth technology, propulsion, advanced materials, flight controls, sensors, and avionics come together to create a modern fifth-generation fighter. Learn not only what each component does, but why engineers designed it that way and how it interacts with other systems throughout the aircraft.\n\nWhether you're interested in aviation, engineering, physics, military technology, or simply enjoy learning how complex machines work, Military Tech Labs: F-35 offers a unique opportunity to explore an extraordinary aircraft at your own pace. Content is designed for ages approximately 11\u201318.\n", "short_description": "Step inside a cutting-edge military technology lab built around the F-35 Lightning II, one of the most advanced aircraft ever developed. Explore the aircraft up close, investigate its systems, and discover how engineering, materials science, aerodynamics, sensors, and propulsion work together to support its mission. Through interactive learning experiences, uncover the science and technology behind modern aerospace design in an immersive hangar environment.\n"}]}, "developer_name": null, "developer_privacy_po
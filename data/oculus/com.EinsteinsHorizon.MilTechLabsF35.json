_oc=AdpOisE5so1THlbiUBOVVjXMbYoqk2bsUS-I1q8ITYRYNR-KfpYLj-pj45PBAnLzQe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB3z-rq1dKU8kk3blzxz8c-zCM1rIENI4m984rMReNmA&oe=6AFDD298"}, {"file_name": "Screenshot_2026-07-02_14-16-22.png", "id": "2817580261934622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_2817580265267955_127024462318229716_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etXUwFPX4hcQ7kNvwHzjd5b&_nc_oc=AdpI-xMnJr00XCrMZ8DYvMb4FlOaL7x4yiyhUxep3R1t5k0FwLzuJP1VHjl3BMWs9uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtlCsR1lBhMpiM-Az3LnOO_konN4JvaGbuse1OpWAFKg&oe=6AFDC837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image1-8.png", "id": "1941873149829716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_1941873153163049_7654712951703493924_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-Nwr2I4hDIQ7kNvwFVMcER&_nc_oc=AdqFyHYjWRAkAtkImn0jbkaQb1eBy7iTnIAQgrCpBcBdHrcEg0mugkV3rO3L27AOfOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrnBOTqB4ydesnpPokEMvieneP5QGqmlz8_1stBH5Vww&oe=6AFDBC85"}, "display_name": "Military Tech Labs: F-35", "keywords": ["military", "technology", "aviation", "engineering", "f35"], "long_description": "Welcome to Military Tech Labs: F-35, an interactive aerospace learning experience centered on one of the world's most advanced combat aircraft: the F-35 Lightning II.\n\nUnlike a flight simulator, Military Tech Labs: F-35 is a virtual technology museum where curiosity drives exploration. Walk around a full-scale F-35, examine a turbofan engine, explore the cockpit and helmet display system, and inspect the aircraft's components up close. Select individual parts to discover how they work, while your personal virtual engineer explains the engineering, physics, design decisions, and operational purpose behind each system, and how every component contributes to the aircraft's overall mission.\n\nExplore the technologies that define a 5th-generation fighter, including aerodynamics, stealth, propulsion, materials, controls, avionics, sensors, electronic warfare, and digital networking. Learn why engineers designed each system the way they did, the trade-offs they balanced, and how every component works together to deliver the F-35's exceptional capabilities.\n\nAll educational content has been developed by cross-referencing publicly available sources for accuracy. The experience is designed primarily for learners approximately 11\u201318 years old, though it can be enjoyed by anyone with an interest in aerospace technology. Visuals are intended for educational illustration and may not represent every component with engineering-level precision.", "short_description": "Step inside a cutting-edge military technology lab built around the F-35 Lightning II, one of the most advanced aircraft ever developed. Explore the aircraft up close, investigate its systems, and discover how engineering, materials science, aerodynamics, sensors, and propulsion work together to support its mission. Through interactive learning experiences, uncover the science and technology behind modern aerospace design in an immersive hangar environment.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": "https://www.einsteinshorizon.com/terms-and-conditions", "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
5rcOhV00pwEIEJtxCKSdzr3KN7DBUv7pWh5aMK-AuUIjf-Iz3ceeVWU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEgwfZ9v4Ej194jQd_CsDeSxX74IoNBVlWHfRd5aPwhQ&oe=6AA93CD2"}, {"file_name": "ScreenshotFeat_SelectionUI_en.png", "id": "1985064375472408", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822303_1985064382139074_6173841608325420387_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bALe7jXDFvEQ7kNvwFjgxT8&_nc_oc=Adpynl6zouQU3N-HoqozLDJUx4j5aQh9UtRX7DI2Uj2g8BpOA7nzD6lsVUEvNdY0VlU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrK_OI5XWR41vrH8WZzlCGXzR6Iy7GzBdMQ9noa2nobA&oe=6AA965B0"}, {"file_name": "ScreenshotFeat_Flexikon_en.png", "id": "5367149163511083", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823905_5367149173511082_3038065852291413927_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzbfcUIcWAkQ7kNvwGmjb4G&_nc_oc=Adqi50J3dqK8Q_c8ncI97Vfbzj19APYY61UbUAExR6b_fGBXkHfF4tSK1tgxrNSAc6I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_AWABvjJdZbTdZUgqNT79TPuXWJ-t3A847FGU8yB_Hg&oe=6AA96252"}, {"file_name": "ScreenshotFeat_Quiz_en.png", "id": "1725601541981228", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823905_1725601545314561_1666141441942899087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAjWSgnG5jkQ7kNvwHS77ZR&_nc_oc=Adolh2ubK4ArUFyMAldjWvAl-MGOoKpmtRZYAm3UpdU1ZXhKq5WJhsR1bkgyhlCiU8o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJyuQ-xhiINQb5H8vSR97ndzL_fEzITBKIx82kfA8ELQ&oe=6AA95C3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2024_06_Corpus_Trailer_TN.png", "id": "1444904026179616", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031315_1444904032846282_8373746752031393068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYEPKTjilUcQ7kNvwFO3Cx2&_nc_oc=Adq8-W4spFT5xPh-h1x7sKxUCMAgXsWDg0aoa4Tl84MxZxEIcOCvkP0jgHevQVGCgGc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw4H3W3YkVKcQeCCtX24M2ebY9kk22xMZcg3x7m1MSDg&oe=6AA93F8D"}, "display_name": "Corpus | Anatomy", "keywords": ["anatomy", "medicine", "body", "learning", "human"], "long_description": "Corpus the mixed-reality app designed for exploring and learning human anatomy interactively while still being medically accurate. With Corpus, you have access to a highly detailed and anatomically accurate model of the body, allowing you to explore all the organs, muscles, ligaments, blood vessels, and nerves. Set up your own dissection lab right at home! By linking to the medical lexikon, DocCheck Flexikon, you have access to hundreds of well-structured learning texts, supplemented by podcasts and videos. This way, you can deepen your knowledge of human anatomy in no time. In quiz mode, you can challenge yourself. Are you a master of anatomy or clueless? Give it a try!\n\nThe app was developed along side medical professionals to ensure the upmost accuracy in all structures. Perfect for students and professionals in healthcare or anyone curious to know more about the human body.\n\nBasics at a glance:\n\n* over 3000 highly detailed structures to discover\n* Flexikon integration gives you access to a medical wiki full of knowledge, videos and podcast for every body part\n* Quiz mode to test your knowledge - perfect to prepare for anatomy exams\n* Add-ons available to expand your learning: female anatomy, beating heart model, and more models being constantly developed\n* Co-op mode as an add-on to learn in pairs\n\nDo you want Corpus to be available through your institution? Let us know", "short_description": "Corpus is a cutting-edge mixed reality app for medical students and professionals to explore and learn human anatomy. With a highly detailed and anatomically accurate body model, you can study anatomy from home. \n\nSet up a virtual dissection room and immerse yourself in learning. Corpus integrates with DocCheck Flexikon, offering hundreds of structured learning texts and videos. Challenge your understanding with our quiz mode. Elevate your studies and advance your understanding of human anatomy."}, {"images": {"nodes": [{"file_name": "corpus-app-icon-512x512.png", "id": "1093844528829777", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982508_1093844532163110_5345377354011801459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hom9S8YlPiwQ7kNvwGC-kjf&_nc_oc=AdpLrg72EeTad1iHhghrN_yL-TIbVTBczADTaMGPMVwRYo0SyntbW_bg8uCq4n-zTFI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDfhcFyeLcNTAbFTtJmrb6Lp1fZVjhj-yksjxS0z1vHA&oe=6AA94516"}, {"file_name": "Cover_Square.png", "id": "1017261366660454", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974666_1017261369993787_5993681090477994881_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6kIE6uY_YoQ7kNvwHTitWO&_nc_oc=Adr8CT-tSGomrLgWUlydJCmMzZTDszFi4JCI4l1lUDz7Wqbf4LIW4kqfpyNqkXf0JkY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSVMRpfaiat3JeO51A6vVN-1p1RjeKFM6kb0XxL5xZqA&oe=6AA940AF"}, {"file_name": "corpus-logo-1200x400-shadow.png", "id": "995988498681175", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031471_995988502014508_3050427182628937874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JjgBHC8jCgQ7kNvwGbMxR_&_nc_oc=AdrTbTkEgPxmbk3_JA0e48BtX64WfTyKbXT6SfyNnVCWbkJrij03KDvmyy28-7BCLss&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg5JrDZFCkybOz_gnsR4P_lyNZ31FINYdrbjAiRNIkcw&oe=6AA93818"}, {"file_name": "Cover_Landscape.png", "id": "829451325829546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003262_829451329162879_2828863557701399171_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtwIyX_axS0Q7kNvwGhAWz0&_nc_oc=AdoVMkHhZR33kYm5-UkdhOq_F5EuW-XXTDY3rzilSvcV7bTju1DWz0EZ1l4RLoLl3T0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com
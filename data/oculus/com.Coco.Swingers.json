r hands and arms. Featuring custom cosmetics, built-in features like long arms, and frequent community updates, it's the ultimate chaotic sandbox playground to hang out and play tag with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1hOKxHeGLPd6Itlniue8T28FHsm1iITIEyqqvcL2NSoc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Coco Puffs", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1-2VNumE1sPmCbIAzmYVVQy8gaP6jM5BJSsYItn0C5LI/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1301356573050859"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1318142261372290", "version": "1.208"}, "id": "2111108779763435", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1249810544872129", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1318142261372290"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{
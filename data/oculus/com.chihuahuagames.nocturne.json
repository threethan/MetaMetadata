11qdOGKcZMfdhzcPnyLNEE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ3nkh2f3_e7EjX8JKJ20C4QRcn4QbIO6RQlaOrxmvPQ&oe=6AAE822B"}, {"file_name": "screenshot_5_purgatory_lamps.png", "id": "1326220749577703", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623400_1326220752911036_5791861193431944757_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VH-XZamlZsQ7kNvwFSf-uJ&_nc_oc=AdodtzDIAWsAx2sg-V540DJcZ3yQD49lNTXYZUV9yCkiFcNdxFLdjTY-1C6WWEyuNjo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBZOFWVz_JHPwPYOfR4hG6k52uSq3xcClSlsRuMEIYGQ&oe=6AAEA51F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4_onryo_boss.png", "id": "5082523245349200", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619668_5082523248682533_3321988913091126094_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPUoPVl2Kh8Q7kNvwErx-9M&_nc_oc=Adr0D9DtvVEPWvv090F9S5NXfaoOQbofP8LLhENVB4ns6DckylynZWW_9iox5xsXJE8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjDQ--2uHVhrtWkJzOv7JD3nSjwffZOsNGxi1IYMtPRg&oe=6AAEAEBD"}, "display_name": "NOCTURNE - Neon Noir", "keywords": ["rhythm", "shooter", "arcade", "balloons", "noir"], "long_description": "NOCTURNE\n\nA hardboiled rhythm shooter about the most dangerous job in the city: popping balloons.\n\nYou ride forward through a dark, cinematic corridor, a pistol in each hand. Out of the shadows drift glowing balloons \u2014 and your only job is to pop them in time with the beat. It's fast, it's stylish, and (for the record) nobody gets hurt. They're balloons.\n\nHOW IT PLAYS\n- Aim with each hand and fire your twin pistols at incoming balloons.\n- Shoot ON THE BEAT to build combos and multiply your score.\n- Every color is worth a different amount \u2014 common whites up to rare golds.\n- Miss one and it floats away into the night, gone for good.\n- Watch for the hidden BLACK balloon: nearly invisible, worth a fortune.\n- Each shot whistles a musical note \u2014 keep firing and your guns perform a full classical melody.\n\nMADE FOR VR\nYour two Meta Quest controllers become the twin pistols \u2014 point with your own hands and pop. You move forward automatically at a smooth, constant speed with no artificial camera turns, for a comfortable ride. Designed to be played standing, with room to turn and aim.\n\nSTYLE\nBlack corridors, pools of red light, film grain and cinematic bars \u2014 a whole film-noir mood, poured into a game about popping balloons.\n\nNOCTURNE \u2014 Pop. Perform. End the night.", "short_description": "Dual-wield pistols in a neon-noir corridor and pop waves of glowing balloons in time with the music. Shoot on the beat, chase rare colors for big scores, and hunt the hidden black balloon. Every shot whistles a note \u2014 string them together and your guns play a classic. Built for Meta Quest with twin motion-controller pistols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/nocturne/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ChihuahuaGames", "support_website_url": null, "website_url": "https://chihuahua-games.chihuahuagames.workers.dev/apps/nocturne/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1225812647285306"}}]}, "scheduled_offers": {"
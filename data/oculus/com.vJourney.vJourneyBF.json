ent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyoC7PtT-l7yw8qiQCRHKfOcV9p693__KX03LNcXckyTw&oe=69B81259"}, {"file_name": "Screenshot 2025-11-06 121003.png", "id": "820853304247968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_820853307581301_5984710865072767554_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZDEJx0ihJQQ7kNvwGiDHNb&_nc_oc=Adkg329-uGRd_lyJbd8U5s2Z6NN7jsA8gZpLXGtap8a-DMJ3e4q9eHbqndCqmaOmI_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzY3qDF4zr_hyB69KkGbZIcMTXnmdMJTznHI1z8KWIHIA&oe=69B80182"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vJourney", "keywords": ["culture", "travel", "tourism", "explore", "landmarks"], "long_description": "# vJourney \u2013 Virtual Travel for Everyone\n\nDiscover the world in a new way with vJourney and experience real destinations through high-quality 360\u00b0 footage directly on your VR headset. From vibrant cities and cultural highlights to breathtaking natural landscapes, our virtual journeys bring authentic places to you in a realistic and impressive way.\n\nvJourney combines captivating experiences with intuitive, easy-to-use controls and optional interactive elements. Explore landmarks, listen to engaging background stories from your personal tour guide, and fully immerse yourself in new environments without travel stress or waiting times.\n\nWhether for relaxation, curiosity, or experiencing history and geography in a new way, every journey becomes a special moment.\nPut on your headset and start your adventure.\n\nWith vJourney, the world is only a moment away.", "short_description": "vJourney brings real travel destinations to your VR headset through high-quality 360\u00b0 experiences. Explore cities, landmarks, and breathtaking landscapes as if you were truly there. Enjoy engaging background stories and immerse yourself in new worlds. The intuitive design makes it easy to get started and ideal for anyone who cannot travel themselves. Travel whenever you want, at your own pace. Share special moments, discover new places, and experience the world in a whole new way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtuelles-reisen.de/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "vJourney GmbH", "support_website_url": null, "website_url": "https://vjourney.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34059225217055104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_829335730031991_2413092841974153342_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3k9DK72rxEQ7kNvwErkrtA&_nc_oc=Adlawc3fXk4LRQdIMsb1nBXauiEArxLBZokWOpejjO6KoC9ehfiMISg-gNcAIotzT7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWPxg6YE90WsBmpiJ9H4DS5bG98iEdCB8gNRQKXnJMmg&oe=69B7F291"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vJourney", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1762973880, "lastRevision": {"nodes": [{"id": "32134440929533552", "release_type": "SCHEDULED
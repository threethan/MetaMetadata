c3-1.oculuscdn.com/v/t64.5771-25/491820387_2040475636777552_5607516046575205189_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA2EfPbXd7YQ7kNvwGc4a3u&_nc_oc=Adks4wJ-Q9ffUa3gM-9XJyZKzd0C72MqppZ-jw1Z86UsUj9CP4q1F0GrwRMU98TjzC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaURdGcK0TMXcSSSHlNT2exCtKWFewkHeTGAXoxBEY1Q&oe=69B164FC"}, {"file_name": "Screenshot 2025-11-06 121352.png", "id": "724275064037752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_724275070704418_1621934128875015553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M41mRCI_dO0Q7kNvwEA8j4v&_nc_oc=AdmDL2zQIVZ6BJuU8EIAYQViTY9XFxFYzyYoHEu6vw4LID6QIGfNt5mTAW8bq4DkuMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx08Atm8OGANQzrDiEWahyPywLw80qv7S1oVi9OR1XsIg&oe=69B149B0"}, {"file_name": "Screenshot 2025-11-06 120615.png", "id": "1368111534696018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1368111541362684_2889539180356530446_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gatr_INDrEgQ7kNvwGiQkhC&_nc_oc=AdkN46uat-44zOBxovrgAIzTzdojHCkQrlcORa604LVLkFsex2-fxLRb1QH_JqP5vcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI484X_d7fXEar-s_tPtv-vYX-fqMrmIJeKAuzGk3X_g&oe=69B17AD9"}, {"file_name": "Screenshot 2025-11-06 121003.png", "id": "820853304247968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_820853307581301_5984710865072767554_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1zGdj5pdXwQ7kNvwFdFiZS&_nc_oc=Adk1LDaZnK9Hy_7IGMQrZ9lqDvWiAUtKJrwfiZr1T7V2prUCHd1J6piSSCGExu8Th2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqNfSlCqkF_JIntBT3o0hssCbj2MhFTLJkwq__Rx4zGw&oe=69B16A02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vJourney", "keywords": ["journey", "accessible", "culture", "seniors", "inclusion"], "long_description": "## **vJourney \u2013 Virtual experiences for everyone**\n\nExperience cultural participation in a whole new way: With **vJourney**, users of all ages and abilities can discover the world \u2013 from cities and museums to nature parks and events. **Immersive 360\u00b0 videos** in 8K quality and a multilingual virtual tour guide provide motivation, interaction, and cognitive stimulation.\n\n- **Intuitive operation**\n- **Interactive 3D objects, quizzes, and games**\n- **Flexible use**: alone, accompanied, or in groups (coming soon)\n- **Scientifically proven**: increases joie de vivre, connectedness, and activity\n\n**vJourney** brings real experiences into your home without barriers. The app runs on modern VR headsets and is ready to use immediately after switching on \u2013 no complicated setup required.\n\n> **Institutions and practices that would like to use our companion app for professional applications can contact us directly.**", "short_description": "Cultural participation for everyone! Every person, regardless of age or disability, should be able to travel to faraway places. vJourney is a platform for virtual experiences. With the help of 360-degree video recordings in 8k quality, cities, events, and impressive natural landscapes are brought into your home. A multilingual tour guide accompanies our virtual travelers. Interactive elements provide motivation, immersion, and stimulation of cognitive abilities."}, {"images": {"nodes": []}, "id": "1449940616108900", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vJourney", "keywords": ["Barrierefrei", "Kultur", "Reisen", "Gehirntraining", "Senioren"], "long_description": "## **vJourney \u2013 Virtuelle Erlebnisse f\u00fcr Alle**\n\nErlebe kulturelle Teilhabe neu: Mit **vJourney** entdecken Nutzer*innen unabh\u00e4ngig von Alter oder Einschr\u00e4nkung die Welt \u2013 von St\u00e4dten und Museen bis hin zu Naturparks und Events. **Immersive 360\u00b0-Videos** in 8K-Qualit\u00e4t und ein mehrsprachiger, virtueller Tour-Guide sorgen f\u00fcr Motivation, Interaktion und kognitive Aktivierung.\n\n- **Intuitive Bedienung**\n- **Interaktive 3D-Objekte, Quizze und Spiele**\n- **Flexible Nutzung**: allein, begleitet oder in Gruppen (bald verf\u00fcgbar)\n- **Wissenschaftlich belegt**: Steigerung von Lebensfreude, Verbundenheit und Aktivit\u00e4t\n\n**vJourney** bringt echte Erlebnisse barrierefrei nach Hause. Die App l\u00e4uft auf modernen VR-Headsets und ist sofort nach dem Einschalten startbereit \u2013 ohne komplizierte Einrichtung.\n\n> **Einrichtungen und Praxen, die unsere Begleit-App f\u00fcr professionelle Anwendungen nutzen m\u00f6chten, k\u00f6nnen sich direkt bei uns melden.**", "short_description": "Kulturelle Teilhabe f\u00fcr alle! Jedem Menschen, unabh\u00e4ngig vom Alter und Beeintr\u00e4chtigung soll es m\u00f6glich sein, an ferne Orte zu reisen. vJourney ist eine Plattform f\u00fcr virtuelle Erlebnisse. Mithilfe von 360-Grad-Videoaufnahmen in 8k-Qualit\u00e4t werden St\u00e4dte, Ereignisse und beeindruckende Naturlandschaften nach Hause geholt. Ein multilingualer Tour-Guide begleitet unsere virtuellen Reisenden. Interaktive Elemente sorgen f\u00fcr Motivation, Immersion und das Anregen der kognitiven F\u00e4higkeiten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vjourney.io/pages/privat-policy-vjourney-app", "developer_terms_of_service_url": null, "publisher_name": "vJourney GmbH", "support_website_url": null, "website_url": "https://vjourney.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_
_ohc=cCaH2YMVD4AQ7kNvwE3P0Py&_nc_oc=AdqIosBA_K4XwbyT4zCYsDs-7Fn46NdrKpTl5WgPOTftZXS2ZF7J7Q1YbESDvTaDJpo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXMRM1xS1oC7GCFm1SEUtKTSI2-v1cA_7_r7QOjd3h_Q&oe=6AC4F399"}, {"file_name": "Kiel_screenshots.png", "id": "1478682457333086", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821115_1478682463999752_1944950754891016649_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhBU6AN_YPIQ7kNvwHRWJvk&_nc_oc=AdouVmAiMYgsw4jaizM0deqnG43qsfl14_rsawftSkyjzI5LhvBATxZ-zLD3dGmt1ck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0mmyEdp-s6L0sG0nQ1l7V_w0oax1-55vPs6ETQ2hFrg&oe=6AC522F3"}, {"file_name": "11.png", "id": "2995167727338584", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821782_2995167730671917_5856017894241391796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvR4tv6B7o4Q7kNvwHjJOJO&_nc_oc=AdoqHmn0WjgZcbFPKv5_8onvWfqq5kX4xaV0v0FXe7xLV_T3h2BCZx0uDq3hA4nihAk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6ZmhgpD8-rJoveh2gd3KKthHpsTu0VE0A2FScfQDHbA&oe=6AC5210B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shopify Bilder (2560 x 1440 px) (11).png", "id": "1247312597470328", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823930_1247312600803661_2634382881900598729_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2qBegf2jpQQ7kNvwFyGgrO&_nc_oc=Adq8wBGi-gNmQ9VLXkeMzgNAh2kIISJWVE4CJUHJydmsY__ysgWW0BquXYR1YlXfPxQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKoV-WD3yb7W10VjNN0Wy1jDF7G6JjdKkc3XgJnHXFxw&oe=6AC4F114"}, "display_name": "vJourney: Guided Virtual Travel", "keywords": ["culture", "travel", "tourism", "explore", "journey"], "long_description": "# vJourney \u2013 Guided Virtual Travel for Everyone\n\nExperience virtual travel in a new and immersive way.\nWith vJourney, you can explore real destinations through high quality 360\u00b0 environments. Move freely through each location and switch between places at any time using the navigation arrows. Discover the world at your own pace and follow your own path.\n\n**Virtual Travel Book and Audio Tour Guide** \n\nDive deeper into every destination with the virtual travel book.\nDiscover culture, history, and landmarks through immersive storytelling, narrated by your personal audio tour guide. Each location reveals its deeper meaning as you explore the stories behind what you see.\nWhenever you choose, you can seamlessly close the book with a single click and enjoy the full 360\u00b0 view, completely unobstructed.\n{1471962861227474}\n**Image Galleries**\n\nIn selected destinations, you can access additional image galleries.\nExplore more perspectives, details, and impressions that go beyond the main experience and give you a broader view of each location.\n\n\n{2907144762765772}\n\n**Interactive 3D Elements**\n\nEnhance your journey with interactive 3D elements.\nDiscover objects within the environment, pick them up, and explore them from every angle to better understand the details of each scene.\n{4294790737502069}\n", "short_description": "\ud83c\udf0d Explore guided virtual travel with audio narration and interactive VR experiences.\nYour personal guide accompanies you with captivating stories, 3D models, and immersive scenes. Discover famous destinations and historical landmarks in a new way and feel like you are truly there. From cities to breathtaking landscapes. Experience each tour at your own pace and enjoy every location in a calm and immersive way. New content is added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtuelles-reisen.de/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "vJourney GmbH", "support_website_url": null, "website_url": "https://vjourney.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
xZGay8o5OrBAtiTp2zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08189PDL8DV0oYr2M9u422nxZKjX32IUIUXTWde4Vgtg&oe=69D256B3"}, {"file_name": "11.png", "id": "2995167727338584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821782_2995167730671917_5856017894241391796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdXgrHlGmAQQ7kNvwHVuAO2&_nc_oc=Ado9PonvZ6UBGL-MewDoS6BZvyWTNc6QjiLY_HR0FYapiuVe9PTXlgMdwZLz-7h0HAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LHWD854DfjQnLHoI2z0bS0C1RoimfnFZ4pBBeywTBRw&oe=69D254CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shopify Bilder (2560 x 1440 px) (9).png", "id": "1119117507027287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831382_1119117510360620_1327747917520001984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f7M7cIGog8Q7kNvwHrOmNt&_nc_oc=Adqy9BmGF7PZ7ZzZSeEQU815tBmqxW4e4g7B5AdYM6qr8HMS9ElnHBwBBa-Gj3E-yaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32cx67U76DqGmLmP08Iyz8nSXyNNgLB0U6aFcIza8K6Q&oe=69D27E01"}, "display_name": "vJourney: Guided Virtual Travel", "keywords": ["culture", "travel", "tourism", "explore", "landmarks"], "long_description": "# vJourney \u2013 Guided virtual Travel for Everyone\n\nDiscover the world in a new way with vJourney and experience real destinations through high-quality 360\u00b0 footage directly on your VR headset. From vibrant cities and cultural highlights to breathtaking natural landscapes, our virtual journeys bring authentic places to you in a realistic and impressive way.\n\nvJourney combines captivating experiences with intuitive, easy-to-use controls and optional interactive elements. Explore landmarks, listen to engaging background stories from your personal tour guide, and fully immerse yourself in new environments without travel stress or waiting times.\n\nWhether for relaxation, curiosity, or experiencing history and geography in a new way, every journey becomes a special moment.\nPut on your headset and start your adventure.\n\nWith vJourney, the world is only a moment away.", "short_description": "\ud83c\udf0d Explore guided virtual travel with audio narration and interactive VR experiences.\nYour personal guide accompanies you with captivating stories, 3D models, and immersive scenes. Discover famous destinations and historical landmarks in a new way and feel like you are truly there. From cities to breathtaking landscapes. Experience each tour at your own pace and enjoy every location in a calm and immersive way. New content is added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtuelles-reisen.de/policies/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "vJourney GmbH", "support_website_url": null, "website_url": "https://vjourney.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34459329137044708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830147_2655373648171872_4217521635905046021_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqVBtr38yC4Q7kNvwHAT1aH&_nc_oc=AdqEWdtTJr6k-obhBVg7ASaGozEovlykm-14VEmoCmYDfkucJYmmfeepoic6aCkC6Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CnOoGJ7eWBONEFlsd_c6Ms
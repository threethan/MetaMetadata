_nc_sid=6e7a0a&_nc_ohc=ICBumekT9hIQ7kNvwEv2x-R&_nc_oc=AdpfI6_10neu5yGMaBgeGT3HQaDB7wtaoOgrSiIScnPkWzr3t6sfyVXQOLhAd6yc2Os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP18Mj-pSjNLutjG8KUxsqlsR16CW_hJ4Cc_dN51YJGvg&oe=6AE4A192"}, {"file_name": "Progetto senza titolo-8.png", "id": "1598218408629731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1598218411963064_7585454035721867271_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTXhJVWDPB4Q7kNvwFWFVfA&_nc_oc=Adrk2VvgKk1c4mdkLL6yeMBtqek0fvnX7GCw1a-dmXUZoKgBuoIBJGqbHTllxNP5ifY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLonvdonIWOUR6O5XWy1zplXW-ldFNwDXJhT4ZEStrrw&oe=6AE49525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Progetto senza titolo-3.png", "id": "1556362466133933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507843239_1556362469467266_2758474349097520894_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmd1Vlc_92AQ7kNvwEUEwk5&_nc_oc=AdryTW9EsBWLINxo7viek9aSiIBtP-Wxs831Nm3Ti9DUhEX5o2TZ486jVu7jaPLw4Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBUxjiEPr-tWetdLBVOHe7KwV36ritDrMwIqkS-MM04Q&oe=6AE4B7D3"}, "display_name": "Virtuo", "keywords": [], "long_description": "Virtuo is a virtual reality training app designed to help musicians prepare for real performances with greater confidence.\n\nPractice in realistic concert halls, examination rooms, and immersive performance environments while playing your own instrument through mixed reality passthrough. Experience the emotional pressure of performing in front of audiences and commissions, and build the focus needed for auditions, concerts, and exams.\n\nBefore each performance, guided mental preparation experiences help you manage stage anxiety, improve concentration, and enter the right mindset before stepping on stage.\n\nFeatures\n\n\u2022 Realistic concert and examination environments\n\u2022 Mixed reality passthrough for playing your real instrument\n\u2022 Full hand tracking interaction\n\u2022 Guided backstage mental preparation\n\u2022 Piano calibration system for accurate alignment\n\u2022 Realistic audiences and examination commissions\n\u2022 Multiple languages supported\n\nVirtuo is designed for musicians, music students, teachers, and performers who want to transform practice into confident performance.\n\nMore immersive stages and performance environments are coming soon.", "short_description": "Prepare for auditions, concerts, and exams in immersive VR performance environments using mixed reality, hand tracking, and guided mental preparation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://amethystxr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Amethyst XR", "support_website_url": "https://amethystxr.github.io/support.html", "website_url": "https://amethystxr.github.io/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "it", "fr", "pt", "es", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1209809028887479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507845837_1726375635240885_3232533242578349978_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jt0gL3eVSkQ7kNvwF4aEbn&_nc_oc=AdoDekC1foEK3c8mHxS5V6SpTDwpBpuVSy0X629Zmk7EqUZR80QhXG2lj0
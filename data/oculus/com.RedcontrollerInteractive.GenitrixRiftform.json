c=AdpaVQn64W6eD8JGQ1GOuE_as41_ztehrhMXPoc0w0-GN0wzaHtc445CDgdrEKJezSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsj5l0x9reunA5EI_IgHaao28-XFUTw3UC73XUsg9HXA&oe=6B0D9EB4"}, {"file_name": "02_234527_Cindervolt_Combat_2560x1440.png", "id": "1485615000102928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_1485615003436261_9028689554668565772_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLDP_kip92YQ7kNvwFCwYfH&_nc_oc=AdqHsDk5KU1aYPVJw427gMYvFw6HLLZyP-D0L0dDDSufwC_4NVBGsuVqZV2ybJAWQ4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTsO5WMpva0eRKyaPYkPhLJFJRCApWsO5SjSJFz7lTGBg&oe=6B0DC29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "genitrix-storefront-2560x1440-v1.png", "id": "3173799979494346", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619059_3173799982827679_3658312171802536963_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x61ACBOP3LsQ7kNvwGN1BEW&_nc_oc=Adp5IF04nx1lZG0lXci7bzsJyhHPLYB0djgiTdHE8z92rqfEq_6Q1m0sBaJN6CMij5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHNVXmeWvyNAfotL9PvNqr6jIvhkBHCRWdoiJ6TQvVNg&oe=6B0DAB7F"}, "display_name": "GENITRIX", "keywords": ["Superhero", "handtracking", "room", "defense", "alien"], "long_description": "Your room is the battlefield. Your hands hold the power.\n\nGENITRIX is a single-player mixed reality action game for Meta Quest. Activate your transformation watch, choose an alien form and face an invasion breaking through the walls of your own room.\n\nWatch breaches open onto alien worlds as enemies step into your space. Raise your hands, unleash your abilities and fight to take your room back.\n- 10 alien forms: Discover distinct appearances, combat styles and powers. Wield Cindervolt's molten fire, freezing attacks, lightning, gravity and more.\n- Hand tracking: Launch blasts, block attacks, land heavy punches, and grab and throw enemies. No controllers required.\n- Campaign battles: Defend your room against invading enemies, face boss encounters and reclaim your space.\n- Hero Lab: Practice transformations, learn your abilities and experiment with all ten forms.\n- Tactical choices: Switch forms to suit the fight, manage your energy and time your strongest attacks.\n", "short_description": "Transform into powerful aliens and defend your room, a mixed reality action game controlled with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/174fg2NgzbIcKeYhj1AG_vJNnGZEwWDP2U30qLA2HEIk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1684206540156515"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771270_1146227941132254_2816663176559611976_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUtHWwSvRGIQ7kNvwG9qntJ&_nc_oc=Adp3eUX31wOmwH7QoL0viEu8F66RfYK9u4yo0hXn2O8YgGm0n6ATixG1Nh4kTlOcksc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBxI4wolhr
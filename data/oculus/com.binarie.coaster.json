dJrf6bQzTdZtZH6kE7gSo9cJFo-r4bye654ia0eYWn4iriEjSaiLOWy02JVCrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-f9EMI0Am_D5z4Qj4qQ43Wxps_J4yfy2qBMtRK-oz5Q&oe=6ACF9DCB"}, "display_name": "Coaster", "keywords": ["Rollercoaster", "Roller", "Coaster", "Ride", "Fun"], "long_description": "Experience the thrill and sensation of 4 unique roller coaster experiences. Feel the wind rush through your virtual hair as you ride some of the most enjoyable and immersive VR coasters on the market.\n\nJourney into each exceptional environment and enjoy extended coasters from a range of different perspectives. Get ready to swoop around asteroids in Space Coaster, fly with a bee\u2019s eye view in Picnic Coaster, dive and loop around like never before in Room Coaster and explore a dystopian mining colony in Moon Coaster.\n\nSometimes intense, always exhilarating, 4 awesome attractions at a great value price.  \n\nCheck out Coaster today\n\nDon\u2019t forget to rate and leave a review!\n\nThanks and enjoy :)", "short_description": "Experience the thrill and sensation of 4 unique roller coaster experiences. Feel the wind rush through your virtual hair as you ride some of the most enjoyable and immersive VR coasters on the market."}]}, "developer_name": "Monster Paw Games", "developer_privacy_policy_url": "http://monsterpawgames.com/", "developer_terms_of_service_url": "http://monsterpawgames.com/", "publisher_name": "Monster Paw Games", "support_website_url": null, "website_url": "http://monsterpawgames.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "EXPLORATION", "ROLLER_COASTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
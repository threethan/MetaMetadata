7149F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_2560x1440.png", "id": "457864648002529", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602063_457864651335862_3663465004495011840_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dexz40IdsS0Q7kNvwHM9sCQ&_nc_oc=AdrTzr7ajArumTd4SMR_emJxQ3FwtRfJkpH9AiZdcKU3MEnd5SAV_tKAWuAAQpJL4NM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReGUAekuqMaxJfKT0-ljx3sTle-VsIoAvrM76Uo-YvPw&oe=6B06FCCB"}, "display_name": "Coaster", "keywords": ["Rollercoaster", "Roller", "Coaster", "Ride", "Fun"], "long_description": "Experience the thrill and sensation of 4 unique roller coaster experiences. Feel the wind rush through your virtual hair as you ride some of the most enjoyable and immersive VR coasters on the market.\n\nJourney into each exceptional environment and enjoy extended coasters from a range of different perspectives. Get ready to swoop around asteroids in Space Coaster, fly with a bee\u2019s eye view in Picnic Coaster, dive and loop around like never before in Room Coaster and explore a dystopian mining colony in Moon Coaster.\n\nSometimes intense, always exhilarating, 4 awesome attractions at a great value price.  \n\nCheck out Coaster today\n\nDon\u2019t forget to rate and leave a review!\n\nThanks and enjoy :)", "short_description": "Experience the thrill and sensation of 4 unique roller coaster experiences. Feel the wind rush through your virtual hair as you ride some of the most enjoyable and immersive VR coasters on the market."}]}, "developer_name": "Monster Paw Games", "developer_privacy_policy_url": "http://monsterpawgames.com/", "developer_terms_of_service_url": "http://monsterpawgames.com/", "publisher_name": "Monster Paw Games", "support_website_url": null, "website_url": "http://monsterpawgames.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": []
7BPP7cvtpNgnS9Zvl-fhtRawYWJTVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsTVjQ0RsmjO4X7kr_vxVxFxBk3EoIY8z4gE7D2mU28A&oe=6B0DCD20"}, {"file_name": "KarakuriNinjaVR_ScreenShot3.png", "id": "532313842891881", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974466_532313846225214_3067714616454957117_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYpwVMV-6FcQ7kNvwG-GZuJ&_nc_oc=AdpCTfrBh8TvgKnF6C1tD8qhyDMZb2KLSTdP7VgaM_t_MAc_MU73jCaBr6WE2BXMmhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1BrrwFzEiclJoip4eaEuAJ47-TRzJdgOlxxqP5rb9Yw&oe=6B0DA968"}, {"file_name": "KarakuriNinjaVR_ScreenShot4.png", "id": "791704113013409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974892_791704116346742_5172384422555289903_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLOQMjPPPMEQ7kNvwGon5zJ&_nc_oc=AdpoDP_ZTCuTtQgb5xxlrP3L3cBBW3WOPC2XW0i5toMFW2s9CjKZE5z75pGMwvxfLRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSmJ8ImJArLdgqHGQSC_rYiknsRXq-JYVdYMUkqBxweQ&oe=6B0DA521"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QJubhy35cEQ7kNvwEQfNNT&_nc_oc=AdpGPgKhnCyWxeHfjSYBH8W1P6yrkdg-1Z66wbwuW5I6H_QW9iVFwSJ-0bFMvmfDPkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkpbHgyiQhUUoGPUnabWQjJDEpITCHWv5VMkf3qF0JYA&oe=6B0DAE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3.png", "id": "1111383943871878", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_1111383947205211_6459044739988428610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22QlrI-bFFAQ7kNvwFu0BtC&_nc_oc=AdqUcZLLazHO6Pa56pZa7-nDt2ZMypfzYtJ8YGEOAruCs-_hPfGz4AjRbl_Pr-lzEMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk3N8kn0A-oMBURSZm3FXGdWXd1T73W8toVp5-NSEqdA&oe=6B0DA691"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
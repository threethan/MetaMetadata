HRIAe1GImpWAzTv6AXY-IaDGwmyVoYyAF7C7HhTqo16YwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAeEgdmVVcQjE6fGyhFYmIlFYEFoXtyy_tYlUAKDZyHQ&oe=699EF028"}, {"file_name": "KarakuriNinjaVR_ScreenShot4.png", "id": "791704113013409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974892_791704116346742_5172384422555289903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTKIlCnYHF4Q7kNvwHP14cQ&_nc_oc=AdkyE3uN7PZM1wHy5Om6maTepF87EINoT4xbpFh6WePfkfM6H_CKemt_Gt7oq8j3jE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftjkF-AofUGQoK82DAw48eS7lcRk2QF0CnfsBkhHkTIfQ&oe=699EEBE1"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-EwG5-dlw4Q7kNvwH6646W&_nc_oc=AdkQCAIxMFi1rn2WO2hmiG2SchDTetVcFOQT8bJnmDD5b-CA0wDdU45RviiluqyM2jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsc-RhW6jTW6kPIeQX1Rzk6BgXy67DyR8GXp5MfaJ7HFA&oe=699EF4DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3.png", "id": "1111383943871878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_1111383947205211_6459044739988428610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsgiHKDJW6oQ7kNvwF0uJyP&_nc_oc=AdlQaSE9frlwIGHvEdIBaaQliGqJxK0BenOG6ixqYIVBOJksIHQ_-kBFTgvHTC5-N4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsFhTkm43I6Vj-uGRXsZkUoTZqgkYBFQcJT4Cd_LAgseA&oe=699EED51"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24848585051426212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312376_1954184468679897_6040663874196572110_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np5Cj5p-5zUQ7kNvwHA-R2v&_nc_oc=AdlkpxEvfjMZKvLlR
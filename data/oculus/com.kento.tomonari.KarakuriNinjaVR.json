id": "532313842891881", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_532313846225214_3067714616454957117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBMu4sT6TAoQ7kNvwHx-qMN&_nc_oc=AdpprgVhrcOSnoFjdxdXYqax1LTcaoDwCH5qbzjLdUfKCtLots-PBn4MkPlJ_xRvhic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQdoDOu5X4i-ot_SsnjiewfJsxT6Mnb-O9RoLqbqM4ww&oe=6AC283E8"}, {"file_name": "KarakuriNinjaVR_ScreenShot4.png", "id": "791704113013409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974892_791704116346742_5172384422555289903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GugVpiSAhPkQ7kNvwGqMpFp&_nc_oc=AdpV58rHZgr94-gQUu74Ms4mvsHAKrQ25fkm-T88qtlH378MI4oBL81aRmoVXrWJ_5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4paSWnTYGmhsdVFexE8r80R3WbUgTIFlQ3tVYu16NAg&oe=6AC27FA1"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbVtPCXpIFMQ7kNvwHbr4ib&_nc_oc=AdrWJ5ruFC90bVub6oecJELSFB2b3G7AXrMT1AAjfA8HQFifoC4N-pMJJ1pM-8QQ9Uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLQOsG_nKeiTgHhTADeiG9dSfdvYfMz9eXSZS6CobVug&oe=6AC2505B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3.png", "id": "1111383943871878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620504_1111383947205211_6459044739988428610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxSs8GYGI3IQ7kNvwFM-aJV&_nc_oc=AdqHoaitjV7q6xLB1MLRv4Jm4SF4nzop9hcZwqgCXeBwI3sBy6GhYheeURrvzUF2q50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAo4jhpF_yRuOQV2-YIrOYFFNv7x5NABLCGWPtUFzP0g&oe=6AC28111"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2702537922374
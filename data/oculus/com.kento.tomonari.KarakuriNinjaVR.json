117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQMB1Yu7sYQ7kNvwEJYt2D&_nc_oc=Adp5Amo5QggNoZVaAFHJJppNWPJLNkxqKbjDloyymUvzowKrPmxhY43TtGogvXwvrIU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AlCkYzEp75eE4sCKNutXjO7SIaGRg-6jcbppo9f0D9w&oe=69FDDC28"}, {"file_name": "KarakuriNinjaVR_ScreenShot4.png", "id": "791704113013409", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_791704116346742_5172384422555289903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqJXGQUW3boQ7kNvwEd4_6e&_nc_oc=AdoUe53Chm6QaCwadpjl3_Obh-3U9kZsY29ZIaOKArseVrBbolZ7PvGTH00fOFR-c8o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AVKwP1PXRNDsk6m6KPBzje38VdDRK03ElxmoCeISR8A&oe=69FDD7E1"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaFiHupZNyUQ7kNvwHQoBJO&_nc_oc=AdrljaV6ZYF-_YJPeY4jQQrflpRALavf7fb770VNE-e4LCBdhaVQcJjBhL_XMFjhhms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fUaEgdWYtiR5CvXUj_UkMlXHUMrEK7RUYHj5ihtyFOA&oe=69FDE0DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3.png", "id": "1111383943871878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620504_1111383947205211_6459044739988428610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVjtBBMJF0oQ7kNvwGQ3yHQ&_nc_oc=Adr8uYR-BD-cDcrx8cxYNLXzCI2p9wm5pjKaJ-kebjS-O5yQSfHukJKlOTLiDYas26o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DE8xbIPAJ41NKa9V-D5PwybLL9MVDMU-M3h0sgoEdog&oe=69FDD951"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27025379223746773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/49931237
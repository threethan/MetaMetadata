_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftjkF-AofUGQoK82DAw48eS7lcRk2QF0CnfsBkhHkTIfQ&oe=699EEBE1"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-EwG5-dlw4Q7kNvwH6646W&_nc_oc=AdkQCAIxMFi1rn2WO2hmiG2SchDTetVcFOQT8bJnmDD5b-CA0wDdU45RviiluqyM2jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsc-RhW6jTW6kPIeQX1Rzk6BgXy67DyR8GXp5MfaJ7HFA&oe=699EF4DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3_2.png", "id": "528255969838115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036688_528255976504781_5985318748757246193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vJSh1ystdoQ7kNvwHBk-x2&_nc_oc=AdnUUWfCfT-i6xi7x-skRHu-KmBXrU58H3KmiZsrBx6fiQSB2NBRxJEM0i11wbuLhSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9bGfjmMBQTgi4zElWovedABIWlWBxtROsBKLIH9kgSQ&oe=699EF771"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://karakuri-kengeki.com/ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://karakuri-kengeki.com/ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8858907524153887"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1270503348321234"}, {"status": "PUBLISHED", "id": "3751576548482562"}, {"status": "PUBLISHED", "id": "3805733206402240"}, {"status": "PUBLISHED", "id": "841979554948316"}, {"status": "PUBLISHED", "id": "778747241303074"}, {"status": "PUBLISHED", "id": "690743163571854"}, {"status": "CANCELLED", "id": "1419482412305799"}, {"status": "PUBLISHED", "id": "1197793344931217"}, {"status": "PUBLISHED", "id": "665696142488777"}, {"status": "PUBLISHED", "id": "462983450206449"}, {"status": "PUBLISHED", "id": "552957417632721"}, {"status": "PUBLISHED", "id": "1218847489424408"}]}, "baseline_offer": {"id": "1218847489424408"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "
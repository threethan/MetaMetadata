FLV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa8jWGnDgH-B2buxNFB2l_qOskZ8T1_4avvRsjDSj6Qw&oe=69AEBDE1"}, {"file_name": "KarakuriNinjaVR_ScreenShot5.png", "id": "3683920028564612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036688_3683920031897945_5662618145369587599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE5bWpjB1PoQ7kNvwHRY0Fn&_nc_oc=AdnAhh-8hndB1nm4RABTPhhdTw5tUjBgOSWy37_rnw9l1JkQ8BW76nkw8KxPHZWmsLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKOY3G5z0QyzOO7s9ARR1k-gZDTxfzFaymbLXz0y1VrQ&oe=69AEC6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriNinjaVR_Logo3_2.png", "id": "528255969838115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036688_528255976504781_5985318748757246193_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIjaeJDEawUQ7kNvwHuWY-A&_nc_oc=Admq1wkNDewMG_9xDxcGGwDuHYOsuYaErdCyx_94ogrmTRJi5XjZXiDFobRYFZzyEEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9MSssoe9FEPsGXsmVqvl2FdBsaXBMFU-PdGKZjzXQ4A&oe=69AEC971"}, "display_name": "Karakuri Ninja VR", "keywords": ["Ninja", "Samurai", "Japan", "Sword", "Fighting"], "long_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world.\n\nThe game immerses you in exciting battles against ninja robots and golems in stages inspired by Sengoku-era Japan.\n\n{855149423484564}\n\nEach stage features a variety of weapons such as Japanese swords, kunai, and shuriken, as well as items that enhance weapons to advance the battle situation.\n\n{1689142684961349}\n\nPlayers who are skilled ninja can use special ninjutsu such as energy balls and aura shields.\n\n{1285994962586025}\n\nHowever, enemies also attack with fire and lightning ninjutsu. In a ninja fight, one must carefully observe the enemy's actions and never miss the moment to strike.\n\n{1067989811457852}\n\nIn Karakuri Ninja VR, as you progress through the stages, more powerful enemies will appear. Hone your swordsmanship and ninjutsu skills and face them bravely.", "short_description": "Karakuri Ninja VR is a ninja action game in which players fight using weapons and ninjutsu in a virtual reality world."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://karakuri-kengeki.com/ninja-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://karakuri-kengeki.com/ninja-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8858907524153887"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2410409599381402"}, {"status": "PUBLISHED", "id": "1702976434017257"}, {"status": "PUBLISHED", "id": "1270503348321234"}, {"status": "PUBLISHED", "id": "3751576548482562"}, {"status": "PUBLISHED", "id": "3805733206402240"}, {"status": "PUBLISHED", "id": "841979554948316"}, {"status": "PUBLISHED", "id": "778747241303074"}, {"status": "PUBLISHED", "id": "690743163571854"}, {"status": "CANCELLED", "id": "1419482412305799"}, {"status": "PUBLISHED", "id": "1197793344931217"}, {"status": "PUBLISHED", "id": "665696142488777"}, {"status": "PUBLISHED", "id": "462983450206449"}, {"status": "PUBLISHED", "id": "552957417632721"}, {"status": "PUBLISHED", "id": "12188
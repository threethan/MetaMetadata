QMnNN4cBmOp-HZ-qP9Ie-lmmy2wOvZ-b5Ffo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WFAOkDBeQl2hh07uc2Zl_y_va4XMW7kZyeA_O6aQz6A&oe=6A410EE2"}, {"file_name": "Screenshot_5.png", "id": "839716255456263", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_839716258789596_5073910643400448713_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3E0rpIqlLQQ7kNvwENxHAZ&_nc_oc=AdpwGzX2ztAfL5DahqemH6moQtGer70pi_CjH9BrTBS7aCOH6wxsC-ZSI5DHKqLpB8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S6qLe7q71XGR4OA7Igd0UYWiEOsQFlPiwl0dbRG2p3w&oe=6A413421"}, {"file_name": "Screenshot_1.png", "id": "641138525632261", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823341_641138528965594_1336938757637520992_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXY9GGZqMu0Q7kNvwG6fcj7&_nc_oc=AdpXH9MK_5qTnY5TRZmQXMm3OcwLnH7RtdzFS6RPXirkUVRWdak8smyooSRSzRsdt80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zR2D5Fc_us-EW0I-DRxEKotEr05a8ibwgWdBV-a6FzQ&oe=6A410F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image 8 Kas 2025 18_38_34.png", "id": "1410398484039692", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_1410398487373025_3799452646507340365_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtop40XcjmIQ7kNvwH4pkyo&_nc_oc=AdpVjg7AC3-68WnptykO6puDH84oBK33bkIvFMRXkQ9DRlYyeyq9kWlnkjuPzXfqMUQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OClvJyj39nfnEA--BIHHmZr3AZHV5JTGqDmYC_qDIuA&oe=6A412A7C"}, "display_name": "Card Match VR: Memory Match", "keywords": ["vrmemorygame", "cardmatching", "memorymatch", "braintraining", "pairmatching"], "long_description": "**Card Match VR: Memory Match** is a fun and relaxing **VR memory game** where you flip cards, remember their positions, and find matching pairs.\n\nEnjoy classic **card matching gameplay** in virtual reality with simple controls and satisfying progression. Each round challenges your memory, focus, and speed as you uncover cards and match pairs before time runs out.\n\nThis **VR card game** is easy to learn, but each level becomes more challenging as layouts change and more cards appear. Whether you want a quick play session, a relaxing **brain training game**, or a light **VR puzzle game**, Card Match VR delivers a simple and rewarding experience.\n\nUse your hands to interact with the cards, improve your concentration, and test your memory in a clean and immersive VR environment. Great for players who enjoy **memory match games**, **pair matching games**, and casual VR experiences.\n\n**Features:**\n- Classic **memory match** gameplay in VR\n- Flip cards and find matching pairs\n- Quick and relaxing play sessions\n- Increasing difficulty and challenge\n- Simple controls and easy to start\n- Fun **brain training** and focus practice\n\nIf you enjoy **memory games**, **matching games**, and **VR puzzle games**, Card Match VR: Memory Match is a great way to play, relax, and train your brain.", "short_description": "Card Match VR is a fun VR memory game where you flip cards, find matching pairs, and train your brain. Enjoy quick sessions, relaxing gameplay, and increasing difficulty as your card matching skills improve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
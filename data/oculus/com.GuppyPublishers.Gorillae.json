277009303746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_2046277012637079_1791526340242227220_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxbYw2t12gkQ7kNvwEXUBq_&_nc_oc=Adqu1KmZNY5uD5e83S0kdiL2ZcI4422nx1O40u4vm8oWKPKmW812x2wbPKdQLr5T12Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ9AZobkaiE4Z5R36aUELtBNlhJDFFuWx6zBwXrAPbdA&oe=6ACB92AE"}, {"file_name": "screen2.png", "id": "1011709405176060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_1011709408509393_3258227990208744936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21DHTKgBAfsQ7kNvwFvtMzi&_nc_oc=AdqWhWPWS9FLmM6fV7yWUSbFxwI-nEpOl71OSvS286coNjiKVR7JnqdcYMk-pVGxqtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9BlUHK9eFXexg9hOzeiu8YUcBY8HvndNHv_c9-4Y0Nw&oe=6ACBBBF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillae", "keywords": ["gorilla", "gorillatag", "capuchin", "hangout"], "long_description": "The term, Gorillae (pronounced gr \u00b7 i \u00b7 lay) is a mutated species of primates designed in a lab. These creatures are mutated to have no legs, yet very intelligent in the brain.  To give these primates the most realistic experience in the wild, a world was designed specifically for these no legged chimps to explore and socialize in. This new simulation published by Gorillae Testing Facility has been released to have an open mind to what living as this extraordinary creature is like.\n\nTo move - Imagine your arms are legs, simply swing them around to move, interact with buttons to join lobbys, buy stylish hats, and to report the bad monkeys!", "short_description": "A gorilla social hangout with voice chat, parkour, and a nice community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/guppypublishers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Guppy Studio", "support_website_url": null, "we
277009303746", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2046277012637079_1791526340242227220_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QUpyOHXHOQQ7kNvwHd8RlF&_nc_oc=AdopIAB6nJcvYebK32qcxxoA5Nva6JMh1qTbLSxns1V4x0u3xiCd7WBTgiEwsZtVBC0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhbJ8hkwmlC7-VqUNtaw6MxEgYoRzJFdiIUvtAyX3QaQ&oe=6AC8EFAE"}, {"file_name": "screen2.png", "id": "1011709405176060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619680_1011709408509393_3258227990208744936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBoN2iG3QyAQ7kNvwFEXRMt&_nc_oc=AdpYg45vRjb_XGHXdIKgvi1CLWsEXzihgUongSlqVn9jUoR7VJQoth5Z-Tl3PFbcPZ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bYiUs1z-gWVQ29AwUU9KEfxX2AJpeCgjf56NbZsPIQ&oe=6AC918F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillae", "keywords": ["gorilla", "gorillatag", "capuchin", "hangout"], "long_description": "The term, Gorillae (pronounced gr \u00b7 i \u00b7 lay) is a mutated species of primates designed in a lab. These creatures are mutated to have no legs, yet very intelligent in the brain.  To give these primates the most realistic experience in the wild, a world was designed specifically for these no legged chimps to explore and socialize in. This new simulation published by Gorillae Testing Facility has been released to have an open mind to what living as this extraordinary creature is like.\n\nTo move - Imagine your arms are legs, simply swing them around to move, interact with buttons to join lobbys, buy stylish hats, and to report the bad monkeys!", "short_description": "A gorilla social hangout with voice chat, parkour, and a nice community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/guppypublishers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Guppy Studio", "support_website_url": null, "we
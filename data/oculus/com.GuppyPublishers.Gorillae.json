"https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297170_2576885069394420_1214838563549483979_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89bVMESJTEYQ7kNvwGqGOr1&_nc_oc=AdpKF9XkqElauejYXigXXdjkUygv6sfryg_Pv4_H35gr1sRvS7LoKd8IobOR5lfBHHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5NLXqlz0T68c5_Ip5NrIXQ-tn0qbyKlne-ASTRNAsWw&oe=6ACB9714"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillae", "keywords": ["gorilla", "capuchin", "hangout", "locomotion", "multiplayer"], "long_description": "The term, Gorillae (pronounced gr \u00b7 i \u00b7 lay) is a mutated species of primates designed in a lab. These creatures are mutated to have no legs, yet very intelligent in the brain.  To give these primates the most realistic experience in the wild, a world was designed specifically for these no legged chimps to explore and socialize in. This new simulation published by Gorillae Testing Facility has been released to have an open mind to what living as this extraordinary creature is like.\n\nTo move - Imagine your arms are legs, simply swing them around to move, interact with buttons to join lobbys, buy stylish hats, and to report the bad monkeys!", "short_description": "A gorilla social hangout with voice chat, parkour, and a nice community! Coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/guppypublishers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Guppy Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/guppypublishers/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
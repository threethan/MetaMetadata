&_nc_oc=Adry6TuB2r8a4gE4VDgtSa5RoMhI33FdZWNiQ0r4-oPGsY19ldmnyQ1I6LawvaEFf3s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl7gk3nd7ln_j26mKCNBin1f1W4grMGA2peEn_1f-T0w&oe=6AA3F6B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillae", "keywords": ["gorilla", "gorillatag", "capuchin", "hangout"], "long_description": "The term, Gorillae (pronounced gr \u00b7 i \u00b7 lay) is a mutated species of primates designed in a lab. These creatures are mutated to have no legs, yet very intelligent in the brain.  To give these primates the most realistic experience in the wild, a world was designed specifically for these no legged chimps to explore and socialize in. This new simulation published by Gorillae Testing Facility has been released to have an open mind to what living as this extraordinary creature is like.\n\nTo move - Imagine your arms are legs, simply swing them around to move, interact with buttons to join lobbys, buy stylish hats, and to report the bad monkeys!", "short_description": "A gorilla social hangout with voice chat, parkour, and a nice community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/guppypublishers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Guppy Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/guppypublishers/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
327196767254947893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdkq4aCnJDIQ7kNvwF9XxsO&_nc_oc=Adq2V6kiD1toKQyW4M4BQHR7WdpEQQxgYBJLFg_Govwl4VWDmEx9T5IXVC26Rx2e3Gw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFy3A7pqLuQGrgKclLbUFae4i5kteDv3PBB-DnM8e0Ww&oe=6AA95660"}, {"file_name": "sc5.png", "id": "1463017008351022", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618221_1463017011684355_8586765599955064393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSfMjvNvlgcQ7kNvwF_DRmb&_nc_oc=Ado3xoHllUL1j0rwJv7s07KJJ5KHd24tr4eEw4R2-VlQZx-L_dvKuqEvE93CTI9kjug&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1dh-qls0wpBrJTL9oU2UJoHGJipr4KOyhcRo7E8idiw&oe=6AA93761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goalverse", "keywords": [], "long_description": "Goalverse is an immersive VR soccer game that transports players into a high-energy, futuristic world of competitive football. Designed for full-body interaction, players can run, kick, dive, and block using natural movements, delivering a physically engaging and adrenaline-pumping experience. Whether you're teaming up with friends in multiplayer matches or training solo to master precision and power, Goalverse offers fast-paced gameplay, reactive physics, and stunning arenas that push the boundaries of virtual sports. Step into the Goalverse and prove you\u2019ve got what it takes to dominate the pitch in a whole new dimension.\n", "short_description": "Goalverse is a fast-paced VR soccer game that throws you into the ultimate immersive football experience. Step into the cleats of a virtual athlete, master dynamic kicks, blocks, and dives, and compete in thrilling multiplayer matches across otherworldly arenas. Welcome to the universe where every goal counts \u2014 welcome to Goalverse.\n"}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/goalverse/home", "developer_terms_of_service_u
6767254947893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8Vn7rbarE0Q7kNvwFW4j8V&_nc_oc=AdpxzJjEYuy6raKs_7zAdOByvQuUlk5jwt5azDTfyzy_tcj2LhJsH3cRlm387MjxXTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnVvdC8HsAOEc3LLJUSWR064seAWL3y2_HQaqM1Eqa1Q&oe=6ACF91E0"}, {"file_name": "sc5.png", "id": "1463017008351022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618221_1463017011684355_8586765599955064393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqpcSARIEEUQ7kNvwEriKOO&_nc_oc=AdoAGUejI9AC0MR7KZ1gQr6WhMFHUmceOwWpXP1XcGY3ykB2M9zOdx2-zMyMUkL6g0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmTV360Uxc93HUHEbWpHHrhgsa5aqwfqeVK-0hV3VLmQ&oe=6ACFAB21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goalverse", "keywords": [], "long_description": "Goalverse is an immersive VR soccer game that transports players into a high-energy, futuristic world of competitive football. Designed for full-body interaction, players can run, kick, dive, and block using natural movements, delivering a physically engaging and adrenaline-pumping experience. Whether you're teaming up with friends in multiplayer matches or training solo to master precision and power, Goalverse offers fast-paced gameplay, reactive physics, and stunning arenas that push the boundaries of virtual sports. Step into the Goalverse and prove you\u2019ve got what it takes to dominate the pitch in a whole new dimension.\n", "short_description": "Goalverse is a fast-paced VR soccer game that throws you into the ultimate immersive football experience. Step into the cleats of a virtual athlete, master dynamic kicks, blocks, and dives, and compete in thrilling multiplayer matches across otherworldly arenas. Welcome to the universe where every goal counts \u2014 welcome to Goalverse.\n"}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/goalverse/home", "developer_terms_of_service_url": nul
327196767254947893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EYJ_9WrVyIQ7kNvwHJs33u&_nc_oc=AdoSRq8YoQ3LNikXmoiWy35_w2jT65zQtYp3YQ2DPy_aNXZanYTpCYPHY8H5_VMsiAQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT_WJnoNoZR0zQUNrsW9X1cFJTQNXIv6-pXpWmXlOj-A&oe=6AAE9C60"}, {"file_name": "sc5.png", "id": "1463017008351022", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618221_1463017011684355_8586765599955064393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExKzayV5oJsQ7kNvwHrOATC&_nc_oc=Adrigmp7UGdtVi-meKsoKCScgWS8dgCyeaXk1lgzhx_-nRBmuNLxcBTfY0XE2YypIoc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2DMNolosoZFeMcoOoYEWBQVQZEWelMObHjMqpfjoeIQ&oe=6AAE7D61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goalverse", "keywords": [], "long_description": "Goalverse is an immersive VR soccer game that transports players into a high-energy, futuristic world of competitive football. Designed for full-body interaction, players can run, kick, dive, and block using natural movements, delivering a physically engaging and adrenaline-pumping experience. Whether you're teaming up with friends in multiplayer matches or training solo to master precision and power, Goalverse offers fast-paced gameplay, reactive physics, and stunning arenas that push the boundaries of virtual sports. Step into the Goalverse and prove you\u2019ve got what it takes to dominate the pitch in a whole new dimension.\n", "short_description": "Goalverse is a fast-paced VR soccer game that throws you into the ultimate immersive football experience. Step into the cleats of a virtual athlete, master dynamic kicks, blocks, and dives, and compete in thrilling multiplayer matches across otherworldly arenas. Welcome to the universe where every goal counts \u2014 welcome to Goalverse.\n"}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/goalverse/home", "developer_terms_of_service_u
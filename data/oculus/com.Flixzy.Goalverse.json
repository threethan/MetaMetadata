6767254947893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdkq4aCnJDIQ7kNvwFJx9he&_nc_oc=AdqzthWznJf2JxYL2AlX5bLYq9uT1yFuWg2gl1hE0v1k6wcc1mMTL7ev-s3oBpGNVYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFvFUPpQcZ4ofX7hwkKfY_ATIUiV_ZQFg770LvTnRxCg&oe=6AA6B360"}, {"file_name": "sc5.png", "id": "1463017008351022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618221_1463017011684355_8586765599955064393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaEzvIVhgOgQ7kNvwGwwf7C&_nc_oc=AdpuNoAP5IeF-Il21hyG_aQ9igV17pGV-dIGyKuF9ElHS3ADG3OJxaJj_gmsndoCUBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTK0I8GJSo3FR1hjwZFdF-07peXSq79Aoz68A7G96ufg&oe=6AA69461"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goalverse", "keywords": [], "long_description": "Goalverse is an immersive VR soccer game that transports players into a high-energy, futuristic world of competitive football. Designed for full-body interaction, players can run, kick, dive, and block using natural movements, delivering a physically engaging and adrenaline-pumping experience. Whether you're teaming up with friends in multiplayer matches or training solo to master precision and power, Goalverse offers fast-paced gameplay, reactive physics, and stunning arenas that push the boundaries of virtual sports. Step into the Goalverse and prove you\u2019ve got what it takes to dominate the pitch in a whole new dimension.\n", "short_description": "Goalverse is a fast-paced VR soccer game that throws you into the ultimate immersive football experience. Step into the cleats of a virtual athlete, master dynamic kicks, blocks, and dives, and compete in thrilling multiplayer matches across otherworldly arenas. Welcome to the universe where every goal counts \u2014 welcome to Goalverse.\n"}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/goalverse/home", "developer_terms_of_service_url": nul
png", "id": "1746527232641598", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_1746527235974931_1327196767254947893_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftX6a9h1cjMQ7kNvwEXQzQ_&_nc_oc=AdrnI1Cu5UFmTYNxtrQi124vc1ehq3fQqAFUO4qIeuieCq_wGdbhGfWtVHpsTFaRvrs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv-iahTfPJ1FoUs0ecRkar-rzHiIeZMUiZyBfbPXnhtg&oe=6AF32A60"}, {"file_name": "sc5.png", "id": "1463017008351022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618221_1463017011684355_8586765599955064393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhYxeJO5xBsQ7kNvwEs1fFV&_nc_oc=Adq8XO5AoExmTbteTGX-xzew413LFw4QBF7m-wscTQNw2eqV6cCJJWXJyIfi3hbYNP0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStrViDK-pSig1q8wEM80qrPWRDBcy4oIyu-9c9ekMWXg&oe=6AF343A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Goalverse", "keywords": [], "long_description": "Goalverse is an immersive VR soccer game that transports players into a high-energy, futuristic world of competitive football. Designed for full-body interaction, players can run, kick, dive, and block using natural movements, delivering a physically engaging and adrenaline-pumping experience. Whether you're teaming up with friends in multiplayer matches or training solo to master precision and power, Goalverse offers fast-paced gameplay, reactive physics, and stunning arenas that push the boundaries of virtual sports. Step into the Goalverse and prove you\u2019ve got what it takes to dominate the pitch in a whole new dimension.\n", "short_description": "Goalverse is a fast-paced VR soccer game that throws you into the ultimate immersive football experience. Step into the cleats of a virtual athlete, master dynamic kicks, blocks, and dives, and compete in thrilling multiplayer matches across otherworldly arenas. Welcome to the universe where every goal counts \u2014 welcome to Goalverse.\n"}]}, "developer_name": "Flixzy", "developer_privacy_policy_url": "https://sites.google.com/view/goalverse/home", "developer_terms_of_service_url": null, "publisher_name": "Flixzy", "support_website_url": null, "website_url": "https://sites.google.com/view/goalverse/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24092608197070058"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24202338106097066", "version": "0.2.3"}, "id": "748481921103974", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24092608190403392", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24202338106097066"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "748481921103974"}]}, "change_log": null, "created_date": 1754989440, "id": "24202338106097066", "version": "0.2.3", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, 
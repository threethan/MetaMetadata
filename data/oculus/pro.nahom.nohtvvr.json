v-20260508-020935.png", "id": "1279726584349107", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823790_1279726587682440_5387128498943759879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXdlgjc_3tgQ7kNvwEKmJFY&_nc_oc=AdrwcqoBlfxPjojVNhDyE38gDOEn56Qi_KGNcwrTpR095BKJ5gVflDSSbwFnIQIN2RA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGLyyBssVIxwC40QbRC0ajSw48uwH_UtodyKlWrb941Q&oe=6A8D6D11"}, {"file_name": "nohtv-20260508-015334.png", "id": "1904921110163885", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821115_1904921113497218_8359387947134429169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OQQ1ZebQckQ7kNvwHJnC6r&_nc_oc=Adrj3lRzBB2rsTfbr02FVzl2o-aylSP0IuC-mH4awyvjh8qXHmpsDD6sVt1ZeWYTvug&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERuFus3IUjiT3dm8_0-dwCemtWXVkE_ss6Q99oFS2bPA&oe=6A8D9909"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb3.png", "id": "6747968188661161", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974836_6747968195327827_2034935819975390641_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0-Kd1i5T64Q7kNvwGr6r6x&_nc_oc=AdqTyIKSUoEwYjySBFIbjECajYLyoHEQZacKv1att7PdmzcCmKxxVyt-6Cd2JVBy41I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN1gaTVSd8pkL61tG0G6VBsxsOiEjFIhPOp8kVbmvwVg&oe=6A8D95FA"}, "display_name": "NohTV VR IPTV Player", "keywords": [], "long_description": "**NohTV VR** is an all-in-one VR video player for Meta Quest and other Android-based VR headsets, including **Meta Quest 2, Quest 3, Quest 3S, and Quest Pro**.\n\nWatch IPTV, local videos, USB media, phone-shared content, and PC streams inside an immersive 3D environment designed for private home theater viewing.\n\n## \ud83c\udfac Overview\n\nIf you're looking for:\n\n- a **Meta Quest IPTV player**\n- a **VR movie player**\n- a **local video player**\n- a **USB video player**\n- or a **phone-to-VR media app**\n\n**NohTV VR** brings all of these experiences together in one place with simple controls and multiple viewing modes.\n\n---\n\n## \ud83d\ude80 Features\n\n- **IPTV Player Support**\n  Playlist-based streaming including **M3U playlists** and **Xtream-style providers**\n\n- **Local File Playback**\n  Play videos stored directly on your headset\n\n- **USB-C Media Support**\n  Open videos from external drives and flash storage\n\n- **Phone to VR Mode**\n  Mirror your phone screen in VR and browse media via the _NohTV Companion app_\n\n- **PC Streaming Integration**\n  Connect to **Sunshine** and **Moonlight-compatible** PCs\n\n- **FTP Browser Support**\n  Stream videos from remote devices or file servers\n\n- **Immersive VR Environment**\n  Enjoy content in a full 3D home theater setting\n\n## \ud83e\udde0 Why Choose NohTV VR?\n\nNohTV VR major features:\n\n- Watch live TV from your favorite provider\n- Play personal media\n- Stream from your phone and PC for movies and games\n- Open files from USB storage", "short_description": "NohTV VR is a full featured video player for Android based VR headsets like the meta quest, quest 2 and quest 3 headsets. NohTV VR player supports various formats and can connect to IPTV services. Enjoy your content in a full 3D environment with various selections added soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohtv.shop/terms.html", "developer_terms_of_service_url": "https://nohtv.shop/terms.html", "publisher_name": "Nahom", "support_website_url": "https://nohtv.shop/support.html", "website_url": "https://nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
20935.png", "id": "1279726584349107", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823790_1279726587682440_5387128498943759879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eseflTwiRhAQ7kNvwFM3O6H&_nc_oc=AdrnNMCWkCLFLQrx_Xx-yUtiNLOprYipfIRycACcz7kv56vhsT4C4AAznsLLEpKXreU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0dA3clsrJ79c6VhXwk8hnEkg_NF3hvIAoKL3LLdPBOg&oe=6A564651"}, {"file_name": "nohtv-20260508-015334.png", "id": "1904921110163885", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821115_1904921113497218_8359387947134429169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5gh_Je7AHwQ7kNvwGv5N9g&_nc_oc=AdpuMFKEm7SAKiOgDx-Tcd9a-elNrWnPnpYZRUelnpgGgEh8e73oFr9hAhf-545Orgo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbJ1dVNY67WlEWOO0KtU9ZD1KjfRbmMb1rLYyP8cDIeg&oe=6A563A09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb3.png", "id": "6747968188661161", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974836_6747968195327827_2034935819975390641_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaf9DkIlZVMQ7kNvwEIM2sl&_nc_oc=AdpZrB3f-a5-ueHuRXV4iPGMAx1faG1n9fD9TEIitvccikA5x7slInCSk2HD6FuyTTM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl5OwODCqeQpd9_fNMaJIYPT6ZsFJruwvNJwIFZi75Ow&oe=6A5636FA"}, "display_name": "NohTV VR IPTV Player", "keywords": [], "long_description": "**NohTV VR** is an all-in-one VR video player for Meta Quest and other Android-based VR headsets, including **Meta Quest 2, Quest 3, Quest 3S, and Quest Pro**.\n\nWatch IPTV, local videos, USB media, phone-shared content, and PC streams inside an immersive 3D environment designed for private home theater viewing.\n\n## \ud83c\udfac Overview\n\nIf you're looking for:\n\n- a **Meta Quest IPTV player**\n- a **VR movie player**\n- a **local video player**\n- a **USB video player**\n- or a **phone-to-VR media app**\n\n**NohTV VR** brings all of these experiences together in one place with simple controls and multiple viewing modes.\n\n---\n\n## \ud83d\ude80 Features\n\n- **IPTV Player Support**\n  Playlist-based streaming including **M3U playlists** and **Xtream-style providers**\n\n- **Local File Playback**\n  Play videos stored directly on your headset\n\n- **USB-C Media Support**\n  Open videos from external drives and flash storage\n\n- **Phone to VR Mode**\n  Mirror your phone screen in VR and browse media via the _NohTV Companion app_\n\n- **PC Streaming Integration**\n  Connect to **Sunshine** and **Moonlight-compatible** PCs\n\n- **FTP Browser Support**\n  Stream videos from remote devices or file servers\n\n- **Immersive VR Environment**\n  Enjoy content in a full 3D home theater setting\n\n## \ud83e\udde0 Why Choose NohTV VR?\n\nNohTV VR major features:\n\n- Watch live TV from your favorite provider\n- Play personal media\n- Stream from your phone and PC for movies and games\n- Open files from USB storage", "short_description": "NohTV VR is a full featured video player for Android based VR headsets like the meta quest, quest 2 and quest 3 headsets. NohTV VR player supports various formats and can connect to IPTV services. Enjoy your content in a full 3D environment with various selections added soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohtv.shop/terms.html", "developer_terms_of_service_url": "https://nohtv.shop/terms.html", "publisher_name": "Nahom", "support_website_url": "https://nohtv.shop/support.html", "website_url": "https://nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTAYc0udhooQ7kNvwEj2pUt&_nc_oc=Adl-QVlMchS0Jj8EVh76zdqNQ3HFRKn7bjimHx6jOHo9QdXSjQwDO5bAiiSLtvQimk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0PlWFJT4vCjmQRL2pZ9n7JgaJ274Tv4vkFgBySv7BDw&oe=699DAA34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWiPBKzGnj4Q7kNvwFxdqho&_nc_oc=Adm6a9cBFeH9ccLQhnvPVYErReziG0Dh8bzj82TdxznKXzjYq_HkIAiMYucp5Nq0DwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEqJFg5f3yTvdW26w3x4zhGHjc5geLMepw4Lt-70CNgQ&oe=699D87C9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B844lNd38CAQ7kNvwEa29-B&_nc_oc=AdlFh23NJlWy2qjUPwBGHDKBu-Jtjgok_V2lorMUflVbdib1YGHGtcVZJN_asdFi7Vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvEAZ1m1xdN1TFL5N0enQMvDees_bC6fiWXg2ZyIBg-Q&oe=699D915F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlqxcXzbyUEQ7kNvwEk1OJG&_nc_oc=Adk_fQBVIvInbDvLCUx5ynFV2ewU2_SqGYKF8_1gTfvB25dncF2fAaum_0oa5b5MWnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvltLlmKM39bY9Y4PNgf8q5For5GAMhCytMu_ABJG9txA&oe=699DB59A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRvG__E_2sAQ7kNvwEXvkJI&_nc_oc=Adl8t7ak4nkYgjbCwwvmvBMbQ-ept_
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mGUauR-62AQ7kNvwEqNx41&_nc_oc=Adl_GSz0MjLrDwzuxkR8QyBgvtX4e-C6-MFlRaLlnvFI6QjDM3RqKfwGV06Vvw2V0Ec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu0Tn3lKuHxz7C5gXWXFcWy0R7F0Iah78ptFUKRHTe9dQ&oe=69986434"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSSkwuy0R0MQ7kNvwG2nsPO&_nc_oc=Adk98zXKhpFMlmGauQGLOnRs2vjYTQzxp-a6-DjfWqqPvX2RxtrEqJ-Hg5iabQZa1SE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsEQcBZ09_9GOaiSJ9zmX1WSufKyreiO1oEbQOyCobznQ&oe=699841C9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8bV2oLAeeoQ7kNvwH_CLgS&_nc_oc=AdkJnxA996CJRFYmCy0gR2jr2tV0q1Q3j-6QAMjAEbgqNtRv7RgjR8stmUx6uFIHaHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvUFbPYNF8ZUoh_HKQJ9ckwMV5DaiPCDucFGduVEURYKQ&oe=69984B5F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6OLuCP4mvsQ7kNvwFwFHnt&_nc_oc=AdmhzBr1wWtQUQWPAOP3zwyKWS1G9CKEzsHqyaC2KYULPqo8KVIxPh_TvTb8xjiy8Ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsoOUwAVBuPLcRbsN2b-mngWCwYTg80jc8XWO14Hx1gdw&oe=69986F9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1um7oQjyU4Q7kNvwHoqP0X&_nc_oc=AdlZ1bPltIE5tOW93MYh12fPwA3SJ2
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTAYc0udhooQ7kNvwHtxUFL&_nc_oc=Adnq7P9h3sn3AsO2NjAneGntIXV9zrsCY_l6fYxT5AKEDR3it9qNXOr_c_rNNEz54VU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvbCsXlXuq2-9aDfV7hl4t57Q1BH6oE5zbRWYRqfkaLbQ&oe=699C58B4"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plIL53pG3lAQ7kNvwFyoRUl&_nc_oc=AdnZ_u2NrDM_DJ6h21J7Aj-JUVxHO0Y3W7OX_34AtNZE-xf8KyxMwG45OahCn254xbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs853ZmZRbC1EpE-fpKQwyxC-AemkD50BjU3IUyjckMyg&oe=699C3649"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRas9i7Qe6UQ7kNvwFDChHq&_nc_oc=Adl29HknJ_w98fGDECiSB1iEsKaXVfVDWjjvvh3c9rmcQbWgk-Yx9dajl2aBcj4sFAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvPILGzoaOQ-NrqbFlCrBO7uVXqL0C1YRg6PWOyEqA4Mg&oe=699C3FDF"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlqxcXzbyUEQ7kNvwGLwhRi&_nc_oc=AdlOuXNyavi7kW236RcGGWBNupXaRfExFd6Lz9TdFZ2LPDMYdOReJw6PO9eMq6j_5Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsmakcafL_aIuEWManidFb4c9OWVXIMk2MEAfxzSou6qA&oe=699C641A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0fvw-VbhwAQ7kNvwEDxtF6&_nc_oc=Adk_U4hUis-j2oRsZxQ-HkLG8UkWWC
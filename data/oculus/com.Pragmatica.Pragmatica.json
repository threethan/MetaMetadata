cdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEDhtyrfY7EQ7kNvwFxBreN&_nc_oc=AdkUAsmV1kyOLfZ5AhrCMt4hOI8uZQukHqXC0vVb8R8XuM749XaEAV93Y-rgOfXmnXE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH-QTeK1cetWPTllOV8pKEkNbwf6UAMDCfbrk3a8cdpg&oe=69AD7C34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVspNeIsY4kQ7kNvwE5naMs&_nc_oc=AdnMPWMwS8FZ3XIeOUT5Nir5s6Xl8QMIgvDmQxR-2-o_aZVLJohs_TI5XX-zy9q8Vsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6jLvLZxhHzz1ZBBjjmyvnZECyvT_0-8lYP20RT2p7oQ&oe=69AD59C9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5FEMNo3rjkQ7kNvwE79bUT&_nc_oc=AdnWzzgjG_akrtxTba7xfJ48r2S2NBsyXvXIFbc74RyKalhnIjOSrWM8WHRU0evlwCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjkBybDJ_xUZ4fCQdJJPhnRG1xT0238dr4My0wIMBIBQ&oe=69AD635F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C62d0AChdkQQ7kNvwFy8RSW&_nc_oc=AdkDqs30Ewl4tPhd9RqTUg20w4IMMF_wzkX7-oczYVNCXZgpBfAVtTxqvFB_IT5_kUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd1WqNLx8z7gm7FSTKa8ppb-PKGKSDvDG8n9NBxGld1w&oe=69AD879A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x
": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16a_6dedmSgQ7kNvwE41yZp&_nc_oc=AdoOjFeAibJHi2PehJOwBpCl61_nI9yfrqpRa61eE094vhKRqfgtUGsxFiuncmHr_D4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcMtxUNYdPLwVEgNbR-1-91W9AgHRI78bzIE1Hn7fhhg&oe=6A5A30B4"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdtNwI4hWvQQ7kNvwETv_b0&_nc_oc=Adp6wD0bHLQnT8ykCXEl_TJmPR6i1dn1svj3GJHwYvpM8ggluMAjvrAv59e8TAa2ffc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrABvDj1YxQK35d8Dbzio883EiKsFAB3Ci5bMcvHxU6w&oe=6A5A4689"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPs-JwaJ9tUQ7kNvwGu1xT6&_nc_oc=Adr3vHAsCElrCcBelL_3QvmZJagveJg_ZDsotQB1cBqGYDCnf-HJG6Nv4em8kRsi3D8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaRuFtr5ow2SQ4aaxUss6y298xEQ7wCCd_A8ovYVdxrg&oe=6A5A17DF"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uylFWYaBbywQ7kNvwFZUwFO&_nc_oc=Adp8TQB5in2b6tGLoFApv1Ny_3qzqO4kJhON_ZUhGTOwhjLHUAJnhi-uelyH8QdfuWM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKeekLhZqCzwggkTK8E0oFghMQYjD3XFF3uDt0WHn2Cg&oe=6A5A3C1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_299549706
cdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAWBrMDi5f4Q7kNvwGfrR_C&_nc_oc=AdkAyE3MaOWMhJsm8JxSWdSDS6eguaj2pflDaIC4BqvqdXJIWmRozzeKRgmuCEbdSWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqKvGYJh8vi5AVTntgdjA85lRPTuwTnNeyibRIyMKrBA&oe=69B01F34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVspNeIsY4kQ7kNvwH9RyIk&_nc_oc=Adkt-7T3EZZe0-9K3ZGIvqoV9svbsdnF_fMLyK8SOxi7iz_dsRE7b0GejLJIKVJ2o4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaTeWyIGUAs1KblBVldo77FziVPCu2np_Qnmtvz9b5rw&oe=69AFFCC9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5FEMNo3rjkQ7kNvwEu6axR&_nc_oc=AdlF2lbCRwf6OFUBIxupG_5cDiIf5OtZBTnlcJVk_55dyuTL5G-ze1Pi3qQUZJ4Mx1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJv7fYymFIHOHVlR_izYaPwIvQbFzro0QvFX5XOIAbDQ&oe=69B0065F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF7Mr9a3SXcQ7kNvwG6TEey&_nc_oc=Adlxt-bVGeBXohy0rrYV_180uij0cqnMNVMWLif8Woy7w6_vavcqv6M7AuclqLJDmyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIVPlqhAdw3QEqEkLBD-1BMDuaZ26m-sPWceExnoRrqw&oe=69B02A9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x
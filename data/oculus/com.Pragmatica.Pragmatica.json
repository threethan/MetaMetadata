": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBghoa4QwdkQ7kNvwH_HtfA&_nc_oc=AdoA9EqTp_PzuLmhY6QkKbg3lcEx_Wnw0n7Iiu9P9IH6wrrrupvJpA7wb1m_M3V4s7k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-8VuWDIobMO2zLpQ6SrdeJa0lxR6I1nWZ4UbK2y_L8g&oe=6A974634"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmLgEmf1DvIQ7kNvwF1JOqW&_nc_oc=AdohcdmZjpaZEMbbvmr1CGhdNO6cD4tXd9vBHqxqCs93uX_NDo1ZyNhvUxsUnEg7vq8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHew7yCYmruxB_PKKQ-QArehuYJ7H84S9DdNGnQbM_Yw&oe=6A9723C9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iWm6T6gwPUQ7kNvwE42Ur-&_nc_oc=Adrm_V-sCksSIcGrM34rLfbh3cn6oR1n-o_TDC-LwPAS_Uv4zQhA16M0gWoQ4Lddzl0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2eP9Tlv7vLfk-P_YGKiEmJTJDh9C8klyfno1O0JGY0w&oe=6A972D5F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLSzzJXo1ZAQ7kNvwHvfTdy&_nc_oc=AdoZ5F2kX_iOkdY9R4tP_6kUeF0DiID16f_UkLSZTHyEcWGQBcNIxgSWtXLvW0Y5rkw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhGBvQ5fuLnkj47I0MtRIIz2kjGsFFy7dYqOH9en95zQ&oe=6A97519A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974904_299549706
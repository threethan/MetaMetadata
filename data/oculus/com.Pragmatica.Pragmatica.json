png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqWg9jYh_r8Q7kNvwHZVN8A&_nc_oc=AdoklD8SX84psHh2HlVlaBnRQMjaFK9PWdx1BHIT2GF7mfmlHrxX2shKVUrkGpHNmWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2KU8Fn5TW--8MZfKMN8-PLRiT-S0oSq9g_hdgezy0rGg&oe=69F0B8B4"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf7OXbpmKQoQ7kNvwEaI4_T&_nc_oc=Ado46o6s223eb37Iz-6co09zvG2qK__j_K37JMUz83ngjrZX3fOUW9K6rGUX86KAVP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2nMi0P2_XDgwllbIdz3gNSWhHQ9Geek44dxv5Q6SMLXg&oe=69F0CE89"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzys7k93lAYQ7kNvwEbmU8p&_nc_oc=AdroV2j3f90l4NvQfcu3md6q2Gur7zhVbUWPwuUN4ftTIpQfGKIu9Yr4tG8zp5HDEmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3IncpUobO_QK8q6la-Zyr-wlrmwq2avP2LDDFA6oYKmg&oe=69F09FDF"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqmgvAsPu24Q7kNvwFeI8nd&_nc_oc=Adohy9HoE-EdMnaX8jEApOE5MKncgfVghnL-HSJJRMJw5YJRvtXvyBJBhlIhOpMBt7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0cnwfTOd73uL4O_THW9G3l6JGUVEmnFaKYTE7ITRTa0A&oe=69F0C41A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0YIGVvgttEQ7kNvwEDRu81&_nc_oc=AdqDgO2BrV_OZE07EYT0h5i3gxrm
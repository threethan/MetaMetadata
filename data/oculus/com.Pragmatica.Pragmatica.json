": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEfuG4peUTUQ7kNvwEHkEax&_nc_oc=AdoOVnwpvBED3V4wwIFMwwg53NCbJrHSdytIPWHF9qf5C3vUf_E3Gr32pnOq4yiZ0Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75ZeYuN64AEQe-GxpCSZLsNKk9hMLX4ukKPrY5PFoRmg&oe=6A072234"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfpw0XXTwcQQ7kNvwEbFfsS&_nc_oc=AdqxFBhSGVoP59MvScxmncslzoQJTvy2LCVw6samG9x0dZs5O_FJJZkLughHyAdwTQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WPuTSdQfM3qV-mSrvlb2Pjqis29gDO-I9lyokcsfGyw&oe=6A073809"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOUr_3cNU94Q7kNvwHoJEDk&_nc_oc=AdoN1iwdvhnaGehrw-xrnkSJvw_old4oQWH3nC3sVp5tlOEN387NtLEtJTDoXrLOHcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IlJs3v8t_QDVwGjBcXLTinU6a0P_FUDkTgJTWlo2bDQ&oe=6A07419F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXn6qudRv_kQ7kNvwGNaH7L&_nc_oc=AdogsZjxmsXqgDtnBZSNADDl9lDFBgP3IjLRehelH96ogcJSYIJomOa1fkX-oVuJkOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HfsJdSNO5bsAO1qe6NmoPzCczrCCFJOsEtyNT6W4qqQ&oe=6A072D9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_299549706
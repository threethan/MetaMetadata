": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iVUVxt-knkQ7kNvwGRPeYn&_nc_oc=AdppACrlZrTbIGxJc0Kqg2nupEngz7AVe3sc7Uy_NQrcAVZ7kj1x9hw2P4flX07N3D4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmSzqLvRiR-uBYQpr39l5PLzWwiuP_pAQjIeB1l1TqWg&oe=6A830F34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mkef2LM6PiAQ7kNvwEEW-Vz&_nc_oc=AdqPoJdKgEXEa0d3mAO3OkUEnD66fNU4lBfv4YKRtHU0Wm6Ti_4EPh5b2tvRwmbnhUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMECJApXp1rQ_o0yzNWlGUTxr12BL5uE8lX402JBhotw&oe=6A82ECC9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB1IvyckCCwQ7kNvwFA__m2&_nc_oc=AdrsGv7K3TulirYL0nhB30m-gImqV3qP5lE5yJlFHZ_AOgqvWQVHTem2RI9S41uP9Sk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDZpa-_1loSceDXgdCD2nQ5BFZ_mCTHRLEn0bm-wkexw&oe=6A82F65F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjES5VEx8QIQ7kNvwFszVp3&_nc_oc=AdoGCCXGzc20_tfaptmKoxGih6QMDe-3J9601Q3kGLvHzukCFynIMm_jzZmfaJlNpMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZnzMr5mnDqgL_ukTN85Z3YAidKiSuZqN7aOgo1sX0_A&oe=6A831A9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_299549706
_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhEICx-fvp4Q7kNvwFCEbUY&_nc_oc=AdpeRwxmGbZIdzUNcTig5KOjNooswz6w6IitoOL4KhVlpreGhI6in_V2yCUaPtpL6F4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKCcjPZqWrd5dyvJQs1vN2f1-z5dgpQb4TbHWLWLywmQ&oe=69C3CCDF"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENAddTMuxIMQ7kNvwEsKpts&_nc_oc=AdqRACjyx3f-V_6gEt01MK_v8FCdnBhI0dM1HpAxLNW1pJSwNpP9jash1nBUetAICkM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwod8OTHHTLoH-R0eVOzzco1fN8zBNm8F4kVunkGi6uTQ&oe=69C3F11A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1319844985336716"}]}, "baseline_offer": {"id": "1319844985336716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1718297460, "status": "PUBLISHED", "id": "1319844985336716"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26281403304826850", "version": "1.4.1.4"}, "id": "1080249596716459", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6886713338055803", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26281403304826850"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1080249596716459"}]}, "change_log":
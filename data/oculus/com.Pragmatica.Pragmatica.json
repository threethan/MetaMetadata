": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qggxhq0eyfUQ7kNvwGeyS4M&_nc_oc=AdovSOLL5CjbZrMUZunxNvRTFCd2scIAYIfut2plewknQJFmstzFLxa0h0yFt8208Lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tTpaFrfdvreBY7e-6yj_r4KGoiDkW2c8PMKYrKWeA_Q&oe=6A202EB4"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3AbTBNURzYQ7kNvwFPQsdi&_nc_oc=AdodXyj-r-CNbfCaelEqMFROUUuZg_RE4m3uvPhBFlRG2b2WztaA-H4s0kvJHWVSqLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67wt7dVzVW9JDrG1wl5ATVWE_YPdl6zcVWyNWdvAv4jw&oe=6A204489"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyYu0-Eh3l4Q7kNvwE_hg2S&_nc_oc=AdoYnPRLlNbvo_YvRKJeInaLp6qhbXKnnDpdqD7kL_gWK1EyZTRaQmJJV7a9sU1Ujd0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W3unq4HKRL7-j3y6WTyiTtRzBE_-XBAWDiB5Qx65l3A&oe=6A204E1F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiN01eC5s6gQ7kNvwFvSIIT&_nc_oc=AdoA4GanXDoH4Mp7Na74KkBEGa83-sDqA2ozW57Dq_VTjQvaFs8lrJ6kfx1GMaMX9do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sZcNq7fnSsVPNMFmvo-3UKJLHF_m5EWOMNGUow0Li1A&oe=6A203A1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_299549706
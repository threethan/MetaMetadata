": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031429_1465699580944379_5678029584034341703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpzxg_RWB-4Q7kNvwGdzM2s&_nc_oc=AdrZNRCx_byOngw9WVXQK70SZZOJyJK1tfHRCP4V5YuwjanX2iHDHi5RKLW0XyjQfOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KKyJXRJt7biXrEfKxfdpotD24rVtAoTtfOz4RGLKzgQ&oe=6A3BDE34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V41kAWFFdMQ7kNvwGnCadB&_nc_oc=AdpCsRMrb_kCGFifMIIRxSvtCkUt4A5JoQ1k0K93BvBxQhcY4jLlnE4lrbEflMwOMkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-svW5sgOreR6PelXRwkUv5coWa7maxGRKZs4VJEeaEng&oe=6A3BF409"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8nrhJmuAJ8Q7kNvwES4kRb&_nc_oc=AdpU3nXzo5ofGtd8hxjxQY7HmucjT576EYuw2WL3ZlIiDVkVpe8Y1Vid7hmWHaE2vbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8RoRMa0QYiG9v1TbcstUGjwM67hgxSoGzsKN13GGnOA&oe=6A3BFD9F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WRZ-hOfoWgQ7kNvwE7SVb8&_nc_oc=Adq_3-k7UvUlunzNb7jpuRUjMlvarQ_mctsVDzX8pAYggFn8AQ8FQWMhxTeEyTbZNik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WXmECCsUjRJL9QxOr2YN9c4fBk1jApFF47CBA5YScyg&oe=6A3BE99A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_299549706
g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-y3uo5iZLMQ7kNvwGDjBZz&_nc_oc=AdmE9GliOXS_XLzDyLG-EO6YCbt0KMJuafsmuJOJVjtP5jk3mjuk91tU2jbs10C64rE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvL-b1ttLSFUTzW82D8RwNUz5888fnycpO9NdV2NVNcw&oe=69A04D34"}, {"file_name": "Gall2Cropped.png", "id": "239709659117578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75286676_239709662450911_1483318958292218213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWiPBKzGnj4Q7kNvwGADMmp&_nc_oc=Adm4MxJ_qDF9saGXKdByhcieUgx0RzXAIuVtpg9E26YLJRBVb2zuJNQW3tsxlJ8HSgo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJa5r0CvY-CnZPC0DOQCsB93ZdGdlRl9YjwyXYkvrrUA&oe=69A02AC9"}, {"file_name": "Gall3Cropped.png", "id": "709644807730856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001730_709644811064189_1504166936118797000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B844lNd38CAQ7kNvwET5w47&_nc_oc=AdkJ-4yU8bgE_V5a9rfV8YFwEChIHH7_fc3FXFr7A6EtXrbA6Qcp0OqMAYcWbNEdWwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsL1tyfvGmd0XotPCIkNBUD1hw3KmGalppU8tOFPVwKmw&oe=69A0345F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hna0rEwgH4cQ7kNvwF7XV-F&_nc_oc=Adk7kU8PA93mC8USEmSA9vDhghvSLG0f7mQsya1CaPR5hYvluVtvmT3yShu7ESMunU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAI6-PNFHXTBq9kfr7Zj-FUnCtLDF47haToUhDzZTHjQ&oe=69A0589A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "http://pragmatica.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7809661289094332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_299549706221507_1427337472960333493_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRvG__E_2sAQ7kNvwF3KGhh&_nc_oc=Adka4QL4wgBWe4dZDqxdwSIKXOlcy1
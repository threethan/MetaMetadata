e3AU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfslfeivanIcscEzPnuIJauBRpzi27x9-q0Jwjp8LN9ZBg&oe=699AEE5F"}, {"file_name": "Gall4Cropped.png", "id": "850506819869091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_850506823202424_6429397341226708739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlqxcXzbyUEQ7kNvwFMLd0I&_nc_oc=Adkqmha20byMtZ7CJpPXX7pf6zxqXauZEr_Fju-C0Ly64Mkq6Fhpym1LSikR5BKi7MU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscQ3H2-lAkfEWOANWY0fEWGgTwrLw-KL_w9BcvlK49zw&oe=699B129A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pragmatica", "keywords": [], "long_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy for those who are unable to access the therapy that they deserve. With Pragmatica, users are able to practice a large range of skills through the form of professionally curated activities, made by clinicians. Pragmatica uses voice recognition, AI recommendation systems, and data measuring features to track user progress, all of which is accessible on our cloud data dashboard. Clinicians, parents, guardians, and care workers are able to view the history and trends of their child and/or patient remotely and asynchronously.\n\nIntensive therapy is key for individuals with communicative disorders like aphasia and autism. Pragmatica offers an extensive solution to this problem at a more affordable price than traditional speech therapy.\n\nPragmatica is for users ages 10+.", "short_description": "Pragmatica is a Virtual Reality solution to supplement speech and language therapy. Pragmatica allows users to practice their communication skills in a fun and interactive way for as long as you want, wherever you want."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pragmatica.ca/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Pragmatica Inc", "support_website_url": null, "website_url": "
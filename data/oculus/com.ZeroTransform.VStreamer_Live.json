A8583E5"}, {"file_name": "VStreamerLive-4.png", "id": "863817605097604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974705_863817608430937_1411759223208000570_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j3iiOpKpxYQ7kNvwFkSTd_&_nc_oc=AdpEmfPgOXztxvgOBoNDRZztQoKeUa8RVD4w6Fv3myes1weihuhIHw04Agt2r5jiPsI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsmoIwvheIJC9oJBreqLyA3IUg18On2Nlu1Kf3Uz6VBQ&oe=6A858D77"}, {"file_name": "VStreamerLive-1.png", "id": "2069511276724040", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75375080_2069511280057373_6486071125126900409_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IejaS_Hc6f4Q7kNvwGdmZIU&_nc_oc=AdqKnNorK56I1gx11nZkKX3pCYmDxFPzLAi90LqA-pwb0q9z_xEbgARibyAuW5BR74g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9PsZEIISTQo_HmMW5PFVmrijtkNHOkAaIqUb-RAUv5w&oe=6A85A98F"}, {"file_name": "VStreamerLive-3.png", "id": "1079860553002176", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974535_1079860556335509_2823356149835878763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdv-5ntkkPQQ7kNvwHX026u&_nc_oc=AdqHUmTRyhZQhoIF6qv2Bc95ZMX7TMsbxidJ6FQd8nAXkyAYslTD6ZRAW-tyXOeHhi4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGScqQYyOjg0fUO-f5Lc5387hp8BKZWi2kSWF0gx1o0eg&oe=6A85A6D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image copy.png", "id": "879499283617031", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982522_879499290283697_6814823952576189196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Oycndh62gQ7kNvwEOtAwD&_nc_oc=AdqklySxHbn4H1VWza5oI2a40F2-mJJ1-BFfZnsOk-lVu9xtP3303dpaL8EmNO0U5oU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHtzCQe37IUSzVrJaCJTgaBClEfUYF6jGh_QYeu8BTtg&oe=6A8597C9"}, "display_name": "VStreamer Live", "keywords": [], "long_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll from your Meta Quest 2, 3, or Pro!  No complicated PC / Phone / Tracker setup needed.\n\nRecord Video from a third person to tell your story.  Includes settings to make editing your video simple and painless.\n\nStream to many platforms including:  YouTube, Twitch, Tik Tok, or anything with RTMP support.\n\nOptional casting to and from OBS Studio for extra functionality.\n\nSupports several Avatar formats including VRM, Ready Player Me, and Meta.\n\nOptional full body tracking with supported motion capture hardware including:  Mocopi, Persepction Neuron, OptiTrack", "short_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a full Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll on Meta Quest 2, 3, or Pro!  No complicated PC setup needed.\n\nIntuitive controls makes it easy to frame the perfect shot.  Works with several avatar formats including Meta, VRM, and ReadyPlayerMe.  Optional casting to and from OBS Studio for extra functionality.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zerotransform.com/privacy_policy-vstreamer_live/", "developer_terms_of_service_url": null, "publisher_name": "ZeroTransform", "support_website_url": "https://VStreamer.Live/support", "website_url": "https://VStreamer.Live/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
 {"file_name": "VStreamerLive-4.png", "id": "863817605097604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974705_863817608430937_1411759223208000570_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAZvcJ_6uH0Q7kNvwHs3xiL&_nc_oc=AdoxPi2c-0eTX3GcUx8IJerHYw88eCnN7xq8IMt-FkPmGnve14iOjQP6E1NEJEo9bw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4W1GnixWA_b1zI35W2pWtoUyYp5fEi15CzTpFVrdy6g&oe=6AD0EB37"}, {"file_name": "VStreamerLive-1.png", "id": "2069511276724040", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75375080_2069511280057373_6486071125126900409_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdP6mEOSNQ4Q7kNvwHcecB2&_nc_oc=AdrGZGD4Xd6ypLKWUqIhoJdgxC55_u8XZN3Y78NoV8VnGFlQJC5XHbwe6MQlOm-sdS8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrpXikLC0NXlskGO6vw2DKnsgp4URYCorFvvkmTZOYUA&oe=6AD1074F"}, {"file_name": "VStreamerLive-3.png", "id": "1079860553002176", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974535_1079860556335509_2823356149835878763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6Vhb56gwaIQ7kNvwG0FJ4K&_nc_oc=AdoyHUDxFC3zDV6o0idZg8M_Ny-wQRKDCF_MtWwi-4NAfBqGmePEGmSyFXkNt0l_FYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODhn-JUJkraRbYy5fyLJNhD1O1yzH0vPRfKCH2iBLQxg&oe=6AD10495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image copy.png", "id": "879499283617031", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982522_879499290283697_6814823952576189196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vjf7fcbBJUQ7kNvwH_OGdt&_nc_oc=AdolIQXtA4zjUZLwY6fqbftH0KPis-L565-hddCYvR_orhLzdSkoKJqVLU9fQY3rL_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9hjA_2YvRrSKldIvDI9XcWkwuJ_McIb37RIygu1hdPg&oe=6AD0F589"}, "display_name": "VStreamer Live", "keywords": [], "long_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll from your Meta Quest 2, 3, or Pro!  No complicated PC / Phone / Tracker setup needed.\n\nRecord Video from a third person to tell your story.  Includes settings to make editing your video simple and painless.\n\nStream to many platforms including:  YouTube, Twitch, Tik Tok, or anything with RTMP support.\n\nOptional casting to and from OBS Studio for extra functionality.\n\nSupports several Avatar formats including VRM, Ready Player Me, and Meta.\n\nOptional full body tracking with supported motion capture hardware including:  Mocopi, Persepction Neuron, OptiTrack", "short_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a full Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll on Meta Quest 2, 3, or Pro!  No complicated PC setup needed.\n\nIntuitive controls makes it easy to frame the perfect shot.  Works with several avatar formats including Meta, VRM, and ReadyPlayerMe.  Optional casting to and from OBS Studio for extra functionality.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zerotransform.com/privacy_policy-vstreamer_live/", "developer_terms_of_service_url": null, "publisher_name": "ZeroTransform", "support_website_url": "https://VStreamer.Live/support", "website_url": "https://VStreamer.Live/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
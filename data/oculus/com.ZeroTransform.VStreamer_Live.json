 {"file_name": "VStreamerLive-4.png", "id": "863817605097604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974705_863817608430937_1411759223208000570_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Br5LjdtWrgoQ7kNvwHLS6Fr&_nc_oc=AdoAPSSoAM4TJEGXK4SNFpdW4pljQk7NKQpf6mOKddayfvH4seK0EemNYukLQ2zJfbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCzJwP0PEM2VybbrGmW7U5-MYoROiEgSFvH7fy8GeoBg&oe=6A5E38B7"}, {"file_name": "VStreamerLive-1.png", "id": "2069511276724040", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375080_2069511280057373_6486071125126900409_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKUakBqWhHkQ7kNvwHfhxSk&_nc_oc=Adr_2WQTMAuCeLoufnaHQwCHuKS8iriwUmTJjy1z02EG8IFS0vgQlzHy08bQVXkZWvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRaZxcLH_tjPixis2Ees_ukDrR5bpmxY4pV7Iaqg2i3w&oe=6A5E1C8F"}, {"file_name": "VStreamerLive-3.png", "id": "1079860553002176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_1079860556335509_2823356149835878763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXSy5NzjAxEQ7kNvwExtD0H&_nc_oc=AdrgYEjn-aWQKgeXSnk4xRtL_7NuRIHc1pQaekw3aaWoHbwSnHIA8xY89aRBnTuA4d4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBliwzPxDa2VIqDLZthuK_BhEmfwj5f-ZuVHDz4LEftiw&oe=6A5E19D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image copy.png", "id": "879499283617031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_879499290283697_6814823952576189196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3ADllDYDiwQ7kNvwE_keQe&_nc_oc=AdpgU22ifeNbsJik-A5wDJK-_3zos39Kq8u46f8FHvCxd3E5bHE0eAbASMrOQVLkAZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZHofWwtsaaEa3gAh9PXe3l8wH9TX0W7JgebHURLEU2w&oe=6A5E0AC9"}, "display_name": "VStreamer Live", "keywords": [], "long_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll from your Meta Quest 2, 3, or Pro!  No complicated PC / Phone / Tracker setup needed.\n\nRecord Video from a third person to tell your story.  Includes settings to make editing your video simple and painless.\n\nStream to many platforms including:  YouTube, Twitch, Tik Tok, or anything with RTMP support.\n\nOptional casting to and from OBS Studio for extra functionality.\n\nSupports several Avatar formats including VRM, Ready Player Me, and Meta.\n\nOptional full body tracking with supported motion capture hardware including:  Mocopi, Persepction Neuron, OptiTrack", "short_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a full Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll on Meta Quest 2, 3, or Pro!  No complicated PC setup needed.\n\nIntuitive controls makes it easy to frame the perfect shot.  Works with several avatar formats including Meta, VRM, and ReadyPlayerMe.  Optional casting to and from OBS Studio for extra functionality.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zerotransform.com/privacy_policy-vstreamer_live/", "developer_terms_of_service_url": null, "publisher_name": "ZeroTransform", "support_website_url": "https://VStreamer.Live/support", "website_url": "https://VStreamer.Live/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
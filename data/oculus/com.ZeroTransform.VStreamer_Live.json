 {"file_name": "VStreamerLive-4.png", "id": "863817605097604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974705_863817608430937_1411759223208000570_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjN26jAAie0Q7kNvwHRYHvH&_nc_oc=Adrzat4zSmsXQv5cIl1skIdWAm4U08byWW9qbKpxbZPcAIHoUcWmfvR8zxoEAieE-s4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuRd1qxHNlTD7ywCApP9gXYh_IKey4ZYcXFfM1OIdm3g&oe=6A998C37"}, {"file_name": "VStreamerLive-1.png", "id": "2069511276724040", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375080_2069511280057373_6486071125126900409_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFlsFcfiiTsQ7kNvwGa7wTI&_nc_oc=AdrR_4A3Yg8YdtZH-OEt8cmDOAJ3RJ18cnOFj53PqTXJ6skL9WLnX3rjHKIskoD9GgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH_g-76c-habdtNZuKEURhi58jgi3kYg3RO4OM06Zqvg&oe=6A99700F"}, {"file_name": "VStreamerLive-3.png", "id": "1079860553002176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974535_1079860556335509_2823356149835878763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulE4eQKbaRAQ7kNvwFBR1Ig&_nc_oc=AdoTUxPjqDkNLW6NRX3AjBUBlel5RYPWBH31_xLGL4gctHTreoJJPnSkKoEdIq6hTd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGY6HgmJyax0wYqgxxEZRnW1Y7EmItNVmzLJT996lYDw&oe=6A996D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image copy.png", "id": "879499283617031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_879499290283697_6814823952576189196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6J7eY-WmN8Q7kNvwECxKyh&_nc_oc=Adp9egx8KvqO3fkQruXzXscb_vC2SeAVc_2xJLYPz_0VoJGYVqFwIC5Pe3sFDSFQbAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVk-NkdzAcLvWoBvL4bF1koSPWbbTzI8Xha2K5ERcz4w&oe=6A999689"}, "display_name": "VStreamer Live", "keywords": [], "long_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll from your Meta Quest 2, 3, or Pro!  No complicated PC / Phone / Tracker setup needed.\n\nRecord Video from a third person to tell your story.  Includes settings to make editing your video simple and painless.\n\nStream to many platforms including:  YouTube, Twitch, Tik Tok, or anything with RTMP support.\n\nOptional casting to and from OBS Studio for extra functionality.\n\nSupports several Avatar formats including VRM, Ready Player Me, and Meta.\n\nOptional full body tracking with supported motion capture hardware including:  Mocopi, Persepction Neuron, OptiTrack", "short_description": "Avatar Video Recording and Live Streaming\n\nTurn  your Meta Quest into a full Avatar Content Creation Studio.\nRecord video to share / edit later, or livestream to YouTube and Twitch directly from your Quest.  Great for VTubing!\n\nAll on Meta Quest 2, 3, or Pro!  No complicated PC setup needed.\n\nIntuitive controls makes it easy to frame the perfect shot.  Works with several avatar formats including Meta, VRM, and ReadyPlayerMe.  Optional casting to and from OBS Studio for extra functionality.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zerotransform.com/privacy_policy-vstreamer_live/", "developer_terms_of_service_url": null, "publisher_name": "ZeroTransform", "support_website_url": "https://VStreamer.Live/support", "website_url": "https://VStreamer.Live/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
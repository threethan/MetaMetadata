cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBd5DrDt5tsQ7kNvwHwJF-s&_nc_oc=Adq93rKs5qT6snBCQlyUOL8ZfUZ1yDJgjrNN1vva1LCzqykIvkKh9vCxKvdYX0B6Mog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpP6piT2tUzYbqLSxdSBhEbDOgZys4BSTfQ5wdke8edQ&oe=6AD252AC"}, {"file_name": "Multiplayer Screenshot.png", "id": "3281929171990017", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_3281929175323350_4158056192861857337_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdsLtjzMbykQ7kNvwG2yjf5&_nc_oc=AdpQleJ_1T4DCGlD8USWkE7wTcxQa8He9qXnGvLJjOU64DzklkNaD396P4uJtuCzd_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG1AULzIGL96X2gWw0u5IahQMqaaU6ZXpnoExccMWbEQ&oe=6AD25005"}, {"file_name": "Halloween-009.png", "id": "3798178827166369", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_3798178830499702_4567096657778033371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MGRit07UEEQ7kNvwHrVVgT&_nc_oc=AdqPR3e7-32PxCgFbEnFFEjxpKKbKhSw7F7Q5J7aAk76SQQc_IAia4s0frsZzDM-hqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbOZ3Swdv08fVWTuJGzmmv55xFZBZbHm3uQp9WGH49Gw&oe=6AD25997"}, {"file_name": "Halloween-014.png", "id": "853947436847758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031551_853947440181091_1528895089867897700_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXvCc3wLOewQ7kNvwHVtiJA&_nc_oc=Adr8oiizJePhKl6O8W8bbdOmR2FWFwbex_8pmNoBdRBpsHLLkqg12UDXY0Xk-eyGNpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzkf3pp70aGdr-rlAM763XfWIcG76HP_WoZ6yTki_f3A&oe=6AD22D32"}, {"file_name": "Halloween-016.png", "id": "1306616440322494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982463_1306616443655827_8510261910223606143_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L5Sd2iM3vgQ7kNvwHpEvNX&_nc_oc=AdqpJH0sr6dnbjU_kDj4iTEmBa_YEonacexyXFUMHcjW9fIjGB9vr7-1TsSLb3PJIBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6GQLD0QbVEi2iYtfAcoMXvJiSmDM54YWOLNwQo8otiQ&oe=6AD24AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Halloween MP Update thumb.png", "id": "4332491723655283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_4332491730321949_5457994863968719905_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvKHXxSu40QQ7kNvwF18fLF&_nc_oc=Adq3emk-sMMQRgNzAuPEu78O69STvoXdBw7dzFQpq2V6C4XLnsuUHKVNPnBbJFljt_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP9mkaxeCjUqFjqHF9xfCmjwWSV49x6I1Qx9uRyz3Leg&oe=6AD24DC7"}, "display_name": "Halloween Candy Reclaim", "keywords": ["Halloween", "Family", "Party", "Candy", "Multiplayer"], "long_description": "# Spooky fun for the whole family - any time of the year!\n\nGrab your pickle guns, climb on top of your candy-vacuuming, self-driving chariot, and clean the village of the candy-stealing mobs who have taken control! Take back insane amounts of candy, duck the suspect stuff they throw at you, and battle your way to the final boss!\n\n# Localization Update!\n\nNow in seven languages: English, German, French, Italian, Spanish, Chinese and Japanese! Menus, hints and in-game text are translated. Choose your language in Settings; each multiplayer player can use their own language.\n\n# Offline and Online Multiplayer!\n\nPlay with up to 4 players - online or offline! Shoot mobs and eat candy together... or take it all for yourself!\n\n# Grab your candy - but don't eat too much of it!\n\nBattle your way through seven levels in five difficulty settings. Collect candy for points and eat it for refilling your health, and build up a shield. But don't trigger a sugar overload - sugar is bad for you!\n\nYou will also be rated on accuracy as well as how much candy you manage to eat during each level.\n\nCreate local profiles for everyone for a friendly competition! Who scores the most?\n\n# How to play\n\nPlay seated or standing - you'll use your controllers to shoot as well as eat the candy. \n\nThe game auto-adjusts to any height of the player.\n\nFive difficulty levels ranging from Piece of Cake (no damage!) to Frustrating (lots of damage!) mean everyone can play, **and finish**, this game. ", "short_description": "Your holidays are threatened: Some naughty mobs stole the candy! Grab your dual-wield pickle guns and reclaim it! Eat it! Win!"}, {"images": {"nodes": []}, "id": "1112750987875985", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["\u4e07\u5723\u8282", "\u5bb6\u5ead", "\u6d3e\u5bf9", "\u7cd6\u679c", "\u591a\u4eba\u6e38\u620f"], "long_description": "# \u5168\u5bb6\u4e00\u8d77\u4eab\u53d7\u4e07\u5723\u8282\u8da3\u5473\uff0c\u4e00\u5e74\u56db\u5b63\u90fd\u80fd\u73a9\uff01\n\n\u62ff\u8d77\u9178\u9ec4\u74dc\u67aa\uff0c\u767b\u4e0a\u914d\u6709\u7cd6\u679c\u5438\u5c18\u5668\u7684\u81ea\u52a8\u9a7e\u9a76\u5c0f\u8f66\uff0c\u628a\u5360\u9886\u6751\u5e84\u3001\u5077\u8d70\u7cd6\u679c\u7684\u602a\u7269\u4eec\u8d76\u51fa\u53bb\uff01\u593a\u56de\u591a\u5f97\u60ca\u4eba\u7684\u7cd6\u679c\uff0c\u4f4e\u5934\u8eb2\u5f00\u5b83\u4eec\u6254\u6765\u7684\u53ef\u7591\u4e1c\u897f\uff0c\u4e00\u8def\u6218\u6597\u5230\u6700\u7ec8\u5934\u76ee\u9762\u524d\uff01\n\n# \u8bed\u8a00\u66f4\u65b0\uff01\n\n\u73b0\u5df2\u652f\u6301\u4e03\u79cd\u8bed\u8a00\uff1a\u82f1\u8bed\u3001\u5fb7\u8bed\u3001\u6cd5\u8bed\u3001\u610f\u5927\u5229\u8bed\u3001\u897f\u73ed\u7259\u8bed\u3001\u4e2d\u6587\u548c\u65e5\u8bed\uff01\u83dc\u5355\u3001\u63d0\u793a\u548c\u6e38\u620f\u5185\u6587\u672c\u5747\u5df2\u7ffb\u8bd1\u3002\u5728\u8bbe\u7f6e\u4e2d\u9009\u62e9\u4f60\u7684\u8bed\u8a00\uff1b\u591a\u4eba\u6e38\u620f\u4e2d\uff0c\u6bcf\u4f4d\u73a9\u5bb6\u90fd\u53ef\u4ee5\u4f7f\u7528\u5404\u81ea\u7684\u8bed\u8a00\u3002\n\n# \u79bb\u7ebf\u548c\u5728\u7ebf\u591a\u4eba\u6e38\u620f\uff01\n\n\u6700\u591a\u652f\u6301 4 \u540d\u73a9\u5bb6\uff0c\u5728\u7ebf\u6216\u79bb\u7ebf\u90fd\u80fd\u4e00\u8d77\u73a9\uff01\u4e00\u8d77\u6253\u602a\u3001\u4e00\u8d77\u5403\u7cd6\u679c\u2026\u2026\u6216\u8005\u628a\u7cd6\u679c\u5168\u90fd\u7559\u7ed9\u81ea\u5df1\uff01\n\n# \u593a\u56de\u7cd6\u679c\uff0c\u4f46\u53ef\u522b\u5403\u592a\u591a\uff01\n\n\u6311\u6218\u4e03\u4e2a\u5173\u5361\uff0c\u4ece\u4e94\u79cd\u96be\u5ea6\u4e2d\u81ea\u7531\u9009\u62e9\u3002\u6536\u96c6\u7cd6\u679c\u83b7\u5f97\u5206\u6570\uff0c\u5403\u6389\u7cd6\u679c\u6062\u590d\u751f\u547d\u503c\uff0c\u8fd8\u80fd\u79ef\u6512\u62a4\u76fe\u3002\u4f46\u5343\u4e07\u522b\u89e6\u53d1\u7cd6\u5206\u7206\u53d1\u2014\u2014\u5403\u592a\u591a\u7cd6\u53ef\u4e0d\u597d\uff01\n\n\u6bcf\u4e2a\u5173\u5361\u8fd8\u4f1a\u6839\u636e\u4f60\u7684\u5c04\u51fb\u51c6\u786e\u5ea6\u548c\u5403\u6389\u7684\u7cd6\u679c\u6570\u91cf\u8fdb\u884c\u8bc4\u4ef7\u3002\n\n\u4e3a\u6bcf\u4e2a\u4eba\u521b\u5efa\u672c\u5730\u6863\u6848\uff0c\u6765\u4e00\u573a\u53cb\u597d\u7684\u8f83\u91cf\uff01\u8c01\u80fd\u62ff\u5230\u6700\u9ad8\u5206\uff1f\n\n# \u73a9\u6cd5\u8bf4\u660e\n\n\u5750\u7740\u6216\u7ad9\u7740\u90fd\u80fd\u73a9\uff0c\u7528\u63a7\u5236\u5668\u5c04\u51fb\uff0c\u4e5f\u7528\u5b83\u4eec\u5403\u7cd6\u679c\u3002\n\n\u6e38\u620f\u4f1a\u81ea\u52a8\u9002\u5e94\u6bcf\u4f4d\u73a9\u5bb6\u7684\u8eab\u9ad8\u3002\n\n\u4e94\u79cd\u96be\u5ea6\u4ece\u201c\u5c0f\u83dc\u4e00\u789f\u201d\uff08\u4e0d\u4f1a\u53d7\u5230\u4f24\u5bb3\uff01\uff09\u5230\u201c\u6293\u72c2\u201d\uff08\u4f24\u5bb3\u8d85\u9ad8\uff01\uff09\uff0c\u8ba9\u6bcf\u4e2a\u4eba\u90fd\u80fd\u4e0a\u624b\uff0c**\u4e5f\u80fd\u901a\u5173**\u3002", "short_description": "\u4e07\u5723\u8282\u5371\u5728\u65e6\u5915\uff1a\u8c03\u76ae\u7684\u602a\u7269\u5077\u8d70\u4e86\u7cd6\u679c\uff01\u53cc\u624b\u5404\u62ff\u4e00\u628a\u9178\u9ec4\u74dc\u67aa\uff0c\u628a\u7cd6\u679c\u593a\u56de\u6765\uff01\u5403\u6389\u7cd6\u679c\uff0c\u8d62\u5f97\u80dc\u5229\uff01"}, {"images": {"nodes": []}, "id": "965587469311671", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["Halloween", "Familia", "Fiesta", "Dulces", "Multijugador"], "long_description": "# \u00a1Diversi\u00f3n de miedo en familia, todo el a\u00f1o!\n\n\u00a1Coge tus pistolas de pepinillos, s\u00fabete al carro aut\u00f3nomo con aspiradora de dulces y libera el pueblo de los monstruos ladrones de golosinas! Recupera montones de dulces, ag\u00e1chate para esquivar sus proyectiles sospechosos y lucha hasta el jefe final.\n\n# \u00a1Actualizaci\u00f3n de idiomas!\n\n\u00a1Siete idiomas: ingl\u00e9s, alem\u00e1n, franc\u00e9s, italiano, espa\u00f1ol, chino y japon\u00e9s! Los men\u00fas, las pistas y los textos del juego est\u00e1n traducidos. Elige tu idioma en los ajustes. En multijugador, cada jugador puede usar su propio idioma.\n\n# \u00a1Multijugador offline y online!\n\n\u00a1Jugad hasta 4, online u offline! Disparad a los monstruos y comed dulces juntos\u2026 \u00a1o qu\u00e9datelos todos para ti!\n\n# \u00a1Recupera tus dulces, pero no comas demasiados!\n\nSupera siete niveles con cinco dificultades. Recoge dulces para ganar puntos y c\u00f3metelos para recuperar salud y crear un escudo. Pero evita la sobrecarga de az\u00facar: \u00a1demasiado az\u00facar es malo para ti!\n\nTambi\u00e9n cuentan tu punter\u00eda y los dulces que consigas comer en cada nivel.\n\n\u00a1Crea perfiles locales para todos y organiza una competici\u00f3n amistosa! \u00bfQui\u00e9n har\u00e1 m\u00e1s puntos?\n\n# C\u00f3mo jugar\n\nJuega sentado o de pie: usa los mandos para disparar y comer dulces.\n\nEl juego se ajusta autom\u00e1ticamente a tu altura.\n\nCinco dificultades, desde \u00abPan comido\u00bb (\u00a1sin da\u00f1o!) hasta \u00abDesesperante\u00bb (\u00a1much\u00edsimo da\u00f1o!), permiten que todos puedan jugar **y terminar** el juego.", "short_description": "Halloween est\u00e1 en peligro: \u00a1unos monstruos traviesos han robado los dulces! Coge una pistola de pepinillos en cada mano y recup\u00e9ralos. \u00a1C\u00f3metelos! \u00a1Gana!"}]}, "developer_name": "Sourcenity", "developer_privacy_policy_url": "https://www.halloweencandyreclaim.com/gameprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sourcenity", "support_website_url": null, "website_url": "https://www.halloweencandyreclaim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "ja", "es", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "29253259777613371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031359_1038584798062932_2752244904417226964_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypCl3UQtd6YQ7kNvwGYalJs&_nc_oc=Adrrg6NhRboYqZa3RjTStzWopu9NKgy6fz1TKHUVwdkbdKhXdJysYtInLNvIYx_qBnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd0QYs0JMNXWV-hoIFKJoK7SJCt7ZJ7rH7ab2v6AumeQ&oe=6AD23D4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Halloween Candy Reclaim", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game
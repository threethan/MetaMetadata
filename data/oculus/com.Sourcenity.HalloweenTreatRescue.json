{"data": {"node": {"__typename": "Application", "id": "8547196931979625", "organization": {"id": "355354068131434", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8547196931979625"}]}, "id": "3633863390277737"}]}}, "firstRevision": {"nodes": [{"application": {"id": "8547196931979625", "release_date": 1729753200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 13}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29244675331805149"}, "id": "1046275867027347"}]}}, "binary": null, "live_binary": null, "created_date": 1791439098, "id": "29253254474280568", "is_initial_release": false, "name_with_fallback": "v12", "pdp_metadata_with_fallback": {"version": 12, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29253259777613371"}, "release_status": "RELEASED", "id": "8547196931979625"}, "id": "29253259777613371", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8547196931979625", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1072970397368869"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2202127670354122", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["\u30cf\u30ed\u30a6\u30a3\u30f3", "\u30d5\u30a1\u30df\u30ea\u30fc", "\u30d1\u30fc\u30c6\u30a3\u30fc", "\u304a\u83d3\u5b50", "\u30de\u30eb\u30c1\u30d7\u30ec\u30a4"], "long_description": "# \u5bb6\u65cf\u307f\u3093\u306a\u3067\u3001\u3061\u3087\u3063\u3074\u308a\u4e0d\u6c17\u5473\u306a\u697d\u3057\u3055\u3092\u3002\u4e00\u5e74\u4e2d\u3044\u3064\u3067\u3082\uff01\n\n\u30d4\u30af\u30eb\u30b9\u30ac\u30f3\u3092\u624b\u306b\u3001\u304a\u83d3\u5b50\u3092\u5438\u3044\u8fbc\u3080\u6383\u9664\u6a5f\u4ed8\u304d\u306e\u81ea\u52d5\u904b\u8ee2\u30ab\u30fc\u30c8\u306b\u4e57\u308a\u8fbc\u3082\u3046\u3002\u6751\u3092\u4e57\u3063\u53d6\u308a\u3001\u304a\u83d3\u5b50\u3092\u76d7\u3093\u3060\u30e2\u30f3\u30b9\u30bf\u30fc\u305f\u3061\u3092\u8ffd\u3044\u6255\u3046\u3093\u3060\uff01\u5c71\u307b\u3069\u306e\u304a\u83d3\u5b50\u3092\u53d6\u308a\u8fd4\u3057\u3001\u6295\u3052\u3066\u304f\u308b\u602a\u3057\u3044\u3082\u306e\u3092\u3057\u3083\u304c\u3093\u3067\u907f\u3051\u306a\u304c\u3089\u3001\u30e9\u30b9\u30dc\u30b9\u307e\u3067\u6483\u3061\u9032\u3082\u3046\uff01\n\n# \u8a00\u8a9e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\uff01\n\n\u82f1\u8a9e\u3001\u30c9\u30a4\u30c4\u8a9e\u3001\u30d5\u30e9\u30f3\u30b9\u8a9e\u3001\u30a4\u30bf\u30ea\u30a2\u8a9e\u3001\u30b9\u30da\u30a4\u30f3\u8a9e\u3001\u4e2d\u56fd\u8a9e\u3001\u65e5\u672c\u8a9e\u306e7\u8a00\u8a9e\u306b\u5bfe\u5fdc\uff01\u30e1\u30cb\u30e5\u30fc\u3001\u30d2\u30f3\u30c8\u3001\u30b2\u30fc\u30e0\u5185\u30c6\u30ad\u30b9\u30c8\u3092\u7ffb\u8a33\u3057\u307e\u3057\u305f\u3002\u300c\u8a2d\u5b9a\u300d\u3067\u8a00\u8a9e\u3092\u9078\u3079\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u3067\u3082\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3054\u3068\u306b\u597d\u304d\u306a\u8a00\u8a9e\u3092\u4f7f\u3048\u307e\u3059\u3002\n\n# \u30aa\u30d5\u30e9\u30a4\u30f3\u3067\u3082\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3082\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\uff01\n\n\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3082\u30aa\u30d5\u30e9\u30a4\u30f3\u3067\u3082\u3001\u6700\u59274\u4eba\u3067\u904a\u3079\u308b\uff01\u4e00\u7dd2\u306b\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u6483\u3063\u3066\u304a\u83d3\u5b50\u3092\u98df\u3079\u3088\u3046\u2026\u2026\u305d\u308c\u3068\u3082\u3001\u5168\u90e8\u3072\u3068\u308a\u3058\u3081\u3057\u3061\u3083\u3046\uff1f\n\n# \u304a\u83d3\u5b50\u3092\u53d6\u308a\u8fd4\u305d\u3046\u3002\u3067\u3082\u3001\u98df\u3079\u3059\u304e\u306b\u306f\u6ce8\u610f\uff01\n\n5\u3064\u306e\u96e3\u6613\u5ea6\u304b\u3089\u9078\u3093\u3067\u30017\u3064\u306e\u30b9\u30c6\u30fc\u30b8\u306b\u6311\u3082\u3046\u3002\u304a\u83d3\u5b50\u3092\u96c6\u3081\u3066\u30b9\u30b3\u30a2\u3092\u7a3c\u304e\u3001\u98df\u3079\u3066\u4f53\u529b\u3092\u56de\u5fa9\u3057\u3001\u30b7\u30fc\u30eb\u30c9\u3082\u84c4\u3048\u3088\u3046\u3002\u3067\u3082\u3001\u30b7\u30e5\u30ac\u30fc\u30aa\u30fc\u30d0\u30fc\u30ed\u30fc\u30c9\u3092\u8d77\u3053\u3055\u306a\u3044\u3088\u3046\u306b\u3002\u7802\u7cd6\u306e\u3068\u308a\u3059\u304e\u306b\u306f\u6c17\u3092\u3064\u3051\u3066\uff01\n\n\u5404\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u547d\u4e2d\u7387\u3068\u98df\u3079\u305f\u304a\u83d3\u5b50\u306e\u91cf\u3082\u8a55\u4fa1\u3055\u308c\u307e\u3059\u3002\n\n\u307f\u3093\u306a\u306e\u30ed\u30fc\u30ab\u30eb\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3092\u4f5c\u3063\u3066\u3001\u4ef2\u826f\u304f\u30b9\u30b3\u30a2\u3092\u7af6\u304a\u3046\uff01\u4e00\u756a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u51fa\u3059\u306e\u306f\u8ab0\u304b\u306a\uff1f\n\n# \u904a\u3073\u65b9\n\n\u5ea7\u3063\u3066\u3082\u7acb\u3063\u3066\u3082\u904a\u3079\u307e\u3059\u3002\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u4f7f\u3063\u3066\u3001\u6483\u3063\u305f\u308a\u3001\u304a\u83d3\u5b50\u3092\u98df\u3079\u305f\u308a\u3057\u3088\u3046\u3002\n\n\u30b2\u30fc\u30e0\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8eab\u9577\u306b\u5408\u308f\u305b\u3066\u81ea\u52d5\u8abf\u6574\u3055\u308c\u307e\u3059\u3002\n\n\u96e3\u6613\u5ea6\u306f\u300c\u671d\u98ef\u524d\u300d\uff08\u30c0\u30e1\u30fc\u30b8\u306a\u3057\uff01\uff09\u304b\u3089\u300c\u6ce3\u304d\u305d\u3046\u300d\uff08\u5927\u30c0\u30e1\u30fc\u30b8\uff01\uff09\u307e\u3067\u306e5\u6bb5\u968e\u3002\u8ab0\u3067\u3082\u904a\u3079\u3066\u3001**\u30af\u30ea\u30a2\u3060\u3063\u3066\u3067\u304d\u308b**\u30b2\u30fc\u30e0\u3067\u3059\u3002", "short_description": "\u30cf\u30ed\u30a6\u30a3\u30f3\u304c\u5927\u30d4\u30f3\u30c1\uff01\u3044\u305f\u305a\u3089\u597d\u304d\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u305f\u3061\u304c\u304a\u83d3\u5b50\u3092\u76d7\u3093\u3058\u3083\u3063\u305f\uff01\u4e21\u624b\u306b\u30d4\u30af\u30eb\u30b9\u30ac\u30f3\u3092\u6301\u3063\u3066\u53d6\u308a\u8fd4\u305d\u3046\uff01\u98df\u3079\u3088\u3046\uff01\u52dd\u5229\u3092\u3064\u304b\u3082\u3046\uff01"}, {"images": {"nodes": []}, "id": "1721216372296685", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["Halloween", "Familie", "Party", "S\u00fc\u00dfigkeiten", "Mehrspieler"], "long_description": "# Gruselspa\u00df f\u00fcr die ganze Familie \u2013 das ganze Jahr!\n\nSchnapp dir deine Gurkenkanonen, steig auf den selbstfahrenden Wagen mit S\u00fc\u00dfigkeiten-Staubsauger und befreie das Dorf von den S\u00fc\u00dfigkeiten-Dieben! Hol dir die Beute zur\u00fcck, duck dich unter ihren seltsamen Wurfgeschossen weg und k\u00e4mpfe bis zum Endgegner!\n\n# Sprachen-Update!\n\nJetzt in sieben Sprachen: Englisch, Deutsch, Franz\u00f6sisch, Italienisch, Spanisch, Chinesisch und Japanisch! Men\u00fcs, Hinweise und Spieltexte sind \u00fcbersetzt. W\u00e4hle deine Sprache in den Einstellungen. Im Mehrspielermodus w\u00e4hlt jeder seine Sprache.\n\n# Offline- und Online-Mehrspieler!\n\nSpielt mit bis zu 4 Spielern \u2013 online oder offline! Schie\u00dft auf Monster und esst S\u00fc\u00dfigkeiten zusammen ... oder behalte alles f\u00fcr dich!\n\n# Hol dir S\u00fc\u00dfigkeiten \u2013 aber iss nicht zu viele!\n\nMeistere sieben Level mit f\u00fcnf Schwierigkeitsgraden. Sammle S\u00fc\u00dfigkeiten f\u00fcr Punkte und iss sie f\u00fcr Heilung und Schild. Aber vermeide den Zuckerschock \u2013 zu viel Zucker tut dir nicht gut!\n\nAuch Treffgenauigkeit und gegessene S\u00fc\u00dfigkeiten pro Level z\u00e4hlen.\n\nErstellt lokale Profile und startet einen freundschaftlichen Wettstreit! Wer punktet am meisten?\n\n# So wird gespielt\n\nSpiele im Sitzen oder Stehen. Mit den Controllern schie\u00dft du und isst S\u00fc\u00dfigkeiten.\n\nDas Spiel passt sich automatisch an deine K\u00f6rpergr\u00f6\u00dfe an.\n\nF\u00fcnf Schwierigkeitsgrade von \u201eKinderspiel\u201c (kein Schaden!) bis \u201eZum Verzweifeln\u201c (viel Schaden!) lassen alle mitspielen **und das Spiel abschlie\u00dfen**.", "short_description": "Halloween ist in Gefahr: Freche Monster haben die S\u00fc\u00dfigkeiten geklaut! Schnapp dir deine beiden Gurkenkanonen und hol sie zur\u00fcck! Iss sie! Gewinne!"}, {"images": {"nodes": []}, "id": "1645953993633139", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["Halloween", "Famiglia", "Festa", "Dolci", "Multigiocatore"], "long_description": "# Brividi in famiglia, tutto l\u2019anno!\n\nAfferra le pistole spara-cetriolini, sali sul carretto a guida autonoma con aspiratore per dolci e libera il villaggio dai mostri ladri di leccornie! Recupera montagne di dolci, abbassati per schivare gli strani oggetti che ti lanciano e fatti strada fino al boss finale!\n\n# Aggiornamento delle lingue!\n\nOra in sette lingue: inglese, tedesco, francese, italiano, spagnolo, cinese e giapponese! Menu, suggerimenti e testi di gioco sono tradotti. Scegli la lingua nelle impostazioni. In multigiocatore, ognuno pu\u00f2 usare la propria lingua.\n\n# Multigiocatore offline e online!\n\nGiocate fino a 4, online o offline! Sparate ai mostri e mangiate dolci insieme\u2026 oppure tienili tutti per te!\n\n# Recupera i dolci, ma non mangiarne troppi!\n\nAffronta sette livelli con cinque difficolt\u00e0. Raccogli dolci per ottenere punti e mangiali per recuperare salute e creare uno scudo. Ma evita il sovraccarico di zuccheri: troppo zucchero fa male!\n\nContano anche la precisione e i dolci che riesci a mangiare in ogni livello.\n\nCrea profili locali per tutti e lanciate una sfida amichevole! Chi far\u00e0 pi\u00f9 punti?\n\n# Come si gioca\n\nGioca da seduto o in piedi: usa i controller per sparare e mangiare dolci.\n\nIl gioco si adatta automaticamente alla tua altezza.\n\nCinque difficolt\u00e0, da \u00abUna passeggiata\u00bb (nessun danno!) a \u00abFrustrante\u00bb (tantissimi danni!), permettono a tutti di giocare **e finire** il gioco.", "short_description": "Halloween \u00e8 in pericolo: dei mostri dispettosi hanno rubato i dolci! Impugna una pistola spara-cetriolini per mano e recuperali! Mangiali! Vinci!"}, {"images": {"nodes": []}, "id": "1157915613473946", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Halloween Candy Reclaim", "keywords": ["Halloween", "Famille", "F\u00eate", "Bonbons", "Multijoueur"], "long_description": "# Des frissons en famille, toute l\u2019ann\u00e9e !\n\nPrends tes pistolets \u00e0 cornichons, monte sur ton chariot autonome \u00e0 aspirateur \u00e0 bonbons et lib\u00e8re le village des monstres voleurs de friandises ! R\u00e9cup\u00e8re des tonnes de bonbons, baisse-toi pour \u00e9viter leurs projectiles louches et combats jusqu\u2019au boss final !\n\n# Mise \u00e0 jour des langues !\n\nSept langues : anglais, allemand, fran\u00e7ais, italien, espagnol, chinois et japonais ! Menus, astuces et textes du jeu sont traduits. Choisis ta langue dans les param\u00e8tres. En multijoueur, chacun peut utiliser sa propre langue.\n\n# Multijoueur hors ligne et en ligne !\n\nJouez jusqu\u2019\u00e0 4, en ligne ou hors ligne ! Tirez sur les monstres et mangez les bonbons ensemble\u2026 ou garde tout pour toi !\n\n# R\u00e9cup\u00e8re tes bonbons, sans trop en manger !\n\nTraverse sept niveaux avec cinq difficult\u00e9s. Ramasse des bonbons pour les points et mange-les pour r\u00e9cup\u00e9rer de la sant\u00e9 et cr\u00e9er un bouclier. Mais \u00e9vite la surcharge de sucre : trop de sucre, c\u2019est mauvais pour toi !\n\nTa pr\u00e9cision et les bonbons mang\u00e9s \u00e0 chaque niveau comptent aussi dans ton \u00e9valuation.\n\nCr\u00e9e des profils locaux pour une comp\u00e9tition amicale ! Qui fera le meilleur score ?\n\n# Comment jouer\n\nJoue assis ou debout : les manettes servent \u00e0 tirer et \u00e0 manger les bonbons.\n\nLe jeu s\u2019adapte automatiquement \u00e0 ta taille.\n\nCinq difficult\u00e9s, de \u00ab Du g\u00e2teau \u00bb (aucun d\u00e9g\u00e2t !) \u00e0 \u00ab Frustrant \u00bb (beaucoup de d\u00e9g\u00e2ts !), permettent \u00e0 tous de jouer **et de terminer** le jeu.", "short_description": "Halloween est en danger : de vilains monstres ont vol\u00e9 les bonbons ! Prends un pistolet \u00e0 cornichons dans chaque main et r\u00e9cup\u00e8re-les ! Mange-les ! Gagne !"}, {"images": {"nodes": [{"file_name": "Title Art - Hero - 3000x900.png", "id": "8470274706395262", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974517_8470274709728595_7885143535196265737_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDCFtjJDU14Q7kNvwEuHAXt&_nc_oc=AdqTLtUw_Y6RfzOeB85tbqVj9G0HWAJMMJyVSwhgUkMpXd64VOWk9DK-KZSlevFw3r8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm7JtSz874RblkC8OJEOwu4SmrDIJi57bt6Miak6sA0A&oe=6AD2469B"}, {"file_name": "Covert Art - Portrait - 1008x1440.png", "id": "1216881669582351", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031606_1216881672915684_5626996902228908137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb4Iz3HEWJYQ7kNvwFFWf7S&_nc_oc=AdqEUhnLjn3sRLLvdQ4WtPBKt_Ofr2oBU9BTY0BFDR4SQzhpv6haZDrXgOeFI4QUIBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLWzuS0nQInGEW3-mfQSOewu1vT75PEAwB9VbJRv4uVQ&oe=6AD25745"}, {"file_name": "Cover Art - Square - 1440x1440.png", "id": "1038584794729599", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031359_1038584798062932_2752244904417
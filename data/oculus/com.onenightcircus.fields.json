QUcPMz0x35BljyKS6o76s5HKZsza4HFfuxBckVMt5GL0Owyuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4j5Sie-5kAu0Sh7r6Su5mNEP9bSjtIzyZketpPiPmEQ&oe=6AA2B181"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM5HkneOXacQ7kNvwEOeHPv&_nc_oc=Adqg3nRLz__hpF887F3sVBHlHtsgnqw7HMl6e-L2Qdenc6LdGwAbhKwKHvLGpxtpOt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoixVZxp97a_zjMNZlgxoQU85-r-iDpEr7bJuZuy8Gxg&oe=6AA2D59D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHRth66k02EQ7kNvwGpuU8K&_nc_oc=Adrj01NREig-iMiyZGkjQg2YKW55OBZmz9k4Yqnyi5rBkBaz3Qh37-IbOs8Vqm6AtFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlU-q89Npl92JqWr8VQbL5FInBbJfOMNc5I42fQD2Snw&oe=6AA29F3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OINszAzaDsQ7kNvwG4irl7&_nc_oc=Adp5bCyxVuixgqvwjnqGp5flYsCfRZk5a3vRfPR5TXiNpgI8Bf9-9EyxxOehMGRzhF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhoqDvwnhVp2okkwq1TRiZWs068K9PRAWYdf7sImuM-A&oe=6AA2CBEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUDETMro9sQ7kNvwEulkCJ&_nc_oc=AdrGE1Vc9WJgKpo0eHyBRFQ3P0epyfMW5pqpWhpuzLbG-qK6kTw8Qc8oCK5QJXPziu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnZlxglk181P-wzl3kW5piXoOQbBK-7JxSr6LBjR7MqQ&oe=6AA2C4DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb40G0yoc2cQ7kNvwF6OUa3&_nc_oc=AdrW1H_tRmo2DddrX9WyWLwoAKKtRGX00QVSyiPnQ1Y1nI3dk3g4-nBJqA09iQyNZco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMZD3x6f_37QDe5beN4BgVt5k7FpQhTeN6adE35TJ3Ug&oe=6AA2CE7A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws4u-1Xad
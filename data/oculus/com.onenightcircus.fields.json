yCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdqbX8_PrN9drV9FKibu9iO7ZInqrgbUjFpcHnktDHjg&oe=6AFF207F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhfOHGvTjzUQ7kNvwGl-7bW&_nc_oc=AdoqjcVe9-r2eSwYWKn2ukMH_T0QkkdZT70m96CrzHIKL0QnyhOnSwGZ5OuWsZG6HpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8RsiDXm9Os-UbGwqC44jKxLSToaijI-TWjNxUgE3lag&oe=6AFF14EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_
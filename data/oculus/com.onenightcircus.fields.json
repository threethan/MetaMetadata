BGPA8ww8tGVtKVEf_pq4Bst-X8cphzw4n2LWDfDJVDEyryLx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC-3tn8dUOB3z608KK2-khtzU6kwAJSPa0DEXpcgubEg&oe=6AD0D601"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRpj-8DbT4cQ7kNvwEkjs60&_nc_oc=AdqYKc1f0tL5QixQ_H6c0EMVkDwahLcyLXcL2zKP4yeLEenRjH_WL1K7n4zP6BmSgqI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJZYClo8KS0PpUjuyy-uvit5NFaAudL8gqkOW1qbCMKw&oe=6AD0FA1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMQXd31RpkQ7kNvwHLMA2r&_nc_oc=AdrJI0BjlgOQ8wx289uzrY7_sei7zxGQ9HfhW1vvI1-_2esCcxquyMyp4qHxeNL_w14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw7I4SEQjmp_hKeLiUkoN6n53ZiG6xnbCC5ZmB1kTGKA&oe=6AD0FBFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn905xW0QE8Q7kNvwEbOv-2&_nc_oc=AdoXo4ZoHWn-V-KR10rRjXIX3l8Q4yNCC4QkLcs6KOxYFYg7sLp7d8kXlBNxnxCQMHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEKHP5FTF0-hsXqoH8EbFhw6CraYARoFZrHCHXs4Temg&oe=6AD0F06E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdPgUYItSoMQ7kNvwFgSxX9&_nc_oc=AdpvV6FOeffGI5MI8knfKxWXwY_szPLtnCaBBiyM_RYkDv_-K0FOxpMPvqVeT4enhjI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpf-LoSFsng3zsm9io0dvZWPElLxoWXHuyiWzzXmI98g&oe=6AD0E95F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cns_UXxUbKIQ7kNvwFnFY3S&_nc_oc=AdoH-3JumKyhvNqUu6mk5U83eVK10jmlfY6yHSAXgG3MTak78z62HuecocWpEQs1l2Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxpJRRqixFWd3a6GCE-Fz5lAhA20H4AwULZ24nV9dJ5Q&oe=6AD0F2FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiJIoVWg-
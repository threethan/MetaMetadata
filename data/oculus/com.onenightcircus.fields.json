uXYoTa6NzAhmz5tVuj6AY9Jy3GeHvzI68xs945dczZnlB3mYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqkxLo7G4sld2n3nW-Kcjm2-ahIgQbzC62r4YlIkyaIg&oe=6AF749C1"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KADxt48z558Q7kNvwEFVQ_G&_nc_oc=AdqQAO9ErO_Mcp5Cy-7Z5-10TrMLyDWc07cITmyhLB0l0cTSTTAXvWfZsXu1dUJF6aQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMp_rVSOLv57KVp-QJ_bcfGgP8IvkSDvTZtCZxe5IeDg&oe=6AF7359D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFXvrQeevP4Q7kNvwG7ydGm&_nc_oc=AdqLAhXozZORLtM_IeTEmbSvNf9leBZtkVbVXlaVT7tO_EedkCwOMPdQDs9xh1qzNtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTckn_7-WW2Q22SOVxyZGL8i6knKy0Xhmt3SF10WHgrGg&oe=6AF7377F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iPNQPDjlp0Q7kNvwEFQbg3&_nc_oc=AdpLynVcibQD1L7ccn998ueCuCzLPjSgW7S2hGQJZRlvzcsMyK5Ul2yo7QFciXL94qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR30NepcZb10Ogv4c7tF0LPGPqtf0kz9hnz6oGVI79aPw&oe=6AF72BEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qY48QFC26YQ7kNvwHrtVed&_nc_oc=AdrY-68282_be3f0fFtfQRQVtfSAQw16-tS7RjTZeA8M-cYsp3GSgowfVrf2pWUQEs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa0y7x8zgYKZYxAHUs2gvvIN-FrwqyKEiPQBAe93niIQ&oe=6AF724DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GxTB7Z7r2oQ7kNvwEhZQhX&_nc_oc=AdpwK7OQ2llOH3BI4owWIb4RUllmG-PF6KhOCbwF5pV0NYLy7GRI60gR7wzIoewcf5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSggwlFkHN9xCqUF6YOy4Ij3Z5wly3OXfYyyNyzK52_6A&oe=6AF72E7A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzmV1NRlq
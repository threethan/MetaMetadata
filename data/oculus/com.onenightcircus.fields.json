9", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_3anxqz5vQQ7kNvwGdWVuE&_nc_oc=Adop3fa8GMw0oJNJwDoQ340s-FGuymX0dyC9oci5zoIKdggbTYLfBclagUECQglTSAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJrLrQWCdian0a60TLgqMYJdUJLl6Mljh2qR4AvHQoew&oe=6AF3559B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOvWzG-rrhsQ7kNvwEpGSLE&_nc_oc=Adr0AIR2ndXGChFhbWN-oYagBu7o4QxL3hkiS_GM63QTc1l0MpIFvMEsNBJjaequAq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM5pfFlBn7VLpHWdv_KpH1P23Mq8SjKjmwt677Etq0lg&oe=6AF35541"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8C2Ab1psYAQ7kNvwH10oE4&_nc_oc=AdrQzBH-Ctv6_xoLnlPeU_NLKupgF2E8DTmvina066X4LMXAK1YrxRNC8IqsTEmxKl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScCvTDIZbE5LiiOAppwoKse7gsdpC2DuMBVqSbVXKpnA&oe=6AF3411D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEoNyiFO_DsQ7kNvwH-ZBSz&_nc_oc=AdqofGhMkqZm-V19HgL5ETon1j7z0_v-Q2cHSUWAA255BP37iDP2DW8fehNcuGh6FUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZThJSmIE1cYGk9824E9TgW01XC64zyJCO6vfe8cX74g&oe=6AF342FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxprMtQJAC4Q7kNvwFy77sT&_nc_oc=Adq8rvxkwK_EC0l6JrY7_FxNH3xmmwKzBBTJe1MwAz4_0o55rDZwXdhAfjKTKu8D05Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbldliGKmBPRiLqbNaCsEWopJXDInRugDpQ0QoiM4Uyg&oe=6AF3376E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNCQw7AADSgQ7kNvwGzAKJS&_nc_oc=AdqH7i1FT9SfSxJNPZ_JTvC5QLVv59H0J9E0ZkbcNt4XLmbjgv8VIYi6B5Ge2dujznI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7hnqvfL6ixqDvZog6YO4ExCskW7qlENBDo_Ru6EA2gg&oe=6AF3305F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
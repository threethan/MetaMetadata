PAN-UYms7wziQm6qhyw6k47276vtnV4XOcRdGRWp2yUEvFF3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ZdeMA7wNiBFz7Qis54w_J3rhb9VCjxeLiq8G1jGUOg&oe=6ABE6101"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xac5JaO6pwQ7kNvwEfrEQW&_nc_oc=Adq3320vgpOhEG27Lmo0zrj1WbAxre5FryU5goVLlpns6C8A5Qjb-lIg-O6n_nH-OcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLLKKdvksfVD1nXj2qvN1fFTOsmHdbPJMS4LH4d8QSfg&oe=6ABE851D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiTTGf5O54UQ7kNvwF8aPZl&_nc_oc=AdpU6nUMP8VD0xuFze7SHyxd0BY8oI038bhyQlNRWuFfWBTXjdRefHVFqkuuvbPYJwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHljxBIO1sx9wHJhysaQuge6FGZfAIjKN63c98cgBv8w&oe=6ABE86FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv10SD4rgk0Q7kNvwFuxpfo&_nc_oc=Ado-a584xV2rPdhe6HaO1tCcpnnGhrDHNwzPCdwfvPdVMD5pSKaDzqmh2NPqigt_QD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIUZrTXZrljDZjxN_FNA5p7ZLRfEuZ58MIInawTjfe7g&oe=6ABE7B6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPiZT9uqiB4Q7kNvwFgGauT&_nc_oc=AdqXvlGCaHiTqTS9jD6DiLDVPBQFfxKUP85xxoosrrZyFvqFSxPAipofJOICLoXbgok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItUdjQK5Xt9eiR7WhmD8KwVH5zpQ83KuxFAlajYqHmWw&oe=6ABE745F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP7FaqxYt-kQ7kNvwFGD9mN&_nc_oc=AdoGXD7Lo87D4f_Fa0Ku0aFW2xFH1jDKLX3vLEbX07yF-zUDRS-HwZiB18EIm47jPGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBRjNSLKGy8wAEp5HVMRKENmbShGr9Mg0wqDu5sePSQg&oe=6ABE7DFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL954IEkM
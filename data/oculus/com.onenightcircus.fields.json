QRCkjtjb4rO_aX6qFXQAAL45TZsfU_9fvV9KeS0KiAyjus8fU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdNr9T42lE7GFjaNrBCmZ5nBY3JXMLjL7yo1o8W01g3Q&oe=6A9D6B81"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fLskmeg8WcQ7kNvwFqANFy&_nc_oc=AdpCAiVv5TmlfPSN1jT9-s5nvgsZs-v0yBfZxgZ52crWKm6caXlqF7-Av3lHsHXIk7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJceo3bpi5toB1kWPoKqPwDz5GqLAGSHeoT7Mgrh88H3g&oe=6A9D575D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5YGr4kNf9YQ7kNvwEQ2UDM&_nc_oc=AdoDoQqTFZfo8wHW4u7actxaD45ZZThJM-INbW-oUOryZTmtbyLfMjiufAub_dXxg-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-MR8-9L8wVVgtB_-KCam3ahPfUmBXohaBpH8U8dvOug&oe=6A9D593F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIwCNa3CfvIQ7kNvwEnvywn&_nc_oc=Adrbpr20ArRZbi9xBVYjN2nzsP-wDNENLlUqEQuD68IV2h3WgqkQ4uHFI0Wj5S6lK4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt2WSZwRhcAlDA5MjB9iIsfn5qHPRSkhoJ4Njlc7UZfg&oe=6A9D85EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXm_txG69tQQ7kNvwEqMiC-&_nc_oc=Adq-eKktjI_wrCL06M5T9IpkSgVSILgH-TDul0ULj4OjTqKWUqM1iY_9KVJBKTledhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0_QHyuDsSJHWyWOTF7Qo9PW8_rPpIMAun6rB_1tXR7g&oe=6A9D7EDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTSj5JSLjpcQ7kNvwEHasqD&_nc_oc=AdoK3LnXDiNgPsPzyiiRkhA1Id0hDUnFQ6oiT55G3twwVaeu6vvUmTVkMDd9Tv9MLmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvAp7RIskIQdY4TcKAEIPeOL-mTht9bqF0DrnY3sGPTg&oe=6A9D887A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVHXnQl5-
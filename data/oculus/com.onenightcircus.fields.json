Adps3lrSgR1LtlfpPfYDJ2nPB6dlcr8vLpMejga19UJgu5q6Bqas06oivsLnE-UAMIU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd3TGCVzzdcV6mGEsa6EZ7QhBBfesuLvQ1yMmZ0AxunQ&oe=6AA40301"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZnsR1GADq8Q7kNvwGMuH0K&_nc_oc=AdpeMdOFTj2NZ0Ya1ckxlgBqp-zUx_TUkbCYBlT1PLeG3UXBrFHGRJJB_sPoxYNqXAA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQSOKvBCm-jgZuUluoQH7DyjFpgDnvaIcdGxRzxkuKCQ&oe=6AA3EEDD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHRth66k02EQ7kNvwFGdmw2&_nc_oc=AdovyDh7DfR_6q-Bb_oFU7RJ-DqHqGlbEqDH-1M6orxfbta3bwvovOdhL2t5fPsILco&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDf3Ud5lOunWzNIqI4N5l5fxqcs-O6PmUyvHiFNRHGuQ&oe=6AA3F0BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OINszAzaDsQ7kNvwFy6w5A&_nc_oc=AdqrZ6rltP_FTTzIEdazmk9rb3w9Y-_9N8p1Yj-sqCZJRcs4caTwcBY4u-ZsgbvMF-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc7lwj2kHNscHZ1AFo6MCMai1rUBnmsEgl7OGWk6ErJQ&oe=6AA41D6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUDETMro9sQ7kNvwE-qnEN&_nc_oc=AdqNUGItpFgVYT87hNcAaF3Be3YXk9FMKc6u6vDgR-DIbRwf8cBxbGHkG6po_28ptbQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOpidf8af70XS8_a7IF5T0bTJ01xcTpgdG0TYhm0iQRA&oe=6AA4165F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb40G0yoc2cQ7kNvwGaVLFu&_nc_oc=AdpRZAWrqsznvLzwgh3pRQst5hb6aEiTMmJIg53-_ysp4RSQ4aREJRzqjn1JC9mgiQc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZEUD0Tpea0mPPI8d-zcsHHYfy6hBjnRvCa1oqZpPwvQ&oe=6AA41FFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e
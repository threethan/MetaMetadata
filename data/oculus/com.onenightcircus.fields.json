9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JCAex9N1KUQ7kNvwEiDjkR&_nc_oc=AdqJPnylwD_rztN1LpKQ5qVXJI-Q4VsCTXLIHVnIzsRWLBORVCbHULURMYJSKbzpbQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBIra08g8urJnukfJqQMevG6cB6lGuFUoKeZUxwB9srQ&oe=6AF46EDB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOvWzG-rrhsQ7kNvwFDjmf4&_nc_oc=AdrHD3hqtlMKgRVoA6jiDtdtUb-Dv6bDoyLVPxHxNmleW6JGvu9cSzlqTnskIwOfesA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBTVh4UbGpFxENAdxXLUEb2_kY2qfoZfdPvHRN6ZUQpA&oe=6AF46E81"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8C2Ab1psYAQ7kNvwEnAW18&_nc_oc=Adqt89iv324ZbnjtgukUIRj9bxdeE8EbOZYoJ2ugU037bsDkZCEU1V94VLjsPz3oHyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS48RJlAb8tcyUWW28L5CUlbmYIpuZZuiIY_Uc2f9sEqw&oe=6AF4929D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEoNyiFO_DsQ7kNvwGJazhH&_nc_oc=AdpXNIGvNtDeP05krBhIaTr3diTgmQyX2E_g7kCd3cR7l9ycv-LcoKF2B7T5NM5_xkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBg601i99zradaSaIgdIC75qmBGqesoS7UGhZNegCD7w&oe=6AF4947F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxprMtQJAC4Q7kNvwFPlXG5&_nc_oc=Adr7MBof79mwZadp4zqUtbzP2azYdiwx_0AsQH_QIMQZIGWWC6tJwpCjuk9_t-Ry_Wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2btC4s7K0qQG13BMWEkgHM617Ns1b3IRaDtA12RJCHQ&oe=6AF488EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qY48QFC26YQ7kNvwH9CCKO&_nc_oc=AdrhNpk1CSRjsPsSi5KTVxDEVR2Yp8gaGt68v0hVg1P8z96OiDFkgbrRBKsTUdUxwIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0fH6C3_rLiC2NTKHRfptY-waXTDm1lcqiGIkznTU2DA&oe=6AF481DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
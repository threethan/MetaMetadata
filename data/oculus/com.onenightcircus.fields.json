eW0LBNCzr3Tz1xb50V6V7poJfKUddiQ3JMBrjXUz0h9QZwtE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiSqCz6r30TC4kwFT-pUV6gwsCis8HnPRbBCU1hb7S8g&oe=6AC4F881"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=282yrlMBThsQ7kNvwHxgtGk&_nc_oc=Adq7ARksLsP4C4-RDCN5Y_GOfU2yvTZEM7gmpFUDuMstIhEEWErmFSMsBh6JENhpXIM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFO2FtckpCYxYxxXO31xqjUt-l5Qbcf4i05G5qbXzhxw&oe=6AC51C9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__hXqU-OG0YQ7kNvwHi6F9z&_nc_oc=AdpwlA-xHqrtbB4hN3R8r16fMb4FbHkwx9idqpkZe4k5691Qu-D9Rw7NIlbPeReZyaY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcYM4RJaAJmLARWPQxkeVs5yRT1srAMIc_lMkNUBKw4g&oe=6AC51E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7KzAmgEcwQ7kNvwEIicM9&_nc_oc=Adrmzh8tu2bqDSbHlXebUSqLUz1GrVaYr6ggvoTsDAbf0oGysesjvfs8KUpGKLhXGHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNafCZdYsXrgISMDQBulIjTcvKZtW92AEFu3TkYe-UY2w&oe=6AC512EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=midMBxGlWm4Q7kNvwERA4K1&_nc_oc=AdohK6KEGzlFHbrlrCmw7VWQcywxWfJ5mWO3EMksqhIYvGzcN9YvqChMjSkku7LHGBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPykt8AeafACcp_JWT_PLaLqeCDVPmSEsaAvyvsmYnyaA&oe=6AC50BDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgft-kq8PIsQ7kNvwG3_6Xu&_nc_oc=AdroQhSttQX_xT6qmKiowsK__v-kfIvgs4o0vhcXcZLl51mrxQAv9UMlJ0KElU5oGQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJgc6DYDmOK6HrNiGBWZ5Sfcq1SkEFr5wdq_AwrKCvuQ&oe=6AC5157A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgf_v9uJJ
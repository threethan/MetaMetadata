9", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JCAex9N1KUQ7kNvwE88npv&_nc_oc=AdrHAuX1eY80G6EgR86sVlctL2vOkvFlXWCfGLKPwa-IbuwTKmWWZwLgXOrlUE-DHZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEUOFFCLu7fbVMboEV-cehe_UBRuJ7BScU9NWrpekNFw&oe=6AF5C05B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOvWzG-rrhsQ7kNvwFzqzHM&_nc_oc=AdpCXa_uIE2puQ54x7jTnBdGICgSV5SoSDiYJ22pDUYMSmX57pr66PIIyTocUx6E6QQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOZO6zBMlv3toiuBE6rYrl8k5F6CoXnHSXUjNsOXlobg&oe=6AF5C001"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8C2Ab1psYAQ7kNvwGMLB3V&_nc_oc=AdoMiFQ0FrZ6-oF0jnD4wl6k0jw0wJR-QEQapfDhq_sALCZr7rfmXPvdmWQD7be4V7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw2z-hL2SWDKPPfpN0PdFIk5SoyHZPgWUyPCfwS5uEgA&oe=6AF5E41D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFXvrQeevP4Q7kNvwGtdHTd&_nc_oc=AdovUOtpE41W7pxkm6aWG-JO5RajTCAcf7qV1k50nsPMbhAKuiHqgzAwPygn8LdpzHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQerU6R_3H_hks0js-nKLc8N2klilPu5KwUktMTF5AdkA&oe=6AF5E5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iPNQPDjlp0Q7kNvwGlzU4Q&_nc_oc=AdrofkttjWQBAFVP08OHBAzDP6EjaANWzw58CVNVqakabyLgAa79AafmiVFHsCStJuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR78GeMpvPkkRiatjUBEP8a6_QZ-83L0UniCCcs3pykvA&oe=6AF5DA6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qY48QFC26YQ7kNvwHPCDDS&_nc_oc=Adr8l754Ky11ooSQwFN98fygP3NdguvxJAU4vIknsfgxIjBfjexrS8_d1jOlLNVA9GI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNzFSC5zlF9bkpVS3ktP-HS3zZGCup7srDxO7uDxc1bA&oe=6AF5D35F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
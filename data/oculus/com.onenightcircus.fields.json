vN_MO2LkURTLRZa91uoi3-YjvmH4fvQOaia8A1eTDh9GP0wLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6tXO_j46wgIwWHCtSK9SN6tRM1lumSIDTuL_8ljCsiQ&oe=6A9C1A01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fLskmeg8WcQ7kNvwG2GqiA&_nc_oc=Adpw_l9sptHMS86u4uiKca4e2dGCksD0wl0Z7ZtObJZBcMAcAKu7DGHBfayDyUIpqWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT1-GpvSYV67HbOQ8LK4yy3E8AYMqUIAFaa2ZSbm6nkw&oe=6A9C3E1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5YGr4kNf9YQ7kNvwF6MrOq&_nc_oc=AdqgxRQY2DWt85tWJDkXXeMhMUsUrW2gokmpmDlpIe0MfowVHQpMqw3qn9Cn8aOcZJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9YYZOwV0pOwnQcbbHAAb4fB_YnhlM5aIS83eM3UV0Gg&oe=6A9C3FFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIwCNa3CfvIQ7kNvwHc8263&_nc_oc=Adrp_ko5ax4UR8Mrv3IT_A1hmJXhNqlsw8xM9yRsd4RoCAKCFabqJzxdArCmxSjhiTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_SKdzWlo6go1m18OZodPSAKN39_JDPDMpRSsPbOkJg&oe=6A9C346E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNcbArm2jccQ7kNvwECYJ92&_nc_oc=AdpbRVDWAJr0bPVGHt7_phFUjrNpcujvF9IxfGyaSiRPKbwn87EoCLn87nMcrFoz2ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYoCoP3Bbtnvra1QTAGbcvR-OdG0a-hOgaVRzc69Ebyg&oe=6A9C2D5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlPrmkXdV6cQ7kNvwEZboLG&_nc_oc=AdrSK5lqDCRkiO57DbkTSZ4L5ZKoC6v2U09laDIKdkd1VbZuLdy72flGTx7kmM4IpwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVQEK1O9uNR6WCNmZtmh_jYWDtq4-psntv75CK3DJs9A&oe=6A9C36FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztX6uIXSH
SkJJDey9JT3ernpzex85VQ4pmwVVaUV0yKdwc_5tEnw7ZxnoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbTjtqRdoHmiFtCIAUdKKVSRoAxRX-ENErR5IKWJ2UJA&oe=6AC10401"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZmZ8BKrh68Q7kNvwE98mKS&_nc_oc=Adqpro8MAmdHj4GD36iYQeS4tOj_5v-d1KKMpPqDHeX-2ECOi39vcfsBsK5h9WUA41A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtFAbFS1ReYtIPz_ThKexYoXisEmCDzu58wQnB7zwQiA&oe=6AC1281D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiTTGf5O54UQ7kNvwE1K-jy&_nc_oc=AdqoQdYEz6f0HyLxu1yCsxO1O0x1zMx-Xav7Atcxfx4ugLRGjL1DPYXtajt0gCNsGJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBvlcLTdblOjYzWXIho4LzCTDZ6kIKTBeHInPDcGNZOw&oe=6AC129FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv10SD4rgk0Q7kNvwEHX_uh&_nc_oc=Adr6mWYuE75i4AK2gWR9_Ea0Pm2zA_pl2QBBit8sjJ4jFK_h5h0ZPAkGMQjMDCpmjsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkYizAXJcdA6qPpPSe_wANGBbviugyxlri03JPPuEi0Q&oe=6AC11E6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N3MFqmQVy8Q7kNvwFWRkZa&_nc_oc=AdouVbIBNNsEu8oquRuMY9UuA1FHgYJeyDva6y4QhY3_WQf0dx2KCQ_uVW5nBPI4Etw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZXXy3A7IsApFGKoPN38uJ4003fge4gQ94eOFSLEB1AA&oe=6AC1175F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obYv_Ww2UOwQ7kNvwFQ1N7o&_nc_oc=AdrXubVtP_Ney9PkLmB7tw9zqDTweTkCkch2RiIwTxwo0MKsiBg_rABlYB3qSYYQDPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkUM67-nlw5AytHWtwpKX7fa5MK4bAE4mwjzJDTWi4-g&oe=6AC120FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFtl7uleX
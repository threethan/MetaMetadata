hvqyYUr7djmPUH0mwz2R0R-Q21FOC-Sp-W9uKaSyGmowp1DjU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwgylEOoNaUJlCBaBaZ7T5_hSFJeKfB4ud-we1ONZzOg&oe=6A974481"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXMIWGoYxcQ7kNvwF-dLrT&_nc_oc=AdoyEz2WEeo2JfnY2_F250mEoSZAyyhmObqGMmAnGTTxH2-DhVog-AS5vi-zVu0Dx4E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH-8puFNq7irXdrlCkd8z-G5p5Ru4_V1-EUfndqkSeOA&oe=6A97305D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSyV5jfLE7UQ7kNvwFePsp0&_nc_oc=AdoRl5tXC9ys2TyxKRptJU-LYAFre03mDhI1U19UfktGzJj637LJyFqqEUnL-zDtsVc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtkSoSEg1_io4tfFFnYJrZENVxrsdI5ljVL7G20HNd2A&oe=6A97323F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWZYwQVX87gQ7kNvwHB1WGU&_nc_oc=AdrqWT2i40WuE1-w427FhmRtAZcBgGC-YqDakL_6MAKdVnwbHuxIFeeEJH9MHLagYFs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOY-qxA7y_khI-v5AHoMLLiAlJREpRROC0_YTWJNLzfA&oe=6A9726AE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUBjZmAd1hkQ7kNvwEwmN09&_nc_oc=Adp1Pg412XiY0B0DWSs52cbLZjZBJipzjlPdrpxsLBjObpGjDg7jWZZTImH_jfOwrPA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi3-yC2ncxZeusFIxse1vilX8d6RJ8sQr71sUq5Ru1tw&oe=6A971F9F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzxBOVsaZmwQ7kNvwEiX8ql&_nc_oc=AdpP4npjB3V68dfYp6xyJbr_UqPOjIQ0uE6NDP79uNso3Z12N44-XFE4fw_8OI9-bsk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-xy-K1NaUG4dyYvQmAn09GAvfKiSkhKjQdukKu57hCA&oe=6A97293A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M2Qwq4qL
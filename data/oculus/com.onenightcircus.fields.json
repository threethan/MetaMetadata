T141cHBo2ZctrkKTx2Z3gSOf9j4MBYO6JZV75QMzWGQU1bB6U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMEJHP7rCOsxDlj9gDtCXmM5FXlnbqWEC3g6nYG7KJ3Q&oe=6A92DF81"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3172y5yRw0Q7kNvwEOCWME&_nc_oc=Adr9MpuF61cDi81nfYD8s1i3KIGo0H08ykpVdpdDqQH5mC78HvSWMf1GHK-Sp1XjvOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtqPt6ChdtE3aDIZbJDQpX5lEB_ozkq9hdY0P05qJMtg&oe=6A92CB5D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4gMNS5eaN4Q7kNvwG5iVFg&_nc_oc=AdotT2XtwPNhCmi4nNzvHd1zdGvKGYM31ufaTGYYYlX2Qi1IEK79abxkaQFx3zambWE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRWLUksWcaT2AG4HKR96C7jRmPPPgpiktjW71YHLSwgg&oe=6A92CD3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyz1kPQRmWYQ7kNvwE1oKFT&_nc_oc=Adot277ZrbKuuT22n7N6rpQwJZT8-ZIuQzevVZYxQ98hIJudv9OjqqqfGjLhBN8cnCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfY5zyJum45OKY_hOUUKRCm-mrBdpUA-FnReqNsciOMA&oe=6A92C1AE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZGcKx-B4ZAQ7kNvwHDHwC7&_nc_oc=AdqUeMSE16OoxK_LXu09L7-3_8okzKLjbp7f6IqTimppRTTuwcEBuTo82MPOSHAG0kk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcEb0DZlae81NnKwheoJ3bcFahWpctI6qTjjuF8V9YrA&oe=6A92BA9F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBiuf5uWPuYQ7kNvwGaszpq&_nc_oc=AdoGzHHpKBNexhxpALHIv01L3tfxauI6CdUfefBNfTJqxCxi85_FQAN30OkXPIMvJ5c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_sBd_OYfu9wpQO9zGr_jLldXYO98aHzLxlGN43N8yIw&oe=6A92C43A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-du-Z2bki
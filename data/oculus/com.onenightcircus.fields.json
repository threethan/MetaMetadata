2joKAf3X51-vaAtyZ9AGsD9Lw3SpYJNpuWQ1ULQoZuMJ_7BO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR1ZdTXn3Zl5ISPDEzy9YOn2aLiWm30K3zqFQo21AOLQ&oe=6AD3B141"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rM6se8UtuAQ7kNvwF0JrPi&_nc_oc=Ado-u-WlKLJMixXBMEhqIakdaB8QDKIYIO7ymjM9-UBz9cLAEO05rhoYa8tbfyRaJAc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9ti819ANy4KodHXWlMNeq6XobhH-ZdJyT6YrSTMRZDA&oe=6AD39D1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IDNOpC0hygQ7kNvwF64-cW&_nc_oc=Adp3mDxBpUpb8lJ01LJOBREejNznTqGjJBd4xLCoIfDeZfH4eAHBZxyco16kOIyTIyQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN59r77QLSD3QJTbD3RBuU_Ee_Ywf02lgvX0w6Jqf9jpg&oe=6AD39EFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRFdhFnZHLsQ7kNvwFy3gSU&_nc_oc=Adr7rlNDCbMWHzvFG_lW3QqRloyB4LTmXH_6YrzLa9_6LuTH2F2K4jIYvrIOcTDgfgw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1cDIIrcXsK3kOoY1Qa0RWQeNT1CO5ARQDoruApwrp0A&oe=6AD3936E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdPgUYItSoMQ7kNvwE-HfWg&_nc_oc=AdpMBxDuOnSYqykVkmzFpXudSXvvfKKRQZm4FV2Q3cVDdA7I4E_tYMFDGp91C1zGjQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAxIYif6Y3QPJhIy95MksRY40QqIkPIwcYGSPDIVHAZA&oe=6AD38C5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cns_UXxUbKIQ7kNvwE-Brkx&_nc_oc=AdrznqCcrU_Ct-Vv16bC9bpFAQZ08uLKs1trh-Mew_JrTHVab20IzTnoyI5s-J9IhRw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx-MuGGHGkcYPWgAuckFo2YN1ub4gmxQ5KlowD2sRMIg&oe=6AD395FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiJIoVWg-
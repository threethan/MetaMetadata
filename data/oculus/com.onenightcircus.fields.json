x9rfLd5okFmU8EZeiH9grKuYw5lHkP56kFARkAofsY_FAyyoE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgUd5w6u1evroaNpWwIMFccel50zht23Zr2Ye_9ocODg&oe=6AB67801"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXiVrAdCh6AQ7kNvwHweY7U&_nc_oc=AdpUltykRS5s45oLdzMMGGfpYNr0-rKGuzhwfoOAgFt3uWkzCEYcfGZNfJn0AQupYo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgqraSmpZ0hGX3WkG-FleG8yFE8QeA1FoHaBjhbWl4Ag&oe=6AB69C1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZoVSURkn1sQ7kNvwGlKBmR&_nc_oc=AdrLxyoJvGNGMBIK2sfpUJfQfllYzl4375fI4xeTszRNjjoyjs87UyE4dH8mRpljC7Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZmfAQHx3d3QEUNUKOmeTtZC3iHY5GTL1tKZbhx5lAaA&oe=6AB69DFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oKIyX-4Pk4Q7kNvwHCXWR5&_nc_oc=AdpZ5p_pzFLZ-qfKo-o363LeTDUcwkQoATdaANY0x-MIqETRe99DvEi0hJRK8FVkrJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIELPbrAu7WYQTXJ8lJfTT8JySTL6JfaBEhdMep1-JMLQ&oe=6AB6926E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ-dFVEW4qUQ7kNvwGt5EfU&_nc_oc=AdqKYjX_oLvUJCF-VSzQNxrZHnGy8ISzQ_pJ4YndXtYNQet8BmgJoBEC8EQGZ-O4VkM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEcHxwroL5xVHBmrqykSP6ZBIel4-3DMOCtL-It88zJw&oe=6AB68B5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwS2seEV8B8Q7kNvwHbCs3j&_nc_oc=Adok51lT_gqrLLOO_9GLDyZ2ttAHuPSU6x9-J9am6tZ7Q-EnabS4-3_GZbvc6jPXGAM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKdTARlZM2D3B0jYnRy_RcL7egQLnm88PeFYuouCabCg&oe=6AB694FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLuzOu2y-
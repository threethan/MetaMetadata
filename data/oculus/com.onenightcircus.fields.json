AdoWaPAVgnEjfZGABvfh5zba-0h_35sdCWxYnn99sNZ8HShrKUUl9FfPh3uXjLGOZnA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0wdSCVGtdIe7uSHL8EjVGuBC4UAIiJ8cN8uCAlAnpvw&oe=6AA94901"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdPHl2XznAYQ7kNvwHTW23x&_nc_oc=AdpvXRYYFqrIAFnvwBIL8xuJ44146PEzwLH5fjh-xTMClY2WOsej-FgENcwE4ZWt5JA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4XmInyNSjJXScoo9zSuDLMUmX1w3JGdJSZVfv1qCT_g&oe=6AA934DD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5EJYsJZJ3sQ7kNvwEsgAd9&_nc_oc=AdpWHJq6kazaxwYiAdMHp9FpJ5UevpS3VJV_-Jk5T4CcyirV487f7MDLaM7nSyQPrJM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrKTNczFWE0XEdcwFjQN4UYjNGhgVyJMmZMRQC61yZPQ&oe=6AA936BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jsCVmm4MRMQ7kNvwETHJH0&_nc_oc=AdqP8QtI9O3FkpyuF6J9u8xGb8ICMCp5GV8bWNl20M-nvxh4lFezdU7aEKTDSm9du7U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7EnsuWH16nNgUagq-hup4xXWH9U7RZIuZAFusarj-Nw&oe=6AA9636E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ty9LgTzqWwQ7kNvwGkJqiU&_nc_oc=Adq5OGAvb0oC3ogLvAhlZ62YclamF0kBbUuDFA1yhH53t7xln96KVBo3FYk3o2DQ5i4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9oB95EhNigT7Co7UdJMUENVku2YaY1L874B6fAwJMtw&oe=6AA95C5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB4FAirXR6UQ7kNvwGqjL82&_nc_oc=AdrlIfgnGUFodFoRJDzfVFuyf709fR4e263w9dMP-XIdAHHWDQ88Df4-_MOrqqB_OoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsNbou3D1aOw97w37obt4va35EPluSMFI85iYXNtp-Yg&oe=6AA965FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e
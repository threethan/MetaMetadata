Lktypl7kdbvmgO_DuS0hizKr-n4ZehEDz7RLX4TYDtEGrE72o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9uQVsSnplRiZw0MGdfHCVIwvs6OHxI3ZErv4iKpqr4Q&oe=6ACE6B41"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbV-Ln1CZ90Q7kNvwG4q3Hr&_nc_oc=AdqSBAfLivccofPbuTLoAZB6eAQ6t9kgh-AG34yabdBBhwD4gsHdRyN12bKEkawqkGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8642dMZ1aVECasNKg3dhOMiClEA0thBOs_e9t66AKVA&oe=6ACE571D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMQXd31RpkQ7kNvwFjg3Yz&_nc_oc=AdpWqPO-xQV81j21sH6KdhVTbXDwqdLI44-VbsodfkTEGhnBcqJWNhz2GA7K36Pl72c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr7G7JWkyUHcVxh0vujyFiFN6mZsA9szvojM4WQuV0eQ&oe=6ACE58FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn905xW0QE8Q7kNvwHpdhCx&_nc_oc=Adobj9HGrujxRfcu6gzJ_-izLzL8JaOL_QVyK5_YR746qstbuRnh0ge3fRn0rB22Izg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlGLd9r6091AT_l6wU_QbYtHcbRu9JLkocwbaz0PRboQ&oe=6ACE4D6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H74-eBAltYQ7kNvwGJIQxz&_nc_oc=Adp1Y7Smm31a_gCHk5TTwDnFm_UlsNdVm8PNggiISoc4UnxjuOLjCEK8McL0b6DHW70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkChlP-HBxkABpywtGCYXwv-HcMD0KaNgkJ8DURY76eg&oe=6ACE465F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnt5miF6QGcQ7kNvwHkZ-aH&_nc_oc=AdoFhEOCQYe4Hpc40Hk8FEHDuZ46VPRi-OOPqzkIiKSilX3NZHfRg9ZiEGperHckRNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7g4LsepcPo4RJGkhQadtU66hB9Ijx8LPT-amub4YLkA&oe=6ACE4FFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYFCJwR4h
9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYcagFjtRjUQ7kNvwEa0xLc&_nc_oc=Ado4t7wsuvIeQhq4MRnVSjJTEyQrXRJtzb_Zs3diJfPhvZahKi07fc_UIMYuiWdo1nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRBrVaYJHoHV_M4eIinEisI2ljg_Y-sMQWVNYR6_rtMg&oe=6A95BB1B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DnzctoUluoQ7kNvwGWnUKl&_nc_oc=AdoHguBeOSgXIAWmRVhW3xdcfi0UXQ4nMOQClYO31yTPQ10LxPkxgh3Mcw_jYb7ZWx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwe81mceZTUFUj2QSd0eO6Akfl2hZpSLmYwk3_Zbqwiw&oe=6A95BAC1"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7agYlV01UQ7kNvwEAaPBp&_nc_oc=AdokZ-aqBon5lnTzz-5nZXuyVvgZFKhAu-JSABXcIkJV1EGucyUjg-Ld_PGh2BDUvXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4NG2hiQE493q8CJFVUD5yiZHC0HPOOlmAJRWHTkGQnw&oe=6A95DEDD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4gMNS5eaN4Q7kNvwGmv4Gm&_nc_oc=AdqBU3-rjOH6T9LJ4Yirjz3vjJ9J8Q66caW1EJWiq9n4PX6hRZx22T1TqIae53FTKVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELxuG_5xzrARbJjQhljHX7y5_yVcYlrceWkgWVdSQGxQ&oe=6A95E0BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyz1kPQRmWYQ7kNvwFx7lmb&_nc_oc=AdqyJC2t-aSs4WfdA_hMFYVlTYGdp_DkH_hI2PF7U8qQJI7dP9I6MLYv1S5CoRh1vc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnSGkZ2gH7_VeO9vdZb0wT430QyO02GQcpPt3LIw6NIg&oe=6A95D52E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUBjZmAd1hkQ7kNvwG3RGQi&_nc_oc=AdrhsHAOR_6GUHvWagQmAyvKT88AVKIT_hZ0ZQ9Us5fth8pEI5W8HfbpPslv4ID9RPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu9z4vYNTYPgw-UHZjUWZQ8_NI1WeZ0JcbHYOqH0BswA&oe=6A95CE1F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
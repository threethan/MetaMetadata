iMtNjOzKmoV18TE_3rjlgb1vXLjHwAwsPxXenH0ZRwXflEL7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdxyxtX38HAMfbQ9xAlGZ4nRy75036Y0alsNyoXfqSJA&oe=6AB3D501"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXiVrAdCh6AQ7kNvwFPCeuU&_nc_oc=AdqhB07jBIbgNK5cu72Q1kSGXVujJsO-nQ9IOVIpazq5zz5Jdp-I8qDpszzTzvVChw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBo4GGw4EfGkNhFzoVKi9Aa69SHcGPq_m6e4PkZsqgCw&oe=6AB3C0DD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwtaOPmGeAsQ7kNvwG7ikDl&_nc_oc=AdpfMVCw_vAni1IVTmvGnYhpTD1RVPjMR8QTrlRJesHKI6YBk_skG6ErBl5UEbUhT-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIK0J13x1fEYzFrgkP1VklgNM7zOnBWCxSodYdRl948g&oe=6AB3C2BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN0O7QozrEAQ7kNvwG7YNiG&_nc_oc=AdrgwmAaLUR0FaJGQ-VbAQfg4bfqgpGyRKBPz-VZBRmC61gOT0UZ6zAneHG3zr6T1tQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-cLEzMWqzSPU8BNuBuj6NUZbX7tIyiOJWvuiAvUQC_g&oe=6AB3EF6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5qKb0pappMQ7kNvwFDTcFf&_nc_oc=AdqxLyZDdFqgiV9Mv1kmVZ8MCchMkFi8cCbF0llSy5WD_P7TSwlwEuxsKxbIKS38820&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTi8G8q6QoKHxy_gWwLIgYpFRkfsYJv2UXvpwoksx3_A&oe=6AB3E85F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bf2yjqTOJEQ7kNvwEaQVvG&_nc_oc=AdoTAknU3YT3q3gm8Z5ebyrnEAdNbipJm5GzfQYyrUsRB58N1o_Eada5EFpGy-vyB5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH0y6F31bbrH8E4yaUzqXRkYk6cq1R9AIQnhxSuVK5Dw&oe=6AB3F1FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UNBIpeAy
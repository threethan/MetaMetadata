an_7ueXHIl9qsxGD5oSY2LLX3qIA6IvtBYKc586kxhE9mf5PM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiUcLdES7Nu3_f6gi1wV-ers1j3qEb7bYcuj_p_qCdcA&oe=6A985DC1"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXMIWGoYxcQ7kNvwGe2qbs&_nc_oc=Adote8pMzXNRtkAuQre4Mp11UF0OQRFr9R7o-G0bBwaXsYm1H0Hl_7q6EoP8ty-k-7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ2ysweTjsCTq3_QBbpo9jIdlr-zFRpYdHv787FsR-7g&oe=6A98499D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSyV5jfLE7UQ7kNvwFU4Wds&_nc_oc=AdqJKxNB1PZUjbwKbg76K_qmRaWPoYYyt0SYpvEiBbiRFwTwOlAHZFbbgivW1r8CzX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIciEYqRaLVz1U5Y_sKzU9Hz05_D8yPyE7xff-HIMjpUQ&oe=6A984B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWZYwQVX87gQ7kNvwEo5XBs&_nc_oc=AdpT0t2MRNStAuv8Ng0613uBoW83j-4SQdX06-hyI92JPGOHW9-qK-HqrUmg_gfZGU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEQsWley6Q25rNZ5-X85MgWmOfiac-OXWO3U79m8eIuQ&oe=6A983FEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUBjZmAd1hkQ7kNvwHWnAY0&_nc_oc=Adr5iUmRmiOBfslyHnkMCwf1wUSoMpyszxcQgxXYp8gWhPiXjbtPq6I86310oMSVmlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjcDSQZUpMPNoZLqbrGZ_MNUNUE2d5F9pGXI_ClJdLXA&oe=6A9838DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzxBOVsaZmwQ7kNvwFhOLO8&_nc_oc=AdpAcVx5xD8WRwZGf5hJ4-WlVABq2x4l-UQe9DDd_UnZE73Vp11WFAFCFXCSaP-qSmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwX9EWdLwd0wNhkgOGZxrh00AiUpOE07MqPixxukgQgw&oe=6A98427A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M2Qwq4qL
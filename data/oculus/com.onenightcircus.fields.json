jcbKeHNJ7JeblWuKGzn0wU2KhzaCX-omPKudeaFesSCGkYAmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnt7ZmmPlqCzI3WywdpWx7QEvCpTqFvRy7LRkxmK8cFQ&oe=6AAA9A81"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdPHl2XznAYQ7kNvwE1zcdc&_nc_oc=AdpBB-pPB-doW0qJGx26QJa8croViXVw5CTLi_ZNGyHJxutQMFTYpwhzCpEnziCO6_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9VmLk4FWfV534vkYn940lgVYCyXHXcez_YjmknB06oA&oe=6AAA865D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NHLsohK3iYQ7kNvwE3no2j&_nc_oc=AdptiR7r-2VjRXk0muG_DR6jkR5DO63lZV2qvJ5MC57a4CiBMh98EG14lz7Dtqc6wrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_l47XxZgMxKvQGjXR4crhINPXpRo50m39y-tfL_6t4Q&oe=6AAA883F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z7NoPtx_bgQ7kNvwE36GVd&_nc_oc=AdpT8lg5ABvaLmEz_2b_CnODfJ9mhzG3d6XEXs_mk72RUfO8uJ_Lq1hgfgmjO_hsSFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzin0ey0lq4WPQ0hn5Z-W8njMoC4W6zw2R1D7gmzsdXg&oe=6AAAB4EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ty9LgTzqWwQ7kNvwGGRqP-&_nc_oc=AdqqLka2QvThbc4ErIgfCrirv0mflHyy32MI2jS2gc7GLwN42fWvp9MNqUm85np_PoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAkXjrrP7fVTyuY21mXvlLheGxy766TGsa1Xz1H77GZg&oe=6AAAADDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB4FAirXR6UQ7kNvwEDOZYk&_nc_oc=Adqmt72creKNI2aXJozkpSMmuzpcyuFlI3CZguB7t1g3gKUiBWq4mX8pmrmJlGZgptU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIde-VqYMQ1WIu4eDxy8dzoNrTYSOr1OVsGv2d6nJqG0g&oe=6AAAB77A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCfAFb_Ak
TdgA_acLrJ1hoW4PZCq6zcJNkNjTaPHfduIvw6s60exY3hlRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWjKH0nBoqB4Hv2MGOukiGCBkGViTwUclIzMHVTwq9Sg&oe=6AD22781"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRpj-8DbT4cQ7kNvwEb5ufp&_nc_oc=Adqmz2i0latZEUuCxgt3WAuot7WcbNzhFUIFWqbYIK50J__PY1U__SujPJqUoe4MSaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDab0hzVM9qZ7kxl06ah6FtcoBGt88FCqJhD06tCJhHw&oe=6AD24B9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IDNOpC0hygQ7kNvwHDuwHz&_nc_oc=AdqM6vSolH8cKr9Ng9CUw1IyL7fLb96STmNR3aLDtXk9fCPzKs71abpRg2Tmqd6r6Yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXD09SFQkFtT1RrCxVRE61s1qrIHum6hpN7V7C5ALQUA&oe=6AD24D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRFdhFnZHLsQ7kNvwHSO9vI&_nc_oc=AdopSTkyZtEBUtKy-I55ZROnjgAPMiipVn-7kUnBUxNHeZ4qetrJaFCUafh1MX6w29I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4LNJFhpfsoqO3Mx5-0hY_FWQIvsnY02AQSwPn0-QTwg&oe=6AD241EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdPgUYItSoMQ7kNvwGfWm5u&_nc_oc=Adp1I0BYnen52oRSd3ouFwnYe8Wo-QjY4BjHxIDjiIt94oKsC3vNlEUk0ybJZCWvbS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBqLYTF4T69_i8PtevjoEDgeHWo3bkYBTuf1GBvMVmvA&oe=6AD23ADF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cns_UXxUbKIQ7kNvwEr7JRe&_nc_oc=AdoekAj2vsonw4CuevQ7JXE1XQWDBRgIopgd6Iu0lqYLNe7ZJIO86uXFYL22AQxRNIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBOo2VA7Yo2_0Lwoiok-VjFzWUKBSzDBXOs60Uc4_KZw&oe=6AD2447A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiJIoVWg-
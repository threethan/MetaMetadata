9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLOVGVGlxsMQ7kNvwHqSi9w&_nc_oc=AdpuRqsPPUHCM11ZuNGUIJScijWtRaeAK05x4eVZ2rNCBJ9tYb-zv82PNW5DxNtU8Co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvEUFE1dv2rEAe3M9NaXbGWbP5T_x5ODu0v9CX2NlVaQ&oe=6AAFE0DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCHQG7vacqoQ7kNvwHBZGBY&_nc_oc=AdoZZlwJ0r9LK6ge2bDmmNljwkj8DQI7-z8v4kcycWOEkgmCu3LnAmcVTTGcNnUoZtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2VUAgVeN5MakufrD2dd94rk0GiBPSzGTibaszDLnA7w&oe=6AAFE081"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F38cH_2BicsQ7kNvwFjSScU&_nc_oc=AdovyprenNMZ_xlngDOW_IbRTyyL6k8jTNWDbmssBGO6SukQ0klCLfP1VTkAOWmkDFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJml-4yg1kkZK3TqdSwwtbbrY4juw8mJEBusUJyTH_q0w&oe=6AB0049D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFDIIo0vOhoQ7kNvwFLw55V&_nc_oc=AdqmGXYf8Uoi8ha4DtsYRBTvte_yWXLOlv0FsWJx-2mJ-3Y2oj9s5kStnn1ZTurBqKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSnEbwr_rulDyYWx5cM32i7f8WpU0KZbAKZ4wNlJR-Kg&oe=6AB0067F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxmQkSL4CZgQ7kNvwE4F6eH&_nc_oc=Adr6mc6W6-7xkWhnbQzkqz15wA-DsWQOZ_elWbb-P5oPk5lAoA-vF0i_OYcha9Wx72g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK9kVEi_AYOKcArObCl85HWvtVLEfoNFDKxfoW5HeYag&oe=6AAFFAEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myB4wpFYiygQ7kNvwHCyGjl&_nc_oc=AdqQcLwPLvVl4l7rzKHda2EJaUmkeuVsLIIq9D1iKMysQOFDaIQalppSJ91ZbBIuOdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3MXMdJ_X8x4AAy0XAyL4ABB6A9SJvjSXp7x58DctzEg&oe=6AAFF3DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVU9PY9MypEQ7kNvwFt8tnb&_nc_oc=AdrLelgbKWn9etOsIeLwUG-fiqAx1ojTsYVHKswvOsJ9gOmoDsjS_-Olk0sWFiTMoXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwd8LhnMDRKwrMfwhxgufXycajW9E7wS4v-D1WfdXubA&oe=6ABBBE5B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE9idwW4OyIQ7kNvwGa5CkX&_nc_oc=AdpfLzbbhiCBk8eQY-gWjN28TpR2g1QQNc6DMA2dqYhu4a3F-P8xUCYiAQGElCNCNDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUcaYyIDOVofednzPnj46Vv5zPff26K5qMhVzmFGhncw&oe=6ABBBE01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xac5JaO6pwQ7kNvwFmWtFY&_nc_oc=AdoL_PoQmSaP7pdDBpBl9HRH88tk16zGVkRTMwTuubNfoUtzipeu6yvhtPqePCNHzGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNkuZsjnpS5b3ltJt4J8ITvy_nPPckScT1-sXBKEvWdQ&oe=6ABBE21D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfCDHca_aIMQ7kNvwGp4rVw&_nc_oc=AdpNKtuSGJzci9xvZccgHZqN4-QlfCGeSzrwyb8I710nFhPdMzKcHzIo8iXOU_QSM2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx7JzNviY76SpVnVjnUBQ_tYaAZQZOBukdNErmNq9iHg&oe=6ABBE3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jXXKTIFGaQQ7kNvwGiG3J7&_nc_oc=AdohpZoLZSSFwxqSXFvDHVATK0vy8iWSRNxNP9HWIL44Jsif6fWVtuhbk4l2_duM35w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA6n33FoUOZzzW26sOOqDh-IAxQ5yAhULap8D1Grr3dQ&oe=6ABBD86E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvAHw2MjnWoQ7kNvwFAaPMZ&_nc_oc=AdrADN_wlg0G3bRtFmoDJXZZK1H8enR-DAGL2QXSSHzjcwJJ8bQnmZrIsBPMJ12r4Co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiNZfutc3c80y1UvS0TjMkqu0Fa987u9ZE6Z03Lu4grg&oe=6ABBD15F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
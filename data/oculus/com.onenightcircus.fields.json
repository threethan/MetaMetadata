r4fQj6xHSw-odxeMHFUeT90M0smJwCkBjt26Os6qbXVHMmS0I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1fOMP2JvOulh7ngfpDV18zJ7y0Wdvh0Ow3ViZRxlLXg&oe=6AE34B01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euxsUvBi1TAQ7kNvwFyOQXS&_nc_oc=AdqcNApbgFpAA1VIIvkLSs5TGL3_XN7zYn3gJmLCE7z9Yv4tJvJNe9u5aDTW3KcCO3Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORH_FWkrpVA5ENQXuXyuRdqQwyQEF3tLjcfjOSeSDYPw&oe=6AE36F1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LUTIt8vxYMQ7kNvwFTdxql&_nc_oc=AdpyhPYU8ihtjRm5MqMSk5nYd46l2mlcu_JOzPSwGoqIJqNzIHoefx2JOHCMdCT4W6Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeIRpRlu6VMcs0QrcnOFAt5yNo4MsvlaPGz-mFea4HBw&oe=6AE338BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_pOZxUlOZ8Q7kNvwGY7Jyv&_nc_oc=AdqkZGdRzyzzErYi35dExyPa-5Ni7_4ufEVAmQrkxgVBJeBiSahRRwB_OFZ5p5WGtCo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONmJqXyznkX5aiFP6d67tqaxXyBSDmGUHjqMCnft6TYg&oe=6AE3656E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjp_V9q2DuoQ7kNvwEN8ugj&_nc_oc=AdqblGXpKVruFh1ZUPDORu6miUYd7I211x2vNhBuyAqDwZ8bBVySI0TFytyf_CzPnqM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMwa3S4bf044kIswzak33OGdwsf_fYd7Lk-4OIBhKU5Q&oe=6AE35E5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6odEq_vSFHoQ7kNvwEY2Goa&_nc_oc=AdqJp7tOCWjp1Gy7vt9RBvObFOZncGnqZoSfXxx3l29XIyeZ6CYbJ7l4irwTwoUp2fE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6cFHnLlxgyo5TGcs958X8WlrcXpVZ5sU1eadalOIbtg&oe=6AE367FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFAgy3JSU
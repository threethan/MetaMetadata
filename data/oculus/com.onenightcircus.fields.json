21049", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLOVGVGlxsMQ7kNvwFwEYQU&_nc_oc=Ado87z-Q3QXQNaYy1qybVU9uwAGKTXUmrKUa7hBNzQtr4QD-NcmYTa4Pl06by0T8lCM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDssfzwcJuf7UflDCvjReUEhdCITRvh5Qu7lIA-yNZow&oe=6AAE8F5B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aqwh5dOJh4IQ7kNvwGGLv-2&_nc_oc=AdrSCiOzlflSTUlRDhDE0kEGnE0wTZsDOEp1n6gZXUAYEyTgsJ4OPK5m30sdMnWwQ48&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX-eKl1cpb0cKywtaObNnmstvQmLP-aZhH_LHOfMCnSw&oe=6AAE8F01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA8vh3-DikEQ7kNvwEgVpW4&_nc_oc=AdqTinJ93Z7kfkqXS2CNV6C8hxvcCpt4HmwrWlDsYbnSdf5vyiCKKKueDFCnEfe07HQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxrXz1Lj_PeAsdizq0e1YUCzpjEnS8-BIRT6siPFuEew&oe=6AAEB31D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFDIIo0vOhoQ7kNvwGRO5ZB&_nc_oc=AdpEKuuTDAWTEA3D57SzH_Imd8O7XRu80wNT7f8V8Y5vkEfwMcxGSdfxJOEHRdejV4o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2VZhy1axtJMxTVtNUi6psFDkfENm820HWWN3QYYvDrA&oe=6AAEB4FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxmQkSL4CZgQ7kNvwEHEwSQ&_nc_oc=AdqnqcUgfMs5ZEVQ5THkIPnMAI9oUt7iDem4emSDRMbTlJf2DkMXewc4tzMd6nEXR4E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItHGYgXsNpBsGORAlvRU_9maF0shRc5KUcA-tY30w9QQ&oe=6AAEA96E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myB4wpFYiygQ7kNvwEh6kRr&_nc_oc=Adru8pUHMvRsHL1Q1a5TAtW-0vNDcxTvAMJX5ilk7hjCFgVGlyS5wbKNmYXP9zqqOgU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdB4kS_V-HxhHAMB4-cByCjs865vjOwKKD8f0NN01Xrw&oe=6AAEA25F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "A
q97yUd6JRmTifoAY1yib-Zk3mpNunTl-SWgMuJANxc7M8oDn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUQR9ZpGuuTvLeBEJWzFvMrLgXgudlD56YRwrOizgTUA&oe=6AF203C1"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOSp6XUybGwQ7kNvwGo8Yz4&_nc_oc=AdpVWkMfE4KQDp0yOumuRWx1uJCVhuTIkbQLytJryC2m-e0urW1WMh1ob_zAlokc0Mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3URt-6-c3nIj-tKhpnWxZvsIe6hnqpbiJMKqI5YKuVA&oe=6AF1EF9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEoNyiFO_DsQ7kNvwGK9goV&_nc_oc=AdqQW66PxrDlOlU_QlmLfh5GnvbKQaYdlu5bNOspnBwV1bC7yeBaqCr60EFq_-x-FLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRDf9RBYJpxUy4rkSSY80fRK2nxUAiADyAf4TKUMdmYw&oe=6AF1F17F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxprMtQJAC4Q7kNvwEuq2OK&_nc_oc=Adp-7PmhG_DMwu6xu9jCsEovzlu0MoBVmUJUnq68T6WgxwrNQNWPuYvgwKNQYHN6xTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc_9CXNsSiwo5xpueq-Ze9XWwLsesr5wXKC2ty4vJLwA&oe=6AF1E5EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNCQw7AADSgQ7kNvwFtnAev&_nc_oc=AdpDkQ0DkuIGZNm4N-xaZ364gCqStQJUbgpkmD30JX9TVV2cj9B1WVa5-EQID2XwMng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_T8NaVGjauK9DsuC8jfng3s98MpMCElL3VT8FamKrTA&oe=6AF1DEDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7q-XxFPazoQ7kNvwFcrNmc&_nc_oc=AdrO3SZR7VBVfyesXa88Gq1uMgLXtaMqFFexiTp_dFLv6Uw0pRnjUAXkr8f96Uaqo9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwu3DSaCfVNUKTEh6n99Gnp1E6ubi0ttUUw9O57THfmA&oe=6AF1E87A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB0ToGpBn
5771-25/499307470_996863526670234_1642446739292448126_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpatjLVhd2oQ7kNvwEqYS3g&_nc_oc=AdoZ7afdInpZBAZOTtl8DkoLdilRb4i5oVZfQa_eCHtDDTS-kCdXrKrmry_ua1gdydA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB6GaLPD_mtgh2dJ13wekz_PGi0k6mxYLOMrIa18UmSQ&oe=6AABFCC1"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "27116012771424144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_27116012781424143_1437624668867778929_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHQNsb1oK24Q7kNvwE5wMSe&_nc_oc=Adr5JWxharqhAE26QzvdolvvHfHe4r_5IgEqrIdRtv-MsR-qdy_BNKy85QhVPkBPVqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMj8PcfqUIu18qPiLmOIpTTGKCssX48yH8GIMskXRn0g&oe=6AAC04FD"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1976656469652933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_1976656472986266_3379136493362140784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnfxBPO9j_wQ7kNvwGi8G8F&_nc_oc=Adrk4Jn8u-6AeMEutVNRYVfgN7dTpFAb0rkdOdHM0nEZ_Ih9q8zbWFrgpxxNChfM-Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfPcunCSYKixeIoL-Nj9pdsEldvzyKsN0bEIBDc64FOQ&oe=6AABDC78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "972177695653550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_972177698986883_1119833782067263075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Evt_qgu6uOkQ7kNvwH7jQ4O&_nc_oc=AdpuZ95Go8LomqYof-f0DcvW2wXvEVpKX2xj-VstuDUoYoHYcHx3XMeIkfhmVtbPS0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ-7KaIJCcKG-THP9hsOtBVBxHfxJ9gs2wwbWVh0rttw&oe=6AABFDCF"}, "display_name": "Fields", "keywords": ["m\u00fasica", "arte", "inmersivo", "meditaci\u00f3n", "visuales"], "long_description": "Fields no es un \u00e1lbum que se escucha. Es un lugar en el que se entra.\nUna experiencia VR inmersiva construida en torno a la m\u00fasica del productor de electr\u00f3nica/ambient Die Stadt, Fields disuelve la frontera entre el sonido y el espacio. Cada pieza musical se convierte en un entorno: campos de luz en movimiento, texturas generativas y lentas transformaciones crom\u00e1ticas que responden a la m\u00fasica en tiempo real.\n\nFields est\u00e1 concebido para la escucha profunda \u2014 un tipo de atenci\u00f3n que solo la realidad virtual hace posible. Sin narrativa, sin objetivos. Solo presencia.\n\nQu\u00e9 encontrar\u00e1s dentro:\n\n- Un \u00e1lbum completo de electr\u00f3nica/ambient vivido como un espacio vivo y en constante evoluci\u00f3n\n- Visuales generativos que cambian con la m\u00fasica\n- Dise\u00f1ado para sesiones largas y contemplativas\n- Optimizado para Meta Quest 3\n\nFields es un \u00e1lbum. Fields es un lugar. Ahora puedes entrar en los dos.\n\n_Entra._\n\n", "short_description": "Ad\u00e9ntrate en la m\u00fasica del productor de m\u00fasica electr\u00f3nica/ambiental Die Stadt. El sonido se convierte en espacio. El espacio se convierte en m\u00fasica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onenightcircus.com/fields-en/fields-politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "OneNightCircus", "support_website_url": null, "website_url": "https://onenightcircus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": 
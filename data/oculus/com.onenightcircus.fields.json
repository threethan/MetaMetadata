9", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPaw_PCULHoQ7kNvwGBD61p&_nc_oc=AdrpquaKx3-rfPWxUe4swBpL_wDyIVD5TippBQkzbikUunrTITevMdg0aDtwtb6Y7HA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL08PEwx1SjC7BZp2cWbHVoUlgT3Z681ZGQS4FKJ_qLQ&oe=6AB283DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCHQG7vacqoQ7kNvwHI8dk3&_nc_oc=Adqywnq5cRx11IKIbly8FW4-Jq9sTundREtn2f88Usqln9Qc9me1aIQ0Jvck7GnXldE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJASjuiqI1H2FKOAzCk0c2GczUtcAjDpgyDTCLQTDJYvg&oe=6AB28381"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F38cH_2BicsQ7kNvwGrbVm6&_nc_oc=AdoznPEvEEwMOeDupkAkPgF1MLQxjwTIcz4CExnB2_4EApmig9EXtPgGoLdbbcCc_Kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7eokK2hwvbz0B0ocW9ehkJxk5sc9ngANgi739och2Rg&oe=6AB2A79D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwtaOPmGeAsQ7kNvwHlJGzN&_nc_oc=Adrb6MbL4czKtv19zFKYZTWNfJh81nVAfdqs0lRUswF2SIwkkto9OJTiISW71JkOEaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfg94_-Yojcu70wut5UxQ2o55LFqf2zgaXOB5nVHanzA&oe=6AB2713F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN0O7QozrEAQ7kNvwEHNtFT&_nc_oc=Adq_tF2PmUvoavc80vS-hGhQ6suwxJVZxtqb09L-mX9cInBQc6KJs6wCQKpP67b_Rxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6yoH3TKi4geIk75E8dXOnLRjkaj9rFBZOuL87u5tqDQ&oe=6AB29DEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5qKb0pappMQ7kNvwG77cYF&_nc_oc=AdpH_vzCp-NoHB6WGpmTmsZFFSkn7Nvt15ab4F1WqVYkpbQ711_pLKF0DQBF4RkF1-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgs7eIPHf4sZmVpyfgDlkutYlAPVrsh_Vd1NReXNK84g&oe=6AB296DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
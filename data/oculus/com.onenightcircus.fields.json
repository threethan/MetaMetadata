t=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvaV-9Ztf_k61pkz4weh5A4HQvnaW_Kuc1gz1MjYTh8w&oe=6ACF9D7D"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1976656469652933", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311585_1976656472986266_3379136493362140784_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJjCl8jmyNwQ7kNvwEjDOnb&_nc_oc=Adopu3dgjCT5H9TXbS7Z_1nOLSz2rN9LFwwpepDUFk_Q6M077iHXtSjqJCUqcLFTMnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi855-BZ34zjDAlAnGfWOjriwzPjYU0eVH5L0boUTp-g&oe=6ACFAD38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "972177695653550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_972177698986883_1119833782067263075_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J7pyaWxBSEQ7kNvwELFrvz&_nc_oc=Adq442GHRq_HdM8CaIfe-DLiAOxH291MrmlzqCjnbbIr9XpnUTEpyCztvzdtJmS2Grs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOMlqNn4b5v2yNrF6napRdLf_QXSsCQ8uZ02_0wCPiww&oe=6ACF964F"}, "display_name": "Fields", "keywords": ["m\u00fasica", "arte", "inmersivo", "meditaci\u00f3n", "visuales"], "long_description": "Fields no es un \u00e1lbum que se escucha. Es un lugar en el que se entra.\nUna experiencia VR inmersiva construida en torno a la m\u00fasica del productor de electr\u00f3nica/ambient Die Stadt, Fields disuelve la frontera entre el sonido y el espacio. Cada pieza musical se convierte en un entorno: campos de luz en movimiento, texturas generativas y lentas transformaciones crom\u00e1ticas que responden a la m\u00fasica en tiempo real.\n\nFields est\u00e1 concebido para la escucha profunda \u2014 un tipo de atenci\u00f3n que solo la realidad virtual hace posible. Sin narrativa, sin objetivos. Solo presencia.\n\nQu\u00e9 encontrar\u00e1s dentro:\n\n- Un \u00e1lbum completo de electr\u00f3nica/ambient vivido como un espacio vivo y en constante evoluci\u00f3n\n- Visuales generativos que cambian con la m\u00fasica\n- Dise\u00f1ado para sesiones largas y contemplativas\n- Optimizado para Meta Quest 3\n\nFields es un \u00e1lbum. Fields es un lugar. Ahora puedes entrar en los dos.\n\n_Entra._\n\n", "short_description": "Ad\u00e9ntrate en la m\u00fasica del productor de m\u00fasica electr\u00f3nica/ambiental Die Stadt. El sonido se convierte en espacio. El espacio se convierte en m\u00fasica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onenightcircus.com/fields-en/fields-politica-de-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "OneNightCircus", "support_website_url": null, "website_url": "https://onenightcircus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1673256473935796"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1329761122607657"}]}, "baseline_offer": {"id": "1329761122607657"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787483520, "status": "PUBLISHED", "id": "1329761122607657"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1676107623650681", "version": "1.0.4"}, "id": "1014432604277692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
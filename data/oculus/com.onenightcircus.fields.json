6karA2vuMTu7srG4hJtozUZzYafz3Fl0WnC12sUvugAp1wNQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGR-R869EtK7KCGmnR8iYqMmDHJOSMmyLVgUIMfscqvQ&oe=6ACA76C1"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPJPfXwrjmEQ7kNvwEiRfCU&_nc_oc=Adpc0nq_pRLUw6AL42bHP0W6OdsXVtfGP_toYy3VCH8NwY5A_FZ4eHh8u5r1l5Hz4aw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjvK6owJa48Y68MxG3qQX0qMixG9gngXqfWlI7HxvP7Q&oe=6ACA629D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC7fxxr6H3AQ7kNvwHWNEWf&_nc_oc=AdpkLmTxWVmdDVoHdDpUgtBNzTPsf0I6n6JDOQ2i6T_BgGNj5xgQZ7tiXWQCEAco36M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME7Z569K7BClK2PExIa5h6dQZbzl0f50JByZLGQAMCbg&oe=6ACA647F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH62mZF71ggQ7kNvwHMesFr&_nc_oc=AdpQV2Nh4k3Bt27aoM55hD9M-vnkgamJnF3bIkVsF-g3GRmB1VekGR0s9-3Kg5OcF-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJJddwDWhh5sxy4_LOBgQopaP3Z_qPl8QKImrvcJOURw&oe=6ACA58EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAfmdhfHH8Q7kNvwGJSJII&_nc_oc=AdpS9_-XI5R3rMsaW_Y1AXmvygwAHR_VaZHvRZytTrZUqG7sd1UAO7dtS_W5SNC4xWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE-Zs2wt4Z3-bgdVC8E7lnbECeV22r8DeidVJAU0Bh1g&oe=6ACA51DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gKiKP3tFUMQ7kNvwERBGuf&_nc_oc=AdrcCy3lWY6tZKIMVrtWdzDs4Gczab2f_tPE89pxKrmANDLpDtZO00s6L1Z6EH7Bhow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_jS_kVe-SQZvvUMrtr-RjfoTNKc3jNXwMkEDImMGpAQ&oe=6ACA5B7A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55bdkoJmM
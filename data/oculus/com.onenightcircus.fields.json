9", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCjux92ul1EQ7kNvwEV3ZIl&_nc_oc=AdolT2CK0KOJBMUwBAI4Nu37KDT-zc8CUK_f1ALmLjVa2c1ATKucyyxdkBxki1CV1vg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcEVu9hK6nwo7I4kwNYOX4Wj2LydzDNB5YIuU44m9ppg&oe=6A9AC8DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB3UTHzhvNgQ7kNvwEDWxxt&_nc_oc=AdphcUk2KlHXdGSXTnFHoFuLAPWk0g1tcCFLMEuLMkAHR3aeQJAmJbLK_e9ZdzwZMR0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhKr_H3fpgKELuxiBPB1dqAZvGJwTg_DRKrhAb72mqTA&oe=6A9AC881"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXMIWGoYxcQ7kNvwE47gOf&_nc_oc=AdrWTeAsvQ4UgFN_VuBzoc1oUumLZFUoVK1J-clPp69GH1zbQCBkaiybHGNUypCc9VU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM8XLeArB6oEoTp_ygpNS7FoJsq0UaXm8Eg6ZntimvFQ&oe=6A9AEC9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5YGr4kNf9YQ7kNvwEAXrdr&_nc_oc=Adp9WRWUyy3uw3oTEp6i_-Xr48a2gjqzYYOEMERYN-Zz96rgPOASpYjEijSuIisUiYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiVPe8UPLNUveXGrVuIpW7NmzFZ1DgWUjAJglfJWBy_A&oe=6A9AEE7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIwCNa3CfvIQ7kNvwFqoZN8&_nc_oc=Adrr9ImH680DKlL2-qvumgLRYl2kpTuyIbX1J7i6IGAZEvKI5Zm3oDP7Qr0S96rDoKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVhaT1owLiLTUNHOzL9wilNoy9_wXLCSkraL8y-Dmtcg&oe=6A9AE2EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNcbArm2jccQ7kNvwF2g7X6&_nc_oc=Adpf_2t9MOGW8tjF6_jU6-QGAgldCT3OaQgh2ZWXnCujrhGkg8ttbqqpylh7h7hiAzE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyVys_-3ry3MzhJVBUed8WwL37yYPO5L7APVnLd6qfwA&oe=6A9ADBDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
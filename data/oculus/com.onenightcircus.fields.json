l4ujPRqjlUynmSELXyNwn3KexMCxOGGgeeZKMPTohdGw-nopE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYS-P931TNRTZxQ5tbNHyYyutumW5v0JtY55oN3fERqQ&oe=6AF89B41"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KADxt48z558Q7kNvwHZzBmD&_nc_oc=AdoHuzMzuRI31xbuj9Y7_xKAn37xqnRRdG18GKdZCZyF662whHQ9Vbf2aA1SfaQxsOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXxrxF2PTLUgayAYzAnNXdFip48dWOCMfWDCboo-YqNQ&oe=6AF8871D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFXvrQeevP4Q7kNvwFSogJf&_nc_oc=AdpPadZj73dx8rkcNZcV5c2F1faoKDYicgo4NQG9NNp2wNnRIxAWhQ2mnovTFCTlyn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkImXUBkgPh71BQGDu_S5G6DqAXCzkbizpfM4vqjxldw&oe=6AF888FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iPNQPDjlp0Q7kNvwH0XcZE&_nc_oc=Adq3Sra9u2WXSqtSnKd1qUfb0lN1QzfeDtEmnOxDa5LWMZ1yUidvxHmYFn8i4pqyd0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Nf0Oz8nE3wwojuFngMxZWFW6sRXTL2bXtbvXMTJsgg&oe=6AF87D6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt5npz_Lwq4Q7kNvwH3nRkT&_nc_oc=AdqXKmjTMS5lW-8A0Hl8XF_D3lb57qKUgIcWN77lJRJHrJycFwPVoTa7053Dm26hdJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9XMJ1RdLvd8mr1nfZwF_LLc-XgJPEXFqLU-mOx5adkQ&oe=6AF8AE9F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFvL0L0lUekQ7kNvwGQKGcz&_nc_oc=AdpjRgV92gJvyP1FPqhnd0LBGjPEQXWgJmbqPCXMr5Y0rEGg2tL2OBmT6qlMTmpnQT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCYk3VIIhGit-Lrf0xH2ynWrBLBN7eFroWTZ01sf0y9w&oe=6AF87FFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI93TVtPH
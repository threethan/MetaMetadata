9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3gSXbrPvUIQ7kNvwFD0N_a&_nc_oc=Adpvn2gfG3IvEaYfqJa5DIZalUhUdL-UL1lmvkB71_ocKipCo_mMNW3EUcbpZu8EDRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOERh0vjyRcktXfHC6D5xEw3Io4ehwVk7AALVNBu27e3Q&oe=6ABFB2DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6P4RbCNaLkQ7kNvwHF99Qv&_nc_oc=Adq80GD5pcAuXfRCVTIugIsaTQc6yjmQ6wrScaLvNmgAjd6B7w7ECLimrzTsRET6YjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc-AQwT7j12iIv6DKS6VErqTTSHky4R0Z2iCQ2BxzrkA&oe=6ABFB281"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZmZ8BKrh68Q7kNvwEGiXrH&_nc_oc=Adp5h0QH_NXCO_wJFZzGRD2nq7J6KWdAKmGfyDcOSRdYbqqThtxESFbgapLpLAVIR8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbl0-V845h8lAsbSVOmR1DocqcclhNZiszjJXHC_iKQQ&oe=6ABFD69D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiTTGf5O54UQ7kNvwEmKb2p&_nc_oc=AdoIkLLQPY91axwSa4IKh1TqNImbNZEKJuOY2CECO7wH-G0H1d_o3BygUuIjfSSF3xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYp2ppqi-FL5AMQmIahpqwCkZlYY6Tj1eg6eAEPeB5GA&oe=6ABFD87F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv10SD4rgk0Q7kNvwHw00XR&_nc_oc=AdqbX1Fx01Jiy5DBVBChyzR0HoaZqUuzcYafggwcToDpNJPya2Pb3pf0Xv_eefQRfvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQYKjcgUvX5DfQgsZKzchVXx1LPFWK6EjX4nXOPP9evg&oe=6ABFCCEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPiZT9uqiB4Q7kNvwGAwwzO&_nc_oc=AdqUiALdIKveMo1jYKRG6Pq4eCepSVVDgKyq1LlopP4B2lBqXNNHCdfuSOySWBDUvxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5gCKnCGnF1OV54p1rW_lU7n8FKa0-AD0lFlUsWQdOdw&oe=6ABFC5DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
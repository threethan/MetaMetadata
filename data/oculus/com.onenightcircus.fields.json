Rs2AJW8sPu4KVSHz9GjvP8h0tvRzdbOeNZN1T5VMjPJN90Ojs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEjxFzKGgSgOTlD6iSCxoIzPUtuV9HtFgnwk_Vu808lA&oe=6ADCB381"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xBUFHmdDScQ7kNvwGs321l&_nc_oc=AdrcAMbHprUQdlLoAb8kKR_iniLiScgcIYbTX0ptoTeSfiPXzMiExtBD3IAitQLPPgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyIpI3Y-ESLM_9QXtf5N3HFxCDvRKzSgkVoWf_io1Unw&oe=6ADCD79D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2sRA37QJx4Q7kNvwHrtrQv&_nc_oc=AdoFID4qkcm4nQugsTGIlyo_VI_3sX1NM5iEergvC4vfDjsecNxZAQOTEs1JjBID7hU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU2qfU25K_30oSSWJq9w9YYcPfnmdjqgLhvb_w5FXQYA&oe=6ADCD97F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjvoW-EsX5UQ7kNvwH-q-TD&_nc_oc=Adrp_JxEC7BMZBj7ucqJ2jPzJJnh3xJgilX_c9wD-qPxvswkSCMQehYPdSVuyliKPp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqKP48ILPIIWIJG2JzsrRtUmMKaX7ak6sUxc9GIsartg&oe=6ADCCDEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtxZY7vRe_4Q7kNvwG7ANbx&_nc_oc=AdqIPvKmOEHXy6F8EBkxDoRfh1ocJ_HPC8h2VDjVTX8Kqoz7pKtAlz9CFJ2UV1bGlQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUphehNLMBzB9wrDuvk0sXAVPJNISyjb-AP7NIMPUnMA&oe=6ADCC6DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qofetN9mPZAQ7kNvwFJ9Hoi&_nc_oc=AdpZAD3JuAodu0eyktBLVWDH8jCmI52zrUYnFWBMEMMeW_ISxeBcMFG2HJmOyrcj2MQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLQ6pDn_lk2J1XMBc68_QgSOTOkwydyam7U_rxRFOcyQ&oe=6ADCD07A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nc1sEMlg
dXb1cB6MOSBPOIEEi2N9INQ9otEW0p9ReUpY-oVIYtXX-FDs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcjYtuzCEdTKXQxLG8UygUMfEYLFilPmLmxBoGo-1xJA&oe=6AE1F981"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unAygIMDtoYQ7kNvwHYF3zD&_nc_oc=Adp9dfXhy6AcWZNVbg6W8uESW4demlK8nXGAF-EVidx7N_ngj6jYE3br9spkXx5rwJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMivIvnc3XOywxppHN2g5KE_xwHm_n3102WycrmxRjfVA&oe=6AE1E55D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LUTIt8vxYMQ7kNvwGu-RFo&_nc_oc=AdryYt0nWp-ccfvsDNQN1YcjeY5aso0B4qMG29CXneYQJw0LVtQ7jS0G3OPRtBBo7wA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODs5D7j8NqK88NlUoqFjyZoLA9ALD2UPXvB_b8lXayTg&oe=6AE1E73F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_pOZxUlOZ8Q7kNvwExwwFY&_nc_oc=AdpBmVjCChLcuHi-uqY7d1K6-_a7nCBLqi8HMSm7AdzC1k_QHU19RgZQFe8167xw16Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxI1BdnllxzkJ2H2t3caVwvYiQlhJGJXSWKC5if2unkQ&oe=6AE213EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjp_V9q2DuoQ7kNvwECG-y9&_nc_oc=AdqNE_dUVXLMu_ZuHGZM0Xa45gesSCh5csp9ACofzuvNnHS8Ln_rbGDsSTV6bubmpCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_lOieZ3iFpJzn1HEPAFf3j26EJECAMrtQ14FUDwrfQA&oe=6AE20CDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6odEq_vSFHoQ7kNvwEP_61U&_nc_oc=AdqYbkqqCKtxkVUygaog6YmTob0fLSs3mjkGdbjE0n5bMNpjCNIO4Atwaoqz7O7Jo6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ3pwjrKyJVlZdpwtJuKUst8j-pYni--yHNreWAaKp7A&oe=6AE2167A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFAgy3JSU
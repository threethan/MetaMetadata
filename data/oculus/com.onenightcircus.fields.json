7d_hc72wgHparR2yqJEJQCp0ezsFlsCbVAkeua0qE0quQVBvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuYxN2GqDOMfQo0PN-5zUkAnb2hipZu1qMZV4Ntdwj9w&oe=6AA7F781"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdPHl2XznAYQ7kNvwFZRw03&_nc_oc=AdqDH1VKk5lwsglpFzgrDzeI0KKBcT-dysOLOcR4o1MGTJQGL7XxfUYim8rGXpiULfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITkYfFRzFJxicsv99JR32e31b1eeTDHLl5MbIkWx3wXg&oe=6AA81B9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5EJYsJZJ3sQ7kNvwF8NR0t&_nc_oc=Ado6O636vyKmbAX277Q5_Z6Jt-jtgXv0ghgINVRLpdVToCAmokgazD3OK5mKuY-_NMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYn-iOhE1KhiTvs6xlWoGkGcJVSNMYf8lDZ-MWk4leKQ&oe=6AA7E53F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jsCVmm4MRMQ7kNvwFzpT_N&_nc_oc=AdqaSh7mDd65MQ7cjqpGPt5yDoOQkivzWz46eMJvBA3SjkJKQbmo62c8egxscQoQ1_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5my9hM6QOxFJwlYkqcYv7jPXt785H6F3INnFb_HUYtA&oe=6AA811EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr5xK1-i4VMQ7kNvwETRBFi&_nc_oc=AdqwkNBnuhRsCKiK-O7CeZdTRCVkyqizOkWqVxradB7NPjLNenfJm4uKbn67bGJZnH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBAGdWFshnSI1lDhDxlYjpwbepGrSXtML5WL96MHHG9A&oe=6AA80ADF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP7qS26xVysQ7kNvwENJjbm&_nc_oc=AdoDrHkgAui2dQ7RymVDOjbtm9bY_KJ85iUzWJEhyO2OojfrMTqe7MIJnvIzSwFoRFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1MnrIs9-ZssVxvEDffMLy_Fsop5RZAAv0THIpnKQy9A&oe=6AA8147A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yUtn8oI1
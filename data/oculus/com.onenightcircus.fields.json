9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5YZ1T6ILQYQ7kNvwGiaDGZ&_nc_oc=Adp7d7nw8zcvbIqNakMCfkNbRWGAR_RRJvELKHUZcQvUIxi0YAXcvxcYZ2fAUkrH7Ug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Bxm7bBs32L8y6Gc5JIJTxWKuuk0q5x1xWxqcgbKxYA&oe=6ADF56DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoZBbnN05YcQ7kNvwHO_LEd&_nc_oc=Adrj_TTRNS1_WvMr1IufWcbL7ldFaSESen4cN2uxvyJOn3xCrJXd6XGAG3VeM44Zyp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqQSlaRlZOwwwSAtzYl1IJnGBTfcV71wGBLEkELqo5Ng&oe=6ADF5681"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unAygIMDtoYQ7kNvwHLhdNq&_nc_oc=Adpxi7tltgMBEGD9LUfaLdtakmyA3DNVe2eZE_iCmCxsLzcAVvDoaPDpFvDekLL9ZGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN3Cz9-tP9Mr-QVqUNCgQTZNdJLTUAFLh7FUd3YceugA&oe=6ADF7A9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A74gNnPPlH4Q7kNvwG_lvK6&_nc_oc=AdpsSbN1ibs2Mi0YxKOHVKrmsxWjoJQmIcGi27bgUzGDIrbi4E1iDnmcHW-wy8tJ_88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrDbKZddoQYtaFTdrtlnUzn94qPSOP8xiHivwvGXQRrg&oe=6ADF443F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J3ivsh7lzAQ7kNvwFRMs9y&_nc_oc=AdpPKK-uxXiLLkc4saxUa1FPLqLwrSrvqzknzXWV0YmHXU7kGj0lo3vnwGwzb6uo_L4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMws7mdPZiooMOBH2-1VG40iiAuWHtwHfDbvnBzfVM9Vg&oe=6ADF70EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtxZY7vRe_4Q7kNvwFy6hOx&_nc_oc=Adox-N0j1cewP9bKDT7GiUrEQ9k2ako8kAWIq6ysoCq-dVY8S3Bn9mQLo_kjAZutZGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJoQWtP-0LtXXR2g8meX_2raMIbV8jnlxCgwX6VbhjcA&oe=6ADF69DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
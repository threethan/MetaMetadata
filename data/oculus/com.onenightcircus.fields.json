EmDEsutcQxZzeFcwkBGBvZUhVT_ZC9uSHqoBfB495Y0ek6-YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlcbOE0sAQ4Jn_KkArkz3dneDQErp4NWqzvfHLCC4k-w&oe=6AE5EE01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euxsUvBi1TAQ7kNvwGzf_cT&_nc_oc=AdqpuHTf6LTYXqBPZM5TLmOayjjPcNVKXpInfZQC9MLB1PITyRk7aArP7LaYZR6zGSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Z3pmIKg1nz-g1jdh2mlx8WWx6TqIn_L790vk5yAvZw&oe=6AE6121D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTuiV4vzdP4Q7kNvwE-_AB6&_nc_oc=Adouhlx899dzUTCV1zecoZ4oZ_A28ItspHkv_XQHR6ehmPTnN-24o6_KPlvUWJtYUVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMybk3ZSdL5wmQ7WSVZ7U_fECXSHL88kJvBQh9wwTpuQ&oe=6AE613FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpZOQivYDV0Q7kNvwFl7ab1&_nc_oc=AdqGccnAmtU0nP5yIqJ31KEBzhJpONOrIXzuG5q7ksdFMUR7gLrMRuwul75NiMOiXhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzcwfTaP3nzCKtZDuPvt7jF_nLUPPuZzm0JrrrsKMEmQ&oe=6AE6086E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc6a56tOwwoQ7kNvwH6grxV&_nc_oc=Adpu_vtFAM9qoYIUmO_hq4H5r_u2p7C7g62m_E2BC39YIHl-wnnKbubnv7rvElD5y1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJhZWvri41k_QPHOcWysv8TOloWytSHiqD4VwpdS-cVA&oe=6AE6015F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtPmJPhDPFYQ7kNvwGpCNoD&_nc_oc=AdpUvF3FmyEQzPTxyxkuud_wouTrHc0bpVBPamaqFoHTcj3PcI0SYFtZS3MSV9SZu0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-Z6b-j6e1GnHIOch9zxrt5mfoFzmyj8myl168kVcr4g&oe=6AE60AFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU3Od6EDp
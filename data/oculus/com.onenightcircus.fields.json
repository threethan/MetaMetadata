9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p56oe9hlJAkQ7kNvwGgBfJl&_nc_oc=AdolIgP-lZzs5_VQWuoABuSojpAlOP5HQ14ri3e1ceQCvAuh6syfJVINYN8equyY8eI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNWE32KWBnnTHOAVTXZQdQNvmHNlkY6eN3iV32x1pdYA&oe=6AE9E2DB"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeTTKD_d3JQQ7kNvwFiXEPZ&_nc_oc=AdrHK8sR_pPLGbGbx-ANTdltX4_VGxj-_20AFXTbBPeO48-HwZFq8kkdXNljqI3NjsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAJ5XChHD_Efn_dHMurG2UOFsqqArAktcdTLeiMN3SOQ&oe=6AE9E281"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GZR8ew7wOIQ7kNvwHkwuew&_nc_oc=AdqaWTma2V6uUngyOztDoKVIN-aKLC1-knGUMfWNd7hecUNPRjG0z6aKLaD4zIpyIMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrsaxAPSJAi_lkhoRb660lSHijomDJ0ZQ4vB9C76fpTw&oe=6AEA069D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auDQOG4fV8oQ7kNvwH_PfKd&_nc_oc=AdoBYufIwDHeVQZsCEUGR6qQsf4Ecmq5t_4mIHZ3tkAVZYkij4iEXC9932iozIbfDrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7pz5kJFMB-Rj3k11gBFyMryXc3PvWkbzphRJX-Sdv8A&oe=6AEA087F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gZkUvJ83D4Q7kNvwEDoRWb&_nc_oc=Ado2XC_Av5RfOL7jeca0MUvxt6wuEIF1-7qVZw7AOOyk4f70lHPyvVt8NPJBodgdlhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn5jGjK9g8ZItredwB7W46OfT4WLFOyiQRphoSQcpHyA&oe=6AE9FCEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb72s7jzSWgQ7kNvwHVjNqR&_nc_oc=AdoUKJn0U3GHeHZasROj9LWPgRo_-F7TYootqTVXLFYzmF4-Q1hlatKW34HSiDsGAB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFkAxMrul98DOl5wqttNVtVej5jdyXB6mpB4vrZdjhew&oe=6AE9F5DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
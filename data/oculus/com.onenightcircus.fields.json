jTnBdGICgSV5SoSDiYJ22pDUYMSmX57pr66PIIyTocUx6E6QQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOZO6zBMlv3toiuBE6rYrl8k5F6CoXnHSXUjNsOXlobg&oe=6AF5C001"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8C2Ab1psYAQ7kNvwGMLB3V&_nc_oc=AdoMiFQ0FrZ6-oF0jnD4wl6k0jw0wJR-QEQapfDhq_sALCZr7rfmXPvdmWQD7be4V7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw2z-hL2SWDKPPfpN0PdFIk5SoyHZPgWUyPCfwS5uEgA&oe=6AF5E41D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFXvrQeevP4Q7kNvwGtdHTd&_nc_oc=AdovUOtpE41W7pxkm6aWG-JO5RajTCAcf7qV1k50nsPMbhAKuiHqgzAwPygn8LdpzHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQerU6R_3H_hks0js-nKLc8N2klilPu5KwUktMTF5AdkA&oe=6AF5E5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iPNQPDjlp0Q7kNvwGlzU4Q&_nc_oc=AdrofkttjWQBAFVP08OHBAzDP6EjaANWzw58CVNVqakabyLgAa79AafmiVFHsCStJuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR78GeMpvPkkRiatjUBEP8a6_QZ-83L0UniCCcs3pykvA&oe=6AF5DA6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qY48QFC26YQ7kNvwHPCDDS&_nc_oc=Adr8l754Ky11ooSQwFN98fygP3NdguvxJAU4vIknsfgxIjBfjexrS8_d1jOlLNVA9GI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNzFSC5zlF9bkpVS3ktP-HS3zZGCup7srDxO7uDxc1bA&oe=6AF5D35F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GxTB7Z7r2oQ7kNvwGbGHsp&_nc_oc=AdrKrNiy3_VgiZv4WqFG_jeD6u-xA4YrruUtEtWwywdrIX7gURQlMuKrlbEeihETlig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHF1jiZwnkeNney1usr7nW4iX9D9tctnwrz-fO3mu1Gg&oe=6AF5DCFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzmV1NRlq
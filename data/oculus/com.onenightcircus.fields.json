9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXpTKLkMXnEQ7kNvwFyro9Y&_nc_oc=AdoiKWiynFQebTip6IYqSLPcfee23vpodgLDEhHhZgIqv9CQX3xv4xp9HvmbyjLTxNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh3bemsplqHlfoWGGXk8O1uT4SlPVrV4haCasK4iJZmQ&oe=6ACB905B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEv-xp8yXGUQ7kNvwHvOHG2&_nc_oc=Adqvlzkb6KikKdeNTGQWIey4Itqv7QtgccFJNoWtmeHUMv5zOgplxSv8sSEQfU5hdog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo1GGDTd00Ctoj9vx1Z_1as-yDzRgq7fh_-khh5MwhAA&oe=6ACB9001"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbV-Ln1CZ90Q7kNvwF1bIGX&_nc_oc=AdoUW4ccumpRE61iyF5MtQ9B-ZTJxUCf8Sz2q7qsaw-FjNE2WHe9-2258-doz6V2c_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFqBK1EOBMgWnYIhCrDH17BFp8fQPQSxgQuOzxBzfTvw&oe=6ACBB41D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aC7fxxr6H3AQ7kNvwECMwOi&_nc_oc=AdrSbc4ExfgV9RR7HKy0myEmVBjY9ta5LRnbi8Rktk7THKbFzMXO8es_8V8MEVHoE0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK6vwCqpPx7D_x-B-sHixdQEsFaRKMJoW2ylwMo6HBJA&oe=6ACBB5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH62mZF71ggQ7kNvwHu8mEI&_nc_oc=AdpAcaKV_Rm-EkMk3ZXzSOVjzRPN0hjPprmqb4mtadrB3aZ_Hw1nqKzK9L3rDJy6D7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU_r78y8ZhWb34RE3weT7WR3fVfR26zbOKtvmo3OPNUQ&oe=6ACBAA6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAfmdhfHH8Q7kNvwGs9brd&_nc_oc=AdosQf_pNGScp2tPPXrfPoqu68zfXlHw48cvNo1BkTN7eQKlRx5BBY0CMtQi8Wc-VXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxUaup9MnMbQwk86Gj_QvC_JOcSbO5IHjkl2MM2iL5Jg&oe=6ACBA35F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
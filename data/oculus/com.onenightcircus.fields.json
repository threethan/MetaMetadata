60HYMEWR4hqGEv6RTpUKB_G6OLI0uMyxYAr_crzdrQtFJmp0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKGTt2umRA9Cd9rPiEIH-okbOCo9QpSPimwh3g5P-YMg&oe=6AC3A701"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=282yrlMBThsQ7kNvwGH1Fhu&_nc_oc=Adrn1jczyz3wCzW5fghpvFYhFPEBIo0oBAIHb9FUCWynbJJ7SHjelESOpedG7tWMc5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORUeTesWKFK-OZnk2omhe7DH45T2-i5ZS3uKfUngcOOA&oe=6AC3CB1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__hXqU-OG0YQ7kNvwEg9CTf&_nc_oc=AdqH9hdz7AcBwbp79FZdHNoKqsCDgXOqQQ6S_kjetgLMVZTm3vNTkmSbHrIjiaNqYmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6L1CHFsyFxV2N56JEbndH5dewtFSyVcmOCwrcgcWiqA&oe=6AC3CCFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7KzAmgEcwQ7kNvwFLv2L7&_nc_oc=AdoVgepkR0JjAkdIsq_OM3HMT81fT3ghgbu9Hqxgsvli2_ELl2in1_TR9rD9eiIIbOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0k5zK83JvQpGkeALfpPmSgAs30pjtfPtpZpd3-dUnww&oe=6AC3C16E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N3MFqmQVy8Q7kNvwFKfGZb&_nc_oc=Adq2D8A6wK4wkldW2CoiSYVUXU2LdWF73sdlrMHor13uzNfIR5pSqCpTgHeEbkcHEPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDTyTNzgihw2i96b1XG6xsUfmCq46G450loYmJv90ATg&oe=6AC3BA5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obYv_Ww2UOwQ7kNvwGM6PLh&_nc_oc=AdpMvnHxhicU2U3Z991WinDPf-ncwYJSYgD_1FEuMzbiIocDt01fU2Vom9BL6hKK8GU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoqK21MnQnTQtjfUK1fTvAtSe_yF8ktQzcYf-KBWeftw&oe=6AC3C3FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFtl7uleX
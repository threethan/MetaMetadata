BK_urc9cYWqQdSQFnfysrd69VmofRw60t2a_MoyngInrITtkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINj0QWrq8JYMhfa6Cd_n8fQ-ucgTkXIz5oRDsqdNLEEw&oe=6AB13201"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F38cH_2BicsQ7kNvwFYK5gp&_nc_oc=AdorMnqgSZgW85bfg1ZzUs2slGtd_3qTEVjOnX2I0QqDYGNvXdauNm0TWEXVyFBCpoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC5gmCa7caUdtRQKqlblr_RuP6VNaDtkob56czhZyNjQ&oe=6AB1561D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFDIIo0vOhoQ7kNvwHV-F9t&_nc_oc=AdrFfjQI-9HK8-O2s4pv700cZX3L50Mfnka_hQLzUWqpRbtgyfzkoi7bkhJhAnG2GbQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8-Qzkcm4i4tfgrMtXAGT1C-48oVddXXlFssYVtKlMig&oe=6AB157FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxmQkSL4CZgQ7kNvwG6qbvU&_nc_oc=AdoEzZP30wBnT-SccckuptsdRvLwMgbUXsNQ11CzEH6kPfhQ_87ei8UNmMZyvAW3V-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu9ECD8d6-q5c5xWu76DqJd8ZajTchKk6qTm6A6jjyZA&oe=6AB14C6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5qKb0pappMQ7kNvwHsh2KJ&_nc_oc=Adqjd0ySyS0PlARbUvo6hBCkOfIu_0BIaHAiI5sIkTucq3J6FxbWAe8lGXlFO2Ls7Bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzpZczTVIAukyoSPS-xlYxexKKSNEFHKKsg-MnnrxT6Q&oe=6AB1455F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bf2yjqTOJEQ7kNvwGMMUvV&_nc_oc=Adp1-jMtLmZRnPi2K-ypZ88UuVSQZlsutK7VfksbU1K-busCUdDGFxUVZm0Y1m45fpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUPoSgb9u0tIuF-4B0swdk33-Oz55uMmJkxwuvao3sTw&oe=6AB14EFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UNBIpeAy
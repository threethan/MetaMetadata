8HSqzzamzIpAanxT74OVreDuFzp41zEP3g5mIcnuO0mtOmWWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiZfUJsKg3PmltVc3O2p_XWDaCwokuOBE-GAKy_YVD0A&oe=6AABEC01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA8vh3-DikEQ7kNvwHPONoS&_nc_oc=AdoqWiuYJGTz_u6oq-DoMOFB9H_Ced-KKTuRXOmJ9gDZdPyAb_Psv4dtsxNinsHAYCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-GN73X5TSNT3tgWQl7lAClpU5tTwKbuXqIeQhiyt9uA&oe=6AAC101D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NHLsohK3iYQ7kNvwGht4d3&_nc_oc=Adrc03LV1NUKG_jrd9Co5vRkYlQTMOsZu5L6Xn46QTV1_YTyQ4EK58athbPi9XKaHYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJybi-YlSVm3b2_wFklN_YV9naeNxLgXbk2qo-oKCE8KA&oe=6AAC11FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z7NoPtx_bgQ7kNvwE17HXo&_nc_oc=AdoPzfu8CjBfZR8oNsIN3WFnmIO8tvVlH1dzsOURhVYwjjM3BjKi91swjKq_syIFAbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3rfDxWBQI_6g-5nTIl9BMGUCaU24E5RkdqDH7VkF6DQ&oe=6AAC066E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ty9LgTzqWwQ7kNvwHhx9aY&_nc_oc=AdqpRhei8EPGtJjrKdO3Q3R0nOf-MJuSapE4BebkP1AijZlr5QLK6EtKLF2aULf75eY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9mW_7lE5nlLiZaxn_skDceErA4p8Lvtbmns3_Yk56Ew&oe=6AABFF5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB4FAirXR6UQ7kNvwHy9QKs&_nc_oc=Adqlr31KHyTeDWIXnQL3twPR5xPh_8J52Ni0wFD2aB7Njx8YtmuePGM-H3zlkKICBFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4opWWdVRBsnMKezdw245eKqs9wNa7fjqbxHtn-Rj4tQ&oe=6AAC08FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCfAFb_Ak
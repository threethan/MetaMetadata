-gxB44I5OtzruDXm0j-JTtid__vw9sEC-sEsKS1OnhY7VvmME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNQRf4JfMTVgodBu0AlpKTlm33GJsW9ZUcenugC-soJw&oe=6AB52681"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXiVrAdCh6AQ7kNvwFOFE3M&_nc_oc=AdouDcJpmE335vg27YyAkIDmZ3t5oq9r9stbSvPwaqLebCR_7DQf9WVXL5dYfHd5-nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwdjsU6ED0yrlfWFUQc5ugnM_mkVrxxFKbIGDMEqruUg&oe=6AB54A9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwtaOPmGeAsQ7kNvwHCkrnM&_nc_oc=AdoTCLW8lfeW9diFvQgg-8O-U-U1X05DU5IycGZqMag_laKPkzykLwj48NV0UifoOk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjEJOhgKLfD8HQY-QTN-dj4Kxqgeew1doGdrif7rl3BA&oe=6AB54C7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN0O7QozrEAQ7kNvwEIVbkT&_nc_oc=AdpchfInBLjgiZy1AKn4nDn074eKq35cRs4TpCMDA3j98p9Dg-sWPV-smUG4en88b5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLju_S7StOU1lwEO0PirWE05CRGVEuYSTKfVqKWoPn_rw&oe=6AB540EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ-dFVEW4qUQ7kNvwFVC6gs&_nc_oc=AdqYXFmnYypHifSAMo1avX1RHfguT8E4iU2udd4U738KmFn5mj2XYqIXn0aKToV7TZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi93j0q6SpDBmkahwN4hD7p7tkH2Yh7eJTR3Vol5u-Sg&oe=6AB539DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwS2seEV8B8Q7kNvwH6tInW&_nc_oc=AdqfvuF5zS-jTj9pkWPbbqU713KieFBIUmonuFWRURZNX8_fQzY-rFlQf3vqNRyN4ME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHNnn13XoUPjTDf4hsn1DEd5CcEKLgDErP7hvQJMWo9A&oe=6AB5437A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLuzOu2y-
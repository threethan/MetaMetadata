9", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2334058800454382_6810420958056556067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCjux92ul1EQ7kNvwEOr7_T&_nc_oc=AdoWtdZxMRF4iywlvoqC9pvrgnen6DlgkubcQ7hQVbapoRW45azu9uPVrGmYoTW9-NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYYM9ZR6mVLB9oQ_35vTDEPzgjADdRYZrt4iV561m7RA&oe=6A99775B"}, {"file_name": "com.onenightcircus.fields-20251218-203353.png", "id": "1290753326156435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1290753329489768_4332884711738293422_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB3UTHzhvNgQ7kNvwHIF6L5&_nc_oc=Adqpfe4aIrm5trbWI4fIw1pWjeLMANXez7ggzW_Jyne5N0f_mGylfAvwuD-V9ihGn6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-OPFKBTlQEct8ov6fUowU1lvbL531J5lfb2c8buvuew&oe=6A997701"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXMIWGoYxcQ7kNvwEvFh98&_nc_oc=Ado221qgixgYRDGknPsWejewGAm7tgM2i5bJkIv3-IW9oYNl6PRDVrjNLGfNqyPBvwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI__BGjhbGgrEmmlbYQSFX1rO9KLL8fQYhIVmq1s9Bbrg&oe=6A999B1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSyV5jfLE7UQ7kNvwG3siL1&_nc_oc=AdrozlaUSXUe67OVatoA1rATC3HNv2SCh9LRSEp8EAedRVzwmTBkImPV7RGeybEg_bs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSMG4N2P74dxQLuT8rbBLsho8McNRJ4tqgf_QEaR3vIQ&oe=6A999CFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWZYwQVX87gQ7kNvwEgQzZW&_nc_oc=AdohdXwCeE-VHa42fE67sf81_ZecGEDkarlafI3lW1jeK4NYJr_z4eT3U-6k58CDRYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg5ESmnR5NckDVWNgG-PkmkD1p9o44Mm-eb4dKrZvHDw&oe=6A99916E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNcbArm2jccQ7kNvwHXS04k&_nc_oc=AdqdZgCkctslqROp5ql_azSk8WMLdK_tL0rSRY4XPOVkWvpYtL5u0L35QFSs4SSuymI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5KyRbi-1KqAbOmjsetQarKo3U7cdZwUbOLLzATQBXeg&oe=6A998A5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_L
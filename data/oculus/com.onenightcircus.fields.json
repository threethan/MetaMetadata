Eajn5-li_bkKG9d5HLvfYl3Qu3gJXIZN3vybxeXzlZRJnnu0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSEofIbqLtQzXvUsG4hT4NVL4SFbVsq_xPrFIxpU_UlQ&oe=6AC25581"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZmZ8BKrh68Q7kNvwGkwYQ8&_nc_oc=AdpDVZM5z1rWKryVFOtSXRcxNet0FplnQJxgHnQLKmTm11cYP8NhlzAy_zPL81JKfR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOja3k_uYF4I2aCntfDKErSMisNWinqm4QP3r30rrYn9A&oe=6AC2799D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__hXqU-OG0YQ7kNvwEzF4a7&_nc_oc=Ado15XtJ73HUYaxdHKbqMT0ckrSUCZKgEsUFPDXA2XGZ1G2vhrti_cVsqXW1Xxc9H1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM93R5Z99GVqqS2p-SKNAn6WC8lzWjkwxzwJPg7cdg2Tg&oe=6AC27B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7KzAmgEcwQ7kNvwHe9WWO&_nc_oc=AdqesSaDAlzeCLk_C_OVui9BrMUtl_wO4qOMUis2gmluwLEKcUhYl0r3Sl6PV39_Pko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAtRlk6HoYP_K6keSeUvE4fDMrFAGPXaBZQy7sqX-S_A&oe=6AC26FEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N3MFqmQVy8Q7kNvwFPR3qj&_nc_oc=Adrhu5OPiEBLuk-V2M6JYZPHgaWN34aEA4rd8U8wvnVxo_0v-W20TMykbH9-5mrVnoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPey8YlglIzK5YzqAiY9HHsyUiCFcyOKgfQv6kvU3et_A&oe=6AC268DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obYv_Ww2UOwQ7kNvwFYyKM1&_nc_oc=AdpA5tEfeRURZt_AQ3fSrHP0SW1_2VEp6uZ2P7WWdsKtRqkg_GgdrxAZwN-SZ2XEay8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKwJed1PnC3_VjMGy_tZ2dh8GDf1Q_CGl5USZvFJ_Z6w&oe=6AC2727A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFtl7uleX
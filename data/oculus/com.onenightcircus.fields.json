1d0_z8xXA5SklnyMR-tyd3EdB5GvMwK86_UKrAQzOIhEWcuk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzZ5fe-ifVD39rUTydGr0LrB2UjCbX3hOm3JCLjc3a_g&oe=6ACF8481"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRpj-8DbT4cQ7kNvwEfyf0C&_nc_oc=Ado6oZ2OrQME-NY1YpY6MTiRRlT0f4efQ8T4X0tkBd9ibdeAchTfOPdxbqLGB0SOtC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ7Z-JzBrNjkSGgB7a1tI4SqC1TgEjm7az9V5biT0x4g&oe=6ACFA89D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMQXd31RpkQ7kNvwFFRyek&_nc_oc=AdrV6gVqrl9iyY3NxDoZ-NodzLF1FD6RyTVfdn0ktRTfpCR5nay36-aKi0tticMncXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4-3v-G1Us3ntfX3oMgTt-iGge0wwK9EVkoU_LxaG9mQ&oe=6ACFAA7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn905xW0QE8Q7kNvwFY5Dpi&_nc_oc=AdqO8JpDDD6cihHoq0eOgxommum5vYpwLKixlsUA3sK3BIRTwtiPgL99zsBPqwlkWqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-S8E-2JpEOSOBm-sPBFfF5v_hK3GgQk5YyZeGRZLDWQ&oe=6ACF9EEE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4H74-eBAltYQ7kNvwEhrGbE&_nc_oc=AdqUEqdQ049_QjYCHL-4VSwoyTRCVQiwN11u7qkToe9Cozv6ZKFFAQlBUugfNAKtASA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrQYQ4d6Zc6Ip5qtqyA8s2otRTqRl06I5iqqB2obhLIA&oe=6ACF97DF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnt5miF6QGcQ7kNvwFEtWNZ&_nc_oc=Adpa-HWWWnhYmoGBg3_ZKEOrRHi7Wt0wlvozCLS3pS2MM3Q8fHxFOj-79AjEflokaro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD85j4ejFn73G-xBK46nq1hdXYkHbpHg_A6ZuHGOidLA&oe=6ACFA17A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYFCJwR4h
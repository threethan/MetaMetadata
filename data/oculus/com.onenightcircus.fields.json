VUBt9eq-yhCwSD8N159B_fkSGkfaeUE08qxE-KiOTj2LA1rm0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqsgs4ljAKfh0tulWqwsEpMqOTAn54VcBzxuchSb3_BA&oe=6A943101"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo7agYlV01UQ7kNvwH93XTR&_nc_oc=AdoOpTNtehx-2_5gdoAZdNuPipjs6PBZjhwrSA4ahsoczpsytR2sCvy4M02TIH94woM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVALdu-p87hBmzjm1SuuUBURdBYU8uNgh00Bn6YBtfBQ&oe=6A941CDD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4gMNS5eaN4Q7kNvwGWKSV5&_nc_oc=AdqNyT5roFxAIS4zBkjPeeT6oEq0-ZcIBtifjFREbJe29nyCAQO4Yzi9Gjz3KxPTf30&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQEkpeJyJro4JFysZEGS7ZRSPTEakO-zxT30FMhg-IOw&oe=6A941EBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyz1kPQRmWYQ7kNvwG4z4rh&_nc_oc=Adr7giaPTMHF5W7zzxodDBGZSjxdReY4megsjkFYX343iw17vN6YY3EZv9uhsOCPNLo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMqxmVvh-NbdvINmIWsB4tQ-zeCZf9KLAYO2w7FTo_lw&oe=6A94132E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZGcKx-B4ZAQ7kNvwEGc8nT&_nc_oc=AdpbuwPuyG0KzGpOQv8bpJ7Vs0JLqVHZG5M9nsjqlUIYfaMP4su4uZchltz2zxZLISs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6m5Figvk4Ta9ZUN0IDEjVWs7JmgXfFkRaFc4yzSwnog&oe=6A940C1F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBiuf5uWPuYQ7kNvwH9XKCY&_nc_oc=AdoaMjnyPvgqegYfQ2BT9A627mOapMe1wf-eIRiPbizsWm4Y8j_qsRFdsR0Nn0jemMc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyTC7ZU1-52DGeDz1PKH4Mv2LrMHJIgVM7RN60bBJfdA&oe=6A9415BA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-du-Z2bki
Ig2LUs0y02Ewg6MSD_Qm4aLUOpnO3nFyZljzmYsxoyWeWNdp0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPnAvHiLdGH9oNdMvZOs0Wa4Jswbhtkejn5Ed1BO2HfA&oe=6AA16001"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM5HkneOXacQ7kNvwE9o_nz&_nc_oc=Adri5mfwzUxxqty6W85wvrWydjX206L1KRJXngsmtGh5i4Y6SdB1Ue8bLN7D6vDPHY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO7MsFeJ0afd_uaYNOtK2ed9aLyeEdYytZlob_0HzeTA&oe=6AA14BDD"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTEf7qg4Dw4Q7kNvwGNLEYh&_nc_oc=AdpQFlqcFl8aVFvGdeXLUzHAEcJ1wyGiIl8v554ee6NiWF2a-Vz6zdL_v0pq2I6QJFY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXuPGoWbrD9cbfW9T_7Fh8p_mUWlzpEoa9tBU8s-tTKg&oe=6AA14DBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjKEU2gVvdUQ7kNvwEcOAD2&_nc_oc=AdrNwGWqFXTfEP4QVyYfWxhCp6iUXh4qpWbyyxo5uiezhafzHS3TPiMSydcXl6sPi04&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRcC219BjwRycZVxEocw8Vu_dHvwGM6CiSm3xyK8VbUQ&oe=6AA17A6E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUDETMro9sQ7kNvwERJoHW&_nc_oc=AdrVCEPpF2U_C7_FKhsi9b5KT7lywmz6uV9dfYgK4EVsQ31YiNDLogRu6Ag3nLwj-4Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyF6FcHANr_1kU-QhyQZtA0rqSTjj1tqG-Mb_EXnhyZQ&oe=6AA1735F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb40G0yoc2cQ7kNvwHoFN_9&_nc_oc=AdrPEUpv6hNRE5qVjABm0MViJRB6D-IibzoEnqUSn-vG0HEHsBSqW51sjAMDiMRB_Rs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwV0hEsInj4zCzVhb238_VlRHL18QQLhzQJxzaDKj3Vw&oe=6AA17CFA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws4u-1Xad
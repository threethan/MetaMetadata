I3yqAUO4Rp3l5xbT9t-Q6BPJMM1ZnmznLtwnbIIesxuwdqrgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSULSh-Ji19KB19XysDDyUe24_WM5M3p333Nb2uNQA4Q&oe=6AE0A801"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unAygIMDtoYQ7kNvwFKCRLR&_nc_oc=AdrnKNANsrqvYtGIh4e-39MpFGzM0cJdEIgS3wuEqzNm5pjhCRlPWXTD9uoXQcyFjTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNbVZ7aKvK2BQ6UcmRodKpOq0_14olhEN-hA5my6zs3w&oe=6AE0CC1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A74gNnPPlH4Q7kNvwFpaByx&_nc_oc=Adr443dbPHAFxa4jAXvwaTHkYjU1Uh4UyhEeJ0GQtlyqRtFMRkyU2mE8qO0xXR2IrfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWWlkMPyid9-FLaS1w7fp01eOZNBLlhLj1Nhbmp-ppqw&oe=6AE0CDFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J3ivsh7lzAQ7kNvwE4xuRn&_nc_oc=AdoDV7t-7vN9ZRBaIK3ngobtu-Pxs94wBGsFl9RfwwhLUKcS4oezVSU5m7YjO-QiKeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAvoXE7gv9RaL0oZ10P96GSVshoT58JwILGBmzjtx_4g&oe=6AE0C26E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjp_V9q2DuoQ7kNvwH7udTF&_nc_oc=AdqyNDotRUCvB79eoXyq41LaE9y5dcsMYutDhdbUKVZhhPPX0MGvBV8jWEd-2pPQ720&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-qfLnueuMDO2V6Q8s4Wb5GF-H0hG5O_2-uZ_5G-BygA&oe=6AE0BB5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6odEq_vSFHoQ7kNvwE2iXiB&_nc_oc=Ado7ApqALleZMYgKaDFuKebRO5nZv-1iJuEiE7LxiePHAWZwGpA0bMuWYIt1jr6AWDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHWUaKiwJoph_QEl_t4tG-n4jnNdtw2Vw9ccUkAQH5cA&oe=6AE0C4FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFAgy3JSU
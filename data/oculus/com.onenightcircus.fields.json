idgkQs9GAk_DAETifMq5TZFqCWxwHASECuhK7kWPoMdwkSeiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZkIgnxF5QkkjfYwtIsw9rOzPqcMszzTnsmOb_W15jXw&oe=6AEDD701"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDbjiXQs3AQ7kNvwGgTDth&_nc_oc=AdoU1oVpPf4Wc8uGfKSh2P7vBWKHkaNYwbkUgDTDemlD2fMl66hs66iDC2Kfl1tW3xY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhPAdodd_ESsKYtPFI9Iq2_FVF35Pe1Xdk7mTDJuUA6A&oe=6AEDFB1D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sY-fqsprVLMQ7kNvwG7dICw&_nc_oc=AdqWnd-oWo3Alriv7D-Ly-S7ZHHvfDt0zPSb4nJLhxIkpY0GZ9sFixGYW66mzSg5zF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzYV_mqBSL_P4iFyW-bojC1z2z8qgGCIwUOf6tiA-8og&oe=6AEDFCFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db-vvxxTxEIQ7kNvwGTzyTk&_nc_oc=AdpmkVe66B9I7zJTEqdgyFv3ER8ZaIytnkJNiGjuJUvNLoRCVZMQHHHZJJP3mkOxbNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY-2ij-a43WmOHvXotT6hOAvNrxcnm3Qz7U7gVf9R0Ig&oe=6AEDF16E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sElwarpmw-AQ7kNvwHFwB_M&_nc_oc=AdrQj9qxsFvdkpm6r4k7IUxKxkIpB8quLnwbksYtBZsv5_CTvrbHDuHgKuNOx4SiTkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCeVAOeW0wxmGBUHd2VH6ascIROEz7pE_682pXACF60g&oe=6AEDEA5F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5G5Fzo6RT8Q7kNvwHo0xPx&_nc_oc=Adof59NN9yaqJumLYCfTV-RJacmFcXX8ukL5Z2gAxvWVpxGTwWNIfOHsC6wA3g82JXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPVEWmRERDcDg1mSfrWtaOFzsELM5lLli1DpG0N8-A1Q&oe=6AEDF3FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZheayiTZ
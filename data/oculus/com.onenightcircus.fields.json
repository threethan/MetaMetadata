a-pVr-hdnj5N1kEBRtGaimdKko81sQUNGFM1Hh5sdH_v8HXes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ1sWJBEBjR-aemc-ICkwUZNgThA7NB0Re5qStvbOqAQ&oe=6A9EBD01"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fLskmeg8WcQ7kNvwF3mkiu&_nc_oc=AdrFH81CTfXfjluMdkiR5r8tPL4Vqd7_98iIu4CA0-kaPG9Wjc7WPm9LCsf8l6PBZrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtikQegIu7jXC2yEejjJmPOSPJkNCx0NNz1rp4OPBl3Q&oe=6A9EE11D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTEf7qg4Dw4Q7kNvwFxVB2f&_nc_oc=AdqxMk8-EkQ8hlOAdWhAgvimlCq0fvFdCrkmNKeCX8WFCrLxfmA-fNvtQd7G_Pxw4gM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrFEI6wfqs0NNshkoubtYEp5ve3GqD-bn8SoAWK9HDfw&oe=6A9EAABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjKEU2gVvdUQ7kNvwGf3GmU&_nc_oc=AdpW2RbY19Zic_PwoKuwtYJZpCPU8tflmFaeh8AKFruKVucQlrOyvHdeH8DnTDFh7SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFfOEP1_b2owKA1_WDVgM3K3jbSKSFoSWYEbEBysNrHw&oe=6A9ED76E"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXm_txG69tQQ7kNvwFdxGSO&_nc_oc=AdoIEV4TBVyWZhqPKRs-k_jLYJ5Gyc71Wr1uHQvS0vc0RMD8oeppa5lCr4m2VK_OHN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9C8ZRfRQQ-qoIQkoO1tes-Cnx48ZowoDRxW4iy3aPrg&oe=6A9ED05F"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTSj5JSLjpcQ7kNvwESU1ZN&_nc_oc=AdrBlfpobo86pMx5nx0Fuyt7mBqwOOb2VWjr93he2eBIFmdf6HWTxL_U7TSGFbF11XM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEAgMTPcNZrxhANkbuNoBYHCOoDoi5CCnsGqi8Zn_g7g&oe=6A9ED9FA"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVHXnQl5-
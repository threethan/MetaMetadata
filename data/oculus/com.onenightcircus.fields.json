gRsJjgRP3KtbQEEP7we3LMNdJo_D6be-a4JCnWTGE2gTocvhs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm3dR8iu3JxwVrYV-d_EXDG09S6arPUqyCGdeIMFQ2Vw&oe=6AC79B81"}, {"file_name": "com.onenightcircus.fields-20251218-203201.png", "id": "1926405484733596", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312338_1926405491400262_5342535590335345652_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPJPfXwrjmEQ7kNvwGk8i5i&_nc_oc=AdpeIqD77Zu1nB9TAjor33wEvHRVvKk8aldAt1_0IRYbVMdJTnhduRrdjbjg6xVHFCY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwZ4UJwGZGFjUBdw7BKGOu4oOra1vYMXARFkBt6BhJGA&oe=6AC7BF9D"}, {"file_name": "com.onenightcircus.fields-20251218-203301.png", "id": "974613512240519", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312470_974613515573852_1573452143751525995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igcGGeGaJEEQ7kNvwGKqW0F&_nc_oc=AdpQMx-6zu91FpYDeJ81MV_RQ17vB7JGXqCtuzzmLw-xchz5j_GtOGfdbX33V0Es1lY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7w3eXVdrDZbxwrmFPV6Zma9JXSNayr604BqZxSQPLQw&oe=6AC7C17F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fields-artwork-v2-2560x1440.png", "id": "1690141432030718", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1690141435364051_2132099073325899983_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf3H-67V9McQ7kNvwG4cYKh&_nc_oc=AdoGb-PNhOpYMvHGwwWNUILeO089ldYdGgCsQ5S7XlrJ7puXMYK46LQQLg_e66eZzF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ94Fsl-URe_SnzTVQIL7cg4mYSSnMahbvXIXhPEn2uQ&oe=6AC7B5EE"}, "display_name": "Fields", "keywords": ["music", "inmersive", "art", "visuals", "meditation"], "long_description": "Fields is not an album you listen to. It is a place you enter.\n\nAn immersive VR experience built around the music of electronic producer Die Stadt, Fields dissolves the boundary between sound and space. Each track becomes an environment: shifting fields of light, generative textures, and slow chromatic movements that respond to the music in real time.\n\nFields is designed for deep listening \u2014 a rare kind of attention that VR makes possible. No narrative, no objectives. Only presence.\nWhat you will find inside:\n\n- A full-length electronic music album experienced as a living, breathing space.\n- Generative visuals that evolve with the music.\n- Designed for extended, contemplative sessions.\n- Optimized for Meta Quest 3.\n\nFields is an album. Fields is a place. Now you can enter both.\n\nStep in.\n{1548057873348580}", "short_description": "Step inside the music of electronic/ambient producer Die Stadt. Sound becomes space. Space becomes music."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "2273186383217800", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307451_2273186386551133_8686410893456982869_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=midMBxGlWm4Q7kNvwEMcQlj&_nc_oc=AdrNcpWISXgxgKI0cq7s5o8N4mq-XEmuoBSlmlb_lXlPMNHvdYpLFWg7v_KYQIB8bwQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWo-gc0jwDQ1zfRJUGwmNX_oeLFnQY8eFaqILdVVPEsA&oe=6AC7AEDF"}, {"file_name": "fields_logotipo_512x512.png", "id": "2080711572861858", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593863731_2080711576195191_4572827690534310494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgft-kq8PIsQ7kNvwFRTMup&_nc_oc=AdrrC5OWkLSjpTzWZwL5yPsTfh6It17LkWVUVYvmpqS9P0tYu9CmMJElvuJGTP8-hS0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxbjtytHV9ArE9CY02pyEh2HNmGsnya_I4iNq-NFwpYA&oe=6AC7B87A"}, {"file_name": "fields-artwork-v2-1280x320.png", "id": "1672909630612985", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1672909633946318_1348928573997257328_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgf_v9uJJ
-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy8-AWFN6m1lfqZQHGE8FtKwMJ03ZHjoK_xomSJzRURQ&oe=6A60BA01"}, {"file_name": "screenshot_2024-06-26_12-10-23.png", "id": "1183497392963538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031362_1183497396296871_8237326188475703296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fC465K920kQ7kNvwFHAqhN&_nc_oc=AdrE8gqgVy_pOTUX44JlRAIv19M8PEc0Aht5Wexb1QCO6PyuASVOf_mi6Kl5MpSZDpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8sMT0FsRaBUdLVKgO6JP5Df7fMnitu4g9qEnTr3sInw&oe=6A60B3FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-19 at 13.51.47.png", "id": "1006852774172099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974819_1006852780838765_2625722960874046849_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xta_5Q-m2iEQ7kNvwGX7RLg&_nc_oc=AdpPssVxGZQR4p3u7y_JLpmLuqU2ry3nyokL2f6ZPXa5SlITDUPXBbaHhNWp8Bphgjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7Q8dnHR5-qLrXP0O_1uZCW6KkFLTeAWG03qBqG3Paiw&oe=6A60A478"}, "display_name": "Energy Encyclopedia VR", "keywords": [], "long_description": "The Virtual Reality extension of EnergyEncyclopedia.com showcases detailed, technically accurate 3D models of energy facilities. In this virtual exposition, you can explore over 20 animated, cross-sectioned, and scaled-down models. Additionally, you can visit 8 life-size power plant sites in person. The exhibits cover five stages: Nuclear Fission Energy, Nuclear Fusion Energy, Solar Power, Hydro Power, and Wind Energy.\n\nYou will learn the operating principles of various types of power plants, including their major components and how they function.\n\nThis app is designed for anyone interested in the different methods of electric energy production.\n\nIt is permitted to touch the displayed exhibits! \ud83d\ude0a\n \n.\n\n.\n\n.\n \n# Available scaled down models list:\n**Nuclear fission energy**\n- PWR nuclear power plant + Nuclear reactor, Steam generator, Steam turbine, Electric generator\n- BWR nuclear power plant + Nuclear reactor, Steam turbine, Electric generator\n- Small modular reactor nuclear power plant\n\n**Nuclear fusion energy:**\n- ITER Tokamak\n- Stellarator\n\n**Hydropower energy:**\n- Pumped storage hydropower plant\n- Hydropower house\n- Kaplan turbine\n- Francis turbine\n- Banki-Mitchell turbine\n \n \n**Solar energy:**\n- Parabolic trough solar power plant\n- Central tower solar power plant\n- Photovoltaic power plant\n\n**Wind energy:**\n- Wind power plant\n\n.\n\n.\n\n# Available life-size powerplant scenes:\n\n- PWR / BWR reactor hall\n- PWR / BWR turbine hall\n- SMR reactor building\n- ITER tokamak reactor building\n- Hydropower house\n- Parabolic trough power plant\n", "short_description": "Discover the amazing world of energetic sources through immersive virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://public.simopt.cz/privacy-policy/energy-encyclopedia-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Simopt, s.r.o.", "support_website_url": null, "website_url": "https://www.energyencyclopedia.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26441100988838078"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "830437843021842"}, {"status": "PUBLISHED", 
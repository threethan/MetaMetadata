{"data": {"node": {"__typename": "Application", "id": "1424834927382871", "organization": {"id": "1335741886292176", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1424834927382871"}]}, "id": "1825365081835498"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1424834927382871", "release_date": 1794245040, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1424923014040729"}, "id": "1162353752896193"}]}}, "binary": null, "live_binary": null, "created_date": 1794253369, "id": "1430441383488892", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1424834934049537"}, "release_status": "RELEASED", "id": "1424834927382871"}, "id": "1424834934049537", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_1965756131475976_4250488601579697004_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuuAbvIiBt4Q7kNvwGKEEI4&_nc_oc=Adr9oN1a46oAESBC3g-oSL95XnlMvMbwZVcZx9j8OZ4lSi8psXX9M8mPOUsgVwCmxF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS50cnfoVBznkdNZ4Bcafx0PPCqAhsHBbMJn9hPyo_1Dw&oe=6AFC9201"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Amona Player for Plex", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1794245040, "lastRevision": {"nodes": [{"id": "1424834947382869", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1424834927382871", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2244481286126289"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2150111512277195", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Amona Player for Plex", "keywords": ["films", "plex", "player", "amona"], "long_description": "Amona Player transforme votre Meta Quest 3, 3S, 2 ou Pro en salle de cin\u00e9ma priv\u00e9e pour votre propre biblioth\u00e8que Plex. \nConnectez votre compte Plex avec un code, choisissez une salle, et lancez vos films et s\u00e9ries sur un \u00e9cran g\u00e9ant. \n\u2022 Des salles immersives : cin\u00e9ma Art D\u00e9co, home cin\u00e9ma, train de nuit, suite sous-marine, ou votre pi\u00e8ce en passthrough. \n\u2022 La 3D en relief : les films 3D c\u00f4te \u00e0 c\u00f4te sont reconnus et affich\u00e9s en relief. \n\u2022 Le son d'origine : DTS et TrueHD d\u00e9cod\u00e9s directement sur le casque. \n\u2022 Hors ligne : t\u00e9l\u00e9chargez vos films pour les regarder sans connexion (Plex Pass et accord du propri\u00e9taire du serveur requis). \n\u2022 Vos r\u00e9glages retenus : pistes audio et sous-titres m\u00e9moris\u00e9s, bouton pour passer l'intro et le g\u00e9n\u00e9rique. \n\u2022 Tous vos serveurs, de l'un \u00e0 l'autre d'un geste. \u2022 La lumi\u00e8re \u00e0 votre go\u00fbt : tamisez la salle, ou votre vraie pi\u00e8ce en passthrough. \n\u2022 Interface en fran\u00e7ais et en anglais. N\u00e9cessite un compte Plex et un Plex Media Server avec vos propres m\u00e9dias, connexions s\u00e9curis\u00e9es activ\u00e9es (r\u00e9glage par d\u00e9faut de Plex). Amona Player n'est ni affili\u00e9 \u00e0, ni approuv\u00e9 ou sponsoris\u00e9 par Plex, Inc. Les films des captures sont des films libres sous licence Creative Commons : Charge, Sprite Fright ((CC) Blender Foundation | studio.blender.org, CC BY 4.0) ; Sintel (\u00a9 Blender Foundation | www.sintel.org, CC BY 3.0) ; Big Buck Bunny ((c) 2008 Blender Foundation / www.bigbuckbunny.org, CC BY 3.0) ; Sol Levante, Meridian (Netflix, opencontent.netflix.com, CC BY 4.0).", "short_description": "Regardez vos films et s\u00e9ries Plex dans un cin\u00e9ma virtuel. Amona Player transforme votre Meta Quest en salle priv\u00e9e : connectez votre compte Plex, choisissez une salle et profitez de votre biblioth\u00e8que sur un \u00e9cran g\u00e9ant, avec le son tel qu'il a \u00e9t\u00e9 mix\u00e9."}, {"images": {"nodes": [{"file_name": "tile_background_180.png", "id": "28766744816359149", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_28766744863025811_5742571811465177221_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOR9sZYKWwYQ7kNvwHauOW9&_nc_oc=AdoI-LanLztgLlMrveJMeE3dEv1eQBsxxJzX7wuOo71QMdBZXvR5Cn4lKql-GE8kBSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiPXJc9crft_oXTOXkzrHlXCDc47hd29qpG7YBOISS0Q&oe=6AFC6FEE"}, {"file_name": "hero_cover.png", "id": "4527742047439129", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_4527742050772462_3500498995387410571_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQvU2p7SSakQ7kNvwEiYF8t&_nc_oc=Adq0R9tACQvc8gDynVEKeQE_uZ3MibAqHaxsHBIOrXF9l0FHT3rnzjq_CNrFZzJPA6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsru6KGUmIIgIPLyj-RXaIPblB8aPsm-MrC00-mNIW8Q&oe=6AFC80BF"}, {"file_name": "cover_landscape.png", "id": "2281786192604228", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25
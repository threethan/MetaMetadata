ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_796571266710790_870231169391310543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iSYbQ5CmCcQ7kNvwFMAjOl&_nc_oc=Adm5TjdT-Okl8lcbV0JinjTM7U2mikYaVMmDz78W8ldFstg0tebFcI21vjJgP4fMuUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIg1lzKxgdVaVjTqqe1k-M-fKblC5i0WLXjvMG7SnDFg&oe=6999BFFA"}]}, "id": "2111070679710218", "locale": "en_US", "screenshots": [{"file_name": "Screenshot61.png", "id": "1178196920466224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1178196923799557_5607646713299094492_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iChXTMHe9MQ7kNvwF_JT10&_nc_oc=Adm6RZABnIaGdz5Y5qa-d90v4Lsh_ERUwc_mywEvawvIWqC5cTYL4P85XO6391dy1ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0iSAI0cs1DzKoRTXN6SfizGEknpRqJ_eWMmNj_O5cvg&oe=6999A210"}, {"file_name": "Screenshot1.png", "id": "1503872184241421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1503872187574754_4635399092623275289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LboA7UFIyqUQ7kNvwGJdATi&_nc_oc=Adnqh5ulQIc0XmN3IPxEU7T2Jhp-mb-Eo_o7GuQe2fxYVnA0FYImMiO4baRc_qN8-mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4drbQ0giRR1nFFoLB_2PRsuEnkd9k4vM7td7ottSGdA&oe=6999B2B6"}, {"file_name": "Screenshot5.png", "id": "830673213083471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830602_830673216416804_5880523732334856674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxru78cS-_sQ7kNvwGHBFVY&_nc_oc=AdlQhNFsEA5h9WScnXwP-BgcuTnZ5TZb1Eb6y8sLtn-5w_lAPili8ttMyZwjszt3jJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKcCSCb5dZ0FAcFQII_UACWpyYeR5DjwXAY4biP6hREA&oe=6999BFB8"}, {"file_name": "Screenshot31.png", "id": "854088763653927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822968_854088766987260_7311536990818701100_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOvahVJgdCsQ7kNvwHLUWEo&_nc_oc=AdmJmwqG6-OpndLu7keCCgdLhcjugQFyCRXT37lSDZpr9U1ziTDLh-gEvm0xxjyJKRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEfgB5sRNVisFf65zzKTyzA9ncgfIChgEYz3PgXQDFRQ&oe=69999B06"}, {"file_name": "Screenshot4.png", "id": "1422048186295561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307352_1422048189628894_7701150010470987684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nm6W6Owo9sQ7kNvwHQH5yJ&_nc_oc=AdnciKk0utLvA9QOYahBYRfGCy7ZG5SKkdr6PV4pvD1wz9j-EynFNycYwZqtlHspHK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuPGAMkXm1aUD5S0ALuKra_u-Yr4snlBEbQOh8TbYzLg&oe=69999AE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Glide", "keywords": ["glide", "battle", "paraglide", "pvp", "archery"], "long_description": "# Ready\n# Set \n# **GLIDE!**\n\n# Wild Glide is a PvP fighting game with a twist - YOU CAN FLY!\n- Flap your \"wrist wings\" to build speed and maneuver in the air.\n- \"It's like gorilla tag movement but through the air!\" - some kid, probably.\n- Deploy your glider for smoother, faster, hands free flying.\n- Shoot your friends with a slingshot.  Hit them with a big hammer.  Snipe them with a bow. Feels good doesn't it?\n\n# Discover New Animals \n- Tons of playable animals can be found through the Wild Isles and rescued and unlocked.\n- Each animal has a different size and unique stats.\n\n# Customize Your Loadout\n- Discover new weapons, unlock new gliders, and create your perfect build.\n\n# Enter the Arena\n- Feeling confident?  Enter the battle arena when you're ready for action packed team death match style rounds.\n\n# Hangout\n- When you need a break, you can explore the Wild Isles and simply pop balloons to earn XP, look for new weapons, rescue animals and hangout.", "short_description": "Ever wanted to fly?  Ever wanted to shoot your friends with a bow and arrow?  Well it's your lucky day, now you can do both at the same time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/wildglide/polic
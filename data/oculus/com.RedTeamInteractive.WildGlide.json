7kNvwEkRyDo&_nc_oc=AdkxXcw1bQiL3LQLUOOvGDMTwpWkZaqpxwjH0KWmzdr0-pgN-2CtG7TGxgQUB7rChZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuvHn2pum0yqewzr7TOEeGSpD61lm07ooE85cR8cOT0A&oe=69BFD686"}, {"file_name": "Screenshot4.png", "id": "1422048186295561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307352_1422048189628894_7701150010470987684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_VuFBPEvi0Q7kNvwFGfvKL&_nc_oc=AdkllP7ywNGjboP_GeDgI1yS5vPS4mMNFbITXnRciHR5UUbUfckEU6iACWvsHym0PHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuSNldwusEom3E3a-ZOEH0wn7iCVlrYGGMQJXX7a0m4Q&oe=69BFD663"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Glide", "keywords": ["glide", "battle", "paraglide", "pvp", "archery"], "long_description": "# Ready\n# Set \n# **GLIDE!**\n\n# Wild Glide is a PvP fighting game with a twist - YOU CAN FLY!\n- Flap your \"wrist wings\" to build speed and maneuver in the air.\n- \"It's like gorilla tag movement but through the air!\" - some kid, probably.\n- Deploy your glider for smoother, faster, hands free flying.\n- Shoot your friends with a slingshot.  Hit them with a big hammer.  Snipe them with a bow. Feels good doesn't it?\n\n# Discover New Animals \n- Tons of playable animals can be found through the Wild Isles and rescued and unlocked.\n- Each animal has a different size and unique stats.\n\n# Customize Your Loadout\n- Discover new weapons, unlock new gliders, and create your perfect build.\n\n# Enter the Arena\n- Feeling confident?  Enter the battle arena when you're ready for action packed team death match style rounds.\n\n# Hangout\n- When you need a break, you can explore the Wild Isles and simply pop balloons to earn XP, look for new weapons, rescue animals and hangout.", "short_description": "Ever wanted to fly?  Ever wanted to shoot your friends with a bow and arrow?  Well it's your lucky day, now you can do both at the same time."}]}, "developer_name": n
ttps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_854088766987260_7311536990818701100_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq8O04L-f5YQ7kNvwFiKLjy&_nc_oc=Adq-5clbi1VMJVNb54mJgvgzG9w89UN23Y9JWAfLb0PH-MvtS-BR3IqSO-JhDdJsU1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNycQxEg7eBQbZOIcC_cQ8PRg0t34n1ch44KPyG4dbLw&oe=6A771706"}, {"file_name": "Screenshot4.png", "id": "1422048186295561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307352_1422048189628894_7701150010470987684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHYbUWVht_kQ7kNvwGqKUHE&_nc_oc=Adqs2cEjGxgZ2nlGKbfIIfz78z_5e9Kbf1JMw6X_gnRdZAy5H79KwY99V7_YH25wNws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSNc4QIG2FTJSil-PI6V41UJmvLcr5SkktGUSIOdFOWQ&oe=6A7716E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Glide", "keywords": ["glide", "battle", "paraglide", "pvp", "archery"], "long_description": "# Ready\n# Set \n# **GLIDE!**\n\n# Wild Glide is a PvP fighting game with a twist - YOU CAN FLY!\n- Flap your \"wrist wings\" to build speed and maneuver in the air.\n- \"It's like gorilla tag movement but through the air!\" - some kid, probably.\n- Deploy your glider for smoother, faster, hands free flying.\n- Shoot your friends with a slingshot.  Hit them with a big hammer.  Snipe them with a bow. Feels good doesn't it?\n\n# Discover New Animals \n- Tons of playable animals can be found through the Wild Isles and rescued and unlocked.\n- Each animal has a different size and unique stats.\n\n# Customize Your Loadout\n- Discover new weapons, unlock new gliders, and create your perfect build.\n\n# Enter the Arena\n- Feeling confident?  Enter the battle arena when you're ready for action packed team death match style rounds.\n\n# Hangout\n- When you need a break, you can explore the Wild Isles and simply pop balloons to earn XP, look for new weapons, rescue animals and hangout.", "short_description": "Ever wanted to fly?  Ever wanted to shoot your friends with a bow and arrow?  Well it's your lucky day, now you can do both at the same time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/wildglide/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24997400783292890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499301053_1111009917774526_8002264471584196303_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkQwk-ShLN4Q7kNvwHav7An&_nc_oc=AdpqLO3TKVlNA91ous7a6rZ0NYsXz-3sH3SISLwTNx9FPOxdCY9t8Ohekdzo59avMrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgmantL2-Do0pnZMs69U-eUKh2QDwbWlRMsXRSwn-Wog&oe=6A773DE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wild Glide", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_na
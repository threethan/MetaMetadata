2_830673216416804_5880523732334856674_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HimOEiXiTOkQ7kNvwHREmQ0&_nc_oc=AdrtJnDzdW1gCR7uYCkUa5WZ0XuUQficmlAtKWfkCNmSfNYl2WbwW5GYJKw6qExq76s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dPxqRt_XHjnKeAsU_LVTyW81yViUO3Va73UnrNb86Mw&oe=6A43D138"}, {"file_name": "Screenshot31.png", "id": "854088763653927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822968_854088766987260_7311536990818701100_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQfCnjeL-F0Q7kNvwFn5fk9&_nc_oc=Adq2q5nUquTxBX0EfrM3Hl2ppR9Xi_rkbtUmfKGkMV_7J9bJ6ITz80LVzBZhJmnYF3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ClgdBtETzdDgMlJanyw5xZhUHzprfvLau3QBk3RSzqw&oe=6A43E4C6"}, {"file_name": "Screenshot4.png", "id": "1422048186295561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_1422048189628894_7701150010470987684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhe-9TGriNAQ7kNvwH6WxFA&_nc_oc=AdqMBiW5fnFru5LxnxtZxt-8IshKjuRIL6laOt2m40Owjq7N9K5KqA6qdSIWFqcCYmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FanYivJaUIIUXZJmwM-Py_Zojoxq3ar7EwfiFHZa7XA&oe=6A43E4A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild Glide", "keywords": [], "long_description": "# Ready\n# Set \n# **GLIDE!**\n\n# Wild Glide is a PvP fighting game with a twist - YOU CAN FLY!\n- Flap your \"wrist wings\" to build speed and maneuver in the air.\n- \"It's like gorilla tag movement but through the air!\" - some kid, probably.\n- Deploy your glider for smoother, faster, hands free flying.\n- Shoot your friends with a slingshot.  Hit them with a big hammer.  Snipe them with a bow. Feels good doesn't it?\n\n# Discover New Animals \n- Tons of playable animals can be found through the Wild Isles and rescued and unlocked.\n- Each animal has a different size and unique stats.\n\n# Customize Your Loadout\n- Discover new weapons, unlock new gliders, and create your perfect build.\n\n# Enter the Arena\n- Feeling confident?  Enter the battle arena when you're ready for action packed team death match style rounds.\n\n# Hangout\n- When you need a break, you can explore the Wild Isles and simply pop balloons to earn XP, look for new weapons, rescue animals and hangout.\n\n", "short_description": "Ever wanted to fly?  Ever wanted to shoot your friends with a bow and arrow?  Well it's your lucky day, now you can do both at the same time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/wildglide/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24193637800335863"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1549248896490188"}]}, "baseline_offer": {"id": "1549248896490188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766434320, "status": "PUBLISHED", "id": "1549248896490188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25326555580377407", "version": "0.3.9"}, "id": "2244
34_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nlrYQdm7fAQ7kNvwEhoRgc&_nc_oc=AdoqIXjpBndi8H243l0FVgcdOisPQXlg_x3eUZuUI_-rtkBpIW43c2NlUiCA2b4lzho&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPmB5CNDer7se3UgaG4EsssdqtkLcS04bNTgEgJrIR8g&oe=6A942F55"}, {"file_name": "3.png", "id": "1606484604338128", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824307_1606484611004794_2972623648423526379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H2JPrv_0zgQ7kNvwFAJyGm&_nc_oc=AdqR5bAB5kOqEB6i688Q1mhQL2zDSKdXG4QrnzukYQdoAfhkQdpSrNdsJyrdXDZCq58&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOUXgqfOO7e2vUclDhYQF-pVOZL-kv3QnuXYP8vqPHBg&oe=6A941EB3"}, {"file_name": "4.png", "id": "1850555829259690", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825497_1850555832593023_8070433699766196685_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03_AZ6qH8RoQ7kNvwGZZ2o_&_nc_oc=AdoiU4fNbIJGLXG3SnrV124EbVngG1BKX_uv-2rS0w4IULTbyMcQCJXr47vXdXXgfeo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLu3fX3bqGyYclWGR77Y7n6oZ3GAUxygl6J5NCnQNcRQ&oe=6A943188"}, {"file_name": "5.png", "id": "1747553692928468", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499292712_1747553696261801_9162067564713142255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz8XxbsSEa8Q7kNvwEL_8bK&_nc_oc=Adryd1EELL2NbMu7D8L6LpFIO1z2bPe7mhEri1DBNCvvO5u_OFr9BX0hmDr0CkhIWEs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcG0CO96TgNi_v68p70dCVCIckum4Gb0x8OjJlFs76xw&oe=6A94145C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491825257_2288055671600787_1008209799779954131_n.png", "id": "1401881455230802", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620965_1401881458564135_859536993883796860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rIfIX2rd6UQ7kNvwEN6LPR&_nc_oc=AdpFcQSziS2PmvkODSyjFKJNsM7i5m8_TNZRuwLdht7mJ-VwAl5ej5ts37OjUExUCOU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzvy81ZQNqD0fWNBofv1bH7RNJEUYeKm6NjQy6wk0W2w&oe=6A9406B0"}, "display_name": "Horn", "keywords": ["fight", "multyplayer"], "long_description": "\n\"Step into the sacred arena of Buffalo Fury VR, where tribal tradition meets high-octane combat! \n\nIn this unique multiplayer VR experience, you stand atop a ceremonial podium, surrounded by dancing Native American spectators and the rhythmic beat of ancient drums. But you aren\u2019t just watching\u2014you\u2019re in control. \n\nUsing a specialized steering wheel interface, you command a powerful buffalo in the central battleground. Your mission is simple: use your buffalo\u2019s horns to strike your opponents and rack up points. But beware\u2014every hit you take reduces your score! \n\nDeveloped by Adrenaline Shot\n\nPushing the boundaries of Virtual Reality from the heart of Texas.\n\n\ud83c\udf81 EXCLUSIVE OFFER!\n\nWant a discount on your next VR adventure?\n\nSen us a message on Instagram or WhatsApp to claim your special discount code!\n\n\ud83d\udcf2 WhatsApp: +18323705952\n\n\n\n\n", "short_description": "\n\"Take the reins in Buffalo Fury VR! Command a massive buffalo using a steering wheel from your tribal podium. Outmaneuver rivals, deliver devastating horn strikes, and survive the 3-minute arena chaos to become the ultimate champion. Feel the beat of the drums and the power of the beast!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/horn.html", "developer_terms_of_service_url": null, "publisher_name": "adrenaline shot LLC", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
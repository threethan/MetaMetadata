QML2dh0HlB_3lgWuvJiezG1iUi1vBRdQpJUZ7otErzH5w&oe=6AC8FAF0"}, "display_name": "Horn", "keywords": ["fight", "multyplayer", "buffalo"], "long_description": "\"Step into the sacred arena of Buffalo Fury VR, where tribal tradition meets high-octane combat! \n\nIn this unique multiplayer VR experience, you stand atop a ceremonial podium, surrounded by dancing Native American spectators and the rhythmic beat of ancient drums. But you aren\u2019t just watching\u2014you\u2019re in control. \n\nUsing a specialized steering wheel interface, you command a powerful buffalo in the central battleground. Your mission is simple: use your buffalo\u2019s horns to strike your opponents and rack up points. But beware\u2014every hit you take reduces your score! \n\n\nZero Risk, Pure Action! Not sure if it's for you? Get a 15-minute free trial . If you love it, keep it; if not, you've lost nothing!\n\n{2275408999946117}\n\n\nDeveloped by Adrenaline Shot\n\nPushing the boundaries of Virtual Reality from the heart of Texas.\n\n\n\n\n\n\n", "short_description": "\n\"Take the reins in Buffalo Fury VR! Command a massive buffalo using a steering wheel from your tribal podium. Outmaneuver rivals, deliver devastating horn strikes, and survive the 3-minute arena chaos to become the ultimate champion. Feel the beat of the drums and the power of the beast!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/horn.html", "developer_terms_of_service_url": null, "publisher_name": "adrenaline shot LLC", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
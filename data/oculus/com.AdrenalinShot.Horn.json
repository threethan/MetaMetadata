 "1747553692928468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499292712_1747553696261801_9162067564713142255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXHvBKL1XtEQ7kNvwEo4juj&_nc_oc=AdqHlZxcxuGUFoye-MctfGQo_hT7HsSPWusAIiNknAXna_SNavaTG7H3T-CAVvEC-tc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOmQYW1eM17AbpPD0ubrKJW7hiVoPp1hVPH2Y1BBOEjA&oe=6ACCFD1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491825257_2288055671600787_1008209799779954131_n.png", "id": "1401881455230802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620965_1401881458564135_859536993883796860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7omu6xxGLMQ7kNvwEipaBw&_nc_oc=AdotUb4BTkisMTm0yJfxltxxGkfLH2u7IHiAYjQBWOgmLVsoaZkq1k-4rCZp8mkm7xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3bm-TvsRBzJKuC-8js-yK3_hEcMj4-J8x1N2kCJAeFw&oe=6ACCEF70"}, "display_name": "Horn", "keywords": ["fight", "multyplayer"], "long_description": "\n\"Step into the sacred arena of Buffalo Fury VR, where tribal tradition meets high-octane combat! \n\nIn this unique multiplayer VR experience, you stand atop a ceremonial podium, surrounded by dancing Native American spectators and the rhythmic beat of ancient drums. But you aren\u2019t just watching\u2014you\u2019re in control. \n\nUsing a specialized steering wheel interface, you command a powerful buffalo in the central battleground. Your mission is simple: use your buffalo\u2019s horns to strike your opponents and rack up points. But beware\u2014every hit you take reduces your score! \n\nDeveloped by Adrenaline Shot\n\nPushing the boundaries of Virtual Reality from the heart of Texas.\n\n\ud83c\udf81 EXCLUSIVE OFFER!\n\nWant a discount on your next VR adventure?\n\nSen us a message on Instagram or WhatsApp to claim your special discount code!\n\n\ud83d\udcf2 WhatsApp: +18323705952\n\n\n\n\n", "short_description": "\n\"Take the reins in Buffalo Fury VR! Command a massive buffalo using a steering wheel from your tribal podium. Outmaneuver rivals, deliver devastating horn strikes, and survive the 3-minute arena chaos to become the ultimate champion. Feel the beat of the drums and the power of the beast!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/horn.html", "developer_terms_of_service_url": null, "publisher_name": "adrenaline shot LLC", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1112512945283307"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2121967298446226"}, {"status": "PUBLISHED", "id": "1827244415354999"}, {"status": "PUBLISHED", "id": "1594415518950758"}, {"status": "PUBLISHED", "id": "1022326867513052"}, {"status": "PUBLISHED", "id": "899238129856609"}]}, "baseline_offer": {"id": "2121967298446226"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790510160, "status": "PUBLISHED", "id": "2121967298446226"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1236657776202156", "version": "0.5"}, "id": "983168830980215", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary"
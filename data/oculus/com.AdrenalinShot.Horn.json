34_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtGg3gLF_YYQ7kNvwFAP3rD&_nc_oc=Ado2OB3mGh7u7F8GRTEKHmjglEJLVRgsrsuHJRWVktmIBadMZj_IgtCqHwu0o-lBxIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeK-MFw21umDj4HcPZV7F6hbTTsVBF7-AQMhoE_YhCOw&oe=6A95B915"}, {"file_name": "3.png", "id": "1606484604338128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1606484611004794_2972623648423526379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H2JPrv_0zgQ7kNvwEvizD3&_nc_oc=AdokbC5OwSvvT_3aqL9mSav8CJ7qNzwawf5l-fMNCIIJWdMAEj2QBG25Mvc9Ox9aBAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHLlI_J4F9B0R5or4e59t5SS7-hnYYrgK0xAsVl_-gYg&oe=6A95E0B3"}, {"file_name": "4.png", "id": "1850555829259690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1850555832593023_8070433699766196685_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzVHgzWXEo8Q7kNvwHRcXYH&_nc_oc=Adqzzg8kGyx8NhV5TXFvSawkoBj0uuqv6JS3TPxZMzy_3KWR5F10wr23NEBl_rjLkdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXBAIf4a6jYIAeteaiXbi7bGfSPupHNXGP-1gH9qA3Sw&oe=6A95BB48"}, {"file_name": "5.png", "id": "1747553692928468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292712_1747553696261801_9162067564713142255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz8XxbsSEa8Q7kNvwFN-8C6&_nc_oc=Adq3UC7DcBSzrIsyh4GO7eBYj5aOGWs2UKgrek3VYGnX-23AtU1MP-lK2s40yIR4wM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuVWwnToH3RC5ZZ-3fBqplJID7HZak5tEjh0Vk9pzT9g&oe=6A95D65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491825257_2288055671600787_1008209799779954131_n.png", "id": "1401881455230802", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_1401881458564135_859536993883796860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rIfIX2rd6UQ7kNvwFeHpcI&_nc_oc=AdoPYIZJJBKGf-k8qpJ3AOY5xVfR2ZPlsc6_y32AHjjfFSLdXwaP7gse-lgJp28GqTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcyOX1jjAYiMHHffBvcM9cjBMPO9QSsUXibcbIGKkh5g&oe=6A95C8B0"}, "display_name": "Horn", "keywords": ["fight", "multyplayer"], "long_description": "\n\"Step into the sacred arena of Buffalo Fury VR, where tribal tradition meets high-octane combat! \n\nIn this unique multiplayer VR experience, you stand atop a ceremonial podium, surrounded by dancing Native American spectators and the rhythmic beat of ancient drums. But you aren\u2019t just watching\u2014you\u2019re in control. \n\nUsing a specialized steering wheel interface, you command a powerful buffalo in the central battleground. Your mission is simple: use your buffalo\u2019s horns to strike your opponents and rack up points. But beware\u2014every hit you take reduces your score! \n\nDeveloped by Adrenaline Shot\n\nPushing the boundaries of Virtual Reality from the heart of Texas.\n\n\ud83c\udf81 EXCLUSIVE OFFER!\n\nWant a discount on your next VR adventure?\n\nSen us a message on Instagram or WhatsApp to claim your special discount code!\n\n\ud83d\udcf2 WhatsApp: +18323705952\n\n\n\n\n", "short_description": "\n\"Take the reins in Buffalo Fury VR! Command a massive buffalo using a steering wheel from your tribal podium. Outmaneuver rivals, deliver devastating horn strikes, and survive the 3-minute arena chaos to become the ultimate champion. Feel the beat of the drums and the power of the beast!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/horn.html", "developer_terms_of_service_url": null, "publisher_name": "adrenaline shot LLC", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
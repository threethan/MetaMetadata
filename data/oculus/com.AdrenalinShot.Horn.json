24307_1606484611004794_2972623648423526379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNNDd6SiBRkQ7kNvwGduudH&_nc_oc=AdouKs_Qg7qXTbqSEHxP6reBTiR8gcztOCAq7AppRHeWHSjiAB4FpRoEI0pUr113frY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ1JPSJMQwp9IqwEsFA4KQjrfuRv5X80f6AAMwnBPpcg&oe=6A984B73"}, {"file_name": "4.png", "id": "1850555829259690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_1850555832593023_8070433699766196685_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzVHgzWXEo8Q7kNvwF-_8ZB&_nc_oc=AdpDAmQsECJI-nWAPH2X0LmTQbVpScCKIKj4D2mppkBsczm68l3eXVDQ37P8EmRGSdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYblpkwOVtvS71Ei-Hp5Mf1RUVVk1DJWjz5fg9_ee35A&oe=6A985E48"}, {"file_name": "5.png", "id": "1747553692928468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292712_1747553696261801_9162067564713142255_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT2ce3Kj4CoQ7kNvwF_X9ts&_nc_oc=AdoRzlfh0HRpZXEo9tYCAdYSKMhyDs7GP03-_nzrVdVzikGEkQ9GlW2c1Dyiseyivkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUnEks6viFUp6U7SE3uMNMwWlKKLhMvclBfl_iGBrHYA&oe=6A98411C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491825257_2288055671600787_1008209799779954131_n.png", "id": "1401881455230802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_1401881458564135_859536993883796860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HG8RDcuBUoQ7kNvwE-ub4w&_nc_oc=AdrwWHyP6WMNcjqdNs2_-pJT47XIKmR1DkkhQR7uHg39qcP4DTpPh7EZ_inHDkl-PY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGLant2h2BKT12qRuhpmITbhkk5XVy2W3nlx0TFCWPLw&oe=6A986BB0"}, "display_name": "Horn", "keywords": ["fight", "multyplayer"], "long_description": "\n\"Step into the sacred arena of Buffalo Fury VR, where tribal tradition meets high-octane combat! \n\nIn this unique multiplayer VR experience, you stand atop a ceremonial podium, surrounded by dancing Native American spectators and the rhythmic beat of ancient drums. But you aren\u2019t just watching\u2014you\u2019re in control. \n\nUsing a specialized steering wheel interface, you command a powerful buffalo in the central battleground. Your mission is simple: use your buffalo\u2019s horns to strike your opponents and rack up points. But beware\u2014every hit you take reduces your score! \n\nDeveloped by Adrenaline Shot\n\nPushing the boundaries of Virtual Reality from the heart of Texas.\n\n\ud83c\udf81 EXCLUSIVE OFFER!\n\nWant a discount on your next VR adventure?\n\nSen us a message on Instagram or WhatsApp to claim your special discount code!\n\n\ud83d\udcf2 WhatsApp: +18323705952\n\n\n\n\n", "short_description": "\n\"Take the reins in Buffalo Fury VR! Command a massive buffalo using a steering wheel from your tribal podium. Outmaneuver rivals, deliver devastating horn strikes, and survive the 3-minute arena chaos to become the ultimate champion. Feel the beat of the drums and the power of the beast!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/horn.html", "developer_terms_of_service_url": null, "publisher_name": "adrenaline shot LLC", "support_website_url": null, "website_url": "https://adrenalinshot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1112512945283307"}}]}, "schedule
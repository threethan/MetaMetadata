ams2-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUNz6oN8OEcQ7kNvwHRyBn_&_nc_oc=AdpbVwDXiAZX7xyHKO8Iofxuq8Huf7D5YtHpE53uCayWciCkzzFiK9xYvIRwO1_jDgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uZTImVGc4bQwQGn274ewsqsp7CQ1UOaRLZML5-NXCOw&oe=6A316471"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMzG416DajcQ7kNvwGfWSyX&_nc_oc=AdrudG0rEGSG7RKdAvJWVJ-uV0uqKee-yEXTTuzNmxQwAO9XU7r6FrD0cL4n5wWGk2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A8jXv52q924h2hz0Q7-wxL26x19b9Al7TtogdfFsxMg&oe=6A3164DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvfxMLFqqJUQ7kNvwFOwT-q&_nc_oc=Adp1VXDTkEESyxDx5bU80BDdJyaNtXvIrExtgqiU_LnW0J2XZaAjKhvK5lnZ1Y9vtRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D_1wAjz2SLn84nd3QyX1mAnRqJUYSBB6uQ9I22ccYug&oe=6A3175B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW69edLppb8Q7kNvwGnHIgS&_nc_oc=Adq81GAD1TNRm0qJN4fq2VgI5v4FfghQeH97-RKouAX2kz46eDlndqd-3Ldi5MlQ9XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FK_3tytQ87HpzQOu-ivMMQMSRW3sUqT5Z7wdWJI19Ng&oe=6A314E61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX6eVIy_OM0Q7kNvwGUnOd1&_nc_oc=Adp9IKuDl4DqQZTxS7xMK3Qou44VRWZ1wHcqTzZb5MXsOlyr9ZeWRppCqCUTyHp5j0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y3T0ucjbanXGCIQsAy28J3HnfhJAZZ97jyaJbHN3u1g&oe=6A3147B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
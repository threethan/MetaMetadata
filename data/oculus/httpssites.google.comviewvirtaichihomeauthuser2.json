ord5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7dd_KAM8-AQ7kNvwHMklb0&_nc_oc=AdpD98UDokd8x2LTVWIhZmVIOijJ6z3ywzlqQN2djMDST9TqXGC_-q9p-lnqEroaD3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4T94MpaF0LWbb4Qz8ofm99-R8gJgvYaps9jjS3_JQEg&oe=6ACBA3F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZGZ9E1ubHcQ7kNvwE4HuyA&_nc_oc=AdoHrjVSFnVFGomX-u-0IBA9NnK6uAeBpN3CNh2ynpxs7boBncM9nO2DQkEg_mz2VZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN18YhaiSdfhWElcnJiH_siISJh3Wq5Lf9NgdiB_q9fxg&oe=6ACBA45C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7FpU9ps1MgQ7kNvwFfb3zC&_nc_oc=AdrN5lGMreQCNMJPXlVdeII9SSQFHwNHPldDO-luuV8KkptrhX-nBoB7OeUyhOwiQD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW3si4ZJCrVscXlQyuqwxRiSEbklTI1Wf3tmBdqbqxbA&oe=6ACBB539"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4ycfmISyFYQ7kNvwFu7ikJ&_nc_oc=AdqQhEOVAYTzHHQFft_KJV2UW-CiyEvuSgZSdXXnlC-gIolti5YX3BexKmHcD-aUW4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNabfiYFeWI-VtSF4Vg40YeaBIeNVkSMzkZgR9JSsGNsw&oe=6ACB8DE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyzX9co-SwoQ7kNvwG7napZ&_nc_oc=AdqgsYVYTgu1HOfDmH6QMaa5w4m8RvH2YokfcOt35S0gT-nZUMmzbwtI0OFCauBNZok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPweCuIKxs0cs8Q-MZfXVuE8eUXK_cbHegt0P6BsvnJA&oe=6ACBBF74"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
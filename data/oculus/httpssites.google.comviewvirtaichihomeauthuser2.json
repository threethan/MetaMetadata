content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o6T8jO65kAQ7kNvwFkDkwF&_nc_oc=AdpQo_nQoKeCbGp4VLjgLtNi42E5A4h9Qq3Z9omvWSkFgPqTiD1lSiRzkg7-aK-P7dA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P4Pz6-sTZPmQfHf5VxlKl90B7UbBOJ987DJppLfyv7Q&oe=6A36AA71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW6Ti77bzMcQ7kNvwHt8ZNy&_nc_oc=AdpojZ_pz8YQzDSARCP1ses8avoLxzD7Oj2pKy2U1rUUQPwuH9sWw1KNsaUXyuJJkPI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JYaEGHW_huz4BMYU15BbhfQBX7pASbbzNCH9fuO4bDQ&oe=6A36AADC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlUGbVr6zZAQ7kNvwHts-Uc&_nc_oc=Adq6rBV-p3GFI2nARMZW42AnrMiLs4xh9fmZECnpgUfHr7KkhZn7-drC3UgqS6IG1Vk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UYAfEsCoJZ4Yh7_CYdd298XkS9YOGcyYIMUFnurscoA&oe=6A36BBB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S9lqcvEmaEQ7kNvwHoP5Di&_nc_oc=AdpFdVT5jp51QQQUNeDRRsP-4jOvRAEP2iVydi6bgDYNP0LPLTyZT4866XgLkkQoM8o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iFXCDdHc8Sj2OcpdkfkC2Y31lBVe-SGQWGgF4bHWiTA&oe=6A369461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnOI00i4jPwQ7kNvwHtacpp&_nc_oc=AdrAphruGIIrTJgjHoADN3HokTcjARj65hs1QvgJXBhj6-5-yerIgXTiUOJoJTN67UQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TE5zWsnT5fugQYGJx0AvHlW0s6ba63S0tmSlFk8_NMA&oe=6A36C5F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
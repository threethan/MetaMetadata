atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgy-xWEjvL4Q7kNvwEZFF2s&_nc_oc=AdpBNx-Rr95ScrggUTEyEfudiWap4pAYnkrXL3wcPdq1H2DA2ERPRRR2qPpgaHdMK2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHrOCr8WFsTw-1Qr4rBCMdh96FlMxJIAfle8Xhxqi1jA&oe=6A71FDF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMi5j5IpS1gQ7kNvwEkThq8&_nc_oc=Adq9jVNjONRdfYdnF10dEJu3hRJKRqtKgJuaH-F1GzphLoTwhgSH3_sJHOL_-uWQiaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMlnfuDusMYTbsQ8OjGJAOyvfJ10sQbCdTQrO7NZ-iQg&oe=6A71FE5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jwjVdR3xDoQ7kNvwEEQVEB&_nc_oc=AdoQRp3n_8hh738pzJ6Dcub7XnmhWvm9V5uw-NZ1JyPsi_YwwtFSLMH6viWNvWvZc-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPpFdn7unZl2Ihf4tY3xPzi3ZODDe25BKZjwQ99rZdFg&oe=6A71D6F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-FytxIXHLUQ7kNvwG_y27e&_nc_oc=AdoXOoAuV14-06h2v8ZlANGY8Xw40E_-PI_yp3w8YLZqOWOIbaDltZKooO5i48NCFPk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNXIwLKG-F-TViaNbXRV0HQw0eMynvotArwjDypBAfJQ&oe=6A71E7E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RhtIx4hhHgQ7kNvwEX8Fb5&_nc_oc=Adq0ernmRObhzBeBfmuHLPIZe4V-T9rzBhnQDuofK9emkl9hSHHbrbAtjIYczxbOcUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_GKrvkPSnel2cWT2U2b2eHd6US7ZKQcOxP-yL2UScQ&oe=6A71E134"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
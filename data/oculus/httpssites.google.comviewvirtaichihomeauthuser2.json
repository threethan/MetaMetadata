sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nakBvWvbPjQQ7kNvwHV_wo_&_nc_oc=AdpIydwwKjZVUVDud6VAdEvrjQ0DgrP6v7lhg1zMIscHuE-8pq7n-ZerXy4dpfYAjFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYRSVQgOI045Yoz5CEahsNE6JU0Hqm0cJzeHejbOkP_A&oe=6AB145F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHJnknNurH4Q7kNvwEWHqJ3&_nc_oc=Adq17_VVnrDZRfNXQUJBpbTRIIMRi0FEam7cKJ6STp8rcr2svLDuVwnV1LmR2Tx9Re0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwtAoze6e6LTbF33C2VeoZpLZ_02_ZesFNibnm2QvygA&oe=6AB1465C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH9cnMaurVwQ7kNvwFZDDWI&_nc_oc=Adpf5U8nkVHzPedV6aKfytW5jmMppIMAwGnuwjVP01-8uoBEO6ADnA_ep-z5SnBrhS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILH1z0zaUBk-BWpjToYNlOkT54zUr31FwAOhEKrxwKZA&oe=6AB15739"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp0oQ4QoQjcQ7kNvwHzqFmO&_nc_oc=Adrby8I6JiRFHZxzJLklZ08qZAk4A5nEN3b3jBIZCWZN2NxJBkDk5IIwdyaEmZ-6-Fk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkx4K1LvM6gDrK8FjFTUE0ssQHntqeooFVhsuablkB4g&oe=6AB12FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV-FoZ8IgSsQ7kNvwEzXJhB&_nc_oc=Adpy2DuPMPzCTIxvJXfHnyv5LHYFDcFdnKT618c7MEPLlWJ-tn_MfPTMl24GhC2KGMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7GvRpRfCYZV458ew7QgZFXnl95P-L5O1BvHlJUT0AwQ&oe=6AB12934"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38LALnTdMlMQ7kNvwFAU0V2&_nc_oc=AdrNHTMBRRjWLVeFbBjHiL-DV4pM7e-RJMTz2ao_KlngJRyGrbXBFdZ7pdZTaqvGMyM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aeLQbKOxeF2zRFzwJcvn9AWB5U5WTplbZk5mKZ361Pg&oe=6A43D971"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Wl_FZ90VUQ7kNvwG39NPy&_nc_oc=AdrqNiZoMBCD1NJK5oDuEAPitb7RP9m2gPCdgyjPXW5w9a_OLUmaz10djzIar5ESuAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9chv33JnUKnKu-P5H25FUNntgXmJALIistqeDyu0ONJg&oe=6A43D9DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GShmoEkkhJYQ7kNvwHCAySZ&_nc_oc=AdoqmuvLHLUE-Qlx2KSBdUzXAn01tob-3hJNPXSdN7syTAOFWouPVHOZn-Q1O-cerA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pf-jNUaz3HKwkXGHZIdC_zMe9h3ynqWnQYFbTLookVw&oe=6A43EAB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BOwUc0ugUQ7kNvwEVHJIu&_nc_oc=Adog5Y6F9ppYrsTspN3uyErXJx48GV70U3bZgVCIb-Pm6BzpLGOTRBXkz2Hb09col6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dRGVT7csYwRQ3ycrT_i6Nc8S0VjZgjuNrVeu82ZS9Lg&oe=6A43C361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCSYpH6dQ8kQ7kNvwEmvn16&_nc_oc=AdptFDURBKy9Jh4_oqKWYJFDHJZX_c6nYP6DBsieyiZ1R14nFDrWWUt8ePpokT_YUpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c_r7RXOL8j3XYIzHbBFmBYZy152DokVHe810lAuoqMQ&oe=6A43BCB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
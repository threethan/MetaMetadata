ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoU5lLsnQZUQ7kNvwFpUbd-&_nc_oc=AdoBPODAIKrHW2vmwewgCi9EEd5PH5lcvT7IpGWXpdW4xXMbiBsgDTLr881vEvVpUXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_SyPVsbeDiVM05ttcfx3Hi8DqYQL5T7J5BkVOMbeCOA&oe=69D90FF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDPuSaLms6wQ7kNvwGGT6pm&_nc_oc=AdqWanaO8WMDYInushFMDc5qdQoLCJqONQp_ut7sfZDR6i51itphLLN25ZYcPI9-H0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J_yL2L30vg6wy55OGC3mAsPI23DSdMrOVht_Y8IK0cg&oe=69D9105C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK0qFldxKboQ7kNvwGeuBIN&_nc_oc=AdqjJKJPQqnu-J-DUOC4Nm4U15B3j0y-ET3BPPyADII9KgUHBrh0pP1YpdPEV6e_mE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fdQgKWowFAvlLgQ7uIhGCmq7B9pTk2K-2RIjgnBpdRg&oe=69D8E8F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlEjq_wYOZoQ7kNvwHhGq9a&_nc_oc=Adp7aa6A3PQOxeiuApgEG-wXHIISlR4uItynA2aKkOdhdzv22lyT9Q_qSf5mR77C7LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26tVjVC743QTcTpUj4ortZgzVBsAcWJK80yBwSrYMaMw&oe=69D8F9E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAfSOR9U_FEQ7kNvwGdpP9L&_nc_oc=Adp2j0giEryjLwtxxHxZuQLs47k_qyznrVK3Mv1nc3xohiWH0H6E3I7gObUXUPynpoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uhdyhcl_wfu459J4om4qP_emegTkXASMQJROScUY7Iw&oe=69D8F334"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
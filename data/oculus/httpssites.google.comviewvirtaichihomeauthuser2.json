ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUyRNl-VYTIQ7kNvwGMNwE4&_nc_oc=AdoWSo_xAkC_6cY0dxE4p20oJaxfisCgC7moN243V4QjoEbVsilUdwBE5Q4nQm-omO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZNT0Gdd9RPfAqw1NCPLtdEOC4bPa1nkb3we-Y2Bc9Lw&oe=69CE4BB1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP4EyAqkVBEQ7kNvwE9XBB9&_nc_oc=AdpChRNmQH4Sn9RY_y9ba5oridE6eKXZKWTEEPgkv40_Z3IwhFTU0Ma1waW65hxh9oU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmBqSCcCRH5UVi7p1y4yXCF3r0MgvhcjcSX_A1nozxHA&oe=69CE4C1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb7oXELWPI4Q7kNvwGxucX8&_nc_oc=AdoJRRjxMvvpajltMpH2sZY4c5q8XkKv5k76HYwI8W_jW2K-GGbiiexDRJCTRstSI38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvRwlKH2u5uYE3MmZNiMzdg0o0z0MNXIX3vV6e5NFORg&oe=69CE5CF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP9we3u7esYQ7kNvwE1I23u&_nc_oc=AdrZlAW9hRs7mUmiehF_FcR5XaFqfE_LTxDjeTdUcJKjyHK7pwK70EmBRCySc17VZwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYAV4uLDhD4LirFB-I8hK_hW1fMBK3khqcahMt6olSTw&oe=69CE6DE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfRM7nvuwtUQ7kNvwHT6C-n&_nc_oc=Adp6oSrO3HdpNEdhedVbOQiOULf78mzjW0RbQRWgUV66b1KOwROdNyBjRMGjycdQu1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9W7MpmO3Ml_azDkgKyI6LC2o8Oghdqkh7yuC_hRJANg&oe=69CE6734"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
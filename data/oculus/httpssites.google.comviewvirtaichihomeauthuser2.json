atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV4mFv0MaGcQ7kNvwHKUpDq&_nc_oc=AdrksjPD3SdGD5l1WaqONB4Od9OpNeBMXKYKhbQRhJGwPgzrqSvd75vvQOpM0XyIODs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJuvkb_mjuCvl3chXtCLWwkx2mQVLHkxGvntBeHnbe6w&oe=69C662B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zBMU3Zu9IcQ7kNvwHr59i9&_nc_oc=AdqqU0GyMyN2vZtRod52vF2zqUXtUv5MH5navD72j80eNeZUsjqvxi5p15Ojm9tqQkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySYqSM63xA2drCwi57gj-iWiAaG3tUHMFE9UphfNEuOw&oe=69C6631C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_1ik4I-4b8Q7kNvwG1luVN&_nc_oc=AdrY30r5zxvVNfh6hFpZmxZP5JNol56ivMyik6vcYO_DLJ43TaE8cUrTxT4jsdS9sdg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzF4uZ5efT8cMaLDwFdg89a7AvX9UQZz3c0yDykRBwNag&oe=69C673F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNDGOvA9ydAQ7kNvwF7xYY3&_nc_oc=AdoozA2Y_tfux_YAOjw_GjoDQ-ajkvmyVtDKL4DJPPGmPGgVh4ONUtn0g7TjMqbNuHQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCsqFm1W1wjeShlRSRaEMhf6LT0dRIcLoaWfRbKDef9A&oe=69C684E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EMSybx13qcQ7kNvwFLGf1v&_nc_oc=Adq-454zMkpX85IZYkETCxolw0XbTJVkhVQCSq3m6nhkF6QzUjVgrYabSwktK4AN-yc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQeFfmSUYbze8iPS_tDoqK8ITAWffpPMeX5zQrpMXWew&oe=69C67E34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
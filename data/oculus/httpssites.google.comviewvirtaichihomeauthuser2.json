sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSdb_N6u7msQ7kNvwEiMFtb&_nc_oc=AdpAwkMKyBTC0X_ku9iT_smyelvu_0tXF1bK9HSXqgsyBtI8K7BHp1poLpIyWywBUus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1msUGCBjr0gVrq3cRUQYbSmsvbxS7YDhEy77EXNim4g&oe=6A92BB31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlwJ2nDOhYIQ7kNvwEYsoho&_nc_oc=Ado15jkJ5V3zjk-QCTpoucObJrQo0Bxq1d2Q2KgDTMhdQKhQS6jZIRf5NSfwD6NAWcY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfBYEfYOGH3rcx9C-w-BmpysaUMQl4BW8gB-e7P_ItNA&oe=6A92BB9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-oxz1BO8RgQ7kNvwHIUYID&_nc_oc=Adq6kmI1f0-J8boQ-M75w_eeVNTHlO6-HlZxCQImgCZOLnY8WvUWZupatKmHcgIOMAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnFxHKZS8legFv8RqPuuaY_qD3STk5FYYyqDCJSGaSGA&oe=6A92CC79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbJOMWL6CAQ7kNvwHOl7GK&_nc_oc=AdpcfHLwWgEs7PAYbqBOUpP3WfOgnbl3rh0lBAmwUD3ir884eqj5gKCSSkcMIQBa9t0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG45MaP-m3kDAbVbN2i6zcVWL5Wr1g6ro8W3qzVTO5UAg&oe=6A92DD61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TmLP7Vx5LwQ7kNvwGDhRsN&_nc_oc=AdohzBv0Fey5dm_Z66K9xkoVf5RhWOx8HIOJk1VW0fQ8CJxLKaONVoE97irel0UdSSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMcDHde6ja45PpVGoNtCKJZ8i9HijrbKRD3z5BEqHmWg&oe=6A92D6B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
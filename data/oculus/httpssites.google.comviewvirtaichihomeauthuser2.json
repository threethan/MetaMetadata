atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBSLUtUSGn0Q7kNvwHyKyrA&_nc_oc=AdrGthYS5AGluQ3yhKUMv5y1yKbhaYcWQ1wDc1d3H3gOTne24cCJoQ5P_VXZD19p8qM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gx9Ao7Dvv2gIXm5usGIb-rz1kXao5sG8xYif_t9GCRA&oe=6A413671"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Wl_FZ90VUQ7kNvwE4m-IJ&_nc_oc=Adpd1KY7jtfrN4MiPFrC9WnMhxbmWXPEmW0FGEYOj4ATEx-OvI06_5813qkUyMG2vxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jpG1BlvVImfQXzP0kCBhPs9U8zJyi0vxQgm79QHL9jg&oe=6A4136DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emrtKXJZcfMQ7kNvwF3Ei2y&_nc_oc=AdpSeu4Zb_QUiTju40gPNWGV_kDk-RS3HHW9LEzVlyUtJiXZYVQVPYfUHsEBmjzJvNw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zCBK3RsKMtPLlUW41VyBBCTq9BpatOhG1BmK0VfEdfg&oe=6A410F79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzlBJ9GXDt0Q7kNvwFF-EGS&_nc_oc=Adq2fmFqW1kmFSMKtb1fOs2YjGca7bMaMhJhMuT1rpR9G8N-BQyM-vbhXbADltwjbNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ojHjOFMJPs4rxE4mFIlZw1EY4Fdf8PMpoLVTe6Hb8rg&oe=6A412061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCSYpH6dQ8kQ7kNvwFvUSDV&_nc_oc=AdqY_KP4G6bJOwHMKikwBhSWRTpHKwdSowRjODg8XCZgEq0YGCmBIgO0fOkmsuZkWFo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bP9XasA903zEaVI7eW8wY_zYae_zqT01u-KTk5vIgKA&oe=6A4119B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
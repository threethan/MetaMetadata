content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYNHsFvm5MgQ7kNvwEQxhCM&_nc_oc=AdqM2MbqK6b03UW03CQZqDiC2Hxe7Ea95OMpHJbQLnbmtYRP9JNMLKFTwA4xyWXEWE0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkMI8WmWtZSqOjY2wzRuHk6utsoS-1ok-ynTLgg_anpw&oe=6AA416F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-XatSvXV-IQ7kNvwGnMV6W&_nc_oc=AdpT3umVXuUM4lZ97siO6WZtptAS1YAYKKW_vjn0QYLwACD7NtV7KSYbAU6C4BiZ0EU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_5H9cpmVnYpXR8JC27ikMJiSdDMehKxdVWTfPhYyVEQ&oe=6AA4175C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBUHdBBI7NcQ7kNvwHHdaQ1&_nc_oc=Adqn3K90OTwrwGzOYlgLc6Il2PRGt-krwlWsa1R_J_rWNJteKUoC5i044neR7q42KLs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-S9eHNPdH1WP5Znrev_ruk85vmeU5rmxHFn72flMSDQ&oe=6AA3EFF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmuQs-i664EQ7kNvwHfGJdW&_nc_oc=AdpTQ2mNtmx_RYbUTS6Xqsj_oUT9c6O8DTDh4Vq5GUxvW6WtLReQCpe_yppfYeC7p4k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDva8pTFjzOoW2ccVgofRpQBPQaGuAJCqB0YzjK0vByQ&oe=6AA400E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4AetQPQT14Q7kNvwHqqygP&_nc_oc=AdrB_egFIWXr9PC1-pGrDfaeR9iiaK08JWNVBvygRlX9XtrTp1PYvmx_9V-FxhN1lUM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnBjUVZCaHPxaE-2M412qQl6hQnsAwSdlwtt-6tRGIvA&oe=6AA3FA34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
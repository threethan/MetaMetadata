iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nilf8yZgpNYQ7kNvwFuiwJ9&_nc_oc=Adp2nwa2-UFEHmcgN6-gVjV3ciqX873o40okNx1f9xiyTxBJOorqjcxzEYpE9GS0jPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H-XG4svwp2HccZ1hPu8oXcfxZppiy1548mcJQYn_e7A&oe=6A009CF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIUr42UE7hQQ7kNvwEQnK8j&_nc_oc=Adq8uBDuq41lE_G7_urazy3McJR6V2nCBK6GwZ8cd_j30GD3Qr8Fr1UIcnxZqOSn0J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EnL7hLkNlrEI_Ep6djRjG_RTs_2b06O5kHEoyMf07Jw&oe=6A009D5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_6LGvG5iP8Q7kNvwHgm4M3&_nc_oc=AdofY-lewtziWIDK7QF8v6uwMMP6adgWN_V5hDMtXYl7vBuu2ND1ydACOn_yn9VKyNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TBvJpXF69FyIoamgQAfw-Pn5rrjFLmFG76HFc06Q0KA&oe=6A0075F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exw1HjKvnQgQ7kNvwH0_LD-&_nc_oc=AdrIZu1iSNP997Ye3-X7RiN2lO-yMbe0jgPiGUG_IiB5FsA4toH24-PytTWicodDL4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X-SkyV8eIt2SR1KgyM5qTFbvH07Tj-LE0six5hnNY3A&oe=6A0086E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_cLrZIUN2wQ7kNvwFXwJ8W&_nc_oc=AdrzmPVV_01T61rT0LqM8LrUD8YJFVsjV1RtLzWqSVYbKAag08lJ1SAbebRPIs8Rc3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6llNwRIn9N2DqkyVmhAEgnpvffmGuPNKiiaxLI8wvU0A&oe=6A008034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
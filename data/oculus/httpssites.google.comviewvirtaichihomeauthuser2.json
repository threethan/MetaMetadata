25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vneOCYpDbbwQ7kNvwGjZdma&_nc_oc=AdlJntk2QZ3Duz2wiJXgNZpXw3wE5XGY_D1CrsT0aveW_7gXaku1nF4fwCQY6YLX1YM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlSsrUce_UwzPKxEnENolOJDyrOkiK4DPWsalXPopshg&oe=69B933B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEmZzs7bwI8Q7kNvwElVdGL&_nc_oc=AdkFOH8wSws7MAKAS-UAWa5nQPJXjTd1y1P9CsnUrP3j62YT41tLkfRz_tEBHeW9rPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXw3y7zrxQShFj7gbreILpnrkz8k2-MWKB4TQLCqWN_Q&oe=69B9341C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW7WUSM2-mAQ7kNvwFC-q7u&_nc_oc=Adle957XXjmLNxt_eLGSXcNW7CHbkWHo6_XtYcT2d7tpOq9SXCBtixsSU-xbBNFRY7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuQODmipM4EKBBe9LzpuY8IShqPDKYhKs2rzaaSWm0pA&oe=69B944F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUTzgSRzq4sQ7kNvwGypb43&_nc_oc=Adm6lZQ8DtRaqurGr-QRVaVPcdIfTrAwC_xj-KoRyWiAO-jbaHqMzI9KRGb_-d6p9-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0dM6eouPtJPqD2pmzDXTYsW6BTXhztnVpu4kg_kYziA&oe=69B955E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnxoNwsx17IQ7kNvwEitRAW&_nc_oc=Adl55dDQjy9Q8g1W4iVF-D6YT673mJtXRsQ3SrKdPt5Gv-yl5bdHmxZxkoG4-TunRSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzeIt1dD8GqiSBb67L49hBWhCpZ-HKJGR36MdZIHoAzQ&oe=69B94F34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsBkyPHPW9UQ7kNvwHR6ZJ7&_nc_oc=AdklMFuOb6wOBXKUFIisGEeEXdZ0Y69DAqiE_TgrFOjs6I-14H7oIvoP-ewoGcTJqgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQOSUdX5IgyY55r9zXX9YMFDIo7x_dwxTRE33A6cfwYQ&oe=69AFF931"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjjC-BNgpowQ7kNvwHviLdU&_nc_oc=AdnjD0mH250GvtvKp-ijj5BUOqwtXbKzYR5kJ4CgLD7C5uxlwrinuOBV69bTp6mEwsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHKLcct9jobXEYTpLCtyhfZgR43CwXF17gmSyo81Yy3w&oe=69AFF99C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3RZxEY54HUQ7kNvwFWSXTO&_nc_oc=Adn9UDeAWEfyEZKUlqCGl_CGydci-eD_d5HpmEuVGuF-GlqFmC2yWjnKXm62gzPesQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLQjtL98wBfajFbA7_P9mXwXPGnZx37D6PGD_9xyBS3w&oe=69B00A79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apOPGo2cur8Q7kNvwGK2hzH&_nc_oc=AdlT-GjyWpyBsGgCI35r9IBHVu1y9YPchvbbXL_p7jOaiXjnOcLwhYTK_G-bhjuZcK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZTYRJz5h8bawm1vK7JuM5BLPvZIdB2rpMFMxLUi7xQw&oe=69B01B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwxVW22-NEQ7kNvwGAJ0n4&_nc_oc=AdkBtOTqZ3nsNpQZ7pDgYVlloUnc2K9JQwJS55tdNO91wf23EfYfkf5g1nIw8yQoEfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyesyHB01FIPYurEjVFcW51CULGmEOUau84iQ2WMkcg2w&oe=69B014B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JobRk3lIV2AQ7kNvwENVz04&_nc_oc=AdooTsYt2agiu3sSyxd9DE2o5MprenJZ7CGjooBbi_GIK9hv7QPECLxF98-S_lJDkQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKgTyH_w3JTBcf8VteW6OBu5SjxHD-cnGy2S7iqa3fLw&oe=6AEF3C71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc9NfdIcxPEQ7kNvwF4t-IR&_nc_oc=AdrkUtFGO_mAM_3NmMiJ_OTcJNTcQEJXCTy6UjS6kkIP7WgQQMbvTNHieUymWAb-BHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE-PinFJKmqkeJT82B1t8mIvBd21QzOuaecyRCY2sG4w&oe=6AEF3CDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWmu25Jyz58Q7kNvwHE9xHK&_nc_oc=AdrG07W1EonZD9xdZESE_99s-shj7oY9fqw9W9vYm5PAi0U_K7wiJBo9IEXMUszuNgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbXcbvNWHLc3AZAcDsLw_StMdjDB8EN5vQ-EfBhkYLJQ&oe=6AEF4DB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzqRWHSQaGoQ7kNvwHb1QJH&_nc_oc=Adq1Mkc_3Gztw-m9LKg9t5qZzhza9Sci8SrFLPqyjKvJqlquzTRMKO1JZMwdhd_pETE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HBFSqR-Clvwmxyr28BGnkdWom7N6G6RVXrdthn46hw&oe=6AEF5EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xp_25WrfW8AQ7kNvwE20tRY&_nc_oc=AdrMmignMenycPSAtwbnj31Xs17OBz1XqmgTqqMQ7ov-pDez5vONLR-u-OVbNB3oZJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHt-QrqcsXd5J8l0TSDKClMO0kxvkYpOBe8Jyr9qRcXQ&oe=6AEF57F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhwGYXRgSGoQ7kNvwEn_Z5m&_nc_oc=AdrmPkA6HcaWiC0TU_-DR_9GVuTm4PqmRqatrgDC64H2zIPWGYqwH9eTiAdByI4CEzc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdlDg8nLGZGSiNgV1Kem81_3xuNYZX8HbEug2ZcjGxlg&oe=6AA95CF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6_qDzpXjt0Q7kNvwFWUNf2&_nc_oc=AdqM9qHYP_3mBWNPak9A8FenAQcHQhqNADjc9A2ffklM1FO0tswxWOV5qoavG4Gxegs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_VIsxTmGdRr5aKv0hzsR9tUfrrvGGNKB90XLLcyBGaA&oe=6AA95D5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42qWMQGyrPoQ7kNvwH2n5Tk&_nc_oc=Ado8q1Q0-NoILxYNSLAdjNl_7jVJi54IUB70TyI62bXgDUu_QOSuKcJbEa37au-j7AM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDX4MdQ-S5gge_t896-MpTE2cKyDfMHBzNrdt0q8c4dA&oe=6AA935F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79qzpkVacqcQ7kNvwF-TEqn&_nc_oc=Adonnt4FaMCYkXyCI-2CAHeevkpthhcybze9ObVDBZX2e2o06dkf2rHQMZrLkfMXcSU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzToyzcPqS1GqAej4Nu5vs4GFFHXasmWcxcwK7SDUbvQ&oe=6AA946E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB939Of2psoQ7kNvwH1oRzi&_nc_oc=Adre0--TU9O8tmKcW0qFMtr0qTSRpFzY7O99MfSSIv5cozDbKVldc_ij-brz7HDhKJM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZg0eM6oPhLsG-zPqwChrtwFdFeDpm-Y7DOqflijy6qg&oe=6AA94034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
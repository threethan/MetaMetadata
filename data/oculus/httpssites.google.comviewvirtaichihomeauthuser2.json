dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB69ua8A8h8Q7kNvwFYX079&_nc_oc=Ado8JXHPpi6FH7X88tdT4zQfQJGK3C7FSxif6RLxqPjIEOZML1T-uU_JW9FAW9pUuCQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw033-1w1JWYWjbKmocqEPDh1eQDd5QAoDdgICTkhotg&oe=6AF9C871"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1GBX2hno_YQ7kNvwF_o0dw&_nc_oc=Adqa8lhxhaX3o2I57Myjd-b2gaqfTAgtigwAU8cORuufOwqzNcZ0EI-QRxWVx6UOViI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST3aCTm7G6hcAwCTCgR_Yrn5AERlEs6WIKdEfo6BpnOA&oe=6AF9C8DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW9BD8P6PLgQ7kNvwExonDk&_nc_oc=AdpDBqmB-fB0yPfVwHpNlVbGYy5o7GOSy6z5NQKW0MdsjCrTwgjAoU0K4sQl3yjGyXQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk9fOTGdINwQV9r2LHs5vO5YCSTttGpLj86WeL_yTEkg&oe=6AF9D9B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riHUo4KIgX4Q7kNvwFIBsia&_nc_oc=AdpxUmCrD3aW_DbUWHRYG0ZiTMADNguFppxp6_DJKLHs8pskVky4ufL-FXT_Y_8lQCQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR22uPT7yszrUtmVonsP3MivEOKMvVCc7K5p5PDstlc-Q&oe=6AF9EAA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuGOEmdRFaYQ7kNvwH9nsQL&_nc_oc=AdoQ37_Gaz30XTMbPpRpvqchrP5cwWsTRBdHY-TeSntJC916oCZRk0NVVQTxI9WpL88&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQATX8oKOHa3Nmz-bwM3nUTN2qdyXbeQCZkPOO3QQwaA&oe=6AF9E3F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUNz6oN8OEcQ7kNvwHkX6hB&_nc_oc=Ado44SmS4ys9O3UHlH96sq94bYQD6-9YmynVSY3sn-Fq-yl30RcdbZhc3ZWTLR6mjO4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9smKacKac1DFbL0C2uysCUUS3is_B5xMdanRsK3n9JLg&oe=6A3012F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsaHPF6Tln8Q7kNvwFs0o8J&_nc_oc=Adq5T60gTHnsspVaRrtPQxj39uAjXg7GEzlqNer55PgRi0wNABSBmOFnw4pM2UDYo5E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wwJrCRghjH1cCMs7EsNiP2dPGCq7G6r4I4M4qWfyIzA&oe=6A30135C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvfxMLFqqJUQ7kNvwFGOOVM&_nc_oc=AdrvavBIzwJSd9k1U52IdoaWrd8tbVgnx6RlgHLkPrTQmyr3abx_8HeBTsUB9nYxrhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vzq5nx0eYUKnrQwGcPPVpDmuBL3ykiZSQIn7qcgbN_A&oe=6A302439"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW69edLppb8Q7kNvwHnhs_l&_nc_oc=AdoBQSmGAwbK9j55FQUPWTqUxB3j9ePZA63YYfC8Zg_0Elq1CvF-EiAMTO95NWVsdhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rB3LVC25AJMa6i4bxVBbpU0GrYvaQijVqjD6noWKE6w&oe=6A2FFCE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7FE7cpd2oEQ7kNvwFWXbu2&_nc_oc=AdpxUve0QFUrm548nqWSPGh7u5q_MGHsaABhnpzEkXqD_tuWLACzyEBjd-CLt8wkQng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FjjwQ6pgfZjCkTrhWGZDo_e53c-faURVcDF54MJLW8w&oe=6A2FF634"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
ams2-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34nfCi0dupAQ7kNvwEfGcmw&_nc_oc=Adq940FpcwifMk4_Ank53H18pqKfLyPXX1FQiTKOw6cAUOWIr0CXl9tAs4oGYHZ4InI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dqF7SAqjOsRmLgfo7dfda0m8Zj5oc9uT6HnUJLH3wdQ&oe=69D27871"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C0gcqRHk50Q7kNvwES9jHK&_nc_oc=AdpGI_pwsBK3CTbeqVOB7bT_HIS_hyjSz4kAnhYh2YPYffk-xuRl2p4TGBxUcHpL-Cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hqiTqR8r9akmuZMN_9dIT9tkVpogG5J7mgFSHSxAZJw&oe=69D278DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N5LNI4M2j0Q7kNvwFYyZMw&_nc_oc=AdqtFOP1ZZg1QEiBe8OYSujc0EFRxV6Ic-5ezfnm1TaKkH67MNp-nu7_F6vZFy_ikiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2airX6fFI6-gfHOFjNGpDfN1ydgnPKr57191lVy1Y6TQ&oe=69D25179"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByIiw5U1eokQ7kNvwFfbTtA&_nc_oc=Adq78Cr62BXlP77gXCWOiO4ZsQhLdRdtJEziMhRcHvJ66jcPaCmB4GuJf8m9fnzaA20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pYZLjM80AdZlcIb9r-QhitkGkWaFvjXFIVIpOMG1p6Q&oe=69D26261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFdZxE6XuoQ7kNvwGEBRvr&_nc_oc=AdrGK-pmXe7oftVNHLDvoVv6IkVfd4rV1Lc-l5a1YGjOj2hcA_CDTSP4k3mZaPI4yS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sG25mWUDS-5PCPc2hkRIrn4DmIpA9XqcEa6l65TvCRQ&oe=69D25BB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
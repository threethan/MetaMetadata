iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KxnGe-cVZEQ7kNvwFcyRxK&_nc_oc=Adoay1m3nrRVXOrg-Xm0R5UQqtaqEeuuwJzPYJpC-khG6blbbw9ZRr61dvJxz6HINKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z_9NZbjfg4zORxE9Ize_idGS6JKPIbBIsEYuAjSMqGg&oe=6A2D6FF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsaHPF6Tln8Q7kNvwENxBex&_nc_oc=AdpHpGSeDfntTuo7EAA8TF72WFua8-0pTJ9W08Vwd_SYP9ARPXqKazuXSRKShfY-7v0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97xNkoYN83iCEwHUHC9nMEJmVh34pGyV1qprgW8qKAXQ&oe=6A2D705C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAjdmuO3zLwQ7kNvwHFxfdU&_nc_oc=AdpHUjveANiQLf7vHcKYjXEZMV1ceK5aw-tNQ9Qrp90TsbhYQGKJ3i2z1tW-XNd-R0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mus6zvo5-7L8R9aiNReO20d6CV2thc_fp-607f8LpFQ&oe=6A2D48F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95kG4V_mcpsQ7kNvwF79uCu&_nc_oc=Adr6x2AfR2a6N2iCDEb445_pk6hRi6GKDnOH4ouV1ZNY9N0X8Ze1NZ3_0ruw3x9ItZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93kkRdg18gvrvpcH0-J2WUpE3eX1k-a5ryRSROpa1Wfw&oe=6A2D59E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7FE7cpd2oEQ7kNvwET22Y2&_nc_oc=Adp9j1fX7QrdA852xVQMaO2FsP-eCUCA8FohGWyMxH04FE8MA-fDqrrv-qSf28tXTxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cZfBqWn4F9JRGwDl1pip4PdwiX1G_slv2SmJztajHKw&oe=6A2D5334"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
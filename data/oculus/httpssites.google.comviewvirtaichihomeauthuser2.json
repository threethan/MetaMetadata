atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nom88nFIEcIQ7kNvwGPgW4U&_nc_oc=AdqYeSLeA6vqdI0aeVkh7fV3RoVqeNDYKhM445iVOsu1YUPUcbapo92xM83-O1UbLI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuN4wlZBQW4ZQIibsQRcuHudi3TAWsrM36z3nAU0g3eQ&oe=6A9ADC71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeLz4mjtCkUQ7kNvwEwzUfQ&_nc_oc=AdpbCw0Jl5XbIzdxGsIw0pVXFMzmGIeg6lHVC0sc-EyxVoSmpBpJ2QC4reUIIMNZ6V0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtmrT0gWq34ayQHKDhQRH6UGxPdotrOpGkc_9bKbZIOA&oe=6A9ADCDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU9d0Igxb54Q7kNvwEJsRDH&_nc_oc=Ado89AQDWoryUfktaC8-Ypr7R3CTD_szaIclAZ7s8-a59NBgwgfVVzXAqE5wGLqUd9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbk78v_vO_DXQAljx5ztA_wQf_2HBEho0cRDjOMA1EA&oe=6A9AEDB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BMkxvmO_fEQ7kNvwFn8Lhf&_nc_oc=AdpWZzLtADwaD8hjU0vZCvfw_RLtyDbYaf9fsm1_LOqBv_VopF06Kc0h2BY5bLQVSi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQbxM1D9erWFrkf607szDDrlZIQey3jpFi1ishDDQT0Q&oe=6A9AC661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUFKfMh00wcQ7kNvwGRz2yH&_nc_oc=AdpwJcb6Hh4dwrHCDGwmsiKx6a_pS4yemied9D_FKZtBXUMKLnXek9ukUCpL4H6bBHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA0kNaqtNuwZ0u5qTfVY-JaBIGE3tAG-WlPtIXCLA3MA&oe=6A9ABFB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
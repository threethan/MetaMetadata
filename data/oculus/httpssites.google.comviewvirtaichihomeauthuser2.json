atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu-AuHvmm0YQ7kNvwEm8xe3&_nc_oc=AdrrcUDhJ-ZgASvJze5VTk3DZNgTnmY5dB__W4M2aFFhCFSP_SsIglX52y9sum4A3jU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTNPmI8cRvkKEZ7kLVbkYD-XabTD0y7bfiw6RQMYx6Rg&oe=69CBA8B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cno2fh9CBIcQ7kNvwElcWQw&_nc_oc=AdqC4uWwgloKT9BuS8FIraSnkXt_uPufArCks1_QT8P5LG04_zUfjtorjOiritZQufU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPzYXdtybj-y-v4_UpUbXkoTurW3GcvhDtOyqPoTvJ9g&oe=69CBA91C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb7oXELWPI4Q7kNvwESnVOw&_nc_oc=AdqANkhBmKI3YiZn4RieBWSs68kEXtjL_K28qqqnghxPT--yxe2O5ULr_m9t7LTQKdk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvPAFE40U4_Z_42iqOWEueRQfogYqlpTs-XRcif-AIlg&oe=69CBB9F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP9we3u7esYQ7kNvwF9-IdA&_nc_oc=AdqjbVa3i0CCJc2Gse8vPP5KAPBu0MKm3c6d8UYEp_BWwC4KL41e8jVjHotI0RtOQ-4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK0ygOTmvJrg7QGjAzv2lVjmeK1jwAYfoGeq0j-MrMYQ&oe=69CBCAE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9FuDPmkh9cQ7kNvwFpItPC&_nc_oc=AdrccLhCIcnrbJAkEJNDvk95geZa6Ayey8TELdrIHYraVWHIs7XDZxSnTndIVIz8uWc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzY-Y-lj6trsk_J5s8W44GKLBaHR7_zBj-6rmz0gnuSWA&oe=69CBC434"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
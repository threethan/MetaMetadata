25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMXgiXrOE2gQ7kNvwGUCFHS&_nc_oc=Admk1Rr57fN3YTlGFAmSz_L5Y_mScBK55DyCQFZpiibNNTY3GgEjneSWMonZxfSPjVc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGCXlicqLOeDTgGmEkJQmYIRDIaPtPkBDn4ADGJd5CWA&oe=69B29C31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm-M5Ukrw6oQ7kNvwFMVhDk&_nc_oc=AdnXTYP22VoPVWS6eHcyjpvpQZI-K37Vrc7QBfIoPU_FskWNXlnr0FKAwxg46GRGjYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2cmMPSrtGFkBTtOG6qvyfjnWvvZK0xwtmKpr1UgCVNA&oe=69B29C9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3RZxEY54HUQ7kNvwGMAlLF&_nc_oc=AdkB8Xggn9GMHrvjVkMIIddzcoEqIjQENcpHWke0fRyDEYVLgs8nQpjkrkb-sj0N2rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQ1peiD90ywpqKR-Jem6XjXbnVJSnmYgxbxELyf5T41g&oe=69B2AD79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apOPGo2cur8Q7kNvwEbS12B&_nc_oc=AdnZXYxhHCPnI9dffiMaHMbcKKZI58RxI2T_Y1CEdLn3aVeVZ641q64Hq8W8MGYIH2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwADdfehbivXfsYFiCuhX7vwt72SFzXayYY4Wv7_dggEg&oe=69B2BE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdi3fcSr79AQ7kNvwHjpYw6&_nc_oc=AdkkG-F30FIy9YPP3YqTNGwsSevXFfGZ8a06ghDQbudZSr-ucZIuNxsaGFmgkIWn_FY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLnIcwbpPPriVF0iRV-7-ACgqDC6xUNeFA0DhKop-4xQ&oe=69B2B7B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
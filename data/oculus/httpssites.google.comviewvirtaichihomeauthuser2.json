sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxNHArbD8PsQ7kNvwFHh7fN&_nc_oc=Adp5yRfOgWCRXCar1pcFmoe3YFW_iyc1MylbFiMuhH8w3b3GMPbgUFcBT8P8JJ3-Qak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWnk5CvVzomIYBKO-Y6t7pKMKr-1sinCUQvoHb_-q4gA&oe=6AE20D71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BClBi8xzoagQ7kNvwHyjLZJ&_nc_oc=AdrRB0uHs7Q_tR0n4xDtL3MWaA2v4cmJb-qINVwyZcJx2bff7IDlZhFjxKsbp3OmjnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz2mriDEWQoLtKj_ncNjXbpQuhlydhy_Od3ibqvDKMCg&oe=6AE20DDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-VcUbsit6UQ7kNvwHb-R0c&_nc_oc=AdrwGKAa3lKk2H29EkrVOtI0gFZRyna18dWfLXoHIyDOs6dkdAYy6sgOTLoHSEOg6Ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_CtY_u0YwrV3r8uH5vZ2LH4P7Dh4myewXD5W0Hz5Qjg&oe=6AE1E679"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ6tAN-IzUcQ7kNvwFh69iz&_nc_oc=AdrRCLOAbKa5qwOpoJM1QwW-NTA-RRBJ8pCZjfPQy9E2VsXq8bLI__hbNWoT7ZOkt8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJpXIEd8Ag8UOnLwLZaOz5EknkYrdmCNStwn8FoX7_zA&oe=6AE1F761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os0XA3hPfuQQ7kNvwGMZmao&_nc_oc=AdoNqcZxwOq_Svjev2oAnvmvCLDFag74T3onJ03IuZbDJwJ6Q4OXeFs2Cv57SRPOloU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ8n7V8Oa4dqrQ57QKrPeF0g_LLuMeEjzdNXSPkKRcRA&oe=6AE1F0B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9BPiLnIK1AQ7kNvwFsYOUy&_nc_oc=AdmRqWhCxu_Add5BZ89yW4w2zsYm2uQyrbwkZHjtf0TInNrgkSGajUq0vi0BUiVJy5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afydk-IhnlvktwH14XmSqSnC3dI39V2qN7DouxQgT69w_g&oe=69BFCB31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIktOEpolbwQ7kNvwFt3_mn&_nc_oc=Adm3rbVvdDynfvn9zv3qNLBu4VDxrFj-nGU7lXJM6TDOrykePPY2sNjgtLbXgUxD3UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl-uTeE87Xgzt1D9rJZOcx9u1Wm2ZUxHlfRjARwspWOg&oe=69BFCB9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqIbv1Nrj2QQ7kNvwEesXtP&_nc_oc=AdlfYFtQsItwBez_5B4v3qwHLLEpNb1DDCmga6wiRadbOYRfeWnF2WV0nYm36qfQqs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXjDcqEt-zHS1AqRrpHwBJDN20pKml35-o1Lc9kiHeOQ&oe=69BFDC79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7qm5_dlOQQ7kNvwGIySAz&_nc_oc=AdmtyQpeMwALrRj_KSpwK0CDvGnnvyENME_qKWjRFz9iL31l2OrId-N2z9WkxY0lnEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw28QZGiEnZihBCO_dDZutK3Q0Pj3Lm-Qy7PdtsxU7F6Q&oe=69BFED61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xmNFrHbcygQ7kNvwE9rLp_&_nc_oc=AdnhmKg41Zpuk1OfdZZmCGi094xktA1V9kjOEfZQK1STjqQ7tzGi9EgCFmGAGPjVnfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyl6g9vQM6F5_w0o6x8iIoqO7i-iRMLsKSc6APRr5f1EA&oe=69BFE6B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
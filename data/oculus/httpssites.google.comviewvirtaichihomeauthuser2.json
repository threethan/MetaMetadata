ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8g0BQW28T4Q7kNvwGZ2ulG&_nc_oc=AdppYTxkA26JW4wAcyYy4R0N-8RimPJUTHSbrvJd_yvNtj8QAjfc2D1SMjVV0xVwkrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx4NIEfDGLjo_Tc3JVS9vA8KMkcr8ZwNUXT_rcMpgF1Q&oe=6A60DA71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xvsffz_Dg94Q7kNvwGhXMTm&_nc_oc=Adpdpc5ozgVdJxDvxYnkLZnUzWlmkDa_GGKpdJZoS3rU8fZ49ifBBkdlVSRJAQHVt1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtBmjWsjWcoyPClZBQkoJTYzWxTIqMlyzaFJQ0vu_VEg&oe=6A60DADC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTIg4xHQ-yUQ7kNvwEcWlpS&_nc_oc=AdrVzSb3RdrUVwwRE5c1v_WnIqVbx9dDe_shsnLujBriMuNW6btkw_gLe9tW_-rckfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxg7Vxo69M7vRSZncTLfmmrxPezpGNpvo9bDB_4xL6Vg&oe=6A60B379"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ0IMocdExUQ7kNvwGIOmci&_nc_oc=AdrK2ZKzbR2oGg6GvjtY7xOf4oBsbEq3HWIv8ApKonxLqniPHfwO1X1jTOxlwk9mSmI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj_GU77_-fII3T0EmNEFb9pbAvUxPPjFJCWAcNvhmFzw&oe=6A60C461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWTFQrf2t-oQ7kNvwEs0c94&_nc_oc=AdrZN8pRPieiYZCkz_k69rn2052ZlIAZs9ZjsTah-3VUqlesfDleLfgRUyWWhmxUWLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy5LsyMtTywk6Z52vX1Xs2O5umAqEVV-agr0lYzB18mg&oe=6A60BDB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
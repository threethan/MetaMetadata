iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvkdEVrFvBYQ7kNvwF3v1FX&_nc_oc=Ado5wGTXgSr5n_QU8G7Jov84sODbOTgFk25atcGSmwRRcTk6dAlHOdNhnKpUfIdstz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tCxAW8Z15Ou6E3P1MU2ZW4iEDu-5QQuhLT7CbWW_6kw&oe=69E4ED71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5BqjERNDVgQ7kNvwEP39Y-&_nc_oc=Adpol5_LpQwzxD_V5lvNrAze2HeOI-sOFXldVDAy5EY5g5_gG9kjGk5dUBkIdMi2rFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oAR6UytO1hRSv9FNgbCCE64rAJ4F3bRpnphPA6CKcEA&oe=69E4EDDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNeIxhz77kwQ7kNvwHus8lk&_nc_oc=Ado9ovakRAvdogdxe-Rx0FebGVW4aNfm49FBjXlZrW2Mn96ck1PKE0Qr79GGXcZKWVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k3U5DeVRFPRkWCC6MOO_5ePDqGMW2pvdRMLKMu-qumQ&oe=69E4C679"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqA2gLxBmM8Q7kNvwGPgApM&_nc_oc=Adq5lJEYE2I0OTKyVehoor5ebE9aKrKn2ZF3A2AMKEgQeysLZdUMmRZdZryknnuoFlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38FQ9RoF4EzuXeiV_KbR8MOmvGF7VkveWos9ofV_mJFw&oe=69E4D761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAbrONtpmNEQ7kNvwF0iLDd&_nc_oc=AdrDBs-cIrnGkHsOondQBTK0WljC46DsUSMwPbia1ohDtHO9CeSNEd6nmTg_4mN7oW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zh9TGgrFGnmlYGi8X4kC6v0WoSuBncYTo33n5uf9eyg&oe=69E4D0B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
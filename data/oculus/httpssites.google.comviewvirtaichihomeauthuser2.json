25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsBkyPHPW9UQ7kNvwGpV9d9&_nc_oc=AdkzP2cO_kDDgufn_E1qtpV1pF2qfE0IOpURFysLmqnmkrNFAAAS2_4MNh1gFLKS87s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEQdT_c4wbaoC7lKupcckWKtYEMcwBZG7KMt4fNHhSxg&oe=69AEA7B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjjC-BNgpowQ7kNvwH92vmf&_nc_oc=AdkC5_v-GO8FTCymCzRUkP8m0ll6VZUl6IMKrz9Q_DdznYreiqTntuDwlgsppl0f_2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw243txtimm2oAXX4VJbzBn0eGNNAPLU2RqfY2mL6x3Ew&oe=69AEA81C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJj4ZgYSHg4Q7kNvwGyQASC&_nc_oc=AdnrWEhtFGyKtFa0mk8I_qtDf0MY4564Sqm2iBgY0JbJmzksdnB6A_PR_DtXfyTMGnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAtU_zZxOGAv2PpltZXlh7L-4fdXBmKFKASdJQQNuFEA&oe=69AEB8F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqxEgemXVgMQ7kNvwEM8OLo&_nc_oc=AdklR1QtRClYSGziq-JzvmmO75SSlbm9Txt_ivNwvsduDBqF_jRNDtj8XdOVkAr7TxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxOECm_Fey6B0aTKWoHvcRAP9OULBQfgjxk_elhFUqfA&oe=69AEC9E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwxVW22-NEQ7kNvwEkHFkL&_nc_oc=AdnxewwtwHNYIyONO5rGhKxVomWBAsmDG2_0UOJXxJi6HL1l1IwRGfAzbqge_E3bBLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAbCi3qnKd6G8P-XevxvzQ1fsc9q5COZTCpFHjGdH2Qg&oe=69AEC334"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nom88nFIEcIQ7kNvwEsuDgQ&_nc_oc=AdorFHaRmM4cV6n6AXvRT3WXT2zzF4FVkcahBrLR6nEPl_sFW9s6RV9Ly_u1ZU3M6s8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7KdqrTZ2pI2w8UwSchB7PX_0GLODQWG-imrs68ZoLkg&oe=6A9D7F71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MEe7vvXNY0Q7kNvwHSGHTq&_nc_oc=AdrrBJ2z49WkQvOcN4q5l9eLRJI_1lZz8p6Qegos93203NFe0jUzJjYDoHvu9IaNWBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFYc-BOets8oB81rhymv_ztGdRsuzW8_fgbmBVuv4zFQ&oe=6A9D7FDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF3-mYP59JAQ7kNvwGhklrO&_nc_oc=AdrWmMKjFAla9kpBHF4lqEL0J9JvHQ5XjakQjMJzTdWQG78VzQg4yM8-ppjeOJmm8sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwP_Fz-fPOoHvXJHdytvrzVe643UHf-vK9gJMoxDJNZw&oe=6A9D5879"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fktIX4NAltoQ7kNvwEaDRWX&_nc_oc=AdqYLwy88XV30QwOHbilBp3yjxUoPQUt-X3U2PqUqyFa8qf-ZD5Olk8gEj1Lf1cVL8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmXOe-39wS51KbsrLD1wY77CdFid3dTOBIgZWVkFBagQ&oe=6A9D6961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lpKQLKA7bYQ7kNvwFixV9u&_nc_oc=AdrY4g71GjVzq3s04qgKLKzIF_EcrmOJthpEUVgdsuolGB1YzrzeMzFA9UOC6a12r48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9F8yPrhIJeFZP8oka_IhM36RmDn8BEQUHCUIAhNFIGA&oe=6A9D62B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
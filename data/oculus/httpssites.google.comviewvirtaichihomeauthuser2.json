dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0O0rOHs3f8Q7kNvwFz68CU&_nc_oc=Adr8T_Vp2PA20Jl2S9QvkvsgpI-rK8S9KLGAqWaUEoso05xgeunm_HTKBrlSUejGBh4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsE58fWsPVDBO8xnNlOgYSzeZGzFCKEh--3QqsddsO0A&oe=6A5A42F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jY791oJ_OEQ7kNvwF4eQle&_nc_oc=AdohSeiPFiFfH0CnPP1RZ3y2veDvDlptH_GsycQhbhOnNd_wJ4IH9duQbDv57A7xZjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN-LDBa4opk2M2S1lmIe2o0F3n4iI5ifIDWMt7C7jgFQ&oe=6A5A435C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDZGKHaHjVYQ7kNvwFtjJ_P&_nc_oc=Ado_FP2uLGYWJxtffa7wHNPwtaSSl1SWhm-bpYsmKDqa4muUye_oSFlPN80N33EB4P8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv_c6qR0NHvutfamDpwH_qowwcD4LLbbxg1nJU-uoBOw&oe=6A5A1BF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiHMlzlOsdsQ7kNvwG8sfSx&_nc_oc=Adr57usuSm76Ne0-11wInbeLX4tYpFTNue3oUKlRr9xEBfo4CMkIDk0Jf5LmVXpU4dQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm26gBRBfzrEbReWMXeeLcR_c54Y7GQAjq3l344qxFCQ&oe=6A5A2CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhuYFjZxhGgQ7kNvwFHZxSb&_nc_oc=AdphYJ7YhFEnL0HVhWBzJOC02VD8biLyiiATt1dHHtXri2EfoahYOc4oGfPCctInYoI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqQYOQz27SRPygxFZvMFhDkIbdMx-ZUsl7u6hshC9MAQ&oe=6A5A2634"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
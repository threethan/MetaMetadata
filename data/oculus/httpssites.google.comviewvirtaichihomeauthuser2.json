iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGQD9_vkUCsQ7kNvwEKcTKT&_nc_oc=Adq8xsbDO2VsM3T1_-K90UE9a9dtCWYHLDfZPNHefiE31tEf_6NXtp1q_6OJGO0cF-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aR22CPri7AwrlLGvJ4cP8q_WRlzfxF0BTZMq8eiS2Sw&oe=6A1EEF71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvWvVw07q24Q7kNvwFbJx4-&_nc_oc=AdpvO6zhwMf6A1RH9tlRyZZ6F0IamL001-fJjKhC4JYUVrKXdYRe92fgK_H7nkCLiwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4szNA_jFdz2uj3lgQw9TryDAbFLVTZ3hXfLvRdpqvyEw&oe=6A1EEFDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7uhZe0YmugQ7kNvwE2mp6_&_nc_oc=AdoKk3fbooKzTnvXqX90tGD8dcMGVtmhSbnesCx2C-nJpy-LNxh-HGzjmc9jIYRI0Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55yFygUIblWJHeCnJb9za4cmlt5s4gfqJBh-bo9IGa5A&oe=6A1F00B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8muHGR5rJq8Q7kNvwE5TPwi&_nc_oc=Adq0AZ9hmrQ6V798wE8u9yWIYlVCtQng9nbJuQBfT-MPEYRtg4NubaubpqeF_PFwl6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SPc5f0nLoHYhj5nFXEkEgURQ3azNnubWLbZ_yft4tOw&oe=6A1ED961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGdCqMIFgK4Q7kNvwEnMoGf&_nc_oc=AdrdM55fi-UVp1CYsw-QW_Fem00B3NJ1dK1MuyIxg7HHcPCVKhbxGK7gPGy-aw9viXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N6NgofbhRAqjgiCBhdlw5SSxk4uuqb1s-1uIBCHmiSg&oe=6A1ED2B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
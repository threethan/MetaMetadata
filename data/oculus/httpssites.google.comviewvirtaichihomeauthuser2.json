atl3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuayZ4DYlkAQ7kNvwGL9BZo&_nc_oc=Ado_qXQreKRZQHFQYFZI_d_UPH-ARBFuKcZIG0D8c9QQWJoHYCHcCu10YONmd2J-s8w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfC_8UCvM8szIDEvJmpJnVfcAn9XegK5tJKfn8Nsmh_w&oe=6ADCC771"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqWOue8KFgwQ7kNvwGF_Dcs&_nc_oc=AdpCd4r13IDwXy6QlvutoZ_daP8TNqxVn008yperrTwv--06Pzcf_kLRcWMOlBROZKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaKd5okqZO_wN0FErYTtQ6-ylhFwXWxQQsPiQPGEcguA&oe=6ADCC7DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59wAP62HEHwQ7kNvwH8n1Px&_nc_oc=AdoiF0n5HRLXoVtvEy5uRhwwuv5cSJo7IVzOzdECr9USTs85ZgCvo1ZwiwIkwjpNP9U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEMjlqMQhQiB4mOhn6UsJqaeASmdOCRfMUFgXUe45few&oe=6ADCD8B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUtK9rLMfaEQ7kNvwFixror&_nc_oc=Adq8Dsm8pqHnMtOYX-l-j7KPncE2IOhE3cLEEfV3l1ucHUJAC7tr-8G3TUjd4LG6kv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo51b2REDmOAHT_JpYi-9xvqXHYRsHOiLWgHnNNTV5FA&oe=6ADCB161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eK9IVUXwU4Q7kNvwHOwrNB&_nc_oc=Adp48_PzXCbKSHodHJREhcTnyXML25SX9vukY7omESalx4LLHNyrn9puQAGiBfNmrcs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVuFAFBhnbczofX4_rPu7Hlvd9nbnBIFUswlBxNbiG4A&oe=6ADCAAB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
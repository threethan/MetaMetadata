fra5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV4mFv0MaGcQ7kNvwGoFrGr&_nc_oc=AdqobkbXq2GSqPZVLL0aKFwGHBglRvnvbQKqQ4Hi1Uy0orKEKyzfVLTcw-pXTsgZ4Yw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz9i_0CEQvmK0zFiYxjim6RNWGLzLcsrk0F1bYnT9Rew&oe=69C7B431"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zBMU3Zu9IcQ7kNvwFzsMD-&_nc_oc=AdpHDdB715ucJJKYyZ1ae6arYAQ-Oxc1nFMGkKNsc3LIQtZwN342BRkvlIxvwQp5Myo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJRKDnJuspQEjKe21e3JkWyoRabzI9Qj828gJSoaLCgg&oe=69C7B49C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIl7vPENYQ8Q7kNvwE4c3-2&_nc_oc=Ado8mQ-jgdzqDK_9Ij5BwdKywuvBAdyfXgwzD2MrXThdRvIdZXkmuYCl6pNf-RIqykg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0QZW5h9rf2qy-ozoFlD3st9CBS9-kTh6s8Y8yyDp2Rw&oe=69C7C579"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqd6Qc6i2IgQ7kNvwEEvQHw&_nc_oc=AdpGiCEKh0ycFR8vuuPuuCP1XXGztlyG1Mna53MZOPw5jt_ezJQzxmfqMhFDZ5Gyvhk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrXuEvZVaW0pt4M_lIHKDm-P17WbhEwUE_z_om9Y110A&oe=69C7D661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EMSybx13qcQ7kNvwFK6yyt&_nc_oc=AdrhGqPhG11afxOdS4hFflaSgA4QvACcltPhDysfrPPMYgVLMfqfBZI2leIo6a3biHw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwDil1efmqqzpX6FSBKgnRf3VIrbWlw8O4QM5QFFCPHg&oe=69C7CFB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
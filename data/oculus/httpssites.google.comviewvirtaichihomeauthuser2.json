fra5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0O0rOHs3f8Q7kNvwFThhh0&_nc_oc=AdpL5BYiF_PTqEGa-z3LrkMDc5vmRc8pvsxc-EnGgDLB2JUeFRHxIteYNTFC2IOvgVg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArUEOOwxYjDyYl9nxTYpfDUPSOffzxpzso6wxKnLtloA&oe=6A58F171"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jY791oJ_OEQ7kNvwHPkgKz&_nc_oc=AdqX5421O_72DL2YXUQbJkqS8gelKhYLzL1sYlGTyFDIxaHIz9ye6F7loc2wlF6fhNE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBIJIWzLd1oG5Bi8z_8e-YJd7zgE0gskZxXuG2lDW8vg&oe=6A58F1DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPodZqR3pksQ7kNvwHZmK3l&_nc_oc=AdrJBWrQOOTrFNBbEk-69nLvgM8o9ALxH3WroUh0-07EiiJJD-DA4KmTxlXeTTj2LZU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3LVaEcAQ1Ew1LdfdPL_yk8rhUs1fBjCaVgKZeSeY0ug&oe=6A58CA79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfgeGYVEC3IQ7kNvwGSjaOB&_nc_oc=Adpo4I2m4d5Ipu4Qu5JE3o6dhauh_jRZmahLK9XbpO-eGKY0mlA96dIQcapfkiFR8lA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjKJgQI0jvwvMI38u80WD5tnculEA-vdILaIEd1g7WJQ&oe=6A58DB61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhuYFjZxhGgQ7kNvwEzBCkd&_nc_oc=Ado920mBE1sGjP7sxLieyIXM8bJQsQLydaWqFBOtZbZibrmxz6NNhbBZo_EgSK3KV_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmVXiyuDUCX7Hj2VL5xm5R2YPRg8osgLQRZdjXbrZynA&oe=6A58D4B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
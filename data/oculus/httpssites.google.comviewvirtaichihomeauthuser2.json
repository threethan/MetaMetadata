dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA1w7TOzHIQQ7kNvwHXJlJh&_nc_oc=Adp8uMjPsGLeBiAUgBI24y5yq2CcHolMDcsGqhZgeSwEcmFZfSHCXflbrBSJZU9WKUM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af193kYS992z7maKzscBaji3glYtimrW8Ub1wTaxfDAdwg&oe=69F4BF71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVaZIIo8mAcQ7kNvwGZTiCX&_nc_oc=AdoI7hmK76Omd0XzuKFK4uPmFWG0Dwt7Mxrek-oJN8fZTHMOqOShruib2gz1efYHqyY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UKZd-wV_mtNs5Pgp-CXO6D_ylBOAz0nPFPp43v7d7aA&oe=69F4BFDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No-Sqc3h00YQ7kNvwGyTfcs&_nc_oc=AdoJm13D-FexaDhHWs_oI17EjFyuA5FvuZYvmfX_JRzstWllneT6-KzlObEpwpTGK1g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25BiZDo6eRIWs3hrUSJ79ukfGCij9c1gsmqO12iKktGQ&oe=69F49879"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kdj0VoN3bQ0Q7kNvwGC41YG&_nc_oc=AdrBbVRwD5qvszSmMHP3o_7CjBRRfH5aQ5FMF7CZqQ1GjdKD8cgwPs5MRyf86_vb_fY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iyod84dCggC_aE9Su2rJrRlfDk6hF_m9niVc3VMO42w&oe=69F4A961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCfMaYRkFPkQ7kNvwHmB_Dm&_nc_oc=AdoGx_5Sr71Qnu_prUjI8yucNFGdNEhB9h8wktIw3nWwrI3AOISKrlHVj2YQtNlWwnk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lJnto3BEA7TOhJzhnE2wOEbr9rmU3F9DGYv2y-dKggQ&oe=69F4A2B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
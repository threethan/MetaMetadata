ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8g0BQW28T4Q7kNvwGUQpTZ&_nc_oc=Adq35N0gpzcIJWX99-F6LPSXU5gXUMRcGZPqQ52Rwm7paNuhGUG3cIO_P8AUY4DqX7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8KuqUkm0Htzy8Eil-i_KYQPpG1duvtPanOXfHiE4TWQ&oe=6A5F88F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vPTD2_iqVwQ7kNvwFYOqAY&_nc_oc=AdrxWqsN4e5MERxTKQX__Y7xvbFXIhMj5eT8nqzw0CrkGt39Uvmqz9GNRgQ4hvk8JHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkzuMKODzJ4LbJbnIu_KXxYPb32QvNucytRM3EvEd5xQ&oe=6A5F895C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTIg4xHQ-yUQ7kNvwH8sMPx&_nc_oc=Adr20CFSfErB9eFPW5E4lP-phD0yQbwiF2G9Wx0FOBhu5N_FoF7ixcfK8jRkUTSnfP4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0i2QzWqft4kzp_hlZvJvvDoz72HBksXJ2RleavAUzYA&oe=6A5F61F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ0IMocdExUQ7kNvwEkMIni&_nc_oc=AdpO9cldDSrNog46m1NrndrHQ92TYffLMdrOG4Nq3zQVQZEUmaDnFEguaCFJPjaygfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyOZcJ2uhjabtU0d_LwACXmC2icGq5xmu06qjXVGXVpg&oe=6A5F72E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx1_C8fDknIQ7kNvwFO7B4M&_nc_oc=AdqCtFsGXE_4bOIIGCGFeUs6lBid5WQbdU-8i8bwR0TXSPR4IXKvJSDuC4tNlxnL3lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb3M3Ijdja2DJ2ooOnsM5GX4Pfri_jo0fKd4JvVSaYiA&oe=6A5F6C34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
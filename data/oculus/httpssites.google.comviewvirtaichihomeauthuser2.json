ams2-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrcIcfW-K3wQ7kNvwFccO-A&_nc_oc=AdrTfoV0E38_xo0E_vI3imSDvij0dCmr3w_Aeu5iteO_ihjIiQR2weIvwHUSMNnh6M8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3isdAvcmxWPwKnkR3fN50GxWjAiTtNYmDFBvdWPxfBdw&oe=69DE55F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEZ9f4CaahUQ7kNvwHm_upt&_nc_oc=AdpRjQwXlnxUa6sUnP-7LAVf0G82Jkmqgf6j-RKeUezP2fqxFiZa7AGhRpvVyNwbtFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wpNU7oz1HU1dz0iFMXahEObGx3kAl1aWsjF6W1ZEQPg&oe=69DE1E1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUCgLeqmW-sQ7kNvwHZ2d-X&_nc_oc=AdrVFh6oviayNayqEnhzcRUM7qAOjcbd5CRjZ1p7bEAZrvCF-mdKLsdPNg539-r3Q60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NOUB2N1H9FhluXRAwORw9GeilOsWqaQwWsZYUINRuFA&oe=69DE2EF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_2nLzXtmGQQ7kNvwE7rLql&_nc_oc=Adow3-_wHJpu4wB_Mvp0SXoJQw7Xaq-uuclsz5TuNYsEz2oJ2D0dzHVhVQth5P4yw2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_tcPNU02uKoPa8a9Dv9UIJSW8RyI9-gC4KRuEFUSahA&oe=69DE3FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnbCTiQYXa8Q7kNvwF526pi&_nc_oc=AdqJKEGPVc7TnhEp2V_35k66FCghwMaVl7uxUBDum5LpGEoiqwXs2Kx8Sq2o4aslikQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39Yg-A9SbfDvkBbVGCPeQU7N_uXwkezFdSbB6l6-fMWQ&oe=69DE3934"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
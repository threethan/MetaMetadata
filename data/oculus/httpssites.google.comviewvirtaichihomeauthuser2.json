iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA2cRENuwNQQ7kNvwH8vFEW&_nc_oc=AdqTSRuXrC5lIUm1Dvjqkxh2hYyQecCCIsKDCoKhDuPbvV1DIeY1mGvZvWcFHx5k11Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfvMYSYtqaYkGkuKqvIuP9yznSprmjsjPDBTSTGkldyQ&oe=6A491F71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_eHu7iY-OoQ7kNvwF7-qWb&_nc_oc=Adr8w1WJ1cJb8qJ9Xrn09jQY75k-_yid7IUdXVnsFxssff_2fkYTfYPvgn8Kk5jgAC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo4ILTS0pjpVlmSdzczWZ52cjn07T9vwxqUnvMRrVQHQ&oe=6A491FDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koeofplDVmUQ7kNvwFrm_Dr&_nc_oc=Adqgrf2epOlyJGcc2CrykwIby8B8pnGlbZy6FCb_2uXu0qpxEiIVX7JuYgHH-nYnocY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPqY6PxqofX0pXW9ADQ0B6rJ335dTFAd-YIO4psvtEpg&oe=6A48F879"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28Ys94bEPQQ7kNvwFg_NN_&_nc_oc=Adrrh61QTZVys9jf8Yo_Ia5SIvFrs_nxXa-wTbN_CjfJG5BFUTKEv1I5Fi0jZI6Ix5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBppcgeURXUbdxF6ZW5Ay_2EsaZZGVmlRtW2O0ynWRakg&oe=6A490961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w1RvfyAnWIQ7kNvwEYEt4C&_nc_oc=AdqMyyGp_8LIlgRdrTbMoDi67-fHBVLUS_WQTtFDFYBp0qVcHv2sXdL2yz9dM3Q47BI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwvYO_0p5-teKq7ynbiSXocC-k7g4Bq0Rudjs2tBWY4w&oe=6A4902B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
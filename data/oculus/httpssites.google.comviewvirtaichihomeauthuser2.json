25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOrO_8lXBjIQ7kNvwGCOJtW&_nc_oc=AdkCH_XGw3m9wK__TQiOTFmHD3P83f8ZnrqsjWF6Hk3E90183EpTwQkbJ35YyKa4Ros&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4y6OJ6cstnluHSnQf1WVDl1gXnlheQBD0gFB83ZTXag&oe=69A961B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYdN6cFgIEUQ7kNvwF_y9bs&_nc_oc=AdnlLk4zcNOCSEHcxJip1NDWZkAlAwMAiVIBe4_WYTQVkgwit4Hi7B_MFAjIHMlaVKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsvntxIslHDjnYdvPpw_4jXKNu3UepApqB8itoVNW-kXw&oe=69A9621C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqtSKc9DcQgQ7kNvwEjENjZ&_nc_oc=AdlQ-rJ5o0ijo5CR1lqvdMKjOi21NaXNWy5Wud08_VTO4Pf8EkN5hh9sA0oTckb8L0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftcATbXHJvQJ4RBHhVu-K-Wmfo2I4d_WEcQoa_vfdIyCg&oe=69A972F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ktVuXXFo7gQ7kNvwFB5LnJ&_nc_oc=AdlmiPFfOau_OAitxn1zbONeuISny-qxWuAMjG1hFN6nlk-Y3oRVKr-mf8Qa7NubdLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft4RfFZe3_Ecxe9EkR0ASEbYQGquWVdZtTc8LbeRse5aQ&oe=69A983E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2yvAUSRM2AQ7kNvwH1OUkE&_nc_oc=Adm2IWuvu-RCe6e5aMMjJUebqUcj7zcD4RFiJNvC8m7lFrN2KoanRhUZ450-Btlw-aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftlxBjDH-QwINYiWmOmfHc23_vNk7aJbVN2uuzy7dK-Mw&oe=69A97D34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
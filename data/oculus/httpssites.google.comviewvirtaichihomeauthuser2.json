sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuFifSwvwL4Q7kNvwGUw0cX&_nc_oc=AdpTUX7sBgD39qu9wUTi5t6DaPAvXEl5Ee5UXronhgGPqQ63Z3bhAX1X2SFSpHAylro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFxBKGjcXpdNp4S3QjCeWUfv20QE1a7IF53cGJjHEHUA&oe=6A901831"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlwJ2nDOhYIQ7kNvwHvEcT8&_nc_oc=AdoM5qlZq0DS5PO3oL0AWGe_kK4whDuIsmsjeEeQbvbrZEnLhRnv6V6Gx4fw7TUvIuY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZeJvlr_hWRXhQvm7GMDaMM4IzFe9RNkfV0swwJn6XsA&oe=6A90189C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEAcWqePn44Q7kNvwGy7yWG&_nc_oc=Adrq_STc157UcHOrvt-gj22dviUMaf_TVOPykgm4_civaW-OEcvwuyqiX4htS0wp6mQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9nk9ntscceYBYutwZOFqEnZ9nDM_nZAJ4JA-cXpvgbQ&oe=6A902979"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7evyjbMhakkQ7kNvwH4-sOp&_nc_oc=AdppOSw5MMOlO9TIbouGO3mFNSBqJFpxCu2DVBFZRUEMnzHMzpO_zauQGWEOLeI6Lno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDXR7TA85aAx0iKZyJupB4ZbacrQ-fD8oJ2a5BCApNJw&oe=6A903A61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TmLP7Vx5LwQ7kNvwFIcERF&_nc_oc=Adpr-k3SgtN4xAxBLexs3DmkFHIwQN4llBWIzW5zmC1LxLUSXNeBvjgVwQFn0mzRneA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWFaXNu_MLhG3nS1V-bymm9F53B1M3Fj1JAT-ekBgGiA&oe=6A9033B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
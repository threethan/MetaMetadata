lga3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZRxW_FzxK4Q7kNvwHQgeZb&_nc_oc=AdoBNnUaPE_Q9v8Y65_UCH-QXwLpcgcZMDyzYj58T3T_mSez10AKT4oj8msux66DynA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d9ZWJ4_iUE7-LS28FkcLW387TByZKJGFwwDW1zuKH0w&oe=6A1311F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRsetUS4yjgQ7kNvwFgkxP5&_nc_oc=AdrBUgIp_SX6tg5qvkH6JATuaa056az2DduiweiZZainpNSMnkpUu8UdXx9LevsQP_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IBPVWhob9VZ4ACLHzqRd5qLg5MPcGKXwKW3xIUs7-yQ&oe=6A13125C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0AXmIiMn2YQ7kNvwH8VqQc&_nc_oc=Ado3As9UcyEhZCWOTZ-kUCWu8o-X3GezPD3cUu-ipVxcjTQ91L8Xy1NJB2UhmhDAHCQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nHqH83cExCydn-G79YK91GTPvPveWorixbBL7_xpfXw&oe=6A12EAF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEQCJ4q-Bh8Q7kNvwEXpqkt&_nc_oc=AdqK3N_lVVDYnmlrjrFF-sZdzYmOpJp0iPu4BDaNsd6apYM46ZP4ZxEAeS2PZzqvYtg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NgJqoGCmyB3coEmNxtiAFpl_gcpAF9VpQky_4eWcfQw&oe=6A12FBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoCHd7dXcgAQ7kNvwHc-Gt0&_nc_oc=AdrY75h7WFYFP5BUrktDzHxmCm53Z8tzfeIOO7QhB3mj-llgWomv_BOC4_9Tt686_8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B-dtRiCqsw7yIWfqj6ja9asEXTAhbt9z8F7WWuOtUwA&oe=6A12F534"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
dfw5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jYmPIfhMTIQ7kNvwEhnZGT&_nc_oc=Adrsct0CGBm9SOz9Zc-QqIXn7fg_Yw_sgq63D52RXG1DHQLX6f5D7NLDOZu_7lREXtE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qYTi8BHs5Uc-bQzLGGNMcAAy_w1WhclzgsIY2y0IfAQ&oe=69FDF9F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIUr42UE7hQQ7kNvwG39R3B&_nc_oc=AdrnqrcEeaPPprAqj7OgvBttyUyjGww5twnH91Mv-zyJt0YqZn1eBYnFAR-_IX72ZhM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hSnbOS6WV0TOehefREA81bJJtLTv8mrbZLcC2MJaK8w&oe=69FDFA5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvRTe1rAdisQ7kNvwHvk7ov&_nc_oc=AdoKCA2_gTAjkAtjz2Wk36__Z-3yIYpkHFG9OSaItr-03dK7Sj_tZ9WFHkffc3rp0r8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tn3vdFMS7W-15h7qPzx0-naZeyl8yS8q2uRY7ngtA-Q&oe=69FDD2F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyTQvrQzt9UQ7kNvwFv7QDQ&_nc_oc=AdpRCKGsKZDLpbenvCwxtys39x6r6n75a8K0SRohrdO7LTrDxtX_sT2_7p8UzLeejdo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V5I-lX5Hk4k3MlABvQnfl94Qd_bT7xW19Ll-0dVninw&oe=69FDE3E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_cLrZIUN2wQ7kNvwHihpRG&_nc_oc=AdrCfymflYztOHf7B6K2oBA9ogU-r4CDRrBFuA1FRBN4q7z6w48m4F3XsaWKGOc0hSc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G3ZMvmGwp58Bu96heFA3H8mTL_usaua1WeM1SkY4quA&oe=69FDDD34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
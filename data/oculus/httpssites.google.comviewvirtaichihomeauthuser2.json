dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgLj7OQQCo8Q7kNvwGbSnzR&_nc_oc=AdoJi8YRh3QFc8e4B34GYaJHIxQxtflZs6kU55_teabB6JDwHGL8ti6x-cRlQwkhZ64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--u2seTodScxbx_podPBX2gzBahSzuvCuoSXPmVWMVLQ&oe=6A26D871"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_xVJSOphfgQ7kNvwFGNbD9&_nc_oc=Adpk7fW59Kgop-mLVOO3tm1LWERe4rZiFjjS6-9Xt_iSxumkNnw5nXORmfXtQC6FXiI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yZM8ie0WPN7KrKoconwhxMRVmPjCt57VJ3_xkUjbqGQ&oe=6A26D8DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCRd7Ac5-L8Q7kNvwFsX5DE&_nc_oc=Ado7FUlp7EK_5t7q19r6qPfPzffs3jZOBt_qwMMkIAX0ziZSTIpdquhkDAxTgidge0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BfutLi8UTl2d13TyXfY35Uy7BKsx_A-ZhWpXRJ8oOfQ&oe=6A26E9B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QpNXYh4XoEQ7kNvwEsou6R&_nc_oc=AdoWg9W70Jmw6sE1rj1YdMmnB3AHZyAhiu7pGnkkm19IAKafWwbxyBH15BBXhkgwWQ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FvNctEmibigf_zkPr7vjpCSU8emWs3N8_gEkQ9YHIxQ&oe=6A26C261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDAzvPjRG5QQ7kNvwGo1LFs&_nc_oc=AdpePf7u334EYlmvTfQ5QKO1036Rcgqe64ZdImhFSLVOTGX3mtxYZnMfk1l5_F-imu8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KpZ4iKkWCWpQ8H0Z2J5NDw1kT-7B2gcL4JK1I4wDO3A&oe=6A26BBB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
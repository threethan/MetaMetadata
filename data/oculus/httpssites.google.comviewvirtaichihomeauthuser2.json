iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSX04Iyl1bQQ7kNvwG6s5Tk&_nc_oc=AdqDuLcggNrrwqfXbRd1ZL0lqCc0jMBYhS1FGztVVAbWe4GXA881n8HwG87HFbCiA0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl158uWykBrttHxwJTC6sz0UIDZqG2QQIyw8r8fYpI9w&oe=6AB53A71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDwew0BxFRoQ7kNvwE8EH1A&_nc_oc=AdpNcinVwdvoyL-WzxMn9dsDm7z4euR_IZbnmga7PH15CRwS8ATdYUNxKCMINiv8Pw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj06u53hbkMm612lREIevHzV2vfM0cPJmfBevP_a7Y9Q&oe=6AB53ADC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwYgWEuWffcQ7kNvwGkR2UF&_nc_oc=AdpOjMSIR_WPcbNF_ui8Vi5XqDmAMLpaYJ6LcXadsMwqNGdyJahS_9JGoEe6RM1GC7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1FKJQCsHk8YMVHqQawRf7b-g9sfXs0qiSoowhgfroA&oe=6AB54BB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxF8sxOYlboQ7kNvwFoMjiF&_nc_oc=AdptiZsX86evdqhD6SyNKMa7Ribq4MZqvnbdgZM5fEufSJAayazcye9kPpkeHtw9stE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKunCLEtmgQDN96Pv6E_vAI3oI-jYUllewqQNkk_YJCpA&oe=6AB52461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGMeXWfSDYQ7kNvwG0IK-y&_nc_oc=AdrF6uNkPbQxdODY3x7IvJ1CSIGvFmB1B160Nbk_YdNxtdzIZ54Q11O32FzWj0xyMhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-XNYt4NEJJ9DfZnZE2eZEjlrJ6vBPBaeOcybzTMg-Bw&oe=6AB51DB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYNHsFvm5MgQ7kNvwH_KXNr&_nc_oc=AdqAUH2FpB2yiLZwu8lK7dA4gr1gEKxkZSl9IywoDWYDI-MFtU3V6IweRyMZ3-2hcrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzxFuD-KdPV7mK4KaTcq6EpH8iy9J-SHf3NKxs6GlGMw&oe=6AA56871"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-XatSvXV-IQ7kNvwGrIwR5&_nc_oc=AdrhmeEgr_dcsF5sM1LmzH1phIfvn6LJ9SjCkVcKHcjqvOz7bQb0N2pKdspTsE5EWUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSvovDDuu9g-91prlpZPJl1gd4xvj5Tbsg1hx6M7tpNg&oe=6AA568DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBywbchZGWwQ7kNvwHfumYk&_nc_oc=Adr5xkTCABxb27A5-U-CafIs6almvX10DEiECVVpJJkCDxGpi7KDMgUOfbvCWnAUKQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcJCPDLKfIEKc0eykEX6V4NpWMbxBXPN8eDf1ubyusJA&oe=6AA54179"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnKwul3_J8sQ7kNvwEgA1a6&_nc_oc=Adrx1SD2QLRkNJmMSkQsJjO3HWO8-xcDDXas18e2eXKgfYlgckNbrrJ4YhNcFwELXjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbCVuXz9zehXGFHThIDgIxSGzXmHkV48JI2Z6-frh2bA&oe=6AA55261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4AetQPQT14Q7kNvwH6VGO7&_nc_oc=AdqQQTg1NCxXYPt1jOTKOYkoRSEYL0x5DoC3B0fLxcGnILp3LozaLbrxG4hRfHNS9po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvgugZ5OLayYO5vHfF7ky-Yusvw5d7FBdghVY7d26ybA&oe=6AA54BB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
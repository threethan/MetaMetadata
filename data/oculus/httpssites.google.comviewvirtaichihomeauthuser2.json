ord5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV26IMQ-hdAQ7kNvwEhJT6K&_nc_oc=AdquZ4k3gvoPlfpIlDnHNHoEAl9qS7rqPBhIv9UOImaISyV3L0i-a_ShI1gp2d8RZe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ1k-EjOHyITgeN3GCshTnlMrHdkl_16Lm-j3LgkghVQ&oe=6ADF6A71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BClBi8xzoagQ7kNvwFsxeRF&_nc_oc=Adqe0qDaSsqgo1ti6itwOKWYGSuVktB3lYoppV06u9VkBRhqz_0DKiHISaAX_yE59QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7YBPgDmDolayAyCq5pik9ILx0mJnaku_l1Sjgy4WcWA&oe=6ADF6ADC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59wAP62HEHwQ7kNvwGfI8lL&_nc_oc=Adq62OlBt0B35CEXqrl9VBaTy8BDJgaW-B7cYFHmpDjhR4w_4qxesMlYP2JOtvtmUuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3s18mVIVm6DhB5lqZJ-Mpnu1M3-b57e7UMhqwLOu3SQ&oe=6ADF4379"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUtK9rLMfaEQ7kNvwHEnxpQ&_nc_oc=AdpRi3gP07e-zT0HvHnAYIUBNhpEj0kk8menD_kGRRCraZwWzy7LC9pmgJMjYnTLFk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXT-E1SwYxSXrwQDT1pAv9CNILbmTg7eU5uVPBSPa6AA&oe=6ADF5461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os0XA3hPfuQQ7kNvwE7p6TB&_nc_oc=Adrc1nz8hf4jseWoKcEdDMjSein3j-TYGh2lTZhdA15ECiw_31PWH1NB71RN6u4Mvvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqgumElZfIRrMTUyztlBTxA4gBDc68qaD2gWvH_zqwYg&oe=6ADF4DB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
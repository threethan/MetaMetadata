25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bShVKsEB9BUQ7kNvwF7O2Za&_nc_oc=AdlWYfwdzlIkAaEbXCaCd9KFr42DGJeZNucWz2m8KuaG1v9vPF-ty6Z8jkLSU0gPaR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpaKFAulIZhb78XEdVQsqllF19geUXh9hO46lU0_OpgA&oe=69B53F31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm-M5Ukrw6oQ7kNvwGaLsVa&_nc_oc=AdlyxDVKSZ50hrFb3Rhv3AfKoDqG3qmMVmbZzp8cQICwpOO6RviGEbMMFHtqruGcenw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi41b2_Ma3Hj33sEKUkmAeSRpieeLiw_WY6A0jpAtQvQ&oe=69B53F9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr1V8C73atgQ7kNvwFYugH5&_nc_oc=AdlCvinYjCsvHLZpsBHF0jtOzCAgBilwYZD9QBR8RITohSxe5fPDgtZf-zU6MwWTHCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFIocQ-pJhODDUXpH4HUnRgHTNMop8evIjVKrCvBtQyg&oe=69B55079"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MeJ5X0qC-QQ7kNvwHZLzm7&_nc_oc=AdkiX7SOKq14hGbCCGCvQMSZ1GMge3680g1zexs8tHmIU2kUuOVVT8sqbhyKuNTk11g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFO1hAE0s95a15m9JU5mUH4Y21H1UETLqKPFN7t74jsg&oe=69B56161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdi3fcSr79AQ7kNvwF0a_Mn&_nc_oc=AdkQYiR9wzGxnTQ-NNLhdPZSSpoIDZaBNpkctenZttQ9MxvEQ9H2A7SavqL0IDBfdms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzogNEgh5NNNQDl2GAHAebBRohmD0EnzLBOdcr7woveEw&oe=69B55AB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
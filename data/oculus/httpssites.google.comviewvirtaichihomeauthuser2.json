iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXiyWprX0uYQ7kNvwF07EGN&_nc_oc=Adqm3k4KJaG-b9R-61rJJvfTAQbKJ_4yDbgztfoQEOFm-ce1mV3qGZlgPk92tS0xW7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3-ThVzxrs3wMiU6qrjS4rzJbyQvCJy8NlaDgO4uLdpQ&oe=6A4BC271"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_eHu7iY-OoQ7kNvwFE2nzp&_nc_oc=AdoUnizAahk7NTUDjhvXvemf48-YrkaFmD9Bd0nl0N-YtHYtwMQRpw8IQlCCKeYFFdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxx06C_4Z9l7dMG_tDXysI5fyduwI5SFZWbiLy7K5LhQ&oe=6A4BC2DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jMvlWtS4WMQ7kNvwE9dWPM&_nc_oc=AdoW2_A90LrP5po5PlRebIzMkb4sUoVFjRwiGxv3YsxX7onsTo93OO_ukT4VUAvxw0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw-B-jSP1lwBhVm6aavR-nOzi_4DderG3H6c-rAS9R-w&oe=6A4B9B79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCRjV74N23sQ7kNvwGjDG6O&_nc_oc=AdrkgUpTUt2wGm4oBfEagFAYitnHWKvigVFJPrsk_fSE0i9S1rG9Dm15hL0VrzGnt-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzO2z4AnamxBxe9JlUZU-RIcMmzBaSJBAJG7-QSs6m3w&oe=6A4BAC61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w1RvfyAnWIQ7kNvwEtxlID&_nc_oc=Adq5D3FqrC9MpXu6cmsMobBw24pZ5U704TGMjW-Y6NOTFRRISowX3uPgQR00nXMVk4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCktkK3ZZIbSldlLPy-ReD0xKF11_TtYTYinobGydJdLQ&oe=6A4BA5B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
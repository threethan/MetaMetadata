ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZnvXnaDd9gQ7kNvwFho0yu&_nc_oc=AdqSiZ8uKAJp5O34hGNP19p6ZjXvP4tV6ETaGbylt60BEKhLFLsCXuTDteS1jK3VIgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WSE_pGufLBv58pr6yvtK4mg7RdYpomAj-AK1jRH3o0w&oe=69FA0571"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCH8JSTXcRYQ7kNvwGHYefl&_nc_oc=Adr6Jqsr4saS8DwdD5hQgQbpgbOH-N7BKyfKMxlZwP_60AlOzEFw2YGUZ7vBcnsY8-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ud8YCI7xOf8PcqbMwfqYMsT9p75E3HyJNo_4Yc4quXg&oe=69FA05DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pe8TyTIQdEQ7kNvwFNmI8H&_nc_oc=AdqTE6hwxzxXmWXG6FA9RFdVK4hosu6qWgJRa-TCbRKskjvjFRSEQOJXXDBIrmBmaSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o0S1RAHDJGD80AtcEUATk_3-OiHG6Wu4avxxSTw-tAQ&oe=69F9DE79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUlidlNZT-4Q7kNvwHfxuPL&_nc_oc=AdpqsYCbrzeVK_BYZuP0TLC_aeWEexGgosqZX6JL__NaEEznG8bb2Tb0cisXi7OXino&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af727xQcP1KrlrwTRfoST3hKQztfCVpdq1kI2itm6J3iww&oe=69F9EF61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpvJcCtYsJsQ7kNvwFDc9uE&_nc_oc=AdpqXuioPINhVlpTrTwXf_9N0GXzrvDOofZuyCf8BqNNJmjvBpk8ZgcL7cOM9Mi4YNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5241pFyyJGHCmi_Tx7fnmLYWW2YVlVpdykFnuijbYNlQ&oe=69F9E8B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYdywPkQ7FwQ7kNvwEmJy07&_nc_oc=AdpdavG015QnHpBpnvFO_wHSLGSu1Rh-gQNKI-dyaRkaRBcU3E83Tj7Dojykctd0Ne0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nao065u9pb3M_5XT9H9PrglAsfhgeGKCwyWc-TBafBw&oe=6A3A9EF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qVnC6fF4P0Q7kNvwH5Ve_A&_nc_oc=AdoKKPM67nr3I_J4-5MNtYq3aI6yAG0VdDVIULNVUi4p51y1sxEVcf42Ls8nLDWHmHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z8Fj1GTozeugcaSKKYgNKh7hQuIL-P8xiavqsER6Q3A&oe=6A3A9F5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQOmzRx7FQ8Q7kNvwEtBDl0&_nc_oc=Adp61G_hnY3UsH9slTLMCXy68oIpPuUlOGDIRekHdPXPTH5O_2KgperTdG9V7tUkNIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--NaEbvmEZq5tAS4AToTju5dSt02qZ_1uc0ATva7KNLQ&oe=6A3AB039"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFaKKmrScA8Q7kNvwFg6aL4&_nc_oc=AdoeFhTBqx1My9eSEaVLB75Y6ieDoxMYRDZDEu5cCniAd2qhnQ_Ey3SwFd6-54qNF0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bj5joEwYXvOvH_XIAEWq3L4X3oyuDq2Ub4z3n7fHHBQ&oe=6A3A88E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mm5zJLMPFEQ7kNvwFF4Q5G&_nc_oc=AdrDXaGWZexbxhc9kIqt7sScSTNZyf00JKJ-OC8rkynSngIx4hBX9PoRaLnnRg5Ap1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yw0VtLKZQVartv4oyLJmEOBP7_Z9a16G6T2ba_bqjmg&oe=6A3ABA74"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
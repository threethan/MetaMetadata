content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38LALnTdMlMQ7kNvwHyvQJI&_nc_oc=AdpOPUKj89CWsRLJ5dTfgdHkhCA2wusDHR1rbMBUtYDuYqBcbqmPOZn9usJaOG9lKzM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0UX1oSd27RIH0Wu5hZAlGQqMLbCaV4RMpNGQXE80mwg&oe=6A467C71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMz-GGdG4kAQ7kNvwERlaID&_nc_oc=AdrvPUB2b1oH6eVBQwufnU3PfqM5wBu2bHXWtqUjTYfRjUkQ_8VHU8JHiHHS7gU6uqc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pTvt7qw7yg3Hl-cxUlDYHt71BW5pFauyVGOyuKy_Myg&oe=6A467CDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koeofplDVmUQ7kNvwFSPTPX&_nc_oc=AdrI40xQiO_vigrtYI9BfuIlutvP-nEaCILBvGM-wO4-gkyMoQXGpKQsycLJzpLHAMo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EZqjINJJQu7tOtUPrcr1APhiUg_zKgb7LBFZUDubqmA&oe=6A468DB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28Ys94bEPQQ7kNvwHoSeOg&_nc_oc=AdptlcywbJItEl3n-4L8fNXSyh_FVOV2_ZBTukA5xdFe4j3_GY8Pbj8OMMDh8rm3cQQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z1WNuVwK5AfMbRBNsBRGNhdX_7X4lFs0wp5QoeAceBg&oe=6A466661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne0Ak-sClo8Q7kNvwHC7ZFJ&_nc_oc=AdpBPYqAOns9NtgHMw7Mbn3DKw8RgU8JPq2ZfPDb3FxUvHHFioToJkk1bcIIDBTvaEw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n1eVQcWAJTtU6DETr80d-nEDG-Aks_Urr5KR6J6Wseg&oe=6A465FB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
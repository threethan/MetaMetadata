25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HPHmCf1np4Q7kNvwHn3t4j&_nc_oc=AdmULfux7H1IfC9U3CLJmAOKon5AmZlGQUkDcOf0jsml0Ub8OuS-UVNLJIt2MHbytVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIvqdWECBNn9js00Piz9np8CgkYJUDIQazmxi68VB5HA&oe=69A81031"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYdN6cFgIEUQ7kNvwGuviI0&_nc_oc=AdmJN3Yd8Qmo_AfvEl23JRPbrO4CJP_Khwj9TIuFVg35r0qP_TWLGDvirug4PlL9i7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwoC8TnDU6OnFest17SwCmhJcUs-Q-gwC87QkF3RRHJQ&oe=69A8109C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqtSKc9DcQgQ7kNvwHQPU3Z&_nc_oc=AdnL9fA2FqynP9LDFJ3lNVMc0GTEEON9h1X0TeO28IICEnjg819KGhvHa7v4EZCpuYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afut30OULhcxxIQQdyahEogUUxPjhUBg9L0oIzHWk4s_HQ&oe=69A82179"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ktVuXXFo7gQ7kNvwEmk8Sy&_nc_oc=Adn6OtePo7rSrIinuN4MdXEIpMqtvjnWqgnbeJ4IqiaVLjueQoUdNJDPDN9V9obhYZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftKcovrjXB8ORMsRExcCDXmRJrKQWcYReS3BFUG5bfwhQ&oe=69A83261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2yvAUSRM2AQ7kNvwHgIKwm&_nc_oc=AdkkCMrvPFR31_ARPJMmJ24sF-Rr4QOqnDR-CdAYDQZrifXFAVNngrw-H_c4GxvMgpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuC9jMiKR99wLv_YyUInDCTwTrQtO8D9U_gdLYRN8diyw&oe=69A82BB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCC6xhyaL3cQ7kNvwHx-LS1&_nc_oc=AdrsvcV5yH03kImjd2--4nkP2QOnK4kxM6mnMDe0q72_RpHxyaoLIqbOTRTwoATdcys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOo6eiMJdrmfuYPgGU96HjeEqQLV5PDvto5rZt3wCGPw&oe=6ABBD1F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeNwG7EYR7EQ7kNvwGgOsMs&_nc_oc=AdpmPdmeSmLpxtyZciiUat8fO7vNnOgBBFqJaxuDKJ6DyLNIta9sX_aiJ1QHD_btX4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6IXHbfwMP1DkcdWO_kD1BdYUfCUn16kRmwtJg2TQEfQ&oe=6ABBD25C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSn5eRpWNbMQ7kNvwEdetQG&_nc_oc=Adqz0ajEdw5AcDydTFJ1TTWhaWX8rzFyAtH1wBzQPeB8xav0-cntP5Vt9AzjEQyVWEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3oGvpUBhBSen_rVQPeMK0meOJ6EY8Yf_954cZuSdW3w&oe=6ABBE339"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPBEjZdMSyMQ7kNvwGzagGP&_nc_oc=Adr5qsmh4nx-zf38aOXk55xoUe6xGXlrfV9-zALnbpU-fPtWiLvbL4luFM9lLCLlkvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9IazTnUSGGLcw_ex1RE4F6vtfvf8c3UaLjlpk6XgxnQ&oe=6ABBBBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_1CIY1-P1MQ7kNvwFWXFvH&_nc_oc=Ado8-gkdQoqTb79VUFO2UdJg1xzC5auKKBH1qClLwe6-t-MQybec1LCyHyCmmjliz_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNFZUnJYH4AXFdEy0-6WVGKqbIZ-5f4fbU540JhVV3Cg&oe=6ABBB534"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
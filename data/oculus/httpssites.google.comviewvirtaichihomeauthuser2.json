qro3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JCdLhn7ATgQ7kNvwG6zOLL&_nc_oc=AdqcOO_aUvcED_jxkJ-OIxLOPmu5mweeS3E69ZraGNAweknh6phOqda2YhNKcdzrejY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwI27hiF4m0TjQOCxFV7UOlq-xBT0uhKl1CCSwkK5VBQ&oe=6A972031"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeLz4mjtCkUQ7kNvwHMWu4h&_nc_oc=AdqvUPviImUrx4MfgWxd2Hkr44_U5H5A9hr9OZjsOC7fnlJeXx1UnZOkNze95s36HgQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa0o6PmLTY7uPTPBO8iQKJtgSceCxG8VZ9baNgMWfUPQ&oe=6A97209C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU-zcuBAxA8Q7kNvwH4ap8g&_nc_oc=AdpSXzafAxqJsqElBFq6ULN9YHoR6OQ-6CXmvt1AoLMRkvpIlQyCC-bQvFBcZoHKJZs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyRNxKujf5T6Xrmiykz4dFlEzNPk4bOOKzdnPGnXylKw&oe=6A973179"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m79el826g4cQ7kNvwHzGsRn&_nc_oc=AdpIYFb2Xqu7ptiizoHqQezyiRM1tuxasJv-wHimS3fqkw-03YLQ0Z9sRAxJNlwX8qE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMKRoPdILukhWFblB5rCacB814C3efhK08BBgheLrQkA&oe=6A974261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUFKfMh00wcQ7kNvwEsG9Cw&_nc_oc=AdpjyglVO18kHdxXusaEs0LrzKZhDQvo2wVRCbmdCiG0ivAs4xtbzb-QZd5c0PK0Kv0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNY0ErV33iQnQIG5CEq0ZTbEgBlTjCffQXDnUXlZFKrQ&oe=6A973BB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
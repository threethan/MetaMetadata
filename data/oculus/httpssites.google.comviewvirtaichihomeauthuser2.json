25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHJx8VJ7ML8Q7kNvwFfMxZ_&_nc_oc=Adqwf_QTvCnZEITYz3pavySb958LRvX30Lmrfr1cBn9lK7rKYxszRRttwaHHBLK8d4g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5B131liWsz3-aZw7R_8fkf3Pj9PVMneVa3TndFbIoUg&oe=69C11CB1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIktOEpolbwQ7kNvwEZ3nqa&_nc_oc=Ado_mofTT1eXrk2HlYPsFDmH9F5SH26LAUtnLATzPD0s0KONB0KBuJPblmZisCDINto&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_UXoXNs9ygMtElXw-iT6yx0Xcjk0a1aiBJ1KFxved9w&oe=69C11D1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqIbv1Nrj2QQ7kNvwFpy64K&_nc_oc=AdrSHO8haGcOX-6yX6bd5BQVmFFjvhtS5U9wDli12P8xDBYloZl-6CrlEEFcgdMP70Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxv-DfY_U3h_1djhJtfx_WuOyRouVz0-2wF_X04IS37gw&oe=69C12DF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V7qm5_dlOQQ7kNvwH2d2jQ&_nc_oc=AdpRtB8k1oaLalSahmSkNeTt1kWzVeV_UPqvRDzIqVPj06cStPZ4lZCFeZzpvo8JC0c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDKgcI2Vsw9kXdX8-TkEjV_4Nz8IKaghKz6QGgkADS3Q&oe=69C13EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xmNFrHbcygQ7kNvwHu1X9U&_nc_oc=Adpkp1wOd6AxJVFMwGfqBgq0MGlNs0x9NYo3qLkHZuGnICRJEFAmISzBrZM5LoWtjQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgKID65WuI5rEDz3aQ56_RK3s3D0DspF5EAsXk9CseAQ&oe=69C13834"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
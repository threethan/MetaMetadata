ams2-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BxF2tDaHAQQ7kNvwHu0uHq&_nc_oc=Adola3hkbdK0dzmbCyTRZ7OkWgoZGURjVGg1Lr1L_mSyzui1mNBIJL0IChX7gApikY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wf4Y2W-NEXns03pY61xEkrILPB4ADjseN_tBEqGtyGw&oe=6A297B71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWS-8VYhQeIQ7kNvwEbZnYJ&_nc_oc=AdqaVqJATmWt0Rael9Ch9QN5BzoctzmUNbj9t0S9jw_yUtH-FogaAk2ozyQoJNOpKUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VXAbWnW9ULre1dMbMchoaOlMDOaQtOACq8ln_67BVGA&oe=6A297BDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCRd7Ac5-L8Q7kNvwGusxuo&_nc_oc=Adp7T6V09zaVVt8TB5X7zWUyiyNO1sSpllxqvdKbvhfIc9V5AQ2iFi_pLZ_kaElObNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vsw3rXCNuJ_3x746PUvbmEhed7lVKZ5vlefpija_3SA&oe=6A295479"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QpNXYh4XoEQ7kNvwEYetnz&_nc_oc=AdoAolyJMG1GhE4KIqQO9l4pPkXoWbWsz4Gc8HUYf3Pq7YpQKmC2s0l3ES9T7FH9gD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iBn6-SNY1OQnXA90VkppTRJAc_Pg_0pYhr1BQpFgACQ&oe=6A296561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSJEWzHeXXoQ7kNvwEYgPmM&_nc_oc=Adppre8BeLbx1PiBh-_F32Ngg59I4yP428Dpgu4_rIus2Oiqe-8EYWbMU5XukpWqoRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uIhBLK7a5XMdxy38MZtdZ0wWr3WGYHWqnDY7HRIGBSQ&oe=6A295EB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
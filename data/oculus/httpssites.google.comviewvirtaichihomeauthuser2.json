25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOrO_8lXBjIQ7kNvwESI6rj&_nc_oc=AdlVlgd8QJleOPs0I393aeTVSZSmQEWzT58mNykR72jhUcHZ9QjSzsa_J0nuUOFkBS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzkqPgsDtVMhPF3029zfG1ALKMDlVnlKv-X6LM5AjBW7Q&oe=69AC04B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FikLKP_VWjMQ7kNvwGgUpdb&_nc_oc=AdmHJcuAijw8E0QhC8IMotrc6aAuCyT0KGWf18J4KnM5Kn_k-rQCN_J8uGw_HmJjQ5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPrM3u95hgS7pDp_jW_8-Fv7Ha629SoxLiQl5c2T7XOg&oe=69AC051C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJj4ZgYSHg4Q7kNvwESBFAu&_nc_oc=AdlPRZksJ2b1iAUpLbS-6gHOQimMhR5JLdIlHdYstt_zzahwFaFvYTvflLcLdox3rQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxP_xQDPq-dIGufKJDO-jBCjKEdfkP7V-eKH6NrcNIyVg&oe=69AC15F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqxEgemXVgMQ7kNvwF6oAFy&_nc_oc=AdnuW_-q6qlDvFm6lqAz8BO4mRtDxDuw0aXuLKIrriZpkrcyZgQZjmIxNLFp2u_RLr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxitfMpSjejTvHpMlb8fY_FGSf9xZXLAzrx18oOGjgvug&oe=69AC26E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oYoO9oov4EQ7kNvwGmn49w&_nc_oc=Adl4XHHkuzhHPicXFAHIVgnCO-1Hs4mu6Zcso61ElzDFSBbpPkv_diSKlQqIEN1IdDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxn_UGYyAfb8f-8zNWjJrDXHBiZ_3r_Rd9qd-z9NHg5Bw&oe=69AC2034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
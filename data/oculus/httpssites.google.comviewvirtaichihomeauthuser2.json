iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0vVY_XjcxUQ7kNvwGEZKXU&_nc_oc=AdoPF7d8RskUvr6KZeSIyJ5EBfmnHhHSEChuWVRjDnvIt6QN7j9AAsL6Aw5aiddkqgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvCGFsu6SK16ONBsxWdkkIeSUCK1KnjxD_RmssMbj21Q&oe=6A7EF4B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvQcJT5-VQYQ7kNvwF04C0a&_nc_oc=AdqDR49VGFwjy3sFGqrprcKA5HvP6Jorot1kbUG1-06Io91cjBbUqzPJAXFG5DZJiVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ybk-TmasYKddnY_MHIJmcF7Dm-Q6SSRF2uqJbfrWiQ&oe=6A7EF51C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ohD_VtiM7oQ7kNvwFs6DWG&_nc_oc=AdrD9tIzVmTWe861xpt6QdCJtqdpcjHeU4cTwR0z01i0Vw4SBlmC2V_UcmvazKy75kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH65cO4U-DbIrEIRvIuAgJmKgxSfphP0s7kPFqhMdwJRQ&oe=6A7F05F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgMOSyKOuw0Q7kNvwEJhvq8&_nc_oc=AdrUn3TUcFfMQcRztbqgulwLLu5ObrzcLvAa8tphWFIZQZWVQIBZzvaCBcQPUeBYaAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsFv5Mn-15mjl3FMqe_ECxurEWtqIPfjP9NwiZtvnExg&oe=6A7F16E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH52_ccOUcAQ7kNvwH6oqWg&_nc_oc=AdrELhxwCy4yHo2LKgVqEg-w7Ykhfr_ew4V6mBFhmM2briDxtQFq6_X3rcob6j1h2Y8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHljRegIyCq5fbmE5q_kJb7GKlVZ1l5t-xbQs4o3onvbQ&oe=6A7F1034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
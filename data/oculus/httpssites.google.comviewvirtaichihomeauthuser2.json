iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu-AuHvmm0YQ7kNvwHE7nR0&_nc_oc=AdrQnboZUgTBPAWapE_wL17FLbF4pr0kDm_3YZsgHiKbshCOeIDOSmMUbkXIJjgtjIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQpHQl-XmlmiRpDAk7Xs_Wpd3u1TbKcMoZlaz1EhqSXQ&oe=69CA5731"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cno2fh9CBIcQ7kNvwGQKp_E&_nc_oc=AdpmJQUH4vimkYhc0FdCbS3xnLe7T3GlkNJwk0iI6yfDRxbqxC05DX21jOwJIn637L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEWy7VTb5FwwWS8Iuag_gAWx94PH6nzVcdDxYQsoGAgQ&oe=69CA579C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIl7vPENYQ8Q7kNvwHP6paJ&_nc_oc=AdqA6q6oFCO4E6THA9Xl-9GtXec88AnJBHOInf9Wdf5IHAtBuFC32hn-_mWMf9tg-JM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6_lJk3UvkgZj4KmyIJQvAYW_DB2ResetzT3T9sDYrxA&oe=69CA6879"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqd6Qc6i2IgQ7kNvwHkvyq5&_nc_oc=Adqmr_P5j07-n0Mz5v9YUc6tJFYkZruHzXl1fkqplHXgAsKuM1BJ-hoeoa1VkaHgrjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg6U4V-KV3dAEE1FfqMBLxd0d3e2i40pkSjjlp-l_fFw&oe=69CA7961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9FuDPmkh9cQ7kNvwE7yu_d&_nc_oc=Adox7ILCARN7zgGweVgVXrjpDiiQzNxOgXEwf9uThlBHMZ15et8Ha1JDkuMZfzojPO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAm8kvA8jgZEb7pQPYKl_aEM9vRoGAZCd4fJ91Wg-CEQ&oe=69CA72B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
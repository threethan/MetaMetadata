iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXiyWprX0uYQ7kNvwH1E1VS&_nc_oc=AdoyuC2upejwL644Lzwn4MxctzLKfG0ORJw3qDfPE3mZtuAwOL25MqcCHyUC9TYMJWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtxv9OJfVFH0kGcYchqNbXMRfVxfE4nQqNs9bWbGvLnw&oe=6A4D13F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMMO2_3D_WUQ7kNvwEb2keu&_nc_oc=AdqK6aElI1KQiiQzNp_5gIoKKT_Z68TO5aHGNKZkk_6S2cgtbcggBwGdl5YGu7q4jjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCta-QTT2Rr-lHp-P53j10VsoKcSJexmciitdvYr5uvtw&oe=6A4D145C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jMvlWtS4WMQ7kNvwH33-RJ&_nc_oc=AdrzxgKbYhWS8IcQTBtuEjo41ffkrs1qorgG6bwBb-yFvKVCcIzmeubD3SGJvaAzoIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqH_Dc6fnPvR2r_TGPX4SyPXuWVaXVef6NG8VZKvys1A&oe=6A4CECF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCRjV74N23sQ7kNvwExjKKk&_nc_oc=AdpQZ4a-jamLzOPllBMhxLupw1_8NqKVnzBsA7UHq5lDMD7GbEvVJ8RSJg11qjmSRvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0037I6Juk3PWeu1IZ0DtNUjusmULCGON3jtPIyvjROA&oe=6A4CFDE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc3-fXIAoxIQ7kNvwEpcfJ4&_nc_oc=AdoNo7AAaHqdZ9dnKhg_PJbPOj69BLeA2fcVUj1oO--IJgteWsdrXqZeSYLWo90DhYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt8tW1R0dzJhuTQxzYWqR2a-PCZ1On0lMY4_NmKoDSgQ&oe=6A4CF734"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
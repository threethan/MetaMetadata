sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daLvikju_TYQ7kNvwFrFWKK&_nc_oc=AdoFGNLe0doLD-DmjMEAG4Af-TCeaFeHy8ZwgibH_LGhsWvHjMQBpSm9CpLmJxB7QZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3drrQAqO_epoN9wvpljqi4LPH4h_OExmAhTKjcLClWHg&oe=69E8A9B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTgM_YPfnJkQ7kNvwF_bJzh&_nc_oc=AdpNwZndo03F0IXKO88ZxGDx0GZtQZfhwjtWCbpw3mC6pKwR3SvJrMMpy0DOzqd3YmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KfC2IAKTQxtT3UeoQE2ZeL0WPt2dKtH8wlnOdqhTkdQ&oe=69E8AA1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hZNd7wG81kQ7kNvwE2xQkx&_nc_oc=AdpseRsCc04GVhvtSDufOz5qGRStLh1w333m7FF56krAt3EaU1wwfgwtism6ElYVfjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EH50Gq8jeL3pskOA9c1wHgnu7iQ-6yVDP1ng3PzhF9Q&oe=69E8BAF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7cQS_q6pjEQ7kNvwEErvTv&_nc_oc=AdqDayIaUbphfTLbFjaCTroBE9OMFDp1tFy37mG2so12qaXOtm2pI9cOy7QJZuUmMwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ykMBNV_2JkobeiMp2M3EENUFOckoAIRdiFbPpK4cp6g&oe=69E8CBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9oZxBT-dRcQ7kNvwHpHseE&_nc_oc=AdrbWR1oNLEP_v5nRTDOgRryrOEKfZeH1CcZwi-_GPGqilUOx7_2hMPu8AR-OXo3Blk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_VKKMYXCBiAc_h-E-2Oe14Vajk-GMzZaNtc5ayTMZ6g&oe=69E8C534"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
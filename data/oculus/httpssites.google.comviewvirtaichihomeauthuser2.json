iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUyRNl-VYTIQ7kNvwHeo6wO&_nc_oc=AdpxHxG1VGXKPen76o4-AfST1zBdtQppMnJQs01H_R2qmJJvs1P8vB_9hGlvPBqtNy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuyZMgg3_j4Os6wuVzkf7giC6-FxTXEaOP0jo5I3WP9A&oe=69CCFA31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cno2fh9CBIcQ7kNvwF7LhUt&_nc_oc=AdrQXc1ldLDzol3et8PjF7q8OnFigLy1JzScALqC-p48RI0xaRuUFVbXBRXOGHdAO3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfWNbv77mV9uRz9DBJGZhKqT5FNCFraQZkX1ZEYK8yfg&oe=69CCFA9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb7oXELWPI4Q7kNvwHbpO2Q&_nc_oc=AdpmCdd2--wkQT4jizaKoENC8UkRG26ipIL7SpIZWRFHRk5R0TO_KugvWE7eV-vdYyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwbb6oKjKkCrIKKL7rQj-i3lJe8QLElPcwwHeHYmqDmig&oe=69CD0B79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP9we3u7esYQ7kNvwGNY4xF&_nc_oc=AdrE_USXdNL-F6xpBNT7yZ8lanR5kH7AwSxi-XNgN9JM-Ei6qIliBrQg81O6Fw9chA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7Zxr5qiW0YcnnaQDzjQY9LvloHxyiakQDnGF_USBeFg&oe=69CD1C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9FuDPmkh9cQ7kNvwFHUOcx&_nc_oc=AdqgKmaHG7RXHJmhWS_HC7ZiEhqI7Kf5TH1Y4ZzM6gBodpzeHOOiS8zm9iMiz0aH9gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxdRh4sapvBpA-J3jde_tNOeJTvs0vOQex4Lrl6mRAqw&oe=69CD15B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
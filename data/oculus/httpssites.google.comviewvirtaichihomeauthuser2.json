content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYdywPkQ7FwQ7kNvwEC42z1&_nc_oc=AdpZeTbLOc1tL1sxdfyXA1TrJVh7a_bp0tPRsi6nC8GtbHXzILdI4DBtP9JRb8mhr9I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4nujfk4Av2gHdUZWL7XphbdXndkm0ThgRZiKGA23Xng&oe=6A394D71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qVnC6fF4P0Q7kNvwESvBN7&_nc_oc=AdrWgymxCaXTPlFCW5MYB0VNZMsS_KQNbpPv2aWofzyAtjrM5TIVE8OwaOOcAxyS8gQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ioQ5FOelqFy5KFsZDeWt7fsxsyR6VO027wkGEwyKtUg&oe=6A394DDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlUGbVr6zZAQ7kNvwF1iyaf&_nc_oc=AdpBkitivdb2Y7NG9zdEZZnVygPAh_LeHzMFsVdA7abJ78Va5b_qi4qR04kFZHN68Og&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89AcRJTro_T7ovc44nsLKw6mKvsb3GWNtILJy2uwWFMA&oe=6A395EB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S9lqcvEmaEQ7kNvwFzylW4&_nc_oc=AdrDwFMkvqUNVHOaHUP9K9-YBe8Qxu3quVMYrsf7xyqKE7F6x6-0k2nvywHPzp3KapM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XEXWUWP_hWdMrqw9COPQwuTzGDhJlWTlVOilghuwfTA&oe=6A393761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mm5zJLMPFEQ7kNvwEVS2Bz&_nc_oc=AdpDWnLhiljswjkKC8Ve8C_b8uyptMvKX_Si4LuTc1Qmuypg5F3EPzHwtXGbyBYaELE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qzyeq0NgJgCY8IllM3i0uk29H-ZIqhFt6L_Uu-dTt6g&oe=6A3930B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7Qs5mOuIqMQ7kNvwFGOcpt&_nc_oc=Adpt9zS9GUYhk8nw7bcemhJErLVxIREwB_lf4Avidq0ANm0WMJfJE-uVAhaxaMYe5zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKJD3et6NaI7RE-CMYQdsiR_-FFEjbJdenLMaFaJijXQ&oe=6AEB47F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C88UZJjNq9MQ7kNvwHfwPRk&_nc_oc=Adqziyl0ttiXu6SJxJ5ARpymSYDLEqmmSpEyEQhc7WegZ3IgihdMVVslPDVWwQAu7Jo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp6RGc6Ype3JycNbzEbSGI2Jj7Rk1Sl-pXUTYsjYNveg&oe=6AEB485C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccy2XC8gGl4Q7kNvwF3ZtDT&_nc_oc=Adq-cF8N2gEEoSf4XXfM7-AZHMlAGxGqg6ZzOtAEGIQw2r8C7mH3gWwq6dIQ60UtqzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDZn0NvZ_NReJbAp15dBJMJD7o0T3ySX9QpisqUhcoag&oe=6AEB5939"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2S66epMTzEQ7kNvwHSRSib&_nc_oc=AdoArl6W_84MiAapTJbWScEYri9Gm3sYGdzfGvvaPS96Gm2D_QWGQ1YMG8UqM_z3MRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAAtPh_gCX7xq6DZArHST06UiP_c1mam_av622LcgiQg&oe=6AEB31E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFhzG0EAyMQ7kNvwEnKCRA&_nc_oc=AdqDxjG1zzNBXc9q1TKhj9hKgCuwjFp5ZzSUm3qiNQSgO7Q2x-Bai4eG5i6kmjfZ0ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6VgQLqS4Akg945iZWRekuFYn-ifbTUK34-eArE-SAWA&oe=6AEB2B34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
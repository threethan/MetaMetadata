lga3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbXj7Ez5F-MQ7kNvwGtUesJ&_nc_oc=AdrUo0ULgBkn-p0tgYKRtpL47tQ-sIyqXE3qHZ4Ax4jE3FB38amUNDCInuUB_PszqXo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa-yMzPCp5UGpasVjehSdUddF3YyZk-oR_LRkhLh9wmQ&oe=6AA02271"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU5fJUhZyVYQ7kNvwHGXo86&_nc_oc=Adp4_hVjC-PHL8d9N_BV-TDOeb1ISFkC_OXPsGNWWLNt8jNYuIGKuJxe8OIdc9JqP18&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqplAtu9VRjC2iDIqm6eB4wiVUnzQJXBFeOdYve8RxaQ&oe=6AA022DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF3-mYP59JAQ7kNvwEGD8pW&_nc_oc=AdqdSVOvP9gwswe22IA7HEeZQJ2RInaQbZwHleR6pUJ2c_ULsWSWL1m97NoI6eU9_1g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW296XTorS57h9yzdWqMbUem1nMOuF7_N36Pvpsg8rpA&oe=6A9FFB79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fktIX4NAltoQ7kNvwF82WWW&_nc_oc=AdqytWxmbkGQ4Dpauw_Le_P5fSTuVgy6ZHcLfMBup5OVHOFmyJJ0UJ3u5E3nADWLADE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjkxCTfrfFjhiokIXu7l-W4i_jzSNFmoHgtWtO00o4Ow&oe=6AA00C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFTtkclT1iQQ7kNvwHBpHit&_nc_oc=AdomX7bpK9ZrW_IoP2M8n4Kei0B-nrR_lCrpyKWVF3f828oH6BKRTWTvFjg83j3Ff2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ixMnlKXslnB3RrIMXoYovTd9-4czOYnjjgyIMGCXGA&oe=6AA005B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
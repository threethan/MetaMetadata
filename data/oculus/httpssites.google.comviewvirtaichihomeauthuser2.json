sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwJ9Bf9lYGQQ7kNvwFVRaoc&_nc_oc=AdpqIYkwoYYSIv4KaZL9uIEtuskC2eM1wSZNdR6UtICxjwkpNzWD3dshViciEaAGT_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LkATSKXLWAsUlr0NqLH0TP6n3-BqTfZB-4fIdalDbRw&oe=6A15B4F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDOZRtAYZUAQ7kNvwFQLTBG&_nc_oc=AdrdVUIlcSZc9GMZyimri6Qlhv0IqC_Nza1ls_Vdjf0IKvNRRTbizUKlsElP72e-ryM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ds1hom8eVHPb857rz_ELK-BiH_nhOcEUDe4SCvCZlIA&oe=6A15B55C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0AXmIiMn2YQ7kNvwF43yd7&_nc_oc=AdrTagWVF1F7XY-mHZDsLaQ_Oo2jH4FA70RbVAumnSwOA3Vy8eFOUp8-EQHOXg9jl60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xlnQ2RpAr9V-IebwniDh-_iEp15roHFSCDut343JT6w&oe=6A15C639"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEQCJ4q-Bh8Q7kNvwF_QPoY&_nc_oc=AdqpaEa7FDGqdEKQM3rlpTqrIYH3uoC8OGQSwOjdQR1wIrpEA3GJeeHrk_Vv-uZGPow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m1MxtqlbDAEzCRk0R3xubn6YcA1D58JNpACi7iHXjNg&oe=6A159EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miJWlB2LvMoQ7kNvwE1JdzH&_nc_oc=AdpEYp36ewChkMxIouuEwe-ZbS4gnlB7jOsasQSuQZOTe4zunVX71rmpiDbF-ttb9Dc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VbHuodtPICBVXcTe4WPZPuyxG2VaPkSiGZ-favb8iuw&oe=6A159834"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4gcJXchhYcQ7kNvwF85gu2&_nc_oc=AdpfsmPbQvs0ipkaDiEVj0AQyDvZ9s86K1q3USDQ4udzP7zebjtFPIiDK4o48-TEKBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yjCUIpOItZYTr1GqWHHwiCU72QOluSMvi5MveK5OfDw&oe=6A0F1D71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45UOxqXFG9QQ7kNvwEE_hKJ&_nc_oc=AdqfyIHSGIjS1giBjsRbboavrvxNKEtF_PR0tQYwAW63uekvfyo1l8sTLQhcOHJjjRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V2tYRPrhixOJXOYurdztoiGfoymOy-oxYrBrZR6Vw3A&oe=6A0F1DDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy75n1CqeJ8Q7kNvwHDxjoW&_nc_oc=AdoQs56-3JtuHUs3evjo-gO-Sv_LWCkaINbPGsb9FbvrydNi2fa0CgxnYLyGAktwt-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af428EWXIk_gXM8ig9EZAJ_untGIrcCRUu72kBv0K11u1g&oe=6A0EF679"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s27HOYu90-kQ7kNvwFxM0Wo&_nc_oc=AdrxgR04HlF4dN3GpDhvEIciKBIjFbHbPx1Fu9gFX38YBtFpZjcjoSqyRJBI_l7jNEQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MCX84NWaPKk_-Ethjve7Mhik0W3AsmnsEnjoHupGOgg&oe=6A0F0761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im1qwk1aCnUQ7kNvwHi3iBt&_nc_oc=Adpsdfreaa9mc19xTpzskqAeZHac-97HDVI7zdRUIrsMm01_N-tEnbMe5QlGstj4x7M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cWjdhKt5-Jd2kk_d4mNr3gisazY53b6OswuEU-ZLtTQ&oe=6A0F00B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KxnGe-cVZEQ7kNvwHdXSeH&_nc_oc=AdqmHr_E1WB_tZROfaM8KK398FIkvmTg1tnINgJP-d52DFR6uGLXCzZfHcej7LCxfKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iLViVdP9RGM5nBVBEpeGJncS1qVjzZhkyQuZIJ5vnEA&oe=6A2EC171"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsaHPF6Tln8Q7kNvwHsFNvg&_nc_oc=AdqntCh9G1rY9z5hGLS4Zhb4WXGOnfROdYuEovNCokxooY7hslM0hMa2-nHGYyoDkZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U_EFFeNP_1hLygeAovSx6cMkMkVhqTgOdHgMPrW3zfg&oe=6A2EC1DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvfxMLFqqJUQ7kNvwHg5VJp&_nc_oc=AdomMNG2FVV4bwpLGCQb1Zpsqc9HqaGOFmRF_Xm6WWs90Z62q-tRE_5JNu4DyrM4xP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xp0tXCJKvt2KehtC489QDVbmPFGxhfHW_TRrpQGpN9w&oe=6A2ED2B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW69edLppb8Q7kNvwEdsrdp&_nc_oc=AdqiUI5EMbcD_lwFbN6h2SxRP1vbo3ZD7BOhmAD7qZfBnTZxKh5YduYmKjWS-Dbo-fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rHBO0YYXQwEJtGmhkuwNU7mUov3RTz_iXnXjZFksZGA&oe=6A2EAB61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7FE7cpd2oEQ7kNvwF-A1Mb&_nc_oc=AdpwryWJg0LynVnmv2TCKt4ZJmenRB2RdQ4PFxCX70a0y9kj7OnuYjS65Pivh5NRMD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G1Oqkmkm7xuZ9VoMHJBqLwvJzpt3kWyOeYK8DPpJNMw&oe=6A2EA4B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
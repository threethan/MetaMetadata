content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nakBvWvbPjQQ7kNvwGcjArG&_nc_oc=AdrJ4YaS_pVu1rCSvAZENLYmRVIZXv7dOiWDdlbrKKbROtuteh7fSmV1LJpNYImqM9w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-XC6rojRim4_vWpcsdG8tSNNQgQXUcebM9AbNDd2TgQ&oe=6AAEA2F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWn1WYvDW54Q7kNvwFnKU4z&_nc_oc=AdrYbJiaCPe4w9qDrOs6RtTN070HT-gzLwjheNE7MJZAMl8BZrtLPKsBihVZ7YWaUUI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BTA5UN_aLYkKg28A-gkyZSuNxY8-3RlZ6BX96KVrIQ&oe=6AAEA35C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xblBj3W2wvwQ7kNvwGc9-C8&_nc_oc=Adr5JX9xpdDU7P_BmSNgsS5AdjgbkaLNG_WoSk0MaHB1ucjLlRc4owI05elpa0DNyz4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv07WbadwzO0-56CgP9GcE4RTEuvGKoaVTTZdEXZkh_A&oe=6AAEB439"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoSxIjYXu24Q7kNvwHesREm&_nc_oc=Adpnvzh-hy6f-AmTCgVEBImN6P5NKaeMQjizfB6nzU0eL6JcGzkS5edPe2mN9w28fGQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqG9MwmVUtZTk99O1krLt6mUBHn7ZE5Yc7Jf7iYnt-8g&oe=6AAE8CE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqhQNCqGdmEQ7kNvwFN_YK_&_nc_oc=Adqti-ntFEs52q-lxr2_gSRZ121oRAydO9_ZOyelai7zq-z9O9mbG4REzI9oep6ncWw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Id5lTC9DK-3Hj_WQNNkDAvlcprT37p3FCS_RyJtBLg&oe=6AAE8634"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
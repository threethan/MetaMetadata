dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxNHArbD8PsQ7kNvwG-CRQz&_nc_oc=AdrhHk2in20cJksRZPKDAc5oMwhzyqwpnss9O6ycX8_KWWnpz4yPsANEFWgQ6F_YEE8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsyqqr4wWWCSAMAe8b66h6KX08lNkL9YUMPXPCX6J41Q&oe=6AE35EF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4w5EBiczREQ7kNvwFhI-Li&_nc_oc=AdqNXD8bSSMJVxkV1flAadv43iQ7n6Cc2Mzu7F3izj6-acKeOz-lGCXyx143t1S8i7g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAmk_cqI3e5_U0T_PyFKloEYP2ksj2lnxFHk0d_s0uHQ&oe=6AE35F5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-VcUbsit6UQ7kNvwGjesZl&_nc_oc=AdofkhahdNgqGGve_6e0kz5ybatD1TnZfugFmlc1y2FN17rJ5xh-san6D8rqjGuPZ8E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_oVqQp2Jn2lpQN9c96ci31mLJWWPGMSc6besa8nzHbA&oe=6AE337F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ6tAN-IzUcQ7kNvwH_sYUf&_nc_oc=Adq3HptubCHrAL0biehI0D0iVte0sjVcUuycowizflxobdtHwVixfL04NNunEMV4KWc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFnPe4Ja_ApClBcw2BLcu0-1x_gGik6mPDa3M2GFa0Sw&oe=6AE348E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRzOeKO34DUQ7kNvwGTQvlW&_nc_oc=Adqm2CvTjhJbMLjmJEYzNNcnOMJwZYSsSxmKT--oW9kAtUZS9gpTgHla8PoqITSF07A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_X5UdNizCjHllp6krzMwVEc-s6btighSv8d0US5ywNg&oe=6AE34234"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
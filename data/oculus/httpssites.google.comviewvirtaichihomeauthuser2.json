sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38LALnTdMlMQ7kNvwFnrcdy&_nc_oc=AdroTENtuNdOJG4wqEPtoQUTCgbFNbhpwOFueJ7QCuHoFrJeShR9PIZv3aBUP7QGsZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TbuG8Z55l5FC1E5QJreL4HQgHGtiOQDCfycuHzierzw&oe=6A452AF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMz-GGdG4kAQ7kNvwG-mMAz&_nc_oc=AdpBnHrgmjndk787hS1tSZZZoE7g_NjxJrxf1cJucHeTRFw1qsWCpbcAKJUTr2QZW3E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZC7E7Y2xdpqa05s_E8GliSAXeh3rJ_HdB1rAq8FMEbg&oe=6A452B5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GShmoEkkhJYQ7kNvwGpHEMg&_nc_oc=AdrttfAsvY97_1WYrtQR7OxHDYsg5o6m2Zx2otv1Dk3uLLeQba87z0pEfAFgak0vPRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dVn_dEvXTmKyj5o2W-nC5fk_BjHhYlw8X5xOVj7eC5Q&oe=6A4503F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8BOwUc0ugUQ7kNvwF2z9m-&_nc_oc=AdrUe-2yx06gXpyMrPHJIetiHwQtxQkGyiFu2MLxZxqsdTV0LLYSFFO2DrlCUWM4gms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Di2Cojwlxhs99fyQJjfOPO7pOxfXomksstuDfrOPiWA&oe=6A4514E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne0Ak-sClo8Q7kNvwGCpMJF&_nc_oc=AdphymJMJvyF7IYFZ_c5U6C9ubrUc5WjPUCgfWktxGCgLlfM6_oUuVMgYYhtDb_HLkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6jTfeTqhuxWalLR5EaHq79CMSLBfyV_q44zL8EcK-7A&oe=6A450E34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
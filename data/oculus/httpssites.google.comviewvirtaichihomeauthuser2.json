ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtzRi9JtqTUQ7kNvwHqtQma&_nc_oc=AdqOA7K3kMsTSDLkyAHtqr-hSdNUNYnVM7xKZKw64DlxROyJ2-1cna1RDo9eoWtNGus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c073VEd0X6L_4DdZgfrnm6Zklv-3GsUd9wZJPPpoOcw&oe=6A19A971"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km6oXx7jMzwQ7kNvwGfGDRv&_nc_oc=AdrLX-CddzQh_lHJ0gXVGbPmqYtcpMVOUUPAWKRcLlzT88qxDtW5wiXdNnuU6YF4haI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IARnzmRte7psLFAeClyeDLuMfccRZmDO2Y12fnZcfvA&oe=6A19A9DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCIQw0Iq45gQ7kNvwEFGpuT&_nc_oc=AdpQ2TLmUoTwISMpu6m-0G0vb_tmVggY7KpadTE-lGANWheqvEgGkozRbpYLFFe8RH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ON7iL0Owoso1Ns7G7tbl9L2h3Nv0cufRfiY4oGFHIHg&oe=6A19BAB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnvTT5zIAQcQ7kNvwGUc7yi&_nc_oc=Adq61ynZfCDUzjgBMx2HSZg3oGeiQLPmzMSTEJ2rUPawMlmVzZnr9MMIe0piE_bKwPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X6NDwZjIzw-nEwXzoFROhN2Mo_tSdBsmUFSTcuMa73A&oe=6A199361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNds66l6TIQ7kNvwE_34ui&_nc_oc=Ado4h0n2VDV9ZG4u67PKLlLuLDRyS51wQKKteb1ObnI7xFZ_-d_TIrSFRul4LrNnL-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K8Jf5HlZ_5Vr1LR7x0k9aiUYQsmslLB_kF063mDUiTA&oe=6A198CB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
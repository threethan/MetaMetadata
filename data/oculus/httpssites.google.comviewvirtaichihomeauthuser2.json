dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPCkZIhaMjUQ7kNvwG4jsI4&_nc_oc=Adoi5lRBtYfJNoJbb9iDBtx5GNwMMmnrrCfDJE1Ok7GsiVHViUP_fhJnlpCU99MQLa0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sSqD0G6W510H0H8yETJi0kAc6_pD6RQKM08y_D26fcg&oe=69EF7971"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTFie3euf70Q7kNvwERE7t-&_nc_oc=AdosId6OBArth-8Twu1an0wnHe-JJtiBXV4fvF44djx7Kw7LXcqn07l_q7Qnfa3KxMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fUWoNfC_9SLH0f75iyu0M5bMWsQXIfXnl_FNOihdNiQ&oe=69EF79DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qic7izH2WkAQ7kNvwE0VPfB&_nc_oc=AdpIf1ol2jzfV0UtEfDNTWK8H4gYL_0jRe8V_W5aqBmaYc8FCV7dcjOb2yZQLykf_xM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KYR9zNyVvzY5uIifF7gzKAx-gMMkkc4qjJ6R24mVWNQ&oe=69EF5279"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHB8-5Oe_LEQ7kNvwEh6E2X&_nc_oc=AdpeDuBks4NzJ7_TVVtmqhHLTrftmdiEyQjyeOLwZKCen_y0XxuDTJSnkgfXSuPHTYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vAAZDN_VueXLVcxJAEZGO-d1e73ACRfc57peoPsieHw&oe=69EF6361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVXiqNL1GZUQ7kNvwFX9OUa&_nc_oc=Adp_Gdbs6Ms-r0VRVxc_gf9YIw7SbkBQ1-EkiQt_7RlzatkaJX8cNsB7ka_WkWQO_fs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wbQalFeYBzvLxy8Sc3LqIgQE1HC2K8NCporHXrDe9PQ&oe=69EF5CB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
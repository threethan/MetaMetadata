fra5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUNz6oN8OEcQ7kNvwHcCSqm&_nc_oc=Adrl5-vMct1l2fqdA_Xdx9NlwxIW11AyuPBHVcoPAFzq0nWBS1ptGAbWPcfffehqeSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xe0SvnYc9IUEop5wX5YSTRZd56xre_CqJs4ukw1PYsg&oe=6A32B5F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMzG416DajcQ7kNvwEN6WQy&_nc_oc=AdrgNMSA441Tn6yaq7bhPlwG-jtWVuvtQfdU14hIt7YLEOcym7Zkr3Ylzji01P_Omeg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8czRdYudA70andiISloHKJ3NVDDfGzhxNeHwzAOunXIA&oe=6A32B65C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyAbG3a7l3AQ7kNvwG4OG5m&_nc_oc=AdptyBVunO-GBNb7y-u2btvzcN7Z7eoR8D0_0DGLs_-hCVAaaObSIIghsTzp-fgVRtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kuDFitE-cyOHZDaOqPCDtzF2aG3Svptni-pt9tDrYeA&oe=6A32C739"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bLWQmdecNoQ7kNvwHeeABS&_nc_oc=AdoVa12Zvg32W4WUErELOqqxuufEhn0muhd_iFqhuXl4gqieN5F1XT5m96RkAQY2_nc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xX6pLlGzc7qiTjmW9Px2Fhe179MXpqWDF9FjvFMSmvQ&oe=6A329FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX6eVIy_OM0Q7kNvwHIh_AH&_nc_oc=AdrPQV2qEF2RjDlnbZ6FTQtM3ELaXdFVnjZIqUCVkzuWKkkYooayiN2Azf_1Z_EoHio&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af821qasXSihgGivloiKUuIl3EkvtL5n06Dfq89WciIRVA&oe=6A329934"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
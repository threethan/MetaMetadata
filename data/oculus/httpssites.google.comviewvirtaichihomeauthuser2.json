64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOrO_8lXBjIQ7kNvwFRzuRm&_nc_oc=AdlA4bpoFkXva7A-eDdmaqkb5O7cFd3k1wH3AcsJqqATxZBn7qcDud2rswX8Xx7DLn0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_1_Ud1PM9w7K1FCILUhEV1gq-zDQ6cLyMqI-edhAfYA&oe=69AAB331"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FikLKP_VWjMQ7kNvwEyf4Sx&_nc_oc=Adnmx78ddpmPWPLu2P9ji3jSnLyQvsxx4MaPlOg8APKPb2gR75LutoTOna8qeeYjUX0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQC2IilAoiDh_0HluzzKDetGhiqRl_bpHKu7C4gaC2rQ&oe=69AAB39C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqtSKc9DcQgQ7kNvwErA9wv&_nc_oc=AdkzFawrtqgJE6LAzZGSc-P_WdWmHQv2mRp08mKdhGMPrOimpKWe5wa0uU6E9U1yM1g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOXzNivOy55XAPJ_IvbrRVxOoPXkeWo1o9F7y2iFNTQQ&oe=69AAC479"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ktVuXXFo7gQ7kNvwHOVXq8&_nc_oc=Adk4lVmTlgH6yh-zHk0S0uadtfuRR09oW7ua2uVIP1ZJ-bjkw-FxHWZcHJMXeLiKzLM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZI2mZGGFyzD1zCW4x-0Q5fPxZQTohfDmiD4KYPEabPw&oe=69AAD561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oYoO9oov4EQ7kNvwFQAuAD&_nc_oc=AdnUplUNVYC59cl78wO2sfjVXn6N5kEPRYQFKtJjp7Ok7KGCRJ8x_kbTMTsI0Jj4eks&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLdEieDugeVmXWx2EaXV3WPQofuvgVivvfk4G6EdGPog&oe=69AACEB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
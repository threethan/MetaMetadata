hkg4-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuFifSwvwL4Q7kNvwFSU9Hg&_nc_oc=AdoRLMYwmCaNZQFqLoY8ItvGaeXS6g-PsijyKzCjG9fKf-8Fy8ugtq_TmTe5yiwzCks&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBQbu83R2SuB0hixF83pSp92rLfEaa27jr0upB1QBaLA&oe=6A9169B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlwJ2nDOhYIQ7kNvwGsEC8I&_nc_oc=AdqZjbCqpZMrkRCN5B0RNpGaKX-2xDJHyvo6VCFAc2xW_G3YFWkEx-41J_mBBgg_wjk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnjZJ33fqOD6wEmUU5sIFVBR4EZlw2GK-WEoN_rHL_rA&oe=6A916A1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-oxz1BO8RgQ7kNvwFqLHBj&_nc_oc=Adqi0uQzAHtU1aPMLSAxHpSA5xOWKMfjgYjFHdQw09Vh3kUK3WrmEKywW2jXUl1gcz0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsqYAvce9RnVSGKFWhzUXA6kl0xO99RoiJtvwWAHxqKA&oe=6A917AF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbJOMWL6CAQ7kNvwGlSLGg&_nc_oc=AdqcyYxTGT1HvJUz9fFJoBPWMr3KWnpSYxH2biT3YTpd9Rv7kjbOzl3YHzEOfEWR3QA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoLeW1VNkNm0eyw0JDZLMuMIuc-MvI1crE8doe3WfqbQ&oe=6A918BE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TmLP7Vx5LwQ7kNvwFJ8PbG&_nc_oc=Adoj-ISljXyTOEc1DGoMgtRrrzyr4pV0o0ZtZ1OiYaGAeQy0lyLstoajau7-9IDkDuY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE9BNOa9S7ilrv52c2xAG0bBUqA4LBzIgS0JJ3FiXzmw&oe=6A918534"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBSLUtUSGn0Q7kNvwHSG_NF&_nc_oc=Adr-2vu0O12CaQ9tpT7mhWrrEB5liUET9Ze2b6lnycPo-HFEx1E1ZKtSOa22CWuvazQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XLyJdO6RE9-m5U7kR2RjctxNLDOYVIaaphkPv6Vit1g&oe=6A3FE4F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X1TW-TUrRQQ7kNvwHG8R1c&_nc_oc=AdonYiaEIcn7fpKcwBKldpvwUM7WEJQb39eW7UtFByg4CXczp18oEoSktpm5fICysE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0xw1GHEJeN-i7LtHmDRJmjPExcx3Ve58SVbGwiLToPw&oe=6A3FE55C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emrtKXJZcfMQ7kNvwEDazft&_nc_oc=Adp6_WAiCyf4_a2ExFPRFyn8sZ0T-OcnjBnL-MvofIggdoblqazS0HPVWFrFHYLL1F0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YW6aqgMZqc6GhCOo6g5__w2sUNWVxOxqDtnNIWfm3hQ&oe=6A3FBDF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzlBJ9GXDt0Q7kNvwFeySwD&_nc_oc=AdpjN6uaE5w7PeaaVHddC1ugCkJhAjvO8un6Mce5oWDGAXWQxR0o7r7f3-S0Hgc-bpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WOqLlBd-F6ijidJV9gyEYpaZt5g3_29qDPleARMjKOA&oe=6A3FCEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ZvBF8PBj4Q7kNvwEtrYC6&_nc_oc=Adpas2YEiox41-8FPH2Qtlf9tJ49LK4fo266agFEhgpY0ys1LCf56c3yjAFofHwx8ew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6PITJtLegpIRrlqJbg6CJm5Snz4sUJf_oQL4Sl3BmTA&oe=6A3FC834"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
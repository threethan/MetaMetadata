25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9BPiLnIK1AQ7kNvwEjCtwC&_nc_oc=Adldg7V36_fWw9EpxgN9dKeggWZ7Q4JA1oYOQiXlXAoQMTZIGaJep6zDWqPjjG40QWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2SEuAMQDivhOTNfyCEHPwKSGFE-EnGW5BnjzCgXotug&oe=69BE79B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIktOEpolbwQ7kNvwG_2aA0&_nc_oc=AdmhoNaErDbVDtz-3ScqR28tSNDCK-Lo4K-pl2BT5kYs8pmq4ENQ3BlzFaBY1q7LTzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjjw6MJkWlhleEyHXrh6g5g_O3jXz9mmA2luOfQI3LcQ&oe=69BE7A1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkbyLXDNnVEQ7kNvwH7YXIk&_nc_oc=AdlbIz_F_wfTEXR06KIUQVukXlH5cvFKxyVrBlLLuoZ24c5Sz8xOQx-aZFIKCkbrlvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhdXBFIWCcFpZv1gtVEO2Ecj3Bw7iBGIjv85D00XHPSQ&oe=69BE8AF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfgMHR65ZS4Q7kNvwHBnJhu&_nc_oc=AdncLcrQJw5cuzGsUSD2yydQ3q-VLyKbe2jo37vxHnY9VzrtUu3BvhFh0b7Rr36PPsY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySDWFgh79-Tmu9yyBR5sw1fZ_Jewt6iuSBlAODG2b2BQ&oe=69BE9BE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xmNFrHbcygQ7kNvwEsnyd-&_nc_oc=Adkq794SCQCJOas4kQZuo9n-IPo6snvTMVpNocVW4K6MCG59ebmq7C8e-8cYoBonfF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFOLbWZWl0CELGzHxNM7Bk-aDSOffZKvXxuG4NaJB9Nw&oe=69BE9534"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
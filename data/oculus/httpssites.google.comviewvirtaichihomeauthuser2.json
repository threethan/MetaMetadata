fra5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HaizOO4ju8Q7kNvwHYy1Ez&_nc_oc=Adr-PySxr3Ur5qEsWDaXz_VEV06UdS-YEMOp7asvxtmlY4WbYXsFz5kmqt1ojleEwtk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20mwDGs2fX53cHvWlk0ORjS8i6FpDQVFdxLKE_RAPObQ&oe=69D7BE71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDPuSaLms6wQ7kNvwG-u18P&_nc_oc=AdrlMWAGwK7p7fDFvpmJnMHu7eAZrexj40Tsahnzi7n3t6Kibhw-tDQ9UJconwKbkUA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wymyzsuhd3f9hV-06sXxTwyyaVtsYrTcKxqwSG-KA5Q&oe=69D7BEDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK0qFldxKboQ7kNvwFW8I1H&_nc_oc=Adqyj0hwqqqtRNPxUtJ2WjldI6FjOlfflyxMg-j8F5Tr7VaJduwT_FiEzmt9aRsd71k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i4WQU_x4rmg4dNUc2lB_d_Jrn3OQfVt1Z5IEpEeHVGw&oe=69D79779"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlEjq_wYOZoQ7kNvwG4hKOV&_nc_oc=Adr78pJyKex9qx5I014FnuIaQhotuOAf0hufhMHbe3RkP5wa_hkxKOsfgP_HpW7QMxQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0No8_eZpq84iRl7hn1AKGUUVYJe2UgX2LTNeMAfU5h3A&oe=69D7A861"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAfSOR9U_FEQ7kNvwH2lMqK&_nc_oc=Adr6QA3mfRSS6IkEygXH4ImSd3HZCIzgx50gYU765uPIjh1coPoorHVzZoeHgv4q6Tw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g8wnxzc9OljLc7EEHkS4sylFIqFA6C7gOEVV1WFpBMw&oe=69D7A1B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
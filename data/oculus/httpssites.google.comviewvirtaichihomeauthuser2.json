3", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRsetUS4yjgQ7kNvwEbgI2i&_nc_oc=AdrhmigaC7O0v7aELGL2Lx6WI-7CXgRgPHtFV3blPkPCHFMTgmbH4sh1qF6mqOMI6Aw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S5TXFhgSvZwcmSZJZb1QkhU7DWr35pLVqMFiPwAuyjg&oe=6A11C0DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy75n1CqeJ8Q7kNvwEJs1ra&_nc_oc=AdpfoQV6Uqh9YU88BVIAKelUW__YLK1cvmSbCLSkyBv50ZEHYC9KWQrEUjtZsaLiLRo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TzxlMFuZ-39yMQuK2JtP2iZWovFJzqcWcvoCiKbWgmw&oe=6A11D1B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s27HOYu90-kQ7kNvwHG50zm&_nc_oc=AdoR334hYli6FX-woVBnwbOFeDCcTWzNAOBCu_mYC1SvjZvrqQhm3XjmDym7cPBIa_k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ekwR2pD16h1vukFSPWqwVVE7VL-J3gVyTASLBPj4LSw&oe=6A11AA61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoCHd7dXcgAQ7kNvwEl9KnI&_nc_oc=Ado69XAhJk-sEbG8UKATllVUI6xKlYJQB83sm3WQ4uQMw4fKEpuhY_yPgd_Yv9zRr10&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VOaevqxu3QN6aSkKlLZzge8GhrjOBhjOdLZg20yG-Uw&oe=6A11A3B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29073331232282767"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "648851100895848"}]}, "baseline_offer": {"id": "648851100895848"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743687960, "status": "PUBLISHED", "id": "648851100895848"}]}, "liveChannel": {"nodes": [{"latest_suppo
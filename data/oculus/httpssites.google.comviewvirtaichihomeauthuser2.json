content-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnQE9xaK3iIQ7kNvwFc8Zrn&_nc_oc=AdoxUB9MG4BKNq8jNUPocyT1BSvAh83GduL1kRzxlw6lNiC-Wev7NJ8kFNgMQ9nP7mM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHurLz5Rk-94we7kha0impnsS7tVK7AQpnKgkx1bVRHrw&oe=6A7DA331"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvQcJT5-VQYQ7kNvwFcxUZF&_nc_oc=AdpP6iht_bIfr_Yafe0NEI-Dr8AHfRlggX06kbmy_9BcYWvFDJCr9nhLSNNxueOBCOg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSR-UzPfpLg86x7xiGzFYpnhUx438VGSDeZrtIS4mr7Q&oe=6A7DA39C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ohD_VtiM7oQ7kNvwHQVNIZ&_nc_oc=AdqtjdC7dBxAfj5my5i3knRJTas63eHMDm0QsMMuJ--kElP7t45UGN31J0p57XL8IMM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETe1wIRELu-B5XLg-NEsA_GxaHUZ4pOlNDRuTGslpYKA&oe=6A7DB479"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgMOSyKOuw0Q7kNvwE4Gypw&_nc_oc=AdphsRjMiDSy9NthJpaFDyNx930-6Nf1J5EHg7XJdo2NZHjaVtF5paRmnSNiVICxpvU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTfPbT5ViwltwhTOYP8tPxvhxGlCpXlBG7zg1qggbh1A&oe=6A7DC561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH52_ccOUcAQ7kNvwHsjO2r&_nc_oc=AdqkOBU0ltwa0s4_LCnPTBAvQFKRZ-5f4bi2dLLba9zwBkvgz5xqP3OD4B-dFPzNPPM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7PjWN3SCDWrkxOeL1gRS2uHl5LBcJErB6O-FeE6oCrg&oe=6A7DBEB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
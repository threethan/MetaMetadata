25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vneOCYpDbbwQ7kNvwE4Z9jE&_nc_oc=AdnDekEY76l42qAQXHYspOTcSJaV2PyCA-XIpv4Ng0rpfxODJ_oS8bH4z8Aw5eatnIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0lFp78t3fGEJbSxvPO4U2cYBlzwzv2IZRm4eGjpsEIg&oe=69BA8531"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70q4-ESOOhgQ7kNvwHYesmQ&_nc_oc=Adn0-fZPWRmm09SDJbhlvicoArL-WwJ7gXHeWWdIxikoXJH5mU5gslrT90di-sZcBgc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSAHZ2OHNkrF9E2MO0b2CMX2qrc7FW6Ebn2xcnBRidjQ&oe=69BA859C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW7WUSM2-mAQ7kNvwGcdjkQ&_nc_oc=AdlcPdI-tQj8SRRVZXzOJ_dc1bo7dx9OSXHX3eITRawIPSoP5fAzqKhBZmGq_p-mvLw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzz1TRQGDpin0tCx8UvSd3lp9u5ioW3787-Scxv6ClUiw&oe=69BA9679"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUTzgSRzq4sQ7kNvwHgVWNV&_nc_oc=AdnoSfcnfvElNHXL8e8TToqKU11TnD5Bd94aJEIrkSnzMvX-3Qj5cD74_worAyT-lFo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfytqsrNR6UVbd4Xog678o33MzwnAzsu3qLXDGOJHQJIMw&oe=69BAA761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9yiatkDtW0Q7kNvwGaWKnz&_nc_oc=AdnWNWmwu2adLEHQmMQ-0LX4Zsww6QtyPXLlERqsTtJdQrCvszaZ2yRW_PbhNyp3AnM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPGnAIWpgPxaZnDYD0KPeZapsJDqM5DR0Pm6MAlJqp6Q&oe=69BAA0B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
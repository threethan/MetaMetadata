25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vneOCYpDbbwQ7kNvwEM0RlT&_nc_oc=Adn_95l1EQpA6qt4D8jTwqCgV4hys19K1Qo7PZRKvVTDNJm7lWOPM02HQZnmdreLtG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHJP-fL42VIVUTOPYK2Ng8_RjCPG__rLilzjotIkWoSg&oe=69BC0EF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70q4-ESOOhgQ7kNvwEQJDQl&_nc_oc=AdnKcyqBvtWkEHCOWbIpG3RKrlyDEEIZwfBYMKbHM16gR9JZh7HMDsSCytpu4o2XPNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4ZmpjI9dywaRmTY-kyDB8moj1dNCi-cB5o12xP8NDtg&oe=69BC0F5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkbyLXDNnVEQ7kNvwGQDX17&_nc_oc=AdmXnhbenupGscpwP3VtIUI2ZPmap51HfUhb0x-TTGJT-Bdbi2R2P55rq0pyYtvdTVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRj-Ui8BOGGtpvpvX4dYKcUxt_YDMd0xuSOIl30T3eVw&oe=69BBE7F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfgMHR65ZS4Q7kNvwFhq6et&_nc_oc=Adn9a0HekMJtcLkiS-wTnQmnxt03_MQN3BRrYj8dwELzFFTwFXxmjQC3704N-luoBME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwr5jymJa77ZaLT-bHsTd5vKZeRl2PFVEdAypA7zagbqQ&oe=69BBF8E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9yiatkDtW0Q7kNvwF1Olxy&_nc_oc=AdlgWpHePpTuvMZk7WznwmTIim2hVTwpW9w7leN1omu7hefZC2UG0EtD8FSuPZ80HI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3_sZlrV_9H1S2Q8l6AGZcQUeNf8gSId0YcAYzRPNaUQ&oe=69BBF234"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HaizOO4ju8Q7kNvwHglm9f&_nc_oc=Adqg20dwU2RKXf4JMQQnE5qP8M28r2813qwb7zYZghNNjUSXMJIlqSsBKkCMvqqKprY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0itkluxrWDFHvXn54t2K_vXEzfeIziPlJ5a-oz1eA34A&oe=69D634B1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDPuSaLms6wQ7kNvwH_QumF&_nc_oc=AdqrzeJspnoElNmqzO81fKbJY9atTrdLzfSe9Onq_4iE0FL5o3XMt253-9ycTb1gE-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wpk9-VaKyYV4GR4iEiTsL6_2LQIFay3K4t8DIdTVkyw&oe=69D6351C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLEtJazadCEQ7kNvwGwpAa5&_nc_oc=AdoqFYDtm1HzFw28JAfdQSkv7cS7CJQU8NjCFjrtEnOgo6htjPl6D_L_Ye0DdVy1PGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QaIoFww39bz5YTtIHOCbvYU_wTFmNlQZgH41SX2IPYQ&oe=69D645F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNYzr2CfAxIQ7kNvwG2xuLh&_nc_oc=Adrf62VIWqBvS4wuXxYhVHd4Eg6oUkLBCzqnuxbVXL9heW9LsLfarK4WKY2JWbvILyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33PF9rlUnWYGL36WlFRMc66CIZTGAYLotlieu5-PJUWw&oe=69D656E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAfSOR9U_FEQ7kNvwG8YymN&_nc_oc=AdoaSJZwOAUQwKr9KJ2D_KVjUhu6t6PhuJna2SXWan2Qe-8mh-wU33EQ_TJ6JvIJcqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y8DTX2niv-sr414R4uM8XtLP0GN1RE86yj76t37slFg&oe=69D65034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEVJK_fOpy4Q7kNvwHZYxxq&_nc_oc=AdoyL4HwYp5PyIkj1yt74MkIUB0QGZ4w4K7Mtlxuvn_-pnHI3BgcyqhIeAw9C6R079I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU2YJe8OugUZEuRvc-lmio32ODnXaXOBDYAgNlyazOzQ&oe=6A4FB6F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMMO2_3D_WUQ7kNvwGWWIxw&_nc_oc=AdrUBa0LuiH7tfhISeuw9a3jst334k4quMPHt2MCUs3UZl78Y1ieKKhKkQCfTXTXgXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1oFjMNRa78Vp100-V2YpLEh0dV8aE3hM065gUgfZknA&oe=6A4FB75C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXPlixgoSQkQ7kNvwEyJuWq&_nc_oc=AdrTScC8tVrJb7gBZrKWGmlbHnBcY8qx7qwSXbpKnumtYBI2d9UHVEyoCA8sSfKjoU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgHm0GTMINK2AfhWLkltIoakrgR7kgqYaN2qd6vBGZmA&oe=6A4F8FF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_GoZDxeC20Q7kNvwH5_3y9&_nc_oc=AdrBcV99H6nr76oK94Luqsxu2sSbX669ZEKd1a12DwQeGHR7vWvIA3USj-OjAUc0SQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH_EgaPE0t9C4fYUFd8Mv5T98p9axycuDIBH_3M8xv2g&oe=6A4FA0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc3-fXIAoxIQ7kNvwFIneW_&_nc_oc=AdpQqZSBkDbPj1zXwCKTOUIHgvBosIU7XpvSjGGa8tBvixAE7Nt3SZQUsKAdCsD8Dqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL9ffm5xUyKijJ6RPott4VCs9P8avvSCMG8wwXp5O4AQ&oe=6A4F9A34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JobRk3lIV2AQ7kNvwG5c0_T&_nc_oc=AdrxL9d5yDEMCPj68zEqoRLKeAA1wiuuxmbb5i50cVxLYeSOTBRlu-NZcpVGUwaWfX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3RQMEDBYpe4Z1gIiBTirfSQdemaOmGWk_ZwTVhhP4ZQ&oe=6AF08DF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc9NfdIcxPEQ7kNvwHQRtbO&_nc_oc=Adq3iE2e18t5tWe1x7gNCe69otVQJ_IqSR-bdk2tAMfZMPosSaqStwj7pUX__kJwXmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDp939ODzYF35Qfn1d8BdN1DFxsDgkbxzUOAXNiufTOg&oe=6AF08E5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_6Dcf-kMxMQ7kNvwG0GOn-&_nc_oc=AdqJFfnXtMpUi4nv6pxb-_wvrv0IpdoFzcVuHTy4KXvlNOgxR30ZZJfFy4lVyLbLGiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDer0xFRaSoiOsMR1SwCnSrZjs_ZF_c2IgAIWaXYbB7A&oe=6AF09F39"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IalCCR6TJcQ7kNvwHadJOk&_nc_oc=AdqyDyXiwy7-rZwBnSnt47ZanByy4Lb5iY05UFoeqpoj5ph2Bp4E5BQJnV79eO5cAEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRdyYBB3niCXAx5JK-Zt-2XvsCqQfYhOC11IG-gWnrlA&oe=6AF0B021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xp_25WrfW8AQ7kNvwF8efP-&_nc_oc=AdpYW1dmWw48qQvRgX71QUpWbjPJKlZJr4Xjbf6I0hYv2p7IJ0uAxGvYF7dA2uFUaK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlKVLgrHrOJtHXjkOrPkHOMux0iTpgGZeuFgLQnDpniA&oe=6AF0A974"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
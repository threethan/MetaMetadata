fra5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtzRi9JtqTUQ7kNvwHoMpim&_nc_oc=Adqk6GQDjEdxrz3G1kqenJxxdahWtp4bD6k1iiCK-egmFDp1oqidKdxM3_-3m6jwR_o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77igQ0xIRjG6hXez0ryqsCOIs5esIk4XMmQitQthTeZQ&oe=6A1AFAF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km6oXx7jMzwQ7kNvwFD952d&_nc_oc=AdpRJ9USKwrPDRTFgrFICegdkhgKYeVQnCBmiNArld40DE2GFkqr5wnvBwkx7wmeGxU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74Y3P6cXJkxQ6X1pX1Q7A0QHucGgEpU-OfxghF5ng-qQ&oe=6A1AFB5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnPBcFfUHl0Q7kNvwGb9wSP&_nc_oc=Ado6ojJHsjO1EdM3xzaAM792NKue-hn4y9odDgoCrOMmnOQhtb6J6hI4ia8jmTyhozg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RYa_GEUo16zFJ56xngVwIgAR_Deh4bishNGhwGG4nGg&oe=6A1B0C39"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR7xRamaIK0Q7kNvwEEleh0&_nc_oc=Adof9c9VduKBXQn1nMvd_KzdJgFlDOxOwofeIRbhKPjrbJTFC7fr_bEaJQrS4jdmuWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OqoNkpG-tCXQmPJi_gZ3WQUI_jN-hmSNcWSYaT4qmNQ&oe=6A1AE4E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNds66l6TIQ7kNvwGUiEeR&_nc_oc=AdqN6vZjhYVe7_BKn_UU6ssfNnUOPodhpT2rcYjU4wQ8Ub1rgLG22G1zXd8dxGGb76U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HWG-3nLkDbvdPwkvIGr_UTnK0Csu1f_QpNl3VhQBnhg&oe=6A1ADE34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
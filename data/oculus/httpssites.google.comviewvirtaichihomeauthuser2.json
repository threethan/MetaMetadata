atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgy-xWEjvL4Q7kNvwFTJWQ1&_nc_oc=AdrgqZVpq8u5boC3GAjDTtVUGoU3-8yLX3bGf42ZngPfCjUzMjjzmz07ohMSusFQvso&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb8_esIeeBNY6RqS64bmL9AhcXKe4zCR6mQ1cR8A6MEA&oe=6A6F5AF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTTvRQDi418Q7kNvwE3LqAD&_nc_oc=AdrmWdMnq_1wuh_fh3oObCcwa0m5VFA3lQb0Tj1AjwqjIIgqeTwq--7WznoxXlWba2k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFH849ZNoUnNmxrf2Zg7oGcKXQO8GO7iTiOEhKT2DJog&oe=6A6F5B5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2GyEiHBQnoQ7kNvwE0LJmW&_nc_oc=AdpbCyBDIdhfVFaKgf0uyp0ue-AWziWQFdaxmKGZK-aPhio5JU_spn13R2W_wHzCq_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHnXBwaUmkf-icuMTmYeyMmfnH97FftC75uGAWTROBdQ&oe=6A6F33F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knZ4mH4mPqkQ7kNvwFsS8BP&_nc_oc=AdpMBOE25Pi3JlIysFpep8aHrMikASJUAj6pFtgDBIiZ_fm5jajdHnSI6Gr0LO4h624&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7yyS4Ljpebl-1u_iNxPbpNY80oXXm9gbax1Q-IZlVUg&oe=6A6F44E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eIZUxWMfFMQ7kNvwHQsdxr&_nc_oc=AdqV_y8z5bLDgtS5hQnBPNpfSOoUnmRRC4yjQHBdLIMUYjqe_LFpqN-POMJl2wFlFxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVh8Sc88M1Bg2DvM8q5O6hG-2FtmKjQwJQDU82XjBiOw&oe=6A6F3E34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
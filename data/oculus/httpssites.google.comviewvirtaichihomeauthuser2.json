iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBh0QGfGTnMQ7kNvwFmXmdm&_nc_oc=Adrnv39Epn0N78GgPLjg0PjbT_lHJY8PO-8CBbthpbzoFhfFaR4pjLj4c0QWEdEmwHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXJT9f5X1cSgddzEw5InWffRiU-AflhKaHcMLXl76SSQ&oe=6AD23B71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO_ecRTwJ_UQ7kNvwGVI42J&_nc_oc=AdpjZsYdKASRowSZDWgjftRsd9kjpQ_1zVvjJmjoM7TDyugVDvQ2kgJ-9Fg05B7xrn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr1vWv2Zq3LfxDU7V1_ydhrbXEAoARD--ZaqGXla4LWA&oe=6AD23BDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHrlCbfytcIQ7kNvwGoA3AC&_nc_oc=AdpHWU7LB_6ma8DmJ9wvcTtapO3thyBoIuWcUuw9w4gOFJdqOtThfxpoPMHnhgzOJAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW4BHiduzy3Ky4-UpaLXNpXTOJMGWIj_DkgWj0cM2DCw&oe=6AD24CB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUjx-5R2HlMQ7kNvwEuXGWd&_nc_oc=AdoM6lor0vmSB2ZQmW0vlLCGi-crIYSh2BOi38BPPK2pujmtrjWGPqqbgVZEJcKiOUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlpAtKv7lxdok6gXUPVubQ76jI8rv5qb9GI5NAT6r7uA&oe=6AD22561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s91pEopQ2cQ7kNvwG6zE5x&_nc_oc=AdooxUgW3VLNYrGsJlxNBlllv76NedmAzCQCHdCjypoMaw1qwOPBoYvlNiNT1yNPtmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUfR5bznZhvMMbSxO0Aqk49FGquNsZ3HMcqGoP77aOMg&oe=6AD256F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
ord5-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA2cRENuwNQQ7kNvwHC7-A1&_nc_oc=AdqdCoyducPNJDSdSxSl_QYhuZ0mac2Fx09TGSnLL96psZoyM7gu3okO5yz-UTX4XzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0kyKbaSPC8R_3BAEidhTuGf-bbeFuvrfSpF4VnbJjrA&oe=6A47CDF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMz-GGdG4kAQ7kNvwFDkIpa&_nc_oc=AdqCRf2LiPuY79lVD9LK9dpaKxOJgs8y41SxIZyVidDlAw--Kj0yW2NdT3-WyTNfFck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rwhSsDTibMloDghcUnV6teGXiv09ONDEAC7XV2mIj8g&oe=6A47CE5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koeofplDVmUQ7kNvwGTS-vk&_nc_oc=AdqtRQKDWjmhl9_D6jMabBIK-WYQXECBxm1R9aEqeL4NtA_F26xiJm_Pz_YAOeIKbuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_43zxozcs9vD0QxEnU9CUcYmv5vjeRR05_JMgtwegWw&oe=6A47DF39"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l28Ys94bEPQQ7kNvwFepxNV&_nc_oc=AdqGos4UYnUW9crCen2b3K3ag6QM_wEf3CY-qEiWPcqYXY2Oaac435zIr6dSqD8dFkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SwpmBf8kJyRsDQy9C6kdbHGQhATUJ8VKoZK_We6DvQg&oe=6A47B7E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne0Ak-sClo8Q7kNvwH5LuNp&_nc_oc=Adqg858GHAU3hfzA3srscj_XjZQQd3Namtu3EXbG6ZwCRBynzpRheVYh3r8IPXUU2ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XR2yY3dvA7VR79z2lP7APY_k40rvWzRaMmRU_ir5oyQ&oe=6A47B134"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
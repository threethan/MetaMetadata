ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrcIcfW-K3wQ7kNvwFwTB5b&_nc_oc=AdpSCRY2qCNI5fcyPiw33VNvt3n1Q8Pql4JPilSAHBKM1LzWVHgiDJ8X4mVmkZTjay0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l_-ayqbP9XvmpVWbUN4LrWrGEVRjqCo76OWvLe4ol-g&oe=69DCCC31"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3hYBQym6WAQ7kNvwFfIItp&_nc_oc=AdoNWZE7rtb0q4f-vOw6mYJrQr756OTMLaQIBQwlsFn3a-o9jWd8eKZgt1eK7lvseXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UEvFRLZTTmr1cskBflFHNhj6GWoqFkh24Fg1Wotp1AQ&oe=69DCCC9C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUCgLeqmW-sQ7kNvwGyS7Lh&_nc_oc=AdrW9Y3q9VKd301axZPDSdBolZ4dHdN5-Vq_Gmj2lldFMphamEqbDezm6KRnb4jpXto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vHAdlSCNMkainDfOOgOPSNrKqw6qs5zpuB3Mij8ZnHQ&oe=69DCDD79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_2nLzXtmGQQ7kNvwHveCph&_nc_oc=AdqRqQPQjVNMiSTK2FMe0OfMko_Z3EKtXznSQLRAn87DQH1X7kAQzAe0UeHTH0qyqVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X0yLD96s7Lg-WIY4BTKkoJqQWURO0rQV4CNZrtvQytA&oe=69DCEE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00QNXSrsx9wQ7kNvwFKlf0F&_nc_oc=Adq-ZCwSep4jdm25nwKwUz1zh2nJ0rMY0tY6CKpMtWjhtWazfLms7RllybQyqG7YNt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h2van0Ksg6yv-Trfn-0mL-0pexmn-reVeZ3kZ-BBpSg&oe=69DCE7B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
ams2-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P83gfPXajawQ7kNvwHx1d3q&_nc_oc=AdoW276IefD3Casje5lWqEKc1MXgywy0DqZmR7nDUCE37tWGu6e0AXs8MEQXEjrciZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7tsjuAraP1SsEAwFTBozsl2b5MI8EJaybxd57u6Ijgw&oe=6A3E9371"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X1TW-TUrRQQ7kNvwGWR9Lt&_nc_oc=AdrWKzdnaALOsnUfj4uaj-ziYh3sk9O2OevKVIrHfyXpYyFnnITAcff-VWAOLjbMbJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jVAV3-6gdH1aXo0vu5on7aQjfDf79KazijRad7YyPuQ&oe=6A3E93DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emrtKXJZcfMQ7kNvwGVVAjO&_nc_oc=AdrXVr36Rl8nud4F_J2Oa23FD4SOLAFJwcctRRMRAThWkuyBsoW0fIILoI3SqOLcouc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WnpL7BbMIGd3qmKZkcqUbZcrr-JyLphS_kDKGly1dEQ&oe=6A3EA4B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzlBJ9GXDt0Q7kNvwHGwE6Q&_nc_oc=AdpqkUTquO1RenMs4bQ_UF-SbGnsz_ruYDryqWKSKyyMTwyFf8Hy3_6MdUK6jIYByTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YxliQTFhRlFpiEwceF_lXc_j4ZFK71yPOGQRqUXu0cg&oe=6A3E7D61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ZvBF8PBj4Q7kNvwHcK_zZ&_nc_oc=AdqHhz5rrwY71CpFy6N1Rk9Xp1JWi4wl6m_r0GOCfrAzbdPtOVdxY2ROVWzwKXekfLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0FGOzNR65Vg3XfTuZXCr9m-XO72i8jNRC_bsJaH4Odg&oe=6A3EAEF4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPCkZIhaMjUQ7kNvwEN1BAg&_nc_oc=AdrQ8MaXJsB9W_ujKLO72J9TfSooo36i5z-005OnulzosXfmt3n-4YAFuRNeu0XJSFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hqWrzrBP9pa0SVM3Fa7qytT9Pw0jgZZ1RaI0tNdUSyg&oe=69ECD671"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZR9IudkovAQ7kNvwGMYJ4V&_nc_oc=AdpvmfNH7d92l4pga-bFMrixSaMzjzD0KkfAsvuI8c9ekCw0HAkwDfcWW7gjzDypIOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cIk5gIy5vGux0nGWAiYyBM7jzKBE0b9MXQtERxJa9fQ&oe=69ECD6DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MTbfI1ztAAQ7kNvwGEEAFL&_nc_oc=Adr8Lb-M1rsYZUozfPFsnymTPm_B7hqAuCfy8HH39YLBez6nCo8zbeactly1rL50V3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wx3plpPZagRohdDCby6mgv6k5KqorYUVcUb6dwgDTcg&oe=69ECAF79"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXnVcoYutxUQ7kNvwF2WaMW&_nc_oc=AdoFWLsJzniim19FgAjxkZY72P-1r96A1wbVAc7Qnfv3kXNSSNqUpj3g9XJWF506J0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21UiMBciOtGLoDCprm7F70JhR0T-52ebDyRAM1hOkbXg&oe=69ECC061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwh7n351YgUQ7kNvwE05274&_nc_oc=Ado9lDQGqHKdlKtQc_REfbPQ8tCb7LtrlG_Gbs4YWwU9aT2fD9yFSkAsJ7xMBJdVKPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hdRSeQZ3r3QJLOADSFXW0PduJvhX9BSe_B9nk92iSgQ&oe=69ECB9B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
sea5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKGmJtxjX8sQ7kNvwGe_HW1&_nc_oc=Ado4FIL0FOxmFFSzd6YnBxElKM1uaL2ptoB4m0dgtX4DOfS88PSYalcOVWSnZV4b8d0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY9MbkfOKsePTk8h1uAnEiYu4OYnIVHqbyZBAzKEFbXQ&oe=6A53AB71"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHlfGQdzw0QQ7kNvwHm6kXm&_nc_oc=Adp6G6AkB-nZmMasweFQTF6oOl3N0_GPQYuzZHfgvRkHGM0wD2Tt1Tp6cRcFZtYQ3JU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK0qen94gKSgEBDgIrXpv3pk0iG13eEtF3T4sPOdgN4g&oe=6A53ABDC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8W8GgyhDkEQ7kNvwFrwS9V&_nc_oc=AdoJQloYzwnD6l_Fi8wdXyjzYR-b2gdVd6kqLjj5O_Xdq8ho9o07pFED1P0M-w2swCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvuFVSUs6sWXeHCWC6AUcxkAku70y8cVYw2bzlbpimBg&oe=6A538479"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjS63FswqFIQ7kNvwFq8T-X&_nc_oc=AdqzoL44O81_g_BYUD-XELKTk51FjImNmQz1EUE_rHEBHRTW5-aSk9hMxAqqNKFfN7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD1gIdWZu10fHxusFdYWKAYrgGS031uJpOiaVQeH_SAQ&oe=6A539561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7Q9n0Al2DQQ7kNvwG29jVR&_nc_oc=AdqaEpq-S5cpo8Fai3Hkm013B1kvkOc0vJf02QP8SBMP1VLhWbJmyWteWnjT8z3GL9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-71NMFhRQE5v58k88rsJwsKbD7Jk-9EGgEumIBb_Lhw&oe=6A538EB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BxF2tDaHAQQ7kNvwFw00xY&_nc_oc=AdquzZ03T0ki-9mAVEoQwqWYP1RQ9k3nUwZVUpeMnk0h4lfCf9Y7cPQujm2aBnV33uc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9idDXMdAmoXPivKjloKtItPc1lAuwmyVWVplKC2tkmVQ&oe=6A2ACCF1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWS-8VYhQeIQ7kNvwH0tT7p&_nc_oc=AdpDnc20ecAO1JqqNY5-rOKWsjCzLwtwkhkSkYJRrGKe_lqOJT25SiYZ5UMTlPMWFe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_10plGYzJOZ-RHiVwxtbdA5dMcKZWP3mp3xfrs8m_ovA&oe=6A2ACD5C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAjdmuO3zLwQ7kNvwFbZwNy&_nc_oc=AdroRgnbWxmQZ1x7GY0yLdz7QUw8L95JtMTNHTG8SszKnkrw-NQh0KuycU3vyEPtgik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x_mgJl1GSXaxT19U-RCtiECxXFn6bp6IBAHOUTnnkBQ&oe=6A2ADE39"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95kG4V_mcpsQ7kNvwE4q5-u&_nc_oc=AdoFnxjCw2fwZPRUvaVqbflXYXKuNI6C85bohIJsazxz7N-VPI2va-jFQoItizgO5-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RWM9Mwg89D-Zyq4lB0qOBd5DXo85yhNCi6DGHSbio7g&oe=6A2AB6E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSJEWzHeXXoQ7kNvwHSGcLN&_nc_oc=Adq_KwV-R6IHgnnwTUQpc5_MSqVKBL_PsEt3yWJ8WO56oukltODLfa1XT_0-bjB24Mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SJotH8vJFMknkb62ruBu_HD4X6Q4lYrLM4dHpdmtIYw&oe=6A2AB034"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
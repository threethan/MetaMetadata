atl3-3.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I4RvqmN3LoQ7kNvwFATLW5&_nc_oc=AdqzYS51avIGHrvOLMUj0wea_CSjhDjJS3btlonuuDHvuc5lINI_vVNc6tvELocWyeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW9kSWzX0jRt_i4wBW7XSRWj0cwrgiGsQsk5i70cr5Rw&oe=6A86DDB1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfpLIcqhJIIQ7kNvwHW5IUp&_nc_oc=Ado8KdVI3ltsFhu9VLEpLe68ieBYY3udIzG7vKCNv1dHtoS3xu2VD8_d4QgBU8Lq4Gk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaLNd84uyAP0neftBVVrNj2kc5EQ-xoArelgBt3UApwg&oe=6A86DE1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkCR0TxGwLsQ7kNvwHv2Vdy&_nc_oc=Adrj2JlnJKG7VoBY0zmK7Liut-j1dA8PIBDqeuJ1zNKfoP8Pz20TXi4jOe0Wk35XVDs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKJA_IjXLmKRY08V_aa985Gh3gkNW8feZ8Xx0jOjMQgw&oe=6A86EEF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkZmS7rNLgsQ7kNvwFA1mEb&_nc_oc=AdrJZerI19WkXmWnXJhfP9B0BbZSmibFIH5XpD5cV5c_sVs7z43QJWOoegFD_fCFHA8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRWuokx4FfZFmIjzIhwreVCBJxLhcNN0ip5nLDs_W19g&oe=6A86FFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7U2CqcGBGYQ7kNvwGYKBER&_nc_oc=AdqkzZULOWBXvz162JKG2OBb6IinKv-rQHiMNcU7NHc7q9ujhmtieE9L82H85EFv64o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEflBqG2ptG980f9CcZONnfalRR_LCd8Gcu-__gCz4l9w&oe=6A86F934"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
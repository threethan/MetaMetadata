iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPnFXnSMrZgQ7kNvwHe70lX&_nc_oc=AdqPwE35WDDmJx54_5PuiGxAkht6W9ABZBlIJPW6CsInuRuNmFMuxp1AwYH-aDaUKO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODGysyt6LLcPcs83W8-O3mi66Gt8YqLi_UhB3Idd8suw&oe=6AC26971"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01sKNyeulc0Q7kNvwHQHvd7&_nc_oc=AdoGaXon-EBBbY-syOD0DsyR76PV4kNuqmYwld4GPfHxXuwPji0TlCED8b3ryEQk9iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdFVfzVe9Zr9VUMCkijv_LVkiO_pYOYklGWUzgqzqccg&oe=6AC269DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uctr9eBXarcQ7kNvwFZnEQE&_nc_oc=AdqI5OpMWr72kiXP4eNezNTN1qiX5JmJD18ra8fv2MAXmQ4IpZa1krsJQEo7xTBvDGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD73Y_Uco_KsCI9n6_0rF9HoAIWTH33GbUiaUxx1LW2g&oe=6AC27AB9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXRtDL4TwmEQ7kNvwE6of44&_nc_oc=AdqwZcAyuFAzm9x-ZS8tYIw1YT5nITPdpiCT9Jz88g_xz6GXe5Unqroh3VmqhzqGkWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyIxLlNxjivIP1fqyUc4813eaxfYpvuYw4qU5sL5UqGg&oe=6AC25361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsxpP7X7VCcQ7kNvwFKRfDm&_nc_oc=AdpQYN4QqmXYOCVJnsQymcuSx6j8NiD7Pmr8PMv0_GgMXHzNd6kfYlr_xzBMjk9b-2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2DKs2-SNAjYq3pIK5Tw01m6oa44HQi5CDCxgo6VTPww&oe=6AC284F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
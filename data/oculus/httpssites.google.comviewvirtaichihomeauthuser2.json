sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o6T8jO65kAQ7kNvwHWjp61&_nc_oc=Adp0Al_gi2uHLty3yjs_6ZjttzMbhwD1JoK42yHbm8WfyBZn8WTxrF0OfM5Ar26Pr4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VS_CVlK9SPimUklkx5-IPdokmmlhA_k8bNyzBygEJ8g&oe=6A3558F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AW6Ti77bzMcQ7kNvwHN81WX&_nc_oc=AdoYLsKJ11u2snoYQDmC_jaunS7LmSkcZAT2KEL3_8DW9AOwHpWTXsUnltwFM3xe4-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-HyZclJUgTI193OxESmVg5MeLtxPA4gR6TBFWNPqOgQ&oe=6A35595C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyAbG3a7l3AQ7kNvwEdenMR&_nc_oc=AdqbxFSw9S8DAexmF3z01GOnhgsIELmHLK0lEQV8VPL8gXTQ8ezUFtDVqoQ8nguE38c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I4v6sQ12J2H22b2c4lJ_AXGxIzFICCTF009XukKpk_A&oe=6A356A39"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bLWQmdecNoQ7kNvwHyNiLb&_nc_oc=AdrtjsDvHrnV9eAzynu0B0QG34-1E8ZTQNEq3YczuzV4FpqwjnCHA6sdcqJekN5s3m0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HKOIwr2tO5G4ah-6gTsLQFH6QmZpZvOsxIFdnjQbNbg&oe=6A3542E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnOI00i4jPwQ7kNvwERO91D&_nc_oc=AdqsvW6arMUVvhr06p7JBzjaonLku3IrX9MtK3KJEQPMdDZA60fcsRLjFAwVbNZFycI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kYMM2VIPXjG9x6UZU8vQRS4RkWRT6F_tSUeRnjsZ3Pw&oe=6A357474"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
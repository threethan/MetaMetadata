sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7dd_KAM8-AQ7kNvwFpmOFk&_nc_oc=AdpjcEURJkYaRxuAvQMBF0YdU1TGhtNU_A_n-37HWb3UetMDGiiy_DbvmTGvTUOG07g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlkI3g8nRDf5lGFMXakLwFuIDYiB--NVZhkZtBcBX85Q&oe=6ACCF571"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZGZ9E1ubHcQ7kNvwGaQ_FM&_nc_oc=Adp8iDKgyFoXnkMhnveGNVETJho3SIHDR1D2RA_8dSfumhU5Dx4G63Cu8S2lbHNBevM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmhpdjeA-ZYyHnIogX7DLr9ptw3mge81Gc3ZLYRLLAGg&oe=6ACCF5DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9k_AvPVOxUQ7kNvwFTKyLN&_nc_oc=AdqA1m6Mf1mfxmdsKChUzTcnHVWEjO8lZY_AKpl61CWc5-oNVcDJBsBkFRc3K6EAP4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgPKuggZTQEBciV8iYkePkPUs1VMtKAuPdIDEi41Oryw&oe=6ACD06B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8fTe1JLeGoQ7kNvwGowO2k&_nc_oc=AdrGmyg4Oi0DExJeP1xowDfWCdI5xZhYUWwL-iX2tEA3_L_9Ku9JQtmMfdJhn9fWEr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-mWhV9KzcLc3L_gRPYQq7MtxIxJ05-1ybtLOJ3HtSJA&oe=6ACD17A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyzX9co-SwoQ7kNvwG3V3uP&_nc_oc=Adrm5xZtIXsy1N7qubMiMO_aP-nmYe-0i2ZiWb8Fy9ENELho6dtuG6fbYWXMXnBo_cU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8uX8eiutyWqVhhK9zFDyqPOBvjMswDGVJfbCMzWEkgA&oe=6ACD10F4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
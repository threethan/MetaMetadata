qro3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdyPb9li8aYQ7kNvwHWE1Dw&_nc_oc=AdrIb7RR0QmcYjp6Z7JSTa59lKs_9FhC8FoytA24UHoSfln_DaeJvfxIk_ke8ZEUYZw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ejQ6QbhVYT2YcmbhY3D2HlW6S9p5iuTXNhjjkkpLsHg&oe=6A09D771"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsDJOJyTge0Q7kNvwFPXN7j&_nc_oc=Ado-x9PARhtxG4U6kHgwB_YsVCQ0Azcz9GeIhuQnsOVdCa0zVuy1qnENmTJSbIPCxzU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BtO-9XHrao26y1HCMJvaB9V_AtHaqR6HnVre3yaRDcQ&oe=6A09D7DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnnxzAVfq3QQ7kNvwESsiZN&_nc_oc=Ado5gO1Y3oFwPPkaLe9_lH1cPFJCDSxTECgY05YP5ruXQwRO4JE8kGXa0y7PLr29XhI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_VxztipTEGGxPveGn37UXC_KfHCAukj7ZWCwQ-unCQA&oe=6A09B079"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9RjBKqPz4sQ7kNvwFPQyDf&_nc_oc=AdrRVK3VCz8M_FpDNeUuGbGoywdojXei1IQZOWSjSdHTnjEAiKFXaO6tErmY5jzLOsw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MZvRyMV1yzN-Yt7pveCpputWLUkzKXRKY2bH0aibX8Q&oe=6A09C161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrFXtMvq9iYQ7kNvwHnTkzm&_nc_oc=AdoLsc9G9eHhpCq3HWA8z3_TZ90PE370Ps8mRP4NfDaoCX-eVSrUr4aqDkL3TMR84No&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61X_KK8bWf7y7j4tW_4uSuiJD3Gt-s0s7NKB9kIVFR4A&oe=6A09BAB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
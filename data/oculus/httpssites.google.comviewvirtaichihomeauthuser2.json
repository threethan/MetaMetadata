qro3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSdb_N6u7msQ7kNvwG2AMME&_nc_oc=AdoMIJH2RadQJn3c8O303JiVLUUjY4ZG7gwrzZgPdiFVfqbJsw7ibh84yKDiEzbAMZA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDPovgm_s7PUg4n19a5AGRJX1XoQjjWoRCPPQbRnNNPA&oe=6A940CB1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxUBNQecnVIQ7kNvwH9y5vL&_nc_oc=AdpxMLHxj6WbW3loc9_FiE_zdVEEVMl-fADOwgwHnpo2RtSP3EH27oNVRLwG58Migo8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEftFv2ILOjWp0JSelb87euu4-elQ-Amyzwy4jgbBtoWw&oe=6A940D1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-oxz1BO8RgQ7kNvwEx_cYA&_nc_oc=Adqe_ivGfU9inQ0Nv8GWVK7hJNLzEkSzlvTJ7cQoPdV_s8qUaakqUryMXz9EgCPVAzg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhIyOf2y8G85pLO6QfnIoDLNoczCXAdJOpbNmpBPWg2g&oe=6A941DF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbJOMWL6CAQ7kNvwGIR91y&_nc_oc=Adrn2uyfuITsdJv8iXZEUQ2yIUiWXoNp-jUwzze2Tg4iue19XU37SdnSqHqEfHtvtYg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX7080ETl8QlsIrQe5_-gCfeC097bd32DRpZUcDFfTNQ&oe=6A942EE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RPjku3LchUQ7kNvwH-9HhG&_nc_oc=AdrjX0Z2xF_dtGEZsl2bD4Hm3mZecXnM1TWkpHiDje3G6hYYzxTWKmfQ9zzIEMhqR4o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwD7_BUp7CAqJny2mAJ2LCzQcx8d46aJRaiFFtd6bUxA&oe=6A942834"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
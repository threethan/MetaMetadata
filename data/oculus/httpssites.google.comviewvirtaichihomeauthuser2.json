iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKCCCg0bRzMQ7kNvwFE2cqX&_nc_oc=AdpDE_xj1-CANIkGhZpmPciGd3jhoQLDUiAmWOCguwOQMS62AoygmrMepARh68X8970&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAREZ9s0u_IpTx_6uS1sFd6buFSuK-Zihq4WcaBqIMEEw&oe=6A5E3771"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vPTD2_iqVwQ7kNvwHIMkBL&_nc_oc=AdoOr1FYw6SjmsTDfM-hegQcq57winL81IIKdFHHrQ9jAFxWpyjlmKv-C1Co0qDu2wI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3y0G0tmtONVoc92sqaEE_VFBmpvPluxdGO6Cc7-8Y_g&oe=6A5E37DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTIg4xHQ-yUQ7kNvwFtB8Rz&_nc_oc=AdovFH7J5fXi-oOKn3-DE-ALm2uwM_-16ZwpneSoabRd36sSSkhWBCLbRIP3ZDHvMDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvlDwvWvm1hCd54XMaAYziPOhZQKoD6O8plkpIAf67Mg&oe=6A5E1079"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ0IMocdExUQ7kNvwE7etBm&_nc_oc=AdpUjxE81IwcFtfp_2BGj83F-kyHBhX2fbOQfapMUC_OWO_Q8WO5cw2hKyKGGsH1o6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMWp8zP8AxR0kGtaziOqL-RDQJzrROpUAVg4yfF3aZpA&oe=6A5E2161"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx1_C8fDknIQ7kNvwHCE4Ld&_nc_oc=AdqGfYSvzchiVg9arB3yL61UxeYoivlqJ_vWJEexoutk0tQldUOK2QHuTK0u4E6elqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw2RRfJWPm_ma6W1nCvFsjfXpHZBOPBhlkBgq27SxWrw&oe=6A5E1AB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
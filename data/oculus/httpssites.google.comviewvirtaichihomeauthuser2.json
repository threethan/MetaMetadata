ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PKc6Gsyen0Q7kNvwEAzV8z&_nc_oc=Adpg3q_ckUTSlsuP193qZK6_jekbhOYM0vTo7Io9F_Odv_HFEe1ty4a0_4SpBz7M_xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ8m42DGkdWQcBqF4anEy9k64qfdiZIkjU3fTkiPiIIg&oe=6AF48271"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXCUAucwJtgQ7kNvwFhAcOy&_nc_oc=AdrkIRUU-vfQf0oKqwFXSfxpKE3y0eA9vfWafz8SIUmNfEbLj_cw-uuxiRRum9pInlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHSWXDnk7A88kYBy8sYlrCUE47EXZMBgkZkC8AtBJlKA&oe=6AF482DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lJPrYM7nNYQ7kNvwGJnVi1&_nc_oc=AdpJ-mENpzmvOl2ffYZCsT2hfV0gwxLdR_XIo0jwhJJovSzRZ8WO6U16T3zLwAp1dDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRifCR5tw0kq3sdRMUKxnNVl9yMYaIy9hm4onqz2k-_Rw&oe=6AF493B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJP9z-p--NsQ7kNvwFoRSr7&_nc_oc=AdriIOHgAp-bvzYNpIgRhhSEMKLqR40m2GAeKMBovfEtzPTJQF2f11aBRBQHicSQoQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0nqDiJPmyeKQ0A5OOsdPEBN8g_n6ROVgz1WL0UQxVYA&oe=6AF4A4A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBwlGSfYvHYQ7kNvwEP79sD&_nc_oc=Adohmrn8rpodP6HwUSuqg9aJTFYKMLCM_Qjs1adDe8QbI9ZSBDIgvKGP2_mFIMiV5cY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR86GrbSD0mULd5gdBMYMU1kpnCXV-6Sr8WLqrhzopJ-w&oe=6AF49DF4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
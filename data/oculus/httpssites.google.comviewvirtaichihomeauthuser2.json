atl3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQJvCTxLuHQQ7kNvwEfbN0d&_nc_oc=AdpkniM_4NxEcDXhdQe54zPSKWewLyKrXWQJG_Y-oIOLLp8vsFBIAFEtlZ3JD4p6Ldo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF6oDRItdBOm2503NFUDspfQ1ekAnPBDDkSUvNsh3wLA&oe=6AAD5171"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWn1WYvDW54Q7kNvwEfqVqu&_nc_oc=Ado1C2I37xd9OskudNKd0_DuDj-SV7h3Pcw7uoggFiJpGNvwvhDKK7qjbQvbU1nafsM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKni8-ATpvwn7Nzvik3CTQzj_kT2tj9cr7ALv9LO2Jew&oe=6AAD51DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xblBj3W2wvwQ7kNvwH5ktub&_nc_oc=AdoR7PJihi_4qn593ZeOku3PVVMfH_KU_FhB6TaY1RE5Vm1Kwq0gd4q96k2oVqv1QxE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvyLKPRFkktxsU3dSQ20bBS67tkyLnIeICa7u0TLesRg&oe=6AAD62B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoSxIjYXu24Q7kNvwGsB0GH&_nc_oc=AdrE7D5yhiZL1Juo4NsrJ91F504D8j21TcmBHh6RV7eSlIUj5bnr3tIkYIO0uhIJY5I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJysWauywwZUhgCOoDVB9FJkqPdCz6Xk96F1INwcoYy_Q&oe=6AAD3B61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqhQNCqGdmEQ7kNvwGcPruD&_nc_oc=AdrRRD4w6XjkWucVhqf7aOCiRk9SN_6pX84Rz6lyKt2CZD1N6HDWzYz83PDymYuPkZ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDm3JkWfS8n4ea0YpZ6wjwj1LDSWhQ3CqVpt8XFPfc3A&oe=6AAD34B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
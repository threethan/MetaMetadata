iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpBZTTtAnoUQ7kNvwFVkrfk&_nc_oc=Adqh3n9Iu7zSC_rYwv_cOtHOFEQMv7DY5mHRe0qvkkja-7hfj_UIxPIsS-ASPvU4yWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl12Ud7QRF18StbnGS0agbLeZ5AH1Q5XfxFj-T6-GglQ&oe=6AF5D3F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXCUAucwJtgQ7kNvwHmai6I&_nc_oc=AdrNb9Y2TLoAiE6uAmI3V4HnfVDJweIAjH24THS1LefgEOpZAC5iRBVkI0rtBfEsbcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-0XFlHWnd3IWAU6722M8GdMk2vlrP8jN7hhnwKx_Esw&oe=6AF5D45C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lJPrYM7nNYQ7kNvwGt0_jT&_nc_oc=AdpwZw7q0wXfNjSQn4WaDieqdk3gaW-hFcXAkYxI5eepwK01hLLgPDUdM1zaMowlN_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqHjwLXmP39hlX8mAi4z5ZL3baFoh_jlG_p-NDSEM3Vg&oe=6AF5E539"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJP9z-p--NsQ7kNvwHf6_2d&_nc_oc=AdrpIrsAbDbmXvHdf1kQxK50McRvAxBmWfu--eXKIAvwsrmTNK-kZ33SugXG0WXvx_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiOwXG8IX2bX-cAImX31oWtV_21dgqQKl3bIRz8TRh0w&oe=6AF5BDE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBwlGSfYvHYQ7kNvwEXwf64&_nc_oc=AdraxD0VgNq09kNtlS-Y47g-llGTgpom3dT8FJJfsGxl2J6X8KJaxXQ5G3EJBaXU1-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNHXuxew1iqqNodVhLbyLYg28qrQzOe6k0XvwAaoQg-A&oe=6AF5EF74"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
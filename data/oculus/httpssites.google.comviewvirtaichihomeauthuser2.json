ord5-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HaizOO4ju8Q7kNvwFEH1Jj&_nc_oc=Adpf0uIrIiE5fP6NdTVBnz43SDB73Ly0Bw3X-ebJdvW30a889rjc0I6D0Mstf7tLrfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ugbBjdlHqsSqLrM-el2ieUoEAbmHubi4x9Xzu0cVJSA&oe=69D4E331"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C0gcqRHk50Q7kNvwF_MwQL&_nc_oc=AdotxZhsXBBYTmU3A-TpL0wZ9ck8dwPjHQeYJ3RX1lrgJXKNlhCoyCMJ_4kvytsb_WY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Od4i_td7yk9opcNg9NXqNukDzsBpKDoQXmjiJma1SaA&oe=69D4E39C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLEtJazadCEQ7kNvwH7G7iH&_nc_oc=AdreFF5aMaGYvdUXEN9yBIXuYEQNbvEdSznq78M8FLyZSFZCPJZPUxfMY4QyElgjoOk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aI7yKXHKn8DQM9LB1vXnimt68sxIkiAg8OnqKllRqJA&oe=69D4F479"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNYzr2CfAxIQ7kNvwETyOjc&_nc_oc=AdquAEfboDNPqD9E582YZfY-jOmmWKRIy9cy7VBLmJRqGp42Nn4jm_oyQaAI86cInHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ojHKubeL7f4M9HsSdajTEvjjc6uyIOV9F13YMFYjQNQ&oe=69D50561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFFdZxE6XuoQ7kNvwELCjpn&_nc_oc=Adqi3-O5cdJ2RVVhiP7JuTDwWCyK_6DWw3g6yRytAlpU96_J9f99oxvoWmF5akTrnhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-oAQODzEObUG8MWKPZAxvjtsrn2X4p2bG1SemBWFHaQ&oe=69D4FEB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
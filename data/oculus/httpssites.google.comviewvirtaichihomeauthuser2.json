dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgLj7OQQCo8Q7kNvwHHkwaU&_nc_oc=AdozgFk_CblIntaV0aeTnkRp6rRnIyzCzRsz3fskmzrl_CIqsvgW7E5eoTLyAaI0H5Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aPuTT6wlKaS15ljgVJfIX9J4G-ABsDRaP5_9vXmKCOQ&oe=6A243571"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JS2w50Db9MQ7kNvwF0xGcs&_nc_oc=AdqIGViQ1Y3WVIgKGrT5oG3bVd4UawlwwuhNTkQL-NTqgkeaiCpydr4kaBTY_jO9AEo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rT1UjySpN40YHzrNtIA2dTXYbdzDK4uKy_Sc9EAOdRw&oe=6A2435DC"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzoNVDcJYPsQ7kNvwEKeu4F&_nc_oc=Ado7b4P-w79p3Y3k3h6hKHDLPexI_Xwr1IY2QCd7rs81dSP4lXX8Uzew_ivnPEkRWEc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RoxzE522yePrBjZ-C4A1XbAr3p0-sfKHrybDSSH0UoQ&oe=6A2446B9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKCY8gaVVvYQ7kNvwFpTxsW&_nc_oc=Adoh3EvMw2GBF1arkPKuM43T9R_D0H1hiRhFa9Fcyf9QnGaHBAhQEiutNAiGBeNC5ug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GsvfNeaH3bAL42krc4BioGTP58pXyLXxw4HHQr0qqAw&oe=6A241F61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_GViFxmeBIQ7kNvwH1UExa&_nc_oc=Ado_0lIXR0woIghfh8trN3B8z8URjOtyw0WEmCy5dE5a5Ym977Fv2YbLqnvUvc3Yhzw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__V7Skp4p__7wkVvO5Kp8r_u3wM0forh0cx7PfYKprNw&oe=6A2418B4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
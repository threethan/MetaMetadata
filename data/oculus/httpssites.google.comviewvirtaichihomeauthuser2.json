sjc3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV26IMQ-hdAQ7kNvwHooQhb&_nc_oc=AdpUJ1MVnERpNqiCAz7IBxpL_Nbgxic8GCwyxYIxsqYw4qqqK2xzlf9mjepPTHPU_Y4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfAbDtfiUI88p-_kPKMHQZ95iEB51Gf0bhTu23qGg8Ag&oe=6ADE18F1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqWOue8KFgwQ7kNvwGlCGMu&_nc_oc=AdrweqqEOL6U78DZJB_9HLbWFGDhRJ-KHAbvvWBxTUhPh4SXHMbOpOZ-Lv88JWmCoU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOru5GdoyHfKHKqMlOgQOP8gGeGnyAVZumvS4yBQMTIUg&oe=6ADE195C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59wAP62HEHwQ7kNvwE7gcag&_nc_oc=AdrGcX02_vf3gCSWz-kVEiP50tt-ua8c9oMi90UJuuo_EhWxk9zPJLomOz5U7hMB-ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzT_6RYi2VgZYn7N-uALVUDVwGW_ePj6IlqRo4D9oAXw&oe=6ADDF1F9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUtK9rLMfaEQ7kNvwFlU6Fs&_nc_oc=AdovGREHxeaG6G-zD3XewicbTcjPwFrVJMhrOY6M9iq1X3uvi70alpjoBI2OAOq8xMA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk4BBbcuqBP2oZDERpjeaROPbx1gTkk2O_-c1Ne5P8Tg&oe=6ADE02E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eK9IVUXwU4Q7kNvwG594ra&_nc_oc=AdqeeK855HpqWuJidI-0lNNHoOLu8KTGd75zAAjrS6BVM49hSeAL-qHT546sc2gFdh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6apVJ7LUQkPExpGt9oyf6xxzqK1tc-E0nV175NAkj7A&oe=6ADDFC34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
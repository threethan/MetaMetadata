dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuOJesqsBNQQ7kNvwFohHU4&_nc_oc=AdqjR5leQ9W0HNOz5dhittaqRlLSIQoGoYIjqE8PjC6P1V_9mAna7yM4-utJlFzGG8E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVVTUX9Y0w3JF_v44epSiE5tHn6NtJ2-PSFCI590LCkg&oe=6A8AD231"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFcYmNgJykUQ7kNvwHoFZIz&_nc_oc=AdoMtJNpRjHCatOax8_-S-4JYZb30MMuQxpju9fJlDL3DQO2XZPLVb7_TgB8rLqEhDk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXEYScIQ4N9KHXZDIseXcHhaUoBcDnFg0OckFQIJ2l5w&oe=6A8AD29C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iet_yRIM5AAQ7kNvwH3RXt2&_nc_oc=AdqWWxW5TMEnnWb82exBcN3kCl8d3r-IYoClY9f0M0j1kM-mFFqsMVHWXitQ2x10RAg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcJq_HT8HJ43N6J8Zr2jz0H75LQDvzxDvIw3LLhI1HRw&oe=6A8AE379"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YauVunr3P1EQ7kNvwEJ-oNg&_nc_oc=AdrGznDh2Xfde7iOGkyRKtQFze5zr7x2jP-119B_JTUJrC2MfwyGIS_Q9PL9VLFYbPE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4VS7IprxKw0kL4mr0d739Z8ZAzjrIRHJ6_dpL2EBrAA&oe=6A8AF461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQZCUCB7RSgQ7kNvwEZxnMv&_nc_oc=Adq6XDr78IpxB_j6qIdatMVIJG41xP1X2YeuxuQbkcz7ShPQy8TMIFwP_77xhbaCYqA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEso59D9MOeHDkOPpkWnDEqpThtv2AQYe31jtTfV6SmOw&oe=6A8AEDB4"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
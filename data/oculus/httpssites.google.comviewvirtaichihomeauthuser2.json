iad3-1.oculuscdn.com/v/t64.5771-25/473391958_946840000769870_1448798391282599495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDSCQgojSRQQ7kNvwH6cBlq&_nc_oc=AdotQvSpPmBFXAXHWicYLEkvrvK5O2_QgV5KLbmneU4v1dE6hg3RG48Ivf8qdbuZwBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVExUMMcm-EHiozjg6uqFNp3jAjq98X1FtqzSOJsAbOg&oe=6A79AEB1"}, {"file_name": "3.1.png", "id": "973802704933663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_973802711600329_4286443366909279821_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyXGi_Af7bUQ7kNvwG8PV2D&_nc_oc=AdovHRKdHoLvlRpzOjOlHhJwa6FAqCczoYvGJA0XTRk2wjFxP_BhpHsZ3-4l5j7ptcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1eAsl308URiXHnnoCtVuSm5NYLRgMiOoYhIkzCMU6Nw&oe=6A79AF1C"}, {"file_name": "4.1.png", "id": "3814254658840576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393516_3814254662173909_5750138294767377904_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr0lU1IJosYQ7kNvwF6V4NH&_nc_oc=AdqxZM_gOE09x-6tlyFM68SSuxfrUQDsogL8R8zFb2ZiF_wUQ9tZ2JF6JAqPaiIDQIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNle4gq29q1CiaZzg4bkBzPqpcKmKX0wzm7VtAkYv1uQ&oe=6A79BFF9"}, {"file_name": "1.1.png", "id": "1218619276643721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1218619279977054_247861571222355455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVrl0eu5MP8Q7kNvwGV4mSN&_nc_oc=Ado3Bs2CDwS1VQ3gv6hT_hI7vdBZZaGLzBgmdjDEmeYG8hL-EFQorjfO9_hiY7TJJQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP00r5taldvPBcFskldd0WhGJ9In5tUPBTi1JbcbfyoA&oe=6A79D0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TaiChiLogo1 (1).png", "id": "1357676372078454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391896_1357676375411787_2617182992602076952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZRHoeOa8NkQ7kNvwEkw1gv&_nc_oc=AdphmrbmYVCXN7mdIReDPPuLJVKcaKeHI1AsoYqA3ninCi7FpLGJWS59bs_u7GdUB-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETGZQZIELXZUlwwH9QDd98t_J3w9bV62sVXqi0y1Gbuw&oe=6A79CA34"}, "display_name": "Virtual Reality Tai Chi", "keywords": [], "long_description": "Virtual Tai Chi is an immersive app designed to teach the fundamentals of Tai Chi in the comfort of your home. Perfect for beginners and enthusiasts alike, it offers a comprehensive guide to fundamental stances and movements, leading up to the mastery of a Yang-style 51 form sequence. The app is optimized for practice within a standard 11' x 12' space, making it accessible for small rooms or dedicated meditation areas. A built-in meditation timer helps you keep track of your sessions, creating a balanced experience that blends movement, mindfulness, and meditation for overall well-being.\n\nIn addition to the full Tai Chi form, the app now includes martial arts applications and Tai Chi sword training\u2014providing a deeper, more complete Tai Chi experience.\n\n", "short_description": "Virtual Tai Chi is an app designed to teach Yang Style Tai Chi, guiding users through fundamental movements and forms. Perfect for all skill levels, it offers an accessible and immersive way to practice Tai Chi at home, enhancing balance, relaxation, and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Vir Tai Chi", "support_website_url": null, "website_url": "https://sites.google.com/view/virtaichi/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
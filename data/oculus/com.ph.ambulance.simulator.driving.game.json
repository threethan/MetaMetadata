30498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlG-Lwok4uAQ7kNvwGXhUyc&_nc_oc=AdpmOTyI4DVhXZkT-kSAx_C4PwntHQRPOo1IL7xCJu6RYNCXs5jBr81GUZkPQtvaZZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FxBcOjWblnIUCMHhZftDJjDGPqRofMnW67mKv5ADHrA&oe=69DBA83A"}, {"file_name": "12.png", "id": "2043831662860578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_2043831669527244_564885338601554598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D3Kyf6ALyoQ7kNvwHSn0VS&_nc_oc=Adpal1MJR87v-X7qXnHT8i6QEr9a-e2AKpalCUUqZ-vDSZSCH60YVOc0yhssWnoVic0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EZ6yMYx1To2IBx5xjxEhP7-gnonZg9_pGmIJb9UkLsQ&oe=69DB8FE4"}, {"file_name": "14.png", "id": "919803264291575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_919803267624908_6848337735532429137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWoR7oMSVvYQ7kNvwENZ094&_nc_oc=Adq4ZUed1YLj0QWsBIHl-AD0680Mkx1cA-g5Wz1TTY0xQReAf-r14-gfpxclGxDz1xI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0txvRnUdw2ldreygLQCM83C3maxQUjaF6bTnNCy0ruxA&oe=69DB88FD"}, {"file_name": "11.png", "id": "1467610341825834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1467610345159167_2516067461151955805_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRVtPQDbiUwQ7kNvwEqwJ29&_nc_oc=AdoMrVxFiquSarOHPqPjSCt-mBlMSzxG177C1X5R2wZ9UpOvzglAcExx8Zfarfbhq0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S_bs3eyvwDhvRjA6tg6VGbO4atiGnNfJ8cEriOJY9RQ&oe=69DB867A"}, {"file_name": "13.png", "id": "940302062101611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304319_940302068768277_8858737482449311290_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGbNFZgAfJIQ7kNvwHstXL7&_nc_oc=AdqzqcxNitBdI8I2ptgQcW8e6MW1mfpIiFGZe82WRMznNzBxCy2PT3do3FxhIsZNg2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QDhaBxLjafrU7EouLy2UZ7LLmh2ypgVW4qSRsu8FJwQ&oe=69DBA98E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ambulance Simulator VR", "keywords": ["ambulance", "car", "driving", "simulator", "rescue"], "long_description": "Ambulance Simulator VR brings you into the intense world of emergency rescue in full VR. Designed for Meta Quest, this game puts you behind the wheel of a fully equipped ambulance where every second matters.\n\nRace through realistic city streets, navigate traffic, use sirens to clear your path, and reach patients on time. Experience smooth and responsive car driving mechanics combined with immersive VR visuals that make every mission feel real.\n\nWhether you\u2019re responding to accidents, medical emergencies, or time-critical rescue calls, this ambulance driving simulator delivers a realistic and engaging gameplay experience. The game focuses on realistic vehicle physics, intuitive controls, and a detailed urban environment to keep you fully immersed.\n\nPerfect for fans of driving simulators, emergency rescue games, and VR car games, Ambulance Simulator VR offers both fun and responsibility in a fast-paced virtual world.\n\nPut on your headset, start the engine, and become the hero the city needs.\n\n\ud83d\udd11 Key Features:\n\ud83d\ude91 Realistic Ambulance Driving Experience\n\ud83d\udd79\ufe0f Smooth & Comfortable VR Controls (Meta Quest Optimized)\n\ud83c\udf06 Detailed City Environment & Traffic System\n\ud83d\udea8 Functional Sirens & Emergency Missions\n\ud83c\udfae Immersive First-Person VR Gameplay\n\u26a1 Fast-paced Rescue & Time-based Challenges\n\ud83e\udde0 Easy to Learn, Hard to Master Driving Mechanics", "short_description": "Step into the role of an emergency responder in Ambulance Simulator VR. Drive realistic ambulances, rush through traffic, respond to emergencies, and save lives in immersive VR. Experience smooth car driving controls, realistic city environments, sirens, and high-pressure rescue missions built especially for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26374872562124293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1581814132893089_7156402213114988120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8sLf5ZWY_sQ7kNvwG-pnVb&_nc_oc=AdrxsCDtmTOHs70pugRA-bTXz_hkvP5go6PxUpkCGkuKdMpo_RMzxzW_-ADDZl8AFEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tuQQwth-RvVP3lB9Wh_TQFTx1X3Wjq_iEGYGmmoRXeQ&oe=69DBB2E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ambulance Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1775143740, "lastRevision": {"nodes": [{"id": "25814801244798097", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25814801151464773", "is_first_party": false, "enables_in_app_ads": false, 
-25/473392010_1245186710511695_208457330754492616_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt50y8XPsJQQ7kNvwFNBK-E&_nc_oc=AdraIC5NdEMKCJcn5PkW5u_-YHGEHxx5KzzeIP06TpDfb9CWvQE4CZLyEOscvP5N-GU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-GmsCeMMnODPsRETA73lUamGHmEUqrjqMvhohR7kvuA&oe=6B0722F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FH cover art 2.png", "id": "3226783710795376", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_3226783714128709_3727639939775504759_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHzS_lsJRlUQ7kNvwEdxhLu&_nc_oc=AdrdHkcIyCbm5AcGm6EJRb-Boz3EM_KP3pKGGBWTZHd4NSW1pDivDAXoI_sHOnqupW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_psDkJigAxGY9-d1HmR6fZBYp1iJTuA-OB9jK8JxZw&oe=6B072326"}, "display_name": "Fragile Home", "keywords": [], "long_description": "**What would you do when your home appears to be in danger?**\n\nEach day, since the beginning of the war, millions of Ukrainians are asking themselves this question. Fragile Home is a mixed reality awards winning immersive experience (Venice Film festival, Annecy, Tribeca FF and others) that poses this question to each of us. Through the medium of mixed reality, you can experience the gradual transformation of your own home into the dwelling of a Ukrainian family, spanning from a peaceful past to the tumultuous present. As you navigate through your space, the voices of Ukrainian people in traditional melodies accompany you, guiding you under the roof of your very own memories and feelings associated with your home.\n{1764359637568951}", "short_description": "What would you do if your home appeared to be in danger? Would you stay or leave?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-fragile-home", "developer_terms_of_service_url": null, "publisher_name": "Brainz Gamify ", "support_website_
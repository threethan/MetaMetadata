. Fragile Home is a mixed reality awards winning immersive experience (Venice Film festival, Annecy, Tribeca FF and others) that poses this question to each of us. Through the medium of mixed reality, you can experience the gradual transformation of your own home into the dwelling of a Ukrainian family, spanning from a peaceful past to the tumultuous present. As you navigate through your space, the voices of Ukrainian people in traditional melodies accompany you, guiding you under the roof of your very own memories and feelings associated with your home.\n{1764359637568951}", "short_description": "What would you do if your home appeared to be in danger? Would you stay or leave?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-fragile-home", "developer_terms_of_service_url": null, "publisher_name": "Brainz Gamify ", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25650094434676816"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1417276376098406"}]}, "baseline_offer": {"id": "1417276376098406"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769162760, "status": "PUBLISHED", "id": "1417276376098406"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename":
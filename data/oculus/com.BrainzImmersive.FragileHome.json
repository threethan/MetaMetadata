972063_4379329588235803113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3jK6fIWTscQ7kNvwG1YX-k&_nc_oc=AdmTlQaBveIN6qOP-Or_7KJqzmqhZNKvHIHsfsSCzBegAcXJ2gcFZwtwItpEeXQgGX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnqT2A_t0-Lqw6dRN4-8XLfrs1065sXyQ_xufFVgYQmA&oe=69B96094"}, {"file_name": "sc1_1.1.1.png", "id": "1328194578447719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393887_1328194581781052_8459044052459633446_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZQM3gUJ1osQ7kNvwFzaH4g&_nc_oc=AdnbIduPrv8TCDOuW7cBTv0x7YFIdojdMEmk-nyjNeCN9gaBGA9jCbxDdGoRTccstik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9o1hNvE5NrWsUYqjvgmQAJ5Tyoalpn2gGo6ZkbAnTtw&oe=69B94132"}, {"file_name": "sc3_1.1.3.png", "id": "1245186703845029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_1245186710511695_208457330754492616_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiCkF4WmJQMQ7kNvwEjei-b&_nc_oc=AdmDzcPR_qI_a9TJDara5QrFuclFiNd6QcsXlvMzYUNAgLlqJOwbWv2jKnmCVsbNRtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsssHZO3BGiyrb3OjGBTxHaDDIjcXkhTmazkDxcRS5Aw&oe=69B95F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FH cover art 2.png", "id": "3226783710795376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_3226783714128709_3727639939775504759_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcOCo4aPihYQ7kNvwGn3ziN&_nc_oc=AdnAOO1XPyX3L8rt0dmq-k_rk9N2f_eFI4jmLgEpl6xy9qUUrhYnQxKY2l9PHT1pABQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGs50TTIqGMMImgKNy44p6pUactjXyUd0M30Ek12p7EA&oe=69B95F66"}, "display_name": "Fragile Home", "keywords": [], "long_description": "**What would you do when your home appears to be in danger?**\n\nEach day, since the beginning of the war, millions of Ukrainians are asking themselves this question. Fragile Home is a mixed reality awards winning immersive experience (Venice Film festival, Annecy, Tribeca FF and others) that poses this question to each of us. Through the medium of mixed reality, you can experience the gradual transformation of your own home into the dwelling of a Ukrainian family, spanning from a peaceful past to the tumultuous present. As you navigate through your space, the voices of Ukrainian people in traditional melodies accompany you, guiding you under the roof of your very own memories and feelings associated with your home.\n{1764359637568951}", "short_description": "What would you do if your home appeared to be in danger? Would you stay or leave?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gamify.cz/privacy-policy-fragile-home", "developer_terms_of_service_url": null, "publisher_name": "Brainz Gamify ", "support_website_url": null, "website_url": "https://www.gamify.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25650094434676816"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1417276376098406"}]}, "baseline_offer": {"id": "1417276376098406"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769162760, "status": "PUBLISHED", "id": "1417276376098406"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25651508327868760", "version": "0.1.08"}, "id
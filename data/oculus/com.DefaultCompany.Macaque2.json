7kNvwFPysZE&_nc_oc=AdrtXdmqh41nuHSjf357B2tnszGD_jKSg6QV5okRfPjWV9GAOJeHLvfLE7o2BL5WW7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oQ3S8i9DGqIKY1t4Trsh6gvpBJWhZBXFepJrgXLNKKg&oe=6A3AB264"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UGxbwQ6nt4Q7kNvwE4uNru&_nc_oc=AdqhZ5zonrHCtGNYaAgdMTSLxIvaw5yWkD20ASLDwSATG6JPxuF_gSrWzlkp31DwSuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aRydusfWHUwLXAWTJyMgGZTevq9ojHp_SBRpJ_l3PiA&oe=6A3A88E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD3MlT4kox8Q7kNvwGvMOxT&_nc_oc=AdoyKVmAgoYQgqvNEbfkeVd2Ogm13UgMZZlzcDuyBMVUWjug5qeQj3LQ-hhpeQwR9S0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9birxLbThm8-6St4WqP3xiz1cKt2sV5pYGBx95Q8wMQw&oe=6A3A897A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHMJPkQ&_nc_oc=AdoO73RLrI71gWtNbLq7u2aP_s5J3ldbw3Ffjsc_vB5lvWaVwkroqNXIQ6uWXp2CBqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMP4Orr1f5XtTVe4plMVGcc1bmsWuU1x8QK6kca26p0w&oe=6A6C9324"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVfNxZ397wQ7kNvwFgWHMH&_nc_oc=AdpNBIi4Pa2IejLcITEG4cz9P-OS2BJKRWmNwt9z_5VxoIPXVxhG8CvltuZAWgZUsHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsXMLXHBG3O4vMsM-11MO_OQqr9DO_-Gdlm0sLRqlnPQ&oe=6A6CA1E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9oANmQ_DTUQ7kNvwGArngk&_nc_oc=Ado7zDyMEoNiJr7G2Xbw7ry78nTmhMdFmxjuf-KpRMo1Z_pEGmqT8bRr9jC1L3pf4l4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2S45JjpWX7NH3ClxYTjCz_SRNVFfwhWpmOKNTm7G64g&oe=6A6CA27A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
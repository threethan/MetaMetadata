7kNvwHM0SWt&_nc_oc=AdonHiiWmb57GpgSm9hqHFttZ7qfPzPWS2qrwRjc4dlTGWPImOJraLvj-fzaTgQGsIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDPNjCTA_-vD3_9X-SLV81bXSQNHOydqHclcTa2718tg&oe=6A6358A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTF7qD1oW10Q7kNvwH5gQ9D&_nc_oc=AdrBML6w5jgRi_Qi11GJWGaVMuJfPBzJ7GwutUvzI_H6aJYV4FZ3lm-25pFGsSbQhCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSkw7J6f5hYmGfqhuFRnXqxn8e9hdcgdLIH5KYY0tmzw&oe=6A636767"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyQTRuSgrO4Q7kNvwFr5g6X&_nc_oc=AdqsErL6jHtlnfSS5hqmRSzhWKIVx1KGTP7CC2mj7w_7enQgr3ODBZBS5FP81oOZIQc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiVXN7yX3qXL2X9rB0arcjQ_VLZIAE3BEFBEVfj1StqA&oe=6A6367FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
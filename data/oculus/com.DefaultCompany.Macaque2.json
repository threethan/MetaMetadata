7kNvwEb9hdJ&_nc_oc=AdqfFst0jvIFhytiP6gYAqK-GI_Y607B79yROnEgyXoNi3fLbMXEEvtca9bHFI6FjB0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg022Th2JZRRn78St1BshxFdBSBeuaR1c2XY9yL4W6ZQ&oe=6A5629A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5B9Xz2ZluQQ7kNvwFl6ukE&_nc_oc=Adq31B0yXWghu5f5G8M5olbuogN1U3lYZxbrQNwOVTzYpne1I3LHl5FboNdgsMm3wEE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlS33asc1oAKt9lPAqVkCh7V9yTim9Rg04iLOIjGRkig&oe=6A563867"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_QYjGgAD9AQ7kNvwHLQwmz&_nc_oc=AdrGPfQsjlQf6C3KloJtt636rzO9UuV39K7YvA7S3EKbHbn9kGp0BiTp0fjIbMSSYqs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjqWl5a6k884Kz2h13IfbMoyzDUFGuh4Rd75idJCHsfw&oe=6A5638FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwEAYmna&_nc_oc=AdpoLv8irMXkNS98L6FtZ-_VBekHI_f8t3pFUR87r-c0jhMgTYdfJuIjHJSA9ze8qSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_MogOJltWgkQ5_MuGFNkkGBnqCj9HU-Ok7URzWy9aDg&oe=6A2956A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MF_JKAHiw0Q7kNvwEmrhRk&_nc_oc=AdpVJQBnuAHG5xy3gs4HnZGZ3FZ5sgrXYOylSq9cEBA8wtS-RyyX2VoSHpPqmUsxBf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5DcmkjZcqf0-ZjsgR-mEPIAxGt87f2CeMIewY51wLcA&oe=6A296567"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKtV5_87fVEQ7kNvwF_ykVo&_nc_oc=AdogA9pWB_PRETzb3hBEuD-AzB3OxQ7-UcTzXiUEhOlnyXWeRlAlzFqvpbuTA5bZBWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RZQwG6xolrIWWSKhi8VVqjU9BFDZjC0F7ONXUKe-UFg&oe=6A2965FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
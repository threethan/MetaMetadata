7kNvwEjnPaM&_nc_oc=AdrOmQ0q3b8ThM86_0hXDV3VEGgRJITvyrOJM8hBHi2B55GeG5RMuEsWoQWmTA2iqjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V4mEq2inVsrpBCYQWmDM0ALtBC9JS4qQuL0eM1A5QSg&oe=6A1DB164"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiOj2_VoodAQ7kNvwHY6XfX&_nc_oc=AdpQL094udo8aIzBQQPlQBDSH9SxHOl5yEuneXX7iI2RpMJmxhVRgDvC_XE0R31ia_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yMUd16ePAQwoZ12OK1CLxty-yBzJlzep9MsUZEsTecA&oe=6A1D87E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_m0GEe6ZUZ4Q7kNvwEfecFi&_nc_oc=Adq8pJ40UNGOqFtlihFZ28CJpBaRdmkch-NJqkWYfVIDrDjbvYSOfSVHTqprfHHiSG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65VwwpL2chx8GKSOS-PLO6wYKo8k15dAxExKb11urB8Q&oe=6A1D887A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwGRvxr3&_nc_oc=AdpA7JENsaC1fawbPbfcMqfFTRZPVvOz5VFKHXaa_2lIflOiTPqBq6-mT22qXn8fpBA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo4h29ZpKYuMonr8VPu3LLz2yFgTEtG8Gx6Bs0gcupQQ&oe=6AA14F24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcOqDwUc6gQ7kNvwEXI5Ym&_nc_oc=AdqBe2Es8jduXf8QI6QTJpU00-9IodRNGdKSmpJSonIzmW40FbzAV4hn4v-b9wtvgSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITygq0OKhCshmxczYaGIbIklw4D1qH_p2oUvk9JX8s2Q&oe=6AA15DE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfoX6HjvPNEQ7kNvwEUypT2&_nc_oc=AdrVTLfQt5gMr8pY3YsPK-7nAesri9tW3WtYgCps4_1gdFJClbWaTppVPZ0Xumu1O9A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbwF7X4DSdI_EDgTQUGq9Dou6Ko48LfsDFlAx_-GytVQ&oe=6AA15E7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
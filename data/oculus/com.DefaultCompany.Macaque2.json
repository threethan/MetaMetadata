7kNvwGdMXks&_nc_oc=Adrsm9BM3h_GoD_oNHyh03Ia7wAB38aU5J5ZRCGbqlJSzGn8NoreCexRMRj9kOb_gXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCLHzYeaRBUzSSzDvALtpRP-V3E_MfKgwpck8YGoZfbA&oe=6A844E24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeKpRe0VoHMQ7kNvwGnHUkA&_nc_oc=AdoCg2s2v12eqqMay5ka25WPogHTrO2t6cZE1Nzk1ibltvHUJQFOp4N0NTvCEsOteAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRE-gP3z8Ay-9BJw7uFLNSDAnOIop3-8ovocDUacn1tQ&oe=6A845CE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycFfasCh8qsQ7kNvwH4Tg1B&_nc_oc=Adp8MX1_5EpaD6PgUWSSe-vGGke4jfelCJ4SvLwslAmnyaGhC3inBd46Jth3_XEIxso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbJp-c02RHLROoAbqAvQGmVPuDoqeGrUklY41QslZ3pw&oe=6A845D7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
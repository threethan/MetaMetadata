7kNvwFvYvPd&_nc_oc=Ado_T_Zv6U-WsB51SfG3AeBRxF_ZioPRsyTS-mJbU4CuULc8FTe_AdFrxk2wCPbTY-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wSfCkUIqnguE1IZjuCsmhrIoeQ2tdj15s9xENGc7N0Q&oe=6A356C64"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T2iO2rX9KYQ7kNvwFew3-5&_nc_oc=AdoaYhGoUsq_SmLczy18fcU_pycDVMSE6_JODCJTbGUokHzLWNvILxYvZJkXZF0JTiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_j3z4Br9W_zrv85kA_2d8dpKImIW6jcrfT5DHHlEqWg&oe=6A3542E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRB7Wk-AJ9IQ7kNvwFLm1xo&_nc_oc=Adqxgfcan54mirAS0Hx04crjI6W4ZQhJc3ZFmL25xTmxPjnCv21kzwFRLE0PYTiTjFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cxV8rPm2Nk83z-RKJWMHMjDDjpZKjNd5mkC4Lwc-KBQ&oe=6A35437A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
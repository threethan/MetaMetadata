7kNvwGugWGy&_nc_oc=AdqbMOq1LfsXyL-pS_AV9yW29Zu-GrIMwyvZTjxEp0J531ABRfHhSxVQE56JpsbnxAY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYUB7F0E6KeNcujSvRlpURLPLa4nuC5sCWC7g8_dkZlw&oe=6A65FBA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8pVthn5RksQ7kNvwH2iec-&_nc_oc=Adp57VQZtg5qsO_pImfew2rmmE-5LVn6K2bqEAj-soy5btTopjLKs-IsMli0_KsED2k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv-OVmfoLkLhutRIik7R99srYTNiF_7vXzOl5ghFVM2A&oe=6A660A67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhTTRcVxliMQ7kNvwHey7lw&_nc_oc=AdpVcRS2DiadzSzeaUPcgq0KAB8ergaayZPq2r-lys_xDzBwM0M-P7Wndz9APrYDCEM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHCUmJQ8BBAftyFLK7Kkr66GfAwkmj0Y1CXU_gVMRUBQ&oe=6A660AFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
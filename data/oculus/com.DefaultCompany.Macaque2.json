7kNvwGuJQJN&_nc_oc=AdqHZyPEFl7F6OCW_W--xxRSWRU74Gba_Nr5cP2t80xIBmhSWkchanAHoq3ux9r4nUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQTjWc0K0kU_7Xb_rc3FQ3Dag_z4DNOIVt_zsymAqDyA&oe=6A6B41A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRUhdKu9THIQ7kNvwE1OhrG&_nc_oc=Ador1FnJ44Y7p8O4P2_K2guqweLgLIMM8ya4sGSSaWxcOZqdNW450ibXpGLL82krXxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASQ9t2wdC9ztWndKoGl6zLlHZa6BCP2PyeL8NqsVcF0w&oe=6A6B5067"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9oANmQ_DTUQ7kNvwHSq5d0&_nc_oc=AdonI_0IbGa4jBYQx1k4mWDHo3rGQcXpFeAQukX46G_1otMyDkth8JqMW6oTUDgwnQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa_Vro-JUVgGV5qU4VP9AYweuOO7O5E43mC_aa2uZS6g&oe=6A6B50FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwFOnndh&_nc_oc=AdoFCfZnOmTbiaHUivK_4TLwH9xIj2nEiEzJXyAspHWnu81SxfT3uMrVPg0apbCTCsI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa02vIaJSR3h9prNi9R8cUEjJSBo3d85iwb6uBcon2kQ&oe=6A9AEFE4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2i-caRC4d4Q7kNvwEcuJXe&_nc_oc=AdqN6W5tLj6Ov3d0HIUKbBt9GClFpQ2FCPK8x4RPfGiDS3sA-KsUHxIf2RZ4I2htrKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrizKpuooCAoYInMu90QRGmwKSGsvG6birA4mNoss4pw&oe=6A9AC667"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dyZ-V8QMCkQ7kNvwEc0y-A&_nc_oc=Adrwo5aPvH1et1bq8tW8QeDlme9vxnYZECCDxBFhMG1LAp0VY7M4H6-sj3XxuLrPDOI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhXODrBil0fnue2r8ZrtxnQmQwXhTu_Roa6zn6D4K2Ww&oe=6A9AC6FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
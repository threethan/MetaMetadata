7kNvwGGweYv&_nc_oc=AdoONLp29kWlj5oBbFCwTFGwRmQnQOVnAgFyxUmpB6srx9uXNp3Zg7jZtfaYI56e7KU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94BSxn9Oi79e1GhXyoADeFvK7lOikXyXX8aALraBuetA&oe=6A3EA6E4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMnDjHfqeAkQ7kNvwHbg09K&_nc_oc=AdqYTzf9WmfOnGDVMtYl0U2CUSt57ST4mCBRK-8-qJbw5PQGmFkfkx6fFh3xqln2rVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89SvKtOUvSxZC0UpHmC5hNnMMXav9npap7WGIvjSGXdA&oe=6A3E7D67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjPmNCGOCVMQ7kNvwFA3txJ&_nc_oc=AdroP3o42hEA4sxeD9S4bUnUwn-N5vXn2j9L8Ttcie4uYwm159OxsmN3l0k_jzQohPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HvdfikAlsS-5JYJ3LaH21jD8erMNIHQz3fYut-g-3uA&oe=6A3E7DFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwH7s8xX&_nc_oc=Adp5bYl7TRKgXcYS8r09Y1L2V8c59ynPqx-2BqUb2Sk5GN59MFcWEdWRrDoBijI9m6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFir1y0v0PaK-ljR1DX0QSv6IfUG-PHECUG2cBCJdzV3w&oe=6A899424"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnIZS3n3B7gQ7kNvwHgh7rY&_nc_oc=AdrF7_9N90jdVULdzdwrP7Wu2aApbB9L3T4Vf2ka4gY2DYrW8eKhuER9FQ-pcO1Vn7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOZAw1vvqeqEtXgkCXku_06qpfoMDy2yzxwg5AzUF00w&oe=6A89A2E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCXFRhSwtNEQ7kNvwF8zIeU&_nc_oc=Adoy08XOu1Q68lmoFOS4xLdbiOdr3dGJ_sPg8fMFnRH6SwILp7QKgZTustYkueq-KFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTjcgA4De6K12XbFabWvRZBzEyGgCtkaJPef_NogCuCw&oe=6A89A37A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
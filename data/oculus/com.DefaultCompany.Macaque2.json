7kNvwE65EwY&_nc_oc=Adqpm9veCD99jJNEESrDZXUdzOgnRHXfyih2ybhafoLkZtzoAuF6eHQcsKsx2zOgZpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI-Lz_PbLBVnU1UaHK8bZAtMj82ldJ-Abf1roE7p7-vw&oe=6A5CC124"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_LSTRaMdEkQ7kNvwFJ2zJu&_nc_oc=AdprMq7hOX0xGfukj3SB1jRfgaKEtwVfRZTZTu4je7-SCyrNikhEbJCwsRKY48ct8AY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3tHQ3YnZbKntkbiVODk_PlaSfL_utS2ncaoXJAfPqkw&oe=6A5CCFE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lovdp2ZplPAQ7kNvwHyOmxB&_nc_oc=AdpGEXKa0hm77r1tObbs5Yh9orwabAiehFk4ENArlvCGmU3ChuFPAA_Lu7RqXMww86Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4zqYXInYA6Jjvfde2xf5mS1Nf5qETQw83Zb1pQ-16ww&oe=6A5CD07A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
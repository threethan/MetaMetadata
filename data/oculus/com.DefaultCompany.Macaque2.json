7kNvwGRm16b&_nc_oc=AdqZ7vL5PeKfjXw80WyutrN9zgX-_JRW8MN1laK4AA-3JaVk1O1eTuhlnQi2G4IN520&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92rj1Be8e7cJ-ZXUhWOnsMUfRDQDxBMQ1WpWXWXp5PEw&oe=6A302664"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBwE9m7nZeYQ7kNvwG8W-J2&_nc_oc=Adq3ggzicqcrdABuLjcTFWwPft_K2UbjQZkZQXsjRwHhOOmHiIRrOn_SJywlRCnhDYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mukUm0tUFinaBJ5_2xWF39UkRs81JcvfzJte-d_of8Q&oe=6A2FFCE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNWK0BtB5vQQ7kNvwG3jbLC&_nc_oc=AdoYJCNJtCcPwUNuYBnqC5WlSBJ6YwWpjIfae5nHGCTESO3ZvfqrZkfCYWdEr6B_BvE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gKLQOYCP9aZkhSDC68tRIlxZk2Y1-TxwSLRItkbBenA&oe=6A2FFD7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
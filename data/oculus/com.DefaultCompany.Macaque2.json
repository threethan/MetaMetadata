7kNvwFxZ1Hr&_nc_oc=Adrd15Yi-NSwASGaisu9is16dvkcu75TtOJF30j8Gu80uNBdfwK-DF_Fr2iQH_iXDdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE_hRrIx9at2M3qbejoJJFFtDacyV_Oo9OFdOe15b6OA&oe=6A7087A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp8fqLCW3REQ7kNvwEziljO&_nc_oc=AdrDNKJAnKHuQHfWsg2pMtB5a9-37S9-UQpX2uPYPR1G0ZPVG8zVqnygkDs8B55mI5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnH4VmijkioOIMB9jUB4q12PCsaJqcf7WcZixWMTDixw&oe=6A709667"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhxSmwhkan8Q7kNvwEGdLAL&_nc_oc=Adq1mmVJIEvBIbgJ6_q5cFLYzVUKVTxw4AUSEh2kgo_Kdcbgmx5QTziUuxQaQZ-lykM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhRoCpEc5bCCDZLd1F45h1wFYcVsk9RA4neCZuXWIDCw&oe=6A7096FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
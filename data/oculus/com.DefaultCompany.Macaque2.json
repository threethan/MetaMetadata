7kNvwF0Wpoj&_nc_oc=AdoP-kewWvMkOLOabNpvywnnp5bTyV_oz0aCQOwtav2GHcrjnpyyUDn59Z6BE2Fk5zU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIo0TP1Zx0bOmOHwEGaZDNrQYJ1VYBWG-TuFrrwjSM8A&oe=6A984CE4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2i-caRC4d4Q7kNvwGOUs7h&_nc_oc=AdpvMgvMk6eb3ssNDtuls2bXFtQs8SS8P0h3LZDHzpkfYqpZg5ITlPiHZXXHiXjoqOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImhzuoJ_3d1H0VxUNXiDzKZvHKQwlPEqE4LFtmhx0wvA&oe=6A985BA7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfOxLo5KvnIQ7kNvwG0JSDw&_nc_oc=AdrOlS9Lavg4PTmAYMR432sDbpN0j1dXw90x52L6MkIlzD34KEhhJWsIYceShrKajWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0kcM-KIw_MU4vkCDoa16s3Pz8GePXu4-Y_nUSVtcwIw&oe=6A985C3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
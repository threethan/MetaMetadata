7kNvwFEkgLb&_nc_oc=AdrkrbqhD6zV2okWDrJi7Gh4AprZdODOSFO79FqpvdVjmbMqro0wMvG63N99Q7y17zI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wkSpFyAzfii9b4-eAKV2cEoBw05vjx73ag5gWHtgc9w&oe=6A2448E4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7l3uM44y9EQ7kNvwGyXz6k&_nc_oc=Adrd_5el-kGRTqVJWsaoyshE5BPPR66MjLnjtR3oqb-IL3xnc5rancA4jx7OPskLQag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hkEHrJORnvJXa9JtLRb4M0mlRlZW3NP9xKMVH6Oxf_A&oe=6A241F67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLg8ZqOM-dQQ7kNvwG3GM7D&_nc_oc=Adog9RAHODZAYrh_ZK-zW71L7e5pJ4KQ3UJ4P5n4RwPz3200ZROx9WKZn0VOwUZogEY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S_XmvxNxUv8SBeGfOBD-CtF9dRok6BzfO3ZHbV-_BUg&oe=6A241FFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwFZHvBn&_nc_oc=Adq3-j30JM-EWew39sM_9YzxSyIqRcqS1kHDZO6bY1TO7bBzpQekOZxS65pefwJIQ8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImn_kzTNTE9gvjLtCPuS4An1iULiJ0wX4sHB9Dj3Qv2g&oe=6A9C4164"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jaes9bbmPIQ7kNvwEllXEe&_nc_oc=AdrUhnl0t-25btyG-g2rYi_hdPMYhx-ZjhigVa63LjAzwnXKmrJGM--FOS1LhK4IDyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLzIT3IfIqnt-BmKYEW3tLhw0pkcO7W5lxqjovYgC14g&oe=6A9C17E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dyZ-V8QMCkQ7kNvwGOJgoE&_nc_oc=Adq0Rq8joFWiDEg8KzPFnd7wpR613V_PBjJbPAa_ezXwCuSauc9rqdolgYrFMucHYLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPkR6TS2Y1V8X4Dt_KoZKN4Y3gdRl7deopjyrDudbsvQ&oe=6A9C187A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
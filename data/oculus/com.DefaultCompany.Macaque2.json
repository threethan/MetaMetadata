7kNvwFSR4tk&_nc_oc=Adpadwa6ccGOhIRmmHgYdIlmLIKbGqJH9wgMOyEw5ZXRQxk5X6lYeomLS8U_vSbfMQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WSCAhcFbUfNpiQLSz4R8kaP669oc0sIqfcJ6rbQMnIg&oe=6A426324"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KvYs0tQawEQ7kNvwFfMCIE&_nc_oc=AdpA8Zwvv8BzQErYk7xw4K2K56uK5D2GeLO_Hv5AEJWl9-PJYDD8D3PusOJ4cNTvMoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sP_IBrMKJ5jZs99tHVyJHLyqGA9sswCna93TW71dG_w&oe=6A4271E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXDWx3GEoh8Q7kNvwEyXnWE&_nc_oc=AdpvZXIWlPuwmCNzaL0S7Fsa-djdubFTU1ZQuDuvMKrP1YU4p0VdjErM56NuIW6UPao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bIKxKvjMXUWwSzm3bdMCZJ9XknUdPpQlSa34In_xYUw&oe=6A42727A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
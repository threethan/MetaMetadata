7kNvwHYruln&_nc_oc=AdobByquT_25gWVt2M6fkoT4JGDd7QWD6teb2vq7AIFupxP9SB4w_ZDn1PK1c_CurOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yBE5yTLfdmEJDveLdZZPQLX0rOPRp0Rpa7tQr6m-tvQ&oe=6A283D64"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zd43bbmmDTIQ7kNvwF9TN3r&_nc_oc=AdqissrcR8QV1xlQtM1VnHTEw0i_VQWRKp7zxOfDAZPCYJ1-LKY5-_eOiBUUGssfiws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XBc1HHxsyLWAYHDBYEAoUbbD4SXhXCr0qQH6ZO6-AWA&oe=6A2813E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKtV5_87fVEQ7kNvwHSnlJC&_nc_oc=Adpjy0zT5Zx79zumZMgRfU2eZ4O5ScNYkgswougAXID1oqv8Mc_UGPxNf5WoxuBh8CU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lcVIFBbVIJKOz9vU_1uksE3Vez6-W-CtMZZqy9MncTg&oe=6A28147A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
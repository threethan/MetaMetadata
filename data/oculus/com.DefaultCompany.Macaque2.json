7kNvwH-tpya&_nc_oc=AdrIBWjHOuIaWHL4D13eRQ-SdGkcOTfqTYl-cq1Zwsx5OeYBA6gWUypXzoNJ7-Ew30E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uxdCqSUe5ztkZH0K_YeKFi4yjMVN48Swap9Mvty1-wg&oe=6A43ECE4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KvYs0tQawEQ7kNvwEuw1ld&_nc_oc=AdqnBh8if5bmXOj7AAx26EMUThmmIE_qUPM3B1XUng_FwodbaGR0OQKJrYyTx6cnuFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gNUZL7KF0fVznsZYTCHUP9fIKlVhsIX3Ku1ms4e7kAw&oe=6A43C367"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXDWx3GEoh8Q7kNvwFbiG9W&_nc_oc=AdrfF4D7OTvSGGXkWrSZjZ6af6RPCfie5JHGAfbHMg32qCpwbY_ImucMakJQdtPE4Lg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PgAo1j6g6Sfzbk12xQx_lKHXAftMAWTbI9jONRuCPHw&oe=6A43C3FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
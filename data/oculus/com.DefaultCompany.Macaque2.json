7kNvwHBHlDD&_nc_oc=AdqzBuHqqQY1UuAkhTSyt-7fn2hps2cUrHjvjijexc19DJku2EfinWaBJq5l_REUOzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5XhXm6BXpbaImhwg6RsoHufBxpWI8jdIkP4QMWk6mCg&oe=6A902BA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCbwxKGsjbEQ7kNvwGkdupc&_nc_oc=Adqzt3NTGqypJn5a2EJTTJQ6suhcB5lzQhh2D_B8fUDRPwK7E5u7qCwq_J9WaVL7rQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-W_PkjyxFuwcQVzBl_folJnEkYN8iX-XcmXpjiI8Y9Q&oe=6A903A67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuak-2uTu9gQ7kNvwGV_Akf&_nc_oc=AdrDLtXsjWuxZzh-DhRbRazSkr0ihesL7hZ_FfM8KPO-0U5FsauMZZWefuVIPt4Zvag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuah8AgER5Lhr8Iv9CRuBVezjMJcYGbIaE3t_Ngvpt1g&oe=6A903AFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
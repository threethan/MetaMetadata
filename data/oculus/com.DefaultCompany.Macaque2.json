7kNvwHicMPw&_nc_oc=Adrt0x4cWbjg6fKXGbs1m61BQ4PjALwh6M7xrEFzZCe0z7qzyG22HxWnV-XzUZZUplY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDwC93OEvqUdzDPf0BralMpEoYXsPPVIBX0a5Ex0IP5Q&oe=6A81AB24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OV8_OdMK8G4Q7kNvwHSwTB9&_nc_oc=AdpLQHUEnX1mgUrcgUIT1b73uSsxTI29AkFVW_6O09hWfGOT_T9_mBIE5tWuqlKbXWc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbQbDYNWCL0xCsM1528-QErRMv6j12krSvemmuX9W6bA&oe=6A81B9E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycFfasCh8qsQ7kNvwHlvaYE&_nc_oc=Adpq2DdCQM6OwOvHWGXmn03tCYqjQV7SwGnHN_5jDzB2gcWmrPtkRWraFkUXi8TLvec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZN18a_GipzCStbzalEEkR0pz7OwB5YrOS3UESdg-cmA&oe=6A81BA7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
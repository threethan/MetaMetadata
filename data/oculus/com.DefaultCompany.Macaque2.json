7kNvwGbcvBl&_nc_oc=Adog5kt11imD88JRsldZJY3AKaNkTWskSD4fp4LLC9WSql0dKwq8pUZV8VdnJojrqtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dSWhwawalfp11RvzbJfsGCM2s54q0UhYapcmq4lGq5g&oe=6A259A64"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zd43bbmmDTIQ7kNvwEtYB8z&_nc_oc=AdoNmMlHCFkyPik8X68Me-5FwrGQL0-a8X8vKIchLGHs2fpOb_TJzdt9zqcobcVHCPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u4ZNZA-PJlcFqIMfOF7LB2LRwS83cFkKWqelrhx01Mg&oe=6A2570E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLg8ZqOM-dQQ7kNvwEEtt_7&_nc_oc=AdpQBh0AJCRRRwayFM9gxKrFar6XjYErCoiBDgFY8i5WZVxIa3i_fQimVlwNhgoJq44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P8zQZ_GX2cKgZONqIJBy8rxQ8OTJVtcPlrLIfG3_4sQ&oe=6A25717A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
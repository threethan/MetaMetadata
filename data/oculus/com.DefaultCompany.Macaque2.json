7kNvwGBBk_B&_nc_oc=Adp8xsr9cRyzhYVX57nOhZ2-IjBg1aKVc_BTq3D0oq1upj82ZeGI74yHoFHhCglifA8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN9hH-7XFgP4wwmtN3EsXe9ceASkXrWAWmjmnJE3f3pw&oe=6A917D24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCbwxKGsjbEQ7kNvwH5_0wG&_nc_oc=AdoYUTP7vaVW7duFPpknii2kisTskcdz1__f4Q-mgUuO020N9PkWfSBkgYOq-kZs5iI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD83xx0_uOsquovydTZfM0lgFyUJ65uU6lojZWrUyNSg&oe=6A918BE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW8uT_j7o5sQ7kNvwEXa-4-&_nc_oc=Ado1stcSMfqaMebxLXSEbxKOzFwCWBOKjSUMIT1ukRhbcrpEV4NDUIQVUqWxijs4UnE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD1VJ96QdOsIeLvt7H6rHJM_l71KMhvk_rkv_XnACkwA&oe=6A918C7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHuQv4w&_nc_oc=AdqQZ1J2EC4uJG2NF00PTKjMDPzTNstQIRgGoUYsrPPRlLLgV_GxHPlHnlERQ0IXtQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xv03Je0MThs055wymUoyNo0StYg14ZmtA7ghO-DS0NQ&oe=6A3FC024"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMnDjHfqeAkQ7kNvwGSP9pM&_nc_oc=AdpNtl3DGeo8XXo74mgHw3JmWyoaDTFbxWYAjSW5Z4TavdJ77A2lJI0z4lukMxI0Rzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X4cJmYNZ1SrrdWS3JwaNKz72CjgwGa56r54t-tyALSw&oe=6A3FCEE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjPmNCGOCVMQ7kNvwF_l1VN&_nc_oc=Ado1DR6qdaVjyx7SG8j9XM1_Cu25GalMc2uJ1nAdnflmFuRiIhznwbJsJ5Z87gexELA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eAQJ6X-qItFDla-QkrSLBIfgdmnFRDTJMD9LXg0z_cw&oe=6A3FCF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHQtchE&_nc_oc=AdptxKlNJo7GUuHDZHHybKFbG8HcsXzrLCs6LZmKy0zazCkg75kionera7r86XVcOEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nZ_G7PVnEh3G_7KZYWFJwmCHyps_MpkBRneAwlJmPQA&oe=6A341AE4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHp96bWX-oQ7kNvwGGhLIT&_nc_oc=AdrAuSxcMx-mYqYxz6DwOshroxNffdGoKa7UPuE2mr-_d_xHvCYWRkQFW1PUtjAvHP0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RxCeSHkl8Bs6ozy7uc-bFnIoNPeM85ySnxY1WekQV8g&oe=6A33F167"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRB7Wk-AJ9IQ7kNvwF9K_zR&_nc_oc=AdqX7SF16PQLE4yadYOioHo2X1agGlzdNEC7JyDDrS6lSThlzz8d9wfxNZXgoCx2_4M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JIb-g5dsBvdWov53FVEfgbpq6VmWvnfnXI_BFxO67YQ&oe=6A33F1FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwFCeTwp&_nc_oc=AdqwHsgOjULwTRYQqtaDd3pG6ouhCNpmmhOC_0VCFwjuicy5pYIoO7lQYRGUGJ3Oqmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7cpJP7q7G25wSoSug7LFRa5knQ_PE2YezFga2W6kHoQ&oe=6A64AA24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8pVthn5RksQ7kNvwG8XTOA&_nc_oc=Adq_rjr-2ptBkdoVCijKD2ZjNse84rmKzZsUlE9FJQk0KCq7GFkPev8_oCt9e9yPwiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEgI_vPdUuejdpkenfxEfL3vBQeBuJpROIjmeKKcf1cg&oe=6A64B8E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyQTRuSgrO4Q7kNvwHaZQ8r&_nc_oc=AdrnlWRoliYRzYzTDTnyZROq3PZb86eA1yOJY_8krhdC-I-J-7EdWSeckc6acIRxM5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAbrVvElXOtySnyd883erljDqhCCvc9vl3dyGL-xTFIg&oe=6A64B97A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
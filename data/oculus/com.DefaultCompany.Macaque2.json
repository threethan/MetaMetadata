7kNvwE53lft&_nc_oc=Adp6kBZlMKH_urqcpXTtJY6xP5_J7omCHMeOFj2T8KNKPSdhjFwaalNFqGqXk9InWsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn52viFb2XqsaIqwHToxzY8VHKWXFxJL2HxV39IzJJmg&oe=6A577B24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5B9Xz2ZluQQ7kNvwG-yh_7&_nc_oc=AdpVJjnDGya_9u2bfsY_zKZmY9TKpTgFZmisfO0E8oHg1qvLWwAM1qLEkZ6INm1WmHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7lUyZ0N1I8LqRSEvP0EfBhVvPau55H2fYVNswBewGjQ&oe=6A5789E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_QYjGgAD9AQ7kNvwEzBL6O&_nc_oc=Adq5iSU8Tz_5cm78xukSKD3B-Dxt1uLpHzEBPEyVOM9l5DInRh5PpQes2QcNLE-EMOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdQAbLXdVBxt-qtyjQc1b03fEexQLGhQBz3w2fgX55TA&oe=6A578A7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
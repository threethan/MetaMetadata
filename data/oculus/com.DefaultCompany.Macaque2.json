7kNvwHflSH8&_nc_oc=AdohsYI2l-Qm5HpGBK4a2MnIAqcuBVHdVrCVwXBAIwgxLNBllpNP_SieJfuJ59npXnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNJY3N7M68pdSSCcvrRjzh-rfhzQBgYkIGwIYvkpSPHw&oe=6A4CEF24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSHvXgMVQtEQ7kNvwHEh8PT&_nc_oc=AdqBdS5hJpImHxZc5CI_S2LfFGcxuJ1sL6IB4HqWi_lUjNW8jDNgO2cQAxnjGq5Th30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkkEPeH-iV0Yfqqm23Ftg5hUvg0n5xxqVw3JaSmkA6dg&oe=6A4CFDE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXzx3PuSHcQ7kNvwGHBja6&_nc_oc=AdrU6QNJnUq7uRCcq1majqwVSO3pLCxPOi4v607lnBQXvwV0kV30sNyJ4VVAKUAhSW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYSEAUC_LWStWxfcnp8lRr9ZJL4SWqFlLpocJCoWZpDA&oe=6A4CFE7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
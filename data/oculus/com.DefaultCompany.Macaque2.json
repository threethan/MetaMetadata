7kNvwH5s1bj&_nc_oc=Adqm_9Kju3Mpeedg8-Vy854o-Pkz8xY40d1ngja2mxbY3PPEbzitQK1CVwxTvVQR9qY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHNbTOXc6uIOxYqdSyeN61mubmXQO2m1iK0MIZfLr7OA&oe=6A9733A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMJ_D-hSdUoQ7kNvwG2P7ag&_nc_oc=Adq4RRrYJTzfSaCl8Ux7aen7YUlfJuSObWsdy2zYowsLnd8cDjV5pHG96t0dXr4lY_Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvFgwqxB3R1K4Ra5vs8a9hP8LiBu2WooJR199Rt60How&oe=6A974267"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfOxLo5KvnIQ7kNvwEid1XX&_nc_oc=AdqzP-zrmYszSJQB3xgYY2ik5sQpgJIC1uOcRjrtrc_dP94EzJX-zNmAv8XvvmqRh0c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOc2zkuhso2EbinU2VgQAl7Ys0s78R-qOOYvbCuOR0KA&oe=6A9742FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwGjx4oQ&_nc_oc=AdpapT698OHyobilgLDhlq9fEsRD6uTvYo47XAguGNBWfcdxSCQw2EJr8PZUoGSlIh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnPM_ySk-5odo-K3VATmYjaS2Q6KrjCwjInE17-_3pdQ&oe=6A7F0824"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udOzZ-ip0bQQ7kNvwFWAFSF&_nc_oc=Adow1YDlif8B3myzhqh0aFGndEN6_Kbs0lgutFmKj8awS1JQ8DBR7xuxtgfZOefLH4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFstgd4Qsd-jsNXU7UUjR6UCP1Fh57LIizZou3Hlk4QRA&oe=6A7F16E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfSWCysGpuoQ7kNvwHNo1vf&_nc_oc=Adp6CEnA9Y1AmqfEchSIUJdloLL5GiKah8n-uSKucfWeN7-qewQlv9NpM1NhexJ-1js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwykTpoKI6xxwcXrv5DL4rq1y8ppIEhSHWeABAnrly8w&oe=6A7F177A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
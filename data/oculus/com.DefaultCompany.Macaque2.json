7kNvwFnYlS3&_nc_oc=Adozg5qprfjpP1Zt2ekTBH8bdgl1O3KZ30SyT-Qd3hYYpNDzsgyPngoFKLXmiXLTxLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN4A3x9w6jx1iTmZzKq1vEJs3900gYKyqTZggDbbdbiQ&oe=6A48FAA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4DtKK1LuZIQ7kNvwGehk_w&_nc_oc=AdohK8I4iUnmkbOK-0c2HrNXGLXDDe5maSoWQ-GDaxE5yL9GRRUeK1fbKIxKSiDCE3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsuK15lkP8JXeorEX_jUankQuhipUVkDuiNSTwNptjCw&oe=6A490967"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDVgjLp7XDYQ7kNvwGn0W2S&_nc_oc=AdqAXr3Puzk64BN4H43P4XO7Ef1l0TzrbTTDrdn5A4GCviJmOIv2dnptuQCOltpIrsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlP1I0wF2cY8bzm635HmfEuiXqFR9TELXf09P10dVXBg&oe=6A4909FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
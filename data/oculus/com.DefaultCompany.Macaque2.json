7kNvwETWWUJ&_nc_oc=Adov60rSOTWIQ9pRy1SHYuPDPuDX4rKN751vVYWogsfcepqlEAFdDvtfBazSJ54IKhI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4nkNoKNiF-sM7RU8L94AcdS0kmP68lcjrVihd4jxRJw&oe=6A9FFDA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcOqDwUc6gQ7kNvwEgAkdl&_nc_oc=AdourLc2IpUeeFpgC8uUP0J4ggaarwN8CVc0eCbDRKhHfeCBjTyT8fIvtoYOZDx5K2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2BIaPfpW4D4An3RxCuJyDUPCw6rXrWo3FmwQnWzM3qA&oe=6AA00C67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knDr69RJy7kQ7kNvwGNzOgd&_nc_oc=Adp-lPT_iIhhAd2w73dKM-POCrsGVFgoElQ6dqTr1MhG5A97juPd9lRYMEZbNsCKUzY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRr5VNUVftA69WouwTi3zAUwJcg1_qTu2Gw1NT5ekiiA&oe=6AA00CFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
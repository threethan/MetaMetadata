7kNvwGSSVLm&_nc_oc=AdpMjlNZmIbll6xoCV_FA9KoN4TJk8OdZVU12dEbL53Pkh_0ccHeafPJZY2wvy55bGg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj7_U012rOK09oLYR8Vv7Do7qMslCA7I2fBBfD2lMVtg&oe=6A6F3624"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVfNxZ397wQ7kNvwG0T8O2&_nc_oc=AdoRUD0vJ6FgeocEU85qGy_4JtV8-O_sxOAV7BM9k9oV4I7nfkXu7RmUBYmg7dhEFEo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJT1HKM8BAXikIw72gjSb4U3Q7FXFYVSlxQ1YEE9ePBQ&oe=6A6F44E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhxSmwhkan8Q7kNvwEir3CC&_nc_oc=Adp7Q0O-8dnZl-cjO70wkGfYxvlC_gyuQ_YrWp_i-kAvCU_pctEC9nzqGKDLuZIJL4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIei7bY2yWoNFSQ1OH1nUgWly7rCoEC63S5iYPaQOiKQ&oe=6A6F457A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHbJfId&_nc_oc=AdphYBT1HipEWBadbnFhgpKJAwOPf5exGbHnjzFfooivIfsuzPFX_6ZDHmFxZdwCPQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N8inrAu7__keJVuyE8iqwK7HXgeeCAB-5SJmOXMZevA&oe=6A21A5E4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7l3uM44y9EQ7kNvwGx5gdc&_nc_oc=AdoUhm77TOeZhLwykHjUjvYmTDLhM78O8VsVAVgjjQZkZZodzPg-R6t9vwzME7eaNco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LGTLOXf89Leqt8MyEu9G2lmZjRtKEIhv2rL9koGBfEQ&oe=6A217C67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGREGGw5n24Q7kNvwF7jWHL&_nc_oc=AdoIIPmMDI-hffdBQxEpsnH0whH_BmUccHezEJiJ3F55D9_52JCB2CAgDBvVOcB6MqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CFFLTsyCwrbbWjKt-42fPvuL-g4-QPbjMz44shOSzMg&oe=6A217CFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
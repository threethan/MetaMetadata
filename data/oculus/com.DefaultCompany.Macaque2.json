7kNvwGXXnM2&_nc_oc=AdpIBPC6Y11IRgRDpUGGWbhx5IbuJexJrxLjKLrQHtNzkfAzJOPNtVUbJqqTq6gHob0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEpBvmgvGZ3VT4L4l4NArBjyBz1vBcoJiPTU4V005wag&oe=6A86F124"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeKpRe0VoHMQ7kNvwHSEbOe&_nc_oc=AdqGdU1YeOyeJ4kdMgFJ6_Ra3RpkNHQBRN52T0WwDVHj0zN42H4F0f4tAoTJP2baoM4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBCr_wbHNerQy_G9V742zL7s0rFfyF8uXio0rFdWq4DQ&oe=6A86FFE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOTmod6aep8Q7kNvwEqaCGz&_nc_oc=AdqecVVpvg_bshNx2WTgE5M_Xxpsv3sYnJsSvJSo5VuKkmD1eubFs20XI1PGoIkFwlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoXMHIEzR5i-n6LGMVsY21SPNS8eEtzHTYvvn8lX_L2Q&oe=6A87007A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwFcrGDo&_nc_oc=AdqGYjXKov0WnrDx79g93A9XshHAx-DGnfHWruHtcGiAVVdWoCITUOeB0hRoFtD184A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0FML13cweZtySOCe7vBcG-F-PbdSU_clg5TALeXxsIA&oe=6A69F024"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRUhdKu9THIQ7kNvwHRhzOe&_nc_oc=Ado3oxirGpiGD_8k3cwjR_BQ9R3DemJYgft4jYmnfRUfnDvb2Ybq3rCqYQpKYoXPrfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTgtToUtvHTwxR-QaVALTvPTVKvcC_j99XExIEtYNDxQ&oe=6A69FEE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9oANmQ_DTUQ7kNvwHgXRwt&_nc_oc=AdreAgz-SJdKRcVnAasCgSaOdyZogq68GNNrckrbtdMz64SBm2kiEY1qXPROHLg0jg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvW2V8XaO7H7RstdxvGQWU6HmvSnxCfbwA9I2dNpDalA&oe=6A69FF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
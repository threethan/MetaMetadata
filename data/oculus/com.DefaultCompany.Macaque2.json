7kNvwHj7ZBt&_nc_oc=Adp6JQUwvN3ZOCbaOHy2w0l0XuiqPpQl8foIDKvmvmx2nNG1TCX6bi-Q3VVmqWxWNvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD0BKEYphE7Lqd3e6B_SzeNfcj_870FGuwPHZeLsZLJg&oe=6A4A8464"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4DtKK1LuZIQ7kNvwFhb3V2&_nc_oc=AdqPlGEkwdFa5Nk-A2bRGZPDitylXtm02NEyvXxxXE1raT3sXNXT3S-3wsj8s_oyWyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhyHCjwwJQkRRdVR4tzUMMDCgA5DISxIEBNorP7HuLaw&oe=6A4A5AE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXzx3PuSHcQ7kNvwGu11l3&_nc_oc=AdpZnN449u4LUfR5ZMNzGohnAkXPR_XoObtLy7C_65eB-RF98FkI5U71PuU7AoTXKjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW93nFX12d6rJXvHuLps2gpVvK9JLD4-9cpMobDKfKmg&oe=6A4A5B7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
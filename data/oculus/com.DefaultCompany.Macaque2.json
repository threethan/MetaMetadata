7kNvwGBuAzC&_nc_oc=AdqFPD7iOwOK-dkVeRG82sMTnt3wbF2JC64Xe4nfNBDT6CTys5TFe7q6NoDfJ9lu6xM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ged6IUuvDyBucVQg1pgBMSDWkCO9UrfKwRmUecurb0A&oe=6A329124"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHp96bWX-oQ7kNvwGh28zx&_nc_oc=Adq4dgutMm6U4U6K8F8JqyxXqIDx_uQhrfi1Y1Lk_W4knz4-YPZWNqiNvxjpM516sH0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pNrOq4-nCdQIJARCSxl8KYUw-2bbn6pSYbZp1ro-Jrg&oe=6A329FE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRB7Wk-AJ9IQ7kNvwHdqAED&_nc_oc=AdozOnv4YlZvmASuw3_Y8ElOiweSCX9R1CHGy5Xu6-U_6lnvqCBH1ujVdr5tuZQe6M4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5bUXZmREgWa3_rUuHFW8iB72hAIrSKbVpWwjC4LUR4Q&oe=6A32A07A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHwq0CY&_nc_oc=AdrmT9I5RhudjppSlJxxzb2hXelsS3R52iC0BBkhbMwS_vKHzjCfQCqAYLVFZuqd5rw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmaJWcsVGEiClZ_klpQRZO-hweb_CG2x-YoIip1uKN4A&oe=6A4B9DA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4DtKK1LuZIQ7kNvwEYlJ1g&_nc_oc=AdryQp8AJrsErVQZjl0L0ruZE4aJUH5-ZHBzcvDTpgc1tZw3lyCqlBxxO2sdadBcf88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL1B03Jmh26HvxeLTNXfKsYCRva0fp9Y13kKP5gJRbKg&oe=6A4BAC67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCXzx3PuSHcQ7kNvwG7nXA7&_nc_oc=AdrUFx1oMRpvQmh0MR30I_Qj3nKROoWneLfaegVOVpD4q_RvBcC5OsivsKlg1Pzi1Dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATl12M0zLXR3Y7iE6I4vuc4BlvytBwBjGptk7deBDA2w&oe=6A4BACFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwGB8vcq&_nc_oc=Adrg4cnB_MSGC0Crz_qsvy-IECwVZ10ddvX8XgoG0D3XlH8-7-LxV6E45xGE9EbNwkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gpS4uPoJ79buLEpmfjqDiuR4BZ_9Us0qmZCTJY4qJIw&oe=6A201C24"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiOj2_VoodAQ7kNvwHmQcK1&_nc_oc=AdqSxQsDIumz6_Qrx5vSsyCl-nBpTeFT5QNjawln3vg1dWCwcd4_4gJW_Z0ppWWQ6n4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54xU9fsEtGiupSJUNZ673ZiuOSNUwGAGCEVWvK0LYEnQ&oe=6A202AE7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGREGGw5n24Q7kNvwF-rm16&_nc_oc=AdorlWhAUyjJ_JGr_-t0gDhh5nrMb-4yRIQTjc9QbBR99tdRoC1_X1Tp7I9YuHXddNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uIArm0b1GW2AnZK8-4gdGTxhgLAdCFECNoeFFXCJ5QQ&oe=6A202B7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
0f&oh=00_AQR0LjyGlCmLq2KlSQ3oPKX_f0Qabz-WOz1AzNIm6VSUMA&oe=6AFF313A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1pB0NvfaP1BTaNKDWoDFuGQP5xn1Qxv9ZWc0Twig-3Ho/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Wafers Game Productions", "support_website_url": "https://docs.google.com/document/d/1pB0NvfaP1BTaNKDWoDFuGQP5xn1Qxv9ZWc0Twig-3Ho/edit?usp=sharing", "website_url": "https://sites.google.com/view/maqacue/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROO
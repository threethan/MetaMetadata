7kNvwHRuhzH&_nc_oc=AdpLMDVgz7PE2wO7mkbQDuKYLWyvE7dO8hfrj420B80VLx0s3d5WTYveMdBJxcc4XTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gAkRxdJVYBVnJ_b9kpbS2owQPmRQQLZQzJ22Bb0MT6g&oe=6A1ECAA4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiOj2_VoodAQ7kNvwG7TF2q&_nc_oc=Adrp9EKTfHg1D8ZkvW5uA6KX9uO1DpuyxeFK0n4sW7J9COyA_e1r2LqigZNqCxp-oU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NsqYb3HuROmYnQztly867nLvSpt1yBM6iZh1Sm00lGA&oe=6A1ED967"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGREGGw5n24Q7kNvwEq9oBC&_nc_oc=AdpvDfHCFHE0awMiSYQtt8c6-l5ojbu7hMs8qO4GXZDlCnPakW5JfQn54xoN39El_Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UlZ7ejZd0_W3DdHTC2ygoDJpcQUkUgmhTYEA6WKN0qQ&oe=6A1ED9FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwHUQ5C2&_nc_oc=Ado0qkWSzvSOa8FkASI0BpyvikyJr6hidq52FwRl6SPb-JMoDKeK-aG8_FaSJBDwcSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8p66BdhqGh7DrWZQ5sXmnRWxNIoOMjOMrIjtKpXUm1A&oe=6A8C3724"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hwf8qJbypCgQ7kNvwFZnc1D&_nc_oc=AdpyGWsIKVu_AZVmDLm9BQ7NQafUwb2693mEmnmPhP8fHS5llk1Lou3972SYZxOtYco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEndgJuAw9tHvPBlFKf8xCp5TfaxSH-d3grrD4u1S31Ig&oe=6A8C45E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCXFRhSwtNEQ7kNvwHjUI9m&_nc_oc=AdobQH_DidyavDw7800RC8nV_8cKTkSKD6UsLGB20lE6iyx5iwku6CeqLfYEca-Sf2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzJpB90OLB3DEC5_HrKl6gDdkepyYKVu0zKlciUSd5xQ&oe=6A8C467A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
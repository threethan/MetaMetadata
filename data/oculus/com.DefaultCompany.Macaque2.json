7kNvwE7dnNS&_nc_oc=AdqEDcGlBwmwK5EPozUSMlNWSmTcasD_pKx3w3UECJAKSagdOTo_Qh0ezg21wPimNNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPbIaSC9zOwDRY31T6-XuEPKp0Rvymqp3Sn-NElRpkMQ&oe=6AA2A0A4"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcOqDwUc6gQ7kNvwEuvGKr&_nc_oc=Ado0FCfgg5mgn5re9Nh-ZqDu5EWLbHoJMjAcgQqgU5haNVfMeGUdIz2bPiPZFT3VT5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtgtL4HRNZiK8IUKLX6Tma_p6LRt1XkyHkLi-b5rvgNA&oe=6AA2AF67"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfoX6HjvPNEQ7kNvwFibajA&_nc_oc=AdrmjVmc1ZurakVtJGQZI2g5nSq8eqcYpPVMm3efc1XQE3SHkS5mcyBCIjoH3qowe28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvlq1pFnK_Kpx2Epkk-puXWIRB1R-W5ayRFTsU_Klxdw&oe=6AA2AFFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
7kNvwF0mUU_&_nc_oc=Adp5HFWlbDpnftfwozxkjB7ay3C51pKuwfuKQeW_SjgZMPFGjp5Skxs5BCNQU9OI9n8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jZbVVuwW8mG8Y0g6ovIHRrC4C3ikTObJ9VF1vrdbKbw&oe=6A380F64"}, {"file_name": "3.png", "id": "1499507151602766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294643_1499507154936099_7118635138041816438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T2iO2rX9KYQ7kNvwH9fj44&_nc_oc=AdqYxiJEXpEcI9tGUe20mjiuaHZmUPmsimZmmsa0I3jEe4hqU3p_a7__yLsiUa6yaxs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wnaa8KA8n2RNHFK55zZg5V3mexSd0mdPhGl-DoH2BWQ&oe=6A37E5E7"}, {"file_name": "2560.png", "id": "1619200342601790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308307_1619200345935123_7723891209240253990_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTLZ70vAJooQ7kNvwHKdikW&_nc_oc=AdocBy_8_NmozidOKStbPye64qEJbFWoFljIh5RK1WRwJUXEfkLcd92TxWnuZw6rSzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tVFfCEH5P58oOFKZMRdvloJVI60Dt9yovSOZq4c8ANA&oe=6A37E67A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaque 2", "keywords": [], "long_description": "Welcome to Macaque 2!\nMacaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches.\nThere\u2019s a central hub (called the mall) where you can purchase cosmetics with the in game currency (monkeys), mess around, and head into different areas!\nHave fun, mess around, try risky jumps, get lost, fall a lot, and laugh about it. Run races, explore stuff you probably weren\u2019t supposed to find, and see how far you can push the movement. There\u2019s no wrong way to play Macaque 2, just hop in, start moving, and enjoy the chaos.", "short_description": "Macaque 2 is a Gorilla Tag fan game focused on movement, exploration, and fun maps. Swing your way through forests, mountains, and hot beaches."}]}, "developer
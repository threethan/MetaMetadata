K4OnS56qXYPmZP3H9BiruGHUyQp241M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsWLQHXsZfunmxxaHbWruvgkQTMqBTUT4PRYFyI42oAw&oe=6A4CE917"}, {"file_name": "migrated_image.png", "id": "206771700559215", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_164015274160671_832598007537991680_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiB3Is7Zi8wQ7kNvwHbQ7Xt&_nc_oc=AdrRBmaDJJDL3psw7Zx5gqFGZKnXhTPXxGQu-gvr3WoW1fujOgRbTUgioUN_K3chEK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcj31rcCUZl__5JMKpuLj3nAFMXWj2iJhu0ItPjxmJAw&oe=6A4CF9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20170829-233423.png", "id": "2000307230202835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162688_2000307233536168_7528282456693145600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n83xSS18wYkQ7kNvwH9mi1Y&_nc_oc=AdoPcmV9ZtWnyPiKke6q1vAlXjK3zfvwMiB-IuoSsPcvbyKz4r6GgyXwU0fNG4wHBV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQYoflW8FxIr7c7WI2htgGe1y62_3V64fD0W5fN5nIaA&oe=6A4D174D"}, "display_name": "Scary House", "keywords": ["Horror", "Haunted", "Scary", "Ghost", "Game"], "long_description": "Best addictive VR (Virtual Reality) horror games for those who love to take a challenge to enter into a haunted house for a treasure hunt in short period.\nVR scary house of the wood far away from any civilization and habitat.  The goal is to find a key in a scary and haunted house and reach to treasure room of ancestral wealth and then a there find a key of a treasure box. \nBeing unaware of its haunted nature as soon as you enter the home, you begin with experiencing an invisible frightening you. \nThough, despite learning the dubious nature of the haunted home, you have to continue a search for the key and roam around one room to another or floor.  \nWith escaping from the ghost attack, you have to reach into the treasure room and bring back treasure in short period.\n\n\nFeature of Game\n\u2022\tScary atmosphere\n\u2022\tHigh-quality music\n\u2022\tTreasure hunt with escaping from number of ghosts\n\u2022\tTwo-floor scary house with number of rooms\n\u2022\tGorgeous graphics and different themed rooms.\n\u2022\tMany Others", "short_description": "VR scary game which takes place in an haunted house for treasure hunt."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.atmegame.com/privacy-policy", "developer_terms_of_service_url": "http://www.atmegame.com/terms-condition", "publisher_name": "Apay (Atmegame)", "support_website_url": null, "website_url": "http://www.atmegame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "290573869637116"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "846026702266109"}, {"status": "PUBLISHED", "id": "1715381118521251"}, {"status": "PUBLISHED", "id": "549010735978330"}]}, "baseline_offer": {"id": "1715381118521251"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1522220400, "status": "PUBLISHED", "id": "846026702266109"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1778414452287947", "version": "1.3.1"}, "id": "787293968110852", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename":
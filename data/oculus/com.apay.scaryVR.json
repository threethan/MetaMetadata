uluscdn.com/v/t64.5771-25/38974569_729565710754902_1522978270537056256_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdjFrQGr4bAQ7kNvwHjXYMw&_nc_oc=AdrDVDfBIeogYeKkMRCoNxjkvPWUAyG-RU6IhqnzfICURz233OJ0MgqOY_PrxDYgBWY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWH6zQYhe6MkI7uVpsrT1xbbsYzZSI63ON4U9I9H5xiQ&oe=6AFB36F3"}, "display_name": "Scary House", "keywords": ["Horror", "Haunted", "Scary", "Ghost", "Game"], "long_description": "Best addictive VR (Virtual Reality) horror games for those who love to take a challenge to enter into a haunted house for a treasure hunt.\n\nScary House is in the wood far away from any civilization.  The goal is to find a key in a scary and haunted house and reach a treasure room of ancestral wealth. \nBeing aware of its haunted nature as soon as you enter the home.  \n\nEscape from the ghost attack, you have to reach into the treasure room and bring back treasure as quick as you can.\n\n\nFeature of Game\n\u2022\tScary atmosphere\n\u2022\tHigh-quality music\n\u2022\tTreasure hunt with escaping from number of ghosts\n\u2022\tTwo-floor scary house with number of rooms\n\u2022\tGorgeous graphics and different themed rooms.\n\u2022\tMany Others", "short_description": "Scary House takes place in an haunted house for treasure hunt."}]}, "developer_name": "Apay (Atmegame)", "developer_privacy_policy_url": "https://www.atmegame.com/privacy-policy", "developer_terms_of_service_url": "https://www.atmegame.com/terms-condition", "publisher_name": "Apay (Atmegame)", "support_website_url": null, "website_url": "https://www.atmegame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "rec
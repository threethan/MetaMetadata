3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7_K7S6knjg99EtlddU3v4V-xdbM62nW9w5bYDKq-Gjg&oe=6AAEA129"}, {"file_name": "ry1.png", "id": "921950635369973", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974877_921950638703306_2023399575315261676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVDNWT3LW6EQ7kNvwG3nTjc&_nc_oc=AdrGiZjjQHKYLqz3cIidqa_UF_zRzyzS8dupwCxX3X-GgOR5DuE68DcQi8ZaLbTAy2Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDlX2T5vxdyzhulHyNsMF5-UFpGbNmg2iHtHclYP6gTA&oe=6AAE7E26"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-_uYHMwjGoQ7kNvwHCF6_i&_nc_oc=AdqVPYSiDkG6W5FFoxDzdDunjSMlqQX-Ul9YEQC03xD05POlB2P0eDhisCHhiN7bhNM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJumwvAYAYfl_rl7q_J90x5jDamG2mHXGnzRtsy11bcug&oe=6AAE8E92"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM5PM7575CoQ7kNvwF_w1B3&_nc_oc=AdqVex95RNq3k7fS6K_5Lsz5i3Rr_NmZqF9e9JFmBBKmD-DOBjj-EhIbDBDhkPGra6k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNIJ8KpCK1SKbZKHzo__wM72LhFlsOo-6mm5bZ11ODYA&oe=6AAE8AE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17FqWP_ajz8Q7kNvwGcGrpE&_nc_oc=AdpZopad0eV0ULGbG2xdX92UZOcRuCfAp5NOWXNfraeqXgnVAjCNDPxNkIpMfT1aTG4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSFpifzAm7y7ENMrJrZXsgUPWt7uWhMheGDQ1Z0TX3-w&oe=6AAEA93A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Yoga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1
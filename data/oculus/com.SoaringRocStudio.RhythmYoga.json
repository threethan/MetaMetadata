QsQ7kNvwE6Ik2_&_nc_oc=Adn_6Y-sKR4JKfelv_Z4ezsK-DjZA9Tj2gwRW6g4poGRvzFVFiZ0QPhDIvJL0cw9aX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJ2PQio7rNUzJLHFb0oKB3bhA5AHW1iUl-SNrCc1NRPQ&oe=699DA812"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O0bE_nTwmwQ7kNvwFtCDOM&_nc_oc=AdmFth5kZz9ryt3zKQdnFeZwb33QmSXGgo-_Ie3QN0DvhdXcDrvcnh2mS0ntcsVShEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu7wEGQcHMCms6N_fUJH8cHdreHBGQ453Z5JKQLoiLS5g&oe=699DA463"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_su
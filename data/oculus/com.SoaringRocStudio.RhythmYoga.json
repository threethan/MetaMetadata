ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWK5IPQbxZrUSSPTwl8HaECbPl3jMGZcQqG6t57DHQKQ&oe=6AAD4FA9"}, {"file_name": "ry1.png", "id": "921950635369973", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974877_921950638703306_2023399575315261676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVDNWT3LW6EQ7kNvwEhll9D&_nc_oc=AdolWvKccor4mm3F6v6HYEzwr2pUCgOQADm8DH5aYEwunECYznNZVvJHnfS-gZ9QZi4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmLFZUFu16GRvTBvUz66-Qc2IP24TjTtCJR9BZauK_Ug&oe=6AAD2CA6"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQXkP4r5rmwQ7kNvwEysC7E&_nc_oc=AdramBwzrscn1klj3fMneYO6LSDmt9r5fggBIgYHps1-b6bpPw6XoKm1WUdpppNPLsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId4DDSidZFUYSHHB5Ir9fqfwrtbHLFczjXwsRNO1lIog&oe=6AAD3D12"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM5PM7575CoQ7kNvwHAvTS2&_nc_oc=AdoxxruLb_MKyAEvVt4fWiLd2SwXnOu8_vfsD9-mLjqSXbw8feJNfvWy1p8qQ-PVt-A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYSj8znkeiNm9xKJOiKRic3hiLFoKqwpfBkgehEGQZKw&oe=6AAD3963"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKJNwrgYd0wQ7kNvwEhshqo&_nc_oc=Adp_OGVhRuXgk3s0gilIEL0lJxJ6b4-nV1A-19kAyPNiWpNTceZhWbn8Wuu2YcaEIdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4oFU6YTzkWXgcLrzdJukUEffGtb_3UgjIMAOJniC_YA&oe=6AAD57BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Yoga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "16725773968
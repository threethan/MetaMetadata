LEQ7kNvwE8a4Hb&_nc_oc=Adk2hm0LKqVwaMn8hUJrcP74ErgGvQGeNfLESRyiFXHQFxRkuM0pGjjYz3ScPLdScfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvuxyCJCY76C5C5GxBfa_OxBLyz8a1Hz_DvDfx4AKl8nQ&oe=699C5692"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O0bE_nTwmwQ7kNvwHkSepA&_nc_oc=AdnZK8JRSX_Oa8jRh_vqJ7Z1Vb9_M3jgqqPrrLn3CaKQi5KwQlZN8Uc3CVTzr8DqBLU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuv7W8Rpvbl0HAveHqedkPDQ2hovZjXPuWzcycxzghDqw&oe=699C52E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_su
cally generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC71wnlHpakQ7kNvwEfKYdB&_nc_oc=Adr9Dn0M4JC1N8cMhH_A0gP__e-yA7vhcutKjqLVuObZL9scOj3o-p_V2TtDEznegno&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE47VSI9dITP7cQLDsJSGOrgWGSvSsvpj7BRkjBz3sEFA&oe=6A8D7B7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Yoga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1
952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7izmUeY-UYQ7kNvwHdJ5-i&_nc_oc=Adk6thLNPtSvcVIVkf3ZnS9854cypgO5UQPvar3CUEPq2iUeIKsRIkYKLf_4y9PZrtI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBgTgOTzkHXKCGKOTMVz7z4y60VZv1oHRnWDDA6M0e1A&oe=69BD4C12"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DPKIoV4pLUQ7kNvwFMF0JM&_nc_oc=AdnrMUAvS85mjzak8iwWoyyS9UwUN9fPdyntdJ5IxMi6IKiyvH3o6qkcp0MHwZZV2do&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4wOHQh1YC8-Qlp5CJC1TOpr7ukm0YiY0mgmHtv_yEZw&oe=69BD4863"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
QsQ7kNvwHOVQ8q&_nc_oc=AdnntPxzoLXqFSRfjQQlzwhifek97mhyGGdwBc9LevJauOFynH9oCVA0i6NSah_ZccY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvhVojS6y-9lrpyn_F9K4WFRn9oBx3GX0wluYTJJ5_VA&oe=69A04B12"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ua8eRPSb1EQ7kNvwERoNiG&_nc_oc=AdkGNpzWq5xP502aI4cCSOSaca72BHapclvLM9-KkeXMSrp47NaXxXiEqYibNMjUuoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPcE_SoVeO-_sNRai2N0LotbyYp_QRqHVeQ1EOea5zJA&oe=69A04763"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_su
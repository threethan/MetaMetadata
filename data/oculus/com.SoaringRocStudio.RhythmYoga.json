/39035453_3078641029049842_8418117438734876936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkV-CqlzTakQ7kNvwGdILML&_nc_oc=AdrKbmndbcM8zzybIgesEEyqvWp-cnxVSx8PZwS390iT_UOgTlK0DI0XBb1z7JFSoGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6TVfYnTDfV2RaU-O-OQvur7Sf7RT7z3zKNcModmcIIA&oe=6B0DC569"}, {"file_name": "ry1.png", "id": "921950635369973", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974877_921950638703306_2023399575315261676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYdSQ9ef248Q7kNvwH7LdXP&_nc_oc=Adoyqh0xQC5nIT6JIQj61RkFfl-HZLV1j4oZHuS1fR8cLdXkZSbx0R3xIgR4rrc4Ctw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNjDGmwjrBKPeEUUn0mjs7jbfntzwulq85LeI6n8kWUA&oe=6B0DA266"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTMgLvJ9ciEQ7kNvwH5dru6&_nc_oc=AdogzAwPMeUddy47fl9Pb-G-X_S3Rs-_PhrS1b56uxNPeaE8nvWezv8deQhk8cedZLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTudXzSJBc0ZyhChAmf_YDkVrJ6iusGVhaN8U3HXgdgzA&oe=6B0DB2D2"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQXuBJzNyIYQ7kNvwGvrWTa&_nc_oc=Adpv79C_S64YQCmEMClfldP9P_GFSQGn4VTF1KP_G4zV5IZBk_DaCH2GM17mXz0Vauk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJMFr8ahAmgB3Skamz7WijfagLtnjVuAnppyguBv6aGg&oe=6B0DAF23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwb_yBU1j78Q7kNvwGAz03B&_nc_oc=AdqItOB50Bp_RWZYmMNST1ghxsXTT3OviiS6XvIhJgFFO87IovYic7LZDRPhmZAXvAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30
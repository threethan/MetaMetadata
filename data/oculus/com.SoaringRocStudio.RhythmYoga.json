IW6ndYYpIPCgmwD9-UWpTrJ0w&oe=69DF82A6"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jaGE2Qh2YQ7kNvwEKkrt7&_nc_oc=AdpSde5QvYSHXwFfxXnL6xD0dVsTOJKzeUH_EAWLmZWJNvSDaPiRKvTGqVoTgpymai0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02pPYrLN1USNbxP5OOr007Dse0BxLk_VYEoZ_n6hxllQ&oe=69DF9312"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xBAO-UCxGcQ7kNvwEvYE6-&_nc_oc=Adpx9x6gMHK-XovHFF29h6P5kYOy0YFqVKae1Mn5h_UCerWQjGE_HTuqqaE2y2opGgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_NJ2dEV0-9QWaob0gQna5ZnkYqKjNhs8CmP8KHDSY5g&oe=69DF8F63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "supp
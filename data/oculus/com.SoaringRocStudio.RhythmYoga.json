952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7izmUeY-UYQ7kNvwH5gOZj&_nc_oc=AdmdpYh03vaNG8C-GsQUWbrZvvizk2gUlNOuzcqzecnzduoWzw0b8Yj7yr-Nq58yVtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNjDCLr7Uvbr9MBRe0upNwKbgyNJgka-JBGPLzYnlZnw&oe=69BFEF12"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9qifwbOL6cQ7kNvwGdQw-H&_nc_oc=AdksLYu_b-al8wLHq3U7fOdNeTol92azO1g0jCbPMEiJhkBmt3fAYcFF5HfbrjKpjQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIyCxaGi0RipDVPUiSsq2pMnDpYqi-c46skP4XxRAqnQ&oe=69BFEB63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2
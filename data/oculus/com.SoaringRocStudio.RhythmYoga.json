ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-8fpKvN_wvAf_kTbtEv7GIzBf0Sv3dEDh4NzMMQSfBg&oe=6AF9C6A9"}, {"file_name": "ry1.png", "id": "921950635369973", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974877_921950638703306_2023399575315261676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1H6UsoPKLUQ7kNvwFlLEpy&_nc_oc=AdpNN8LaamG8oU8rc7B1S0EhlvSC3K8-eD2WR2UTGvmjkpRhqTcY0qN4cBkp5Dvfssk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxHkEEpoB-n7hwv5MIjPnegKSMXu_Y8SfPcc-umB-daA&oe=6AF9DBE6"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYO6IaujtUYQ7kNvwGP_9n2&_nc_oc=AdrmFG-gC1gJ6OvYFRmh5gaXGoV9u_TnjyubEemLSTnOsGdjdqi2rwZuGlllfOURt5c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUVzbY3wPl7192TiQyJfMjd-ADiof_tmSP6LubhQMiKA&oe=6AF9EC52"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1KuouRj4rEQ7kNvwF7syae&_nc_oc=AdoHJgvRAWftO1mo1F9Iak_xySrD7Ig-CCg-Vq9ux58Ncm4p5HrLZPEfi0C-NIzpkzI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvCmTa7BcoLwh1XmUA3V1j5vTBX8D7DMem71CAIyLfpA&oe=6AF9E8A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceXmOD-4BnwQ7kNvwGWtAXv&_nc_oc=AdoUNTSGdwsRVuUIU221Ln79J22wvORiPzJtRHPI2it9LFsVTF7jJTTbiiE0CulRCMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzsVYHme2iZGr4l2PHvuHcCjSGeFlCXkdXTOtzNcd76A&oe=6AF9CEBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Yoga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "16725773968
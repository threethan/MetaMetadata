/39035453_3078641029049842_8418117438734876936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQbPFXpagyoQ7kNvwG2y1dG&_nc_oc=AdpNerpXo1z_YKcaDB9ojDWGcdipEZT8sjicnWy9_hr_2pqF4xnj8XwB1OHFXfhOhcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR0p8WmW78XsJp_OdhQQPdbuIXCXl9WyvKx9z-c6XOrA&oe=6AFDBB29"}, {"file_name": "ry1.png", "id": "921950635369973", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974877_921950638703306_2023399575315261676_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlgA99NsbwsQ7kNvwH1d0N9&_nc_oc=AdoGre_ewWBoZ66PK_cGAOS5EFbQDknkYrYoEsGdZhV4PBr55-VGkt1RDIBarIkWyt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwiqKX1FoDE5lP07wodZu5-IFyW4cFFSX_sCRDsxLWtg&oe=6AFDD066"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_UL1JOo5-EQ7kNvwHsQW39&_nc_oc=AdrrUFynAHeIYrTp6QkRe81QWbEYIyzRe6MiZuzdMNDvXxjxm-Lz3F-gCJnMqBO5XiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCcNFcQZnWBFakXAEBdFeseGxxTAZ-6CWVNMOPsW1R0w&oe=6AFDE0D2"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkFerHCv_dkQ7kNvwHqRbvw&_nc_oc=Adqxqx134uDcuqM7m-d3lL7QDA5j_exP8dNawFWnbpnDryCLvpVz90aHQ5znn1SGoys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5FfSjRIOq8fYhQaxpoft-JkXPnp9ebRCEGUmU98iJGA&oe=6AFDDD23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBwQy8JS_xQQ7kNvwGIAhz0&_nc_oc=AdrdU3LzhprFpK1HZ2e-JZf4vUyCmmRDofqrrai9KNcAQpXACL7KhXVQ24h2fk7jTCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20
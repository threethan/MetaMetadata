23399575315261676_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1C0xCMl2aEQ7kNvwGq3MYI&_nc_oc=AdqjF0b0-xhR2cTnbqE9k_H818giVMkjw5PzN8OtdnHY8PRSSqgWb-6xXcqiAZn3CnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vLsUS1lKBOu2x_ffRxUwk0z7H88JFMEvqvPThpxuvEA&oe=69F88F26"}, {"file_name": "ry3.png", "id": "1079952596080463", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982484_1079952599413796_611171385511283369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S---glTg-UQ7kNvwG0sKqh&_nc_oc=AdpSpp3YDYmDdcgUglwtWqZQ7TzNkeKV1Zhed0ADOw6Q4pUnJxQLoc6o6ZQFg7iNQdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RbFPrFet5brbLCs5bqnzyCFyYrIEYt_vEtvn1Kpp9gw&oe=69F89F92"}, {"file_name": "ry4.png", "id": "438696171008045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035304_438696174341378_7195065161313210474_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XocThmDZdpAQ7kNvwGrCaKl&_nc_oc=AdoVZYQUx1n8B7KJ9YOlcXjR7mNcdvF4I9amrimUeUA2DB3euFutWESsT_KwjlRb6Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fZ4F1bk4BF2jpMdpgkATDhnehBdDspU1S_PI8MoJP1w&oe=69F89BE3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhythm Yoga", "keywords": [], "long_description": "Let the virtual guide take you through a variety of classic yoga routines and relax your body in a fun, rhythm-based environment. Select from our catalog of calming music or even use your own beats!\n\n- Go through simple guided routines that change every time. No two sessions will be the same!\n\n- Use your own music! Simply drop your favorite MP3 files (even organized into folders if you wish) into your device's Music folder and you can relax to automatically generated routines based on your tastes\n\n- Challenge yourself! Each session is given a simple grade based on how well you follow along. Use that to motivate yourself each time or even for bragging rights among friends!", "short_description": "Hit yoga poses to the beat of the music, including your own!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.soaringrocstudio.net/rhythm-yoga-policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "RELAXATION_MEDITATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4497617800364123"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86840885_1303507486771187_7986329620067712463_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbem3zpICzYQ7kNvwERJ0AI&_nc_oc=AdqrnCRDNP_ImGSu0QjTupfuMgXw9dYAZ8aoxvIwh9H9WsePJamHgndobothn9T9rAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jarxZK69Sfhta2eIzgPhY23xJa_trAVSXcDIhRgpJtA&oe=69F8BA3A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm Yoga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1640110557, "lastRevision": {"nodes": [{"id": "438282087628198", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4194548443987290", "is_firs
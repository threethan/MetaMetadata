64.5771-25/491825257_1672873021225496_2584829794827052785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCF4Ah0eqocQ7kNvwFeGmbO&_nc_oc=Adok7gy5Dk-zDLqiEvhidQACTVQWlteOqOD1lSY2HJ0XOnHwRpfDv7eLoZtDejFx_nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRthiGmQl9N8UJ6T2PzGT8hegqyMc6zj1FQVjr_H0S7ww&oe=6AF72D3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1109587654982631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1109587661649297_3473518958900578560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDPJfAW3TscQ7kNvwE7YRIC&_nc_oc=AdoL-UOXcU_EZRVXYRnnypdd4FFp9s3M4LXE5PifbKRQJ3fetBy2in4ztzJtm4Rt_m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ds9fjGso_CytYODsAxHORgUKR-2JMXME2tQDIaH83g&oe=6AF74287"}, "display_name": "Police Simulator Highway", "keywords": ["police", "patrol", "highway", "simulator", "driving"], "long_description": "Your shift starts now.\n\nTHE CRUISER\nA real patrol-car interior built for VR: steering wheel, working gauges, radar head, light bar and siren switches, and an MDT laptop on the console. Grip the wheel with your own hands or drive with the sticks.\n\nINTERSTATE 7\nFree patrol on a highway loop through Cedar Valley with traffic, ramps, overpasses and shoulders - at noon, at dusk and after dark with the strobes lighting the road.\n\nTRAFFIC STOPS\nThe radar clocks every car ahead. Pull in behind, hit the lights, and the driver pulls to the shoulder. Step out, walk up to the window, talk to the driver, take the licence and run the plate on the MDT. Warn them, write the ticket, or make the arrest.\n\nPURSUITS AND FELONY STOPS\nSome drivers run. Stay on them with the siren going until they give up, then order them out, hands up, on their knees, and cuff them.\n\nSHOTS FIRED\nDispatch sends you to armed suspects on the shoulder, and some stops turn dangerous. Draw from the circle menu and defend yourself.\n\nYOUR PARTNER\nA partner rides with you, calls out the radar, covers you on a stop, and keeps up small talk between calls.\n\nA CAREER\nEight missions from a first speeder to armed-and-dangerous, a score for every stop, and a night shift that pays more.", "short_description": "Work a highway patrol shift from the driver's seat of your cruiser. Clock speeders on the radar, light them up, walk up to the window and run their licence. Chase runners, make felony stops, book arrests and answer dispatch calls on Interstate 7 - by day and by night - with a partner beside you who talks the whole shift."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/policesimulatorhighway/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/policesimulatorhighway/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382145951648607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_1608278260764248_197537118389420519_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oImGcZZw90Q7kNvwFUs0j2&_nc_oc=AdqQp5qs0cWiUQahelY_6noAHb7WUVcLo1VazYrfFQ2zg8tMbFfP5f4xGuX2h8gR-_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oc
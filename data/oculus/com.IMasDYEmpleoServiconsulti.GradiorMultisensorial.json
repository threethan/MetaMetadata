7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nv3ROee_M0Q7kNvwEVtO0C&_nc_oc=AdpZCoX6_f9aql4806acVr6_kRix-T0swJRF1z4v7KCqWC9WDXAB-U44Hg4wa9hTyKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7cMBB5CkQi9OP2FBiX44bLCUkKYBQfKXmbZ7pQQTIlA&oe=6B09B439"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9g_W58lmK6QQ7kNvwF3k67y&_nc_oc=AdoqD5UxxcVxBBrL_F5F_qfNPFYfQtAnbMaPc2Rsr4cg_bIowSxEOnvdbw32jP3j7gc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBX30bJz3AD9h2OYMPT9bC3OoitVUFQohCL3G6hYL9_A&oe=6B09C929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmAD-4l2hP4Q7kNvwH2DqgD&_nc_oc=Ado8iXayufFJ9emdQyMMOOgEotTQ-4xx5gJbwjabXxl-_t8OYzyQPsr4fKZQGrJDpl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqC_lAPu24O4xMZ24OwW49XeEVzUd044lHZSoaMYLb9Q&oe=6B09A2C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
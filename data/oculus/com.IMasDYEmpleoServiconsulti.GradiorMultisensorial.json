7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igMRi8lHArgQ7kNvwFHejdC&_nc_oc=AdpHyGa97Fpp4jg1W2j8l24UkUHfU8quINEjN7T3QK9Pwhb_jwvpGapJ1O_rmcVN_2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcTbIws2W2jZ_dJ09VZ6goKJg00Lqb-xZtGhT4MI0Urg&oe=6B031CB9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80FIdWjWUwIQ7kNvwF8zshF&_nc_oc=Adq848h24FYhgxowCpUwl58k1Qq1Bu0Sp0eW4BuIFAAYVu61ubpo9lJUgyofZht4Zmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb-90J0gTmxDdMO_51ukEy4uk55-T4egSWuoZyPTgZbw&oe=6B0331A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3YYCNulYj8Q7kNvwEYIlF6&_nc_oc=Adr1EEEVPG4kC8bCCtKtUfDvVLfyd4zkiVMZyEYqhslYMnezabIExgg_KtSLMNTcYXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQypU_giyunssCdWDGOyxgLWzuyI4zUBBNoDCUEv_wyyw&oe=6B030B44"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
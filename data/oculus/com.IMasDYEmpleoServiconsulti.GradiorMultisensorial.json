ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t5sS53qtNoQ7kNvwEuow9A&_nc_oc=Adr9c46hBM7RZHF7-sf3kfQfwz3-_sjPw2jKRaLJax_AJ42W_SRzNoMLnQysCsJpuo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgdIFP-5RCE-KTjQCQB2y8XNt-a5wV2YL7SLAOjD2-lA&oe=6AE749E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_0pqjwCjboQ7kNvwEVR43G&_nc_oc=Adqw_bazx-wt7GUSDXw0GUfjcC-bbPnCOzlz89tQ53as9w5YLUNbZN84M_dv8yBuZRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6QdB-SWM7f8Fk6nGim9xMDQAT0vZPtI1KiLfN7u5chw&oe=6AE75BC4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-i
7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tokLjH_46hcQ7kNvwHAqWtn&_nc_oc=AdrRNeasdyRzu99idBiTdM99ZJ1BGqK0CVgDEn-Eg-pTfVSctZnm8EP0p9a6WsfBQ9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZeWD8jWRzmG3WZ4KiI0uFVJJHcY1rJyPH1a24jClcIw&oe=6B104BB9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHE9idFwdEAQ7kNvwF2zOkb&_nc_oc=Adr65jt-lWCjwKOQYYSK2qIz3OvY9_OLVtrPaDPoC6dUREb9AKrOn4fGlT5Z-VG6IvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6z_OrNeKTnP2E3ZV0jIwXZIEtJBHGVal8G6iEY39aKg&oe=6B1060A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL9xPNVe3ewQ7kNvwFS8mcJ&_nc_oc=AdryDLF1E8YL6oIuJBpc2YTUHj8UKwpHiojF-9xFis24d2gUK0dcj0LgrwwNeZ9xFPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmgFOAbbAIe611PN94PF0_JUVZVt2Eq77JOKQTkLVTiA&oe=6B103A44"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
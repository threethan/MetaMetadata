ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmySUNBjS0kQ7kNvwGMq8Xj&_nc_oc=Adra-eVQjW055Cp8Jp0CRftAWHwiz6aDBLJwTTF0OGS7zp6XEAZx6f1htZk580pXOs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MffgAYzx3BtqC51rcfD2ISeGYsBPtBZ5jRYPdIlgN7Q&oe=69E0EF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRiPqU_pMb8Q7kNvwEOOjjs&_nc_oc=AdrrehbURmsKB1RA7FOnMa9Y70ppxXyfjbeeSSFqM7pLSw_q3Dwck1aUXxNJMzjrkw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39fteEwkhn9MDC9WpGVThE0IwTwjfwnUtD--rZf95rdQ&oe=69E0C904"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-a
7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmpLlUuwa7IQ7kNvwHECw3h&_nc_oc=Adosb_ODKSnT-sKjC-sntUY72v4QoYtUnp6Yd97HKSuY4tR6_CtWXt1WHi_1IT1l2f0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTz6gQS3LXLx36Bk3EmGITS36olOo1VWYMhkHsbgL_Xyw&oe=6B0DA8B9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYiMXCtVg7wQ7kNvwH9otlt&_nc_oc=AdqgWJOELDQOr6uZ7XDm7Ag-pcXY693WxT1GUu5EiMvzBHvPMl3yN0NyyvLzByu4t3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDXm8yowAjnsNtBee_mlRWJsu1fn2Zzad5y0wCNZTg4w&oe=6B0DBDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhwQcsCMIIgQ7kNvwHkValW&_nc_oc=AdrIKVdHLSe9EaJl-q4exz435zIATCZ1HHy80-O10hh5tbiJ_CPqo9Mk45k9Lx_UYKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1V2285tvSii6bZEW4DCJ91IXHNzRIP1_WRyVfzXu6kw&oe=6B0DCF84"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
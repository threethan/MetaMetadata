ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Atd7gr7GpIQ7kNvwFzQkV0&_nc_oc=Adpoh8_0GXqv-BryzDcDa_4Af2qY4C1jxnGlRz0reOwv-QT2-8YuVZ0wrWQLTi9lmO0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YTYFEM-YHSt4ZDwyvMEpFAjVO4qSrjFy9CTVTtIGbbA&oe=69FDF069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIa7cVvsauQQ7kNvwF4uSGs&_nc_oc=Ado8Llmlaf4-dui1hHq6apuUmNn7RMBGRP1AtiuhNTdIDPg6thIufH35_pgNj2T_iSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zt2SxSOe5xgdSmLBBPHtK4HqSijPuyB31zk90gse9aA&oe=69FE0244"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-d
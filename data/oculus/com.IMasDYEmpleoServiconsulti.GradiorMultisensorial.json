ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4e-zIlMGToQ7kNvwEylFb0&_nc_oc=AdqxzGgvhgQ48l3OLEhEKMLrGeceB2wCXDnYJ5VWqf_3ZwMfFWvFkcpuy2NfMCqU_6k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhkNSp6hxAf1MxvSiR35gZ1hTdl4sjmcDKA23G-JOK6w&oe=6A974EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isWfpiZm9kcQ7kNvwH7emlk&_nc_oc=Adr9aJZGqgL2ohh6FIO4DJ48d2SnR7UnStsV1GR2PcivQdDELlIaWFdR-VbkfV6OUas&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2qcmwm_zprYr-wPe-Af59ZJC2rIAmS9dAlf4OIX3LLA&oe=6A972884"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-q
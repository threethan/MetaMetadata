7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igMRi8lHArgQ7kNvwHnsogJ&_nc_oc=AdpUlXgtNktn8ENr-Q6OeIHoW9Gir_OLv0qT0m3ipzwHgGRw5j_0sGn_CBaaX8_Ku6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu62xtLgUwr06YOuBxUM5PqA6eQqWrSYsfnKyyRIDApA&oe=6B01CB39"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80FIdWjWUwIQ7kNvwEziyr7&_nc_oc=Adpk55zQlvzwch_WgR3fr5t_49NDXKAOGLGZrvP8EuE_0kn_PsYBEBJxmjP6jnhY7B8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6PYwKeEiliJ68Nro2vCrp-3QLQq3VrqxKpWP61FSRRA&oe=6B01E029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6x0V0ORgH8Q7kNvwFYUBk8&_nc_oc=Adp8W0TG0-rSC7czq1LZDhE9I7xHo-L3sB_v6B8Khe_w4YnIW6VsBJeq5RjSJLMQzQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR5VRRHkcZTCJG8_Y_altnlDuF4kGVwG_ueTaIht9KxQ&oe=6B01B9C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
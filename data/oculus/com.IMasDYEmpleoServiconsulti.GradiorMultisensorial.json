92EF9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79MwjYYEFdMQ7kNvwFDg5bc&_nc_oc=Adoeim0Xg5bg7l0I1E-Ppo4g_gATDkMGGd8tgRFzqru1rbsINgNRdQkOU64AXmMqw4U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__2O7EK-ddrDrTzAJg338Ar1Iq9Fx45jNGp3nhQ0cdgQ&oe=6A3943E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfUDr8J_LVIQ7kNvwFVm6ON&_nc_oc=AdoEbGzxg2HihNxGrkLyC9_HwvlHFDV51MqPGY8CWhRYpzKFqJoUtCEly22XdDvOr40&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0jEVbnVijKc59B8hHOWTSGr-T5CNPDNXu6am7Ix3ngw&oe=6A3955C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "ht
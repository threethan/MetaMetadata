38956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR-X_OO9XvQQ7kNvwGZQlpV&_nc_oc=Adpw4Jg_Gv2yZZv1lTN_C2g9zPEL0iGoTiW-07IX6IrhDCqZFStn5Dg3lLjQAwJFq_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2LQrud8pzQC-gjVZq04iHSKhMStKXHReAR7l0YcO5hEg&oe=69F0C169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEcP1iq5OwIQ7kNvwGHUOSt&_nc_oc=AdoaKjYFW7GR4pZakGrZgyHfI1AZc_WcrGt06XuzfMIQE035Tz_mHP5TSUSfV34q9tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af33GkQAOJ_D3HrHtvPFazvq3kZpJFWLmhYA2zNiVFQIHQ&oe=69F09B04"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035425_5570991519618067_7496178075557269886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCmJAiE1MNcQ7kNvwHdTrmS&_nc_oc=Adq1O9DI3_Br9GxLS0kc0e
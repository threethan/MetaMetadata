7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmpLlUuwa7IQ7kNvwGDqN3m&_nc_oc=AdreGP8bAY9NYjcA7REy64O_mm1C7qFy7wBR4CxRyxvFphPrjUhCacQvkYv_NCyPmHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTt6o68JZTh60SMPRBz2ztABxwTI0G-WvvmtMq3GzDKZA&oe=6B0C5739"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYiMXCtVg7wQ7kNvwF1k-DO&_nc_oc=AdqmoFzxsCejuKG788fvQkrMhLgnThi02kBFagpFvs2bSTYCkSrsHbpBiAvzIgn_CEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAC5Qr-krVs0_ThiwS97EK_MrAzCzHCsn4FCNPfA23Ww&oe=6B0C6C29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhwQcsCMIIgQ7kNvwGlVy3-&_nc_oc=Adry4wcUAdmfkyQkhYuXq8NSvTjPhouW6vVSVs52g_nv5wx2F3u9MsywiF-0VybtEzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoS3cqmJIUSaZVlJiqiZ01gRtEKfA8lRlBVhzaEG-1TA&oe=6B0C7E04"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
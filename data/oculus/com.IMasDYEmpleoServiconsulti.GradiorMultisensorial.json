1A1F9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a170Gy4vyyEQ7kNvwHNGtjE&_nc_oc=AdqqCzld1fJvOBS3GPfSgz65ysrIWeEeOVc0ofKfFZTs10gqM_8BFDmqrFzmSRDLKSw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YqEjyne2Hmrxz7gvNafNXBcYusEeuRLpiqbEoEoATOA&oe=6A11B6E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEeJ0dJ-95EQ7kNvwFcN4a_&_nc_oc=Adpw5dPvw5XzjDRgFS-poc8OJkLBoTq9FlwuPd2uSkKWXZzKBWBysq2nA-ff9LfEBoc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KlmIHGcLpJ1d1OMhZ28_sJuQCAstgdGbqG8QJ8RKAXA&oe=6A11C8C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "ht
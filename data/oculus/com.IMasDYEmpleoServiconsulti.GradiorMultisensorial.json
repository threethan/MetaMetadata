7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QViwFiO5LyUQ7kNvwGt5Uiu&_nc_oc=Ado2x8ak_n_09T1rOkwM6rYsjdUqiapiz6i2VjIiZ7WFNJ1FfUqNuIfoABIWEJSIhz8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbq_tOlLqAciYH2gAf-dWDT1I4ZMtQw4JpupIG3NBQ6w&oe=6AFB33B9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN9abgGcgMcQ7kNvwG4roDV&_nc_oc=AdrGyjYjpxpm2KtB68oHw26jhUTLrbOUt2Vn9OPKALx5nrnK4gbkCSjeJxlgGR91GH0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTPNgtaPcRHUSNU98HTc5CIXVOE1QJQuI2qz1ybHjm8w&oe=6AFB48A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy6MHAisPeQQ7kNvwHfps1B&_nc_oc=Adovk06FIix4RTE2JO1UqyG3qop_dyADIT_J7tHlWvp7hGB3TI_iMv3qTvh-1iyzs8Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOzaErxxeP-4gcM_EeIwRlD0rPqnAhn-CrsiXrw0NHuw&oe=6AFB2244"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
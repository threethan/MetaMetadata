ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TXKQ9f4BeUQ7kNvwHdXwO5&_nc_oc=AdqswJmzUwh6TXH8I-z-y6f3oRAhzEU_wxj3zCL_Zn1j_t1A6D9ELp7P_ThOXOyN3Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwH4AmGl8SadKJAHjw7Kef1CgfhnPqgXp42zsoLXyv4g&oe=6ABE6B69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdaRw0mPz5YQ7kNvwGam-F_&_nc_oc=Adpn0qaXDKGD52lOs_woW9p6M6ZkDRr1XzeJYwgoIkQtgy1u1Mp98ZMD3nRkcxim1Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKfYn8QUzHk_Pss8KzHu1OaNnZ9T8YsDy8sUSbWWPMmw&oe=6ABE7D44"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-s
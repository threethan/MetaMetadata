ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbcIvOrtJNwQ7kNvwHdQtkv&_nc_oc=Adpi0xylNQAIhuyA2cf9972cRqqzljq7bFDYSDfTIBgVBIZbzwt57y6xKsFMy3EiK4M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa5bl-CeJtVOnovy6yLj8VTzlQhbp_5k5fdQ29P-I39g&oe=6AA16A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1bwmGjkCXcQ7kNvwG5inP2&_nc_oc=AdplI3RKk2WC1WJYZA72aZwYSJuK0LASr0ZAEeDEVRGTYQ7XY4N7FGRmc1QC6gP3ts8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuR30VAn_2E7iTRbFyKfqXUiL2y15KuMXZGGA7JRaoQg&oe=6AA17C44"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-l
ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN9abgGcgMcQ7kNvwGYHQHa&_nc_oc=AdoxhkcuSyTI9N19ferlSi5jWRhfa41j8Bskj0tPuv0RXMbh_O81AuWpQKY6yaHdkvk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfrcvaGUy55bZSm700KBnCImF2b9B_MX_woVJ9YM2nzg&oe=6AF9BEE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zprN7CdPjnQQ7kNvwHqT1lD&_nc_oc=Adp7g_XnUG4aI5AC7-vF4HjL2PUEQboNsoNEeNIzWeXQSPUKggm1XG6P83yG4nTOu_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0XfXvBkfd-7vrYeW4i-vbVEtb65o40tvT1yRcL7a5Sw&oe=6AF9D0C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-d
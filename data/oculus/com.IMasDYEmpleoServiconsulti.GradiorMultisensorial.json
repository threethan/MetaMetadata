7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7YSR7QE_PQQ7kNvwH3bPSS&_nc_oc=AdqgdsDPwcpaLeAtT46II6k5_gf43nIgKYi3euPLGRio_D6CFody50e_EQXHG6tOanQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9-8viV4d5uLNtpyVkkx6wm9WFYMDT0mDH5_H_GrWCGw&oe=6AFC8539"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5wcEs2CZeAQ7kNvwHchmcu&_nc_oc=AdrNzOK9cRhoK2t1mYp-z8dhC_lTDN7dtOIwQ7YyJUYqIpWGun-f6Ho3RkNXwBtxMNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi-nQM_t94_bmKoYEZL6K0SudtNpoUJkBm9OaLGshEVw&oe=6AFC61E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy6MHAisPeQQ7kNvwEAwP9v&_nc_oc=Ado-858oRbRtDNKxeNOymYr53L1KHJ0chN-jPfv8UQqn-Z8ZlfAqKfHOnfpycPaardw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfZVFAuv1kCxsxhdn3UTOAOIKiKWhC9tf0QlxJzvRG3A&oe=6AFC73C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
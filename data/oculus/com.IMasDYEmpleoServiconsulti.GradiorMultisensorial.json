ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxkPvWaxGOcQ7kNvwEOfSub&_nc_oc=AdolXJv3FzJ8EX4eQ8Nma5k-zfvCrYaJ0-YhjfT38Y5ZGQ69FYJUqmJokLe2nRVP3DE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jwsfd3a5QTKKHu1TM7V1BIeANZnXW-5ZMMlVpbikxBw&oe=69D26EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXhXlZqDUqcQ7kNvwHwTALq&_nc_oc=Adr8xRhX7eQqI5h4NELGi1WSFnL4Qotfv8WAOwOZ1OJA_tevbt-cN0oB9KloZ3bcZBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OlA-v0JZkcBWqMS0DxHfLg5MAs3Zy2VhJvoQutgPFlw&oe=69D24884"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-a
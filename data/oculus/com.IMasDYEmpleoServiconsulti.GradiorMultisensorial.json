ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmySUNBjS0kQ7kNvwEEsVyd&_nc_oc=AdpyIZnefmETWxIpOLGWYxQP7TOlw83vSB04apfcsAmMqjrPecFEtqceayHNJ0g9IFc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25JaIWNDh_R_KqFgCbVhuaOOuan8LFCpAd7Sl7dfrTag&oe=69E240E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXuszwd50q4Q7kNvwG04ySL&_nc_oc=Adpx0RQkU5YE66Ee5OSfZ05ek1DQ4cp-lQkuB8vMkv2W1AbWvA29ZYkuir5ISnyhANY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_VdXZ6zFFvo2P0ZOMMqnQ29UYCu6nK6yqLefr_SHJtw&oe=69E21A84"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-l
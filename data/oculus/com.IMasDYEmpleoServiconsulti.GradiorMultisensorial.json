7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kaJFCzfrjcQ7kNvwEFOeRh&_nc_oc=AdodcIEOEG7nJPC_pbnz0fcQ1r4_A_QedLd88Pig5TmCGKV8EGcGNC21jGGDJBmU3tg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM3-KRCMF24Pn_KvCvcHIJnGk6yjJkYTafvcQx2ZHShg&oe=6B05BFB9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw5guuvRRyoQ7kNvwFzRny6&_nc_oc=AdpTVkJfPVS-DCIQGV70zA3Hcuzmm6QflrE1-JK_epvHJEeOt0YAl1JQ8wfzmEv1frs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbhXlmiDBw1C0qJBgbVgIaPbYQLYZxY2dPjRFzpd7DLw&oe=6B05D4A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3YYCNulYj8Q7kNvwHloyQs&_nc_oc=AdpiyaoylAnPjd1YsUK_sDd0_QYHaaVnwzDuQ7QEft8zzsv-MEBZgXoJJgP1WdJD2G4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-V1GbOngcxp31XbHBO-L3uwbWRA9Oajv1RqPhFpfw0g&oe=6B05AE44"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
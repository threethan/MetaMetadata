7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kaJFCzfrjcQ7kNvwG-_ljI&_nc_oc=AdpYjdELukyl5W8QilWIV3iOkW6jeX2xMjfylRcldGF1S6P-6NCQ13ZoudR8D9hWLsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi4TcFJ6jzYMNcrBpBm04pOuHIi2xa55uc9_v7gc7apg&oe=6B071139"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw5guuvRRyoQ7kNvwFtPa3X&_nc_oc=AdrV2AEcyhXEW-Idsx2kpR-oj90AcL-WGptwSLn8nP-2ZY7xpOKnKiIu8bEgOtR3Tyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyt6dKyUvukcilRGEJUcE2LF3Oi-cE8LNIZQWyuU_a8Q&oe=6B072629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmAD-4l2hP4Q7kNvwH8vC7j&_nc_oc=Adpsl1Z2pC3ELJCOLscfEIYGbrvwVwxwGrmaEeqX5CBnC9kpGNqsDJ68TLy-fdJSDug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK7N7IDNmvS21AfcEXTc2nbSyTOWLKSLFwQg03F26s2A&oe=6B06FFC4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
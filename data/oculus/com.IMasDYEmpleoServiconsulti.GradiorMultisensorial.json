D8EF9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwsk9SOUwLcQ7kNvwEzY2X4&_nc_oc=AdpQKJuOx16YspD4kEl8Cc0i9e8myd2VJsPW3sCGFKHnald1fXDIgYF6B60gDn_PYH4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9Y6mJnoJu77Wbb6lPtdivr_yV3YB4NHTypj_FrHQ_lw&oe=6A8D6BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBdJjGLvt-QQ7kNvwE-mg9R&_nc_oc=AdryKAkHDUeyrmgbwn5qVuT5_kvGu8FfqLa6h2jMvTo4sYeIVgLg37XfPeYgPzCw4oE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCwjKMV_9U67jn2A6NNkCmSw-iKnfqxroITgc8BWjj8w&oe=6A8D7D84"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "http
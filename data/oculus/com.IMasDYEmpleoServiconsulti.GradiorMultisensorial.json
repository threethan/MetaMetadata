ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MppdGXxSBfoQ7kNvwGe4nyC&_nc_oc=AdpN3vLdjptFAvtKmo8YByTVwY4QrAb_kgdcJhYFtIzlvd7Ma_PeoM3qPuOjDbAug80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mSH4IWMoEr_rHCxhIlXRSuZhVN6cu1aMJkFX37TTiPA&oe=69E8D869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFC94ZcfzdwQ7kNvwGJMd8J&_nc_oc=Adr-VEA04j_8Dgdr-pOF-zILZv441_nX-TkZoJKhkRHa3zJNn1ehbvGZxOHnqnexwDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CNi90Txf2Njk57YDk-rFg3vOgpN2soch93Xbnu1iHuA&oe=69E8B204"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-s
ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9MItDmuqCcQ7kNvwGx6PBq&_nc_oc=AdpOz8Jv5O9k1xDcm9LKSsKvXDx-C18GJH_KJTYXcbWlsYTJVValH3SagUJULHzQipE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI-TYpLTIQBBWSSU0Tx-vhj4i7qZf1rp35NWWxaDcaCg&oe=6AD3BBA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wK1ALnOWW4Q7kNvwHTkrFy&_nc_oc=Ado3UCHAWbCN9Lg5Pw5ApVbjjILSH32AiUlaDfVhhGYYYi7pbK0s8Vy7ABxRn4YaZEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnGSU4d2G-AwEGvRCZU0ZTIKuiltY4fcnNgGqVuKx0ig&oe=6AD39544"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-d
7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7YSR7QE_PQQ7kNvwE73WN7&_nc_oc=AdojNvMHn4bihtxLhwjzSYyVyzsZnrL8XiRATNWRbi1zfWcpwyFNttPlqJOQmvDpaB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR2YLSeUghaKDc6c5zlsaSVMUVSsHNM64MoSQHZtsv-w&oe=6AFDD6B9"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5wcEs2CZeAQ7kNvwGEp7g8&_nc_oc=AdrrTiEuIdxqpQpx16Oh-SfNtiMhAQA-UdHIt3MVwEiW-efi95zuGFzcJ_mx3yLDGnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQok0GHfKPxxfiJTQfRg0VKhwTFpy1NpN4KluTMb3jgpA&oe=6AFDB369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy6MHAisPeQQ7kNvwG9mEII&_nc_oc=AdqbjSFU7gtYPWTfD-EXafamFJAfwbwgQ7ozb_Eufu6m3NZb2BnmFIfk5giFnklAi1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFkINufrdmZsRohIyXxDgB3F7HFuv8PBhJhg4ksaae-Q&oe=6AFDC544"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
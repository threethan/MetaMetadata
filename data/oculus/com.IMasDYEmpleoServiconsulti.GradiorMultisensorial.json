7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7YSR7QE_PQQ7kNvwHeoKsq&_nc_oc=Ado86zW-72RnUxzx2uzhsmv7zaUpx4lJSnU_IITpO2v5ESxqZq56BRIpg39d9ABYrig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNSAPnGT3k0jYwxOcHODuP5N-ZsTXAbX3GU4iJYJ8GCg&oe=6AFF2839"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5wcEs2CZeAQ7kNvwFbx5n2&_nc_oc=Adr0xaw2oR0_SZ4PfL__JHUSnoWZmBiGT-wpzOft7Y4dbu5uDizvQgOZ86FtDsb2boo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNOcgnbmZhA5tAcig6oliAXzVzCLwx6I_WPnDdW_zUWQ&oe=6AFF04E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6x0V0ORgH8Q7kNvwGUVJrx&_nc_oc=AdqZz6BNkQHXIGCT9AwMNilfg5u_iXNEQ9HQf0GJz-Uc8QXX5_-SzZrTJgrSuikOL1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD7zu-9oxGepRMnKWe4Wphc2Ci0_qahMU353jqqt7aqA&oe=6AFF16C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
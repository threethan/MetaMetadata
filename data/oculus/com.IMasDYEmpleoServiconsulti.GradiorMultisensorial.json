ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKz-PDVZ4tYQ7kNvwGUhBQJ&_nc_oc=Adqchnx5iOCcjlYiGUY32ddbTgn0AT6icf1lzu2h8m5UErWhjuU-mV5FNi5Wtw0nbvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T2acq7k8QsbHwdXhV5GcePzdPrVs04JmhuLcyxj4A3w&oe=69DE4C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRiPqU_pMb8Q7kNvwFeq2-n&_nc_oc=AdpLcDCIW2HOOC7asJCoaXEHcD0zW9E1SyiSC26UFU3BIJlxhzp8mN9Mjy7kq9AQj9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01yI8fJRc8ldOThQr9PlJQWZo4bBCiLsAjH5ZSN4z3bQ&oe=69DE2604"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-a
ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o441ipzHdKAQ7kNvwEEOU8x&_nc_oc=AdrvaHoI7reaMsCqzF59XTXWqZBQ13p_gkYLzDCbl-3i-2Qn4RudPOL5p89XOceYxRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4TJUiQOjOaFe41ENi7ca-QR9bQp0JyFvqCZyjNEKNXQ&oe=6AB68269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xk5J1hhIAmoQ7kNvwG7nkfm&_nc_oc=Ado4QOAsJ_OwG193Vgz6g-6qE-PdmBbdMf2Jg8GNPJxcN-Myhi4vHtv6V-eaWek1v1s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX-9JOzDGTNL_Z6bmnyQK6uQ2VMX9gWWO_bEzAyRoqqQ&oe=6AB69444"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-s
7397077_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kaJFCzfrjcQ7kNvwGFcAOz&_nc_oc=Adop9kS4pmauBC1KTs_nuWDarYpw2H1kM6T0r03eInnsvf8aScn5eT3sLt-pcnOUovQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG_ZC1ft0TH9hBkfaC4EeN8ms4LoqSR2RXDF2Jw6zDfg&oe=6B046E39"}, {"file_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw5guuvRRyoQ7kNvwEstOxg&_nc_oc=Adqwsgg2eOr5cbyRMQ1PKq-dkfWd7a_swVqLrQW6EJq3UX2qpC77Hv3gNjVYAnBJNww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2iziaYf4xTHF2JDkFnN4D-k6WmcvVDFMffJ-M_8mp8w&oe=6B048329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3YYCNulYj8Q7kNvwEHO2Nj&_nc_oc=AdoGFEXCEkjZy0S-Veowq-mlL_SV_BJinn9u4EDh3uicq3BbYOduIhNgpsja2297xIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-uLmOwI7jDOT11EbzKDWsUqvCv16wdoDlu6vbsu4mbw&oe=6B045CC4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and beh
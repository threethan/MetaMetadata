ile_name": "Horizontal1.png", "id": "2012299192491541", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_2012299195824874_4779073699798838956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuQ4loK-VXUQ7kNvwGR5lbk&_nc_oc=AdoPS5xlAnKIdJii_F9vcNKBZd_xyMbW56GxRbb_5qbRV9uwW3gn_WbK7y5K3LUdOI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx1pxHHqxF81IInh7tH1Olo-M3Xl2zHqKxgMgVgsJwLw&oe=6AE203E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "3427671484224633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001717_3427671487557966_5472668227748834221_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1decgA-fD4Q7kNvwHQ4Leg&_nc_oc=AdoROJIBKOs53zVb95Xv5EsRUk86n91R_xthZf3JQ_Wn0is_NJ7u4wnop5jhd0oioYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME2JYS2VQfOjj3OER-MKukEv-d8gznZiYgVwXwGCGlag&oe=6AE215C4"}, "display_name": "Multisensory Gradior", "keywords": [], "long_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. It is a support tool for neuropsychological intervention whose ultimate goal is, through spontaneous interaction with immersive multisensory environments, to reduce anxiety states and behavioral disorders, promote self-control and concentration, as well as develop creative abilities. GRADIOR Multisensorial works on the sensory and psycho-affective dimension of people, contributing to improve their quality of life.", "short_description": "Interactive platform for multisensory stimulation therapies and behavioral therapies based on Virtual Reality with total immersion. \nThis app does not contain, display or access third party content.\nIt does not include advertising or in-app purchases."}, {"images": {"nodes": [{"file_name": "IcoGradiorSensorialEx_Barra_SinFondo.png", "id": "5570991516284734", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-s
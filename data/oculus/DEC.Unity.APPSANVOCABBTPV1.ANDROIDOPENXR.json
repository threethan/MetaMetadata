e provided by B\u00e2timent CFA Normandie.", "short_description": "A virtual reality application designed to introduce users to construction trades.\n\nThe scenarios are designed to help international learners develop their French or English language skills while discovering careers in the construction industry.\n\nUsers explore the equipment and tools commonly used on construction sites while learning essential technical vocabulary through immersive, practical situations.\n\nScenario topics are provided by B\u00e2timent CFA Normandie."}]}, "developer_name": "DEC Num\u00e9rique", "developer_privacy_policy_url": "https://decgroupe.com/cookie-policy-1", "developer_terms_of_service_url": null, "publisher_name": "DEC", "support_website_url": "https://decgroupe.com/contact/ticket/new/technical", "website_url": "https://decgroupe.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28988810237413661"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1897290981243959_7228484537683038452_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xztP4XNwgkQ7kNvwHbEMdz&_nc_oc=AdpcmxLLC64p5ZkWvRotiKwGbbsTxNXxxw0IrNDTVquFd50uz8l05VkWFOXl_Tc4NTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4TvPulOhFFTJIyUFfoB74NMKbgq3Hd7z95OSb2jMmOg&oe=6AF72
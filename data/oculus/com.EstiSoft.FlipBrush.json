Aww_3Yz8VRWyFZNPZ-3AxCW21A7SU2feZ8ixJLXTeitw&oe=6A6F35A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-12 112101.png", "id": "3907428042858460", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982463_3907428046191793_3803245053037493726_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT6GmSNXhjEQ7kNvwG3O5Cv&_nc_oc=AdpLU79oUAbIM9d8PVTko0MxW36fYawdXt_aWOR4QqWoeHSoazJj3s3kOUyMzYLVpfI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwDvywkaoZEg_HBmnxpwqhPMeWm7QZAUyN3HqDxs-r6w&oe=6A6F4D07"}, "display_name": "Flip Brush", "keywords": ["Comfort", "HyperCasual", "Paint", "Art", "Brilliant"], "long_description": "Step into the world of \"Flip Brush,\" where creativity meets action in an exhilarating VR experience. This game puts you in control of a dynamic brush that flips, jumps, and twists through virtual canvases with each trigger pull. \"Flip Brush\" isn\u2019t just a painting game; it\u2019s a new way to explore art in motion. As you progress through levels, unlock vibrant colors, varied brush effects, and unique techniques that push your skills and creativity further..\n\n\"Flip Brush\" adapts to all player skill levels, whether you're a casual gamer seeking fun or an artist looking to craft complex visuals. The immersive environments are designed to enhance your journey, from surreal landscapes to challenging obstacles. Experiment with a range of techniques, master different levels, and create a portfolio of artwork as you go. Each canvas and environment is a playground for expression, with interactive elements that respond to your movements and choices.\n\nBring your ideas to life with \"Flip Brush\" and experience the thrill of blending creativity and VR interaction, creating a one-of-a-kind experience available exclusively on the Meta Quest Store.", "short_description": "\"Flip Brush\" is an exciting VR game that combines creativity and action in a unique way. With each trigger pull, make the brush jump, flip, and move to create dynamic strokes across virtual canvases. Players can explore various levels and environments, unlocking new colors, effects, and techniques as they progress. Designed for all skill levels, \"Flip Brush\" brings the joy of painting and the thrill of gameplay together, letting you create stunning visuals while navigating a world of interactive"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/flip-brush", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8502991456478563"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1655587188848292"}, {"status": "PUBLISHED", "id": "1312031614141641"}, {"status": "PUBLISHED", "id": "1448000780172637"}, {"status": "PUBLISHED", "id": "3286119754869290"}, {"status": "PUBLISHED", "id": "2429135530789466"}, {"status": "PUBLISHED", "id": "657037580412952"}, {"status": "PUBLISHED", "id": "1709933096541499"}, {"status": "PUBLISHED", "id": "445172045114599"}, {"status": "PUBLISHED", "id": "8804492392960381"}]}, "ba
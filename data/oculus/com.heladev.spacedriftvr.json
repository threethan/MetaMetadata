54503155", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1051324261169821_5058554044220752949_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0-esA9Q42UQ7kNvwGFJcfK&_nc_oc=AdpltTfydJp1AN3ogSoHo3PPOJ9HlWYfGDS_dr_KK-Eef6Cumv7jwlolfxSOdTn1fDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPGIuD-76Nb2QgKG_md5iGKcgTyngSYFP8CLGABLM4nw&oe=6B0F12CF"}, {"file_name": "Main Menu.png", "id": "1568864881529573", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1568864884862906_1549797796834493083_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVsbHtjkhdkQ7kNvwFfG8Bk&_nc_oc=AdoUIhQ0lcIY9OojvhJqmgIHDtMhxkb9cV5McddOBm-vG7oQSVwoT6Ua0dG__Rerm8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFeeiibmcexuFhO1WD_gfilUCVuJSo30TvI9VMUN-0iw&oe=6B0F0585"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Drift", "keywords": ["space", "vr", "arcade", "cockpit", "drift"], "long_description": "Space Drift is an immersive VR space drifting game built for Meta Quest.\n\nStep into a futuristic cockpit, grab the steering handle, and drift through space while avoiding obstacles and pushing toward your target distance. Adjust your seat position for comfort, choose background music, experience a cinematic intro, and compete for high scores through Meta platform leaderboard support.\n\nFeatures:\n- Cockpit-based VR space drifting gameplay\n- Comfortable seat adjustment system\n- Cinematic intro sequence\n- Music selection\n- High-score leaderboard support\n- Designed for Quest 2 and Quest 3 family and, future devices\n\nHow to play:\nUse the grip button to hold the steering handle and begin gameplay. Avoid obstacles, reach the target distance, and use the pause menu when needed. Seat adjustment is available from the main menu for a better cockpit position before playing.", "short_description": "Pilot a futuristic space cockpit, drift through asteroid fields, avoid obstacles, and chase high scores in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spacedriftvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holo VR Development", "support_website_url": null, "website_url": "https://spacedriftvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26166497076277095"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1024820820482488_5215596649074743487_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFQLuxnGr8cQ7kNvwEdG8Xv&_nc_oc=Adrvh959py5yov6A6ulrWT0_xLSC_OvxONgKL_IJEXtx219MxQqGKqEHRTL5ugn06zI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVSW9RGqlsobOwvm-sHBDmp7jKz53t_8IR_VQpHvgPMw&oe=6B0F0086"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Drift", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "33152
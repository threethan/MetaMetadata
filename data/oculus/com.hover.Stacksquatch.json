9842120079_920352537002477469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57u_E_2QFCUQ7kNvwGbyhBv&_nc_oc=Adl1ouO7O-QabbVN37IvLUSrPVd8_RlTm0ypipsQYmlnx9dcJZ08YJYIxCXNHBQrYiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyliZLtUwfnj62EUnOzNQ5zHe8K8bCqrGgU89sY2JNf4Q&oe=69AFFD5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover.png", "id": "3795692477382122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/228850307_3795692480715455_3488138652679626165_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSMB_kBjkHAQ7kNvwEpZ6TK&_nc_oc=AdndHvTGMVLFVR-whsLULc-MQL2zDlgL1QmNgD4r5_yCidKPEyg19UllNeQ1YQqghak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwarZovm5xmLg0kfrTTVQrQ6jj7q1oJgJeM5jR508V0xA&oe=69AFF711"}, "display_name": "Stacksquatch", "keywords": [], "long_description": "A cozy VR action-puzzle game about balancing towering stacks to meet cute cryptids on colourful floating islands. Will you overcome gravity itself to reach new heights and perspectives? Will you find the mythical Stacksquatch and recover the Wayward Islands?\n\n* Explore across locations, seasons, and sizes to build the best stacks\n* Chat with the cryptids you find, all with unique dialogue, hopes, and dreams\n* Sit down or run around, whatever your space allows\n* Enjoy accessible, intuitive gameplay without violence\n\nSit back and stack with Dogtective!", "short_description": "Sit back and stack with Dogtective in a colourful, floating world of cryptids in this VR action-puzzle game."}]}, "developer_name": "Hover", "developer_privacy_policy_url": "https://stacksquatch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": " The Stacksquatch Society", "support_website_url": null, "website_url": "https://stacksquatch.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968
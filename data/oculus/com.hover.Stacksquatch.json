9842120079_920352537002477469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Acw-MY6FxrUQ7kNvwFg8V9n&_nc_oc=AdltKYY09vSfGtwwEohctuTlHWE3nK4ChogsqEbBZRf_E7QU3WNgKfuuisvfxsqGLO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXAguCBIURvXffBZQdwb_-oQG5-8ROBNN2njAuQu2paA&oe=69B937DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover.png", "id": "3795692477382122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228850307_3795692480715455_3488138652679626165_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIhYG42kmYkQ7kNvwFKC1eo&_nc_oc=AdkuZsMAMiBCQYUY_vLG90Wr_joZO9XSVenLqWYc5WDZ_7rN6xSQkLJy3M1_DZAAEGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ_NbUlNH3JBEQ4HBgRz5EZREa6Y5ArUv7q6IoIepvzA&oe=69B93191"}, "display_name": "Stacksquatch", "keywords": [], "long_description": "A cozy VR action-puzzle game about balancing towering stacks to meet cute cryptids on colourful floating islands. Will you overcome gravity itself to reach new heights and perspectives? Will you find the mythical Stacksquatch and recover the Wayward Islands?\n\n* Explore across locations, seasons, and sizes to build the best stacks\n* Chat with the cryptids you find, all with unique dialogue, hopes, and dreams\n* Sit down or run around, whatever your space allows\n* Enjoy accessible, intuitive gameplay without violence\n\nSit back and stack with Dogtective!", "short_description": "Sit back and stack with Dogtective in a colourful, floating world of cryptids in this VR action-puzzle game."}]}, "developer_name": "Hover", "developer_privacy_policy_url": "https://stacksquatch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": " The Stacksquatch Society", "support_website_url": null, "website_url": "https://stacksquatch.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968
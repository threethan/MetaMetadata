p.png", "id": "3110462739159637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628447_3110462742492970_5527981341120245752_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFpmhUJtBbIQ7kNvwHvWp0n&_nc_oc=AdqtEQkAAFWcteZEIyegthzwTzixXhaPjNaIm4Zo7quxQgiv9Qnz_18NAZ3QthGMkes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThMI54oJa9Vz9jg6VHdR3ASdk-sH3B8yTp1Qb5V5l0Hg&oe=6AFDBF0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover.png", "id": "3795692477382122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/228850307_3795692480715455_3488138652679626165_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3n3Zej43K4Q7kNvwE-gpCq&_nc_oc=Ado9a4wryP3rNHjOrHYBsXYLvPVNcZoSd3U7PANZ-eG5lqhgbbSM7ahTORrqSVRodNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDMd_YU5gYD3HYD4R4ONTo-3NUvJ6lRYpHTeoLjYofCQ&oe=6AFDBAD1"}, "display_name": "Stacksquatch", "keywords": ["puzzle", "casual", "cute", "physics", "relaxing"], "long_description": "Stack a surreal landscape with this oddly satisfying VR action-puzzle game. The higher it goes, the bigger you grow and the more you can pick up!\n\n- **Grab your surroundings** and balance them with coordination and timing\n- **Defy gravity** with suspenseful moments of finding the right balance point\n- Find **cozy moments of peace** with the ancient art of stacking\n\n{29178065241796136}\n\nEach level has **unique challenges**. Some need you to stack tall while others require heavy piles. Sometimes you have to deal with a twist like rain, fires, or darkness. No matter the goal, each artistic stack gets preserved in a photograph at the end.\n\n- Explore different locations, seasons, and scales\n- Enjoy accessible, intuitive gameplay without violence\n- Sit down or run around, whatever your space allows\n\n{1067342019414844}\n\nEach stack also acts as a guide for the **local cryptids**. Some might be familiar and some are out of this world but they all have something to say. But only the mythical Stacksquatch can bring order and rejoin the floating islands.", "short_description": "Stack a surreal landscape with this oddly satisfying VR action-puzzle game. The higher it goes, the bigger you grow and the more you can pick up! Pile your surroundings with coordination and timing, feel the suspense of defying gravity, and find peace in the ancient art of stacking."}]}, "developer_name": "North Key Games", "developer_privacy_policy_url": "https://stacksquatch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "North Key Games", "support_website_url": null, "website_url": "https://stacksquatch.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28717050571220738"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620669_1653346929482246_3505207453897960560_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgF8OMafLogQ7kNvwGYXTBX&_nc_oc=Adqd19XF2ploG1nObB3ypIm9lxY1Rb3bbS8bDeM3dbgH3fogT0W0sQeH8JZ_mJcLH4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68RkTqNuU4q46YIxfYCi75If0sK-RYqlwVJc6_ge7qQ&oe=6AFDCB89"}, "is_concept": false, "is_test": false, "is_t
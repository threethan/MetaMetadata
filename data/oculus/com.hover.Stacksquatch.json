h=00_Afv3GD9nnCcBpcXtJNlw4M9YlZLCaUyakHBkGWz7xD_EWg&oe=69A6C2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover.png", "id": "3795692477382122", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/228850307_3795692480715455_3488138652679626165_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVSe7N8d980Q7kNvwGtGoxj&_nc_oc=AdnwXvqMXTOggxezlyszNrCEQcCV_Y5Cj72vyqYFdclG6MmA8LnwKyOCGT75L5y5hvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv5HcZo8wSoZstjl6v2oaEEJPjKbomCus6ax08Fe8uoog&oe=69A6BC91"}, "display_name": "Stacksquatch", "keywords": [], "long_description": "A cozy VR action-puzzle game about balancing towering stacks to meet cute cryptids on colourful floating islands. Will you overcome gravity itself to reach new heights and perspectives? Will you find the mythical Stacksquatch and recover the Wayward Islands?\n\n* Explore across locations, seasons, and sizes to build the best stacks\n* Chat with the cryptids you find, all with unique dialogue, hopes, and dreams\n* Sit down or run around, whatever your space allows\n* Enjoy accessible, intuitive gameplay without violence\n\nSit back and stack with Dogtective!", "short_description": "Sit back and stack with Dogtective in a colourful, floating world of cryptids in this VR action-puzzle game."}]}, "developer_name": "Hover", "developer_privacy_policy_url": "https://stacksquatch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": " The Stacksquatch Society", "support_website_url": null, "website_url": "https://stacksquatch.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
name": "dump.png", "id": "376749838786746", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75639801_376749842120079_920352537002477469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaWoDZgSpcMQ7kNvwHN6c_f&_nc_oc=AdrrX5XPdaGDlO-oYEB2rG1DcW6Wa4gEnFL23-MCf8sgxyD7vtMUIyz4qH8ZH9ZG7VU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eVbsbZmamivQYaKHXFDhLd5Cpa_Hc8tRUXv2eslRt0Q&oe=6A46809D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover.png", "id": "3795692477382122", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/228850307_3795692480715455_3488138652679626165_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfsNah9BxhcQ7kNvwF0gUzC&_nc_oc=Adr71RIEMl8yD5aXvdyB3db6bnGWQ1zUO8o4zl3c9RWWaA3nEvyz8xCDf9O8MI9kUcE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0H7bY0cz6RDV_vvuXYk6XNO-wLZBEWlJyaOg8HEexJQ&oe=6A467A51"}, "display_name": "Stacksquatch", "keywords": [], "long_description": "A cozy VR action-puzzle game about balancing towering stacks to meet cute cryptids on colourful floating islands. Will you overcome gravity itself to reach new heights and perspectives? Will you find the mythical Stacksquatch and recover the Wayward Islands?\n\n* Explore across locations, seasons, and sizes to build the best stacks\n* Chat with the cryptids you find, all with unique dialogue, hopes, and dreams\n* Sit down or run around, whatever your space allows\n* Enjoy accessible, intuitive gameplay without violence\n\nSit back and stack with Dogtective!", "short_description": "Sit back and stack with Dogtective in a colourful, floating world of cryptids in this VR action-puzzle game."}]}, "developer_name": "Hover", "developer_privacy_policy_url": "https://stacksquatch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": " The Stacksquatch Society", "support_website_url": null, "website_url": "https://stacksquatch.com/", "category": null, "comfort_rating": null, "comfort_t
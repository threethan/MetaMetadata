63400494183559_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuWrirukaJoQ7kNvwGVJL7h&_nc_oc=Adq0FEqU_2rMjcgtUbL56xsg_GITtrWGVJCIWzF5CU7XM88cbwPskP8EoC-wCrQDFUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC6xvMntlnX4SeLWx_eFqvSFCxKJ1oejnUhuJOkyK-7g&oe=6B01D102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creepin Capuchin's", "keywords": [], "long_description": "Welcome to Creepin Capuchin's! Explore vibrant worlds, climb towering structures, and swing through exciting environments as you embark on unforgettable adventures. Meet friendly capuchins, make new friends, and discover hidden secrets scattered throughout every map. Collect unique cosmetics, customize your capuchin, and express your style while hanging out with players from around the world. Whether you're exploring new locations, socializing with friends, or searching for hidden surprises, there's always something new to discover in Creepin Capuchin's. Jump in and start your adventure today!\n", "short_description": "Explore, climb, and make capuchin friends in Creepin Capuchin's! Discover new places, unlock cosmetics, and enjoy fun adventures with friends in this exciting Gorilla Tag-inspired experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQ7WgVfmDXei4ndjBnzxCi5WN6MJlFKx4kTuJWdMWG6MDhhnCWv4QxjyqlU-hHZ2jWpyceSPRXWeqA2/pub", "developer_terms_of_service_url": null, "publisher_name": "Sparks Games", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vS2wxQWlquknUSQC8gY7BcMvqRwkcNpPb-tQETXTDrcqgZ3Qr05wf7p33C2sEHXgLYPtDnKVl5jo_sB/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "ex
name": "Temperature Reaction Rate Experiment_Screenshot03.png", "id": "1100989481213588", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974920_1100989484546921_8474543867823972853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ8cbaOVEUIQ7kNvwH980qF&_nc_oc=AdnP8z5YT7ZKJJ9skZ-7MEbj5zJaIlAFzj_a_EzjgGmmDn9uNpBjDRDwbhxx8x7XxzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuKTNdpqKHoiO4MDw2NksRp6bafvf9jeehr0WeVpTHBTA&oe=699F007D"}, {"file_name": "Temperature Reaction Rate Experiment_Screenshot04.png", "id": "702414045397417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003231_702414048730750_1001696630753264057_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auhVoCT6mEUQ7kNvwEEfXpz&_nc_oc=AdlHvocbf7o_mQOIOix-G8akJjBIvWClqSZL3R9Zs3h7VnxChTjs2vTGeCqZRSNxF6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsR8cdCpI2gW1S4Qfb5eNCHyGauykfrMObyx7jSj4goVg&oe=699ED464"}, {"file_name": "Temperature Reaction Rate Experiment_Screenshot05.png", "id": "7054665214645991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_7054665217979324_6721150839639086559_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TySqAqkXKIUQ7kNvwG55i4w&_nc_oc=AdmnCMZgu40HJchJ7DCWEuUAfzjdv5wR43RPP_cj0VdlFehT4TUuab6Yzh4rpfg8hjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftEn8IUHS3zFX6EqrMr-bPvCeqezMTv1gvLUps5WHJb7g&oe=699EDA2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Temperature Reaction Rate_Landscape.png", "id": "7447925385239094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572952_7447925391905760_8455662158874321892_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vb1XALeWVMQ7kNvwEDI1w-&_nc_oc=AdnFqiFEfjVzNHegSKSYC9IK_-_jb0T1Fhu_xvH_8rCIru1IoJB5ZCKqmzxcxS7m4kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrBUHcfA2XPm3HU1vz-wZcXfivo4qE3BQmlRHTTkei2Q&oe=699EEEE8"}, "display_name": "Temperature Reaction Rate Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "temperature", "science", "contentsda"], "long_description": "1. prepare cold, normal, and hot water and measure the temperature of the water with a thermometer 2. prepare 200 ml of chlorinated water for color comparison in a scalpel cylinder 3. add a spoonful of food coloring to the scalpel cylinder 4. add 200 ml each of cold, normal, and hot water. Dissolve the food coloring by stirring with a glass rod 5. The color of the water will change to green as the powder dissolves. 6. Add one chlorine disinfection foam tablet to each of the cold, normal, and hot water and observe the change.\n\n<Result>\nThe order in which the chlorine disinfection tablets dissolve and disappear\n\n\u2192 Hot water > Normal water > Cold water\n\nReasons for the rapid disappearance of chlorine disinfection foam tablets in hot water\n\u2192 The reaction speed increases as the temperature increases.", "short_description": "Observe how temperature influences the speed of chemical reactions. This experiment offers an engaging way to understand the kinetics of chemical reactions, illustrating the vital role temperature plays in accelerating or decelerating reaction rates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "k
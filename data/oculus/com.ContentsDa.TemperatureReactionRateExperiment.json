, "id": "702414045397417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003231_702414048730750_1001696630753264057_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UGD2QZbECEQ7kNvwE_tkMm&_nc_oc=AdltA1PKQa5TRQqqjJtTcl13L83hFcF-j3XAlx29klKVlYYWZz-wScL-QsUAeIN8hOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuOTudVTto296mFiGZUCmVIki3rFQT3ED-A1PLMxSEFQQ&oe=69A80EE4"}, {"file_name": "Temperature Reaction Rate Experiment_Screenshot05.png", "id": "7054665214645991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_7054665217979324_6721150839639086559_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSrRhuYNUrkQ7kNvwFh6e7l&_nc_oc=AdnrGvUNLF84zzKFuwvYyxVjohb3dZBL-9k2GG9s8skINcnX7-Tvr0WEOwb87GUlQmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvVFjwx4FGxAZK2_hCXKnkCBMTQ0JbOBCvzMr5p9bm57A&oe=69A814AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Temperature Reaction Rate_Landscape.png", "id": "7447925385239094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572952_7447925391905760_8455662158874321892_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F17qjhr62WsQ7kNvwHlDG1C&_nc_oc=Adlwp7XbsiLWHHdojk5GhiB5YsKHgv7DH9iMpEN1PLQcr6-t2oU1OLYZSXMz9F8kHq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEopwXe2nHA1tWZNuDZIxpkLBf_lYf3GHy3lfL1vLyKg&oe=69A82968"}, "display_name": "Temperature Reaction Rate Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "temperature", "science", "contentsda"], "long_description": "1. prepare cold, normal, and hot water and measure the temperature of the water with a thermometer 2. prepare 200 ml of chlorinated water for color comparison in a scalpel cylinder 3. add a spoonful of food coloring to the scalpel cylinder 4. add 200 ml each of cold, normal, and hot water. Dissolve the food coloring by stirring with a glass rod 5. The color of the water will change to green as the powder dissolves. 6. Add one chlorine disinfection foam tablet to each of the cold, normal, and hot water and observe the change.\n\n<Result>\nThe order in which the chlorine disinfection tablets dissolve and disappear\n\n\u2192 Hot water > Normal water > Cold water\n\nReasons for the rapid disappearance of chlorine disinfection foam tablets in hot water\n\u2192 The reaction speed increases as the temperature increases.", "short_description": "Observe how temperature influences the speed of chemical reactions. This experiment offers an engaging way to understand the kinetics of chemical reactions, illustrating the vital role temperature plays in accelerating or decelerating reaction rates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8865535813497455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348038_1547200169348548_1553845623598349384_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaZxjdJqS10Q7kNvwHR-bMn&_nc_oc=AdnNTjbBfAQvHakWcZjEoH5LkJc7Vw3cjmbMMm
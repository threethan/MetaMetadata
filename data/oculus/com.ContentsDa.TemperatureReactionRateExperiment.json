cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oO_X055BkoQ7kNvwEkvfXE&_nc_oc=AdkrZB7NpLd1GCgtl9qT197ALtU6BakL7mlZ866SAt0j0ZYMYCt0qX_yhZK8GyxBla4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-TpXlJ4XsPWcKSOkRJPB7ELodwVMruwYd8K9NvWjilQ&oe=69BD2CAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Temperature Reaction Rate_Landscape.png", "id": "7447925385239094", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572952_7447925391905760_8455662158874321892_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp7k8w8yU4gQ7kNvwHhkU8y&_nc_oc=AdkhRmP6jz84RzZYlRZOWkhQ-d_BDuX3XBEHJ1uND7c6rWjg90Suw9JMiaKzai6EVnQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG2PgAouKqpXZkUD7IWEUdHG5nspH5WlOodpayeuPtSg&oe=69BD4168"}, "display_name": "Temperature Reaction Rate Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "temperature", "science", "contentsda"], "long_description": "1. prepare cold, normal, and hot water and measure the temperature of the water with a thermometer 2. prepare 200 ml of chlorinated water for color comparison in a scalpel cylinder 3. add a spoonful of food coloring to the scalpel cylinder 4. add 200 ml each of cold, normal, and hot water. Dissolve the food coloring by stirring with a glass rod 5. The color of the water will change to green as the powder dissolves. 6. Add one chlorine disinfection foam tablet to each of the cold, normal, and hot water and observe the change.\n\n<Result>\nThe order in which the chlorine disinfection tablets dissolve and disappear\n\n\u2192 Hot water > Normal water > Cold water\n\nReasons for the rapid disappearance of chlorine disinfection foam tablets in hot water\n\u2192 The reaction speed increases as the temperature increases.", "short_description": "Observe how temperature influences the speed of chemical reactions. This experiment offers an engaging way to understand the kinetics of chemical reactions, illustrating the vital role temperature plays in accelerating or decelerating reaction rates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8865535813497455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75348038_1547200169348548_1553845623598349384_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdE4_-m9wfcQ7kNvwGu2ygN&_nc_oc=Adlt9Klc-VWOdEuFFRnzbRLAA0Ahgzkvh1n9TIjrTvn_wSlOyI0u5y78Z5RwvBrFfPA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDbateZ_F9PS2l9JOhPnatOVMdXDCeYGxOxU0Yeni9vQ&oe=69BD4DA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Temperature Reaction Rate Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1699977139, "lastRevision": {"nodes": [{"id": "70387851
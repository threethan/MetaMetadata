VLPxZkQ7kNvwH2uKJE&_nc_oc=Adm1fMV4IHXtl0-W38P7Mc0yJlbYbK1VUuAR0Hw-NSP4jh9m7a2isGS7a_HIkSFqODM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5tg8zAm70NZyyHs5ZCifq_5YH49efQllHfLRAebudLQ&oe=69A44A0E"}, {"file_name": "ScreenShot_006.png", "id": "1534021694670179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507840145_1534021698003512_3147050357246630702_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JarY_-H2TDkQ7kNvwFkPHff&_nc_oc=AdmoJXq4JG-tM-gZgQK8_j3FFZwYHla-oyzx5TwmtQSB8Jm9bJz6lMBkOR6DNcvEjIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvRL7aKOH7DnzKKaiRCO6PYhiITXK6PGRenDy2whdItEA&oe=69A4294E"}, {"file_name": "ScreenShot_008.png", "id": "9999412326762282", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828842_9999412360095612_3406489954701264873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6WDJtPIpmAQ7kNvwEOd4H5&_nc_oc=Adkv3R_MRmkPU6Iizb7mk9Eeh5tY4_8RqomU-2lCmWnaYUrDGb-umDBOMJf-vt-5dxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft9bmeRjtsXlcuopXOsvBWctre2NbFAqLP7TyMXig8Org&oe=69A41F5C"}, {"file_name": "ScreenShot_009.png", "id": "1406121000629400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_1406121003962733_7872042812824226814_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oHJ4E44D48Q7kNvwE-96DC&_nc_oc=Adnrs8oXkR66tXOdk05Q_HtQ1DOfTJa8aC8KyjrLO3OBm43PHOmZ_hj8PpyHd-ddCPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuTAYSpElt9EuGCQdZggzX258iMDxZCiUz-uf1FT9-izw&oe=69A44D8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Party", "keywords": ["boxing", "arena", "simulator", "punch", "gym"], "long_description": "# Punch Party - Gym Update [OPEN BETA EARLY ACCESS]\nTrain in your very own boxing gym with friends. Buy rare equipment to upgrade your gym, get a good workout, and become the strongest Wob!\n\nKnockout your friends in this zany physics multiplayer fighting game with realtime arena competitions, training quests, and endless upgrades.\n\nPunch Party is currently in open beta early access! Please leave your feedback in our Discord: https://discord.gg/punchparty\n\nFight in the Battle Arena to earn PunchBucks to unlock hilarious and beautiful cosmetics like the Nether Block Boxing Gloves or the Stars and Stripes Boxing Gloves.\n\nProtect Wob City from the BRAINROT Invasion of Tralalero Tralala sharks and earn a limited time SHARK HAT.\n\nGrind up your strength to become the strongest Wob in this hangout boxing gym simulator while getting a good workout in.", "short_description": "[OPEN BETA EARLY ACCESS] Gain access to exclusive beta tester rewards during our open beta. Get strong in your very own boxing gym. Buy rare equipment to upgrade your gym. Free to play multiplayer battle royale physics arena game. Knock opponents out of the ring in an epic punch party."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildwest.gg/docs/privacy", "developer_terms_of_service_url": null, "publisher_name": "Wild West", "support_website_url": null, "website_url": "https://www.wildwest.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "30311823411765030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824609_1241887324252556_888111885
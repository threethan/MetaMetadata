9nH7QMQ7kNvwH6Z44J&_nc_oc=AdmKzZVS0eHsGD_20xVQItoFlmiuov14Q3jRE0RJoizPc0dQsBzSLkrUG2-sVLLBR1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuPWQeGUvSVX5sgbTfs5tLSd94dEsiWafx_boJQWobcUQ&oe=69A59B8E"}, {"file_name": "ScreenShot_006.png", "id": "1534021694670179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/507840145_1534021698003512_3147050357246630702_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JarY_-H2TDkQ7kNvwFRRtYW&_nc_oc=AdmGW0zi1uUh95GeJo2VBG5I082EAG2HlB_v-hNa09pMQi3SrzyUccppI_6TIpRNvrQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfunNZ41zXaXYLzGPZRB2qcTqxIG-zc7oUhF_aX1i_Hx3w&oe=69A57ACE"}, {"file_name": "ScreenShot_008.png", "id": "9999412326762282", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_9999412360095612_3406489954701264873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6WDJtPIpmAQ7kNvwHbWisc&_nc_oc=Adm3Ew3TQMdFiP9Pu3rW2SUxB2lldV56NJXmVERrBhbk2H-d6Qe7O28d8CvAs7o2TMs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftLdpf3AdCJpGjC7Ea7JCwFiQtEiIP0f0tnV8pNsqnnAg&oe=69A570DC"}, {"file_name": "ScreenShot_009.png", "id": "1406121000629400", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830599_1406121003962733_7872042812824226814_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oHJ4E44D48Q7kNvwGJMdCs&_nc_oc=AdmkofbhKKu4rNPlil4NwoNeOFy2crkLesPplWbYwRbcuUdHEJriWrx7X8HYMmBmLcI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft662IyAWT3i2diFbcwXxcZr7-CA89QGArkM1xht-xYdw&oe=69A59F0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Party", "keywords": ["boxing", "arena", "simulator", "punch", "gym"], "long_description": "# Punch Party - Gym Update [OPEN BETA EARLY ACCESS]\nTrain in your very own boxing gym with friends. Buy rare equipment to upgrade your gym, get a good workout, and become the strongest Wob!\n\nKnockout your friends in this zany physics multiplayer fighting game with realtime arena competitions, training quests, and endless upgrades.\n\nPunch Party is currently in open beta early access! Please leave your feedback in our Discord: https://discord.gg/punchparty\n\nFight in the Battle Arena to earn PunchBucks to unlock hilarious and beautiful cosmetics like the Nether Block Boxing Gloves or the Stars and Stripes Boxing Gloves.\n\nProtect Wob City from the BRAINROT Invasion of Tralalero Tralala sharks and earn a limited time SHARK HAT.\n\nGrind up your strength to become the strongest Wob in this hangout boxing gym simulator while getting a good workout in.", "short_description": "[OPEN BETA EARLY ACCESS] Gain access to exclusive beta tester rewards during our open beta. Get strong in your very own boxing gym. Buy rare equipment to upgrade your gym. Free to play multiplayer battle royale physics arena game. Knock opponents out of the ring in an epic punch party."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildwest.gg/docs/privacy", "developer_terms_of_service_url": null, "publisher_name": "Wild West", "support_website_url": null, "website_url": "https://www.wildwest.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "30311823411765030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824609_1241887324252556_888111885
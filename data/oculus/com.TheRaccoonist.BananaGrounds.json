&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C8tPCCcqeM5OPgPSd6lps1Bjo3kIy11ijDPawYrtB9w&oe=6A1EF1B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bgthumbnail.png", "id": "898705955649984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_898705958983317_1286403463132461696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7TgQylHxeYQ7kNvwEYB88S&_nc_oc=AdraREgnAu2r0r5pnaHog2AKltdnpKcBqqJGtaLHw_fiSxBzmM__qHQez8ucTd2mpoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af427NhpvECyjoK3ZPkHuUG1XBtAhleMaTix5y7ztiFRBw&oe=6A1EEF56"}, "display_name": "Banana Grounds", "keywords": [], "long_description": "This game is discontinued. Please join the new game's discord: https://discord.gg/wxbBQkQAht\n\nBanana Grounds is a fun VR Game where you can explore the environment with a push and a swing! Find some monkes and play multiple fun gamemodes like Zero Gravity, Only Up, and PVP. \n\nYou can also fashion up your monke at the Shop, where you can buy and equip cosmetics of multiple kinds at.\n\nThat's what Banana Grounds is all about, so get the game and have a fun time with all the monkes!", "short_description": "Banana Grounds is a VR Game where you can use your arms to move around in the surrounding environment. We also offer multiple fun gamemodes including Zero Gravity, Only Up, and PVP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/banana-grounds/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Raccoonist", "support_website_url": null, "website_url": "https://sites.google.com/view/banana-grounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
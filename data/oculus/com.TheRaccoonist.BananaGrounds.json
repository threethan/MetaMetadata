il": {"file_name": "bgthumbnail.png", "id": "898705955649984", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982451_898705958983317_1286403463132461696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5P0O9Vm-mQQ7kNvwFzcf0L&_nc_oc=AdrA2u8v9R5lTgdkkT1pvj2JwAdW8AUsvaYaVMhKomdRqm60b_5a3ePWLL_By5bu3ZI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUwjfmdBPxNYxzWda82E-dG39O5ftx6CVxI1y5cfHbBw&oe=69C11C96"}, "display_name": "Banana Grounds", "keywords": [], "long_description": "This game is discontinued. Please join the new game's discord: https://discord.gg/wxbBQkQAht\n\nBanana Grounds is a fun VR Game where you can explore the environment with a push and a swing! Find some monkes and play multiple fun gamemodes like Zero Gravity, Only Up, and PVP. \n\nYou can also fashion up your monke at the Shop, where you can buy and equip cosmetics of multiple kinds at.\n\nThat's what Banana Grounds is all about, so get the game and have a fun time with all the monkes!", "short_description": "Banana Grounds is a VR Game where you can use your arms to move around in the surrounding environment. We also offer multiple fun gamemodes including Zero Gravity, Only Up, and PVP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/banana-grounds/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Raccoonist", "support_website_url": null, "website_url": "https://sites.google.com/view/banana-grounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
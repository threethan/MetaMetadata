1FqLUXTXk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5CyoPnnNby4Qz9Z4Fn-2BvM2IkKmjZD_ugGCx9-G4RQ&oe=6AA95F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bgthumbnail.png", "id": "898705955649984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982451_898705958983317_1286403463132461696_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-w3TZnyPHHMQ7kNvwGBLHbc&_nc_oc=Adq5I2Hkxy43xEpgWdS11rkPcsqqgb9p3GX9V5s8x263eMVJdhWcGE8Vp9sE9HKBKj4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWX2IAiQP2G5sjD2mPdcYlVqRqEkzK49hWEH0wnwR5rA&oe=6AA95CD6"}, "display_name": "Banana Grounds", "keywords": [], "long_description": "This game is discontinued. Please join the new game's discord: https://discord.gg/wxbBQkQAht\n\nBanana Grounds is a fun VR Game where you can explore the environment with a push and a swing! Find some monkes and play multiple fun gamemodes like Zero Gravity, Only Up, and PVP. \n\nYou can also fashion up your monke at the Shop, where you can buy and equip cosmetics of multiple kinds at.\n\nThat's what Banana Grounds is all about, so get the game and have a fun time with all the monkes!", "short_description": "Banana Grounds is a VR Game where you can use your arms to move around in the surrounding environment. We also offer multiple fun gamemodes including Zero Gravity, Only Up, and PVP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/banana-grounds/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Raccoonist", "support_website_url": null, "website_url": "https://sites.google.com/view/banana-grounds", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
771-25/604293968_1350012057115966_3508114181315357755_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ohs2s1yWIMQ7kNvwGtQlsF&_nc_oc=AdpBqxXG6eRZzTTG2biPBIGbaYp8zSW8cFP2LuD_rkjQ7sN61KN-VF5KUcN0FBXZIoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiH6l93EbYXZOTfXc2Q01oKoqnIb0_zLWfP7v4mb9aiA&oe=6B0C80E7"}, "display_name": "Blacktop Outlaws: Motorbike Brawl Racing", "keywords": ["motorcycle", "racing", "combat", "brawler", "multiplayer"], "long_description": "**The fight is real because the arms are yours.**\n\n- Hold the handlebars to ride; let go with one hand to strike. Every punch is your punch, every swing your swing.\n- Read the wind-up, then lean away or duck under it. Block with a hand, parry with a weapon.\n- Knock a rival's weapon loose and snatch it out of the air: tire irons, bats, pipes, batons, chains, nunchaku, cattle prods and a two-metre bullwhip.\n- Five highways: Sierra switchbacks, Pacific cliffs, Redrock Canyon, the Neon Interstate at night and the Bayou at dawn.\n- The Circuit: five tiers, prize money, six bikes from a rat bike to a hyperbike, repairs, fines and a crown at the top.\n- Sixteen outlaws in five gangs. Hit one and he remembers; his gang backs him up.\n- Highway Patrol: brawl too hard and the sirens come for you.\n- Brawl: up to four riders on the same Wi-Fi or online with a six-letter code. No accounts.\n- Comfort first: level horizon, a light vignette in hard turns, no camera shake, crashes fade or play from a steady roadside view, small hops by default. Every option is in Settings.\n- Play with controllers or hand tracking, seated.", "short_description": "Grip the bars, race seven outlaws down open highways and fight for every metre. Punch, kick and swing chains, bats and whips with your own arms; duck under a rival's swing for real; knock the weapon out of his hand and catch it. Five roads, five tiers, gangs that hold grudges, police who don't, and brawls for up to four riders, in the same house or anywhere with a six-letter code."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/blacktop/privacy", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1430767615898940"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1164169526173639_5211509897996991960_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftbdKm7dp8AQ7kNvwFrG55X&_nc_oc=AdrVfWrsx3BPXwAQTW6EIWyBKUVDTjy98gaT_D9cGARDrSsz3f868kF0MtPIhegX864&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRR52mJtQX_k06wJdyV6eE5tVHCm4QwAXy-uNjzb0FA1Q&oe=6B0C7519"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blacktop Outlaws: Motorbike Brawl Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"},
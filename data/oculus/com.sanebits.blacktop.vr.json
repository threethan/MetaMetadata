lfUoOlrGyd0zsd13b4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQwiijVE1OXUv4g33UJOAUsdhOYU4PTkg9S5z5QwqaUw&oe=6B0C7AAA"}, {"file_name": "screenshot-3-neon-eyes.png", "id": "3453087801537006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654886437_3453087804870339_9135947357426822457_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X5bYrjnCJkQ7kNvwHydnNJ&_nc_oc=AdrTTYu174c29ZxPX-SPzRbXAQ0zkkx7klcmXj13DxgGjfGPlusNPOnFESoDt-E8sUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDaste-tO61073Yocm0QH-uW8FWI1SXTvW8PGqtIvqfw&oe=6B0C7D1E"}, {"file_name": "screenshot-4-bayou-swing.png", "id": "3663411143808712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/804229564_3663411147142045_2186787338814523553_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTy_-33cw1AQ7kNvwFSzXj2&_nc_oc=AdpZHNxFw1FgJemRxzM5dVszp9BU7UV7aEfZX6O6iWYdKDDDWaMXtIu1CYMRpE-0ZLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZCNg0w5lvqYKEpovRZ_Hon9sgOmaprsrt5PCgW0aeKA&oe=6B0C4FAE"}, {"file_name": "screenshot-5-sierra-swing.png", "id": "1700364204993676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1700364208327009_771254784922106644_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpahDiEbpMIQ7kNvwHIWd8y&_nc_oc=Adq6ovTihrr8qcwfBgwrfhUejMS_ZCJLwoa6VUecZPeXuzmJZiVIaACWes0Kgg_kP9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsDgzv3lHravArBOT898RbDzgOTgC3eV-EqsQPrNRkPw&oe=6B0C7116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "blacktop-trailer-cover.png", "id": "1350012053782633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604293968_1350012057115966_3508114181315357755_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ohs2s1yWIMQ7kNvwGtQlsF&_nc_oc=AdpBqxXG6eRZzTTG2biPBIGbaYp8zSW8cFP2LuD_rkjQ7sN61KN-VF5KUcN0FBXZIoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiH6l93EbYXZOTfXc2Q01oKoqnIb0_zLWfP7v4mb9aiA&oe=6B0C80E7"}, "display_name": "Blacktop Outlaws: Motorbike Brawl Racing", "keywords": ["motorcycle", "racing", "combat", "brawler", "multiplayer"], "long_description": "**The fight is real because the arms are yours.**\n\n- Hold the handlebars to ride; let go with one hand to strike. Every punch is your punch, every swing your swing.\n- Read the wind-up, then lean away or duck under it. Block with a hand, parry with a weapon.\n- Knock a rival's weapon loose and snatch it out of the air: tire irons, bats, pipes, batons, chains, nunchaku, cattle prods and a two-metre bullwhip.\n- Five highways: Sierra switchbacks, Pacific cliffs, Redrock Canyon, the Neon Interstate at night and the Bayou at dawn.\n- The Circuit: five tiers, prize money, six bikes from a rat bike to a hyperbike, repairs, fines and a crown at the top.\n- Sixteen outlaws in five gangs. Hit one and he remembers; his gang backs him up.\n- Highway Patrol: brawl too hard and the sirens come for you.\n- Brawl: up to four riders on the same Wi-Fi or online with a six-letter code. No accounts.\n- Comfort first: level horizon, a light vignette in hard turns, no camera shake, crashes fade or play from a steady roadside view, small hops by default. Every option is in Settings.\n- Play with controllers or hand tracking, seated.", "short_description": "Grip the bars, race seven outlaws down open highways and fight for every metre. Punch, kick and swing chains, bats and whips with your own arms; duck under a rival's swing for real; knock the weapon out of his hand and catch it. Five roads, five tiers, gangs that hold grudges, police who don't, and brawls for up to four riders, in the same house or anywhere with a six-letter code."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/blacktop/privacy", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "suppo
!\n\nJoin us on Discord at https://ultraboxingvr.com/discord", "short_description": "[ EARLY ACCESS GAME ]\n\nExperience VR boxing like never before! \n\nFight ultra-realistic AI opponents with advanced dodging mechanics and lifelike animations. \n\nJoin Early Access, lock in the early adopters\u2019 price, and support the developers in shaping the future of VR boxing!"}]}, "developer_name": "UltraBoxing", "developer_privacy_policy_url": "https://ultraboxingvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UltraBoxing", "support_website_url": "https://ultraboxingvr.com/discord", "website_url": "https://ultraboxingvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7645313852228443"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "744862771983288"}, {"status": "PUBLISHED", "id": "1458422709104165"}, {"status": "PUBLISHED", "id": "690190420745720"}, {"status": "PUBLISHED", "id": "865412476209452"}, {"status": "PUBLISHED", "id": "1543644420233389"}, {"status": "PUBLISHED", "id": "24492089793792348"}, {"status": "PUBLISHED", "id": "1851543902025017"}]}, "baseline_offer": {"id": "1851543902025017"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "744862771983288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
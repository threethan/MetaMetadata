g1kokb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1UdUcUx5Kiy8NTtPuSezF3W1bAFrGdejEJiznncrMLQ&oe=6B05CDFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_early_access.png", "id": "1016741763372218", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031400_1016741766705551_2640565472597873510_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRYBcdG8JosQ7kNvwGhzKAU&_nc_oc=Adr2JMgUaNkfzuoIfGXo68moVBZhDC1J1F8mlOpsbAP4MCNXMXubM_VFD7nXgKZfOdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT870p84mId6KzJxgnw2LJFZh-jq8a3bjVYCwk3fnYFQQ&oe=6B05B527"}, "display_name": "Ultraboxing - VR Boxing", "keywords": [], "long_description": "[ EARLY ACCESS GAME ]\n\n\"Realistic and strategic\"' \u2013 rbdinsdale\n\n\"It's a VR boxing game with smart and difficult AI, unlike others\" - alexdt113\n\n\"This boxing game is more realistic than other games and has huge potential\"  \u2013 ashchan\n\n\"Its pretty fun already at this stage of development and will only get better\" \u2013 gabkicks\n\nExperience VR boxing like never before! \n\nFight ultra-realistic AI opponents with advanced dodging mechanics and lifelike animations. Dive into fully immersive or mixed reality modes for an unparalleled boxing experience. \n\nJoin Early Access, lock in the early adopters\u2019 price, and support the developers in shaping the future of VR boxing!\n\nJoin us on Discord at https://ultraboxingvr.com/discord", "short_description": "[ EARLY ACCESS GAME ]\n\nExperience VR boxing like never before! \n\nFight ultra-realistic AI opponents with advanced dodging mechanics and lifelike animations. \n\nJoin Early Access, lock in the early adopters\u2019 price, and support the developers in shaping the future of VR boxing!"}]}, "developer_name": "UltraBoxing", "developer_privacy_policy_url": "https://ultraboxingvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UltraBoxing", "sup
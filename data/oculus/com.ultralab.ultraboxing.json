1_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D7WP-L8-LgQ7kNvwHKlXkG&_nc_oc=Ado24XVwckthZniPrY-OEott6et7QhERbjWQvRhQMWKKeXu4FnuVa4PVLo0ImS_ymH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQtxjuSWrEROuhvT2rjfCFeL57-hStupac0W0b4nqdig&oe=6B008350"}, {"file_name": "UB_4.png", "id": "1941120696714574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1941120700047907_511899241805437978_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p0YEndlMv4Q7kNvwFXB_7u&_nc_oc=AdoPIwquoYbM-sHSj-PFjxm9UEU6PHFDqU8iopa7z4szpr-YBlpX8L1_NSetVuGma20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzR8b4J0fi3LL5BDQyjhBoL2WT_vVza-qGsUTs2xj8A&oe=6B0068D7"}, {"file_name": "UB_5.png", "id": "1248579159976670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819300_1248579163310003_8317599004920694681_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfmj4r9yFoQQ7kNvwH4I7Y8&_nc_oc=Adob4kYQrZ6H1iQ2HdNaXOUcfwwnIcVigfJYnbJgMcIOp75frYYWWiSWBIiFdCQoACA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4zssnd2lz3wP9SXQ9ENs0mw8FWXpcfT6jXjIpoZBuOA&oe=6B006175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alpha052.png", "id": "1045706654440262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298291_1045706657773595_6910800927080218870_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoBBvDyYIl8Q7kNvwFZzRvV&_nc_oc=AdrDIz4ga4VNHdRk0ZIE-a9wm57uCbtQYJAsOi8QeZak2WRMH8zEnVZOenw5ID8xGZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSawYr_BruYyzTCWWmA-F9Yt96L4zS2wsXe4AdW61Jz7g&oe=6B005373"}, "display_name": "UltraBoxing - VR Boxing", "keywords": ["boxing", "fight", "box", "fitness", "combat"], "long_description": "# The closest thing to real sparring in VR\n\nFight ultra-realistic AI opponents that bob, weave, feint, and hit back.\n\nThey read your movement and punish a lazy guard.\n\nIt's a real workout that leaves you dripping, whether it's your first round or you box for real. \n\n{818140161236764}\n\nWhat boxers say:\n\n- \"I'm a boxer and this is the closest to real fighting/sparring that you can get.\" \u2013 endcole\n- \"The crown jewel of this game is the AI movement: bobbing, weaving\u2026\" \u2013 oculusboxfox\n- \"Feints being registered/reacted to is an insane game changer.\" \u2013 alealejandro73\n- \"The fighters actually move like real boxers. Great workout.\" \u2013 docproc.2024\n\n\n\ud83e\udde0 Smart, lifelike AI\n\nAdvanced dodging and lifelike animation. Every fighter reads your movement and punishes a lazy guard \u2014 no two move the same.\n\n\ud83d\udca6 A workout that leaves you dripping\n\nFirst round or seasoned boxer, you set the pace and the intensity.\n\n\ud83c\udfe0 VR or mixed reality\n\nFight in a full VR ring or in mixed reality, right in your own room \u2014 your real space, your real footwork.\n\n\ud83d\udd13 Early Access\n\nLock in the early adopter price \u2014 the lowest it'll ever be \u2014 and grow with the game.\n\n\ud83d\udcac Join the community: https://ultraboxingvr.com/discord\n\nNote: UltraBoxing is built around realism. If you want thumbstick movement and in-game stamina like Creed, this may not be your game.\n", "short_description": "The closest thing to real sparring in VR\n\nFight ultra-realistic AI opponents that bob, weave, feint, and hit back.\n\nIt's a real workout that leaves you dripping, whether it's your first round or you box for real. \n\nSlip punches, work combinations, and feel every knockdown \u2014 in full mixed reality, right in your own room. \n\nJoin Early Access now and lock in the lowest price it'll ever be."}]}, "developer_name": "UltraBoxing", "developer_privacy_policy_url": "https://ultraboxingvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UltraBoxing", "support_website_url": "https://ultraboxingvr.com/discord",
2932303565154413388_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v73FA4oCfCMQ7kNvwHd7yfP&_nc_oc=AdrLLrV4zu_-7uOMZ9Y29f5P_IQDmlUphml6dpe4Pc7NeI2aU11QVX2wDPGXbi4Dp2w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LLCSRGy9vn5EDTr91ymZF6dhcBq-oUbPz3ZXIQWDGIA&oe=6A36B4D8"}, {"file_name": "ultraboxing_05.png", "id": "1959935377795117", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75210898_1959935381128450_7436401260482591507_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2YaclRtZFQQ7kNvwFXC17x&_nc_oc=AdqtME9QLpDRuh1JAHHMAT72juY76w28gX8ymSLrgs8i6yjWSvV4Evj_ZtmGc-LVtn4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92bfgKyqzVnAu5409tGaJcg6fPMql4iK3Ujvdgb5w8IA&oe=6A369A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_early_access.png", "id": "1016741763372218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_1016741766705551_2640565472597873510_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VmQn8yr2dUQ7kNvwEK8LvW&_nc_oc=Adogc2wakGojIs2AKlXFzEZtz7TSwNOnlyeuKEit6G8X75qULVy0hjYo04Ss3aRA5Ps&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_ObQadYFTzf79iaAzwFGTzFiZgdWTqXVfBGtqv4rOkw&oe=6A36B9A7"}, "display_name": "Ultraboxing - VR Boxing", "keywords": [], "long_description": "[ EARLY ACCESS GAME ]\n\n\"Realistic and strategic\"' \u2013 rbdinsdale\n\n\"It's a VR boxing game with smart and difficult AI, unlike others\" - alexdt113\n\n\"This boxing game is more realistic than other games and has huge potential\"  \u2013 ashchan\n\n\"Its pretty fun already at this stage of development and will only get better\" \u2013 gabkicks\n\nExperience VR boxing like never before! \n\nFight ultra-realistic AI opponents with advanced dodging mechanics and lifelike animations. Dive into fully immersive or mixed reality modes for an unparalleled boxing experience. \n\nJoin Early Access, lock in the early adopters\u2019 price, and support the developers in shaping the future of VR boxing!\n\nJoin us on Discord at https://ultraboxingvr.com/discord", "short_description": "[ EARLY ACCESS GAME ]\n\nExperience VR boxing like never before! \n\nFight ultra-realistic AI opponents with advanced dodging mechanics and lifelike animations. \n\nJoin Early Access, lock in the early adopters\u2019 price, and support the developers in shaping the future of VR boxing!"}]}, "developer_name": "UltraBoxing", "developer_privacy_policy_url": "https://ultraboxingvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UltraBoxing", "support_website_url": "https://ultraboxingvr.com/discord", "website_url": "https://ultraboxingvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7645313852228443"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1403955764941688"}, {"status": "PUBLISHED", "id": "744862771983288"}, {"status": "PUBLISHED", "id": "1458422709104165"}, {"status": "PUBLISHED", "id": "690190420745720"}, {"status": "PUBLISHED", "id": "865412476209452"}, {"status": "PUBLISHED", "id": "1543644420233389"}, {"status": "PUBLISHED", "id": "24492089793792348"}, {"status": "PUBLISHED", "id": "1851543902025017"}]}, "baseline_offer": {"id": "1851543902025017"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1403955
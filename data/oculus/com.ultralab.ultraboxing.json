1_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM9EQpobhsQQ7kNvwEf5Nfh&_nc_oc=AdqZhk70yEnt_gNJGM2DzI0oiDpJPmEgC-I69xVpvpR1CQsix0y9YgBPU_gl8MiSr8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx5eaMEmzGMe-Wdg6We5d2d048a_yONEVFdZInPNbcFg&oe=6B05C950"}, {"file_name": "UB_4.png", "id": "1941120696714574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1941120700047907_511899241805437978_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBK1jhenQ2cQ7kNvwEt3AlE&_nc_oc=AdoCPDk2lnrO4o69Z1ozAHnIs0r1HZb9xGvUxeaWCT48QI0QH-Me_coFGocrBljmgD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSl0w0NWTD-i_iMAohsSfqvfknW2YV5_4FIvIbGwjPWg&oe=6B05AED7"}, {"file_name": "UB_5.png", "id": "1248579159976670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819300_1248579163310003_8317599004920694681_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a39F3OcFjZkQ7kNvwGEY_Ag&_nc_oc=AdqSvswZKe-MeiYO7Bk_RtI2K_gk8pbFddh9eRKLJ8xx8eNMX4ExAk983q2fBx31p5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDZuNfKM3gFe68HKY5a5PuLL95PHmUbnk_1J6razkFgw&oe=6B05A775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "alpha052.png", "id": "1045706654440262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298291_1045706657773595_6910800927080218870_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBJpVrBB3KgQ7kNvwEdjFrM&_nc_oc=AdqpyOfSnTOW2kACY9nIwamSYEztHFg5pEDRj1A6ryCYiss64nDBaNar5bDeDVQf54o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpW2tJOC_uKEOvkDaq7-WNTE6GwnLiYIo-vgj0kHU9pw&oe=6B05D1B3"}, "display_name": "UltraBoxing - VR Boxing", "keywords": ["boxing", "fight", "box", "fitness", "combat"], "long_description": "# The closest thing to real sparring in VR\n\nFight ultra-realistic AI opponents that bob, weave, feint, and hit back.\n\nThey read your movement and punish a lazy guard.\n\nIt's a real workout that leaves you dripping, whether it's your first round or you box for real. \n\n{818140161236764}\n\nWhat boxers say:\n\n- \"I'm a boxer and this is the closest to real fighting/sparring that you can get.\" \u2013 endcole\n- \"The crown jewel of this game is the AI movement: bobbing, weaving\u2026\" \u2013 oculusboxfox\n- \"Feints being registered/reacted to is an insane game changer.\" \u2013 alealejandro73\n- \"The fighters actually move like real boxers. Great workout.\" \u2013 docproc.2024\n\n\n\ud83e\udde0 Smart, lifelike AI\n\nAdvanced dodging and lifelike animation. Every fighter reads your movement and punishes a lazy guard \u2014 no two move the same.\n\n\ud83d\udca6 A workout that leaves you dripping\n\nFirst round or seasoned boxer, you set the pace and the intensity.\n\n\ud83c\udfe0 VR or mixed reality\n\nFight in a full VR ring or in mixed reality, right in your own room \u2014 your real space, your real footwork.\n\n\ud83d\udd13 Early Access\n\nLock in the early adopter price \u2014 the lowest it'll ever be \u2014 and grow with the game.\n\n\ud83d\udcac Join the community: https://ultraboxingvr.com/discord\n\nNote: UltraBoxing is built around realism. If you want thumbstick movement and in-game stamina like Creed, this may not be your game.\n", "short_description": "The closest thing to real sparring in VR\n\nFight ultra-realistic AI opponents that bob, weave, feint, and hit back.\n\nIt's a real workout that leaves you dripping, whether it's your first round or you box for real. \n\nSlip punches, work combinations, and feel every knockdown \u2014 in full mixed reality, right in your own room. \n\nJoin Early Access now and lock in the lowest price it'll ever be."}]}, "developer_name": "UltraBoxing", "developer_privacy_policy_url": "https://ultraboxingvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UltraBoxing", "support_website_url": "https://ultraboxingvr.com/discord",
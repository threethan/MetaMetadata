6_515338500623336_7465455355011960316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FlcMUjL2TMQ7kNvwERqx2Z&_nc_oc=AdrD9-HD3B5j1tmEP5KN2JvWW72p7_gBP-2-zyGKIfY2ovHHcPePNBsj1WlzcjEqRE4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L--MkZo5KpEZHHmbBiqVqhNrTrOfhj0A8EzEHPRS3FA&oe=6A033AD2"}, {"file_name": "RM-2.png", "id": "1304659184923096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314648_1304659191589762_485620222432298873_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoQYzuwhc8EQ7kNvwF_XPCH&_nc_oc=AdqLJG4aX8p5ZwWN3tOwOIno-effJ7s7nHeeBJRlKt2KbtndWFnk_GPM_IrimxkVQPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WOkU7ypUJcWces39JpT4PeArnTPSxR81Pwg-yiyiu9Q&oe=6A034571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoHeaderMeta.png", "id": "1175310229824307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86811598_1175310233157640_6086778125962899174_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKuOlcSlY58Q7kNvwHRu37z&_nc_oc=Adq0YuHwkdeYOH1-UlsZjEjd8q08epznXOvlNsX05I5_3_VIhc_6PgIu8UH9Y4fc4eI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AQq6Sfpg0O_7rhV0JnZJQtkJiM86QZxjSZOO4mdJhGQ&oe=6A034C0D"}, "display_name": "RUINSMAGUS", "keywords": ["JRPG", "Magic", "Action", "Anime", "Japan"], "long_description": "# \u201cLet\u2019s start a Journey! To our tomorrow!\u201d\n\nAs a member of the renowned RUINSMAGUS Guild, your goal is to help strengthen it with magic, resources \u2013 and wisdom! \u2013 as you embark on more than 25 unique, story-driven quests. \n{351937041257287}\n\n\nFace off against guardians tasked with protecting the ruins from intruders \u2013 and solve the deadly puzzles hidden within. When you've succeeded, head to the surface to acquire new items and upgrade your equipment in town \u2013 if you want to live another day, that is!\n{1298633201098030}\n\n# Features\n- Immersive VR mechanics bring the world to life.\n\n- More than 25 story-driven quests to challenge your skills.\n\n- Unleash 16 unique spells from the palm of your hand.\n\n- Raise your shield with to block enemy attacks.\n\n- Cast and blink your way through a stunning VR fantasy world.\n\n- Equip new armor, gauntlets, and shields to stack the odds in your favor!\n{3782892395315941}", "short_description": "RUINSMAGUS is a VR action RPG developed for Oculus Quest 2. Explore and cast your way in first-person through an immersive fantasy world. As a novice member of the RUINSMAGUS guild, work with the Enigma Research Institute to uncover the mysteries hidden beneath the gilded streets of Grand Amnis."}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/302743560/MWMwYzFkMjQyODc4NDk3M2I2MWRhYWFmY2NkNTRmMDc?atlOrigin=eyJpIjoiMDEzYzgyZmIxM2YzNGNhNTgzNTUzMTkxY2IzYzA1ZmYiLCJwIjoiYyJ9", "developer_terms_of_service_url": null, "publisher_name": "CharacterBank Inc., Mastiff LLC", "support_website_url": "https://character-bank.com/", "website_url": "https://ruinsmagus.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35002229979424394"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_1559934078563873
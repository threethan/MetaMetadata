al experiences.\n\nBridge the gap between physical space and artificial intelligence with Tectonic.", "short_description": "Tectonic is a spatial intelligence platform that bridges physical environments with autonomous AI agent workflows. Visualize spatial digital twins and orchestrate intelligent agents directly in your workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/86fa142b-cb3a-40da-96e1-bb070458e919", "developer_terms_of_service_url": null, "publisher_name": "Duot Labs", "support_website_url": null, "website_url": "https://duotlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1432188443311154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604317775_4441067682813148_2183534130554190579_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7mWnL9aMFMQ7kNvwEGQ_s0&_nc_oc=AdrCPVia4fAnwJiyzMrBq8SwS_kdcj2SPDDRSFzq0p3z_HTPTqeFlNcEEC1DwYxwdhY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm1LqhkWnTfc_Fe6bZns_Hh9_wAn6RBSamXsIHxnvFsQ&oe=6AFB3745"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tectonic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "
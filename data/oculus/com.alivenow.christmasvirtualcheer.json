e_name": "VR-Thumbnail - 1.png", "id": "6937477429622341", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035370_6937477439622340_7767983116593349206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n98vA9NntT8Q7kNvwGjOZ9v&_nc_oc=AdpSBMPJjE1lKu2LWZe-HSj1AEmfHDeCCRgYBAob0MTlerxJ85oKcD_Ru8nhdrFyqcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KEdzMiGXZ7EVTbPnNxLDs2JdHNwd6uZZ0EYyOSGJ-Wg&oe=69F20C41"}, "display_name": "Christmas MR Celebrations: Decorate your Xmas tree, Assemble Gifts & more!", "keywords": [], "long_description": "With Christmas Virtual Cheer, have fun with the amazing Mixed Reality Christmas experience on your Quest device! You can decorate your Christmas tree with all the accessories available. Play the gift assembler game by fixing gifts and placing it on the shelf or see how well you can arrange gift boxes based on easy, medium and hard levels. Have fun and share it with family and friends!", "short_description": "With Christmas Virtual Cheer, have fun with the amazing Mixed Reality Christmas experience on your Quest device! You can decorate your Christmas tree with all the accessories available. Play the gift assembler game by fixing gifts and placing it on the shelf or see how well you can arrange gift boxes based on easy, medium and hard levels. Have fun and share it with family and friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alivenow.in/MetaStorePrivacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "AliveNow - Creative Tech Studio", "support_website_url": null, "website_url": "https://www.alivenow.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT
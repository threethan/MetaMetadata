716lPjFrpoKPuSGIG5i8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvHPFXZ0vSwqSyEMSBc3VN75KkIpUmfPMSs11f-CsZyGw&oe=699ED861"}, {"file_name": "5.png", "id": "3851150991688807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_3851150995022140_5895250472335389604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwZIfxEb5B4Q7kNvwGxnUdz&_nc_oc=AdmzLqUrZQxlSCUKYjxdoVQdDjZEjgw3aXVg6Ms7LKR47JD3VY9xkD32ig0CLdUUzzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv_l72_tAUqPX32jx32IVt0xgLKEOY6gUcKNGRzVEIU-g&oe=699F0545"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner2065.png", "id": "833188112944592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_833188119611258_3929177890589792910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZe9eC-ZlS4Q7kNvwHBIwLL&_nc_oc=AdkRkR2KIwc0tjWBtcz5RrPSmzYpbplhVcbdqh30CtSjnQ5BO42qEi-hhF2fm3VHWTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftEorJPXeGPqZGmhgvj09nOwI286sIdgD2X9E8f_Y1XGQ&oe=699ED7A2"}, "display_name": "Unscrew VR", "keywords": ["puzzle", "Unscrew", "screw", "relaxing"], "long_description": "Unscrew VR is a relaxing and satisfying puzzle experience where you take apart toys, remove screws, discover hidden parts, and enjoy the simple pleasure of disassembly.\nUse your hands to grab, twist, and unscrew objects one piece at a time. Each toy has unique parts, colors, and challenges designed to feel tactile and rewarding.\n\nTake your time, enjoy the sounds, and explore at your own pace. There are no timers or pressure\u2014just pure satisfying interaction.\n\n\ud83d\udee0 Features\n\nRealistic unscrewing mechanics using VR hand interactions\n\nSatisfying feedback: sound, vibration, visual cues\n\nMultiple toys to take apart, each with different screw colors and layouts\n\nRelaxing environment made for focus and calm play\n\nSimple, intuitive gameplay suitable for all ages 13+\n\n\ud83c\udfaf Perfect for players who enjoy:\n\nTactile puzzle games\n\nSatisfying ASMR-style interactions\n\nCalm, focus-based activities\n\nShort, relaxing VR sessions\n\nWhether you're taking a quick break or unwinding after a long day, Unscrew VR offers a peaceful and addictive experience of taking things apart in virtual reality.", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201897639398456"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1488521572233731"}, {"status": "PUBLISHED", "id": "1462620581467988"}]}, "baseline_offer": {"id": "1462620581467988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1488521572233731"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26885587597696120", "version": "1.3"}, "id": "1406343191161761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
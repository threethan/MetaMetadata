t=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzzrTDRgcb-TtGRn09DE1YaB84i-o0crvb2WA1lzhD2ug&oe=69BFE02D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6jQQ3Ry5BoQ7kNvwFDDFUe&_nc_oc=AdmVvazM7imy6kyerp_JVf0r02AmgHeNcHw5kwupZMWlv0Zl1Pfp-Akilww8RlrFKXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnsOEV9M6Z7zcr-nTspdAOPc9_Xr_qfg1g7ZjiVOIlig&oe=69BFE91A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "relaxing", "unscrew"], "long_description": "Unscrew VR is a cozy, oddly satisfying VR puzzle where you take toys apart screw-by-screw. Pick up objects, rotate them in your hands, and dismantle them piece by piece at your own pace.\n\u2705 NEW (major update): Daily Tasks\nJump in for a quick relaxing session each day, complete simple goals, and earn rewards.\nWhy you\u2019ll love it\n* An oddly satisfying disassembly loop (slow & chill or fast & snappy)\n* Hands-on VR interaction: hold, rotate, and inspect toys from any angle\n* Hidden parts & \u201ctoy inside toy\u201d surprises\n* Perfect for short sessions (or \u201cjust one more toy\u2026\u201d)\nWorlds (included)\n\ud83e\uddf8 Kids Room \u2014 bright, warm, playful\n\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe (not horror)\nContent\n* 24 hand-crafted toys to dismantle\n* Screws fly into matching boxes as you work\n* More content updates coming\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop (common items available)\ufffdWraps, rays, outlines, base colors, and charms \u2014 themed sets for each room. Your equipped look is saved across sessions.\n\u2b50 5.0 rating \u2014 cozy, relaxing, and satisfying.\n", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26939860028935543"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_889137850455200_4130014856033965612_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPa9XVodunAQ7kNvwGbfFO2&_nc_oc=Adm6-3mlK3u7SVi-GiUnwPbeBWotC_aA9fYtEsVNZ4pzwb5-VhNJ8zgo12tvaBgE-nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9tjJYquzTQd7WEHSht41Ts96MtatM8frkXl9mEfR7kQ&oe=69BFD233"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unscrew VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1764860880, "lastRevision": {"nodes": [{"id": "26172284992359721", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26172284939026393", "is_first_party": false, "enables
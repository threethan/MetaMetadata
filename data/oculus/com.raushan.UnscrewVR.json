ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1420853833034918_6388293259070652166_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD9OpXQXhIkQ7kNvwFoIu64&_nc_oc=AdlXnjWmvbyGJqar0hbXBZjAkSoIjR7IfAX-r5QhpSQorKoGMKBbUKj1tjvITqCUHVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvTjFrfuZhF1mwBRj59NwQcQRqytRbBm4WqYsgmxoYdFw&oe=699ED217"}, {"file_name": "28.png", "id": "1430188735504948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_1430188738838281_3491539909404045795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJIu2MevVPgQ7kNvwGGfNuV&_nc_oc=Admh0sB0fbnzvp5RWgEGTsi0AWEGxuObUyoiACiorS4wxiDv73Gntv89tyuQRMCW0mY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfshK729GwiX-tGMMg4c37bxix9Q3SYFFfPx4r92MJfi7g&oe=699EF995"}, {"file_name": "22a.png", "id": "2108678506556317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_2108678509889650_1445391153025836268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVKzHNK-LwsQ7kNvwFp1LPG&_nc_oc=AdmXRS6LDsMHftpmbL5pI4CDNI20Ggt8dV3mcYmadHe-Rjuj37U_K2HV4Cd0JbY9RJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afva3H9sD2EEkboG8MCRQ7CeogknLbOxXbcKUNiFTRHx9g&oe=699F0296"}, {"file_name": "3.png", "id": "1635787717427364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1635787720760697_9080267137891876587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N9yOYuY_SsQ7kNvwHqUkdL&_nc_oc=AdnEdfAUhMRsjhEQg_xWAjglpVq8Sax1JV5UTl367gTo2pIPwKiHYPLbD2pJ3VsOPBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftKAK_qCkwaI2l6dBTiiJchsHbWcD3UdXM39Aia0O5lKA&oe=699ED501"}, {"file_name": "29.png", "id": "4412506235660297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823901_4412506245660296_36671098053330263_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqvsh7AiFikQ7kNvwG0BFVZ&_nc_oc=Adl3gs8qIo1CVUXcL4Wwn2vQQNr8gcmnxTgGYQCWxgMM-qBDEXXZzOpMu3oq-hrJVBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsjs1vkKbOrMPJz98YX9Atpusye0CF2rR3kQuMtCph6Lg&oe=699EEAAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omJzheiJVxwQ7kNvwFhRsLT&_nc_oc=Adno3oSTgnXJkWw6CQxWlGCW5oHkJKSTGBM-mA6WN7BRj6KGvBopDTqzfINt6aUEVcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuT9lQevB4of16pclWs_Bfc9kX7uWT4LCQw48WNGdFOFw&oe=699EF39A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "physics", "relaxing"], "long_description": "Unscrew VR is a cozy, physics-based oddly satisfying puzzle game where you take toys apart screw-by-screw \u2014 in true VR. Hold objects, rotate them, and dismantle them piece by piece at your own pace.\n\u2705 NEW (major update): Daily Tasks\ufffdJump in for a quick relaxing session each day, complete goals, and earn rewards.\nWhy you\u2019ll love it\n* Oddly satisfying disassembly loop (slow & chill or fast & snappy)\n* Physics-based toys you can hold, rotate, and inspect from any angle\n* Hidden parts & \u201ctoy inside toy\u201d surprises\n* Perfect for short sessions (or \u201cjust one more toy\u2026\u201d)\nWorlds (included)\n\ud83e\uddf8 Kids Room \u2014 bright, warm, playful\ufffd\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe (not horror)\nContent\n* 24 hand-crafted toys to dismantle\n* Screws fly into matching boxes as you work\n* More content updates coming\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop (common items available)\ufffdWraps, rays, outlines, base colors, and charms \u2014 themed sets for each room. Your equipped look is saved across sessions.\n\u2b50 5.0 rating \u2014 cozy, relaxing, and satisfying.", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]
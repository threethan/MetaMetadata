 {"file_name": "4.png", "id": "832008659540682", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_832008662874015_4241832845886769009_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ-hJmh-054Q7kNvwHsI0EZ&_nc_oc=AdrObZ0eRtosQFe9PCK5xYhXbulz_lz_8l53hO2lDU6H2c1q_ZML3No5DKHsoULiqLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7jbV6yyrSfSGVcMmQiSJVmtNp9kwB1b5KU_7f0JyuZA&oe=6AA2C821"}, {"file_name": "5.png", "id": "3851150991688807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_3851150995022140_5895250472335389604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siGlIe_05c0Q7kNvwHWR24c&_nc_oc=Adq4-pbAxd2myYx-JEwujG88l1QCYSpBLRuAgRtcYlCWWLixl2Yz6o41oi-69NtGnwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpHpNgzDXUu1LGdFqyod0CxXeuyqJ7H8c0kJ2faeyOqw&oe=6AA2BCC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner2065.png", "id": "833188112944592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821702_833188119611258_3929177890589792910_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrYkOCAjfmwQ7kNvwGKtdng&_nc_oc=Adp3j8Y7UoR1LMiKa6Q2mA0NIhC1O8x71UC6FFliFj9mdG2nv31mzYAce2ZxnO1JlQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_RPHSDkymJHy4psOW1FoiyRKEKxevcfn2u69dkNdyvg&oe=6AA2C762"}, "display_name": "Unscrew VR", "keywords": ["puzzle", "Unscrew", "screw", "relaxing"], "long_description": "Unscrew VR is a relaxing and satisfying puzzle experience where you take apart toys, remove screws, discover hidden parts, and enjoy the simple pleasure of disassembly.\nUse your hands to grab, twist, and unscrew objects one piece at a time. Each toy has unique parts, colors, and challenges designed to feel tactile and rewarding.\n\nTake your time, enjoy the sounds, and explore at your own pace. There are no timers or pressure\u2014just pure satisfying interaction.\n\n\ud83d\udee0 Features\n\nRealistic unscrewing mechanics using VR hand interactions\n\nSatisfying feedback: sound, vibration, visual cues\n\nMultiple toys to take apart, each with different screw colors and layouts\n\nRelaxing environment made for focus and calm play\n\nSimple, intuitive gameplay suitable for all ages 13+\n\n\ud83c\udfaf Perfect for players who enjoy:\n\nTactile puzzle games\n\nSatisfying ASMR-style interactions\n\nCalm, focus-based activities\n\nShort, relaxing VR sessions\n\nWhether you're taking a quick break or unwinding after a long day, Unscrew VR offers a peaceful and addictive experience of taking things apart in virtual reality.", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201897639398456"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1559652835123078"}, {"status": "PUBLISHED", "id": "1488521572233731"}, {"status": "PUBLISHED", "id": "1462620581467988"}]}, "baseline_offer": {"id": "1462620581467988"}, "is_approved": true, "firstOf
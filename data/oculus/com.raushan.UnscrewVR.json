 "1420853829701585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1420853833034918_6388293259070652166_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S5-zfUtDS4Q7kNvwH_hxz1&_nc_oc=AdkXk3Jp7nGCPSJaV0NDl0kiGDm5VmGDAWcvH5KTfUzY8RV9tG7u82Q2pr5GszK59GY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsfikub419WbXiPTH3Xxes4BILH_n78BSJzYk2LS4X1Rg&oe=69A80C97"}, {"file_name": "28.png", "id": "1430188735504948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_1430188738838281_3491539909404045795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg34Gt-rLbUQ7kNvwF5pSqP&_nc_oc=AdluSkPo3d_oXi3obcpVyXrSuVpggtdKUHIqhBcOd-iWiB9Qde5fe9xxKz2vdbG1yBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuWEC1iZY6MDrUfgHfcX7ImVUjgc7k_Y2Chve3ce8a9hw&oe=69A83415"}, {"file_name": "22a.png", "id": "2108678506556317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_2108678509889650_1445391153025836268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdOMMmaPeOcQ7kNvwEbszlP&_nc_oc=Adlok7c75oa3rteirfIu2gsv3esPLOYvoWs5ncwEJ9Eh-NvkEb1vnbrT2Wxx2epMH1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNQh2184UxiT8tQ69MBbgCGYGnHhvcDol8Uepa_sfS2w&oe=69A83D16"}, {"file_name": "3.png", "id": "1635787717427364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1635787720760697_9080267137891876587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hI51Eh-h0QQ7kNvwHjdMZ4&_nc_oc=Adm7NgiEtqQzgxSWmbN3kg0B1xU8fJJQlb0mWVc7__YlHdEkhnOnU8RBrtFWdIFNIDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfveIKFKT2C7Vz7BE1aMGOewWOKIerkw0cRZEbIaPZ0psQ&oe=69A80F81"}, {"file_name": "29.png", "id": "4412506235660297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823901_4412506245660296_36671098053330263_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV9yCPF-iOsQ7kNvwFeRxDK&_nc_oc=AdllqGu4qFHj2X-_XV2zwPPlaKnoTN7B_lv9khj9ZfNEJopDQZW5UaIanBpAcgDZAc0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsg-xUQXoyYksMukACrTGf9NbH0j2fFMg3jCyhz3IociA&oe=69A8252D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L7P9eefuuYQ7kNvwHTg2Th&_nc_oc=Adk_92ttGTD4QrJ0gxe2DFRRRv4hzuaQ695V1CItL4YhHsdUJ8y-hac8Mxn0a6FdxlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvW7HGiy1d97qztOrsDAR1IWKW1myyY71a_XBaj6sN1oQ&oe=69A82E1A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "relaxing", "unscrew"], "long_description": "Unscrew VR is a cozy, oddly satisfying VR puzzle where you take toys apart screw-by-screw. Pick up objects, rotate them in your hands, and dismantle them piece by piece at your own pace.\n\u2705 NEW (major update): Daily Tasks\nJump in for a quick relaxing session each day, complete simple goals, and earn rewards.\nWhy you\u2019ll love it\n* An oddly satisfying disassembly loop (slow & chill or fast & snappy)\n* Hands-on VR interaction: hold, rotate, and inspect toys from any angle\n* Hidden parts & \u201ctoy inside toy\u201d surprises\n* Perfect for short sessions (or \u201cjust one more toy\u2026\u201d)\nWorlds (included)\n\ud83e\uddf8 Kids Room \u2014 bright, warm, playful\n\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe (not horror)\nContent\n* 24 hand-crafted toys to dismantle\n* Screws fly into matching boxes as you work\n* More content updates coming\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop (common items available)\ufffdWraps, rays, outlines, base colors, and charms \u2014 themed sets for each room. Your equipped look is saved across sessions.\n\u2b50 5.0 rating \u2014 cozy, relaxing, and satisfying.\n", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26939860028935543"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_889137850455200_4130014856033965612_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8LjCC2-10kQ7kNvwH9tY23&_nc_oc=Adkl7mz4-To_EpV_aR7UIEC4gzawZXP1E-Ocv2HndFNmQZWtPFAyWuJYfXPWsixM-_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvGCu0URrq1sQET4y1KKmvmfYYuVcYHxajRbTmW6L0Hlg&oe=69A81733"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unscrew VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1764860880, "lastRevision": {"nodes": [{"id": "26172284992359721", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26172284939026393", "is_first_party": false, "enables
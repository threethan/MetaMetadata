 "1420853829701585", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_1420853833034918_6388293259070652166_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmzeS_8tewEQ7kNvwHXffAx&_nc_oc=AdmzbV4NfuSKec_4pWXgxOue0dgiwEUFHfaHkf4-kLFC2wMC2VNgZAnPyrbiUCPv_GM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz07jbhp5EnjmU_m7bc5Bh1RxB-e0a9Xd1xyaoVF6BnUw&oe=69B93017"}, {"file_name": "28.png", "id": "1430188735504948", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828806_1430188738838281_3491539909404045795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzinImUL1h0Q7kNvwHCFTm1&_nc_oc=Adln8KOMrKd6UhsUchnOHJu-fbdBsEPm9zuicH4EEukT8JMrppT0fu9me3UKa5qZaUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6Rs9FAX8RijTibbMwKPzzE0EHgVU8poRwjSC8wplxUg&oe=69B95795"}, {"file_name": "22a.png", "id": "2108678506556317", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_2108678509889650_1445391153025836268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSRK2AF9RrAQ7kNvwH5r4fM&_nc_oc=AdmI2W1NBWJVBBWJIGl94yvV0SO7Xdor9cGNIwlnnnud-SYrVDmKscMcgeVPClgWAvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIQ5Eb_AOSFx_2ruNRRAVi8vDVz_TZaiEd73GWltoefQ&oe=69B96096"}, {"file_name": "3.png", "id": "1635787717427364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1635787720760697_9080267137891876587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gINCh7ngwUQ7kNvwE5gmo7&_nc_oc=AdkfKqOvGcfBOLzsr2U5kxg8DLnFyanjpj9EZFTuyoadsk3KlkJn_QkNZ1q_42c9FHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjCwxQNY_yA83EpRXT_qVl1eT-n7RlIdB_JMfzK0pzzw&oe=69B93301"}, {"file_name": "29.png", "id": "4412506235660297", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_4412506245660296_36671098053330263_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FpXMwwzn5UQ7kNvwG1timh&_nc_oc=Adma3z0Qy0JrIBN6avenruwMVh71QvkB2djTRUgcA1mOkCM3bLGygV4tWedlrRdo2KU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBOd64RwfbJvagzDz3k1LayrSYdJd9f1seHK-7SwXYLA&oe=69B948AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSwvA_N4eToQ7kNvwG5hHsA&_nc_oc=Adl8Yd9pH7JYQ8AmzdK4qlg9S3b9zzMefQWwP3jPVUxP1wLHEIqapI2lRW0A0VZY1y4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8ARpD_wu1KSg1q1TX-_sBnBtY6U8wbIfogvqL0EDs0g&oe=69B9519A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "relaxing", "unscrew"], "long_description": "Unscrew VR is a cozy, oddly satisfying VR puzzle where you take toys apart screw-by-screw. Pick up objects, rotate them in your hands, and dismantle them piece by piece at your own pace.\n\u2705 NEW (major update): Daily Tasks\nJump in for a quick relaxing session each day, complete simple goals, and earn rewards.\nWhy you\u2019ll love it\n* An oddly satisfying disassembly loop (slow & chill or fast & snappy)\n* Hands-on VR interaction: hold, rotate, and inspect toys from any angle\n* Hidden parts & \u201ctoy inside toy\u201d surprises\n* Perfect for short sessions (or \u201cjust one more toy\u2026\u201d)\nWorlds (included)\n\ud83e\uddf8 Kids Room \u2014 bright, warm, playful\n\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe (not horror)\nContent\n* 24 hand-crafted toys to dismantle\n* Screws fly into matching boxes as you work\n* More content updates coming\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop (common items available)\ufffdWraps, rays, outlines, base colors, and charms \u2014 themed sets for each room. Your equipped look is saved across sessions.\n\u2b50 5.0 rating \u2014 cozy, relaxing, and satisfying.\n", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26939860028935543"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_889137850455200_4130014856033965612_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP0ta2A32KQQ7kNvwExnzWq&_nc_oc=AdkH4GqGNOMDQ2b3OuIe131qf7fBlVa1AygDH-pqdaCjOQ_s_C5xtn13zqJ6QYoKPAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5h43oseTxq_ATW5JtYpsEP6u_R1xleK_p1xc0xk1oMw&oe=69B93AB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unscrew VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1764860880, "lastRevision": {"nodes": [{"id": "26172284992359721", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26172284939026393", "is_first_party": false, "enables
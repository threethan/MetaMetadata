8vzoOdFskSDZ1o2bFFYF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdMQio0gF59gxTTvko3q6JR38JI9qApTI4-uD4-LRVug&oe=6AA2A22D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS9Uwvzz94UQ7kNvwFol7Az&_nc_oc=Adrldg1lB7XmJVfxgu1q-2xmdhlU3pO8L85wbcIKDN4rubbiFjD5R3ml7G8jPTATZIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7JkSlctTzZ05UkQhObh8GdDWu6qdjE9-azzb0zEhQEQ&oe=6AA2AB1A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "relaxing", "unscrew"], "long_description": "Unscrew VR is a cozy, oddly satisfying VR puzzle game where you take toys apart screw by screw. Pick up objects, rotate them in your hands, and dismantle them piece by piece at your own pace.\n\n\u2705 Major update: Daily Tasks\nJump in for a quick relaxing session each day, complete simple goals, and earn rewards.\n\nWhy you\u2019ll love it\n\nOddly satisfying disassembly gameplay \u2014 play slow and chill or fast and snappy\nHands-on VR interaction: hold, rotate, and inspect toys from any angle\nHidden parts and \u201ctoy inside toy\u201d surprises\nGreat for short sessions\u2026 or \u201cjust one more toy\u201d\n\nWorlds included\n\ud83e\uddf8 Kids Room \u2014 bright, warm, and playful\n\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe, not horror\n\nContent\n\n24 interactive toys to dismantle\nHidden surprises in select toys\nScrews fly into matching boxes as you work\nMore content updates coming\n\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop\nUnlock and equip wraps, rays, outlines, base colors, and charms, with themed sets for each room. Your equipped look is saved across sessions.\n\n\u2b50 Rated 5.0 \u2014 cozy, relaxing, and satisfying.", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27295150900073119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_889137850455200_4130014856033965612_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a4Vct53mJ4Q7kNvwGlnalr&_nc_oc=AdodT-9OzvKemFkbAwaA1XDjCBB25sl65b5LdpODwyGiikDuUdp0agdECSl5ZtmQtNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrdMUcKtTXHVlsXd1RKmc6nW3fkmP4GACfGyfFLHiWoA&oe=6AA2CC73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unscrew VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1764860880, "lastRevision": {"nodes": [{"id": "26172284992359721", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default
 "1420853829701585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1420853833034918_6388293259070652166_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wdJI7S4mxEQ7kNvwHAQZJX&_nc_oc=Adkk-0N33ugpr3s4Ne30EVTOzMTLfLo_96Qrahfz62TNF4GxszQVOm0fVHSLzrBpqog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEz7iwPITo6C-zyUy9UZwyunNtXFniBwOZH1VtUHnv0g&oe=69AEDC57"}, {"file_name": "28.png", "id": "1430188735504948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_1430188738838281_3491539909404045795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c03HJoJR9TUQ7kNvwEctVo4&_nc_oc=Adlj9_y_n9pxGmJKXRK6pxi1Jyw11RyIz7k9gm9PihwL-fmDp-vh0ZXiASjvr7dMPL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0RzkWrAscUyTvTCLqwoYBwXClyIPydl6DDpQ7rpmX9g&oe=69AECB95"}, {"file_name": "22a.png", "id": "2108678506556317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_2108678509889650_1445391153025836268_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTxz7vTKopsQ7kNvwEtLdP1&_nc_oc=Adn5bDWWF0M4-ylZ4-Hg20XgWv1LRA2HNfVQS9yaDJXrNfFGBdXZJT9bRNhUqQgWaRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycWEhwZjyKTz2AituihZbqT-LlUHclD8Y41z3Ih5rCAw&oe=69AED496"}, {"file_name": "3.png", "id": "1635787717427364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1635787720760697_9080267137891876587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93X7ZFfZgNUQ7kNvwG0qElS&_nc_oc=Adlxlv6jPefdEeY-U8wGbvR9_9Bhz101vwP_PWY5EAkc_ie2_a9ODYfC2GLe6m1ae9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0BJqZZ81-TRsA89S9iCmfieCgsHPMRuWz5OU6MuGt1w&oe=69AEA701"}, {"file_name": "29.png", "id": "4412506235660297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823901_4412506245660296_36671098053330263_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhhP-Ow4uOgQ7kNvwF69nJb&_nc_oc=Adl9X_dnCFuh6LurE_Yv1T_AZ4w0d23B9QyVtEvv-XqfsbFmNWHNiihGg2xaOITUNyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFMJsVYQXjW7kgNC6_3EwM8vEYqNIPgG60Fu8KK4piFQ&oe=69AEBCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2026-01-23 at 19.02.47.png", "id": "4272070023009569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_4272070029676235_1069954213262680705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Jf9R8UqAMwQ7kNvwF9ddKS&_nc_oc=AdkJZDeDrFtWpC41fshds9a6suAvIbZTy9GuGMaW-5aG8MCQJ7ZixYrReMhRX902gYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznHgOQkyhIJ4KtbaEw-ju1eSk5BtOz92azztrij6e3oQ&oe=69AEC59A"}, "display_name": "Unscrew VR", "keywords": ["disassembly", "satisfying", "cozy", "relaxing", "unscrew"], "long_description": "Unscrew VR is a cozy, oddly satisfying VR puzzle where you take toys apart screw-by-screw. Pick up objects, rotate them in your hands, and dismantle them piece by piece at your own pace.\n\u2705 NEW (major update): Daily Tasks\nJump in for a quick relaxing session each day, complete simple goals, and earn rewards.\nWhy you\u2019ll love it\n* An oddly satisfying disassembly loop (slow & chill or fast & snappy)\n* Hands-on VR interaction: hold, rotate, and inspect toys from any angle\n* Hidden parts & \u201ctoy inside toy\u201d surprises\n* Perfect for short sessions (or \u201cjust one more toy\u2026\u201d)\nWorlds (included)\n\ud83e\uddf8 Kids Room \u2014 bright, warm, playful\n\ud83c\udf83 Graveyard \u2014 spooky-but-whimsical Halloween vibe (not horror)\nContent\n* 24 hand-crafted toys to dismantle\n* Screws fly into matching boxes as you work\n* More content updates coming\nCustomize your look\n\ud83d\udecd\ufe0f Cosmetics Shop (common items available)\ufffdWraps, rays, outlines, base colors, and charms \u2014 themed sets for each room. Your equipped look is saved across sessions.\n\u2b50 5.0 rating \u2014 cozy, relaxing, and satisfying.\n", "short_description": "A satisfying VR puzzle game where you unscrew, disassemble, and reveal hidden toys. \n* Unscrew objects, uncover surprises, and master puzzle mechanics in VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://rau-games.kz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Raushan", "support_website_url": null, "website_url": "https://rau-games.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26939860028935543"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_889137850455200_4130014856033965612_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfgX-OwPeCIQ7kNvwEV8Ug8&_nc_oc=Adn4Ue-u08L_ouJtEUmV_iMmgnoJDee7A3Kbgf2YqHo2D0eto2lY7EmidKyAn16HJ-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzY9fMZK09xMLhEZnXH2e6YsNyXuHvtD9yX9UicTZkCQ&oe=69AEAEB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unscrew VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1764860880, "lastRevision": {"nodes": [{"id": "26172284992359721", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26172284939026393", "is_first_party": false, "enables
02&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQjia_d5v3gQ7kNvwFxihV9&_nc_oc=AdqKMJdeKSnl8OYhY99os77P7wkh3bdcLru3Yes5gg5rAX2v9H5wnPjZr70laKJHYE8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH7H9KsMoKED1WtdlGGF3bg7bO2GZ8xX0AVPJbW018Ww&oe=6AFF34EB"}, {"file_name": "5.png", "id": "1812463109323783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393455_1812463112657116_8633908569530080845_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjicGfM4ssgQ7kNvwH2IwOB&_nc_oc=AdrQQNRwidI1ylt45skQTD16E1ujZBggo7m1yE4jCFPg8AuWzIja3meu_rujDkluTHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx__QkqLVsxIChQgGpZRlMRBNVdouGwC8VEJB-HK5BgQ&oe=6AFF1DA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nature of Northern Mongolia", "keywords": [], "long_description": "Northern Mongolia is a region of striking natural beauty, where vast pine forests, rolling mountains, and clear rivers come together to form a truly unique landscape. The area is home to rare ecosystems like Tujiin Nars, a pine forest growing on sandy soil that helps combat desertification and supports a diverse range of wildlife.\n\nMajestic formations such as Zorgol Khairkhan Mountain rise from the plains, their distinct shapes tied to local legends and spiritual traditions. Scattered throughout the region are ancient petroglyphs, offering stones, and sacred sites, reflecting a deep cultural connection to the land.\n\nThis part of Mongolia offers rich biodiversity, from elk and wild boar to rare birds and medicinal plants. Each season transforms the landscape: lush and green in summer, snow-covered and serene in winter, offering a new perspective for every visit.\n\nNorthern Mongolia is more than scenery; it's a living story of nature, history, and tradition, waiting to be explored.", "short_description": "Northern Mongolia is a land of vast forests, rolling mountains, and pristine rivers. Home to rare pine groves like Tujyin Nars and majestic peaks such as Zorgol Khairkhan, the region offers a unique blend of natural beauty, biodiversity, and cultural history. From wildlife-rich woodlands to sacred landscapes shaped by legend, Northern Mongolia invites immersive exploration through every season."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8065390416918250"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2271055826752983"}, {"status": "PUBLISHED", "id": "1033726528757461"}]}, "baseline_offer": {"id": "2271055826752983"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773214200, "status": "PUBLISHED", "id": "2271055826752983"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8067372763386682", "version": "1.0"}, "id": "1023957993015439", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8065390410251584", "is_
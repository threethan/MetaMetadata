cdn.com&_nc_ss=8&oh=00_AfwBG6V9PfJ8K4axW-VMvm5J2L3O9qfpWFKW8QLg80SSwQ&oe=69AD6A79"}, {"file_name": "ss3.png", "id": "1879506515830666", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035337_1879506519163999_2429712081008591447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8duKZRJuz0Q7kNvwFnJSlR&_nc_oc=Adl1FxTuqU-nDx_M5__RKeHmqJNyrc6LhSQSlGN_52ivl0MeiyyxlccDXmI_n0G2Yjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8_R53NkGh1o_UaKa9VEUJ6ecFWzvkxU_GJOWVHLPxnQ&oe=69AD85C7"}, {"file_name": "ss4eng.png", "id": "1383262605715309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982496_1383262609048642_6915853167248882202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC7r_tZQGJkQ7kNvwGc1Jwn&_nc_oc=AdnvOxiwkuCTPQ-MawxMKIEc0r7j-wNCytiA6NCn7r9TAOjOvKZgOOmL7cXZ2mgFmOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSxM7qQF6G2XAzqdMYj3WfTauXKFYq3fsPRxW-UO5O3w&oe=69AD81A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mmd viewer", "keywords": [], "long_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software[MikuMikuDance(MMD)].\n3D model : [.pmd] [.pmx] file.\nDance motion :  [.vmd] file.\nSong data : [.wav][.ogg] file. \nOn the Internet, there are many 3D models, dance motion created by MMD users.\nThey are almost free, so download them using your Windows PC, and copy them to QUEST.\nYou can enjoy dancing with many 3D models in VR.\nAlso, this APP included 2 3D models, 3 sets of song and dance motions, and 3 3D stage models.\nThere are preseted, so you can enjoy without download, copy, etc.\nLoading the 3D model in menu tab P5 \"Marionette mode\", you can pose the 3D model.", "short_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software\n[MikuMikuDance(MMD)]."}, {"images": {"nodes": [{"file_name": "hero_sqrt.png", "id": "1558366228067701", "image_type": "APP_IMG_COVER_SQUARE", "uri
25/39001681_255823250858247_1800315508367017851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdkPaNiXLZAQ7kNvwHJmQE8&_nc_oc=AdqDGCdWFpR6tmcEhTeuQ-MNMES_mdDYog5Edozx5wakEHi4L-20x70i0we7ETgCG90&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVP6FpifCrelrcLplYhT3PZkx5YnIuyTDVRONcTi19jg&oe=6AA3F2F9"}, {"file_name": "ss3.png", "id": "1879506515830666", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035337_1879506519163999_2429712081008591447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hONnGz7GV54Q7kNvwGzZ5ZF&_nc_oc=AdrbnWdaxHsznWmbiS7gaWOEvtlR76iiTpwDj_Wl8ng4MjoR7o3BJganaoyWSwkJPRs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEUxqPj95WVYDSmQVVVxd1etGgNtskac_20h7viuUl7A&oe=6AA40E47"}, {"file_name": "ss4eng.png", "id": "1383262605715309", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982496_1383262609048642_6915853167248882202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC_uhwTEeMsQ7kNvwHJtmci&_nc_oc=Adqv8J1ifMXxxanXRjcS4Q4dv9_irVC3xQhjOc9Dcrd0OW42suXuBU_IIlNeaIxXt8U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK1J97228EqYiBPyKAEhO3FUmnt5CvLZbKqgPxaJjQsw&oe=6AA40A21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mmd viewer", "keywords": [], "long_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software[MikuMikuDance(MMD)].\n3D model : [.pmd] [.pmx] file.\nDance motion :  [.vmd] file.\nSong data : [.wav][.ogg] file. \nOn the Internet, there are many 3D models, dance motion created by MMD users.\nThey are almost free, so download them using your Windows PC, and copy them to QUEST.\nYou can enjoy dancing with many 3D models in VR.\nAlso, this APP included 2 3D models, 3 sets of song and dance motions, and 3 3D stage models.\nThere are preseted, so you can enjoy without download, copy, etc.\nLoading the 3D model in menu tab P5 \"Marionette mode\", you can pose the 3D model.", "short_descrip
25/39001681_255823250858247_1800315508367017851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-sY1iIN2SQQ7kNvwEU-fbd&_nc_oc=Adq66v4Z4tK1H5k_4xA4QmGksU2KFTsvScVTCRno9CUxKxMBTj-_LcS-2BqLbzpZvuM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJwq5k7uKZk6fO4BNyXk2PTTm6Sd3spC-fA1hUGbmaDw&oe=6A7DB779"}, {"file_name": "ss3.png", "id": "1879506515830666", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035337_1879506519163999_2429712081008591447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnqA7s7IC7kQ7kNvwEkj1VO&_nc_oc=AdpAy-NtArYCgoiBoa-71KOuvGJ3T5dO0VWC_X19WumvirfWBUz4s6tr3ozUq4cVQaM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa0thLkQcgAC9xoUmOlYv0j2OIBMZvTSuavRO-TFvgIw&oe=6A7D9A87"}, {"file_name": "ss4eng.png", "id": "1383262605715309", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982496_1383262609048642_6915853167248882202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0zXKnViz0Q7kNvwG8xPmK&_nc_oc=AdpixhApwJNchfeNrnn4D3PU-O19308qenA9dzkENSCQMqGYHHI2ywB4Uqo0BzpkK54&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlCY4daJfOytmewkARmmPghb2ZZoR7mkIEvFHHvjl8AA&oe=6A7DCEA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mmd viewer", "keywords": [], "long_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software[MikuMikuDance(MMD)].\n3D model : [.pmd] [.pmx] file.\nDance motion :  [.vmd] file.\nSong data : [.wav][.ogg] file. \nOn the Internet, there are many 3D models, dance motion created by MMD users.\nThey are almost free, so download them using your Windows PC, and copy them to QUEST.\nYou can enjoy dancing with many 3D models in VR.\nAlso, this APP included 2 3D models, 3 sets of song and dance motions, and 3 3D stage models.\nThere are preseted, so you can enjoy without download, copy, etc.\nLoading the 3D model in menu tab P5 \"Marionette mode\", you can pose the 3D model.", "short_descrip
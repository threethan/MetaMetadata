cdn.com&_nc_ss=8&oh=00_AfxCOZjd9_lmwyrDGcra6wML-EIj7qkWqUt-AtXhSApdEA&oe=69B7F679"}, {"file_name": "ss3.png", "id": "1879506515830666", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035337_1879506519163999_2429712081008591447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txmyy-DsGMQQ7kNvwGGwYJt&_nc_oc=AdnOD4hr4mXSsgG7ko8f7hPE1tbRjcf7OdghWHIBwa2lP8nolGh1GWegGvgTN9DOM9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkRbK6jGBsmaE3HHDbNyAleYbh7fLYVVmJvSWxrhik6Q&oe=69B811C7"}, {"file_name": "ss4eng.png", "id": "1383262605715309", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982496_1383262609048642_6915853167248882202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mWVy5lLAc8Q7kNvwGoziaj&_nc_oc=AdmIDRgvuhES-3GK9qMBX1_h9K8Hl2tI5PYzggtb1of_Wmy2_U0z8iS9ldICag9tDYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4nrrRGbjHL7UbOa6QGLHPWd90kF4WDvQvEv_Ya1j5ag&oe=69B80DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mmd viewer", "keywords": [], "long_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software[MikuMikuDance(MMD)].\n3D model : [.pmd] [.pmx] file.\nDance motion :  [.vmd] file.\nSong data : [.wav][.ogg] file. \nOn the Internet, there are many 3D models, dance motion created by MMD users.\nThey are almost free, so download them using your Windows PC, and copy them to QUEST.\nYou can enjoy dancing with many 3D models in VR.\nAlso, this APP included 2 3D models, 3 sets of song and dance motions, and 3 3D stage models.\nThere are preseted, so you can enjoy without download, copy, etc.\nLoading the 3D model in menu tab P5 \"Marionette mode\", you can pose the 3D model.", "short_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software\n[MikuMikuDance(MMD)]."}, {"images": {"nodes": [{"file_name": "hero_sqrt.png", "id": "1558366228067701", "image_type": "APP_IMG_COVER_SQUARE", "uri
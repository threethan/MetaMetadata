25/39001681_255823250858247_1800315508367017851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz3Lm5r55dQQ7kNvwGbbtIy&_nc_oc=AdoTL2Z50k69EtgihrX8QOtr4TBd-yT7dGl-Cugw9jlC-uqYghLN7MSxYUdR79lBYrw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIps5ttAmtFQdL4lxzBFe3XU5rFkokS6d4TkqiGldftmg&oe=6AAE7EF9"}, {"file_name": "ss3.png", "id": "1879506515830666", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035337_1879506519163999_2429712081008591447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9kiZMOhjH0Q7kNvwF4Oixn&_nc_oc=Adq_mXhVgLmuJciVJug8pY6zU5zsdul5ZgVX9eLv7dj2jOUPP8IVB4v-Olsh1DhN-J0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgWNQrmDtmq6ACo3fFO3rX3tM2hro7zCZsjXiEXif41g&oe=6AAE9A47"}, {"file_name": "ss4eng.png", "id": "1383262605715309", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982496_1383262609048642_6915853167248882202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4l2VZnvWzUQ7kNvwGGdwQq&_nc_oc=Adq3ThnDK-eG2XbxBykZChStAGU5quBSJZDPzbJDTOq0_ozIbm9aGJFHViLka2hrVTU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK293a5jH6RG7E4YOnHq0u5CPMq0tw60bS0fnLYNxuFfQ&oe=6AAE9621"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "mmd viewer", "keywords": [], "long_description": "This APP is 3D model viewer.\nThis APP is able to load 3D model for Japanese free software[MikuMikuDance(MMD)].\n3D model : [.pmd] [.pmx] file.\nDance motion :  [.vmd] file.\nSong data : [.wav][.ogg] file. \nOn the Internet, there are many 3D models, dance motion created by MMD users.\nThey are almost free, so download them using your Windows PC, and copy them to QUEST.\nYou can enjoy dancing with many 3D models in VR.\nAlso, this APP included 2 3D models, 3 sets of song and dance motions, and 3 3D stage models.\nThere are preseted, so you can enjoy without download, copy, etc.\nLoading the 3D model in menu tab P5 \"Marionette mode\", you can pose the 3D model.", "short_descrip
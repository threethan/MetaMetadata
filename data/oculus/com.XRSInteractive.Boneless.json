n{3669989183213932}\n\nThere is also an external camera for video recording.\n\n{457804259952906}\n", "short_description": "Boneless VR is an experimental Virtual Reality physics sandbox game built to test the limits of what's possible in VR. The game features unique maps, unique weapons, such as guns and swords and multiple enemies."}]}, "developer_name": "XRS Interactive", "developer_privacy_policy_url": "https://sites.google.com/view/bonelessprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "XRS Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/bonelessprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26222508400719030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974910_1170945560991342_2190084726796334121_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qSiwDbfcCwQ7kNvwEMILGE&_nc_oc=Adq9vLaX0g3RldVwbRGkbJJBVGTGA67MxHLXHMXy0QvxH5ZAnhoT4CucEs0XOtOcz14&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShfzfd3NqNooNx0uMl5vg6KzsFXDeIEP2x3VzaOrbzuQ&oe=6AFB28EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boneless", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
A9F8"}, {"file_name": "HighresScreenshot00008.png", "id": "946184541783205", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/654867655_946184545116538_366564984145373785_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zqtqw2S-1s4Q7kNvwGWqf5-&_nc_oc=AdrBBRLgaDlg7L9fDDz5vSoLwBEMacLWSeJjZpDcGHYEAKmRd6_UTnXf9txTnAYPhXo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-gnpDkK3o0slSZix4hL8HaMSXMI8Zc3nT-Yi4IJy6jw&oe=6A329AEC"}, {"file_name": "HighresScreenshot00005.png", "id": "1708440607004831", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/654862493_1708440610338164_2356079420539984233_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77X6zib8f7UQ7kNvwH7u0YE&_nc_oc=AdqcXZQheTOXsb05RDUxDtXncRBVqwmDOvQF7zVjJahIDTTYiQnf6Yw_ONCHi88DIGk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vc2fkPrHGbIq2HmtXdXYs0GjL6j-25WMGI5ofHM5-dA&oe=6A32B749"}, {"file_name": "HighresScreenshot00006.png", "id": "3396619950511085", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/604282317_3396619953844418_5989006564066268463_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dciNBXNibcQ7kNvwGexBOW&_nc_oc=Adpkx0W0GA6qzPta1oTivL613WmWB3oYAW57IYcGzC4Dz-UEMrfRzhNbsmCJHHqCvhU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N_KkprV4afkZythLcikleconC1-io5r2Ii68sAbTMJw&oe=6A329104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Energy Storage and Management", "keywords": [], "long_description": "Energy Storage and Management is an immersive VR training application developed as part of the ImmerseLearn Energy Storage and Management micro-credential program. This application enables learners to gain practical, hands-on experience in a safe and interactive virtual environment designed to simulate real-world energy storage operations and procedures.\n\nThrough guided simulations, users can practice essential skills related to energy storage systems, equipment handling, operational workflows, maintenance procedures, and workplace safety standards. The VR experience is designed to enhance technical knowledge, improve learner confidence, and support workforce readiness through experiential learning.\n\nThis application is intended exclusively for individuals enrolled in the ImmerseLearn Energy Storage and Management micro-credential program. Access is restricted to authorized learners participating in the training program.", "short_description": "Energy Storage and Management is a VR training application designed exclusively for learners enrolled in the ImmerseLearn Energy Storage and Management micro-credential program. This immersive simulation provides hands-on training in energy storage systems, safety procedures, equipment handling, and operational workflows in a realistic virtual environment. Access is limited to authorized program participants only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1589194673207338"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/595143057_1300763255535046_909129921083092237_n.png?stp=dst-png_s360x360&_
t=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUh6MjbOPkMCiEmbyWfQDT7dh0TJVxCEbzl_O08X2VREA&oe=6B10486C"}, {"file_name": "Screenshot7.png", "id": "906847520228498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69GDd8FcF64Q7kNvwE9RYY7&_nc_oc=AdqSNy10CW2knG06d6SggY7PjbJnVXN7-_PkXrD7cJPxvVn5Oq1OQygQYwy6-sX7Dbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCnF7BKZcNrto3F6gdGB_zKG3k3uU431mAI21xFyOsDw&oe=6B103D3A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loK68X7w3nwQ7kNvwHsLUGi&_nc_oc=AdoX6pjOgmQDkzwFI1zKUgfuI9n0dfRA2D_OeC_wDESiCcif257W_6W1B2uanMMAjus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVee5nGa48RgaOKK4BnGGornBkPNTmoPs3eu5h-5DO-eQ&oe=6B10367C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jScEqHx3msQ7kNvwFLvYie&_nc_oc=AdojLE4ROpixeuN61mozJNZ_5RAo60BAcQa4bbXSs7mk55Q48oIododZMN3PwghtMIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWEAzsf-K-aubcLa9kFKwiKhROE2MT6RzqlwnCzDELB6w&oe=6B105895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsADN_8IoukQ7kNvwEr8ycg&_nc_oc=Adrcy3ntQQgD8LZv1FDSCMaEu245m2MaMGiy8TfmUeYR-3lcRlxsENYaXdy1qmglo_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyaZo-2zfjF1uAkWMJpwohOGMMUxhjzdWPrDgOMZbi7A&oe=6B104A13"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SI
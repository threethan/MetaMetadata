IWk6Bx-m_AAPuJDGd-FWOzK91-3Qnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNT88OK-p0dJAciDT2SmXrtK0ybw381Cx7_5lOYV04PA&oe=69A6C33C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03PQMkJznncQ7kNvwHFyv5u&_nc_oc=Adky9Cg_OnjVUuEukWA3_stmAVh26nPLLBJYj9XDMTYIzsYutG4LQiaQG81-xL_jelw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujZvUxVb1nIBbHXM_G6yzumVMEo_LNWYImkHYWZ-sDfQ&oe=69A6E555"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6HnWvGYjcwQ7kNvwE7xM_s&_nc_oc=AdlWbTV4ePNBDzu58ezCgmSI2dd8RJ8Om29sf94nKNZ7qFbXctvGdm-JxdVw9sHqoYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2CfWjg6hyTUhuvdNyqvyBYtT9c5_-DW9iqCEwOZY3Zg&oe=69A6D6D3"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4859378930820876"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "423411266407090"}]}, "baseline_offer": {"id": "423411266407090"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1658768760, "status": "PUBLISHED", "id": "423411266407090"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7660442467307876", "version": "1.50.1"}, "id": "357922729264885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prim
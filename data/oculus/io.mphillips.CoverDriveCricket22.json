t=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeMmzSJ_NYbbvTIfjnhrfj8JytnoaBEbIHihs8OpKEMQ&oe=6B01C7EC"}, {"file_name": "Screenshot7.png", "id": "906847520228498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwjBHPeeSOoQ7kNvwGPWgfp&_nc_oc=Adrt1bpDf9p3tZ4eKPuyBCMuCmN9frV0e9wHSN-_v05sFwDPuO2JaD1faFQ3Mw2Pi5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ6UX2th52_BF89v6V6uigrswuyTIser2JOdicCtDi6w&oe=6B01BCBA"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ_lsl7pmnkQ7kNvwHuDx7x&_nc_oc=AdpihM1ye4IOjc02bbuPkBoVyRIgPBM4xsafyxvpkPC4EHCit8murp4ByKie78rEqNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ21QHntjxIvrng36g0kJlmHCOnoQ-iZOMsMmbXmkmgaQ&oe=6B01EE3C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swArt9Ft8dAQ7kNvwGZrwHB&_nc_oc=Adp19B4m0Pt79BIWWsc0NpM-EGpGrdiQIq29ZsrDEZDgu77LG6QYEVNOlGLAYEQnY4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsm-as2KeMoCAzmydhl6lpx4siZUqypZliQpBI7rL0Pg&oe=6B01D815"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT4BTQgF2z0Q7kNvwGTzD19&_nc_oc=AdquqLiF8bmBk08MR9ZToVC9no48zMiJe7Zm5_XXxct1rrqxAQswl9MwPTostYdhJKU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi3_SYK1uvrUfR4vJaqSD9X2JaWcsm9aoatW2GliP7Ig&oe=6B01C993"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SI
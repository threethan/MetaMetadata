Fj4blS&_nc_oc=AdmmPbZbPTzwc-OWeyclxtnZz-tjACHrMvNTB6PJIQNqcIGy4riO9CpgFLO4bg8G2Ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNzHuyV0mKC0HhVtgg3UOmzDgWLq8d2CZdjxNSPRfk9A&oe=69A0327A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkaWseRqx5sQ7kNvwEHanZt&_nc_oc=AdkMdz3had_1Q7SLbrSGycphJWbGg7fFxBN2pLG9fmLlDzwFjWHo8JLypLLXx9nMLRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvEeqCZVAMPN_bcY74tWpbNZwl0n84Xy3BjfYfGRfFBw&oe=69A02BBC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXD0vCyZnv0Q7kNvwG-a6j4&_nc_oc=Adk856f4i3mBxee2EGvUtadw_LhxoMJ0EjulgOuSdqSCgD8tqYheWXUCq23ZjOtNPms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlEkvkducHCnj3F_FpCuUd8UYVi0d10XOvuOqSzVrxpg&oe=69A04DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH32W4eC06MQ7kNvwHk5BCD&_nc_oc=Adk1EQLAzwNkwu5Yle-Xu9-_B_Wf9xXOJ5sj3JUgTmgU-LjpmeSGkRPIrMPOA6UZwVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4ThbGlLYqJ45t1tpvQHUSDe41Dd1qwy9NsTze2chMzQ&oe=69A03F53"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "824614125428797"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
71-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5wmIke3NV0Q7kNvwE_7Jz2&_nc_oc=Ado22Y_fYKtFca1ECZLKLk-jAsXCPoRsvWXLZ5mVwOQfP1UGld8M7rcrV5Bt4omjAe8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcLN87eIvoXa1TdOIBgfLzMHRYBeETx6aev2GLNuH_qA&oe=6AC517BA"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtQpW9vIEyMQ7kNvwFJMPdb&_nc_oc=Ado2bbyJ_3Dl1qLHi3kGC_sCapvz09hzswNRfeeyDSCBuXY6LCUDGNgcQIiXSOz3UdI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbbdUJ4Aufw8-r2XkmNsyZQLeBrtJ_YlsWF28gcaqifw&oe=6AC510FC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NORMUpUa37MQ7kNvwGabjsv&_nc_oc=Ado8p1oAR7q4mIKx_0eKve1f36uzcg8Pz8zMVb_slQfGyCfGqKqAn7tQ-Of1QBzksiw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcYjsv7DvbrUuBhUpTQ0q8L2PNiFsKsWOmAvR5G6etKg&oe=6AC4FAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIXxErYEn98Q7kNvwGCfL5R&_nc_oc=Adoeq5lG3eajJe3JcMpYler0OObTph5DC5SHREysY6S72xNr94Sqy5LOB3Qz3w0Dfr8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD9zlMmCJydCAe3a-UomSC2paXOVhFRqdHu4oEZjnAKg&oe=6AC52493"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"],
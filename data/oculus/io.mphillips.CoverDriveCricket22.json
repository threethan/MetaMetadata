t=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD2FBwtTDpEShpG94U3UdewAsTetKbMPGrTrdtHwuV0w&oe=6AFB306C"}, {"file_name": "Screenshot7.png", "id": "906847520228498", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvhnJ2IcH5sQ7kNvwGBLNdq&_nc_oc=Adq4O3Y5GrwaiWsppuHQgQz7H9I6HARUq_FA9Ejh269q7Z9k5FzQrh_iMQzu9_Ta6xQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkkVm4UwAoLPqvNfgHlNiop4gPH9fKGJcij61JJmRQOg&oe=6AFB253A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlGliEdzH7sQ7kNvwGaa6ST&_nc_oc=Adrimgx2wgdFrnIgm8kt6F63TX80yWWvVv5oZljl-F8gFLMkuHtcDyhafUwN1i7KSd4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9-_cg5UDPz6viHYLyl-_1kDQSTGDB3e_krkI2_DSrLQ&oe=6AFB1E7C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp9yHTlE2GQQ7kNvwFqBruB&_nc_oc=AdoT8SNMo9fx7h9jRQgMm_hoOIlAn9S1IbaJB9VyyZ6vo97ajwWi1HER2t3--z0tlwI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFq7eKv1blNl2okyAPP-mtUspGIAc_RNb2RaH8zKMS6A&oe=6AFB4095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_gHN6JrpIQ7kNvwGiplB3&_nc_oc=Adqr_tJj1mstCKeIgpJmjS2v_9KBEc9Pa74VGp-_cBKmGQ2ZOp_bG4QIsgMA0uTF4NA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSivSnFTM2ZFrnJeLGFKTfjC1sVBkUDVPqynrwl4jFiSw&oe=6AFB3213"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SI
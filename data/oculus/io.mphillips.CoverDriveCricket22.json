t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrEQo8QGad3GXp3gp6T5Vw6BD6vgBoOEMvha-sNQJ5sA&oe=6B0DA56C"}, {"file_name": "Screenshot7.png", "id": "906847520228498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfBGW5VX3LUQ7kNvwFKTETp&_nc_oc=AdpWqYGAWuyKGDU0fYMLnmVXmNOxKg-wD5T4OLbGECKXvd6C_CN9A1P1YE7Is51QmCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsZw1lnNQIUFrFKGI_ZUeQvSILsYoB4W2ScJz8JL9hOw&oe=6B0D9A3A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNT3mbZQBYUQ7kNvwF9LG2v&_nc_oc=AdpZ2DEGYCd3klElIpZTZJV2xSk2dN0GHM_HaR_r-mQ-vRP_NxprgDNpLxK8q-li99w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKELTAa3kbduQqY9nmrb0Oa7UYWMoBSsU-QgCirQ9k0A&oe=6B0DCBBC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A61bPi_4cEwQ7kNvwHEE_0q&_nc_oc=AdqSl7xpVWfT-makyWM8EtFoGH_hbQfxejVapXnwDOsH3pY1ntwfEEZ5C98JzveccYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZOUsHSOcfWsguIpo6jhHKJ4hlZfH_yOKtev_Z2lsnpA&oe=6B0DB595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjXKWcE0AXUQ7kNvwHgRFiG&_nc_oc=AdqPC4a9bU1cTFX3n1O4EEo4jwJNaim7cZoZdwcpjcRp24KzZw5nNl9DvrqtRoWN0EM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSb6L5Tj1QePjNHFbaH0afCeL7zEgcRc1z0m_nq5o47Ww&oe=6B0DA713"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SI
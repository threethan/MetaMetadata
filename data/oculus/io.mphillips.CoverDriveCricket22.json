71-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkq8LZGlK98Q7kNvwG6VieK&_nc_oc=Adp2Ec7fcxqYcu7N32dnOvEa2HtucSPtVvEIcnGc6ZBZVZHSJF8K9HH8K4Jod2ZBbVc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyEYhYKnO3bGZg-P0QBfCR--1-r9aA8_aPdINNuOYbKA&oe=6AD3983A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzbxGVudtm4Q7kNvwFOr0dI&_nc_oc=AdoUc8mOJXGHiCH9QFxDSvdtcHR3r7Txn1JJj1ztB3BSlaS_oFiOfO3btEVrnhu9YeA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEB6SNrWkGYRDe43q9c52XZgJiixIFW_mCC1kgCcvnbw&oe=6AD3917C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl0iqoknTJ0Q7kNvwFAhyEx&_nc_oc=AdpNnDu2cy0lS5DBQqKND8Sk8acuVW0rurg3wsCf1QRin_WIloqqFC38P42zi7h5JFA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-y2xw9sTDmjzVuvHt0LodtN4Y5YfKj4c71-QFG_khiQ&oe=6AD3B395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTO4gI-yLxYQ7kNvwHH9Zg_&_nc_oc=AdoTMEuddzh1Sna9JYLkDwkfKLnV-4k0L-CpVpPz54p-UEM0ocK98ahP0vOwvVB5seQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZxmdbVzvO7OH9rF5S-acZqW83NmFNbhc1GfdkfSharg&oe=6AD3A513"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"],
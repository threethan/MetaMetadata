t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLkvoT5qxxrL9Hj2SlI32egXggUCmyi-I0NAKEdXMvqQ&oe=6AFDD36C"}, {"file_name": "Screenshot7.png", "id": "906847520228498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvhnJ2IcH5sQ7kNvwHvXc5Y&_nc_oc=AdqReUdF8fDimNdI8GcBQJJPi1cMOkHE4rAhe6qHiuDL3dj86Zv8lPHCSruD6F13OK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwxGgx_pR8f1fTaU5zQFkwWF8AyIDsUZeNTNKLDC6H8Q&oe=6AFDC83A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlGliEdzH7sQ7kNvwEIoqf6&_nc_oc=Adrv2vCqFh3tvLsek2LMNme0iLrWs08P_WXrb8F7Q0uT1SD-9yB67oA1rvfkEcq3zIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxAQ1Dys0UXq4I5ypHoWBWjeVn20XtYxzeF7CvJhCyhQ&oe=6AFDC17C"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp9yHTlE2GQQ7kNvwFGXs4l&_nc_oc=AdoS3M38Dj0azbKKqdAemTpmon3rVhYnnUbaLBIWK3Zw7cmOJIwaLINDbvxNKZjuiSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTS2fQ-9qUowh6aOW57OxhtPplYmzGxZOn9dTomBNCg&oe=6AFDE395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_gHN6JrpIQ7kNvwF7Nwyf&_nc_oc=AdrJftdsK3xvjaVDymoUeyIyN8bhMtnswECr_LdKxRXKLqOA5Man3ktrH_LQM_PBnb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy_UkwuHQ3KcAwYPr1oQRwLhpm7nH4tfu8BKCkh5X13w&oe=6AFDD513"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SI
71-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz2TC2VvPL4Q7kNvwEyyPqR&_nc_oc=AdpLpnw2FdtF1gGzlL8-jB6EA-qURV9Tg2D8Q-TwZ5f6YzBC9T_Oxbco8tJD64EtTcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9mX7Ehc16wvpoLHzojSg9vInvGLzu1TpOpg3mm-YSSw&oe=6ACA5DBA"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBGU4x9j0n8Q7kNvwEunsM2&_nc_oc=AdrWSuZ64NQsw8p_YZprZ-Tl_5718NF5zTQPpwf5qahDjCl-Wqml0uK7Xow8QcXLT2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOpQ6djK7Auklkid6WyzXD2k_034hAWSQEhwpYbbUNdg&oe=6ACA56FC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gQNVQvmlCQQ7kNvwHXLdMs&_nc_oc=AdqeNqIMwKv4Pg7BxDBwfvDYSnHhW0ysFhSuDIHF951UwOkvScNbideiESF1V2EPnmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxrsLLMyLjRXl64krBns5fOjz4HDOtrmloct56x6rWtw&oe=6ACA7915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHjFy53lk3cQ7kNvwFB1T7E&_nc_oc=Adqjz6ZF9FyVxIqRqxQgNwiw1-fQfckiyiDHoEEhv8mxXzAxm7xxH956JYKxuSXfy-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkaPv6_w5EBq7WGoCyjGPsH4HjpQqvOS-ClgF5huu0xQ&oe=6ACA6A93"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"],
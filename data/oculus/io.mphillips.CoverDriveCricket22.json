31_5187790799498299354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVD6GscXwEYQ7kNvwEh0Ma1&_nc_oc=Adme1k9_gJIc4eb3KZwj15zAbAIr5_J8ku8MfG_-4598eWz8Y0YWZkQ_hlrfzg3RiyI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9LKLPVj5DF2EykWOuLLXmbbFqYWq15NJsIZqmtIQncg&oe=69AABE7A"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKmysNSMuw0Q7kNvwGIsjFF&_nc_oc=Adkg1cg-jCfkWdJYaVryMkyFpY1FgE5DpJuPuTaW551xA4EEMLNn7L_QGvfLCvvq8Bs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOpPspOqMhWY7VfdGzqf6nvwWsWc9YTTO0OOjfPgx6kQ&oe=69AAB7BC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwxKwh-eJaQQ7kNvwEcVfNs&_nc_oc=AdkQa8useNs-ZCMnzr1ayqltx7KwIBeRZk0wob9Vm3JLZgAC-iRKryRUIIJRD25oIg4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEgcFtu1jeCkOsLcZ-XFYGCCejv21KGNDMJU_k1XEGtg&oe=69AAD9D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOukRK6Pxt0Q7kNvwGtVkCU&_nc_oc=AdllGlaZ6lYyVJh80D_AiWgpz-56xXp6Gpa-M_nSqVwMm2E9Gyn_7p1YKPOOif9w6kI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzulAKvgn11NA0uEJIxBg87I8hDObPqgOxf4yYPN_zMjg&oe=69AACB53"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
71-25/75371510_906847523561831_5187790799498299354_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdojQVGbj9gQ7kNvwHR5L7Q&_nc_oc=Adp74ENnvwI1yB9dzP3IFHZa9rjLRbOqfh9jrOcnlV__Iv_nJF-DUBPBzcWTR1ug_E8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WjzpUjMwwqxc2DCNb2bEyTaw053TB7efGxsG9apjOZw&oe=6A2C29BA"}, {"file_name": "Screenshot10.png", "id": "866787014220123", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75314849_866787020886789_8737656666218146974_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBdNB4y3tqkQ7kNvwGzW8fO&_nc_oc=AdqKQt47jWCzv34Jk_kHvLB2xvUsmh9PNsO_FCptFpbYF2JJ_qZVNhy5LG9H8FdTuA8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QYTCfMSD0_ufGFVRmixAWZHdjPwHhD1Mzg-cup9ayWg&oe=6A2C22FC"}, {"file_name": "Screenshot2.png", "id": "1013789546032675", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75534976_1013789549366008_7876335602803416625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW5joWB0le4Q7kNvwEOOktC&_nc_oc=AdpsgKtgdomulh15KaoqsiHDTZZ5ZT4C9mz8Oo3lTcVZCLVeUd-h6FsXSQk31YPQBpU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qCHek5WFD9ElqbNyePubeiRAxC2-CM3W56H8T4Ic65w&oe=6A2C0CD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape2.png", "id": "1009792546497224", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031354_1009792553163890_3758226238892144121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWZYBSRyPssQ7kNvwEAGOGm&_nc_oc=AdooxVaFy8a6k6eq7Hd_NK-7L-FDI4f8CSC8k1ctN78E5OGeQjN0AKUxxhixj3_lVpI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j1AYY0Ho5ZBRiFHzE_LDfhaB1iiNJhvH5ahC-rtoHCA&oe=6A2BFE53"}, "display_name": "Cover Drive Cricket 22", "keywords": [], "long_description": "Missing cricket and wanting to be back at the crease? Cover Drive Cricket puts you at the heart of the action!\n\nSet huge scores batting first, or prove you can handle the pressure chasing down a target. Test your skills against a Challenge, and try to survive against a wide variety of different bowlers.\n\n\"a no brainer for cricket lovers\"\n\"I LOVE THIS GAME!\"\n\nCome say hi! https://discord.coverdrive.cricket\n\nIncludes:\n- 10, 20 and 50-over games against AI opponents,\n- Super Over, Survival and Target challenges (plus Spin-only challenges!)\n- Unlimited Practice,\n- 34 bowling styles and 5 difficulties,\n- Track your stats to see where every delivery hit the bat, where your shots go and how you can improve against each type of bowler,\n- Play against your friends with real-time chat in PvP multiplayer,\n- Left- or right-handed batting, with vibration feedback,\n- Play with your real bat,\n- Leaderboards,\n- Achievements,\n- Replay mode - replay every delivery to see how you can improve\n- Fireworks!", "short_description": "Cricket, in virtual reality. The most true-to-life cricket game on the Quest, featuring the widest variety of bowlers, difficulty levels and game modes. Track your stats and improve your batting game!\n\nCome say hi and join the Cover Drive Cricket community! https://discord.coverdrive.cricket"}]}, "developer_name": null, "developer_privacy_policy_url": "https://coverdrive.cricket/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cover Drive Cricket", "support_website_url": null, "website_url": "https://coverdrive.cricket/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"],
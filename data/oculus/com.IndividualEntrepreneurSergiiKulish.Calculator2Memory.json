_sid=6e7a0a&_nc_ohc=s_tau7H_tygQ7kNvwGzc4hK&_nc_oc=AdoD1yQTdgm5944z1L3KxFJgrI4ESlCDtY_BbZINcbWyIdttG3JRQTzcLBlMA5pXkTs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2kmJ2OXCM_7VtqaFZem7WlQoWGe2OGU8fHP3xwzYp6A&oe=6AF9E128"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5K1NPr8LcAQ7kNvwHaUh5j&_nc_oc=Adrbhm_zL994uLLgVJxXQ3DmQGcCSyPk09vytQo1PUuR7Hi-yRYMa1LlC1ftqnvrwLY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHBe1L6Ag-Qd0ChaBFpUzXiM08mdoSm_vhJzWd-huobQ&oe=6AF9ECA2"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzEMfe8tf-MQ7kNvwH9W53y&_nc_oc=AdrGZMnMA54P7n-ZroPd9FgHnAAvG1V9-of-yREfQPG-bAKtqVekGdd5BqdBvW0ioNI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2LOoYxO1f_2dyYwZf4f2n5TlHTiL4aqvfFCaYm0w9UQ&oe=6AF9E6C6"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Um-PVpVShsQ7kNvwFjqle0&_nc_oc=Adozu66U3T03w70ecS7Jr03uzXlc5O9nrIvmmhCCqJOzF8otXFVJYH020dV7k7T4BJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2K-wgSoZSRTxyrUBOFwTfdegDRwH1P4-5lmfLEGzm5w&oe=6AF9DB5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab8KonIfDKkQ7kNvwEqBI4J&_nc_oc=Adr6IsAa_I_Y9jQwPeOM45-0FoE-W7yGVPsOKMz0sc11ILe6J-um20VOPtO8Cz-4nJg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYzp1n4OdqGzxJyKjliysCsOkDo-qpSfgXsBCULpBsjQ&oe=6AF9B721"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
_sid=6e7a0a&_nc_ohc=ntgzTfCPF8oQ7kNvwGpoyAB&_nc_oc=AdpVO9jTQyTGnwP9g_4DzPhJpU89TNgNAtLVstYNKol102rdLu63ILEsJ5JLUSXUHeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHdRM9K9XrwrxkbfTf-b8WQ5cCvhNMTc527JJGVgU5dA&oe=6AE490E8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0atfOF8GRAQ7kNvwFiWHX8&_nc_oc=AdpTgk0DLr4K0pbz8rj7jRcDXOokQ6Ppyy2Fr7IFoQPfbiBmzMl91bwDInwwH0ztUn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLTCEcKGq6ahmBWWh__8ENVVYgvsQmMD5jTvO5y2d0-A&oe=6AE49C62"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNZOV7FauQ8Q7kNvwHfZEZ-&_nc_oc=Adp9a076H_69WlA4SNgZsf6jFotfKkSnn3VCYc_wp801EAzXd0tYlftTXwYBbRbVPC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPw9eE_4Hw7tAhvlGxwYufmI_Z-NqcfA5cfe8boej8Sw&oe=6AE49686"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsrDBi_CtAYQ7kNvwGUAuo7&_nc_oc=AdrfH58zKz4K8tWrXNGIsH8t6TvfgvyNJwuLRiV0gBB_chgEn78I5bQxINcZAFAQdgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjcMsd09Wye-33o5zDfQNHaZL0eNKzdvfG_kIIJpdXZQ&oe=6AE48B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQSapCJ2y8IQ7kNvwH3UI2s&_nc_oc=AdrFhJDOldoSNKoR59V5Er8qnVMC6jW8Cy8CxyqWN7yh2pom4tPpH0J5rV6jF5hbFGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzzQDO5xRnEf4O-eOw0AFfY16tBM9CQwpAc_d9vIRUGQ&oe=6AE49F21"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
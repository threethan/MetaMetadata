_sid=6e7a0a&_nc_ohc=XC_O37bKK3UQ7kNvwGhKBSU&_nc_oc=Adp5JaaWFLJfTl2PqZgGNFoCiKnZOqgkAMxabypjKF5NkZBd5Oh4C8KIVRY4LdgDMSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG-hnSwtIrvGS3EL0ZOk0kcVzuOblhKRDG_Nrw-bA3pg&oe=6AD3A5A8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrQpq6K2veoQ7kNvwEIdee6&_nc_oc=AdpFshaLCEL8Ksu-scVFig5DbPML-LSPbcvE1EWrAvUvmkfwng3l11-4Zda801SpWYw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQyOTlgyrrxRrrtO9RMkh0gbDuY9mWlK94oiRsHH-1pg&oe=6AD3B122"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0KRv9VuY1kQ7kNvwGfMH_c&_nc_oc=AdpnrIQorxIhfobGOYXzIvRw0MKF15oJzDXAp2m7SGQM3zxoyVM1kKZJfCA6exNXBto&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGESrXLBPeAwKNblb5PT5lUFn0z-uRPd2VIqt_Ltwilw&oe=6AD3AB46"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkSoo3bTQAkQ7kNvwEv9z67&_nc_oc=AdqdinbuFJe_VZx8k91GpqTUeDBxkFEwGmQ5-R5xWUodMD8_-zBppExmWEoJz5WBDAc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm1TMbHNvSRuPbt3aK32MGKdbuZ3rFfFWOuu7rsgvqTw&oe=6AD39FDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-l0IqNuEScQ7kNvwEnT6hu&_nc_oc=AdrV1gErF-WKXhqvwp4Vx15uX1u8eQJ5MiVZI-EkWlnMfPkL6H6dgDgeSDxcE_rJ72M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFRjL_geum6iPgIjRTSqKZ6ULtW4sMBiWGT_gbPKFUJw&oe=6AD3B3E1"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
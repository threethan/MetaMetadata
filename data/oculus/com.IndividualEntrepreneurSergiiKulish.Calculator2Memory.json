_sid=6e7a0a&_nc_ohc=r3IHl1AKXP0Q7kNvwG71B7d&_nc_oc=AdozqAZjKidH8O1X4XFstW5Z9OqsR3YSXLYWEcjaYRIuq6K7amLxzcyyeWAaf7nxsI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Kjc_vrfHxr3-xnSwZouUqoz9qt1IwDT8djXibtSwNw&oe=6ACD0E28"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOrM87hdmdIQ7kNvwGbspjo&_nc_oc=AdrzJ1TVD1BIAxDWcoS5aM-9qe2jVf-yGiws5ZIBKsoLk83NMDuSooBstWJZH56Z7oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyoLBf7hrSdp-oUN19hT4Yfce4jhbPUZwqsgBezklCxA&oe=6ACCE162"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfFCUAD3oB4Q7kNvwHCw-_X&_nc_oc=Adqf5PGhWKD_6axHJ0EUezufLu2BxwrqCZQe9n4cYXh-MT9SjW-N8VYaB3YzE0kWd4U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsbpvamarv8lsN5xJwPR8kFmZ7ZdHFjgakr_GlWfiehg&oe=6ACD13C6"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pHKPhqW5PoQ7kNvwEQZ9UL&_nc_oc=Adppll_aehV3xh6fI-u4eK4dFSVkCBVdwNdBsqN8opfTTHUnU5r1AVACLKJxpYYreik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgj8_XqHpNVEaLPgxIC31v4Cl8qi4n1xk9gu8Z-Fs2pg&oe=6ACD085A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtF9jILxaTYQ7kNvwFtMDOH&_nc_oc=AdojXWEOt7T1cYw3HeM5FFJbGaKVUThrIjPy4wij0YIfuTic-YTXziZLbMrLNAFNs-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuRk_Mm7pd0hGOtW_QSW30-aSolArtn81MaoBapPq_4w&oe=6ACCE421"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
_sid=6e7a0a&_nc_ohc=XC_O37bKK3UQ7kNvwG8hIbY&_nc_oc=AdoUuPw_m3VivZRWp_0qAhp48CH-iKTxJrjlIqr7IJz8Yp0y00-n8-oo9IStBjf2x2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB_ZUnJ3tHJtQHhsnxBP2ZqAZdyEN_xWWfyxKdYC4ULA&oe=6AD102A8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw3POD75z9IQ7kNvwHKY5Ry&_nc_oc=AdozgNONNG3KcHyuiU2VbfSHwNcyGV5cZwKrmBOmyO8e4t0eHmaI8eSXEnM4sdsDIWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMleEvNhJnA7hiSuIe_PiR_pF3iruu1rQe5oIuT_2eWtg&oe=6AD0D5E2"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQr_tk7Op6cQ7kNvwH0gTwz&_nc_oc=AdpoMoRFpm5Cn5csjOFnqkvw5z-oxFUIiK493iXXxcpbBR7dJm2bqs4OWuQiEa-8O5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCnVrcD-1I1BAqTuu0mcgvRFVNG8-u-_F4CWtoGjL7Qw&oe=6AD0D006"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04H0WYoXx8cQ7kNvwF8KIOg&_nc_oc=AdrAtcOEcxy4cWSsHhCRY4ZnwX2PDEKZHOL-wvT6W6YxnuiCsnYNHRCvhYP7WGkRBlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb6zou4FhE80gW2pzyl10gyoJ25DElSGp2hOibd0szWA&oe=6AD0FCDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3hPXsINWPcQ7kNvwFOrIQb&_nc_oc=AdqDNVRF_xkc6v0D0mmxc6dQiW4dMu_9JzVTt9Nic8we8gka_a6ZvjeuUJwH1RQxXck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQyTuHOQF4JhbKaqx3_UgEHff0R2D3gy3xwdSac0Gocg&oe=6AD0D8A1"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
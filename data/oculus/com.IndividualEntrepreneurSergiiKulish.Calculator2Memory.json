_sid=6e7a0a&_nc_ohc=4Z4EK5eiIlsQ7kNvwFIvNPs&_nc_oc=AdrK3Ql3zTiejvMDFwOeECIapi6UaVlZxLiiyE5O-OLfah-S3Wadckdqu-O6MaTmsys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPtOmqW7aXmKcOtEUd0iFBSJqQFmNTHrXlI32l3ehFuQ&oe=6AF5ECA8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpHqozOBE0YQ7kNvwFxYXr8&_nc_oc=Adqns3s8Z0eI3n_wPa6BzlqZ4FwxNA19BZLkoggbT5H1k2O0NfXQyyUgRHF4i081mHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSScbRkjRF7XWkkbjanjLxSjKEuA8GFEKR_1BYVVcs0wg&oe=6AF5BFE2"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuQ1C-W9p9QQ7kNvwE8rFOX&_nc_oc=Adom02iVjC8jp8UEO_1kAOkPT44KuiIZurUV3N3IusBB1iEGB6y3Dj4PStLbVuIBMpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ9QP6ibRdQTpmXpwv-O1CORCkNMZgk7PyFg7qlafgZg&oe=6AF5F246"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MkHqPaoe7UQ7kNvwEEFzvn&_nc_oc=AdpTVEO3FhvtsuVFSPzkPR1CjxZM91D1Qd3OevbdOMby4AbUf0t2nbvq5K8VsxcVKBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQypIZ6uYOmkyFTGxSynnqax8DND6JbB4eGkXQw1Vw7AQ&oe=6AF5E6DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lajekm7SozIQ7kNvwE_c2M4&_nc_oc=Ado2he6o16mw_b_MAIav3-DU7M-BYaGIaXmGiJAUJE_EbwvfbDOSeJeZ1gLZsXJ1nXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA9m5ZtTGJUcI6rCWcDfKCUVqpZZj9_hHjCJpZGzEW3Q&oe=6AF5C2A1"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24078917151743994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391892_664749129445109_4946171028246235498_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=200PNkCencEQ7kNvwHyuzlC&_nc_oc=AdrjPfWYVvA4t80nPsomw7rv3u-5s_y_JTk4QBk3bydup0vhdSdtHre9fFHy_--XVjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0pGcMMUKiFglX2XGez-rd-w5K-_dPTWEHGGVrZuVLlQ&oe=6AF5E108"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calculator two memory cells", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1742845140, "lastRevision": {"nodes": [{"id": "9303752429687043", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9303752386353714", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3545817609052749"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CreatedBySergoutback4Transparent.png", "id": "1882322565675333", 
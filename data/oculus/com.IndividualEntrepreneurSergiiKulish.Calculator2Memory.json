_sid=6e7a0a&_nc_ohc=VHgLTgvYmsYQ7kNvwGh-5Ii&_nc_oc=AdpmAkSA6NQaaPOdaZ0TIAdKvc5P7Vg2QK7R9lyD9dglAZsOhd-qAaTwqSaw84XNSzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSelJdjpmHHTAzygvZfUQ27VtcEAWuVcOLyK8WG-tjxDA&oe=6AEB60A8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISvUnh8d4hUQ7kNvwHT_K8-&_nc_oc=Adqy6uCMTZS17ry2THcDcfSzZpnr8Wlt8JUgGBjRea860XFzxPFkOI8BcKwX8GixDxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUIqxrcZ2_kfmGtS_rlLb64u03AqVZ19t63SUAaDuiqA&oe=6AEB33E2"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QgZzH3PbV4Q7kNvwEv8Zxl&_nc_oc=AdqkcOx8rTJzsFns1h-dRdBb3XZw7mr-kd75JlsTIhT2TuFUVDnc8snCOAlTgpyd2gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0CZyLEPOCvQRaR5YDmDfhDPDZSkSONpssgMjO2kcDxQ&oe=6AEB2E06"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3IQq21tHZcQ7kNvwHQSQeH&_nc_oc=AdrMadq3RBDYnkc02hbXvAyE-k883XgdxMCeW9lS8uTRDxcugc_mFTvfq3fmKSUFSz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGpbY-zKOuBjMy8Y0wgl67-3g9VUy-fPGwRLZaKF2PUQ&oe=6AEB5ADA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghdX6jL1YXMQ7kNvwHpQ9Yb&_nc_oc=Adq5sQeMelvrHMwvM3zomegcQRJqY2bLblYRvE3h3PElY4m_f5iyECmJqRqTS9Y4vSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW_UwSbYDlyl72d7Mpxd35NkhtVtrQml1iBz9ZlTBfPA&oe=6AEB36A1"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "c
, {"file_name": "Calculator_4_2560x1440.png", "id": "1434205387820638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822495_1434205391153971_2568401136587248495_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qitPPEL7V1oQ7kNvwH9YP0P&_nc_oc=Adqu9HhHmgp4WucHix9aZwkZpdx1Kg19QJc6g6v-46_mHx11iDrEd8pGp95MlY4dwBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9H8AJx6hFTZm1jOX1KWYBzJCBoPh6IXPXpfDLELft3A&oe=6B031BA8"}, {"file_name": "Calculator_2560x1440.png", "id": "1371893943916288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820987_1371893947249621_456840990864085795_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx6ToJj_ljYQ7kNvwF_1jPQ&_nc_oc=Adqx1fJhBiy2nDGMKTx3cia-ZSWHN232GJdj5-QhC5SXY7_a1DvjuyKR_pXD6Gxvg20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7GWrGC3nhhWEeB0B-goFDj6efo2WB_phZbMmqqUQ6lA&oe=6B032722"}, {"file_name": "Calculator Two Memory Cells 2 2560 x 1440.png", "id": "1848434082576408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1848434085909741_2709126891936435548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiaTtpoDqzAQ7kNvwHojQcl&_nc_oc=AdqqblOrK7te4ooWJL3Vvy5GMrqJwF-hYD11HDV8G_PJgT8UKE9JAd6UJxFO0dpR1SI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW3WfVzHNoiBrfUnd_mHJ4A0TvhPC7XbtLj9M8DmNlnw&oe=6B032146"}, {"file_name": "Calculator Two Memory Cells 3 2560 x 1440.png", "id": "741038088455266", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_741038091788599_5843595559296521184_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gprQEMhrtB8Q7kNvwE-9RgB&_nc_oc=AdojiJwghDKCkKoWun24Nl7y7WPQVWDQYsUe3ZpUvJoBj7GgPF-cxMinydGjq-hDuEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYKV2uHNTT7-xdZTCynIN_ekFEFsSVb0trV52Aya_k0Q&oe=6B0315DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Calculator Two Memory Cells 4 2560 x 1440.png", "id": "1141123477217178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392005_1141123480550511_7944056824242099643_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rar_XMdeM7oQ7kNvwEBiU6U&_nc_oc=AdopXQStPsXF3HJdgNmF3iaQMu1Gp-IY-JJUF3Z0mM483lzdpXGRuezIJGP9WGGmcAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3bogPZA29WfOVGsw4WzJu9y_36vsy8z7kc2Hl1stnAg&oe=6B0329E1"}, "display_name": "Calculator two memory cells", "keywords": ["calculator", "math", "quest3", "utility", "memory"], "long_description": "**NEW v1.3.7**\n* **Scale pop-up** \u2014 wrist-menu, resize the calculator from 0.1 \u00d7 to 1 \u00d7 in one tap.  \n* **Apartment shadows & colours** \u2014 minor lighting tweaks for softer, more natural look.  \n* **Player movement** \u2014 free locomotion: **Left Stick = move, Right Stick = turn**.  \n* **Grabbable calculator** \u2014 new collider lets you pick up / reposition the calculator in VR & MR more comfortable.\n\n---\n\n### Why Dual-memory calculator?\n**Dual Memory Cells** \u2014 store & swap two numbers instantly for complex chains.  \n**Intuitive UI** \u2014 big, colour-coded buttons you can hit with controllers *or* hand tracking.  \n**Basic Operations** \u2014 add, subtract, multiply, divide, percent.  \n**Precision Engine** \u2014 28-29 significant digits, range \u22127.9 \u00d7 10\u00b2\u2078 \u2026 +7.9 \u00d7 10\u00b2\u2078.  \n\n---\n\n### Quick Tips\n* Turn your wrist \u2192 slide **Scale** to resize.  \n* Tap the **Passthrough toggle** at the wrist menu to enter Passthrough; tap again to return to Apartment.\n\nNo personal data collected. Requires only the *PASSTHROUGH_CAMERA* permission provided by Meta XR SDK v77.", "short_description": "Calculator VR & Mixed Reality \u2014 resizable dual-memory calculator for Meta Quest. Switch between Mixed-Reality passthrough and a cosy VR Room, crunch numbers with 28-digit precision, and store two values for instant recall.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-calculator-2-memory.html", "developer_terms_of_service_url": null, "publisher_name": "Individual Entrepreneur Sergii Kulish", "support_website_url": null, "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24078917151743994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391892_664749129445109_4946171028246235498_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHujjPJmoIwQ7kNvwHCDxFc&_nc_oc=AdpIw6NZ18HRqOtBpS3GJ6Z57ez7lX9mhZ1pH20fIur8fSKr7kRvPApy8VaeWCL2HsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSleGHtNnxoPWZbgsJclu07FXZLDiKiFQz8t0A3aMeOXw&oe=6B031008"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calculator two memory cells", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1742845140, "lastRevision": {"nodes": [{"id": "9303752429687043", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application"
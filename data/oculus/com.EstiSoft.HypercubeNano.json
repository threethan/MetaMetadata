FDqomw&oe=6A858B65"}, {"file_name": "ss4.png", "id": "2089860094887151", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824292_2089860098220484_9012006939827353590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIzivIllKKAQ7kNvwHd6a7S&_nc_oc=AdpGAlqiJVorMD49vDrEDqUxvre4vGmgJbapGbH0IrOl_P1XpUS0OBv0Y_b4JtU1d-w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxzGXGJ6Ie6AZpYTiNPyH-HIiusvBPnx7aSvxKcYhfNg&oe=6A8591FE"}, {"file_name": "ss5.png", "id": "2139676803436147", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828038_2139676806769480_717139991994205999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6siGydla1NYQ7kNvwGUZRGZ&_nc_oc=AdorDAzGxPe5nX7FCSZ3ksbwXvzSk9NuyaoAgrCAx8TIMZe-fHY78D_4NReQj4-qZSE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFS6wUlN4OdjgDA7l9PjvBS-TlU3lW7FK5yB8U0-OA9g&oe=6A857B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1416508536883737", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822327_1416508540217070_3738951529957428882_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNDTXFEFaCkQ7kNvwEzKjUy&_nc_oc=Adpw99E5uhGzyQpo7wrpjQjjfeZgc0RdcdqX1yNvjt30faed05glj6hktWnzDgS38-Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbFO1tbILHGbZaxyKAkswFg3nllpWkMYu6O5F0G-CZhg&oe=6A857C9B"}, "display_name": "Hypercube Nano", "keywords": ["Casual", "Neon", "Nano", "Hyper", "Endless"], "long_description": "Hypercube Nano is a straightforward arcade game where your goal is simple: move forward and avoid the red blocks. Navigate your cube through an endless wireframe tunnel and test your reflexes.\n\nTrack your last and best scores directly on the menu. You can also change the tunnel's grid colors whenever you want a different look.\n\nFeatures:\n\nEndless Gameplay: Keep moving forward and survive.\n\nSimple Mechanics: Easy to pick up and play.\n\nColor Customization: Change the grid colors from the menu.\n\nScore Tracking: Try to beat your personal best.", "short_description": "Survive as long as you can in an endless tunnel. Dodge the red obstacles and beat your high score in Hypercube Nano."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25932856766416278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820441_1625566218644649_927420142133883624_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7Dw8k66BSkQ7kNvwGLr6d5&_nc_oc=AdrCE0PFSySqxQY6xtOdLVkSvkqIen1MLdU-tdGH75a8mcc9WhQ7eaYmPrVMyuImaDY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkrc0sB6x5wwPf2dYdKHIXLt1Y7J-u5GdgtTnEapjU6Q&oe=6A859326"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hypercube Nano", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 17744
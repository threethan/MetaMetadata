ainment only. You cannot win real money or real world goods by playing. Chips can be bought in the Store, cannot be cashed out, and are only used for gameplay. Le Casino is for players eighteen and older.", "short_description": "Jump into a fast multiplayer casino, vibe with new people, level up your game, and grind your way to the top.\nIf you think you\u2019ve got the skills, prove it in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/nomi27951/9299934663b40d56b80434da70026167", "developer_terms_of_service_url": null, "publisher_name": "Intisab Inc", "support_website_url": null, "website_url": "https://fb.com/le.casino.fb", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "32393680490279812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_25822692280661282_703413071013577895_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zusa2bswo4gQ7kNvwH5y7rv&_nc_oc=AdkkpMIUFV7EbsWf5MpZ9kSgWQYRPP1BzvCKWsinSr8RvE0XK2S6Cq1_i-JT4yMchVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqaCT_CFqzGveFFJG6KzriNyHCoFTbRcay6PArI1A5Dg&oe=699C653B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Le Casino", "platform": "ANDROID_
3244508656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404233_3756013247841989_8313590061236056444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itWUvN0aqfQQ7kNvwHoi3Mk&_nc_oc=AdrkMrn8-lYIn4rpaRdeoxkBoJtlzhNk_rVnsLVpJwhZZ0dTO5OkF1bz3Pqt0uVp2oA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_RL-7VT483aQgIa_W4EPHYuYkMA06fBNq7vBiz2D35g&oe=6A19B7BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "blackjack (1).png", "id": "1254038809564622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_1254038812897955_5767184285058047530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL6lWSIUpfQQ7kNvwHDgIzq&_nc_oc=AdrpPQrfIOatALCVVmtuRtqNlgl4ivQIwGjKoP69bDoxHRftu5vGXTKcJf_x9UzQbnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LjnjVC1ZIR4FE57Yqk95m92NDqYvy-JrBEjmg7c_dXg&oe=6A19ADDC"}, "display_name": "Blackjack", "keywords": ["blackjack", "baccarat", "casino", "simulation", "poker"], "long_description": "# MULTIPLAYER BLACKJACK, BACCARAT, and POKER!\n\nLevel up your skills, get better with every game, and hang out with new people while you play. It\u2019s free, fun, and the perfect place to sharpen your strategy or just chill and vibe at the tables.\n{1172544441090247}\n{736273008822085}\n\n**\u2666\ufe0f 10,000 FREE CHIPS ON SIGN-UP:** Start with a big boost.\n\n**\u2660\ufe0f 1500 FREE CHIPS EVERY 12 HOURS:** Stay loaded and keep the streak alive.\n\n**\u2665\ufe0f VOICE CHAT:** Talk, joke, and vibe with players in real time.\n\n**\u2663\ufe0f AVATARS:** Drop your style and stand out at the table.\n\nJoin now and take your Blackjack, Baccarat, and Poker to a whole new level.\n\n{1967748304125710}\n{697735416741966}\nBlackjack is a free online game of chance and skill for entertainment only. You cannot win real money or real world goods by playing. Chips can be bought in the Store, cannot be cashed out, and are only used for gameplay. Le Casino is for players eighteen and older.", "short_description": "Jump into a fast multiplayer casino, vibe with new people, level up your game, and grind your way to the top.\nIf you think you\u2019ve got the skills, prove it in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/nomi27951/ee3d058d7c9134c36b9a2d73b89c83c6", "developer_terms_of_service_url": null, "publisher_name": "Intisab Inc", "support_website_url": null, "website_url": "https://fb.com/BlackjackVR", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35377289985252166"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298221_2464291930675027_2013219529549827953_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6s-mujOOBoQ7kNvwHF5fCM&_nc_oc=AdrM5JyvLZCD-IdctvM5RFtm6wQfxMiBSOcVlVPyltZlL0UgqpWjnGxdgMPgqRPPplc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5K47OX9gnQAxDQSeTjwqhluVVZOPqPy46BUjSIyzqRMQ&oe=6A199111"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blackjack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Hangout", "id":
content-iad6-1.oculuscdn.com/v/t64.5771-25/75404233_3756013247841989_8313590061236056444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKNoWqvH2-sQ7kNvwGrtTco&_nc_oc=Adpm2dTWR7W85B0jsMSCMKGEm25FIO26_NIZQ8hRnYqzqN9qoZnMBPg6rJnKWzq-vVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z_cG_QqLAtmQ2aPOfbLTDDWj1Kx-lt3xohQ9WjCZ8tQ&oe=6A05B8FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "blackjack (1).png", "id": "1254038809564622", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1254038812897955_5767184285058047530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2nnwaCDOwoQ7kNvwE1-XgW&_nc_oc=AdpPcacNTLZNDyOi8tiwsHzBjrMyMhwLAj4v4jIv8mX2rgx3hTRs0AStFQQG857eLpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ng0S7K9rcaEbt4yzJ97oE4AfBwsw--scHDD91QWr2XQ&oe=6A05E75C"}, "display_name": "Blackjack", "keywords": ["blackjack", "baccarat", "casino", "simulation", "poker"], "long_description": "# MULTIPLAYER BLACKJACK, BACCARAT, and POKER!\n\nLevel up your skills, get better with every game, and hang out with new people while you play. It\u2019s free, fun, and the perfect place to sharpen your strategy or just chill and vibe at the tables.\n{1172544441090247}\n{736273008822085}\n\n**\u2666\ufe0f 10,000 FREE CHIPS ON SIGN-UP:** Start with a big boost.\n\n**\u2660\ufe0f 1500 FREE CHIPS EVERY 12 HOURS:** Stay loaded and keep the streak alive.\n\n**\u2665\ufe0f VOICE CHAT:** Talk, joke, and vibe with players in real time.\n\n**\u2663\ufe0f AVATARS:** Drop your style and stand out at the table.\n\nJoin now and take your Blackjack, Baccarat, and Poker to a whole new level.\n\n{1967748304125710}\n{697735416741966}\nBlackjack is a free online game of chance and skill for entertainment only. You cannot win real money or real world goods by playing. Chips can be bought in the Store, cannot be cashed out, and are only used for gameplay. Le Casino is for players eighteen and older.", "short_description": "Jump into a fast multiplayer casino, vibe with new people, level up your game, and grind your way to the top.\nIf you think you\u2019ve got the skills, prove it in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/nomi27951/ee3d058d7c9134c36b9a2d73b89c83c6", "developer_terms_of_service_url": null, "publisher_name": "Intisab Inc", "support_website_url": null, "website_url": "https://fb.com/BlackjackVR", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "34233602406287602"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_926176296874937_1538400205391854208_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmZT-gWue_YQ7kNvwEhmNIw&_nc_oc=AdovXLDzyw03j3WdsTroLz-GyQUsJQIz7fk1llF5yCKygjHUq4RjH5qSJnOwWPh4guI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hH4s2oeyx6d5IGjM5gB9qwUVWpyTqt_jfue0S1mO6Mw&oe=6A05BCE7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blackjack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_n
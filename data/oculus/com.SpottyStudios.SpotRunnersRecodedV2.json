_1342168323763922_8427901155261325310_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEf8Cloei18Q7kNvwHT-uYg&_nc_oc=AdnJS__VWjE8ubTJ62dCHhkE8fqjsBb73w-BhAPGxYZxjE6r3ljid5RvovoW2T2j-3k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtyhzQ4O2DHgdtTlyUTTRPmRcwbUbc1wbDFADzVIH7_A&oe=69AAD55E"}, {"file_name": "Untitled103_20250317210322.png", "id": "2128989940894530", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391986_2128989944227863_570570883978708691_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt1594_No8oQ7kNvwGx5u5g&_nc_oc=Adn2e0aMFjizGb41H8J1kp2pW3f-BR90WG42ozyXrjgO13-6bKaowMB1233MQvP8e48&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv_sxRD5y1bwtirc4j-RZWoEEP2-_xfo_H5ekUkWblGg&oe=69AAD740"}, {"file_name": "Untitled103_20250317210339.png", "id": "1292728755129578", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391934_1292728758462911_5029479505658674728_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tdwguI0cvkQ7kNvwFdWOEr&_nc_oc=Adk_qf-NBAiALD1D0rZXXlPp5RzeZ4b_AWA3Y4gsQYi8RHW4b-wnfV3Ok3FpHl-5YDo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvZo-BYVv2LMW4W83Nu_9TalHozqE9GVMh2sU41SiG3g&oe=69AAB756"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spot Runners", "keywords": [], "long_description": "Spot Runners Recoded V2\n\n\nWelcome to Spot Runners, a thrilling and fast-paced VR experience where movement, skill, and strategy are key! Swing, jump, and climb through unique environments as you compete in various exciting game modes. Whether you're looking to challenge yourself or just hang out with friends, Spot Runners has something for everyone!\n\n\ud83d\udecd\ufe0f Shop\nCustomize your character with awesome cosmetics! Express yourself with stylish top hats, glasses, and unique holdables like buttons, branches, and more. Stand out from the crowd and show off your style!\n\n\ud83c\udfae Game Modes\nCookie Clicker \ud83c\udf6a \u2013 Click to earn cookies and see how many you can collect!\nPVP \u2694\ufe0f \u2013 Battle against other players in a fast-paced tag-style combat mode.\nFind the Button \ud83d\udd18 \u2013 Search the map for hidden buttons\u2014can you find them all before time runs out?\nHangout \ud83c\udf34 \u2013 Relax, chat, and explore a peaceful map with your friends.\nRising Lava \ud83c\udf0b \u2013 Parkour your way to safety as lava slowly rises\u2014don\u2019t fall!\nAnd More! \ud83d\ude80 \u2013 Stay tuned for future updates and even more fun game modes!\nAre you ready to run, climb, and explore? Jump into Spot Runners today and start your adventure! \ud83d\udd25", "short_description": "Become a Spot"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1NVx1fwinI9I0C2zHZRuE3T9y0M9QbmI28fVkGnTozeA/edit?tab=t.0#heading=h.k3z2p3jur6mn", "developer_terms_of_service_url": null, "publisher_name": "Spot The Cat", "support_website_url": null, "website_url": "https://sites.google.com/view/spotrunnersrecodedv2?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9403048046440083"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1200452731614742"}]}, "baseline_offer": {"id": "1200452731614742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742
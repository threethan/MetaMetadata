tUGGoWZ0RJA9PJSUKpz9jo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5jbLOR6FTUtaFtJJ8y7zFUbu6_T9cFsJkT9zJWjyAhg&oe=6A8AEB67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2032842950907540", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499311611_2032842954240873_5715925386210071833_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVu3RlfLbbUQ7kNvwHouU5r&_nc_oc=Adq5vN_siKtbPG_VMSiXz3HPPChDqfFmrAygb9EIdMeYo5DBQsdZ-HnkqJj2gsFfHTY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjV5kXFJl1fD_FV5ss4sLvQ8r-BqgYLMqIQQGIs2D4TA&oe=6A8AC40A"}, "display_name": "Tower of Hanoi", "keywords": ["Tower", "Hanoi", "Puzzle", "Math", "Brain"], "long_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod.\n\nThe objective of the puzzle is to move the entire stack to one of the other rods, obeying the following rules:\n\n- Only one disk may be moved at a time.\n- Each move consists of taking the upper disk from one of the stacks and placing it on top of another stack or on an empty rod.\n- No disk may be placed on top of a disk that is smaller than it.\n\nYou can choose the number of disks between 3-8.", "short_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
{"file_name": "Landscape.png", "id": "2032842950907540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311611_2032842954240873_5715925386210071833_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6GcHomKJ3oQ7kNvwFH38_5&_nc_oc=AdpdNlxfSv2FeILlOFg_u9rF8ny-RxuXwqA0MdXeJcZzLRoyZaGHuwpNUtEI3oUcxFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiUwN8nbp54Kvl7FIx_y-watq17XSs1plmyXNBPNFR2w&oe=6ACB95CA"}, "display_name": "Tower of Hanoi", "keywords": ["Tower", "Hanoi", "Puzzle", "Math", "Brain"], "long_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod.\n\nThe objective of the puzzle is to move the entire stack to one of the other rods, obeying the following rules:\n\n- Only one disk may be moved at a time.\n- Each move consists of taking the upper disk from one of the stacks and placing it on top of another stack or on an empty rod.\n- No disk may be placed on top of a disk that is smaller than it.\n\nYou can choose the number of disks between 3-8.", "short_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
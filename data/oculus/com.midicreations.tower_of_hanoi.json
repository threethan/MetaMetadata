culuscdn.com/v/t64.5771-25/491821178_1399553421453645_83845266239807732_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k28QwfuBWIIQ7kNvwFf1IXQ&_nc_oc=Adqb-PWRVgYCRHU4mCHfFLCxREGJedmdEsmeUINpn5_iUzV7CQu3aAnqVzw1ymQXlPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWGLJIXPexduTtJIViAmIUV5So5wWi08CRXVetzI8S-w&oe=69C129E9"}, {"file_name": "ScreenShot5.png", "id": "1625493598580689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823893_1625493601914022_3857719261246434661_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qio4i2fb4QUQ7kNvwH1h8Yb&_nc_oc=AdrJDnWGkC3Kr5aQc8vyjla23qQU-wSe45fx6crPnupdTKPeDhG98GJ2lPD1hgUAG5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzv6pkMGpdpu04-O46sEc9t0LE8bxpn8Gz73E_rqUAwFg&oe=69C135E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2032842950907540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311611_2032842954240873_5715925386210071833_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt7_3xTaO-AQ7kNvwGeTlG5&_nc_oc=AdrAzmUykr2vhSVc4vmqWq_6d4bHtgixBcy8Gia6Twj3bgEwrFjbEw248NkLZTCu3Pg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9xNVQ3vpfbG479g9xFAx5hkxLO6V9L491qxfOiZy5Ww&oe=69C146CA"}, "display_name": "Tower of Hanoi", "keywords": ["Tower", "Hanoi", "Puzzle", "Math", "Brain"], "long_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod.\n\nThe objective of the puzzle is to move the entire stack to one of the other rods, obeying the following rules:\n\n- Only one disk may be moved at a time.\n- Each move consists of taking the upper disk from one of the stacks and placing it on top of another stack or on an empty rod.\n- No disk may be placed on top of a disk that is smaller than it.\n\nYou can choose the number of disks between 3-8.", "short_description": "The Tower of Hanoi is a mathematical game or puzzle consisting of three rods and a number of disks of various diameters, which can slide onto any rod."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26043535571929864"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304305_1428241968686975_8875717401531790421_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j61i7G4XdEQ7kNvwEC4ayp&_nc_oc=AdqeKvlTOLpj6DhLR5ebBW7-8qOnI85uRZEd_Xn54eKN0KtapW9400qxI8HhQjxeYPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW3tEmtrcfguXkn6xE6RVUJweFCbsuzqVgWRKD01lJ2w&oe=69C14F51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tower of Hanoi", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1772027460, "lastRevision": {"nodes": [{"id": "26043535641929857", "release_type": "SCHEDULED", "
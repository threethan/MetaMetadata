86828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8I1DmTehoMQ7kNvwFy3Cc3&_nc_oc=AdrhwvVnG244klPh10yulQA8sORysbrTxQcmbo2B8krb0H_cU8tpV-Ribnv1-iTCec4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHbUvQ1kiE_qbm9bOE-DmHVvb9afw6QAWUN5MNIote8A&oe=6A9AD811"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXg8aSRk26kQ7kNvwHm28wE&_nc_oc=AdrvQg4r6ipO-J7JbsWV5f9i7rqvviBQUuXyBzoX1t15kIq9_72lyh9QqHP6T8kzCRo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK71PwRKoePQoQR4E8rQWyeMJI4LlTrW7lPkq9WrHByfA&oe=6A9AEAB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest2.png", "id": "1671929807380101", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_1671929810713434_2366509974214248848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVO9JezHN0oQ7kNvwG3DgSg&_nc_oc=AdqlHBRRdasQsDA_Wfp4iHcGv1WJ5piChUA9wsoJLalwPlJaM54XEUMbQFdLqMImCBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRq5nAOvNXt33Aezu4NpRZuHzmxIlrAQnX_ahmddWZGQ&oe=6A9AC847"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27948457968073737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827646_1632374044535545_1440713904090467674_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kikMNtpVK7MQ7kNvwG8Pih8&_nc_oc=AdqwCLmiEk6SC2c1maOLIFc3fgl
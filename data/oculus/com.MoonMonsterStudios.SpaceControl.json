24085_6286828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2F2Zshgvh4Q7kNvwHJnmW2&_nc_oc=AdqgYpoHc-VBIFDaE9LEdfJrnbpeOjWXPGOD_JCTzph4tVJKFWPu8Ba5xV5Sq4eDaH4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRwxgXWctM9-BSXWLTMuFVAzgikh0mCNIKcY4XzfUWNg&oe=6A7D9ED1"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NopaLka75isQ7kNvwFTDA6R&_nc_oc=Adr8WYHJIZjArC7xLjDapS_eW3vgSAD63ainqLM0_AQtIDbCFgbfx883UT1hwe2y_DQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCxup9MC9wf3u3WHcKf3bKzQAceKxwsLUx9YFsd-tZPQ&oe=6A7DB170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest2.png", "id": "1671929807380101", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491825481_1671929810713434_2366509974214248848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrpGO-0LRpAQ7kNvwGVQ4ob&_nc_oc=AdrYXzfLAhSNjZjdYq8_Ro0vxS2zL0Fcw83_S-u1xlM7nypx-Ttn-yO0NYmAYq09Hmw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQVYoj-BxyORwXljlN3YDRey9FwSM1oA5cdVjBfDwgBA&oe=6A7DC747"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27948457968073737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827646_1632374044535545_1440713904090467674_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8NZYHKDqYsQ7kNvwH_tDgL&_nc_oc=AdrTEp2eGq7YbPx9N8
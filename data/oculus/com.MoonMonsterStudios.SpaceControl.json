.5771-25/491825470_1366780821424085_6286828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=appFuSyPKrwQ7kNvwFIgmyy&_nc_oc=AdpHighDShh6MxGi3oI7YbzOIITACateaKWFLkI8CNGT3I2or2RvvIUjYweqvv5iY7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f8RHCljIhZnxznkJGsSecm6Vi75CnCxNEMbRHnRsLBA&oe=69E4E911"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_InO1dnwCMAQ7kNvwFHR-Ov&_nc_oc=AdqAoz0di33bTL-pSbtWHxFfA5lA6BTxWsQ7KhpeAToCdF61fN7_eJ4FWaJAYMG4MmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25losVWyuS62ieBo-tN_vX2lhDI976IsLadgQMLdcwsg&oe=69E4C370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyArtImage.png", "id": "1427392565424268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822550_1427392568757601_7304444617808475821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPUMpQXpIUUQ7kNvwE4RJ_D&_nc_oc=Ado55PhgovIyf1OBWoIYlNJ5c5CIyi4osFkT3pG5VV5zKMYxUu0UycydXNser_dtwEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zLTGbMdx73zr9gPvd-KaPeLEkR3hC2Qz_h-DB62ncfA&oe=69E4ED25"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26950165357903008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2149896142446552_3371229544290914324_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQxF8OYrOSwQ7kNv
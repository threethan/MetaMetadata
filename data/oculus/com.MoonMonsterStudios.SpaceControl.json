86828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Fi4BooWFkQ7kNvwFfJgZa&_nc_oc=AdquUWCeEiRI5YlACZWlikYUgCGzmvWV2OSJ_35uu9Lq0H2RKtt55Mo8WMcuLZNIzaM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbP9u-wFiSo4egm43dBnbeh_ZeqqqAUyzEMozOaOqPNQ&oe=6AE8A091"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78noDYmI0p8Q7kNvwHm3cx_&_nc_oc=Adogazs5ZSvEY8skGgLQOcgkXog-1f-llXPs7TrVYsINExCRcocTSBhb_55rjrpFxOw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh8X4GRP1xxXThj6to_ClHTYSVgeVqRnUqb2aDvhwdEw&oe=6AE8B330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest2.png", "id": "1671929807380101", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825481_1671929810713434_2366509974214248848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sEYb2Ln31QQ7kNvwEEbkjC&_nc_oc=AdrHXrtRXKMATAD9TxDCcfjxIoqSD2EqtB4TIx_geAf0PGRhg4iWfcO_xOr5Qyve28s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYPIm6EHVAjBz5WtMrumGRmHkNkQdEt-KoB0V4DhZQJg&oe=6AE890C7"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27948457968073737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827646_1632374044535545_1440713904090467674_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoMPlartyl8Q7kNvwEuZREE&_nc_oc=AdpTtYm-FHbApRflbK0QWTyVjm6
_6286828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eqoSN7urCEQ7kNvwHpvlTX&_nc_oc=AdrhwoUcSTSrERXH-th0nSm2lJKKXVnL8ucoHC4VgLmKIy5PIFdd64edlu_SydPovfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6weE80ACnyCJWZqjh4AAmMggRu_NwT8Y_eK7avvbb8gQ&oe=6A048D11"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbPI_fFiQ84Q7kNvwFpCLt9&_nc_oc=AdqhKvcYREfAYpksZIY0ie9WhckzMKuwAf4IPKUutmA4WdwdDzVDJKIzmH6DTRCQVBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ytk9p32gdFsXLorO0gCFK_JHMbGpBYlqv1WDJAFa_Zw&oe=6A046770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyArt2.png", "id": "35127171656928695", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_35127171690262025_1511915802260911713_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afNEk6TDKyMQ7kNvwHYUIqF&_nc_oc=Adp2oS2KWXXJUqhvh7RBDbooj6GqQ_K3VZv_VDGuG7RzbIEagcaa8g27nx7K8eBNtxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FByf2MMZ22_t384UUIuVM2lCOnM7jZy-hN2J8nmmHLA&oe=6A047E35"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27222290347357173"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_973875778658476_8573055794161130722_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54b8Wnmmjn0Q7kNvwEmv9hl&_nc_oc=AdotybFmf6dTyNFY7WrCE8B
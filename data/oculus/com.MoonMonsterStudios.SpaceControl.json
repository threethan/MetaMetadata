7kNvwGB6COK&_nc_oc=Adr1LZIhtY_6rxY2dI95mByqt1Nw6HzRjjt0yl5V4aoOMZgJLs6Hs02R_dL31hnLh-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0m5x1a1woDPHyvbe-3gSwAZoQ2jxdf8Eez2n2F44xYfA&oe=69F0C691"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUAUDnDWLM8Q7kNvwFSWbQ5&_nc_oc=AdpvjHiQpMqfPdX7008jTKvaE9lKv89wO2bTftx-PlqXEcaZbSq7kNdVF1oAmdctsDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3RaLllis-_-grkgrI1Wed5XZ2BQMI2npaFtvQ8zML6pg&oe=69F0A0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyArtImage.png", "id": "1427392565424268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822550_1427392568757601_7304444617808475821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I4hkHGHgM8Q7kNvwHbqQnN&_nc_oc=Adq2DjPld8-m6NE-7F1DXx9u9NOWJBRBRte748WEJD5yH6t7v_HL0A15HSJQM9WbAoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af23V7vr9n467oqhWjL3m5OsVHJvdENQYzepUd_o8PfmRQ&oe=69F0CAA5"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26950165357903008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2149896142446552_3371229544290914324_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNXxLRuugvAQ7kNvwH2zhNa&_nc_oc=AdqBxrEW2yM4QG41T1gtfIro9tKAjdP_ZvdzDqc8zlyiSp4-NFzFO3CTNNToVs5il1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3mlh7KfZs36z4FKFbrt
34824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgVK2_ZypikQ7kNvwE5sIxw&_nc_oc=AdqesIkQpb6ZOPoRcwJBEc0xrFciN6jEgqIAXRaROY5XiUNUFdFSbMhoaRSxFufS2hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yc9pIGXdHVk2HrGS2f2uGW8ed-kNAgB5C4XuZSWaA6Q&oe=6A297711"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hikaGl7zC80Q7kNvwGuiAJw&_nc_oc=AdovSdDxMEO-jGohNHgoPccPlZB5WZIegAr2t0OgBGLh4fOLhyO9H-A2O4GKuKRdmDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pr76wuGYU7rouJrxXWQWBrcWtxEwp8sjnHPEF-izscw&oe=6A2989B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KeyArt2.png", "id": "3510469225774961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_3510469229108294_1946832411946206600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPzhoxczpbEQ7kNvwFwwcbv&_nc_oc=Adrmqi66Gd75sUwcFcsE_0DukvPsMaT1W6pglZ4owH3AnQIhJzWJPTNKDwsmAm_NVq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PD-ASuzfWDB-mZNoUedwJMWBIB1jPs43UNjKgXxAqmg&oe=6A29654C"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27433849089534630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_1340976004585007_3624487400291402331_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vjAMVetjdQQ7kNvwGejWLz&_nc_oc=AdoflWEHYF3f2GCB748va_rkLqvKBfEPuDuj
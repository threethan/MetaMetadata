86828475834824160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0Khrc0uFi8Q7kNvwHLNZ0w&_nc_oc=Adrz0oTgkDNJm1o0YNi4N0XVhcdSmbCDv3IB3v1_kZ4Ogd_Alrtgh2x3mnYYU8vtQxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoKhnjGE-MEo4CtHrs3XcsATjIRVj-0MbU_9nSyF5bJQ&oe=6AA2C111"}, {"file_name": "Screenshot_07.png", "id": "891578790275826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_891578793609159_6171827621334307748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqXqmJLrmR8Q7kNvwEhhozP&_nc_oc=AdpaM7tBcB8RtUPSplsr2S0ENb0Lz2JzdS4W7vBuXIsfVmALyBjujPbFnRAFIaTPGds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIduD10S2-ogm7xx1wJuVV5-iBbK3hL863O6Ti1VKU_yA&oe=6AA29B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest2.png", "id": "1671929807380101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1671929810713434_2366509974214248848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3p09kiWd6wQ7kNvwHH1XGc&_nc_oc=AdokiN8vnAFiXx-CH9zri7lS784h4EiY8nNfli8OGXZCSnoi-aivwCZas_Ud06s4pcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdId_lpyvt7VH2tEkgOAeHnAKxf17AJUG-HBjB16GXTg&oe=6AA2B147"}, "display_name": "Space Control", "keywords": ["Aliens", "Cartoon", "Sandbox", "Physics", "Space"], "long_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!\n\n# Have fun with physics!\nPull, tug, bounce and throw around all kinds of aliens, gadgets, and thingamajigs! (almost) Everything is interactable!\n{1980053469586391}\n# Weird jobs in a unique episodic narrative!\nAbduct new recruits in the Abductorium, take care of alien babies at the Daycare and cook up some questionable space snacks at the GlorpoVision Music festival!\n{2283999592083928}\n# Meet your alien crew!\nGo on wild adventures with Melody, Widgett and Zorgle - Your friendly space companions on this corporate adventure!\n{884349157679414}\n# An immersive, whimsically dystopian world!\nEnjoy cartoony environments inspired by the absurdity of beloved shows like Futurama and Rick&Morty!\n{1982018095715483}\n\nJoin our Discord!\nhttps://discord.com/invite/SJhu6bNHHm\nFollow us on socials!\nhttps://linktr.ee/MoonMonsterStudios\n", "short_description": "You've been abducted by an intergalactic megacorporation, Glorpo Inc! Work off your debt with your alien crew - abduct new recruits, take care of alien babies and cook up some questionable space snacks!"}]}, "developer_name": "MoonMonster Studios", "developer_privacy_policy_url": "https://moonmonster.be/SpaceControl_PrivacyPolicy.html", "developer_terms_of_service_url": "https://moonmonster.be/SpaceControl_TermsOfService.html", "publisher_name": "MoonMonster Studios", "support_website_url": null, "website_url": "https://www.moonmonster.be/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27948457968073737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_1632374044535545_1440713904090467674_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAJ1oO1e7L8Q7kNvwE7I22e&_nc_oc=AdrKhHm8QLRLLZWAReUyoKfzsP_
0f&oh=00_AQRcLn7AZWsyPg5hFEaOy6OUwuag3FEDLWsu56jDJObGGQ&oe=6AF5CBCE"}, {"file_name": "SplashWash_02_repair.png", "id": "1045047895187810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1045047898521143_3117145171238484749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHn3iLAOMb4Q7kNvwE2vMCH&_nc_oc=Adp-nS26c2KAgW0x3f8oFOR3V40z96g3xYOztemVZaJMA8VYV9Y15Ysi3csjhlPBgn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7RjUD_svViWnpWIAv1RfelkP3tN8Dc0iFa6bjJbTyNg&oe=6AF5D90F"}, {"file_name": "SplashWash_03_leaves.png", "id": "1544472484366461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1544472487699794_1060183148338830521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fN8bdG8_hIQ7kNvwHGC4rR&_nc_oc=AdqQIb2eWymekJDGF6QY4mLlEMJpi1w_CSkzke032ozS4FNULLPj0eJP-vAh2qJldYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRmiKh7GbxPFOlLU1iNOsSa6-8Pp8Hk6kB-IhTh8vNtw&oe=6AF5EF3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplashWash_05_coop.png", "id": "2569228953546478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_2569228956879811_8496671646047204918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITB1ZCeAhFoQ7kNvwGbZ0QJ&_nc_oc=AdrzzZEw6LRqjaTLZtW_a21Pr-tOg8ma6_ksL_qlVYztY8biPGZrLIPKEfifBcFKyxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx4p1cUM2xHQc7CHiHQ-ClPJC0tysBBPwZaSuLJKknpw&oe=6AF5DDE0"}, "display_name": "SplashWash", "keywords": ["Cleaning", "wash", "pressure", "Simulation", "cozy"], "long_description": "Turn dirty, broken-down places into clean, satisfying spaces in Splashwash.\n\nArmed with one powerful multi-purpose tool, you can wash away layers of dirt, vacuum up scattered trash, and repair damaged objects as you bring each location back to life.\n\nExplore each map at your own pace, find everything that needs attention, and enjoy the satisfying transformation from messy to spotless.\n\nWash. Vacuum. Repair. Restore.\n\nNo stress. No rush. Just satisfying VR cleaning and the simple pleasure of leaving every place better than you found it.", "short_description": "Clean it. Fix it. Make it shine.\n\nGrab your all-in-one cleaning tool and transform messy, broken-down places by washing away grime, vacuuming up trash, and repairing damaged objects. Simple and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/splashwash", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/splashwash", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "fr", "es", "pt_BR", "pl", "it", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1581952789725993"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1575318100743408_5503590261131085155_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo8kns0soOcQ7kNvwG0RxMH&_nc_oc=Adr503Qh2pf4FMb-y5pQ-mboNxHv_leRFImpC0XDLtUvFaQCWSQ_tg4s1Kd9Zj27dXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzQ-fIEgaDb-xG_5IpwnjF84enykmWAMel3HjzKd161g&oe=6AF5ED76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
AF5DDE0"}, "display_name": "SplashWash", "keywords": ["Cleaning", "wash", "pressure", "Simulation", "cozy"], "long_description": "Turn dirty, broken-down places into clean, satisfying spaces in Splashwash.\n\nArmed with one powerful multi-purpose tool, you can wash away layers of dirt, vacuum up scattered trash, and repair damaged objects as you bring each location back to life.\n\nExplore each map at your own pace, find everything that needs attention, and enjoy the satisfying transformation from messy to spotless.\n\nWash. Vacuum. Repair. Restore.\n\nNo stress. No rush. Just satisfying VR cleaning and the simple pleasure of leaving every place better than you found it.", "short_description": "Clean it. Fix it. Make it shine.\n\nGrab your all-in-one cleaning tool and transform messy, broken-down places by washing away grime, vacuuming up trash, and repairing damaged objects. Simple and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/splashwash", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/splashwash", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "fr", "es", "pt_BR", "pl", "it", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "156204689838
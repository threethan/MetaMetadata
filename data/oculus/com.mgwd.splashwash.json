3-1.oculuscdn.com/v/t64.5771-25/491823910_1045047898521143_3117145171238484749_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w78BBF-lwjcQ7kNvwHH160f&_nc_oc=AdpbOzzKsZGUPOVVXTy1fAzWUBHpekJlhTY2Uv3begPI__r3ZX_TIzBu0TpAQmbARtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDWaQ5LtJ2S-pXV7EAb0TKHSPy0AgczM7ji1lSs7lUfQ&oe=6B10370F"}, {"file_name": "SplashWash_03_leaves.png", "id": "1544472484366461", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1544472487699794_1060183148338830521_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2B-iuZxr7QQ7kNvwHm5Qir&_nc_oc=AdpKx1nwZXnOSKZ2HPE7UhzSc6F2wqgPwLziniapvPaw5xELdUyKbpkj98Rg7e8zNhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6t1P3dqlZ6Gf5n4nhw2lfMm3ilxiGeIyPyRp_XhGgwA&oe=6B104D3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplashWash_05_coop.png", "id": "2569228953546478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_2569228956879811_8496671646047204918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08RL8Nnte7IQ7kNvwHJVeyS&_nc_oc=AdpXn2q1IhFxUgxwKXYVs6V3vWTWemPKqkNAcVR_lJaL9ikfM4TPeauLLkXAYprG6eY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfwv2MVPdFlCgFnjD5xQuAebpxvJt4bcKjrQ_pI1N6kw&oe=6B103BE0"}, "display_name": "SplashWash", "keywords": ["Cleaning", "wash", "pressure", "Simulation", "cozy"], "long_description": "Turn dirty, broken-down places into clean, satisfying spaces in Splashwash.\n\nArmed with one powerful multi-purpose tool, you can wash away layers of dirt, vacuum up scattered trash, and repair damaged objects as you bring each location back to life.\n\nExplore each map at your own pace, find everything that needs attention, and enjoy the satisfying transformation from messy to spotless.\n\nWash. Vacuum. Repair. Restore.\n\nNo stress. No rush. Just satisfying VR cleaning and the simple pleasure of leaving every place better than you found it.", "short_description": "Clean it. Fix it. Make it shine.\n\nGrab your all-in-one cleaning tool and transform messy, broken-down places by washing away grime, vacuuming up trash, and repairing damaged objects. Simple and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/splashwash", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/splashwash", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "fr", "es", "pt_BR", "pl", "it", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1562046898383249"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1414708920022512"}]}, "baseline_offer": {"id": "1414708920022512"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791223620, "status": "PUBLISHED", "id": "1414708920022512"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1626473105273961", "version": "0.5.2"}, "id": "1098117052705229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
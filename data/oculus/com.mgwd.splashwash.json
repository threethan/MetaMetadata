Ei6Z-k&_nc_oc=AdrEIt4G5hGNeRBeifWAusATBm5f41oYgpre5TTSSCRarvKErn9t2wCzBkD1zcp_bsc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcZpSnC4lW9ypsRzfMvWMy9LQdduMNZzkAdJX0WY7kew&oe=6AFF29BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplashWash_05_coop.png", "id": "2569228953546478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_2569228956879811_8496671646047204918_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J467IzkrcTwQ7kNvwGIuOSG&_nc_oc=Adq0fKTMw11g1GfAvQQ-0O5sA_6DeGlxWYDHpDRfrSgILr9hgupwYF-URnoVLixcauE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROPZmCauJtjIe7kYfqSdH8D4x6KUzn2LgWGANk8EnKFw&oe=6AFF1860"}, "display_name": "SplashWash", "keywords": ["Cleaning", "wash", "pressure", "Simulation", "cozy"], "long_description": "Turn dirty, broken-down places into clean, satisfying spaces in Splashwash.\n\nArmed with one powerful multi-purpose tool, you can wash away layers of dirt, vacuum up scattered trash, and repair damaged objects as you bring each location back to life.\n\nExplore each map at your own pace, find everything that needs attention, and enjoy the satisfying transformation from messy to spotless.\n\nWash. Vacuum. Repair. Restore.\n\nNo stress. No rush. Just satisfying VR cleaning and the simple pleasure of leaving every place better than you found it.", "short_description": "Clean it. Fix it. Make it shine.\n\nGrab your all-in-one cleaning tool and transform messy, broken-down places by washing away grime, vacuuming up trash, and repairing damaged objects. Simple and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/splashwash", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/splashwash", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "conte
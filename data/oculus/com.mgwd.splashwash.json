0f&oh=00_AQRmrjRUSNhydP56evyqcahLOxnSlHhmpJurOA7nLnBEfw&oe=6AF9C04E"}, {"file_name": "SplashWash_02_repair.png", "id": "1045047895187810", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823910_1045047898521143_3117145171238484749_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkg7PXbXi3oQ7kNvwGwzgJa&_nc_oc=AdrVOY5QoAuF2FCXQ3Ghemgl85ANb4CgwYBQKCTBYQBvvFX1pCwR2R6wgyODURNeln4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSScj4NncZ3ppvzRY8WN3YdjF3UWVuOXP7hI3cxj0ud1Q&oe=6AF9CD8F"}, {"file_name": "SplashWash_03_leaves.png", "id": "1544472484366461", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823930_1544472487699794_1060183148338830521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVcK-oqUIMIQ7kNvwHUCFwm&_nc_oc=Adquy1G0IQFyQGttu4RjdwTI0kSm6boVEvuo4YeKJRUj07MvzRAMUpiBqShjsX2lJGI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm6reMHWN6fpNhc4GnmNc8GlGgiZBhx5_Tumwrs-WqYA&oe=6AF9E3BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplashWash_05_coop.png", "id": "2569228953546478", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825305_2569228956879811_8496671646047204918_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agrL8_pR_AcQ7kNvwHi484g&_nc_oc=AdrjqAz6yL3Xa4imlq-ElG43z-t45xbVOrH73OTe84FbUxVEZkGRWL9ZBlxMHaglbL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvlGexsNwa20KWL1htVPskyFp1UQUI9AiEC719J540zQ&oe=6AF9D260"}, "display_name": "SplashWash", "keywords": ["Cleaning", "wash", "pressure", "Simulation", "cozy"], "long_description": "Turn dirty, broken-down places into clean, satisfying spaces in Splashwash.\n\nArmed with one powerful multi-purpose tool, you can wash away layers of dirt, vacuum up scattered trash, and repair damaged objects as you bring each location back to life.\n\nExplore each map at your own pace, find everything that needs attention, and enjoy the satisfying transformation from messy to spotless.\n\nWash. Vacuum. Repair. Restore.\n\nNo stress. No rush. Just satisfying VR cleaning and the simple pleasure of leaving every place better than you found it.", "short_description": "Clean it. Fix it. Make it shine.\n\nGrab your all-in-one cleaning tool and transform messy, broken-down places by washing away grime, vacuuming up trash, and repairing damaged objects. Simple and satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/splashwash", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/splashwash", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "fr", "es", "pt_BR", "pl", "it", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1581952789725993"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823783_1575318100743408_5503590261131085155_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsQAa0b2ncIQ7kNvwFk9B04&_nc_oc=AdqeKjHPq7eE_QZEo_Hc0-rbpgCPJy3rFcaXcaTYdhWPRan_D6ItTyFjjAHqZ3yH234&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2W5DaGiotvqKh8vy64N4LCjKfS0qr2yUaSn8Wowfkyw&oe=6AF9E1F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
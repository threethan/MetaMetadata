nc_oc=Adrr2b67WMGm5ZlXlouPNuZdC-m3nBcCGFuyxKYju17dFXTlRQUZM2gVw2ginTl4JI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsnika8X9kOkjB_5RcunxQg0gMWZ6V4AWg7Aj42JnSyg&oe=6B0DB91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2180829819495588", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_2180829822828921_4100009751801718496_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg1IthXZXZUQ7kNvwHSNU5h&_nc_oc=AdpsuvvCe8-0KuEhC7GLU7uPSDOVWru2QWnHLNNBjCUEi948vL2yqIpwXyXUUh0P0Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTW2dpgD4im2yxV4C6JOi3NlDZR8bfsR8IsLeuRSrDKA&oe=6B0DAFA0"}, "display_name": "Bad Passengers", "keywords": ["airplane", "comedy", "pilot", "passengers", "chaos"], "long_description": "You are the pilot, the cabin crew and the mechanic. The passengers are the problem.\n\nBad Passengers is a chaotic comedy flight game for Meta Quest. Load the luggage, get everyone in their seats, take off, and then try to survive whatever this flight throws at you.\n\n15 CRAZY FLIGHTS\n- UFOs trying to kidnap your passengers in space\n- Pirates boarding from a flying ship\n- Ghosts, zombies, a magician and snakes on a plane\n- Sumo wrestlers tipping the plane and a wedding that turns into a slipper fight\n- A boss fight every 5th flight\n\nREAL VR HANDS\nGrab bags, carry runaway passengers back to their seats, hand out snacks, swing the hammer to fix the engine, pull the power lever and take the turret to shoot down enemy planes and angry birds.\n\nGROW YOUR AIRLINE\nEarn coins and stars, upgrade your plane and turn the worst airline in the sky into... a slightly less bad one.\n\nCOMFORTABLE FOR EVERYONE\nTeleport or smooth movement, snap or smooth turning, comfort vignette, seated or standing play and a left-handed mode.\n\nSingle player. No internet needed. 10 languages.", "short_description": "Welcome aboard the worst airline in VR! Load the bags, board the passengers, fix the plane and keep 15 flights of total chaos in the air: pirates, aliens, ghosts, zombies, sumo wrestlers and one very angry mother-in-law. Grab, throw, punch and repair your way to five stars... or at least a safe landing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://justpaste.it/hz4o9", "developer_terms_of_service_url": null, "publisher_name": "Visionary Games", "support_website_url": null, "website_url": "https://discord.gg/jyfg4XFQGf", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "es", "es_MX", "pt_BR", "fr", "de", "ru", "zh_CN", "ja", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1363305466873827"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2133487467554431"}, {"status": "PUBLISHED", "id": "29395226923415054"}, {"status": "PUBLISHED", "id": "1100221375944546"}]}, "baseline_offer": {"id": "1100221375944546"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795464000, "status": "PUBLISHED", "id": "2133487467554431"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1409419872262386", "version": "0.14.0"}, "id": "1856298085545932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_
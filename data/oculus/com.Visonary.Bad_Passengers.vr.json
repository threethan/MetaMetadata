ent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX76WyVgMzIT8boyEl4aGHxyqhj5upSABMwB4YRLxadoQ&oe=6B0EF2FE"}, {"file_name": "meta_04_snakes_on_a_plane.png", "id": "1869305207417561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828028_1869305210750894_4440327705754579755_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLr4n4ZKn7YQ7kNvwEIAKdt&_nc_oc=Ado0-C89SrpAPulXsarEb74KbMAbcJ0FPfL9MIMJhY4kYLW6VAgKsHVID_qIx0LKJo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_NR_LqR6VPhykWusXkJYlKw6XpKw1hYt6RFlEicSsjg&oe=6B0F183E"}, {"file_name": "meta_05_on_the_wing.png", "id": "2696032167488534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_2696032177488533_8434709783617267990_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDgYVSbPQ50Q7kNvwGdkfbB&_nc_oc=AdrIU6VgbvzNC8auU0BPW2J7fM69fGoevgO7l77kil3HzaDYdJnNmUx8V6r36dNT5l8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWZbUDWZ5vafDe8aDk2UW9BouICIl5R1H2bnbuaR3O0Q&oe=6B0F0A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1111866638375104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/613090345_1111866641708437_4683495811272810558_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxhIksr6szAQ7kNvwEi670d&_nc_oc=Adp_2V_6jNvJMzJeYVM1Hi--XwOh3t159LnAxdxh0sMMrYH5TXyCBqvp8qHMOq2ykhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXd5u5VZy6YFRquvJrUKlRJLFWQsYA7EPd5x8wS2IhHeQ&oe=6B0F14A7"}, "display_name": "Bad Passengers", "keywords": ["airplane", "comedy", "pilot", "passengers", "chaos"], "long_description": "You are the pilot, the cabin crew and the mechanic. The passengers are the problem.\n\nBad Passengers is a chaotic comedy flight game for Meta Quest. Load the luggage, get everyone in their seats, take off, and then try to survive whatever this flight throws at you.\n\n15 CRAZY FLIGHTS\n- UFOs trying to kidnap your passengers in space\n- Pirates boarding from a flying ship\n- Ghosts, zombies, a magician and snakes on a plane\n- Sumo wrestlers tipping the plane and a wedding that turns into a slipper fight\n- A boss fight every 5th flight\n\nREAL VR HANDS\nGrab bags, carry runaway passengers back to their seats, hand out snacks, swing the hammer to fix the engine, pull the power lever and take the turret to shoot down enemy planes and angry birds.\n\nFLY TOGETHER ONLINE\nTeam up with up to 3 friends: Quest players and phone players fly the same plane. Jump into QUICK MATCH or share a crew code with your friends. Talk with crew voice chat (optional - mute anyone, any time) or shout quick calls like HELP! and FIRE!\n\nGROW YOUR AIRLINE\nEarn coins and stars, upgrade your plane and turn the worst airline in the sky into... a slightly less bad one.\n\nCOMFORTABLE FOR EVERYONE\nTeleport or smooth movement, snap or smooth turning, comfort vignette, seated or standing play and a left-handed mode.\n\nPlay solo offline, or online with friends. 10 languages.", "short_description": "Welcome aboard the worst airline in VR! Load the bags, board the passengers, fix the plane and keep 15 flights of total chaos in the air: pirates, aliens, ghosts, zombies, sumo wrestlers and one very angry mother-in-law. Grab, throw, punch and repair your way to five stars... or at least a safe landing. Play solo, or online with up to 3 friends on Quest and phones!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://justpaste.it/hz4o9", "developer_terms_of_service_url": null, "publisher_name": "Visionary Games", "support_website_url": null, "website_url": "https://discord.gg/jyfg4XFQGf", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "17009214807
f&oh=00_AQHUpkX1UvXVpCw8qIKUarfyFhrhLV15j4pIMcQnT6c0vA&oe=6A8EF559"}, {"file_name": "screen4.png", "id": "696186223390429", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827038_696186226723762_6741408362021777591_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FO_Rd2zmlIAQ7kNvwHD_0XU&_nc_oc=AdoeV1_6wfpasKETZN46_cC-SWN-0Y3aX8s-ZYUjrl9RdSk422XKF6cUfo9Xi3Bczrg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHueWR3ECB-dNszpo0gsNlJinuaLQ3Sd6DtLAkSeJoY3A&oe=6A8EC57C"}, {"file_name": "screen5.png", "id": "1071974211507363", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507833247_1071974214840696_4011689310068594960_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZVoUajt_78Q7kNvwG2kQo-&_nc_oc=AdpzRedxOiMLIVs1sgM0l5eBFgg1-Ajs2loRJClrC_--omGBv5lXUcpMALoPKu8yvIs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEatbA8mSl8YtSbxzifef0lbASDJzRot24Mhs9Bc79GXA&oe=6A8EEF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverr.png", "id": "1088329313160624", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618297_1088329316493957_6329245103537020287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_woack5xz8gQ7kNvwF9llEU&_nc_oc=AdqaDBW1KVNela8Kc_9yqxElHuPWHAj5AywcJzTtVscUNYBOU27xt8rxf5dyWZMG42w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwpec1-Vm12bIbJ57MYc78fNOd64I3eWSvaulRne1k9A&oe=6A8EE3FA"}, "display_name": "Infant Rampage", "keywords": ["shooting", "fighting", "combat", "baby"], "long_description": "You are a killer baby. Kill them all!\n\nIn Infant Rampage, you play as a killer baby. By crawling around and using your environment you must kill a family and the police. Use more than 5 weapons and physics based combat to rampage your way through the house.\n\nInfant Rampage is currently a demo with one playable level. It was made in a very short time period, so by showing your support the game will be expanded upon.", "short_description": "You are a
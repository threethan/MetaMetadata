content-sjc6-1.oculuscdn.com/v/t64.5771-25/12138832_876531119160141_28757745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzGf4FjQ1P8Q7kNvwFVHzei&_nc_oc=AdkHxJDJPevdHi1IKNQrj36AunABzUxACZVSnRZerZVcwOFLCKAV7C7vYo-cuOIg7Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftrdWh48yshukYXXZ5b3dMyXrNV3J0pvoNI_gnpy30V9w&oe=69986F6D"}, {"file_name": "migrated_image.png", "id": "511253479779150", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449015_223379238050259_1427157275_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4d1YZ_v1XIQ7kNvwHTc8MR&_nc_oc=AdlHK1GUcIgdWFbnpwetVnjQT8kPN0jfIRKkhtU94a_9YqfujqfXmJ-cZdmcerBk43s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvLK0wVdh4tGhbFapdO_KDwor38Gp74l_PlrsBNeIKBfg&oe=69984ED9"}, {"file_name": "migrated_image.png", "id": "863543127392978", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162745_1043450449056171_1107328641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1SABtZMK_sQ7kNvwGTvKdK&_nc_oc=Adm0BZOpoyx3l7pSJ0tzMuufshGqZR4BUCoZcdetGZrbnF26L6d3sOzoYa2HLcxAoxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftjDM5quYc00o7cZX4jYboj5VHTL6OZluqSdR6VXmzOqw&oe=699858A4"}, {"file_name": "migrated_image.png", "id": "204855680781206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138771_856803251097648_1060911761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCjFbOnjkHEQ7kNvwEfDhe2&_nc_oc=AdkN_fLYT0b3jNefdKlfwky_PzwmdKPmdXeyxz8msD-Yu1pF926D970Lv0D8CLi0leI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvED9KepCdned_mlPd0gNGCm7B_EHljku8_0tlJuIBNaQ&oe=69986971"}, {"file_name": "migrated_image.png", "id": "1578426772332750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162739_338068802983630_591907603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wdmbEK7AIIQ7kNvwGnD-wk&_nc_oc=AdkV8Z4bQLO1WtWnz6WEIhc4RIRv8RinTA_lzREciVZCgpwZkQnf8zx60MKlnQ1msZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuF9q7pQlLAp1pitCmoiSdcWgJgp01g71awy3xzq7g0sg&oe=69985075"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starry", "keywords": ["puzzle", "VanGogh", "jigsaw"], "long_description": "You will be facing  the illusory world, making up of endless stars, by putting up your VR glasses, and your mission is to turn pieces of the puzzles into the masterpieces of Van Gogh. VR technology enables very single piece of the puzzle to be presented as vivid object that you feel you were about to touch, and you will certainly be immersed in the artistic spirit within the whole picture. Keep your brain working, and conquer the puzzles.\n\nThis VR game stands out from its genre by providing you the experience of taking deep thinking, and enjoying the calm in the present moment. Also, while making full use of VR technology, this game does not offer any dizzy feeling. Try restoring Van Gogh\u2019s masterpieces through your virtual hands instead of traditional way of clicking and dragging! ", "short_description": "Starry: a VR puzzle game: getting a close look to the masterpieces of Van Gogh (and experience the  nature of art from pieces.)"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "DJH", "support_website_url": null, "website_url": "http://www.dajuh.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3187004521623310"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493532737499357
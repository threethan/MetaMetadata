content-ord5-1.oculuscdn.com/v/t64.5771-25/12138832_876531119160141_28757745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUkXRMldQBIQ7kNvwG4bP3p&_nc_oc=Adn3ZQcGsVNS67SJ39gY9JXpz07tkP1-8Zb3puUcifvMdfkNj2dyXNU9gtASePCcg7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvrXHjaUs1aB1K1L7zg8qOPSIWdEh3RxJ-lPklI1xDUyA&oe=69A44CED"}, {"file_name": "migrated_image.png", "id": "511253479779150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12449015_223379238050259_1427157275_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyR3h7o0hZQQ7kNvwHmzm_L&_nc_oc=AdnR7nRApyAkdeXyvGGOcA6-ov8Vv6NcR0cRDic4porCIvGeILVe1lDeDkm9JZ6UmVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsA6X9WTmld7KLn84Yd1VZ97bT0tZzsiLh1RcsWICaQ_A&oe=69A42C59"}, {"file_name": "migrated_image.png", "id": "863543127392978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162745_1043450449056171_1107328641_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAI1VtwMvXEQ7kNvwFdRc70&_nc_oc=Adk4FBg-pM3hPfA7z3l4wSg2U0hhEjukgG-02W0XOg4RdpHYaP-_zl6lWFGOFPjOgg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4Dqh7r62MtzTXJWWZoGER7E_46cy29a380VC6IMCu4w&oe=69A43624"}, {"file_name": "migrated_image.png", "id": "204855680781206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138771_856803251097648_1060911761_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBBOBd_k6qMQ7kNvwH4FIjc&_nc_oc=AdlWoahdiXJkbCmK6mUlXcT419_KHSodoklXsCAB3aFygvGSTK77qUqatYgnzi-s9oI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft3bzqAAy7kj0HyIY4ij2Ifg3X3CwvoxR-elBoq0JRsWw&oe=69A446F1"}, {"file_name": "migrated_image.png", "id": "1578426772332750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162739_338068802983630_591907603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoFh0keZ5voQ7kNvwEzZfxK&_nc_oc=Adm6U735Jad4I8us81yU4kjM9Vv0uDt5_tuz8dNjJv_Cafoh8Hes9FTnd_AyQFxI32s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvFCVAHa6Bax126ix2oV05X2fUuvc5KJglBmlBefKJIuw&oe=69A42DF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starry", "keywords": ["puzzle", "VanGogh", "jigsaw"], "long_description": "You will be facing  the illusory world, making up of endless stars, by putting up your VR glasses, and your mission is to turn pieces of the puzzles into the masterpieces of Van Gogh. VR technology enables very single piece of the puzzle to be presented as vivid object that you feel you were about to touch, and you will certainly be immersed in the artistic spirit within the whole picture. Keep your brain working, and conquer the puzzles.\n\nThis VR game stands out from its genre by providing you the experience of taking deep thinking, and enjoying the calm in the present moment. Also, while making full use of VR technology, this game does not offer any dizzy feeling. Try restoring Van Gogh\u2019s masterpieces through your virtual hands instead of traditional way of clicking and dragging! ", "short_description": "Starry: a VR puzzle game: getting a close look to the masterpieces of Van Gogh (and experience the  nature of art from pieces.)"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "DJH", "support_website_url": null, "website_url": "http://www.dajuh.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3187004521623310"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "493532737499357
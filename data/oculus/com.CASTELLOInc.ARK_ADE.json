-iad3-1.oculuscdn.com/v/t64.5771-25/38974479_219609333186314_6666503618924774007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OBZf1hXxqgQ7kNvwHTC3uf&_nc_oc=Adr5GXDn_Q6t0_SCPMXRr0miSFvl-sWl0WKhyF6t2d_9rgi7b6DHi2Z-46bspqrB09Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nBHH_taRczBsHmtDw2tG0MJJhU10MlxhILXFEBT3YCw&oe=69F76AAE"}, {"file_name": "screen27.png", "id": "501378757801614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_501378761134947_2304345828853568045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc2RNz5gBwEQ7kNvwFcUW2v&_nc_oc=AdpmqMheV9qU1JaJ10a--mWFZ4zd0s8wB7dTio4xvKeEso93lr1vpEIggMxc1p4prsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32ryLEiQtXyF2syvzsSesS5zTFx42UqDwCnEexicH6zQ&oe=69F75031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_2560x1440.png", "id": "1002665716930295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_1002665720263628_8704289160894096720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDvohMwr6ZoQ7kNvwEMOjQd&_nc_oc=AdqHkRwJ6aQMRKvVhaxsuC5O42ck_6b2ygK-HcYUSZLfnC6paWxWcyQaRJyq71PxyFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BZ1Zl0OdVvJk8LEVxbE5u90sKs01Gt3w0XNpmExWz4g&oe=69F7425D"}, "display_name": "ARK-ADE", "keywords": [], "long_description": "Have you ever dreamt about being inside an old Arcade Machine?\n\nInspired by the major 80\u2019s Pop Culture references, ARK-ADE harmonizes the old fast-paced Run \u2018n\u2019 Gun games with the new era of VR technology, diving you into an iconic setting to strafe enemies, protect ARK and defeat ADE.\n\nFEATURES\nChoose between Free Locomotion and Teleport Movement to enjoy the game without the risk of motion sickness\nProtect ARK from ADE\u2019s army\nMorphing weapon\nEnjoy destructible environment and covers\nCollect all the secrets and defeat ADE for good\nImmerse into the nostalgic 80\u2019s Low-poly Sci-Fi setting\nShoot to the beat of our original soundtrack", "short_description": "Have you ever dreamt about being inside an old Arcade Machine? ARK-ADE is a fast-paced VR First Person Shooter. Plunge into the retro vibes and shoot your way out through an evocative low-poly 80\u2019s Sci-Fi setting to protect ARK and defeat ADE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://castelloinc.it/wp-content/uploads/2021/04/Castello-inc-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "CASTELLO INC", "support_website_url": null, "website_url": "https://castelloinc.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "348695116894190"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1363858914897623"}, {"status": "PUBLISHED", "id": "791625714859817"}, {"status": "PUBLISHED", "id": "416498416458827"}]}, "baseline_offer": {"id": "1363858914897623"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774529100, "status": "PUBLISHED", "id": "1363858914897623"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4892712584120277", "version": "0.13.4"}, "id": "498260718218360", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "
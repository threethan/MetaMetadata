-ord5-1.oculuscdn.com/v/t64.5771-25/38974479_219609333186314_6666503618924774007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5_w_eCZZBUQ7kNvwGbrWSv&_nc_oc=AdoAyDqSgTdJKEfJuHrxrKzn6Z27o79ZYlVl9toRaqbrRqDoLFrtFHs75KQzotd8pTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UDVcAq75YeLPQNFdYNBrcbsm0-lWb2eYBcFtvdaBHzw&oe=69DCD46E"}, {"file_name": "screen27.png", "id": "501378757801614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_501378761134947_2304345828853568045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnWkX5xf1q0Q7kNvwH1z05X&_nc_oc=AdpcGv-odN5aeYnTzoBIIgfeDnkqkc9bWSc6PRE3sqdmY1Q4745S3Uyurk2vAU6x688&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10j57EkpXFYvIvabPreg0Ra-NyAXdcVJCKaMXlolb5eg&oe=69DCF231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_2560x1440.png", "id": "1002665716930295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_1002665720263628_8704289160894096720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqRMhQVeMQAQ7kNvwFcWSCV&_nc_oc=AdrRmj1JVMP0Fvrp-3RjuBWQcrYy7gfNAgoPbAG9R32B9rZhvUdeauMt3b9PcJC5Kz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mnNKiKcfGvO2Cz7Maky7nSpyEz92gpbGt55WJHz7-XQ&oe=69DCE45D"}, "display_name": "ARK-ADE", "keywords": [], "long_description": "Have you ever dreamt about being inside an old Arcade Machine?\n\nInspired by the major 80\u2019s Pop Culture references, ARK-ADE harmonizes the old fast-paced Run \u2018n\u2019 Gun games with the new era of VR technology, diving you into an iconic setting to strafe enemies, protect ARK and defeat ADE.\n\nFEATURES\nChoose between Free Locomotion and Teleport Movement to enjoy the game without the risk of motion sickness\nProtect ARK from ADE\u2019s army\nMorphing weapon\nEnjoy destructible environment and covers\nCollect all the secrets and defeat ADE for good\nImmerse into the nostalgic 80\u2019s Low-poly Sci-Fi setting\nShoot to the beat of our original soundtrack", "short_description": "Have you ever dreamt about being inside an old Arcade Machine? ARK-ADE is a fast-paced VR First Person Shooter. Plunge into the retro vibes and shoot your way out through an evocative low-poly 80\u2019s Sci-Fi setting to protect ARK and defeat ADE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://castelloinc.it/wp-content/uploads/2021/04/Castello-inc-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "CASTELLO INC", "support_website_url": null, "website_url": "https://castelloinc.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "348695116894190"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1363858914897623"}, {"status": "PUBLISHED", "id": "791625714859817"}, {"status": "PUBLISHED", "id": "416498416458827"}]}, "baseline_offer": {"id": "1363858914897623"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774529100, "status": "PUBLISHED", "id": "1363858914897623"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4892712584120277", "version": "0.13.4"}, "id": "498260718218360", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "
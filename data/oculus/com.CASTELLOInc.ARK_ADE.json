AqjNhX4xEyewxUg&oe=69F09AEE"}, {"file_name": "screen27.png", "id": "501378757801614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_501378761134947_2304345828853568045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dndYyKHNW4sQ7kNvwG6dYG9&_nc_oc=AdoeZ7LU_8zZeVK283tCGScdmtrmVHRcYusYhVH_xOVC83PpkzKeRB6PQpONidrqhe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af33CQttP_liZ_1zBO3tuXRXPEtELwsP7p2QXHabnwgEbg&oe=69F0B8B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_2560x1440.png", "id": "1002665716930295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_1002665720263628_8704289160894096720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9vim1aeGwYQ7kNvwEmN6Gv&_nc_oc=Adr5wE1wZNgMqd72PKyvjT6ijCZ2cwrGNtIJesjr4oq2gBwMI3DT3qZ-PGcdQ2kItVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0v2SXIvt6PQSe3netZswj854iQg6fJIrKloG85JCGBCQ&oe=69F0AADD"}, "display_name": "ARK-ADE", "keywords": [], "long_description": "Have you ever dreamt about being inside an old Arcade Machine?\n\nInspired by the major 80\u2019s Pop Culture references, ARK-ADE harmonizes the old fast-paced Run \u2018n\u2019 Gun games with the new era of VR technology, diving you into an iconic setting to strafe enemies, protect ARK and defeat ADE.\n\nFEATURES\nChoose between Free Locomotion and Teleport Movement to enjoy the game without the risk of motion sickness\nProtect ARK from ADE\u2019s army\nMorphing weapon\nEnjoy destructible environment and covers\nCollect all the secrets and defeat ADE for good\nImmerse into the nostalgic 80\u2019s Low-poly Sci-Fi setting\nShoot to the beat of our original soundtrack", "short_description": "Have you ever dreamt about being inside an old Arcade Machine? ARK-ADE is a fast-paced VR First Person Shooter. Plunge into the retro vibes and shoot your way out through an evocative low-poly 80\u2019s Sci-Fi setting to protect ARK and defeat ADE."}]}, "developer_name": null, "develope
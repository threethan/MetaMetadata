7f20f&oh=00_AQFoNiHtNXQPJ6yTtm12DE91aygyP0JNALByO9LlrW-2vg&oe=6A858ECD"}, {"file_name": "Screen4.png", "id": "219609329852981", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974479_219609333186314_6666503618924774007_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u9UC6EPFnoQ7kNvwE5ulay&_nc_oc=AdqnISrlxgH0VZOBt0p9cDV7R3roqsFGAGeL1wc2SQb8iDrJLlakegq7QcYf2ylDjCE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUzkiljrowZdxXBVCpaUuLdXLNW_0i9ZTWwx0mXPrsnw&oe=6A85946E"}, {"file_name": "screen27.png", "id": "501378757801614", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974446_501378761134947_2304345828853568045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuTElRZdz-cQ7kNvwFxexYr&_nc_oc=AdpkMEtSbYCVqP17Rcp3R08dcFbCxX4dRSChvttxuRuOUR5MIZPi0P3WJO9BcCZnHgM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELXhoRbzaU8ExCXIzQY7yoQM-gKm-pawj0H0Tew3YlTg&oe=6A8579F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_2560x1440.png", "id": "1002665716930295", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57566678_1002665720263628_8704289160894096720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMCQ2KhrGUkQ7kNvwHsDgFU&_nc_oc=Ado3o2U4vIHcVcJlui8A6PQuaxufj_EiTrDYSGl0Vhd4AkHOPVloXHQ2O5XSowfhot8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhNQG_ywgTlKZTaCRDKKeT_6FTr_yi3O-gs8baOEnG1Q&oe=6A85A45D"}, "display_name": "ARK-ADE", "keywords": [], "long_description": "Have you ever dreamt about being inside an old Arcade Machine?\n\nInspired by the major 80\u2019s Pop Culture references, ARK-ADE harmonizes the old fast-paced Run \u2018n\u2019 Gun games with the new era of VR technology, diving you into an iconic setting to strafe enemies, protect ARK and defeat ADE.\n\nFEATURES\nChoose between Free Locomotion and Teleport Movement to enjoy the game without the risk of motion sickness\nProtect ARK from ADE\u2019s army\nMorphing weapon\nEnjoy destructible environment and covers\nCollect all the secrets and defeat ADE for good\nImmerse into the nostalgic 80\u2019s Low-poly Sci-Fi setting\nShoot to the beat of our original soundtrack", "short_description": "Have you ever dreamt about being inside an old Arcade Machine? ARK-ADE is a fast-paced VR First Person Shooter. Plunge into the retro vibes and shoot your way out through an evocative low-poly 80\u2019s Sci-Fi setting to protect ARK and defeat ADE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://castelloinc.it/wp-content/uploads/2021/04/Castello-inc-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "CASTELLO INC", "support_website_url": null, "website_url": "https://castelloinc.it/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "348695116894190"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1363858914897623"}, {"status": "PUBLISHED", "id": "791625714859817"}, {"status": "PUBLISHED", "id": "416498416458827"}]}, "baseline_offer": {"id": "1363858914897623"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774529100, "status": "PUBLISHED", "id": "1363858914897623"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4892712584120277", "version": "0.13.4"}, "id": "498260718218360", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fal
X3o3l7qGmRl9dsXSLkgQBhrRw&oe=699C3AEE"}, {"file_name": "screen27.png", "id": "501378757801614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974446_501378761134947_2304345828853568045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEOFLPWYLOAQ7kNvwG4Mfeq&_nc_oc=Adm3U_ON2XJ69GYoPBUE02pENnrlI088bZ8DcFL-XcAUIg9t4vGbs2GWZOKF7K2S8jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftj-dDIfWB5-LVPo9HZwbAky9VRDIak4gHm87vz46XwfQ&oe=699C58B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Landscape_2560x1440.png", "id": "1002665716930295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_1002665720263628_8704289160894096720_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZevq7wfpuUQ7kNvwGalMZo&_nc_oc=Adk7Dpp6Smy-aNGm0e1l-aYa0vsZK0loxymEpHOTrvyYqAGOErtaaSNOyeNyXFO5lRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUMkcS_xUrtIYVrKpajMid95gtFtN33SThtsghmfL8wg&oe=699C4ADD"}, "display_name": "ARK-ADE", "keywords": [], "long_description": "Have you ever dreamt about being inside an old Arcade Machine?\n\nInspired by the major 80\u2019s Pop Culture references, ARK-ADE harmonizes the old fast-paced Run \u2018n\u2019 Gun games with the new era of VR technology, diving you into an iconic setting to strafe enemies, protect ARK and defeat ADE.\n\nFEATURES\nChoose between Free Locomotion and Teleport Movement to enjoy the game without the risk of motion sickness\nProtect ARK from ADE\u2019s army\nMorphing weapon\nEnjoy destructible environment and covers\nCollect all the secrets and defeat ADE for good\nImmerse into the nostalgic 80\u2019s Low-poly Sci-Fi setting\nShoot to the beat of our original soundtrack", "short_description": "Have you ever dreamt about being inside an old Arcade Machine? ARK-ADE is a fast-paced VR First Person Shooter. Plunge into the retro vibes and shoot your way out through an evocative low-poly 80\u2019s Sci-Fi setting to protect ARK and defeat ADE."}]}, "developer_name": null,
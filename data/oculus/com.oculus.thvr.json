uscdn.com&_nc_ss=7f20f&oh=00_AQTWU__DS9kQsAbiybnMraSW-aihZgz1cPctXIlkfKtj8Q&oe=6AE88BF9"}, {"file_name": "Default.png", "id": "1404315547915518", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822924_1404315551248851_3120237580768958328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7J8sbFQGUYQ7kNvwGEEUOZ&_nc_oc=AdrB4hIFFANEOyxK5DtptijIw5LxxV7_cASD09z2WBmSU2tD41HHQU4Uce9AFZyQf10&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtiVvfKy8uNRbBwiJAhsO1KySwxMZZazzvdReU1TU_1A&oe=6AE8B826"}, {"file_name": "Carousel.png", "id": "776954241804449", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820983_776954245137782_5778119862841203598_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpoSQRqVoigQ7kNvwEL0o3t&_nc_oc=AdpX4WOcQ8bYk6kyhAFmD_BgBBrg9g3GWNY8PnJnvZvIjiMy0JjLlbIm7zG1cXsb1HU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSli4PHBH0zkdPQBKfbr2yGO4z3v5WgQPXM9a_2isFvGw&oe=6AE8BC9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491820566_1208181367799674_7232913575540972291_n.png", "id": "4617474408536968", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619668_4617474411870301_4454086205398883643_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r25lfS_bwxkQ7kNvwFnNtmo&_nc_oc=Adp2Ym5U2RT08ojGS9Stshn00s62ymIpSWygnQHs7xLEdJK5Vmo6zQncemV0g3Ty5X4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWX8QkcVhac3Lk3lefi9Lp2NtiL1SH4edIySehw_Ql9w&oe=6AE8BF95"}, "display_name": "Threads", "keywords": [], "long_description": "Get immersive in your conversations with your friends and followers with Threads VR.\n\nSee what people are talking about right now\u2014from niche interests to big moments. Reply, listen, share or just follow along. \n\nHere\u2019s what you can do on Threads VR:\n\n\u25a0 Start a thread, share your take\nHave something on your mind? Take it to Threads. Share a thought, ask a question or open up a conversation. There\u2019s more than one way to kick things off with text, images, polls, ghost posts and more.\n\n\u25a0 Jump into replies\nJump into the discussion, react to new ideas or just see where the conversation goes. Every thread is an invitation to join in.\n\n\u25a0 Keep up with what\u2019s trending\nFrom live scores to breaking moments, Threads VR helps you stay close to what\u2019s happening \u2014 and join the conversation when you\u2019ve got something to say.\n\n\u25a0 Control the content you see\nControl who can reply to you, mention you or see your posts. Use Hidden Words to filter out posts and replies that include words or phrases you don\u2019t want to see\u2014so your experience stays on your terms.\n\n\u25a0 Go deep on your interests\nFollow friends, creators and communities for every interest. Threads is built to help you discover new voices and join conversations \u2014 starting with the communities you care about most.\n\nMeta Privacy Policy: https://privacycenter.instagram.com/policy\nThreads Supplemental Privacy Policy: https://help.instagram.com/515230437301944\nThreads Supplemental Terms: https://help.instagram.com/769983657850450", "short_description": "Join the conversation"}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.instagram.com/515230437301944", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://www.threads.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TR
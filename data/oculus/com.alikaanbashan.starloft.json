culuscdn.com/v/t64.5771-25/491823310_1725678018976470_7032964054919461196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2mOWr1kQIsQ7kNvwHAz6CB&_nc_oc=AdprER5RP5w9-fMNXDdBmrQNWzFvRbH9iBDkxFzprDZIwBbaHCA_JK1n5uTh0BCEUAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFtqEhLrqJ_AL4PIKdQ6DuM-ju9G1Y8oBSIiYk389oog&oe=6AF73E19"}, {"file_name": "ekran_2_galaksi_2560x1440.png", "id": "2579683582512446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_2579683585845779_7260170545847269320_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PzDcWSlsdsQ7kNvwEYRWy2&_nc_oc=AdrGpfab3NuqxP82jFmbHES-lkaQwQKailotYBjn1j_j1nlAyq-OB7fRNtZFs_vroRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNcn6J2AI5uc0NDdaasXhCBEk8GGQOe1NKkgSJEyUewA&oe=6AF74327"}, {"file_name": "ekran_3_isik_kelebegi_2560x1440.png", "id": "1115284031390002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1115284034723335_6752248557482234850_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqgzYo050CwQ7kNvwGORpLC&_nc_oc=AdpCmQofHzyB-bZzWX3xjcvW-xwAXQjPOuAzC-YuoBBfmw162YJp7PAegPXIPL_L4oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQClTWqffwJ5caBS7KBdqsm1UpjXlEfoknJxKlT2axcoA&oe=6AF71462"}, {"file_name": "ekran_4_isik_agaci_2560x1440.png", "id": "4574455059458410", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4574455062791743_3075401782856463545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_Jr-SgBAj4Q7kNvwEjfRzh&_nc_oc=AdrHwcJ4tpgyBzfe6qm8aSMWApOSO5L_pRAIZKZzDsJKUB9HfhvYqWwtjRcsJGbiO2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8mZpWu7TBmTZO7C-ntdyaa6sVuOTO7KsuzfzfDZBSOg&oe=6AF73433"}, {"file_name": "ekran_5_yarim_denizanasi_2560x1440.png", "id": "1444153237046345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1444153240379678_8458963322651419469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnj0UQlEfKQQ7kNvwFnWzaN&_nc_oc=AdqNUDHcNCaTay3KTE5nnddXkplK5JKynyDkIXW0DAktAw8en4ne91S17BtBXYncdlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG8ulbyvoQ4ZQnbG7IVgIvhmgv41cP0xx6-R6JPhvf8A&oe=6AF7243D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Starloft - Light Painting", "keywords": ["paint", "drawing", "art", "sketch", "doodle"], "long_description": "Paint with glowing light in mid-air, under a night sky.\n\nStarloft is a single-player light-painting app. Draw a campfire, a galaxy or your name in light. Hold a trigger and a bright line of light stays in the air. Short hints show what to press next while you keep painting.\n\nWHAT'S INSIDE\n\u2022 12 brushes, including Light, Fire, Stars and Snow\n\u2022 Color, brush size, undo, redo and eraser\n\u2022 Mirror mode for symmetrical shapes\n\u2022 Grab your painting with both hands: move it, turn it and scale it up until it surrounds you\n\u2022 Your paintings are saved on your headset, and if the app closes before you save, your painting comes back the next time you open it\n\u2022 An example painting to explore\n\u2022 Adjustable brightness\n\u2022 Play standing, with controllers\n\nGOOD TO KNOW\n\u2022 No layers, import or export in version 1.0. Use your headset's capture for photos and videos.\n\u2022 No mixed reality, hand tracking, multiplayer or online sharing.\n\u2022 No cloud backup: uninstalling the app deletes your paintings.\n\u2022 The interface is in English.\n\nONE PRICE\nNo ads, no in-app purchases, no subscription and no account inside the app. No internet connection needed to paint. For Meta Quest 3 and Meta Quest 3S.\n\nPhotosensitivity warning: this app shows bright, glowing light effects. If you have epilepsy or are sensitive to light, take breaks and stop if you feel unwell.\n\nExample painting: \"\u5b54\u96c0 peacock japan \u590f\u30d0\u30fc\u30b8\u30e7\u30f3\" by Mana, CC BY 3.0, simplified for Meta Quest.", "short_description": "Paint with glowing light in mid-air, under a night sky. Pick from 12 brushes, from light and fire to stars and snow, turn on the mirror for symmetry, then grab your painting with both hands and scale it up until it surrounds you. Short hints show you what to press next while you keep painting. One-time purchase: no ads, no in-app purchases, no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dyazicimvar.com/Starloft_Privacy_Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": "https://3dyazicimvar.com/starloft.html", "website_url": "https://3dyazicimvar.com/starloft.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1439311752597925"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1757932778608320"}, {"status": "PUBLISHED", "id": "1875067067180393"}]}, "baseline_offer": {"id": "1875067067180393"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1757932778608320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1442395595622874", "version": "1.0.0"}, "id": "1414564170842490", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__
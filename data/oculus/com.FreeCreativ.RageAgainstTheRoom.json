0f&oh=00_AQDFsR7Qjv5qq3QK42e3CLNhNW4Eo2ytptMqyD97bDP7gw&oe=6A6210E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "362884679701179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569444_362884683034512_8990070230059180269_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbm5kxZ5Rm8Q7kNvwEmpa0o&_nc_oc=Ado6-XMzZy9Qv9dytg48XJ5P2I0vlbcGkrKDBkYOmW4HUA1WiUGwaDIj3-1iL9RE9dE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAuWjYuXSKLw3Z8hj_Q9GRppFBFPxUL4BmYlV2QfHHdg&oe=6A6230F6"}, "display_name": "Rage Against the Room", "keywords": [], "long_description": "Rage Against the Room releases with two gameplay modes - Arcade and Story.  \n\nArcade\nYou can play standalone maps to try and rage to the highest score you can muster.\n\nStory\nPlay through a short, introductory story that introduces you to the world of Rage Against the Room while smashing everything in your path to become the next Champion.", "short_description": "Rage Against the Room is here to allow to smash, crash and bash your way through all of our Ragerenas!  Use a variety of weapons and items to break down everything in your path and realise the key to unlocking your rage!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://freecreativ.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FreeCreativ", "support_website_url": null, "website_url": "https://www.freecreativ.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25511893071787967"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "912251490781305"}, {"status": "PUBLISHED", "id": "1778430839350351"}, {"status": "PUBLISHED", "id": "1130345728271117"}]}, "baseline_offer": {"id": "912251490781305"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729621980, "status": "PUBLISHED", "id": "912251490781305"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32070855942558281", "version": "1.0"}, "id": "926651935371182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8582203168516889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32070855942558281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "926651935371182"}]}, "change_log": "Work done on hand IK / animations.", "created_date": 1762248966, "id": "32070855942558281", "version": "1.0", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8582203168516889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32070855942558281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "926651935371182"}]}, "change_log": "* Fixed a scale issue on rage cage weapons", "created_date": 1760292257, "id": "31667531136224099", "version": "1.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8582203168516889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32070855942558281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "926651935371182"}]}, "change_log": "v12\n* Impact sound issues addressed\n* Stool grab location fixed\n* New song for Restaurant\n* Beach ball damage increased - test this still!\n* Re-write of The Arcade - loads of games to play and break!\n* Re-write of Restaurant\n* Fixed issue with attached destructibles\n* Fixed issue where destructible items wouldn't respawn\n* Improved menu pointer\n* Fixed destructibles not exploding out properly\n* Fixed thrown items having lower damage\n* Fixed various physics assets\n* Fixed the hand volume bar on the in-game menu\n* Fixed camera blocks on arcade items\n* Fixed respawning of destructible items exploding on spawn\n* Fixed weapon respawn locational issues\n* Added a particle effect for game win to most of the arcade maps\n* Fixed damage pathing to fixes various issues, duplications and omissions\n* Fixed surfboard not having appropriate debris meshes\n* Fixed debris impulses\n* Scrollbar widened for TV menu\n* New hand model\n* Fixed physics issues caused by light and camera rig\n* New speaker model\n* New rage cage model\n* Fixed disappearing models\n* Damage meshes added\n* Added an onDamage override function\n* Added a damage material for the TV screens\n* Changed bouncy ball sound/functionality\n* Further improvements to impact messages\n* Fixed physics asset issue on the new rage cage\n* Fixed objects going invisible when broken/damaged\n* Added a reaction for static objects when hit\n* Changed scoreboard from simple plane\n* Improved wooden post UVs\n* New bot spawner model\n* Slow-mo on Rage Hands\n* New map designs", "created_date": 1760081229, "id": "31619464107697469", "version": "1.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8582203168516889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32070855942558281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "926651935371182"}]}, "change_log": null, "created_date": 1725994505, "id": "26525296407114290", "version": "1.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8582203168516889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32070855942558281"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "926651935371182"}]}, "change_log": null, "created_date": 1722868722, "id": "26136569712653630", "version": "1.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
0f&oh=00_AQAZOqVgunmVgIm_sRKKgdpyU52PiiiNkxatZocZGFXaRA&oe=6A58D667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "362884679701179", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569444_362884683034512_8990070230059180269_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p23fPu_0t7kQ7kNvwH2J9eU&_nc_oc=AdqzFzVmZG0DdCodv847aSTMtnXgiwh9lf_yB16mVDQl8FEwGyJ9iu8PJfnVZ046t68&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuq8GBFXQJJB94cMJnUJgCJhKueq8dqJvF5In685ayhw&oe=6A58F676"}, "display_name": "Rage Against the Room", "keywords": [], "long_description": "Rage Against the Room releases with two gameplay modes - Arcade and Story.  \n\nArcade\nYou can play standalone maps to try and rage to the highest score you can muster.\n\nStory\nPlay through a short, introductory story that introduces you to the world of Rage Against the Room while smashing everything in your path to become the next Champion.", "short_description": "Rage Against the Room is here to allow to smash, crash and bash your way through all of our Ragerenas!  Use a variety of weapons and items to break down everything in your path and realise the key to unlocking your rage!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://freecreativ.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FreeCreativ", "support_website_url": null, "website_url": "https://www.freecreativ.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
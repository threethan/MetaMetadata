IQz0IhHf1pP4V2LCoOE7ei5Sl-f2j7hsIox7POmwZV-wL4YdjDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cYqdj7kp4LSm28h_gBucuJ1YE6jlqP_PThH8p6YbNow&oe=69DCF032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArcadeBG.png", "id": "3327318267576392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356794_3327318270909725_3314026119492980721_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37tLTN1pmowQ7kNvwGGpHx7&_nc_oc=AdptiVfWZ8o-KHE1kz-GhBu7wNQ_5xBy0g1L4NSeJYLmewXPn3QkhnFvcXipTRI4UpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25jlQkBk1XwZPg1Nn-gDSNg7wdJ1kwOpWXIh521RtZeQ&oe=69DCD82C"}, "display_name": "On Point", "keywords": [], "long_description": "**On Point** is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!\n\n## ABOUT\n- Compete in over 90 minigames.\n- Easy, medium, and hard mode.\n- Local, global, and friends leaderboards.\n- Tuned for all experience and comfort levels.\n\n## DESCRIPTION\n- Arcade-style target shooting minigames.\n- Newcomer mode, low intensity, to ease players into VR.\n- Hardcore mode, for experienced players to challenge themselves and the leaderboards.\n- Fully in-world experience.\n", "short_description": "On Point is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://onpoint.game/privacy.html", "developer_terms_of_service_url": "https://onpoint.game/eula.html", "publisher_name": "Actuator Digital", "support_website_url": null, "website_url": "https://onpoint.game/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
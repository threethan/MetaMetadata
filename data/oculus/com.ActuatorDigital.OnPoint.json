WYn8M3_5piJnJr9MOpwVM2krsUsCLjaFebD5KiJg_gQPBiIp3-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf9XqHe4D15rB8XJY5T0ydLDb-F7Uq_Z4nX20l_9pd7g&oe=6A68AF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArcadeBG.png", "id": "3327318267576392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75356794_3327318270909725_3314026119492980721_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4DGwpbPrrwQ7kNvwELWWwG&_nc_oc=Adql_3dqRypk81g9fyYeuXUIoDuQXZex6_Q9zd4xIXq3ClmMl_3jjg_LaFTk_z4IgwE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVuVPyQ4t2gNqeD-gwB7IAjBeN_Ow7uXiV1PeBo72EpA&oe=6A68972C"}, "display_name": "On Point", "keywords": [], "long_description": "**On Point** is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!\n\n## ABOUT\n- Compete in over 90 minigames.\n- Easy, medium, and hard mode.\n- Local, global, and friends leaderboards.\n- Tuned for all experience and comfort levels.\n\n## DESCRIPTION\n- Arcade-style target shooting minigames.\n- Newcomer mode, low intensity, to ease players into VR.\n- Hardcore mode, for experienced players to challenge themselves and the leaderboards.\n- Fully in-world experience.\n", "short_description": "On Point is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://onpoint.game/privacy.html", "developer_terms_of_service_url": "https://onpoint.game/eula.html", "publisher_name": "Actuator Digital", "support_website_url": null, "website_url": "https://onpoint.game/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
rR-NuM0VRDHd9_9-7di1FrFtTv_yhKPgS2-eSh9yDrXnJWFDjtM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER2sZuQHbGpTBrWsTd83ptB8lkG6xQP0LltA2Y_IeUng&oe=6A806A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArcadeBG.png", "id": "3327318267576392", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75356794_3327318270909725_3314026119492980721_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP6uHeFBercQ7kNvwEEjN9_&_nc_oc=Adp0Rd2nZONF1OkmSTexdBrNnf6DE-TpjunCy_WzL2gKOd4HnAumEE3SkKznLnOl0L4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnxqwBIAQ90CNEd6YYIPTYtENFwLdrsLyJXfzVfEyAig&oe=6A80522C"}, "display_name": "On Point", "keywords": [], "long_description": "**On Point** is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!\n\n## ABOUT\n- Compete in over 90 minigames.\n- Easy, medium, and hard mode.\n- Local, global, and friends leaderboards.\n- Tuned for all experience and comfort levels.\n\n## DESCRIPTION\n- Arcade-style target shooting minigames.\n- Newcomer mode, low intensity, to ease players into VR.\n- Hardcore mode, for experienced players to challenge themselves and the leaderboards.\n- Fully in-world experience.\n", "short_description": "On Point is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://onpoint.game/privacy.html", "developer_terms_of_service_url": "https://onpoint.game/eula.html", "publisher_name": "Actuator Digital", "support_website_url": null, "website_url": "https://onpoint.game/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
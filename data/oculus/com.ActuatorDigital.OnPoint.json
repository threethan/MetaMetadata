l1-_ekRybw_0p1M28bZxdZ_OFdhtNeNeGg&oe=6AFDB791"}, {"file_name": "MedLevelSelect.png", "id": "486155310766917", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75520122_486155314100250_6851802354829899748_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDGCLM6pMw0Q7kNvwGGFPgT&_nc_oc=AdoDVNm5d8JB3b8u1CDDzloxcOkBzeb1c9fwqRZS7orIrSmEy22-7M2SflOS9xIYVzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZX1I9NORSmXxYOPSdN_sCcxoi2V8gAbBK2lLVe8zT7w&oe=6AFDE0F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ArcadeBG.png", "id": "3327318267576392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356794_3327318270909725_3314026119492980721_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYdMfQg3PtcQ7kNvwGMNXe8&_nc_oc=AdqMP2LSQMRx38i_dkMgAKc_xWZL_gvbR0HqplgD93IMKFxfAgG52kRbfm-rYptSNwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfRFbNVPzkPOrOuk6OGiEKTS1f9I3wQsXlznwWe0wo_w&oe=6AFDC8EC"}, "display_name": "On Point", "keywords": [], "long_description": "**On Point** is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!\n\n## ABOUT\n- Compete in over 90 minigames.\n- Easy, medium, and hard mode.\n- Local, global, and friends leaderboards.\n- Tuned for all experience and comfort levels.\n\n## DESCRIPTION\n- Arcade-style target shooting minigames.\n- Newcomer mode, low intensity, to ease players into VR.\n- Hardcore mode, for experienced players to challenge themselves and the leaderboards.\n- Fully in-world experience.\n", "short_description": "On Point is a shooter, filled with Warioware-style arcade minigames. Think, aim, and blast your way to a high score through endless shooting minigames, but don't hit those bombs or you'll run out of lives!"}]}, "developer_name": null, "developer_privacy_policy_u
8_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UIzA8rb17AQ7kNvwG1iyJb&_nc_oc=Adl1N90jQgGLL4Agptow-nxjgWUHi1L3lOjfFu_GiteFqQjaMl97lRu_Hw6n0pYujHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvv_wryrH3-fd_Ot2PQ-SQ-NrvQuVoaz2Oy0VVUF4M9SQ&oe=69A6E956"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm3Z5HEHK5kQ7kNvwHLOu7m&_nc_oc=AdlHIzirdm8QswiUwUZCLEfsi-9vO65vByfzWnajxVAVTgSiG9YERV0YY6dnoOw-GKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2Rzy2TH5FQGrnpF6ssmo-pfkGumqtdPaoEJrPcB3ybA&oe=69A6E54E"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe-o_lA5rRAQ7kNvwEREMxz&_nc_oc=Adkapobvvr5-rVaFHmB5y0n8xWonKEPputjF1_VzSr82a6y5ZsIapwWxdCgTKVr04F4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqzrKac9ZS4vYWJgOQUHOVvYN0l_sNM_KOSDD_f0FJNg&oe=69A6DE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqUg02NzUbEQ7kNvwFh39Xk&_nc_oc=Adlrb4fIOunS4J8g48WDuwqnF7oG60plP0Xz6vtG_2l5Dr-nOFFHdxECYKEZYz3uUnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfugB3stugSVz5M3tP0Yfx0JHjVQGtpLrfoJMIV1vwzEVg&oe=69A6BDE0"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "896295805113002"}}]}, "scheduled_offers": {"count": 0, 
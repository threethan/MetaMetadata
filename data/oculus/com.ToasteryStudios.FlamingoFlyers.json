6Kv7Z0dp7vzMfJcNZGTow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhm-DO2eo0kzGfXqS-Aslg7k5l7UjpbHcaTQ479Z3fXA&oe=6AA0124A"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EUKpRpTHfgQ7kNvwHcJGdH&_nc_oc=Adq2ClAUtzjUpARmoUdpMnjrgMB5KuShshYkgrJyYUmme82RqOws-RquqoTgTyX_930&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWVTxLjsJz5ZJz_d6SYfMzSu6v6CCxwtenWOum7Ubvgg&oe=6AA014D6"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uslMV4wH6AQ7kNvwHzLpin&_nc_oc=AdoZw51NU5oWpZYArfG0rF1WC83uk7spiwGY7nsC3S6QElxe6fetJED-4bQE9lYEwGE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj2B68Qq8ZppZVWVAeP18v3xLamn_8BEz9keRiV3xW0g&oe=6AA010CE"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIYuWiRar38Q7kNvwGnAkKu&_nc_oc=AdrX9WiDLnqDaD053F4kKI78TY4TvqBO0i82ArBsicizr12a96AYyeOZA1uwWYhTJvM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvgqjszBE8y13ayp3tvNushv-kwV50rus2InLMdKqYLw&oe=6AA009D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHephz-c-qsQ7kNvwFnh32x&_nc_oc=AdrBlQuUe7JNs1ClnSDjsZQADXaUEjvUF1gQRQJDJ4umHfdVqabt-jB_UK9F2KLFYXI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7hxgW89msX4j_u-gjwOYynNczWE6zLfEhsGCAiOoQpQ&oe=6AA021A0"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
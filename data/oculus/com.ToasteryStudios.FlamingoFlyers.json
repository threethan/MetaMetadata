zD44zE_tDMPH5FxtrxOBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cTU7EeYkyiAKiaOCS6Hvi49Z9W1-EeKaUJn-ctlV4rg&oe=6A3548CA"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71n5LQnOQ0IQ7kNvwHQfW7L&_nc_oc=Adr6qdwzWt3IIlkFGs_R3CZO9xgeK7xV_UHhS1KPWLbOx45LyElvf5G-w896ihHajjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rJw8zxBsHVtAcoqifpFpw-DyKJzGdW0fEqQ6-T2fucg&oe=6A354B56"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNo17om2bVkQ7kNvwHFGkUC&_nc_oc=AdqperVpyuoQU7IcfFfrGY4sp0E3hVnHg59IwPuroD3faZQGZKqALFk6h1E3Gxzujds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I4IRnZhMnKjaRY2_8Lab2LtQaVkhQz1IiV7JhJFURUQ&oe=6A35474E"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO9e_X6_LIkQ7kNvwFxMCPh&_nc_oc=AdpUglbm12sDbhB8E8XVvIXJW-3ppfgpuOdcQ-LcW0f9tCkG3566mchNuL0I4MxJklM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tN1pO_-s7nqRKoi6ajFo9oBiIKRmkXJqTUk1XBKtsOQ&oe=6A354052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ppz4xUZFjAIQ7kNvwFvcmxM&_nc_oc=Adqvrwdcs5ECfeb3QC07DYpDqOec__dyliJZAFeVR300tiaUTTLe9beR0pqkeG7UwbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yhmwz0FWOVPHdz-v4kjSfrOFNiI2554euUqlVrZEVRA&oe=6A355820"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
content-sjc6-1.oculuscdn.com/v/t64.5771-25/57570295_794152864986334_3130489345579551787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31FElvXr0p4Q7kNvwGA8vA0&_nc_oc=AdkKLFXu3MkdLLsDNq8tKdxy4A-PhCGATVQFF18BUgW8M8eUmXxFX6np6Sxi4TPDaC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afukd5C4d-wdPLINpJC22I-UBUK6M5GfFezYPZc8JwX92g&oe=6998664A"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IjQZZsI7nAQ7kNvwFq-6wI&_nc_oc=Admbg4T7i8B2Z0pak9kxA6uXOywZGFR2iAWUYpD9KtNRY6qFWOlQIlujTw1JBidmS3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsSKRZ360sUASD3NXMktlQUTSU916y7P5JnoHizrDoKdg&oe=699868D6"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Av8eHOzXtMQ7kNvwEbK3ls&_nc_oc=AdkzT5n_Zz4gh4TERDcx_P0RPey8n7QpClZ-7tfGwoel2kfjew4DY27kk9_SIEmq2l0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvH3BfrigwOgggI6xws4MaHmcbxQ9NdNgjI0Q8vduhsMw&oe=699864CE"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmfxW74TiLQQ7kNvwGZMYwB&_nc_oc=AdnJWmN0aqBAqDJOIm7XUs0qdizCrD7gVXRH3-3FnM0OkDo0wjyy408YYMGM_U_W7pU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs5CQwciM5Fj2pcJ3vXeshGgPD3VRq84ibHyGQDVqikmQ&oe=69985DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmG4mDG82p4Q7kNvwE-UVA6&_nc_oc=AdlAFOkRwdK4vcl3uGQEmj8roqcaVJPcW194NqeDDqwgHPdLsA38Qn6h9JsY0ZTkP_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfviHKBxKpbMboEtvvAjUsbno1JKnboZ8ZLwFgjazHU0TQ&oe=69983D60"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADV
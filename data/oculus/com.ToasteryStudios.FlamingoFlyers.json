-iAP4o57Yo7jrCSnw4Km8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtq-Ocm2Zzg5jOQ2lc1sphHSXVO0RzrPL3o-vLLwFYlQ&oe=6A91598A"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV1G0_BJv24Q7kNvwGUAmuc&_nc_oc=Adq3MQApg63B0Jw6rgBDEvC81YLOxRoWJhd4HogCVgGANSNnBzRMEJQuIHO4KjQvoCc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMg8QSH7sfzIDl7PUjo8QKkRZ2D6-Q-ZtJD6fimqIGAw&oe=6A915C16"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99UGlRmHMScQ7kNvwE98J1L&_nc_oc=AdpRGESsGlrpDW3aaiLkUumn-QvtwqhMMpLEYXZB9nZi8zR3bUzasoF977QrD_gtrZo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyMKnoPQWHlR5I4VMyvGaN5jkVl0K8uMUffNj7SblhBg&oe=6A91904E"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSPz5BOglAQQ7kNvwGXNg2k&_nc_oc=AdoiKwbW8Pty0LgD-oL21QuZH_P688a6RcrZYna6-gjezO5ZQazh1akI7zbRN-4Rd84&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjBKLCaRec0K8tDEUKtfcfhigDCx54mc9wjrRsPIlwsA&oe=6A918952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udf20lpt2E4Q7kNvwFaxpdO&_nc_oc=AdpSKtfLg3XlDiMbXPiBwILr-vfT3j7ZY_Oq1YZn1hxIhbJU9iPdF92zmAOZkKBtnNI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjKmvsQ1Na7NyawqXMcN1oR_56rnJTzDIMdjRfHtUC4A&oe=6A9168E0"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
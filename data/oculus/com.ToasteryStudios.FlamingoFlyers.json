ak9kNcpDzl2--b0GF11EU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aY3QTDa3iUNtDB75QTRiHU6xhVkd5i9aYmWkhU2m18w&oe=6A008CCA"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5hXxGqCuT0Q7kNvwHmguf3&_nc_oc=Adp8s_MGmobpHIwELSYCIzpKH_n4kBX9QFTB-dT-1BSKcaBl3f2cZ9RPTkSQGEpU0Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BdSTLYwnNzJ9__dVpHjxdDhquTsF4Qr5ROSVO1HUKzw&oe=6A008F56"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW7eHK59tIgQ7kNvwE5wZ0t&_nc_oc=Ado-DO3gdOXzP1sArnKq3FoAG1CqZf8pbDyFCPBZrz7mutKVYkhUwNz4-BpsXAO3xQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73VBZKswuNqEvLEt6CHFUi-pMm0xOXruqTX9MqPF-2Gg&oe=6A008B4E"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKTQ-0hLVW8Q7kNvwFxqurS&_nc_oc=Adrh97dpi4RiNmBrkz0KyxIP67GLETpn0bQcDeK4ys_6txjzanT-3VmCK0niCqc_Voo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bDYfr29FCZvGe-Yx7hYho5o-af2kvchlncmcbbTIiqQ&oe=6A008452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJuwGjuwbCAQ7kNvwFkQsRG&_nc_oc=AdofiudwFPi-okW5x1vrrpXYMrc2dBsRVUjnaA2XYsWmBuUkPxo8JQyOgwtYHrTl15I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48q8FziA6pJPVHHnsDU-rQbo2PNAp8Nlwu0fHlsdnM4Q&oe=6A009C20"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
QoN_Bvtu3_FMMjWoCEr-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nyz0KvF0ftoeO5oKHqHjxLsDJtnMis_SGnbu-6_9qOQ&oe=69EA234A"}, {"file_name": "screenshot3.png", "id": "656326242822239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974819_656326252822238_3728324384587642172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tF0syyqFaoQ7kNvwG-guVC&_nc_oc=AdqoSNicE3vnfPpUm3hEHMDuRqHndnfbXfdu6TEr7cmA7GDtVHLHnS7U75eP0G0WHeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OOiFMstohEl-UH95gY4EAouEcOkOvvVjaZzn36To9ig&oe=69EA25D6"}, {"file_name": "screenshot2.png", "id": "832061318102191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210389_832061321435524_3478669676353719298_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTDBYO7NPR0Q7kNvwGjGUrL&_nc_oc=AdoJ9fd7P9zkg3_p7p49iZz-BZrncg-L7F2AoQfmM8rQf6XLi4AMhRLvtm62VDGkwl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CmgEu9fjj2sjt1hxCYXMA1pNKu7Dbq11DVZ2oCn_7OQ&oe=69EA21CE"}, {"file_name": "screenshot6.png", "id": "1342867746117989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031402_1342867749451322_3872284319872716768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuiJZbuFDCcQ7kNvwHIF-RH&_nc_oc=AdqcPx4udUe5XPiBmzE47HfvgCbFDQg-rp2aRoNFB8mcGI1cqdNMR6ua2YkxATSTZKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nsw_aT9osdWCK6qKXCAwxNrIusk1FosZPjvns7cBjQw&oe=69EA1AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb.png", "id": "2952877285006142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481467_2952877291672808_4640184572027750368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2nlDxiDHZsQ7kNvwH7qj9-&_nc_oc=Adr8WtDtMTVSnpvOf46XgguhxR55t24_6GSmTZeI9p3EE1XhxPIkx9ThFxAIKh1X1gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oppe8M2YsgGFDqvxbp6z1FXMOhhlSQbkWL-MoxN0Uxg&oe=69EA32A0"}, "display_name": "Flamingo Flyers", "keywords": [], "long_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! \n\nGo skiing down a huge mountain, and explore deep caves full of waterfalls and glittering crystals! \n\nSurvive the forest with nothing but a flashlight in the horror mode! Invite some friends and get scared together! \n\nTake a break for a while! Relax and socialise in the main area, or head to the gun range, and empty a clip into some dummies (or into your friends)\n\nOr maybe try something closer to home, and play tag! You could even build your dream home with the sandbox building tools!\n\nCome in and join the fun!\n\n(P.s we also have a discord server! https://discord.gg/WSa5wRGdtM) ", "short_description": "Welcome to Flamingo Flyers! Crash down from a roller coaster into a mysterious cabin, and choose from a variety of game modes found within! Go skiing down a huge mountain, and explore deep caves full of shining crystals! Or maybe try something closer to home, and play tag with your friends! You could even Build your home, with advanced sandbox building tools! Come in and join the fun!\n\n(P.s we also have a discord server! The link is: https://discord.gg/WSa5wRGdtM)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/AtomBread/Flamingo-Flyers/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "AtomBread", "support_website_url": null, "website_url": "https://atombread.github.io/Flamingo-Flyers/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
o_2025-12-31_14-39-29.png", "id": "1233559355303084", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303672_1233559358636417_7392087802368481585_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ncWZd5yP0QQ7kNvwHceb8b&_nc_oc=AdrH9HKPHSuZXNtr3mlguE1RZV_jmJapOUSpn2EKyMs2GMTqTjrL-r-7Ct1VlrPp2BY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmqJQAZZUGDC3JyzkLn6-GopOLJMJynFq32TusxDqsiA&oe=6AFB465E"}, {"file_name": "photo_2025-12-31_14-39-11.png", "id": "879711677772467", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823296_879711684439133_3258108546588307233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p6z-ssZjaQQ7kNvwH1GNYy&_nc_oc=Adqb5xp2gJCE8loUo0UH22yTY1dVK_vBNPmJZbbh7Xytmf2fWh5VPLj-X6CDK3lMyKE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvSwqEY3XQsuqdYmphmM9bCIFHhirmpqpHJLYoXgwyWw&oe=6AFB4BCE"}, {"file_name": "photo_2025-12-31_14-39-14.png", "id": "1552279819230188", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820887_1552279822563521_2442619647669126538_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zskSAP9K2a8Q7kNvwGfPile&_nc_oc=AdpHujRTL87jq6E2N6KunWUhgF80eZ2kRe2FcBZVtACJfJewuTkNr9Nw9l3C9bYR7iQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIH2IL83GjHVn6KHICRPfyqtWEetPnsWyGl5jS8lbxbw&oe=6AFB35C0"}, {"file_name": "photo_2025-12-31_14-38-36.png", "id": "813994891539306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818852_813994894872639_5215314523067586631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXcoCoqVAlwQ7kNvwG-EM1S&_nc_oc=AdpY43E0KjUU4sReEk-oNSYA7vmFmtY4NS2e8aml8z4QohGqJvwoqNVE8AUF5Jm5x-0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3GW0ETtatXHv910G3ws-bOdYSEQ_oVdiv2wH5DiQ5Yw&oe=6AFB268C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Active IR", "keywords": [], "long_description": "**Active IR** is an immersive virtual reality training module designed for medical education and clinical awareness around **cerebral aneurysms**. The experience places learners inside a realistic, interactive environment where they can explore aneurysm anatomy, risk factors, and critical intervention concepts through spatial learning.\n\nBuilt specifically for **Activate LMS platform**, Active IR enhances retention and engagement by allowing users to *see*, *experience*, and *interact* with complex vascular structures rather than only reading or watching them.\n\n#### Key Features\n- **3D visualization** of cerebral vasculature and aneurysm formations  \n- **Step-by-step guided learning flow** suitable for structured LMS curricula  \n- **Interactive XR environment** optimized for standalone headsets  \n- **Designed for training & education**, not diagnosis or treatment  \n- **High-performance and intuitive UX** for short or extended sessions  \n\n#### Use Cases\n- Medical and healthcare training programs  \n- Clinical awareness and anatomy education  \n- XR-based continuing education modules  \n- Simulation-supported learning environments  \n\nActive IR is ideal for organizations seeking to integrate **high-impact XR medical content** into their learning ecosystem, delivering complex neurological concepts in a clear, memorable, and immersive way.\n\n", "short_description": "Interactive VR module for understanding, visualizing, and responding to cerebral aneurysm scenarios in immersive environments."}]}, "developer_name": "Musa Kutlay Tun\u00e7", "developer_privacy_policy_url": "https://kutlaytunc.github.io/active-ir-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Activate", "support_website_url": null, "website_url": "https://www.activateholding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
tps://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823296_879711684439133_3258108546588307233_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by8l1e2JeKUQ7kNvwGr6sv7&_nc_oc=Adp1bOInLMsReXgSoaJFd31CTTzX3XVtjwBb5Ng0DVn7WPfVn07Jx3hoqShben9YdTA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gzKZQ6sc6vnINZEf1ZKgk3hyvICxBEDFA407pHOALaw&oe=6A2C180E"}, {"file_name": "photo_2025-12-31_14-39-14.png", "id": "1552279819230188", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820887_1552279822563521_2442619647669126538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1DgOkBnTHoQ7kNvwF-iQQZ&_nc_oc=AdoFDsOSGMY405UF889I0vMAFOthfcepTqSmgyJUUTmCVOrJVe_jGvbOCdzpMeOx2h0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rkwj7UBhffedLSIyK5pujGMKrSCXWylGulgfzZnA7fw&oe=6A2C0200"}, {"file_name": "photo_2025-12-31_14-38-36.png", "id": "813994891539306", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818852_813994894872639_5215314523067586631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlm4RLsZdpQQ7kNvwFKB_jx&_nc_oc=AdrwYy0XQQMRYT_72juaG_C2zMJj5q3Lju2JrILWUYD45EYSWnf08d7ceaWjsu7TLjA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_971lGXxPXS_JlLiDpYN3yiBn7suSrj2x8jWDW5TncUg&oe=6A2C2B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Active IR", "keywords": [], "long_description": "**Active IR** is an immersive virtual reality training module designed for medical education and clinical awareness around **cerebral aneurysms**. The experience places learners inside a realistic, interactive environment where they can explore aneurysm anatomy, risk factors, and critical intervention concepts through spatial learning.\n\nBuilt specifically for **Activate LMS platform**, Active IR enhances retention and engagement by allowing users to *see*, *experience*, and *interact* with complex vascular structures rather than only reading or watching them.\n\n#### Key Features\n- **3D visualization** of cerebral vasculature and aneurysm formations  \n- **Step-by-step guided learning flow** suitable for structured LMS curricula  \n- **Interactive XR environment** optimized for standalone headsets  \n- **Designed for training & education**, not diagnosis or treatment  \n- **High-performance and intuitive UX** for short or extended sessions  \n\n#### Use Cases\n- Medical and healthcare training programs  \n- Clinical awareness and anatomy education  \n- XR-based continuing education modules  \n- Simulation-supported learning environments  \n\nActive IR is ideal for organizations seeking to integrate **high-impact XR medical content** into their learning ecosystem, delivering complex neurological concepts in a clear, memorable, and immersive way.\n\n", "short_description": "Interactive VR module for understanding, visualizing, and responding to cerebral aneurysm scenarios in immersive environments."}]}, "developer_name": "Musa Kutlay Tun\u00e7", "developer_privacy_policy_url": "https://kutlaytunc.github.io/active-ir-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Activate", "support_website_url": null, "website_url": "https://www.activateholding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26332658246411920"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"stat
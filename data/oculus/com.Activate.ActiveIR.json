24700_1383690846557190_4435333718392176597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8r5l3k-XJgQ7kNvwG0PIyC&_nc_oc=AdpDmYpMuSi5d8Cid-Fz08Cfie4aAGlfjSZTE9GwqShmSHClB8WDjDCB4M_UawHxjak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c_RIoNR4sUgqn4H3_VopzUS_FNgJ5ao4uEhr0iP7Icg&oe=6A257050"}]}, "id": "1299931838766844", "locale": "en_US", "screenshots": [{"file_name": "photo_2025-12-31_14-39-15.png", "id": "1800658770589947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1800658773923280_3586200645486051978_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjghx7Ef_RkQ7kNvwHyNVm2&_nc_oc=Adr4QHdSfpV8_FKNu-Kr5nC9i30ZGOiaEpBRoZ-3alGYQIbW8qcb54NGCoDMVdWBdvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af935tTIo-jLGtOR1yFQ_Ti6g449Smr4_sa4cWjwbhDOSQ&oe=6A257294"}, {"file_name": "photo_2025-12-31_14-39-29.png", "id": "1233559355303084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_1233559358636417_7392087802368481585_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIYsGXRHxz0Q7kNvwE49gEX&_nc_oc=AdrXyjhXRRJ_bBHqIeO3NnVN2zdDjMY1vtFex_L0AaKgCgl4y-0LiNs5r8zAz-dze0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96FNABZQ-1NYPr1xkAoa4p-6h8e02dVpcL8FhH-ZQ8cw&oe=6A257B1E"}, {"file_name": "photo_2025-12-31_14-39-11.png", "id": "879711677772467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_879711684439133_3258108546588307233_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_CH3X3QlssQ7kNvwHtLYog&_nc_oc=AdooH8DfTH7zvUmkDoh3w0uVcdDmYyyrlLAuZ6MYpyaGWLN1Qfg7UDsU2rWTjLEzakY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5g5KMxe3szoeZk0AZguasqizxbuoYSdITImrb2BiKDw&oe=6A25808E"}, {"file_name": "photo_2025-12-31_14-39-14.png", "id": "1552279819230188", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1552279822563521_2442619647669126538_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rnQWjbXUG0Q7kNvwHUCS2c&_nc_oc=AdocLJAq6fZE57K8GsK-iA5wdMEFxZPEyGdwchsWm2-pk0Ts6wUULbTBunDGONq0B5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pqXxwlbhycSXYc2stJkB0dAXsup8u1bjRZ90wJEtQ8w&oe=6A25A2C0"}, {"file_name": "photo_2025-12-31_14-38-36.png", "id": "813994891539306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_813994894872639_5215314523067586631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOgKC-lbdJ0Q7kNvwFwavF2&_nc_oc=Adq31j17wVzyJa4o2xcr_TtY40lsrZ6ZMg4swWZRZ-cOAKiEAGSaVZbxQBiOkW0srlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NsLbJpQIpK-WEEprV6wgHkJ7xAxFpmrx_jAM2MH2LDg&oe=6A25938C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Active IR", "keywords": [], "long_description": "**Active IR** is an immersive virtual reality training module designed for medical education and clinical awareness around **cerebral aneurysms**. The experience places learners inside a realistic, interactive environment where they can explore aneurysm anatomy, risk factors, and critical intervention concepts through spatial learning.\n\nBuilt specifically for **Activate LMS platform**, Active IR enhances retention and engagement by allowing users to *see*, *experience*, and *interact* with complex vascular structures rather than only reading or watching them.\n\n#### Key Features\n- **3D visualization** of cerebral vasculature and aneurysm formations  \n- **Step-by-step guided learning flow** suitable for structured LMS curricula  \n- **Interactive XR environment** optimized for standalone headsets  \n- **Designed for training & education**, not diagnosis or treatment  \n- **High-performance and intuitive UX** for short or extended sessions  \n\n#### Use Cases\n- Medical and healthcare training programs  \n- Clinical awareness and anatomy education  \n- XR-based continuing education modules  \n- Simulation-supported learning environments  \n\nActive IR is ideal for organizations seeking to integrate **high-impact XR medical content** into their learning ecosystem, delivering complex neurological concepts in a clear, memorable, and immersive way.\n\n", "short_description": "Interactive VR module for understanding, visualizing, and responding to cerebral aneurysm scenarios in immersive environments."}]}, "developer_name": "Musa Kutlay Tun\u00e7", "developer_privacy_policy_url": "https://kutlaytunc.github.io/active-ir-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Activate", "support_website_url": null, "website_url": "https://www.activateholding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26332658246411920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1421922309532147_3599948136465044868_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4r1aREfcldcQ7kNvwGaAmiH&_nc_oc=AdqRNlFT8YY8RnTfdTKxYvV67XpaZQ2c1P3DasGkM-Hah_dzAspTb8Cr6pOoswGbvKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DzJkC3oYwHH6HWZ7MUh_hnVcFwoWzWElKC1bqVxMs7A&oe=6A259E59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Active IR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topi
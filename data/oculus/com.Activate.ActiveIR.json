o_2025-12-31_14-39-29.png", "id": "1233559355303084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303672_1233559358636417_7392087802368481585_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWnj0A-93m0Q7kNvwFPhEzU&_nc_oc=AdpnYzOfMl7rhwe5y6tIVoqQVprA-K0bHC0fwRcd2kWdGP8KoJKf4_CHLqHDQ16tcEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTD90qzrUt1N0MUTQ3QjxYyhdpniGhNWJuL6vw8RalxYA&oe=6B0DBB5E"}, {"file_name": "photo_2025-12-31_14-39-11.png", "id": "879711677772467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_879711684439133_3258108546588307233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQV-2r6hupAQ7kNvwGTjGVO&_nc_oc=AdrBjfYuvDPb-8dNL1t7smFWvwqM4CU2T810wZRR8q2ewGKfhXBkhpsW4qsp2OlAO7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4ap30sJkOyzI3W34l6HFr9WVIsWPsp5EUjI5zrfulaw&oe=6B0DC0CE"}, {"file_name": "photo_2025-12-31_14-39-14.png", "id": "1552279819230188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1552279822563521_2442619647669126538_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jfQgXZSaHEQ7kNvwH0JCy2&_nc_oc=Adp61YXMn1idVd6Vqyx4bKePo_lLk6rEN0RdjYxn6bNwTOMoLrKeYvX-I6kACiTy5EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-uSGz_Hk0HDSMfaKV1y8soBImu_mOu3PgqEhzw5doPQ&oe=6B0DAAC0"}, {"file_name": "photo_2025-12-31_14-38-36.png", "id": "813994891539306", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_813994894872639_5215314523067586631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrjtiSda5-MQ7kNvwGu05Ru&_nc_oc=AdoF8CvLQv-aLCNU4IdgFFvXHG4Uvmd0U5NEOEIeRIml_8Kxo2OrWnbmuOn_hx-lbAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcK0awBNdX9KR2jZdxZQMKundqESA_NPasJKOzCqKDhw&oe=6B0D9B8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Active IR", "keywords": [], "long_description": "**Active IR** is an immersive virtual reality training module designed for medical education and clinical awareness around **cerebral aneurysms**. The experience places learners inside a realistic, interactive environment where they can explore aneurysm anatomy, risk factors, and critical intervention concepts through spatial learning.\n\nBuilt specifically for **Activate LMS platform**, Active IR enhances retention and engagement by allowing users to *see*, *experience*, and *interact* with complex vascular structures rather than only reading or watching them.\n\n#### Key Features\n- **3D visualization** of cerebral vasculature and aneurysm formations  \n- **Step-by-step guided learning flow** suitable for structured LMS curricula  \n- **Interactive XR environment** optimized for standalone headsets  \n- **Designed for training & education**, not diagnosis or treatment  \n- **High-performance and intuitive UX** for short or extended sessions  \n\n#### Use Cases\n- Medical and healthcare training programs  \n- Clinical awareness and anatomy education  \n- XR-based continuing education modules  \n- Simulation-supported learning environments  \n\nActive IR is ideal for organizations seeking to integrate **high-impact XR medical content** into their learning ecosystem, delivering complex neurological concepts in a clear, memorable, and immersive way.\n\n", "short_description": "Interactive VR module for understanding, visualizing, and responding to cerebral aneurysm scenarios in immersive environments."}]}, "developer_name": "Musa Kutlay Tun\u00e7", "developer_privacy_policy_url": "https://kutlaytunc.github.io/active-ir-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Activate", "support_website_url": null, "website_url": "https://www.activateholding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics
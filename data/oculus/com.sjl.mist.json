irst-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwoO2nhdtxQQ7kNvwFl2i6T&_nc_oc=Adq-GL1bicKmPzYS2bLBTAIYclQDSfmq9ydJ7N5iBXGmuC8THKrye2wr87ZQmk2E9-0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O61fCnydjKmFc9F66QdR9zlabQF7whhv1aSBS3iQ05g&oe=6A394668"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata
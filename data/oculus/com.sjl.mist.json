564525967492519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8nRoko3PvIQ7kNvwF2hulN&_nc_oc=AdrhlWy_7NcJrjkOZxptaXNqLF27Tq2ODxlmBIURDp4H0BqOVRxmLHDRDsm9-GKhmyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz2sF62PtD4bDIiC0PIyNuv6qXW10I6DI_I9lF0uLNzw&oe=6A4A78FB"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX_M37kN-2EQ7kNvwE6FtJs&_nc_oc=Ado6aSUriqa9lt3Yn6eRpZ0CBJBq9z_oRj4OjaAZyHAzLkESYC9Rxnxuqa6zn81_yso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNUye-CLB8bIaJoxqKEz2OfrrKx8g-gLRrEJQXBx6WBw&oe=6A4A4CFD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK3JPqJw7D4Q7kNvwH3nDQS&_nc_oc=AdpIgJpG5Aa1ruKAM5g8Dkwvar7ZCh-ODNS0kt12bx9Ko1g1icwvmz5HeP2fD8UaP0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-DcBskZE3ODq8YbEV6X0JFcOJQNUfBAfD2OzDXbFWuQ&oe=6A4A5A70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ntpWrupTkwQ7kNvwGu2c_h&_nc_oc=Adq0VBrJBIo4eAgL7Rk5l2AIVT6mD2w4d4lpjd9j5ob_zvUihr9-xJXqmDrW3veNjqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcVSe7dv-DK8aoMX8ZSBxaMDuC6PeU1naFrRnZNggtXw&oe=6A4A69E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
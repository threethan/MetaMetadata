564525967492519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWP89Z3bQVAQ7kNvwEbiLUq&_nc_oc=AdrdGNPj_IquTlvGmkBmfHp_txf8IoKFBma3VYi3Nbh0INd-EZD18F5WW4CZZGbWABc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEe51J0_NfdpEp8jO2djArzCbl9ha90tdpyo9hYHBdfQ&oe=6ABA887B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KO6HjKoz3kQ7kNvwEBQ52B&_nc_oc=Adoz5H4q8dkgOI0t6R4phQ6xr5v3bzTfca2IHQ9McxiZU01FFEc3Kjdr6Y8grEBTNkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Wc4S3Y2Kg2zGc1WLNTyLQ5Ka60CpK80E1FPpKAae0Q&oe=6ABA5C7D"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bts5PVGMsXEQ7kNvwF_n7y_&_nc_oc=AdpC2tktQHOu97fshI5gqeSv_nB7w1fn-oLAFAQ_0HJXROrLVjM6T0Afh-oYC6Kwb6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInaSacoX15qo0il9Misu5DGrTCh2j97LqMPmTN03S0eg&oe=6ABA69F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOEJniMLhJwQ7kNvwFZqnh9&_nc_oc=AdqQcsTDEBd1zPePYjE2BKZoyDSAl4gxMA_bm4WVFoUBr5h8h09Btql9QYCLy6Wbc9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0KqVMSAtzIcW67RzTjz46eCnDhePd3nAOjlks2WGT5A&oe=6ABA7968"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
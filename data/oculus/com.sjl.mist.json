564525967492519", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elfl15N6fFkQ7kNvwHu2M66&_nc_oc=AdqMKS3AF4e0gPZnv_n-uWFhZ6XDc8Nh0a_lYqv71p71b3wpeWDMEOQQo4GV92d_-O8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Tw6AnDGVhdGwspZDsPGQ1c925hUdPfefYRvKod17oJw&oe=6A1C547B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRmdsN1-SOcQ7kNvwGRggj9&_nc_oc=Adrp76J-7IOBP2B1gQuFhcmvtJar7amB_XZECoYSpTt629EKwpRIS0TRFPtJWj2vBxg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pI39FUCIklfUAUdrd9Pb3KoJgP0u2xrjSlI9Fz4UQQg&oe=6A1C60BD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZIIRfTf710Q7kNvwHffo3W&_nc_oc=AdpAJJdWWIzCj5pU2osNE8zEadtxyQWqggIU4CbPoYVUEOBaYtU-v-o45hy8hJ6lPb8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l2GYm12jeGqYFKr4G67NE5kTncL0GwdfH-oPnAuqZkQ&oe=6A1C35F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG-YCFbCmC8Q7kNvwFaiPf0&_nc_oc=Adp7rmVjFa9xhRGL5IYcQ2LkQ7zsRfg0wAAskHiZw59nczVTLwbY3D7r8LIo_l5ephs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yrTRJd5xUecBMvhXLGVRDy42_uKKygHiTgz-ng5ICgQ&oe=6A1C4568"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
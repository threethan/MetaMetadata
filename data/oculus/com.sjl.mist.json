564525967492519", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7dm29Yrt0sQ7kNvwGNYbLI&_nc_oc=AdrK61AW-wbtttQ2kVL4CNVvH0cT2AzbNlU4Rt9_-Re2bXn9Eg4fqRO5vkaXm0xHQV4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c6pwdtawqr-ydNkHGUQWzBP9qFnfLpiocUo0SX4eFGw&oe=6A2C267B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9SmUumO4xsQ7kNvwEa4UDn&_nc_oc=AdrlTPNFQ1O9nBXQcc8OUm2UH-hGI4vAHqi6MUZzERotAys9FMxnruXj7ZGWusy6KmM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OsHVrqX7eoaKhFwLExBDOQYk1jVCPD5FVWlXK26SpTw&oe=6A2C32BD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_BVhhKLogwQ7kNvwGNlWyV&_nc_oc=Adpjahv_rZrWyyGnQ58c3-wIgZJULTZbbN6MTdtXZfb9R_aWZlaYb_0IeA0WzC09yY8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b8KkSKoRf4Bq5_vPxbDIxM3OZksR8IYP49jI3m-ToEQ&oe=6A2C07F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbkU4UTdeQgQ7kNvwFwUkgk&_nc_oc=AdouQrMHQqe1TVRvaHJKcyN33_zUzKttpy6mUSZqmvVgmla4or0p7X6rnZA-uzyMraY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i_4ZkfyFPdBQfpzbakwREBieHHcy_xthuXO-Hd7za6w&oe=6A2C1768"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
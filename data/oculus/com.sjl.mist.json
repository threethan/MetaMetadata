564525967492519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV9frzmJiecQ7kNvwGQcD5X&_nc_oc=Adr5KP4ulMk2xrPeuJhRtXTOpOF-hiToPKEpTQ8wD6IAji1g014czd59TbrnFYPl9Pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q7VHXECO9VRGuBkhEULHxYBZx7yury_NUrAG-CszIvA&oe=6A316C7B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtpZI0htzQAQ7kNvwFAn6WS&_nc_oc=Adp8-EQ-fzOzT3oPcQbj4OseBGL6O07AmsZ607HYTOAucDjSbPEqhXgWm5YOdXLlIx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8idruwRUL5bHbvzt4a490acC5q5LO5XiNY3O3iL0JO7w&oe=6A3178BD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWgybiTbvssQ7kNvwFszwca&_nc_oc=Adr5wjY9MpOfHmhWSrBZ_DV6yP3AIUSFqwDm5_FOKcqNmbxkDEm8aUmC0Ml8GLWdG2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6FRfpY1yKnshvKnAbwp4qCkBlea9lnllYeWjTCZc1sA&oe=6A314DF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEZpR7OuJg4Q7kNvwFdpMRE&_nc_oc=AdpJjAn9D1I3J73J8L7ZlkhQSUdGPBpxETUi5Nfiftl-tG_KvmiegWtEi1eDK2SHK5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93c395JnjamsAO3lT7XQlDv4v9ZpF5009BtnCaxBQ0tg&oe=6A315D68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
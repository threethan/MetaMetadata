65600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfgplDQ07VAQ7kNvwET-P9J&_nc_oc=Adl5r9XMFVevee24fGSg9Km2I-VGwZNHaVv3dp_AdUhpdhOc-i8QqR7UxCyNG3dX1pM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftEq3DsrkWAT0AGKvNZAKzcAwCiOWNzPXMH2v1_wewnZw&oe=69A423BB"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5w6Aa3OdSMQ7kNvwHbrFik&_nc_oc=AdmhLBKXaS9OadcQ14c2ETEJS2RIssyIufzjHKAInoesguGGzNrsM1T1YRjljr9my-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afttf3wMFRfO3otmMv8T6_5Ztt6rKOTwwVd6fdgXF0G-fw&oe=69A42FFD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5lh35q3yoYQ7kNvwFiskwT&_nc_oc=AdnXbg1g8wmGNfCCH0mTo_aiQms4okmf_oldUvWr5__H2HIPaKVbnQzP4-qCZ5bZPb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvr5ue5XrEBpZ3YGnBMG19zJuAA9HiPdXlEsf0Fcr4fIQ&oe=69A43D70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eslgp7bv0KYQ7kNvwGjxRlO&_nc_oc=AdmjaLjnZcXF6KOBFs89Q3Wrop831WLwQWloNniyGvO_rDhfdLuWExJQKkvQL_IBSi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftYV1qTIgoPUYygC1FR3vdf8l9QikMi0t1wKxrB79xdUA&oe=69A44CE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1471907882820219", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "ia
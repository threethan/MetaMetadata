65600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3gzRE-rXWMQ7kNvwFwZziV&_nc_oc=AdqEEaqemO2UWFAUfLjjhQuiG8XsPoGXrmgil0t3yX1yLMP39cYfovJl7ocJXYcsLcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0yln4m0yZ1cTjOG--HtADjPleWkmMGo28GsR0DfhNB1Q&oe=69F0D2FB"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzDzsSt0WMQ7kNvwF6G9-8&_nc_oc=AdqXO1Pzh73kOwNoq7j6hGK9dIFT4UcGLtp-CYCArA8R8judwF3CCKVLvY4TtYT0Hy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0mgalw0zFJmrs99PJPRsEsucNg6jLsYto7mqW4Mm6s9A&oe=69F0A6FD"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDx2RrH2FogQ7kNvwHCsCdM&_nc_oc=Adqh7xSwaDUq5agFff5bYt-UBeoBy1rpenfLTPjuwaLDoKFkmdtHELW16lhj5tOs0AU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0_jNz6Fs-juy5aVGS2NYbYzc8Xi_PwIDgnYl8eUXDhOg&oe=69F0B470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzgyHs0XFPEQ7kNvwFkv8uT&_nc_oc=Adp4qfayS06I3U5I9NKRUVusUDOd4w4Ncli9XmqQoid7YlPqxSPrlM3j0jt0tMGr-i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0vfSJCbvED3G6kCozaJizniHI7zZ2BB8A9HiNxoTGgHg&oe=69F0C3E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1471907882820219", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "ia
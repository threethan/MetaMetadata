564525967492519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH4JUetZ1VcQ7kNvwFmpdYl&_nc_oc=Adq2lzZ-7pxp2utH0VLg-wIl7pWHjQ60EipYqbxhZpXpc4qyQ88ltJz6CllwYgZxj7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2DJotHB7rcr1vEMFUAmov0vSV5RDybzWeuwXPTlSMPQ&oe=6AF095FB"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK9JbOytZd0Q7kNvwH8svjt&_nc_oc=Ado5feh3Hz_tojY7du2ISdZ3hzlqUx9K3sfO-JQuG19dAbM1vhUdAxxw6PrRFPar96A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9CQfJfnlgQdJgYBxMz30A27U41PFUkTRSEBtPr06jDQ&oe=6AF0A23D"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHoAkqd5fX8Q7kNvwGZTjcf&_nc_oc=Adpum3OTKL8GOBt2oxQO8wgoF1ngKc2yhUS2u-ind4tsh4jDVeXKOyQW8Ms0hNYt39w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqV3O9nRwLcNBEJxd9Di75B2wrUmmNpzBjpdKlepbTXw&oe=6AF0AFB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Em4rqDvv28Q7kNvwFuipzi&_nc_oc=Ado9eV20urYSCj6Bq5fY5DAIBXCbaGwmuJ4kay37PDNw4FJvwHci7F6Vevik1JpUWV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXhuUU-D0pwqHujxuo7OmyR-sKQyCabpgFaYAFngfsOg&oe=6AF086E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
564525967492519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727894_368310726875442_5965993471482265600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo2KT87_5q8Q7kNvwECXpBw&_nc_oc=AdrvMUtW4NOMHkw_DqTBPyBzzr_pewticg_v0MeDIPrx0pyZBrAy1Lhbs2a7aMCrT0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKn-sNR5CHFd7444z-EHFmmATskCNndyKNMAyvGfh6yA&oe=6A51107B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-X3b_neI_4Q7kNvwFgV_u7&_nc_oc=Ado9o2O7xRl1vC1VRPPNRgVw-Ed1K65PCrIDr22Jx3t-n81Dj1iqbT9cFRQoFAKFsNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzs--b5jQMElqNYbR2YG41qXJRcgg3snV5OuD76f7MOg&oe=6A50E47D"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFU5r7K6WOUQ7kNvwEkpBYZ&_nc_oc=AdrDJvY78PzxuJXBr2yEHqPXT2o3hkFdOEmY8WaVoQ_rpCBg7CXD9NJ1_EAE-nrV8pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlnhGcA1vfnShibRisoujzIybW5HRrRZbkm8obeZJddw&oe=6A50F1F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llgIPlyJcoMQ7kNvwHwrKtI&_nc_oc=AdruVx6G3its2H0xw9fYSwz1xrXv8ZO48p31FSZ8qJPY3nMefqAQ-qFWhmh9J6GEYXE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQYqSu_ytjwzKr6tXyfYjMogjCwIP3m_pXRg7wT94KnA&oe=6A510168"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"a
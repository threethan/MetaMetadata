65600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15bW7MJvTLMQ7kNvwEm2-ky&_nc_oc=AdkOlgSOOaQ7W2hi5xaUcFXgL6X3m2-nldryjcCbUpekDrnOvqW6-CA71HyknfKrZMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQMPnKw32M2jRfLMUt4hT7BvsplTc8tOct6f2PtgqMHw&oe=69A2D23B"}, {"file_name": "migrated_image.png", "id": "2298461123786420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727931_1778683929063417_4241997283949805568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drqxsnwk6qsQ7kNvwGXdMm2&_nc_oc=Adkd8KsfklS_3b-TXQsD9lWk9Il42P3vgIIxy2FZO_HTpBLTIM7PKKrMi3125r3QnJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSQ-atB6OaSeuct2kNeQZNzzTq0IAXaYYlJE9YxHBPrQ&oe=69A2DE7D"}, {"file_name": "migrated_image.png", "id": "535968277334304", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727868_149986445493898_1448925397902163968_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5lh35q3yoYQ7kNvwHNW2aE&_nc_oc=AdnanF6uHYqJeaaIq5cX-BPmqEhj5PseQZpdKFWW4lKxs2fH1m3ZHB9VHlc4t_dWt7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYUTYxcoziNiLMO_p2GU6xNAoO2aoMEzmZ1USowBpM8A&oe=69A2EBF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIST", "keywords": ["VR", "RoomEscape", "horror", "Decryption"], "long_description": " On December 24th, Dana\u2019s child was getting cold in his arms as the chimes of midnight struck. After his parents had died, and his wife died in childbirth, the young businessman had lost his last relative. \n\n   Shortly afterwards, rumor has it that the young businessman went mad. He always holds the picture of his family and talks to the people around him with a creepy smile. People all ridiculed him. Gradually, the townsfolk forgot about him, and he and his house were forgotten in this wasteland.\n", "short_description": "\"MIST \" is a first-person perspective escape decryption game. Players are in an abandoned foreign house where it has cold floors, decrepit furniture and swaying lights. This environment allows players to continuously discover new clues. After players solve the puzzles and walk out of every room, they can successfully escape from the house at last. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mq11034182.icoc.me/", "developer_terms_of_service_url": "http://www.mq11034182.icoc.me/", "publisher_name": "Jacky Xiong", "support_website_url": null, "website_url": "http://www.mq11034182.icoc.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "HORROR", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2293760720767145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410400_365611807119551_2022285716393820160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eslgp7bv0KYQ7kNvwGo9XM6&_nc_oc=AdnuQKCJzv69CPmmgwSAw5QbM_JK6aAZBUHIljZ8OBrAz9OijMKXAbs3hUdjuuhHCKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmGjZgAcHE5w3BQy2cHqEKIP63Rc579sgPqHfsx6_awg&oe=69A2FB68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MIST", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1484726400, "lastRevision": {"nodes": [{"id": "200013210409939", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1471907882820219", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "ia
5/499298502_1029200290270550_834390979754715603_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASN6yQEYlNMQ7kNvwE9YdH-&_nc_oc=Adr8JY3zjQ6oEsAGSKbpKLxvjTB82WeZ9k4tgdw1U3quigiZ83TJ7sLYe-fLtqEA4mI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB2GHOQH2LKF3UT-RdUSEReBwscO_6asI7dGHlL4g4uw&oe=6AAEB29F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maze VR", "keywords": [], "long_description": "Step into a dark, twisted labyrinth where every corner hides danger and every shadow could be watching you. You are not alone \u2014 a relentless monster stalks the halls along with its friend, hunting anyone who dares to wander too far. It doesn\u2019t need to chase you constantly; it knows the maze better than you ever will, and it only needs one moment to catch you off guard. focus.\n\n", "short_description": "\u201cWelcome to this game \u2014 a dark, twisting maze where you must hide, run, and survive. relenetless monsters stalk you for fun, if your not a fan of the maze, this game has other maps for you to explore. can you survive the endless nightmares?"}]}, "developer_name": "Myname32", "developer_privacy_policy_url": "https://sites.google.com/view/mmstudios-website/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Myname32", "support_website_url": null, "website_url": "https://sites.google.com/view/mmstudios-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
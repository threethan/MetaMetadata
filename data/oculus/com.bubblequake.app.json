7138036373_8195423382392911684_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIc69YN9zj4Q7kNvwGTJ52X&_nc_oc=AdqWRBARoA2KB0xbarCK2VTiUscLAX5lzzWIxWEjLCPNRihyqbn9ZUFGDMzq5EDXnW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkqgnA3DubGPnE2ssUoaikaF3XmBW6R2WYnGX6JaA6sg&oe=6B0C5740"}, {"file_name": "screenshot_4_2560x1440.png", "id": "2349810189153865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_2349810192487198_7549093664876849445_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFaghoGaSwMQ7kNvwHjO8Fl&_nc_oc=AdpfBFEQC6dOKUUOtBf34H9tJQHO9v2bQvSRtxZoffeKHKNlpaA5rCSJGxjqtn1bA_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSe_S4VrhD23dGlj4uKF8hmGVSuI-kbUmMDgRlZ0UDYXg&oe=6B0C7531"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2121172168766847", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_2121172172100180_4190219964849874674_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGhy9vyh-lQQ7kNvwEJVp-0&_nc_oc=AdrXBW1feII-1eMwU8p2WIkNbbnwT_G3HAQgyXG6jsL5z0bYBgCN9daSoxaw_LzXWdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREehESjFXQbS54Q1olUOZz5FZOuGkOx8h7iAkyQ-nyYw&oe=6B0C5BCF"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1147217217729673", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/757345450_1147217221063006_8385437369859722188_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcfYG2d1QAgQ7kNvwGs5NAv&_nc_oc=Ado1gYUedo_Lez7-HOdegPOo3Fp20TVCxTHgEHgCPcJDCB5bLYHpfqmEDv2w7AZv9WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRc1u6I9LwfwiiAVK2tToLhHvgsVMynTpi5pHjPe59zzQ&oe=6B0C5092"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1794137925167825", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654867655_1794137928501158_7577090301496098425_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H6SG7kowCcQ7kNvwE12iMD&_nc_oc=AdpolzSOAvH72nwqFrPcfE8Dyo_CIYd-hPeqNsB2ege6XyfWIJucgpsye3uGAWI2U5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSY3UpEDNPtbPSnThGd_ZUbkHeki40mUif_YkmTw7WgEQ&oe=6B0C67ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1625456292373017", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/806363909_1625456295706350_3028832981312505522_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otND3ZPQDwQQ7kNvwH5RqIx&_nc_oc=AdoElxiIkAUl9x_WoettmTYnmJUcGn2-UXde4Wch3Ug2x6Kj-tCGuKgz6_JxRXZOgtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVCNg6A_SMCxJECgXtQHzfNUl890aCMK7_YsnRnLRwzQ&oe=6B0C56B0"}, "display_name": "BUBBLE QUAKE", "keywords": ["bubbles", "pop", "puzzle", "family", "arcade"], "long_description": "**Bubblequake** turns your room into a playground of glossy, candy colored bubbles. A toy bubble machine lands on your table and blows bubbles all around you, and your bare hands do the rest. No controllers needed.\n\n**POP, CHOP, PINCH, CLAP, FLICK**\n\nPoke bubbles to pop them. Caged ones need a flat hand chop, and tiny ones dodge, so pinch them. Squish wobbly gummies with a clap, and flick a spark at floaty ones up high. Keep your hands off the spiky ones!\n\n**CHAIN THE COLORS**\n\nPop one color again and again. Three in a row sets off a BLAST, five a MEGA BLAST, and seven a COLOR WIPE that pops every bubble of that color in the room.\n\n**100+ LEVELS, 15 MINIGAMES**\n\nTen themed worlds, then endless Remix laps. Minigames, slingshot levels and One Touch puzzles are mixed in all the way through, and 45 surprise challenges pop up right in the middle of the action.\n\n**TEN BUBBLE BOSSES**\n\nKing Fizz, Big Blobbo and eight more. Beat them for charms that power you up.\n\n**BUBBLE BEAT AND BUBBLE RUN**\n\nPop to the music in 19 songs, or take on Bubble Run: fifteen rounds, three hearts, 22 upgrades and a Daily Run.\n\n**FOR THE WHOLE FAMILY**\n\nEveryone gets their own player and their own difficulty, from Easy for little hands to Hard for grown ups. An announcer cheers you on, and online leaderboards show how you stack up against the world and your friends.\n\nBuilt for mixed reality on Meta Quest 3 and 3S: bubbles bounce off your real walls and furniture.", "short_description": "Pop your room into a bubble storm! Bubblequake is a mixed reality puzzle game for bare hands: poke, chop and pinch candy colored bubbles that bounce around your real room. Pop the same color in a row to set off blasts and room wide color wipes, solve One Touch chain reaction puzzles, and topple grumpy giant bubble bosses across 100+ levels. Every player picks their initials and chases the family high score."}]}, "developer_name": "Potzer LLC", "developer_privacy_policy_url": "https://bubblequake.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Potzer LLC", "support_website_url": null, "website_url": "https://bubblequake.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1514853881700334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831393_1561483539068081_396269729468614186_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_ma
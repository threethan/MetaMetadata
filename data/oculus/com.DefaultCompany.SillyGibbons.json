s, just endless monkey fun."}]}, "developer_name": "RozzaM13", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-sg/home", "developer_terms_of_service_url": null, "publisher_name": "RozzaM13", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-gibbons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23911321695158110"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1731115380947419"}]}, "baseline_offer": {"id": "1731115380947419"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748616240, "status": "PUBLISHED", "id": "1731115380947419"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24212383881718555", "version": "0.146"}, "id": "1043882491209877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23890230570600556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24212383881718555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1043882491209877"}]}, "change_log": null, "created_date": 1752082653, "id": "
-iad3-2.oculuscdn.com/v/t64.5771-25/499295486_9920738848005596_3831840554885036604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_JWpp4Cz3QQ7kNvwFzvhGq&_nc_oc=AdmZiA7MC9jbjiNyDqFiFDaMiV_7IEq5loA1qC3_xT-X3-7l8eQtAY0RccK1Cf-hGBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsQjqDomuXnIOd_wvJgEps8P8ABBKhkvlt-lDVKY-upwg&oe=69A046F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silly Gibbons", "keywords": [], "long_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun.\n\n\ud83c\udf1f Why You\u2019ll Love It:\n\u2705 Smooth, arm-based movement that feels awesome in VR\n\u2705 Hang out or play tag in fun, low-pressure multiplayer lobbies\n\u2705 Explore creative maps full of secrets, slides, and silly surprises\n\u2705 Perfect for laughing, relaxing, and being a goof with friends\n\u2705 Regular updates with new maps, cosmetics, and features\n\nWhether you're a Gorilla Tag fan or new to VR, Silly Gibbons is the perfect place to vibe out and monkey around. Jump in now \u2014 it\u2019s totally bananas! \ud83c\udf4c\n\n\ud83d\udfe2 Free to play. Easy to love. Download Silly Gibbons today and join the silliest gang in VR!\n\n", "short_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun."}]}, "developer_name": "RozzaM13", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-sg/home", "developer_terms_of_service_url": null, "publisher_name": "RozzaM13", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-gibbons/home", "category": null, "comfort_r
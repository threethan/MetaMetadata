nc_ohc=s7JPycevqg8Q7kNvwH6aCeM&_nc_oc=AdrTHQS5mTL3CyWXi0o_39xmKPM20I1EymqtQH-gBctVCQ3csIC_pfgE--laLvvP4fM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1JZffONM2oeXoLQ8w-RRwqePzYyB37wVN12wOR69IQg&oe=6A9026EA"}, {"file_name": "Capture.png", "id": "9920738838005597", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295486_9920738848005596_3831840554885036604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlAtLahEdsoQ7kNvwEN6-Wq&_nc_oc=Ado6FgANgthsgXW2RVmPSrUpln92XUoeaz8llkKat17ASLxQ_5vfWpoK-7ZXgeliD7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWvYs7cM-RnVBY66LIvKXiAnIugclRfhqprtvbw5SkKA&oe=6A9037F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silly Gibbons", "keywords": [], "long_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun.\n\n\ud83c\udf1f Why You\u2019ll Love It:\n\u2705 Smooth, arm-based movement that feels awesome in VR\n\u2705 Hang out or play tag in fun, low-pressure multiplayer lobbies\n\u2705 Explore creative maps full of secrets, slides, and silly surprises\n\u2705 Perfect for laughing, relaxing, and being a goof with friends\n\u2705 Regular updates with new maps, cosmetics, and features\n\nWhether you're a Gorilla Tag fan or new to VR, Silly Gibbons is the perfect place to vibe out and monkey around. Jump in now \u2014 it\u2019s totally bananas! \ud83c\udf4c\n\n\ud83d\udfe2 Free to play. Easy to love. Download Silly Gibbons today and join the silliest gang in VR!\n\n", "short_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun."}]}, "developer_name": "RozzaM13", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-sg/home", "developer_terms_of_service_url": null, "publisher_name": "RozzaM13", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-gibbons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23911321695158110"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1731115380947419"}]}, "baseline_offer": {"id": "1731115380947419"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748616240, "status": "PUBLISHED", "id": "1731115380947419"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24212383881718555", "version": "0.146"}, "id": "1043882491209877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23890230570600556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24212383881718555"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1043882491209877"}]}, "change_log": null, "created_date": 1752082653, "id": "24212383881718555", 
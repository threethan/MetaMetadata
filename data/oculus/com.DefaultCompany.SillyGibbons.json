scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_1582512985777859_2609237502022752711_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0MdprCUa9QQ7kNvwF2avBG&_nc_oc=AdqTMGR0lvHG5zszc9M3Mr5cgT-q8-U5ShCpymH9PprYryuQI3E8uv5S8REdr5Pnp9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPGuwIAPOLSkn5O0JDg-o7LLxjdKCy1k6Xzm9k4CViMA&oe=6B0C7C44"}, {"file_name": "Capture 5.png", "id": "1239657031231065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499326206_1239657034564398_3467012499535680528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vbh_Cn-PuQ8Q7kNvwGJkOn2&_nc_oc=AdpxY7k7-C9trKo20ejPZ47qr3Mrnwfy7XIA9i_oym6AfIf2Lk2PYHoKlv5XP6xpSQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5FRnCSbb55BYL6pXnk1wUGO1UcSZjRLPNHw3CT_NNWA&oe=6B0C846A"}, {"file_name": "Capture.png", "id": "9920738838005597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295486_9920738848005596_3831840554885036604_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1POVGBBh7lUQ7kNvwHcignp&_nc_oc=AdrYFLaKal2127XP9xPxFQFauG0DHJhJgBQLiJfCwnZMN0KsVC7wAq9ReJ6Uwu0o3Oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbsdXYSpPchnll1l1fKW-DEG14HI9hroYbzON0jBWq-A&oe=6B0C5D35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Silly Gibbons", "keywords": [], "long_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun.\n\n\ud83c\udf1f Why You\u2019ll Love It:\n\u2705 Smooth, arm-based movement that feels awesome in VR\n\u2705 Hang out or play tag in fun, low-pressure multiplayer lobbies\n\u2705 Explore creative maps full of secrets, slides, and silly surprises\n\u2705 Perfect for laughing, relaxing, and being a goof with friends\n\u2705 Regular updates with new maps, cosmetics, and features\n\nWhether you're a Gorilla Tag fan or new to VR, Silly Gibbons is the perfect place to vibe out and monkey around. Jump in now \u2014 it\u2019s totally bananas! \ud83c\udf4c\n\n\ud83d\udfe2 Free to play. Easy to love. Download Silly Gibbons today and join the silliest gang in VR!\n\n", "short_description": "Looking for a fun, relaxed VR game to play with friends? Silly Gibbons is the goofy, feel-good Gorilla Tag fan game you've been waiting for! Climb, swing, and explore colorful maps as a wobbly little gibbon \u2014 no timers, no stress, just endless monkey fun."}]}, "developer_name": "RozzaM13", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-sg/home", "developer_terms_of_service_url": null, "publisher_name": "RozzaM13", "support_website_url": null, "website_url": "https://sites.google.com/view/silly-gibbons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23911321695158110"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1731115380947419"}]}, "baseline_offer": {"id": "1731115380947419"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748616240, "status": "PUBLISHED", "id": "1731115380947419"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bin
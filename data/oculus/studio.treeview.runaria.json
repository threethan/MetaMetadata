f20f&oh=00_AQElWhoGAHTx25nEO-0zB2HQLFpLwo1zBJsTOze3RrvK7g&oe=6A8AC5D6"}, {"file_name": "2.png", "id": "842044365228201", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619113_842044368561534_6746876348997966132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b6UjjegUq4Q7kNvwEVUWsK&_nc_oc=AdopDxt6NOpRxj_dBUcuAmpyIpAVakb8uv4xdQXCK5-L0cU3O4T1dk17Z4pjXaRndTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL5Qy2_nB_iwG_Cigxk_jxCezvTW_ZB-OEQgRMaGO_og&oe=6A8AF3CF"}, {"file_name": "2.5.png", "id": "2706002806430761", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620856_2706002809764094_4785885011057060749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SCxmoUO9O0Q7kNvwHqNtx2&_nc_oc=AdqpfuBPkxE6rUo9JQ6JE-gxuMYD20ASJlBMCva4vmlWegq28j58V8EzcD34TqJvPWo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNv3FjXZsHcnc2rZ1QFhkjUS8bZosolezC7IcMX_zTdw&oe=6A8AE1A5"}, {"file_name": "3.png", "id": "1491861425238960", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620817_1491861431905626_8683926603533212059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FrdJ3GPu0YQ7kNvwF5mDhg&_nc_oc=AdpHBoUlZ4x31n7KnzMiTCHV0247S5Vpy_PPh9_df5fsibGa5OT-3zBcR8iC0gnvwFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpMPFG3VvVVfet7rIL4wDcF_DI1P8YZsnMwzSde6j5Wg&oe=6A8AEB06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1392216358956686", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303679_1392216362290019_6610558549685353827_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D_BNfDeRxcQ7kNvwHTlgLs&_nc_oc=AdojMUx85gsR6y_LEpP6-44jBxL1LgCE-vcFt05E_QOQ2peYv20E5tFdNt7ZaLAEa8g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBYy6QN45jWqv4zTKdOyn53vePYw732oC6hWuFjuH4Rg&oe=6A8AC7B7"}, "display_name": "Runaria", "keywords": ["puzzle", "mixed", "augmented", "cubism", "places"], "long_description": "Runaria was created as a submission for the Meta Start Developer Competition. It is a calming mixed reality puzzle game where players build a floating world of mystical islands using natural hand tracking and micro-gesture controls. Solve spatial puzzles by picking up and aligning glowing rune stones that hover around you, each unlocking a new piece of a magical world suspended in mid-air.\n\nDesigned as a native mixed reality experience, Runaria requires no controllers and blends seamlessly into real-world spaces through passthrough. Relaxing soundscapes, stylized visuals and intuitive spatial mechanics create a peaceful gameplay flow where anyone can enjoy slow, satisfying puzzle solving at their own pace. As players progress, completed islands float outward to form an ever-growing constellation of calm, transforming any room into a serene fantasy environment built one island at a time.", "short_description": "Calming mixed reality puzzle adventure. Solve spatial rune-stone puzzles and grow a magical floating world around you."}]}, "developer_name": "Treeview", "developer_privacy_policy_url": "https://treeview.notion.site/Privacy-Policy-b3865aad7525442eae3dcc7146bf8b6f", "developer_terms_of_service_url": null, "publisher_name": "Treeview", "support_website_url": null, "website_url": "https://treeview.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
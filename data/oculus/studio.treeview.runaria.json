UasPPJj1F2j-iFqkcBfjAiaJ5z0CaaU5Ija55MblSWaJRdsFkI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRWbdilR5vMKFjwjHVPkYSZVTNWpjUKvOF6uuzF1ismQ&oe=6AFB47B7"}, "display_name": "Runaria", "keywords": ["puzzle", "mixed", "augmented", "cubism", "places"], "long_description": "Runaria was created as a submission for the Meta Start Developer Competition. It is a calming mixed reality puzzle game where players build a floating world of mystical islands using natural hand tracking and micro-gesture controls. Solve spatial puzzles by picking up and aligning glowing rune stones that hover around you, each unlocking a new piece of a magical world suspended in mid-air.\n\nDesigned as a native mixed reality experience, Runaria requires no controllers and blends seamlessly into real-world spaces through passthrough. Relaxing soundscapes, stylized visuals and intuitive spatial mechanics create a peaceful gameplay flow where anyone can enjoy slow, satisfying puzzle solving at their own pace. As players progress, completed islands float outward to form an ever-growing constellation of calm, transforming any room into a serene fantasy environment built one island at a time.", "short_description": "Calming mixed reality puzzle adventure. Solve spatial rune-stone puzzles and grow a magical floating world around you."}]}, "developer_name": "Treeview", "developer_privacy_policy_url": "https://treeview.notion.site/Privacy-Policy-b3865aad7525442eae3dcc7146bf8b6f", "developer_terms_of_service_url": null, "publisher_name": "Treeview", "support_website_url": null, "website_url": "https://treeview.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
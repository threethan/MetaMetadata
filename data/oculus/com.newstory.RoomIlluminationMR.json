mperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39391049367152526"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620630_1117230290654588_8945768299849422148_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fg0WQpw5UsYQ7kNvwFWrcky&_nc_oc=AdosDIA6kys75nhIo2hVrL3NbLG8sSngAFE8ZEEsQ4ZbK5VGyI9K3aPEE7fRHHyza1Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMELNubvU5tSGRH7lDG2BRhwn96hma7ErLqpLVzXUeKgg&oe=6AC7B9EF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Room Illumination MR", "platform": "ANDROID_6DOF", "context_category": {"context
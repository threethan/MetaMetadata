", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_1605120643983815_2168144531049824123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eneH_zH5OWcQ7kNvwGOwR_p&_nc_oc=Adq8OvI6en38NmuIU9cZ8FswMsQ9s_air1cMJM70rS4EJ95CvmGq8t5QPEIncoNeOGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbQ8IqndCTyGfX7CVFNbz9SQFBvUbVPDvaNbMkLnIZGg&oe=6A772EE1"}, {"file_name": "10.png", "id": "865278572561552", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619680_865278575894885_8853525601159692344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUo3ld7Y7UMQ7kNvwGJ8woW&_nc_oc=AdrFqdkBesEHBPFmNWcJis1OEndR2HfqrQF8Ck1jmQcSV6CWe0LfK-przzi48LpBpxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwQTmapCU1cyvnNsnnJsiyFSeJI6ghcacN4BGLBGYWFw&oe=6A771650"}, {"file_name": "6.png", "id": "708987818604220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_708987821937553_3811348579892270900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnGBX4HonWkQ7kNvwF9dnTV&_nc_oc=Adqr8WgIIMoeM1S14Z55WMHCOoodhWduFCTTDlhQBQtalkqHOkLmpNgmT9gn6hxfXv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGympz3dwKT3VWN8umaroFhxZ13Em3xKv9SM7I8j33W0w&oe=6A771C85"}, {"file_name": "9.png", "id": "874169222165640", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_874169225498973_3872092001231859400_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s2NQo_BWikQ7kNvwE5uv-H&_nc_oc=Adomq8dlt3XxlewU3vDhRkTiCpUSAx-lR6xYrv5CiP2wmC-NeCKHKRajDzeN1Qanr1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGSzWPWm2zaBEEJnKy-bo5vofXi0B3eP6sNoWVRSw7-g&oe=6A7721E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Illumination MR", "keywords": ["Design", "Interior", "MR", "Relaxation", "Simulation"], "long_description": "Design your perfect ambiance.\n\nRoom Illumination MR is a Mixed Reality utility that allows you to experiment with lighting design in your own home without moving a single lamp. Using precise Hand Tracking, place virtual light sources anywhere in your room to see how they affect the mood and shadows.\n\n\nFeatures:\n\nVirtual Fixtures: Place lamps, spotlights, and colored LEDs on your real tables and walls.\nPassthrough Integration: The app scans your environment to ensure light interacts realistically with your furniture geometry.\nGesture Control: Adjust brightness and color temperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33578427841748070"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "886464640506375"}]}, "baseline_offer": {"id": "886464640506375"}, "is_approved": true, "firstO
-3.oculuscdn.com/v/t64.5771-25/499619751_874169225498973_3872092001231859400_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4apdmhAsyKYQ7kNvwEuPdbs&_nc_oc=AdrM3eCdxnRit2Y3MH-9qwvBKDogYIMx01XsUsKs6vgZlLknXX7pnmOy2Bgu7RSG5eU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72SOE5IcWVvFIhVWjaDa9HYxPgzCzM77ETeLRaT24TtA&oe=6A031DE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Illumination MR", "keywords": ["Design", "Interior", "MR", "Relaxation", "Simulation"], "long_description": "Design your perfect ambiance.\n\nRoom Illumination MR is a Mixed Reality utility that allows you to experiment with lighting design in your own home without moving a single lamp. Using precise Hand Tracking, place virtual light sources anywhere in your room to see how they affect the mood and shadows.\n\n\nFeatures:\n\nVirtual Fixtures: Place lamps, spotlights, and colored LEDs on your real tables and walls.\nPassthrough Integration: The app scans your environment to ensure light interacts realistically with your furniture geometry.\nGesture Control: Adjust brightness and color temperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "ex
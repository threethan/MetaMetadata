//scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_865278575894885_8853525601159692344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZzxX4aoFxEQ7kNvwHCUhE6&_nc_oc=AdpdKfz0sthzaaumUfChd_mJXhycJtxT5dGQd5FnuEcLAp6SovvZnxJFQv1324aI5i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2NukWUfDeTQReaNYF3jwtpIk4Ul23WypRzsAK4cD__A&oe=6ABBDC90"}, {"file_name": "6.png", "id": "708987818604220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_708987821937553_3811348579892270900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WMECntUBToQ7kNvwGwZ2H9&_nc_oc=AdrZzZgvqdhTo8m4faooFIVCZhtHpMhHcyvwNRpy-PxCkj9kddzoz-NXBefd2SeXa9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPVZthamSfb1R0ZuvqyJZwXF70rQ14AGfeeVREnohofQ&oe=6ABBE2C5"}, {"file_name": "9.png", "id": "874169222165640", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_874169225498973_3872092001231859400_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDsDJXRk2AcQ7kNvwFPgTPf&_nc_oc=AdpUlwNwALS214o7rhBJhl9Ql8w_9OTrewMM3bCeNO-5R5GUHIYlMTbGuvrqEAksfYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2fsdhX3tNtwH_BKcJbRtu2nkiZJVYuSpHEvcihgxz2Q&oe=6ABBAFE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Illumination MR", "keywords": ["Design", "Interior", "MR", "Relaxation", "Simulation"], "long_description": "Design your perfect ambiance.\n\nRoom Illumination MR is a Mixed Reality utility that allows you to experiment with lighting design in your own home without moving a single lamp. Using precise Hand Tracking, place virtual light sources anywhere in your room to see how they affect the mood and shadows.\n\n\nFeatures:\n\nVirtual Fixtures: Place lamps, spotlights, and colored LEDs on your real tables and walls.\nPassthrough Integration: The app scans your environment to ensure light interacts realistically with your furniture geometry.\nGesture Control: Adjust brightness and color temperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39391049367152526"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624069_1623578766031473_472564724440105476_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEQY5jdTIt0Q7kNvwGyxQBO&_nc_oc=Adr7KzkobBs-b1GhbxyLutcoF8yP-yJ9HERaY1o750V4y64F5Dp29-ucQu4eKcN2nyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ZwL4Q_FvJWZ-9CloM2c5fQsUmRZWq2Q4fa0yXPhVCw&oe=6ABBC5D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Room Illumination MR", "platform": "ANDROID_6DOF", "context_category": {"context_
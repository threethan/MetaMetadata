file_name": "7.png", "id": "1896912610937334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1896912614270667_8654140232961769434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQmV-NxBNfMQ7kNvwHmqgjo&_nc_oc=Adp5dIv7AtmA9d-4UBDCcN62j95MYl2MsKzUeTfQ4pW9FKLRgJ9pG5t2c8ES8vV3OPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1NlDJE1hL7TBwwmRHC-W08YGY4L5yaAJcYqbandCTU0w&oe=69F0B846"}, {"file_name": "8.png", "id": "1605120640650482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618284_1605120643983815_2168144531049824123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJL3sfrTxxoQ7kNvwGxC0tW&_nc_oc=AdoDXKyzNeawMmQYFq_vpJNmpOANwO5Lrig1ExcczSrxvnx2O8YvQuMSu7jZQtPVt_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2LRezjpKys0Yhbti4xTLecK30HK_nzMVPxPkxeyvAaAg&oe=69F0B5E1"}, {"file_name": "10.png", "id": "865278572561552", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_865278575894885_8853525601159692344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS7KmkwS8LQQ7kNvwEpgfSj&_nc_oc=AdoKh7hAVwOQZr7Uk3POe3p4a2PJSS4v-BeuTLM_o-W2_xeOhRY5b5WN9KwVUAzFDkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3spa4dD86sOyhqGtHt-hPgpEo-JdfaSyaNeKIca1aLHA&oe=69F09D50"}, {"file_name": "6.png", "id": "708987818604220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_708987821937553_3811348579892270900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHPiZoFEIQQ7kNvwGHgxCB&_nc_oc=Adpw3FI6icjztu0dqlLMo8G-eCnZtUMyIxe0H-7Kr-NEtnfP7YYpOSvo07RvgK5PZlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pQ5hF3_SVTmoKBIVWWgrGOG-kiS-ZwvB5YH2DCYcTKg&oe=69F0A385"}, {"file_name": "9.png", "id": "874169222165640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_874169225498973_3872092001231859400_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2jAbnfWDV8Q7kNvwGQyYe1&_nc_oc=AdqV9qAaivj9ad6xzlZS8RIO1MZH6amiRZdFTAte1jb1q9MNWt_UUaY6tw47mBBSt-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0o8rO5eVgoboFv6k0Bo8uW4SW6u3jkkf2C1oZJD94yDQ&oe=69F0A8E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Illumination MR", "keywords": ["Design", "Interior", "MR", "Relaxation", "Simulation"], "long_description": "Design your perfect ambiance.\n\nRoom Illumination MR is a Mixed Reality utility that allows you to experiment with lighting design in your own home without moving a single lamp. Using precise Hand Tracking, place virtual light sources anywhere in your room to see how they affect the mood and shadows.\n\n\nFeatures:\n\nVirtual Fixtures: Place lamps, spotlights, and colored LEDs on your real tables and walls.\nPassthrough Integration: The app scans your environment to ensure light interacts realistically with your furniture geometry.\nGesture Control: Adjust brightness and color temperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
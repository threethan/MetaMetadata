oc=Adq5SfgvtverhtwFdjtDbiluX8t71UYd4_UKPxAEeUrkE7memKJI0ArQlPew4V8-7jY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVxU_FVebTu-cBVpmP_8zh67h1Pk2leSAl3-eaN0d28g&oe=6AA15EE1"}, {"file_name": "10.png", "id": "865278572561552", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619680_865278575894885_8853525601159692344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwTcmlgNoPgQ7kNvwFaP5HV&_nc_oc=AdrcZgLTmhUj7W6Ihpk5nK5_S412v0JMhQo_l3zat-fLTMJEW49lV-7vhBdB_qPBXUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVJKwushyrR0j9LWtgHEAUrAA4uIeere-kCMP-h8PAWg&oe=6AA17E90"}, {"file_name": "6.png", "id": "708987818604220", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_708987821937553_3811348579892270900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6AEVdQy_VYQ7kNvwGBiYDA&_nc_oc=Adq16aVA4Ukr9iOeiPIDKgiSw4Gn4degtl41BFGbgfPmxr729qIgn4p7vCMSMqibmGI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAb3BbhJGIuwChvUyyyYPFxHCWz9IEwG-4D0rHmYK1Fg&oe=6AA14C85"}, {"file_name": "9.png", "id": "874169222165640", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619751_874169225498973_3872092001231859400_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHN_dBDLAxcQ7kNvwG7p0s-&_nc_oc=AdrssAioEgvrIkcUXwXb0LmWMk7cgfLmH9HPycUEKA9gfrBPDBphvibTkKhXrLuOMcI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCrlBTEUzk7n3NJ5coPqKn_nmoNiO5JYemYmBJtycy9Q&oe=6AA151E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Room Illumination MR", "keywords": ["Design", "Interior", "MR", "Relaxation", "Simulation"], "long_description": "Design your perfect ambiance.\n\nRoom Illumination MR is a Mixed Reality utility that allows you to experiment with lighting design in your own home without moving a single lamp. Using precise Hand Tracking, place virtual light sources anywhere in your room to see how they affect the mood and shadows.\n\n\nFeatures:\n\nVirtual Fixtures: Place lamps, spotlights, and colored LEDs on your real tables and walls.\nPassthrough Integration: The app scans your environment to ensure light interacts realistically with your furniture geometry.\nGesture Control: Adjust brightness and color temperature with simple hand gestures.\n\nCurrently in Early Access, this tool is perfect for visualizing new room layouts or simply relaxing in a custom-lit version of your home.\n", "short_description": "Visualize lighting setups in your physical space. An MR tool that lets you place virtual lamps and color sources in your room using Hand Tracking. Test shadows and ambiance instantly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33578427841748070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618274_1201996532030160_8710265339248379055_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5YNe1CaFwYQ7kNvwHJDkot&_nc_oc=AdphK44Jdgf7ORWLYyD2R1gI21lnMu9eyCSPvIsGhjGrW7lg8NlOVym_s2Vgc1CAcyU&_nc_zt=3&_nc_ht=scontent-lga3-2.o
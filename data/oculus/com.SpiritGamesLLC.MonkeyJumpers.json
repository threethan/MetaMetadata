w&oe=69E39253"}, {"file_name": "MJ SS 3.png", "id": "386202204220259", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375083_386202210886925_6273706944842981934_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-6jXrm5QkIQ7kNvwGSSCke&_nc_oc=AdrRroopOcrnt4paHKP-zm1w7G2u5FP8knj_zgokeb8ZQyUYFiwxaWWp3B3iEVKhY3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WRNqYJdt7C-LW28rxFW1Auaw_DM6ApjzemWFIcQkBkw&oe=69E3790E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Jumpers!", "keywords": ["fun"], "long_description": "Monkey Jumpers brings excitement to a compact, lobby-style map where quick, action-packed gameplay takes center stage. Enjoy a visually stunning environment filled with vibrant, dynamic elements that enhance your experience. The game focuses on fast-paced action and strategic gameplay within a small, interactive space. Customize your monkey jumper with various fun options, engage in thrilling multiplayer modes, and explore a world of colorful adventures. Get ready for a blast of energy and entertainment in every match!\n\n\n\n", "short_description": "Monkey Jumpers? What is that you might ask! Its a fun game that has tons of features to explore such as Horror, Zero Gravity, etc!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service", "publisher_name": "Spirit Games LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pl
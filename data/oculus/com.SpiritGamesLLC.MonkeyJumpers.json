us fun options, engage in thrilling multiplayer modes, and explore a world of colorful adventures. Get ready for a blast of energy and entertainment in every play through!\n\n\n\n", "short_description": "Monkey Jumpers? What is that you might ask! Its a fun game that has tons of features to explore such as Horror, Zero Gravity, and much more!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service", "publisher_name": "Spirit Games", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8810377275688335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031340_880956147438362_356657795942484378_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7XZXygIs0IQ7kNvwHdR-CP&_nc_oc=AdrKObSOvX4Q7f2a43vjWUPEV6rnICvsl5Uj6YFlNYMH9VHG2Bbjoa0ZBj-T73riOwE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc40j9PE4ZGC2OwxrUyRUxgvrHGJGkKO9yN7dvnnqi0Q&oe=69C7D747"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Jumpers VR", "platform": "ANDROID_
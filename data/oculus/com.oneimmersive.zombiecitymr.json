ll, "video_trailer_thumbnail": {"file_name": "Cover Landscape_MR.png", "id": "1755970878769543", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312422_1755970882102876_4449336742544374328_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcf6OoivM1MQ7kNvwHS9cPa&_nc_oc=Ado0NhfhWZPYGZY0aDJpEjH_KYr5OYwkKXuRlFnA3hUBsO-AGj1dgcd8jVWztSzTQ_A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZFnHdny54wE5PrqZsgzZ6jxtdnQQp_wAUSoFz3brNag&oe=6AFB1BA9"}, "display_name": "Zombie City MR", "keywords": ["action", "battle", "horror", "shooter", "survival"], "long_description": "Zombie City MR  is an action-packed zombie survival experience that puts you directly in the middle of a terrifying undead outbreak. Step into a dangerous world overrun by zombies and use your skills, weapons, and quick reflexes to survive wave after wave of relentless enemies.\n\nAs the infection spreads, increasingly powerful and dangerous zombies will appear. Fight your way through the chaos, defeat challenging enemies, and survive for as long as possible. Every wave becomes more difficult, forcing you to react quickly, manage your resources, and choose your strategy carefully.\n\nThe ultimate challenge awaits at the end: the final boss. This powerful enemy will test everything you have learned throughout the game. Defeat the boss and find your way to safety to achieve victory. But be careful\u2014one wrong move could end your survival.\n\nWith immersive MR gameplay, intense combat, challenging enemies, and endless waves of zombies, Zombie City VR delivers an exciting survival experience where every moment can mean the difference between escaping alive and becoming part of the undead.\n\nFight. Survive. Defeat the boss. Escape\u2014or die trying.", "short_description": "Zombie City MR is an intense mixed-reality zombie survival experience where the undead invade your world. Fight through endless waves of terrifying zombies, defeat powerful enemies, and survive as long as you can. Battle your way to the final boss, defeat it to escape, and claim victory\u2014or become another victim of the apocalypse.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zombiecitymr.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oneimmersive", "support_website_url": null, "website_url": "https://zombiecitymr.noodlzxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358086744053235"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1084792577403110"}]}, "baseline_offer": {"id": "1084792577403110"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789100940, "status": "PUBLISHED", "id": "1084792577403110"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1307430542452189", "version": "1.0.0"}, "id": "1404803608178957", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1305763372618906", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1307430542452189"}, "release_status": "RELEASED"}, "binar
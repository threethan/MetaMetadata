. Compete for the fastest times or explore the environment. Experience the freedom of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tothetopvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Electric Hat Games LLC", "support_website_url": null, "website_url": "http://www.tothetopvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPLORATION", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nn", "de", "fi", "ru", "sv", "ko", "pt", "en", "pt_BR", "it", "fr", "es", "ar", "fr_CA", "zh_HK", "ja", "pl", "es_MX", "zh_CN", "da", "nl", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "679097290194839"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1422183382283180"}, {"status": "PUBLISHED", "id": "946618489475380"}]}, "baseline_offer": {"id": "946618489475380"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747674000, "status": "PUBLISHED", "id": "1422183382283180"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6191586594200153", "version": "0.20"}, "id": "456881865446403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typena
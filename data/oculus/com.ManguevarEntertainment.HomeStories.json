scdn.com/v/t64.5771-25/491821725_1886292258736753_3563832011452970290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uatYXEbCIjEQ7kNvwG3puiJ&_nc_oc=AdrpneafOOgEUNlm5khG2W2alxhfBdKkzOuoOeVvqxO7cSrXg58_8uUURxr90Ofj2Sg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1FF0FPaxDmJf5W_0TqJXCRG38TDUQNbpXujm2B4SIxg&oe=6A2FFB55"}, {"file_name": "screenshot_adam.png", "id": "1836546173706011", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314660_1836546177039344_1598171294967081894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8uywfIQLsQQ7kNvwGSa2FQ&_nc_oc=Adq6fkP079n6G1oxs7gIDBNZO2jysdsVDsGp-J4FLzvbrI_IS4nus6IZ0ft1Xr2jwJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-guTWDZC86G8KLiUGm_fljOd4wn_24cff0bCmwhJQ4Nw&oe=6A2FF90A"}, {"file_name": "screenshot_artifact_hold.png", "id": "1676186617039183", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622325_1676186620372516_5024815253600947523_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1cyFh2uL2oQ7kNvwFalQoF&_nc_oc=AdqkXQ9mcCYHNPPZNu6qTSMt7vTKssdISauoLDS1cQJHahN5jnk-jjZEltiqjC67GCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dnK4xXn0WA0kg30CWc_hh0ctworQhKLLqge4F-uq2FA&oe=6A3005A8"}, {"file_name": "screenshot_spotlight.png", "id": "1228308072570569", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623384_1228308075903902_2022142940549348091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE2L1VaWhF0Q7kNvwHSscff&_nc_oc=AdqTCvHBaUQ4SmakzN5SZBe07oCInH_CpJyplJNmyUCFKWHSEHidoyQ5fYKG9eVx9hY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oy7cjEmxHI-XKsdwk7NgOrweP03iJ6JMoSja315qz9Q&oe=6A301B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-04-06-02h44m11s624.png", "id": "2310411319485824", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818852_2310411322819157_2308593500808932144_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0UGUnruwuAQ7kNvwHFkkxI&_nc_oc=Adrux-NaH7SUWScinuyOroKsd32__L-7fBA--AOZ-2e9oRXa-LGVXno3tYdAhk-Neqo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TMNSx9YrzDBL7_NkT9FZvhDWi18A_9foF5uVr8vcvAw&oe=6A30148A"}, "display_name": "Mandela Invasion VR: Alternates", "keywords": ["horror", "analog", "thriller", "alternates", "puzzle"], "long_description": "You are Joseph, an agent of the US Department of Temporal Phenomena, sent to inhabit and investigate an abandoned house in Mandela County, where an entire family has vanished without a trace.\n\nAcross the county, thousands of disappearances and unexplained murders have been reported. Witnesses claim to see the missing walking among them\u2026 but not quite as they remember. Subtle differences. Wrong expressions. Something is off.\n\nRelive the Department\u2019s classified VHS tapes and uncover the truth behind these anomalies.\n\nObserve carefully.\nTrust nothing.\nSome things are pretending to be like us.\n\nA psychological VR horror experience that drags you deep into the uncanny valley.", "short_description": "Found tapes depict events leading to mysterious disappearances and murders with no clear culprit. With no more evidence than a couple of emergency calls describing unusual behavior in certain people who appear mostly human, you will relive these VHS tapes to uncover the events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://manguevarentertainment.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Manguevar Entertainment", "support_website_url": null, "website_url": "https://manguevarentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "en_US", "en_AU", "en_ZA", "en_CA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27792868180305067"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303971_1578727383330793_8968375295998318730_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgSlIqXebMMQ7kNvwHf0YHj&_nc_oc=AdpF6xtaxOwTL9TXdueBANru74q4RyD243L5zeVMoef2OhiS_DILzhz0yc_iIaL0jwg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pCyjbjfkYGhGuPZ2ZPVpuwoRG64TtJc2Y-m5yqq4sng&oe=6A30129E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mandela Invasion VR: Alternates", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1780000860, "lastRevision": {"nodes": [{"id": "25578304715094769", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25578304681761439", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1419497126850882"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1644413566801122", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mandela Invasion VR: Alternates", "keywords": ["terror", "horror", "analogo", "puzzle", "historia"], "long_description": "Eres Joseph, un agente del Departamento de Fen\u00f3menos Temporales de EE. UU., enviado a habitar e investigar una casa abandonada en el condado de Mandela, donde una familia entera ha desaparecido sin dejar rastro.\n\nEn todo el condado, se han reportado miles de desapariciones y asesinatos inexplicables. Testigos afirman ver a los desaparecidos caminando entre ellos\u2026 pero no exactamente como los recuerdan. Diferencias sutiles. Expresiones incorrectas. Algo no est\u00e1 bien.\n\nRevive las cintas VHS clasificadas del Departamento y descubre la verdad detr\u00e1s de estas anomal\u00edas.\n\nObserva con atenci\u00f3n.\nNo conf\u00edes en nada.\nAlgunas cosas est\u00e1n fingiendo ser como nosotros.\n\nUna experiencia de horror psicol\u00f3gico en VR que te arrastra profundamente a un mood inquietante", "short_description": "Cintas encontradas muestran eventos que llevaron a misteriosas desapariciones y asesinatos sin un culpable claro. Con poca evidencia m\u00e1s que algunas llamadas de emergencia que describen comportamientos inusuales en ciertas personas que parecen mayormente humanas, revivir\u00e1s estas cintas VHS para descubrir lo ocurrido."}, {"images": {"nodes": [{"file_name": "coverart_portrait.png", "id": "2143128913123576", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499313074_2143128916456909_214100105962581453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzA84kEiqiEQ7kNvwF42lvZ&_nc_oc=AdptP3Zs0u4mVDtzVUphEwzHXIyaNGZbgoHTd0n_6GSUEmb3malCFJ99PLRS-dSu6sI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xkt4JvWfvtCABJKcvOfiY0Uo-zXc0d_Y4clXKMRBWCw&oe=6A301A3D"}, {"file_name": "hero_cover.png", "id": "1930401650910486", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311613_1930401654243819_7931681656665480529_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUxnEvGiI4IQ7kNvwH7Wsws&_nc_oc=AdrROwostcoQ2if3Lrb7hMaOaZHiAUVkSBjHNVWHifweo87oR
0yptpDT3e4P5lM8jtbN6RzNeHxU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBnpM235e8K9sYMxBZWAZlgpyh9hrC5lzBqntc61oaJw&oe=6AF1D50B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA9tTzZxE7QQ7kNvwGX_B_O&_nc_oc=AdrWdju0GbbCdpJX_ENgeULP1uSyOr3XcV8U2fiAHLNGS0LlyB-C-4O0lE3ZrQ1hNHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt6WaZNJ_fWmUPDyapY_rpsUlUcBREtVYn8YxVGcfPNw&oe=6AF1D162"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmMwbjZHUOIQ7kNvwEP_1lZ&_nc_oc=AdoXsDs4wEqrRl3Z62rmbOeJW6S2u4ZAWryDm5UZd7_OJA6fHVRrF-oiKeP_ZpgdI90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6MEgOd17XDLBFV0dyOzgpuXw6d0lbjYcqk2GwmCisEw&oe=6AF1EE86"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds14IH_TIFwQ7kNvwFc4Z0V&_nc_oc=AdqA12Il9Zx8o8_hDbvARuOo2Vq0R4iE2qYElzB4Agv-JQwoUsKQgX7mNsScO-DjECc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRetSUo6Nwya_jDEEcbaJJSI2iw30DubroPm-XU-ntIiA&oe=6AF1E7BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skqDgBGhSAQQ7kNvwGtxn7W&_nc_oc=AdodfLqIf1-n9qchJMjzJCvSrZSAuNQpI8repI0YDtw6RU_zovvItSOUYJTbtnT0row&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzuh7ClikbrFsVbcSWCvOok0KG6YZDMDo9X91RnSkTog&oe=6AF1F8C8"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
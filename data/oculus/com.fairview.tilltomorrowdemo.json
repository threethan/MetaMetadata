x4jtFbB9UQnNC-16Cgigiw&oe=69A1A68B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ONvmbOBQCIQ7kNvwGyka1A&_nc_oc=AdmW5W5yfu6gL5PY9SPBWns8ONrWMCwBoLOi26S6soSXaCv3SkljQe1P_iKewlEFR30&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afty-hBpj9lm0STiwjpQeK7qieUWH7UbaA_Q0QMMvBgsrw&oe=69A1A2E2"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ4rE_yaXfcQ7kNvwH1iDEl&_nc_oc=AdnclzGomJaQ3Tm74BOqTA5BnLJaYmb-vY7urT7TnkldaCeFktHAStmYMhJ8-zvAm6Y&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv3MeW4v50LGn6B_HO5APx3h7sF7lEn8-hKuGCUKUArbA&oe=69A187C6"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP-kjsDpEWIQ7kNvwF9Dh_h&_nc_oc=Adm3JWAM97ff7JFmV7GGbREOVgHczcJiS55jeTUxA8u4uTvn8XorO-qDTAu_zz0MXd0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsvRspJrONzR3rtWUbFjr1cbycWIUBAtWC-SOWDW9Zs_Q&oe=69A180FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8WDhaHzj2UQ7kNvwFOCkw2&_nc_oc=Adll49M58kZFTmTzCidAGUzVO5JenJzyzZc0fyHK3YRJIOeLtVqu3HBcL-WLwP3SXX8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsjGtb9-RdRY8XgShCqUEBCWpdzHHw7301i6-Z74V3_UQ&oe=69A19208"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices"
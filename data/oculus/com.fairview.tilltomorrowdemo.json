Gs_wECaNwIn3p621TIJ4rQ&oe=69986C0B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ1o1xWIk8UQ7kNvwETXNX4&_nc_oc=Adn5Yn91-6XNvgy_wGUco7vma9uSzqEuHxDDPFRC1RIY2iaGkoHiEMkVSeGg7aisOKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftq-dc9zrkRul9Ej3At9OwAyPR6S8V0z_tCltdpHN0hrg&oe=69986862"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtS5PEXS_KMQ7kNvwE4R5bG&_nc_oc=AdlFkNcttHdHkb-IhywhS42urSYGVow9dYo8uuRGVrufUzOWKJk8K2OuJEEIJ0MUw6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afux6tnSKs45NEogjGP10CBWY6Ebj7ETy5Z8Qrerfbkpkw&oe=69984D46"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtpDlGy6FygQ7kNvwE-25ZV&_nc_oc=AdnZJ_6mw_bZIoAQKVxcQEzRo57B2zfACsiUaUJKduYsNrysVphvIUgXdtGjT4HkUsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu7E8-s8Xb7nosD4biWBbMY3ig8JBn2EN0V6iuseHeAeQ&oe=6998467F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iGNQTD3SJQQ7kNvwEbUqDD&_nc_oc=AdnJ9ZSVchq3Y44OA_MIjog1MLtOL0jpcqoYX1fHhVa26EHFtiRO35pCx68Po0PFHQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsDZ6UdssxgnJEzCvLuRMLNL9KU3Mn5Jp216psmEumyGQ&oe=69985788"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices"
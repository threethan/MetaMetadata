3wupuyv81hv6NzqZ6zPYlfblW7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XMIBUGV0-DdgUsvx7sIY8lY7T6X_7xvnzpykHDrOO_g&oe=6A087B8B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW_5fau9vhYQ7kNvwEP20xD&_nc_oc=AdroiBSbucWgJz-TxGSkYLhVxImQ7QbBUguhQZ9xKu0-ZCxw33I3kqU2tkKfRK-Dg5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CbsyUH9bk-5-anUwXGRrsFptTSmMB8llo6uE-DWi_YA&oe=6A0877E2"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGUyWKEgjGUQ7kNvwFM4NDM&_nc_oc=AdqFKGbqhO82iVU-uIEzGs89OFMV1IqrLgvOyIHpYrFSS6FwEnw8Va8rX6ZpRGBjdDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jpl6KORYjmMyI7mcInddkP1iUTg9kOZJO6UdMQWArOw&oe=6A089506"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNb1bkTg69UQ7kNvwEAGpMf&_nc_oc=AdpEJ96JRsAqTZb1GiuTlLwUkPbX6YPNQdFAXHZyQkqCTvHzxjDRfu_K-DnbVPyEqCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gYFtsUaDtk4RtOyiJ21POzu2G_xMPplUo-IFXDfM53A&oe=6A088E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juPQv3sCj2EQ7kNvwHl4hMQ&_nc_oc=AdqcZfB-1rzqsUj9M1gsJuQ0h1-1STyFezt0aKvSV76c9x2OjkEVEGF-mDeEwSE6u2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68lSabguagUoafrwcLmnefBVY_t_tLO1T8EwWGBH_8FQ&oe=6A086708"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
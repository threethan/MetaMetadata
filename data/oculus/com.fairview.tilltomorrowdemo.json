KTa4T0FuzjY7h9ch2V3zQzgRTPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNat69Y7KfGpN6ZGZTNrK42kVmmN-wcmyJZRan6OJLuPA&oe=6ACF8E0B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XcU6c9bQEYQ7kNvwE2NK-x&_nc_oc=AdpsqSYOyriAs-lxbyYVgnMREUelqOU7dkZ6qF9UceqUssMG_1Iaeg4goX_OjkbegKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSSzZSuzb8hbqC-Kvjj--RCZ7m3QFqHkjz7wWX6Eobgg&oe=6ACF8A62"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhISVdXg9YEQ7kNvwEhYFSu&_nc_oc=Ado_nHr-VwYEuIVLmfcIFK04AWlnVHjJ7BHNBKhe5eAJ_CLHnp1jwOw_u5kML9rHoD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt5VpO2Zfjz2fCrMqMYVc3VO2z30eDIevm6RD5P6j34g&oe=6ACFA786"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yddbz1A_kZAQ7kNvwE_ol7E&_nc_oc=Adohtukwi2SL50Nly2tPVBQbNOh5vbDJlvRPf4bK3PG38YcWghANgKCiPYxZ3NA911Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbKrR-8yAkzj65J5R-v0Lo-oZexbMU7VqnmcVDXQjxrw&oe=6ACFA0BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldy8I2s2ECgQ7kNvwGEqdRY&_nc_oc=AdrpVZLOyRMoElaVZnX87RXs9rtd_PScn6nlULMaVT378W493G_hF4Usw71tTzLI59M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz3gOAOTIm6YQH4kwp0PianJiRdHkKQu26n4zk-DPT8A&oe=6ACFB1C8"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
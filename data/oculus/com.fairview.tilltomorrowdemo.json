oLt3bktW8qZhSxXuCEuqH_p0pvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rs8IWY0El2HCh1a-O13R3DRFPeyyCRoPS7RZxPbmvDg&oe=69DE4B8B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aqd3nsRghhEQ7kNvwHjd6bw&_nc_oc=AdqnseCVWsfryJoqjFK1MOPmWUQN5na4brN4NHPZeRi6p_PFKavkSdqBT7RwSfUoKbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GN--p2HWjp1QBDZnLfuV_LQn3Crag0kosO3VByn8WdQ&oe=69DE47E2"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8thNLc-tyUQ7kNvwEj-HME&_nc_oc=AdqNecKrGvFq7w8g2CswN7MrmHDwgH1Hm1-IPLB3kPjl_aGyOPoiFn5OEOHBLPQ1DL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z5tT7HxpPhWZfGrjyXiquU0yGqHfd-pJTJGHE93cYIQ&oe=69DE2CC6"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGe4cxUecEgQ7kNvwEMcrMt&_nc_oc=AdpyCfnspoxn7vje5Aft0yZdqNG05rGBKDMwI_CqDQO08XUtwlYE4Hh3qwuKPyc8yXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vr-Q3udR5k6gRewEUhQMDuCeOFoGnlfn0J43INdA2-w&oe=69DE25FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02hpmRfZ3vQQ7kNvwHuzXgr&_nc_oc=AdqST7AnB1Yc-40vpduTwVpaybJnuDSqpUJARNzBwFSxSR2sT0dYLO_afGF-G-iS_Vs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30_aABOgZv705ZvGS_iAG6waK2EP6kAMcuLt11BWgSpw&oe=69DE3708"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
UZ8i7kfU0ejcFgZf0bu4k0WHVRk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F2PviB62pLXtilrnS_3i0mrnjZu54J2Q_Y9jTZiVmBQ&oe=6A33FD0B"}, {"file_name": "3.png", "id": "341784861538881", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982623_341784864872214_1996714101842698969_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56gtKxQBUBEQ7kNvwHzwVIS&_nc_oc=Adp4-IBl0E_lY-MGHKnBzy3VxglD-nQbmhxO3XH8vAzBfgrMnQ5qdt3zS24cX8rMnBE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af950j5mPsNw9csIWXlZ3c6pbledu0JVJ8ZWHjaNJ-32xA&oe=6A33F962"}, {"file_name": "4.png", "id": "1443479432875271", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203622_1443479436208604_1742939252581312512_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Egb7HvyHBA0Q7kNvwElVVDa&_nc_oc=Adq0OrKpbyWzhbF5ZuemrVZOQeCcZnZ-bmkXH9DYmrm5WWSsEj8O12JgMIU1ya6vpyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-rC_2K0pkjSxVM9NdleMtZeVHiFzSm-KTmw7azHvPlg&oe=6A341686"}, {"file_name": "5.png", "id": "1039291067062704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974703_1039291073729370_4733580831308276218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnFG8gwCoMwQ7kNvwH7dayO&_nc_oc=AdoidRmqdElimrodEBOJTW3WY3AKQI0sXZT345vBvy9EcbsUaRZdeGotr1gtAVy0hUk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DSgFDcoavY8ve2gcRLEy03rWtD9KA_pOLHVQuZ_BaTA&oe=6A340FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_landscape.png", "id": "1089215391856861", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982514_1089215395190194_5023217157685857883_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMMJPlfyrQIQ7kNvwHU3feo&_nc_oc=Ado8oXolauvbkctahda90gYBnu9nElm4EKg7ugLyxBvuayp68i4OaXjQMWffW4oGayw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RCU_FJfXl8hgaRUpUEWbmYP6USd0GtEpAObtfPhTSYw&oe=6A3420C8"}, "display_name": "Till Tomorrow Demo", "keywords": [], "long_description": "As an adventurer, you\u2019ve been thrown into a remote island by a fierce storm. You must survive on and escape from it eventually.\n\nBuild your skill set for living in the wild along the journey, no matter it is forking fishes, hunting with bows, farming, or making houses! Those will definitely help to realize your goal and build up the gears needed for your next challenge.   Have great adventures to explore the 'dark forest' where you may need to fight against mystery malicious creatures and collect treasures as a reward.   No one knows what risks you'll have to resolve till tomorrow\u2026\n\nJoin discord: https://discord.gg/qMkyDn4NEM\n\nWe are a tiny indie VR game studio and it will be awesome to hear what you think about the game, good or bad. Looking forward to hearing from you all!\n\nTry out the Early-Access release version here:\nhttps://www.oculus.com/experiences/quest/4825294284255836/\n\n*Multiplay mode* is available for the early-access version NOW! Build and explore the islands with friends together!", "short_description": "When rescue does not seem possible, can you survive along with the island? Hunting, farming, building, crafting to thrive on the island.\n\nMultiplay mode is available for the early-access version NOW! Build and explore the islands with friends together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fvworks.github.io/TillTomorrow/privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://fvworks.github.io/TillTomorrow/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
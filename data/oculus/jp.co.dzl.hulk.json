dn.com/v/t64.5771-25/12680493_1340055386054482_1440654519250714624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phei4Zrvj7IQ7kNvwEhHBhf&_nc_oc=AdnpHFzGS4q_5VKWt0bhKeDZfzhesWGWoPPpDzuOl1uj1YGSaGpeX38RAe4INCCZ0M4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPOjiBFEv828HFS9hTn19_IGvqlo3Y_4njVm5TgX-QKw&oe=69B2D011"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ninja and Princess", "keywords": ["ninja", "fps", "japan", "zombie", "towerdefense"], "long_description": "Full-scale Ninja Shooting game released with VR!\nYou as a Ninja must protect princess from enemies!\nPeople were morphed into non-human like creatures by mysterious virus.\nAll humans can do was to run away. Except him\u2026\nYou are Master Ninja Hanzo. Your mission is to protect princess from neverending looming zombies.\n** How to play\n* There are four weapons available. Use them wisely like real Ninja!\n* Virus infected creatures will attack you by various patters. Aim at heads that are their weak part!\n* Once you accomplish the cause, you will receive a secret scroll from the princess. It will awaken super Nijnja power in you!", "short_description": "Full-scale Ninja Shooting game released with VR!\nYou as a Ninja must protect princess from enemies!"}, {"images": {"nodes": []}, "id": "207573963641419", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ninja and Princess", "keywords": ["FPS", "\u30db\u30e9\u30fc", "\u30be\u30f3\u30d3", "\u5fcd\u8005", "\u53ef\u611b\u3044"], "long_description": "\u672c\u683c\u5fcd\u8005\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u304cVR\u3067\u767b\u5834\uff01\n\u5fcd\u8005\u306b\u306a\u3063\u3066\u8feb\u308a\u304f\u308b\u6575\u304b\u3089\u59eb\u3092\u5b88\u308d\u3046\uff01\n\n\u8b0e\u306e\u30a6\u30a4\u30eb\u30b9\u306b\u3088\u3063\u3066\u4eba\u3005\u306f\u4eba\u306a\u3089\u3056\u308b\u8005\u3078\u3068\u5909\u308f\u3063\u3066\u3057\u307e\u3063
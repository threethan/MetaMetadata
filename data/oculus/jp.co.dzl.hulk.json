8\u306a\u308a\u3001\u6b21\u3005\u3068\u8feb\u308a\u304f\u308b\u30be\u30f3\u30d3\u304b\u3089\u59eb\u3092\u5b88\u308a\u304d\u308c\uff01\uff01\n\n\n\u25a0\u904a\u3073\u65b9\n* \u4f7f\u7528\u3067\u304d\u308b\u6b66\u5668\u306f4\u7a2e\u985e\uff01\u4f7f\u3044\u3053\u306a\u3057\u5fcd\u9053\u3092\u6975\u3081\u3088\u3046\uff01\n* \u30a6\u30a4\u30eb\u30b9\u306b\u611f\u67d3\u3057\u305f\u3084\u3064\u3089\u306f\u69d8\u3005\u306a\u30d1\u30bf\u30fc\u30f3\u3067\u8972\u3063\u3066\u304f\u308b\uff01\u5f31\u70b9\u306e\u982d\u3092\u72d9\u3063\u3066\u5012\u305d\u3046\uff01\n* \u5927\u7fa9\u3092\u679c\u305f\u3059\u3068\u59eb\u304b\u3089\u79d8\u4f1d\u306e\u5dfb\u7269\u3092\u8cdc\u308a\u8d85\u5fcd\u8853\u3092\u767a\u52d5\uff01", "short_description": "\u672c\u683c\u5fcd\u8005\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u304cVR\u3067\u767b\u5834\uff01\n\u5fcd\u8005\u306b\u306a\u3063\u3066\u8feb\u308a\u304f\u308b\u6575\u304b\u3089\u59eb\u3092\u5b88\u308d\u3046\uff01"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dzl.co.jp/privacy", "developer_terms_of_service_url": "https://dzl.co.jp/", "publisher_name": "Dazzle Inc.", "support_website_url": null, "website_url": "https://dzl.co.jp/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "FIGHTING", "CASUAL", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "264684405746585"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary
-pfttPrp8EnUT3bK7dPyphtCH65SyMjUDTgfg_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtSBmNAUZJq7HyDtuEhZFXfjbjgrgt5eiGqZE_nm5mMQ&oe=6AFDE1F7"}, {"file_name": "red1.png", "id": "622050200283720", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391934_622050203617053_3031395591573663433_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsP1HLpV0CgQ7kNvwGAkAwF&_nc_oc=AdrfoPafpj5WJsjBTBRljkdfBG433UJZWQyZX4aqubFowgTPn5uSJbCzBpCmd-6qUW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ78QBPG6Dxieka3e8DfbZEJuqDB2fu9RvLFzMqix5M2g&oe=6AFDC565"}, {"file_name": "purple1.png", "id": "1133456441653587", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_1133456444986920_4552907036141576076_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aepbFELt0EsQ7kNvwFz70Wv&_nc_oc=AdrE9X9nOXsCjwiMbCYPygG4InX86Fx28NevFkdROedmpP4If0gIKg_JQzMT4eMKDkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYP19D1d4oiuSkhWWg6VSJvNWrPp8GODn5dODP1fCDxA&oe=6AFDB782"}, {"file_name": "home1.png", "id": "948371210561414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391998_948371213894747_3808256704087504823_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OZ_wz195YEQ7kNvwFoX3U5&_nc_oc=Adoiv8fOpaAXK6F1zzLr6OjYIUbiygbycXLG_K09m-jzUNp5dc0mw81CXuGBGREgBas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM--BIGPi9woi5BFYoIIxAQKAUyCVOPrBVz11_aRzClQ&oe=6AFDC200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "for-meta-2560x1440.png", "id": "1503719603635841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1503719606969174_1942472366399319441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DLPaB-28LEQ7kNvwHCsJdA&_nc_oc=AdqiFSC9Gr_bffpNl7VYukeMVI5lU_Yu4bWgqjSlaXd_QzQgJem2kwqtXruIw70s_c8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk1Ugwe8gfNDK-NxrvWAT5jrYkKAS5jyNxT_bSlaPYFw&oe=6AFDCB8D"}, "display_name": "Falling Space Rocks", "keywords": ["nonviolent", "familyfriendly", "disabilityfriendly", "space", "shooting"], "long_description": "Your planet is heading straight into a meteor shower and rocks are falling all around you! Launch fireballs from cannon gun to blast and pulverize the rocks with a satisfying reverberating boom. \n\nProgress through multiple levels defending the planets. Immerse in beautiful expansive skyscapes and space music.  Rank up from Rookie through Commander. Earn badges for abilities such as Vigilance during rock barrages and Defiance under high gravity. Adjust difficulty settings to your liking, including rock size, gravity strength, drop frequency, and drop zone.  Automatically save game progress and settings to local device.\n\nCan be played sitting, standing, or lying down. Can be played one-handed, using either hand.  Non-violent; family-friendly; disability-friendly; exciting although relaxing.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!", "short_description": "Your planet is heading straight into a meteor shower and rocks are falling all around you! Launch fireballs from cannon gun to blast and pulverize the rocks with a satisfying reverberating boom, while immersed in beautiful expansive skyscapes. Can you earn the Spyglass badge? The Radar badge? Can you attain Commander rank?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16l1ysWkozI8ZtTBso4A9RZvwNCF-_XaI_3IHgSHq0_4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1U2Pfkya8dKmHoa1Z6tCK24hdeZsDBK1V6kr-nh277DI/edit?usp=sharing", "website_url": "https://docs.google.com/document/d/1U2Pfkya8dKmHoa1Z6tCK24hdeZsDBK1V6kr-nh277DI/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
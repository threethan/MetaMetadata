https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622007_1880618032313393_6010599161947695798_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSZDYLazuc8Q7kNvwGR9DMC&_nc_oc=AdkZsPrn-KYwsXV1pi47hQG330ng58XDc5O2preAb_-EgYuq7xPauyelqhZsZdJq5jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2tVtFkMUOJSQ7io8n-KzgEPcR_2Sy3WWvUjX5Xal76g&oe=69B409BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mazerthumbnail.png", "id": "964842981178383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_964842987845049_4248177471819190144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzixDK0CZ7YQ7kNvwEwAFYt&_nc_oc=AdkPvcvfZmWpA8pexp1f9SfjP8yiE_KS1khadoE4Y5nTr9WSdBRJuNUpcEXIfyEphvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5sBMpX9gyEArICtxDWYyH67XAjgjw27IngNhROGBZww&oe=69B3FC4C"}, "display_name": "Mazer", "keywords": [], "long_description": "Within Mazer\u2019s groundbreaking virtual world, you can own a private penthouse in one of an ever-evolving network of Cyber Cities or set up an online headquarters for your business. Mazer\u2019s fully customizable, private virtual spaces give you complete control and almost unlimited opportunities for personalization, making them the perfect place for both personal and business use. Set up your space to suit your specific needs and invite whoever you want to enjoy it with you. \nBuild bespoke XR solutions for your business or use your space to host engaging and professional business meetings, show off new products using Mazer\u2019s state-of-the-art digital twin technology, or simply enjoy the exhilarating entertainment facilities in your virtual penthouse with friends and family. \nEnter Mazer World today to discover a new future!\n", "short_description": "Mazer is a cutting-edge virtual platform with awe-inspiring visuals where you can experience the true future of virtual reality existence. Become a pioneer as you live, work, and play in this futuristic world of limitless possibilities. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mazerspace.com/mazer-spaces-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mazer Inc.", "support_website_url": null, "website_url": "https://mazerspace.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "4946484465388644"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "9084671474943840"}, {"status": "PUBLISHED", "id": "702460341678778"}]}, "baseline_offer": {"id": "9084671474943840"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737890280, "status": "PUBLISHED", "id": "9084671474943840"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26278442908512140", "version": "4.3.15"}, "id": "685685712458951", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4897117547071319", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26278442908512140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "685685712458951"}]}, "change_log": null, "created_date": 17
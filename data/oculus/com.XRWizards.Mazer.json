cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtSnBoMqF7gQ7kNvwHHlFtR&_nc_oc=AdnrTvmYukAqqHAFT2MF63FQVRMbgN-KXfFdeeKdC4_UcinIDswnFCi9QBi4AtZyha8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftHyA2nBtn81xrBgQ4JXg46SNNbeBEXBLwqskUiJ7HBFQ&oe=69A5893F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mazerthumbnail.png", "id": "964842981178383", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974593_964842987845049_4248177471819190144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRrCgFwDX84Q7kNvwGuWTY1&_nc_oc=AdlZz1ilzhU0GSzJ92ruy33-BKYU-OBRwc9z8HiEu5uoJ5HQONYUhFKEj1qMuj0y1a4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsLHav3vmeYJdDrHCtWSutY5r9r1O9EA1lPVd4qEKMjSA&oe=69A57BCC"}, "display_name": "Mazer", "keywords": [], "long_description": "Within Mazer\u2019s groundbreaking virtual world, you can own a private penthouse in one of an ever-evolving network of Cyber Cities or set up an online headquarters for your business. Mazer\u2019s fully customizable, private virtual spaces give you complete control and almost unlimited opportunities for personalization, making them the perfect place for both personal and business use. Set up your space to suit your specific needs and invite whoever you want to enjoy it with you. \nBuild bespoke XR solutions for your business or use your space to host engaging and professional business meetings, show off new products using Mazer\u2019s state-of-the-art digital twin technology, or simply enjoy the exhilarating entertainment facilities in your virtual penthouse with friends and family. \nEnter Mazer World today to discover a new future!\n", "short_description": "Mazer is a cutting-edge virtual platform with awe-inspiring visuals where you can experience the true future of virtual reality existence. Become a pioneer as you live, work, and play in this futuristic world of limitless possibilities. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mazerspace.com/mazer-space
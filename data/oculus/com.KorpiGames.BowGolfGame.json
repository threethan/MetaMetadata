5554145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1033485702220811_6917860014135126447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wk7bzX8FnDgQ7kNvwGYG7mW&_nc_oc=AdqmtC6UrEz4npv0h2H2MEDIEOuPZuxjNYhulEorhZt8aHVmQemUd41YXJURd1vJ4Uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH82Qedy6-SL9TQrsaJux_1ISfT1F1KBF0LUGmva3B9zQ&oe=6A79DF8B"}, {"file_name": "New_BowCourse_QuestStore_08.png", "id": "1697048881018586", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499319013_1697048884351919_5531112753064302333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZE-iT6MdiwQ7kNvwGO3KSC&_nc_oc=AdpBkv2dE8gMF9hoBGcZFojrAbbm9t5vzq03fgwaiCBpHFDDHXLvi8XQYy1uFH_N6U4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRXWMaj3WYNKsSVKLN_ANtg55RNjaD8HwxK-2627vKwA&oe=6A79C5AB"}, {"file_name": "New_BowCourse_QuestStore_02.png", "id": "1738622320871891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_1738622324205224_1562867178012633561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3kT-qid91YQ7kNvwH4Rj-_&_nc_oc=Adr11BdDa5bfQRTN5ZFUGQl1ra7caCKrZGS8KDL5hcJaPjW3OEYpYEOcYg4KViYQBXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmSr1PtSeYC_4CtBNeW5Mmx7boWbNL3XdSA-JewdGzkw&oe=6A79E02F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TEvsES-abcQ7kNvwFb-ZTh&_nc_oc=AdrUIZlQAUmBFB3TPRjtVD2FoWfMH7VXIv6NVm8LKrHQDdkDKby06O49K1RDgMausNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG096tXbrzJlsYogCHksvtdoDsWJELd1RsKPT_S44ADfQ&oe=6A79DE52"}, "display_name": "Bow Course - Archery Golf", "keywords": ["sports", "casual", "archery", "multiplayer", "golf"], "long_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n{1449951679695905}\n\n**Bow Course's Early Access has two maps, difficulty options and all main game mechanics & features. We aim to add an additional map, character customization and more features during EA. We look forward to hearing your feedback!**\n\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Hone your skills with practice mode\n* Play comfortably with teleport, smooth locomotion and other settings\n{716753251094485}\n\n**Customize your outfit**\n* Choose from variety of clothing\n* Change your eyes and mouth\n* Unlock outfits by playing\n{1388403669037468}\n", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
wSKSe1vp0xFNbtAVPIEdkdypFCJFLP1BoWHi7RyYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTspYHlqH_QrCIDwo2YqhMbzE0wbXZHXIXa-Q8SUxmjNg&oe=6B01BD27"}, {"file_name": "New_BowCourse_QuestStore_01.png", "id": "1033485695554145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1033485702220811_6917860014135126447_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_44ldRL1NsoQ7kNvwHbfqDq&_nc_oc=AdoLLiLx6IecZj8rdxdaD5sJLGvXC4i6klydBhN9oasVjKqXYmTRnkFM_umwvpZ2pOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfJZAKtyB3LtCWiHl7qgofUSgXjIniXQXJC96dPQRmuQ&oe=6B01E24B"}, {"file_name": "New_BowCourse_QuestStore_08.png", "id": "1697048881018586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499319013_1697048884351919_5531112753064302333_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgVY9xLz7TAQ7kNvwGFDfIR&_nc_oc=Adqz80dgVUxqCoGnpcKC-lwboKXVnuzUQf8L14vkajnEW-aeoBMolW1ED4sFvTe_EHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdOSniNbzseCcZ9XZaLFCOkXyfOlkaC0uQ9KtPOSE12Q&oe=6B01C86B"}, {"file_name": "New_BowCourse_QuestStore_02.png", "id": "1738622320871891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_1738622324205224_1562867178012633561_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bxVlUATOasQ7kNvwHnAz9n&_nc_oc=AdqsF9bbZXC4npldsvwXMA-hPXw7x8r4W2XI7LShjWbYSkTP6yMbuhtJcKO4-7Wdl0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLitQAOltA4Uvmc5O_Rl08TAIFxK7SA5iLxDSgE7O6zw&oe=6B01E2EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKb7RG-fmnkQ7kNvwFg0bj7&_nc_oc=Adr539_eD1EwZHxjkh5MWSvIjF20U0_p44oU0lifCRLArfUtNBDNajCTqPuRdlC416o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZPftRJhep4-cC__ZUcS9K4aLscpF_Q2ma0LaGc06zeQ&oe=6B01E112"}, "display_name": "Bow Course - Archery Golf", "keywords": ["sports", "casual", "archery", "multiplayer", "golf"], "long_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n{1449951679695905}\n\n**Bow Course's Early Access has two maps, difficulty options and all main game mechanics & features. We aim to add an additional map, character customization and more features during EA. We look forward to hearing your feedback!**\n\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Hone your skills with practice mode\n* Play comfortably with teleport, smooth locomotion and other settings\n{716753251094485}\n\n**Customize your outfit**\n* Choose from variety of clothing\n* Change your eyes and mouth\n* Unlock outfits by playing\n{1388403669037468}\n", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24026348343720413"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_1171353293853562_4526971800517422570_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCNSdHU6LyEQ7kNvwHQZhbA&_nc_oc=AdoQra35XXTznbyLsOJ7JjRiYFaI8G3a5voS4boOnXJbzc0ocvSQgVwt1gRuCHJmEcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU-_Aqf8bXbkoFtYsvAMzJuvZ4-FkQjPDwFWD4P-U1Dw&oe=6B01BF4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bow Course - Archery Golf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1748437560, "lastRevision": {"nodes": [{"id": "8643367019111795", "release_type": "SCHEDULED", "adm
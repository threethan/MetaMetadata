5554145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1033485702220811_6917860014135126447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SepEJPPN2DgQ7kNvwFFV7xY&_nc_oc=AdprnGhcNXqKIqAdQ-PJukhmjVWMabF29IXYizNtlbf9jvy36-274eM36QC9EuLwqsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wg03gV9VqMCD7gYnaVvzoXY-a2u0uhjIu6EGT9wDTjQ&oe=69D9088B"}, {"file_name": "New_BowCourse_QuestStore_08.png", "id": "1697048881018586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499319013_1697048884351919_5531112753064302333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xcwqWnqs3UQ7kNvwEfHxHb&_nc_oc=AdqY84tyV2pTi6eTQGaWqTQPk3q9XFoN3hS5IhbRBQXqyKTSSkuhhWXfg6MkfT-ggkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af245CuvASJvipcLmG9fBxrfFvj8SmSzMITFaW2KrUUy6A&oe=69D8EEAB"}, {"file_name": "New_BowCourse_QuestStore_02.png", "id": "1738622320871891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_1738622324205224_1562867178012633561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCzQWjBVw7sQ7kNvwFW5w1n&_nc_oc=AdrmsS7J41npMKd3raAoyi-qtxfh-55g2I5xwGY5e7eVi1C8iClUsCmVDSFMVFwLAN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1irBpEaBgwNGv5erxv7XS1_8zuZBHjGrHZ4EyJ14wQLg&oe=69D9092F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQd6OoaROpUQ7kNvwFAylUH&_nc_oc=Adp9l9CaLg9henTXFHMlgzvB3qDFKN9STB806l1pKjvTVlY-KO0KdUlTJG2wPQVhvJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wm9rnq3GZUmbSVGgjtmav76RbzwwNhb5GLk8nG7OzDQ&oe=69D90752"}, "display_name": "Bow Course - Archery Golf", "keywords": ["sports", "casual", "archery", "multiplayer", "golf"], "long_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n{1449951679695905}\n\n**Bow Course's Early Access has two maps, difficulty options and all main game mechanics & features. We aim to add an additional map, character customization and more features during EA. We look forward to hearing your feedback!**\n\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Hone your skills with practice mode\n* Play comfortably with teleport, smooth locomotion and other settings\n{716753251094485}\n\n**Customize your outfit**\n* Choose from variety of clothing\n* Change your eyes and mouth\n* Unlock outfits by playing\n{1388403669037468}\n", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
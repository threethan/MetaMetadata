0f&oh=00_AQSJ0nQ1RDHt2ZCCVg32FTE3eeXL9yUhcAzta_UbGmQ2qg&oe=6B0B34A2"}, {"file_name": "BowCourse_QuestStore_01.png", "id": "509858568475139", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392282_509858571808472_3316931944811454768_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV9BL2hdkgQQ7kNvwHXFUuh&_nc_oc=AdrnZg22DkXt4btw1jZx8gYrjgHNG37koHmQEWToTeC_vFpL1DDvYfTNdADdl7LYOfQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDkpQ1n6Joqklr0vhZ_06pKmzKnH75WBG2pO2t2h_haw&oe=6B0B2B0A"}, {"file_name": "BowCourse_QuestStore_07.png", "id": "675548511568390", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391787_675548518235056_1018153086863976528_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr_V6kJ7GlwQ7kNvwHrTvjt&_nc_oc=AdpHcNuIuJQD_SnPXV3Ol0BfxksGMkKDJ2_5vjOek99ZkxnmMjGaG_y7Doih2bnSMnY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTk5bVRcdqIs-oLbtkCZXrlAqOzncH5bpMP06TfolWZUg&oe=6B0B39D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9bh38qiluAQ7kNvwFHTWjE&_nc_oc=AdpMfwh8i4mGRt6UlzfIB5Y3BVL20IvMyRNE3G3ePd_Jtck8Keh96kBmPNmekYjj3ms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQp9hAgZ_V7HoN53TTDwIGDeWVqW4JqhXjyNVxhyp09SQ&oe=6B0B1B92"}, "display_name": "Bow Course", "keywords": ["sports", "casual", "archery", "golf", "multiplayer"], "long_description": "# Immerse yourself in a new VR sport - Archery Golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n\n**Bow Course will be released in Early Access with two maps and all main game mechanics & features. We aim to add additional maps, character customization and more features during EA. We look forward to hearing your feedback!**\n{1284964985943064}\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Play comfortably with teleport, smooth locomotion and other settings\n{1772529446871531}", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
9858568475139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392282_509858571808472_3316931944811454768_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDXGrbuUO3kQ7kNvwEXuv6A&_nc_oc=Adr5J4S3IDYOjFY2lh0RLUHkFJBnngu6YgVkXHETRgiSSAdjLukOViaxQLlg3GPD0Mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7-xA5t5hORtZ75dLGqZH7UUcMLGN14GKAK7PvZvUkKA&oe=6B0066CA"}, {"file_name": "BowCourse_QuestStore_07.png", "id": "675548511568390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391787_675548518235056_1018153086863976528_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfGtRHxPETYQ7kNvwGjIvko&_nc_oc=AdrhPejB-zoZflZ5GUmUUa_3pd6ZDoY7CoeBWgbN7iMATYs7L3LhrzfU-PY3YexngfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtObjfedAKV5ZuoDKeXo9yOyKxz0SE8zlfCw-1VIreGQ&oe=6B007599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKb7RG-fmnkQ7kNvwGETtrr&_nc_oc=Adq8eQqTICKbCYcj1ay2TgywfHQbOmhLTm8aKlTpAcDqye2vuuFlmW_NH2ll3xxkYqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5ikS2G3k_DX9BrK-HX6mW4QpHD35bSDdHWT70XV7eQ&oe=6B005752"}, "display_name": "Bow Course", "keywords": ["sports", "casual", "archery", "golf", "multiplayer"], "long_description": "# Immerse yourself in a new VR sport - Archery Golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n\n**Bow Course will be released in Early Access with two maps and all main game mechanics & features. We aim to add additional maps, character customization and more features during EA. We look forward to hearing your feedback!**\n{1284964985943064}\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Play comfortably with teleport, smooth locomotion and other settings\n{1772529446871531}", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
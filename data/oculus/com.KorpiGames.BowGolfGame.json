5554145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1033485702220811_6917860014135126447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDxxJIiJstcQ7kNvwH6-Gqs&_nc_oc=Adp0lF9yym4zBpQJNjCacHNuSnC80iaSStAdvR_0GKp671HunomFXJ2IMxG3i0ekJNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08olRDcR3u5NlR3kTic9KBG9Jf2-RpxFCLag0_0_xGrw&oe=69E8DA8B"}, {"file_name": "New_BowCourse_QuestStore_08.png", "id": "1697048881018586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499319013_1697048884351919_5531112753064302333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAfm9cNPZiUQ7kNvwFCO91x&_nc_oc=Adp04DoEMQSWYamGcFq3taB-jhjlmR3DKO3Yg20Ql_nF3VZfMI4v86OQNGMdyMlWXXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02Y0Us8aMG4wafUBBhpdo5uALqEDuDX0avDm0esSJ4kA&oe=69E8C0AB"}, {"file_name": "New_BowCourse_QuestStore_02.png", "id": "1738622320871891", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827567_1738622324205224_1562867178012633561_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkZeidH02SkQ7kNvwFqB568&_nc_oc=Adqt4YGSWvEny-zyilzjtul-i88CuzKOhIxDiPBt97E5o6KltVAZ8S9R_QgoE_odNtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jXDlDxHcbPURYVfjnFFBSCZuCdaScI9J3VCNegJ-IjA&oe=69E8DB2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-APPB4smIgQ7kNvwFa2RAN&_nc_oc=AdqCUfLh-tAA-4Q2j1i3YulM-CuYfcf98gfSMA3diGVbuSvK7L5QfuKhIho1WUXh2Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KOVgcCMIcUe-OC5sviGvONaGB4FLwNXuohccpF9zwIw&oe=69E8D952"}, "display_name": "Bow Course - Archery Golf", "keywords": ["sports", "casual", "archery", "multiplayer", "golf"], "long_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n{1449951679695905}\n\n**Bow Course's Early Access has two maps, difficulty options and all main game mechanics & features. We aim to add an additional map, character customization and more features during EA. We look forward to hearing your feedback!**\n\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Hone your skills with practice mode\n* Play comfortably with teleport, smooth locomotion and other settings\n{716753251094485}\n\n**Customize your outfit**\n* Choose from variety of clothing\n* Change your eyes and mouth\n* Unlock outfits by playing\n{1388403669037468}\n", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
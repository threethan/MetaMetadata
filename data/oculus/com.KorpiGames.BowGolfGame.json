BoP5cQ7kNvwFY8UeB&_nc_oc=AdqYQSc1IZ2Fg6_ttDOsS-7P7gBR2DDraC6pe5mP8-f0l8STxHuFI0k2zFHQGgULr6k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpcWNQ83P2t2htFHuf8IlMSqGOR1PLh0rFQ_0XExUDaQ&oe=6A85A1D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BowCourse_Thumbnail.png", "id": "2057677827991603", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393956_2057677831324936_6257418328995593478_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOSdoSMrUWIQ7kNvwH6ERhC&_nc_oc=Ado4z73dBSdk5QR3bi96QZyzI7Vu6FlIZG9eypxh1e90hHFObbPR079PluGIhb3dFnc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9YWHW2Pjef0zNor92D724Gnvbmk22pmIxCPTgtCi9Eg&oe=6A858392"}, "display_name": "Bow Course", "keywords": ["sports", "casual", "archery", "golf", "multiplayer"], "long_description": "# Immerse yourself in a new VR sport - Archery Golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots in the end wins!\n\n**Bow Course will be released in Early Access with two maps and all main game mechanics & features. We aim to add additional maps, character customization and more features during EA. We look forward to hearing your feedback!**\n{1284964985943064}\n**Main Features**\n* Play solo or challenge your friends in multiplayer\n* Realistic bow handling & arrow physics\n* Versatile courses - Each 9 target course offers several routes and shortcuts that players can tactically use with different arrows\n* Fun and challenging gameplay \u2014 Easy to pick up but offers depth to master\n* Practice at the shooting range in the main hub area\n* Customizable difficulty - choose starting point, wind conditions & more\n* Play comfortably with teleport, smooth locomotion and other settings\n{1772529446871531}", "short_description": "# Nock your arrow and challenge your friends in archery golf!\n\nMaster realistic arrow physics and challenge your friends for a round in beautiful and challenging 9 target courses. Gain a competitive edge with skillful usage of different arrows, avoid obstacles and utilize shortcuts. The player with the least amount of shots wins!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://korpigames.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Korpi Games Oy", "support_website_url": null, "website_url": "http://korpigames.com/contacts", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9467101290071693"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2022880861637585"}, {"status": "PUBLISHED", "id": "1601716561036468"}, {"status": "PUBLISHED", "id": "768952662919911"}, {"status": "PUBLISHED", "id": "1388358519695123"}, {"status": "PUBLISHED", "id": "1158170342934814"}, {"status": "PUBLISHED", "id": "738023275663785"}, {"status": "PUBLISHED", "id": "1045558620401287"}, {"status": "PUBLISHED", "id": "663548806643921"}]}, "baseline_offer": {"id": "663548806643921"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "2022880861637585"}]}, "liveChannel": 
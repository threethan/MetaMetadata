ler_thumbnail": {"file_name": "Screenshot 2025-06-17 160730.png", "id": "616899590781376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307422_616899594114709_8796208626525528597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBTgucVDqD0Q7kNvwFhVdy0&_nc_oc=Adk5p1qxUPFKQTVkUkiMnW_AYo9hjwgVFrL3psILo1PN0ZZw_e0GqWhPp97-6wk8i8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afukg_pCmrTB-N-f4qI06DYh9Ts7j5SQahIxp6i3tvX-gw&oe=699C322F"}, "display_name": "Marmoset Monkeys 2", "keywords": ["Monkeys", "Monk", "Mischeif", "Gorilla"], "long_description": "SWING, CLIMB, GET INTO MISCHEIF! Marmoset Monkeys 2 is a step forward from the past 2 games \"Marmoset Monkeys\" and \"Marmoset Monkey\" and is better than any other. Play the parkour levels, go shopping, play some tag, and find secrets unknown by others. This game is in its app lab stage so it may seem incomplete and the goal is to make it as good as it can be. Thanks to the moderation in the past it has been a bumpy ride. Enjoy this game it has been a ride thank you all!", "short_description": "This game has been worked on for many months and is finally in its app lab release! "}]}, "developer_name": "Bright", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "developer_terms_of_service_url": null, "publisher_name": "Bright", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
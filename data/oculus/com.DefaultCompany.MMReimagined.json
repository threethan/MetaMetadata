=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cYWwyhRg32Xn-rroYZ5viGcXd41rdlL9EivcJ66qpxQ&oe=69F73E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-06-17 160730.png", "id": "616899590781376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307422_616899594114709_8796208626525528597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvIoPO0okNsQ7kNvwFSdkjl&_nc_oc=AdofOsvp40OZVi0QY-jvIC0e611D_gUbUJhuWZuX_jYAOeHvoGhD8js87jGHuYOr8tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yzdFeXOZmoVVOvPGlNz6LYCmw40Or3gKfQB79t-Bazg&oe=69F761EF"}, "display_name": "Marmoset Monkeys 2", "keywords": ["Monkeys", "Monk", "Mischeif", "Gorilla"], "long_description": "SWING, CLIMB, GET INTO MISCHEIF! Marmoset Monkeys 2 is a step forward from the past 2 games \"Marmoset Monkeys\" and \"Marmoset Monkey\" and is better than any other. Play the parkour levels, go shopping, play some tag, and find secrets unknown by others. This game is in its app lab stage so it may seem incomplete and the goal is to make it as good as it can be. Thanks to the moderation in the past it has been a bumpy ride. Enjoy this game it has been a ride thank you all!", "short_description": "This game has been worked on for many months and is finally in its app lab release! "}]}, "developer_name": "Bright", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "developer_terms_of_service_url": null, "publisher_name": "Bright", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
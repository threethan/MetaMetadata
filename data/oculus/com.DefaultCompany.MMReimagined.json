, GET INTO MISCHEIF! Marmoset Monkeys 2 is a step forward from the past 2 games \"Marmoset Monkeys\" and \"Marmoset Monkey\" and is better than any other. Play the parkour levels, go shopping, play some tag, and find secrets unknown by others. This game is in its app lab stage so it may seem incomplete and the goal is to make it as good as it can be. Thanks to the moderation in the past it has been a bumpy ride. Enjoy this game it has been a ride thank you all!", "short_description": "This game has been worked on for many months and is finally in its app lab release! "}]}, "developer_name": "Bright", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "developer_terms_of_service_url": null, "publisher_name": "Bright", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicymarmosetmonkeys2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10046343448748177"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "690252247116884"}]}, "baseline_offer": {"id": "690252247116884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750352640, "status": "PUBLISHED", "id": "690252247116884"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []
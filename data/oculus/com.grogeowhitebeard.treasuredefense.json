XuyJITva9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkR-sKWeWcJ5xHecxlh6N0ty4MzGGXjmq2Q8MtQU_uKg&oe=6B0F098E"}, {"file_name": "5.png", "id": "1452565746975327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1452565750308660_3113211762538989637_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umx0U2CzhTkQ7kNvwHC2gZ5&_nc_oc=Adqdf9opS9rSqZDqtoGRmylzPi2fB_QumJ7wEmhWdPg01a9rISbZYNaRd7zYKn0EviE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXS-MjBoqxuONW4D20QJMXVfvzoIJhDfgH0iSn2PANf6Q&oe=6B0EF737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Defend", "keywords": ["TowerDefense", "MixedReality", "Shooter", "Pirate", "Action"], "long_description": "After extensive searching, you\u2019ve finally laid hands on the legendary pirate treasure... Unfortunately, you weren't the only one on its trail! Thieves from another dimension are now trying to steal it from you. Using the turrets and weapons at your disposal, defend your treasure and repel the thieves' assaults for as long as possible.\n\nTreasure Defend is an immersive defense game designed for Meta Quest 3 and 3S featuring:\n\nMixed Reality: Choose your weapon, place your chest and defense turret in the middle of your own room. Thieves emerge from portals and navigate around your real furniture to reach your loot.\n\nFull VR Mode: Explore and defend 4 diverse immersive arenas (medieval village, pirate island, dungeon, and ruins).\n\nTarget Practice Mode: Unlock this bonus mode to test and perfect your accuracy.\n\nArsenal & Strategy: Choose your favorite weapon (crossbow, buccaneer blunderbuss, or sheriff\u2019s Colt) and combine it with a turret (arrows, ice, catapult) to survive against waves of formidable thieves.\n\nAre you ready to protect what\u2019s yours?", "short_description": "After an extensive search, you've finally laid your hands on the legendary pirate treasure, but dimensional thieves are trying to steal it from you! Defend your treasure chest in mixed reality and VR using weapons and tactical turrets. Face waves of thieves emerging from vortexes and survive as long as you can!"}]}, "developer_name": "Whitebeard-Prod", "developer_privacy_policy_url": "https://www.grogeo-prod.com/politique-de-confidentialite-jeu-video-treasure-defend/", "developer_terms_of_service_url": null, "publisher_name": "Whitebeard-Prod", "support_website_url": null, "website_url": "https://www.grogeo-prod.com/games/treasure-defend/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "it", "pt_BR", "ja", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1445103448686505"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2000253621319681"}]}, "baseline_offer": {"id": "2000253621319681"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793289840, "status": "PUBLISHED", "id": "2000253621319681"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1506560062540843", "version": "1.0"}, "id": "2295257114557457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1387488
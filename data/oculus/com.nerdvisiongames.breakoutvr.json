/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfCKGRmmcB0Q7kNvwEQ3rDT&_nc_oc=Adq9t-ENoS2ZhMqnvL5wDYVngxDnHXHY9Z7LruQa_rEyUkGL5mPHGpoPbP7A4gDCi28&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDffljgZ_S-RgK0nlOjQmuEd4_ETVgHhEvo-Ij04AP4EA&oe=6A5A2D1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5f97sMPWpoQ7kNvwEVINzC&_nc_oc=AdoOO7sIQzqXlLKKBaUIr5N9mpjNPvaxPCsMkmB5OeeEEyszQLu2wr2Qk3fy21GFjKc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Nc3-nM4YC1ApSzm3QZnznjl9hU25LjlbYGcqq8I1-Q&oe=6A5A4AAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnWZfFDMDaMQ7kNvwGuCiYK&_nc_oc=AdowiIOHrXPS7iUZGvOnAK4B2dXD91PTqyCO61sKILfBWOOvkgWuU4T0oZ41VSeJAXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQM9JFnDz5zjbveP9JnsIFS-r4Osby307gOU5_ujO1ow&oe=6A5A2E71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
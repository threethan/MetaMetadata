/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58pScfFnL6YQ7kNvwHHMUAY&_nc_oc=AdqHq4jbkEArjMskBNfdFdnoxYIQ1EBJjjioQn8K000YvdQ47vHs9jqyOsIw8FklMeM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9d9uCT-QxbmZrC7hWAdDVKW6JCK2XkxmFhgWkibrxQQ&oe=6A217C9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbWx8sEFCLQQ7kNvwH7PXob&_nc_oc=Adr2zGu6tFQxtxARUtgtFZvi8rEsKD6UGSI2NT7SNBRI2ChRDbMZQzM1vX7SwT2sY74&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fdojuTxzUs2nC1-PzsWg4SjhYTMmjsBM5r_nqYNqw6w&oe=6A219A2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrLDbeVRtKMQ7kNvwE8Ro9o&_nc_oc=AdqJrM2ISesVYoUMcx76ZHuEsBES0d8KGGHyd71QsBdqF1cBdrDdoK9nAWncZWaWomA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iNRfbPkvmYRSmUCwrxdvRzhaJP-DOb98Iqhka_u7GWg&oe=6A217DF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewE9i4TpKIsQ7kNvwE7FeWH&_nc_oc=Adq08ajW98rtvucGpghkMJ5a0g5F1QdrYsYygH_RI8y36VUgAG5nnspXhgpY3eCOsgM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0YEX1C68OCecKXCWQPsYV1f_1CzCxgTrI_xDB_lRU7g&oe=6A88519B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6j3TONaqw0Q7kNvwGsPceh&_nc_oc=Adpm-BWMoKG2NTyylaO9rJnsr5TMU65JfI0YxB2zEeyW9al5p3xW1lOwitwjW6K3zx8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1J5hCu9P2osUdL6bYBG5F8Fc8gtKRbbscltOcTIANGg&oe=6A8836ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gc5xZuc8qUQ7kNvwFdMB8H&_nc_oc=AdoWky1p1_IJUegZxLmQGdH9WqRAwCh3t2MTSm4vwliTkCliHx5--2tBLK78I86q8kQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsQChuOx3xtFrh335eIFLzcx7HDlx2IXcnioUz7VpLeQ&oe=6A8852F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
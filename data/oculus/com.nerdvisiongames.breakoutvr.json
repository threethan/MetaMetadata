/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibYcigkj2OoQ7kNvwGrPYc5&_nc_oc=Adr0t_bXrHee9l0VH2CIiR75sztLa10QX3K_4lfv0TNctQsJwcwB1ikyKiKVnlZZim4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNtnJVwhEc_2o8Ct1nolS_jApAsLMOreTkgE-7zPGTbg&oe=6AB9191B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6QZnsD9N1cQ7kNvwHbimly&_nc_oc=Adqo8j2KsRhU8nc5MWn_pdFfe3aw2BS7c56Tm_w0p_sXloeTx7U4Q97j5NvVIpsWWxo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9SKT_rI4Qiv65ry2pmmdILjjp8-178-G8vLovLeSgbQ&oe=6AB936AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rQHgqqn0uoQ7kNvwEGXjbS&_nc_oc=Adru7FzhcX1ZAVYc5Q4C0DqDmz6ByKOXcH0Yq-Zu4KEG1GAg4T8IJSDYTNa9H9XvY_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpAWV5AEbxLwer9NlHiplYdwdiWLl5sYRKSVo3JCpVJg&oe=6AB91A71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
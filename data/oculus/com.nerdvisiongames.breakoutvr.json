/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-jM4FfQLWwQ7kNvwFyEDgc&_nc_oc=AdrvVQ1I0I-_hE1DLovCd0HFQeAWgxuwMQlnRxWImXMC_bicRKrWafgM7LtRwG-iPkM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXdvdAMMDizmHvq4NztB2-x_u97zRM2_Q3_o2rRKX6IQ&oe=6A4E4F9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYz-DNBZKCIQ7kNvwEe1RI4&_nc_oc=Adriv1neehj_XVqYqs6HpXp5xVtsBBKyAdDfd5rywSMeOweGKy1zTqXgEHGNK7u9RKo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcOX9tkZOhZuBWnjHMijQo52VoH9pCJcHvO2Tj89f9Hw&oe=6A4E6D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6p87w7MeI4Q7kNvwGkgaAL&_nc_oc=AdpEGvQDnRXsSQfEdYhPRCnnPdxr8SZx8ODvPjidCIfhwe-QY5kGbo3nOGmMPEpuiww&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX67tzmVyfk4ZcTYy2MOX3fSQMI7jc6kypDIm8JD9UbA&oe=6A4E50F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
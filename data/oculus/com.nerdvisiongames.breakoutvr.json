/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X26e1U5HYPIQ7kNvwECFMH9&_nc_oc=Adp2vhFI1_f0qzwS9UQBg1SsAJmLxJOOndWBTEKnDKI5W4FAWYDF9fWmEK54fywg16g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE4lGCZFdVqfJhqr5Lu88AOJLBepw1tiXxX2gLi_vgJQ&oe=6A7B229B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiNoEcyRDgcQ7kNvwG44-e_&_nc_oc=AdpOyBgr_OOhAyPnj4c87jB5GU7CQfprH3F-1M29cjIaR2ykIvO3rR4ie1qcX3PK0nw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExpCPcn8wH8Cy-ayYfzUDKAXA0tGDJsXWb8b9dwaZCJQ&oe=6A7B07ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeXNHKl9ZVcQ7kNvwFqCrVM&_nc_oc=AdrMQebZc70P9bX_Qja74DZoYErSLIfqLL-0zleK9mFWK-VA7w4n7g-vM896h42_EW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0z2zIXJSSEbMb_jKgn23vLz5EyOSylPtIO68bAFhT1Q&oe=6A7B23F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
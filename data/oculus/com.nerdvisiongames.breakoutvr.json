/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEemBAGOAkMQ7kNvwG_rVxx&_nc_oc=AdrUPdu1zVpm2rPp6-BGT4HlVzSq6Sm4SllbBCFrQufcmxItWz0oY_C6ChGS7G5eU0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD36g1at0-QYlPkz299qDb0GNxSak9xn5PHqkQMuC41RQ&oe=6A60C49B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEuBQVPzg_kQ7kNvwEYOU7C&_nc_oc=AdrH2bC87YldCFVs0kq8rsAcZHVKI5TESvoe9kJfyedDgAhYlWTrcKCgwwvd9Y2_uYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJbUBPvf3oRlSM1sJTeVpZidptohu6xjWsU6tXJQ29MQ&oe=6A60A9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSJNHBm_X58Q7kNvwGr3R8E&_nc_oc=AdqZnpSnhiQO97jVcxfOIpl-T0AtMRg-TBa3Ad9ektEXuuoEbfCORWQJxFpyWolkZKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeEyYulte9-kRG1y-ibjNMYLIzLpcSmsNQ2saqYpvGbA&oe=6A60C5F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcCm68sjn_gQ7kNvwHBvxwq&_nc_oc=AdphoxVDdpPa1C1pC94Nrv1GEzobCB6LMLu8bQoft46DT9H3aN4TMXSWEe3dYLW9kkU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UQ7gf4-IMg1Nn69Ej9Lp_u555lIvLsrIW-JmYW60BTA&oe=6A1AE51B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbEK0dkpH1UQ7kNvwEU1zRV&_nc_oc=AdqI1LAjie1LEc57tgmh2GIX-_u7sCRaVCDqXMwGXwwROAxFJriWsN-8BrPBTLMPU9o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TnKC-stg_JmwTa7UKXTp4gA2_Fy8nXme-amX5Vc2i2g&oe=6A1B02AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vxYoKC-Qb8Q7kNvwHTyaud&_nc_oc=Adr0fQ6RQPCRtVyk-ysrd3kIXlIQ5PYKBJ1YqIT9in3Mg9Xx3uRvMbC0GKjK5ywxZcw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mf7WtUgLxivDMYZfDVjrdZKe3Bu-ECi8LbUfc1SUrcQ&oe=6A1AE671"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
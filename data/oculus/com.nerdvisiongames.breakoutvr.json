/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KgTd3lYknQQ7kNvwEx7U2_&_nc_oc=AdoDGKlX-Zb2nw4K5Mhy9d5ZwFUIwlHdz9k0BPE7ABWOlumj5VIsEc0qrLJYIW4S8nI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpgdTc42Z75PvfXIZ6Pa9ly-wc23cC5XvcTq1xdiYV3Q&oe=6A58DB9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5f97sMPWpoQ7kNvwEsJQfQ&_nc_oc=AdqOXgAMFwqFy1Qz25pfhIuFg_J62W-cgITjhY3oygRtp95ES4jMWDhSaz8Xtmd0vRI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBjcfCyR32c0WzitNp4RTzEDuNODZv-5ck3CJqtR8CeQ&oe=6A58C0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mxwlLm4rpYQ7kNvwH0BFEI&_nc_oc=AdogY8c1oWhmrTm1TKOuKgdGH4gfSXkwgLiQ-mKHSMkVmmKlQyQ4Upe2fNm1oU9ih40&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp3auiSYipkrlG9JcBaE8H-ouctD0HCg5CIG21j5l4wA&oe=6A58DCF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
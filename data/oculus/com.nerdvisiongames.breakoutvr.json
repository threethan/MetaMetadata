/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5lpfr5bRWoQ7kNvwFRO7wr&_nc_oc=Adram7_isZcXKSd5NhdafYkC9QLyZEXhhhBkGW9WXPMwmXEf8MOVXdMgsXtSsreqsYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK01PwbF0JsPl5T3ZU68kk8JiOIoEtoyNeJnpnmOWyGCg&oe=6AB1301B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9ihGBRRQ04Q7kNvwFc43y8&_nc_oc=AdqzTAS7ZoWx9gb44yIVs1uYMzM3X60CrGc5iyeesFzxGAfza5t55AWCdKv-RYLuOZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvJ71yhz9Tf9gfaRhY9bRbCJGo7JUJnqe4uzrZUcSXNQ&oe=6AB14DAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UjE1t2QQgEQ7kNvwG6eJZg&_nc_oc=AdrKaaooeRz6CdfIdrYFwg9slfWKCwpYKDvbCe8Ts7Nd-IQh5cumS_jnsjo_QZ0RPmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuVyiBH9fdNWGArr6zJjcBgzCyflwOrWRobMJzkvMwbg&oe=6AB13171"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
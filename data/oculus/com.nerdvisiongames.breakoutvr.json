/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6I2qPV5y_cQ7kNvwFC2ezK&_nc_oc=AdpTH1HbSxr4Vsi87UJzbFxOwZF7Ok0Wysd4Nj-v-ceBvojcK7-yjRrpyHgrGYTws2c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxnpYgJwNaDYtGANI3JBkLdlb6cpz8q8PzFagd3I9f1Q&oe=6AD3AF5B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYnGdiPIB60Q7kNvwFl1EiT&_nc_oc=AdqZ5RMpEBxck5Kd53snhb-YxUqRo8tbchEq7V2GElxUu_hnHk_sA-aCyoEbe8Zenjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtmisglPbZucY9uIGTdElKTjBjEpuJ2vu8vk4Tdh3s1g&oe=6AD394AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnyBJq-bKT8Q7kNvwE_VC2b&_nc_oc=AdqZvjxblqh2V5JR-fcdrlX5ocVBXBPYQbpxoNVm6xBDcNUBGbTiSNe-6t6PPvduu48&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiaYyxXlLHi9KauFzFpXcffRryFVXNc1BZm-66e8BWrw&oe=6AD3B0B1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
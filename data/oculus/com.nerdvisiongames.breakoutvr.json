/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVuE1ImB3xIQ7kNvwF0ray6&_nc_oc=Adpwhr7XbsV8kTDytataxERr6mPbYdtleY9mqdsAQi1_LTgmtqk_Mqdk4eSjh1jOdG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fZJUK5zf9r6zNFybpPxboz87tHD-KZ5xb_hYRdJvPzg&oe=69EA1D9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2fo0eCjiM4Q7kNvwFV8G5t&_nc_oc=AdpH3ijkD3CH3ibGl0prysqlyH4XKJSB8-XEP-sCTvlkh2LQgZTskPmriUXexDB-MsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dx2_5vNhLmtxe43jMdFYvceny9oS0oZV5JZvjQ3N87A&oe=69EA02ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx5XNbLkzcUQ7kNvwGmkvVi&_nc_oc=AdpoU_Ix2K-zs0fGUCbwqcgbwU5W45slzMojq4wCceFBsqgO1R8pYvMYC-bzvvsz-T8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14QbXzKSfDLCNJoNqUYcoyPB7CYgYy8oX5ttnaWu5s2w&oe=69EA1EF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
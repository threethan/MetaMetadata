/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77ybyygzjYgQ7kNvwEmEdPG&_nc_oc=AdomI0s6BK3yZHAc_1foXm-XeGP8lcmbyAqyLsX0sbLl41ZP5yQ_I_w8jgozDs6TDfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzidKFrbSzfn1pkFHHXkp0QHnsp-iR0dlyQC2Mol9Clzw&oe=69CA799B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CG5U1sghCIQ7kNvwE0qY7z&_nc_oc=Adq6MbfXhHAdv4CMKP6sJm9plYNvvVh-Gf20Z3JOF2pYgsjzGhyQR_wvTmB71_3Jt7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL8fv1r0x6TR9_pSeJXzk424WAy4gGge9CvLukzwiyYQ&oe=69CA5EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzT-jUZzfXUQ7kNvwF5Sivk&_nc_oc=AdpCVRYXJpI0qnkWMoAfvhrG8IecrPwQQJB9FIs5OO5fs7xA8lerDu0bgUW4YO3oVLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKeyQLyiV1jVbtpEP0X6cZdYiGdjzf-XEfK5EXF7G-QQ&oe=69CA7AF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
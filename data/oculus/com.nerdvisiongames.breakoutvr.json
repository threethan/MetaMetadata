/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGdqsa3iWGcQ7kNvwEktldC&_nc_oc=AdoPZ0zlheeI_jUPEcM2e58ky_Gw83TIX1xFWegjwyUQUZOBqOJqnySe3VLystw-bdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v-RQpQy58atdQUqhCNqxsHnuVQKMVeZrqIHKK1A2Pgg&oe=69DB9D1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP3WQyIt6toQ7kNvwHzUt7T&_nc_oc=AdoC-lChAtRnQyOGaZSr9vZW5ix3tiK0Y69hjkksVACCixjjwGlnWHVuvMJyNDiibbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06osnvswMW9SUkEPYTeQu6vJ6dbin-SmUXMAplCEICWg&oe=69DB826D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtPLpxHtjq0Q7kNvwFo-SfJ&_nc_oc=Adpmcg8VUxFSsAB3vqcuxrud9PTjcWOGxwW5w72vYzvKRPexgZ_wE-98ype_UAcrYxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wnf1MS54fDjPMThjKu49veAZ31m-IQKbVy5rmaZQWnQ&oe=69DB9E71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
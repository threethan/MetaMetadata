/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teA7xGzNEfkQ7kNvwH8UuD-&_nc_oc=AdqbTygFB7HlFQcFsQt3Sga83gkB0OW-LoyiR_gLWNq1uxKW3Jl5ELo9tHDy4RJQ_ik&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I3rGRZG_HDa5RC4xgShb0PlU9uNEsapbDMavgewHeXw&oe=69E2349B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfcaXz9bAvMQ7kNvwFg9JKn&_nc_oc=AdqcGvMKDdkRDwGlbMBQ8izZGfyH962lV8fB1ApiyPEPzlOFdo1r0llvNaHvBfQRSWQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LS5vIQmFFCSoMZiM65Cggdme4XfYxZ3AFLTsCGJ7j5Q&oe=69E2522D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bkMdn6-dXEQ7kNvwEcQKA9&_nc_oc=AdrKZh9Qt6mAYfM-Q3PrrFbU0gU0S9Ab6Aplwbz4D6V-N1WGDLoYvh3xtYvjlaRXNP8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wAd_wjCoICT1wdmbidHAtdln6jPn1W-j6AYNCAkVlBQ&oe=69E235F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
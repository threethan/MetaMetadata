/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a82C9i_xgpcQ7kNvwGavM_h&_nc_oc=Adqfe_RAqdyodpEiHtB5Z2NWVzcBox1Djo7UKYlOeO-CZpj8l60jw0sEvoiMS57H5R4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tQHqTKk8j4DIEYptmQaIvRDwTmRDmG5OKAbGCVlEehQ&oe=69DA4B9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP3WQyIt6toQ7kNvwFKi8Ks&_nc_oc=Adrso_3J112AX450iv6sjnX_kTjsCVvnXvVc-nLcxm82N9c-hosIIlba8tqfPR0lgY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_fj5W41aipPzB6VPl3y9LsnmLK2Om_pwfi4uyzNPCeA&oe=69DA30ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blW-r47rDscQ7kNvwGhey7m&_nc_oc=AdokuY90TKnY1HLIJLG6zygdDuBfCvJLj3IsRxVNUW7Zw8qAYNZUXV69T7zCiC3Uv54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KN56odLgg-UWpnem1ldSoHvMaXNW7cz7oSVRDHFtBrg&oe=69DA4CF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
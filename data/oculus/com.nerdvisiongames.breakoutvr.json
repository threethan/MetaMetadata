/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26jcRDNicSYQ7kNvwGOKfp5&_nc_oc=AdpQeIRHtbcPB94l2s25v_l7_n8HfYiZ_YaT0xwcVgdYIOVwcDaAeuF-BxarsEw_arU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7htFbzeAIUpqPlMXpMJ8JXxlXHz5FhwEG4RBc3yAIrw&oe=6ACD17DB"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLY3KIqv8_YQ7kNvwFpmLjE&_nc_oc=AdrnoT-b14fbyLFympfCBKxhPmadt7xBHT0qy-cEMpPXCTAs5L0J4L8Vo1qnMt02_Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_TnpPaa9JulMgOmEiZ3UiWEJgdLOXSJmoRaQPsRmJVA&oe=6ACCFD2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CgzU7MLTnwQ7kNvwHBJzGf&_nc_oc=AdrB_Dg17GFsSEaN4VY4GOr2uginR1IHcb2lCubz6z0MdskMZJo2vFdmobDe_5rmKMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRmC7OoLDpLKN_vtPNe4byzUuxO3kcYhkpn8ksxJKOsQ&oe=6ACD1931"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
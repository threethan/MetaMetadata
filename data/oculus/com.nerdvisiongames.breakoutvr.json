/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOP400kiRmUQ7kNvwG7KF49&_nc_oc=AdoFYDC7bRfMPUAMsE8W8mlmepoZIsprpTsK-D9YnmgUyK4zq0MPPr4lRCQB4nYFtbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxK1XR71G6rKvfVTQ5koX1_AYUTwudD0_dY8HgKFAO5A&oe=6AE5EC1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCEp7WDi-g4Q7kNvwGo_JaR&_nc_oc=AdrmryQ1OVuqCXadVS7NdQGnvCPsDmjaQbFEQtcGd9JdnKvnncwk-uopYqkdS9pzbH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIDGjeEiQ0njt5dLzOu5YMTODdrO1JLt7V4RbHHYUrew&oe=6AE609AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5x4boDlLfkQ7kNvwESK0Oi&_nc_oc=AdpcKZZi8-ptVAkNdxjsLtqEuzR_9HUF6EKMlsDT65EO-6k8WD4JxaXSiCmtzZ7u09E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Fm_AeJGm9ZFpWKzweI3XNDLlo5-mKxH6SE5b3h7Slg&oe=6AE5ED71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
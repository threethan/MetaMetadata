/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uueFK7CW79YQ7kNvwFaxvU7&_nc_oc=AdpHgc4ZcILGnIGL3ujgSl4kg9v6OJz_9v6ktOpUlGXbo9i_nk_vDTp3-EIXpoLIrpk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzFUHY_Uy2Tfg9Tvvr5-t-UKsW_R38F3S51dKRUTr2vQ&oe=6AA15E1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgmuZK4th6UQ7kNvwHhjO70&_nc_oc=AdotYofH1L9b3d5yLCo_coKBM168Ot5zAXbenZX7kr1sYFOCieUCkEb-49cqNa56Qd8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGwAnV1PltEe18dw47H14x9mAZ4W59KITBBlRHFuGiWA&oe=6AA17BAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNWtZ4bq6K4Q7kNvwGri1vS&_nc_oc=Adr0QGLlRXo54ncrI2ow9tQ0KTKU7L8nx9T2moD4CXyjI9nCBBpqm5G1dVKierM6kk0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5eB02blnBu6_KNYZPZQNR7OoHpPQlhNu9iNjMx-tsdw&oe=6AA15F71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
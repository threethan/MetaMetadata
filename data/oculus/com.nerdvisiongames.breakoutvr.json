/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXVWAi6Sc8AQ7kNvwGvsyf0&_nc_oc=AdrVQf3Pgn_U3F_245kKA-WJiKkkq2owMNZt5Wa_jlKk_kCXNjis6uT6bRwkUodS5yI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwxJs6PCVyYqdxF0IwxbzZbmdcfcYfvxZWSxjSQFxr_A&oe=6A54E71B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFOKfNPIb0gQ7kNvwFKBaNK&_nc_oc=Adoyp3X4K-Mz9SZbp8_UzmNNHazju2384nE7kkir6Vzg5DJfkcoDTgixcmE6YWpuMiI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4d52YzoR4IgcXrBvezop7eNWHLC41ef4x0rVTubTvjQ&oe=6A5504AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-1ylzclVGgQ7kNvwHPly59&_nc_oc=AdrS7vJ_bjfzFIGe_j5kh0iTKFTcTBt5d9UAie1JXE-c4exI_DIzn4ngzg69F9rL-6g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmr8bHNWMwhawJCfC8wHEJdffxz2bz6ETqk-Mtq6DP_w&oe=6A54E871"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
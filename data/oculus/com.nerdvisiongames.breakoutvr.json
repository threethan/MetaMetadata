/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIwnm0ToBpYQ7kNvwG7zPXE&_nc_oc=Adr_JPux72-OOGmdmOKZ2n8SmitH4dl2833yNG-6Mu1IsYzmg-VN0FMFJhV70O39FxA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPMuR6CkFKgNc4yhJB-fx2vi0h9pAQmzgVBYnUFEb2Hg&oe=6AE1F79B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duMvmgsa3hYQ7kNvwEUd_Ak&_nc_oc=Adrq8D4umPq8ZFZ61s8eI0BqlRwGaj_vlXwvK2XXJMKipk3c5np8FcPYdpo17snQCUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQYlqgTDZH-rp276XCslMspiyzp1elv0qELG9V5fayMQ&oe=6AE2152D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0uexgTV2k0Q7kNvwEq3mB-&_nc_oc=Adp0Tcsx-Bsl6TKlPNOZ6SYKi5A3ARieCtMMOmv8sgXgjlJzrWmVb5i-PQ723NnnnAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9c8giG2zKwnOJl7iG73PlpuQgqb1R4cr9t9CsrFR3dQ&oe=6AE1F8F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
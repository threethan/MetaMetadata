/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibYcigkj2OoQ7kNvwGYt9p3&_nc_oc=Adqfvu9-_L_50XVwTRYb6kdUG5pCmPg1WqZtUH64O5GBfy_zEmbccqeedJ-AikjrEEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkpb803WM4y6_yPasopPsa-aIXliNeSo5MvHKK98xA5Q&oe=6ABA6A9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6QZnsD9N1cQ7kNvwH_Rhmq&_nc_oc=AdpiNDVSDXOEl-EBSiPK7EkOKMGPVfiVpzBvBb4-tya6sOM1o5Zl6Ha_ahVEZUyoFpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeGdZwhaz3uPnQ5Si0vuRwRsWjqI49MVwUD6OYrLhaZw&oe=6ABA882D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rQHgqqn0uoQ7kNvwEiPYnQ&_nc_oc=AdqNKGOpqyQcL4WOUKYvDtNh5rcpYWxHOpeLEhaUilWDEXZAoo4LRai8D0s2fASOet4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTJHnyp7o9Py8XLG1P8kLXkrTUzJF5wZF9PTRHm3ksZg&oe=6ABA6BF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
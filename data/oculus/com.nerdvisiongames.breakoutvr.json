/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTVw2dNOeqQQ7kNvwFPO8FZ&_nc_oc=AdrvAv9MyhtRXkGNRw2SCYGQS1gnkFGh2i8yiSQ2S5CeFQ4sZFGquq6g0AVHD53tNaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjqpqJmHTiCDYgpcfD9OJGUWTM8l6MgDtP90DKI9NY4A&oe=6AEF5EDB"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qb7Zs6hTQYQ7kNvwFP0LMe&_nc_oc=AdrflJZQL3-P3UyV3FO43WWfWjlzVHcMqrMeWwQW_PBv4B4wYwddImgVx2NgV9Hm9yw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeGWe-9BefgZaU4OuU_xmjazlm7T6wIjuFjSumbLtamQ&oe=6AEF442D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdhLbNntjokQ7kNvwG7OXOP&_nc_oc=AdpSuBpQ9xXrWcRtfvJrZqHE_qGy_coScfPizAGXSQRD-ZIeB1MJ4osO-YA_h_DS_q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Ko_NXOK-jR9RcbwcYombpKP2ADKr0wZGW8CDunOmhg&oe=6AEF6031"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
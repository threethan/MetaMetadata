/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfCKGRmmcB0Q7kNvwEImCBQ&_nc_oc=AdopLoDbdcpMvG3e_VQ6xHlff8RSao_JAavs_RMPeVtjAYOqqxP2LhedkDJ3sUwU-qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-us9snAglr2kgF9Y0CkKsHvey9kyw5mKo-Eg8rMporg&oe=6A5CD01B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW1OT-iO1-4Q7kNvwHmfsTZ&_nc_oc=Adou8xEWQkyeNTAZpk4P39Vuy6Or-18YbOtJYPPFCFBj9cddOJ-Qw7hq_oWuidZHdlw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUaXYLlBCXpwiO-w3c_iLLQ99w_xdZagTI5ZwY_yaI_Q&oe=6A5CB56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnWZfFDMDaMQ7kNvwEJGIQ4&_nc_oc=Adp-wk5t7OuxNmpHcNXwCWE71oGQoV3HGLd345YVc47OPr5kPcxMVupC7cvaDtI7OkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHwxghaOnYqySaBHm7XkW-gzlxgAHnef-DUL-FvEubyQ&oe=6A5CD171"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=276Pecoprz8Q7kNvwHCwct2&_nc_oc=AdolMQ3YqeQisRYVPiiEK_GkJ1xiF2_yR-s6_Lurim_5_h4C9JQrs9L4PqhCZ1DLRgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIplBQWmbiUbhcwOYs1253Dv7J4rJGtG-6mAxofaLJWvw&oe=6AAFDE9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9ihGBRRQ04Q7kNvwHwrYPq&_nc_oc=AdoEBVPSQnRtCjmXACHSSaaam-OvyNiL50irouZWhme8XqtE_MUocj2I5hCiRPFeJmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRjyrMrP2LorTU7NwZH-PRcvIcNDH57RfItFmu4OJyKA&oe=6AAFFC2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwO6Slcmp_QQ7kNvwGAtXU3&_nc_oc=AdoyYbNY7AnFxRu8t3RxFkctITV52YfJTJcI-Zy6O4XYk81NEMw2AlpSzvEt9862ApQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUIT-n3O3Zr0VRCwDEEVBALC7ybbSFxSjUIHKi8jy3oA&oe=6AAFDFF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
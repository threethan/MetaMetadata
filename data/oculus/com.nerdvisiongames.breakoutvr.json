/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzFxFnkXyFsQ7kNvwEiTwzp&_nc_oc=AdrZL_rvbwWAN207gAbwGrCNF1I30O-hXHqAXMhUDOAmSmdHMdZj8idaEDNU__WTdWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LDuR79jwxomywQ1qFGbl7IJaa6wOLoy5ifQvlLdG_dA&oe=6A25711B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl9jMCf-zEAQ7kNvwFpiwfp&_nc_oc=AdqwCKDHRo0ySD5yUCoSaSHnMaVMt9v67EqKUzBG213eKyzTjS1hCu-q9Wp_POhrkfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ax5ub79w7XqA94gdUe8T26rJd8ra3pEeIlTKEiq58nw&oe=6A258EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KdXG0vqSRQQ7kNvwFq0Od9&_nc_oc=AdpjimnJU0x3XSHg3VNsse3w0UEZG0NI8KJgv7A-tIBfdEoF4G6XxnU-f_GLOKNOAAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K26odYj4eIaPjJMw3J-ZIxj6nlVKpKl2EFiBCfVzD2w&oe=6A257271"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
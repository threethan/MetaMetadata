/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BtS0LLUvSoQ7kNvwFAoTHN&_nc_oc=AdoE0JTmtksfD6umQfws9AvLNrQgRQgDIY6VkYHlW9v7EX-fXM5mM-P4KTdD9UGrdLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq3kg_yNybeZpSnQX0SlG6j3PfGR9pXySqnHVe6OloQA&oe=6ADCB19B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIGl2Z5LTFwQ7kNvwEQP-aU&_nc_oc=AdpXMw92W77-nwUsxOHpk1CxCyjpvxVHKK9_TfXpVP1QrhEJubQ8c7CSfJeqq876IpQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp6A1XMBJuLbw4svVhIB-fdNqi82l-Gpaapqs4KYlz9Q&oe=6ADCCF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSPG6EVxr6sQ7kNvwG3Hpto&_nc_oc=Adp7W4d48XottKHo4W_f3hLCLAnKPA35dV9MdjjARBwWzxm79ANv748iXDeNdjpanZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrta7M4XDp7sk6ALis2cK0tWSrrRbr4g3OoFuYVsYFDA&oe=6ADCB2F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
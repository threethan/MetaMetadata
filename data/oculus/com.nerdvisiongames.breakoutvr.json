/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9bbvADkdXYQ7kNvwEOpKtS&_nc_oc=AdoLT3Jw-1ltMUSSaMPrEBVhx9k1CW4Swz026VspSEtsG_b8rvLleYRsb2kAbj0PuVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJkupI4jr4RASaurUSth0vIhGudl_iJcoJF344ZSB6Mw&oe=6AA5529B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P756ao_jwSMQ7kNvwG1kzid&_nc_oc=Adqz4TicerRRIO8nyUTNM3yiUfae0mu7TXOyr_hQIqUEaWIj495fJzqtYD0afzsNzA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKawCRwMtPnaw8q_yXD4ELkKORE9kPsx7JuPx9XcffNmA&oe=6AA5702D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ih7GOjcsMQ7kNvwE2936Z&_nc_oc=Adpf0lLyzLMVfDahZEdaA1HvHB9vq4sIMshuF2YQibVeAmQ3DJZMwYHd5ZkYrUCMwlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjH6h20I_9fypVTl6hSvgTN17ZneG-hTyjR2_qW2CmRA&oe=6AA553F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
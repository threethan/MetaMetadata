/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6I2qPV5y_cQ7kNvwEh9xzD&_nc_oc=AdqPd83zjbnRdCQVoPs9yjYRLc5sMFRrnFVAIas1lytC3cgIHGmXmjbYGVcf3l9Ctj0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9cfoFmJb2axBZOh7pv4ZiXJ5nQbvJxoYP9jJlsrIHLw&oe=6AD0D41B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lFxZ3_B5JcQ7kNvwHlVdzW&_nc_oc=AdqFOK8GEDTD3-xpQKCGlVRMIB8Jow0eE6w5UFL66r_qyhX8tk0IERbAERnr9RuzZys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdyONWzdTOk3-qexQLlC4CjqZkZ4DQdVfbvvrY3JnHxQ&oe=6AD0F1AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnyBJq-bKT8Q7kNvwGAKLLd&_nc_oc=AdqoFF2-Qrjdj2pr1UuFvh4W6Lw_EKhxgSLrvZtKJOuTKdUZ-atZbV7oJn3WK80RCW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpLy2lfnSE-JLe6SjtIfI1ZUOVdsVfBl-b-neW6tm1mQ&oe=6AD0D571"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
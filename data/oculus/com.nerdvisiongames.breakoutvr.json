/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_qDLxD4bk8Q7kNvwF2Rfty&_nc_oc=AdrJ3_YFfJrjip4_cgS2hbrpoWB5O321PPo1eH_tm-HhynrfgdE94bPTUnMMiNv-erc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Kf6UtfbPyZiqJkhkp2_9rRMsVXGEhoz9A4kO_gWMQw&oe=6AF5BE1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIDVuKf8WO0Q7kNvwHrA-Qr&_nc_oc=Adrqeo8A0v1olUQXstdlgs-HxUzaRhMkWQMZw8dralv02J5f8vZlvI4REc2nB_PBpoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfo8OLWvhZnf82Aihi4JyejT3m5MMxdqvk5r0v9eHk9Q&oe=6AF5DBAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YybQrdqTcQwQ7kNvwGlUq-2&_nc_oc=Ado7IOcjlfpRARqJ-_PwwHvk0l7XoS4ymmGqx0sMY7qAY35b6CWWYOi20gZQ-9_CjTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHc3DRQu0QLVwPafFXWPtN1q23bOf5hj1f_0Tvbq3_Fg&oe=6AF5BF71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
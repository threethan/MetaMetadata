/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaUJKp7dWH8Q7kNvwFKTxtz&_nc_oc=Adp2ACN-eL5i4XcLdaXM557S2X08QCTgYI47FhV8uL8y1ILnZSRewtVnfMGZcYcNRgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ6uwd9C_plhS2_kUSClsnft6Nn-6nny6XRmTZZ3uZKg&oe=6A75DC9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubrgP6x9zk4Q7kNvwEDsgii&_nc_oc=AdqQfUvE9h_vyAkDoiDrOJc3MyrJXQ43kqSbozdkgQNJ1bmD9NprKjRE7045ouoPfm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNA7KUgMpMr1aXtK57_3RdEIuC4_rymTHuPdW_-H8ZqA&oe=6A75FA2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0weXwlj-6IQ7kNvwHjncpo&_nc_oc=AdpegsQp0yHH6GsmnzkdaiVirS9VROMMOh0YiJkaSbXRE_b54f7DDws0ZK6QpVkN9VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFewkA_4tvmR6rdWzsI_3tXKjweOZF9uyCddQo9TO5Abw&oe=6A75DDF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
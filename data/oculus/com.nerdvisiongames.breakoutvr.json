/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOP400kiRmUQ7kNvwF9EjKB&_nc_oc=AdqfUoGaZoaQkexMfvX8jqBs8it90f7Y8AYLrq23qi-f-s83GkIMFAVBgdDAAMtWAy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR02dhfTRpoMX44wy_HTNL3l9ITcAQyrCNZsSySYfnbpg&oe=6AE73D9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtuBLY9SZpQQ7kNvwErwpyI&_nc_oc=Ado7wA9x6cqDPqstWEsDDSrWs0my10CRNvIPFgVbanMnilD57VBerd3dbwtemCQPX5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtRzcuyhJTphuZ9bq_AIbUw-fv1Ub75u7oM110EA1YHg&oe=6AE75B2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5x4boDlLfkQ7kNvwH1x5P6&_nc_oc=AdqfoJA8RH9vWBbVgCWK_QXcqeHWLQ6WCR_c7EJA1sKg3vkkbND7xKDkv6Z6CdGs0MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHMh4U0K3ruYJBg1hzS0Ri0mzf-_attEGe_riB8GILMw&oe=6AE73EF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
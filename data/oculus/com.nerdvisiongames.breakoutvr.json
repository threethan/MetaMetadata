/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue4Nb-tllXAQ7kNvwHJMhm3&_nc_oc=AdpEb9Kg7S8FpfQpUvRneZOw7u86CnvqRdZpcYKbCsN_EJ1OvNw5OV4wUKj-8AfEx3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhlA4EA3bEOqUwCIuuyuw-CAyI2ASDiKjwZp2pjCBGiA&oe=6A64B91B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5IQEZKfgmMQ7kNvwFTO2Qz&_nc_oc=AdroQIBIGPl_wyolb56dyRBQrIuAYMNl4U5v9SE8n2H2nGpede6KHyuDA59u9VL8Nxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeCa8xaa37-_yz_KS3_EfTPwZVtIuQGiotYr95qVKd8Q&oe=6A649E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxDZPfvO8XEQ7kNvwFXeA2k&_nc_oc=Adrg5zk8Qa2r0aMDAMf5y1fbjEw_C5vxN285J_kxGDhxoppU4UMgbO-mpDuDwAyZjnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPhOwbYEg64_HmXaKFa5qDolnYGm4dnbq7GTMKW_oVRw&oe=6A64BA71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
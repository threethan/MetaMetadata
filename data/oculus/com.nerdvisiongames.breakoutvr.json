/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOO2bar-77QQ7kNvwE3N-6x&_nc_oc=AdrIjDEZnkLR6Gvd2MO4bZPurHmXZMOmwCbI9j0bcMWD8B_m6GRahbGsqge4WkXRvyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFStE8F2hq_zEu1O_2rfoiYjQxySgw1LbWif3b-QPNaPQ&oe=6A70969B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RDL_Lt6F-4Q7kNvwHXjVFR&_nc_oc=AdqoR9x1Kl2fP9hJDnTy7WgDUhPMGGneFxBzpDbTKwGAWEnjol_XToBOHCcQ3IBOC1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8OvtsXOg-Ejrv3QjXHg22tmmya-GJhgqe_WhlSgQy6A&oe=6A707BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aYpAbJLQbwQ7kNvwH3Nmce&_nc_oc=Ado2U2SrIfRpcVWKCRfMzO05JjDjtSyF4l2PO-jaJwKN-zBPi63QKtBPQj7YFDLCNOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJVrf_LhViSJdlXUUdsViUa9twjxa-HvX45-MRmYLjTQ&oe=6A7097F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzFxFnkXyFsQ7kNvwFnFCyO&_nc_oc=AdplwLq1etZE6LlIE13-agQvIh5KEnssADr0cjTqtx-6xlAo7IF_twtknRHGiot0b4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HLAUp4NENvGBH0HXvmva_cYMAAAAD1JufSAokjQENaQ&oe=6A241F9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbWx8sEFCLQQ7kNvwEihkbN&_nc_oc=AdrAiE6sxCaBpSAb9qj0ZvQwbceo0P-JX__X1dVgtzXO7B37jobmIfTxRbEHD1qX8Ck&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cP74opAtuvnu3OkalusqeD--cdJWm_Et5OKxVI3GEzQ&oe=6A243D2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KdXG0vqSRQQ7kNvwHy_pPs&_nc_oc=AdpRp8ewgBcYMgyarvts8Rtjmeo6HbwlKp_DgWHrFahfWnZJBtIYce0ubx6C3nJFr90&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S6Y6qLwX_jOGdbaSoQgoB3ejLK9hMbHSb72OZNVjYrw&oe=6A2420F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRGl_ga9u4MQ7kNvwGZXPyA&_nc_oc=AdrbTtJDO-BDQM37AhaMyR8zzt_wA3m_hNVMzUatI2cA8B0wPI-nlHrDbwKEj-IW_KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzzn543P47c5h1sOqzLP4ubIrC-rJmkovG215bE2YOiA&oe=6AB5249B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SHssobF0jgQ7kNvwFn1hBo&_nc_oc=AdoQXX-C_udN2QdP4oyVekDQjPluSv6AVk7iN0tX6hbqQfZ3aonRjj1Dg-DnIxV4hig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtxlp25qmKE1zQGRNVHEU-qIXSHILmesbTI6xWhOLsKA&oe=6AB5422D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqun1QvKuk0Q7kNvwEhyOyJ&_nc_oc=AdqMay2Woy6DPWZW9XNIIjpKnZeOKwAiw9y7hw_t8Fd_wS51S_BbCTECQC5F-MsSxhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHQIN5lbPHDv9yHNV1NZXtscaXgADtidlywW3p_T0m3A&oe=6AB525F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGdqsa3iWGcQ7kNvwHhs_Di&_nc_oc=Adp4BeItOL44wMUZIXuxyhR_lrE_VlM6yyjbRR63vq-BwH7tptWDaQ0-ZHc6VQd7RaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cPTI1g8hZqH-SydSYPT2-zu18nGBLX_EK79ZmU1q_Uw&oe=69DCEE9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JP3WQyIt6toQ7kNvwFAMq7O&_nc_oc=Adq3H97sqLac-BAOe6e0J8jqSaEx0lYCMcNKnSHGtF3kNFKNJnG9NH--GWwNodbqWeY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b6lXJkFA8f68s-9_ltwXm_s_BBTIwdB7IOdEE_cP5Ng&oe=69DCD3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtPLpxHtjq0Q7kNvwHeNwku&_nc_oc=Adpwhdun-FtWdauB2aIQ7A1Q7G2q_mvrIC_ONuPcn1ofScjsMGmoJ_7iR1o8qnckQc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D46vElUgt4jIN-Pw2EMhaCz6w1zVIauwNBAmd_J9alQ&oe=69DCEFF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcHZNVYwWRQQ7kNvwF7kbJv&_nc_oc=AdrE0x8jKy70gKKlO5kjDGVnklX1e7tSc-FhmLi9kyw7zELEkx22ATdrR8ZUTfCrI20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvvqpBOBfNGlp3E23W4FgPwaREBMhqBhdHwOeLBP-Lpw&oe=6ABD0D9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrjmYtnPUwAQ7kNvwEtPxW1&_nc_oc=AdrmUqJK4VnLjGFW_DoGPJ1h7CcETs9EGrHD7divpUM6IwCLBQHH-MMpU_aouzbYxwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtUFsKfE4rQD7YQOYG5WWuuetxmtrX7mOQvf-ZSc0loQ&oe=6ABD2B2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCd1BhfDEqsQ7kNvwGQUgMq&_nc_oc=AdqaHBCJI82pRQdAUSc-35Oh0JlWeEQUJu5JD15Oze1SsTe1X3D__PiyKC7XKWsUwIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl-dmFpA2ObKhwp7d5DrahAD56z-capBYAWuDz_jvpDg&oe=6ABD0EF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
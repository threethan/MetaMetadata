/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXPkVwIShoMQ7kNvwHx4rFP&_nc_oc=AdooEH-x6OtMCZS83mVR-f9mRFe5OCO9Vo4ojCpxWtHOX2PkiS2IZUfI2ammETaNLpw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67szafB1M5UfaHTC1T0voJbqpZe8qNcfRAmZKPOxxEzw&oe=6A0F079B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ9qpirK5WEQ7kNvwH5-gx_&_nc_oc=AdqzM6ORLEwpjXnflJbzk_y9W0p9dWVfw8C6IDSEp1QMVK3IeWWUkyuov1oX3i-9TbA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucNJPD_BQEbiZjB-E6Pd2PJ71a4A1VeWEKJGCKhFa6g&oe=6A0F252D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLRahlfXboYQ7kNvwHS0Ody&_nc_oc=AdqrXNHbulXJlOgqARQeGH7TdCDBWyry9p2X-EwCGV4WylKNb7Xfp6FfNXknjQrxCfs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5drOAaPB8mvVa8hfe8X1RVQiy2UtiIYmfEvGGQPlppqw&oe=6A0F08F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
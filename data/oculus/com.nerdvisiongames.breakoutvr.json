/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5SX-OGfdN4Q7kNvwHgLY5e&_nc_oc=AdpdBCl3hiKHPORES7Fqy8ED9iAcWMlTApNjtKfVS-a-2nqsPJnmQG3QWjopCptI5w0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M9Fdn9xwSNh_-7l7HFfmOALag8hiPt9Sv46od59I9MQ&oe=6A26C29B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl9jMCf-zEAQ7kNvwGqrADA&_nc_oc=AdqNOqplN8fzd_uJz3CU98C4lXYDns70zV1C1d-Mc1JOIV7skO_5tW3MSzbNSMMGBT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yAGgi1naRZeI2Y0NVOf7YliLmgPKPJcM21-w7_T5WjA&oe=6A26E02D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvTSRzs_likQ7kNvwHgsBAT&_nc_oc=AdqrAod3SrlrNJjBzHGlcDC5R0mbmt3Rq7n5enYWpE0pVeK-i6fco2P8TwNKx_XV9t0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_rnsjpYtIYvnzq7LRgK8up3iQ7Dh3-etoUUQL4A27hQ&oe=6A26C3F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-jM4FfQLWwQ7kNvwHgsfZ9&_nc_oc=AdqdnHee7qrV93ExQXbg-xeN_DmwiUq8AsjimGqaCi4Rcfpbd4kBXcalEXOkZbNv0ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDaOt_QFkcvUhJSSKvn75uX4PLSELyR6ZgB0sKsq7Wlw&oe=6A4FA11B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYz-DNBZKCIQ7kNvwFvFnnA&_nc_oc=AdpbztQT2TKop_x2HLwACvA78DVeT6jrrszO0cwEHs-1dfNzI0wgXOn0SHoc2mdRTaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjt-0w8fSHwefqToOkWtkJvdPlBm2dRxfbc652vlegCQ&oe=6A4FBEAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6p87w7MeI4Q7kNvwEwocMM&_nc_oc=AdofBIZFVRtg0fhhLQmCm4D0rEPxmw1suGIJ-LInCv8RHwhYI5eZVyYVPX0jl88C-CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiNYyKHUoqpGG8wpupfNBbYUgQV6wZw9zdszHcOER5XA&oe=6A4FA271"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
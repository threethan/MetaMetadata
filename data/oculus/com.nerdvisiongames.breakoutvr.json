/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNljKJvl8n4Q7kNvwFymV9W&_nc_oc=AdoTlEcfTmANg9FJzF3rzgG4B1-WDYOXipIAhiwN1vlBXaQA3ltjBzh8rYfvKR3g_uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj5rDcGZ0YurrL7sNz5wpI_ZLs8yxDk2Qf8R4Mb9fs2Q&oe=6A6CA21B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vttplq704gYQ7kNvwHcR8CC&_nc_oc=AdrzpngPklELSCUXzaYxF0gXF8KqKJV8oE8v8D6eWIFn_eRWGjVd33PND76ad5y2-90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQRTFykFz0ku4XojnMUyDFVVJu_oPGMdK5qQ3YoVNHgQ&oe=6A6CBFAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCpDG06MuVIQ7kNvwGLSZLm&_nc_oc=Ado5Zad0RnkdOq418Gn3geQq5zP4oclQqbX9eM2kUkhWaC7yENETyWuPOGbx7TSuZuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKMMJFK7v6D2obsVp3s0H0kqMM9lQD2CvDOWdy1oPyLA&oe=6A6CA371"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
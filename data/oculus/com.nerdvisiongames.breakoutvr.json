/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm_aLc0BQlgQ7kNvwH-zNnS&_nc_oc=Adp2NK4lJ9Pl2lTSZ8ihFuJgiMvMd5YrPK4nVKAM7S5uguJ3_H8cil38nJS7AuHxzfA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztOjT-QhWjHpE-vtCcph_rQXOm7Xcm27TpVFN98D4Jig&oe=69C3E21B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRicAPmL5YYQ7kNvwEq1mLK&_nc_oc=AdojTnSVgzdAdpzZ--4YLxmyQ6B-2uR5dSpZAhcibR9mAKdEx3WJ3JE12dGD_cfjaX0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd6P7FMHF5ipNQTk8O20_X5dgQ_4e2KKQQxOcyEAY-zA&oe=69C3C76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmJzBoel9cIQ7kNvwE1pCm3&_nc_oc=Adq4e2W6UMEy-QZxAzC8sKDVZHIE2DZEM4gzIGhvs0fMH7JsdhIw3rj4H4MVGtr0yds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-nsSZb3z7Tk5mjcJdcxPnOoX21iaipPijXFaeQOewCw&oe=69C3E371"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGliBCgNgj4Q7kNvwEydBzZ&_nc_oc=AdpN6vOa0qermoRQbFXzAJ0_Ve2Mmd2ORn8UuY7BoWu8CHtgaEcxf_BiT4DF2xs-o5A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgID3bcGmepX8irHMqsFLgQ3cVxfjeMxVFD1L6uq28kg&oe=6AC7999B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ta6Npa_5aAQ7kNvwH12eB_&_nc_oc=Adojz1YCmrAg2SkCDHD1y7V2G5agQu4hfNuWwnDhxgfR3FASKkJ9WtCI11PfiW7_Kuc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjMFuA-MN8DZ4ieLeA70iDtPzfKP5k2v0o2MOVMlkh7g&oe=6AC7B72D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI5-XJFu8LAQ7kNvwGbaf8-&_nc_oc=AdpRFnJf1lT6XKB9vz6gDaMwyv0N4SLThd_fpUonBHrREGhE6di7TCUi9LQssFfHejE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiKFDOqu7pIKH7w_wyAc0AggiHGa6AZ-Qy77Vch47OTw&oe=6AC79AF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9tRP5K-4l4Q7kNvwHIeYWz&_nc_oc=Ado8zsNNjUtKKIlAPpxUSoxiWE39Hebg_3bcxt20Npn4ShY60tVxNlGyhWOfzKVzJ9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6crZ5cl83aAEI2ieb8P0A_YtsdlIwl3pPIvrDh0-ShRA&oe=6A159F1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTHQkS98CucQ7kNvwGiecfh&_nc_oc=AdobdTRqNy35pWqaX4lMf_qM7KRDFGzda8bnsdiHJyJdW7wOud0_0s6rrrzxBv4Gk20&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vFxchsZN0zpzuBCsBkDuk5TIdb3PKaIl7ZmtOvX7uXQ&oe=6A15BCAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aL-UQuR8EsQ7kNvwEtP2aD&_nc_oc=AdqVNTC90pBnw0qLOqSaqu-AK7gkc5M76OT6tSn3zCV_gyAOA_50AVBpdcPGMdOmmQQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wmIZlZdWayyEO5_cqQo9XphgKeKKlIGbZ1_Y9Se6SwQ&oe=6A15A071"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
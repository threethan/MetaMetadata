/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvWtIBPKjpEQ7kNvwH_zBIw&_nc_oc=AdpjoRjXYqrjLgfwNsGgDQ0V9Ip_CI9xGRnXFZt-m_ACfNdTzkS35tUuXKCnGDgmmVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ixl1uemgZpqbfxzLPmbvVop2QGOMLWiZGwzL3afpSMw&oe=6A47B81B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M33uFh4ENz4Q7kNvwEZ4AUI&_nc_oc=AdqxOmxKMLAjHuAKepmiE4YpCbAAb1uEl4-zLhNcUmZtmPCuBqn3ifPotXlxUatpUks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86ay98OhlvUZAqNVTzbH33ImHTs4qbMPBbO6FK8wk_yg&oe=6A47D5AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8MHhDDTvzwQ7kNvwHlgMfp&_nc_oc=AdofthHcRpnuz6HATUx-Inon0luBOx0v0R2np1PJniDPDfWBieTbmVvqi3IHbWHcXR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9joyL5746GM1WDeObt_VW55D70AmwycHQsHkIG2WFIKA&oe=6A47B971"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
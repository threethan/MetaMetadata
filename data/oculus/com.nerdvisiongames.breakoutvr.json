/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEziMr9FuRYQ7kNvwFxtWsa&_nc_oc=Adrb9uAz1ROoQs-1ff31MX2mD6dBLA-UF_V6q_6WA_WSaZ54IHg2jwzSI-IJD3DqMmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kzK_6CC5jSkVFDKVrzmOZ_8i6nzoMBZNRk8bDsWF6Ew&oe=69FC929B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCPgoFrOaWoQ7kNvwEwFEQr&_nc_oc=Adrv9YWC637U4q5cIJ97PqdqsrR5JhCz5BsdVnr8l29BgOtEwatkgeD4-8ufMduFrVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o8_yo_o9mI-VxVP_A1Z97OiNhqxSu0soyQL_q5gl-RQ&oe=69FCB02D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbIcQNosJDQQ7kNvwGVeAoD&_nc_oc=AdqghWtsfANaev2HpeXxfYRUtEiBWcshwXY8XN3zOfI-MTb8b1QFkXPaGwMtFnz5IjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qnf2sPsDRfkiC28Jzg_8n-09uz2YJnE3wKcwbG3VHCw&oe=69FC93F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
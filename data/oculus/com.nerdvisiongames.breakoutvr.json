/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVuE1ImB3xIQ7kNvwFo7Ha_&_nc_oc=AdoafNBAvssrmOa5qxl4KuMJwUUGxYLZiZc2Di6oYEXsfosjmwnlwCdw3svDZhIWyMA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0drfNk6l-3fjbbHdfLYiH0NxBgANq4Qk3wcdKWHkAmhw&oe=69E77A9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZADag0FMKAQ7kNvwEQ_azo&_nc_oc=Adr5I7LV6j_1y4BsmwRnCgy8SpIyihVrvCx-mULpzud42ZFHiaigUsi7l_vAVNtxl1c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vYqOc0iME489E63dqiOhQ5MdVpudzuthat8c87wApzA&oe=69E75FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx5XNbLkzcUQ7kNvwGjWeJZ&_nc_oc=Adok_pFxzGUyliVAC-vNqXRDUXPepk_lPPKifcvJal6NTsj9AzhOAL6luUG6S6c0Ers&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18o0JKDJIZwPH6jctk8Xr3dkEzKLtJ72kYbSjylYNK5Q&oe=69E77BF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
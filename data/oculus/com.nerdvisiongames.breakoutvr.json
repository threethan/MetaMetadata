/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbPvIeL538UQ7kNvwFwxeVr&_nc_oc=Adqhm2HmiagC0uWcDwXCztzpaLSt1t6FttM3ZiPoRvumhNPv6RYHl2UKbdPB-RqafWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kejqbDu7YvQkMuRPHniXP7r1R6FG1z8B8ZTmvEo7V_A&oe=69D3B41B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahto3MMg1UUQ7kNvwG1zGuP&_nc_oc=AdphkzNKHNRp7NBiih_-LY3LRqAyLTl-GissvPV8-DE7NPP_nECY18x0JP6lbkBJLCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HfbBaYB7gSRIBS358mU-5-Af8wnjhbEvifa2wF4xGwA&oe=69D3996D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxX0a-qDAsMQ7kNvwG0Iy38&_nc_oc=Adq4J9t5nn6D9Cwq06oNdDiuwVER6Bh3JbwcnbdeYjo4_k9Lw40d6leCl19Zhmn3zzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iBNd0aqL9jbjdfSTdjdOUF3PA0Vm6yxGc56geqyFzdQ&oe=69D3B571"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
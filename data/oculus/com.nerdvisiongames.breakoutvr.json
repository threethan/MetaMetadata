/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGliBCgNgj4Q7kNvwEDbfT0&_nc_oc=Adp8_4aCzftmqqzfszy2xrY9TogGxqXQAbRn7olFl_1jaVsQ8h4DMs3x4iUWf7q3EIs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlbAmuvf-rXiUxG8UWMtIR-5o6Ube2LJmZM8VqIMyWOg&oe=6AC4F69B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iI4STm8HJIQ7kNvwHFagXW&_nc_oc=AdpRPno0FjgNwBVwCjDjmudUa_rLg6tOzC1iUyMYdbz7RWB3-zm3Tku7wZ6qCETLAN8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnqyS4Y-wEv5DiJo1fZ3npjVv2uCiEgrqFgV5kzxmYkg&oe=6AC5142D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI5-XJFu8LAQ7kNvwE9QJFD&_nc_oc=Adrv1uo-5CenvL--8wqLmwNde0I0gc41cCS9auS7zPjHKSo9uwZzugsC7DtA-by3iXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73qvBOhWaTtFuXWiH1dFt9t_S4B9UirOtCrRuBfbGVA&oe=6AC4F7F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI1Wu0heQB4Q7kNvwEontLi&_nc_oc=Adq6NjDdz0kwB2SRSrQOt4RPNELBnI1F4fLSXVrYry1rGOdKcKPA-Ey9L_Fq3UOj8ts&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VX_4PRfLDrZkVu4jGjtmoElxKJU4tDCKCbqN86k5yBQ&oe=6A33F19B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8_UHIW9KgcQ7kNvwHlQgcy&_nc_oc=AdoKaodDzf1GPAtNcWAkzbdhTdoudlBI1Glwt9UggTo96KAb3GsrN3gO2DYea_2Uha0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LikE8Q2XeEw-W8dyGPuwrBAyxovrn7RhE0th-ys6lQw&oe=6A340F2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6IDguNaRAQ7kNvwF201MN&_nc_oc=AdoQ7mXGmMHq-88VbScQY_6jjjuRW6XGaWHpCkeejv5rdXSFMIDFLopnDi16IV1YR_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B4FvkRL9I5zP6qIJ_csFPENKzRcelrDB3tNIuvVUhnA&oe=6A33F2F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
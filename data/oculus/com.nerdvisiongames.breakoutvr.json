/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58pScfFnL6YQ7kNvwGKVNZr&_nc_oc=AdrpGEhAxeO5WYBvBaDoM3LC1eIau04QxoqiKGP5T58Pceft0Xs2925bgo2_xbflqW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7noYTlz4MtABBFN2APwKYB5jNWu68aKkv7sLgNBuo6JQ&oe=6A202B1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZFOwV4ncx0Q7kNvwFRWvYn&_nc_oc=Adp9dNLDXAGvWLmuFFRaqG7MwBmVe0Ym_zeH-GUzJXjqaumboI8R1qBCyrv_CWvMirg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sjhil67iTSkQYnYgOd3-XQsBcZ5y1ROOpSgx82avmEw&oe=6A2048AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrLDbeVRtKMQ7kNvwEYh_-d&_nc_oc=AdoJ2crTdxfWUIxTlCfGI5wSQm93iQrgVtBuxsu3WIdebAT40lyn8LQhmB-xglJHE5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-N17Z61RrreDSNAPAnosQKW6DmV65CnZuStdRxI8D1g&oe=6A202C71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
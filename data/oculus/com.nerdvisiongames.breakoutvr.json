/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qFI92u9JuIQ7kNvwGfWdpO&_nc_oc=AdqhAujs4HIZNnCmHPFq5Rn_yNGk2iE24X2N-Y6-Po4_dZu_yTGQlRpf9RtxavOo5TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx3PHTWd_cDemByqsVjEV5ITiXxhJ3mkb1Ib9Rny1I7w&oe=6AABEA1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVnXUwsCVsEQ7kNvwGgyHKW&_nc_oc=Adp12AIY3dgbyvW05kAhhTUOTbdg9yUJV8WlQQj_DDcEwcRCxVvz-oFRAn2lfdvNnMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZMugLO67qw4d7jlZIshQS94rbALUqC5r5f4iniYNEuQ&oe=6AAC07AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sK323jZf20Q7kNvwFFUCCl&_nc_oc=AdrF-F18yviBqKRymAHHjFpfeDvBcRPfjD-0y94ZYsGM87zcloB1o9iL8rjGVVyHHgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXYCX8DpJGA_NR1n341hpZq5WoT8Duv9_qMM-SVFqCJw&oe=6AABEB71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
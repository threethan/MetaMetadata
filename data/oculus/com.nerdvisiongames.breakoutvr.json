/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYfl9G2c4goQ7kNvwEZYSy_&_nc_oc=AdpGCMCv2HaqMIyEMOEcwtqXVVR41_i4SApV1Ve9eifaTuf9Dul4J-tzFOqgeQj6ILs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgupXJpQ13EEK-DY3oQswDrymySuqNQovKDquhr-5dvQ&oe=6A68AD9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72jhEdgs-7UQ7kNvwEwC7Fd&_nc_oc=AdqRMV9F18BR0J4d7Bvj69bl678VKwhirgXnrth9u0PHre2NMI-0FXtiZT7RzDJG4eU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj957mBthfWdZ-ss5AfnZEYbiRc7RI9HuXlfS3RxPzPg&oe=6A6892ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsjUPjarpTAQ7kNvwFOr9pW&_nc_oc=AdpDhwdBtxSDN99_V_ILylo_7on4S3E9GmrIQHxWwKqEbeCCZqt9TMM1L2o3YSiuJsI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6RFBIG4Z40jXJGeJdqBXLc49a71Jo-0N5ye2YzDECOA&oe=6A68AEF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
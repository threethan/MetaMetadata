/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9tRP5K-4l4Q7kNvwFQoMZH&_nc_oc=AdoMQ_OfyVahwjfwwWsGmbpTi4XDPasDuLRypPx58Tf6tr6_M45vwkT_XKSXBeuW6EM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ct9uX10DGYOzZBF2ZZ2hz-NRPcQVh7g0Zc1RTlVnAZQ&oe=6A12FC1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ulKHq8O6WYQ7kNvwEKVB4k&_nc_oc=Ado7R6V2ctEBPZmbUafgm7bROO-VkeSLoVHVcsQWEIpNDBPwC6VfAKyIvnR_9jF01fM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oAM2Nrb4SSYf5IEvh9r1xvgtzbztg8_-Q6qvcGx-xSg&oe=6A1319AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aL-UQuR8EsQ7kNvwH1TByh&_nc_oc=AdoK9ub_OoUUceHKENN8Eba--2ze9mAJduAUlGt4YCVCpxmciMZhoEqwlBNKkSyvtTU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58OlSFWOhv-co9GOpZ7c23VPABvVY4jPaHobUQL828xw&oe=6A12FD71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
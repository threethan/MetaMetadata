/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIwnm0ToBpYQ7kNvwHzpoDe&_nc_oc=AdqS0SNblHL4IWI1voyqNhlIuAJ-IiFPWpgEDHZ8EnztkJpue6BV3BISXuC_XBHLsXg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYsEnp9K19qVPtG4z0QXGRoqvk-4jWG44h31pdEnUMhw&oe=6AE3491B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCEp7WDi-g4Q7kNvwE93RCP&_nc_oc=AdpEQ_bjPo7AgBoroxWyMCofvKNDAAdjmPfN64qFORtCgDblYeBlrgyKvL_yxNRRKsg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGy0_ar2wWqmVpKP3VUrNt4hkg9GCwombIp9jYP1975w&oe=6AE366AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0uexgTV2k0Q7kNvwECHyB-&_nc_oc=Adrg7782xqMUD6F7s4XDytRCqYxw1ktEyNeKO2pv0TtwZfEHt8uJUuLXD4NMZ37vmGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_taPR-TYWZeLUE9nN_G0G2wCXnk-MFbas1FLy89WwWw&oe=6AE34A71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
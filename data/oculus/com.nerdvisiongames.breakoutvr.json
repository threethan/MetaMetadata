/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w7tPJcjvGQQ7kNvwH2n9BC&_nc_oc=AdoY9j8RVxQ9SCvNhgyFIJAQZVEc-dP_gik5He8Yuc2QyJqwf3ZtDxPeaHW8WJg3dJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ixEFJ3KAjeIK26csK1Ehm6vwA_ghe58STGfB3cgHAeg&oe=6A42721B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cU8r4HfjuEQ7kNvwHm0-zt&_nc_oc=AdprqHX3dHLmDD5-WEufmISeT9CXMwrdP0xB0VphRmUuw_yGd9LEb-5aJVXRpvEygdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C9UfI-0gzCJSY8ohNWCr8znhK3ivgKxY5FcVNnQWolw&oe=6A428FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Kbn4HISIVQQ7kNvwGrs2ya&_nc_oc=AdrEb4jB-THmLrrpEGABDQ3AL15zVeyDvGyZQwO761NhDqsMKTBd8b81OIIeA77VLp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_muWEQkqvp3SxFh19hp6eFz9PUCvClioDEztUwEBz3Jw&oe=6A427371"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
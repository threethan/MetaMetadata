/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehtTlBfWYZoQ7kNvwHSGs5_&_nc_oc=AdoPYOo4q_bx0oJlQcH26H2s72ZzCTSzxR4e-J3pq2tbvaKEiEF-4eELnWAQFKZi_uQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F4c7-hKc8j8v8MWKokSBC-Hm9B3WEwUg454-pAAggoQ&oe=6A047B9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej0bveLurDcQ7kNvwGcdD3Q&_nc_oc=AdoraExxpCnLjkponeo0IyPt8ALptmugQjztfrUxGdYSh2LuCKRgPUMqat17c2Z3z3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LrotohcVsUPBft3qxqznt-sGo-ChZkCZ6lNKFahfGsg&oe=6A04992D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhDhhXOWPsgQ7kNvwH7f7Db&_nc_oc=AdrSkWYKeZgNShszEA-J8J9XD8S19JM2MI-X1jdUy3CMcAvdeqafMF_tJk9vmbywKN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iGs9GWikNgFkmnXFcXovKm7DSKlUl3zik72HzGcna2A&oe=6A047CF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
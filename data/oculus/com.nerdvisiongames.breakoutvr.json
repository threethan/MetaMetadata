/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw0TqUkKuHAQ7kNvwE6bqhn&_nc_oc=Adqta3OHonLAoc4co8phE6xATOLXJSBiWdwrd8rs3NUnHNPbm4vW2UXoXAALywCRDL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tK5M4cC0xuLTMQNxS943Mz6fP6ujfp3UuOliTuluV7g&oe=6A0DB61B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ9qpirK5WEQ7kNvwFoHSmH&_nc_oc=Adrs-OhlZz_cJ_Q6CPRauCUdSADcGWNDV0SYDOiB3jkqniWELmgIB3heAwCfzIjZvhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PlMgzFOexlKndgONeqsFKrbk3LBY4x2i6W__VhGQ_zQ&oe=6A0DD3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GFD7RV78nMQ7kNvwGJc0t1&_nc_oc=AdpPUQ_Ze0FVVmp-sQLOqhk4bAVfEKfCsKIs5VK5xcbAKIf1btHr_rJT0ICwGThw5k0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D9o4GPqvXGokEs7DjPA6FDqOgrqOpHSFwSZztxi2y3A&oe=6A0DB771"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
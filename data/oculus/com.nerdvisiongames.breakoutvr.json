/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w7tPJcjvGQQ7kNvwH9jYwK&_nc_oc=AdpXhb7LjvOgXPEhTu8DOqcXlSSLgik7lgazWddzm9SsIhD06HITsY85z3uwyq26pw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fr74kJGOWqFX0FCODNNnCq7PoSH9m8vPdfY5P77Fe8Q&oe=6A43C39B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cU8r4HfjuEQ7kNvwHbwopj&_nc_oc=AdrepZMKIiJmvVWAYdblVU7i_HF6aVJXpPmt7ISH6eBOftBar9lZ-rBcgxb5NvagyDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jdbbiv4TwD6uhEZ2TdH8HkufBrxHaxV2W_nerZxqzDQ&oe=6A43E12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Kbn4HISIVQQ7kNvwF-B52_&_nc_oc=Adr9pX9oo8g8lylSZ4_ni4KtW_Crz9bJxI_kfS3d4ymYCjAvxefy0f5YK4ZdWjKIyMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_73DMGavplBe3fjX2GZHD3CnnZvI9iNV43ZrtaTrr71w&oe=6A43C4F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
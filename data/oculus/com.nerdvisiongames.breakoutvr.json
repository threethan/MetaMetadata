/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G60eYyxZrqoQ7kNvwFl7BmN&_nc_oc=Adr2Cgx-uOCc8BXgm30qtQTUos6AsghCQdBNIrUgvZB6WSIuX_bloFt0AGqsn2nQvak&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZtyjhaiCsBNi4HRJU3GP9Hk4O0onD14PDFhvA8z_eQQ&oe=6A81BA1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFRNRAWNa8AQ7kNvwGrxunh&_nc_oc=Adr10EYuxX5eqyiWwbDwzrHom7jERU340jA3KvFWfU7VzT6VXagcgh19cU3Yw9jvaQk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1gz5gYrIX-KQr9KK9RaMRCANEYCgRp0dgo734J_bo3g&oe=6A819F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z05_NDtUZgQ7kNvwENbcxI&_nc_oc=AdppbLVnbB5CAdcgcfjZZ8lj1x4cn-N7FJ6I0hBUCelNtwLWood6eKRcsib_6RpCir8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFvCt80BCnGav5uRIxtUSIqW8mLd6y6Evt7lT2fLhAgA&oe=6A81BB71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
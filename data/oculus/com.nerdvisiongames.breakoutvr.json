/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vod7RfvZQMwQ7kNvwFwviN3&_nc_oc=Adp-9sGFYQf78N_Se2r-BbucWZdwW__XpDez96xfqvIkXjQSb9wBEGk67KLkFDxxKxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rwfkcDxCAuZeB-t9X63T99rRWbylJXlnZEReGDUi6EA&oe=69F89E1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_-2zxqfQ_MQ7kNvwF1IwFP&_nc_oc=AdrZBEx23LdhuaFnuC1BENqot-u3YLAfGDwuJP0gR2ZV5A0D6lR_z4T_58ku5Lqfa0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17A5bBLxOUKsZpt52g_zNtZOJ3MzE7SQCIqY-FDf_Zdw&oe=69F8BBAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LptVyvTlDg8Q7kNvwHMX0kS&_nc_oc=Adp-aildeA4hmGZ4stL55SAw-8_uthYVdrAuL7VUTaW1E0ZoWLhmqayW5ztjALRgqmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28QJ1AIqrI7CzrPF0Rw0NMtEnP22yu8A-_XYwo6AZdEA&oe=69F89F71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
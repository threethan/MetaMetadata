/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcHZNVYwWRQQ7kNvwHrCzOE&_nc_oc=Adr1JRsHoaU8LXmikdeVbTucReyqP4wgM-HsTyFNegIXjxR2vSXaoRGETXl2_6_QD1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKelOQdio7qScCgvKvuxcC71U1RlaN6fyAuf3APgQ0vMw&oe=6ABE5F1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrjmYtnPUwAQ7kNvwGupdeA&_nc_oc=AdqWOp5MExWFArOaDlk5SwxYyjKwoh2fIp028w819KIIEH3SnBHCN-3_UTqHkcPc9wE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRq7I92N7ywMvI4Jh94ZUvFdxAsO7R2K2QUaREMw9www&oe=6ABE7CAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCd1BhfDEqsQ7kNvwFa021G&_nc_oc=AdoeAmN5dnfAEDBjqSYWntTrO-d0I5ydEePsCcuG6HjwsZiO1NqJ7Yq2LjgIaIDHu-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMViu-eD1hiVBli86UmTFqXcPvSJkg8D6KOQKPt8AX2g&oe=6ABE6071"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
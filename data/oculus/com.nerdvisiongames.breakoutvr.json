/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q23S_anHBYQ7kNvwFywcZd&_nc_oc=AdqZD-xSZSnoeqtwLneKTLLQf7USEjt2wK57d_Hc4h2xLxnW6vL7SW6Fdou62BfAO2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_TTEHAJCOI0UY-yN7-i5QjyhUUfEv5Vvzli8K9kbnCQ&oe=6AF201DB"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qb7Zs6hTQYQ7kNvwFaIJvR&_nc_oc=AdpMLb8L3MZHdo3nQ4usnfhoGWz4dtIfMuYgIiALBwSP7n-UfiN2pUmaYNnf1Cuu-ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpbMwUYeg1XkC0WHYWCK_GWJX1JmkSuYhBK5jAFoYHuA&oe=6AF1E72D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdZVZWE_ATcQ7kNvwEHOlhI&_nc_oc=Ado31xQMaDlTBsl02-dECdqElAdTriRsmLP1JzPrrgm1fkN2UzOqrVPdCVTtwVVzL3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlgkk0-U7Mu2y3wGlhhgIqgtq3-5K2v6SCcPDPLjKEUA&oe=6AF20331"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
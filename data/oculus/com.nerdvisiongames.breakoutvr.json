/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ_FAmlIS8cQ7kNvwF88sNf&_nc_oc=AdrwfWPiM_rmOEXz15WsuNMpRkb0mVoew9Z446sLAAzlWel2fjQ9S0BdWlIbuMNV4zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Lo31EfyMdTMvvncYEctpfr-YvhBMV6YDWo73ZhgEzQ&oe=69FF359B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGiHuvsAIFUQ7kNvwH_Q6D9&_nc_oc=Adrax9TM8bFyPsJ4hf_hJG1DY5x-mPpNnOAMj9OmCXBbSgQCM5QVnaj1D588HG3U8DM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VGG69yXo4oV8exu2bE-8l7Q_0kIUvURuSkJbNX1Jiyg&oe=69FF532D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AeoKcmWGC4Q7kNvwFD3j-g&_nc_oc=AdpJQox9tSlAZZLaM2TNFhi3j-9WxdgyWQTMcqZHtfqpr15PU4DwNjcpvpCcuEctHqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51ZtWLpMNaLMFMEjIzuxF2bBYoF9Ae2P8pmZrCWyHJoQ&oe=69FF36F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ_UyFbyV2QQ7kNvwF_OlWX&_nc_oc=AdqhrkBjSBqFszKKverqACgHGtxv_XosdoCon2eYdIZwA7GPm2OnXe9gYrzcUzrgt0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpsPUEl7HidNn7OYdrpEp4CT9HZzu0sXzI1eOwABk1vA&oe=6A985BDB"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgGss3ZIsWEQ7kNvwHqA6LD&_nc_oc=AdoslKRlGVi6aPbsT4tvw2DTY8ButPQCDcnfRkSSZuv0IVLBm4IDB7Bg4_XsBlF6Yv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMjnLeNwR-Eqyu7sS8yibESRLMzG_PfvCrHuDTWCI3tg&oe=6A98412D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQZCdrDUal0Q7kNvwFBde2z&_nc_oc=AdoMGyOVoq9DcVJmvJCUXIYX23hAPnpzA5bj1fHrBoNIrKI7aqn_WEcJKgQS-LEucZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5vEx6WbFz7P_KpT8wFPkzWb4-QXjVEtn8D35nGt9OmQ&oe=6A985D31"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
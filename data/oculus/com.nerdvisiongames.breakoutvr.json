le_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyTbdvFHksIQ7kNvwEYHWFd&_nc_oc=AdmPaNXWG8xKLfbMBGut304bNPloHP5HIQEpn9DRuHuZHY1BnJP0qaYt7j1EA6ZCiEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv8SbhvVVewe-sKeup9NWw9UXDF5Fyl3N2HpLxb-Vi5Jw&oe=699845ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJR2irKyoQwQ7kNvwH-n4JL&_nc_oc=Admx9mjT07SntfjCeHP-wUHZwEhwuFNibRyWYmCuqWgjUeL9bTqtRTiASC0ZW6y2EW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvLlDJWnKDoTmUKtlB2Ow7VIezlmnbbJYpbd42k7Eytsg&oe=699861F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nerdvision.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nerdvision Games", "support_website_url": null, "website_url": "https://www.nerdvision.net/breakout-vr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_catego
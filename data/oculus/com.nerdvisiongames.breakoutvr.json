/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg6A_eDzhKUQ7kNvwEXxAF_&_nc_oc=AdrkDTfNwF_OF2x_2N1fc71uKVUzagcKZq2KDQeHMugD7Zu1Xzx6F5R0Hv4EtvUiI0E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAbck7veVIsCwby1CvNHzY80cASAXlMzoRV5ZWEbUWcg&oe=6AC8EB1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ta6Npa_5aAQ7kNvwENm0Uw&_nc_oc=AdpiptlkaNkmyZi4TTlJm9yiCfCKPAk6eSl-iFNS_F661qncSmr1po4hqIaN07h_6t4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4VBwkt8T-yaYhr7E5P-RgD_CAXSiffU_khLqYRg1g1w&oe=6AC908AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d94Mzv8mEXgQ7kNvwGIBNXW&_nc_oc=AdrxgCUFjuBxjh-d_lflTRYrxHqTVLiMlIO3j2v9P4k3PczvoGEVG3SaTyWz3dK1D88&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Ucy9XFRvn8b5lgKv0Ihdmpsa-Bog835jKte75n09xQ&oe=6AC8EC71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
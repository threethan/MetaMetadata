/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEziMr9FuRYQ7kNvwEvyYr9&_nc_oc=AdrAScdRb4RMQBNLuORcxJUiPp2sPj_1oz7QdlJXDZbiqM8U_SNnv7JWy9rxd-dBq5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rWvEMYsQKsbpvFcK4zaFMwUrED8rSLsoy0WpOQzFJ4w&oe=69FB411B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCPgoFrOaWoQ7kNvwGIemKq&_nc_oc=AdoKiqc150amXvo36vlE2-Qg3B5YLEqeMj8MuANLNUqREoBfded-AmzxEJltsWZxRP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vRZ9U3spjvJm48sCJLQM2kCXEKJXoX3ohsqQe7gjW1g&oe=69FB5EAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbIcQNosJDQQ7kNvwE1lJCo&_nc_oc=AdqUSpcOPKezi_m7SkR22ROwtfED7ueKPHFa1vaJSeqS4qTqEmvNtpF9gtVSgG0R_1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bZJH48eVG5zD6wsEhZFG2rbCwZ56iLeDy7E4594qnoA&oe=69FB4271"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxXzk3YAW4YQ7kNvwHcvsgg&_nc_oc=AdqZK8uId7VhNtJKzRYfkzWVxnqWwgN2ojveG_2c3Bw-wO57YZVYwMY9P7kEqU0RtZ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSdvJBM212TcgA4gJjj7fAgRQSyvsuhB-QI2FdnZCwsA&oe=6A8AF49B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6j3TONaqw0Q7kNvwEyW6oD&_nc_oc=Ado9GuUIuefNqYRrWRdszbtUVm-TSZL4EVT-MSnpwMQEbU8MxAisd0KYK83LlvxrF2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsBiqnE4w26ynv17-4gySniXpUR8qLl3j7jjISXn5phg&oe=6A8AD9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNqJlDEEb28Q7kNvwFUICry&_nc_oc=Ado5x_fP-TMhEp06H4D8713Z_1t6AVoq6qviR0WgCGaXoTxwQmxei1Aat6GDlafyOWw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9rLseUSUNOtQhYa-xz12BKN1md6g8T-ecy9VCQ92szg&oe=6A8ABDB1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
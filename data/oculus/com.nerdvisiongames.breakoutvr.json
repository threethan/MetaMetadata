/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XffZrWrDL0Q7kNvwGfOOJr&_nc_oc=AdqW4b-Q6gXAh3LOg8ewlbLtHT8gfg6U31_PzADJ4WkMTkuLERC_qAi64Zi_6tc6n3E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7HK32IFv1PcxaZtFZP3keG9oaqvJ_qBK15ycBtcBE6g&oe=6A9AC69B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgGss3ZIsWEQ7kNvwFJzx91&_nc_oc=AdrJNfRVFS2oqqfohMg9CmLWHJcj2bk-BjzCH70K7dSuAI2nObmNnYc3j1nWPN93K9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdF9_k5QmL-nNQcKU7WLnuAa8ayM_kNKd3ZBCKAipY9w&oe=6A9AE42D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlYicud8e4UQ7kNvwHn_xw6&_nc_oc=AdqGgzrbK5IbczgMu2yeeDB_PS_ecVnUpNkhvpgh3ZNa12TSxvZmyxlWHnzueEPuJS4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr_4_XXmoXO9e_u0INz2abXOnla00InYluGIoxgWjZmg&oe=6A9AC7F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
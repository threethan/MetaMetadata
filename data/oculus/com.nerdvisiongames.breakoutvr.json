/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySXn4i5ECpkQ7kNvwGHNtEI&_nc_oc=AdoTwbmioEKwG4U1quOpee7GIe3_UxQYR0aq7h1b1EGqEBOqBvG7OHgDBHKzkRvVeAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzO0ejJtjYde6UVl8IfCGibi8Bh_3M5cWOE_BQfIT0cg&oe=6AC1021B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8kNUNGqzqcQ7kNvwGkvYe3&_nc_oc=AdpJy3AgxaVdMzbzTYevLN7ylV7AQpaOnioVobo93KXYGI5D7_bvIKuohWJWQAS4j38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Az50g5xnhBuNrSFzXhcxV0pgPrIze69zoKZsPnnSpw&oe=6AC11FAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aJmav0voSEQ7kNvwGZ5eEy&_nc_oc=Adp7-Zt15WuU6fPnwdYfcoISQ0vY7UwBL7Kki6yCUhnefRBil3ErON-3N71KPSrKC5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-ih9FFxbcjUG3o-maWB3Eas0RHXAQq75MsEEnu08t3A&oe=6AC10371"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
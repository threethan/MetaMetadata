/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq-9JRwCdHsQ7kNvwEHqv3T&_nc_oc=AdqjMMkh9FLKTORLrLxg0b1Yez_xFnUFpTBJOvgFHs2t-k9TnD0M65bgK3HYgQ2t8zU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oYo-qgq9zTICfwwp2CEOXNWApYgwnjmTdA-S2Ot96oQ&oe=69F3581B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWcwRpIlvQIQ7kNvwGUlGpE&_nc_oc=AdpQipQF8bpBfGJC7RIVR2nY0VZV7LmaQYcQiCaCwBbmf_HXgg2-dbNg27XiO9mSJE4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36BgQ4gVu-fR6RaKwG8sYIG2hWOc09BQBn5u19Bulxsw&oe=69F375AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LloWbwWZJvAQ7kNvwF7q3KZ&_nc_oc=AdozhBFJYoVQC-6Msg18lkO3AMpEqGTZ6g6G0QgpCPclpYR5VrpW4a6JnGM0eEJyWzc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LU91uU0-6RdAu_ihQcLOeK2BNHH9IULX327fK_SzHEw&oe=69F35971"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
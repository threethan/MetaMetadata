/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYDOulIr24gQ7kNvwFBZn_C&_nc_oc=AdrjYUq3JCj9r4-HHJ4qkwCKfo50mF3MS6wRQlQ64O3oz_PJyWRJOsyMV7mAPL9nGuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64sBI3mORd0dKgqVxudrnFEu8tRq_ENZv5LmkZbCl1EA&oe=6A071E9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwTWfXZQ3xsQ7kNvwFv2tA-&_nc_oc=AdpoyCEAn2DxWPKGH5WVncJbiSTABgT6UKsPvHaKnrV3XAPEQkkzXv8PPeFSzrqQTRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VSt8F8nTZe296-MugmdGChEkqYdkbGm_n82CiTJD_5g&oe=6A073C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic3pENZ6NsUQ7kNvwEi_ITh&_nc_oc=AdrJKLs83TvPUC1eZTGvPXhU9opaqbCQxl3sQBxijZYIS3zfJ3hgbzDh5a_zU1Xri64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ogb24DPVRHT6Mx4md3gW51JOVVh2cx8RGQlkBKtUXQ&oe=6A071FF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
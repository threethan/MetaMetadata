/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XffZrWrDL0Q7kNvwHcx8Nz&_nc_oc=AdqTQV3Eu0UCEmY5cUkN7JeOtnYyrWAyXLTItzqutDbgN2ghz46XFdYh5vzVA_sWI54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ21FjnTBfOxzekJ5LuH_DyyGJUQve8Zn4ommffp-c6yw&oe=6A99751B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgGss3ZIsWEQ7kNvwG9lpNg&_nc_oc=Adom90-nB4RVYh7LC2IA5JqyqtsxqbYAVOBqClm_q01prNeDnQGY6HpxVWjKLAYqdBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFs-L6EZ5GyiXv8yc9Vo980jDoAi924x7NNFFQnfiTgA&oe=6A9992AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlYicud8e4UQ7kNvwFN0aPB&_nc_oc=AdqS8DO6OzcWShger5gUjsCFx0i2Fg3LecjTsr89JC337RAmurtmE_npXCqpyrKq_1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCMEmVuecAnWCljwovHe0WBtD1IzjXLkdgOo-DVVi9tQ&oe=6A997671"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm_aLc0BQlgQ7kNvwFIYuAs&_nc_oc=AdoSs9qLxkkaH3aaP_qCXepvY8huiB7C7PEfIwelA9mayKGjZCq-YscppzENAjPo2WA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHima_ICZOBzo_5Ndt1NKE-7Kin0ZHNCELh8HnZZjWGA&oe=69C6851B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5fZJvplxSMQ7kNvwE_o7QU&_nc_oc=AdrFmFGm8lvIfXAPDdBkACe8SkjREIlCDixMqiyzM4WEHdKpR-Se0V2e30bThdAvO4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxItn4ZGYKYedOfkiAHbNmGJ9KjeKMtioAIzX_nkh128w&oe=69C66A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmJzBoel9cIQ7kNvwGZiJGg&_nc_oc=AdoqpolwJ78ATwvQhdL87SH0Za6k0aC8ke4YKkykksBm3u37D0KF3dPq7-45rENAkDA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjlyHreL1RioQSOOsBqqm_oZdT-RS4nkv3zb1x7s3x3A&oe=69C68671"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
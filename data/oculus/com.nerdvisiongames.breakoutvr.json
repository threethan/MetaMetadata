/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ9F1ui5204Q7kNvwGA1dpO&_nc_oc=Adrvp-BjdFtUWKzph5Wmy9J-YdHDcIe4WGVis75fY7H_e4U6VQGZWp3yHUH5wec5O00&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU8XwRWfaIxMWnyD0sztaAvmM9quHmx9QuCO_KCZBFHg&oe=6AE88F1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtuBLY9SZpQQ7kNvwHxURDU&_nc_oc=Ador-0FMgiQhhf8drlrD3aldxKvKoO2VHAbNswf6AkjS75eJmpKmTG1ocOG4_YtaPwM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKQ7cd8x_5QJ03NPl2lre9UdEmAesUHI0QUR7tuvtGOg&oe=6AE8ACAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPlTIHTBUhoQ7kNvwECWQDm&_nc_oc=AdouVFMD7Pb3-gLGUYHI0MiB-zSH7Fn7tVZCrJQm532AlT63tanFsRHFRNEuvGuzDho&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAUR1rG7BGpSgj5OSgE7kRh5NSJqkPv1RQNKEhhuqb9w&oe=6AE89071"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
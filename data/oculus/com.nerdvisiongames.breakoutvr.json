/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGe0BcG0OK0Q7kNvwGf-JdO&_nc_oc=AdryJGVO3EtyLUpYg14JSYdb4_i6djM7PAAXEPzxZ318Xdh-he3sfQc-7WhnCvyNnhw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SJeLX8BmtznvHLPnPjgrhLUGMhkLwWtmq7y1Xx2ycyQ&oe=6A2C089B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70XiVfg4q4YQ7kNvwEgZwGj&_nc_oc=AdrLcEOtWhTB-u0uizrq5hxa43bfanEVuNruyf5D7jwj8zXTsCi08du344I92-BR4JE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2j-P11YnC1F5ItmmGnxH0tUnFHRZvxFoU0uxM8db5tQ&oe=6A2C262D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tnlbCf8W9UQ7kNvwHkrwKW&_nc_oc=Ado0M2xEArhhO-9EaTP1k3gIdgnEXHYd0DmQwdXBYD3t6ziIgO8aF6Pkk-shkVT-40E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GdS4y07SvPi5A5yljQ3MFwpIbLPyV6sAqvmE0y0vqkA&oe=6A2C09F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
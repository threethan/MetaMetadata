/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEziMr9FuRYQ7kNvwH5It5K&_nc_oc=AdpBNr3JZOYu3trKp4_gPLxEqN5jRathlz79SKpzMF-kZTwvACAA-0r1LgAFSny0w1s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kX4PZNkED5boLxNYVOAb8BRRA_Lcim7BIuuZygoUnUQ&oe=69FDE41B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGiHuvsAIFUQ7kNvwFQj6Fq&_nc_oc=Adp-tdrP8t5iLB6EEsfjNKJ0T2BampEF1qk2fNu429gs_LvY1WvtcY56jB0KeOXXoDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JXV3zNy9iq4lhANbo99OK7PDBCCw37M4Am9zmz-eSoQ&oe=69FE01AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbIcQNosJDQQ7kNvwH6iEbr&_nc_oc=AdojoexFFbcI8gIf48FH2AxW81woMH6aLWI7o8MZgfvYWcGu6o48dBw17bYmXOe00g4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GcL82SObSo2B_3e_JlDWTUYB9-Ei2jqlIncsniAKawg&oe=69FDE571"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcCm68sjn_gQ7kNvwFeh_t5&_nc_oc=AdoVOmBTeCkTT6d8J8VVu4vSMbE_2IV1-OwAmyAFj-E9v8rZU_EkR3rDZeeMQ6Af7NM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xL1Vmi1RffBOQJZgYjLhh4uo1wMxeOKKZtqhKrZUyXg&oe=6A1D881B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZFOwV4ncx0Q7kNvwEkvOWA&_nc_oc=AdrWCsjm_MUMi-UXoTFFEdSHQ7OrV_oXDD_seNar_6HU21Ir8DPx31YH_FUTHw9zFm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6165rQEpuyQD7DSS_FEHF4yKu17DbSQO6cYWlFR3AZhQ&oe=6A1DA5AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vxYoKC-Qb8Q7kNvwEb5h_S&_nc_oc=AdordWcJhb3z_DyO28rUuG_qQP9OCrl7TQoLfioB-sqQq0uOWeSOAwCfuqhvEcNCTDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50k1Qgvk7R8BZO7wgS_ZRhczxuyAX_tjqIutd9j8-d8g&oe=6A1D8971"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
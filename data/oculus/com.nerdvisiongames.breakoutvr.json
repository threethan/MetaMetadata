/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6I2qPV5y_cQ7kNvwH9rcys&_nc_oc=AdqstXbNXF9-3xaO8aFEzyU2SF2WQ157anEJqwUrrBdPD6U6st-4PW94BoUYWxRuKw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF9URslaxUpZCf0FuwATt_8cxA622UGReZCAjPWodsTw&oe=6AD2259B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lFxZ3_B5JcQ7kNvwEyiCI-&_nc_oc=AdrrtxntFSHtfA2GmxXP5U42tdXFkXBJ_oYVFhqZJySGT5qZZz8Rx2jlZyycjvFhUHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2rSTs-LIgKoRzrQwrtVp4-td0LS8ebvlF5Nr_g-JLbA&oe=6AD2432D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnyBJq-bKT8Q7kNvwEfO0MO&_nc_oc=AdrNmhWTR7qyQgeq4XN7G_dab2IMxt3xa5jUD0BeZrR7u7UAVr9jxK5HccNJxDPxd4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8xaUOr2dppv5hvr4MRzHkckV6ZAJQliJPsbsGA8T93Q&oe=6AD226F1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
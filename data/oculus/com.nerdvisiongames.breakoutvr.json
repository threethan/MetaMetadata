/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ_FAmlIS8cQ7kNvwGNXlbB&_nc_oc=AdojemamWrM-Q9Il5eNOdYtcQLuDi0DI40GcaTpcTKPn6cGL_DSmEv3v-w9rS7JQneg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-tpKZHsEVSPe6TBzVOa97d3GzCI-TRGsyn81tD0eBfg&oe=6A00871B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGiHuvsAIFUQ7kNvwEJrClf&_nc_oc=Adps1pzTTJNib1TecbH6wp82zLXDpuBRxL6sZ3MwaW586Cr_lDG_BqI8Zqe_n0oSy5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m2dpOWgHY3c5NzrgfO5aBimowKIn5XadhDQDOzGmZiw&oe=6A00A4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AeoKcmWGC4Q7kNvwGFTBMV&_nc_oc=AdonW-w3QcJu8PbHojKuHAS5HDB0UTPYLkW3eBmC1Bvgv50kS1mP34L1vuTMYo4W2V0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76nxReF_PngfTIamonx2t2lnzIjeJzDlBIGH_HXicGbg&oe=6A008871"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
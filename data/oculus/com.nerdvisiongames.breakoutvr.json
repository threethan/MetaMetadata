/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGe0BcG0OK0Q7kNvwEtpZx_&_nc_oc=AdohTlkV9_hkVT0kVQ4itNvjQRxwO1C68KbKHMfD-9oVansj30gRKaRZiMygSOJu0Xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DC4wkLk_b_qQhoN-k4DzSoz0Eeh-r2Kg80inwSXJffQ&oe=6A2D5A1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H-WTY1RApUQ7kNvwGdt53-&_nc_oc=Adpktv36hWm9VAmgGO55mpyShf7tkI9g8zwhHWM0xdR2drAy7froRnc7aSm9md9B8IQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DveJjHDHzkwAZ84oyIzaECivl-1t0LM05DMs3O8PbSg&oe=6A2D77AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tnlbCf8W9UQ7kNvwGS-yuu&_nc_oc=AdpWHQvSzlL8p2VNAsEVoPURYOdF9xcdQ5-Vugnv9BQFbuehTjMndd51rG63ZOKdmvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88SPGm-DEo52ZnKbOfIyGTYCG6Q12kbMvthFUqTNPUoA&oe=6A2D5B71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
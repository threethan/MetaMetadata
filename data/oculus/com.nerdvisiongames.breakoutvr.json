/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok8pR4XOwgwQ7kNvwGQzho5&_nc_oc=AdoMloozKqLQVmp4jp9MZWS0LN_Wd6xn7t1N-C7pfX3kGdFCS25TKDiH3Og5uqp-_-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvZceoYwcSnKnQ6sH7CBovaDrxf3S2fO4ONJIZ-P5aCA&oe=6A748B1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubrgP6x9zk4Q7kNvwFRvHEE&_nc_oc=AdpK10pwtlIttqCCtFt_1bAS5Abmg-FvH0eKWNuFCBVZls91a3vtYy6e5df4rd-66QI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjsZ-QuBduQomPeMOWJRIUMgu2aRNGx7ctgejXI61FFw&oe=6A74A8AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdFhN91JbhAQ7kNvwEBf_Lq&_nc_oc=Adoy-_HIZ8nd6_oXbb6nPPcaVGCQ6rcrK-VjdxZ73hKTEwwJTcMfYunlE3MrSNxV5fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW5VTyRVbsQeIAzBmlG7AeNb6Dc_mKFO3JWUdINNZF9g&oe=6A748C71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
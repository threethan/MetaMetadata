/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvWtIBPKjpEQ7kNvwFB4bbQ&_nc_oc=AdoOQHTJmL7nDK1EsUlSN9kbchWnkE7oYDjT7bF2Fc_Z7loig-LUG81t5aGKpvNDxZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA62C9Q9s-Lvx_LiplvXYIDGFj6uAjC3Nm3kXv64kyGRg&oe=6A49099B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2hIuhWh2dcQ7kNvwFKl9kJ&_nc_oc=Adq7SS_RXdBqe8q0atFLqbEMlRicULZ90e1PI2CWX1to_2EEXJpq_zQ5k1Jt0CBH8AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHIvE3LoH_pim-5k5k9r-aN-TuLgJIYqzwb86aiZ-b8Q&oe=6A49272D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8MHhDDTvzwQ7kNvwFEvRjt&_nc_oc=Adq84kb2LwprSEyaoJWQJKVRDN-L2eZdwZcdV2RVWBP1LwkbRmL-fX0qJ0v8Kk5yOqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwOJEFeRlPDRznSlMtexBk9wDuLoOPg8CTnbEUvtlFXQ&oe=6A490AF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
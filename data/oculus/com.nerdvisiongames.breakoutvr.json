/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAoXzSZubl0Q7kNvwHfTC3w&_nc_oc=AdoQ6PHLFPVoQwn1Tqum94tLz87DvFK6k7pvfagXozMR0hvGG4N2XiiJWc7itpe4i1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7TOssn95aeBEotPI_QXFQmg_cw86Sbbqu1icxoutuiA&oe=69CE6E1B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG8R5k-Vg0kQ7kNvwH7RALo&_nc_oc=Ado6KVEMkM6AXumjjO7uRtJgjcFQiBnVPTkns-FdbkByZiato2sV4MBivBiyRBTt1RM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_BoahA03CxAFbgHv_S1nXyn4aC9gVVzdUlPMCPopgbA&oe=69CE536D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq9rt-ruqiUQ7kNvwHE7QYD&_nc_oc=AdoA13fs_4QLbdte7sW50LO9k8h6rsuuqsrdtrfv4ao-PfT1PGxcHsFAnKkw6kjMqk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxeTSqv4Efxr2ozmkCXx3RDSzxRMhwgJXEpDwLRgjR4A&oe=69CE6F71"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
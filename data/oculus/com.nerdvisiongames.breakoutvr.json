/38982495_759203238356065_8065363845288554757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYfl9G2c4goQ7kNvwEhekc6&_nc_oc=AdoKhl_-vkJN-LwOdvkjhbrGPS2Enl3V0hzILtnpiBo6C_0xrOfpLqG_nmi7WlwtTis&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWGRibJfLfQ-fy9Vf5G7__w2ATWjifxf70EwVD8olvlg&oe=6A660A9B"}, {"file_name": "Screen5.png", "id": "212804020571364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982495_212804023904697_3077647452501088787_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5IQEZKfgmMQ7kNvwFs1D-5&_nc_oc=AdpmRWnFFEg2Kbsf7O3Os89ml-IEGPZ4amfyDkwYNFp5OXPkD6TKCmgAw9cCZpA4VcQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSpXdWUCE5KASDgxPUtJm1VCT7jgcYMwrOOgOwYaW9_g&oe=6A65EFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "3784786011589131", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031352_3784786018255797_2545045293935095199_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsjUPjarpTAQ7kNvwFfudij&_nc_oc=AdrrxCwloysrSvdMyBIDnZcrT0bk-FWtohKeC6j8GC3yrjDYm48KpGPL1F0XwRJHRMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvN_4SWelxjC-p2CRhl5kHjaQON-Kybc4psCHSAnd4jQ&oe=6A660BF1"}, "display_name": "Breakout VR", "keywords": [], "long_description": "Play the famous classic arcade Brekout Out now in Virtual Reality. \n\nThe VR version of an alltime classic brings you hours of fun and explosive gameplay in an unique atmosphere.\n\nStory:\nYou are inside the space ship and can only move your ship left and right with your triggers.\nAim and destroy all the bricks to get to the next level.\n\nThe game got inspired by Alleyway's cover image.\n\n- Play from inside the ship in VR\n- Mess with the world and find out who is the best VR brick breaker in the world\n- Starting with 15 Levels in Early Access and more are planned and coming", "short_description": "Play the brick breaker arcade game now in Virtual Reality."}]}, "de
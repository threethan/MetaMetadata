5/491823930_942063942179611_5603423357653252203_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBeQtm-T7usQ7kNvwFqF3l9&_nc_oc=Ado3Yt6X-2brmcBDsJoRlhSvPYoJv3HaV6IB6BVX8ryUiswUOWkIs9DEiPzbAi6_Sig&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6X-RtAo7MoCp6IXJZGyxxZJGomSgUcAKOEKustXu_dg&oe=6A7DB9EC"}, {"file_name": "2.png", "id": "1989186061733869", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491825415_1989186068400535_454832996453261898_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SUlDaPxTjwQ7kNvwEIjooR&_nc_oc=AdrQG0Tv48f00z4mDB7FoTe4HXMtdisEzslLdNVxIr41dq9gTqXsTjtvJPN-uKHUjrE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELwA3YMqTfOK_34YCevDBF1Sfu8zfnwfXehLFoWJc6Dw&oe=6A7D9945"}, {"file_name": "4.png", "id": "2168962400563749", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825563_2168962403897082_7864304850799023070_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vew0swQsmeQQ7kNvwHHzPJU&_nc_oc=Adoq9S0Uc7e5POxu4wVcd-xf6EnOoJ-7GxwW-3FUZHJzCkHzIjny6AU1NAxxitV2K-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIj1I2ED7GxI1pACUCnNg6R8WO7y21KWfcqA_qx14s2Q&oe=6A7DACFB"}, {"file_name": "5.png", "id": "1921108951937471", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823905_1921108955270804_3771789987790635370_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_2Xi5SUvDwQ7kNvwEjbYV5&_nc_oc=Adrfxl5g-1k3ilh5kPzQ5GPTWKKDsGibbecYerJjgxkS3jgBacf7AMrRNDu-vM_yOho&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9wn-h8jsFYG9zR_5MbT4nTXk_Uibbni2tc_p00A7YQA&oe=6A7DC469"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Speedway Racing", "keywords": ["racinggame", "vrracinggame", "carracing", "drivingsimulator", "speedwayracing"], "long_description": "Get Ready to Push the Limits of Speed, Control, and Precision in Absolute VR!\n\nStep directly onto the grid and feel the raw intensity of premium competitive motorsport. Horizon Speedway Racing drops you right into the masterfully crafted cockpit of high-performance racing machines, delivering a physics-driven, adrenaline-fueled speedway simulation engineered from the ground up for virtual reality. Whether you are fine-tuning mechanics in your personal garage or drifting past rivals at full throttle, your reflexes will be pushed past the breaking point.\n\nBegin your journey inside your state-of-the-art interactive showroom. Walk up to elite sports cars to swap out custom high-gloss body paint coats and manually slide suspension bars to match your exact handling preferences. Once your machine is optimized, access the map selection matrix to choose your circuit, lock in your simulation difficulty, and take your place on the starting grid. When the lights go green, engage your hands directly on the virtual steering wheel to fight for the inside lane against fierce, smart AI opponents.\n\nWith fully responsive engine gauge readouts, active cockpit mirror reflections, and real-time electronic leaderboards, every second on the track defines your legacy!\n\nKey Features:\nImmersive Cockpit Telemetry: Take absolute control with an authentic first-person driver's view, complete with functional steering wheels, interactive menus, and realistic dashboard dashboard meters.\n\nShowroom & Suspensio", "short_description": "In Horizon Speedway Racing, Grip the wheel and floor the gas! Customize elite super cars in your virtual showroom, select your track, and dive into high-speed, heart-pounding cockpit VR arcade racing.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
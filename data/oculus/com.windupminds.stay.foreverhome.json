_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O0VS70GeljheRLhTGVA5lx3fLP-UUlkNHM5O0te6NBA&oe=69D902E7"}, {"file_name": "Stay_VR_04.png", "id": "1911207066037308", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_1911207069370641_8374597071554066819_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rXXawAeb7cQ7kNvwH5Dg0W&_nc_oc=AdpawXVBpYOyxpWNFe5b5fQZqRlFtvTXQwooG2_bozRvDJ6KfjZdWcdpxGsdaJteJx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wkkcaa-5Pd1oU_GMhAX8uNLQX46Ul1XiTzzQigrGmPw&oe=69D90DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stay_CoverImageLandscape_01.png", "id": "948004587223855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75608434_948004590557188_6676514701035541992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt1TawmJYtoQ7kNvwEixb2u&_nc_oc=AdptBAdnnHlXyr8SI2QRKvkX_FaAhIKurSQgCELIZdej_tPb-zbcvQ5CxWxD61YIYX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14e987wzJX97DGCXGCeSk-PyBLCCV_do3mMgh2GJcGOw&oe=69D8F70B"}, "display_name": "Stay: Forever Home", "keywords": ["pet", "cozy", "dog", "cute", "relax"], "long_description": "# A game that loves you back. #\n\n# Meet Ember, Your Virtual Pet #\nA magical friend - who **won't** dig holes in your backyard. Ember's not your average pet! She weaves delight into your life and invites you to share her extraordinary world. \n \n# An Unforgettable Journey of Companionship and Play Starts Here #\nImagine a pet that's uniquely yours, responding to your care and attention in surprising ways. With Ember, you're not just adopting a virtual pet; you're going on an extraordinary journey of connection and discovery \u2013 and where to find the treats.\n\n\n# A Cozy Haven Awaits #\nStep into a world of wonder where every corner invites you to explore. Join Ember on a curious adventure. \n\n\n# Features That Spark Joy #\n- **A Pet With Personality:** With her AI-powered personality, she's always surprising you with her antics and quirks.\n- **Mixed Reality Magic:** Your home, reimagined. Ember's got a knack for blurring the lines between the real and the virtual.\n\n\n# A Game That Matters #\nFrom the creators of Bogo and First Steps, Stay: Forever Home is more than just a game; your digital pal is always ready for adventure and - maybe - a little mischief. \n", "short_description": "Escape to a world of warmth, comfort, and play. Stay: Forever Home is the place you\u2019ll meet your fur-ever companion. Cuddle up with Ember on the couch, explore magical environments, and enjoy a dreamlike gameplay experience. It's the perfect antidote to everyday life, offering a magic refuge of play and companionship. And you\u2019ll never need a poop bag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.windupminds.com/stay-forever-home-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Windup Minds", "support_website_url": null, "website_url": "http://www.windupminds.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8907175349342385"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1883447782295160"}, {"status": "PUBLISHED", "id": "1239123521465912"}, {"status": "PUBLISHED", "id": "3354853657998277"}, {"status": "PUBLISHED", "id": "634625596071714"}, {
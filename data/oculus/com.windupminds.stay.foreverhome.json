_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MbGGndv7jxzieP4WB0-44jK96UBNwQibna5xRucl6mg&oe=69F603E7"}, {"file_name": "Stay_VR_04.png", "id": "1911207066037308", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982458_1911207069370641_8374597071554066819_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUtiLQFLgHwQ7kNvwE2VAVz&_nc_oc=AdpmTJzkl4CqxpUgPgrEJOJVVV4_DO23JPcvKlguZ0JxQWVuk6lVxrL2p0-7VXKRhDA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DrSDUW6UbZzvZcpbCDS2FWQk04UEyNCVm7y44Gi0Q7A&oe=69F60EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stay_CoverImageLandscape_01.png", "id": "948004587223855", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75608434_948004590557188_6676514701035541992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSrLFfqQW3MQ7kNvwHySY5Z&_nc_oc=Adr4jxUA5_AjN4TN8xyInabPA4pEKiWWhowAPWocL3Ti9EJHfe84LnEPyEYV4fHfHpU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02_k9l6qSqvOx4qCgpeWIk2zhjD82u4O1zU5Mh5q2IoQ&oe=69F5F80B"}, "display_name": "Stay: Forever Home", "keywords": ["pet", "cozy", "dog", "cute", "relax"], "long_description": "# A game that loves you back. #\n\n# Meet Ember, Your Virtual Pet #\nA magical friend - who **won't** dig holes in your backyard. Ember's not your average pet! She weaves delight into your life and invites you to share her extraordinary world. \n \n# An Unforgettable Journey of Companionship and Play Starts Here #\nImagine a pet that's uniquely yours, responding to your care and attention in surprising ways. With Ember, you're not just adopting a virtual pet; you're going on an extraordinary journey of connection and discovery \u2013 and where to find the treats.\n\n\n# A Cozy Haven Awaits #\nStep into a world of wonder where every corner invites you to explore. Join Ember on a curious adventure. \n\n\n# Features That Spark Joy #\n- **A Pet With Personality:** With her AI-powered personality, she's always surprising you with her antics and quirks.\n- **Mixed Reality Magic:** Your home, reimagined. Ember's got a knack for blurring the lines between the real and the virtual.\n\n\n# A Game That Matters #\nFrom the creators of Bogo and First Steps, Stay: Forever Home is more than just a game; your digital pal is always ready for adventure and - maybe - a little mischief. \n", "short_description": "Escape to a world of warmth, comfort, and play. Stay: Forever Home is the place you\u2019ll meet your fur-ever companion. Cuddle up with Ember on the couch, explore magical environments, and enjoy a dreamlike gameplay experience. It's the perfect antidote to everyday life, offering a magic refuge of play and companionship. And you\u2019ll never need a poop bag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.windupminds.com/stay-forever-home-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Windup Minds", "support_website_url": null, "website_url": "http://www.windupminds.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8907175349342385"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "992334313305351"}, {"status": "CANCELLED", "id": "1471859671209354"}, {"status": "PUBLISHED", "id": "1883447782295160"}, {"status": "PUBLISHED", "id": "1239123521465912"}, {
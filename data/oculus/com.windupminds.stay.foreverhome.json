422010_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gszXEkv8mkQ7kNvwHsTlPJ&_nc_oc=Adoek8nwMwai63zRZKv06r3uiE6m_V1tt87oJlWhEVaGrlAVG4V8xh7m03SB-1JJRws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyGq1RDuXkbSSKGN9t-jgkG30tZUf5H4MXRCn0ybEvnA&oe=6AF32A96"}, {"file_name": "living room goof.png", "id": "519946854176272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_519946857509605_6709902780551874934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW8wqToEwRwQ7kNvwFXhMq7&_nc_oc=AdpxU2V_xr8G3SF5fT4gPwWyFDpmR6_ec6nHbomb2iSgblMNglTfipGh0MYHZJgO7Pc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVohisAJ9Y6BdJC9sECkMjt8KpI9QAp6CW11u0LNYxw&oe=6AF35503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest_WhiteBGPortrait2560.png", "id": "1213013216859447", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_1213013220192780_1963160557558937053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJgLOP6h0VoQ7kNvwHXoou1&_nc_oc=AdqNPuaRC3mmT8jkIUdjRpDpcaV1SpgOk4Wz1E8OwpdJR_9qin7UgXhOpExEpLz3rXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWOCIIHmXFKan3zZqRu6mHwJBj3nCz60McicqLizvuA&oe=6AF340A7"}, "display_name": "Stay: Forever Home", "keywords": ["pet", "cozy", "dog", "cat", "animal"], "long_description": "# A Magical Pet #\n\n**Meet Ember, Your New Best Friend** \n- She'll bring magic and mischief into your home, and take you on an adventure in her fantastical world.\n\n{1242411510687436}\n \n\n# A Living World #\n- Ember\u2019s world is full of creatures to chase and ways to interact.\n\n{1278851093944533}\n\n# A Friend Who's Always There #\n- Ember shares your home, always there to play with, care for, or snuggle on the couch after a long day.\n\n{1471237194076810}\n# Endless Ways to Play #\n- You and Ember work as a team to harvest resources, banish thorny weeds, and explore the mysterious Otherlands.\n\n{23905804525715285}\n\n# Collect, Trade, Buy  #\n- Forage resources and trade them in trade for new toys and clothes to suit your Ember\u2019s unique look and personality.\n\n{2661665564036552}\n\n\nStay: Forever Home by the creators of **Bogo** and **First Steps**\n\n\n", "short_description": "Stay: Forever Home is about Ember, a magical creature who comes to live with you. You can play together, go for walks, collect and trade items, and interact with a strange magical world just outside your door."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.windupminds.com/privacy-policy/", "developer_terms_of_service_url": "https://www.stay-forever-home.com/eula", "publisher_name": "Windup Minds", "support_website_url": "https://www.stay-forever-home.com/support/", "website_url": "https://www.windupminds.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "it", "de", "es", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25700995619533761"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303672_2911362935741667_3352749707930790538_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8462ivrb5AAQ7kNvwEDG_qy&_nc_oc=Adokf0qnpEsIY3XLkuYudRPyecDj8kD2E_8eqFK5fCrsz8Bq5Kl_wNPKcqOuFfRmWHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL-he9pBN5PO_i_cBKCZq
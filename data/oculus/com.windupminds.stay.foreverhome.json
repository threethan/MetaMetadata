sSLVkRCr6_peu-FYCXcAdrQpRnLt1hXXCYI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsG0UsNglt_PJK5Un73m1yPL59kZvCBAXbIJTeQFkkDpQ&oe=6999C196"}, {"file_name": "living room goof.png", "id": "519946854176272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_519946857509605_6709902780551874934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfCyw6WctocQ7kNvwGyZgBy&_nc_oc=AdlIXDABWZchVVrFTYGc3zCv-aZxPxwyXhc1aTsF9BS8u4_pqLDb_6uBO1iHgeMr1WI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvPM7LsxE26VHMXhyehu147r5N4EmDtYDqGVqsyoiodHA&oe=6999B3C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ABTest_WhiteBGPortrait2560.png", "id": "1213013216859447", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1213013220192780_1963160557558937053_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpMSiU7jZ_IQ7kNvwHd7LAp&_nc_oc=AdmTul9N1dZpSeIdTrms6jcaFL_zDHikU9yDy9HBWLjIKmJlXcGGfk4Xat7ePmhS6Yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNOZugkfAB-__V1cqPP2xukcoudayxCfUT-IjsyuzKTA&oe=69999F67"}, "display_name": "Stay: Forever Home", "keywords": ["pet", "cozy", "dog", "cat", "animal"], "long_description": "# A Magical Pet #\n\n**Meet Ember, Your New Best Friend** \n- She'll bring magic and mischief into your home, and take you on an adventure in her fantastical world.\n\n{1242411510687436}\n \n\n# A Living World #\n- Ember\u2019s world is full of creatures to chase and ways to interact.\n\n{1278851093944533}\n\n# A Friend Who's Always There #\n- Ember shares your home, always there to play with, care for, or snuggle on the couch after a long day.\n\n{1471237194076810}\n# Endless Ways to Play #\n- You and Ember work as a team to harvest resources, banish thorny weeds, and explore the mysterious Otherlands.\n\n{23905804525715285}\n\n# Collect, Trade, Buy  #\n- Forage resources and trade them in trade for new toys and clothes to suit your Ember\u2019s unique look and personality.\n\n{2661665564036552}\n\n\
ap=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW0QdSF9T80Q7kNvwF0e-HO&_nc_oc=AdqIORVvtqiECJ32wQwBXKGxVRDnnSsD7TEhlK8d_UjxtQ4Y7fQJZEBALaFCwSDT7_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLkEIdomDidfU6hXhscarZnodm_URsWQ2WKY2Cv1gk6w&oe=6AFDB2D9"}, {"file_name": "Stay_MR_01.png", "id": "1290832198588963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974465_1290832201922296_6294468570698202063_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxzz_H-ON_0Q7kNvwE0Thxk&_nc_oc=AdocUA0ZfGwDJVoZsj2xcE4sAebDeH4mEhBXHk-y7-hbDdkUN-t0CSBSFQs5R4lzAkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRkmmLgOczWWYPsmtxWoB-Ll9D41F-Kh6OKMaR9MdjCg&oe=6AFDAFE7"}, {"file_name": "Stay_VR_04.png", "id": "1911207066037308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982458_1911207069370641_8374597071554066819_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE88xGqfC2cQ7kNvwFMofvO&_nc_oc=Adqo9O8yuG2SuHUoHMnzKymzR-zMajB0SLXxZ2EiWQImDdm4dcePtWKIbja05v1MgJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToh_iZyxl-4rM0zVj3eLJH3zJ2n7_vYY-q5zbkwPEm7w&oe=6AFDBAAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stay_CoverImageLandscape_01.png", "id": "948004587223855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75608434_948004590557188_6676514701035541992_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U_3YxBNey0Q7kNvwEkrpre&_nc_oc=AdpoaMdp5BwM_eZd4JUyZoIU2ah8t7QwFG7U0TbLbUzksOfX10g-uL0MG8FQC_pAG3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlq82w5V_GyU1nArZUlOib7dtTODxUEbh-2BqnnhL1OQ&oe=6AFDDC4B"}, "display_name": "Stay: Forever Home", "keywords": ["pet", "cozy", "dog", "cute", "relax"], "long_description": "# A game that loves you back. #\n\n# Meet Ember, Your Virtual Pet #\nA magical friend - who **won't** dig holes in your backyard. Ember's not your average pet! She weaves delight into your life and invites you to share her extraordinary world. \n \n# An Unforgettable Journey of Companionship and Play Starts Here #\nImagine a pet that's uniquely yours, responding to your care and attention in surprising ways. With Ember, you're not just adopting a virtual pet; you're going on an extraordinary journey of connection and discovery \u2013 and where to find the treats.\n\n\n# A Cozy Haven Awaits #\nStep into a world of wonder where every corner invites you to explore. Join Ember on a curious adventure. \n\n\n# Features That Spark Joy #\n- **A Pet With Personality:** With her AI-powered personality, she's always surprising you with her antics and quirks.\n- **Mixed Reality Magic:** Your home, reimagined. Ember's got a knack for blurring the lines between the real and the virtual.\n\n\n# A Game That Matters #\nFrom the creators of Bogo and First Steps, Stay: Forever Home is more than just a game; your digital pal is always ready for adventure and - maybe - a little mischief. \n", "short_description": "Escape to a world of warmth, comfort, and play. Stay: Forever Home is the place you\u2019ll meet your fur-ever companion. Cuddle up with Ember on the couch, explore magical environments, and enjoy a dreamlike gameplay experience. It's the perfect antidote to everyday life, offering a magic refuge of play and companionship. And you\u2019ll never need a poop bag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.windupminds.com/stay-forever-home-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Windup Minds", "support_website_url": null, "website_url": "http://www.windupminds.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
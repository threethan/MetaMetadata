itive movement mechanics, taking inspiration from Gorilla Tag and enhancing them to create a diverse and dynamic gameplay experience.\n\nSprinting: Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter.\n\nLeaping and Climbing: Baboons are known for their agility, and in Baboon!, you can leap incredible distances and climb up trees and cliffs with ease. The game's physics system ensures that every jump and climb feels responsive and realistic", "short_description": "Channel your inner baboon as you sprint through the jungle at breakneck speeds, leaving your opponents in the dust. The sensation of speed is exhilarating, and you'll feel like a true jungle sprinter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baboonvr.vercel.app/#privacy", "developer_terms_of_service_url": "https://baboonvr.vercel.app/#terms", "publisher_name": "Zaven Games Co", "support_website_url": null, "website_url": "https://baboonvr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1377756638744995"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1580248300457710"}]}, "baseline_offer": {"id": "1580248300457710"}, "is_approved": true, "fi
cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nRmSCgcl7MQ7kNvwEcfnMQ&_nc_oc=AdpImfnXQOB4DeajKPKez3lwOYv6zW5Zg-bbayjOuL2TvTDQVUIq3Hmoh-hx_Qpqls0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnNsc0jR9MnGZ7TJphtDDr4AeyeoDhH7uGm6wU3b9YrA&oe=6A9029E6"}, {"file_name": "shot_flowerfield.png", "id": "1575425590874280", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619685_1575425600874279_7513003613985302748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znNBMraVeRkQ7kNvwF0nREG&_nc_oc=AdopcU1dgE_Qu6Ep0S6Egh6--u6QJBZ3Be7ZMHnT9WPP4gQoBEGAp_rFILIkK-HQEvY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6qxVnGvIspQftdX7WuvDPJ-cgBBsg_1kwmlYvc3um9Q&oe=6A9027F8"}, {"file_name": "shot_crystaluniverse.png", "id": "1050219184223413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622315_1050219187556746_8259124061839392060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKRTq_z5rZYQ7kNvwGkxM1W&_nc_oc=AdoJKpAc1R5vTcRyn3yXlCOUvjvtYtDNQUtYFptWcS8E_Xx1hQ1rf5gYjXrCkyzu0K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH3DruljZnxURwmeHbB26yB9H0-3z7Mha-03rjhXx2Cw&oe=6A901C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1094321209615725", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823798_1094321212949058_4969062892607470542_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hE4mHxKXroQ7kNvwHspsVM&_nc_oc=AdpIjT6p8FHVJEpuSlYu0Syx_leKe7qXDjMu9qzDdkZMOnM17zwG11erF4NE7ptx4qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETQAXV4JKmbNW-4mpUt7c1zSqDFCNS6luzpjSkFhc7LA&oe=6A902A8B"}, "display_name": "Nagi \u2014 Meditation, Sleep & Breathing", "keywords": [], "long_description": "Step away from the noise. Nagi places you inside nine handcrafted immersive environments \u2014 each one a quiet invitation to slow down, breathe, and let the day dissolve.\n\n**Nine worlds, one breath at a time**\n\nDrift beneath a canopy of sakura petals on a sunlit hill. Sit on the engawa of a Japanese garden as lanterns glow at dusk. Watch the aurora trace slow arcs over a still mountain lake. Feel the calm of a tropical beach, the hush of the deep sea, a sea of clouds, a quiet flower field, a mirror-like salt flat, and a silent field of stars. Every environment is built around *ma* \u2014 the Japanese ideal of beauty found in space and stillness.\n\n**Guided breathing, always there when you need it**\n\nNagi's visual breathing guide sits gently in your view, pacing your inhale and exhale without demanding your attention. Choose from multiple breathing patterns, or simply rest in the ambient soundscapes.\n\n**Try it free, upgrade when you're ready**\n\nThree full scenes \u2014 Sea of Clouds, Deep Sea, and Crystal Universe \u2014 are free forever, along with the breathing guide. Unlock all nine environments with a Premium subscription (7-day free trial) or a one-time lifetime purchase. New content is added regularly.\n\n**Privacy by design**\n\nNagi works entirely offline. No ads. No data collection. No tracking. Once downloaded, nothing leaves your headset.\n\nNagi is for anyone who wants an unhurried place to practice mindfulness, ease into sleep, or simply take five minutes for themselves.", "short_description": "Nine serene VR worlds inspired by Japanese aesthetics \u2014 cherry blossoms, an engawa garden, aurora, and more. Breathe, rest, and unwind with guided breathing exercises and natural soundscapes. Three scenes free forever, no ads, no data collection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/nagi-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"i
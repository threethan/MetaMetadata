ue-ezoo8TA_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdyeHhLjQg7QmyRchlBRMtB6jb538Zl_EJWN27y9IxtA&oe=6A7C6366"}, {"file_name": "shot_flowerfield.png", "id": "1575425590874280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1575425600874279_7513003613985302748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8Zu_sedK7oQ7kNvwGAeHc_&_nc_oc=AdrIoDkdvxZDZwNP5HDUmAw8KMkYhAtS8hQRrZRdcEGPugnzS9vBl55OvMIjN84CMBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOiqtkobHwt96Uk6VCQRrp8l0o49ZoJtGV3jO4HZsp1A&oe=6A7C6178"}, {"file_name": "shot_crystaluniverse.png", "id": "1050219184223413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1050219187556746_8259124061839392060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEvQy1hj7RoQ7kNvwGgXlLD&_nc_oc=AdpMTYUC8Sidou7yFjUSmpmSsBV7Ya1HgZAD-U28OxBxrSc3NKvIxRLJwUHRFavmao4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvkkmWZrZD5uWwk9-PDUva7ynOzXmbr1bfPEr4QV0_hQ&oe=6A7C561D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1094321209615725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823798_1094321212949058_4969062892607470542_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkGK4KxwTGQQ7kNvwH_4o7w&_nc_oc=AdpzCsdBMCIRNEB26CHW-YLtutSgjKbgW96pyYdDv_J9arpd2kR1ZuVg-5K7JkYxw2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6w6dVIwLmJwOmUa8Z05_56vo-KlXu4pdo1Hi4AYclWg&oe=6A7C640B"}, "display_name": "Nagi \u2014 Meditation, Sleep & Breathing", "keywords": [], "long_description": "Step away from the noise. Nagi places you inside nine handcrafted immersive environments \u2014 each one a quiet invitation to slow down, breathe, and let the day dissolve.\n\n**Nine worlds, one breath at a time**\n\nDrift beneath a canopy of sakura petals on a sunlit hill. Sit on the engawa of a Japanese garden as lanterns glow at dusk. Watch the aurora trace slow arcs over a still mountain lake. Feel the calm of a tropical beach, the hush of the deep sea, a sea of clouds, a quiet flower field, a mirror-like salt flat, and a silent field of stars. Every environment is built around *ma* \u2014 the Japanese ideal of beauty found in space and stillness.\n\n**Guided breathing, always there when you need it**\n\nNagi's visual breathing guide sits gently in your view, pacing your inhale and exhale without demanding your attention. Choose from multiple breathing patterns, or simply rest in the ambient soundscapes.\n\n**Try it free, upgrade when you're ready**\n\nThree full scenes \u2014 Sea of Clouds, Deep Sea, and Crystal Universe \u2014 are free forever, along with the breathing guide. Unlock all nine environments with a Premium subscription (7-day free trial) or a one-time lifetime purchase. New content is added regularly.\n\n**Privacy by design**\n\nNagi works entirely offline. No ads. No data collection. No tracking. Once downloaded, nothing leaves your headset.\n\nNagi is for anyone who wants an unhurried place to practice mindfulness, ease into sleep, or simply take five minutes for themselves.", "short_description": "Nine serene VR worlds inspired by Japanese aesthetics \u2014 cherry blossoms, an engawa garden, aurora, and more. Breathe, rest, and unwind with guided breathing exercises and natural soundscapes. Three scenes free forever, no ads, no data collection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/nagi-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "in
y_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373718889164355"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New premium space Sky Lanterns: a lakeside meadow at night, with thousands of paper sky lanterns rising and mirrored in the lake. Now and then a lantern is released close to you.\n- New premium space Planetarium: a dome theater with a quiet star program, featuring a real night sky from the Yale Bright Star Catalogue, the Milky Way, gently traced constellations and meteors.\n- New premium space Campfire: a small forest clearing at night with a calm, slowly changing fire, crackles, sparks and glowing coals under pines and stars.\n- Added a Licenses screen in settings.\n- Sharper stage titles in the menu and clearer settings text; fixed the trial badge flicker.", "created_date": 1791859020, "id": "1354425854426992", "version": "1.2", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ease_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New premium space Summer Train: a window seat on a Showa-era local line at a summer dusk, with countryside, 3D farmhouses, a station and hydrangeas drifting past.\n- New premium space Rainy Caf\u00e9: a window seat in an old kissaten on a rainy afternoon, looking out through raindrop-streaked glass at a 3D townscape.", "created_date": 1792396712, "id": "1365689709967273", "version": "1.3", "version_code": 11, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1371010872768490"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New premium space Sky Lanterns: a lakeside meadow at night, with thousands of paper sky lanterns rising and mirrored in the lake. Now and then a lantern is released close to you.\n- New premium space Planetarium: a dome theater with a quiet star program, featuring a real night sky from the Yale Bright Star Catalogue, the Milky Way, gently traced constellations and meteors.\n- New premium space Campfire: a small forest clearing at night with a calm, slowly changing fire, crackles, sparks and glowing coals under pines and stars.\n- Added a Licenses screen in settings.\n- Sharper stage titles in the menu and clearer settings text; fixed the trial badge flicker.", "created_date": 1791859020, "id": "1354425854426992", "version": "1.2", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "a
cRrG4NKF7JdG_UhZPsEYFG45w&oe=6AE35C58"}, {"file_name": "shot_sakura.png", "id": "1793685085399895", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620860_1793685088733228_1690693166977736219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKK4JLyqEfwQ7kNvwFjnpOg&_nc_oc=Adqedxv7ayGKoysqf6RtwFaqbyKWxlL__7KjCk93TwRumy145kyXYlTlDLaIwggxU4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObY1B68ayysqy0HEp3OXqnIwSzLddQ2zlBWqIKYH_Jdw&oe=6AE34B9F"}, {"file_name": "shot_deepsea.png", "id": "2283207202423810", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619078_2283207205757143_9002113439986989039_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN063_TwKS0Q7kNvwFGyjvN&_nc_oc=AdoXPBedMQzbSi1Ev2mU_2S9JBhmfajJs-l5BNcZX9x5Ykv100YgAIzIU5mW6zgsA1A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh0EViH6rIu8XEiF-BnMmIomQdwYaTjZvAv2pZ-j6VQA&oe=6AE33866"}, {"file_name": "shot_flowerfield.png", "id": "1575425590874280", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619685_1575425600874279_7513003613985302748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVExUMahR2oQ7kNvwEnd--Q&_nc_oc=AdqCBWmPhZpSN-VhZ8dr0eqp1piUXMnqN8mvt-ZEeZC0y6gYP8pkuwHkA6J2TD0CImM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHuah6eMYkDTqp7x1X97z1TGdsDelI-_kKM5JnL1oXvA&oe=6AE33678"}, {"file_name": "shot_crystaluniverse.png", "id": "1050219184223413", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622315_1050219187556746_8259124061839392060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZNoWblkm00Q7kNvwGU4JsK&_nc_oc=AdqmXUXFuLvGv7DDRXaSLPcbiRYDVVt4Bs81Rqnk5IJtJLq6DGknFe5M9yDsdBDIbac&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHinD8IDeM2gq8ir1C8Ak9WHZClMkH5Yub4OrCDn_vGQ&oe=6AE3635D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1094321209615725", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823798_1094321212949058_4969062892607470542_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW7tHoGGDSEQ7kNvwF4Mb1U&_nc_oc=Adpa6zOAQC_ntYElFv0JVxKCU-BYfwM0GuUe_a2fdd6PzlYYUAMTvr-e9KQLe1OhJmU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxMeK67JgAUAH-cxl-MS500YIQK3myLTqk2ha-FCEmsA&oe=6AE3390B"}, "display_name": "Nagi \u2014 Meditation, Sleep & Breathing", "keywords": [], "long_description": "Step away from the noise. Nagi places you inside nine handcrafted immersive environments \u2014 each one a quiet invitation to slow down, breathe, and let the day dissolve.\n\n**Nine worlds, one breath at a time**\n\nDrift beneath a canopy of sakura petals on a sunlit hill. Sit on the engawa of a Japanese garden as lanterns glow at dusk. Watch the aurora trace slow arcs over a still mountain lake. Feel the calm of a tropical beach, the hush of the deep sea, a sea of clouds, a quiet flower field, a mirror-like salt flat, and a silent field of stars. Every environment is built around *ma* \u2014 the Japanese ideal of beauty found in space and stillness.\n\n**Guided breathing, always there when you need it**\n\nNagi's visual breathing guide sits gently in your view, pacing your inhale and exhale without demanding your attention. Choose from multiple breathing patterns, or simply rest in the ambient soundscapes.\n\n**Try it free, upgrade when you're ready**\n\nThree full scenes \u2014 Sea of Clouds, Deep Sea, and Crystal Universe \u2014 are free forever, along with the breathing guide. Unlock all nine environments with a Premium subscription (7-day free trial) or a one-time lifetime purchase. New content is added regularly.\n\n**Privacy by design**\n\nNagi works entirely offline. No ads. No data collection. No tracking. Once downloaded, nothing leaves your headset.\n\nNagi is for anyone who wants an unhurried place to practice mindfulness, ease into sleep, or simply take five minutes for themselves.", "short_description": "Nine serene VR worlds inspired by Japanese aesthetics \u2014 cherry blossoms, an engawa garden, aurora, and more. Breathe, rest, and unwind with guided breathing exercises and natural soundscapes. Three scenes free forever, no ads, no data collection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/nagi-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "fr", "de", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1226853960517516"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "887257440698539"}]}, "baseline_offer": {"id": "887257440698539"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786116660, "status": "PUBLISHED", "id": "887257440698539"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1373718889164355", "version": "1.4"}, "id": "1727650671903260", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373718889164355"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New premium space Koi Pond: a Japanese garden pond where realistic koi swim slowly, with an overhanging tree, a bamboo water spout and a stone lantern.\n- New premium space Hyperspace: sit in a small spaceship cockpit as a blue-white hyperspace warp alternates with slow cruises to four destinations: a ringed gas giant, a colourful moving nebula, an Earth dawn and a black hole with an accretion disk. Includes ambient sound. Motion is designed for comfort, with straight-line travel only and no flashing.\n- The free preview of locked premium spaces is now 60 seconds, up from 30.\n- Smoother frame rate on Quest 2 and Quest 3, through fixed foveated rendering, removing HDR where it had no visual effect, and per-device quality settings.\n- Richer, more natural ambient sounds in many spaces, including Campfire, Summer Train, Rainy Caf\u00e9, Koi Pond, Hyperspace and Beach.\n- The clouds in Sea of Clouds now render more smoothly, without the grainy look.", "created_date": 1792761953, "id": "1373718889164355", "version": "1.4", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373718889164355"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": null, "created_date": 1792633673, "id": "1371010872768490", "version": "1.3", "version_code": 14, "release_status": "RELEASED", 
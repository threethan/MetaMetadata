nt-dfw5-1.oculuscdn.com/v/t64.5771-25/499623876_1436222411717897_8447682918547918409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8vDMXy6bS4Q7kNvwHpqJZL&_nc_oc=AdqFKrkyu8UeWabGYF1dzYBROBsFv1-KmANZXp0pnmzfFLZu9x6IxseZiovv0iB7Ytk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj3twTjYrr9hgSjnCarfMhAWIEJ_LDUf98KYpImhWp5w&oe=6AE3454B"}, {"file_name": "Sakura.png", "id": "4468536020086917", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619404_4468536023420250_8370096239118235013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CLk2oVCtW4Q7kNvwGx5ujv&_nc_oc=AdqevsyxKwtqUbBSZcKmQrXsHv6drLDhGXlx5JNaTS5xoNJr1WzDIWUODWItcGX1xVw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFZZSry8ZsNiStlB8i_s0jHVGscwerfUS3x0K4HzlaoA&oe=6AE3393D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1094321209615725", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823798_1094321212949058_4969062892607470542_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW7tHoGGDSEQ7kNvwF4Mb1U&_nc_oc=Adpa6zOAQC_ntYElFv0JVxKCU-BYfwM0GuUe_a2fdd6PzlYYUAMTvr-e9KQLe1OhJmU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxMeK67JgAUAH-cxl-MS500YIQK3myLTqk2ha-FCEmsA&oe=6AE3390B"}, "display_name": "Nagi \u2014 Meditation, Sleep & Breathing", "keywords": ["meditation", "sleep", "breathing", "relaxation", "zen"], "long_description": "Step away from the noise. Nagi places you inside twenty handcrafted immersive environments \u2014 each one a quiet invitation to slow down, breathe, and let the day dissolve.\n\n**Twenty worlds, one breath at a time**\n\nDrift beneath a canopy of sakura petals on a sunlit hill. Sit on the engawa of a Japanese garden as lanterns glow at dusk. Watch the aurora trace slow arcs over a still mountain lake. Feel the calm of a tropical beach, the hush of the deep sea, a sea of clouds, a quiet flower field, a mirror-like salt flat, and a silent field of stars. Let paper sky lanterns rise from a lakeside meadow at night, lie back under the real stars of a quiet planetarium, sit by a calm campfire, watch koi in a garden pond, or cruise through hyperspace. Every environment is built around *ma* \u2014 the Japanese ideal of beauty found in space and stillness.\n\n**Guided breathing, always there when you need it**\n\nNagi's visual breathing guide sits gently in your view, pacing your inhale and exhale without demanding your attention.\n\n**Try it free, upgrade when you're ready**\n\nFive full spaces \u2014 Sea of Clouds, Deep Sea, Stardust Universe, Suction, and Dream Pool \u2014 are free forever, along with the breathing guide. Unlock all twenty environments with a Premium subscription (7-day free trial) or a one-time lifetime purchase. New content is added regularly.\n\n**Privacy by design**\n\nNagi works entirely offline. No ads. No data collection. No tracking. Once downloaded, nothing leaves your headset.", "short_description": "Twenty serene VR worlds inspired by Japanese aesthetics \u2014 cherry blossoms, an engawa garden, sky lanterns, a planetarium, and more. Breathe, rest, and unwind with guided breathing exercises and natural soundscapes. Five spaces free forever, no ads, no data collection."}, {"images": {"nodes": []}, "id": "1421042576252671", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nagi \u2014 \uba85\uc0c1, \uc218\uba74, \ud638\ud761", "keywords": ["\uba85\uc0c1", "\uc218\uba74", "\ud638\ud761", "\ud734\uc2dd", "\uc820"], "long_description": "\uc18c\uc74c\uc5d0\uc11c \ud55c \uac78\uc74c \ub5a8\uc5b4\uc838 \ubcf4\uc138\uc694. Nagi\ub294 \uc2a4\ubb34 \uac1c\uc758 \ubab0\uc785\ud615 \ud790\ub9c1 \uacf5\uac04\uc73c\ub85c \ub2f9\uc2e0\uc744 \ucd08\ub300\ud569\ub2c8\ub2e4 \u2014 \ub290\uae0b\ud558\uac8c, \uc228\uc744 \uace0\ub974\uba70, \ud558\ub8e8\ub97c \ud758\ub824\ubcf4\ub0b4\ub294 \uc870\uc6a9\ud55c \uc2dc\uac04.\n\n**\uc2a4\ubb34 \uac1c\uc758 \uc138\uacc4**\n\n\ud587\uc0b4 \uc88b\uc740 \uc5b8\ub355\uc5d0\uc11c \ud769\ub0a0\ub9ac\ub294 \ubc9a\uaf43 \uc544\ub798\ub97c \uac70\ub2d0\uace0, \ud574 \uc9c8 \ub158 \ub4f1\ubd88\uc774 \ucf1c\uc9c0\ub294 \uc77c\ubcf8 \uc815\uc6d0\uc758 \ud207\ub9c8\ub8e8\uc5d0 \uc549\uc544 \ubcf4\uc138\uc694. \uace0\uc694\ud55c \uc0b0\uc815 \ud638\uc218 \uc704\ub85c \ucc9c\ucc9c\ud788 \ud750\ub974\ub294 \uc624\ub85c\ub77c, \uc0c8\ubcbd\uc758 \uc5f4\ub300 \ud574\ubcc0, \uae4a\uc740 \ubc14\ub2e4\uc758 \uace0\uc694, \ubc1c\uc544\ub798 \ud3bc\uccd0\uc9c4 \uad6c\ub984\ubc14\ub2e4, \uc624\ud6c4\uc758 \uaf43\ubc2d, \ud558\ub298\uc744 \ube44\ucd94\ub294 \uc18c\uae08\uc0ac\ub9c9, \uadf8\ub9ac\uace0 \ubcc4\uac00\ub8e8\uac00 \ube5b\ub098\ub294 \uc6b0\uc8fc. \ubc24\uc758 \ud638\uc22b\uac00 \ucd08\uc6d0\uc5d0\uc11c \ub5a0\uc624\ub974\ub294 \uc218\ub9ce\uc740 \ud48d\ub4f1, \uc9c4\uc9dc \ubcc4\ud558\ub298\uc774 \ud3bc\uccd0\uc9c0\ub294 \uace0\uc694\ud55c \ud50c\ub77c\ub124\ud0c0\ub9ac\uc6c0, \uc232\uc18d \ube48\ud130\uc758 \uc794\uc794\ud55c \ubaa8\ub2e5\ubd88, \ube44\ub2e8\uc789\uc5b4\uac00 \ub178\ub2c8\ub294 \uc815\uc6d0 \uc5f0\ubabb, \ud558\uc774\ud37c\uc2a4\ud398\uc774\uc2a4\ub97c \ub098\uc544\uac00\ub294 \uc6b0\uc8fc\uc120 \uc870\uc885\uc11d\ub3c4 \ub9cc\ub098 \ubcf4\uc138\uc694. \ubaa8\ub4e0 \uacf5\uac04\uc740 \uc5ec\ubc31\uc758 \uc544\ub984\ub2e4\uc6c0\uc774\ub77c\ub294 \uc77c\ubcf8 \ubbf8\ud559 '\ub9c8(\u9593)'\ub97c \ubc14\ud0d5\uc73c\ub85c \ub9cc\ub4e4\uc5b4\uc84c\uc2b5\ub2c8\ub2e4.\n\n**\ud638\ud761 \uac00\uc774\ub4dc**\n\n\uc2dc\uc57c \ud55c\ucabd\uc5d0 \ubd80\ub4dc\ub7fd\uac8c \ub098\ud0c0\ub098\ub294 \ud638\ud761 \uac00\uc774\ub4dc\uac00 \ub4e4\uc228\uacfc \ub0a0\uc228\uc758 \ub9ac\ub4ec\uc744 \uc774\ub04c\uc5b4 \uc90d\ub2c8\ub2e4. \uc5ec\ub7ec \ud638\ud761 \ud328\ud134 \uc911\uc5d0\uc11c \uc120\ud0dd\ud560 \uc218 \uc788\uace0, \uadf8\uc800 \ud658\uacbd\uc74c\uc5d0 \ubab8\uc744 \ub9e1\uae34 \ucc44 \uc549\uc544 \uc788\uc5b4\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4.\n\n**\ubb34\ub8cc\ub85c \uc2dc\uc791\ud558\uc138\uc694**\n\n\uad6c\ub984\ubc14\ub2e4\u00b7\uae4a\uc740 \ubc14\ub2e4\uc758 \uace0\uc694\u00b7\ubcc4\uac00\ub8e8 \uc6b0\uc8fc\u00b7\ud761\uc778\uc758 \ubc29\u00b7\ubabd\ud658\uc758 \uc218\uc601\uc7a5 \ub2e4\uc12f \uac1c\uc758 \uc7a5\uba74\uacfc \ud638\ud761 \uac00\uc774\ub4dc\ub294 \uc601\uc6d0\ud788 \ubb34\ub8cc\uc785\ub2c8\ub2e4. \ub098\uba38\uc9c0 \uc5f4\ub2e4\uc12f \uac1c \uc7a5\uba74\uc740 \ud504\ub9ac\ubbf8\uc5c4 \uad6c\ub3c5(7\uc77c \ubb34\ub8cc \uccb4\ud5d8) \ub610\ub294 \ud3c9\uc0dd \uc774\uc6a9\uad8c\uc73c\ub85c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c8\ub85c\uc6b4 \ucf58\ud150\uce20\uac00 \uafb8\uc900\ud788 \ucd94\uac00\ub429\ub2c8\ub2e4.\n\n**\ud504\ub77c\uc774\ubc84\uc2dc \uc6b0\uc120 \uc124\uacc4**\n\nNagi\ub294 \uc644\uc804\ud788 \uc624\ud504\ub77c\uc778\uc73c\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uad11\uace0 \uc5c6\uc74c, \ub370\uc774\ud130 \uc218\uc9d1 \uc5c6\uc74c, \ucd94\uc801 \uc5c6\uc74c. \ub2e4\uc6b4\ub85c\ub4dc \ud6c4\uc5d0\ub294 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0 \uc5c6\uc774 \uc5b8\uc81c\ub4e0 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uba85\uc0c1 \uc2b5\uad00\uc744 \uc2dc\uc791\ud558\uace0 \uc2f6\uc740 \ubd84\uc5d0\uac8c\ub3c4, \uc7a0\ub4e4\uae30 \uc804 \uc2dc\uac04\uc744 \uc704\ud574\uc11c\ub3c4, \uadf8\uc800 5\ubd84\uc758 \uace0\uc694\uac00 \ud544\uc694\ud55c \uc21c\uac04\uc5d0\ub3c4 \u2014 \ub2f9\uc2e0\ub9cc\uc758 '\ub098\uae30(\u51ea)'\ub97c.", "short_description": "\uc77c\ubcf8\uc758 \ubbf8\uc758\uc2dd\uc5d0\uc11c \ud0dc\uc5b4\ub09c \uc2a4\ubb34 \uac1c\uc758 \ubab0\uc785\ud615 \ud790\ub9c1 \uacf5\uac04. \ubc9a\uaf43 \uc5b8\ub355, \uc815\uc6d0 \ud207\ub9c8\ub8e8, \ud48d\ub4f1\uc758 \ud638\uc218, \ud50c\ub77c\ub124\ud0c0\ub9ac\uc6c0\u2026 \uc2dc\uac01 \ud638\ud761 \uac00\uc774\ub4dc\uc640 \ud658\uacbd\uc74c\uc73c\ub85c \uace0\uc694\ud558\uac8c \ub9c8\uc74c\uc744 \uac00\ub2e4\ub4ec\ub294 \uc2dc\uac04. \ub2e4\uc12f \uac1c \uc7a5\uba74 \uc601\uad6c \ubb34\ub8cc, \uad11\uace0 \uc5c6\uc74c, \ub370\uc774\ud130 \uc218\uc9d1 \uc5c6\uc74c."}, {"images": {"nodes": []}, "id": "1143827644787153", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nagi \u2014 Meditation, Schlaf & Atmung", "keywords": ["Meditation", "Schlafhilfe", "Atem\u00fcbung", "Entspannung", "Zen"], "long_description": "Tritt heraus aus dem L\u00e4rm. Nagi versetzt dich in zwanzig handgefertigte, immersive Umgebungen \u2014 jede eine stille Einladung, langsamer zu werden, zu atmen und den Tag loszulassen.\n\n**Zwanzig Welten, ein Atemzug nach dem anderen**\n\nTreibe unter Kirschbl\u00fcten auf einem sonnigen H\u00fcgel, sitze in der D\u00e4mmerung auf der Engawa eines japanischen Gartens, sieh Polarlichter \u00fcber einen stillen Bergsee ziehen. Sp\u00fcre die Ruhe von Strand, Tiefsee, Wolkenmeer, Blumenfeld, Salzsee, Sternenhimmel, Koiteich und Hyperraum. Lass Papierlaternen \u00fcber einer Seewiese aufsteigen, lehne dich im Planetarium unter den echten Sternen zur\u00fcck oder setze dich ans Lagerfeuer auf einer Waldlichtung. Jede Umgebung folgt dem japanischen Ideal des *Ma* \u2014 der Sch\u00f6nheit von Raum und Stille.\n\n**Gef\u00fchrtes Atmen, immer da, wenn du es brauchst**\n\nNagis visuelle Atemf\u00fchrung erscheint sanft in deinem Blickfeld und gibt Ein- und Ausatmen den Takt vor, ohne Aufmerksamkeit zu fordern.\n\n**Kostenlos ausprobieren, upgraden, wann du willst**\n\nF\u00fcnf vollst\u00e4ndige Szenen \u2014 Wolkenmeer, Stille Tiefsee, Sternenstaub, Sogkammer und Traumbad \u2014 sind f\u00fcr immer kostenlos, ebenso die Atemf\u00fchrung. Schalte alle zwanzig Umgebungen mit einem Premium-Abo (7 Tage kostenlos testen) oder einem einmaligen Kauf frei. Neue Inhalte erscheinen regelm\u00e4\u00dfig.\n\n**Privatsph\u00e4re von Anfang an**\n\nNagi funktioniert vollst\u00e4ndig offline. Keine Werbung, keine Datenerhebung, kein Tracking \u2014 ein ruhiger Ort f\u00fcr Achtsamkeit, Schlaf oder einfach f\u00fcnf Minuten f\u00fcr dich.", "short_description": "Zwanzig ruhige VR-Welten, inspiriert von japanischer \u00c4sthetik \u2014 Kirschbl\u00fcten, ein Engawa-Garten, Himmelslaternen, ein Planetarium und mehr. Atme, ruhe und entspanne mit gef\u00fchrten Atem\u00fcbungen und Naturkl\u00e4ngen. F\u00fcnf Szenen f\u00fcr immer kostenlos, keine Werbung, keine Datenerhebung."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/nagi-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "fr", "de", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373728569163387"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619685_2142048773040120_1392575141521794970_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb89GeXQWjMQ7kNvwFR-E5p&_nc_oc=AdrCi7ERtkOh0e2S0FELNtcj1Tegp7NtBzXGk3Yi2uKcB92aEnXxlGe9pfLIEZ1NJGc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMx9KvlLOkmzewwZh-woE4Q07l6xfUjbDbM_GgUPln3g&oe=6AE36B9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nagi \u2014 Meditation, Sleep & Breat
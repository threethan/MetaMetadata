ontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnNsc0jR9MnGZ7TJphtDDr4AeyeoDhH7uGm6wU3b9YrA&oe=6A9029E6"}, {"file_name": "shot_flowerfield.png", "id": "1575425590874280", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619685_1575425600874279_7513003613985302748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znNBMraVeRkQ7kNvwF0nREG&_nc_oc=AdopcU1dgE_Qu6Ep0S6Egh6--u6QJBZ3Be7ZMHnT9WPP4gQoBEGAp_rFILIkK-HQEvY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6qxVnGvIspQftdX7WuvDPJ-cgBBsg_1kwmlYvc3um9Q&oe=6A9027F8"}, {"file_name": "shot_crystaluniverse.png", "id": "1050219184223413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622315_1050219187556746_8259124061839392060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKRTq_z5rZYQ7kNvwGkxM1W&_nc_oc=AdoJKpAc1R5vTcRyn3yXlCOUvjvtYtDNQUtYFptWcS8E_Xx1hQ1rf5gYjXrCkyzu0K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH3DruljZnxURwmeHbB26yB9H0-3z7Mha-03rjhXx2Cw&oe=6A901C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1094321209615725", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823798_1094321212949058_4969062892607470542_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hE4mHxKXroQ7kNvwHspsVM&_nc_oc=AdpIjT6p8FHVJEpuSlYu0Syx_leKe7qXDjMu9qzDdkZMOnM17zwG11erF4NE7ptx4qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETQAXV4JKmbNW-4mpUt7c1zSqDFCNS6luzpjSkFhc7LA&oe=6A902A8B"}, "display_name": "Nagi \u2014 Meditation, Sleep & Breathing", "keywords": [], "long_description": "Step away from the noise. Nagi places you inside nine handcrafted immersive environments \u2014 each one a quiet invitation to slow down, breathe, and let the day dissolve.\n\n**Nine worlds, one breath at a time**\n\nDrift beneath a canopy of sakura petals on a sunlit hill. Sit on the engawa of a Japanese garden as lanterns glow at dusk. Watch the aurora trace slow arcs over a still mountain lake. Feel the calm of a tropical beach, the hush of the deep sea, a sea of clouds, a quiet flower field, a mirror-like salt flat, and a silent field of stars. Every environment is built around *ma* \u2014 the Japanese ideal of beauty found in space and stillness.\n\n**Guided breathing, always there when you need it**\n\nNagi's visual breathing guide sits gently in your view, pacing your inhale and exhale without demanding your attention. Choose from multiple breathing patterns, or simply rest in the ambient soundscapes.\n\n**Try it free, upgrade when you're ready**\n\nThree full scenes \u2014 Sea of Clouds, Deep Sea, and Crystal Universe \u2014 are free forever, along with the breathing guide. Unlock all nine environments with a Premium subscription (7-day free trial) or a one-time lifetime purchase. New content is added regularly.\n\n**Privacy by design**\n\nNagi works entirely offline. No ads. No data collection. No tracking. Once downloaded, nothing leaves your headset.\n\nNagi is for anyone who wants an unhurried place to practice mindfulness, ease into sleep, or simply take five minutes for themselves.", "short_description": "Nine serene VR worlds inspired by Japanese aesthetics \u2014 cherry blossoms, an engawa garden, aurora, and more. Breathe, rest, and unwind with guided breathing exercises and natural soundscapes. Three scenes free forever, no ads, no data collection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hypnos.co.jp/nagi-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hypnos Co., Ltd.", "support_website_url": null, "website_url": "https://hypnos.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "fr", "de", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1226853960517516"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "887257440698539"}]}, "baseline_offer": {"id": "887257440698539"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786116660, "status": "PUBLISHED", "id": "887257440698539"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1251310574738521", "version": "1.0"}, "id": "1727650671903260", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1251310574738521"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New free space \"Dream Pool\": a quiet, empty indoor pool where light ripples across white mosaic tiles \u2014 drifting swim rings and underwater grottos invite you into a dreamlike calm\n- New space \"Fireworks\": a lakeside festival filling the night sky all around you in 360\u00b0 \u2014 watch the blooms overhead as their light reflects on the water and the booms echo across the lake\n- New space \"Aquarium\": a nighttime aquarium tunnel where schools of fish, sea turtles, rays, and jellyfish drift past you through shimmering light\n- Quality-of-life improvements: adjust your viewpoint height, the menu now appears in front of you at launch, and the initial language follows your headset settings", "created_date": 1787123837, "id": "1251310574738521", "version": "1.0", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1251310574738521"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": "- New free space \"Suction\": a giant plunger latches onto the glass before you \u2014 every satisfying pop feels like it draws the weight right out of you\n- New BGM feature: choose from Rain, Piano, or Ambient music (shuffled playback)\n- Separate volume controls for music and ambient sounds\n- Refreshed menu layout for all 10 spaces", "created_date": 1786668466, "id": "1241978449005067", "version": "1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1221828074353438", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1251310574738521"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1727650671903260"}]}, "change_log": null, "created_date": 1785864457, "id": "1226862183850027", "version": "1.0", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test
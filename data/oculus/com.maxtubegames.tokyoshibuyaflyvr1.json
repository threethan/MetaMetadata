7kNvwEDtOqL&_nc_oc=AdqUxDNmNQWevUCN_PDDqywt9g0hYgoPlNxHlNCAabSEC36tQnxRFEDhMKR6cdkNJQM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEspHqQLtVuvxmvM2yRTKxve2EIPKxY5Iq2VSIF722y1g&oe=6A9178B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "covercapa.png", "id": "1541778373484765", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491820987_1541778376818098_7796083457767478142_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVsSmbPa5vEQ7kNvwEaxzM2&_nc_oc=AdqjijkS_CPK8hEummcRwDBxPuAMqZQZM95qADK0ry44MJaP7FO0KProVrJTRKXN-Nk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvXgT-v39PwyOOqsteQHk0RTY1Ypd5zmGmLhxCp06GDg&oe=6A916442"}, "display_name": "Tokyo Shibuya Fly VR", "keywords": ["prank", "tokyo", "japan", "shibuya", "sky"], "long_description": "Welcome to Tokyo Shibuya Sky, a thrilling VR experience that starts off calm and ends with a heart-pounding surprise.\n\nAt first, you\u2019re simply sitting back, enjoying the bustling atmosphere of Shibuya right in front of its famous station. But then\u2014out of nowhere\u2014your floating chair (or maybe a cart?) suddenly takes off, soaring into the sky before you even realize what\u2019s happening. The ride twists, climbs above the clouds, and drops with stomach-turning speed, giving you that perfect mix of fun, fear, and excitement.\n\nThis game captures both day and night in Shibuya, letting you soak in the city\u2019s unique vibe from two very different moods. It\u2019s not just a ride\u2014you can enjoy the adventure, play pranks on friends, or simply admire the environment that feels alive and authentic to Tokyo\u2019s most iconic district.\n\nWith Japanese voice acting and subtitles available in English and Portuguese, you can fully immerse yourself in the cultural and emotional atmosphere. Whether you\u2019re chasing thrills, a bit of laughter, or just the stunning skyline, Tokyo Shibuya Sky is an unforgettable ride that will leave you wanting to play again and again.\n{1303813848138917}", "short_description": "Take a seat in a floating ride above Tokyo\u2019s iconic Shibuya Station. Relax, laugh, get spooked, and enjoy the breathtaking view as day turns into night in this unforgettable VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klebbermax.com.br/maxtubegames/", "developer_terms_of_service_url": null, "publisher_name": "Klebber Wallyngson Hosokawa Costa", "support_website_url": null, "website_url": "https://klebbermax.com.br/maxtubegames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "pt", "pt_BR", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31722599674020053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1542913087086059"}]}, "baseline_offer": {"id": "1542913087086059"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758300660, "status": "PUBLISHED", "id": "1542913087086059"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31722832053996815", "version": "1.0.0"}, "id": "3647930022169426", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application
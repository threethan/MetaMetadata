nMPhIifeBSPjYmzZCWdpV8IKR7n72msKYECLa_1hoA0hXD05FqY_QxQ9XjSzLenp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv2DEigliNfbNycTy_Py6ILZsPZDCl6W049vuqVVwiIYw&oe=6999B344"}, {"file_name": "LIVHubScreen3.png", "id": "684892090556672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295853_684892093890005_3787526848962808357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bErJLY6dnEEQ7kNvwF_kHV7&_nc_oc=Adlzqr9ZJscAXdWcMQ6uUivOGunYKmr1hValq_cyOQpxfvMNOl8vzzyKP970YM-eEyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afur6RcdY1lGS8dpLVAcM8y3kcD0o1mQPTN1qcUtRfCCGA&oe=6999BE23"}, {"file_name": "LIVHubScreen4.png", "id": "782674757593313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623599_782674760926646_6335000739411137287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWDnrDTXfxcQ7kNvwHOxS8G&_nc_oc=Adn0E2rWyacGEE_O0G445Obi2FH2dK9OP6A7HBhc2V2fePsuen8A17pYLDP8MZXXbaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdZZSyLgSM8BG6BdSZkyIP5s4EDGkEyJp8ouXA-Y14gw&oe=6999C23B"}, {"file_name": "LIVHubScreen5.png", "id": "1923565098438371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299876_1923565101771704_6832136010787642783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2eQDHlKWMAQ7kNvwFnHR9S&_nc_oc=AdnYD2lEOEg5tdkg0O3pqunXMFrPByjlySXxZwoGlSUt4BcxO1_WRx9IOEoob5ALofQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsctSJjM91okhJC0Rc_4lDn6f5u19fF3suQ7mi1VkF58g&oe=69999F20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Hub [Alpha]", "keywords": ["Camera", "Streaming", "Recording"], "long_description": "LIV Hub is now live in Alpha testing!  Live stream to YouTube and Twitch without needing a PC, *for free*, with an optional subscription for advanced camera features!  Capture & share your favorite VR gaming moments with your friends, family and fans.\n\n{892542886675529}\n\n\u2705Free Headset streaming;\n- Stream any app or game from your Quest without a PC, mobile, or extra cables!\n- First person view only\n- Go live on YouTube, Twitch or your platform of choice with custom RTMP \n\n\u26a1Free LIV Camera enhanced streaming\n- Unlock MAXIMUM POWER with the in-app LIV camera in a growing library of supported games!\n- Supported games include Gorilla Tag, Ug, Brainrot Animals, Strayed, Ancient Dungeon, Elements Divided, Jigsaw Night, Shmackle and more! Don\u2019t see a game you play?  Ask game devs to add the LIV Camera SDK. Full list and new games are always added.  https://bit.ly/lckstreamgames\n\n{1368996694887005}\n\n\u26a0\ufe0fKnown issues\n\nYour mic might not be heard on the stream in certain games because the Quest blocks it.  There is no workaround at this time.\n\nWe\u2019re still in alpha! Join our Discord (discord.gg/invite/liv) and help shape the future of video capture, live streaming and content creation in VR!", "short_description": "Start live streaming today with LIV Hub. Go live on YouTube and Twitch, manage your stream and unlock advanced camera streaming features in apps that support the in-game LIV Camera. \n\n\nGet started in minutes with a 7 day free trial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.liv.tv/legal/privacy-policy", "developer_terms_of_service_url": "https://www.liv.tv/legal/terms-of-service", "publisher_name": "LIV", "support_website_url": "https://support.liv.tv/", "website_url": "https://liv.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
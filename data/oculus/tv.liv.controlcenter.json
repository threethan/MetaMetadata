7_4834019027433293830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuTSxDdtRLkQ7kNvwHSmPI9&_nc_oc=Adp18zzqqbF42qpOkAr5O3G4Uqf1-7AdEsmLYiBANPJWSpCLZbNuzCM95dxwAnXGTTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-_VPfkI9nHV-DKt4kkyMbxiR-Ku8cK44iqiIzOX5B5w&oe=6AE73EC4"}, {"file_name": "LIVHubScreen3.png", "id": "684892090556672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295853_684892093890005_3787526848962808357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUCV_V0ZvgoQ7kNvwE6CCjN&_nc_oc=Adqojq7yRGFBYxnA-jEz1Q7i46z-hEmbNNhSTnhU4fTmqe8pt1TjtPLuKekZecZudlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp7ImtEEhEBsecrppPxBGu3jDMqrKhAgm1kOOkBJa-bA&oe=6AE749A3"}, {"file_name": "LIVHubScreen4.png", "id": "782674757593313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623599_782674760926646_6335000739411137287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjtpsfOxhdYQ7kNvwFWcC2z&_nc_oc=AdrZ2sWmTziDt6pYu1wlA46wzvjFxfgS4Rt0bgYW5hnSJJaN2KOwgP4YAnJIWtQHMVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUzUWNe8gRWoIn9OaKSZHaVJqPUpYPYmsjzulLfJsy3A&oe=6AE74DBB"}, {"file_name": "LIVHubScreen5.png", "id": "1923565098438371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299876_1923565101771704_6832136010787642783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJUwN-RC3psQ7kNvwHtDeEN&_nc_oc=AdraaW5IV4J_3UN1u1S1Y6GFRHVT9Gd-TpnKdz3uACek5rwEYCo9xRFMYCXxBq9KjJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl21wh0J-_6YlJjLdRxpInnMc2QgLZmx2P0sRGtr29uQ&oe=6AE762E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Hub [Alpha]", "keywords": ["Camera", "Streaming", "Recording"], "long_description": "LIV Hub is now live in Alpha testing!  Live stream to YouTube and Twitch without needing a PC, *for free*, with an optional subscription for advanced camera features!  Capture & share your favorite VR gaming moments with your friends, family and fans.\n\n{892542886675529}\n\n\u2705Free Headset streaming;\n- Stream any app or game from your Quest without a PC, mobile, or extra cables!\n- First person view only\n- Go live on YouTube, Twitch or your platform of choice with custom RTMP \n\n\u26a1Free LIV Camera enhanced streaming\n- Unlock MAXIMUM POWER with the in-app LIV camera in a growing library of supported games!\n- Supported games include Gorilla Tag, Ug, Brainrot Animals, Strayed, Ancient Dungeon, Elements Divided, Jigsaw Night, Shmackle and more! Don\u2019t see a game you play?  Ask game devs to add the LIV Camera SDK. Full list and new games are always added.  https://bit.ly/lckstreamgames\n\n{1368996694887005}\n\n\u26a0\ufe0fKnown issues\n\nYour mic might not be heard on the stream in certain games because the Quest blocks it.  There is no workaround at this time.\n\nWe\u2019re still in alpha! Join our Discord (discord.gg/invite/liv) and help shape the future of video capture, live streaming and content creation in VR!", "short_description": "Start live streaming today with LIV Hub. Go live on YouTube and Twitch, manage your stream and unlock advanced camera streaming features in apps that support the in-game LIV Camera. \n\n\nGet started in minutes with a 7 day free trial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.liv.tv/legal/privacy-policy", "developer_terms_of_service_url": "https://www.liv.tv/legal/terms-of-service", "publisher_name": "LIV", "support_website_url": "https://support.liv.tv/", "website_url": "https://liv.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
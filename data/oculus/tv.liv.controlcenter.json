0_AQSJojw28wJYDiz-7w6eafGh0qZaS1YvguD_0qCrIVgJjg&oe=6B0DCF78"}, {"file_name": "LIVHubScreen2.png", "id": "756393760513864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293844_756393763847197_4834019027433293830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwgEiGu1QHkQ7kNvwHBAWeP&_nc_oc=AdpMlUFdaCbhOCmUUV0MyqyaXTBXg9D7xmC7q74ONV2w_nMCAp470o__uyvfSkIAR14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR07RYS7nm5wGQOfYlsWRmfN0_7-4KrbzGmyhg5dG9YcQ&oe=6B0DB284"}, {"file_name": "LIVHubScreen3.png", "id": "684892090556672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295853_684892093890005_3787526848962808357_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebB24uV_9TIQ7kNvwEEdUws&_nc_oc=Adob8FGtxbuC92R6zzDniHiXz70_haywc-50AwyDGj_lbKTnxqQFT3pmHsrHhbkwVTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuQBg3FyaTcc7GRrIFQ4kxFWAxL55n-xtGwgNSV7UssA&oe=6B0DBD63"}, {"file_name": "LIVHubScreen4.png", "id": "782674757593313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623599_782674760926646_6335000739411137287_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSsJbeV_OGEQ7kNvwEhL4ns&_nc_oc=AdqECLFxv3nq84cn0ny70VtcwkTcO8Pw3OHCDK9Ai6rzIdWT1XHPzPNkvNLOslJisvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyEPmKO3_UyTRGoNPq3CqOyfSB0xX5qF90YbyPwHnc1w&oe=6B0DC17B"}, {"file_name": "LIVHubScreen5.png", "id": "1923565098438371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299876_1923565101771704_6832136010787642783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tMGwLrMugEQ7kNvwFCX-cl&_nc_oc=AdqgfU5-ozPfmygb3I-kRL6rGy8USpX7KP8Fc-D8sU22XFDQSUHSX9tuzUydFlS4X-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl_TUT69RvTq1ThPr8dJsNEquHup2U2Vw2ijCHPk0i_w&oe=6B0D9E60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Hub [Alpha]", "keywords": ["Camera", "Streaming", "Recording"], "long_description": "LIV Hub is now live in Alpha testing!  Live stream to YouTube and Twitch without needing a PC, *for free*, with an optional subscription for advanced camera features!  Capture & share your favorite VR gaming moments with your friends, family and fans.\n\n{892542886675529}\n\n\u2705Free Headset streaming;\n- Stream any app or game from your Quest without a PC, mobile, or extra cables!\n- First person view only\n- Go live on YouTube, Twitch or your platform of choice with custom RTMP \n\n\u26a1Free LIV Camera enhanced streaming\n- Unlock MAXIMUM POWER with the in-app LIV camera in a growing library of supported games!\n- Supported games include Gorilla Tag, Ug, Brainrot Animals, Strayed, Ancient Dungeon, Elements Divided, Jigsaw Night, Shmackle and more! Don\u2019t see a game you play?  Ask game devs to add the LIV Camera SDK. Full list and new games are always added.  https://bit.ly/lckstreamgames\n\n{1368996694887005}\n\n\u26a0\ufe0fKnown issues\n\nYour mic might not be heard on the stream in certain games because the Quest blocks it.  There is no workaround at this time.\n\nWe\u2019re still in alpha! Join our Discord (discord.gg/invite/liv) and help shape the future of video capture, live streaming and content creation in VR!", "short_description": "Start live streaming today with LIV Hub. Go live on YouTube and Twitch, manage your stream and unlock advanced camera streaming features in apps that support the in-game LIV Camera. \n\n\nGet started in minutes with a 7 day free trial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.liv.tv/legal/privacy-policy", "developer_terms_of_service_url": "https://www.liv.tv/legal/terms-of-service", "publisher_name": "LIV", "support_website_url": "https://support.liv.tv/", "website_url": "https://liv.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id
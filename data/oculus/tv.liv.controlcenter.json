nyYqO0A2_SnGNrROvZ2si4SMvaaCEAr67FhwjQEyBlyZezSnzmOyQEBlfrmp26sRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aful_ZzVP10slW-81-D51ZPBGBhjcgzqEJ3TgU9o3todFw&oe=69A2EDC4"}, {"file_name": "LIVHubScreen3.png", "id": "684892090556672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295853_684892093890005_3787526848962808357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p76S2y9BrY4Q7kNvwHadlgj&_nc_oc=Adlg-dQC-bTp8SwUVmx2R21Cq_ZhJ3QV7osRv3OCGs91MEIWbxYs4grAOKeeEEL4aKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssPXpxp04L_yW6qKTIfKPBhoyaxTags5DrDDNld5j4WQ&oe=69A2F8A3"}, {"file_name": "LIVHubScreen4.png", "id": "782674757593313", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623599_782674760926646_6335000739411137287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D7echc-gsoQ7kNvwEtq3Xn&_nc_oc=AdkHt6fMVoWxUqMLhamWmrvfD1Pl0mPq6xAeDIAAIGttwjkvw0ShqRELxdkNsq9qn4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyTusVzx1N6lxCboLJVJHjVAsT4GVi4N8g23N0fg5UIQ&oe=69A2FCBB"}, {"file_name": "LIVHubScreen5.png", "id": "1923565098438371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299876_1923565101771704_6832136010787642783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP642vzEttIQ7kNvwGCOrP8&_nc_oc=AdmNs2Prf6xAGD4A_D9im1Fbq25Zs1AHZoII5Hq7en2HEPfZVklV1OOIFoNM_MtjyVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuAQE8GClJuL9C06EqX8GMuRP_NzY64KBGbh6a7U6lTw&oe=69A2D9A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Hub [Alpha]", "keywords": ["Camera", "Streaming", "Recording"], "long_description": "LIV Hub is now live in Alpha testing!  Live stream to YouTube and Twitch without needing a PC, *for free*, with an optional subscription for advanced camera features!  Capture & share your favorite VR gaming moments with your friends, family and fans.\n\n{892542886675529}\n\n\u2705Free Headset streaming;\n- Stream any app or game from your Quest without a PC, mobile, or extra cables!\n- First person view only\n- Go live on YouTube, Twitch or your platform of choice with custom RTMP \n\n\u26a1Free LIV Camera enhanced streaming\n- Unlock MAXIMUM POWER with the in-app LIV camera in a growing library of supported games!\n- Supported games include Gorilla Tag, Ug, Brainrot Animals, Strayed, Ancient Dungeon, Elements Divided, Jigsaw Night, Shmackle and more! Don\u2019t see a game you play?  Ask game devs to add the LIV Camera SDK. Full list and new games are always added.  https://bit.ly/lckstreamgames\n\n{1368996694887005}\n\n\u26a0\ufe0fKnown issues\n\nYour mic might not be heard on the stream in certain games because the Quest blocks it.  There is no workaround at this time.\n\nWe\u2019re still in alpha! Join our Discord (discord.gg/invite/liv) and help shape the future of video capture, live streaming and content creation in VR!", "short_description": "Start live streaming today with LIV Hub. Go live on YouTube and Twitch, manage your stream and unlock advanced camera streaming features in apps that support the in-game LIV Camera. \n\n\nGet started in minutes with a 7 day free trial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.liv.tv/legal/privacy-policy", "developer_terms_of_service_url": "https://www.liv.tv/legal/terms-of-service", "publisher_name": "LIV", "support_website_url": "https://support.liv.tv/", "website_url": "https://liv.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
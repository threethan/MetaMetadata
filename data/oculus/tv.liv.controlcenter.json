lUrsUxB-8cZPk69Mow94r3PN1e51sAyBrbWFkHLxF-tUq_TVDtb8rBPIs0WjQOt-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu1ZsjrodcC9Ax9y27t68GL0f1Uvo6F-no1nWeeUEvusQ&oe=69A43F44"}, {"file_name": "LIVHubScreen3.png", "id": "684892090556672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295853_684892093890005_3787526848962808357_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p76S2y9BrY4Q7kNvwFe7Rct&_nc_oc=Adlg9RmtKbqdwUfbCIvzhvzIDC4zW8p0EEf3ahClgTTGCr9MT6U5vtDVI5iEX7a461Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsQUVlUOhb1UssEh6H4ikS9N8bg7renkOw6dIZyhT9BRA&oe=69A44A23"}, {"file_name": "LIVHubScreen4.png", "id": "782674757593313", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623599_782674760926646_6335000739411137287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D7echc-gsoQ7kNvwH0Q9yh&_nc_oc=AdlItp2MQ5pBEjXAoFzrckZ3hyFtcsNThTKn0kF6BygPWZRb-gRU8aKed2Oy-srglqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvhLK8HyJSRz_JD2qbuWM93yS4M-ta2hDzcVAf8DAfxhg&oe=69A44E3B"}, {"file_name": "LIVHubScreen5.png", "id": "1923565098438371", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299876_1923565101771704_6832136010787642783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFpd80jjkTMQ7kNvwFRxdMP&_nc_oc=AdkdMWAsyNMElsVmRN1NwuuyDYd9lMTwqJyQ-y68K3AlBltbo_rewDq4IZgw4cguSSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsfRxIQWUYrjcsVRSx3CwNGQ2h8gOhrWeElboPIEO730A&oe=69A42B20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LIV Hub [Alpha]", "keywords": ["Camera", "Streaming", "Recording"], "long_description": "LIV Hub is now live in Alpha testing!  Live stream to YouTube and Twitch without needing a PC, *for free*, with an optional subscription for advanced camera features!  Capture & share your favorite VR gaming moments with your friends, family and fans.\n\n{892542886675529}\n\n\u2705Free Headset streaming;\n- Stream any app or game from your Quest without a PC, mobile, or extra cables!\n- First person view only\n- Go live on YouTube, Twitch or your platform of choice with custom RTMP \n\n\u26a1Free LIV Camera enhanced streaming\n- Unlock MAXIMUM POWER with the in-app LIV camera in a growing library of supported games!\n- Supported games include Gorilla Tag, Ug, Brainrot Animals, Strayed, Ancient Dungeon, Elements Divided, Jigsaw Night, Shmackle and more! Don\u2019t see a game you play?  Ask game devs to add the LIV Camera SDK. Full list and new games are always added.  https://bit.ly/lckstreamgames\n\n{1368996694887005}\n\n\u26a0\ufe0fKnown issues\n\nYour mic might not be heard on the stream in certain games because the Quest blocks it.  There is no workaround at this time.\n\nWe\u2019re still in alpha! Join our Discord (discord.gg/invite/liv) and help shape the future of video capture, live streaming and content creation in VR!", "short_description": "Start live streaming today with LIV Hub. Go live on YouTube and Twitch, manage your stream and unlock advanced camera streaming features in apps that support the in-game LIV Camera. \n\n\nGet started in minutes with a 7 day free trial!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.liv.tv/legal/privacy-policy", "developer_terms_of_service_url": "https://www.liv.tv/legal/terms-of-service", "publisher_name": "LIV", "support_website_url": "https://support.liv.tv/", "website_url": "https://liv.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
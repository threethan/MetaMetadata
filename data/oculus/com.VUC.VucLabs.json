ocale": "en_US", "screenshots": [{"file_name": "Still 2026-06-15 111105_1.1.2.png", "id": "2191570661619819", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823812_2191570664953152_5922243220561255120_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctpO1XVeheoQ7kNvwF6ZuYs&_nc_oc=Ado1fQWj2JuKqnAxzbrdTfFIOspwjJkLN4AUKTUXR__UHbkTk6mtJwelHMBucJCcK2s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqbb9WQYiobJI1XwtW_eR-DohYWoi7EMxYwp-j2JtkQg&oe=6A8EDC8F"}, {"file_name": "Still 2026-06-15 111529_1.1.5.png", "id": "2906260389722793", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/596168449_2906260396389459_6318538300435579801_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA6nPC6wg5wQ7kNvwF5jJXt&_nc_oc=Adp0qUD0WjBsFqcCn4tCPZJSbScg0kmXCWKAGEvGSA26dfgu_Vu9WgX8aW_OYHjdriM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGidLga7tgr26RH1udk5z5eFkIHcy59w5nPjrEZAyg0ag&oe=6A8EF2BA"}, {"file_name": "pic5.png", "id": "1464843245443023", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824322_1464843248776356_309606304407425801_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HSI2VRRzjUQ7kNvwF8FTf7&_nc_oc=AdqhdbeL20W66q3kMYOT1bLBV18wrjzZubC021NlLoso-0E1dzTsmtiM5kDsn1-LyHI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1m4KAl0UM58Bce847HY6w9Z7XlCdPXHBrVJlIOvwQ2Q&oe=6A8ED40B"}, {"file_name": "Still 2026-06-15 111525_1.1.4.png", "id": "2011367326158263", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825470_2011367329491596_7564521844485182429_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CbTr6wkOm4Q7kNvwG2_xZm&_nc_oc=AdrYGmQCWYBtU8JX7PMS0lD6KZ8mwXZVK_uXwUg1yZKO9xyO_meO3qf40ssAXJzOchU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0MJp59MN9X1EzXLiCD21-Tk6U1XAmZhJUZ_0AEl-itw&oe=6A8EEEE6"}, {"file_name": "Still 2026-06-15 111520_1.1.3.png", "id": "1524624979390028", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825415_1524624982723361_2733579023643581923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0EonAzLc3cQ7kNvwFFUi8F&_nc_oc=AdqOf13DtAZ0cqvsPWgaygHuy6xPLI6cQ4Yyi-vIlwbSKwUqKWoOW-bcs_1sG65jZ2A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL-EXdBikHYhZ3cpYMWh8sRSUBNLH4BfK4tlEX1onJyQ&oe=6A8EF07B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-af (1).png", "id": "889468476787039", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_889468480120372_5350091974646838841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTkKtWNovNQQ7kNvwE0mKMs&_nc_oc=AdoFNBnCyIkx8Eln6uM6KKXNDEZjV9kFkACKcMdAGMDwmNIoLlTUeiIH_EEOov30DxQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9fUAb6-4fXYbye9sBZE9bjAODIWrZNbxnxNvSpG2NJQ&oe=6A8EE3EE"}, "display_name": "VUC Labs", "keywords": [], "long_description": "**Welcome to the HF & VUC FYN Multiplayer VR Application**, an educational platform designed to transform how students collaborate, experiment, and learn. By combining virtual reality with modern pedagogy, this app opens the doors to a virtual campus where distance is no longer a barrier to teamwork.\n\n\n\nEducation is social. Students and educators can gather in the same virtual space as avatars, utilizing real-time voice communication to brainstorm, delegate roles, and solve school tasks together.\n\n\n\nAt the heart of this application are the STEAM Labs of HF & VUC FYN, recreated in digital detail. Every lab reflects the physical campus spaces, providing 24/7 access to specialized learning environments.\n\n\n\nEvery STEAM Lab contains a custom-developed educational task uniquely suited to that specific environment. Aligned with the curriculum, these tasks require students to interact with virtual objects and complete academic objectives, turning abstract concepts into tangible experiences.\n\n\n\nKey Features:\n\n\n\n- Full Multiplayer: Join classmates and teachers in a stable, real-time voice environment.\n\n\n\n- True-to-Life Recreations: Explore 1:1 digital twins of physical HF & VUC FYN STEAM Labs.\n\n\n\n- Custom Tasks: Complete unique assignments developed for each individual lab.", "short_description": "Step into HF & VUC FYN\u2019s multiplayer VR application. This immersive platform brings students together in a shared virtual space where collaboration meets hands-on learning. Explore digital recreations of our campus STEAM Labs from anywhere. Work with classmates in real-time to tackle unique, custom-developed educational tasks tailored to each lab. Turn abstract curriculum concepts into interactive, team-based experiences."}, {"images": {"nodes": []}, "id": "2117218468834684", "locale": "da_DK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VUC Labs", "keywords": [], "long_description": "**Velkommen til HF & VUC FYNs Multiplayer VR-applikation** \nEn uddannelsesplatform designet til at transformere, hvordan studerende samarbejder, eksperimenterer og l\u00e6rer. Ved at kombinere virtual reality med moderne p\u00e6dagogik \u00e5bner denne app d\u00f8rene til et virtuelt campus, hvor afstand ikke l\u00e6ngere er en hindring for teamwork.\n\nUddannelse er socialt. Studerende og undervisere kan samles i det samme virtuelle rum som avatarer og bruge stemmekommunikation i realtid til at brainstorme, uddelegere roller og l\u00f8se skoleopgaver sammen.\n\nI hjertet af denne applikation er HF & VUC FYNs STEAM Labs, som er genskabt i digitale detaljer. Hvert lab afspejler de fysiske rammer p\u00e5 campus og giver adgang til specialiserede l\u00e6ringsmilj\u00f8er 24 timer i d\u00f8gnet.\n\nHvert STEAM Lab indeholder en specialudviklet uddannelsesopgave, der er unikt tilpasset det specifikke milj\u00f8. Opgaverne er afstemt med l\u00e6replanen og kr\u00e6ver, at de studerende interagerer med virtuelle objekter og gennemf\u00f8rer faglige m\u00e5l, hvilket g\u00f8r abstrakte koncepter til h\u00e5ndgribelige oplevelser.\n\n- Fuld multiplayer: Slut dig til klassekammerater og l\u00e6rere i et stabilt stemmemilj\u00f8 i realtid.\n\n- Virkelighedstro rekreationer: Udforsk 1:1 digitale tvillinger af de fysiske HF & VUC FYN STEAM Labs.\n\n- Skr\u00e6ddersyede opgaver: Gennemf\u00f8r unikke opgaver udviklet til det enkelte lab.", "short_description": "Tr\u00e6d ind i HF & VUC FYNs multiplayer VR-applikation. Denne immersive platform samler studerende i et f\u00e6lles virtuelt rum, hvor samarbejde og praktisk l\u00e6ring m\u00f8des. Udforsk digitale rekreationer af vores campus STEAM Labs uanset hvor du befinder dig. Arbejd sammen med dine medstuderende i realtid om at l\u00f8se unikke, specialudviklede uddannelsesopgaver, der er skr\u00e6ddersyet til det enkelte lab. G\u00f8r abstrakte l\u00e6replanskoncepter til interaktive, teambaserede oplevelser."}]}, "developer_name": "HF & VUC FYN", "developer_privacy_policy_url": "https://sites.google.com/vucfyn.net/privacy-policy-for-vuc-labs/start", "developer_terms_of_service_url": null, "publisher_name": "HF & VUC FYN", "support_website_url": null, "website_url": "https://www.vucfyn.dk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1967475070578903"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1008289708234520"}]}, "baseline_offer": {"id": "1008289708234520"}, "is_approved": true, "fir
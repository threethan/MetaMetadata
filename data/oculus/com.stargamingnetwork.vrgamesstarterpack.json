ohc=fIE__YWAuecQ7kNvwEZpD3t&_nc_oc=Ado5txz24UKwsVx3q9S3o3RSE-TUnirHE0gdRz0qS4ab7oLiB1q910MCCf0oE-aWm0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9qgivKsYmsb4iYmvDhzZH1AMk7ZSAwGwnPXAAAC0OlA&oe=6B05C823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/afEG4y", "id": "2652702094790999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982591_2652702098124332_2119530630743064576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE8rl9m0bisQ7kNvwGp-E4W&_nc_oc=AdryGbh4NCSPSYmSvNZ-XeXbHRY3KWenbfum5n6DYf8WzsrzCXFVMcBxJfeCLLKS7ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDykYOMjFZwAYDy39jQYjpRHZWv5_dqAsP8GAeQ8li6Q&oe=6B05A202"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gamin
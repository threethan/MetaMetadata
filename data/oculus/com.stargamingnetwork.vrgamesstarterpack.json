ohc=lCTezvyrIgAQ7kNvwFvQdHE&_nc_oc=AdppgweOpL_JHo8iKcJxiXE83_DDmqXOLmf9NNx3z7W4DubHl9XlWh4vGo8uZQ22j2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM69X5JT7VBuNjuNCK6hJAg1vA3fjNmEvnLpUbY1aMxQ&oe=6B01D3A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/afEG4y", "id": "2652702094790999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982591_2652702098124332_2119530630743064576_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LLsud8F74wQ7kNvwHXiDDb&_nc_oc=AdoTXa07baSWn41XNCCCHP8Eq5rrV1vnDBClxI-6b9F5b70DOuMCDSSEUiTsZqP-cQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf1d4szdbaGX9CDxJjajgfGeot0u4As6WejXBjM5Tsvw&oe=6B01E5C2"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gamin
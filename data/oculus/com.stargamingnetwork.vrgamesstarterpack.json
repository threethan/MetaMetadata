ufVAA1UG9BzjqDJPkkdD0y_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvWuSUr50hFU3wU7uGrSD5FxElvexvSCuB79jKMuU5lQ&oe=69B413BB"}, {"file_name": "migrated_image.png", "id": "505166463705129", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_453538918804808_4017985177203507200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05TgMrLxwxkQ7kNvwGMbgj0&_nc_oc=AdnKHzXoq4fBxgWdQWCWk2fWuvZ2ZX-pkBikoSmB3CgE-udRxIiKvmWP7xFjKXv36bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynLQGavsQ8e9xazs-VZXmctBd-lnHsGlKzgxncbFj4aQ&oe=69B40088"}, {"file_name": "migrated_image.png", "id": "205133557443443", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974656_456307444931794_231579766107406336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBSaP9tt0J0Q7kNvwHAozbT&_nc_oc=Adn0b23Lsh2bwyDQiXwAmK4hFZtj6niOfTYCl8tpkjcqSAV1QLhnh-VUmrv8mZLvf6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxQKUaYQ65GeB1N9bC7yMEk2MoWFPzkjfoZScLVc2mVRg&oe=69B40FE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/afEG4y", "id": "2652702094790999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982591_2652702098124332_2119530630743064576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuGS9_P8FU4Q7kNvwEegY5O&_nc_oc=AdkyaGPIblP2jeL5y8ffMTarRrmi13c64pHvSz6VyZlZyvWIB-tyfTqDNRlVycHgL0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfytgRPHUHH7SOLHAdtMkSHvHoXdmV6cvDYQKZo6tWdmyA&oe=69B42202"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", "website_url": "http://vr.sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1508958769504427"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2346229562163325", "version": "1.0"}, "id": "598865813949482", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
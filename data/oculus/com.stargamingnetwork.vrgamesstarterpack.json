-ord5-1.oculuscdn.com/v/t64.5771-25/38982591_2652702098124332_2119530630743064576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuGS9_P8FU4Q7kNvwEegY5O&_nc_oc=AdkyaGPIblP2jeL5y8ffMTarRrmi13c64pHvSz6VyZlZyvWIB-tyfTqDNRlVycHgL0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfytgRPHUHH7SOLHAdtMkSHvHoXdmV6cvDYQKZo6tWdmyA&oe=69B42202"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", "website_url": "http://vr.sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": 
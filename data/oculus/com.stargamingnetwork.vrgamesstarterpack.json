_nc_sid=6e7a0a&_nc_ohc=SO8IVnBI0XgQ7kNvwFfS8i3&_nc_oc=AdkoDBDeZePC0CQV2LyYhJGkRyx2D68UuUWa8n8_2Iu_2eZ5vigRaXAKRUPUsmnqE7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvvEHMNhMrs08PlYNgzq0GZasTORIs4ZhkXypnEPd6p_Q&oe=69987282"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", "website_url": "http://vr.sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
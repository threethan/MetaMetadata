VskDXHoozdcWdpHx8etCxILc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9gU-aZ-gEPiTI57Zbu440U1fBIj-FMwOaQeLFg_M2Xg&oe=69B5653B"}, {"file_name": "migrated_image.png", "id": "505166463705129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_453538918804808_4017985177203507200_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05TgMrLxwxkQ7kNvwHanV8y&_nc_oc=AdkrZYWMjqQoDsXATxuK490VOctIEPkG88iJ41q_RCSVafEVl1iWc3zskExa5Jx_Vns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwECWRfOZLwa_EdADz87hDUAGuJv95iMJdK6l2BTrQIMw&oe=69B55208"}, {"file_name": "migrated_image.png", "id": "205133557443443", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974656_456307444931794_231579766107406336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qov9yXhe7loQ7kNvwGG7mHb&_nc_oc=Adn6x-NFLkKoVlPi3ccTTRQkr85c2zT4njtv9N_ILVo7VUiJoMshTh-3y4wRacSoU-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtz_LT8uJS91PvC_9WNBXz7eK0rGm0fAJqIJEG1YLZVw&oe=69B56163"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/afEG4y", "id": "2652702094790999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982591_2652702098124332_2119530630743064576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsQSufEiETcQ7kNvwFcJdYB&_nc_oc=AdkKZ7g83I7DNGkrQ-vrVt00NdU6SkXyhGgJkRazGuTIWefuKgpRD4o8xpg5eo__FG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWxB0v8gR7-Ewp0PP7gKl3pekdTU4wDjFrTzpfs3G6Zg&oe=69B53B42"}, "display_name": "SGN VR Games Starter Pack", "keywords": ["Maze", "Zombie", "Shooter", "Space", "Basketball"], "long_description": "Four games to get you started on your VR Journey. Perfect for new VR Gamers, or even experienced players looking for short round competitions.\n\nSpace Flyer - Fly through as many gates as possible until you run out of fuel. Shoot asteroids to gain more fuel.\n\nMaze Runner - Find the treasure chest at the end of the maze in the fastest time. Maze is different every time you play.\n\nZombie Shoot - Kill as many Zombies as you can within the time limit. Get more time each time you kill one. Zombies can only be killed with head shots.\n\nHoop Shots - Get as many Basketballs through the hoop within the time limit. Get more time each shot you make.\n\nNote that though you can play the game standing or sitting as no walking is required, Cave Runner may not be as comfortable to all players as the other games are.", "short_description": "Four great games to get you started on your VR Journey!"}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", "website_url": "http://vr.sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1508958769504427"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2346229562163325", "version": "1.0"}, "id": "598865813949482", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
luscdn.com&_nc_ss=7f30f&oh=00_AQRzBUJtvft8ZWmD24rtVv7DFvoucG9AhW1UHOFaL6uO7g&oe=6B0DA09F"}, {"file_name": "04_surfaces_mats.png", "id": "1884742616029052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842279_1884742619362385_6753468846774349676_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9RhYS_uYWMQ7kNvwEII_nh&_nc_oc=Adr5cLTm76JKTn4pWc8UR73dYmW_lVMV-Gd5LsrRofpTBvP0D32PrzeRE6LS2fowJr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9HbzDJob9QyFGsF2fDlys2o4asoB5UbGggA4HleuzAA&oe=6B0DC000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrueScale_Trailer_Cover_2560x1440.png", "id": "1797218425737389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908835808_1797218429070722_8264862225625725446_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SADKglnlwAcQ7kNvwGpW_oh&_nc_oc=AdrltO2ub9EoNP7q0ShduJjsWRyWnlFPEmrLL0XkaBWUV2DqnxaEqu5-jDjGvcz40Jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVs-bRj1EOYLQ-ORzvTt6fQCHMSusbPGGNhTCwjraD9g&oe=6B0D9D0F"}, "display_name": "TrueScale", "keywords": ["Printing", "3D", "CAD", "STL", "prototyping"], "long_description": "**Stop guessing. See it at real size.**\n\nWill the case fit the board? Is the part too big for the shelf? TrueScale puts your 3D models in your room at true 1:1 scale, so you know before you print, cut or order.\n\n**From your computer to your desk**\nDrop STL, 3MF, OBJ or glTF files into any browser on your Wi-Fi network and the model appears in front of you, at real size. No sign-up, no cloud, nothing to install.\n\n**Built for makers, designers and engineers**\n- **Hold it in your hands.** Grab, turn and place models with your hands or controllers.\n- **Measure anything:** edges, faces, holes, even the gap between two parts.\n- **Look inside** with section planes and CAD-style hatching.\n- **Work on real surfaces:** turn any table or wall into a graduated cutting mat with grid, protractor and snapping down to 0.1 mm.\n- **Test the fit for real:** exact collisions let a 20 mm pin slide into a 20 mm hole, while a 22 mm one stops on the rim.\n- **Pick up where you left off:** saved scenes come back to the same spot on your desk.\n\n**It feels like it's really there**\nReal objects and your own hands appear in front of the models, so every part sits naturally in your room.\n\nMade for Meta Quest 3 and 3S. Your computer and headset need to be on the same trusted Wi-Fi network.", "short_description": "See your 3D models at real size, right in your room. TrueScale places STL, 3MF, OBJ and glTF files in mixed reality at 1:1 scale, sent straight from your PC's browser over Wi-Fi. Measure them, cut them with section planes, lay them on graduated cutting mats and check how parts fit together before you print or build."}]}, "developer_name": "nullByte", "developer_privacy_policy_url": "https://nullbyte-site.web.app/html/privacy/truescale.html", "developer_terms_of_service_url": null, "publisher_name": "nullByte", "support_website_url": "https://nullbyte-site.web.app/html/support/truescale.html", "website_url": "https://nullbyte-site.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1869881591033083"}, "review_messages": []}]}, "cover_square_image": {"
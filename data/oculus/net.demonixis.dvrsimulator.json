dn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjQt492a4I0Q7kNvwGBi5Hl&_nc_oc=Adq_htcl3rxy118LIf4Q6xqhfgpZYXMYIDCp_Gk__8fkKinWqCv71L0O9RP_qYxd8xE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NJUpcc9klCg9G4EECcX_HFbD58gzE0dLbdnSkfExAsg&oe=69FDEA9B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZcFmcROpjsQ7kNvwFpO6fh&_nc_oc=AdrVYoPRu9jzYB5XrEjH-yhsMt6SjFl_qSs9eym2P2bIe6KjWKgFEwWNUVEMxOFC-uw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e5vUgZujuoXMsSkEplVfrImksD1Y_RQVur_kSJ065kQ&oe=69FDD5F6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FX7jTLPKgzYQ7kNvwGkmDMX&_nc_oc=AdonPJkd9ZAYyIorjanzyYCcl0g2_qW6Z_Ov27sqXzlYMFqJAhvejo-MEQRGI1qPEmk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bmbUq4LyzIpyJ52sEeycGBa1mybPtHcVBw1dAkPT-2Q&oe=69FDFF91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht5kzQ7_ikMQ7kNvwHcPr--&_nc_oc=AdpuIk1JlAggDfAvYO2L804arJxOh3Lcb2-Uk7Zyp4nCwGRVy4IN3eQ1AdmnrDV15ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IJ4m4cTP44ReXuuQzQogg_6JgCUaEgnNpMA10PXbz9w&oe=69FDFAD0"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624
4fGTOvFpBH-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdC07FBaR2C7jznp-O81eLFvpqunj4BIe1x6doMxGdbw&oe=6B0B1907"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7CZLfYddE4Q7kNvwFCMoF5&_nc_oc=AdrZk9mHPIlV8B-O0qJrAeZB5VahZHOeI96Lc1At9syBs-4lmVceP9z_hyYk2Z5ceuE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuMeuxKBlUS4G1e5q3CAzd0H-JDknPsziS3YekqKuOnw&oe=6B0B14DB"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWYKbCYZjaoQ7kNvwGy9MfX&_nc_oc=Adrvmqka6eUCwbuEiZd-vAVENLsyZpck3o-Ly43QhQsIVT4EUcH2JahVX-fJctuD94I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEPySN7ui0HsfcnyFTonUeLOHn8hDbYWe6w4yHageSIQ&oe=6B0B3876"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8__pJuaO7UQ7kNvwHbD_s1&_nc_oc=AdoPMKX8MFccYniem8CxLELd5F05slxoc2yoifEuCeMn76KE17BJgCvcSKBe2zCkRTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHqh5yhCEgBlfiZSnYU5g4I2pUWy51ZvKXp8Tpdq4_Kg&oe=6B0B29D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-efM3gwVlzYQ7kNvwHL8zvR&_nc_oc=AdrRs8ESIXcEinD-zLGhwNKptYEHBnQF7uYiXredcnwP4ye616MpBdJPJJGqNttd9YQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSceqCwd3JHYEdsIkf47sXSQoAOQnUR2dOiE9bjvw1naw&oe=6B0B2510"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
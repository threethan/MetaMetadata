Oe4N6rm8SNYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-ah7j7khzJ9U4MHNF8o9evBMWzRDMlrk994gFudnVdA&oe=6B05D307"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lQTDakLycwQ7kNvwFEioIH&_nc_oc=Adqsyamm9Q2QdYwBz_L2jKRIkqhZGWCtOrZsjxp4r_0zYFM_NnPr_xW96BDgz5UUdxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnONBu9xx6xR8iH0iCYRdY-EzsJi_bLFXm_93d5Y-RuA&oe=6B05CEDB"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7NEFk2PcRUQ7kNvwF-Y1xJ&_nc_oc=AdopOhbtla834TMGPRan3M4mUoRJWlkS3nK5CKoDhFFqx1ieGdAGY8gqaE_bB5QEVGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaKi--6RET_0rBuTCB7NXTxnpO18xu0AjDNnYXoK8kKg&oe=6B05BA36"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fYDojqYo3AQ7kNvwHb0OD9&_nc_oc=AdqEnVL3XZkciDvDpBniTrB7fwk2k1HD9die2uwTL_EzgIGMP8idEJj23E0maQ-ThZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZEdrLDVsWLImvIM4iDQYuliYbQzfQOUAknv3_UIRCcw&oe=6B05AB91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLQsTn8jR0oQ7kNvwEPIDOi&_nc_oc=AdpWMeyOTYWn3K9biJFnZ1RQugrzgWjULmvwmPD5BXQSelCp4vNB_v4qI4Z08Beg4Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA2TEJDKzk6t8ID7ZsCBbkTLsayF68up9HgDrrnWD46g&oe=6B05A6D0"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
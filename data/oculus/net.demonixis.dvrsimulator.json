dn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mO0vJT0_IQQ7kNvwGBZ-Ot&_nc_oc=AdojWcQhYONZy8ygNTujx7bZyy4hCddnSKa7rbiunRXOkK2G0Ugk-x5vfZ3ZIlV3Jpg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5K-_kckGsfLYyd8QUPGZGnHytxRYQCpn9pKVvpSBqAQ&oe=6A91929B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roq43xpOMfoQ7kNvwENvWgL&_nc_oc=AdpaCzhFMDWMUt5-tS6u1dPvClChXk-EzvQHrtOeje6R3gnxPYdzKKu56aVa2IdBOtM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYot0xlNWXdKffT4Sl-YWHLPAe9PFKXHOp_jCy7oyfVw&oe=6A917DF6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VHj8abuTmAQ7kNvwEZHMJK&_nc_oc=AdqCmLSyPTODHr4p8R8QycoAMAjavvDYmVwv93bJzlpP-Yg7_Jssv5wiiRFrx1owFZE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjaOOoCMYBdb2EnbbC9R9Nry-IiVhrx1OaDoY_139dDA&oe=6A916F51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWAHeecatS0Q7kNvwFPXqSx&_nc_oc=AdrWOr46Cy7wcx8Kt9jEM0XfTr1VA7Nk6HSojs4DDV_pcNgV-Mb5KYRORIIHZgNZKKY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLUijBpuadgm2jif1Sy-idxhqc9vZ3tSkIRdRJV7CJLA&oe=6A916A90"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624
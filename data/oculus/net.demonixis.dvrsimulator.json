Nwp8QRRUV07k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8glhxWmUfQGOxcRe3FKbN42md29vH4oDebnelu9dLXQ&oe=6B105F07"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ2AX1v5_O4Q7kNvwG8oBEz&_nc_oc=AdoOQJBXmfgO9-d0Ez1RaPxW8A5cwU9jgwr-lmFZ0Pu8RVCriMnznxWNcQYWZwY6d6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXE3RzO16o42VIa0H76UhUb0RN6AY1Zq5G5jPR71V6AfA&oe=6B105ADB"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhSxMQhbt3wQ7kNvwGa1x-R&_nc_oc=AdpKEYaSu5v6cACxRgZAUi5nQrklP-QBFe4134j9vygH679eLiSqSCcCGl9uS85hEyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9pqewgPmtI8goEIaVfVdafPKR9LUiXUs8rB6gusmfeA&oe=6B104636"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o26Po_T2poQ7kNvwHYTYWN&_nc_oc=AdruHinKf8ECxBjNg8z6vx1O4C0wtn0ZXqvYEii6u88T8o7qcrq7fdcGoCAs464V0do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzSeK5DQQdHJM06C92pBbR87H1bd9EdF5YxDUpVO2P9A&oe=6B103791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJmdf5FhI8EQ7kNvwEOi1UN&_nc_oc=AdrnCkP-k4QOtiSRYdbzwpQlOmGcw6G-9vPZz4bIRpEr7Q_Xl3RshzmKt3VZjH2iGPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVVIfRR8P-LsVHIJuT0JOmVedZpbsJA35oRr6oAaMKBw&oe=6B106B10"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
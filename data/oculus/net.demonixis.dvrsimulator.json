1480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYwNv_KJsjoQ7kNvwFCD3KX&_nc_oc=AdnabMJQHkvoUYPaB6hGjy6KfoCVS3pt-c1eYj0B30OgeGu9K-LZLjAdaJqDlfzLjbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfugXMyhz9oZalC31qzkkzYvdnv8eJWyZaHD2jhpVcZc7A&oe=69A8391B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk2_DY5n5iIQ7kNvwHrVw3O&_nc_oc=AdlnRf_sm3trWhQY2dQelY9oqoSOBBrECX3LragO29a-02YRp-GsNSDNoJaEgCMzrjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftGbs6xWpqtJr5sU5CYdHWxTl4sm9XgEQL3fC65OAKC7w&oe=69A82476"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkhS6MWIJaMQ7kNvwGnkdRm&_nc_oc=AdmaYXnKyNL0VignWIXwFRQENV8CUGyNqkSIc1GcTCJQ6Fyk_pwWJzawtyoLrOAzBco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftjMi9WAVQtdPf7IcD96fcp3uQec1eYgazrtwIDw5djOQ&oe=69A815D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QY1hUbBpFQQ7kNvwEoZug2&_nc_oc=AdkKPtv0tTHSglMybVSzfVUdnKQCB3TXxNP7vuv3iV0WkOU5k6QeYXvrNtX6tqMmD3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuzeoahLUF-a4_urRHcjPHG_T3ZqwZ6s8HnUZlDy3crRA&oe=69A81110"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_
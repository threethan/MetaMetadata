JvoxySPagr1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPTvIDHaMXEaJB6q0Y9jOxwXFXI1R9Nhvp7TlPmN8buA&oe=6AFDB1C7"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUZUUrqZmngQ7kNvwGiT6oX&_nc_oc=AdqTWWMqzl_BQh6Lq3ZOWZKCDnyBeOcXrvL6loDMta33FXZXtpvyhVq2ADh85EjKGKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcSzrLa6hOkUw2IpEwTnvF_82cD3C0ohQnhPEIq2zAQg&oe=6AFDAD9B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E851TKxMTvYQ7kNvwF6XaeW&_nc_oc=AdpTY-2o1V9W3Hj6Q234hG_KRlVwx8fim5SDtgkX-bg9o13vCVRsiyWT7ef7wtzgtE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNrhGILB0eIujlkb1HXfwaEYST9N5fMzi6g8mKPlA-FA&oe=6AFDD136"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwHU4Cos43EQ7kNvwHh9A6k&_nc_oc=AdpfSI_0N7GkiH61FGrIP22UtQCogfkkfGBnRKOv-pFGlRsWhywwVE45K9mNr7Zn2vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV93QmofYBi8U4BZKXlQtYsNOKpYXeAKNQbeA5coERqA&oe=6AFDC291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWuyWNeKXc8Q7kNvwHhDIaT&_nc_oc=Adrk0rmKFidtb4wxEp0FPO2H12ecmYIwxg4ERg4zdR8xSdfMltLalXD4GWR5t1hrEps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMTCpTN_rqixUmHCE9aiXfkuHi9PUQ5SWrrs1IUqIdDw&oe=6AFDBDD0"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
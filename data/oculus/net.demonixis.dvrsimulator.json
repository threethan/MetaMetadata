nsC2jtvq-pAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrV6JWEF9Gu0rQ1_DZDDTidv-XCTBengbur98iecpXAw&oe=6B0F0D87"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ2AX1v5_O4Q7kNvwFbMZ_g&_nc_oc=Adpq2Qsoyd1PdsmExoBsI1d8VAN4Kp4fMQzb6I2vPA4kxNpfd3MOxGEfyFFNnlaDutE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7nxiSPSpTgkBXXeupoAoGO171NjNPZsaMEmNXDkRJJg&oe=6B0F095B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhSxMQhbt3wQ7kNvwGPHJaD&_nc_oc=AdpCELrfNnaverQEu3RNYJIwL9zr_r1n9pRksaEgOgytor8pNx7wo2KNBlegHpsrkyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5Kzzaxoc8tKPwbDcUlxOJjHwlWeTjrmRfKxQHwuqu0A&oe=6B0EF4B6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o26Po_T2poQ7kNvwFo9toe&_nc_oc=AdqtxE6BNKXnoo7HkeiRp42LPRkABAjvcGBSgIOmU_8SvH4j-hI91GlSTjljEugHl3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdeygTocWh_-Skkdrd04rTMIexmn2GR8f-DQYDf6RT1Q&oe=6B0F1E51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJmdf5FhI8EQ7kNvwFms1LD&_nc_oc=AdqGkgKRvVkLEWYnaR917y70-E5c2Sbj31BoIP1Xdx2qLF1F_iMdm2yURoT2J-ZkoZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVf6yYLjgquyY8L1GI4qUpxk4ZomPCNBVPxdXEXorBJTw&oe=6B0F1990"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
dn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3wiPC_OY3sQ7kNvwFGjxUZ&_nc_oc=AdoRexcQd6uwJFgVqzi5776z_FMbnFMj7s4fXkMCN47xCJiLJGdX6iRt8XEYW3goS_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6I-w2nBt3j-IKbcZVze1XL8WnfNuh6GDfQiW3xaj-gQ&oe=6A75E31B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygicrsSOydAQ7kNvwGqL_jC&_nc_oc=Adov9pdE5pPhPX5kEgS7zdXrkZAdh3pml4fuB29APXlvaS21lndrBekICgvZcF0RF84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdIUd409oHssJsN1n19kHXNYjXdq0OjruRTn7YS3tAJw&oe=6A75CE76"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tziGse3Id7gQ7kNvwGd9a7G&_nc_oc=AdoMgJNfVEFKmAu7w7tkM2zz8omjljLxLra_VwIKk4JbtFh2dKNHgHZJtyWpwuNzASA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzSbjDmplatMTOXOL3CB94tbKbrIUkC14cUy6C8m2kkg&oe=6A75F811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwfWDeKZRu0Q7kNvwH_VvGM&_nc_oc=Adoe2HE0ct-kA0qOVcJOfAW7R-nSjvlJ3C12HADuH7-f0kvoDTkBh-tlZ4N338X_n_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsqMSkjP55O6gQW461OoahD5xip6o7vZK0qJ2Y9s9c7g&oe=6A75F350"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624
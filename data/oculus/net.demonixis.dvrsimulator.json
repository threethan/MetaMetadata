7&_nc_sid=6e7a0a&_nc_ohc=_aEEGHF7ZjgQ7kNvwHYgrKD&_nc_oc=Adqfn6kR9p6NiwZL3b1Xil4gN-0_nmDMpjwU335pyOoaKW_5b3Et39XcJV2Qy9twcJE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1TQhwlu5Ijat5B-9I7ZPwS9AN02cNoPWTFE1Qgey42eg&oe=69F20D1B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd06UnSi_WoQ7kNvwF2pW5h&_nc_oc=AdrsPxkLC9OCdyIuvlF2UHB8hYU0Zhzl65igw88SMjgcy3ddUjA7FJsDm30ZUl-KkqU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1q67Kbtd5f54GYnOJUZs9rppt5t0Y91BkZWFWlWyD4Ng&oe=69F1F876"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRhTLvcEYdcQ7kNvwE4IIfE&_nc_oc=AdrFUarqct1p985JsdDZC5_sKH4cvdIrhMaUzSFYrrRhKIGNAUEqM2IcBhmOYqO6KUU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0lvb8zWo9AMtvyIzNvHAT66_OF7I_FoixHnN35ATpkRA&oe=69F1E9D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4_TykdYCHAQ7kNvwFuL46R&_nc_oc=AdrPNC25HN3UR2zqD61G_c3xq8UvfDLi26I3O90onwZqthPm6V0wmib_wPNkJuKcKbU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3sVW8MuCNuQ9hAlw7bpyofP8aDW19U6L8bmIgTya4cWQ&oe=69F1E510"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEyT7uWe9HQQ7kNvwEdFemU&_nc_oc=AdoMp0e3oJvJl6aKbTV-_mcDXlQBYTyip3RvyV
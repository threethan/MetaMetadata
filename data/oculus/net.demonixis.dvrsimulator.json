LSqIUwtXeEA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsNrYBkEPBMtF1Jx8k3i-rwqN4z3RlGX5MesYCfx2p5Q&oe=6B01DE87"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WbyvXHQqH0Q7kNvwFWbOyG&_nc_oc=Adq6m-5VYwS1iZ76Y-zM2RckwD5zSUh7CCXxv6XNt9ZAUbkyRvTJjEJTYFGDltlBEA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaWlPfaypw_GPnJ85C24v-O7Vx1zfazBn60sOIPcRCvA&oe=6B01DA5B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1jtvjFKBgEQ7kNvwFSjYPM&_nc_oc=AdprLEwCFeStVcel4yL19xfipd6tZSc_jodpsoLTot9yehEhZ2BjPihYCfhJvQAeNyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY9_pdjp0InAgO6U2C4ccbn42ya73pDQZcSzaJkk7B_A&oe=6B01C5B6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9OTFrDOK88Q7kNvwGwrRAC&_nc_oc=AdpeQL_UjKUqZ5FWbESh_Rbrfu7_27GN6rZ2qtKufa65He4smWPz5S4X5x9NQgD_lM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4ccuj_lIR0Hw9dwDDILwpOHWE3aG3nJILnNqzT9xaQ&oe=6B01B711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WkKKjyWyTAQ7kNvwG1O74Z&_nc_oc=AdpNUhAKyGSd_GE0gEZ12Vadbabt-n5W4kfeANXDppx4o7NeDy0tE-alBmObsXbOThY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP-NlotUGEVYa81Tpbvnif3ULmHB8Cq95-ue-RFZXEKg&oe=6B01EA90"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
dn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_OxIv7wqoQQ7kNvwFG18cC&_nc_oc=Adq6FMAiyfecin5vO-y6Uw5Z8Pl4S5z92VBI7SgiogaL5JRviIjFWbREjrnUpVZaiYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0EUta_LXAENRmvgmqGWG-3dbKZrVe_GNW_4JYdfFjDw&oe=6AF89FDB"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAgnGE1mLaAQ7kNvwF1BseH&_nc_oc=Adr9do7ZTfQN74vxRRxbrW9o25TMMmX01d8ajas5ha_iRB9jxa0F_M45Dmzy74pc6WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZW4hlYET3zfab3mILKAk2oBvPcGGPqrmftgTfbGlSGw&oe=6AF88B36"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08FlzJiAp4UQ7kNvwHp8iZn&_nc_oc=AdoUuz8zY9EUsNDTKHU6_TBMjFCrJF0zfnqrYMN09OSfhsGEiwDGIWFZPusr1o2Jcx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmVPXYWWBAGUKrBBudxIoo9wbpahMj7JppaS8DQUoIPQ&oe=6AF87C91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBg9-IOuM7gQ7kNvwEVNY-D&_nc_oc=AdpURxAmSm_DzX68cAJuDhFl0uRkSEYlvmTP2gSnCSQURcqJS2D1U_Lu1BQBeQxaZLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXrsWOIIrSTlWQcjlHaOBWAk1K2hxwPtMC83PeCxfSgA&oe=6AF877D0"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624
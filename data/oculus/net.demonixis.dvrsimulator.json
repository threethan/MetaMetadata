1480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr_yJoHnVLgQ7kNvwEfuZc-&_nc_oc=Adkb5HxcVjQeAWLFln7bXn9PElPItsMRW3CdIziEb-N2zmO8o6hUXPo3Vy-AOrmDLqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwN0U6Juuj8CRTM2sVoSotZYEgrnkiu-_GbiBzxa5pCdw&oe=69B95C9B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh-lThzOswwQ7kNvwHl_XSi&_nc_oc=AdmiQezPRTGFyzSPDiMy3WO6Xz8mTzQrUNBBgGcYLm2g_7IkIT2UthAIDWNsVUXEqNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKXHDJJomCVXKzMg7lm13UfW4A0JxPrqKrOOhxyeu3_g&oe=69B947F6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AUSvGir6GMQ7kNvwH0P5KM&_nc_oc=AdnU82EomBUD-h8Vk1rDlbiqUiN34IXW2dAWYnv6zqqrpS2-2qNDj7c0jOPhsBWjhbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCgO1VDdAI9b9GidnE-2HLSr4mrrXjf2Aky7C9pXuX0w&oe=69B93951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vKPojx1DdIQ7kNvwED99hC&_nc_oc=Adl1yh7COdRYAJgkWcc8Sz8ylZW7lo9fFt9P9bOeXPS4S8Xky-Mn4rReBqA22O8KGbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLoQ4r96sR4GW8GyfoEekMZ5gSx1WYdkhUcA1SC4RAYg&oe=69B93490"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_
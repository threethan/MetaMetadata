680915396222_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIHS3QlhQmYQ7kNvwHZZr5z&_nc_oc=AdpBPPgHrWClPawbRORO9wQWpBQk_FM6XmeK5FQaWJtSLVS0lmdbllP3NGhEvdcvqJk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwiUswOis0OddrnXVMCItbscHPskbuVd7-i2ihvAXiVg&oe=6A8D73F3"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwMqQnidsUkQ7kNvwGr4Y3G&_nc_oc=Adr_IobxQ-adHL4SvndoKVGlPutBeHueeyDxMfWBKLTidM7Xo1NVhImkxt2yrHur8PE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2QfE3hvlFcN005GfZZzVLh53ioBwjDReToJA6dNQRxw&oe=6A8D7AD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available.\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534
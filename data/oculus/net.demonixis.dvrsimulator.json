dn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMBOVbIuLN4Q7kNvwFonQ-2&_nc_oc=AdpDLhxdkG2LFMS-KGY3JWP6X91Un6eLHqJS_gWnMChhzUCsLTfZ3twX2TC4cFr2Moo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ln7Fao8BSQShD_38xLfMV6VXRxiO5VnAtKAbe9SZ4SQ&oe=6A1C3D1B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDJzd_rwQzwQ7kNvwEsKiEi&_nc_oc=Ado9JSuE0x7xgeJTGez8LSle7af_mnIMoQFFgB0XXfaMwgpuzD1Iyyff91xVbByok68&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zyXeqMxdVMNI_pijHUmUJeoUe7fXJ5KcDojhZXw07aA&oe=6A1C60B6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg2YoCR3bVoQ7kNvwHjux_j&_nc_oc=AdoKW6pkhlRLta5u4Ba5X9xvPyzkt739bvaMZVC3hwx3FtXF9n6PQVX0NeG6EBBeIJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_FkOMXzhXH1-08pDdTzS5EvQn0hHLbWKWiAd7ryIm8A&oe=6A1C5211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVh-cdssI4oQ7kNvwF6D9wk&_nc_oc=AdpAewH2Rm2xcClwMyBzGC90iEbky23izPQD5CK4Rh5QLuxXQ0KFF_SXaiy1RuRDFwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Exjf3vT3U57KBfHSPlEvcGnPtyzZyS6FFU0VOsbFAA&oe=6A1C4D50"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624
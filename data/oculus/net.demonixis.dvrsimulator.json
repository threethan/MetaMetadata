9A1xF-vBuoQ7kNvwH-cxfD&_nc_oc=AdnHM9XyiDe4CtVLj8MxnXKnb8hOenrkfqr0gIwaK8IErSwfnz-nfSYGCg0zbCYN9RE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftzhIT7bWGYuzVIdnFVs3mYb0RNLS9xwifBR5WRC0w4zQ&oe=69A0501B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTQuE8t28G8Q7kNvwGHKm_U&_nc_oc=AdlPI4cqak9bZS82SDZ-LkIBRSTF64omdGzhOvj7MTkaZ9oJ7kAPtrSNcASLVeq1Lf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujqcRLrBC3v8otHnyfVwM9USFTIU4x_XSebSGfE1tkDA&oe=69A03B76"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYPgxmbl_L8Q7kNvwFr1pFz&_nc_oc=AdmEWQVtZSHPogLkusD42I6hMz1D9p1wwJJwVkeji5jXWVaPAtlLSziTG_LtJvaLdhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqSwfeY5gputtTClRypP38G2h0PekI0ULwS5KEpQsrZQ&oe=69A02CD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FL10QgjHrYQ7kNvwF_kj7t&_nc_oc=AdkOSeGonz2HBLI8M14_IZNLlqUruuocD9kbBDKZZE89-_sYzXR8gcdcQfsk63HgTFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQRLQi0MRfS2VL9LBaJEELxh5cZworyJ00AniRcZs9NA&oe=69A02810"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHI-S5cuuyEQ7kNvwG-hP32&_nc_oc=AdkaT2UCjecHhJsuVR5fHOsX9YUVCS0k-SITnnocMZKLKzFZKGj1BJGYZZxrWHBP
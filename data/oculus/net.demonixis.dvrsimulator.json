IWxeRt5YCgP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG_ijTbOpThAOVcSNveivyRq36yCgkUChyX6h6ehWJ5w&oe=6B083DC7"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lQTDakLycwQ7kNvwGKyWcQ&_nc_oc=AdrtFFypKTtrDivemDZtBN3iCYHfO3idMS1XKKr3Ww7DQkqVjMP3WcSpYwHf6WofGdM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9cGzy7upFtcHc-FEGg-qgkZDKKwJEeNoHwtJ3KK3lCw&oe=6B0871DB"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7NEFk2PcRUQ7kNvwFcdVn_&_nc_oc=AdokfpbaFo_oCNNU52Ihj65UC92o46ltgmlH66g2BJBhVOIeA7D1MuBqcmY4XikYObQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA4_J0snqyAQk-xXddNNWKngpPpKLnMqT_ldC4pHFz5w&oe=6B085D36"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Qsb9kJUpXAQ7kNvwHWSufR&_nc_oc=AdptTzB70qJMRK_HLZEKErUDSeYZUBUsGO8chS-vXjUzFnQSh6Ws_DY7KCZ_6yP7yr4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3CAwIMUSDzgScWBcN3ehOaw5nLU4PA3f7bHdskow-0Q&oe=6B084E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs7L2r-S9_0Q7kNvwHGrSto&_nc_oc=AdqK2wav3lpyjWhXljbCB3K9dAiNOsG5QcRV3_74uh5yR2gH9qCMYwEdwfz13RMzRyk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXIxWumNE7tbIC8E3aDW1kLkFTvX4gWM9Km6jAIlph-A&oe=6B0849D0"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
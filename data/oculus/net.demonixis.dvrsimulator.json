5396222_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuVH3b3fXMMQ7kNvwFT6AWe&_nc_oc=AdqI7G-rHE1z-VfOut2Avg0uThAsPGMtz_2s-PXRM8XeUxmd2emoMTrM20Kokw7-RJ8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD2lovC_2az-3B_vyW9lzJ0ozO0wP3TPtV1GTk4xIGPg&oe=6AA95BB3"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL4ZHXIlRNYQ7kNvwE5XzNx&_nc_oc=Adop9Cda6O3nHs7mxgKZIOiViBphs6LTXJz5BcaCwPNJXbA3xKvMl_E9U5T-pWKYv80&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-l9US87M4SFQRXqzYFx57Bp0WhfS-7njVFZyiqNT2Zg&oe=6AA96291"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available.\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
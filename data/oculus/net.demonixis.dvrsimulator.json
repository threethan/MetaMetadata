YwNv_KJsjoQ7kNvwGa65aW&_nc_oc=AdntlrIk4BCSMsztuT5tgFZaMyV6LGknPhR7_qWPvhwDdjh8cp3wInPbDvD1qvWYk-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs_kIjn-Reu3d80EpBXhcGVO3y9G4j6eqima1e50MVKog&oe=69A5961B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOTCJGSLY8AQ7kNvwE17fFT&_nc_oc=Adko8K5ApWkXfT8dRpQZ2zMDVWmBlwOzTkTNHISFe2qtUHwU9QZGQRLzQrnqZkR93Lk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvnYrgdJeOmh-QB5fi9LNQfuJNNcu6hL77_Zux261DOBg&oe=69A58176"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVF_PD_9nbkQ7kNvwFR4lfF&_nc_oc=Adkn2lpu06oQb99dTfWqUtyGJ10XwbdpBjYgk3aX6MDDsEBoDrXHmK1TBJbGNpwdW4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afub5T56wsQR6sRlcG5GEnDqq_ETZJSYpPgsb4Atkf_k3w&oe=69A572D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usIxEvxwewQQ7kNvwFTcMvq&_nc_oc=AdkdP8bTIR0aPvWlbb8vjWMt5lhJ1y11JP5U2ZilgHI1RMkW0lbilShA3Dnp4iUIoR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftM6a8CPC0S9rF5sLFTQVhnOGDm8a1xCSjI2XJRklLM5A&oe=69A56E10"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gaPfUPTSDsQ7kNvwELe8Ay&_nc_oc=AdmFXWCDzFb8YzrUyxZgj7I8eZ2itnpJbn5d--0vwG8DJ-9nDZmZ68ZCkX-h4Wq_
QwwTwRUxocQ7kNvwFksPdE&_nc_oc=Adk-fzNuQOjAaBvme8G2ddmI4O62WYfbLC10tTxRcSNuZ2po5Kmk06vRyOTE83XKNPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMylDh9pYt3_iftq3NjgP8CdLuY50RROyBZ0E7NqLrIg&oe=6999B89B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vEb11Lbjw4Q7kNvwESdr10&_nc_oc=AdmdyY90xYLdBLNYRqMc6vKwaGxx40FWErccc_RGEgLEZaDRBhUJxMj4f34FUBfs0Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNtHYgbVLYfdgl_RV3lcvB8vwCz4rj1s7vJHSTZMdJ0g&oe=6999A3F6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g13QWH1RUUQ7kNvwH24gr2&_nc_oc=AdlHfAW8A0i4LxDNIz5LW44GfFmOrPpiLmVFgPjEqKIWO9KFiqf9DhyKCBhkwHFdTyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyutECsP2NUzCD0WNcyqHHG-luLK_vx9fq-NU7aXNHlg&oe=69999551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43Q9D4OH_EEQ7kNvwEvlp3L&_nc_oc=AdkeQm8nHaKh5bjadHX5SfyOXpJs56LuvBE7jontI1PUtgAh0zuXx27ElinaNLuMyjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC3SIiWotHborcKPpzuWOY0OzeqEVE5hyUKqqSMlLYWA&oe=69999090"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588169147939921"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031441_996427188759546_745748311741624142_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIVUHEHfssMQ7kNvwHNbevi&_nc_oc=Adms05LkTllCRuRsqehPJo5kVg7N5a6BUvgqCDvtxZglUdAoLXRYlGL-CqDVFCTx
02K_yAz9bDag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQoH_6RZUa6zorpbX2qn0_bHAoo5VsBbBPFprEx7eF2g&oe=6AFC6047"}, {"file_name": "Screen3.png", "id": "4364801470264817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003267_4364801480264816_8536196082918813760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKmrMrlOA-QQ7kNvwGseghu&_nc_oc=Adr65y-7mLbDLq8trb-VJYPfKo6TAj0I20tWnKZ4sn86jBmHS1nkmb9cuvS26A6DQKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_R0z070GLrwYLhccSK-PYwxyCjjXPDg4pjX0yk7eHbg&oe=6AFC945B"}, {"file_name": "Screen1.png", "id": "276433300899591", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_276433304232924_6714630228818820303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E851TKxMTvYQ7kNvwFWgUQb&_nc_oc=AdrAeiMZv5ko8fUQzoQvpVQaEb9RZALOS_qMAJ6Xqqw9ioibr7R7vLhAid4xdQhJVmI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLSuxERH4ad2c0SnBNLlQOqv4oiVgOesqwph6d8jgIaQ&oe=6AFC7FB6"}, {"file_name": "Screen4.png", "id": "539088520607883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_539088523941216_1542448400021589127_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwHU4Cos43EQ7kNvwFTD2bT&_nc_oc=Adq6w_INEGKDtZkYpisUcm3vdEkYfYWJgCuUVxWOOiirXQUvLMAVnNY6HXVe0ceWycA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-7TJrwF-QvwGmC1nfVtXARatCgRCKWy8csPOeyuaY0A&oe=6AFC7111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DVR Simulator_2021-04-08_21-48-53.png", "id": "806780961421519", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75422394_806780964754852_8255125831375478688_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWuyWNeKXc8Q7kNvwFG4aqG&_nc_oc=AdrA35icjmhvk_9cjWRKm4HllS0gNAD0ZMBG_QBBOtXgyKHrjKPSRFQ3NoL1XdpZLvw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvLLmr-x4lcC9MYd7meQ-w2bvb5mUu4oqm_xoh0hAeQg&oe=6AFC6C50"}, "display_name": "DVR Simulator", "keywords": [], "long_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available. With Mixed Reality you can control your drone and learn how to pilot without breaking anything. You can also create your own race!\n\nAn in-game editor allows you to tweak the drone's physics. You can also save your profiles and use them later. The profile format is open so you can share it with your friends.\n\nGamepads are supported and enabled by default. Radio transmitters are currently partially supported. You can play with VR controllers but it is recommanded to enable some confort options : Throttle Lag or Sticky Throttle.\n\n- 8 levels\n- Many drones\n- 2 game modes: Freestyle and Racing\n- A tons of options", "short_description": "DVR Simulator is a Drone Racing FPV Simulator. It features two flight modes, Freestyle and Racing. Simulates FPV Goggles using your VR headset. Many modes are available."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.demonixis.net/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "https://www.demonixis.net", "support_website_url": "https://www.demonixis.net/contact", "website_url": "https://www.demonixis.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices"
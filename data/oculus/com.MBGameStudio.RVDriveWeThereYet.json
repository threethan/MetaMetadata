railer_thumbnail": null, "display_name": "RV Drive: We There Yet", "keywords": ["rv", "drive", "race", "survival", "adventure"], "long_description": "Hit the road in RV Drive: We There Yet, a laid-back road trip adventure where the journey matters just as much as the destination. Cruise through scenic routes, manage your supplies, and keep the ride smooth as you travel mile after mile in your trusty RV with a friend. This game will make you ask the question rv there yet? because we ain't and it's going to take you a long time to get there!\n\nYou\u2019re not completely alone on this trip - your friend is along for the ride. Whether you're navigating winding highways, screaming when you fall or dealing with the little surprises that come with life on the road.\n\nExplore new places, enjoy the calm of the open road, and see how far your trip can take you. And if you look closely at the details of your vehicle along the way, you might even notice a small hidden RV somewhere in the journey.", "short_description": "Hit the road in RV Drive: We There Yet, a laid-back road trip adventure where the journey matters just as much as the destination. Cruise through scenic routes, manage your supplies, and keep the ride smooth as you travel mile after mile in your trusty RV with a friend. \n\nYou\u2019re not completely alone on this trip and it will make you ask the question rv there yet? because we ain't and it's going to take you a long time to get there!"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NO
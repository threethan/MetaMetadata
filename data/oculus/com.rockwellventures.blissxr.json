vwHbh5Bk&_nc_oc=AdppFQa548MWGsGcHNUXDAGg54xBDx8O9eKPolPtXvuBTBc_7i-3inQS4rfaIcit8wA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJvYiZq_HyFKcsebjon4nHHbgf8W1zgMlLfGz-FaL0gg&oe=6AFC6AA3"}, {"file_name": "Screenshot_3.png", "id": "2205259739623910", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031618_2205259742957243_4814912224586648800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL0moSh9P34Q7kNvwGNanwm&_nc_oc=Adqz-K5Gm10lmvFRmpB2E_eWJBm0LkbVgTtlZvlNaL8J11o_Le5dy-23QUMUcowU0n8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZkA-iH3XUL-iDJhl9sJnpNJ3S0Ocm_ZnfPA99G2EA-g&oe=6AFC5E81"}, {"file_name": "Screenshot_4.png", "id": "326946172620699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_326946175954032_4895921826098113970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OfdhuRlvu8Q7kNvwFC3Iwa&_nc_oc=AdpVSiMAWqYQ-j5CZy79X6pjNWVoeImwey3mgFM0wm63pl6H1TWYFFHE5ed-zbI_qF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQowypMv59aC59uADDzOgijk2H_tVg7ogzuNCrg7Ubxgw&oe=6AFC7F48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bliss - Visual Breathing", "keywords": [], "long_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nMost people don't realize, but there are simple breathing exercises that can significantly improve your health.\n\nBreathing at a particular rate for extended periods of time can be difficult and boring though. So to make it a more enjoyable experience, we've created beautiful visuals that help guide you through \"Resonant Frequency Breathing\" exercises. We call this Visual Breathing.", "short_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nVisual breathing guides you to breathe at your resonant frequency, which extensive research has shown impacts many areas of your wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getbliss.app/terms", "developer_terms_of_service_url": "https://getbliss.app/terms", "publisher_name": "Rockwell Ventures", "support_website_url": null, "website_url": "https://getbliss.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "440621284605192"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "535369214788007"}]}, "baseline_offer": {"id": "535369214788007"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1653582600, "status": "PUBLISHED", "id": "535369214788007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5615029358544331", "version": "1.0.0"}, "id": "2115006895331668", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4759867464060529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5615029358544331"}, "release_status": "RELEASED"}, 
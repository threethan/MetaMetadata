om&_nc_ss=7f20f&oh=00_AQEtcGrYKQ6w2o0nioFvk2ZDROkBse1escChttQGilqQVw&oe=6A857F41"}, {"file_name": "Screenshot_4.png", "id": "326946172620699", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974853_326946175954032_4895921826098113970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnwO6X3Gxj8Q7kNvwEd6dg0&_nc_oc=AdqyK8vLzqrxcoMS0fy3IVl3PX0YmFJYvHuT2gDvkopMMoJKjLZCy7YLXwQIf-Ozcbc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfSlMcfDyv0gleH5SHziJA2oGB6FDz60td46rp4QFNjw&oe=6A85A008"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bliss - Visual Breathing", "keywords": [], "long_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nMost people don't realize, but there are simple breathing exercises that can significantly improve your health.\n\nBreathing at a particular rate for extended periods of time can be difficult and boring though. So to make it a more enjoyable experience, we've created beautiful visuals that help guide you through \"Resonant Frequency Breathing\" exercises. We call this Visual Breathing.", "short_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nVisual breathing guides you to breathe at your resonant frequency, which extensive research has shown impacts many areas of your wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getbliss.app/terms", "developer_terms_of_service_url": "https://getbliss.app/terms", "publisher_name": "Rockwell Ventures", "support_website_url": null, "website_url": "https://getbliss.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "cont
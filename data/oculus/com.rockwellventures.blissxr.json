vwGH9aQL&_nc_oc=AdqcaO48_WuD13CTGu5VSl5boHRKoldDVRuVNmfAtDolcFOgrNXrYH4KwpPrnAgIdl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB3e49TUTOXJKqnBAiVn6wvmZ8nA64ydOx16Pc-vzc3A&oe=6AFDBC23"}, {"file_name": "Screenshot_3.png", "id": "2205259739623910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031618_2205259742957243_4814912224586648800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEQe8PwPJkEQ7kNvwFMSB87&_nc_oc=AdoeSLPNqLKXMPrsyHoMJ6D-ORvcKrqCfQQ6Oek_Tnp8NheBNvP02baB2hdIEvcUTl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-P1H1hR8HHuTrKGaR_R43AM-SpP_N9TN3wPYt_0jtJQ&oe=6AFDB001"}, {"file_name": "Screenshot_4.png", "id": "326946172620699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974853_326946175954032_4895921826098113970_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H87lRhYV2UQ7kNvwGEfGVB&_nc_oc=AdpFKDROLg7qNFzBYXfbL4wJpNIMjB2rp7ozOrndAa2e9bMjYvB4K7wDI_CXBi3OmpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC0hZXIyK5KPT3TVxVzp-hFfh4prnObn4bKdnoKFJ7iw&oe=6AFDD0C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bliss - Visual Breathing", "keywords": [], "long_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nMost people don't realize, but there are simple breathing exercises that can significantly improve your health.\n\nBreathing at a particular rate for extended periods of time can be difficult and boring though. So to make it a more enjoyable experience, we've created beautiful visuals that help guide you through \"Resonant Frequency Breathing\" exercises. We call this Visual Breathing.", "short_description": "Bliss is a revolutionary new way to practice breathwork in virtual reality.\n\nOur body responds to our breathing. Bliss uses science-backed visual breathing aides to help you relax.\n\nVisual breathing guides you to breathe at your resonant frequency, which extensive research has shown impacts many areas of your wellbeing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://getbliss.app/terms", "developer_terms_of_service_url": "https://getbliss.app/terms", "publisher_name": "Rockwell Ventures", "support_website_url": null, "website_url": "https://getbliss.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "440621284605192"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "535369214788007"}]}, "baseline_offer": {"id": "535369214788007"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1653582600, "status": "PUBLISHED", "id": "535369214788007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5615029358544331", "version": "1.0.0"}, "id": "2115006895331668", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4759867464060529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5615029358544331"}, "release_status": "RELEASED"}, 
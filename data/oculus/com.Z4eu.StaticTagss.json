.\n", "short_description": "Static Tag drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. "}]}, "developer_name": "ok", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uh-sbwkMY3JbChPgDeAnWBiKyyy6ZS6NU5dL-_-HE1A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "z4eu", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1z-REaNrWMY8mjT-6MyzM2ntXLOwT3FyYw51NgFuMiP0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26576259512009455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830007_1255590066288142_3730482196298641761_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BxYwFoC_FsQ7kNvwHGVvbF&_nc_oc=AdpyeyGHBP0vZxuCcgplCKHlR9M9fREhA-1iFUEVqqRyk_R5WZw7lQDcTnTwQ38uhJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZCJPhYGbSKMB3HKGA86aZ1r-w7tqUJkRIq_A5YBE7ww&oe=6AFC933D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Static Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"top
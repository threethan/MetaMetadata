com/v/t64.5771-25/12138833_1085891638148274_450942019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ty-iikJ10HIQ7kNvwGGF2Ei&_nc_oc=Adr_aN8zmT6-X2wUoiGzkMc8muV6RITni9TIR1wGFxf-ivN5-E0SxohSnWXqJAaBpv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnsY42NcnLcxwzEHdFIZiAtO6USbJVwTTHzt8_UT7kAA&oe=6A830AA0"}, {"file_name": "migrated_image.png", "id": "137489677705260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138839_1716338468590024_54162614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeEF-A9dyeAQ7kNvwGdT4WS&_nc_oc=Adqpss6-lmuPNmiAqfLWLIH_fyKOo8t1eKDfVt_iPtlhaMu-nOljgrxH_MyzQXzYgYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlaI_VVF5EXzOfBqYXg4WSLfgmZOc6ocbSbyUq8uMtcA&oe=6A830C12"}, {"file_name": "migrated_image.png", "id": "842321256180041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138771_449997491860377_1531688600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AADSchnl84Q7kNvwH1lozm&_nc_oc=Adoe_XN-Q5POCcAEgb78hy5iddmO0s3xThQktSGbSYgfeBwwCkXb21ITiHljZG2XutE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2bHKmEAXfgQ7hvrhFHpyIDOhQudHRruTj9jqijkcEMA&oe=6A831283"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gumi no Yume - Premium", "keywords": ["puzzle", "classic", "Sokoban", "gummy", "candy"], "long_description": "Immerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic.\n\nUse your puzzle-solving power to bump colorful gummies around the game board and win your way through a 3D world inspired by the popular classic, Sokoban. Can you solve the puzzle before you run out of moves? Will Kon-kon ever get to eat all of the yummy candy he collects? The world may never know\u2026but you will if you play Gumi no Yumi!\n\nPremium Features:\n-All Stages and Levels are UNLOCKED!\n-All Future Content Packs are INCLUDED!\n\nFeatures:\n-A colorful VR adventure sure to please anyone\u2019s sweet tooth\n-Adorable music you can\u2019t help but dance to\n-Easy to learn, fun to play, a challenge to master\n\n(Kon-kon\u2014Nickname for Konpeito, also\u2026What the fox says in Japanese!!)", "short_description": "Premium Features:\n-All Stages and Levels are UNLOCKED!\n-All Future Content Packs are INCLUDED!\n\nImmerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/7759324", "developer_terms_of_service_url": "http://www.lucidsight.com/tos.html", "publisher_name": "Lucid Sight, Inc.", "support_website_url": null, "website_url": "http://www.lucidsight.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1950209135183137"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1977274569164935"}, {"status": "PUBLISHED", "id": "1865518313772076"}, {"status": "PUBLISHED", "id": "871694396290612"}, {"status": "PUBLISHED", "id": "300404053805867"}]}, "baseline_offer": {"id": "1977274569164935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_
g&oe=6B047752"}, {"file_name": "migrated_image.png", "id": "1046419009074045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138771_449997491860377_1531688600_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUbLCwAi-2wQ7kNvwGZO0ZB&_nc_oc=AdrmO5fRJN_w3lQ9lNBsIMbhu06_GRdErZ5-kijCKnzFv0GndTdHOQ_QPxVYpH-z5_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmncDZLxfjkm9D-x_LoyVNKzhyKfFcvSBChU15B8Gfrg&oe=6B047DC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gumi no Yume - Premium", "keywords": ["puzzle", "classic", "Sokoban", "gummy", "candy"], "long_description": "Immerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic.\n\nUse your puzzle-solving power to bump colorful gummies around the game board and win your way through a 3D world inspired by the popular classic, Sokoban. Can you solve the puzzle before you run out of moves? Will Kon-kon ever get to eat all of the yummy candy he collects? The world may never know\u2026but you will if you play Gumi no Yumi!\n\nPremium Features:\n-All Stages and Levels are UNLOCKED!\n-All Future Content Packs are INCLUDED!\n\nFeatures:\n-A colorful VR adventure sure to please anyone\u2019s sweet tooth\n-Adorable music you can\u2019t help but dance to\n-Easy to learn, fun to play, a challenge to master\n\n(Kon-kon\u2014Nickname for Konpeito, also\u2026What the fox says in Japanese!!)", "short_description": "Premium Features:\n-All Stages and Levels are UNLOCKED!\n-All Future Content Packs are INCLUDED!\n\nImmerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/7759324", "developer_terms_of_service_url": "http://www.lucidsight.com/tos.html", "publisher_name": "Lucid Sight, Inc.", "support_website_url": null, "website_url": "http://www.lucidsight.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "674371693568232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_1086330224721258_1576501671_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV05U2dCeCcQ7kNvwFhQA0O&_nc_oc=AdpMLB0xTHCI9yPBlVf0aD8SiGA9dIBjB3KXOcRza8AnfU99DuDpPV4oYjD7Y1kH7wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQivyT2TxgMf6XX-UGZvco8zwSTm2VaTZntr2JrCMtjw&oe=6B046ABF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gumi no Yume - Premium", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1458111600, "lastRevision": {"nodes": [{"id": "1721905961388643", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1286663531345620", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"i
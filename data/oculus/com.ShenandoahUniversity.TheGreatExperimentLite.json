n.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BNj7nyruMAQ7kNvwHibw5A&_nc_oc=AdrnnRZ3MxvHQEO86d2JhCSykyUPmYGbaXMBvMbn-xP2bHe1r18_mkZfQcFdeux2nRg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-mLNUSQmZXrmfwbgHRcug7GDY86kLr8OXfvVWR0ynaQ&oe=6A54DF56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlzgSBq-hR0Q7kNvwFvvWQo&_nc_oc=Adp_d7VWl4phZv3bQJfrV2iSgC2zRymcg_QfzPQ5cQriCK30sFHwZRhC2-d2UuCIyPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZnvhAWoNgvKW4FLjDM8ftXHKTli5zp6jkmApo5NLtSg&oe=6A54DC4A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-u
reenshot-4.png", "id": "1011372144574165", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618481_1011372147907498_6871990140599367240_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su_XMslZExwQ7kNvwHDAxyI&_nc_oc=Adr0_6TJ1d_OuQ2xggAnvnMFhVoQ5WUPXU_KdfSyHwbPGpX0Soh9L2usd11pwfT2AEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPsB0s2Q-AqYVF9-CNAszJpRQ69MppCaMdLEMfJ8MZgA&oe=6ACBABD2"}, {"file_name": "tge-lite-screenshot-5.png", "id": "1542299014562657", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307602_1542299017895990_1120129192074085984_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gGIhoSsDwsQ7kNvwE1q5m9&_nc_oc=AdoYBoByKamQ7IJN6OKNgTk-M4q9lMwtymwGL9TNh6Sl7ko6W8p8VKiWWYaqjB7ygaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOORJh26fJQnjOF6srxujB2Lls4kjLV-6rGYSVwFrmUQw&oe=6ACBB71E"}, {"file_name": "tge-lite-screenshot-3.png", "id": "948369511328361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_948369514661694_7387049969517353559_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz5Y_gaEHcMQ7kNvwHmVlHN&_nc_oc=AdrzFbEfGxfp7M3n7OE0M_hI6x9fufZJmI0r8PAQ8Zbw0eBJwUdI9r18q7G-Yg_3ojQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj5i7dc7LkMpeQqS18qajA3lmomkGWFdk6OJyWkXHvEA&oe=6ACBB977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406138988223621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_1406138991556954_4764579879170119330_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWLBgU5TAn0Q7kNvwHMiYAq&_nc_oc=AdpUymQKyV27qek8WnRE8PD5VLyPqad3fX1cR56aD_CZyLXxnBRFQvKBdeUaQfDBiWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXSrvp_Jk9BTeWpHapmBgfmPtDDT_LIZamUyv-rZXNVA&oe=6ACBC014"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27947833851483207"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304131_1288397182829984_7529158438715172939_n.png?stp=ds
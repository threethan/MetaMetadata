0a&_nc_ohc=EPumwY7YYR0Q7kNvwH4Lqu4&_nc_oc=AdpwH_JSYXy-zCEOg8MogG9VBsezBXCEpY1hxGSe9eE2uo_CZ4lnq-CIOZFyH0yrD1g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VmOsdpe-ABP8JDWk_fu6NtQf8gSwYEHuIJJvLewc9_g&oe=6A22FE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x28MqindkpcQ7kNvwF8wAyf&_nc_oc=AdohRp6IZ41OyimACvOkINArWWYPiwfXQlo7HsYbRHOLEuxx5aNBfG6yck3w8wTPLm4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oNQ6_VDqdQGIXC3gnf92Heq3VnBissHhlwkB-dAdGrg&oe=6A22FB8A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_
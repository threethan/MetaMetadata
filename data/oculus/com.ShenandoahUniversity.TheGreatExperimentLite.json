oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ASa7ZzcC8yUaj5bXBqcOUGcxpekycHzC5Ok1uilOPhw&oe=69DA2C63"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9RhqErhJ-kQ7kNvwGvkfZ7&_nc_oc=AdoeWxmulm2JxIV9R87Z1ks7OHXW7XW45R62B9Aw19Ikkme3DWPBRhHTf2MzCEYUV5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CY78wvSwLMCujYyKc6kp2iYnhb-jLQfGj2OkULCdTUg&oe=69DA43D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vRJSeoCEgoQ7kNvwGOrc9Y&_nc_oc=AdpHZSax62MG0Yjqc55W6zFOdksvnomaOMfdK3J6GZD-oV-SXyhmLTTlkPkcuBB4fkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DH7C8xYF2UJex_ZcNDsaqrVsk4vMkCPgi3xcqohMwdQ&oe=69DA40CA"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_pr
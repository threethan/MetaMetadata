oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_cwrZZVfpEKPgFIiU9Mrwq23-TWntMHjkud6Obn_ppA&oe=69D637E3"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31_CX4X1GUoQ7kNvwENf1rY&_nc_oc=AdoZJ8-Sqp4rDOvLLeIs7VSDpqY2-bPStiu7MQGbdluZIojW8JjjnKqICKyzgrNu0Iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0n9A7nGJizVNIcmP5bkzxtFJniuEB_HERAM1HZsAcmiw&oe=69D64F56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND0mGRxXVScQ7kNvwEJ9ZFb&_nc_oc=Adp7HSoPrVAYZqHXGw-4W88J3B3t4_GTIwcOMvPasKkI7nbs-0wgQIO-0f8uZpN5cxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-kG5R_EsnFNz3prCdVIZz8JHNpON4Ck89zuqXMwQX5Q&oe=69D64C4A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_pr
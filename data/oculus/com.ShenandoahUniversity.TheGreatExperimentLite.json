oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lTOsZp94f2bTjv9Vd8v-IKPhr3qmVCw2f-RZmTk54pQ&oe=69DE20E3"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SsiniJZcWEQ7kNvwGuh-Vi&_nc_oc=AdpAaem9iqipiplsieISQZBHJ21Q6LzU_LIimGZrGUa9m9jOGI3HgHpSxW8IUytgfRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Eow1dG1_4Y5bP5o3plgHrZj90IVf1O648eHnB5c4CaQ&oe=69DE3856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vX9HR-W6XT4Q7kNvwGQUvhj&_nc_oc=AdovRpsQ5JzONjbqQ2VkOBappyZMMdMf4wjPRBKL9H3PCbQ0aVai0lvkI10muqwyTFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ulDLiZFGeiP7GeP3ZJEgK172NZCScpcJUIL5mWNVSaQ&oe=69DE354A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_pr
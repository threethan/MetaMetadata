pLIpkQ7kNvwGHyrHn&_nc_oc=Adpu6Pxwq01MVvvfm_iZp76SycSTFyG0N7qr4agRCdP8cCSpSW8ms-JDQF8MjyfnBq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-yMdctbgBdrk-U-hW-ZYcGsThf2-VjiSUTcPyTgXSKg&oe=6A01F1A3"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zePFS-04Qm8Q7kNvwFyeLB5&_nc_oc=Adqi2UzgA9BhEQfvcjfb8nXK377Llr52uLHtqrFX2STBrEMGLgsnwzxN8M6rfLE3MmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iz7Q6-KQEz8y9aHo0_jT_IbrIIk-q5HFzhhjZJ1gICQ&oe=6A01D0D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXiYwBIcSVMQ7kNvwExh12G&_nc_oc=AdrpeF9mm1LtXtUBp_sE-lnvzQehr--QCAkddEmqqa5wUnyVMxcRoINi8132Z8z307s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nQ4RE0XNlNS-HY3YQeqAZ8l6vfUfyfKufyuqaehYdkQ&oe=6A01CDCA"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278393631760579"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "768767779464704"}]}, "baseline_offer": {"id": "768767779464704"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764877080, "status": "PUBLISHED", "id": "768767779464704"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27654353587497903", "version": "1.2"}, "id": "484657121200320", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9174064799286729", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27654353587497903"}, "release_st
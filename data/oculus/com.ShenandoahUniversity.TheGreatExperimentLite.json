c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEerPjjDykgQ7kNvwHu4Sdn&_nc_oc=AdmT7gFaDePYf-Rj58jiIF4ftGZavkKtS6fb2HQmq1kEs1UsIPoAglXio4iQvRg96Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLUzV3d4Y5u40SwuPBtno7njjL-Zh5jkSPhYDe_lg34g&oe=699D9ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la-RIxhEMOEQ7kNvwEJUHm8&_nc_oc=AdmXRL81VU6tVmYwGKx-sFNjteiatHvKvFipI7p1bCHFt5VSlO9wcYOgbKi-Kx22jNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv58cAdfzDfhic_XhVcJ3aNuqYvTSmzVRsIJv-cMvetAQ&oe=699D9BCA"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "websi
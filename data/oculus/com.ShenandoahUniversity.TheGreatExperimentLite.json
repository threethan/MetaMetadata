n.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwKgdf1NECQQ7kNvwELHuxd&_nc_oc=AdqyskfvoFynoa3uNrg9wWtXqJSwfv2nDu0oZmAfHUuq_zoEd4OVocK4PgFJzgnoIK4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjkJYaHeAQhJKSVA0tW5PL__HjK82rmsAcG8sPFXXe_w&oe=6ADCA9D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fES4oXLnpoQ7kNvwEqnfxy&_nc_oc=AdpkZTAaKfi3tUs7AW0TKwdaMggqETDDiReJL5rYrYLolmdceBCkkCt3DCs4Sl-GMrs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN87NS7lj7oIJN9JhoW3_8W8uaKgZY6_JIFMTVqA-GBzQ&oe=6ADCA6CA"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-u
QEMUyngPRtzGXr5xgOYqc_5sS9px3mykSGqB763Un84U85jK_tUjnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhlhCeFbUfU3ircLEaNUKYIYq9kIrH5XtbnEOEI0Vizg&oe=6B106573"}, {"file_name": "tge-lite-screenshot-4.png", "id": "1011372144574165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618481_1011372147907498_6871990140599367240_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRq4WeXbjBQQ7kNvwHWAOJf&_nc_oc=AdqLUQnXhu7K26WH0oYmAUTENB7zF_bOybbXrzgvufJdgytDw-Bbufl4706bht_bnvY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVv8CR1KvHL9oJ7l3uHOqsnOp3wpMHQykXin4Dkr6KlBg&oe=6B1039D2"}, {"file_name": "tge-lite-screenshot-5.png", "id": "1542299014562657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307602_1542299017895990_1120129192074085984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygU8DpwHK6IQ7kNvwG13sVk&_nc_oc=AdoFDbOy-B9E-4Kwt-P3tD0NNEmUkmicn30XCSs7Tc63mQdecuwa4GYxJfPikMLktT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfxGPyjHAWg_rwE4OXeNmYvnaHFayAMijWwvw_eD8G-w&oe=6B10451E"}, {"file_name": "tge-lite-screenshot-3.png", "id": "948369511328361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304952_948369514661694_7387049969517353559_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFmq_oKGKyQQ7kNvwGw2f-Z&_nc_oc=AdrOF_RqPM3YuaLLZQNYpMgrFnpg8pQJiYiLpP99kdYXC6tfncsVwkWvCdPM09wxvFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaOitfQC-jwCN3HtecfWkAmb5q11iOC1n_eI5hi_LQ-w&oe=6B104777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1406138988223621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1406138991556954_4764579879170119330_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OjiJ8KwafAQ7kNvwFTs_mN&_nc_oc=AdodFC94u6hiYUhaTlsl9ia7omL_vhaRPChcKtdOpHC2rV6hCjHHnBeDdEm4WItR9Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKVyozzDEuh3S1mmok3eMaIhV09gz9Jti0k4vOLD7lew&oe=6B104E14"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
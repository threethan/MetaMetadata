c_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEerPjjDykgQ7kNvwEscwcT&_nc_oc=AdnYQqtzSJxjXTtae_l3m0DBIqBNusL8w0WVRSWVPdjUlGK5ej_pTL98qWNGqpfWxws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs4_9dM3O1olCJmZvajWX1eLYrmBNix1i81STFjMnOFDg&oe=699C4D56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfDBj7jFPgEQ7kNvwGQ_2J6&_nc_oc=Adk_cD3woYIAZzleoRXHsEFpb8iz8qi4jDoKjNit6EAxHf8h-DvyUebLi8ZQR1uPh1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftI8LDMCbW-xwOI93mKf3TR0MaVWlQLvATn7Brhahm3Wg&oe=699C4A4A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "websi
NHv_4TQ&oe=6B005857"}, {"file_name": "Debate_Day1_Screenshot.png", "id": "408699652260169", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375771_408699655593502_2948096073224477887_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc3in91G4_kQ7kNvwHaqlGg&_nc_oc=Adp78woJ5VI9kIhcgJDiEIAA--zT3IuhJP42_wqSmNFhqGyL0lP4sonfhH4-Xvu0Zig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgB_OSCnn5VfdPvE40WVByJErqR34JPz9TEfi_oQgosw&oe=6B006323"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfFXlfiGn2YQ7kNvwEHnec6&_nc_oc=AdryS4ET0L0m4sOvIli-mwAq4TPWiiOT3qFKrxxLMzzaLMJAP25EO_wwObcO390Ojjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGQyedXOlTDO_SWrpn0oSie3ZHg6a8DL2ycF5ftNK7SA&oe=6B007A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-7Q2DMxEmAQ7kNvwF0sIuA&_nc_oc=AdrYhHY8LxA3ch8x19Cy9YolxHdMegPyi9UOAZKFNXy5znMW9NmvOHXYL4J8hd5lAm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQudRwblQDokE5wqg91v-yUecSgFxQ2ZHnggtMNQlrBMg&oe=6B00778A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/vr-ar-xr-privacy-policy-for-shenandoah-university-and-scil/", "developer_terms_of_service_url": "https://www.su.edu/scil/vr-ar-xr-eula-for-shenandoah-university-and-scil/", "publisher_name": "Shenandoah University", "support_website_url": null, "website_url": "http://su.edu/tge", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26278393631760579"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "768767779464704"}]}, "baseline_offer": {"id": "768767779464704"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764877080, "status": "PUBLISHED", "id": "768767779464704"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27983661847900407", "version": "3.0"}, "id": "484657121200320", "channel_name": "LIVE"}]
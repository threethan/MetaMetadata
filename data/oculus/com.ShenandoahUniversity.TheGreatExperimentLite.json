oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kgx7GOhxFXG39a4nz7WWk9Cx6dAMMpKsX29FiqOSv4g&oe=69DB7DE3"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9RhqErhJ-kQ7kNvwEpImd1&_nc_oc=AdpoX03vLDtKWQNeZ-tJjq_QgX0iWa5ilgECWMhtGictMY7l21vmoKVyTxFpIyGAnO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00BVSPYUJpWbxLCxyP5NkZv5PlFgPysaGx0ouYPG0dzA&oe=69DB9556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vRJSeoCEgoQ7kNvwHgYzFe&_nc_oc=Adpvmb3sF3uEJLAmPOixiDVMAu995QJDkzfQxdqQIo36MokNwcB3Khtk3-aSdFtFG_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YL_EbtW9ajkVDTvp9oRLeqYUuN-Y_KsvzUuXW-YbT4w&oe=69DB924A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_pr
scdn.com&oh=00_Af0AkQUJZiDwUEunw-pQjMHNQNnDWeOYohYtMto4apGRig&oe=69F0CE23"}, {"file_name": "MainMenuLite.png", "id": "1807801109629232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001675_1807801112962565_6934324477033427151_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TLKTUA8qR4Q7kNvwHmb5eH&_nc_oc=AdqQhWsEmKTrpBhcOFCNlLk5yFXpG7CUoFNoNhZuqjf1J6xYq09Za46egdAtaQBqtn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2FOBelDKPeqY-NuLjMnWUNxytSHgzYf-RduQ0R1bq9pw&oe=69F0AD56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Independence Hall Virtual.png", "id": "2119403915255253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314667_2119403918588586_4426626092050294803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsY4haVUOXsQ7kNvwH_1qBF&_nc_oc=AdrtP2ilIwJqeDjSQS0oTj4c76X2CW5sf9JKid2J1w1TBzTnHK6gOOfWL7lSGEoU2Wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2IFGIsib6YIdvETBz7eQDvaaki8N2ERTeopQx3eID1vQ&oe=69F0AA4A"}, "display_name": "The Great Experiment (Lite)", "keywords": ["history", "constitution", "usa", "america", "government"], "long_description": "\u201cThe Great Experiment\u201d is an educational virtual reality (VR) experience that immerses participants within a highly authentic, virtual representation of the Assembly Room of the Pennsylvania State House (Independence Hall) at the time of the Constitutional Convention in 1787. In a series of increasingly interactive participatory experiences and discrete stages, participants find themselves immersed and actively engaged in those historical moments surrounded by authentic avatars of the founders.", "short_description": "Imagine Philadelphia's Independence Hall in 1787 - the founders of the American government in breeches and frock coats, debating how the new nation would elect its presidents. And sitting right in the middle of all of that action, is you!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.su.edu/scil/
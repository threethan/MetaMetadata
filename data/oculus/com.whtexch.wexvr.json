name": "633792270_25904263662573973_7282656651064214453_n 1.png", "id": "1315544220594692", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304952_1315544223928025_3805685080948985276_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09MJT7nD-44Q7kNvwGY4sBp&_nc_oc=AdrRqBKLgFt-wE7yzBhjM0Z0HJKqzcGGZ31DLXh-2TFLs8EUeZCNh0F_ehzAyKYlgLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9lY2R2vxW0R0yt-pCX6hf1vRm8LCR7B60iYH975c1SQ&oe=6AB143AC"}, {"file_name": "634766816_33769603886021398_7720308037698937167_n 1.png", "id": "1580441983178113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1580441986511446_7975432517543561007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RbAbu0_2ecQ7kNvwHLVqzX&_nc_oc=AdoyBSPCDgEsE8WlUYGlY8XeOvnlrboVTO3p_eqCTzY-rkgRbpGJBVKqHiwsp09mhjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID0So0D6On4q36WDm7QhmCj7WeL98eN_-QcI0UowRnGw&oe=6AB13CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1733029097871689", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307470_1733029101205022_8799904521914701092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W78jyxQ0tn0Q7kNvwEmfVp6&_nc_oc=Ado49_tcEVXkastl-AF8bJtth3JBxTiounPZ-10O6GR-Bun4sA5ikcLji4HHlZb43Yk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu0kgrc1O05VFUJL1l8dgePw1n_1HQOMdDpilksoQtAw&oe=6AB13EB8"}, "display_name": "Wexvr", "keywords": ["video", "360", "sports", "immersive", "media"], "long_description": "Step inside the experience with WexVR.\n\nWexVR is a next-generation immersive video platform built for Meta Quest. Explore premium 360\u00b0 and immersive content designed to place you at the center of the action \u2014 not just watching, but truly experiencing.\n\nWith an intuitive VR interface built specifically for headsets, WexVR lets you:\n\n\u2022 Browse and discover immersive video experiences\n\u2022 Watch high-quality 360\u00b0 and immersive content\n\u2022 Enjoy smooth playback optimized for Meta Quest\n\u2022 Experience content in a comfortable seated or standing mode\n\nEvery title on WexVR is crafted for immersive viewing, delivering depth, scale, and presence that traditional screens can\u2019t match.\n\nWhether you're exploring new worlds, watching exclusive productions, or diving into unique immersive storytelling, WexVR brings premium VR content directly to your headset.\n\nPut on your headset. Look around. Step inside.", "short_description": "WexVR brings you premium 360\u00b0 immersive video experiences \u2014 watch proprietary VR content designed exclusively for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wexvr.com/docs/privacy-policy.html", "developer_terms_of_service_url": "https://wexvr.com/docs/terms-and-conditions.html", "publisher_name": "WHTEXCH", "support_website_url": null, "website_url": "https://wexvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26809469015370028"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299132_1322276926423514_4920856531324455210_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPflHHH8HhQQ7kNvwFrQJ_j&_nc_oc=AdrMUVO1ZL3e4aGkflsqic09a4xC7-e2u-LiTAMbJm9MRP0YJEv6NHqW2u92ODdlg8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.co
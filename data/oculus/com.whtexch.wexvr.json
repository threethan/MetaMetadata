": "1585693679564778", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499302770_1585693682898111_4729193947684875021_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3bYJPFZmjUQ7kNvwHo8rmD&_nc_oc=AdpmeiP30zG8u_F5Ud5LJ567P8quz_33D-GgJdLr4KzLbBSzOepD-EV1uyVD4lHwBfI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZoGPBoHUi3O3zWvsr9vi6Q3S4hT8x0AlPK_6ctOl3XQ&oe=6A11C1ED"}, {"file_name": "633453380_34178714891712714_1245536382219991143_n 1.png", "id": "876747555342682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312332_876747558676015_2508613613418862699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9TZnO3w7vMQ7kNvwHXJt-I&_nc_oc=Ado65Hq70XQ_j1srSF7d8rW5TNZb9KXyDkpjvWP2WT8mbnWZjzzWBDMB6xJYvG_lky4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_RyUYJheJSh7mj0DrLr3L-E7CoD0sKXoTX-GhSFQ3Nw&oe=6A11C12B"}, {"file_name": "633792270_25904263662573973_7282656651064214453_n 1.png", "id": "1315544220594692", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304952_1315544223928025_3805685080948985276_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhmtmHXkM7wQ7kNvwFKeEWy&_nc_oc=AdpxOaWyD-i4tGAlpXs51aB3SKncVKVvMgjBPUe5c3veq2Vny6jekeN6srWSFnhgccs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V5N17-tGgSsSfkzzj3yx5eCPYYNDmhbfdnJd3TsrXkw&oe=6A11BE2C"}, {"file_name": "634766816_33769603886021398_7720308037698937167_n 1.png", "id": "1580441983178113", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499305050_1580441986511446_7975432517543561007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3JPXgi4N78Q7kNvwGc72-g&_nc_oc=AdrfZe8yYm0Rd3Qak4NoW12WYP1xeSyUVmJOx44NXoWwah9OGfj82i2TkaryQ1mn46I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Iq2B3fwfKXR3aTYgteXyZArbgZbRcHcJKat47vZTrSA&oe=6A11B757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wexvr", "keywords": ["video", "360", "sports", "immersive", "media"], "long_description": "Step inside the experience with WexVR.\n\nWexVR is a next-generation immersive video platform built for Meta Quest. Explore premium 360\u00b0 and immersive content designed to place you at the center of the action \u2014 not just watching, but truly experiencing.\n\nWith an intuitive VR interface built specifically for headsets, WexVR lets you:\n\n\u2022 Browse and discover immersive video experiences\n\u2022 Watch high-quality 360\u00b0 and immersive content\n\u2022 Enjoy smooth playback optimized for Meta Quest\n\u2022 Experience content in a comfortable seated or standing mode\n\nEvery title on WexVR is crafted for immersive viewing, delivering depth, scale, and presence that traditional screens can\u2019t match.\n\nWhether you're exploring new worlds, watching exclusive productions, or diving into unique immersive storytelling, WexVR brings premium VR content directly to your headset.\n\nPut on your headset. Look around. Step inside.", "short_description": "WexVR brings you premium 360\u00b0 immersive video experiences \u2014 watch proprietary VR content designed exclusively for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wexvr.com/docs/privacy-policy.html", "developer_terms_of_service_url": "https://wexvr.com/docs/terms-and-conditions.html", "publisher_name": "WHTEXCH", "support_website_url": null, "website_url": "https://wexvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported
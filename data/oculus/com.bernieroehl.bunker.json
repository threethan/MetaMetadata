7GexLG4KxbdH62vdrwzzxqHlbpw&oe=6999AF23"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trmrop4vq54Q7kNvwFe26cu&_nc_oc=AdkDIgz21xuxF7BZdMcMdKX5TK7Sfjx81O0lzpW0O7YWBSm-3H21hlP5G8TAaR2O-IM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNg4pCJpItbaDRxxwLzf43DTywaUz-nhIidQ6alO0HgA&oe=69998FED"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA70kt_UfH8Q7kNvwGd73DW&_nc_oc=AdkNNmVP0sj7rmJgUiQesm2AYHHKW4IK5GPbTzAwjE7FSYQjzwN9abgDHgjY1f9l4qM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7fZ_DJQVnyvytSiRdgF78mzM3INdy60nu3aJ1s61jUA&oe=6999B06A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]}, "developer_name": null, "developer_privacy_policy_u
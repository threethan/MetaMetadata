VaCThH6JZAUo29RbV28HDOb5mhFWtTOYuCW6upprN4QFg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxAHqx7vh3Q4ysuv_aNJk4eepbWA4cPk4HFVNZVgrQWQ&oe=6A8065A3"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkc9lESDDYoQ7kNvwGve359&_nc_oc=AdoLvzlKuXweR8y5-mVtf9hRoSXQ--w6mk72IXeeognbS_d7fG-bDhTLiriu6yaqLi4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7co57FISUHklv14iwpGqDbYozIiryyF-1gt8hsaY-Ag&oe=6A80466D"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iWaT98FMuQQ7kNvwEDW_6s&_nc_oc=AdrI7gaHrjfJkEk1EL_FOxPARBTzzYdr6DT8vQjghLmTDyknEnXyRhC78rvChm6TZJI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKph44tXvmwSDzpvW7iBgs6tkdlNoMr-pogtQmurt3w&oe=6A8066EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "developer_terms_of_service_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "publisher_name": "Tiriam Immersive Media", "support_website_url": null, "website_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "323154106528627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12449016_500595363474300_32568515_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghNMSR7chVkQ7kNvwGHHFhQ&_nc_oc=Ado34qtvBF2-g0foF6s0klbnJucxa5kuesTQw4yanvchn6tNiNOLYMJke7wCCWtn31w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqSFPF67wlum_EpvoyQhaGNNffOnI9DnVEpcGYuzANOg&oe=6A8041FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape From Bunker 14", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1459321200, "lastRevision": {"nodes": [{"id": "829856257136309", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1312603832098804", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_
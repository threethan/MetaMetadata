oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wbBS-NlxiK0c53XfNqZc1sGAAhiywiz3oJ_e-XAgEiw&oe=69F203A3"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_k9g-ta5E4Q7kNvwGJTUT1&_nc_oc=AdrhPcbP_FfX-4cd9n9Fd9V6RsxxFifS9v-CLGe34Rh6G3MMQZoFuOr6ZkLVTI9JfgY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1piewRGnZB_WsyTGeHnJm6nG_i0VgVC_6AvhJLjw5u-g&oe=69F21CAD"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMIoNxY5IjUQ7kNvwEeRQ0A&_nc_oc=AdrPXe5HL0CK0nHCuv54Ev_HZUv5W2VZGlBjzgQ7uKAAU9qmKLVX3J2rStKljV43I20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0gbp7pRWxN2IPYeYO4A2_LoGDRm9xmtquOnyttBVOLsw&oe=69F204EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]},
image.png", "id": "141739770561339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_187304251640223_577999780_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvEQ6tR4MokQ7kNvwGugh9J&_nc_oc=AdqIojeBTQrl98KQsky_k3ko_yHtUW4O_FpiMAIB3g4iVMXHKxuiqAAj_4ekfk3kI_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKSFe3gam00NEoa72kKrx9JCqm1np-w2s1yA5BT0CE9g&oe=6AFC8AE3"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_F5FdAXD04Q7kNvwEoKMvZ&_nc_oc=AdrAUQGDJfy6cJpOzFIqrYozR9NeFrsHrwRv11aaQc0zooCjBhfaMxeYAmQyaWMj3ao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUCUgG9iXGYpXiuf12Rhqvaw7SUFrBricKP07LpAmjGw&oe=6AFC6BAD"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLsxk1EJWokQ7kNvwHNvtIJ&_nc_oc=AdoDxdutlz7c9sUvpCVx3QXqtYLfhGwPpN3fc_dqNgam54-RStK-4mFU6QGDN1Yf7sc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZYgMOPRa7GCi8-0cSpyY9_55hIlZz6_PhQ89PQ0NsMQ&oe=6AFC8C2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "developer_terms_of_service_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "publisher_name": "Tiriam Immersive Media", "support_website_url": null, "website_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "323154106528627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12449016_500595363474300_32568515_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETrRrFxjfiMQ7kNvwGRhVuN&_nc_oc=AdqfFx8PTZ28q6jP3nwA04VFstNolzgmLBLIKbthcDRKbTpqwYmYWELtJpXiOxqrVnQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXy9TZiSYuffixGxUEoa4fs0DCg4U24XNK2J4M7DwXA&oe=6AFC673F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape From Bunker 14", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 145
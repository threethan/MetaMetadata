2BnH7qvK-XB1x2ue9s8auVUCcSl2-Fk5-Fiqo3TljU7Zs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpoND_r6mr_zbeltiWe6mXCIY_3ZksJMfgHme2SCrTig&oe=6A89A023"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOkJEh1b3wUQ7kNvwFT3PNt&_nc_oc=AdqwC5QzQi4xCOgO1NeISH2d_Y43fxtaeoNUeX72UdVVrqW5nDFJetPMLrW4EwqTHEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFP2vlww5m_lK3ZVTJ0CbVQlwHozrH_x1W4MEeAzrZ2w&oe=6A8980ED"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbbpatJEoCUQ7kNvwHMrvH0&_nc_oc=AdoLF6hY2x5gQgub3__eGPtdwHN7uonJ2tT5aVFMUr5DXYbsZShqNvl56SQN1HSmT_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOWlolDLtQ_iaKRa8W8fTBD_9o5DVLm1_eHRGz6jcvMA&oe=6A89A16A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "developer_terms_of_service_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "publisher_name": "Tiriam Immersive Media", "support_website_url": null, "website_url": "http://www.tiriam.com/#%21bunker14%2Fcs7r3", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "323154106528627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12449016_500595363474300_32568515_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HadNtWkh6K4Q7kNvwEX7OQC&_nc_oc=AdpFXpyOqHPGKOoi7wpq2XL6SA7gx1TUeMnAvN__5RtBC4jLz7209NDwGzgi3Qh6Wm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6Thbplr9WN1PZum5VOotr9dZzhMA-kfaOsHPaY7xJDQ&oe=6A897C7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape From Bunker 14", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1459321200, "lastRevision": {"nodes": [{"id": "829856257136309", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1312603832098804", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_
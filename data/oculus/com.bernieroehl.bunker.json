PbKe5BGo8Q8ZSPxJx3W-rfxcE5g&oe=69A6DE23"}, {"file_name": "migrated_image.png", "id": "237763994282854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138838_1314483055234976_1983914333_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuyR9ncmkeUQ7kNvwHWHTjw&_nc_oc=AdnI02O4ovjmZlhOuAoKMYQlFcyZDpBWdUfYAZFHMw-55zdgdWCdNevEXmiAsW3AVR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxFLomfZ9LENcImnyMGRN9dfP2d9rQbWxmL23Hbbm05w&oe=69A6BEED"}, {"file_name": "migrated_image.png", "id": "233766967751445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162739_1665992893655746_1594083282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4Hf1EFjDfEQ7kNvwHHuHGk&_nc_oc=Adn6RwAO2kHTUBjAjbFOFXHCBtZU_Mv20mnuz-l4CoeVdKibx2fuMvmY51-RGNn-0PI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8jxPQkEgrNGPB8z_gRxtBMZLZprXcM9XBdlyeqPXcBw&oe=69A6DF6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape From Bunker 14", "keywords": ["escape", "adventure", "puzzle", "game"], "long_description": "You begin with no memory of who you are, or where you are. You seem to be in some sort of military bunker... but why?\n\nAs you descend through the levels of the bunker, you begin to work out what happened in this place and why you're here. In the end it becomes a race against time, with high stakes and difficult challenges.\n\nThis is an adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out.\nNote -- this is a small game, with an estimated play-through time of about half an hour.", "short_description": "This is a short adventure-style game, all about exploration and problem-solving. There are no zombies, no \"jump scares\" and nothing is trying to kill you. It's just you against the bunker, as you try to find your way out."}]}, "developer_name": null, "developer_privacy_policy_u
y5f80DybvTgKAyktXvGwt3Ew8FSmFeCfZDFjOGTdj5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs-xnrY4T_SYZLaI5Y2WnYL5c_wy2uJ1mVBeZ1khUy4Aw&oe=699D9E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud2b8\ub808\uc77c\ub7ec \ud45c\uc9c0.png", "id": "923945151828818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_923945158495484_326985208110092383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFVeA4QkTicQ7kNvwF_eaIQ&_nc_oc=Adk2EWS0YFHR6lBjrhyQp7OtPpAW0ISAI9cdAAnpA58UhJKNvr5V7J7daiPV6hg2uw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTY_TZcQkVNRmsdpX4o4xQFL3itoELcJtGxlJ1-b4yUQ&oe=699DAA27"}, "display_name": "Starflex-VR", "keywords": [], "long_description": "- Global NO 1. K-POP s3D VR Contents Platform\n\n- * It is a platform that you can watch K-POP IDOL's performance through realistic 3D\nVR contents\n\n- * You can enjoy a clear VR contents of 4K quality.\n\n- * As a 3D VR music video content, you can enjoy a video that is clearly different from\nthe existing VR contents.\n\n- * You can enjoy various contents of K-POP groups such as performances, music videos,\nmaking films, fan meetings and V-logs etc.\n\n- * You can watch it through streaming service and download content, so you can enjoy\nvideos seamlessly.\n\n- * VR contents of a new K-POP group are uploaded every week.\n\n- * Not only K-POP but also various genres of performance contents will be uploaded.\n\n- * Starflex-VR provides English, Korean and Japanese language setting.\nOther languages also will be serviced in the future\n\n- * If you add Starflex-VR on your \"Wishlist\", you are able to be received updating\nmessage for a new content continuously.", "short_description": "In this platform, you can enjoy various music of K-POP's top idols realistically with s3D VR. Not only\nK-POP but also drama, movie, fan meeting, making film service will be opened. High quality software\nis provided through Multi-Camera system. Please join us. we'll guide you to VR metaverse platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://admin.starflexvr.com/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Starflex-VR", "support_website_url": null, "website_url": "http://www.starflexvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC_VIDEO", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1162243841246565"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5704814966254446", "version": "1.4"}, "id": "4363719957068462", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4251495034919787", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5704814966254446"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4363719957068462"}]}, "change_log": "Bug Fix", "created_date": 1676264747, "id": "5704814966254446", "version": "1.4", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": 
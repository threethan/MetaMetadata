jBhUiZAodzfmnD1NGa2D78y6e_MhjveN_vfIuSC8Wczql7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi5nUwBEQRNX52u5iCis61-YxpbuKiJvK0YZ3By7n-Jg&oe=6AFDC43A"}, {"file_name": "com.VRPlayer.VRClient-20211222-160847.png", "id": "399698475280264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974537_399698478613597_1098849269948342817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aedBjvTKY14Q7kNvwHhaW0F&_nc_oc=AdrPfsAgOS4z6a3zWoV90i4upFjmj0unwkgwcbqbQfyvnFLacrIfoReTm1rCw_YlXjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQs4gVPfUfL64_JyVXPGrYOiDPCObt2GvylIzM_xJhuw&oe=6AFDD75B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud2b8\ub808\uc77c\ub7ec \ud45c\uc9c0.png", "id": "923945151828818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_923945158495484_326985208110092383_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKPpxOmI8g4Q7kNvwGdohFC&_nc_oc=Adpzu_C-Xx_8yLiLvIL5acPK-AwDR1vf0VTHAA5la9PnURaSnli8lnmBMhF8mrJCAnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi4DdGrSb9tknGC1O1uhOqfOG1IPEYNzIXaRjZRGUZ6Q&oe=6AFDE2E7"}, "display_name": "Starflex-VR", "keywords": [], "long_description": "- Global NO 1. K-POP s3D VR Contents Platform\n\n- * It is a platform that you can watch K-POP IDOL's performance through realistic 3D\nVR contents\n\n- * You can enjoy a clear VR contents of 4K quality.\n\n- * As a 3D VR music video content, you can enjoy a video that is clearly different from\nthe existing VR contents.\n\n- * You can enjoy various contents of K-POP groups such as performances, music videos,\nmaking films, fan meetings and V-logs etc.\n\n- * You can watch it through streaming service and download content, so you can enjoy\nvideos seamlessly.\n\n- * VR contents of a new K-POP group are uploaded every week.\n\n- * Not only K-POP but also various genres of performance contents will be uploaded.\n\n- * Starflex-VR provides English, Korean and Japanese language setting.\nOther languages also will be serviced in the future\n\n- * If you add Starflex-VR on your \"Wishlist\", you are able to be received updating\nmessage for a new content continuously.", "short_description": "In this platform, you can enjoy various music of K-POP's top idols realistically with s3D VR. Not only\nK-POP but also drama, movie, fan meeting, making film service will be opened. High quality software\nis provided through Multi-Camera system. Please join us. we'll guide you to VR metaverse platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://admin.starflexvr.com/privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Starflex-VR", "support_website_url": null, "website_url": "http://www.starflexvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": ["MEDIA_PLAYER", "MUSIC_VIDEO", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1162243841246565"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5704814966254446", "version": "1.4"}, "id": "4363719957068462", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary":
3537393708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv8VT0JkcUAQ7kNvwEvvyxs&_nc_oc=Adl9G9pHSEudYSKnWiSWMtMIkADkRmDMcJFQgzd5A0LCEVWvkVi-Lees-KEsJZHejv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLziLXFQpOVwrULleqRF9q-TyoES-yPpsYRetRv11M1Q&oe=69A02C63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avCZapJNjUgQ7kNvwFMQxBc&_nc_oc=Adk05WFAM-p5LN9zZ1y9i7Yhm7_nsnUiggfeaLn15c-ErGUCETHyVAtPdNO6raE-Umg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvZ0pGWzStlQdigq5tcT90Ho-u4yuThS1oex_Cv_zjXkA&oe=69A04525"}, "display_name": "House of the Butcher", "keywords": ["horror", "shooter", "quest", "puzzle", "evil"], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support Oculus Quest 2 & 3\n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
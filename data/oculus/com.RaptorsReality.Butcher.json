3537393708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv8VT0JkcUAQ7kNvwGGu9Gj&_nc_oc=Admnzts4X3aISsFhuxwVmT7Q6hVl-t_59gUsahFAh4bgldFhwCc96qiaoHClmMRFIoo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftoBEEpb-zL0ftMGuHAtceMxq2j99LC23p4sxV8MB0F1w&oe=69A17DE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuQm2u9wnG4Q7kNvwGhDzJc&_nc_oc=Admso1s-1cB35_Oobtd8S7q0OXX69RpMYvK2Fm9wOKs8KLSpwOJ_OldBhdiB8oBfnwU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsqR4gTYHChpquOsA-gaDhPkZgOP9gUv-ghl8cOy4fpaQ&oe=69A196A5"}, "display_name": "House of the Butcher", "keywords": ["horror", "shooter", "quest", "puzzle", "evil"], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support Oculus Quest 2 & 3\n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
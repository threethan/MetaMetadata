3537393708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngDsZ2U2Ox8Q7kNvwGXDiUs&_nc_oc=Adk8LiKMt1UUHkTTlJK5oNozSUmHJBQwyE_jMikfL93iNr8iYRUUgH83uPzJNSgvjy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQGXnwNnc626sArwXgNDTmAHeaxZsU6uq9lA2zJdnunw&oe=699C37E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG1JS7yaudQQ7kNvwHmMuFI&_nc_oc=AdlRcS2Qa6hCKcg0HUIXgNFElIOyRoatzpvvY1xJKu3lIBcBCGfm649F7Vv2VtGTjEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHPZK5j-SOUGbG1gd0H3fwAzrs5EyOp1ThOcu4MKC3BQ&oe=699C50A5"}, "display_name": "House of the Butcher", "keywords": ["horror", "shooter", "quest", "puzzle", "evil"], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support Oculus Quest 2 & 3\n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id"
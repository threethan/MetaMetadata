reen_2560x1440_.png", "id": "3314433392109438", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348041_3314433395442771_2202454263537393708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah_QjDq8ggwQ7kNvwEiAxDJ&_nc_oc=AdpwbmY60HQiB3J4Qe6SLu5BI-0pTyxf8EFiqlGwAivnoAIJ89c4TnkilNceqoVCpM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jSw8x-i8trgxixaQee6TqcTQ6QUin3ib89apZ7-GtFQ&oe=6A088B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFaJiKcilE0Q7kNvwGNVZDY&_nc_oc=Ado-8TNWihOSstUExUtKYnh9oZZRUxxCAavzu5z5nvz387qpwgtiU24pyQ7lriINVo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-aD-_eHtG5dNJdGLAsVzu8mofxsidRi7hyNyl2el_Kg&oe=6A086BA5"}, "display_name": "House of the Butcher", "keywords": ["horror", "shooter", "quest", "puzzle", "evil"], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support Oculus Quest 2 & 3\n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "CO
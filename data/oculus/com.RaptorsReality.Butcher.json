_3314433395442771_2202454263537393708_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8jqDtjw0_IQ7kNvwH2aiI6&_nc_oc=AdrLzAj6aA2e22gB7Mfb7HYjiNORatg__Pl71HcTZuSrZhFlNaFD_b5mwC-SjPXJRdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7uW37NLbgq9aOYBxMgMoR00G7mC29KxMmIYjnQpGWIQ&oe=6B0C7AE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvsizMaTQCUQ7kNvwF8xhL-&_nc_oc=AdoCe0e36QK7lIs35-2Xu2GKb6HdI9s9CpSWrlJkiDE7uK4YiowQ2-jBLmWXzdGqiv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpoo2Kc4IQOFe_eLi1WhbDCJ4EBk3jD8ZTWI-NTAhoQg&oe=6B0C5B65"}, "display_name": "House of the Butcher", "keywords": [], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support \u0392oth Oculus Quest 1 & 2 \n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
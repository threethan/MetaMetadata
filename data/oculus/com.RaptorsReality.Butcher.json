_3314433395442771_2202454263537393708_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEXoIPsr2C8Q7kNvwEPb4Qk&_nc_oc=Adp477mYaAoOQ-wvJ9OFKfyUhN-f3i4q5QC6UcqPbvZjS0sqABtMdKgSCP7UBYF4lFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkE7XrJT1X-K2oI7LhVKiKMOJudieb2TaGEG1QnjEnZg&oe=6B030823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "816547639394412", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035322_816547642727745_7998601187497381217_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUhCoRu9_cIQ7kNvwGp7ybB&_nc_oc=AdphL8FQJeQR404vXdk7BgGbTPfF46Ve7wXHFuDBGRtXQBgghKFuju93X2HeVIFLg3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsQPxfHO7mlVCu_afNzxRAD6WqFloTfdmu0SNSuXaamw&oe=6B0320E5"}, "display_name": "House of the Butcher", "keywords": [], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support \u0392oth Oculus Quest 1 & 2 \n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
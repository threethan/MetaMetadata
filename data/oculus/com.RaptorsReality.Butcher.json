wqfQCYNoLsE_uJI1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyo5Z3byFUMD8kEZ9LdPSz0c0VRaUEWQzWkKjvZKl5NmQ&oe=69CE69A5"}, "display_name": "House of the Butcher", "keywords": [], "long_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements. \nOne day while camping, you discover a killer. Trying to escape, you find yourself in his lair. You have to search for items, solve puzzles and find a way out while the butcher is hunting you. Don't let him get close by shooting him or using your axe. \nYour main task is to survive at any cost.\n\nKey Features\n- Support \u0392oth Oculus Quest 1 & 2 \n- Two types of weapons\n- Many different puzzles\n- Free Movement\n- Smooth motion and framerate\n", "short_description": "House of the Butcher is a virtual reality escape the room style game with shooter elements."}]}, "developer_name": "Yurii Kaplunov", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Raptor`s Games", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "755704852214663"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "25911898308504
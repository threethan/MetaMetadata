1r9VrQEzkfwdlwgxOG9OByUUKyqywGKowteRNVAky8GaFKz6IPWQJl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPeSPz9B0BGJ_uHPmXi2FQ2JZDpZ5Ghp7-Mb058TdQxg&oe=6AFDD1B1"}, {"file_name": "04-beginner-programme.png", "id": "1854923015524002", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827601_1854923018857335_6762639268114675440_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXyr_RBlLrUQ7kNvwFXrpGP&_nc_oc=AdoWcGotwuuojKfYr-ng30-OzrClQzPTNnimDTWvV9nayovE1WjpJsfHpok3hZzVFlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs7OVhFp7AdsWxQm5xZZf2onpKQHOWVGwf2MyUPpKITQ&oe=6AFDC66C"}, {"file_name": "05-quiet-time.png", "id": "992904303152613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_992904313152612_2905134394622822897_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjcyxMR8Ei8Q7kNvwGeGWAn&_nc_oc=Adp796kZGzWP64a9uRe9wmz1oyzhIcSBggpsgYykC1FKZ5JGyrvuKHnCxlmgQ-JZflk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYx1guc27QweitbxRnrWvcHe-LA_LDIBUP3dg5GYLEVg&oe=6AFDC92D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-rhythm-play.png", "id": "2272698456913015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_2272698466913014_4931710266694693930_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbo9NbO8ZC0Q7kNvwGxwGv5&_nc_oc=AdqPEvGNFLejj88WCRrI5x0JVJz_FleADvZljWibLEDX-OWLUNcevcIlR6gA3q6BXs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi4yH5xn6UY6yiTApPfXW91vlIATA-Y6HlXjM3OJQwHw&oe=6AFDBE6C"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1078539535005469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620599_2089766848325496_4471379178071837862_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0DVu_0Sp7YQ7kNvwEd33tk&_nc_oc=Adox58CIAzynqNVULwBaNhcvuhw8GIVgkc7by9_4QeI89126i4qPjmQ2UJYyEQEtqWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Ka_A-RCqWveVaE5WZt_qWLbcHt85zjYfX--tGgWYLg&oe=6AFDDF48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Avenpulse: VR Fitness & Flow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1792262160, "lastRevision": {"nodes": [{"id": "1066650602861029", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1066650589527697", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3293913667462151"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover-landscape-2560.png", "id": "3827252577428841", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_3827252580762174_2198283615115080767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhYk1prjpoUQ7kNvwEJ9i7p&_nc_oc=A
t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwAS3uZ0stkQ7kNvwEbXsZ9&_nc_oc=Adp_c5Pe5-TNkhvkOhrirvJXqerc8QyBjB25KCjFmjTncKtIPHNrJp6NogCNYPpGvZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrs0ysRFS6eCmW9Ez_HWOE5UZdw3gamO6OmgxlKaiwnQ&oe=6B09A8CE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1BUpTWWTqwQ7kNvwFB8LLU&_nc_oc=AdpR3z-Pw46zu5WGVKxBohz7iLuXw7EKXGk_4HDh9eOXLJmgwef-Qei3CjUcjen681E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwaoSZJL4ZU-Ng7IlUqxPuWhkVyWl88Zrte2lOeHm3bQ&oe=6B09A420"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEytiwwo7kgQ7kNvwHJcyYH&_nc_oc=AdoMElFCJ1ns2ygNTGuHsxiFx4XPDu6OpGDfWN7yLF5kdhUqUmlEl407K6-aT2UGl0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt6sJDHZgI3wIaWALgiUrnhkZfadxo3ybYjMtIGRxQLA&oe=6B09A80F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jliS8TM8hz4Q7kNvwHojzjr&_nc_oc=AdozidAUAPuZcN1qFIsvh5Qug0X-SAPJoFrv5xOjPYE0ixRNwGQAYnDSjrpg7OC16hE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJIn1vJ9UgDWRJ7bVuzkjWAtB-l567mJYjHCP1MjIm8A&oe=6B09B9CA"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAt1XjC2Ym8Q7kNvwHOaIFb&_nc_oc=AdoLrjG4QFYDPvxMDHVAx_P3ZuJ6OD2Ifo1Jc-zbbZ5ITQOqrbavpbXzFLiK7NCjmLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7hlz2hrC3pJ7Zhhggc5JWPz46D212EGEcUelPuhPcpQ&oe=6B099B22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
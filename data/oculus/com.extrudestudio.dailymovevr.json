t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueFRMB3Kp78Q7kNvwFVHhfd&_nc_oc=Ado0qo9H1EUbMwFS0u4x6LZSL8tOQ5qf0VSFwcV6K4dmQt4-e157Rs-6v-uC3cqQzjo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRmZ_wEGdZIMqqbzLO5o46jgYE0_sDYCfHRAdIjxnYoA&oe=6B08574E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1BUpTWWTqwQ7kNvwE1jtyA&_nc_oc=AdoLySw_KBs6VOismmG-OxEUFPSnJvqNT7fvqvIjLBNXgoVWCfvIC4ge2mlhUxqSKZQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtvUO2goqEjU4Kq6Ddign6meT3G2GBeqwXLSkEcbTxEg&oe=6B0852A0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeHmQ17zb_sQ7kNvwH54z3u&_nc_oc=AdonHLdNi9W6TCOMhg889sumZXvplr1nfwdef1uaSb_TAJ1QAm-v1fQR8VaL9-Wr1h8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtdNGqB4aQr_00lRwBdqn7YQX_I_EhjspCIjx4YMKUrw&oe=6B08568F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jliS8TM8hz4Q7kNvwGGnP14&_nc_oc=Adqbkh52WuBLOcbvILUUlv9fSdODRb-oGQz-oJLIr6HWa4dDx2vkQ8XIwBb6yDMVmN4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbkRWWqHX1YQKcZdp_suWgPlBBlq_5G-4dtqAXZw0zpw&oe=6B08684A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAt1XjC2Ym8Q7kNvwE9krhE&_nc_oc=AdqcDzqwFf_eHkYAoqQrgVr4l-y7yl5kGmiRMdMjvYrLObFdwVKjQlxzbwQKwBJaJMc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxRCaBjWBlVrz6kW8uoVdSyvJ9Jk-Ga3QjVVY1gGY2Sw&oe=6B0849A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
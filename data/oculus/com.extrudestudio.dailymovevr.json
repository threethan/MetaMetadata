t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIYNlO3ooUIQ7kNvwFpxfFa&_nc_oc=Adq5OcWmN_XwMT16iSnLcB5EDiq129TDZmKOngeu2agbiwDK0kwI7ircKu2nz_4PCM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKLxN3dwwPUkvcIWrsAcSR83DfAQizKeIi78egcmqaGQ&oe=6B10404E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSQGun1VcD8Q7kNvwEtna9c&_nc_oc=AdqPV5UrKen2yH1VinRduIGakelR6Ke_aqanaqMXbJtuQN7raWzbPjEOCuNbug8Zdug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWq9qXO50Up2u7TSY1DMKBk28M6SLpkBgjJ82wapBfidw&oe=6B103BA0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Puh-7Z4FoU4Q7kNvwEtgqoe&_nc_oc=Adog4Cpstl1hU_cw4u6lDT8XbOjL9GA9g1LkozYapdwSlswxX_E8nClf4eXD4KRNH4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLsmdhhtlD6DsYmODB7T_ud3zehB7l-gQ6BVOwvQlzoA&oe=6B103F8F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6pxofju-4IQ7kNvwGKUiSO&_nc_oc=AdoLW8FTGoCACcOaDs0osELMmrqS2Ek1BtQrFAl_xsofEB2YDC3-z_sFFThYfmpiadw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjIquzbHRfgu4nb0PuwWm3dN9bo9ioY8ZkDyIrXc8LYw&oe=6B10514A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGgCuu40HeIQ7kNvwHIoldX&_nc_oc=Adosz4VnH6KycSseSmgcCAP0glr4CJcyYsRiq1gcw0HwJb1xDjzOg1da55OaW033Tkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNSv43KLowsFJjGooFumIALSmxbAT6rDweTvU-LGi3zg&oe=6B106AE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuo6_6N7c6YQ7kNvwGSTyEv&_nc_oc=Adqp0svC2Ldp5s_NOE4jv251Ulxkwz1S9RD2Bq1Okd6LXER72f7_if-oZjyVOf8efPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzWGKxnozqIKcG__bc2vjipT9VZnLA9xZGXOSe54SY7g&oe=6B06FF20"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woa3RCapxyQQ7kNvwH4vIJU&_nc_oc=AdoZYxB1k6825odPl659JOsP8nSnzVRB8b5sGzFehr6Aka2biyAP3w92trPQnR4YOTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5fWLMWkGvJqgM35A-4cHeeq6fKU7nmhSwH46HW17bg&oe=6B070ED9"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N30w3QZenOQQ7kNvwHY8cUB&_nc_oc=AdoZFcIYN3WsJWFqdb_7hugyEmidLaqcaiPxDiqgsDuiXC17kg4G9x-pghI3HB2PElY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdWj9HQBmaf-048Cf0SvzSe1BvQzOWingeKWwlM9oLtw&oe=6B070F5B"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rfxa7YnymoQ7kNvwGm7ppo&_nc_oc=AdoXaDTrDIK-FFxg33rQBkUwnnvV-v4wmDpBcJNUfaQY9E1EaFZVEOi3G11P7Tqpfcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT82L-_APT_rOqbMv4pk4NEoxjcvCu6knEhsrxALN44KQ&oe=6B0718B0"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1M9QXw9WIcQ7kNvwH_Kd9h&_nc_oc=Adqs7AzSkvWseK6z7tXR3_pf0sML3-_LCTzKq116JeF12M52-GYQTeHrAha4p2R4oVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg4nU17UXFPXIPnBKmHW6aJVIa7gq36GXDCLE3hh9m0A&oe=6B071050"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOxw2ZC8YgIQ7kNvwGMJBsg&_nc_oc=Adp4iCbil_wjX4ZsHEgQJcZ69ruxRNV6pufkTpRdsy0OWDgMlqxgH79XIj2Au4eZD44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhwUnt6MCF0vWgwU5Y5BobV-vXMN5vgyfQN_Jz6uf-Tg&oe=6B06F262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ED_rNKxhTgQ7kNvwFeDOxC&_nc_oc=AdrvKiDTujPG7dz1gFNOnyJ3mib8F-VgN8hBXi8iDG02S7J7LMKZ77G1V_jZXYqCMcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-QqAyyclZOaEV4uFPl3v-NcteQ0kPGbJ8jK0WbkPEqw&oe=6B070EB6"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueFRMB3Kp78Q7kNvwENbAvQ&_nc_oc=AdpyvjAhy-cQWmKieYxxg8Qzg49u2ymd585o9KuvKzfEgeeDnYsRW3N7cd5iiFbbrhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8MgyJf0M9diY0dZSR_-B-RVlrpeiTqlrS0DX2xRdlIQ&oe=6B0705CE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J1U6Va-o20Q7kNvwGENqO9&_nc_oc=AdooUFa1gkUEedTi10BLs4zHHKUx-eV-MxBqUnXirYeNbIN1Z0Vaeh9LBTUN6Hz3JtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJWMBZT3p4JzmO681nFm2N2L_At5URQqu3iD6rH2uT1Q&oe=6B070120"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeHmQ17zb_sQ7kNvwF4CtiS&_nc_oc=AdoaWiEsHGkhrlTCcSxt10QzCzsoIqaCRFZNE4eQfFMNlPiV_6qoa5Y-AcnW5nrYGPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaSbwKYHYtaweafqSx46kz4JwtCYLtbOy2tzHZmNSIig&oe=6B07050F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jliS8TM8hz4Q7kNvwG1NbPa&_nc_oc=AdqFiQptt734lSOGM70O7t9fo_FN59dT-Hg23YCuXd-4xJS8-dwUyjV6WfOAeUBsah4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3J0YFNGX4lcfI9LqGuhjKY70FQeaWxCQ7I7zbkoptqg&oe=6B0716CA"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAt1XjC2Ym8Q7kNvwHPhG3O&_nc_oc=AdrGkFOsxEQKbfDD37vb7CN-wce-P88ukzK6E6Jn6SgFV0Mq7nPm12OrKBkNkQDO-Lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW0o9xCsrEp5fQq2aqUkLORnDDhg5SkChcYBbPNpUOHA&oe=6B06F822"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
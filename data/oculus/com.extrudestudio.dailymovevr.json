t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwAS3uZ0stkQ7kNvwFe5hB6&_nc_oc=Adp394PPCp39qUGz09hemjgs5SBCAC2Iuz-Wx6fmDDyjwVat1GVpNP8sRx1vzTZlnEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJcAn5lTk4qHYtIDJ_9AioTaIwRWpxUiMxgx_Q64nqKQ&oe=6B0C4BCE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHZJM_H1AEQ7kNvwE0dNoM&_nc_oc=AdryLVfD_K4fhpuN1xxPOS3kH9vnciv6Nc0GFGKvMBo7KpNo_w1P1n_tUxvZMsMJ7qI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoYfSxQUJY0EMyt11IEsSpsFmJ9jTCCBNFentejoIG3A&oe=6B0C7F60"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEytiwwo7kgQ7kNvwE4YBL8&_nc_oc=AdrHeMOYQu3pSYURaeVH4Bffv1Xm1XxnuIRZ946ExAdX2EDGfNv3VAJDHVggOXAXnu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9pzYTv7SsjQ-fCoM58DmB1Dfy_od2piWPKLL140XjdA&oe=6B0C4B0F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efibYryZDIcQ7kNvwH-KpBe&_nc_oc=AdpaW_0FKKTF7DUvXKOSEkhaRYcxuNIcwTx47YyVz65ANWXITQ6Wq0hPPxiRkvnk9SQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzPR2W8Mhb4BzgkNfxi8N6Bk46ZM76otP-UrlxPST0Rw&oe=6B0C5CCA"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GWQNf7erLUQ7kNvwH9NLB-&_nc_oc=AdrpFsGG8lBiFOjz3tVJz1DrQBYZBty95Py9hRSIOMGwWlJxznSPyiem8kkAYNVb_u4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTebxAHIwkgANCJqXSYlJBIW21vOgbH40VJ61ssAlGuqw&oe=6B0C7662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
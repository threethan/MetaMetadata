t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqZ44Bm-bCIQ7kNvwFM4ulv&_nc_oc=AdpBmvddjk_oA3fqinHRRENldwjVPFC28AMzmA3kdwtD7_Yk7o28qTY7_4aV3PCbOyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8XWBNG9dJH8qd0c5zpQ7eWs-xeh12D5Y8MnK8NpRTPw&oe=6B0462CE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J1U6Va-o20Q7kNvwHtk3XG&_nc_oc=AdrUFXp5Ke22d7dQijJSl32lCH1W20HCGmo0g07totmlOAUCTN0rWlA1ByHWNeIsVdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEiE73mRAvOr4Qs2BZo-yszq4aWtonxsAK-CJ0kdrioQ&oe=6B045E20"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6ONyrap1nsQ7kNvwHDSHBa&_nc_oc=AdoTqym3HL8iX01VDCNf_lCKL9nyeVAy7z16iC7lpsD-CmG2Why-N1E1rgZ1efTk2ho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtJKuKs0b8To9UwpTzXvj32w_5aVQ1zlw1BoyHb8RYUw&oe=6B04620F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl9XMArBupMQ7kNvwE58xkF&_nc_oc=AdpW-6V-tQ6liB1exnhe1gslkJoayGyfRCdVj2rdS10iSUeqfCDL-qiSaN672pNyn28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMH2RvrtLhAXz-AKA-lRpZMnVCwmcMmio0ZN8dA6drzA&oe=6B0473CA"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N_lMZPQytMQ7kNvwF6gbTt&_nc_oc=AdpZWducRnUgM6kzyHos0z2LrPDTbEwiyU3SsAImD9wUY-df3TIReZOmiPrDTPxvVm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE0Shnl_MJE-I7PYw-Cig3VJPYk27TdDgNb4NzdcOY6Q&oe=6B045522"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
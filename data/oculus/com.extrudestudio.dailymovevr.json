T1JRcptg&oe=6ADF78CE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy-c20lIgNUQ7kNvwGZ8tGO&_nc_oc=Ado5tV4gN4iaIVrhlDfjp4F5R0R4yFydihxI0HNKIALZx199Jbzg5HFEGZC_iulJbRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTu4XDZu6Mv36Ih_DwNNSK860_6qgUF7yRavAoqG8HbA&oe=6ADF7420"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKFlxBlDhBEQ7kNvwHJzWYk&_nc_oc=AdoeWxr6UB64bUtCLlnWHKMeGq5pKr-Jqv2POcjkbsJawwKvlVltSpYZbRWpCM8JdbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFJKESFBtcSrCpp1A6IbNqh7Irou4VbQKPC0ae9GerTw&oe=6ADF780F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNoxnDLX2H0Q7kNvwFcRFof&_nc_oc=AdpIp_CZVdjyIzwogbzD1Ki7o9o-m10wXAOdc7lASbNfqjGdAhEWj1foDqbjwWe0fXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwo3l5ujYaX0z6xbYJgrSVeTl90_qmYpYOHadKE5UYfQ&oe=6ADF518A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E3RqKLOSKkQ7kNvwEyuVXt&_nc_oc=Adr4nWeSmRQ58O4tXZV9GghFW_covkLygheVBYey7aFO2YYLvFKEzThdOdOqHTHFT2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7MCi3s4d2alo8QIJNIXrDNGlXDSPeFOOaSfgVdteOSQ&oe=6ADF6B22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_r
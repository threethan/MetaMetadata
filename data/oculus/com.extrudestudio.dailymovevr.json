s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLwg5vZnfmgQ7kNvwF7fAKK&_nc_oc=Adq9p-trZGKqG0RA9rVWPw2bYVan-Io2NVT7alkwkNJM0O62N21Q6usQk2pnWs1i3ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklUcV0yE3tH4g4rMVQzVhE63XKtA7VRGGCxPg-JTKKA&oe=6B05ADA0"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woa3RCapxyQQ7kNvwHg8FEy&_nc_oc=AdpF_lE0aZ6g0mOqfMxRBfOVuffocfI981LoPp3Re9uaF9N5deIdSfI2QqGh16scSXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUbHN4a_8r0rVLvPnI1f8CFwX7BIZRHytyA2mu8C1k2A&oe=6B05BD59"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N30w3QZenOQQ7kNvwGzBdKQ&_nc_oc=AdobPz5CYZIjQpnRmV-tl5uB-W0AFNBbNkWaZt7H-zgjkR9cQaQao_UkiCl5fZv1Kac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe0W0dTnwglOnUH5Wq5y0WCUdGTJcgHh4LAe6xEWKCFg&oe=6B05BDDB"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rfxa7YnymoQ7kNvwFOUj64&_nc_oc=AdrhA4Y96Yh8HCrGzSy2ciBNmAuWsreCFFi0LmWQYzjMyJQaoHM01rwZy2L3f2gnsAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUs73sDkW69Ugh2vUlNASn7xilCoc3HVpdnBtZBcgEIg&oe=6B05C730"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1M9QXw9WIcQ7kNvwFyvXVy&_nc_oc=Ado3nu99aD3O9UZ8jCg37TnQAX4jCQfzeZYikOXWEuKlzq97T1jJubHYMY2apaueu-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoFMFJK4G8aazYH8VR-ComRzrWYSxpW4M_BTzD-Rjjog&oe=6B05BED0"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOxw2ZC8YgIQ7kNvwG_LEgx&_nc_oc=Ado4oOhsXOwLoGzd7v4XLJFZMMPML7RK-jBQMLLjF-4P2xL5mUJFVf8cXIysVRRgnyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOvtpg7-owH1bit0E8Fkk-WkU4x8yoXYdYERLr9V93Q&oe=6B05D922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJizOMvQuZEQ7kNvwF7bXlq&_nc_oc=AdqXtC446Wjq3YrrRhBtKnfWgVriqtae_KE4xrhjjvoE_CUVH45NCibKoIIn0BXq-q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqRdkYzdoAyJQH6bxyO6kqULxnOIie8Df8CIq-BdTigQ&oe=6B05BD36"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
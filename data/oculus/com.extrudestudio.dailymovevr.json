s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB0ZywQWBQYQ7kNvwHRweA4&_nc_oc=AdqiLFZLhAmY4kozldxtZXkNPAh1e05JRyfrev1BiEgVfsxHopuJDiNCsXL2P_bNm_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9lz-9urJctBaChqNEeNA3jRbbQLLYif-wrb9xcNCD4w&oe=6B1039A0"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvwdhUjVJU0Q7kNvwGfrmkl&_nc_oc=Adpd5oEeZL1p4vtYU5ETwH8FHC8NsWn4eVlvAz1r4B758cvSrxI8maRyllMCKyXk4CI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdh2FKQ5RZ50LgA98go-FzcPMPTqSwB019SnuZpaKR0Q&oe=6B104959"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gFlPPXJBugQ7kNvwFLIWzK&_nc_oc=Adpk1qI6HMdoXQL9hJwhfygRnOp4QUKIzIgfz3BM1psrK250UnbohZ8qxGi-ROLcEM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWe8UJd883JOw0uD4pvs9PAk1UR8VXBCnwFVRRWMZkIQA&oe=6B1049DB"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynZ3ycwQK3kQ7kNvwH8aqYH&_nc_oc=AdrWOf2TH4BAPS8GjBzxgNaTMWI5Eql3edGE5KBaVwrb7Ry3L6B7nCI_3paoTxtmqdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7xuNtX8W48YrU-aMWqJ0KnEqJBR09TfwvpTN7RJPWRA&oe=6B105330"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ82KN6BTHgQ7kNvwGNlY99&_nc_oc=AdoxVFHwHA8ju3j9OdckDhZPreFyEeSrmNaQ5xXE7xQ5DdZSdiRv0_G7nS7Ymm7m3vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcci7D5Ts97gpmhq2DSE0EsDCb6Brdv2GOqEdt_I4Nqw&oe=6B104AD0"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXx6bPusQcQQ7kNvwFZhDJb&_nc_oc=Adp9ST_dKoeQz9wkz2bULFZrbBz0SbnUJ-ug6QepqFr8Hgi_1N6vUXdz5Ne2wD9NSjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQBAJgee2z8390hEcTnxQz0dwvmhUhF2G7XvlMm2BABw&oe=6B106522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9As-PLWDgnMQ7kNvwEPoFT2&_nc_oc=AdpCat4gzrCHEMnhGGp5wcJoBUW7b3qb0e-4Y3dTV3FZ_BNHnGiRAfa8p_PZ2Xedxvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXpjLMLva95f7JUnethkV06H1EP_kUXZBMNM79wz9TVg&oe=6B104936"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
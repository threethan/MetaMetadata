s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLwg5vZnfmgQ7kNvwEZdiRa&_nc_oc=AdrthYOt_g5iMu8zYJF32G0phF0ICyH8YjuQixznpX_tJd1M2E6rcMZxFf-cAfDQ1MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTilq2J6OsRLodRZV79agOra3FPijK8NGmStzxjJQW5oA&oe=6B045C20"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woa3RCapxyQQ7kNvwEHoAfu&_nc_oc=AdqZ1fVmMX6qhKtEeT_69hesqFr9_s2R5YQJIoZweiv-nbVu9cNoZYBzOSXKw61exqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWms2puJjXxLhJJwB5_fionWZ0uvFL6_0lDXkdb-4w2Q&oe=6B046BD9"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N30w3QZenOQQ7kNvwGSt13S&_nc_oc=Adq4CcNxhU-ABPdgSQI6QXB1YO4nMbhJIgqZ1AqfQd1reTfjIAmIv79ssu565qt-drY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2gjI1bT-I-kb6_ML446Ft7Q5djc5_HHpBXm0LEL_5pA&oe=6B046C5B"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxARRpD0kcoQ7kNvwEK4sxP&_nc_oc=Adp5bVY79Ae1Bny2MmBW-FgwFD6C_kVK7M_4lnnPYqQJdPFh5xvm75wDzJhOuZ2St6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIKhsOwV5PY1NyfTWnZrFpORjNiPvtPcG9J-F5yVNong&oe=6B0475B0"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1M9QXw9WIcQ7kNvwGj8tvu&_nc_oc=AdqoelfWKWUD3z5D_wlCZWF-srkuLfB7gXIUxuYRN1Pa0HhHno33oBTmGaP91nnMRNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Fk0PNi2AFbzgJBg22p-swjgm-kW-3weIe2A_xUpqOA&oe=6B046D50"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOxw2ZC8YgIQ7kNvwF8o5vK&_nc_oc=Adr8suNCOSBkczF2SZXyBYqHXsUQUifTGGN-C5ap86Urnf47LIAgLoxL-b3VysBz8pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLJ26YKCoD6GWMcnDAkiI1CAwYg3_GEtMacI4fPZup0w&oe=6B0487A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJizOMvQuZEQ7kNvwEMhi52&_nc_oc=Adq4Zl0OevSJFoPNoB7f5Wicp6EXyRY_gPqgYw2I5fJExTtU8TG_7YGIqYfWKYAr62I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRUbVGOEotCDHZE0XPyTO7hbHCSasHTWemyGzmqAsJww&oe=6B046BB6"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
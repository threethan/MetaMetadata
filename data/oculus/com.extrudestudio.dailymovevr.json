LQ3PfsHtc6zUaIY6TiDPODMUuqy3aRfm5XHfmKWreoBYLK5xB3enPk4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9WeSzLGIk_y41p-LZBEUpyasFCmGoAMI-2XlJZxJdkA&oe=6AFB2EB1"}, {"file_name": "04-beginner-programme.png", "id": "1854923015524002", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827601_1854923018857335_6762639268114675440_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXyr_RBlLrUQ7kNvwHkKJDg&_nc_oc=AdqoJzcYV3_vI7F9tXWiC26whweVVTmFYwCqwna68WLKizXLeIiWpCBuzxovycI0lNc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfDC0yucHRzhGpdsZPDvPHJ6bhxB3oCZDRcMVajwZlMQ&oe=6AFB236C"}, {"file_name": "05-quiet-time.png", "id": "992904303152613", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_992904313152612_2905134394622822897_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjcyxMR8Ei8Q7kNvwEfDFsS&_nc_oc=AdosvuiVT9EAQ6ySwNYLXtK6P6vU6AMLpSAkrtEx_SbIlJYOZUo-Rt5UdQzWoUqgLfo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkt-lxDQaAIwRonNVjJAiqvEWstRA9GEiqj-Ow_PWgrQ&oe=6AFB262D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-rhythm-play.png", "id": "2272698456913015", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824671_2272698466913014_4931710266694693930_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE09zJGn-ncQ7kNvwGdI4dL&_nc_oc=AdrP6kpLcW0ouhcyF9XGhHP4eC_ExeT_JMz48zY7qzuUV2X3K2SGPSin6JoMjGg66y4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4fIl1qTcwymKBLb6TNeOIuO-3ee-D5PUZvdRa-ZLbLQ&oe=6AFB1B6C"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1078539535005469"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620599_2089766848325496_4471379178071837862_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcIBgd9X4z8Q7kNvwEbhfas&_nc_oc=AdowxjivJo62YtVQAYsSlKBn_lvSL0yOX0PUX--DIWe-QBuKaA8kLtLuOWbDrRe2ykI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLruX7TKjvwyT_jBAoH6vefsc0GaWm5lkGuAgQ_p1qMQ&oe=6AFB3C48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Avenpulse: VR Fitness & Flow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1792262160, "lastRevision": {"nodes": [{"id": "1066650602861029", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1066650589527697", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3293913667462151"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover-landscape-2560.png", "id": "3827252577428841", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823901_3827252580762174_2198283615115080767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKy4Rn5nO_oQ7kNvwFa2Tib&_nc_oc=A
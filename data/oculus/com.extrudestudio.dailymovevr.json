t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIYNlO3ooUIQ7kNvwHdQOfu&_nc_oc=Adop4RQNxdk5hIXMg5gpEkTC4N_rBltiEgFsSv-seAmNcg1ia-GiibcthbpixeSMLIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVx0CInyMVtmF_6ghsSPbmspJivMBeC_KRB7AaUaGEo6Q&oe=6B0EEECE"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHZJM_H1AEQ7kNvwFUuWne&_nc_oc=AdpPU3LW97fSgfl6gICqsSCxZIFUvPNmSI3oNxImpOi1frMAkNKbRKl8y16knIzjra4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiV7RfZ3k9eICnR3nL9LNHWmSUc_TCA_SV8hi8TEbBDA&oe=6B0F2260"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Puh-7Z4FoU4Q7kNvwFvzPGa&_nc_oc=Adpn2vVz14bfgIVp3_PLLf4QfzFYxUb5znNX7z4SDHakf3GbTDRGzUj458ydz25st3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdxfjzq5DFSRXy0JhhINTw8mHGlhOcHZ1cbP51u94xKw&oe=6B0EEE0F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6pxofju-4IQ7kNvwE6mPaC&_nc_oc=AdoatS4rLxz0TlE9pZrS4sgrT5w7PnsQVIjNAtDvdC7MXTh4VqaQiQQm_u_fGu4ucwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAsyIt_tuBhdzPNhIEYXYyIVXFOgteby8kd8kf-kcDCA&oe=6B0EFFCA"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGgCuu40HeIQ7kNvwHAPVsX&_nc_oc=Adqb5wKPORVI4KjIrv8JazT2-O_rFha0eO5deME3aO_QK8KCWPPGlKTQG-dz8ETTb7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPbh3Gl68LPTwDP1TWJUyoKqjvRbQg4GQywi13z1esiA&oe=6B0F1962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueFRMB3Kp78Q7kNvwE-QdFJ&_nc_oc=AdrQYjA3dfc7AVTptqEqIOVXVs6GIc32JCYxcOB0imn5pXwhfbsjL5SANUTmMUOkLas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEcnCEYKgEXCG4FWT5xB-6cTESdlFpgIugEvAsoae48w&oe=6B05B44E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J1U6Va-o20Q7kNvwEaQXVD&_nc_oc=Adq-BSPPoK7yjJEoLy0lsXw3Noiaj5qxeoY1WIiNJMRgCKVlr8Lr327hrdlWTnDqsuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh2EvRAQD7GmSvPozPSnyrlroP8xm94SpGdFnyh3mTqA&oe=6B05AFA0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeHmQ17zb_sQ7kNvwG7Ea9v&_nc_oc=AdpWWM0MqZtlzypcaacZVn6U8uZ2NBIhVbyWhz_bb9pzDuRifloTZ4s7eqtoGROv2D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnTV_iQOio3ju-F93IbnUv1NRYcg2Rcd-XvV3odOjhgg&oe=6B05B38F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl9XMArBupMQ7kNvwEI6SkO&_nc_oc=AdqKomyDIutZ2jAwfnbzU5fmS4pxK61zwb6ajopcoBIxESiEivcIAdLIR7PsRKWGbsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoHKmlbJkJxjQp5FNRlTe6bz8tXl3LRy4wsSK0hK27kw&oe=6B05C54A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N_lMZPQytMQ7kNvwH__WXD&_nc_oc=AdqTCOKaSd2_oPvzH17YxhfhsbE2u2BbxkXvAR629OTKD8MEqYcx3HZmw9CvFLUmfXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSpsDIhXRZ8sDRQSgUEULolyQPDCbsjJ5fozS8F7CXEQ&oe=6B05A6A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
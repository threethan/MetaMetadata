s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnsv-EzR68cQ7kNvwEhKzAt&_nc_oc=AdqLRPK-3BMQ1532A8tl64e_p7iEkvp50BKUaui3muoeAEO34XnuWkpSGt6oDk9Ssh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0b7BjFrBh2fshUVcMmWim_CdFtz2peBqr7AjT6gqs1Q&oe=6B0DCEE0"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vKjGFvLykIQ7kNvwGhm4sD&_nc_oc=Ado9KSLG6FHf2CPi75lRcw6YFmlalncPHepcBgciUphR-6VisLq7HCBDUI4trTo6bMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhISuLxMXjiNCMS7wVmKnJ7zv1ptxF1He9BFBWDNziZQ&oe=6B0DA659"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMHytk_U8BEQ7kNvwH3l_Ji&_nc_oc=AdqS4RPjEAhf6_J91k9hMHXJc91LLAijEpl7mxTI3FTpfkT0P_kZPBiQrEG1edgD_2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTWmyG8vXu4Toljl-0N4_8adRhqcrE44RMRpBpWvUskg&oe=6B0DA6DB"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynZ3ycwQK3kQ7kNvwFWsr9q&_nc_oc=AdqTpXF1Xt2EVVAyvA9jUPWg85ykWw1WAwVjXWpS7fgPDe6RLY8imjIpB_Ne_90x7wQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrl4a0ku3simx_XF0Ry1D-pT__d8kLJunCXtbbBFK1HA&oe=6B0DB030"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlizwR334lUQ7kNvwGnmg5k&_nc_oc=AdrzzW0pcz-5vwFlog8dEwFsuXOQZwCQ0J09ZcCGjUqQ1763Wxgj6l9ep5JeZAB4JNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScpY4CeLU_NQ_K9p2L59ZTlFRdv66ktkhfg_x8DJCbrw&oe=6B0DA7D0"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kklw9Dqy4UQ7kNvwHmLdyr&_nc_oc=Ado0hPVHEtCkQ2GS7G7ubRaQHSxY9bW8TRZYzRIGWT_qnQUvxQEG-ZDH9kTIa4qT_Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKL8XIEZdgY5AxSjqHZAx9vlYZzDGmuDGuZTCCCx-Jwg&oe=6B0DC222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89S-TWHytJcQ7kNvwEA8ffZ&_nc_oc=AdqvDchaehDu9W27Vx3Trids2IfuP1If4N3eHQOIOQ-ggwiBlbezVlLk_g7GGTlO8ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWXNlHPyMzhB1lKbsk9fHSFnhoJE8a1-MABactDk9DxA&oe=6B0DA636"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
UM0RSjPA&oe=6AE36D4E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGtnjn_1EesQ7kNvwE_5dvt&_nc_oc=AdomMH7QAKbzpt6OWh7M9NBI941kkzVpNwpGIW1xw9iGtNtgIQABf5-6yucsp9uDTXA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBA_puJqINMfKvapnwJcsGqZ4KxY3SkI6Jgq-IGmaYMw&oe=6AE368A0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G--JG0AyIxwQ7kNvwFErQim&_nc_oc=AdppAnL8Fezv2BEz6fVX92VFrysQSNAVbAQRCCpxD6xCe6tJzH39y04hYt48VKDfhPI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLct8f-k75Rr2yV0v28F28fjtiUD7kmK_tPudZDANiPw&oe=6AE36C8F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzYdrE0Fi6MQ7kNvwGI0vvb&_nc_oc=Adp8N4bM7mLjjVs4I0spVvA2TJnK-f60L9QTgc4xpD2s-IcRY2l72K8YUYkJgHLdDAk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaPGu36agqQY6wlknUeV5v65oqMzopADFOsrYgK-kf3A&oe=6AE3460A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeGxSdRTGC8Q7kNvwH6hcTW&_nc_oc=AdonE8wb8M-LZO10-5QRtGbwnl9dEwJTs8D3F8Hznh76jnfyyAqyywVF0gH-aKYD0iw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbFCA1io6OoneDXzCewruiYFY7HbmZgH33zda-Fp2LVQ&oe=6AE35FA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_r
r-programme.png", "id": "1854923015524002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827601_1854923018857335_6762639268114675440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCtNtiQXJPMQ7kNvwHkRS_J&_nc_oc=AdqpS2hTbTLMP1J7KOnCA-HuWJN8GD1YbTC2xDB4taY65Lzvyf7HWvRY4JdFl7sFgSA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-DaUd011QVp70l084N9yyKJRGh4OWR0Ne8L4KP4vycw&oe=6AE8AE6C"}, {"file_name": "05-quiet-time.png", "id": "992904303152613", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_992904313152612_2905134394622822897_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_vlcxvoQSMQ7kNvwHG3N0d&_nc_oc=Adq_Sjhv7NA87AUlPJqlZroVlyAmaPwGRvka4cDHauJKuVWrd7vz-LKo4snRu69Y678&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFxlSWdf0vOIQk1Hs1IXm3YOwBPz8SIzw8Ir3T2-2LXg&oe=6AE8B12D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-rhythm-play.png", "id": "2272698456913015", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824671_2272698466913014_4931710266694693930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U1mMrqdRoUQ7kNvwExXR2f&_nc_oc=Adp2wZ79sZLlBY1Fo4RKl8Z_KQ48k7BUy5mFz2TiKlrGgtRGxMWOfU4LUVY8iPES30w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCgm0zlp2jw011zdjcYlF9pdQ79VQk9MOiUF_2ovVCjg&oe=6AE8A66C"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
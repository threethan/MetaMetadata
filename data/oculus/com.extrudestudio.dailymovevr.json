s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuo6_6N7c6YQ7kNvwHkDKru&_nc_oc=AdrdIteqZXImB4W5jC7nJdWH8WD5MoSNy1niYRJ5KMaG5AdlNrXu6wStze4-RWHW3vY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTy-Y3g_1vLq4ROBW7sldcvZT9DV9d3T7zcMu-GvagCg&oe=6B0850A0"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilkVnAuoomMQ7kNvwExSKuG&_nc_oc=AdpkFE34HjD2BEhNlBbt4sPLisxcsf-GVpa8M88Uvm2hG5XT7C6TZUQlnPxEuhfga4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXi2MqZek3A32mE0tHF9y-R0q9DVWZMNl1J5O40tFO8w&oe=6B086059"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ld_XZEHnH0Q7kNvwGmKNTF&_nc_oc=AdqKk2-QPzGMytUAJA8bdT89mkYSGROj5P3jVot-L3PDeE7s8Mr5XnK0TOKFBLm52Zc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0XGjIr7Px776TXmT-cSifNy8Iq7u0dF3kUZ5dG1oNLQ&oe=6B0860DB"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rfxa7YnymoQ7kNvwHyvwku&_nc_oc=Adrb3HlFTVTWfXA8Z270XIDG4Y53jCjfAKBEDYNfVf9-BLnvvu2hwoG9m0WNhtCGalY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB6lsSVt5xnnjSMsIhFgNOPBbKeMPRf-jj5YzQrhycjw&oe=6B086A30"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XwuHHyDxmcQ7kNvwGt7b-p&_nc_oc=AdqQmdWMPEdgQW5oBgMb5RjqCUqoNQIIl3eplazF-epfz4iIyk_N_BDgOkP53f3_SnM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkVVvCvCw6IJiI9JhCf15JNFHpucGu4iGxmxlJssSWQw&oe=6B0861D0"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6fzOaN1KIYQ7kNvwGKEn9K&_nc_oc=Adp8tr-THCQrmvdyjMR01Sz5Hv6et9UOx-PfnkGo3Uw3zhPdvjiAgONkBbdV5ctWS-I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwdJrzFm2a0mFa8yq0stTn99_rlb_vLAqHDo1KdwDANQ&oe=6B0843E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ED_rNKxhTgQ7kNvwHJuQ0P&_nc_oc=AdrxA21-Z5rx9jgtUOwH8vUJve5O6Dzg8yAgZufW0My6VGoKVTmC3HaIPHulJuoo6zA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn6XTxF7M-AV_tTmWVXJ6Sqif-goFkecF0zNoMJwiTFA&oe=6B086036"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
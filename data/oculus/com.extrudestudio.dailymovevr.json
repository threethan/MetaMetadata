t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwAS3uZ0stkQ7kNvwE5xKuy&_nc_oc=AdpUfphFu4vBwtiimlMiKoSFQKiTDC7HL5sqEABXUrXFVNkFw8iFgfHy4qrZzvkrLQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4iV9V1fBoEVuvjyRG5H304vmPEGN7ffnapMidJ_pz_A&oe=6B0B328E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1BUpTWWTqwQ7kNvwENSb8e&_nc_oc=Adq30ytJ05s283TlnuvbvMd2oEHnGOh5cH5ivMRKs2a5iMxQwiOyZV_SSe01vL4ZRew&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRfJof0ZUfdjTx5bMXFXeYfXkTMPgD7TqhCkbD6nTBjw&oe=6B0B2DE0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEytiwwo7kgQ7kNvwGHOduG&_nc_oc=Ado5OS8Aa671z7sOSOMi2oZD1HQvoD6q_NUjL_SblZxk-4ca1Da8LXLtLY2JgHEu2DE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSLNoDnLh8U3c27gJ25Dey0hCr0lscbdEvEnIQHuyM1w&oe=6B0B31CF"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efibYryZDIcQ7kNvwGHpzQq&_nc_oc=AdpwjUMKjLtrt4zBCa0JzLgj5cRRBfR_4pcanNThVbAjepRB_BfskvVpeL2SOVEo2rg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTScP1oQiE3G1EwsDGvhEet7vfvwsiwwBHUd0GPY4w_ww&oe=6B0B438A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GWQNf7erLUQ7kNvwGGGWsF&_nc_oc=Adqzzu0M3t7NlUZ6kJ6vCTG5fKRoO-hlZdReW-J9waoPV6EtzKDG1UCSDJheHcvTm0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqqgRtzQ9ezk30t1s_WzdfWerPx42b1oE-T8MzIBnOSQ&oe=6B0B24E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
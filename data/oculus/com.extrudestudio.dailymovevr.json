t=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIYNlO3ooUIQ7kNvwH2WMis&_nc_oc=AdqOLBT2VX8XLimQfsoRwxBxZNxmYrLoYIZOrS9No2yhc8rYk-T72XXjJ6qUlbYKWKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuwVqEpjxcSEUe9eYhUbyIvyXvQ0ZBvJSC8S0uLPeITQ&oe=6B0D9D4E"}, {"file_name": "05-beginner-programme.png", "id": "1405540487884879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303471_1405540491218212_2609239924669878127_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHZJM_H1AEQ7kNvwHI2DzZ&_nc_oc=AdrPBcFaYnrP6KqioLPrh9vNF3hK09gqUDXD0YPvWUgz4ivZuE_HgIgUcA1nw3g6HD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaWfurywHn41d2Jbf2tPWwyQbyN7HPBtKMFeQZrS5bZQ&oe=6B0DD0E0"}, {"file_name": "03-yoga-inspired.png", "id": "1079386321557634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_1079386324890967_3371672596461927065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Puh-7Z4FoU4Q7kNvwEgnDIu&_nc_oc=Adr0BwFJV059kUzT0nRs9aTZ51LO7nPw3l0mlg84J8_yQP14pjCCKFWvsF8FwRiEzgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQi0uJa7b6VguBq0Uup4qDf_jZ9avzX6Fx-PJjhFl0BxA&oe=6B0D9C8F"}, {"file_name": "02-guided-legs.png", "id": "2349193569155702", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_2349193572489035_2835842825716791386_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efibYryZDIcQ7kNvwFNC-ni&_nc_oc=Adq1BejjYv6BSmvWZ_qsZUgiThaEjf86s06x1-YoXDhb-YspHKL6yYmFXm9UjpfjgXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNjrkrMdeOLKsy6XK1cWTcRiEfHs-Vd0_SUGK28WVZMA&oe=6B0DAE4A"}, {"file_name": "04-quiet-cove.png", "id": "1125130653355729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305071_1125130656689062_6465662660947054234_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GWQNf7erLUQ7kNvwFQJWWG&_nc_oc=AdqesDGielVfEYT7aIQlHKJfP-LKnx-SztBKHYSRl4iQdOFi3jAlGl6LqDyajO0oVWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeILZz_H7_SStYHCOtovnJgGvHK-rnHVsABMXjcmKH7A&oe=6B0DC7E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "breathing"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]},
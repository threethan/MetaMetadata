r-programme.png", "id": "1854923015524002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827601_1854923018857335_6762639268114675440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK0HjRMXDTkQ7kNvwHz2X4_&_nc_oc=AdppwG3RTvCck1E_WexEBmkomajKWKacvWcq0Nk_52moHH0dJ3ew-f4i0vlUU-1QmHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAsBG9wW_7VSxfI854WCbd6-KRhQsCkekWNKj2noRtaQ&oe=6AF5DD6C"}, {"file_name": "05-quiet-time.png", "id": "992904303152613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_992904313152612_2905134394622822897_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ulYzTz9VpsQ7kNvwF5AiKc&_nc_oc=AdrynsQ274THpUmukBR1tAW_SOf6MTxqjkJNlTGs0Yj0N8_k46QWgnDyuORyqyRbjeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKMPgT1ut0xGqFDXEAGKAMndtr8q7H16t0LRexsAJKqg&oe=6AF5E02D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-rhythm-play.png", "id": "2272698456913015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_2272698466913014_4931710266694693930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9WnBefmtB8Q7kNvwG1bZ0l&_nc_oc=AdqCNB9LS1NfmX4epPBwT2X1t5sVJIIjLUlonESvVLGD6VUHy_CgSqIcwdamj2EmCEU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdPklwQtXG-rM6XKURyly-SJD8u2D8tg590NyQgYfiQg&oe=6AF5D56C"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
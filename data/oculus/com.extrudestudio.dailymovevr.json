s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnsv-EzR68cQ7kNvwGjCqii&_nc_oc=Adpe4kMK0bSu7MQJ3_ztGRh6ENuM4Sd-yFqaXAIb_Pgm3NAiOSv9L0DwLX-sD8gA_KM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxnLg-F480zBDiRL2dIdq92TXPeXpntWjiHNNc8FohWA&oe=6B0C7D60"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vKjGFvLykIQ7kNvwGjqTDA&_nc_oc=Adq6DjtblrY60_aDrlMvH2qJvNR0p0v3OtgycsINCD_vWimI8U9KApssUvOw9toJ3F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHAcQoAlGBvakfBYCK8MfSzNoDWe5xMW8EuixiOLY8tw&oe=6B0C54D9"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMHytk_U8BEQ7kNvwE2WkjN&_nc_oc=AdqN2738a0a-0keun5_u6cCyYSeNnFKruKVPmQmpwkBvt9snUUldRn05JWljgPUrAn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEOs62yga02BsdA9yGq2Hhs1XQYIzqh2dimcvdPDVFdg&oe=6B0C555B"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Kf_UtRhlxoQ7kNvwEIMIUo&_nc_oc=AdqKkwHopoweZgEZnS5YfAJSrrm_USiZ-oG_WmWrABsQGhosVf0lXabTvfehf919fW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSm6PUottNB9dcbuvZsBhan5M0NuY4mAeZtjinwcTLXfg&oe=6B0C5EB0"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlizwR334lUQ7kNvwHCiHha&_nc_oc=Adr-_lhHHifdOWg9GBbocePQMGRzMWcQxazjXQ-p2cSv2GI0PKaQSbF8BmI0JXzGxTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvdoRb0hyH0kI1CIXk7eE2fFp5eMgUcFnn6n8P6USLYw&oe=6B0C5650"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Kklw9Dqy4UQ7kNvwH4chAG&_nc_oc=AdpqCPqWXwt8jnNeMOxxxHfjjKMaRu2G06HzpgOYMen3Vtl1Nfc3YdhyZ3LpG62Ga1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUTMM0GvqiJFH8igwTrXWu1m42hCZGXT6c1nSsADWWWg&oe=6B0C70A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89S-TWHytJcQ7kNvwFqmIYB&_nc_oc=AdovLjj72keHWQma5oVZcuZXv388C2VQMkFX4s1UckPeaMlwbbMrz2Dpjfum1F4X5Eo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1D4WFgTwrfWJPD9WIzKFfAU91WMahQSMB8KO_SIjnng&oe=6B0C54B6"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuo6_6N7c6YQ7kNvwHpo_Yn&_nc_oc=AdpcX0FmKxYOSPPyF2zOMyynswMeOQHk-sVnPbgOXGALJju97bWsWZroip3qH14t0JI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvj44nfzGhu9MsFr5kpXvfTbtBqrIarCaM6-3U2-pWuA&oe=6B09A220"}]}, "id": "2311145426096263", "locale": "en_US", "screenshots": [{"file_name": "05-quiet-time.png", "id": "1723703469184658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596106838_1723703472517991_8231767730450727728_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilkVnAuoomMQ7kNvwEEaihK&_nc_oc=AdpPzGMoQbATzo5obtHl6ws5jBtAPNG2kmTUNauv76Xtg_iGZkeK6ZM2glwLYJpOKFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4UOLFzNP_2oMfjVc67w0o-4TqxfwFm_h6L0dKTaQqXQ&oe=6B09B1D9"}, {"file_name": "03-guided-seated.png", "id": "2438233096982304", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673825275_2438233100315637_496793874526595065_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ld_XZEHnH0Q7kNvwFN3B12&_nc_oc=Adrl5F_7e4dlEmSuu1_9phkHshTukJZ43E0C69oRSTRJzzuo8E3uWU0EqBwLA8reqVA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNQlSv3P35emOO9sO8gwAxP8i7B8qrBYmRDbBtwgvbXw&oe=6B09B25B"}, {"file_name": "02-coastal-blade.png", "id": "1657912055997566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604328314_1657912059330899_5555042387251949235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Kf_UtRhlxoQ7kNvwFRQUEZ&_nc_oc=Adqnh0HG4T7RkGG3Z2gxvpyFdXFm7hbsqNfMr5hfQOpF5apunY6g9Sdwh5J7s-mYYY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQKzU9Y6sPIcBIq4GTrUo1ZuWNSEBf30hs4u0GMF8X4w&oe=6B09BBB0"}, {"file_name": "04-rhythm-play.png", "id": "1482573137307056", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673728339_1482573140640389_4151979705116600388_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XwuHHyDxmcQ7kNvwF6228Q&_nc_oc=AdrdHmxqIT81eD2houkX5Y-Ydqhm_XG3NApQqmikrPAA5nKBJflmsZjGDgKJ7Y6fyLg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpU0a80CrL1REVetewS7eDSshvJCCoU5UmIVY3rxTrgA&oe=6B09B350"}, {"file_name": "01-standing-flow.png", "id": "2077945196251601", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830904_2077945199584934_8765671846544955795_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6fzOaN1KIYQ7kNvwFbazCa&_nc_oc=AdrWvDRNRk1EKm4iOYj68fPl1S4f1So0J74NBl9ytGnMIWHGCvj4gj3locuAJaBOPHs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg16ov9HGhKQVfkSk5nB2uVvOn-y2Crs8xir1QjKdPpQ&oe=6B09CDA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2220713038822694", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585727769_2220713042156027_1211939128201901012_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ED_rNKxhTgQ7kNvwG7ZOcM&_nc_oc=AdpbNej8Y3QC4utzAqfMrI-duLS1c7fcFfceQtPFRYD_wnPn-a--GCu0wNgv5H-TgCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjihJmtZlaQdhNjjXazBhb3VpDog59IjVew_gRKZlalg&oe=6B09B1B6"}, "display_name": "Avenpulse: VR Fitness & Flow", "keywords": ["fitness", "boxing", "mobility", "yoga", "Avenpulse"], "long_description": "Find your daily mix of energy, movement and calm. Avenpulse brings rhythm play and guided exercise into relaxing virtual retreats.\n\nPUNCH TO THE MUSIC\nUse both hands to strike colour-matched targets in Pulse Rally. Choose a music track and learn combinations, small shifts and knee dips in untimed practice.\n\nFOLLOW YOUR COACH\nExplore standing cardio, leg practice, seated movement, desk resets and yoga-inspired flows. Watch demonstrations, hear spoken instructions, repeat a cue and switch the viewing angle. Select a smaller coach range or a slower pace.\n\nBUILD YOUR ROUTINE\nStart a four-week beginner programme, choose a daily mix or put sessions in your own queue. Review movement, mobility and quiet time in your weekly activity journal.\n\nMAKE IT YOURS\nChoose seated or standing activities, a coach voice and appearance, hand equipment, music and scenery. Adjust comfortable reach, move the menu and recenter your view.\n\nTAKE A QUIET BREAK\nSlow down with guided breathing and calm surroundings between active sessions.\n\nFor general fitness and wellbeing, not medical treatment. No account is needed inside the app. Use two Quest controllers, a clear real play area and the Quest boundary. Seated following needs a stable real chair; virtual furniture is demonstration scenery. Feet and exercise form are not tracked or scored.", "short_description": "Punch to music, follow guided standing or seated workouts, explore yoga-inspired mobility and take a breathing break. Choose your pace, comfortable reach, coach and scenery. Build a routine with a four-week beginner programme and an activity journal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raheelswati.github.io/avenpulse-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Extrude Studio", "support_website_url": "https://raheelswati.github.io/avenpulse-privacy.html#section-7", "website_url": "https://raheelswati.github.io/avenpulse.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1096580663201356"}, "review_messages": 
": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob0Vex4Ffv8Q7kNvwGyKXvk&_nc_oc=AdpnAHBuQAV3Qj1ltwR9CzjDvarnZKuP-j_I1vh6hY0tcntBNbMSNXhrqMM4v-Kj2xA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMKnotOwtRdlZb7WATDbR8GbJePFv_UEysaRnAnmPA9A&oe=6A8EDD39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKK8DC43WywQ7kNvwG1vHd1&_nc_oc=Adrjo1VRuGVYWK5yUVbKnRDwC48GNxrkPelymTmL1hQN5kSbq3hLQlPG6MXIi6keyY4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYpI_jtQaaf-2xmu_W-H3A2c8nnZTXEULmZfpxA6mVDA&oe=6A8EF66B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1DIXLBkH8UQ7kNvwGOixHc&_nc_oc=AdryIg8x32ZWbRzcj0p_dAEQci6S7a0dJESN1DKVmPmqs7qTbhPYBVHKN__FY3RkMYU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj8jDWvGfArPskvQVWt5DfRXEQ80ekqSXAQhQEI17kKA&oe=6A8EE03C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5kVdpwWqcoQ7kNvwFUGVwr&_nc_oc=AdqOMX8jMQjbehc2hS4SubT02Wp0BJ-RC0WnhG16v6h0S96GKHQzubHQNqalZrMLPbY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfoAetB2Q7ZDwnCT02UejQak_5kfVWDPv0ENIR8CccVw&oe=6A8EE39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVU8Mhxoih4Q7kNvwGBWBeL&_nc_oc=AdpHn0dWoIgM3ZtvvPC9lWPdzF2G-QPSuCruR5wU0W-f875QwNyDfUdJrHJPs7o5Wt4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS1Liwh4tGN0Z5dWxrvZSwx_k4JLGxyI4fMLaiW76G_g&oe=6A8EF07A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
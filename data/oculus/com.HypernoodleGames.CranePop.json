tl3-3.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-XhEqL8fHEQ7kNvwG5XTH6&_nc_oc=AdoMnhDQB3G8kSmW9AG_mE1_KurjK87DK3uNQP-cyz2wDmCi6vFS4alnKX-Bu2LXkvg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_4ByR_4YTf9JJqJ1YJDx05VZ-r0hJQK9rFP_l8kSMTQ&oe=69C67939"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB8GWy-P1ksQ7kNvwEEWb7U&_nc_oc=AdpqjofJxomf2iAUtER7ugsm_dPL2ywjoI6puu4hWkfXC4qvXFQZmc9RwYZAZWTcqA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySWq7uIidrZJQGvtOAvmGNdwXOsD1tAbD2wiZFGA2_Iw&oe=69C6926B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqIWL2xRCZEQ7kNvwH1U6hq&_nc_oc=AdqjRknXWD0lDoF8oKTamcIYFPLBzGkhOJthFg2g0NF3ez4JZ5RDz0gEVmr2yvcaelA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGjQIV8IQgmg7LDwvM3GXOP_kX7Z3h8dj4GtvgP5wX-Q&oe=69C67C3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHyzq1qve1MQ7kNvwHhCzv0&_nc_oc=AdoCgjg31zXfrDW_ndYVc35CqBaOzW78M4vkFS6Gk3PPqGtvTw9-FSddRQik1-N80SA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8Dv2dFJS4ItC7L3LUiE9ARb4y2XSnRCCZHBt-flkFyg&oe=69C67F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aDTrec9veoQ7kNvwE16gCi&_nc_oc=AdqbtVOjBegTVKujw1KJnOVkbHqcWfnLd4B0sVGOQCpS4XC2gAC9JRfnzj6utgK9F3E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQgwL7n7Go7xTe1JWrJvSwucgh4N5QQpBLYoSfjJE22w&oe=69C68C7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
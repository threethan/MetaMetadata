": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8R8fYDLQWIQ7kNvwF1zyl1&_nc_oc=AdqHkFcELfc6vB17sRdFUnwxe7Ly21rV-f0_VDh_8fqqZHRUe6UNb0z2k-HpLjgQElo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXj5r6h3Wjjt-s0x_ocMrIiPMGKLMjF3x5ZolfhHfu8w&oe=6A85A2B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnpH_ZtDnEQQ7kNvwGgVVJr&_nc_oc=Adpro-UuNlM5JRI5IV9p1OqhTaNfUpA1bw4etlcpfc6Zs8q5j8lttVkGy4H1qY1Q428&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMsK8PCd29uj_FbbNbsORYpJYodAaR_VH2YFPlJkj3A&oe=6A8583AB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV70x53t7MgQ7kNvwFQB-Xf&_nc_oc=AdqCOYTrI_5ax2FzBVVq3CNEpyGjkz8hWrrbkVcQ80QsXbGsZHujauAMB-_YF0Npixk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB9_fKSweUgR0I_DTnblClXI1IKJtYuwadsLwMeDReSA&oe=6A85A5BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3oMS25tFxgQ7kNvwErlvaB&_nc_oc=AdrEnlJ1uvkoaHXMbXAMFt_FqonSMqiKvM6l79jW1gAySjjEWegl62eVHYtUowlvrdA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgUoPDw2iMHT2s0ThQm9dTWll6mzMF4SocLockk4SNeA&oe=6A85A91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9pyS6T7IgAQ7kNvwHptKbz&_nc_oc=AdqvqKVeUhq6_rCHKUS2nvVCMnCvhQdklP_KARZ8FX3yvfLlprx0pDSIC-1qRnLevrM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW_kCJxzz2FGTnj4ZVewgdIbji9w7mCGGN-zNYn4ftuw&oe=6A857DBA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
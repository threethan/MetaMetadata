rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUFqL1jWrw4Q7kNvwELsAzl&_nc_oc=AdpFRW1HuMLV1M9znungeGzx2hTlTJrjIs19sQrEM3v24pRsjLdualWn63WHUAGB870&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRouWYoeiQW_t6dktZD1jVdeNa0U-4jKvK-AZxpx-ctuw&oe=6AF88D79"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWuaov0h5iUQ7kNvwF0UEGf&_nc_oc=AdoF9J-7xhKfVTW7LqQmHEbodFUh9GeRux5X3wUwMhZcytTCpqhy1tnS0sYlhNfcp7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt3lBcHQKptGNx0mZSUCnD3MPP9niHSBnUFQSyYHLhCw&oe=6AF8A6AB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD23Nj1A1DMQ7kNvwGovbTL&_nc_oc=AdpTHuQ5s4nl1_Kj8VOf_VReUkPH1JJisoTURTZO0S97Lwjbb8bmlOsiiCOJfSXewo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVLr8Hl_bdDb7eDQrAJ0v6bUZtxhgdddg5d9H5A1BKqg&oe=6AF8907C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYt8uF0g-5AQ7kNvwF8ewAj&_nc_oc=AdpuykWRjgCEYSvD9Z07dP75dtUiwS75A-kbVSJp3o9XriUNOocUNdnAApGPxOemxEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZMojdyLnl_qGwTJRhUTFykSIlZapctI0DrMmxYPcQA&oe=6AF893DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gMFayQNx-oQ7kNvwH5_-wp&_nc_oc=AdoymBpck0DXf42B9yYeJ7RWZSd3Rsvm9hPATSI32g6JdgQKkuR3vtWyzJy75IC-vnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy49RTxwsB3b4GBc0jdQyizyf8lDX4pTIypgijoQ-MfQ&oe=6AF8A0BA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
ms2-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41jpeEm-ASkQ7kNvwEPHVrK&_nc_oc=Adovk0s8jh-Oj2jzkC6s-uEjSVcCklykuvUpWJucnVuewAILHZVwHWkOm12x-uqdmhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_528R-Cn3RJhkQ2wDCRYwmCSytzPoB55SKGoMWjAflg&oe=69D10539"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6_szgS6LsgQ7kNvwEygFUT&_nc_oc=AdqNr93LVXKoIPPVvsPe5QGZKGOmwJpNOmw6wML5HMMi9T-Edyk_f75psJFxsUw7BpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzAOSedlwGGw1D_ePxlOjV8Otv7IlEh16kjJHErORA4g&oe=69D11E6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcy7EcAzgJcQ7kNvwG017eI&_nc_oc=AdoxyhPHPCvY5SqINoGciNdEciYypJoF7ztSUmtuQeh4KaPyuezPaoX_T6dz-NI3Kms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHDbot7Ptiey8fiO8Ie1hYufkTegw2IpCU3vd4-eTsCg&oe=69D1083C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO0hdPpf9CoQ7kNvwG9iW_F&_nc_oc=AdoYkSuRoMNCSpqkRHcy8K_dPVEIeRYwWGIyXqm4c30qCagSI-4wOq5zWmNxb0sVUGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_lE4YC3FXcu7wCseBKgzQ2KDyuqsN3ph4z1wFuAVGxw&oe=69D10B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZbtL1Rtb6QQ7kNvwEaHPFq&_nc_oc=AdpJKrTWB5mD6FMs95MwjB1f9sVonepikxHMxRybJ19-BhGJ82graJjL3gM_rEkNndE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnA7A2akwVuZavxKXbv4iKqvXH93CNST1jm6nKeyGJqA&oe=69D1187A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
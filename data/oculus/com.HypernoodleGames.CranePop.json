rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjT-17xpY_oQ7kNvwFQRwHp&_nc_oc=AdqN5W24dP5KGMtd1yBBCwnpfaWdnwCsgKs3-0eA-ITA-_PKNPG5hzDOo6YalshDQuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8gYi7Eql0wAPzbRCXSc3fgorp8eLgPGtBVEXcL3vMDg&oe=6ACA68F9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPg1w_A-NlwQ7kNvwEvQ05d&_nc_oc=AdosKG33ywXaSYbsuMRgYs9sBbMd736O1MJzm3Wdyo_oBWJto3psbkDtbPWLLUpGSf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxgUDHXnv0WAqBymAP947wEyABSOZbg9aU74oE1EWOKA&oe=6ACA49EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4YEXV4V2NAQ7kNvwGUOpKB&_nc_oc=AdqfFIPqd1mRC8UxHNQ5X32Kg2ZsuWDpMzVf4jNeJAsd3qx9El7uG09dQk4AUH8CtW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCWN7ZklWRTr5wabxOKirDNdEukJs3Us54KUumczFfnA&oe=6ACA6BFC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5bn_83iExIQ7kNvwH-vuOk&_nc_oc=AdrogmQUxc4LGbrE4Ewb_OVok1POc22jFV1lYpsNauWuEa9_yq6FzHGFiHHBgdei0GM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRQQ7fvUGqjio9BVYZZHgIgm9SGnc_52cbCaYcLkUk8w&oe=6ACA6F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRNomkf63oAQ7kNvwHRGBr9&_nc_oc=Adp9UNz-Gnmu1m4e3I-sOmgQB_TbMSftLA2kPDqjdjlaV95Hv57iT55_wdfagPMt-DU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqe9hMWl7oMBIWDs4G-y7kil1aG4UzzntSPrO_nLo3oQ&oe=6ACA43FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
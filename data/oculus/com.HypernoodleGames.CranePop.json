ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqELa73Wof8Q7kNvwGP7DwJ&_nc_oc=Adoo1KUd9bN6_vIoqZYM7LfBbBNJB2LKRKb9dkI2PyhJno5Zys6AEZTfRCi524RhK2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD48dmfv8DYz9OGoKGySl1qIU6Fx1ntWus7e-iMciO1oA&oe=6A6B44B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN-_Ypk9lf0Q7kNvwFu2SB_&_nc_oc=AdoVpf9xfX3iP0pg0379_4nTvX9Dw17QQTx8nXkUHGpytDtLKEGP6HK76M5LbIF-L6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX-IP8dY-E-B5VLIdyqMk1zpJqb2d2lKam3UCWsK8v2Q&oe=6A6B5DEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6ieFydahyAQ7kNvwHLGxDE&_nc_oc=Ado5qHQi2ZLcI5AGZuLlDGzNtuloDaBXKx3vNIlLrkW6wBKBshR4CuOrMFpHYUPjo_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfS_8amhzqFcgx_oubftWDTIAcEJvNYYer7S1YRP_SUA&oe=6A6B47BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcbliyxoxoAQ7kNvwGVqXb1&_nc_oc=Adq4g5POu-SX5cFlu1vHbwFq-3sSaLnzSXF_i3uz85ocXsy6dELf-Z0yDGYrB2dF1SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeqwCIjd__-aiUbPGmX-8SoZf68e5kZjC-ZZIzwEfs4w&oe=6A6B4B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X89HI6ZXDE8Q7kNvwHk8sFW&_nc_oc=AdqfN7p3NqvCEwqB2JPYmYgV0QFqG8_l-100GbeZoZlDDCdK6LCiIy8nvCjl-SgJSx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKXq1JCbA86I44NlovXjbfgvxVi3GVvaCXSraNH3OR3w&oe=6A6B57FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
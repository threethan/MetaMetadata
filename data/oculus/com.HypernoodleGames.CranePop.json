ra3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySejfjkiXdwQ7kNvwEYWGFF&_nc_oc=Adph057N8JtSh7iGOMsho_XdiTKOJfx688RvUK1Rd9Xss5-V9Wr3WL7Lzsg3uCxZStY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm67HDFsI7j4kE_CX_7SkmA49Ac1KLIY6t_2I6qhXGWQ&oe=6A81AE39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_6ooX-nQT8Q7kNvwGAWP_p&_nc_oc=Ado3vNm0pRiGLbXa4nTjWDPgOuSlCVlASEe4czOicYWXX0NeeAEL6UDl9J_zhFkiL2E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAB5Dtv9rMLqv_2jRBYAtu9UHgG8TH6wstAaEPx0rflA&oe=6A81C76B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN-ZSZDtaskQ7kNvwHwBEgp&_nc_oc=AdrHJ1lVyqSBFTubj7zXiDMAmvzKcc7oLMEwisYLL9_4DhkpwKa_GZ_kyiA9p5EEWXU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFePksFnRqSXAdG1ovzrFjgy74LnDBoJiHnuFlChSDilw&oe=6A81B13C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieJ8Lb56ci0Q7kNvwH9YJ1Y&_nc_oc=AdpoAmad9l7fqQagcQtQkck1BoNfQplDpvLeuqev-aFKsZ_NnNI9josbBiKrRfM_Ot0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFewwI-ULeIY9ZSdyxrh2acseTXXxveVEutm6GiHb8F3Q&oe=6A81B49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FaIARXGyhoQ7kNvwGK_shH&_nc_oc=AdpqJT7mz6lvDGgxYibYzZ9go2WrTZwDS12UGKstEicXm6O_e8WC7lHXdzFsWYvloyI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1mliOdf8mmRP63u1-zQMBgYKr3TCjw478aQc5Yk114w&oe=6A81C17A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
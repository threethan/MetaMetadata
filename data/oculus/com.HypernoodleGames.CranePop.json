fw5-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjO5L-sffTUQ7kNvwEzjnhg&_nc_oc=Adq3adk1B3F-rKVNg_dOzRjA6xekGVvOUHKGZ_JKJtXg60DnZg8nX_t5XrmxMV6e_9s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c3QioOOe1Y_bVXbfN3S-oGsxjMGR7dIzA8p8JI3h6qQ&oe=69F49DB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQShJr38yL8Q7kNvwEue51q&_nc_oc=AdrjpvAJmrapa4vj-zRevYF-pqfyoFDd3dIKFELNu99NI24c_PK30jS25pt5bv12G9k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aDpwfEL5Tm1Owux0qZIUquTYbA8170MSVNripNCvNKA&oe=69F4B6EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWrVxQcNPP0Q7kNvwEwvfZ7&_nc_oc=Adr071UGtMUOf8nvQyfS0UAvW49KFd2Z2dn41yhyhlw08NwYbnNFmeuA6U1naE8-PE4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TWOxNvHyuKw5F74pW5Q6fs-Fd8wxG_M8oJW1yyAZ7vA&oe=69F4A0BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bAKOm6qcc8Q7kNvwHAMrbp&_nc_oc=AdrQ0AWalq764XDG4XgW61jtPnSHjJXVzFYr662sBshDSvj5vZmsyQ05NhvAr8P5c5s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BiMaLZ6n9_vEDj6fO-g75cvzGRtvQBhp4hu55y9pemQ&oe=69F4A41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbznTTnBXIYQ7kNvwFeL4YO&_nc_oc=AdrdBhG-jyUtXJTMJzSYhytohZCEgqmf_U09kyjYLhBDcP6fkx-ghMOo9fOir7-AQVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09njRw9msm-BcTwn48uqFW3ujT9RD7yw7_bySjy4MntQ&oe=69F4B0FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
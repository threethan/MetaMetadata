ms2-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-warpuYw-kQ7kNvwFvzFFk&_nc_oc=AdrQ-uQlFRAnEHWMj8LBJ0GvgOWJar8Pbd4ZMpsw2XGOnDtogtJh_6ZW9hA4gpN-6f0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gD2VuehvzpZeCNZGqq-rHe1zzlXLOnBZgMGOi2H0m0Q&oe=6A2959B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd9IKga98mYQ7kNvwFe_NlE&_nc_oc=Adq0OVRO0vdmwCtndyklIqMqM0473g4LArRcDkG7SAoUMvVFVWAdoPhdPxMOUwuuW2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZaUhPLhIifT1eY8f2HKyLnCxBQtdU5QrJvLHqLtw4QQ&oe=6A2972EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdDkrJ8xE3EQ7kNvwFbllYx&_nc_oc=AdoRpnWn69YvryIHsGXQGlwu6AIxpaYFxoOQmQUgvdLIQkqnNE5II7U1L-SX1ItskBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af854olszhzpP5gmfqRHpBXskDL7EyKeJLJaWJ3hIKjQ1g&oe=6A295CBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lqpP2AE2MkQ7kNvwGiWFTl&_nc_oc=Adqs0W-E7USwIF7nHMk_oPTST_hl6-rlxrKNLG5XY76XghQ93z1sfTNq-XCGTQ5eWCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nZ6muyWdnrMJIqWFFwwBB01-gtrw3RtU6LUxi1DqWNA&oe=6A29601D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T9T4EXcgQYQ7kNvwFrqvoe&_nc_oc=Ado8QQINbBT2hQR8Yq9aZSMSRFLeFAq3mx4wR7tcMfDEjIBVrFaPoMDW4TBhMjqsE1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91B32Lorwnb5CyhyeDpvdqBJ_ymgYrsFThwQtfqc2oXA&oe=6A296CFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
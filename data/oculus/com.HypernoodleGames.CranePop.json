ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHXMPJDEx3oQ7kNvwHBNJw8&_nc_oc=Ado2ohIMl0kusZGcjymhIAthZVqm9pv6Fq8DPmjuK0mEIUSii0MP68FL4biBvWjEB3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hZdOD4LDbrZuK4M647PFhrarBH5OpyYUmydY4HWkEqQ&oe=69EE0639"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPBhlrRRpcgQ7kNvwFRAkDJ&_nc_oc=Ado6nd3pVgvNt84RBttMl4567B5KCPs_-Kjvr_UL7uPXmiSlAE2Z_Bhf7STawKY_Pzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wqYUumcmA3PIabZOLmsbRMMvP74ntrTKQavoGyc-zhg&oe=69EE1F6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwEUzmFpsNUQ7kNvwHdHYVE&_nc_oc=Adq1vGEe1rCkDFar3554jxLLyug-sXNLLZ4DOBugI_y8_fLUQbYQdOSdPNwpr-pl84s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sPgdl-o-_tqyB8Mq6sn9qQtrIJKPulUuDw0glnuM6Rg&oe=69EE093C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8umu4LjkO4Q7kNvwEwvPTZ&_nc_oc=Adqr8vW6e4SuECYRRixeclAzdyXvp3sVJx2hVxiLY8a9WDSZS2wQVSJzTmqw_zBhulM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EoMMmQCi0muCqWFqZ-0Qc-o9fy5RYOuR_Fmd943C4QA&oe=69EE0C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvtAMnKPRLgQ7kNvwHxl2Ic&_nc_oc=AdrN74RB9IIWRoV9GDIJFkvxueC4AkNV041mOuObmgDtdcC4B2l-woP8FGehYUtYoSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mk1I3hi9OcYmuzZwjG6b02ZRedakt7mOoVPkPmJg9rQ&oe=69EE197A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
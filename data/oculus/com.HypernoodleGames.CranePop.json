fw6-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFJQ7stVi5sQ7kNvwFTgkKk&_nc_oc=Adpm_Yhwxk4J4pFRlQL_KdeP6CUKUTb44sC6VaICCxoUUB2kOMYmsB91hzcD5XXg4p0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg5BErn0xBAmV0rdTByTuG3X0WSR4nRtQzOENxRPW-Yw&oe=6AE33D39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gfgjLvc5EsQ7kNvwEAs6py&_nc_oc=AdqDyqCCdNWommVcwE9i6rN6QCUsBhgp0UfXUzZ000mgK9NUHDGiS2m730HIcIka79M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhvbWLKkHSt-9tAmmzwEUFFPkrWRHHZ0B4sshuAFf4HQ&oe=6AE3566B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1iQfMVBifUQ7kNvwHUkVLK&_nc_oc=AdpVzE1z53kGkXM735moki7aXdX9uRqwteYOf_BEPrTh7Z7-Rhok34dVY-RmdjMj2bM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMLSWBY1idP7D3L1N8bjVbA7iwz6AtwkGf2IevxccHFw&oe=6AE3403C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p6QSEr-VpYQ7kNvwH4V3aU&_nc_oc=AdrJK_Pgx2YxPuE3Yici7smcoNVDWJiKDOz4l-JaHA-p2ws06-5pMkPTGg6ZyMJfzJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6LCt8wPtjahNAz9l2rz3EfEldtnX7Xn3no_4XmoXtnQ&oe=6AE3439D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7kORdDSQ0Q7kNvwGjgDRa&_nc_oc=AdoGGMfOZlLRuKaRjVxFjUseZkVBXjcTfzMGD4KCOIT2TxKJu8W_AqLDzQQYprqyeAM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1BcrMy_6XKCv2e47B-CLW1Dez9vOOVaI1H2Z5Fx8Jjw&oe=6AE3507A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
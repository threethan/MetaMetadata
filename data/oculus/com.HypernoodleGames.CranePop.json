ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cioE-S0HPRMQ7kNvwHL0PBI&_nc_oc=AdpaHV4cWItydctwtWEcZ84zcRfTaV2KLaU3kpj0wYWcFZnTIb5Su8QqBxJJmTCm0No&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBybLa1518ZxWkVgKZLIMXf_--1RV6DTpLjq-PAlWwHg&oe=6AF1F5F9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6ew7xHzbGcQ7kNvwGWdQlb&_nc_oc=AdrPGJ4vz26LKR30Hc9W6cfjG16jEvugiPivAB4zjcqJ9tcLz5vzQIHXxoUSUiTjfQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt_-az2zfK56Yv2F33T2Gfu00ubV6gi-1qQkF5QwYbcA&oe=6AF1D6EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvUz6A9r8EAQ7kNvwGrp-6t&_nc_oc=AdoUE8kyN3x4mtGTizJgYSl4eoOa3AMtcBhfdgVLFjHQuVPTxCwNgiESutqZgzjvQ00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1KmvMsD0FssXlPhkRkRuSV_9KuceMWCEEQnkCzJfWpA&oe=6AF1F8FC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlgH9kK1yNwQ7kNvwEHIaLb&_nc_oc=AdrwyaWU45UcFk40rIsg21nSo2Ov5T-v3dxTlA3OxJBdOaTtRB9LzrjBs4J7qBx_2pI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRznOec4nzyiv6JAvx3Z0WFUjH1zayJZSRPtEEW6iog1w&oe=6AF1FC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1vABToR3cMQ7kNvwHa4e1S&_nc_oc=AdrKQS94iewNIeLsgxa5xL6sOq03WW8Rr3c4M0fdNmf7GgPYlIM4-Xzo-y9SPRIy4mQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaCO9mUvZ0x-jiYTpTyLpX0NJNkRVwWqFGM1qZ7vd_qg&oe=6AF2093A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
tl3-3.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id6wMklCdjcQ7kNvwEu30NU&_nc_oc=AdrRVizG05Qat7KVm8JtCyP0_sAP0iKARN-2ab11BdLugtLI-xEXT5LAlJlAC5PcRfg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoVLuK57EWJs3ZAlYSMGo8jgVyo077yVyL3RGuLMO6NQ&oe=6A6F3939"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ-oTAgphCsQ7kNvwE65XwP&_nc_oc=AdptRCuUXj2Vi-8kpemUrJo0zg999PJiwtL3bTmQMQu2bepXJfFDvPWdxdwZska1bpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcGEWYYdfkavQ7P8rC_E0HtiyMN3ePZHeQQiH4S4jAfA&oe=6A6F526B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ3ZcHlWH_wQ7kNvwH65cGF&_nc_oc=AdrNCWROz7VcWV30YhuQ-4rGUrTxj0XQlS1QSH8rkPmIUFrCdG88_q2-QwNFFHxdj5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuAewDuCEsTZkZVrgs-LLzBPzIh3DQ7K-ZlwoQ8bABDw&oe=6A6F3C3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On6yRw40IH4Q7kNvwETQ_5U&_nc_oc=Ado3JTzCnWRVgCSlqD-7f-LG5vw0j9BgayCxvOG0jM6Rp7cF3GVoBYEqVaxDX7aYaW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnah_m18box_qzQlgv1Xp6GF7Viap6k0A6tSIwwo10Mw&oe=6A6F3F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXkguv4ArnEQ7kNvwG7QdIJ&_nc_oc=Ado_64j573mYH0MH-54UlAjSnb0d7YVVZ8bJuN110Q93ZZomoVbKlbAOAqHxzrk8ww0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPsUT0iFljNvddWrpMMvYU5CU2-RclWnbtJke5UYj0Vw&oe=6A6F4C7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
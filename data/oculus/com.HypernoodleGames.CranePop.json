ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDLocrbwtKoQ7kNvwEoP6iB&_nc_oc=AdpDap1vwE3Yvp-zPEPM3CdMDLIJ8L4E9E5CnQ-q8EPsNgku1sHWwLYphf_V59_AQH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P2e0ACxs1quGKoW2s6tb9yeC7wZthfedhRQ-HDozZxA&oe=6A2E9FB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdYCjByZzFIQ7kNvwE8DExQ&_nc_oc=Ado2lKLWpmGDFrJf80JYBYVCFyK36VSZgxoHWY50be6FzYG0lGU-yza7DOeZhIQDsmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rAqxY-PZ9G4ThCGlOTxolxdj8NeLKMonrv5o5sJwF4A&oe=6A2EB8EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi4Se5cTqf0Q7kNvwHKN-cy&_nc_oc=Adocik0rplsMi7umt45xkmacEFEWvVpR5Avdx4acOn93cL8NZx4X-hiRlNmK3cM8eJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D4Az3c1f-Ca4XvFmHISbfUga9b4NKYv4uEhWIxcIywg&oe=6A2EA2BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ty4si8bfwQQ7kNvwH12VDZ&_nc_oc=AdpyStTvXk14HpBfUep0J74V46Mr7aspARCVvI2KquInuPbDXplV7Zp_YFjPnoeTXSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eVO3KZKIph5O4rzqF68FQIlmV6lTrCrP0Ul2L0gwe0A&oe=6A2EA61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGqN2wIgMbEQ7kNvwF7rcko&_nc_oc=AdrM0OfaAiWDbwt1NGoAu-JZvWxVQBK3tPEV8jUszyd0JpU2QYspSv-fsG4ZxFvJwzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D84ipZEjK7i8_lYFbQDwSStnUNS_hdBCK90TsL5EBkw&oe=6A2EB2FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
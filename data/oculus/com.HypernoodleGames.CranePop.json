ea5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAkcnPQZDD8Q7kNvwFX3c0I&_nc_oc=Adq9EYyWoe98rVKviGmSPem2K5ky7Buh4bBmXwsrU3k9AcTxy9wxm0BQ3_s-tsEEb_E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WOfoUG3Lc6GIL5ALBfeWD71FCUuJlQk4k6mx-po0T8A&oe=6A450939"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=np-GPfO1ES0Q7kNvwGgCU4b&_nc_oc=AdpWfJ0wcSuSmXmSE9sBA0J1Vw8152WZihogqdNjD5imIiluoGgA7BxX6g6K64-L-7A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89fIdCPif_3dgn2xwfTV-U3lr2CJPPTpee_589Z9oinw&oe=6A45226B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUYBv8gyycYQ7kNvwEyCUYP&_nc_oc=AdqHt68yXco5TPsaN2NzGJ43ibP4O05Y6uunrmkMLiT4w7tHGr34jEPMO3JEsTaDt9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-183kyD53wIOvnqZyGOHLEWrMAGIlfTlJXgkYGmjNugg&oe=6A450C3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcJPeWCdyQEQ7kNvwGInVxI&_nc_oc=AdoC-Y_nFWgV_6Sg1mx3CfVAPZcyjE0W19_eWqxRn39H94sa9z0GAQIVoXe90zwFpe0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eUmxzhqB7DPNnqb0TzGY9ZhaVlAJ6qY0l-xFO86_rcw&oe=6A450F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxiX4fzd490Q7kNvwHUVVuX&_nc_oc=AdrGfCbmEP8iSHEVeR8ouYJRHxg3TyUadhzvIpUIIYXsCoPtqne3EveufnShNBwD_IE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jO4a3O7_45YMDZn-GJWFheD_yYOfUO3v-UB65tNvciA&oe=6A451C7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
fw5-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k13BF0CLueIQ7kNvwF--Zuu&_nc_oc=AdopJOvBlnpZVoxYEmhW9DNiU-E2Dk4HIhcyPy8gMXMYkR2uOOeRDSdXoVpc8m97aOs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gmIzu3X7jIwNkwG1ssMPSaHl2fRscjY5UACa2gD1ryw&oe=69E61D39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCQvF3guiQAQ7kNvwEZQ3vX&_nc_oc=AdqQ3I9xgryaa7A6slJuv06e_hkiDrnIopI7-Cb7mq8PBbfteFc4iMHT5Fyot8qN5cM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yWRFarX6x4JAb6N3T_yr5x4YShQQItd-X-5HyqOXcCw&oe=69E6366B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9F34zAi12AQ7kNvwE6piki&_nc_oc=AdpONI0QWW6thEyKZqEloEkRhMW5HRlSNhwj48FISn-PhOqVNEzcf9KD_oFyIoO3RMs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UOkiwsFWxuaYyfPrJYUjSuDMfRW5di8zwwqXr9wtLIg&oe=69E6203C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w4AxqbnmGoQ7kNvwFY9zvV&_nc_oc=AdrHq7vYCsUnU37VV0TO-oBOtudBBOqcZ-_w9QJ1TNK19OYEENpmxXNOs6fq4QEZNS4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q7UfpaU1oVUuxAOKmRz5w93XmZIgCyd8SKb76pwcfzA&oe=69E6239D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uvsRvYj7LgQ7kNvwFdPXVa&_nc_oc=AdpSECZ1d43sbIbLUgGxnSHySc2vdVPZ8SAyVZ2c3CbmOyrZRLVa8JxXbedrPTJRtxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H05vEQ_PQ0zKjib4FR5qCv817aVJ6WutBlccU62RwQQ&oe=69E6307A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
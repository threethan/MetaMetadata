jc6-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc0wyG95ZT4Q7kNvwGlt9mi&_nc_oc=AdqKeDin1edDgnzjGJMH7Rz2oiGSPz7LV_fYWBorDv5RkiESCvwNWcy_H4Ht2w7GlQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG8dpp8H1T75SPef-LzuHe-sbdA_RFglWVQUbaalNijw&oe=6A5CC439"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD-VaPtJHaAQ7kNvwEsDRod&_nc_oc=AdoV63_j6g5-flcuiJJOFqN-7RBQ_8ZPY3f9zn6RKODFQalMtheSlRbkwOhKl6DZo20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuhRGgLkfWGlDVXAz_SbBJRfUUbmehxZ5x28iERLgvXA&oe=6A5CDD6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkdIntNmhSQQ7kNvwGgekUK&_nc_oc=AdrXWfOBjZ0fV8IY5DwFuioQmv2j-jnBmHBTkdwSjPc5NVxProP0JQpo3HFF_VLk6HA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaCkuCocEwjd-0wQ8Lq0MPwgQCA-L0nzIH8o8LAEfp-w&oe=6A5CC73C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8d6Tt84GgQQ7kNvwH_BN67&_nc_oc=AdoS2M-_GjpGdun3reZKjk1Y6lLuw_21M4avkcE0JDABYqRdJArjN3FEXU7J3yPB9bI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUNZ_bDjPnGGVwhaYA937TpegyiGa8mcL3g_NbXNdzXA&oe=6A5CCA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxvHW_XHA8cQ7kNvwHDNSlw&_nc_oc=Adrwb7oGdpZ6tbPO3FN02dLxg3fLcN_i1_-3-GIuklCFjLafaQVx30_SiqFhEPAU-Zc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUKrdWO-Nud2ElwsCxCZEE_1UVdnSNRwGLnXnidTUXXA&oe=6A5CD77A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
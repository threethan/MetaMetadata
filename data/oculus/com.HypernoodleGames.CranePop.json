ea5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob0Vex4Ffv8Q7kNvwFsESsC&_nc_oc=AdppQnw1kymFZYrLeq3lprfHhG-zaq5eswW7X1kM6mBNPqsYDCjKrhIsxJOy7yovHvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHHExdau06FvAH7xQ2UtCiFEddolHGAkhRSsKH9QFJFw&oe=6A902EB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKK8DC43WywQ7kNvwH0d438&_nc_oc=Adqd6t6-kPTX1iHQVG2KmZa6TxPXAiGSOl-3ZdvBW6dEg2uFDs8dlMU2b1khFlX8gTk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqk3LLp6qBwGZ0fjPRLNRxRtP4_Af1y-NyNBHWjru7tg&oe=6A900FAB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1DIXLBkH8UQ7kNvwFPfFGf&_nc_oc=Adpw59x3alQZLEL0qwqv0BSIvoO41y7PXAgTd2IzNEVFinGk8_LhxYua7q8UJQKcQFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJIcHTGFZ2w0OgDPOqOOTBJ_KiAW8edkZ5hc2zvzJoaA&oe=6A9031BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt_CTxKisVMQ7kNvwG7wbnb&_nc_oc=AdqQvAR6C-qHX_FcSxsSa-3tXSaGmEgEC4-zASleyqJYCinvcbxSFX43AbKena0swU0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEx1cnTtm91C1cincu9IB_xcwIv3qTG_hmapeCQReqYg&oe=6A90351D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVU8Mhxoih4Q7kNvwGSt_sG&_nc_oc=AdoxVAfce4bAKxBg_oUV5g0NIXPKTpOjZt_S0q9oGH6F0dLc5AAXKXaF7sO4FOfo1xQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoSqYbNitAPG1xcZiSI6Xu9PGUzUxdxOL4PUDtwODPKw&oe=6A9009BA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
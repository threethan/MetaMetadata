ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXLUtcNYiXQQ7kNvwEgmEAO&_nc_oc=AdqAc55uvfFkKXZ_PMa-d7WQQsU3tJiDGdn9e6MPgSeQK-QJNsY2OTGye-3o_4bZtbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjwXqe25F6veNG0FYfXPWkbALFBqG512n6Gt5gc1RvMg&oe=6AB518B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5L6BI4Z5R8Q7kNvwHD5O2i&_nc_oc=AdoFFrVYgGm_yAUT_Z2SxMtOdzj0eeUm8Uw69lWPFDtkq7Q7d4j9Ex4ZehjPsLhjEvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-LCdrXxmEwBbTCN-1CCGDjU5j5wYYaEqSUkhz18iSBQ&oe=6AB531EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKArrfTaatwQ7kNvwEQOSBb&_nc_oc=AdoPyG4eP1_Bl-2KAiWYFdGoyc5l9TJ1OaGnVOmdL5Lg_n55RfsRsAbHjXQ5-z-k6-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJHZqVEOYUOy46DD1PaNqGMXCqw7s84o95KL2UjSfmIQ&oe=6AB51BBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJh1nyvt2zYQ7kNvwFccWCe&_nc_oc=AdqdDFTr3qqPSThJ27YPxiUD4XOYTN6IfqwqIh5LmUurIZWOszXqA6q_2U0uwK9TXFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgIanFBnCXAqdspwxKwMtH9OX2NXdMXQ6ovII9UTWGpg&oe=6AB51F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLhwPneMXnoQ7kNvwEtQCkM&_nc_oc=Adp_svOCrUmvGHFkDZpH5XmqIFDezsgqDei9-U7BPQvBNq7OGx1HAMeUYyUvEpvm-1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYl7__EtfY1zhNlePQqXHy9kK5RnCUPUF3_dvAHwe-mQ&oe=6AB52BFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
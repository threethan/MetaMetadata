tl3-3.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1cGGRcRsmgQ7kNvwFCfSs0&_nc_oc=AdovgYsJ2P4V_S8FmHDROcQgh9OXfT8ZC73ue2QAlRqBBLNy2QicHsIxfaYSEUP6NOw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UxvhEVTXLH3FxcABB0MFZM9sCwLPkp6uZNV5ZtEBYHw&oe=6A341DF9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN_QOsBOuSMQ7kNvwHQEphX&_nc_oc=AdrH0r9Q9Tw4RqRUUDjc49OWkFAVYGWxDKt6QNWN12lujzlA1esvXkbru6bEMI4I2Gc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pTHWOGk_dLYrobO_U9sE-CLOEABA9sBIPOD9mHYtgtA&oe=6A33FEEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnUOt-IlzaMQ7kNvwFYKn48&_nc_oc=Adpf84znMitntEIEi4uNs-0xPhqmctnOFOSqjvI4w3L6rTPg55KWiBQ0ahxKxttZSiA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cUvfXcq5WkI6zidWMGPN79LnlI-g6p1tFdMH3OnQAoQ&oe=6A3420FC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJNYkE56WQYQ7kNvwEv4sS4&_nc_oc=AdoaYodRBYo3CBAK8c6wMpu1M-LdoBgJnvXtKEQJ9SxD2XKEKMbl3qoeVCs1KvAKAiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HZgcM7LGs8gaWH5X5tgNCizaW3nDy7bK0faSgIeR7cw&oe=6A33EC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOu5jzwrmyQQ7kNvwHuwDrJ&_nc_oc=Adr4v5voxBcMEktHocoNzfnTGnbWdM9X9OwRbN0X1k-9LFaTuVuLKohobrFsaBBVN70&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QeUtJebyKk1Zi5wov6OTGkaitF6t1iqKwan4BMcuY8w&oe=6A33F8FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
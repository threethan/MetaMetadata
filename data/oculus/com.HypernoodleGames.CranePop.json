fw6-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS58Skv43kEQ7kNvwHiZdns&_nc_oc=Adph3xtdpyI_S41jwMWUer_e_FeCfwd6vmJ2McCYkLFOYv9qs4ZbcNlzqpNVx02AtyM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA0ugMWn9NbJljnNKzU7I3oN9T4udXIOg5I5aniFVQ7A&oe=6A65FEB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnhFftLnL7EQ7kNvwERqzd9&_nc_oc=AdphCGzS-gg0vDSlcnHrJkCsCMvCti2eund681Szd4AyZ_AndF5sVQ4koMvvPR7mnzc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsWd2A2F3hkUsxQVDK4fELwrQu4TTSM0hYmkiJ3MdKFQ&oe=6A6617EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87kY-ndJK18Q7kNvwH2Z8oy&_nc_oc=AdpP7Re6Wsk1X6tmN-3P09Vnc-ZtSqkqo1H5xkg40uW_ptIDRmKGvnLCRazaSv4HCBU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO9wNI_6ywQm0GkbzL0ydMA-oQxHBf1lc9bCGV7s13LQ&oe=6A6601BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cTtYpGWPuEQ7kNvwEjmce6&_nc_oc=AdqJYbn3e9ZakMkme-mql9x6j9-iMF9xRfsJRWSuJ0342C6GqR-xQJg7uHzIZIQi9S4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRxbhqr8NhrOqBk76_OIw4u9eI1RFnR2nVZzxBxfEJug&oe=6A66051D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQj42fLy2_cQ7kNvwGPHi3v&_nc_oc=AdoUWuMtbUQPrDka9o4dUvvp31ecNh74QeuGwAuA6UhPnLI7WvIosBiNkeMNLzlEM7o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBln76OTXgNPLZUhzfhJNqwg8uYXfaVUKAe0IJ43QeGgQ&oe=6A6611FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
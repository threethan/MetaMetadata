ea5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8wOYChtEbwQ7kNvwHkwqfd&_nc_oc=AdpFBvRB7LV-rzSgeEGd4rMgzhdG7wJYkUjypzaw3oSro7ucyP-ge6olrN6G0ARQPYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA3qSViO5SrlrnG8UnUZw_CdRrP4c1iDVn1ImhN4zJew&oe=6A54DB39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ4ALyI9t48Q7kNvwEv81Fd&_nc_oc=AdoF0u5GWRQlFg2Sf7EEwf04FviTuslDxWRs9VIN8HzZVEtjgI9LTEwBtWn9WUFcD3A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3pCshniGGLY2OpXM1X8QCkaIXeRftDmXkEF_Bncg73g&oe=6A54F46B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xbcspk2HcWoQ7kNvwGzmpnR&_nc_oc=AdqNluUFNAjlUkm25EaYqLLFGJmeLTGrX7sNgFaG9MciSejvdyYu4O4mxq0APIUoZ3A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK70LasoLTRqTOvTvvEPoOLCjI4_PIJaoxfQtUnoM2KA&oe=6A54DE3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAb9YxlhfCYQ7kNvwFjoOjJ&_nc_oc=Adr6TmlkDQQpFOetKUcJ5ZOrlDH6arBOllgkz_B8sGl2nv7ix7wxZI9cOg92-Bbm_Tg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeYzOPvYsTFxmh4UnzT8m9VRSLezg66s_zk4-qgbBTWQ&oe=6A54E19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAXRrkNDYn0Q7kNvwGMBrmp&_nc_oc=AdrFQNQTKf5w91hVY0LL8sKBIsfw-MJLN-6QC-Fk8sUL2_M7Gg7reghmG91xkh0AWy8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjW3ZmL6Rj2XeAGR4gQqfVldTWZ7bBYF0Y2hyPa4iV5A&oe=6A54EE7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
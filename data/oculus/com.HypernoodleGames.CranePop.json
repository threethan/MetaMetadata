ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhVos6MWnlsQ7kNvwELXNbr&_nc_oc=Adq92XRneecAO_mFDGQqct8YFK4FnSQ4WpKQtCWGlLCy6e8yrtDVnlIQ41Xvn-31tZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68D6-m7zLXVVWre0U4tiFTPW2CWDIUfhaGkmSWNXr8cQ&oe=6A1ECDB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL_-OiKDUnIQ7kNvwHU1Zrn&_nc_oc=AdrzpLxY5s4kzjAeR2DBmtLD03YdIEeuS_hcZEz61DruUiMNBHFj0AWlrA_x_4pvHKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tVhWC669-28GdrCN4w6fm5oMny30ux1J5yX8d4FN6GQ&oe=6A1EE6EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZlWqK9WE8oQ7kNvwH1EpG6&_nc_oc=AdpMieJQDJDNmd2n_xCqBDHx9HYy2vBqYaNZsyxsKhKhbmzuvTbsrDIsieKti3H4W1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X-rsYxwDysRrB1Bc4T-Tq-r0zCfkG8gk-gzef4gU1_Q&oe=6A1ED0BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUw63bKzPiEQ7kNvwFPy6Cr&_nc_oc=AdpgiodLUUOce-KzOd5wibv6G1ue4gqtrslbSDch_2ae6Q1_B5E1o1pfTxGS0_CKdq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_D5bMXu30vIjU7m_26QTbaXqGlsUQukP2LZnwZZLBwA&oe=6A1ED41D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0MYCDle93IQ7kNvwGQZlhE&_nc_oc=AdpDfPZa4oP1k3L4fndxaLwyaAtBi7Nq-6YtgSpZTHZSgJnBs78iaQ54B8CNQQ2mS00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lUJZXI3T1UbpwSFgqIp_E_7l9H0zwGzY83IFVtb6pQA&oe=6A1EE0FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
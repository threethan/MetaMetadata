tps://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIuCRZji9R0Q7kNvwFP-Gua&_nc_oc=AdrGekf8e9z-_lzS4LB1NZGb8jxeiKGC4K0UI-sxGRtBVriEUjfYh1p2IYmT43TL1r4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oyDZ43oqDADCBO3tHI_d3oJSqrPtcyIgNH95aOQn_0Q&oe=6A36C0F9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7guXvQj2MIQ7kNvwFrWo9n&_nc_oc=AdrGciXhhZNaJiJ9fyiGc3ui6-xHniH0WAzuyY9G29p8TtlR-7ugLerotXZ0OpkE34Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XBA15nwkSoFcP9t7IDEQtLHbJ1Vk_emv518rrQ6tdHA&oe=6A36A1EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxNQKS-46sgQ7kNvwGRmhOU&_nc_oc=AdpyxIx6Zf5UMOciYGzIQugrMCFC6BgUA9tiiUJv82BaVOl2cXXdqghkP06ZxSlnbFg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cmTUT01op6Gw1kjExmTpW84u2qCOEzMVFu3MTxq-gnA&oe=6A36C3FC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vedGO7EDdMoQ7kNvwHC2H5K&_nc_oc=AdobFfiISkBwYVx09qA1X4doPGd4Vow39zUneFlRCPqDQCBt-3BMurra58IsNyavPv0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-UdUH1wx5oURMuqO2Jfxfh5VkDbxnTVJoi42NwQ9omw&oe=6A36C75D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHpRWr-D8rIQ7kNvwGGFYU5&_nc_oc=Adr1DvPNHFXR2Q3hkNYsRfAmkYX7ZbnwpbRMQyxaNb6kLBVUM6eDlNXjY_Bpsg3K4OA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j8GpVlXvBGplQjnx7rhvSyUi-K7ncRu_0U4SqdBL76g&oe=6A369BFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6VZ83PGdVoQ7kNvwGio-5i&_nc_oc=AdozyRtD-iI_8qy__Gew3zFU0JDsxFD1ND6spbvw9BBfUD1W2BJekFGlj6sL3HuXis0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgsTV3vXOYyOlUJ57GELkRzRhNvZtSFtMXIKUlTl7bcQ&oe=6AA7E9B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w991doUQUccQ7kNvwEK2rJa&_nc_oc=AdpLygRgNdnrLrDABJbi8u8IAHc3HMqPUJpsfYUSeE_GRTYv_bGQW6ztFLdUeYuuEuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUk2PMdYf0ZkHwkoXGreC8hWeO4MB1kzF2R_zpg0fL5g&oe=6AA802EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO_hOLty8AoQ7kNvwGpFYMM&_nc_oc=AdpASruvUulERb6DPOaVIKzdq1asgW7LL14B-MroJsQTSBRg7xQZdRm-u7pc7h_5mhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCGxECqsWh-oAgAu7P8Y04TWkIIVFN-Hx6yHQCz68tmg&oe=6AA7ECBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFPyRXbcS4cQ7kNvwFt--LH&_nc_oc=AdrmmcrcnrM2Jh-kFl3LFbqbSRrgvIlR7quokWIcKoS8uSjWMUt00BRsuB1tN3Ghpas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOHSkmlXXPYm2CQ9Gr1V5nywm2fXKB3D6qJYWCDjXSHQ&oe=6AA7F01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAwMqb7Ml_EQ7kNvwHMjL2Q&_nc_oc=Adquu5_7b7t4qADOhsK0Don70_oDWjvMhxB0fbNNUTT2mYBbnv_od7MYItJweW3hmzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgmho-ifRfv4YI2dITZtv1JWt-8TDT3LdhqPp-p2r6Sg&oe=6AA7FCFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
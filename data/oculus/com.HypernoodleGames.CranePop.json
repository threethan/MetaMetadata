rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCcX_DHca0AQ7kNvwHzwRkX&_nc_oc=AdpiCKYGqZ8e_91OR1UIQoIlh43UuDqnSkxoKrpC2vNPEmYEOutixILN19drr4aWkUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57soxGFAUGPKfS00GcnlJQIhfHMEaRGl3WjDIuHsEzoA&oe=69F9E3B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLVRgi68xN4Q7kNvwGKaaeo&_nc_oc=AdpJxPcdAsMpFtrQngmWCiFuuhlozw5lI1KNUzM3BXcqHaBEng50hi1VSOmvmi9FFfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lc9xZinCK-EEBKtnIsJXJSYZ7zr1w10WW3WMOC03neA&oe=69F9FCEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vU3ke6M_pYQ7kNvwE7ynAA&_nc_oc=Ado99OQxp3mkr_WKE1d48HiwV9aLzrf82dbZgvKgEU01RWSVeQiSwbnQf9W-oh2rPcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hg8kOU00HQRjda52BCxMhonu9KOq4JezTZ_c_jAPbDg&oe=69F9E6BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqVX95VKO3sQ7kNvwGPOpBa&_nc_oc=Adpx8dzJweX8nRIp8hXqKOvCbmRDQQcJ6WgGP4dYKSjXuA-_APGH7n8cfk7ZAj9pX1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WSSpI4KotjKogH5E_jSVv3JhlNyl_S62WQGrbD3pM2g&oe=69F9EA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KY3jU1pc_0Q7kNvwFlV2Yp&_nc_oc=AdpVHzUGxHFSCg4eJHS00UmGz4MlWSeI6Zv-2Aj9DlPQo8GIafBPec05O17w4dxSTwE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62K6Pu8yhxm2TA1yVHX8XID0PXyzEBCeHUV2nBwpFo6Q&oe=69F9F6FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
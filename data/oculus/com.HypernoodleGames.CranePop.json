fw6-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCwboeFGQrcQ7kNvwEV73PG&_nc_oc=Adp1t1B8WQs8GTSn9FSTbBbWPY3GqcuU-puiIiBjS367KPlA4HbRR56Vu1dig-1aLKY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfGLhKwiB7wG5zI2d_iU_e1dX7WpcWEBbf8P-iCIOjpw&oe=6A8AE8B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIAndTZItPUQ7kNvwHdtf9b&_nc_oc=AdoPP0ztqipee320KbZPo4qpo-7sYWW6k1yWXD1KwnBzVbwLFZycnGLlkPw7X7EPWM0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXGEU-udRdpMKza9qcv-8I87Hqpo2YpvAVsXW5ncECCQ&oe=6A8AC9AB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJzQCtjBQdcQ7kNvwHWZrdl&_nc_oc=AdooJJvk-cWk24NkTMbqh7KDvLxi5jaFzW-5mHXL_Om0aF5hp1NakI17-YP1hS418Rg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO4s32rZpUdyFjo9eWTpWMAZuCBZQ1z7qp0G6ksdbzsA&oe=6A8AEBBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLcN5lWIdsUQ7kNvwFs7ISo&_nc_oc=AdpzMh0OOikY3qSEo3KQse7-iML9k6PsiE1I-ml218nBufTPDLzyNzzpBsMIXxW9f1g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ReH6PriVwWleXPHWkhi8ABTLmfsSjyyQtTu6iw274Q&oe=6A8AEF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPwjgjMmJXcQ7kNvwEQoVNl&_nc_oc=AdruwCLybqxwoEwvQ30OYIFOZWN6221X0DLbNTYjGsNUOD50rxDw9Ic_pznbTJvlP30&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJGC9El3xb4DSLaNELphZdRDa9UeCZppXegjNALAo2Sw&oe=6A8AC3BA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
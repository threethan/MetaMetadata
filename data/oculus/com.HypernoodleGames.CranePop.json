ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j5z4DIYXiwQ7kNvwHr6p1-&_nc_oc=Adrftvc2fEQvALIhfIgtM82kfKKSA2umHS_NCMxcNn5LEeOOfn3xyPiSwf5ArqZdpjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTeBrQW3wXDRhS7s1MtD4BDHyy6GzZ8cER17JDOIBHPg&oe=6AE48EB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxaSw17ztwsQ7kNvwEo5Aff&_nc_oc=Adqs1fxaKF2lmnlAVCHQ4SVYFk6JC1hI4Bt2E9OFxdq_eK0fp2IQxL3tpy0GDP2-mtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-udusjEBPagW8ywXGsRU8dt84DTF-OtDmrU3c4J1BQA&oe=6AE4A7EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1iQfMVBifUQ7kNvwEqX_wH&_nc_oc=AdoTl2Gzzbs0ay5h43Uyp_3Xn6YnfVV58gVYrqxick-XPO-cwt9Vkcr512T87rqWWgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQChaqqif9JMvXZsmVtFJZYUhPeABb_yUPKbqFphTaCg&oe=6AE491BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p6QSEr-VpYQ7kNvwFEFFis&_nc_oc=AdoToiTwmPQC6XgIX046aCvHbp42Ib53Xi8F23nMaLlsETm15R8K9uL8ZBdaYgLUvIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8lC5fQfJGSsWOpbkIJH9pwA4nOh0PDv5glRkunPGR9w&oe=6AE4951D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7kORdDSQ0Q7kNvwHNaSnA&_nc_oc=AdpBaYqFN3blCZXW30r91GnDXK1MahFL88AYKcgD4i0nu9ygjbZkEVZWiCKqhhct9EI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOofZNuTq9rShktyJuElnv7B2BuyKPP1aQCuj1LVMqv_A&oe=6AE4A1FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
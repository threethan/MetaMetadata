ms2-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uzj-nDnw3W4Q7kNvwHj1UPj&_nc_oc=AdpO_P8UeJ9c49C7qOSWBc_6Wn20RuuY4txa1I_8GOLssbZRLVq_Y0cU1oMpySbW1NQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G3m6gqnRkk_hcy-U1Gle5Y6hRAZ9Wwz_KYtHoLl7p-A&oe=69FB3539"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LKxBv9oNboQ7kNvwH99oXC&_nc_oc=AdqZOQX4tEuUpXcbFT25H0ADPoCQjs6l6r7ghpbdNApSe4DGAzz3nIXhBIIvmsK25Ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o_03sueNdHHI-MvR0iEvPJJEmHqc651absGRcrRivqw&oe=69FB4E6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vU3ke6M_pYQ7kNvwHsqjyA&_nc_oc=AdqbSDbBbWan3ifKmmiaZBeZ3GPOuUAhTxct4Ey5l1sybCoSk0ucpgxxYkFr5nH33Uo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M2pIb4JtNbzaMb0gYdV2s31_V8fwGVNFTxGl2EyxMZw&oe=69FB383C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqVX95VKO3sQ7kNvwGUuvpw&_nc_oc=AdoRwL9tKGuYZbJk-tc5QqeSxt3VcA58oEZW_AU3Ebm7pK88TnvNvKNAcccSVP5frtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y2EcsyrN52uvaWi-SQGW-9-MmWAX39Lp5I-cNPTFXhw&oe=69FB3B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KY3jU1pc_0Q7kNvwE1z72U&_nc_oc=AdrJpRbtZFQ-9Xz8xhMHmMtZDxSC3OxBbnw_A-ZIE-5_J8Y9p2XENfy0LShF-6jXzBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U8IS_U5xDII0G3lmZqCCnLda4HGAjvLEk6kPc9nBc5w&oe=69FB487A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
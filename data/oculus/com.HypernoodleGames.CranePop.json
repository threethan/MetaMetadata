ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gBPTiKrR_cQ7kNvwGido-B&_nc_oc=Ado1gvyJwomTa_Y1xdreq_mpl6POlDxxKTs1517XCT0n_IHzxzl3G4S5EM6LQBKyl2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7eKqwAXV1pqEumUgNv_w01IHl-o30lerkys0pTFnhEQ&oe=6A5E15B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RJ6GTOpNuoQ7kNvwEDDic3&_nc_oc=AdrOrIzeQEfGb3fvvbI6LAXb6DZEFEuQzmrsEBZbiQNfGq3vSyJUme8lqMNcQh2ubR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA--D7j2N6zVFQTkh9T0J7k0_FcrqPhbBsUKECKme0cyw&oe=6A5E2EEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkdIntNmhSQQ7kNvwEK84y-&_nc_oc=Ado6cN5qd6DFzGM0tpamjC15Ux0eBIG8rmzpxMIXHnu8W758pYLCF0L-VOvcVRGNRJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGQYnIZG9If-Cw6FhGnomlfR2YBV2eP6mR3ob9oTngTw&oe=6A5E18BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8d6Tt84GgQQ7kNvwHpj6Bu&_nc_oc=Ado5_21AOOUyteul4hHCz22NhqpvdT8xS8199syAsitSRt-e74wr5kotAfzf31q_XxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoYLHlP5ScJl8j0IOHldxeUUDJ5JazzPIappiV-MdkEA&oe=6A5E1C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxvHW_XHA8cQ7kNvwH1Fy7U&_nc_oc=AdqNWIRfULmt0XtzCZJ2ADOgAlG7s9ljGQdaCzYaRRc1SpdU3PW7CHYGAVqJeo9WwrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5BsgzIntoLWFlUxrwm0zx0BZx7ZnINCM_-LUX_r1N-A&oe=6A5E28FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS58Skv43kEQ7kNvwEUwtGV&_nc_oc=Adow_m7fNcBz8gKxdGkulk2gPhvWvDMmTxdgcg3u-y89TtCQJ-afCM1elpnzPTMT2e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDa76vy9h1e8VPjVLId56GYIZ9nrf1CfNK5s-DhE2dMg&oe=6A675039"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAdn1fNj6JEQ7kNvwHjpJ5c&_nc_oc=AdrZZd8nkKzxLQ_tQRe1rL5LiAQb1Adt8vqS9-8L3rmLg-sgfB8LPsuQfxhOXtB_v_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN294ITJlku2JmXl-Y5cOOsAhj1tUOOYo4RXbw-8OurQ&oe=6A67696B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87kY-ndJK18Q7kNvwHO6Vrw&_nc_oc=AdpbB2z4yTjPkfMFYiyI4g4lE7HjkQzI09vWomTioDwDrb2k3e-9e_SkrI2ilezv3yQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhScs_xr2ggHfZxUn3l2d2kM8l-ENazbOEmNB-Z5uUoQ&oe=6A67533C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cTtYpGWPuEQ7kNvwGDZTgO&_nc_oc=AdoL01jbsaEvlrhB4UUtwcX36t8W5G_pPGumwFuXxAhyHYFQgTpkZL_u0NsLLVEoHrM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO_a90Wlzz1_e29ZCnVQ4Z3lE3hFK4VlEPb2emviTWLQ&oe=6A67569D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQj42fLy2_cQ7kNvwFvuXQ1&_nc_oc=AdoGih-SyvkpF-k16qkAACNHzwK3B6FmK9EwUAVh_XJ8pXu67Lqie_JGvkuh1dtTQGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByAvWKBLDbIpCNT4Mq-2nSfK2KWH4n8H-Mjm7YYl3_tg&oe=6A67637A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
tl3-3.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbYsY0U4mbgQ7kNvwGYsaod&_nc_oc=AdoHyW3ptJbpTNv4e9pKybpc2F6J5uIzuOSCwtZub1TpyxKhsRhnGrT0ASD610-Mk3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pP0mBeU8H8fvlrMcbimzbFB81U7O_JaX9dZZF28rQYg&oe=6A16E4B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l48eKgjXRCgQ7kNvwGCNuLc&_nc_oc=AdoAPErutwdqcNOyhVMN4c4hEJPQl2vcsLv_IU-j-FcKP4Q2-gLZ_ZGYLGx4-DRQclw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JmcIEeyvdF0IX10C-ICtxysabiEmeuQLbZjjdERIs_Q&oe=6A16FDEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gemWl1kZiV0Q7kNvwEnnw6s&_nc_oc=Adrx79xm-y1oPl7_FZ6EpERmjz2o4W1UKEc7RQFXuN7CmTgqIOX-sS3I5_2at-YN8qc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S0O1tieF4JhdQ3faBiJ62sj_wlJNPXnU8XICQKUC6bw&oe=6A16E7BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RfgEi0gMwMQ7kNvwF506Vj&_nc_oc=AdqxZJiuUQvXLEMUpe16hpKstQP1JXmnFDQwnOZ_9zOrIGeUisQ2gi_atmk4hoK4Woc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58TPUQ3EHf2vqr6J2iOMSVuhaunM9tuyCoWwvxzk_R4A&oe=6A16EB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GstgbrUaL40Q7kNvwHPkW_B&_nc_oc=Adr6b6rN3B_j3ke9kbw_4ukIZian5aEtBjXzP6ydb_Rreh121smwkdKTDd77eLYvqVw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DzyFhqWwxqiYs7UDsCZRXCgBlRiGwlHNg4JY5JAP4Qg&oe=6A16F7FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
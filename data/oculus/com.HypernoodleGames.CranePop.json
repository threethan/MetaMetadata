rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P34wj8WJq60Q7kNvwFRXlhZ&_nc_oc=AdqWf0r_ttozURQx0ysNHVefTU61G7daaNmtkmezNMR4ZO4davFbUjgp9bpRRr6PRKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g7GdSmKv1I9BppIsb7TtWVtoNhtx_YAqC_hWF2_h8Fg&oe=69DCE2B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLJvqY1Bi7cQ7kNvwGNb1iQ&_nc_oc=AdoGh3ptZQS3EQv1PXb5GmOWX36ZbtcBMchhzRuSbulFO81vBwqedekbcCeU_FpZUUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j-owh509c8DzdpX6-hSSbv-mJl5rBmsZfql9Egkm56A&oe=69DCFBEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18dkMbfNY9oQ7kNvwFefGlN&_nc_oc=AdoeNPz2mY7GDYBsOsuAQ_r5LhozSFkZnObLvRa8o7k6Dk2oeEJ_UYgf0dC6ddV0MdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hfzMpWxwehv-uYhuV7dsBqRLGPFKT1u2E_9JaOL0_Ug&oe=69DCE5BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf5eqm380TgQ7kNvwFjVZBG&_nc_oc=AdqKenx2fhqiJUbkUWx5Ofbz-DwHhYEEZTJPDpDi5epZjaUjcYln4bj1Rx_U19m43lQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tf7xAG1eokXnRTgt8UlT1WRAZYXAjKDoVuNCqSHhViQ&oe=69DCE91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKvSVhGDPKQQ7kNvwFgq9CG&_nc_oc=AdqYVNFt8PIh5thfA22k_sm3RD1yI5HtgmD6c8vTSEMTrhz_KmFH7rx5LSNdQ6b6oac&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pHqT8ABTh50t7W4HR-GdB5Dwp-AZj-IcvCyRN02Vvcg&oe=69DCF5FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
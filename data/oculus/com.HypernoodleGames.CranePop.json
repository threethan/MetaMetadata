jc6-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NhxyFPxdGkQ7kNvwHACRxu&_nc_oc=AdrxKpJDxj489ZDl1QTGlhY004cmAi7ev4J_mBjuuJPuXBlaCVeARcJyMME4RRIsF9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiJvSfDEgd27TF_gs8p1-sUOcN2vGa6q4NWhghT0amuA&oe=6ABA5EB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O5dUbMbAoQQ7kNvwF3UISg&_nc_oc=Adrx3j9havetJgn6c9eAFEQ9Zph6jnyYKvPumTl__gm8IUV2G1UByfDKVL5p401eh5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWqADJqMqLyfE7rAxogYtx5zCorsGSHaVNQdOrSlde7Q&oe=6ABA77EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36pmLriCBY4Q7kNvwEbBmKT&_nc_oc=AdrOR5fT7QkRQmQr6r_WC6tr8-jWvn8WDglgxeumhwsL6TSBacz_fBheaO7_UAUI4GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN-FG_Uqu7kWHtWEh_I6PI1Pg5IxJN8E05ZcBVkMnXdA&oe=6ABA61BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzgCFHvvWrkQ7kNvwFSemLD&_nc_oc=Adptt1VNqWzjqRj94HUuTKaxAbegZ4BmaC5va9t4MhubxClTSR0iWzOJ5Mg7VPOaGm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBLJHW5KPJyvmtiiUDYaCc5RZPi_J5iTNgb9vhVR3HMA&oe=6ABA651D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2E8Y8vdmroQ7kNvwE47I7C&_nc_oc=AdqZvsOMZHKWS8RE3erEOkAxAcO6r_vXDKN76w_ofDTyzegmNfMvmfoa4He5oxUab-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzruWK5GXh2LSDFX67kToQTrxpUZgtWRmXMBjSWs-tPg&oe=6ABA71FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
ea5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuWGosDCAhAQ7kNvwH5ufog&_nc_oc=AdpZScPFJMjiAOk6waFNug8ZO_k7SsEHlq2oaKpldNqnEeyf-p9-rxBhPGWn6sJobjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51V3T2lNQdtaso344ZCbVszol3dFuLD_susiG7TQjXzg&oe=6A159339"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE2GlHHB2coQ7kNvwGRDecp&_nc_oc=AdqdvJXrCkHeWn9HWWMRMFHm9IIbBipFCE0L-UMK2swP1BIBp2atj-8QGmgO2cPcB4s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LcdYCCD4KSxCTeSMyTb23JNGFAef18K27ywObUrlhjQ&oe=6A15AC6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gemWl1kZiV0Q7kNvwH3i8br&_nc_oc=AdoP9Y1cO9u40_5jtTTbkl_yEmKoDsYxhoB_yYPSs8hq3ix7mJMRUAuPh3uiGiH4mnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Iay4OdlKd9RWIUSCv69WuHAl-nEWaQFBEzuUd1Nt7QQ&oe=6A15963C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RfgEi0gMwMQ7kNvwEy8JiG&_nc_oc=AdrlRoHVqiBOxV783PKd0YskvOXOjat72t7_auLJJ3VTi1QE9GWMcekEu1jt2bjefK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z6RJVjJZKJeBP0ZKAnG-MiINt9PPEuEaKJU8j9iicYg&oe=6A15999D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GstgbrUaL40Q7kNvwGeFcDe&_nc_oc=Adqp3HOsU8N0wJsP98Ng6zSPIkJBW9tdgOXicyZPh9VoJgDaeAdWGiHLl6ZgdM0c5fM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fQKWtVstXZKuEl97rlrxykzDGkfZlQrsJYKsVGADJRw&oe=6A15A67A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
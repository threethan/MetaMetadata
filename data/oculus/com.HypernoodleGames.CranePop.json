rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqOal3yEivcQ7kNvwEUnzfq&_nc_oc=AdrStUpfEnoZVT7jjsW4GTob2zn6Nr6Qp7iK3D1svNm-IZ1-jJY0u6oxKzX215diS-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECUWUPb6GevAz1SCygLlCDpIHeMZx-8DPj4ExGteA-Sg&oe=6A732DB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DFZXMCveYEQ7kNvwHQ1yvd&_nc_oc=AdpEHvj0KPwYs2z9iRIQ4OS_9sRPwKgjce8Ahpr5ae9JUDGLqru3PBZGUc9UkWMcWE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDMGnTHMbyN1_W7vWwofsh0O-7hwsAdWC2L-870s8xDg&oe=6A7346EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=589on5X8ousQ7kNvwGq3nyA&_nc_oc=AdoM3gFgFy9Gm4MUCaViAvaJPlxY3rl-qjmBp0h3S7DNgJCiPn4Wr40eCC-qr7CDFKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLJ0ll9PYBxlPBz5pH2NWOhH8-nOd9gS24gfaw-XT5gQ&oe=6A7330BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMasq76StLcQ7kNvwEPqoyi&_nc_oc=AdojBLmFo6-6PsUgTBRQyB8_sOxsWQZylMOtzyYnRlwrPNcxY63cDP_O5h0DIYrQUY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkSJDBKMVTl_OEWoBTC3hSPHhtuX12g1U9JcXot8hDHw&oe=6A73341D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vsuu3gU-HPQQ7kNvwGOXwNg&_nc_oc=AdpG15wQ9A2w099R04Lvl1mKcgRdYFLlHcCQeGk_vHTMqYoLGnv8PNNP5oxcgNEz5zU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3FGuvgovi0zreTQmYwJhZ8iDS5egw5RzAkmPAIkR2Cg&oe=6A7340FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
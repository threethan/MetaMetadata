fw5-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIKpsc_2oVAQ7kNvwGgCyCk&_nc_oc=AdpflrCVclJNq0ejNYVnDx2IEf1zokyXIV-H7iqjFrfRbxdBJ-MeyubSWnmA1F9WI5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2tSqZAiRveCc5hFry2Qeel6h60SwGEZFyHhWMs0KXmg&oe=6A244BF9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2j8zu0fBCkQ7kNvwFChvNY&_nc_oc=Adq-wXFmsB5tvdeiCsPiBmx7NZE9pLJvyJo0ReqvMzQXmm8VeDlNVs74-wCqIYnvEi0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PpSISPsJOMSUSVzFG0OCjG3Z7m29y_dw-J0P7AwaQNQ&oe=6A242CEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb7H8ujpNzYQ7kNvwE4yAvc&_nc_oc=AdrbkmORzt7Ms4JXsyVPA53zC1d1cbcB-2g3MJL2Fqxq3fI_ihMv_qJFvu6U_30Q3y8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vRU4gQuZ4-RoOB-kMZ_1tPeBZitOCENIwk-5fzTe42Q&oe=6A2416BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSVQ8-jhfZAQ7kNvwGx5DEa&_nc_oc=AdpTxHwliE9xoJbyjslYKCYGJLyOpr5v9Y8oSz5OuPVknnBArBd28yCLYaQofqcAFLc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fBYh26btBANeDA9kzPD0dPR6dnFYquVu3AlV4sO9zwA&oe=6A241A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YQAvEfkMP0Q7kNvwH6hJGH&_nc_oc=Adp1lIATWk-JGHgTa72t2H43aweuhkuiidnLvJLr85mRO2-OkYkmwBDCUO1YZ9lWzM0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YZyZ6G25UW-ZybM0r5oSi0qEOdecVvnfwqi-Ls2Zcow&oe=6A2426FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
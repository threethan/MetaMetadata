ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV_5QfexMekQ7kNvwHW8IDe&_nc_oc=Adp1fpQJrEosylciFTqnEaCX_IuwLTq1eaVWAUOIFxH-4dBPjJtvFtScyg2elYKagKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhGsT6cO6cPQjhBUDnvu2PALI-hpi6qCwfXfrjvzCSPA&oe=6A4BA0B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-Md0djoqD0Q7kNvwH8sUmR&_nc_oc=Ado8jKKeXoMwNtUugmckJkVwe8Z1ifrBRCQmueD2606Vw7kuWbFU4ZQglxQe142XCxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7OMyOVllcaQgUNAI3Zw4qZ9Nrl0rOZswqFj1K3ZsY9Q&oe=6A4BB9EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYmRGfusqEQQ7kNvwHsAHQN&_nc_oc=Adp7DBlO8PZXe0bjeWdOrj1wlc5gj_aWc_RPydbTNeVlRNjkRPjBEEbwaO99Mrih3Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUrgSCu3O8Feh9s2IoMva3thNtWnZYXHcbYbHORGm97g&oe=6A4BA3BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7QUb2AodaUQ7kNvwHJySgP&_nc_oc=AdrUqRa5H9Bi6OR9knX74aDQJAmhnrFMr4FnyQ32PZLbalMLYzEyrwa_ZRFLOA2JHwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvg7NU9oHSvh2nFVi_HAoRsz0NdHOnbFDKkNiCBuw7PQ&oe=6A4BA71D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CEdPXYchbsQ7kNvwGz9BGA&_nc_oc=AdrGLuYXerygTHUqLVreOxevwyChNMQKJtXoKIKef5FANyJju39Yw2DQbHYtS70JEEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXJSEOcO_AKP9_W_kYRZGL20TgiuK8UfUWlDCAdTcL0g&oe=6A4BB3FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
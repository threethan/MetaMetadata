ra3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8R8fYDLQWIQ7kNvwEHAGMY&_nc_oc=AdrVOjhl2Ue2uFR4D9CnNKcrtOCTzE6Rx6zE810PSEyMlGI7FSUbkgjGNMhQLwzVKYc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH30XHfZsAPtO8krHjyrSMvBkvpy7ZNbe3umz2feSHNew&oe=6A8845B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5b3sUCSLO8Q7kNvwF9lvZN&_nc_oc=AdqHp_yW9Y8CtJWG92c0Sj_8aSQkXLXFB_GY0q9Q7yzjVQjjoC59SkDfSEtMPyW-sxU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9A83rIKYC7GMWKEyRQ-btxAxoIcFGFw7vMNXzjWtd-A&oe=6A8826AB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV70x53t7MgQ7kNvwFfccuO&_nc_oc=AdoL3ESPLnLfa-MqAwNJ7CpnMlCKUd2mdSxFTI1qhn9DDTVDhhYaPmiET78G4nmFLWk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy18a5Y3rZwc0-E4u8cEW43PGjahr8PS-Ghv0jLNrXRA&oe=6A8848BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLcN5lWIdsUQ7kNvwFVHaz_&_nc_oc=Adp7Vc4BpiYQzGLPxVs_JuQhfLiYsesDrj3HCSvKRphs2nXq_eNsTlQdpAoY39AA3Ds&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcfUer5Cob6aAvuMdEzA9uK5Wx1mNSfsyIJd47kcG-3A&oe=6A884C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9pyS6T7IgAQ7kNvwHuGEa7&_nc_oc=AdrWHRN_hqMIrK84fXDD4tOCr_n3ekAVJYdX5cIFJSyaxXb32MzmotfD_YE4zv57GsQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl45uFVLD4pZ3diNSKhMmdyxE0d7nWKzsabkgnwjFAgQ&oe=6A8820BA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
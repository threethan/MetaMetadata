gGJXoaevCf90UqtE5Rwy_0V4Z4GY1Rqw&oe=6999A9A4"}, {"file_name": "blowfish.png", "id": "1624707322232725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_1624707325566058_2333624222558977449_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsSQRd61TzUQ7kNvwFrPZ19&_nc_oc=Adk1CbxMvzES-uRIW9U3q2ntwkAdqotKqN_vTgkJqdIKMqZJ7mguvZueh_qqdTqvpgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWBJPbooKZujhDFFBACGygta_4HhMGiast03ejs-W87w&oe=69998EBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot_3.4.1.png", "id": "25838068265810644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618102_25838068275810643_935613708642561262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1_nupltZk0Q7kNvwGbLDmo&_nc_oc=Adk9XKeUvwRD7grj3I9qxfci8u8nhz79KD6ufMb6wFxs8SN1q-nCv_WCLRIIETG6ly0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEa8mdNVBduYkR7fYKxuOm6zZSU5GZNTDfkNLa_ABvpQ&oe=6999B04A"}, "display_name": "Crane Pop", "keywords": ["suika", "merge", "physics", "cute", "short"], "long_description": "Drop 'em in, once two of a kind touch they'll pop into a bigger one. Keep dropping 'em until they all fall out! The bigger they get, the higher your score in this 3D Suika-like!\n# Features\n- Multiple themes to choose from.\n- **Passthrough** (recommended on Quest 3)\n- Use the immersive joystick, the controller's thumbstick, or hand tracking. \n- Use hand tracking and a controller simultaneously (Quest 3)\n- Leaderboard and daily personal high scores", "short_description": "Fill the claw machine to the top with bigger and bigger toys in this 3D Suika-like."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "CO
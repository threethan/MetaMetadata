rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84IRt-4apPIQ7kNvwFDHFXn&_nc_oc=AdrXFhJOFlsln0zqSkPNhuwGI1gN7-rPC2nftJEPvDbN9JUhn0EFNUjI68sLHVL83eE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uJ-Po2c41MTC63pKVQg8CY3BSoNe4E6rPaRdFXJbaFQ&oe=69DF85B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLJvqY1Bi7cQ7kNvwG6Tzl5&_nc_oc=AdpELzvSjAfrjqeizkODk8qVQm4gARQ9ExtIX3szpO99nc3XeGz9Pf8krdTBZovWtIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J54JpAF9LZViGaSdfK0jQerv8oH7bIZIZpK3TLyj0_A&oe=69DF9EEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7HCegRiM6IQ7kNvwHs3gBn&_nc_oc=AdpD2MF8m1SbAtH5MUKDq20DZFzVrPvPadJdMHSVInrU_0C4PXXf6WGww4Q8z0TsLwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B8U8_NNtpGyjmKVFEJ6mxbLHMp4MDARdbJJy9iG8sAQ&oe=69DF88BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF6AdnYfatAQ7kNvwF2peoh&_nc_oc=Adq5YLkqOBRLTAZCsjqls2NmPUsVKPb1e5-MeEQ6jefZ5vbJn5YYB4m4g0ForalP9Yg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Hx0h8Lft5gbLf36dQcBMDBrAjgB94sehK_9rGDktTEA&oe=69DF8C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOwBCSmp8t8Q7kNvwFYT-fj&_nc_oc=AdrFHMLQoT7Wz4rOn8qSZHOb-EPgVPOoEOpLzeATCN-7twrHxQXjM4KecLK5jjzsfbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wvA3N_yDRjuVnDYOq5gaHAY2BqjdjT_1Kw6YtIjzfyw&oe=69DF98FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
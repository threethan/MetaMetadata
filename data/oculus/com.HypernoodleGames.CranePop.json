rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TEK03LSfXYQ7kNvwFqkZg0&_nc_oc=Adq6K6jT14mZVqupeFphDdbDNplmjPVbYI5HtD4xfDajXojFkJammjl7wUyc5wKZn6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwkycwawgM-HluOP18X7pAm_xndMdmYk8bT-GoXJlu6Q&oe=6A635BB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnhFftLnL7EQ7kNvwGJRCFM&_nc_oc=AdpeVHhfVhwMOIZltyjWx6RFNylUjEsWxCHq24WPxcn3Du0H6cMON0bOodxrtCfzSZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo5lwhWeTki0zxMpoLHhJGIUIAsGAcPOQckJtP--qchw&oe=6A6374EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKpEkX5OC3EQ7kNvwFPI44p&_nc_oc=AdrzqVk_HkKTlj3OKyMQm3Sq7WoTRGeOAjzUGR4GrXeqANvshl1QV2Yc0iYZtDJU5t4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGAo7ZMHX4uEsrkekucpIflyK8TbFsvGGWE411ZacMPg&oe=6A635EBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wi36STWalkQ7kNvwHAPC3D&_nc_oc=AdrnbvH_PG032F7EJ7r6k2bWlZm7CdYRjDniQfrYFCitsCCm8ytWhJgjctqS1l79ZEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyKVANIqXrO42OpqKm-qoFB7fmLefluyk2VM3GRQNWCw&oe=6A63621D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG1-9KWW-BEQ7kNvwGYCxcZ&_nc_oc=Adp9ZREh5UChnbdbvXjGti1t3-ZLNTgAHRoMotISZraDuGdDTTPMBvhJCFgzy1MwTJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBklDvGt6E47shP-0lERby1rHNiN7__QB2X5rXmqZ9TAw&oe=6A636EFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
ra3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21xZghDsahEQ7kNvwEOjfh1&_nc_oc=AdqGMxb73wP0CTX-b9yP6V6EiLXSso45rJroBIqICP2OMAkLxAlcOF1VT4SVgRm3Ur8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYh1Fw5VnZ1MVFnJKvazBO-zQhDTUQtiN0sAvi7WCjYA&oe=69C7CAB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB8GWy-P1ksQ7kNvwEl291s&_nc_oc=AdocA1wwg1Yg8r9TGX2XqndDPi25fVt2ZvxFOOs91a_hyoWxK4o2-uuqWEKb70KDfis&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx52zKKDqu3Ur9z12iSpWtGjLe7ZHWJhPb1eHBkRSToIQ&oe=69C7E3EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqIWL2xRCZEQ7kNvwEhaYRd&_nc_oc=Adqk2E_9cT27ScXu7YUMYaKAqvSXKcBsUDBTELnTMP8UHoVE_aPVi-naR638ZAZMSuM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzirugoKJc_I4XIulA6jkiu4vNYOQMcmxm7bWjPC-1GA&oe=69C7CDBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHyzq1qve1MQ7kNvwFu0IXS&_nc_oc=AdozM3lXPEe13ZDHBpBJGFDMZe_6rep3ihQtXoEGrnAYpQBxf-jARa3oJZzSSRxYivc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdhMzUiSQzxawsHH_AL7WWJATgO3RLL4KBnw5Pv8hYdA&oe=69C7D11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aDTrec9veoQ7kNvwH2037P&_nc_oc=AdpLrOK2uBvCUPZV4CosSLyVQkQBk5XkwLNBdJrBI_q_E9e0qQqoW1mwb0naprCXQZQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpffagiXw86HXzZRm-rXqXbdrV3ek8fFcGGLCojtZGrQ&oe=69C7DDFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
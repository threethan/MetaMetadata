ms2-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41jpeEm-ASkQ7kNvwEebIK1&_nc_oc=Adptlwea31Kd53U-WEygRo0CN2C1CuV4QIl1Ac7CuhYT0tZlOnZL0gxlvV_2t8Jpo0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FGzNLuYfroxb_MSssTp_f4vAazxuyhgKS3vKoJqnfrA&oe=69D256B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6_szgS6LsgQ7kNvwHRzPU3&_nc_oc=AdpCTdUVIqj02pvioSWJjqeebvhflhdy8YEFRZEwK-_N2-gYnzzXnw_Ja7xcE3HJqOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xWdYjEqdf4JIASlelUHGUWBZylwWGUidfnwkRZiwURw&oe=69D26FEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX5G6PKC-voQ7kNvwHP-8ha&_nc_oc=AdrZJ71IPQ4RxpESrI9YGmbIcyhrhLO9Lu4uSsR68RpouS2w94zkLO8PWCoADFf3fIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qxHc8TquMUhB4kDFuv3W9Nu720dvMCKRjWr8YPUfDGg&oe=69D259BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWX1NS6y664Q7kNvwFQ1pBE&_nc_oc=AdqY_9dO_-wYSs2BnGfwSTYRiFC1B9VmwwzCepsSSQ5zrwxus4IqFo_yF-b2GPfEmwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17PhMaXnhE4mxc2N9OQQIkdJYBy_3yRiH1h_oQFyH7og&oe=69D25D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v8foENnRSEQ7kNvwHrZeHJ&_nc_oc=AdquZCr8Smmf4J1mPF2ElScyBPTJAbXdlN9dDgvdmr1lJQhz2fKO09qlER-SctNz1hg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lT64fdIiFaoKb6QHTvg7TUcejBbcnUNwCH485mwek4A&oe=69D269FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
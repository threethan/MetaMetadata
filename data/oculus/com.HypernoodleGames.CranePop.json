ms2-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd8DHXkiE2oQ7kNvwEjH7Kv&_nc_oc=Adqm7cHEtv2lISvJzdEWqPho34gH0fv591lle2wf0vBK-ctGHRt9UCN44wUNxE0Tvrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af578TtYYVprR_NIz5eS09dSKMhDk2wYzbhgCWlwbmn5rw&oe=6A0B0739"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbEg3ItejJEQ7kNvwEJMmJp&_nc_oc=Adqn3qjJTt7mNOKaJ1ugvVEO8Snt4cTQ8DL_g6jLVy9ylguHePXaKiM8Bn16MTFUhVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BDTEAagjJsB66BV0FcKZ52lJUds23xYPAYvMledLv5g&oe=6A0B206B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWvlmMmKe2QQ7kNvwEmtjAh&_nc_oc=AdoDCHlrx8vKZc3LEaNoagYMp28e1HjSuehRLdmwqZzmwdXfUNquZzwJ7It5SmWZPuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SxP9RrqyfhJ4sc73V59GVaVXZuWAj0i8Xc3_99_KjCQ&oe=6A0B0A3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rdb6gKIewcQ7kNvwGtw662&_nc_oc=AdozbGSA3lUMT6o3VQogkH9tprFLus8_0cc5IY0FmNzNB3ru98JxzthZhhZHpT3Y4oA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I5y7xOOp1Hqs6p76zgE7NlgWdGyARJglVy62v7Ewcvg&oe=6A0B0D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoJS3oNHoHEQ7kNvwHhBWHA&_nc_oc=AdpQ1NOlGKji_FKeK-CO5w9iC_T-d7IGewz6zxIFh5PAqYwY0TTDNT9FRE3v647m85w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61uLq1SoZUeHQJ6mvoN1EfFRLiZJjyyrPaE1NXIXVf7A&oe=6A0B1A7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
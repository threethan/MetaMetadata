rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwzrxyJ6iTkQ7kNvwHGdd5C&_nc_oc=AdqVi_mbJC6-MXlIj9sem3TFrTY8uawrHy3pYgdI7nOqPkNUoRc0nTyRDtRhbl-fUdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w3DozUX198nSJKg8xHvWgDU6M7dFIs4BWlHm8O002eQ&oe=6A1D7C39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDvIf8OwIsAQ7kNvwHR789H&_nc_oc=AdpwZNDsinHF-xQ3dM0ea7TsCoopCQ11BE75-r3B1j5Urm43-fY4pyEUXeVapclDZ50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uy9VT6sUQ2rALdjlTYXirmQSUtIeBkl72aDnceiF3RQ&oe=6A1D956B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZlWqK9WE8oQ7kNvwF3c7S2&_nc_oc=AdrhRZI6GHoijlf51XilHqB6kNt6e0rjld0wX0p-tr9CC0xd_gK8y108e3qFaomPhiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dsF89hJFvT0vZg01NrUyQVP2e9HmBM6lxfDptqnFWlg&oe=6A1D7F3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUw63bKzPiEQ7kNvwFOeSSl&_nc_oc=Adqw0J-4LIyKoNNjbsrRsoTOIOaAr61PZfIla1V0rMVE2JwhoR92FUbGPj0CWniECq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QbvaxiBXayg7sSM1ioAoMgVO8p3wosmsgHSqvy3Hqqg&oe=6A1D829D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0MYCDle93IQ7kNvwFWNbOJ&_nc_oc=Adqs6FX5v1JdJZLCYrfKqDJTgFbbp3FOrWc0JZ2kyTB2ITTLuaBr2wUku27fA8laozQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vng37TLvimdBNIrOPJYOgRYK4A_n0xlXlMVJudAV32Q&oe=6A1D8F7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHXMPJDEx3oQ7kNvwFbc0Dh&_nc_oc=AdqVUYLeMdbRVjctDJhZ3OOlA11OLIR1jCOxHlab6krv5XRPSH4V5XpCf-gDMe_p0B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JlyB-TIwABhvA2_QK9vNAl48pAg9NKU6AXbS06Ftfzg&oe=69EB6339"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPBhlrRRpcgQ7kNvwETLezC&_nc_oc=Adp-sUsQYFI13VYMLXII37f0-bCe86iuox7vcx4kUVATtbahglS_l66uFXzJsIoO8MY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EBN39E0foR9xQXk4rG7RFOAtiPy5hPpoqCI09tqHj9w&oe=69EB7C6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYrNIcNpGj4Q7kNvwGfu38Y&_nc_oc=AdpvCLy4abRRJ7miF2E5YBqMoSYSj9yxxKjrki3cdxDIpg-l_6Aws3ZRZw2speJACHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yJSIqjGExym9pOMW8FX4GAMt_HB4z2kofiTIVUl6YDg&oe=69EB663C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YLTrfJ2VWwQ7kNvwGJnp6b&_nc_oc=Adqlp_3i0Gyfr8yJ91ckNzMY0RISH4plOTGksJiC3n2Z9UQToZD3F3lvFXKo-9l1mvk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1edCFb_evqPDBL4X3ium6-Hizxbl1OFLbAKDfqws_kvw&oe=69EB699D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5HNEv7QXR4Q7kNvwH6Mc-H&_nc_oc=Adp5L6f7F7d7lDji1VpzWGvVOfL8UT2Id2Vg3ukJHngUpI-yuHuA7wpCXVwLLCQTpEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WWp0ZVyDld9VzayEF8oA3DmdfuWz8I7gcYacpmohWKg&oe=69EB767A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
rd5-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuWGosDCAhAQ7kNvwGEz53q&_nc_oc=AdqcbSCxBJcyO_t1neL4vY3DvYvWsu9GHdVA30H87PVa9IwtZ9ohMXJFtdYekalqwEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I9_QrCRpAkQEhWfMFReCEC8HMNY1SCYNYMYDLeYo2dg&oe=6A1441B9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE2GlHHB2coQ7kNvwHNJtB9&_nc_oc=AdpqrQRlgPHUEXJ5NIVUJpgeASDjtP6o0FjU2_HS6MmK3pr2zVVqPTl_7MY9jSpnmdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SM40Cg1FWopkAifJTBH574VePvY-nEtudOrjZPZMiEw&oe=6A145AEB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHz91q1X3Y0Q7kNvwFCBZg1&_nc_oc=Adp_vzlkqqS8Xn-C3LKLiRFQHubVtAoFMPY8A35fi8pFj1373Tj8FnBJRCAhIy0R86s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64jLLyWJ5C8J00i8iYZl_9jQc7YnBxzok4ANy4777PvA&oe=6A1444BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VZGJZAtQEoQ7kNvwFil0sC&_nc_oc=AdrnZqonhOZQ7LtoPNY-VDgiOKB6KR3zSv4jtNuEZJE3yLD8Qug4JQert5jqzDv3vqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TdEyKVHsw7zhuI5ysA01xFeb93Mwq6G-4HyRGBHdvdQ&oe=6A14481D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjdmtn-BDKAQ7kNvwEE_Qqq&_nc_oc=Adopsowu2A5RirVqbbwFkWEST22csx_K7FlKqktnT4rK-51Pa4sfEYBPIn8xlEVPQOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FoCvwxq23QcbtpwqQF1wSbyd8YsXsIfGoeyBxj7F6cA&oe=6A1454FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
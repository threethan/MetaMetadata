fw5-2.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5yr_bwYgoYQ7kNvwFGhkLB&_nc_oc=AdoYQQymDtghD4Yx23jjBhCdY9WDY4vvivYCwWVVMZKroCmKc5WlTKlJt-61iQSIMF8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y7f9yEyyzTX8D5K7VtMadnQfHGDeN62JR2ItJGvxzBA&oe=6A0EFBB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CgbFGkDFHEQ7kNvwHhpXtb&_nc_oc=Adp3W65S7zQLe8NUEHHa7-CVLbuPwoIdUqRmoRuK6_3Fz67XgBFf6PjTaN3fLf67UBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EFMvQUms4mRwxd5QGGFEFeKYURONsC3pLEDotTqUBkw&oe=6A0F14EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On3A0UDmb8QQ7kNvwELqQ06&_nc_oc=AdoQ_S0GGV2op5ywjUVY0-v5ZCR_a7YLcsMIgnsygf_xyzhywsD6yPMTU78GN7s_bdE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40CbnTp2-zUZi1KWWYuKZXN3fnBzDvOUVTneIK5Iniug&oe=6A0EFEBC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQU4B8rRpgEQ7kNvwFIOzqH&_nc_oc=Adri4pY5OLLUrFcUz2Fjjhs_VUT6KImYPDk9u0ntmADw2mNaLFqZy2_ADRMzS9em84E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-ndOwmLmFRpPkwuGPAC35AiWc5UsUSULfzYjHs5MlIg&oe=6A0F021D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rtsbwx1eC4Q7kNvwEu_krk&_nc_oc=AdoLSFLNog2LzA5KgDUtZUtpiHcMjOejNAkSv8H28O0lllGTxOet8Mhg00T1hlj8pyk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KJekAl7ukScfEPEcXJbddcYDpCuodmyQTFzzPU1E0Fw&oe=6A0F0EFA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
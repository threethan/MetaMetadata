ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXA6Z9NOZLAQ7kNvwEx4Ve3&_nc_oc=AdreZ77qeIyklWAVDaj1VuBAuF3ETszpML0bBssPmCun65kYxh0CXgmZSPKtlSB3u3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEuUXfjHdvhz1tqtVip4ShCz-KNO_l9iyf4M11VxoOQg&oe=6A4F9539"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPGq4uLRQB0Q7kNvwG46pq-&_nc_oc=AdrurEHLhEG5sLPo1GO4aU4WYeHmWnr_e74AZidiHSiGTMJm8M1kzozAwmXkdx4gHDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs9e9Q7vmSmIgA1_uY5DqZf_KwYzJ1OHr2qRHL1lxrbA&oe=6A4FAE6B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSOFpOKmpIAQ7kNvwFbo7U3&_nc_oc=Adq2V5CkMIVls5Q0GNGTL7BWBfByU5yE7CPrFzJ2DhGG8uXt1k1tLCS8O7zKQQ2_waU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbaBWTcBKA_a0ciNCertIsZaiCZ2d-V_7zIeRws2JlcQ&oe=6A4F983C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf2dLk4_SZ8Q7kNvwGwi1IT&_nc_oc=AdqrCp_Twmc0F8K5w3lnmWH1u-92o5ITtP4II6-FuILTxmCMqsPhCrij78t9eBQIN38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTvNLrOB7J8J7w9cQyyrZKZrurZeC30gIv6a9PSDoPjw&oe=6A4F9B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZc8i66iyGAQ7kNvwGiUlDw&_nc_oc=AdrNMHpTYK1BK53SZkWQLB9T-fRd5CG9w88e8yNpRFW4c_FFtIm5tSEQiBiJhBNQJuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8UqNB78RoKLFkRap7PFXpCsYmDz3LNxZwPr_VYdG6wA&oe=6A4FA87A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
jc6-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TEK03LSfXYQ7kNvwEUf58A&_nc_oc=AdpJ3kWXM3oNZeUuzxiqUDYueIi9St-IJMIfFX7WDTeHsSJ-dF_vhs7HgLFRX6xwiFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmfMVqlwma0yxWkVP3AroyEj9dofJc8l2q4C0WDcYXlw&oe=6A620A39"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnhFftLnL7EQ7kNvwF9jmFM&_nc_oc=AdpKo8-c8Ne0A92K6fJF0mFRaqYGZeTd4cKGA-V8iC9_AkeUlq63qi5oznXdp1YNn50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3wJg_f3qt6cAIPCfN7BsfpQKwndK3BoyB-ckDH914yw&oe=6A62236B"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKpEkX5OC3EQ7kNvwFZnv25&_nc_oc=AdpLET1xrFeOhRQR0YOP63I2YuPGdq7rYMpDWpQItOgqLpjqN2MBj1W8xKx3Ifi82NE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASoddTDcIzd2AHvPvpYTknYe-uTDowntqVveSQ1Lk6tg&oe=6A620D3C"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wi36STWalkQ7kNvwHqR2EL&_nc_oc=AdrKVlkw8eU9KzKdDTwoSk_yjswAlguH6eXGepIcCkpEApJbo-a3SS6Hd41o9uhStU4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCywSLvLJiKSLHXVLmi6h9g3ZsXjYnRe83dQdj-1z2hQw&oe=6A62109D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG1-9KWW-BEQ7kNvwFMqSvh&_nc_oc=AdrMRpea80pbCnZHxKS_6P_eCNJqkhogLkM59qUbtA1X5OAQVTh_SAqpP9udmQmaFeg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIewZ0UAzQwxl7pCa_D2dUzU-jGI0bleJzvzTIBjtYCw&oe=6A621D7A"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
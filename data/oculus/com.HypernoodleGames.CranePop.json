ad3-1.oculuscdn.com/v/t64.5771-25/39035303_2024172197946497_1512612047972221905_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW8o0iGBIJoQ7kNvwGUG-Br&_nc_oc=AdpcZGfIZ_qOrNZ-GlXxQIrolZ53ZOUaeKN8enlYd52ZLHZpVWyS_nn8etcbLEJbXRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af786U9OUzeYRO5WIZ9-7ePVJ889Iy8-V4X344zIZOc_3A&oe=6A046FB9"}, {"file_name": "Menu_1.1.1.png", "id": "3209387409365064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630190_3209387412698397_7171114134697323853_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsL7bOz-vL8Q7kNvwHYL6F6&_nc_oc=AdrhLJvigfnTc0BFewXzmVnYuaIj7tUuQcXkga9PbAj4lrnylSRAgtNCyp7tPX_V_aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w-zhrEN74Kq4lSKkuF3LkEqA7rG0WXTjvsTJj68N-Yw&oe=6A0488EB"}, {"file_name": "SideView_1.1.3.png", "id": "1486738105216656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_1486738108549989_2800012866689650826_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_rocfLu-l0Q7kNvwEA9Fnv&_nc_oc=AdqBGXw0CCRxM7BV54k9uDhIj6wlAlZr77muZR4frJ7iDZj28y7aVSr3IBWw5E3qRZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xi-7ySHSMucvftH6NAoNrnewuOeZCbdJCSBbAAgTEvQ&oe=6A0472BC"}, {"file_name": "VeryFullBox_1.1.3.png", "id": "7019028088185721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411995_7019028091519054_2996925865049541052_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWTGRlBfX8kQ7kNvwEGs4QV&_nc_oc=AdoRwPbQ6CfYKHbNCyIExBXUL7OFSzBdUJh-tu01D0uGsh4cwa-HEbZOs7zT9EvA7sY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z_j7_VHQEb-0s3K5MrsJszhnoc0Wd8rQKbwfedllZ0Q&oe=6A04761D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_1.1.1.png", "id": "1069758007599612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269589_1069758010932945_7109376256242061612_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fR-Fuo3ugEQ7kNvwFD5015&_nc_oc=Adr2qi9SEzMTehBs9SDo2YeCA3tqrpJ7OWEwKEhqLU75pN5OHmE_4XgvRcZm56Q38Rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ApgOXOmh0fVRf_eUSApUKXUkNzGLBM6m8FWaCaN2-Xw&oe=6A0482FA"}, "display_name": "Crane Pop", "keywords": [], "long_description": "Crane pop takes the idea of a VR arcade game at its most literal, putting a crane game in the center of your play-space. But instead of getting your favorite toy out of the machine, you'll be stacking it full as you try to combine like plushies together and raise your score higher and higher. \nUse a virtual joystick to intuitively move a claw-machine's claw around, dropping plush birds into the box below to combine them with matching birds. The bigger the plushies, the more points you'll earn from combining them. \nLeaderboard support means you can compare your score to your friends as well as the rest of the world, and your own daily scoreboard is reset each day that you play.", "short_description": "Fill a claw machine with bigger and bigger plush birds, combine pairs into massive new plushies and go for the high score! But once anything falls out of the machine, it's game over."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypernoodlegames.com/crane-pop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypernoodle Games", "support_website_url": "https://www.hypernoodlegames.com/feedback", "website_url": "https://www.hypernoodlegames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
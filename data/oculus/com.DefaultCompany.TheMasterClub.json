318788212_7800440516992555787_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK5Qq1v1G_EQ7kNvwGrcIGm&_nc_oc=AdptD-494I_f1nn6p57EBtSbPNKahMb-75DdDco6cuL8fsc9TbjinhS1qLkwDDszNNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MHKe4n5O5d6__ZSeoN4JzrE5FJzeUzcPOg3kbxv-Fow&oe=69ECAA97"}, {"file_name": "ScreenShot12.png", "id": "258818093420653", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKYT7dhVyLAQ7kNvwHRtW12&_nc_oc=Adp3reLzKtsTPzv7nHXH-U3BxvzdF3cYGR8jmBTrjzeYTxaCoAnGXo9k9Lu6PZAeGws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jX3F6F6fzUwizft-uwmrKUU_g4jebXENd5YULdurqHw&oe=69ECA531"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGZHawV-m4IQ7kNvwE0jMW7&_nc_oc=AdqsygjdFqzoeVVhHes4t9RuCBdjs7VRnK3rKoB3dnzV5fvoeJWgvsSu_C-diGlaMZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QpEc2Bzn12YzEaaUI9fRjhsu3PZzyC7tyNkp9vDvdFg&oe=69ECBADB"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBfMOyIwcMAQ7kNvwFIovyu&_nc_oc=Adp4swDP94zE4qsV_Z6F_iJZtmfN8D2TJ3DHF3N8SoTCoxMsiKJ5VAtceGFrtw_mbmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sxfz-sD7AE2y--dATaC02OXLg5aKVVwpN79evsy95mQ&oe=69ECCC9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1Nwziy4FsIQ7kNvwE3UL9d&_nc_oc=AdrRfY2DhPVdKzhVRnvLfOq_kXq5Z1dN_9TZyrTyWkestYkP5Ja26CTHpmHZsLC5950&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qOFm5mW1G2LHpBau9SfIa-6Oyq8iU2vca5Ml_lRikWg&oe=69ECBAD4"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url"
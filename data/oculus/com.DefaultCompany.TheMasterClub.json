3n2K7GhjzmTEtQM7CUId-xiHK_y61XsU4I0DA&oe=69D24C97"}, {"file_name": "ScreenShot12.png", "id": "258818093420653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jfnLfwJSPAQ7kNvwEdKu42&_nc_oc=AdoQ4qM4UdmOwJ9FsmtTuxOvDOhkdsieHmPNFE74xlyqwsKVN7thQaptz23hO_WP-vU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wx1y8jdeM1hF69tGEIBIKjYQueU8zhcpHNZQck-ixGA&oe=69D24731"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDHRMgBjl9gQ7kNvwE8-VYA&_nc_oc=AdqvQETvSO90TfQsbZejl8lv9z6yXzRWJGnnH3eCICZmZKnedNXTDJB5I-UJ_ewvGmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wuxdu72GdBhqwpsXXETZDStsMnfhEo1GakQWppp7miA&oe=69D25CDB"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3RZkh6syNAQ7kNvwHFIR27&_nc_oc=AdoB3END8Uq4kkLOzsp2j3e_YgYUQ_g7k9mWn5EOyGmogdvgcHAN8s99NZmIU67-4iU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ld8qj32PoTlTwFcTTFCinkuYf3OEEb2DX6CH5JbinfA&oe=69D26E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKy3ycdvYAgQ7kNvwFUkU46&_nc_oc=AdompqO7ZTRk-eOVRieGOBn-S-WG7PjUkxlqZonR7KbxDJgQ9xNmy9wN7aJma24MECk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sp58ta1b8JrQKVnpjVl9dfd7c_UcizFEJQ13Q64a7ng&oe=69D25CD4"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-ar
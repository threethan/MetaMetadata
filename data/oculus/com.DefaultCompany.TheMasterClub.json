.com/v/t64.5771-25/39035413_1453475318788212_7800440516992555787_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvidrBQu7lMQ7kNvwHpbcV3&_nc_oc=Adq5fKtxe4aun_H3he3-Q_eVNu1etWa5UjdeMH3f3gnutmG55JdgWaMgsikUDoElNuU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00E3yuqqN5eKDars3wRh9zJb58I3_ejjIT9OeN4r8J2Q&oe=69F1F097"}, {"file_name": "ScreenShot12.png", "id": "258818093420653", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFQhZ9hlwsoQ7kNvwHfAPZc&_nc_oc=AdpfH5eg0X7BM66jaO8q2eLCVAiyY4MeYht8dQuS-8EUamHQ0a8NKh4CrifcnpBZvaI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0v_Ex4oOmU2rbw9jCI2aaojtltYXPFsUw6QZnFVeZUlA&oe=69F1EB31"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAQDSP81NEQ7kNvwHQvCEc&_nc_oc=AdoaoxH1wpNptq6P5sasbXitay64kzZgJk9XJPIiP_p4AmDRMqWGQe7JIkUnFHEZv-k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IuIxAQX9xBW6HpOUH8fvw1s2DyLjnPBIAJ1Kaop0Nig&oe=69F200DB"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-4hCODWWM0Q7kNvwGRWRZC&_nc_oc=AdpKRXd8FdsVmICZtQE_stRAAKo50BHw9zIPHrLoYRgkP69gVGKb7qy3Deb_k0G2VKY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0X1IZa88eEL7Rve_U90Guq7yfn1iKVB8YR1C8KJjcvXw&oe=69F2129E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X5K45FmCHoQ7kNvwF_3hOU&_nc_oc=AdpEw6Zlm9XWWepgkk2kRtgh7ukWRhpLG7gasrVjBacTOelaLLgfYIXi5B32Vq1F544&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HPq-bgL3VURDUSS2cPcq0vWdJnc6T-YV33r98CCfCag&oe=69F200D4"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url": "h
318788212_7800440516992555787_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI0e9EkwcsUQ7kNvwFezNUb&_nc_oc=Adp5nK3Wl8n2WoW850i0eGfhFS0q34XdYWqn-o9ezIJZ-9CmIc4Myq4a7AVz-v20UjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pWEKrm7pvD0VS9hbKGaRjDfXNwgF7lwwoG2bPh8Svig&oe=69E8B617"}, {"file_name": "ScreenShot12.png", "id": "258818093420653", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxtk47YW4oUQ7kNvwG91ETC&_nc_oc=AdpeVq0VJygE9cLPV0MZHT62Qn-nJ4CiSYW72XZmkwPGUuLGYQwig1GiW9Gmg0hKThk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3htAdmM0qHWR7Xm5UdL4IAr1Lfm8m78kspzszReNf3HA&oe=69E8B0B1"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baSeJPPtt0IQ7kNvwGFYXSX&_nc_oc=AdqWk9J-mmE4nbmlSmTfYVh2h_Zmvw7A2RjgEaTfvKg28rbQ3YouGPKQI6b8aGzCV6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27oawv-qh2Fy8_SNeSwcFdLk6wHpfAwqmTs_SeeOntCA&oe=69E8C65B"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUumJeh5v7kQ7kNvwHvTfpT&_nc_oc=Adq5c_Vk8OYIxgB0pD1HXFS2zxcktMtIGMfnjvujmwoRsPI7QyYFtQhVdATNC45eTG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24s7H-Iv9BeVKByAIq2dXeQqcbfN5Zvnk75JqpsNWMqA&oe=69E8D81E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCm49OBkDcoQ7kNvwEU-MRM&_nc_oc=AdolNbOqyIgmKdT8p5MZt2jIlHgntADKtLezSFetXED7ut3sRxT1x-sJ1TDdTz3dahE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E_TkKmuoJ70VYeNq0M2STI0V9Z5iXaUWQM87d9uoKlg&oe=69E8C654"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url"
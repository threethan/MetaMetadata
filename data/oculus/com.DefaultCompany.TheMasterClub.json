318788212_7800440516992555787_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK5Qq1v1G_EQ7kNvwETK825&_nc_oc=Ado1Khc-6jYtVXyx2lTT2UcK-VkM9n7w0WisjwMlinxi5tM2rbKq3tjBCaihfT3mWts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D_xwHjLYGJKqM0GblBX5FcTfgWScnBHx9f8SWhepEBw&oe=69EB5917"}, {"file_name": "ScreenShot12.png", "id": "258818093420653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxtk47YW4oUQ7kNvwE8oP6c&_nc_oc=AdqL3bJoINCTGYb8ZpT1N0aeQnDvh0YioGvuPkdIK-WlVo0t04AOKvtj6qW9w8n1UJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q17iDaZpLoZjSaObjdpUXUA5DuQ-O_M77ur4XU-w7-g&oe=69EB8BF1"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGZHawV-m4IQ7kNvwFEYRoe&_nc_oc=AdqzGajkby_HN9xos8lFi0WITD66FLHkp3PlOojzx7ItSp3DMdQ3WTi6KSr-GUYMxyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nr17P-U1LaN6U2YiA0lmicLOAG-CkJKDsUBO6L8N3eA&oe=69EB695B"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBfMOyIwcMAQ7kNvwGjSJeI&_nc_oc=AdqPx-XLZROtbWgmeV53pSMNK13W-vwNqy4ksb_ZA-VZR1oqTv4XVBOXXd75bhGA8EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i8C_jiOyEPEMtVUrNWvTfaZ2n1fEzHRHt2sNIol1-Sw&oe=69EB7B1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1Nwziy4FsIQ7kNvwHlZYJ1&_nc_oc=Ado9CoAG7Q2HYGKU1YjGHKFawuF6KD-2Xm5R5nQ64-BR40hyTui2hDoet5LvWWFymcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ykBiL81h79d8UT-ZlgeheT3Ta932iPq7IT-Zz9RVIAw&oe=69EB6954"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url"
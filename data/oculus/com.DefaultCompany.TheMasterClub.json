4.5771-25/38974622_258818096753986_467696596536903373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX1gdQUkwDQQ7kNvwG_mGY5&_nc_oc=AdkT8HCYfgqsb9XVPigr8AkAoi03bMZPSc5z-wUn80Dl3eTZQmaAA56JjfRJ9ueRAhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXH9uJxh_czMbxZs1ZPo__luD3rLe_TFEOB8b6JdMctw&oe=69B2A331"}, {"file_name": "ScreenShot8.png", "id": "1501206916950409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974791_1501206920283742_8492096938236551844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeyRswwuXZAQ7kNvwGARM_9&_nc_oc=AdkUeUzVMJo2p-ouoMpF4lmYXtEMPsB3Se154Ddz3gXWtXP690d1b4OpRHNyhWYCagg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuIougIdhSNjGnaQqgQ_x65UChO1GAW6EcQSSuQqQYLQ&oe=69B2B8DB"}, {"file_name": "ScreenShot4.png", "id": "251261660934237", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974466_251261664267570_1308644332253553952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tAOor7UHjEQ7kNvwF4sM_6&_nc_oc=AdlM-a_A5Ck_J5z-oYcfn7IRQejzb9c9fvoWZ-bqkgSm0yd1TpE46Jy6guaA6soW2ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPaFm-izhjBwgzsvi83uUTQ80Xvgsn-7JkKRcmTaAELA&oe=69B2CA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1674681809669861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974551_1674681813003194_2895250008313765539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f6OqSQuTZUQ7kNvwE0qSNB&_nc_oc=Adl6reuxxsVPvKHqyqtRdHzA7feh18EYbco33Yx9Yzp_ETNBnPnbNWEzr86qs3qIZ5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8-AHyvUevv991KUuJXga_gZIqXoTa0irOYV9rIIlkWQ&oe=69B2B8D4"}, "display_name": "The Master Club", "keywords": ["Chess", "Ludo", "Domino", "Checkers", "Rubiks"], "long_description": "Join the Discord community to find other players to play online with:\nhttps://discord.gg/W4KMzaqsas\n\nThe Master Club is a collection of casual games which includes:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nThis game contains the following features:\n- Single Player mode with 4 levels of difficulty (Easy, Medium, Hard, Master)\n- Multiplayer mode with an internal matchmaking system\n- 60 Achievements to unlock\n- Leaderboards to see your ranking compared to other players\n- Voice chat to talk with your opponent on multiplayer mode\n- Avatar selection\n\nThe game contains the following scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar\n\nWalk around the scenario using the Thumbstick buttons,\nmove up and down using the Thumbstick buttons,\nthis game uses snap turn to reduce potential motion sickness,\nChess game offers 4 different styles of pieces,\nCheckers game offers 2 different styles of pieces,\nPool game offers 3 different styles of tables,\nRubik's Cube 2x2 and 3x3 contain auto solver\nthat can be stopped at any moment.", "short_description": "Play:\n- Air Hockey\n- Archery\n- Basketball\n- Bowling\n- Checkers\n- Chess\n- Football Table\n- Mini Golf\n- Pool Billiard\n- Rubiks Cube 2x2\n- Rubiks Cube 3x3\n- Solitaire\n- Table Tennis\n- Tennis\n- Tic Tac Toe\n- Pistol shooting\n- Chinese Checkers\n- Ludo\n- Backgammon\n- Draw Domino\n\nOn 5 different scenarios:\n- Day Outdoor\n- Night Outdoor\n- Hotel\n- Room\n- Bar"}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
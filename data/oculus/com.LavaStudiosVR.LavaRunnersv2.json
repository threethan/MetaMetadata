GC3cDn7IlPY3w&oe=6AE89577"}, {"file_name": "Untitled design (10).png", "id": "1177011561263383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299808_1177011564596716_8790617921849682552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWDt6ayXDuEQ7kNvwHtnzPN&_nc_oc=AdoD8CE8UKpot_Gprc_xdshVDWwQQYDaQa0Sgf-W8L8YAnLKjz1enZ3uCkYO-wGDUk8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN61dMlUHlxk_7r9U-mybEILlh0PjCm-f-HB-DgGZkGA&oe=6AE89107"}, {"file_name": "Untitled design (14).png", "id": "2583128628754369", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296890_2583128632087702_288936135554570297_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYgFxi7UuWQQ7kNvwHDa3pl&_nc_oc=Adrxyn2M0fTW6YV77vXBq9grwAkgIAEi8VWgdAkyEXe61mPlgHj7AYH9KMJajBF3A3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZJenodfSEy0PWAZccOWVC_88xf0hoG_-r0xyElO3nQg&oe=6AE8AA34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LavaRunners", "keywords": ["Omnytag", "LavaRunners", "Gtagfangame"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to LavaRunners, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Features:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lava-runners/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LavaStudiosVR", "support_website_url": null, "website_url": "https://sites.google.com/view/lava-runners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26038004335800896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303198_1556731775348577_3852787437143690937_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahOYpFX0CPQQ7kNvwGSTwJG&_nc_oc=AdqLr1wcv7l6Djz4l6LID1I6eRDqxMwqiyhes7bUo7Tu8nlJ1rppsn8psoxA3Xxbsgw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss
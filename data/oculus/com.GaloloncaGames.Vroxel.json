/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DmQ5JXPLZMQ7kNvwFrIi5w&_nc_oc=Adob8L8VG3vXZAyfge_edEiytQ6qzYERTQSc3igxaCD8bT5sLdKWdeo8sE51KYamQyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-oyJJ37gdR8etO1TwOx1kzNZ8Zbwr3lM79V9Fx-BiVA&oe=6ACA69DE"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmgMy0L9I7kQ7kNvwGjtU5c&_nc_oc=AdqtusJNJnY796PFU5PNJUv1eUEybOa792ihwG0Ut_ItBO4KQL53PW77kahhVFeJ7pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4oZ1IsPqBW1YwJok4YhdssgFkq14FpEeFte-S33HnUQ&oe=6ACA58CC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsTSK1vL7D4Q7kNvwGzfdh3&_nc_oc=Adq_25ON6Jf7CVvTa6VJtrtJUPcl8t4Fei4m0NFOFcg_Ktnwi0lm4gJpc0KGkrQInFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdgBs3GbOg041jfBWdtoAQVIwHGq1Lu1vBJMI2I2lhug&oe=6ACA6260"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00mYemYJ20UQ7kNvwGMGBuJ&_nc_oc=AdodtBRXI5DDWT7U4xw-13vwfzw9CYmqZY_seu7aFm7F0BquvvOAHp2a5xBPQqLaZ0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa9nJQHCvUJuh5Ti3AXBDO8RpHZ5FFIx1-c3vyz2MIEA&oe=6ACA4313"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZ2n5RotZMQ7kNvwEo9Fg_&_nc_oc=AdrUdIw52UpZULd7wBxAYsQm2XswP4rnLIjBWV6VwX4Nofe_8BnGNb41YItsuUGASM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzhAeFjVhgwl3c-nNGl2nV51XWnu3aig_BbbZPTZ7NGw&oe=6ACA54D3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0fUFemSdF8Q7kNvwFb7JEE&_nc_oc=AdohiIl6iOpumBlMApm28sRONYDUWVR7EnrrxPQ9REbrbkXZIunwFbC6OsMxC-H3VIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5rFj4aF-HndI2o4SS22aZwoc2S1rO_K_w5W0vUc2DcQ&oe=6ACA630A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
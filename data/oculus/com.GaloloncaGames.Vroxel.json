/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=th-Qx2czoJwQ7kNvwFCKHx3&_nc_oc=AdocYsHPHM-MiC92TK9t7ptXEjx7__qFZKm9LGG1v0szN3NTp6OKEji_4dVWPv1y01Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_3kF1eH5Stkmsf5tq37vZWY58UOFtnPPxxA29FtMbEA&oe=6AE76ADE"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9gd8Dqt_gwQ7kNvwHErN-m&_nc_oc=Adq1VpFKGajQ_txoHAaIErmOUT0gmKWCTDaljEFmV5iqVJWHbShdEKRAW8OM1iUJiJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNQShLQ-sVconJ3GEihtjrroSDja6A2f4xEtFvIuBdJA&oe=6AE759CC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEflrZzBBCgQ7kNvwGDVjZt&_nc_oc=AdqIshnk_OTY9Ji9Ir6-9V5YW1pODFWBKdaXTtDsUtD94SHnSvki7ok_X_04OSqkCoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOYm5VjvtgRb1vVTmY_f2Lm_CA37v6qAV_uEvr6KDYgA&oe=6AE76360"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y5hfJNLLRkQ7kNvwFZXL2a&_nc_oc=Adrf3yVIM3KWGWhO5UUrAYs8spw445FPklcTmVDtuA6M8oCli4SKHup7egA-X_4lCTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8b7v9nhoqY6crhQMfiBgVKaMCmUr4iIbC9uFNX0DELg&oe=6AE74413"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMBCLmJ1rbkQ7kNvwFZMWoQ&_nc_oc=Adpj0W0r8bcGVkPSZIp-mw1FSWrAhZ4AfwAVjOU8kWGhMA_G2OXCxQFP6AaiD05n4gU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjXmUNlLDmVF_s838s4e2p6a2t-XwVb8Lu2raUK368TA&oe=6AE755D3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpeZ_V7MAUQQ7kNvwEayZcT&_nc_oc=AdqQj4_DEw7rzLZMm2FS73Ak3VbD1kBw9I0pmbNiZ7uLlXPN0OsMeIVf7GVxj6CRjNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSibn90FFnehJz38Or02mM0NK7RW_EZh6NspqyyVoEcXQ&oe=6AE7640A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
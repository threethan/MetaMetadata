/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXUq_RIgiVoQ7kNvwHF-wCP&_nc_oc=AdpxsXhSuPg3h873xCgBUZRDM7hOL2LqGfB89Advk38pKjUvn5UM3JwhZbioymPnE7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxHp6Q3ufYgTwEEK0vQBz7h2Ib5zedojrNLz74abeFIg&oe=6ACE5E5E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzDq-ew_3PAQ7kNvwG6HMNo&_nc_oc=Adpw5nQqjV1ltN7DLy56Mm5xi2w-gaM1HRLgI3ct4JsePX3BmuEmzLjFhVtw2uvX62k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLj3mKemC3WTkjLtDC60d7YdZVvW0aYwECXqom9eQPiA&oe=6ACE4D4C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pp3b6l1eyEQ7kNvwHk1Pax&_nc_oc=Ado_c0LVzucb1XRrSgbLlX6JvAhd426Nq6Of27bJCu07K8A4WVf3Q2c2sR5DzVS9feA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT3kxR-bNJeWSWSDM_IHwjhZMt0R_rlcLkZPqSMSJYjw&oe=6ACE56E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLFa62Rb2PQQ7kNvwFIwojL&_nc_oc=AdrakXbV7Nqylp7d7WbETb8pjOoIaHBscGp_E9s2Ow5Cnlg6gZdrMn9Q0sQfJaufqlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2UOs5Qofn1Y4mIEpty2nz6x7sW3s8CxBaqiKnM8AIbg&oe=6ACE3793"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISzm2lfY8ZoQ7kNvwGJH0BR&_nc_oc=Adqc7UWbif8S0iv1mOTxpM4ywbib-EliqdgpmosYFZ3JlDIN9sRMkqjexAD1ZxEQCzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOckDxwpABVjBVtwLekO2zQG4FjG9Zr6iJTzhs-R654jw&oe=6ACE4953"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrNSiH8CDQMQ7kNvwF-tO0W&_nc_oc=AdrBjaC4leB4FrkMdA7GwqF9tdupiwYDzdDsNiMZ_sxJqEbkZyU1iHMmzfH_XlchQBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMoGiRkdhlhZZkQEmtKw5B8YG9xrtGfnofEEars_NRQg&oe=6ACE578A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
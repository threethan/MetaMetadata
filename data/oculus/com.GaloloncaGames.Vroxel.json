/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm9mZoWZgRsQ7kNvwEotIE2&_nc_oc=AdqXoKuqfmkLK3ET3Elp6A0VILH2xMhxLonoav09zAG4xCoCejCWQs_yGCy3kKmULoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9MG6AoONbLZlCBB_yaBQOEPikbBL0He-8YyDaZYbxeA&oe=6AC3D25E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPWvoPfrz3cQ7kNvwFJ2Hxz&_nc_oc=AdqS9oplQDoRTrvn2WLkEd8u1yMDYc3NIVD4r1rpHbuAYVDWHXsCG7nIWiy3Uemqpg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDdt6faJJtZOn9sgc4o1GCHcVVBkW7bIfQqUIFgONkjw&oe=6AC3C14C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RzSDFo--NoQ7kNvwHE29R4&_nc_oc=AdqdMcUgFxTqDHS2_uSXeK4XY5GIxzs4cT4mbaHEPhkDFURVrC8UMGhHmLnGLozdPkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMplxLwzGZiYG7S7VWX7hZ22mZqJadG35txPygOx9AhmA&oe=6AC3CAE0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovvx9dNfVDQQ7kNvwFwUv4I&_nc_oc=AdpIFAk7cil6xLuYsMtMjuFenFVXUDiuzszZQT_WWU0foq8I_ReVPw_THMW0rAhhwHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXlI8ECHMGBrW9PjkodbnCHhcGI8DA9oV_iVghADuc3Q&oe=6AC3AB93"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVW10sanZ60Q7kNvwHJBnXH&_nc_oc=AdpXGo1XbgnJI83J0YjwAoMzRsW-Dff68JP17IR_EmkeaJBAjsCYj0Z0yG9e6SRh8bQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8diynY1DP_4RO3BpdjRyvSI1q8BA3ScT9ukVaToftOg&oe=6AC3BD53"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woA4ELi8n4MQ7kNvwFsEBmH&_nc_oc=Ado2oq6HEFGfOZchFT4j11elqhjkLny95mK8jB2Rc34lkba06SHKCJ9M-MC6pJhiLqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcBaKSd4aBvUGBnUFIk1xDAO8_qrd8sACTGoSIrqNNKQ&oe=6AC3CB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
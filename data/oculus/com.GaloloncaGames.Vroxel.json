/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fc47BepQVoQ7kNvwGfhSl5&_nc_oc=AdpfADrSGvNSnXLE6gcDKuvL98_3XHaj5IffnvLZ_Ot_mqDDJbkr9Q69K_zGVKQjYnE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3eEzT44Avd05LlbP7SttzbEur4yvbnL9mVh8vXo8SZQ&oe=6AC523DE"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8ApFM-nFp8Q7kNvwEkYSL0&_nc_oc=AdowtDDbG7BbmJgp9JwxJHpzzDe1T8jbYtxuWAhCp5QrMcJpsvYJu8bMbGTQoDA3TAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_2hv8KpSQJNpfUJVtl-s5cjVcGJNEeJ-5NXjtT8iStA&oe=6AC512CC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7arColiyq7YQ7kNvwF-DlWx&_nc_oc=AdqJXTbudCRbCiIP83F8Q8Xdc8-5LYV1A-JXFn5mFr4Bc0wAqlTy3w9a4XmsqgarnF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUJMJ781r-vbBsnsYhO3Ne6js1whnhRjNMSNAOwqpWLA&oe=6AC51C60"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep8jz3ucIlgQ7kNvwHuSh7q&_nc_oc=Ado6IYLNUtll-1KaXs0oHr232HQ13lS6Xv59VZ3xjexdZyXKH6r-slMB9aDjVgVbPGs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWcxdOL5_kZNfoPzIojeXVENd37askD0Xx0OBFur8JfQ&oe=6AC4FD13"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVW10sanZ60Q7kNvwE61GwA&_nc_oc=Ado00WzDHfjK4j8bnUoh4Rs2GaSNc00xwfCH1RhPsRQ2R59KitZjQRBfpo5IAyyVa90&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7Y6CdugNEQ5Sp7ziNFZtF-MFMmiRwJa9kp61zu93DCQ&oe=6AC50ED3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woA4ELi8n4MQ7kNvwEtT3v4&_nc_oc=AdpUkhCS2n9Q0G3Z_sqI3EVfL6I2Gmke3UK2r9HcRaKtQemPkzb29McK-mUmI1hTB4s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3AvB7ZKrIokSEzisloNXlyrNOe7XCf6_sro6H-BUduw&oe=6AC51D0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
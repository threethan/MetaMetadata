luscdn.com&_nc_ss=7f20f&oh=00_AQMXr0C2nUQn2VTJZGoyUp7D7xrtcYwDlGOS9m8d3lXedQ&oe=6AC8F193"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZ2n5RotZMQ7kNvwHiUOff&_nc_oc=AdqWhREOzvc_rN0Ei30VfIh245erlnnOXG8DqMnRo2SZkgeBaBODD5D1XkYRwn0Qnhw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsP-n5I2XVdcFSgptBEzwtKyuipcn0J_2yS_QNeZer0Q&oe=6AC90353"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0fUFemSdF8Q7kNvwF985mx&_nc_oc=AdpKs_iXGOIbaNYxnXPtJ81M9DXh5VPPLoS7mCFtEjjTdXcCvD7Dd1YlMcHhbIScHhk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5FJLgKQ8STBxzLKYwOqi2LBeY5v4gqrecytHUmlP3_g&oe=6AC9118A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4d66-b0ac-c60561a08458", "developer_terms_of_service_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4d66-b0ac-c60561a08458", "publisher_name": "Galolonca_Games", "support_website_url": null, "website_url": "https://www.youtube.com/@galolonca", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1316671971523715"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1093861716660421"}]}, "baseline_offer": {"id": "1093861716660421"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789592400, "status": "PUBLISHED", "id": "1093861716660421"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1321123147745264", "version": "1.0.5"}, "id": "929617150204964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binar
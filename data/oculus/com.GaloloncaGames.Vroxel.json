/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBZpDqQx9GgQ7kNvwEPGTDf&_nc_oc=AdoZ5kcDaHcMhGCklEWZHEnqGKC-MqDwdt1NHtwcdHyttaNK5jZ_ribgWwyOxtnQeT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNke2Fzpcq5lEC4T4-qsg1FZFHTBCrMV_vs406Fe6Z5A&oe=6AB90E1E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G11iMuoZ7zAQ7kNvwFD9bww&_nc_oc=AdpLeCby9_5N3ahl0D-e8r9Gni3j1AnlfTrpmeh7Lwt8Z5FjA9xrzQeFw_TmQgi4zaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZIXOovi2nWLoXvmH6FWvqmrf1vZuOdg1DLBu0UTzgew&oe=6AB9354C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvusyj6dXGAQ7kNvwG90zt2&_nc_oc=AdqYlM5UcxECgpEjqmIUXaXNFlbfOwNAUoTGloTeRIxg-2iF_aA43X_27j89pWG0bSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7xz3J-RHEK5iHBmXn6DtnRoL66HiVTpF0bLvlZ0pdRQ&oe=6AB93EE0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJl0mzw40XsQ7kNvwHeY3-M&_nc_oc=Adruh6f6ZVzg6lCkoFyQ59-LYqamZhQf_8eTonhCLx6lIJIZkymbFS4GPztDkqE8rRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Do9Gr7RO2hgC86e7dE8COpsqNyXkwzOga5XnbAwlpg&oe=6AB91F93"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceV4E-5aZjoQ7kNvwG7tEBr&_nc_oc=AdrrfLMCQHE4UDR2ZZll2-hlSIl8Kn7r4WLGjlTz0k3Oz4J7urN0ALhx5kHxrFecVXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOuEMdUl7Vb0thuIyruL7xG-_PnM-cuLmW4j60d-uWYw&oe=6AB93153"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COsvzjSaV_AQ7kNvwGIF0Rb&_nc_oc=AdpwMcKiLWH_S9p-ixNYJkaiX0AyhqHZIRHdgMHWL8xpY9yorLlHTq9Bryqi-TpSTPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkUo6t1qg6f94tmhB3_8FXKyWWIjPuYy68jqOFpoKCgw&oe=6AB93F8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
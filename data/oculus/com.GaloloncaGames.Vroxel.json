/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFLgFgN-zYgQ7kNvwHllzSK&_nc_oc=Adq_ZuYRhR9HiqRCi-OO6KmuijSwGjq7GCjpsS2Uq0PkAekgMzOGaylVGrBfIo8fh-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKZgTb9HqZp2yUeEMY9-ADdNYPP1sfnWoY-pL-uBCI9w&oe=6AB3C81E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0HNCmc6bMcQ7kNvwGbrCXB&_nc_oc=AdrUBz19ZvbKNCYf9IObNdEFdVMbBXDImOB21Sy1-N-4A12pqDGc23GDumEFNtReNJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5nUafv7tX75RYwaq996uoFOADFrvuJpX-UZGlYiVE0w&oe=6AB3EF4C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wzFODImgzQQ7kNvwFYKT7w&_nc_oc=AdoPJHVAuP4dV20OQMhhEFS8r_EYIjz4hRYStnpNX5FSevytGsDO3srcWBMK-rTW--o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqm6b0oSIPCsxIgZWasggvVt8J1fWh7lAAOZCfR2aNVQ&oe=6AB3F8E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNLR8HV2LTUQ7kNvwFy5S15&_nc_oc=AdqpUhueCDEJFTKUalmJDmMNesy8mBYULob_dR1V2MZ0SzoqU3SsA0vPnMX1_rsTEcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ92QxdX-OVwL56GBJJNv0kUmSsQUi74cXd1OBufi1i0Q&oe=6AB3D993"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HZJRTbZfgMQ7kNvwH_8dlE&_nc_oc=AdpLYwAakZCDmdudZTh67Y7YbSTiDyfQZPot6NIJpj26Lm6z8MbPQeKoG2slmrH7UNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII_WFGt0SLEYp8QHcVDcQ-GCdko5NcCWSjb3q3ppmf4A&oe=6AB3EB53"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Wq38lrI1AQ7kNvwGSVplm&_nc_oc=AdoFkFZNtH7giIIgzlg9qZkkxiu_YXNNkBAC-2uNI-Z0mUH2zYPZssRodZfwR7bDIFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvnskr8OGNTu2geeF-6e8I_My2e3zFaZNzMUurZVuuNg&oe=6AB3C14A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVCwg8dAEyAQ7kNvwHtVasP&_nc_oc=AdoWFesQ5C7sUXBIB-3dpBwoNOSHkaK7CD3PE9Y9LCfG3bG4kzheFJU99v3qdYDuuwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWzYcK1NH7mR7YBwliZ-q8_IA8zn8Q_teCHIh3yJXg5w&oe=6AEE025E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKjDqbpZX4wQ7kNvwET05A3&_nc_oc=AdoD4_PorJrV9jC_biyXBV1Ndu3lvZMoSy9DXII8LrKjbz0E9_7eEffpBLrhoFKYSio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD03RZHH0dMoM9EtScet5_JCgip2lLp2nbpqnZxhX4ig&oe=6AEDF14C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d6bl39wVKYQ7kNvwHYbNJ2&_nc_oc=AdqAiL0mURGf8D4TS0uaIArO7vh8GQh-G5orOMSXtjKOsW9KwJPT2frxAaG547AAymQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN-6ZDxu9PiqT9uQ-hDBpRSlKVUgk_ycQcARNxDXhf8w&oe=6AEDFAE0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=239Ce2xI8PYQ7kNvwG2fwaN&_nc_oc=AdqSV1P9SovmyOtmqH9S8edXYeGdK3jSfpAy7JX7IEMmGJTH3aF-xmjJyA99T1xmO7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkJIHP6If6eqb7QuQxXoqfO28psOeBgWNm205PrFTRqg&oe=6AEDDB93"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsA84o6WjWkQ7kNvwHCDX2s&_nc_oc=AdqVFnFZav4ESgJu3iqUafqR7d7cb3J-axNKOAj8EQFXpYSZR-6FaFnCCXKWpU3uPmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgICzdUUhkqrQfBwLEa_od5kPQT_dHFIGJPqkRhxzXHA&oe=6AEDED53"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUEbzaPyDHEQ7kNvwEyDSwP&_nc_oc=AdqsU4DuaxlK9GBfh7wBnG_cHr4_eRP9KdfNylidM6EjOxQ597OVXz8Z8nMTSYe6id4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUFlK_A2vDxSAL5hJ3dsuJmoopEdtoAYtwljgTDYkBxw&oe=6AEDFB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
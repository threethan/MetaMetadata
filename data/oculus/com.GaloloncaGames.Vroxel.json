/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGzyhZpg1-kQ7kNvwF1urmV&_nc_oc=Adr6lCvhAfJvFCfwtVqVcZpK-DbG1lvtAwP1_AxyFZ5kH9u4Vh3zZeZcyOEk8xMmUmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2f4alqEtxd-ezF2cY3HfOkyIbgdRoKjqAI2HIh1s4Qw&oe=6AF88E5E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7VT7jYAnq0Q7kNvwFqx_CE&_nc_oc=AdqQcSSoX3E5_mpnwc1rGD7Z8O9k463bkoH28EeIs4ZvPKM9OCkvQtWovP28oZpAYuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoJQk8Gxe9zXI8N8_TO9osw1Z7jEd4qZBFNZ3lX1o8fA&oe=6AF87D4C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjf1hu2MZc4Q7kNvwF8cxk-&_nc_oc=AdpKzfOdIRlteBHMfzalQX1TDHlj2OT1TC-pR_zop8yXm0EqRyHzTd7YtpWbWyXDYPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjAXux_j3Qv5TkdfxrlNenFeFc32uHqTByB1CpeOUDeg&oe=6AF886E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6l0ZvQCL_IQ7kNvwGw6USi&_nc_oc=Adodh9Y_a_s5hyE3jbMK8xg4HQPDSZiYuknKRBkpJZJOOvT7l7zntV6lem4ueT51064&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqqNgicjCa_yBJnWelCcqtYLyhdZOiCDf7jWQtkQgcFw&oe=6AF89FD3"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StvNxF7QsXYQ7kNvwG0cki_&_nc_oc=AdouoRlWS4JEBY1vaGYDghYTL_zouaUljAq5QdJFWX5ANyBNznnjIn5JJBSPQ6Z8gP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJs2T78vyGjvD-3vII729GZi-2t2Jbk1CKxMpdEqOrOA&oe=6AF87953"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-V9R7uVs8IQ7kNvwF1V2cK&_nc_oc=Adq_FfbWZ01lpbxI8o42R-Ccd_yRIjdqvmhFiZlCTkIv4ASeNewOc_43HNWYMWVW3Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9S98VOfqmBl9XMkPl6ktzaQM5i0jURGSQg6Gpf0HT0A&oe=6AF8878A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBZpDqQx9GgQ7kNvwFrPcwu&_nc_oc=AdrMeXCZ7QRw0PbjqS_hmqoUlD_iW_7CkI00bPZv4n3GuG75U2eaDaUbsesxhOiaNIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL18ktDLCQUSO6c1JncxmFAVn8TFoHmw5AYHuih2XkVSw&oe=6ABBB11E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G11iMuoZ7zAQ7kNvwEqkiyL&_nc_oc=AdoV_P84kX-U_FpfoG00-AMSzItir5WHnA0vp0sYSaxdzr8VciQgGg4fRT8GSG_nMTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRyosOW9lTFzuC93XQvBAEKkmup4ChSnxe62J-HerR3g&oe=6ABBD84C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvusyj6dXGAQ7kNvwHwqB0V&_nc_oc=AdrRPuVDvFu6dU8PB-XIo5sUKjnmqn6D7ln_l9C0PRBy_VfhV0HlClc4GDPwkjWMdlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX8vMHbm0y57kpAo93R5JjvKR79JFJbF8i5JsamqxCAw&oe=6ABBE1E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJl0mzw40XsQ7kNvwGBcWVk&_nc_oc=AdpXxd-UzgGz36lxeVThzauWgi5JpOSE1QoXyLzvq3AoTkMDwQwTFF_Mu8_WRByrPpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_6u5uMOC1WalS-klfop_EZvIdOn4BhqvzC49w0UPSTw&oe=6ABBC293"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF-tfdCShnwQ7kNvwEDu6Ml&_nc_oc=AdrUttgGBgDyxRdW5V2zfEgpyq_s327B-6U-GnnifyNkYb9TMpFtOAxVcYWIdGyWGVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXNWYD1G8XUN8JCPqRjzr30pNYxnVjKc_77l6hOnUVyw&oe=6ABBD453"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZEpZ6DdzhEQ7kNvwETy_7c&_nc_oc=Adq1402VzaUgtoIi6HlaZLuRZITy2n649XpQqOTuNysOnJCwKXczUrHRLhrS8I4Uh20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZzgYYeGlxBFlh0Spdt-zFaKPVPqKJGDcHZ0XqfXnjYg&oe=6ABBE28A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
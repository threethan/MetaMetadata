/scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35WKuAORg8IQ7kNvwGbP-kF&_nc_oc=AdqywuPMyuM-EinlES_r2dTfR-jjU1VEKqsgSVm9h1i6ywBkab_R1i3K_DnL5u8YcJc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrUZRds74HV7pTQ_LdFrEuns12isOmQSwTDdlRuahmSw&oe=6ADCA69E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV4ZRPtkgW0Q7kNvwGKuzkr&_nc_oc=AdqXNyFuTgY1VmaaZ-f6-c84J44ZUBw1--WUYlXp4EmmJdkyk-EZi8rBMQCu_lXKvd8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKWiaV_yxx8C6HV0PlcnALPmtTqrpnIMrI5S4NptaksA&oe=6ADCCDCC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6BWaNXsi3oQ7kNvwHBQqYZ&_nc_oc=AdpZ7uHBMBjbEjMZCMXvGVgatiY-WpMrAlLqdOxy0-YPMcOJ8UlHywd1gzyaHFD0HXk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXfDRMFJDgKPUmxGB39FvG09wc-3sibmVOC0T52oDVgQ&oe=6ADCD760"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G84zcJfAzr0Q7kNvwG1pXUP&_nc_oc=AdoGqzrrxEWOy_OK4a51dxEDGqchgdrUFhSruy2Imaoyi2X7G1lMvtKwLvkc1_THTnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKDbuDij7I6G0k6CNnBMRfVPGJ54-oaKxRN2yzjPDwbQ&oe=6ADCB813"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5S43ozHjoIQ7kNvwF6kMqm&_nc_oc=AdqC4QAK7Zu72SKdvP3JrtwyR46N4UCLm1sIxoImwdoRsQICM-6maXHxFpt5P-499UA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBbp4jmY8xoU4SozrsBcrge1Miyr3ePWG2Eth2j-Fvuw&oe=6ADCC9D3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm_5nklSGRwQ7kNvwEBJJEG&_nc_oc=AdqW_esSY4JdBseshwYs4j8BT8ozC-JhVOB95fo9JlSJk9t2ch57z8cWO0bQ388KPXM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJOjBw2QSuHIjbdMOD7WOYe0jxGKmVW8RZ_1zqnG8fnA&oe=6ADCD80A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
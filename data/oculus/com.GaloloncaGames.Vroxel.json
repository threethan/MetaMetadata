/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DmQ5JXPLZMQ7kNvwEsgPhK&_nc_oc=Ado13aV8eTUY04z2Ct21kK4ArHtfqLuJgbmrIijPSivdzk5Vg7CFqSzg5etrwb-_2m0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSNHMqkOAtc2Oei5xNfZoScBwynu9zwrj9yYsSdw0h_w&oe=6AC9185E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmgMy0L9I7kQ7kNvwGl1IDp&_nc_oc=AdrI2q88lI4A1GzXbJL5SXOcOsi3G9OjPV_wRduagEY0CFKzeUJRoWX-72v-y4Dg5Pk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZjxnc5HVq_e6YaWYqvKOfHzvWNAK4JpyiJQHcsA-hTw&oe=6AC9074C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsTSK1vL7D4Q7kNvwENWS59&_nc_oc=Ado8gZuXGpAyFWKKqG2vO9YYeqnpg7w1tlyl19b8qYlLeIr1UxW_H-xme0Rbi1yfSsY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyV9mSRmZX6gvAUpI1iPUfJEUASKnWSFWa2SILvkHxQw&oe=6AC910E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00mYemYJ20UQ7kNvwHnXWbg&_nc_oc=Adry5PLloatf-9TBr8CMkDLAQ3xJQaACL7I5azZeP6Q-Jmy3C_AP-70FwG86H3L46_0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXr0C2nUQn2VTJZGoyUp7D7xrtcYwDlGOS9m8d3lXedQ&oe=6AC8F193"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uZ2n5RotZMQ7kNvwHiUOff&_nc_oc=AdqWhREOzvc_rN0Ei30VfIh245erlnnOXG8DqMnRo2SZkgeBaBODD5D1XkYRwn0Qnhw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsP-n5I2XVdcFSgptBEzwtKyuipcn0J_2yS_QNeZer0Q&oe=6AC90353"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0fUFemSdF8Q7kNvwF985mx&_nc_oc=AdpKs_iXGOIbaNYxnXPtJ81M9DXh5VPPLoS7mCFtEjjTdXcCvD7Dd1YlMcHhbIScHhk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5FJLgKQ8STBxzLKYwOqi2LBeY5v4gqrecytHUmlP3_g&oe=6AC9118A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
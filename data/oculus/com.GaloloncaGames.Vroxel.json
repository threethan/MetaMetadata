/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6O_sLMUz2kQ7kNvwHQHmws&_nc_oc=Adr_MBsRTUuTYkRDGQGKTu5BaMV0qioTMi9oHAktTZFvfChDNQJ_KldCiTfZ9Dmq4qk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZYhvBTo3Gynfmmj1tdLceo6FFp3MBc23xdWlP8LKuHQ&oe=6ABE8C5E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-4EOGI2x_kQ7kNvwHI6goF&_nc_oc=AdrgLmUT3Xe_uHB9ixC5eGFqH3oisyFz-77i-0TWploKTR0ze8Fi2kQ3z6VQO2Y4NaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2T8pyE1Rjm1aPZBbk431H1bXMHAvfPtTbuCHrAWGzxQ&oe=6ABE7B4C"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p33i_Sc6EBwQ7kNvwGmMRx6&_nc_oc=AdouKnxa8-ZcZmsNc3EdOlq4zPzM0FURZ9JI-gXEZxW-1yM0nwBN5BWT64uOKptvQbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa38tOzctt9PJVGZpLOtkYSayNyLXeiKNYMRuiG5VjgA&oe=6ABE84E0"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCx727vAgYcQ7kNvwECWIOQ&_nc_oc=Adpob7SAEHQZASO5mg4S81wgOtFWX5ywHy41hnPZ-Z79qMuyzvihQ8iZGaMU4MBBkQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWrKlqLpqCIbwKXNrk1Aw8jyHmd3jnNsbQaCZv5FGYig&oe=6ABE6593"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SF-tfdCShnwQ7kNvwH7i45P&_nc_oc=AdqDhSwNUkINwHUdD8EZJyvnTrXqWtpb-3URk2uGoAaTvx0RcQR5W63AmOuVMW1HAZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiRMWqVM_KqEiFlK_sKXLlXWTs1WC9isF6fLzTlprvPQ&oe=6ABE7753"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZEpZ6DdzhEQ7kNvwH3MY3o&_nc_oc=AdpfKjnA4XUYjTZxaLWkfMF5kSb_T7eBPkcjS5Oo6tif87RSJpUeqNXRgvyOaqgMQEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIrAGSL92vUlzLaeWHlHve__0bzuvN4j7m42kTITmjlw&oe=6ABE858A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGj1H4VYeEsQ7kNvwE93MfR&_nc_oc=AdrGG22jBt81MIdDh9SeYkFM51sWJ-MLrvfuLf7y7Esa7_6aPKi34lwqlpCrhvIShKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQmcpKQrjt9_d0YvH32EPO5tKKWBsoBtFA9kEdVBkYXQ&oe=6AB5199E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mQrvjAYPewQ7kNvwEJ7_3j&_nc_oc=AdpHU_jk_dzfkyWq_ISJc4Fu643fGEkvXmsS8emfKCiwoofGP2YppPVT9ogxqfhidQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl4XAl1yc845vbsUpW9k-RwoRQ--qpZkDIc7Yq_x2kxg&oe=6AB540CC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5AiiVR4ndAQ7kNvwEttnQv&_nc_oc=AdqMoqV9ueBRlwXPD1xQnCwN578ZgW1Pu9zi7fDxUgqZw4Cn63khR7EXbV3FNmYwK3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6TVby9O7-hrutQA8uvPp_AksYa9LtQ5QoaZeefivDqg&oe=6AB54A60"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qjishxn7VwQ7kNvwFP1f8J&_nc_oc=AdpwmCKEJ-Aprj2TkevfUIMw6LsVOoZve_lVGMdcbaluUYXQtfC-X3i6L1cHPN7uCIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLapyMB_mA9VInC214LFy8klbkOggpg8VdtqdpdXdtuYA&oe=6AB52B13"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HZJRTbZfgMQ7kNvwEaGlpn&_nc_oc=AdryyuAPxFU1RbziDJVzd9uswNVOv0UfMXP5unikZbHpmEd4Ed3wNodaxHR5xEE8kzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOR3sR230oI_zid4oS7_WdWpYd6L3mzgXHRVTFF1Lvjw&oe=6AB53CD3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Wq38lrI1AQ7kNvwF6ruM3&_nc_oc=AdqijwN2hHC6yNQMEGAfoSuabLKBey6E_nkd8DBu_j3tfHmOFDOqXfawsIDU2udEF48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxiYplsdtsNB2Bf-pF_EvdZ3W9rSeeN05zvnrJHRiwkg&oe=6AB54B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827987_1010248855408282_1997211617262539395_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35WKuAORg8IQ7kNvwFSD7oA&_nc_oc=AdrNE8AKBwZ6TiKiC6wYlFo8zZTCA0AAr-Crg9AtfzqOPHFyYSBkiOOUafQ3owgVLl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU7AKbdoyqjdsh96YltyclbkAYUkQPxyo9ZQ25bqFahA&oe=6ADF499E"}]}, "id": "2193634237873130", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1082440211322643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1082440214655976_8356343421689882175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV4ZRPtkgW0Q7kNvwHa4nie&_nc_oc=AdpdUjjvcNEk8dsXLVoaHnBVhgGbxk1GCNgfQxMxQ0TKNbcgZX5Y6t4IgXb6FMgUHS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm1vK3_c9z4MGAswWYzHzTimsxPW5GyzK5x6SezSJSDQ&oe=6ADF70CC"}, {"file_name": "4.png", "id": "2328412614562203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2328412621228869_2728608472432197794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6BWaNXsi3oQ7kNvwGcknzQ&_nc_oc=AdpYTou5XlY8teZkLnr6iexL_VSdTeIMJQWkYpy0Lpb-v2VjwQjd0lWqZ0iaXBm_prw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNrMPCqzANTsNGyXzJJOfjBOYwTby9Z8qxoxdypnmDdw&oe=6ADF7A60"}, {"file_name": "5.png", "id": "928386303189163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_928386309855829_4181310895669016653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G84zcJfAzr0Q7kNvwG2bGj5&_nc_oc=Adq8F-rfbdWtyUi7xK9RXZZrwSW8BaRfP64eQ01YHb93gJW8s7iYBPe9loXWPQkZXgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFQRyPZztb7H6Yp3YQMXNVjIGhoSh6NTeikmE-6wI8gQ&oe=6ADF5B13"}, {"file_name": "1.png", "id": "1738911637157977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1738911640491310_8148733143007251625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB4NjyMLFsgQ7kNvwFUgytJ&_nc_oc=AdqQ0WEtqEChgX37YmoWXdpmmJyka5XXuu_83AV_vcW_CNAvN-aOcuLndBbDDL7I-U8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtdo3STd9YT787F45Mn6QeFnMGv6T_67SXUdGelEqb8A&oe=6ADF6CD3"}, {"file_name": "3.png", "id": "1657690232584447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1657690235917780_3092627237809417041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atqgwfodb8oQ7kNvwGJF0TE&_nc_oc=AdrcuSsdpohz5TM8Ce1wyGVVCWjawnKZbpSVOmk0S6OeETl3ZiW1KhHWPt_Y-C0fKSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_WaPxjBT5ugAQquxXb9n3UmvfHHBOSiQ9aA78EsOq0w&oe=6ADF7B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vroxel", "keywords": ["MagicaVoxel", "3dModels", "program", "blender", "voxels"], "long_description": "Vroxel: Your Universe in Every Cube\n\nIntroduction\nVroxel is an intuitive voxel modeling program built specifically for virtual reality. We have reimagined the process of creating digital art, making it as natural as sculpting with clay yet offering the limitless possibilities of the digital world. Vroxel breaks down the barriers between game design, 3D art, and architectural prototyping, giving users a unique creative experience in an immersive environment.\n\nCore Features\n\n1. Format Flexibility and Import\nVroxel speaks the language of modern 3D artists. You can freely import:\n\n.vox files (the native format of MagicaVoxel) for instant editing of existing voxel scenes.\n\n.obj files for working with polygonal models.\n\nBut the real highlight is the built\u2011in voxelization. Load any complex OBJ model, and Vroxel will convert it into an editable voxel structure. This allows you to combine high\u2011poly design with the charm of pixel (voxel) aesthetics.", "short_description": "Vroxel: VR voxel modeling. Import .obj/.vox, voxelize, multi-scene, free scale/res, real-time lighting, smart opt., intuitive UI."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c5f0f625-ada5-4
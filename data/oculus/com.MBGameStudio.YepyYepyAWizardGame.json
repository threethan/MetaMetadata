00&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6i9ERvfifEQ7kNvwG99L66&_nc_oc=AdpeOdxOPf5ahbVPeEaNc9hhHHEyoZvE_w8RSnE_rq0Suo1aiZuPaviYh3a_u1FDmW4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA5uEnMfkOi84mJtQSPU6K3x3R7Z78URa3PSnD9Dgdgw&oe=6B09C4E5"}, {"file_name": "Meta5.png", "id": "1121533723403739", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824700_1121533726737072_683561319480785542_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHzzvppBSUIQ7kNvwHjveAa&_nc_oc=AdqIA8xlXbozm7-9TgvDcNnI-pqhtfy3uUd0KiEbN1PDAYKqh15u25B5eBcIUjkB5Pc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUBupOiEzKlPCzY4Bgm7sWMqBh8yQdXY_49hw5m1ytdQ&oe=6B09CE6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YepyYepy - A Wizard Game", "keywords": ["yepyep", "wizard", "survival", "magic", "action"], "long_description": "YepyYepy \u2013 A Wizard Game \ud83e\uddd9\u200d\u2642\ufe0f\u2728\n\nMeet YepyYepy, a brave little wizard on a dangerous magical quest! In YepyYepy - A Wizard Game, you step into the robe of YepyYepy and explore mysterious dungeons filled with dark magic, hidden secrets, and terrifying enemies. You have to grab your wand, and shoot your way through with magic and spells! You are the wizhard YepyYepy!\n\n\ud83d\uddfa\ufe0f Semi-Open World Exploration\nTravel through interconnected dungeons and magical areas where every path may hide treasure, traps, or powerful enemies.\n\n\ud83d\udc80 Fight Evil Skeleton Monsters\nThe dungeons are overrun by cursed skeletons and dark creatures. Use your wand to shoot magical attacks, blast enemies, and clear each dungeon to survive.\n\n\u2694\ufe0f Cast Powerful Magic\nMaster magical abilities, unleash spells, and use your wizard wand to defeat enemies standing in YepyYepy\u2019s way.\n\n\u2694\ufe0f Hardcore Dungeon Crawler Gameplay\nDanger lurks everywhere. With limited health, every fight matters. Dodge attacks, aim carefully, and survive the intense battles deep inside the dungeon.\n\n\ud83d\udd0d Discover Secrets & Hidden Areas\nExplore every corner to find hidden rooms for health potions.\n\nEnter the dungeon, defeat the skeleton army, and prove that YepyYepy is the wizard brave enough to conquer the darkness.", "short_description": "Meet YepyYepy, a brave little wizard on a dangerous magical quest! In YepyYepy - A Wizard Game, you step into the robe of YepyYepy and explore mysterious dungeons filled with dark magic, hidden secrets, and terrifying enemies. You have to grab your wand, and shoot your way through with magic and spells!"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25795648303465293"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "946312241647189"}, {"status": "PUBLISHED", "id": "2216086275986631"}, {"status": "PUBLISHED", "id": "1323271059616582"}, {"status": "PUBLISHED", "id": "850368964690878"}]}, "baseline_offer": {"id": "850368964690878"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "s
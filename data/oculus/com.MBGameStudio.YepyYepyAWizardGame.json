NvwH3KmMo&_nc_oc=AdpBcIQrsR_N7TwWiRWmX-2m5Qwn9Y1kQZq73VQOpsT6x2nN_7QV8So6K4PHcg6UfNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9vFh1KL9VNhoSrH1F9CaYitPN3OvKqC6IM0g2WyrvNg&oe=6AAAA0A5"}, {"file_name": "Meta5.png", "id": "1121533723403739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1121533726737072_683561319480785542_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7Pg1YNTXz0Q7kNvwHiQW1p&_nc_oc=AdrvY-reI2f8WG4IRQKt2jxQ-VL8flnQIMJhY6uEmb6EkXx2hZGsTnyUnGVJBoGYcR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZgh6EV6KpvU7pxV7764bz4MlBOUnFptWz8z0ujczuIg&oe=6AAAAA2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YepyYepy - A Wizard Game", "keywords": ["yepyep", "wizard", "survival", "magic", "action"], "long_description": "YepyYepy \u2013 A Wizard Game \ud83e\uddd9\u200d\u2642\ufe0f\u2728\n\nMeet YepyYepy, a brave little wizard on a dangerous magical quest! In YepyYepy - A Wizard Game, you step into the robe of YepyYepy and explore mysterious dungeons filled with dark magic, hidden secrets, and terrifying enemies. Don't forget to say YepYep, Yepy Yepy or YapYap while you shoot! You have to grab your wand, and shoot your way through with magic and spells! You are the wizhard YepyYepy!\n\n\ud83d\uddfa\ufe0f Semi-Open World Exploration\nTravel through interconnected dungeons and magical areas where every path may hide treasure, traps, or powerful enemies.\n\n\ud83d\udc80 Fight Evil Skeleton Monsters\nThe dungeons are overrun by cursed skeletons and dark creatures. Use your wand to shoot magical attacks, blast enemies, and clear each dungeon to survive.\n\n\u2694\ufe0f Cast Powerful Magic\nMaster magical abilities, unleash spells, and use your wizard wand to defeat enemies standing in YepyYepy\u2019s way.\n\n\u2694\ufe0f Hardcore Dungeon Crawler Gameplay\nDanger lurks everywhere. With limited health, every fight matters. Dodge attacks, aim carefully, and survive the intense battles deep inside the dungeon.\n\n\ud83d\udd0d Discover Secrets & Hidden Areas\nExplore every corner to find hidden rooms for health potions.\n\nEnter the dungeon, defeat the skeleton army, and prove that YepyYepy is the wizard brave enough to conquer the darkness.", "short_description": "Meet YepyYepy, a brave little wizard on a dangerous magical quest! In YepyYepy - A Wizard Game, you step into the robe of YepyYepy and explore mysterious dungeons filled with dark magic, hidden secrets, and terrifying enemies. You have to grab your wand say yapyap, and shoot your way through with magic and spells!"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25844705491892907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827096_903277449111830_3993772226931741582_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx_2agrPqvQQ7kNvwEgWDtY&_nc_oc=AdqhVsgmHJpwptSdKGq8ju9y-x7yFbtTzjDm8hehTpIxeveJIGoC8sj_7pruHl43YMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISo
a&_nc_ohc=ab8ZPQIsg5sQ7kNvwFULrQv&_nc_oc=AdqsfD6WpHdTxN2rVEaj8eX5pssmi-Wyec8urgmnzBaKYQvqpiRAFQndpnjxb2rbgXw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-gSW_JvIoREjVkiF_wEwXwq4dkfNWiH8mNNZWEFA1nQ&oe=6AE1F55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "2491152488000345", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_2491152491333678_4872525017770918862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnP5mjIpPi8Q7kNvwFj1Q17&_nc_oc=AdqkxFoHHUxbDU_sa-yhtfq0NgEDGMkT1f2QRZ0r-hk9evGp2P-acprkI9WRM95h5u0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSX_pEbUYIBxkP8e7Sb-UgNA5KJBeaD5uWfKX0m7Vf2A&oe=6AE1F73F"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "
a&_nc_ohc=9U6HVcOU0F4Q7kNvwGmCUKe&_nc_oc=Adrg3GUKhx7cmpNY6lqgBumYHWPE01ANjaMAbI0TOTPXvF783bEI5WvwZklUyz3esPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwKA2sKfecTtUz0VTqFK4hUwDAOUOUL14PDcKY62vvsQ&oe=6AB916DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "2491152488000345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_2491152491333678_4872525017770918862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rictlX2h8yMQ7kNvwF4lzHD&_nc_oc=Adqt37XQ7F80boYXX2adwjdV8ituvNyB9P6Lq3iVim9ksgoeH6ciBZqK5pvut3lm7b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxKNXhBmzTmIxfCdpP2j1_zSBh2GGSJe674fqHtV0S1w&oe=6AB918BF"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "
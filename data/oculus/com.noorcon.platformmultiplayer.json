a&_nc_ohc=Adgv-OCxUsIQ7kNvwF8NbDo&_nc_oc=Adp_sAuA5a351YUdmWqQh6aOKzSjZdaq7tzMRSK-A_hCfa5EtUGxR2NNhdV9q2ZXn34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlsYSorMH2MgHfkWDlFyZQLUNCwgFc6MMlXThzg2Ot4A&oe=6AA6A1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "2491152488000345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_2491152491333678_4872525017770918862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6fmrNVc6sMQ7kNvwH4iFmT&_nc_oc=AdoSVLbOlvS64MTgI3V6SZ0I0QKfJ57Q_q0gPom8odcaNqYKGg35_4fOUlhR-q9ePCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxQkepOxM887mJ00_xF-TqprAusr8EyQRD3zGm3SgJJQ&oe=6AA6A3BF"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "
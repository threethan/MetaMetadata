HPS6WKjaSKAj3lbc05e42gO5Km_eRZy7jBZ7NOY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHWTFdyQEFi-exIaeNZygcTJV1XQ6l8BPg8uG38dgdQA&oe=6B1053FF"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "https://www.noorcon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
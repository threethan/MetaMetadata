combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "https://www.noorcon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "27345369411809862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312039_4387874991499144_2362686194155541706_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdQwcha_drEQ7kNvwGd_7AQ&_nc_oc=AdoNSRbLry0pC2B6pAXrGQFxyNd4hYtQs_
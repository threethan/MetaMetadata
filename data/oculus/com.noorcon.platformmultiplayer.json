a&_nc_ohc=-2VXxsNB7IIQ7kNvwHJUc7u&_nc_oc=Adrd8lzdd9lpcyXO9PN8QGwT4RdLgbN7I_dmZa8fcEkUbAvg3UN5MR9eV29wW9RkyqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg3rqNX5nFgZkq-5Gvwu63OJCRCjuOSUy2fSCA22uN0A&oe=6AC0FFDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "2491152488000345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_2491152491333678_4872525017770918862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yfm-nXeBpSMQ7kNvwErvl5c&_nc_oc=AdoObYdqkZXh6iGqLXtsfFIM7B1mTKzwV1PbeBZUoB-T-D09dT1_5OinI6_Epl_pTgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPEsREao6UD7zz7VpeNP_C21Jnp1HWEg693CcjLVL0-g&oe=6AC101BF"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "
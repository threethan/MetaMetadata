a&_nc_ohc=SNEs3P4C7rgQ7kNvwHZoD8g&_nc_oc=AdoaPc2IFra24dk3F6Pygtu1vdzKx5xd3xWPcESgnhQPR_JjYqqgjOjvdkVYkX2be_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK68-GxRNVYB3jDY4zrJWA9KiJ-cZ7w-LK2z6gGyR9FZA&oe=6AAFDC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "2491152488000345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_2491152491333678_4872525017770918862_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWg-izLf1dIQ7kNvwHtcYNZ&_nc_oc=AdpKwflaiwBGYadcQ0WSkDU76jt7aVD8noKS0lfxk0lbB_9s7ko4RDdvGXO60SEDF34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVBzLx3RPAJuhHdaHJOxUvpCqXI3VwafPMU6qKEHCo2A&oe=6AAFDE3F"}, "display_name": "Nucleus XR Training Platform", "keywords": ["enterprise", "xr", "training"], "long_description": "Nucleus XR is an enterprise-grade extended reality (XR) training platform designed to help organizations deploy, manage, and scale immersive training experiences with confidence. Built for industries where safety, precision, and consistency matter, Nucleus XR combines powerful content management, real-time analytics, and flexible deployment into a single, cohesive system.\n\n{746010898003861}\n\nWhether used for workforce onboarding, compliance training, operational simulations, or advanced skill development, Nucleus XR transforms how teams learn\u2014making training more engaging, measurable, and scalable than traditional methods.\n\n", "short_description": "Nucleus XR is a centralized training ecosystem that connects XR applications, users, devices, and data under one platform. Instead of managing isolated VR apps or standalone simulations, organizations use Nucleus XR as the control center for their immersive training programs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.noorcon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Noorcon Inc.", "support_website_url": null, "website_url": "
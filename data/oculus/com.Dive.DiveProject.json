ch company focused on VR, AR and Mixed Reality solutions. Our mission is to expand the human experience and solve problems in an innovative and efficient way. In which world do you want to dive?", "short_description": "DIVE realities is an open access room created to connect people and offer dynamic 3D elements and real-time voice communication. It includes a collection of interactive objects and interfaces, and also the chinese cultural experience \u201cChengyu\u201d, an info-game about these traditional Chinese idiomatic expressions. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.diverealities.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DIVE Realities", "support_website_url": null, "website_url": "https://www.diverealities.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "794372235156963"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1150005639273438"}]}, "baseline_offer": {"id": "1150005639273438"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668203820, "status": "PUBLISHED", "id": "1150005639273438"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9780167628675018", "version": "1.13"}, "id": "1215531089007168", "channel_name": "LIVE"}]}, "is_for_oc
9720702850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569452_643409724036183_9196644312400353990_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjXINpscZx4Q7kNvwFDQSp5&_nc_oc=Adp4Y8ODn8OYTrb2fXvG9y8CycFcj8YnJAJvHccCiLgl1u-czWNKKnwtfYHkhx4WtEE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx99rm0tTGmuAfvRYizmI84pLU2PK_96hpaA1-pqEq8g&oe=6B084680"}, "display_name": "Dive Realities", "keywords": [], "long_description": "The new metaverse project DIVE realities is the first multiplayer PC/VR/PCVR platform developed by DIVE, a brazilian tech company focused on VR, AR and Mixed Reality solutions. Our mission is to expand the human experience and solve problems in an innovative and efficient way. In which world do you want to dive?", "short_description": "DIVE realities is an open access room created to connect people and offer dynamic 3D elements and real-time voice communication. It includes a collection of interactive objects and interfaces, and also the chinese cultural experience \u201cChengyu\u201d, an info-game about these traditional Chinese idiomatic expressions. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.diverealities.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DIVE Realities", "support_website_url": null, "website_url": "https://www.diverealities.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDI
hc=F5du7aRkaGAQ7kNvwGQUdS2&_nc_oc=AdoWKTCnUslh4e_ZfTrtPDx9iQcZjnJXN-1kEiWCPf7KFab1pFFdTC5IoRjOScoaXcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkYk5KBltcF2Wb9GZOOuVoqQ36u1Ht4waSrM8Z5_d1ag&oe=6B03133C"}, {"file_name": "task_screen_2560x1440.png", "id": "689437976139383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974780_689437979472716_1043640606162263721_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVU1kZ0KyioQ7kNvwEcldlE&_nc_oc=AdqM45WgqCoN9x1lSgBEN-OGeGjWQ5rszhF780ytUTib1uKgQTGNt8qbOBMI9b0xfgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo43E1ZSpVuqpYJAZI1tnwkwYYH6zzl-YLCtpUtOLUXg&oe=6B03035E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dsvr2_feature_2560x1440.png", "id": "8416629548408336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001732_8416629555075002_469901930314515976_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pen3zr17D1kQ7kNvwGv7n5g&_nc_oc=AdpiAusUJC9-fMWSzT9CvjJBnUDdLsXZxOIMHkEab2-SiI1hBaFjbmHuriq1WoDVcJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQypL3Mur8ZV57rLb8oBkh7xaeo6gcgBoeyQIH4bCWq2A&oe=6B030271"}, "display_name": "Dear Santa VR", "keywords": [], "long_description": "Be Santa\u2019s VR assistant and help him to make Christmas presents for everyone! All the elves have fled and left an awful mess!\nSanta has a large number of letters for Christmas piled up \u2014 help him collect gifts to fulfill all requests. Not everything is always in its place in his workshop, and sometimes you\u2019ll have to look under the table or sofa. The most inquisitive players will be able to find his secret caches! Look for toys and their parts everywhere! Improve your skills and abilities, and more complex tasks with new details and instructions will become available to you.\n\nDear Santa VR is a spatial puzzle game in which you have to find matching pieces among a lot of other interesting things. Put them together to make a toy!\n\nFeatures:\n- An interactive virtual reality experience that focuses on attention, imagination, and skill.\n- Easy to understand \u2014 suitable for people of different ages!\n- A combination of 3D hidden object and 3D puzzle game mechanics!\n- A variety of toys, from simple to highly complex!\n- Use your hands to assemble and connect!\n- Keep your eyes open to find the hidden parts of the toys!\nChristmas magic is here!", "short_description": "Dear Santa VR is a spatial puzzle game in which you have to find matching pieces among a lot of other interesting things. Put them together to make a toy!\n\nFeatures:\n- An interactive virtual reality experience that focuses on attention, imagination, and skill.\n- Easy to understand\u2014suitable for people of all ages!\n- A combination of 3D hidden object and 3D puzzle game mechanics!\n- A variety of toys, from simple to highly complex!\n- Use your hands to assemble and connect!\nChristmas magic is here!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/37491139", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/37491139", "publisher_name": "Alice Games FZE", "support_website_url": null, "website_url": "https://alicegamesfze.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_trackin
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdvZ7uGeWh519mkuoqjtCqipnOsyk3oESDD0vErRwS-g&oe=6AFC8BD4"}, {"file_name": "Image Sequence_016_0000.png", "id": "2151810265702866", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824665_2151810269036199_5135521245329551457_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR4AqtRszfoQ7kNvwF6NiVK&_nc_oc=AdpfgPkUOB5uQ4nmNTgK5WPrPc39f4MOi1sA48TCpYT-BOKJBdRSLnhanlaB0G2lUnM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0r_SYAGI_DHo_SV79sCO_xeYTVSWeDNewT1jpUgblZg&oe=6AFC7AD3"}, {"file_name": "Image Sequence_012_0000.png", "id": "2163842117594527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_2163842120927860_3543128302502585504_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCcxIsx0hucQ7kNvwH3FtFr&_nc_oc=AdrmHS7AJj_izW_1tiQVKovsr7i6gyoVGLMI8tEPXKREvuQiXE9FbTo6iT6pPl9694Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6kaY8ky-V4sosOZ1TfJgJyAAbB1ZTEmSj7q3g8cFj6w&oe=6AFC8C2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "683289467513429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819980_683289470846762_4341270081475047694_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMpgMT3d5PsQ7kNvwFn2--0&_nc_oc=AdrSlJ3mqYIf-DDDmawERPgrmRcIRjjInWxfRk-LKPFsjyRoaPh7ovNv01XItYXElfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQve6bmA5RwyYF24YK-E0Gur3SwulWsh-0fIQFKiFGQBA&oe=6AFC8012"}, "display_name": "Opic3D: Spatial Video & VR social", "keywords": ["spatialvideos", "immersivemedia", "socialapp", "shortvideos"], "long_description": "**Step into the future of immersive content with Opic3D**\u2014the ultimate spatial media platform built for VR. Connect with friends, creators, and communities and explore a vast library of stereoscopic 3D videos. Capture and share your world using Opic3D's tools and hardware designed for spatial storytelling. Fully optimized for Meta Quest, Opic3D supports VR, AR, and MR headsets alongside smartphones and desktops.\n\n**Key Features:**\n- Upload stereoscopic 3D videos and photos\n- View content on a virtual TV\n- Enhanced media tools for creators\n- Cross-platform access (VR, mobile, desktop)\n- Added Mixed Reality / Passthrough mode\n\nDownload Opic3D now and experience content that lives around you\u2014not just in front of you.", "short_description": "Opic3D is the world\u2019s first immersive 3D social platform built for Meta Quest. Whether you\u2019re a creator, viewer, or brand, Opic3D delivers a deeply engaging way to interact through spatial content. Capture your world, enhance it with AI-powered tools, and experience it in true depth\u2014only with Opic3D."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/67988903", "developer_terms_of_service_url": "https://app.opic3d.com/terms-and-conditions", "publisher_name": "OPIC Technologies", "support_website_url": "https://app.opic3d.com/contact-us", "website_url": "https://app.opic3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28961275273481184"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619704_1915502809011038_31646769361
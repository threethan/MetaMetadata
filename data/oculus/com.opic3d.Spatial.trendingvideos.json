oc=Adoux45PfGx1JySnLMsvY3_eT_2xAiWyKidabj5ghUTb8q8qIzxBDTwA7GUvc06ZJp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf03pK6FCsp1u49R36mA0_oG_jFneD83ngGb4S0DU9ig&oe=6AFB2EC3"}, {"file_name": "4b387da7f04d48d5949e45dd0277f614.png", "id": "777463518351141", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499625088_777463521684474_4560656274785738474_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IzLJrzi1c8Q7kNvwE1kVG9&_nc_oc=Ado24rNEMLk9ElkczUI9wwmtdt2APN3fTZO72OcBGVPcsmie8SnM49lWcKO6sdulXSw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6XjWhBCQtZ0yPK5snc_8WEPubxkLl7JnYQ2DPUGFGug&oe=6AFB3C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_image.png", "id": "683289467513429", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_683289470846762_4341270081475047694_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMpgMT3d5PsQ7kNvwFGE6wX&_nc_oc=AdoY04t66Yhp6DZKgYz_2u3L9sReKV-KzxQZw6xxwew4Ha-BSeeDjYpjrrUYo8tvkXU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNcYp2xpLzDhr36mDtV7qD-aKJOEXI2vtIsIglNsx91g&oe=6AFB2E92"}, "display_name": "Opic3D: Spatial Video & VR social", "keywords": ["spatialvideos", "immersivemedia", "socialapp", "shortvideos"], "long_description": "**Step into the future of immersive content with Opic3D**\u2014the ultimate spatial media platform built for VR. Connect with friends, creators, and communities and explore a vast library of stereoscopic 3D videos. Capture and share your world using Opic3D's tools and hardware designed for spatial storytelling. Fully optimized for Meta Quest, Opic3D supports VR, AR, and MR headsets alongside smartphones and desktops.\n\n**Key Features:**\n- Upload stereoscopic 3D videos and photos\n- View content on a virtual TV\n- Enhanced media tools for creators\n- Cross-platform access (VR, mobile, desktop)\n- Added Mixed Reality / Passthrough mode\n\nDownload Opic3D now and experience content that lives around you\u2014not just in front of you.", "short_description": "Opic3D is the world\u2019s first immersive 3D social platform built for Meta Quest. Whether you\u2019re a creator, viewer, or brand, Opic3D delivers a deeply engaging way to interact through spatial content. Capture your world, enhance it with AI-powered tools, and experience it in true depth\u2014only with Opic3D."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/67988903", "developer_terms_of_service_url": "https://app.opic3d.com/terms-and-conditions", "publisher_name": "OPIC Technologies", "support_website_url": "https://app.opic3d.com/contact-us", "website_url": "https://app.opic3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25049032938038790"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1396753808836288"}]}, "baseline_offer": {"id": "1396753808836288"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764592920, "status": "PUBLISHED", "id": "1396753808836288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28913316874943691", "version": "1"}, "id": "1973004396872296", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only":
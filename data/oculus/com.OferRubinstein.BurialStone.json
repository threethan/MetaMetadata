10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3YUFGDOAyUQ7kNvwHuorz2&_nc_oc=AdpMKFV9ltZG5qMSAATH615MaEQ4udmqr-uyR-ezgNGEVxw_RmrPXVNz6kBAE2YjVFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF21HlcSLlqCxP-FH-GuJj2GzA4i4uS0cczmkRhKCb8w&oe=6A8458F3"}, "display_name": "Burial Stone", "keywords": [], "long_description": "Delve into a damp dark dungeon, with your torch as your only light source, in Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game.\n\nThere is a sense of horror to these dungeons with some surprises along the way. Tread carefully.", "short_description": "Delve into a damp dark dungeon, with your torch as your only light source, in Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\n\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://burialstone.computerrpg.com/BurialStone/privacy-policy-burial-stone/", "developer_terms_of_service_url": null, "publisher_name": "Ofer Rubinstein", "support_website_url": null, "website_url": "https://burialstone.computerrpg.com/BurialStone/burial-stone/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
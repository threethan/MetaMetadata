10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v46nyQX7bcoQ7kNvwF1Wyjt&_nc_oc=AdpbTjAzCtMMrmR6F98Ar1f7V8fbZwOZZ4f0bPTA8_xQ67eS0MKHqqw7jdmCfGYid60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zo832WZYEOeiYLWQtwqaCSG8NlPbkabfbWX3lPLfylw&oe=69EB6AF3"}, "display_name": "Burial Stone", "keywords": [], "long_description": "Delve into a damp dark dungeon, with your torch as your only light source, in Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game.\n\nThere is a sense of horror to these dungeons with some surprises along the way. Tread carefully.", "short_description": "Delve into a damp dark dungeon, with your torch as your only light source, in Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\n\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://burialstone.computerrpg.com/BurialStone/privacy-policy-burial-stone/", "developer_terms_of_service_url": null, "publisher_name": "Ofer Rubinstein", "support_website_url": null, "website_url": "https://burialstone.computerrpg.com/BurialStone/burial-stone/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
_ohc=m6hCBDrX0EQQ7kNvwEl8Gnj&_nc_oc=Adq14JXjA5xxT7XcfITyhIX37wM_DW7NEq1MV3U3uCe2QNB7IzSrZsC4ZeYLcKqWbtc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJU57AAptYMvE2WKdNT9d9uXB8XR2WLhXpUohLjG1LzQ&oe=6AFB27AE"}, {"file_name": "04-damage.png", "id": "1085634784355914", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604375581_1085634787689247_4857923908202376665_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v6xMSDaWgoQ7kNvwFYOvRu&_nc_oc=Adq5CcHc7vPJhCs8RxswyMSX30X96CF_MA205EKWEAxoh-VwaW1TW6uofiSO7TORRV8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAzNBUImmBAqxmhwwvD4IiU9lKunaYbjqbaeSgwYcicg&oe=6AFB3B1A"}, {"file_name": "01-lunge.png", "id": "1254181000213632", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/585799753_1254181003546965_8381334479256650760_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq7dr1W3XlkQ7kNvwHIMHkA&_nc_oc=AdrjYB0ZqvbFMbi1UOqjugodl12imcf08BXlreTPLZRo2eEmOGpUHZzdelHHJA5zT7o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcGsqyTG1tYakfJg8UV4dymC3ZOtdBIMPrKGxGrNZx6Q&oe=6AFB2C44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shark Game", "keywords": [], "long_description": "Your headlights reach only so far. Your sonar has picked up something enormous.\n\nShark Game is a single-player VR underwater survival game. Pilot a small submarine through dark water filled with fish, jellyfish, drifting kelp, towering rocks, and coral. Watch your instruments and prepare for the next contact.\n\nA colossal shark can approach from any direction. Sometimes it charges. Sometimes it drifts out of the darkness and waits just beyond your lights. Fire torpedoes to fight back, but wounded sharks become faster and more dangerous.\n\nEvery successful attack changes your situation. Your windshield cracks, propulsion slows, and lights begin to fail. When your submarine is disabled, a red emergency beacon and hand flashlight are all you have left. Exit into the water and use your welding torch to restore the hull. A repair display tracks total progress and time remaining.\n\nLearn piloting, combat, swimming, and repair with the replayable introductory briefing, then face the deep.\n\nContains threatening shark attacks, animal violence, and blood effects.", "short_description": "Pilot a submarine through dark waters, fight a colossal shark, and venture outside to repair your only shelter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/partonfox5-hub/futureMusic/blob/codex/shark-promo-safe-area/public/shark-game/privacy/README.md", "developer_terms_of_service_url": "https://futuremusic.online/terms", "publisher_name": "Future Music Online", "support_website_url": "https://futuremusic.online/contact", "website_url": "https://futuremusic.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1436606146196940"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831964_1790851462118617_6372531211905614143_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKj84VsuUbUQ7kNvwHPFbeJ&_nc_oc=Adrg4TqdEz6dKLkGzeDtmZGJcY2FHRAQ2CC6b1xx5OZusSuGfHAAIisVLPZHtUaBzto&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_69h
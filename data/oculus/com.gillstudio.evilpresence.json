674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLBHsC6QYG8Q7kNvwHjPnRW&_nc_oc=AdrhIEXQ3TzmENYAa27AFMwZcJbL7IPMpQj55NRF3_nM06RAOMWnDu9N5PHtnuD4B8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFizxobhpSrzrfv0MMw92-bTECOuuXX1zVJrZ9Xs0z-rg&oe=6A734959"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GwHctah63YQ7kNvwHvUaZc&_nc_oc=AdoBGccj20ppxPXkaSZej5YEtCJfRiepjmeqKnAXaBD84SWYcI_mcoHKsdKDT-VMI34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzpI-I3TecLr-Hw9WTfHFr95fjEntinEWnBD2OmplcHA&oe=6A735216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLd89Jg0ajcQ7kNvwEGP59-&_nc_oc=AdoR3rbsiFAkdF_HJByt7SWHUkxXjwZdNmfaXQL2fT6KzStkk1hykg4QkVOLBzoqEbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeGq-Szm46dnprMzoXkLKfWNjSrTvb7x5NtVMf5i4yFA&oe=6A734E31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
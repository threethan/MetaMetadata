674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE3NTbiIGqMQ7kNvwG9mcak&_nc_oc=Adq-oZ9zt70UUdx55cSi2-RmPb0HZsEBvPgxcGi2o88M0cL0fgbzkBwSIuCL62EVh98&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IUfl4j2-LUEwpzAiEaB-LYGrrg1as4Dcd5-fCVOBmVQ&oe=6A300CD9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4gPINaFrwoQ7kNvwFYGRHi&_nc_oc=AdqfugUaVKhRLgUQnAyvkGTXay8tGEI1uZNt8eJbMU_FmJYzi0z0tzdNQWccub3O1MI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aueODxvyepVfHtlFRbETjhptUADbdZRKBaOrDwfuv2A&oe=6A301596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ1GWOpL26sQ7kNvwErbAJg&_nc_oc=Adq9vsBt1b74IdPbF-8vj43PChMWgqpZrAG48TTtDO8TdIx3ZA94Vkz5nym4zvXq-IE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nUVV_0OpbsUz0_Cx_9CUlrYuNmHRjMODj2exicMzytQ&oe=6A3011B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
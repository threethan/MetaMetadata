674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE2YbCttr4cQ7kNvwEIPIN2&_nc_oc=Ado_JR92GFJJnsqOhTpbutkt2H3cltfyhOrH7vLdsfeFOHTMuk4CvZzaV5n66lHIaT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16ZAN39MWpk_EiglBASVplkX-gwCfchOmi0svw3V3HHQ&oe=69EE21D9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JU9zNzcZj1UQ7kNvwF990Ln&_nc_oc=AdpfGr3SF2rFYTo2DRqvBHFREkrOmAwsbs6i2a_FvOBkMaPyeZvHaU7rflLRFmdEPr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FjsM8jsaZ4OJ--hCoiVfzaa8_A2J0N0e87Fedq4gepA&oe=69EDF256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usY9B383UOMQ7kNvwG3Dyy0&_nc_oc=AdqOT1AWPypp5vc_wCCyvhAKTQ8xokQBFBtiTvwpXXG9nIHbbH0FzFipxW7ojxwf24E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IW7dqNU4IFY3vc4Wxn5s31R_s9_SKVGJoLyb0QWnpIQ&oe=69EE26B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
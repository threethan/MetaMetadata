674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfamt3a9D0wQ7kNvwFBcFJT&_nc_oc=AdrK7PqCt19w8rIt08eY__1fn7OEIpZlGDXwXqi-O9BBgLiUV2dmxj5FrJWgjC4eGbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfqYfrhzsX1GBZwbLmT5IKVyhj7uDkBgvG_y62Xh0ebg&oe=6AAAA859"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wknv0sCXIcwQ7kNvwG4TRpe&_nc_oc=AdqsSIlSapZXc5LGlQkYiH8mRCYYurWlHE8UMtK88sUGimY49Aygmv06Ds63PYQE7og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHtJZkON_k1xOZaZ1124-CYT3xE25qxZwq5HoDJ4o6mg&oe=6AAAB116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LR0jok_a66AQ7kNvwHIrMCu&_nc_oc=Adq80ylZN1jHRLJ2Ns-WOajrCkjTs-eabPomMYJPV_wlRc3_RiPy8wFVHiBCG593MYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxb7J8uoqtxpTDuA0BFQScyuJs89U9_bzhZO_N_AF0eg&oe=6AAAAD31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
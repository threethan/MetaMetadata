674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xtpIsTngN0Q7kNvwHA_l_v&_nc_oc=Adrxr0Id6jb103CKGK5K2KUdmhP-0agzWizgbjz7z9JrfPA6Oc5eP7vDxZwZIqSEZYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnK5MqdW70V-j0b2mt3i872bCs01L-kXakkHocUiz5NQ&oe=6AF087D9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJknSZknTCQQ7kNvwE9a_6u&_nc_oc=AdqZ-OcTTnTegLhGU_LyFTVyglIMzwIWdjdEtnFabQgbX94Lii2pFtChQrK_QDYtkXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO8GP_4Y5G0w6mQICEeDq6jU_InH6MrjUhjuqKa_-nPw&oe=6AF09096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40Lvr8qKZvUQ7kNvwGZCeq7&_nc_oc=Adr00FKa_LWcb-voxqlYykh8p5L1WdER4eq18HS1UxP1KihEXvONJkCInC-9naXsjsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZBWO-WrfKWUOivSv3D8_TTfS0c9LK599xEZF3JEarJw&oe=6AF08CB1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
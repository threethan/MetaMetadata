674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeEaqp0gGIkQ7kNvwFWEM71&_nc_oc=AdqJhhevoplysDiMDHuu7xXQlJXQMpRxbkfM-SaVxaNGPf_Lge_957fuOcdiqANRVYE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53VNO_pD01bvZnf1SJx2l5XeAX1Xllto4wo3JOqkfvFg&oe=6A1C4659"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiBQjvOAZvoQ7kNvwEY7vIU&_nc_oc=AdrYJKUbEccA2oauFH3_MroD2dRl-hVp-g_rUXH5vCVZG_gTLTeFBfVkesiqp1XqeFU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vQBtRURJG68OIzayl4_hNSYhg-rqj3e49N6uGmoQzQg&oe=6A1C4F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUv4BVkoDXgQ7kNvwGz7Nn-&_nc_oc=Adr4qinr7pKOEpFqaQtjFvX1QF6q_V0VOY8cFiv63ekUC5woCHiaU_2uIB0c8BwiG44&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5th66ksCXoif8NhVbHp5W_RbQyhl5Re5ahkENmeNvOxg&oe=6A1C4B31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9rtMNx-vksQ7kNvwGpQblm&_nc_oc=AdpJcbxc_wpSmgFZu8iRUAU0WLdxKGJs8SXM0EK1HxMS9WaJjAS87LN0WGboeo6yLDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfGK-OibAagDyUjWai52Hwqwd0AVil5pQ2f8wlVkw-LQ&oe=69C937D9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We_y8ehzi60Q7kNvwHLRZt2&_nc_oc=Adrf5L7d6__xv4pjXvXdpa-c4pJYlWBWzcC7CRu1fWPq25vdDH-4KQZOGh_h__FmI6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSzxLYj5PqFNr5lH54Dwtiq4UtQGx0tK8pZ2yGvOgR0A&oe=69C90856"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgzPDciiiUwQ7kNvwHf0gtj&_nc_oc=Adpv57qOggU3RZD29nKSnmvHfUFunhMXQ-vwE2mdyCm9Waqii7ZBQobn9QnO8gYNxQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY0fj_8b_JiibRSDvSf6kR_2FrMIwpD9bFvrSQ_PaBPQ&oe=69C90471"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
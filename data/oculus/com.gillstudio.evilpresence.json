674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFZeivLhgJkQ7kNvwHHrh2z&_nc_oc=AdoKiR7i61dr2_bvSkTRSUwXGPyzt18zJePDvh9qTu52FPTBf0-PssDt2pDeKbKkEy4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJVwroUAptGUp76txKA_DK5A1UjenVzgECkBKe0bNXMQ&oe=6A9D7959"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LyPtl0mTgAQ7kNvwFl_ziL&_nc_oc=AdrfDqoGWjz-08xbdFV0lP1IxgBlhOey4tI7VMMOEK-EWYSKJLW2bk5t3KJsFcc2PWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB2ydMS4YFgZVP98BJzR4kOkAYoQufUm0eyyWo2dSgeQ&oe=6A9D8216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIEjhMj6pKoQ7kNvwED-crV&_nc_oc=AdrHXL_At-J9LD7lCXah3LfVM24a6aeFjWGpFBA0ePmrDK9DGtugXuJFBc4joxoviCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyT6DKz7p_xQgwWfiK63SRarw_0PF7OOrkw3Ac0jGsDQ&oe=6A9D7E31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
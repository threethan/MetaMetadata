674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM_QhhCon38Q7kNvwEUeemr&_nc_oc=AdqLRYYnu2CMsV_F9uUPGWdNalsQ9dAWUVCuIWyXuonPRg-7SjHbewgMmO-wIH-j6Zk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRTJXnRIUz50qyNMpU4hYopASsfJHap823Kh4PJAl-8A&oe=6AEC9359"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_mx5PMdK7IQ7kNvwHkEq58&_nc_oc=Adp2aOOMnBmeUfNTueNDpnKfgPN_MPJMTWfEkQJ9ZdJniu9FiZ5Hivo1ttduTzfCgO4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX7BHSTzAtU5Dle1hO8RT4wi8AcTVVSt9vniiM8gniig&oe=6AEC9C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNwXDPpff1EQ7kNvwHJLn46&_nc_oc=Ado1nVhG-anHYGeJ_RWnUD4hcUE0N5fSyRfbH3jHCJ7S8YQ7iJKVna2WQqqaROs_gD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3hYX6UyUCfXdZj_1wnu9e2uK3ddXuBoni9dZYpj32iA&oe=6AEC9831"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
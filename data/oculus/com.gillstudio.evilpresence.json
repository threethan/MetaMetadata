674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MKsPjZqxdUQ7kNvwELMXeO&_nc_oc=AdpF5TRaxvo98ZHMQmnPtJKx6FzjCtFIFzFmk1vMY2syO8juzVDM18IwBLpObi3kMRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbWsmpxlARhXpd3wUww_bFTtg_dXL6HzZe0uTNp9JomA&oe=6ADF6459"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN8GUXHRdE8Q7kNvwEsEJA1&_nc_oc=AdpEFPtWchd3ui-w3X8L2hPIod_T9ecOR3Kc8Tg0mEttYwUU4KBCvsNK33ZobFkQFuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMKmz6DrfENuXKXJ3usiww0IAgndTnrcr8wF2Ro90LSQ&oe=6ADF6D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4CUzpfqCIQ7kNvwGr6HZB&_nc_oc=AdoWZJMf9QiwoK26H5je1n4gqhiSpRkNp-bDJp3S2g6P6_-VH0GW_cWNACGignRvXDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdrFFa2JIbpEQdQ5FPpPQN4DaAXgHns4VlCatQtk-szw&oe=6ADF6931"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeEaqp0gGIkQ7kNvwENq5hd&_nc_oc=AdrPb1mn5lMP-ycKf8Q_T1gu5Iy_-lF44OcTaBn1VVsQ8Yix9yjx3_7yuFCAfBDjxDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ji9XeUgjCvqoQrRUJaAmlNc1G2lBhmLSTKtFt0b6gVA&oe=6A1EE959"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wvC0spty8wQ7kNvwFHf82S&_nc_oc=AdrBcCIc2ZHqiF4FxNC8JNIbQFjwckTrRPB9WlgYOxRWqP-AKGbiYMTXE5xaahc4Y3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YanV5uBHniHFakXWpdaj7dkedaDGR6HJeauU6sl5hqg&oe=6A1EF216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Iac66c1yEQ7kNvwES5qLP&_nc_oc=AdrC-IAXWga0P3IbBG6iP1RXSPn2JpFJrJX7ThXr22UZyCSzK1vgUrhO2X4U-fFT5Vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lEOVehWUyuEDl1axF4lwV-2xBPKFcjzyqfrUhXUP44A&oe=6A1EEE31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
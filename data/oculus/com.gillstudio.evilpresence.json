674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE3NTbiIGqMQ7kNvwHOsSRw&_nc_oc=Adorto6E77DZJwcy_0OaLMWJ3Icn4DYBV0ST7ZSU-wHaRSWOTsxgKi8GJjwvV0RlKPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AYYZ8wyPufPvHDBCE3gqkOB59drm5ZjvP9jfAGTAGEA&oe=6A315E59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4gPINaFrwoQ7kNvwHEVo1Q&_nc_oc=Adp6F5Zf9ra8DODeJkQEaVLeDYj1yLx7UTRXupTWjGnHVNMJQvbFiBwSQoTKF12E9B4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1jNYLbwdYTUc0fJbfVl2RubneUVmH81iDUKOJe5NIDQ&oe=6A316716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99JeE3kpAIEQ7kNvwGhawP7&_nc_oc=Adryx9IQQftocXGSJU-myHoaKrxybI-Az7k3JxFCUxL9ul8W46gfTneSqo_0AGA3Pek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tTBKDRuJ57Tr80qcparUeZ0OrhJf-TYvgRLEbPtOEkw&oe=6A316331"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
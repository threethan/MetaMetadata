674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5pGSfGHWIsQ7kNvwHDc00g&_nc_oc=AdqTI46lYRu4JnRduQHak68j2_dQkZAcGA2yf2R4nqAfRKME3EGW3bxq_w9TYavyV1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BiJJFY0uRUcwkfdYZX7xLuHzvJP2tqVqPXeOqPOTt7w&oe=6A3E8D59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPrSODqRMlwQ7kNvwGXV-t-&_nc_oc=Adp6sg78_rQEao0jWLwJfVgXH0izhOnm4i-u2MNSh-pKcqgTPAp-MUDIHRmeT_A6CAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OTKVQrFVudMl4AisbMN4hb3eD3TISaOmRf8V2_tv_Jw&oe=6A3E9616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWbtauqC7KUQ7kNvwEzbHIm&_nc_oc=AdoPAyYcau-7cHKOkhOeHaN3PpbwChXt6defBY5q8XcOaXpfWmdw3vAUDbTg2KxHZIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PxHRZY6eL72G0R_9CyWvTIPY7UQeXwsZ4WsP60ugfIw&oe=6A3E9231"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
/11162730_1451674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEU74_thqzUQ7kNvwERVf9c&_nc_oc=AdpRlBkRiimBPBT2zDWAcPThR_t3z-lwfLMrzqyhwLGfMRbACqNUq352L-nbYB9ncJ0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zorsZa9YpKAzhw-ha4ZRzkrhgQQ4VTBVZMrF45jIZ0A&oe=6A36A459"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_baYnkYuq0Q7kNvwEaExUZ&_nc_oc=AdrzduyqLRDPqYTJA6Xq4Si-VQP8xFhyGv4eVap8uCQ-s0uw20d5kYQwX1JGOdJHux0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hDZ6eumwTjRDdZq-xGsXy5j8-I1Inf_6BhgWIQsrgKQ&oe=6A36AD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiRVvEKIAecQ7kNvwEIEBEZ&_nc_oc=AdrTyjazI7nfQQiJN13vOvzyJ0YbYjO7b2aHCOP0aVCoNJIS4x4LgTVMNYG1bpOWNc8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8bC1bGNfx11OauPSoFOByUBWefutAsbqRxkECBjHjtA&oe=6A36A931"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong. Every play-through is different thanks to randomly generated objectives\n\nCan you make it out alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mgill42.wixsite.com/website", "developer_terms_of_service_url": "https://mgill42.wixsite.com/website", "publisher_name": "Gill Studio", "support_website_url": null, "website_url": "https://mgill42.wixsite.com/website", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "PUZZLE", "ACTION", "SIMULATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "932758697378985"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "304256670062357"}, {"status": "PUBLISHED", "id": "1453682351390768"}]}, "baseline_offer": {"id": "1453682351390768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "PUBLISHED", "id": "304256670062357"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362336603893485", "version": "1.2"}, "id": "156967291537074", "channel_name": "LIVE"}]}, "i
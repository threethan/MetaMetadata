674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-uS5TnbIuQQ7kNvwG_58yt&_nc_oc=Adp9Czz5XOnT01Gn7W-JPQTMlSFpx4sw9iEHzfn8uRkGlgPk_kRZ9m7efUzPEekRPxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qXu5sr4Yg_rGY1L2XsB0iCMHc1kE_V3BW_Av49f87rg&oe=69DA5B59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6uOu5fTRukQ7kNvwFM_9xx&_nc_oc=AdpPNsoTeNF5j5HeMaBsfsCf0GbC0f8nEZk3BbdMwVAHvj2xFH47ebSmtZQqE7UT5wo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zD21_iJdJbmt7aucPd9hSPWyNjSs9sdFpJtPWxcUsvg&oe=69DA2BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYvj09G2J4AQ7kNvwGHGNSy&_nc_oc=Adq4XHqvMmivUj4DTNGXfnJtjSCR3M0o6aKMgLL5qZ9Vw1vKlbKXC-7cBUYMcownCzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07aTI7rYe2YN7gj1-_lJjz8PskRFuRUhlb_A_wwBkZLA&oe=69DA6031"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
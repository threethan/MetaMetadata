674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMzFmNQmHNIQ7kNvwFlmnwr&_nc_oc=Adrc-8ramvxid4_tHP5tOj8gCEPK3eZL-HHxs6RrskDV9nzvK-nYiIR6v_ndRe4JvCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IHpmhQl8tRnA1UOkx37RR6EmlLlwBvVKf4C4iYDnZ6g&oe=6A072E59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D87k-Hz7zdEQ7kNvwGtMZPn&_nc_oc=AdrPfExAB9_RCp6LVCgDpqSlZiOUimGskziYeL-njvX25mKIBYoTCxlU7DMSTpjMAzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z9PVVIDE5XIrg800imNgf25z3uTKzfG0et3UZrVtebw&oe=6A073716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTlmZAaH0O8Q7kNvwHIhAfV&_nc_oc=AdowclfjE145XBYk3Mmz_1z0Osi5j8Kv8BmO4JxNnDoMCPNLCY-rxyc8-eFGDWJ1Vg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41FF61nKuriDN93wxwxOX_YTKhyrQnQqzg5god-fJ5ng&oe=6A073331"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
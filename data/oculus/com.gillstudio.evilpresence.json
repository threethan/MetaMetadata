674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4IB22r-A5AQ7kNvwEndSvQ&_nc_oc=AdoTtCj7t_H8aj8soKhhd1Yt-eeLa8yAuifcbn3J3MbWOv2_OKWXGdH6NoZ16OzQIdw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI2obRauEv_piAGsVL_qNhHvbsMgnXx-v_ALa0uv5xCg&oe=6A8ACC19"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7QNLaAgPHYQ7kNvwEoHCiT&_nc_oc=AdrhdODMN5YeU5qOC29RzA1QWJ10KtgRSA_NgTLdDUYGYw1fW-oetGCWn-cnzNt4gK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3PMVHd8cCYcTewK5tpX98s740sVO3eSRVfaC1jInufw&oe=6A8AD4D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzoqkqljiuwQ7kNvwF21kGu&_nc_oc=AdqH3fYJKwQDllxw6tU7NP1WY9otl_JaccbGFV5pMKwF7bXLl4NoNfQD3W18ZSLJZt0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkGd3YC-LKhYfV2zQ3v7jFig90M3WMkBAIkdKt4ySt3g&oe=6A8AD0F1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDCaEY0ve8oQ7kNvwHcMFTC&_nc_oc=Adr7CiKjfWxLLN3BFo4UyzpZGxmNO0_pdC9iMagvsuHxqhpwQvN85857mAf5ZCduY4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvCOYPW-l1XcCX8Az7FXcJnttNalHxg3V223FBOur-hQ&oe=6A843499"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6S7JNb2ATYQ7kNvwGquorI&_nc_oc=AdqSQH-fPMVJf7_kqfhrQ9PBKdpjsXV7rqDb7CmLyfArWHGfcyMGG1Mv6nfnE69WbNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmBzvUmI9X6fDYHUv4_SP4X6eGxSCU-x_Y-FeKu1EFIQ&oe=6A843D56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3WubtSADqYQ7kNvwHoDonK&_nc_oc=Adq3xNb5vjXamOxhBnbdz52AIMZTManDepSVRWGUaSRH0Rvtl9vZKdzfILJkDH2VK_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcvJUfiTKdDpgEcP_W82B2M0eEKYgQjNvy_DyvZMMVHw&oe=6A843971"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
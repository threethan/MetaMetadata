674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE9lrk70WtAQ7kNvwFhtlr3&_nc_oc=AdpjALMKiLQXVMlKqs-GGl4XpvLOiNfRWOtOPXDrQkRAP0hfKSz1gSTbzu3Lylw-gQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKjmBBJMM82WR-eMq63qVQLpUhvdmGVp0vf3rGTeQ_Qg&oe=6AA56259"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsQWUVbe7UkQ7kNvwH0SBXR&_nc_oc=Adr9WPhnK6yCjY5CVTK3mzxx27JfKw7s9DQdMmkGbXSTA6dEvK-J4uto78ppT4wztXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItE4kX3y3OoUbBlCQc9v8gpo_sjO4zV4NT3Yvmy7W4KA&oe=6AA56B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XR8IsipNl6gQ7kNvwFS3StJ&_nc_oc=AdqQ-rz-oinbOLDsTAMm3UYAlPqasVkX5ed6rL6Zs-7iBoXb3ASxV-Z8ekmU0WcfZUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL105oErC4s9ztmhsCV2bIsKL23DKeM1zNtFfj_-Zha4g&oe=6AA56731"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZeeIkaodR4Q7kNvwGl4Cb_&_nc_oc=AdooTSAI9HeOk_PU6304VuJlPNN2NKDwSd2DFo8_Bz2sk-IJo5vw3YOgahmhaZ2jWuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_VY_0XDo5DRxwZ6TMOY7zZGOg8A3unjXqGg0enTwwqw&oe=69DFA159"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhfoa_wbsyAQ7kNvwErn-Ua&_nc_oc=AdpLTu3oPeapTPt4T20hF80nl5h9poJkksEbxZwTIHH1X61erAQkbAbMLSbkQhGjSWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GrGKpG0EWInTkNX7vnMtbnllTM3KIPtLPs7ik92Q0iw&oe=69DF71D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wqD9TbHOvUQ7kNvwF5P1VQ&_nc_oc=AdqyHm1wvYBGWiAe_ak1gqcvXjMxh06uK3If3XmQJ4XWTxwniM2eWQ_OPSOu9HE6STg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UZrqLzFfdnHw3F_NcKE6_5EWky9jYlcpGUeVu_ucIzg&oe=69DF6DF1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
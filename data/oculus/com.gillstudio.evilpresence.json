674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MKsPjZqxdUQ7kNvwHxRtmn&_nc_oc=Adq9LWjQ-Ok3ZPuzLTtmpBkOzHGpLdie1aDV860vtITsQF-gJErjm1hPemmUmaRMdK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpOR7RFQPJp6A2lh7HceGQnkmssm3t7IsqY86JrnrwZw&oe=6ADE12D9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN8GUXHRdE8Q7kNvwEjk0r7&_nc_oc=Adp9e6wBCH8trAeDMHTprEJ7dUN8krxksFi73NzJLe4LNG1Z70aw-AH4dbDVEKgjnqA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoAaseVs2wA9sIOJUU1p5Km2pte1nDnrVivzaWch4FAA&oe=6ADE1B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU5Z063_ikAQ7kNvwF_o2vN&_nc_oc=AdpyH720_dPTcH4cs6vlVjOuaXQG50t5iC_jPZq5s0JRTuZXcxKt23J3-qa-JjrQ4jA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrn3ABk_T74S72PLuqpcSv9byzlFkvbud0bUsyGmBFnQ&oe=6ADE17B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9rtMNx-vksQ7kNvwFHfM0-&_nc_oc=Ado7YeKsEGt0UVOnWGM11-k8CI20PzH7bVLUoZqffL4opevA6vL0mH92J3-H1GOu5pE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY3c9k4hDYbK9mAS9nVzJBSrtqtFcWrMZqA3QGs_kyVQ&oe=69CA8959"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We_y8ehzi60Q7kNvwH4L9wD&_nc_oc=AdoA8q6Lfiv3YwvlRSiSPy8FTNSWl2w0KB9vK9yU5Cu4Qd11GYwggMtdYlhjsomcQy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAQG-n-MtF1ji8JqHSDCszy6sw9zBlZqixVUBAMe8wzw&oe=69CA59D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_P9lHoPV5P4Q7kNvwFf50aP&_nc_oc=Adrtibil3jeDaWBPdf-5FvknbQ8JQJxT9i4OY5a1yoRszvih9iALdYTxet4I8lbv8hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afww3eAYG3zOPa6fzYC1BSMAgCSvjbsLcVP_TkeMzjRl4w&oe=69CA8E31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzUIlozaDkIQ7kNvwHy-vs1&_nc_oc=AdoFIALXNlxMRUfhDGVTaIo8-1QY-gHtLf_UTt5vEidOabx7YMYIv_f-0YPIjzEzBzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLRRuuqmMya7XfygTPpw1zcPiOhM7smtHSS49Zm8xK6A&oe=6A983359"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4Pha0Sxhs8Q7kNvwFr4A5v&_nc_oc=AdoOLTPLvOJFv7pgS3IWP3zJ7wlVdW3-SuwsUBsq6wMl3oHG1xkLJRTbzIws2V53Dzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYj_YCNybURkD5BgQUu-hnl0dzh5e3oSStcEZG8KjSWw&oe=6A983C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U2iMxvxLg8Q7kNvwE9pEha&_nc_oc=AdrD6iKtsg87lHGnYVX1Kk8Iq8ykiYGjPVejFDGxLmPW2VlSfH0QAbauBMlr2zrYZIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1PuPbHWnWZNXyF4NI35oeSexcaZOzicczRyayQwC7xg&oe=6A983831"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
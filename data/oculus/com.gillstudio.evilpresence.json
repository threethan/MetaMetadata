674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpZ-O8-8Jc8Q7kNvwFZ53q9&_nc_oc=AdqgwUsMUv8-Ijbr-jz5Tk4YJ3EyEnPamsODY3gkizgLiN5Gv3uGQzczlnUKZfIfGwA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMpdEO4qOyn0prmCz1Kwpk_vdHk93q7omYESWpN28lrg&oe=6A5F82D9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y06v0ruQEcAQ7kNvwGd67Sv&_nc_oc=AdoG49Xc6B2hpqfjMUYpOtlUxUZN3Ff_R8OebeJp5gw5FfEx9s7gCtC_H0LnXmW0wm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO_-o2wgVi5NMbSrfols9pU-wDV1P0uX9MxsyZx__Ptg&oe=6A5F8B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce42Mvr8gmkQ7kNvwG8Xc7s&_nc_oc=AdqqE1SS79uckNGGgKm-DvcGOWuFkLfDm7bseM2MvqNuwZrNBVrb4ybdGiSseM05v20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmX4Xfe5hGxMulh6p7b7HXIQ_VYLW0_uhD3SuMkb5Wqg&oe=6A5F87B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
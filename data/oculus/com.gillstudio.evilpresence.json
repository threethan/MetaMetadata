674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPfGvFrPNdYQ7kNvwEFLKWE&_nc_oc=Adog8QPLLJbaX4oYREwvZ2qYRhcDcxUTU-TowXEXyh9fBG5ZD6G8S_fSM33avFnGhGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsBVOn_p-DJaoONsIZW3sh8yCT6Y-eQgDhDJ1SNaXlHQ&oe=6AE4AA59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6_NykVRN_IQ7kNvwHhsH08&_nc_oc=Adp075Tt22bowI9uAMezAl379RjA2zE8I9ClWk-YLCeu7uN45AusvW4BN_pBhEU9stM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjkZQXAHlWwKaxkHfmBdaxZ2ej5j2PwM8YZQalUJC5TQ&oe=6AE4B316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5ZYI7xNfNQQ7kNvwG36R6M&_nc_oc=AdpdTSbjvsZenP7G9QETEfeGtNX36mjxujO1Wm1s_yp6RadnpyIc562DI56rICJ36pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt2nSdybvXXW44BHmjmaiGrZpg-ZvWiuXc077JJu10_w&oe=6AE4AF31"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
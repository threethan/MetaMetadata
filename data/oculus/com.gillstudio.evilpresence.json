n.com&_nc_ss=7f30f&oh=00_AQQWQZyDzyZ3TYbc2jC0qeqneLIIbK05pN4MpFTkZaMtyA&oe=6B0B1E19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying around, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying around, however the hospital is now home to a monstrous abomination, an experiment gone wrong. Every play-through is different thanks to randomly generated objectives\n\nCan you make it out alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mgill42.wixsite.com/website", "developer_terms_of_service_url": "https://mgill42.wixsite.com/website", "publisher_name": "Gill Studio", "support_website_url": null, "website_url": "https://mgill42.wixsite.com/website", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "HORROR", "NARRATIVE", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
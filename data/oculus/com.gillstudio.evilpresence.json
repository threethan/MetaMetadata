674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE2YbCttr4cQ7kNvwEWM2B0&_nc_oc=AdpklpDjgO4XFmyKsW55_e_kI-8nItuM9111Z6jVOv9Xqtx9NHniAvKSfnWlY8XEjsY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yJce6wd8DLz28RSV9B64N3jsbyCM_TBfSBRKIIkYYxg&oe=69EF7359"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OWky8zNgngQ7kNvwF93KMj&_nc_oc=Adp4gW-1VSTe-98MnEtGGLE_lMetdaC12JoE2o-YtOTN3BooUYVJ1XAPRvgFSY0S9WQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RbOxOl16Nzs-WIAcbuRc8msSch0sR93USPKB6Sz40fw&oe=69EF7C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usY9B383UOMQ7kNvwE4yDBG&_nc_oc=AdpqmKJup613JZUSGetQ9osyqVV58GpWX7yhpxJR8zN-zKsJT6oWi7pJ850YWG6a6Ts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hRq1LBEHIq9VUrHSekNGRtD4eUtzem6LQekmZpMrqGw&oe=69EF7831"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
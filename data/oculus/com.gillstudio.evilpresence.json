674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMaLmcldOEgQ7kNvwHxEzSV&_nc_oc=AdrGO7VQyCAfkE52oCrrZU8pwhDjQ0-u_RvE1SKgb0QNmbHmF4fwxP55dm3oRE3gyJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWo7MeAqr5PB20M1XUVvsMBlI4NKkc9o93BtYMhZI-ig&oe=6AB13FD9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hooLkp9CCcwQ7kNvwFStBEg&_nc_oc=AdrhWPKWYxpxIaHbc0_molyq8iAObR6uYPjECNtCZ0yaynJxdxVKF8RF2fsV-3tCM8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMg8R1Tg9moe8yLzjbj5XcaVMMMe3yl4oJIKy9cvrhCA&oe=6AB14896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MY-DRjH_UAQ7kNvwEMDATv&_nc_oc=Adq9qcu4s6kIHvLKg74a0p8g-PIIJnXVIIf8mXtdLlvDenhsHq04pkD0T7K2dcTYzTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL07-HESAKIzctuhLT5y_qKTCA3-92Wxx-OVlO_1Ssz7w&oe=6AB144B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
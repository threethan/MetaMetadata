674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiPV8TJF0Q0Q7kNvwEM4aIo&_nc_oc=Adr6tNjlP2-8cHyNnROYLWdNgT51XZC1-SivGtVPgPr9y-v047cPpEpsk6f2HcX-NOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQGx7p7zQlxHSr4O9z9LRsqiQLUCdv_rje_GrG-VE40w&oe=6ABBCBD9"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpBSEtA-SMEQ7kNvwEu1uSg&_nc_oc=AdpgzBFpYEhxAgz_WEUVVVLAqQE1C7jcyMvwZMKSciB7e1Y5mzZrNjpsGK6SttRXXUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQSUAYdHCWCC_NTBtapuejiz-U98I_P4OQVxFwzxeRXQ&oe=6ABBD496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR-ADQ3Lo5kQ7kNvwHgT1J4&_nc_oc=Adq4XbhGL054zN-LvmQYbY3Z-nhs79u96PxN-Qp5gvgnUqlO_yNtzV1Eoi_wuk0kYtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL-2ZuIQt8ghXzGupXD4ffWITD9NeJxd33sD6VULGJxQ&oe=6ABBD0B1"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
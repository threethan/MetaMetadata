w home to a monstrous abomination, an experiment gone wrong. Every play-through is different thanks to randomly generated objectives\n\nCan you make it out alive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mgill42.wixsite.com/website", "developer_terms_of_service_url": "https://mgill42.wixsite.com/website", "publisher_name": "Gill Studio", "support_website_url": null, "website_url": "https://mgill42.wixsite.com/website", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "PUZZLE", "ACTION", "SIMULATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "932758697378985"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "304256670062357"}, {"status": "PUBLISHED", "id": "1453682351390768"}]}, "baseline_offer": {"id": "1453682351390768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "PUBLISHED", "id": "304256670062357"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362336603893485", "version": "1.2"}, "id": "156967291537074", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1325781514215661", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362336603893485"}, "release_status": "RELEASED"}, "binary_re
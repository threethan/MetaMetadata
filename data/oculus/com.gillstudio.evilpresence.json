674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd28XAQfV4YQ7kNvwE6brpP&_nc_oc=AdqO2F1JtLBuAifJ3mHTwy5H4HcZSppSKzy-HH3iP0os5UZ4LQ5aVf9hs3DITUnZooY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo3FtovovVFWAmUt9g3eDoHAEHFoWet02Ljt3uVjRdzg&oe=6ACA4C59"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4_0ahDFyTEQ7kNvwHz0xYu&_nc_oc=Ado6MzgHa-nT7pflQE_nsRuOqsh4-zS8sFc4yWuuA3iwckaSvAIksnjyYISmM_3H2CU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5-sNP_QaIBDWvknG9c_-UQcLYajzKAjkbT7xDGCN-ow&oe=6ACA5516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjcQcJs3BPcQ7kNvwFAc0MS&_nc_oc=AdqyOnB7nm1aGVjQo_YKQrOSqHR3Kyejfdspk5vil80unjkiXjgX2LRWusDAAJzvKuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0-jzm8igZSq8o6XP53msL3K6b9QH2Cg8cfE9S9sdWBA&oe=6ACA5131"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
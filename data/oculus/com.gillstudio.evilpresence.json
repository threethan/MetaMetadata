674821615229_9044775275073634304_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTyV0DZP6bMQ7kNvwHshzWD&_nc_oc=AdpjXJchoUrOiwphWPh8dM_7UVxSThuA301_L3xYEXwsu6derJ-7NG0fqauGQzYx430&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57thXlkdydQCKoiyLZU80JEKhtAQgDOrpmkVcSLoZvuQ&oe=6A19A359"}, {"file_name": "migrated_image.png", "id": "2513502842299488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162726_1854054711577045_5582650056718155776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP9npfXB5WcQ7kNvwHHTx4i&_nc_oc=AdqlXsR9ta0fIntIWEZEmU9ocS6iCJfxi8qczFlCGHKGipPp8XC50AWO3Z752m9GKEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4udWbb-KtGIISeU3PpGBiNGddgOpHaitEAw4spKG58bA&oe=6A19AC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Icon.png", "id": "1720845498222971", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162687_1720845501556304_758256641949827072_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUv4BVkoDXgQ7kNvwEbE0v_&_nc_oc=Adrl8jaSsULqBjyVa3NIId_OhmPdpcwIl-RiSmsxGRSnzfy4EX1nSMn_gbsuY6RIXxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_kuVTb3skfYUFssWNeSwyjrBMs3_x8hm0aAUWb-W-fw&oe=6A19A831"}, "display_name": "Evil Presence", "keywords": ["horror", "hospital", "scary", "jumpscare", "haunted"], "long_description": "Venture into the unknown, but beware of what lurks behind these walls. Evil Presence is a physiological horror experience like no other, built exclusively for virtual reality. The hospital once belonged to a very wealthy family but now it has been abandoned. Your goal is to collect bags of money lying, however the hospital is now home to a monstrous abomination, an experiment gone wrong.\n\nEvery play-through will be different as the hospital features some random generation. \n\nCan you make it out alive?\n\nHeadphones and a Gear VR controller are recommended but not required.\n\nWARNING: CONTAINS PLENTY OF JUMP SCARES", "short_descrip
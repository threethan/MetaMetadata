otout.png", "id": "1490241906381853", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1490241909715186_6989171750510869612_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwhhrZXbVREQ7kNvwFWM9ho&_nc_oc=AdrXtkkLmcWBnUUqgvfiyE20IvPZ6UL7BIDi-FTUCMSXCQTm_Av5wDn0cS-AQzLd1iM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxLrqrJcRwJrTX6G6AiayLum5mr2N8jzThj9UBo5bFCA&oe=6B105A59"}, {"file_name": "04_grenade_path.png", "id": "1069275809468699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1069275816135365_8245754958877304747_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3E8SX2ht4MQ7kNvwGc4BTr&_nc_oc=Adr3HqaHIsTWZFiXbiAsgBB9F2mw1IQ1q8mCB54tzmcDjd_CwDAV9gNMw0kdIKBW_2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeb_JK7lt1GW3D2rioz9iKe5TSjcaD_QpBLgGRjopvYg&oe=6B104DE1"}, {"file_name": "02_bar_hang.png", "id": "1457426872473829", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1457426879140495_6994644784184104955_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNJsUftHTr8Q7kNvwGaD4or&_nc_oc=Adom55qxNapXK4YOK9rU7CBNCnwjGxef8R0bGjBfrg8airTyX5mY68TyYuV4ma-8TW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_IcmL5pkF7dINwsXP-74wIYxdnjrpvy0Gidf0yxf0hg&oe=6B1062AC"}, {"file_name": "06_jetpack_cage.png", "id": "3623057441201750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_3623057444535083_274781004489613872_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRq9c4sYBksQ7kNvwFceHRb&_nc_oc=AdqDuMGcwUd8DQt4inugr3PCPNONO-hmT6MtErsYyqRiPMwi5HmK8SJs0AvGmPBmkcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqyugGYvKs8a5hF69eC4uKnwNGghBL45hiAnyAjEQulA&oe=6B104C2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla: I am Monkey", "keywords": ["monkey", "gorilla", "simulator", "zoo", "pet"], "long_description": "Be a monkey in VR. This is a physics sandbox monkey simulator. Climb the cage, swing from the bars, fling yourself through the air like a gorilla, and grab everything you see. Then break out of the zoo.\n\nYou're the newest ape in the zoo, and the visitors came to watch. Give them a show. Feed them bananas, steal their hats, take selfies, throw fruit, or slap them with a fish. Everyone reacts to what you do, including the police. Push too far and the SWAT team turns up.\n\nEle the elephant has a plan for the great zoo escape. Work through 37 missions over four acts, unlock the lockers, grab the jetpack, escape the cage, and free your buddy George.\n\nFeatures\n\nReal VR monkey movement: walk, jump, climb, swing and fling with your hands.\nA physics sandbox with 70 toys and props: bananas, cameras, hats, guns, a flamethrower and a jetpack.\nVisitors and police who react to every prank, punch and gift, with ragdoll physics.\nA story mode with 37 jobs in four acts, ending in the zoo escape.\nAn open zoo with 5 minigames and a climbing gym.\n20 hand skins and 20 accessories to unlock with bananas.\nA reputation system: be the zoo's sweetheart, or its worst nightmare.\nSingle player, played standing or roomscale. Comfort options include snap turn and a vignette.\nLanguages: English, Espa\u00f1ol, Fran\u00e7ais, Deutsch, Portugu\u00eas and Italiano.\nNo ads. No in-app purchases. Just monkey business.", "short_description": "Be a monkey in VR! Climb, swing and smash your way through a crazy zoo simulator. Prank visitors, grab anything, fight the police, and plan the ultimate monkey zoo escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": 
&_nc_ss=7f20f&oh=00_Af5-xxYsAe2X3-pBBwb715ojqA6Hnk-KU3aGt-CXIdZpjw&oe=69FF4F2B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br2LFAAI_McQ7kNvwEPcSgP&_nc_oc=Adr2_0m3cet2rtZnI3bVIVUFZxLAGCR65lqaWOTkLPbc8k3MV6wI6M_0MJ2l8zCeLCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KCzwlhnAhm8Mq0qT_OUjUo9xvkjH4WQcW_51fIQQsCw&oe=69FF21A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP6RhTrLfgoQ7kNvwE8FQ3h&_nc_oc=Ado0T2-a_Q4IkkwGdo29_ASH-9CY1tBK_czdi6kPsx-s-xqglrzOCski_ulRuc8VFD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ljhWxQIpN5WaPksOuKE4v5zjVri7dWsRC7me6gwQs2w&oe=69FF3DD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
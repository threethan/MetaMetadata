&_nc_ss=7f20f&oh=00_AQEflqRSMRGk5w8RTjR6dQyEszLOYrtgwJRBamnZ7Fq-3Q&oe=6A94106B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IyGtX63g_IQ7kNvwHQflWj&_nc_oc=Adq3vS2HZ5o1nclIh7e-xJKC9rBFqCJOiFi5pXbbA6QNkSdT_yST6tKpN4zM4LMeZ9o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfTnNycKW86wpPCOaCBP_g5T2pzZH8UMrPevS9XSEHYA&oe=6A941B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9gloTKLkyEQ7kNvwFIda82&_nc_oc=Adp8jxe9a_bKwxXJX1o6PAA7J1ZewlrWFfLx-VYU_88QeRB2IYFSRwD21o-htHXtwDw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpsCgfH4L73NGQ2njyTeAlOSBtiXcnUdMtu4aAI2oJ5w&oe=6A93FF18"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
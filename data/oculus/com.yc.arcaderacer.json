scdn.com&_nc_ss=7f20f&oh=00_AQJWQbISuzgddMpAauouYM_87Am1dLydYnL2B1GShNMKhw&oe=6AA41AAB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkXRwR4xl1sQ7kNvwFm3ryu&_nc_oc=Adq3mQXXPPJm2afnn62lmoAvpCN9OH3-2KCYto6Igd7FdOfvWE_F6A63VPnLJV1C1BQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK83SJF3N-i6CM1ZNnbAu0h2MUH120qNHFoO4VwCaw-Kg&oe=6AA3ED26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR64hjUvRL4Q7kNvwEjmqMe&_nc_oc=Adofh8kqvUnMcfBYc_XBP8Evm21uYXgYL8yqiVD0wNAaTYmINn1cWyB1GaUOo1S0JI4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-MU0XPK_ZuuqkoGrr0CisWtbJtw_fLedE-OydWmY8TA&oe=6AA40958"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!
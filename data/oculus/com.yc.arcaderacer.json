scdn.com&_nc_ss=7f20f&oh=00_Af_S-Plp9jOnDHJ32P3zpoW_FOGgT-IZHuHGIv0jSSiAqQ&oe=6A36AE2B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m99epfN5aswQ7kNvwHS71tY&_nc_oc=AdpPB3YEJhF4amV-3y6hftpNkbTIoEEDVqcgHN-VnEEAqdvhNl_AmYJuW8EnJhMV7yg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWIxecnV2zjkbRq_Q3389rBgbKV8Aw-538CqteXelmA&oe=6A36B8E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwQZHn11QCcQ7kNvwER7NOO&_nc_oc=AdrmSsshCFrNyNSQj3yg95tQgd2bXLzwoQrbsm67zgPIpPZTYOZSMQhFM1ABhvzUeac&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aATYUW8vCOpIImyvsKr05fSpWrZseyLBRNqyRong3rw&oe=6A369CD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!
&_nc_ss=7f20f&oh=00_Af52KrTiOYGypep1cxesiCQWmrSbPNcQsG0ro91JbluV1g&oe=6A0DCFAB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTV1A1sta2UQ7kNvwFVXIRh&_nc_oc=AdpFh9iGTWRSZmp9s7QRjVP5eIa12-E7qBtQ1mEty35pLD5Q9akBz0Zooax-i6xFTt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zu_8pUTKMWsH5JAwWJE7pYPVt66008zHLfUF0nJp7ug&oe=6A0DA226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-ykOWl3gDEQ7kNvwFLGf4V&_nc_oc=AdrMJEL6XHN1IYwFj6ez2VS8MxMuLorgsvNAdXkfirWV3B8p0U5Dot1XweM866BnTjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W_JBJ6bITTsf7ecFViTFlA7CBBol9e3NUvV7u6Zu3fw&oe=6A0DBE58"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
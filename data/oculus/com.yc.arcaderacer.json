: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLTqJAevvjQQ7kNvwF3TKVR&_nc_oc=AdmsLWpvWJ53MVdRV-5a2QU3x1XzZ7-W9WDQvGsfycRRShbwvH62tTTYx5aqEAumd1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsURORehMe_nDH6pFpnpFU8hCsiUpv5_KnhLrqkatEvVg&oe=69A42A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-3hX69ezt8Q7kNvwEG_yzR&_nc_oc=AdkuLKhdsxcxujx7V4dw1psHKlq0ZrIQYmP9JvfxvJNpRO8egOYbbVPjjUq8hJsEmsg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvGx7ojVcXdjmqsMwNYIQn4TiI_Bkjb0L20LXCLBKPcdw&oe=69A44658"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC S
&_nc_ss=7f20f&oh=00_Af6MVGX1uLxoAuuAMMDPo-yOwcr9Mit3VlDa9fTPrL0mwA&oe=6A1072AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTV1A1sta2UQ7kNvwGNVxkA&_nc_oc=AdooggAn2ERnzfbBbYCHQcZU6pNWhJHVT4Hifze-Pc-Grnpx-zmk0V6IZrRXgxDv5eQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SVw2t0-7EMhq5PftA5SsrKNR4lE-zo6U1_NAunp4_Og&oe=6A107D66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-ykOWl3gDEQ7kNvwEQy9Wy&_nc_oc=AdoBjPWpo-akDm_7TCVsfHZo6qFG74ECWczsultdLhUSWwqusg1oGnie8-hebs4mKdw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41fxhEfUdpwwpqA7_KCcE8fhuDCrU32VDxJGGncMvB7w&oe=6A106158"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
L15yKV1NvOr9djPOw&oe=69B3F16B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VSn6LByb-wQ7kNvwH2hsdq&_nc_oc=Adlq3GfDkFt5_fHYZeT1g_-OWAirnm7Eu9MoBW86FoOO7_oFLeb6jhcw3q8-6x62cRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVYg8rUh9-zLcoAvBMxyzC8Etn5KZpIgcCbYCJJk2yTw&oe=69B3FC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iOtN2_2PgsQ7kNvwGL5Gpo&_nc_oc=Adni7LAKB0vraE8WTg9zdVeLTr7GLQ6gJQznRpOLBnHtkv8V8V8fzGk5GNRrCg6bDLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-dZ05h-b7U9Xo3A8idvOOlqF6-omcK4sTXZRLesfEcg&oe=69B41858"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url
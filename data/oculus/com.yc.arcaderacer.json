_nc_ss=7a30f&oh=00_Af3z4FdYdjelh-ikhixEvmT9GQh2TbKzRmed1tfQP1IJ0A&oe=69D4E6EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd8xE21B3A8Q7kNvwFVfcS1&_nc_oc=AdrQ5q__IluT1Wis1x54y9GEVne613j3wEltTTAjSB5HQtBcZhPopDZGIMUV0RClDqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07fQGtLq67Q-SjnXxRmA6BPna2TsTvGWpBomUuWr6ueA&oe=69D4F1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5EOSCpyRWIQ7kNvwFMBENp&_nc_oc=AdqV-M73Nz7lIbkuQ7Fc-mzn43vbaWfF2cEiG8d4cXYOWC-HZkOjwIdy2r14SNbh7Tw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SfycmBHvKi8zWLV70akoXrYdhY4mEh5q0jkdpzOTaUw&oe=69D50DD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "deve
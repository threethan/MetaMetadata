scdn.com&_nc_ss=7f20f&oh=00_Af9m5ogPary-ecsmwsS4TT5IS3EJBQhdGlHjSXZi9QAAWQ&oe=6A22E7AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8S5eoO0xLAQ7kNvwHp_7aE&_nc_oc=AdripkVcU9P5TPcKn5gn1GVhRjz2iCB_wHPpcPNb11w68423IVOhM8GEdRAjNTpm4B4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tlDX_0glnkI_7H5HPHCWllwKeq3D8rY-I2DzlzU975w&oe=6A22F266"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYR2xhS8kNgQ7kNvwHhoEoc&_nc_oc=AdoBBRK67Z42zXNnCmAibROhu1CzGSf19PZlrnHmaawrLfPo_H8HgmOWziL7JPd0iEw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87DN3xwQRxRVP5YBDrjs0MqdJf-f8UwDGe_HlynI9ybw&oe=6A22D658"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!
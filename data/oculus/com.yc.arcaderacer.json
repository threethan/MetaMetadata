&_nc_ss=7f20f&oh=00_AQEv1fV6-mEGcPfi6hX-uJNjwefu3m53UYNwkQsMuYPuPA&oe=6A7EF86B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EkJHiZHHbgQ7kNvwEIq5om&_nc_oc=AdqsioKcIfpgOL6Tw_e8VxiyRo3myiHZ8E5jce7-7BJ4siHmcKTPDCa9_zhMhHa_C4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOpa4mTAExGXg54fvbhNRrzKJeYwsjo3dZX0Erf1yjTA&oe=6A7F0326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flbioaF26b8Q7kNvwHv0xWe&_nc_oc=AdrkEy46SuVMQ65wcyvwJSUzUgKVop4p3JQreBZx18lDKaODaqJViZ17DEhTyKb6Vo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9M05fL7JfIO6LveS58XaVy1djdJSStZFG4eglssCk_A&oe=6A7F1F58"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
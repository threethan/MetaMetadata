_nc_ss=7a30f&oh=00_Afxq2kzxx6XVLv4pV4TTx4Ha-OuMu3WfSl9Ww-cYlRo7-A&oe=69CE4F6B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UEXcNpfKBcQ7kNvwFVhZoz&_nc_oc=Adots9JY-QRk7y0gucMFjY88m34veX1nKL4GQDQULlSqxc43mE8aA2hZYEW4fJrUSFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2IQGdUKJRbEzaRjRKt3wy1Jft8J9W1cYVGJu9veMPmA&oe=69CE5A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxi-rM4yA4QQ7kNvwG92QVk&_nc_oc=Ado8z2qKlGQCUntA3OrpCs5AiQ-DiLP9vg9KhVFq4z_lZ_TkQIGSWk8PuJ9zrQSNCjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsTaDJdivRuHOGeRjOmnK1NE4RT4MWN7VM7YB348IdNA&oe=69CE7658"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "deve
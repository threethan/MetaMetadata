_nc_ss=7a30f&oh=00_Af1upjM6FUX_d6k0B1cIC4ujDPZ1Y5eCTSvQSPNNCdoZBA&oe=69DF72EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXVUl4pgCEAQ7kNvwFskVXO&_nc_oc=Adqy8hFkbO5K9Uf3ZYQVs9fVw2wL9roZvsmJt6PXJ5TQDWIs1m1qOUsB4pjm09H6Zys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0floApKGRS0NE_tQEZU63csuVcg1PYA2ysd_Sy9Lso_Q&oe=69DF7DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umEADo7Ht5sQ7kNvwHO2y_C&_nc_oc=Adr1e6UnPKtArznK5DOSFKpiFUxw8Xy96hDskQjA0oe4xgJawBNtSDV4bNeteVWzN8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nD6FvWD9x3qafOMbztYx3H2VRRiC0pCmHZP611ZopeQ&oe=69DF99D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "deve
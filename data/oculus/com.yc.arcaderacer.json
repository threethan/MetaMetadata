logy of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ycc-studio/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7294711533950714"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1932402814066076"}, {"status": "PUBLISHED", "id": "786912344284799"}, {"status": "PUBLISHED", "id": "4436558913330010"}, {"status": "PUBLISHED", "id": "3947564088879862"}, {"status": "CANCELLED", "id": "840028069095619"}, {"status": "PUBLISHED", "id": "2364445357330971"}, {"status": "PUBLISHED", "id": "2355522188201675"}, {"status": "PUBLISHED", "id": "2286650821784802"}, {"status": "PUBLISHED", "id": "1715769942429122"}, {"status": "PUBLISHED", "id": "757688870565233"}, {"status": "PUBLISHED", "id": "1965535924288718"}, {"status": "PUBLISHED", "id": "1024615446230400"}, {"status": "PUBLISHED", 
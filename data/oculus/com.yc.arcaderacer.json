&_nc_ss=7f20f&oh=00_Af1NKPoVQMYQFAlgBoFHMSrnNELg1i2TzxzSHksHEQd2UA&oe=69F4C32B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiC-Lzd2gN0Q7kNvwE82pep&_nc_oc=Adq_4Xll9WyWM_bR2urZe_RBt4Zituez4dXeeX-hOm0peVoZlaaIc8m8i4Iu2Yo49tI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09wEcVAUSbJAIOtz2R83cfUwLxV9cmQAGA8aM1mnnl2Q&oe=69F495A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLG71B0aIzcQ7kNvwEKEdMt&_nc_oc=AdqG8UUMemyOx_N4VvQKBThtCEfYrOUhEDPmUtqYV_RkA88_COypBh0T25kKFY32bsY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QqfqrawVjyVy67uu-LN6RlLe93T0yxag-XaHpqX8vgg&oe=69F4B1D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
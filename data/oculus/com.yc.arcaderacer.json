&_nc_ss=7f20f&oh=00_AQBfjdcFmnYrXs9Fiy94bAk2b1XBlvKlTvdAEx3AUNDs6A&oe=6A4A74AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3ek1RfqofcQ7kNvwHmxXI8&_nc_oc=AdpLmFwI8pLArVU2LYvaWlSiT5w_R-B5AGPIsf4q8eAHTbyv1_ee26An7sTmrN--oFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8gCenpadofmPa8ILTQG6uq5m3KWOvbNWjYiHcJ_IEsw&oe=6A4A7F66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVZCkR3pBaQQ7kNvwEXN94f&_nc_oc=AdpEgVMpFMjkQvC-WTfBIWkFCo0Ml7VLpM7DWaCGP2-zakpm_YJOmjnU5xPeHlUKRd4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-xg7lTOCdIfW2SCJEnBI8FtqQHg9a8b7DvDf5L4RcTw&oe=6A4A6358"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
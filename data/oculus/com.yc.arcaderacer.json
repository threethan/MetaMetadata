&_nc_ss=7a30f&oh=00_Af2UCYKb5IdHNVr3oP0l0ErZdEXHbZAuZdpVY5efbEBTJQ&oe=69EDF36B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9Zemh0IlvcQ7kNvwH1apQn&_nc_oc=AdpOpirAt_ENLi7jeeLvu-rGcNKWHfddabnDabciIQnjqYKuoReFrrKKPLlvrFwt1BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-suqPzVASN10dW7V1fK82vpmizka5TXCkwsX0lYNSzQ&oe=69EDFE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzLFE2dqy2QQ7kNvwH6D-B-&_nc_oc=AdquDfybwHmE0nLi1XMCka77N7Ar1qEWx9INwoeCdSWdeHQom7egc-Zzsb3SWNu-wxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VEeq59AhUFkvYzDWvk7N9q314c_pQlIjGkq4QD6EBiA&oe=69EE1A58"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
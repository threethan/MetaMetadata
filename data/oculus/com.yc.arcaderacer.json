&_nc_ss=7f20f&oh=00_AQI0sFcmfp2XswMNq_aN6FT1p28MwlhAKw453QqvVU4UFA&oe=6A9ED4AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pezk22nkskQ7kNvwHWVqzc&_nc_oc=AdoA0lEFkQKI8nDbsDBorSzb8Q7n20b_BfxytHl7_orS47HfFmvzzmHYg0BlU7pXGp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNZzdd1HVVdFcuK-lEhxvuubgX3cEZzyKGjhkAeQbQdg&oe=6A9EDF66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR3n7s-tXtQQ7kNvwFcMgZP&_nc_oc=AdpLGtUszFKOFmtso2mFLyH6jSo4K5QHdPmInyHBxn-1X1lZmYCVjk_rhqwoN6WYqo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-E265hzuShwUT_GkbJR2VTh2l2YQm6zmWShfza2eN9g&oe=6A9EC358"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
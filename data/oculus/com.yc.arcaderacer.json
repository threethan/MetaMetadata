&_nc_ss=7f20f&oh=00_Af0JiinHru3Z_VJkIQy1sqDwmfe97FsZoHdAtF5uR0P8CA&oe=69F7662B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY_q5wnO1_4Q7kNvwE7qcV5&_nc_oc=Adr2Lz0BmSxi-1_NH1M8IdPY8uJxoegcnavQWVqOoyabW7FnoJhav7ecPCpcxqlI8ak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33eUPOKO1lDdPIxcsAeo4J4k19XMldirHXNhoQRKa9Og&oe=69F738A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-lHwvHq2X0Q7kNvwHp4Ue3&_nc_oc=Adp3bk7Mf76JWEZH98I8y0xlqGqp65h7j_W_8vPQeAj830r9o2uZfMaHONjqG8IYt5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23qzY5hoVksDQdKkPNKAE69eh1x2RHGT0DmC1C1xhC3g&oe=69F754D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
&_nc_ss=7f20f&oh=00_AQIS3VXZsSNatv52S72byjKwmM5MUTkxHjTeSLvtlewRxg&oe=6AA2C92B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ1yU51B9HQQ7kNvwH5x0mN&_nc_oc=AdonkHax4CZD8DZuOWh8XX7yYa_kcNnNFsfdcBE_XFmwy1HfwZfEpYkTyDvfVH0jJWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWYxsvo_Y7vC1WqgjDmX4HaD-kzeFj6iFK_sZvT030gA&oe=6AA29BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk5bxO3vq9MQ7kNvwGTfUqO&_nc_oc=Adp6xU4xfFhjo-229_g58svv7lJgSKSSyJN2ma093ausLCRMe7B91Z2ZD-Yl4yjHcDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi_UMXpRyKC5JJuTgCYYeiS8Siv3AlXiQxQodgFLc0xw&oe=6AA2B7D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
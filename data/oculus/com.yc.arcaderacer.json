_nc_ss=7a30f&oh=00_AfxdS83XPzaJFtUFAd_0C0Mc_fWf8nhs36NfCldqfhyqcg&oe=69C514EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv5KxQ8zYGIQ7kNvwFX45Oj&_nc_oc=AdoA1c4S1KZqvgr6G-afDtOlFheWz_TZ4DRxxIJMzxCiomM4lff5FQHw1Irm6PCP7s8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5_HingAelPbZ7PsNEGIwCMj8ruKV9YjOWpGD777sOuQ&oe=69C51FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7htltJfIEJEQ7kNvwGW2d2b&_nc_oc=Adq2nwe8eOMyWc3Trc5f78waDaY6-I5VWNq4X1EaHDgCon3Fb_BF0N0xdWea7RRc1kc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkUZUMwDv80e41dImFqwYwLjDf2WKP7vxYbzlExFY_LQ&oe=69C53BD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "deve
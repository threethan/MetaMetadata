&_nc_ss=7f20f&oh=00_Af-8HcJRDJLqgfBlwIhS3S5ZKCwmqP794Zp8WtnZIeHmog&oe=6A3BF42B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf9q9hZl1cwQ7kNvwFJE0pO&_nc_oc=AdotaOQuMXR_8lvXAS4dV9Xexo_-IiREKde8OMh6wDnQEpDkUpZBPkhyaNOsZT3zv90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T2K7WEAnxRL_Sn2FdxSFiPRutWn0FHqmUXjZM0kUO-g&oe=6A3BFEE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo3vQPNrqTAQ7kNvwG01oU_&_nc_oc=AdqaQLFWISl4rp6ZEjM5y2_DI2m_tMhQKYLDjyCPsqn3W4bGxqs2ytT-zkmNnDRhffE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tlubZt9_OLA7S34We_Sg1O6WpeD_K5Jfbe7YhdxuyRw&oe=6A3BE2D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
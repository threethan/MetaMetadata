&_nc_ss=7f20f&oh=00_Af4qZFZ72vQwvT9bisd-RpW0t-3OkBX7BovjYSvv59nMFw&oe=6A1DA1AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQWPN8rWqLwQ7kNvwEtTJPC&_nc_oc=AdofXZyIJ-rH0h5nl4qgETdsLEVxFQ5_iQVGk_Dnhr2d1tPZGHMnO_0ZANGLGCWknnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ngd7D6bc8pEwop4V1ArAx6gM2XQ6M_N-7WHO54qW8wg&oe=6A1DAC66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WaY29haPE8Q7kNvwEOKvFw&_nc_oc=Adqc3mWHpCmWt8Kxg8_MoHjUEAB1m0IGDqkJIrOeXlx40b9fBlyWZ0LOwEzdvbBm5Yo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KJH4WHkRWTHdKsj7ItUGHlnSeIMN9iRRt-Dq5QeaILQ&oe=6A1D9058"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
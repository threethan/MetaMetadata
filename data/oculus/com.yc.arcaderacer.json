&_nc_ss=7f20f&oh=00_AQKiVxcthIOIC7AE0Xa4pfa18Pgt2xhXlUcGecUjTbC-BQ&oe=6AA177AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ1yU51B9HQQ7kNvwH_OQtw&_nc_oc=AdrH0BV0Km2ib_BmW2JGXDEzRdIbvQq1qTGVcEoorm5wOU3ohUWi5FMTbhf0fFwTk_4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqx6C5y27UZ5u2LPsOlvro5uJgLv0FYsylWhX1nndrpA&oe=6AA14A26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk5bxO3vq9MQ7kNvwEtQLoc&_nc_oc=Adqwu85JTt7UV_mj4tqN_mPm3f4tyEbw5qDvuA3Er3CSovW1DsssFOBbRRMwe4NCj3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5MjAx63WJFnIbZr-9JzJSI-ss1YBuwgHIzoyc42s5EA&oe=6AA16658"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
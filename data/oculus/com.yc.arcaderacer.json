uDTN4WcmmUjaX1tpgNrR-Ny6Q&oe=69AAB6EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7b-9rXA1ZgQ7kNvwGTkjHL&_nc_oc=Adl_sIO8supGFvkQgvDwYSM-x7vkBg7tSnhgImxYetaB8mLgjkRYsFd3p-mLBf9JZP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKQ3kjsnER8P39QjuhcEJWL0Wx0EA7pSt7BOnB5bI8rQ&oe=69AAC1A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr7sQwv1JVYQ7kNvwG3Z3mO&_nc_oc=AdniQNKxnX9tDtD4L7E5yVn6uSkdOLCHFDNiyj4IvZajCLZwE2-bQi0eo8drekQ3fEw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9_smOxdBbhnKzaW2TPlw2PPxX60Dap3XuuKoyAryWYQ&oe=69AADDD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_
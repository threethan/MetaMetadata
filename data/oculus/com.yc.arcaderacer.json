_nc_ss=7a30f&oh=00_Afz4EfMa38WuplV1jwt5zjxj9bvRd47Iu9wddtkIuiIhGQ&oe=69C9096B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJsxCCEJxoYQ7kNvwGF4ayz&_nc_oc=AdqPRjPF0CSv72ttWAkgRJUA5QA4aQgB5SnbhbNTIIlSP_9nfvOGRt5CBWESRktQvRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDJ8Udixrpil8FJqcGekBYwaBydRlRXMbHqkm-nv7-dw&oe=69C91426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1Ri8G2YBIYQ7kNvwG7XQ82&_nc_oc=AdpQ_nTA0dE6iBBjJL1c4oo_uc_b-C-1OMJ2ygFV45Cy880lHWRaEl9RvjoAIZW2evU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp1SUVDhrDX0l755TSibP6csJ5y03xL3Q1S0_ZA336dg&oe=69C93058"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "deve
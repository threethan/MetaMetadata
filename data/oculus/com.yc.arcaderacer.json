&_nc_ss=7f20f&oh=00_AQCNtjEo8tO0KUvc3awbDklBmePxUoxFjPkXfOqaVCDkQA&oe=6A5A46AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpyIzZPbOKwQ7kNvwFh1aBk&_nc_oc=AdoMlFlTvms-ELpoGg37zPOg0qe_uSzNw1L1VeJDB2GUjnQGM2tQLae7UlSvz-B7u9E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3KVkioGT-2CrKYJwFempXHGn4_DW3cbei94HL2VnaFQ&oe=6A5A1926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKe_wtolZ68Q7kNvwH4yYHV&_nc_oc=AdpVwZHkxDlYOOb7yIGmchVFL6fQ8SMAXvhh-AHZ1VLiKB0s15-bx1ObAP7HV4pYrbw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1oF1mIGw2rZDBpXkDJuROhvtCKV39cXNwk3-9xcp1lw&oe=6A5A3558"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
&_nc_ss=7f20f&oh=00_AQGpZluhmCcCBXotOOiFF8Htt_zl0Us1xrkz2tVeVT6WbA&oe=6A8AD5EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHQJzzGapJAQ7kNvwHytpT7&_nc_oc=AdpOn__a-H3GMt07qfAO4THWOa_KoQQ_XFoyZg8JSj-aqLXSXv1u8MUu50-wQvdp5XE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC76y0rGrPYJWAhYfVF7_3onp3QAdF33jL4-dkr5K2hg&oe=6A8AE0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYkVp5PgBYUQ7kNvwEHEGH1&_nc_oc=Adq3j6l3Iq79n09gwzq7CEnhxi3grrnyw5eg_cj4BdNxXagQGeYG13URdEg_2aNcU-4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz4_c6h80YJnhw-FwYuq9FqGppbQfhbiceVZAEiqoFbw&oe=6A8AC498"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
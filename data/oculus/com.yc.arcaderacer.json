D4_eYcKepY5BDMMXA&oe=69BA88EB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n599XETWR6AQ7kNvwGRIKFW&_nc_oc=Adn8UESF_qJvi0ViUptQ-Mmv4eyAKyqlMYWwLREeZq7ZUihV8khPNajnC6LW5gFZ0IA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwI3G4_I4P-zCONsuCFr8gM2QMLTxrdLIRHYGrbOj0cfw&oe=69BA93A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oKXsUnvC0MQ7kNvwFNri5a&_nc_oc=AdmbVlzm-H1kfnKQSm9R4Kb_z11T8oVOnLmeuuQaa61TLsIWEU6Fr1PwpGpJtQTeJUE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMpSYc6-nDrDUCejSyrOIa0H59QGIm7EQk3-pPipaGdw&oe=69BAAFD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url
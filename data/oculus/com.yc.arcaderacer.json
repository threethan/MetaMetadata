&_nc_ss=7a30f&oh=00_Af1wAA7dsTLFJy19HW6VYK55dThzU4frBKhQjM40lSo7Ag&oe=69E8AD6B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CoRezTVxdYQ7kNvwHNreOQ&_nc_oc=AdqmjPY1wwSEj7K-uSr7jiiXVTn3zAm3MQYLql0MxhvhA7jEnqVgiZN8sVOYV5vrIYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16v6iOJUPpU3SB1JP-e_RKdCRpxKCGI8L63kFW6N3iYA&oe=69E8B826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpmXHpZ1UcwQ7kNvwFhfZgM&_nc_oc=AdocZtWXxxmTwHPt_oo6cZktlUtvhG1aMiTSA6QmbcJKsa-OtCR2xSUk-w1o2cdAkhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AOmrF8mOFhSqDSnFR85vF9aBv2zkBdlvAjhSK8lmKYQ&oe=69E8D458"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
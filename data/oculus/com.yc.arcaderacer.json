&_nc_ss=7f20f&oh=00_Af_KP5JQgJJl5EWOth0lQM0G_De4aGpShmPlbfpy3dau2w&oe=6A2C222B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ID8n-pTmmsQ7kNvwHk0r4c&_nc_oc=AdqFnsR57OvvyyztwQd-i-MVdBUdOSo4e-PZTlJn8aNThsg1eeFkqs_exCFOQfn-CnQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JrVMwwKDtMyKLgvp-DgtX3-QAahWKeXfd3pmLNoRDHg&oe=6A2C2CE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyknYwAaJGwQ7kNvwFK6a_8&_nc_oc=AdqItCICRZ6UYL7wFGhMPi2RhucRWJ9Zk7zGxCQNiB7owLd9zbfmA3hj5UXpBLt-Jlc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y8IoSG1Vt8-mpXcmtWwAlNuJyIELdLbeDLxDg1ILSIg&oe=6A2C10D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
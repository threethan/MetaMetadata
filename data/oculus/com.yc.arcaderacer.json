luscdn.com&_nc_ss=7f20f&oh=00_AQEznJYFaZkL-6bAtSG0iDKDdtl26yBhnALOW6xt-62vwQ&oe=6A858FEB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8_QBUf8g1sQ7kNvwESXrc8&_nc_oc=AdrkP9Tr0puNyhYXFwT93QA8dT_GX9zbT4-GbhVelQnBmfqT2lQ8SHXV54j3T9XdHUU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIaY9dkziLpGIbcEzABkpn1Y1lO4DFOY59vN-dt8A_uw&oe=6A859AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lbeSiBpX_MQ7kNvwGVTBf_&_nc_oc=AdrfjlpBg0kO9qrBJZwBSPIPSHHYz9yFZrJXBn_hAW2dPBu8TtZFylVCpng21Q_olWc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjas_9swc9QmQ-bEoN201PMYAHk6L1E0qgdE2O7qSrfw&oe=6A857E98"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competitio
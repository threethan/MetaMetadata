&_nc_ss=7f20f&oh=00_AQNWfRg3LhGSNtf_K2yfQOcFijmZyGckI877j7m74xI0EQ&oe=6ADF6E2B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2vo374ZQoQQ7kNvwGjfJIN&_nc_oc=AdojIkJBXGCswdd-xP7nMMoqjnxkiLeKrIctPa7334x60UgYSDWtk-HnICSVFVgkthY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeihuf1cvdNyTJ1u0d4gH78-dVMsiOZdieKAqBOv9fDQ&oe=6ADF78E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHdQXGR7wPkQ7kNvwF3B79n&_nc_oc=AdqrpAVOdWR-SZBO_8MQ06rELWVoG4dCb1VOSQEWC3Se3dUIo0zJG0z4gYUx7c5_aG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmSY5ZB7gPSRT1S4SXJYcA-NZcc5a-cXLyDHIHPQNm7g&oe=6ADF5CD8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982470_1114682429720524_7355995334901525775_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSCCJsAUUAkQ7kNvwF4Sb0U&_nc_oc=AdphmM4z3Lnug1X_hEjBtLnyMy1Xvyt9yguM0pUDJO-hyaCHBEgoHhxpsHK0QF2MSNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9qdffRzypZ5fbe_8igEhSQVnK4MLbCa1J43S5GXmjbg&oe=6B0F1C6B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bn_DyVwjIm4Q7kNvwHqR_zT&_nc_oc=AdrBVP5QYNRd6iHJJT1ubtEu05N2zYnxNyUbVLDnN7db9WjWW8Kno9n__Sn9XCzb0o4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWf6eMvejAZjnEHpmmzVzhMjTc6KPxwb9W5lf3ckf2xsw&oe=6B0EEEE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0lxvjnYaJQQ7kNvwHHVXoL&_nc_oc=AdoPRSuDvdtJ3WlXEuIvYevSAHAjQMGmH3ufZckVieN5YohyLBNlX2KLYz3x0aJYtIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4a7XGNtUKEDwkz7uANQ_P75Tw11P2eZ7KJO19pnJGOQ&oe=6B0F0B18"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/ycc-studio/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7294711533950714"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1932402814066076"}, {"status": "PUBLISHED", "id": "786912344284799"}, {"status": "PUBLISHED", "id": "4436558913330010"}, {"status": "PUBLISHED", "id": "3947564088879862"}, {"status": "CANCELLED", "id": "840028069095619"}, {"status": "PUBLISHED", "id": "2364445357330971"}, {"status": "PUBLISHED", "id": "2355522188201675"}, {"status": "PUBLISHED", "id": "2286650821784802"}, {"status": "PUBLISHED", "id": "1715769942429122"}, {"status": "PUBLISHED", "id": "757688870565233"}, {"status": "PUBLISHED", "id": "1965535924288718"}, {"status": "PUBLISHED", "id": "1024615446230400"}, {"status": "PUBLISHED", 
&_nc_ss=7f20f&oh=00_AQG_6VqHfYI176dtmSK6OXwUba1KOd1Ho0gwtgZE5l8vug&oe=6A75F62B"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTioxUjOiXoQ7kNvwHbqv-b&_nc_oc=Adp-Fu2GIpPTIYh4Q5d10B1N8Y004LICWbZM55hxYbbXRLJNA9ueYiihAKZqY8ZW72k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfLx6fCLcGFUOkicGV0OtFhtB0ZbNxlXEvA5e9O-HOdA&oe=6A75C8A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_76WO5CsDgQ7kNvwEuyhpq&_nc_oc=AdreX7zpTQ37mQDpkfoOrojy0q--5RFVFurpNvzetVVbhnH7LLzohuXc_MWadEx_0Ok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbGqgP94UGG1mnTno4U6Ie72zrB2dCQrHEjU__qY0eQQ&oe=6A75E4D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
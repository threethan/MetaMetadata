: "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WY269Cb8acQ7kNvwE2nP9L&_nc_oc=AdmfnbtgXf7Z54CT6SsPtxVt_pup_vdtsfTuYc0tGtfNo9bO4YqWTTdFWhqAbgQ4f8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQcnsGC3mj6dbulWEqSDxlkp9Roo9mgtTgNq--lSkFpQ&oe=69A035A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w6QmI4CVfkQ7kNvwGCHvoJ&_nc_oc=AdkiDta8-wRn1pAO6h_E8Tovc5hzLzb0HcccZZ24S3qwnU15FdL87-IkdOeNsBQLGX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0VAiT6bcWkswUH6_Qhr-bCHRn23-xlY0Cf7GM4DFr0Q&oe=69A051D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url": "https://sites.google.com/view/ycc-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YCC S
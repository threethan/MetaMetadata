&_nc_ss=7f20f&oh=00_AQJIu_aK6mrr3SOjllZPaK14cVf2CpYerTEbkXO4VFHvIA&oe=6AB932AB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF91IA_GIxgQ7kNvwGYhXKP&_nc_oc=AdpDIN9cP-6mMLipPieimEJ8A7bzJu5sE98L-zWkG6m-epGBU-ZjYPCCopb-trSozvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1It6zrgt0pyf9udi0F6p7y5j_lUSoCv03ZNdgfmyVCg&oe=6AB93D66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hNtgl5NZ7wQ7kNvwEl-dIE&_nc_oc=Adpmwub1zcxVrakni-9plmBHRLI-L3GTOpIM54bUfB1c6SoBpsGbZ2FDKVRIo7wdZUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbWdqsH9SLc6b2GPiwzZ_MOYc4atvGBrUHj6Dtjxlz0g&oe=6AB92158"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "dev
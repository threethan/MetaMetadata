sPxSvNDstHe8ndY5w&oe=69B29FEB"}, {"file_name": "Image Sequence_006_0432.png", "id": "299670376473058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031506_299670379806391_7234294570572118687_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VSn6LByb-wQ7kNvwEp3hvo&_nc_oc=AdnAYZPJGC9m_Te3X8AxrB4Af_h9Ajqt70DrotJ4DnRiZcO0U7lHrZyLnrTo4YZpQc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFNFix2-ufuNRNFvdo1zpTUKBoSuGWt-awRshfD6QiVg&oe=69B2AAA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0324.png", "id": "316247204790684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031314_316247208124017_4275818072155497570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iOtN2_2PgsQ7kNvwGXcHbh&_nc_oc=Adk_JzXLhnP86jyvj_I-p3DchfnTa9ZL8Uck2IT5ZAFQBGD48mIaKnEoFu9eL-mMJSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyl_Xngf7Qq3wLaghi8v0ysuem7dugYj91pnJ84x8xvHA&oe=69B2C6D8"}, "display_name": "Retro Racer", "keywords": [], "long_description": "Step back in time to the golden era of gaming with Retro Racer, now revamped for the ultimate virtual reality experience on Meta Quest! Immerse yourself in the adrenaline-pumping action of classic 90s racing, where pixelated landscapes and vibrant tracks come to life like never before. Feel the rush as you tear through neon-lit streets, master hairpin turns, and outmaneuver rivals in this nostalgic homage to arcade racing. With intuitive VR controls and stunning visuals, Retro Racer delivers the thrill of the past with the technology of the future. Get ready to strap in, rev your engines, and race your way to victory in Retro Racer on Meta Quest!", "short_description": "Experience the thrill of 90s arcade racing in VR! Dive into Retro Racer on Meta Quest for intense action, vibrant visuals, and nostalgic fun. Get ready to speed through neon streets and conquer the competition!"}]}, "developer_name": "YCC Studio", "developer_privacy_policy_url
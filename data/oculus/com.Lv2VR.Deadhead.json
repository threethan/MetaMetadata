eVDqYCUnDNWArR-r4qR7R1k2ywqO7n_CEYePyAdO0n5tAwNaWtuLU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sQolwJXrb23Lkt62JeGhBP-IAkXGC0ZDBGvAzX1o4AQ&oe=69DF9445"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7jYDzJ1pc4Q7kNvwGcoXON&_nc_oc=Adq6xlae9-PgpahG1d7TCgTn9OhX3twEsE1v1iyCuYu1YqB2OCrOtC12ghx8kc6YLiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VHB0ZqIeQ5R5m-dzJY2Nm_3OyktPjDWJVVocDklR6NQ&oe=69DF759F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3IHIb2sez4Q7kNvwFjmLvA&_nc_oc=AdryKeUnMdNejuWrLNguWMbPNHfEgG4-FH7OujmQm3u1KjKvnYJL9AM3Er6w9nGiKKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g7wgGz0XslK7KiEBO4qXH_DozXPyBsoXChZqaDbGh0g&oe=69DF9B1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
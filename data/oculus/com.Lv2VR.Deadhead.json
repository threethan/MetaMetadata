zK5S_uWLIK0Ny9erGHZAhTwxdwNgaBGkdGtvaOAVV-E_Pt3VaIl9A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ0DdiaPQUXqy4a-SWsVB1ZTBsivUVei-I23Drw44rrA&oe=69CBCDC5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZqxP-CtPYwQ7kNvwHbNXbl&_nc_oc=AdpOC4XFH7sQypVFBmnqe4d1fURtWgeAiOuI-LBbCXkQwZAfYY59aCmpAIL0XTNU35I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhEQmS_aK13n6mjDHfxQVA5xtHBf0_yU8aifEl5-hZ7g&oe=69CBAF1F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfGf7a1C0iIQ7kNvwEBQNU9&_nc_oc=AdpgrQLIzv_7btnR3x-Egji1EmL53p3ZfgCNcx_Kio0wMBYtZ0s97v4--ANSdWxcuBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBrpTpeJlYa7Q2P7eiuUDfOSBO-roUEMQSgProdJ0T2Q&oe=69CBD49B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
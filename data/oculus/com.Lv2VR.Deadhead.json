sbC71-5GZvu-dS-Tsq0UpEENPrk0ZCAlOmfpv-5NFcCA_nXjIOBM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zADjNj6tevfw-SgVuDXi6HYxw0CU2Fc6lglnJOP9N3w&oe=6A032CC5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcLx7hrEXeYQ7kNvwH66BsP&_nc_oc=Adqumjhpm84zWBGJoR7Wf0y8fVkifvc_NiH8hCxaJ2ZaOV8Uyg5UoKF7QoFKphuWn58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jf7qKmqLF_U9KnnGKMQQVNQn8UrPHNACj-R4q_xBcFA&oe=6A03465F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2H1Pk6HVuAQ7kNvwF9OiIl&_nc_oc=AdrDKe1GsBFM2uGazJwgkhkauepspB2YpdQ8MN606qrbkOfbZfpi6VROt0YfQuVb_G0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c_PIlDeP_vhfr4XD1O-wW8xOVbpUDK9JninKml2K-xA&oe=6A03339B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
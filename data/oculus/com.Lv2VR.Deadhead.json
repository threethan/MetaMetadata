5IuB45whEgL4MVXzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoabzUo4PY3SuVzqAcwzqg_kG5CvTd3qd5L1DLfFuV4A&oe=69B56445"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaN058gp-HYQ7kNvwFO4Czj&_nc_oc=AdmuxN5hAITX5Af5xQYcRNC2nFLtzH8X2NguJjovBjTrI-e-AM_pl0YsHcR0ZWypBl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8buneO2R0Vxn91PEqgBj4EaHAc-nEekWP516x4TZoBg&oe=69B5459F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMiGeCeP6sMQ7kNvwGkgdpq&_nc_oc=AdlS3ks1RXShND6SH-xeO6OUXr3v018BWX3AMr3xf82AIzRM__rgCXe_OdeDOkBz6wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRI5kVG5flt3ZyUKZvZs8idp3yd9_V04D4_V4FGH6P-A&oe=69B56B1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how lon
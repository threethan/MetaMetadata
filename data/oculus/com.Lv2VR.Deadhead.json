F0-MLD4VpA6V1R33Y721dUP0lCVU-2DSZhYkzgjcgqf2s-gP_cW74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGTQtb4uRxR2293xi3C3EG3wQHCbtUooPhrJ_MJgrBcw&oe=6A7B2545"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul75G2fI67gQ7kNvwH1uZFB&_nc_oc=Adq986lsTZ8s_OjUHMEXWJXwdpBLz1TaEivUrLXq-6QBXdqbyv7fInVyyANnibFcuNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZlS6_hyyB_8uJVFhw8sdQlTnfR0MeEOcXxH2lneBPjg&oe=6A7B069F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB18gwU0aG4Q7kNvwFW32pA&_nc_oc=AdqgshmtYd76BNdJxW-_1vtjnbpjw8p6D8YGN8UVyd6Y4UbUzA-lSbTLgp--YlGPemE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBvS5KqRd7CLMl52xu50Dmj5ZvpCBixuKjIhTbDeZDlA&oe=6A7B2C1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
rO6nKecCfK7ypfyPxZSyO6Lweb2ffT2ucY9h_2dv8UKoVrvalKHJffl_sI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r9JlqbdRH0xgn0Mz4UMLB5KndKuqhLCBlc3toM5s3Iw&oe=6A393A45"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z_YXdW_NpEQ7kNvwHrsVL8&_nc_oc=AdqioxfgcCJE3ahb_q4inT7rvGIjXF_DI5HGEprpl5-5iFyJP7QLNQwCnwedAoPt9gg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xiCQ1bjg9z5FrENcJWyYHjLW4TcaAWmLh7X7d5Edmdg&oe=6A3953DF"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGsuQMPbmasQ7kNvwFLEDrt&_nc_oc=AdrqrD1glrQGpJdY6KJeV8Iy9zoRTiSjSVqUTdLhT3LgDc7qD04GMM7aUqtqQCJ11Hc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K_CBb4i6dI-Apfa5aNOWLJcW2X6MwNvu5QtkhvuS2CA&oe=6A39411B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwbac
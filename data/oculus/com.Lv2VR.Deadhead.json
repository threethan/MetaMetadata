igrated_image.png", "id": "532568754306702", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138945_438806592985304_767396154_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa2HOQBJAr4Q7kNvwGU_pup&_nc_oc=AdpbIhBKYKgIYWOApqonqXd31cbH0IZJrDqBGpkbFvGQfVQ2KuRuFmOqq_f8QNVFFTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfhLCnK5LAI2NibTvD6TIFshWgu_gI8lgg5YA9xCVHBA&oe=6B0DB405"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g9memZSA2gQ7kNvwEA9lnw&_nc_oc=AdqqbFpHwDgsiQCLXB6LIsTZjd7260acKsna5ZYQWo5GHxsL6u_iwTgpRuk8cZhwyM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPLZqCo2HGuyjHZCOYKmvHRcxMnLLuj-do4pSeuI41rw&oe=6B0DCD9F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3SZNjOVWdQQ7kNvwFBupkD&_nc_oc=AdpYji7iSFfRz6nGOMtnqJdkwguI05zRSHggH6iz86iFEmlgDQKOpYmpMbVbwdM-4r8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbv_eNFAxZ-AugPUGZsFTXZOl9iA8vHz0a8KS06hcD1w&oe=6B0DBADB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/LV2VR/", "developer_terms_of_service_url": "https://www.facebook.com/LV2VR/", "publisher_name": "Level 2 VR", "support_website_url": null, "website_url": "https://www.facebook.com/LV2VR/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "HORROR", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455965746011061"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138840_1076286759050999_763588409_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfGqdY7lov4Q7kNvwHJ1_iA&_nc_oc=Adr2TNnY2TrRlbYHeFk1GFLgeniX3C_1KZXJoXTia4SUbzyfPPD8sFbeSmbG3vJrC5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTz0Q0Jgt7mWE-1UMkQEvYn8wG8sKQZy2Vh9uNfaZ-GJw&oe=6B0DC33F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deadhead VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450944000, "lastRevision": {"nodes": [{"id": "1011528915559204", "releas
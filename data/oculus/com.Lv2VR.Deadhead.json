s1ggvFAxvd99D0hQPlYhf_0ZRi3dazmJ6ruMoINuBrjc4l8sTDdzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj_n99yJ-lUS1Dmwt70UdXM5rtrpziI1QvrWTiknxlNQ&oe=6AB3D5C5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FtY7BEP-esQ7kNvwEncT9B&_nc_oc=AdqweJtjGF1GJ7Ckr-_NjM3zaoUYzbjEBxLXEI1mi5AT9uiY7u-9QXgp6rQZ0yuFOoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKir0pyCZe3MWYLMQeRolXz_TxCqAu11p9FQp1n7u3crg&oe=6AB3EF5F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl9eCBEshVoQ7kNvwHpdDcs&_nc_oc=AdoM7ASxjqkQmElBB1_ZHD8J8Kg6mgjTaXSTQKwHM9CfM42Zqps4VRyNWADZIlHVRH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH68XBgiaKRwGIImhdjjH-lZ_9UwJsRUalC-TtFAMDNw&oe=6AB3DC9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
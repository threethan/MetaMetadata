GM1PEUD_srzyvb7Sh_xr3M0R41A1RSgKLP7oaWkLSpnpEscPSuWT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCov-nlK8ES2JjzJc3Abg0Gvvvh_pqCDnGnt4ZRwahCnw&oe=6A6CA4C5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqNQrIpVVb4Q7kNvwGZDCed&_nc_oc=AdrPDcNq1obu-ZjhypF10xsJjUS8nL6eRZol0BGjx0Hknkpp0xH4ySY4zLh5bVqgBLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzX_5TsQt_7t9Go4CAErutDDoy58rPcmzuGSsLzVJvjA&oe=6A6CBE5F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcHherzx9a8Q7kNvwHMadV9&_nc_oc=Adrv5OTOvN7f3gGx_WwfPEkS2i_H6oRlQ-2DJpdy_B-4a89hp5iu6ofHhGHHow84tpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdorUxc5ykxtj_Jiuqo0cjlK-FE-Qd-32EJ0VhBOx7ZQ&oe=6A6CAB9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/LV2VR/", "developer_terms_of_service_url": "https://www.facebook.com/LV2VR/", "publisher_name": "Level 2 VR", "support_website_url": null, "website_url": "https://www.facebook.com/LV2VR/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "HORROR", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455965746011061"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138840_1076286759050999_763588409_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-Zy5QmiLVgQ7kNvwGvH2rX&_nc_oc=AdrNwNRgCiQfcK71NnMH-Mi-XVwlLjvCXdcbtulzkobnHl3dYyBIBxnV6QJWSjLR1e8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpNs_hiWnkr1IsahSxCx0a7jNKcDc2TeJA6xzKqzthjg&oe=6A6CB3FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deadhead VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450944000, "lastRevision": {"nodes": [{"id": "1011528915559204", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1239373126088846", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"n
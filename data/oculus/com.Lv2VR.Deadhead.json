KlZ6BDTqPQxCizf1OK41Kul9SGNBknIWtMVwXgMJep0_nr5bqWjmc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BK7JFxhzAeyvghtoN8MoGV9A9vf0CL-mEPB2H-bqFLQ&oe=69FB43C5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qef0BVqQFY4Q7kNvwGUo5-y&_nc_oc=AdrTzNzkBufHtuoSh0ED80kqIBNby4KxDdEpU0fiGEa657D_G0FoDf5VrkloH_7HZgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EEcCizJKmAVbrxx-3O0sI0uTogCCK7DCLgGutHLWL2A&oe=69FB5D5F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxD_06JFm-8Q7kNvwH6qvvu&_nc_oc=Adq7YJHWmWu6OekX0JT19LZlgjnj9VpI5h0hSd0tTlACCji4J09Y6GE03S5bgF8nqZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JKsPJFOPmruCcKzfn9Edy8n-n6WymlNM9GIeUrNRAOw&oe=69FB4A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/LV2VR/", "developer_terms_of_service_url": "https://www.facebook.com/LV2VR/", "publisher_name": "Level 2 VR", "support_website_url": null, "website_url": "https://www.facebook.com/LV2VR/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "HORROR", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455965746011061"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138840_1076286759050999_763588409_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSNf39fdLt4Q7kNvwFkgngA&_nc_oc=AdpQjvFB_ZrEcRpTqhXe2It0rkOrOcy_Ml_ReZOSQ0aSnHI-2zXlBKOhFF53tQ555m8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pyA6K9dSvwUZ-i_9Xu_QfYYnsQvSuOmKPnKP_zyBECA&oe=69FB52FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deadhead VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450944000, "lastRevision": {"nodes": [{"id": "1011528915559204", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1239373126088846", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"n
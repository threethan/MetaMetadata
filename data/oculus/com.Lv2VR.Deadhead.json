-atl3-2.oculuscdn.com&oh=00_Af37fr-guQFV0HrJGKqi9Y1NJxja3H0u3utZqnP0PZAwxg&oe=69F20945"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCGesVmZmXUQ7kNvwG23eGO&_nc_oc=Adpckw3x5d18ej4NZn0AImwAhBpTCB2a8u9X1OfyvwXIizzXmv0bH5xyKOM47CZVbmk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vpnxH-7tZMrqDcz-KtQIr5m0z1JErflv2QnX8JPcjew&oe=69F1EA9F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AEeUsrVr8EQ7kNvwGJHdXD&_nc_oc=AdqkL-bdNVgLsckcRZ9x_GiH130fNnOjz6pX5cAjPqOgoICgpVamyv6UXqH9qJ-zYxM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vgrwY2TnBfapGznZ1Bt__QOV8hYQofN1Huoyis7YeMw&oe=69F2101B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": 
nGozmegm-TBTlH6SSX4-__U6qMd4NHjyLorjBGRYdqrU9dh4mm-Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UNnRoaEED0LKkv8okrU2yEP2qhNRtb_-pvh8hl49eFA&oe=6A37E8C5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z_YXdW_NpEQ7kNvwHMez_c&_nc_oc=AdqnOPYXA5VG2hVncAI_bNeww3MduNNEVo6tpRnqCpqO3_TiRUyzJkUOA7ZXwv0KNHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aksFIoR40SA3zR1o4aMtwngvkjLiXb6yTMlbjA_Eijw&oe=6A38025F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGsuQMPbmasQ7kNvwHj_zv7&_nc_oc=AdpMKRgqGaWVfMyxI_hFVRsdF_eKXMyUml14-jAaTje4wj9kKOrVtiA9ulE4lAaULNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TcFyw5YiUx732hDZdMiQaH5WpOxZ-hspjmXeMD1bR6w&oe=6A37EF9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
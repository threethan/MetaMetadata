igrated_image.png", "id": "532568754306702", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138945_438806592985304_767396154_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa2HOQBJAr4Q7kNvwHyEc_L&_nc_oc=Adqk9ZlqoezT1be9cbWZ1uutqcMeOWccgq8okMt9U7OvQS5SbxmPdEpDswK_BViIU7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRcNvXLu6pXjRTORHMNV71lhYDGpxy52JQhwPmgHEhyQ&oe=6B0B1105"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9Tq5G8h9KwQ7kNvwE1K-Lu&_nc_oc=AdqdQkS9ipl3mDrm-WO5REBtzTIZFbAYQ44tCYX8RscjM6JkL6KVe1pAYpeC9cgBl80&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWWm2eYWGLU786SXBC9uTUMN88zx91GR0caQlW2CFN7g&oe=6B0B2A9F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGWf26RQ6C8Q7kNvwGdISvu&_nc_oc=AdqUQRy7RntYZoUZYqcfPpXeFfY-VMMhILeJPyq_zepjsumJ_xp8G-U_wlBhDHQ8V2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ832Y9HVS4qm3MWkyjLK2e0CTNQs45p3W26WJFyqJCtg&oe=6B0B17DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/LV2VR/", "developer_terms_of_service_url": "https://www.facebook.com/LV2VR/", "publisher_name": "Level 2 VR", "support_website_url": null, "website_url": "https://www.facebook.com/LV2VR/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "HORROR", "SHOOTER", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455965746011061"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138840_1076286759050999_763588409_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfGqdY7lov4Q7kNvwEQ435O&_nc_oc=AdokDMaZfXjHv8yoP1Pf3NynYYVNgrpL9SBzSj8UmfT8JaWxdzlO15ydr_ISNpsyWo0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqGTCppg58Zn6GOfH60gaAxYOJKGmJQ1nFNWHqbgpMog&oe=6B0B203F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deadhead VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450944000, "lastRevision": {"nodes": [{"id": "1011528915559204", "releas
b7TQlEPCy7d0PMjqYZ95kdko4dt0y_g4s7w&oe=699B0645"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DfTsYNPNPEQ7kNvwHKyEwd&_nc_oc=AdmcWJauh4urzIe8tZkEIvcvlZ-dCm3fzN_8bmkQrR8f_SWpRd_2v_CRcguF1M7Pog0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfukEXIQQj6w0W7jUkbTVOiHk7Frqh7AEX5c9zleOm2OgQ&oe=699AE79F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANhyEABdx-sQ7kNvwFmiEgT&_nc_oc=Adkgur74VIoozBvg4ZezyxiPuKGuUXCk6rsSmrDTT4Yecn435YX_tXHvVEJdqcGGmJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsChmxdogty0uxSOdiayJyIximpigBbaI_95JPFRsw3Aw&oe=699B0D1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how long can you survive? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/L
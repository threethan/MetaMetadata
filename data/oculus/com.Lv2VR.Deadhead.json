2-h2Y7uNHd1K2Jn-d18LpCzcn1hDBXEsxBGa_E-ZQln8YDffOyQnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE4bErrgjTihb6n7CYtvcgm96UZPjzSg_MIS8589nA4g&oe=6ACE33C5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2px_hRI_zeAQ7kNvwFv3Ctp&_nc_oc=AdqzRFHDA2cw7-IodeYlXDSOaAnMt8iBSLKC0YGDuuQMmniK5EfcYbGqGVVL2Mrl0mU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyVrQBzugh7hbmZYwYVUFZqgFWqaFbASFYhDGqY6qboQ&oe=6ACE4D5F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YwBOwTk9RsQ7kNvwEwCJBY&_nc_oc=AdoScs3YgAgCC1t_vPpzIGKE7yAK1vRmEykY5-v8lXedXu_q6Ck8pyna64AxFj0dFaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPlFFb1fkG3fflIapQPk-BK8NNGJqIMf2p4Nqk5sPgbA&oe=6ACE3A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
qKA6P3Qu6Nd1FO2uQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ822FVnn2PGfd5Zpp0cLaL5y034VEURrt_QNnPC-fkA&oe=69AECCC5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV2cNeBQEp0Q7kNvwGGYa3r&_nc_oc=AdnoWVzRRYNTsO36Phlrgw6nh1S6Qfxy4mJCpySXTdaNKaO443f-igcjbBtC8Z9yPTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx2u3Y9cGajQ9B3T_EyN4LPKkAp19DLuvnC3Spptwsag&oe=69AEAE1F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuCrpsiMb6IQ7kNvwHrw3Ey&_nc_oc=Adk5j6rIyYkyFmyLJ2yqVY0fQbMhovm5Obe_dJlUGXTv69DgwtalVSIJ67iEpSo4zSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlSi3_FQDLT89iud2I5qKCUERB_cKL9D8ZIwDQ0EV0Sw&oe=69AED39B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arcade shooter. You will inevitably die, but how lon
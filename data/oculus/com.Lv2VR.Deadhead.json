fIOBt1IZ9PGvbSkMlzUiwyORhWzSAgnC4oP9U1dkIN37FAQf7HdCA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02oyGLU1euoFBYYe33qOaNWahRzM2tyhaJQ1Z-_kQ2Rw&oe=69E62BC5"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE3BxvLR_-sQ7kNvwESLh3Q&_nc_oc=AdoFR-iJzTHrn9Oni_JTvbi18fW-2kOvy_9yVZAgAzl7OJVCb9dyzUErV5uMdDsE0ss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U10vGkdPav4Oglwici5A5xlN0tmhuPJqbiUDZxKtYag&oe=69E6455F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPJ9qGosNJ4Q7kNvwEKnjZ2&_nc_oc=AdqBUTJOza80LWwKR0Cr2kVZXNFkHRvLRZv7bVxme-AkzQ759lEzRfOAgCyL-xJW6mU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wRco6OiwRYmT8YM0Hrs640KwsmhQ993Uunk_UNrbjUw&oe=69E6329B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
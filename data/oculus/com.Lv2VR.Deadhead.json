g1lwXGyqZI4Z8An53KBEMXjgeNXeMZQGXkeVtV2p0wlNI6kG8ORuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0RlUP6GrREb0iK33Hzz3exgOLVMYwin0BF0bBMJ2U3Q&oe=6A733C45"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBMkIpMhstQQ7kNvwESfAyv&_nc_oc=Adpa1sHL609u-PqJaZ3hepUxd6YGC3ljz1W6ouCJX6g_WN-qzbTSXrYn7euxL6B-rt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNdqy3kyhvt6ItbiOkU-1usSnnwuv4J-N5mnvVFlPx6w&oe=6A7355DF"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb010T5qJ48Q7kNvwHeb3Z1&_nc_oc=AdqddZZwhyIDAMnDMFOj7QUvQws1mtszSodkHz4-RkO3i_UX9QgnEW12ID79egbaiCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8xA9lTNoEuQv5ID7Y54deuVTbcpinKgIcnvC2FLpKhA&oe=6A73431B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
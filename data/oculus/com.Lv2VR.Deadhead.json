dN6L7MtI1mtChzCaB5AxKyZhkJfN7Vj50a_OcTTIl_n5zTyHtUovU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzM8zal7aZ8xAfEd8mw8sjHEtf0WKHmvWYF9l3scQwvw&oe=6ADF5745"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LfCbn26R_EQ7kNvwHztmD2&_nc_oc=AdrhvFYnpEcVGc_tizyF2IMqZ56H4e5Ab4WVaL-VvIycBtNhmZb1-ihatW4bFbHISV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxtpZus3qajL00RiGEl7FNVS1ctdNeW9w0iJHUmmllVQ&oe=6ADF70DF"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx36wesETSEQ7kNvwGio_oy&_nc_oc=Adr61V715B8qn9joIDzUNidBnSg-0PJ7sw14JvHAX9dQJwhR7MuqVmwpRH5kPo77gbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPloYXi8lLy62rzVchb9ackL1AVxzVVjnv92h5o1bs3IA&oe=6ADF5E1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
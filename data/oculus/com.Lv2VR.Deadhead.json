o2sOB7Ko1ECUeWdXNjF3zGQDAtGvvZJ-jkIlT8EYkoOlGV8B4p2jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cTilCV3Ut5Xfbvp0TXLMOJV-AEiKCOsfLrFK5VTdhsg&oe=69EA2045"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVJAIgmpInoQ7kNvwE8_6FX&_nc_oc=Ado0eLUwcj9izHEnKbog9uIDoiWlvPERlFj8WSBFsffkEJhTk_rOhSeO8NqheGMWvPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DiHR283Q6dfs4RCSQ3nHz2qWiU9m3L5Rb9toHSR9_fQ&oe=69EA39DF"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVsSozKRj9cQ7kNvwEnav4N&_nc_oc=AdpOZf4DBc4L7ZYRaxFwRF66m6gkcc3Cgls2zX8VCSiSBaMSng-8upLNgcJ2ZWXlmoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gZvrgUa_epDF14ri0TATxlx0POlrrgJGz0CJGNIUlfw&oe=69EA271B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
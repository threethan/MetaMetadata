ywSzVEJ7jVdZXMJVsYVhTcHG07gJ4_9FmaTe8Jx8RIULCvjmGUEls&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRbkvG5av27J5c1ZIMHnv1oT5AGOBsH35wgqSaa7hYZw&oe=69C53645"}, {"file_name": "migrated_image.png", "id": "830146164121878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138853_1482349018762448_1360026320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqR49enjyhMQ7kNvwHBoB9u&_nc_oc=AdrKLotFV4LKNnEgYrWWs5Oi_qNMdBhMw0_bUg4RDFOSQ02d32blP4kdE9QNJS0dplo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyueeErHXasQkI9PwWTvV2w40ZCpb47hV_e8PcJaVKKlA&oe=69C5179F"}, {"file_name": "migrated_image.png", "id": "544983129465947", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138853_1479861728986817_626868105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFf4FhdNqOIQ7kNvwFawzwQ&_nc_oc=Adphmk9DmEk6u0B1MXxemNVnXlzyocI3eciK-L3pl7z4QQXGSYv_jNAdAc_nFP8OBDs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAQSd9kHMky0IEOlvlzIjzWHfaRSvtdt74wuHkrU84Dg&oe=69C53D1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadhead VR", "keywords": ["FPS", "Texas", "Zombie", "Arcade", "Steampunk"], "long_description": "Welcome to the Battle of the Alamo, but in this fantasy world, it's the apocalypse. You are Monsignor Saintiago, best shot in the wild west, you wake up from the rubble only to find the rotten corpses have come back to life to hunt down the rest of existence. Skulls rise from the ash and come to your aid. Destroy the rotten.\n\n-Unique companions, unlock all six of them.\n-Five weapon drops with expendable ammo.\n-Level up your soul types for unique strategies.\n-Killer music tracks inspired by old console classics.\n-Procedural generation creates a unique level every playthrough.\n-Voice narrated backstory in English and Spanish.", "short_description": "It\u2019s safe to say that no living soul can click fast enough to blast away all of the enemies in this throwback arca
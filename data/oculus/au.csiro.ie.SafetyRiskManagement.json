iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVLy09l6s88AJm8r880-iCzIbxmpgajQ8aFOmmIcdAg&oe=6B01E259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "22-00433_HSE_Landscape_SafeCoVR_220824.png", "id": "1801657256840757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031618_1801657260174090_3905271283469526809_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSBDrLyossgQ7kNvwGyzcPP&_nc_oc=AdoAWEZE9DH63Wx5ikui-LBmMD_JNRsZZ9EoefIJ7j6wvigK8-DwOfWq7J37X_Tl0b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqInEpnA9usrsiqkSswcBG540MTwNLvhow1Yody7d2VA&oe=6B01BC15"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https:
sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSINNDLqMmnRVsUTh5aDiHTGLpbP5h7b7ZPd85eb4bc2w&oe=6AFC6419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "22-00433_HSE_Landscape_SafeCoVR_220824.png", "id": "1801657256840757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031618_1801657260174090_3905271283469526809_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkdNrtUx1xoQ7kNvwHOCRDq&_nc_oc=AdrDOPg8o-qlYWvnQpkXyyRn4zZNycIar_0ez-TKJprYgrlGoobhpDDDgKXl7W-qlEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS--bT2NrgA8YLGKbpFXxOLwa28M9qh9NK63DMirbRL5g&oe=6AFC7615"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https:
04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-gx7NOPV9AQ7kNvwH7NJah&_nc_oc=AdmQoPU_oOveP6Nxndo6KOe2Ht2-q5o6x0dpVy_h2qTuQbFoXe3BdW8G7CAgT1Zxi10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQsqUXGz8XUH2CSqSAYxTbL3iP0zq689ziek2akn2-2w&oe=69B69B55"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Terms-of-Service", "publisher_name": "CSIRO", "support_website_url": null, "website_url": "https://www.csiro.au/en/about/Corporate-governance/Enforceable-undertaking/Safety-Risk-Management-Training", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}
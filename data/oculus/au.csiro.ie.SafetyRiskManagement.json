1-7&_nc_sid=6e7a0a&_nc_ohc=R1n3l57GWxQQ7kNvwGtBOHt&_nc_oc=AdrBr2WuYKLas4r6Rb7NETgrPCm7Q2pCtXpYemp0-DqyV9vHJn8MqVjU7JqVCxLCX34&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fhGXaCOIjoAAg94bX1vHkxhtEx7voHdlDnNxt5tt7wg&oe=69F491D5"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Terms-of-Service", "publisher_name": "CSIRO", "support_website_url": null, "website_url": "https://www.csiro.au/en/about/Corporate-governance/Enforceable-undertaking/Safety-Risk-Management-Training", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "
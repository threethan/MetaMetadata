iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgu_bwRH95tFcyekQ9gZSXIZQdVAa3w4DG_mGwu8Kbmg&oe=6B0C6E59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "22-00433_HSE_Landscape_SafeCoVR_220824.png", "id": "1801657256840757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031618_1801657260174090_3905271283469526809_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od7nv8DyN-kQ7kNvwGIda-2&_nc_oc=AdphbxsW8n22rvDYnTPmlaIZLSk0hsuiQNVCJE7U5n5XiwMhxSZ9g-D9_hEFGL5BotA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP7ue0e7XGEUzP1mODiG28rWvQG0_hDUhAGx9gBGcZqg&oe=6B0C8055"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https:
ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzOmf86lshAoS3dGIZVHCx-MSzpj-28xPsAIBgkXNSWA&oe=6AFDB599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "22-00433_HSE_Landscape_SafeCoVR_220824.png", "id": "1801657256840757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031618_1801657260174090_3905271283469526809_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkdNrtUx1xoQ7kNvwGIc1Aw&_nc_oc=Ado6F99ruY-mgwAOjwfy-33CWQKqaxREtkaV3v4V4Q3RROuTQwyfpzIHv06MQ7koLyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi2rRdBO2VBb5dkWgwZj3Uid0-qigoK0DUsnC1Hfqp2Q&oe=6AFDC795"}, "display_name": "SafeCoVR", "keywords": [], "long_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management through:\n\n   - experiment and facilities design \n   - plant and equipment \n   - management of unexpected incidents\n\nResearch institutes and organisations located in Australia will benefit most from this free training.", "short_description": "SafeCoVR invites users to test their skills by completing safety and risk management scenarios based on potential real-life incidents.\n\nSet in a laboratory, users will gain a practical understanding of relevant control measures in action, including the consequences when the control measures are not implemented.\n\nOver three modules, users will consider safety and risk management. Research institutes and organisations located in Australia will benefit most from this free training."}]}, "developer_name": "CSIRO", "developer_privacy_policy_url": "https://www.csiro.au/en/about/Policies/EUVRTraining-Meta-PN", "developer_terms_of_service_url": "https:
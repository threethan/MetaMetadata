79_1557777182429909836_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZLl5-6B68AQ7kNvwGvhwaG&_nc_oc=AdpnWG2BM6oNIl8unj_tP2WlY1O3mqUmcXCaiKjEhUNKGZYgBYngKcbIOUeieOLrdfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0mkNsa704zZDQ1LX3yd2a8_dZUZ8ByJePR-n1VMGL3A&oe=6B0EF7F2"}, {"file_name": "Design sem nome (23).png", "id": "1638538954640796", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604310912_1638538957974129_1141426936909840121_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdEKS7NHfRkQ7kNvwFBoiqY&_nc_oc=Ado3Mh8promIsbrJIlptwvxt-4y9LFLJhHfk14_vKxn7pl5uATq2fDwbpQAjYIrPy7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUD2Mzas-8VgufXXZH344pMa8atCsztPKTOYzXJ3iXDQg&oe=6B0F208B"}, {"file_name": "Design sem nome (22).png", "id": "1428363971955045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/793139181_1428363975288378_3303008038376938385_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3khkQH0chxwQ7kNvwH6ma7t&_nc_oc=Adqeo9sIcDhgiPJn_Ggn0MYPY0SoihA1fhgnVPI4AxPZH14NBplgRO5ygzTBkUb1Zpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQsiDuPIj9fvqnDkCZfoMDKSaqrH6zxE2eSq5o2qe6vA&oe=6B0F077F"}, {"file_name": "Design sem nome (21).png", "id": "28927289076887155", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312422_28927289083553821_3244088598321837487_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLURXSzPhJUQ7kNvwHzBd4z&_nc_oc=AdoGkvECspoTuCX4NevoU-qh4Jdgd7Ke1HXOZ-ZCxl4hZ5fDlH4TGCXWTtfyUWpFpjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVdWtT_GZSLh9nXb5SbhYOcFNjvQg_vipCifPTLCDckw&oe=6B0F0428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Thera Trabalho", "keywords": ["trabalho", "emprego", "entrevista", "autismo", "psicologia"], "long_description": "Thera Trabalho \u00e9 um m\u00f3dulo da Therafy que prepara adolescentes e adultos para o mercado de trabalho por meio de simula\u00e7\u00f5es de entrevistas de emprego em realidade virtual.\n\nEm um ambiente realista, o usu\u00e1rio participa de uma entrevista com um entrevistador virtual e vivencia, de forma segura e controlada, uma das situa\u00e7\u00f5es sociais que mais geram ansiedade na vida adulta. Cada sess\u00e3o pode ser repetida quantas vezes forem necess\u00e1rias, permitindo treinar, errar e evoluir sem as consequ\u00eancias de uma entrevista real.\n\nHabilidades trabalhadas:\n\n- Apresenta\u00e7\u00e3o pessoal e comunica\u00e7\u00e3o clara\n- Compreens\u00e3o e resposta a perguntas\n- Comunica\u00e7\u00e3o de habilidades t\u00e9cnicas\n- Contato visual e postura\n- Regula\u00e7\u00e3o da ansiedade em situa\u00e7\u00f5es de avalia\u00e7\u00e3o\n- Iniciativa, escuta e turnos de conversa\n\nO Thera Trabalho \u00e9 indicado para pessoas com TEA, TDAH ou quaquer pessoa que precise deste recurso para se preparar para entrevistas de emprego.\n\nA plataforma oferece relat\u00f3rios individualizados que fornecem dados comportamentais como contato visual, movimentos das m\u00e3os, lat\u00eancia de fala, interrup\u00e7\u00f5es e an\u00e1lises geradas por intelig\u00eancia artificial.\n\nO Thera Trabalho faz parte da Therafy, plataforma de realidade virtual e intelig\u00eancia artificial usada por psic\u00f3logos e cl\u00ednicas para treinar habilidades sociais, cognitivas e de autonomia de forma imersiva e baseada em evid\u00eancias.", "short_description": "Thera Trabalho \u00e9 um app da Therafy que simula entrevistas de emprego em realidade virtual. O usu\u00e1rio conversa com um entrevistador virtual em um ambiente realista e pratica habilidades essenciais para o mercado de trabalho: apresentar-se, responder perguntas, manter contato visual, lidar com a ansiedade e se comunicar com clareza. \n\nIndicado para adolescentes e adultos com TEA, TDAH ou qualquer pessoa que precise deste recurso para treinar entrevistas de emprego."}, {"images": {"nodes": [{"file_name": "Design sem nome (39).png", "id": "1646991697168240", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_1646991700501573_8084244245119253720_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM5xZCpSRBEQ7kNvwH_6IoI&_nc_oc=AdoLlkzpfAdFvuf-1Dtet48jVULdDfuN6RdFl2nUjc8Jp-YNVHN-cub_pTUbDAt4Fbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWu4odIA1E8OF-xK9KJYADkJ8o0-BJa4mU7J8vskzxC8g&oe=6B0F1E0A"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1620781473079841", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673716021_1620781476413174_6263027131848936522_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Rf-u0rgKIQ7kNvwGz1gvm&_nc_oc=Ado9zyUQ7ySaeg9vvDSH5l5u4qaodEc3k2hS-M21-vfeUua5LVXTA4ZaTYkz2S6UlsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVzUlAk5XJa1UBCJJqIUQv66s-zYiaGPxYWpy2sD20jw&oe=6B0F0C02"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1144895081409800", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_1144895084743133_968225751514458907_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ0Z5gngN50Q7kNvwFbX_6b&_nc_oc=AdpYZClX9YqEhM2BrGQIo7qobt_x9BdZZiCzAD9MF1Ssv1be3MqD3OGz0P-qMzUvkZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4ZJfnnxNgM034_4w8EbuOseXMMKngZ4f8XFU-8imzsQ&oe=6B0F049E"}, {"file_name": "Design sem nome (28).png", "id": "1113824207961756", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303976_1113824211295089_1091859266962238459_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibvOAfBv_6gQ7kNvwHt3FWy&_nc_oc=Adoo1QrOnia0adteSDooq2qVfZQDVNdnlkdxRPwO_PIXkusiDm-Dj8PxVLdKU9YiVcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculusc
_dr8-Q-hacLFPPt2I9QKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVO926F7IoH9yupWiyqHit6FpdBhXdOz2cf8UYh4Dl1og&oe=6B0F0E6A"}, {"file_name": "Design sem nome (25).png", "id": "1644641604125670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307444_1644641607459003_3418703402826645879_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-NmOsE5NMcQ7kNvwEliDjV&_nc_oc=AdqhVkpdh0WBA7cYOoBGYohGYJtqidVqsOWl57mVoM2cPeu97f36PkhYr5Lgows81MY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyoSLB_CMnrFlCWam7nfUs4MIdTQtVaEq2-dGVSab0Dg&oe=6B0F187A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Thera Work", "keywords": ["work", "job", "interview", "autism", "psychology"], "long_description": "Thera Work is a Therafy module that prepares teens above 13 and adults for the workplace through job interview simulations in virtual reality with Artificial Intelligence.\n\nIn a realistic setting, users take part in an interview with a virtual interviewer and experience, in a safe and controlled way, one of the most anxiety-inducing social situations of adult life. Each session can be repeated as many times as needed, allowing users to practice, make mistakes and improve without the consequences of a real interview.\n\nSkills practiced:\n\n- Self-presentation and clear communication\n- Technical Skills interviews\n- Understanding and answering questions\n- Eye contact and posture\n- Managing anxiety in evaluative situations\n- Initiative, active listening and conversational turn-taking\n\nThera Work is intended for people with autism, ADHD and anyone who need this resource.\n\nThera Work is part of Therafy, a virtual reality and artificial intelligence platform used by psychologists and clinics to train social, cognitive and independent living skills in an immersive, evidence-based way.\n\nRequires an active Therafy account.", "short_description": "Thera Work is a Therafy module that simulates job interviews in virtual reality powered by AI.\n\nUsers talk with a virtual interviewer in a realistic setting and practice key workplace skills: introducing themselves, answering questions, keeping eye contact, managing anxiety and communicating clearly. Designed for teens and adults with autism, ADHD or anybody who needs this training."}]}, "developer_name": "Therafy", "developer_privacy_policy_url": "https://drive.google.com/file/d/1i5vYCIRWLUUeQsmUm1hR-MoLnV0WrlkU/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Therafy", "support_website_url": null, "website_url": "https://www.therafycare.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1719919915944658"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673716021_1620781476413174_6263027131848936522_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Rf-u0rgKIQ7kNvwGz1gvm&_nc_oc=Ado9zyUQ7ySaeg9vvDSH5l5u4qaodEc3k2hS-M21-vfeUua5LVXTA4ZaTYkz2S6UlsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7q2K8-iZ0ynpKPR1bH0aHMXpaEtItsQYTqf8UmOhwgg&oe=6B0F0C02"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
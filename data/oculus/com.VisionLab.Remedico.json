tent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzgAJ61S80Q7kNvwGr0mI3&_nc_oc=AdnXL-tF1cnWq_gJom8svZlmuSCOwm8regUy3TQH_KW2SMEU9FOn5Fi5Qq6bG9T6Jog&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft7OjpbCB6ptZyH4ZA6MPs3ki83HF8ZH9mWJGrj4k9rQw&oe=69A18FB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuztNoXhaaoQ7kNvwE33_jS&_nc_oc=Adm9MKRdZvHmDjWAE4CPuHMo38nxrL3RLf03p29CuLk0pwmBylh-gS50WHPig3RbScw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu0pkaqly1wJT5r6-AEr8t2Q32KSe2tCTaHTZnirMZgKQ&oe=69A17AF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXG_Y-LE4QUQ7kNvwFnehL6&_nc_oc=Adk63jCqoG08U1eBls_C6UbaYWN7ZoQpR1Qq5lNhnYc1C2SY9yPIxR1Rg6Clrnmi2JA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsk7tpCzkELU0laFc3F69f7wE_mM5LnPPCzwcSEg_vXAQ&oe=69A1A2C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzJxicXWIMIQ7kNvwG1Ym9q&_nc_oc=AdltaotvtjDXynUZ78b-BvvnqD7OGcGiNuPoDiWDH8CFWRgphm9x6BAVCAqDKhy6FdY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft4aDl0QwzhQxdsQ4U-fBR_PQDIVH0x7ff4gyoNmSveGg&oe=69A1A7B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCDJdl0fObAQ7kNvwGionkq&_nc_oc=AdkU60FXMlA93TOI0S6ziBHfKcUTMd7apARP9KaXrI1aIuN8qjZR4VJXDPXTKbPYC00&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afsegp6hC60RxPE94LEEtUZVo60qkFcP_UkdikuDSRyCfQ&oe=69A1A89F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
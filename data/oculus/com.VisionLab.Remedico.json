}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Q5Zjrl2NkQ7kNvwGTUR-l&_nc_oc=AdmP_tqeOIamR_pE7rnuLMeqKgbNhGKMhFdA35zJybfQF6b5OI2vOzJV46lHz28nygk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGOy3gx659ShMhKUBRgywYEo0gY4UnybeEASkhwO2rOQ&oe=69B01036"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peyjbyM0oDYQ7kNvwHxQzYb&_nc_oc=Adkg4vF-zfcnA0C-ABeMnLd59pHkYCsy3YljUmZojK-0AHxyPVVX-dsPhWvWstzDOoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjYJ72wxEJW_gJnMOcf1I8B2vssn9goU39SI6qlrULWw&oe=69AFFB73"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M13uV4gFEY0Q7kNvwFBcPUu&_nc_oc=Adke05nozXEsnBEUuhJwTalvnqxW8tpg00gxaS7hpo1qnHEu3TBxwdFWM08gQtl9A1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXatCb8M557RoR2MHaZ5YqWg9WWd39ndusvTRUPv_n0w&oe=69B02345"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QY0fb71BiQQ7kNvwGgkgxa&_nc_oc=AdkT9Yv0XVlVvsmQO76eKfYGlBSwKMI3CJSOt2VbARV9pZgWU0pQRHvvmO7RNfF3Iak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwScS81sXfHaYEXhb8RrNMQBG4ITyQwlb1tkbqhCEfAKQ&oe=69B02834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npksgKzY7ZEQ7kNvwFeHGAH&_nc_oc=AdmkxrZ92cqqrXpB8P_FdZj5VRFyCtYxPWcwg8F4RjgdzQkWlaBzXl2tljwbLVzfcBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuhRBTJToF6yMoLkqyodWO0Nf0UFKkAvo1dRKh1dKE-w&oe=69B0291F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
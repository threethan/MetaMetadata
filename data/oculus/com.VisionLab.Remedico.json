}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwJDc6EU5HEQ7kNvwHTweoa&_nc_oc=AdmgPvxatr9ij0cZfKE8Z1aLKeZCKsaleTTBs5OVTh75GhnuVzyrN8rCZK_uB55uA3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGX26qjStQDTUJI8lmEyPvqSkoes-h6hCWXKd_hIkWlA&oe=69BFE236"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgUpGaVA2ZkQ7kNvwFKEiA8&_nc_oc=Adk5KDAY8PzpLOOSeAmB16zgl2SclKqIRn_k35rohSjt0aqKsmr7Adj3Zk5IYEMMhGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfytfrANjvhi-S0gSjcVJfougf0jS7Sa-mBcrm96PVd8ww&oe=69BFCD73"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxqVljYEutUQ7kNvwFEl_n-&_nc_oc=AdmMgyATajXvboMgxBOZoc26gVOmjOl0vg7pQsR35uRqoDhRqtj-FERPcb8osWVRuSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVAdo57zJA39Hg_X-nIBu0cAyKdaoxAWIW9QPk9OHuXg&oe=69BFF545"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAsu8htU2FIQ7kNvwFgOs3l&_nc_oc=Adk9_j2bK6S6hcppG2GwEpjqGazdEktMZeBSjvMu0RByhQG3GW8EoPeVqhK_Fw_B7wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygZxnipugM0g6jWTXRfDlCOBhlm4VnoPg8WPyB3sNAlQ&oe=69BFFA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPfD4druYCcQ7kNvwEOg2K-&_nc_oc=Adle-JHTIXPw-Bo7w1d64yLrUVQ-pahKnxd80FSMSbprUF-WNO-CpKjCuMK0hgRK3Ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1_6EgmZrF6CtYc_SuHUGSsPkqjfgpMatdmLi39thRFA&oe=69BFFB1F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
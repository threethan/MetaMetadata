}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0h0JjeN2ggQ7kNvwFajVAY&_nc_oc=AdmXP_4OK-qb6TcpZAvXrIcH9d2YGBEyJuVsLk4VAc5b7o1C6UsdE6f-mJcb7e80lZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC0rd67-AwOGPybOl89Z5ZFBXRqhgitIgGZ2kHy6ZeUA&oe=69BA9C36"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-3Q7JkjGCAQ7kNvwG2BOnh&_nc_oc=Adm_UZlShlYFD5e93Q01EVxo2Pd1r9En2DDlXbUmpfcYQQRdg8ui1r5GucN0TEVvM6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1HM9JTA4HfsXXZykg7_wkeKeO8GwAU5Sc6QWB3BM7Nw&oe=69BA8773"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2hUg9GDUKwQ7kNvwHi5x4K&_nc_oc=AdlWpyy_SKaJAkSsFsa7qYKxfc8SyWpWh3arSEi_uXD0oC6IPc92AHreCbXqmHFlZSs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_tAIGXHp9HAfXc6Ex09NuGlPdvpZ0ED6QDn1VqctPsQ&oe=69BAAF45"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv9wds1bN_kQ7kNvwGHYiEg&_nc_oc=AdkyGP8AbHLrmPx9t27sGXi3953vq4BaG9wPkJGTDrO0AAYOP1uyTx12WxvaT2ZXIWI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzoe3lnaguRlnXZyGJHDv96Fcs5794iqCc-RuQ_ijiPyw&oe=69BAB434"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl97h5YR214Q7kNvwGICnRJ&_nc_oc=Adm3MOSn4vp8YEQwowZudS7tIxmvDiNPPh7ZWSfu1SAlxbZAfYyrhciWNy0ws0J5qMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVi7_Tbs8TP81LKOaopr-JXeo5xkzXis_sJ7uuUz8vmw&oe=69BAB51F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
tent-ams2-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pphi2T93EBIQ7kNvwE72kxT&_nc_oc=AdkOJohPpcicyDG02MZGWvDX1KJbdgu5HBzjnlfl-OZpTooHVOVHPIo4XK69x6luNDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuPZkl-hwujqLwsTA-VowtwpNkbSyAWWZ8NAczO2Ckphg&oe=699EECB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWv4ScP_eqMQ7kNvwEca7fh&_nc_oc=AdnvT5nsojYOsq3hrMCNQXQxZ4P5Q8xI-Y9jtkq1SEOiOz4_ziPM5fpQ3seYZllj_nA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfurDRA9V-18Cq6AWVW50nosCcBBif3OA88fH28OdAPhOA&oe=699ED7F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGkbO4DsC3cQ7kNvwFrMOfY&_nc_oc=Adnlsa3_JF5fkqFqn3E7y9UiDcrC0nTBx9TZ3PUnJQ9gFVLpgPC4psB8F8HVTqRQeKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuqkPEmjeE5cUY8a63cki1gfqOZ06SJNqQRx4gd3l_ZLQ&oe=699EFFC5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM1wLxqlg64Q7kNvwFOmZks&_nc_oc=AdkqQU2dghgU2fJfEdhTRen9LO2BfLeOleRrUDFFH50RwyEtcqk-GRwULVxDNKtYtEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIJJ6unwVpWeJDJ4iSC8rSbsOhUGn9MyOEpJDVAaxBiw&oe=699F04B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCDJdl0fObAQ7kNvwFYkchR&_nc_oc=AdmtyIzLQx0w3NkdgXiTX5XUHoBRhtDce5wXrvnUoaGfKtBmtOxgzMisBzfviAKvjqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_Ekhp7cZrRODOHgKXRyWgkc-90FXPynOyjTBsU8wIuQ&oe=699F059F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
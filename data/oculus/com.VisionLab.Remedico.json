}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0h0JjeN2ggQ7kNvwGP4IFP&_nc_oc=Admz2ZMM0C36oFbb_cEoe61LPwz4ZuXrIw0XvzK4zBnCZ183xECXhVD39OuOSDjgPfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQ4qt3Pt3KA8O-AGYYOXdMHiLu6AtTHAERbgX6D9Y6Yg&oe=69BBEDB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr96-kJ_lCAQ7kNvwFIHu9B&_nc_oc=Adknm-Nn4Z09QE9pLJI9B8t0so9D_G0fiH1pB-HcCU2ryI_P2MEpDZhIaVtlkLrQp3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwnw2-sl1w8hvjyMeWVcI4Ef6eMigbhYxt9nmOg-yacUQ&oe=69BBD8F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vKLIz_RHwQ7kNvwEEeEft&_nc_oc=AdkCbUxqIzSPtAXpja4dXPthbejVr7igJjNFbXgnwXhsgEmA94N4CR6lB5GCH6kJYoo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmR-ypaydmPJUcO-Ht7Cy7R94qU_BYJzdNpY_HQkPalg&oe=69BC00C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ust5MftDjxgQ7kNvwHJ4T3M&_nc_oc=AdlfvStc5uvn3u6mfZ-0XtoP97lxodu9TVXS8BxBhKJe-7LSi_atzrobVExcCcDNp2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwG7gMlEeiTD-D2FKUCm_6WkqBiPl3fJbe4S_vM2GnAWA&oe=69BC05B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl97h5YR214Q7kNvwEV6FMM&_nc_oc=AdkydpZXeVsJURnQfljEmR0I9Dibd0QdmZ0u5jC310XgwJ_n_C4OP-ZWdyBuwXLYVnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-nrgIGvvAN0vyyPoQmsMKfje27VMT39K5-KcgSfdyVA&oe=69BC069F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
tent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUzgAJ61S80Q7kNvwF8eCE7&_nc_oc=AdlHYxwinelfHV1yvPWWav8T_Lf_ovXfLoGSmOVqKUREMpMJ0KOVNDhEgOkcQdlulXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6KROAlvXtX3gU_bRU936yNUwSbWrJDvDRE30yyp_UCw&oe=69A432B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oePLk5jy8yQQ7kNvwH05Bd8&_nc_oc=AdksNFMwZwigpnPXEiwGfm-qSiUJiRVvbd0fHpUc9fMFANt9NaWAiQFOVn46kNTNrZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvp5BvFfLss0LJihQeBN1F2RpQygtoMEkB7cIpyJeTkcg&oe=69A41DF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOAEZRLZ4ZYQ7kNvwG5rupu&_nc_oc=AdnDIolhF8tyheaJDcNk9VAt36vwHvvi_7WIwX66N4PnGJ8A7IaycquYiMbz61wwUe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZI2CjRmbn_zL7UoLc5ueAD3lfTjdLdOMfobyR6PNb5A&oe=69A445C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufXNCJBkX2QQ7kNvwF__S9F&_nc_oc=AdlJ3qH-f_VIi5LZ8afq08JocTszvJ-rCkTuimeGo1ZO1rU2Ex4iyMuqnsM6CNGosBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs-5QA8XGlzI85CHjD7cksr0Kzs4U8p5L1GJCdN49vZ_w&oe=69A44AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoG5zIJoYCQQ7kNvwHlhbAa&_nc_oc=AdnkfP09lQZqUvVmHvdRYwrpMN7KFCDbnWPiluiQQYE7reW-NOyuPAcAbywaaoD9pg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvW-U1vwm9dFvG0SGGXyBRIpAbgTHR2tzxHq0XtW9cvtA&oe=69A44B9F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Q5Zjrl2NkQ7kNvwFgs_av&_nc_oc=AdkCMfh4VpmRGVEQjNVUXs24dsdy7zCsVAh-7BILCwCPohNUksTcQR1HwoA-0HwFFsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqMS6DGdWID6Sqt2b6ugYhobZqKEJaeyeugfF5NWfwwA&oe=69AD6D36"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28agdOj5JcQ7kNvwFKDoMz&_nc_oc=AdkmwkJKJ3AI_PuVWWoHl6zI7zUv582-TQGtDevkCqh60NyXIp7KBhPJ30jC6oxArGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx05ZKrc7beGt4zTtOMC-XoKoWP0lqrcy0lr_XfHTpn2w&oe=69AD5873"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTBntZf5DuwQ7kNvwE3O7D5&_nc_oc=Adlzc_1dVLN1UA5_UMN1h5QFBXRSDu-DNtY3i4QQ_DTHbNLQcpwNHH4AMkN_Bv8w5cM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpE1b4UuBhpeZJz7SKsUE-NxyV5noACq0LD-JOS4eN3w&oe=69AD8045"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z0MC_kdMI8Q7kNvwFJdek3&_nc_oc=AdnWDSAm7aQJInxUKnfuCw0U7nulI4KAa-8XSvA3SFe2WEre_0yK96gCuOyqxD5SyI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyAngtQbXXwJbRs-2zU6hcl56u2ImOMNrZakIAX-Wq0w&oe=69AD8534"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq5AIIrzcuMQ7kNvwH1DwAH&_nc_oc=AdngEkjRxPS2aQ8HDPYDTcxwN-DTprdc4w6Q8hNqhqRF4SyhEdNxdk524ol5CulC1rA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_mJvnNhur0nSdYaWO2Ya_F69Kf_36jysfQ5SfEnSpmg&oe=69AD861F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
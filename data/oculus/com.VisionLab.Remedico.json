097", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974575_725793559427430_8275926473934160577_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFbk91-VhYQQ7kNvwG2VE0k&_nc_oc=AdrZ-h3AK_v8rre7Qc1hEnz3oxfKc14_ysgM7--VqH0J37Je_5h9E9ZUUGoSa6Sgpsg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUDkmcB4re2UVfKuaOwISBhMi868rVfDzFVvvr2I5r8g&oe=6B0B35E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 16-9.png", "id": "726622369351307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/43997718_726622372684640_2299835366958838159_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSFQHonEEDoQ7kNvwFSVjp7&_nc_oc=AdqrKcbBZkLyzn93Ek_ydwfuX71BIY0NPJH7VVDKKgzK5JVCnTLfpT4klVUfBPHqyuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlxMINyqRo-NaT_E4f7SKlAYMsVo6eZ0aaX1OtRih2Rg&oe=6B0B3810"}, "display_name": "Dentaverse\u2122 by Remedico", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "\"Dentaverse\u2122: Revolutionizing dentistry with a collaborative, data-driven VR Platform for clinics and students.\""}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6883085311804767"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1331522674422136"}]}, "baseline_offer": {"id": "1331522674422136"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1709758380, "status": "PUBLISHED", "id": "1331522674422136"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24920532204300135", "version": "2.0.8"}, "id": "477876947879884", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5736021759844467", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24920532204300135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "477876947879884"}]}, "change_log": null, "created_date": 176122
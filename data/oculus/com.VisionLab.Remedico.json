tent-iad3-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pphi2T93EBIQ7kNvwEHkstR&_nc_oc=Adnzc8xmkEynM9kdUslBtGuIm_sF5KPUgNi8ut5i9HUP35fC7NoS975yr-QOvZ6otXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsx22TnWQ45WLObj01Gabm4t9NSgXWIckvFAmLY6oliwQ&oe=69A03E36"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuztNoXhaaoQ7kNvwHiE9CG&_nc_oc=AdnpPrJO746WCSBBtzffEdE4W5utYlOvm-K97R6t-2f1Ih-XFSmd0N-9TzITg_8zPtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdwymVdzqTt7yWRLicDgqiQf3QbYPIex8URXc_d8Abhw&oe=69A02973"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXG_Y-LE4QUQ7kNvwFuN0kY&_nc_oc=AdmM4aqIfB8QhG03dmInBOj5yj-6D2HarVYnWapppSPdSjY-epz0LYAlJGP7rESUBBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuFULnCPyd-z8ww1Z3bL4SnDEWlM8giZqnVExwSE7-VdQ&oe=69A05145"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzJxicXWIMIQ7kNvwETUDGr&_nc_oc=AdkC0mCPfJBnQzzvrYF6sOCxC8JSCByU9p7yDqOITAzs0uhQMbpQUxc1ZiGyHuUmo78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDWqbCOhwq_kqorACdgzJnhKngM-ee6gREcqLYFZM7LA&oe=69A05634"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCDJdl0fObAQ7kNvwFukdX-&_nc_oc=AdlK4JT6LAvKGLYkIp9NFUHGATh526iKVvxI_qp0bTJMvLJR4hgj5SLXTX8zeSEiAiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afve54wxxZiuPIlj-vQRyPwyZkLE8ghIJImJqJ_gbCLiPQ&oe=69A0571F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
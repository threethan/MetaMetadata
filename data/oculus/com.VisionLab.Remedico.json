128047448443236_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix7sO8rK4DEQ7kNvwGUWvgi&_nc_oc=Adr0z_JejMesxKknY8n-q6YvvOvQ1NWwz8spD6zvyjzIFdXqliWnzYvDi_a7oXIoYMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUr4DWs5nyg4AjYXo2gN-c-YWWt6w9xyaZTmM6TdgMCjw&oe=6B1060F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yx2VUajifAQ7kNvwGpC1hg&_nc_oc=AdqlqcPnC37M2I8d8Z1-VV77guXod25I2RPK-LedQD66TJXg-VKpmwRj9nM-b2ok2So&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQFksGQ-50OrA0-ag_RrIq-4hukjcWB_u1MxmiXOLljA&oe=6B1061DF"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "8720066824773264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272215_1596628877629980_7684927048397764472_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6ZT_7TYfiAQ7kNvwEVdxo-&_nc_oc=AdpDbDm-baBMeQ-fi324-fyU2N_KPcxuC26xc7dQ-uKlMCsS_-5zwjOLwqcrH1fRHqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXm51znJdEWUfL8T8f13HVtDKMep8jM7GpyxDFTQ9RrXw&oe=6B1044E9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning",
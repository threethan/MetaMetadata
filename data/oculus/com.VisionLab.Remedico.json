}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQHHZ6jBO9IQ7kNvwHNfHK0&_nc_oc=AdkEneD4y9IcfUyymCCJO3v5iPuq1ykoFPU5fD-a2LDvSCIGF9OyMaHlN1lRmt4KfGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft-kZcYxiHkO8TXpDelC7lywN1SB8zEMvkfrmuQbEbK6w&oe=69A978B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rH6RO_gPxQ0Q7kNvwEiwbD-&_nc_oc=AdkswMd1_J7h6hTx65BRLsDA0oG2VCksZJ8ryBQlSESzAJpGhTwhzmnXQR9dqJJBJdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuTqT3wi456TXbPfJVg5KabTnlSUBEF5nGMniEuryLXoA&oe=69A963F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT41dT0VZXwQ7kNvwH_PGIe&_nc_oc=Adm6KYwJ8dUcH_Ea118qKPJzMR_i_UliPYaEG-SgnjFnEv3vIMmm4aJ_ir8kmKLwrbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvzCTsq87G6-TZ65--NJsI1DQmz2INzgN-FBeVTptICNw&oe=69A98BC5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdDVIuUlZd0Q7kNvwFuxH6H&_nc_oc=Adki__weOpe13YBwOVo2fApoigBvx0MXffmnPjFFXp5lr97xSgBx5u2uNiMhdi_eMgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs2ono6ap_x23m9CcCp_tZqMUaFcgIoPz5gGqFq1F1pgw&oe=69A990B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLfHsRw8310Q7kNvwG3IOJi&_nc_oc=AdkmPfx_4ZK7Jv6JLr5cieo7O3Tpmdpd868Sie0OfHK7_uG66p1Is3ddalaq_Mtmg-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuBUKUgkQZhbgb3q-EwF1XdJkc3RGhWSmFk_etSDHlLoA&oe=69A9919F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
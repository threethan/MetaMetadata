}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwJDc6EU5HEQ7kNvwFCCtdN&_nc_oc=AdmGCThTqjr1iPV24-OoAIiV9l3uDqbiOlw3w3jT1XWU3xTba0v6v-a9wybCYIP5iEM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKd-U41Acbfghrvf6xixDquWZTuUx4OzcJCWFIGNiF2Q&oe=69BD3F36"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr96-kJ_lCAQ7kNvwFJQkCW&_nc_oc=AdkRSP3iqxmuMN84RmmZ8i1vCSpBlf6483ujxvNSCMGgzmEIRZyWUvO6Rk_351IPmeE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7eT9g6z5zUg6QdEjQrNyO2PWojN2sSxaINKY2dL8tBw&oe=69BD2A73"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vKLIz_RHwQ7kNvwGkUuc8&_nc_oc=AdmsopLuqvPz3V0_eoLMmb7B7oz-i9asgj7Lqes06RGfd_m_3bvMcY5OKuTuTtjETLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAXhonRpJKxf4TH1rTnc7zaZTgEZ8pUAqL5MSLFSVXmw&oe=69BD5245"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ust5MftDjxgQ7kNvwGCaw2Z&_nc_oc=AdnewIUamQoth8jx3UKE83fooK2uRIpz7Sbf3dccmSHL6UrVS0xh4OCPxGqqYN-Lemw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwqqdXp4AOjHnPdmkdDs2dhxSKkZFyZ5WRRzcXFRDZNg&oe=69BD5734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl97h5YR214Q7kNvwERme5u&_nc_oc=AdnAdu643YlH3tbyFocVF6c6Whm4iJwsoK0ye7lKQBCKIFUA9ONX8iSusvGqaPtW5ho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2TeOcjFd9adi561B-BeujjNS5sNrm6Kah0kCLjm-WiQ&oe=69BD581F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
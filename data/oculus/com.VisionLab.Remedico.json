tent-iad3-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJbxIhhxxMkQ7kNvwFMJYrM&_nc_oc=AdmXznrJJVYH7xGw_eZ73g2hnWxXo6IkrosrR616ekfdKLFeXl_HgH35SfuOi7VBdjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNlY0xeTpdXtDslGqArBD7dfVdREPKeI7OwboX9xdCbg&oe=69A6D5B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oePLk5jy8yQQ7kNvwG7P3cI&_nc_oc=AdlKUi2vom-xSV7u--R7Ug1YX3cJZinsrRaO5z8_gQiVnnUdVKLpEaBIhsVmEhbDVSs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEsrr-riOBIUfHh99Dmnrqgk_mM4lif9xE3B9Sp-CUeg&oe=69A6C0F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOAEZRLZ4ZYQ7kNvwEEF1yo&_nc_oc=AdkJ4voPtHVobw_Ou3kOjH9aHjffpaAqkcBIjOhlK9WsgMb7NFGE3zZGMmI4PP_Tac8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVaYW7MVxu_YlDlcaTJXbphAO8i47W2JoPJwf-Jm6CQg&oe=69A6E8C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufXNCJBkX2QQ7kNvwFebqHF&_nc_oc=Adk2Cxi2MRaXWymUF3VWhVhU67DlK7x0V9nNEsmsLXn9lAdeb1989ZqlAzhjgrMWk50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHguOPnfpioV5ZAuGhIcvIyGhok5w-QlfVpB50crx6xg&oe=69A6EDB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLfHsRw8310Q7kNvwG-8d9S&_nc_oc=Adm2f029i_K05AELRNJDWXljO94HeFCSjldSDHJS_frwQBe-mRYE66kXtA9-jYPZ-AE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYzj5ECBeJeJcjO3XrQyvDDD3GWLY-l0fWYwjaBtb1tw&oe=69A6EE9F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaWyX4tmxpYQ7kNvwHtikdL&_nc_oc=AdnZSJ2wGT7Q0NGTXxuisGq04ComCtfNKTsYj6-OfRF_RQTT4hSUh2vdME3fF9bALTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2UQbSNKGzFrBeg4R_OviD4lU8gde5FP0u8UQ2g4HF1Q&oe=69B6A7B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3EvtWLO44cQ7kNvwFKcyUT&_nc_oc=Adk7UICc7TSxkcSh1TtbmyPGkuMh2cSA05BwmzF7KFw4lPYZbx2xTdsgZn-ZIQKRlD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_q9kXxNl_6_wKFRNKbeQUWe3G2nsETSNArdHcp3MQ3A&oe=69B692F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aIb6o1v7V4Q7kNvwG9dvAE&_nc_oc=Adl-HetPe72f745PTrf7ax8Fpxnj517p7OtVXMnBqbAWOoIlS4-RWy8Gpn38kHmBv0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUJFX0a3FaoCX6561VqAGloETVKeu2jR7jL4tILoc4QQ&oe=69B6BAC5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zAmWovUfc0Q7kNvwGkILyx&_nc_oc=Adl7DLDbEe_rJjumusX19As83hXHT1c-EWBr51aY8pRcFCcylClFLtgLyC9RsdYUmAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJE2_BTGkR-kzkIFFrr76OALE5nx8hFNM7lqU1qUxb2g&oe=69B6BFB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8IpW3C9gckQ7kNvwHjBPWd&_nc_oc=Adm8xFg9PzhreLVANh7GQWCMXXJHIrmt9WpePI98uvASJooT1b3yjPhCegn2E-XziK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHhCojVFUnjURga4MvQ9sLFZg1FgU_RM7wokIg-syn5A&oe=69B6C09F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
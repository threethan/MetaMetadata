}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwJDc6EU5HEQ7kNvwHsbl0f&_nc_oc=Adkpr0-VrWOdZhZIFASE4cq-3uv5YoybkgI0t7yd6VFGvePsHgWg82sgwveS6Sh4K3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhCR1yrfM7G36z8LxX-wgBxrdKX0hUR9ieu_AzFSdwAQ&oe=69BE90B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr96-kJ_lCAQ7kNvwG26_b1&_nc_oc=Adk0Cz_LCDsZ6ICyRGJaaBgJWewTcMulWBMmxCYR1o-jBqwW2jVKcf4vZb2dZ_JqN10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuvdImlsUDT-gtv9WfIcUSbV9wSzjP0jk9JBn90OnEZQ&oe=69BE7BF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-vKLIz_RHwQ7kNvwFJ-9Ex&_nc_oc=AdnKptKSOk0QhaiQwGPT2BDPJ2tb8hbzF3YuHyc2jj1mdWqySqeQ3E4u04o50B7Hcn8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV_d0Kp3QOsYvRE-izo3ggpOTFQRkkj_5o7diar0CH_A&oe=69BEA3C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ust5MftDjxgQ7kNvwEgjQAD&_nc_oc=AdlkztUIC5f6nHcTymUTlThw_3MTi7S0hoYkvGvyZ8o9uRM5JtGBHkqvyL2V_ViY4N4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwnlz2J4N_vb2k9Csh8ZA1GONlhmqH7BM_cNgBzw7bbjw&oe=69BEA8B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPfD4druYCcQ7kNvwEkd6ya&_nc_oc=Adn20ZUbi3C2C1h4Wo_LAY1t5zPz7bjAgeUMSNLbLWc0FMdCj9L1Q5VE2Y-E3ptUtTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrBnb0qKc_YMXjxrOrZoHtYp7eqoKEW4oaXVQHmn7vKA&oe=69BEA99F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
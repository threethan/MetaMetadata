}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaWyX4tmxpYQ7kNvwH2ZJG0&_nc_oc=AdnL9KgB4RisQIqERcI0WEa1zFt4Ug-TDKaZwrLc_3obPG4u5zev5g-PYhoWBWDIFoM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxudVWSywMzLxrLb6BxOUPyRO-jECY_85wFOkDKG_Ltlw&oe=69B7F936"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-3Q7JkjGCAQ7kNvwHGY67N&_nc_oc=Adl81CuIv-IMjQmMRITp6_M1EHLvFO_wSA5HYm_CTd-hksO8yk259R6W72yBmRcDX8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1lyvx0HVQIwfPfphUF1rxwFrifgthBMdJN7bRMof24w&oe=69B7E473"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2hUg9GDUKwQ7kNvwEVAI64&_nc_oc=AdkbUbfgxDWziwj3sMs049UHGwR_EN3V4xrEJDEW-d1RW_EvnMUm4weK7pXG2pT2lEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_0Xf-EMOeQkreCOCZuHYRvw_fZ6EVEAF4TVQ_BzsUvg&oe=69B80C45"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv9wds1bN_kQ7kNvwE1tAfz&_nc_oc=AdkwyEGzFi1up2syXscVOqZD-lPLtmSmZzNdFVkWdCYU0_J2Iwc_tOGrzlVShSJbNI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwC5C848ZGlR0G7hRx3rQ-4S65GVWuJ-dH4jVLH9Cxhlw&oe=69B81134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8IpW3C9gckQ7kNvwFmD0NW&_nc_oc=Admya2Mp6CeN1oX90HVVeDhvICq0pw4jw7tFYwy0kFePhR0r7vf4EL-ZiK2UrfPKwWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrTLoXPUXc_EVgWtrMr5JZR_VJ_jbesHayQv5Z3z_JVQ&oe=69B8121F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
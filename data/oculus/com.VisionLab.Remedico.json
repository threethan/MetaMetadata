}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJbxIhhxxMkQ7kNvwGsG8vS&_nc_oc=AdkZrDA7NTGJ2dYpbHMvIWRi3PTnYk-ehMULroFRHHumrw9tm5sCJxLw4deNZROOQPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYrMegXsUwZikTLQQ3hJrPb60ffeDIF2U399K1r1edjQ&oe=69A82736"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rH6RO_gPxQ0Q7kNvwFh0W5i&_nc_oc=AdlCRqgzKJk0EJw3jr_gEUnFl9ECa4AyuAl6fXO0lq1mbBWmemWTwe5r53yePqkuPwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvaOZg_8m1dPBqTHNBDI7suKsitx1IA_xqkTOa36U1FQ&oe=69A81273"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT41dT0VZXwQ7kNvwEfssYm&_nc_oc=Adm9gvvFzVFzGiLhqqI47B_FG9ZaOeFA34D8TtE5zv1JJLpPlmaSBGq4Qz4zWAiZ-qM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsY9ys7AZ9NVMDt_FXLKzXkbZ0wf_5L-LQvXz_uAxemxw&oe=69A83A45"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdDVIuUlZd0Q7kNvwEaXALF&_nc_oc=AdmHG_dNDJeerPeeN_5Xkd0QwrQ9HSKO24I3htxoQ6cbBPPXp7rBRKBxnOHtdYfZz3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu4Vp3EB8rvJMuG-MxKINQNWxtRX6wt4Ma0TQIGZ8NVIg&oe=69A806F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLfHsRw8310Q7kNvwGg0R_l&_nc_oc=AdmvNMFxGpmjZTHslKMUIctJChioucw2iktZ88B_q7pWkWGzslEmg1KbWlrZTYEStLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLyrrHLNld75zmJH3Y4Mn-P9wXK_F79jqlseskJ9QZ5w&oe=69A807DF"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
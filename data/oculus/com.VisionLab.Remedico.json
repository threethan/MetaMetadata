}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6LY0yXcC04Q7kNvwGiHcS2&_nc_oc=Adlox6X3DtztpSzN9zzEkNAEXBpSDIWPhgaS8pBdzXwCOYNo4ipKIttucQkVe6OiJbI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs0E0Rhs6_jaPH3jBivrJiFMHP58sBi_COpMAAWcyLVQ&oe=69B161B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peyjbyM0oDYQ7kNvwGHb_SE&_nc_oc=AdmNHekSVQa-4iAxWYK_RkXB4jbG_6KCuxI3IFo99xDda0RurhpyO1MmZXfnECaEU5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdWE1iXh4bLk9k10A6o9VLDOPzjj9TLaITyBSAIEaNCg&oe=69B14CF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M13uV4gFEY0Q7kNvwFIyvkl&_nc_oc=AdmPdnSZKuO8MSxURKlpIzJ9h6ShMEAAmQIb4VUQxmRIH4CXALU5Q0DYQp9RoVdQvFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYR9-Fh4IuJNVVFWZ4ZrRMS5Iy8Viyyp55ullsVofBxQ&oe=69B174C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QY0fb71BiQQ7kNvwE3CE1F&_nc_oc=AdnbImRo8jQ4dxy_hjt0i_AbHaucQcQO6YMyHUrsykXdN4BJIIeQMmZYOuGDVA7rVvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBf691pNNwnrVjvCfcIYldKDy5PsauasTwFTt3SNodNQ&oe=69B179B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npksgKzY7ZEQ7kNvwHrkV3j&_nc_oc=AdmzHbgcmBGkiZK7QnF1Ays774o8cSrob55HOQYXOE9rEUX9L2R5CQ5A6bjZn7TEJb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp6dQqjJyeWYukA2gZtaDdAWxAY_YoAdu1xfYCz8RIrQ&oe=69B17A9F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
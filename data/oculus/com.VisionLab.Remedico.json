}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0h0JjeN2ggQ7kNvwHBIXpD&_nc_oc=AdniKyYUnn4JByjqRsH6ubgjFav30CWZnyw17DXobKRx4-ck-cIwuj1GypdkCfGcqGw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqYwAjNMFq5TaqavYzaQzfZimflcPFry3sGDYOvfnCbw&oe=69B94AB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-3Q7JkjGCAQ7kNvwHEHbL6&_nc_oc=Adl6z9vJ9Lzhe6iWuWAIwX6LAM7-OE7IPAxQ3mcOf3rnBw1Mne2g761J2FKGV4fuII0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_DBqiyESslmL-IqxDncQiwQjL7sDaDp0Sw0hL9WBkUg&oe=69B935F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2hUg9GDUKwQ7kNvwHaJY_7&_nc_oc=AdkR8Df_jz_-sl1Ei-3Txh92Khg_Sk0ZFOQ8x2W5LbsPu8MdZvj0jZK2FhyMvWzST6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeeRZn-XwYrSTPWwwTJJSxc7zMB7yJteprA2GxzDh03g&oe=69B95DC5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv9wds1bN_kQ7kNvwHf5FlB&_nc_oc=AdleVTiiXUkBLvwhojnADkiyPRN0A2y4sIbAwrvBrh0f5UNdA0DGYR28WfNE63AQwQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjUzo0JwCDvnV_g06fIDTk5hcT8l-_QBN1i2ifFkmh0w&oe=69B962B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8IpW3C9gckQ7kNvwGfs7hv&_nc_oc=Adm_wcu3GPJalCd2IQt0p_6Vh0-Xng1LN4XLaby_RtJdcYdAf60Z1ggck3RR1E-zpKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfySpBM-5NYWNA6gsIlT18cI8hKMrWd1cm1o7AMxMdjUaQ&oe=69B9639F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
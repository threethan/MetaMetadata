tent-atl3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJbxIhhxxMkQ7kNvwGP1rXZ&_nc_oc=AdlVJGXbzgXXi7Hir33i3QyhgdZG6WVpIEHien5Wd9FeaKZrFmiPa4YAbh2mFVkOsBc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftvZhPWPgcgALWyUPbRvREQ803AOoX9TC6Hc9wGrDE6vg&oe=69A58436"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oePLk5jy8yQQ7kNvwG95BKa&_nc_oc=Adm1MTmwm4lw0ufWoC1DPE23p-vb9207LzbP9VyAcDT2aYi836Chp2-Z0rhqWqHVyxc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsZCSCLHVuHiT-lbVsFNs3COfUCREbLZfjXZUXOhdMPvw&oe=69A56F73"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOAEZRLZ4ZYQ7kNvwHp9NyO&_nc_oc=Adn7Roe2zkX3vTT-afgjYkl2KzlQ7bcU01HfWqxhRDh4m8smF6awrDzAIt_mKICcNSA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs99b68Kx2v5c3L45MJUSyoiX81Dp6S7fm3uV4XPAfvjw&oe=69A59745"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufXNCJBkX2QQ7kNvwFMcFuw&_nc_oc=AdkxjP0eHv05BUSykXcHPqNfNDc8bnSJ9kicE5SeEM7NibBUcx01Cn9N-ID66f6z_yU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvAyCGqrAZrLrONWYqQ4TjX0ZEYruYqmBa9mcizpEYkww&oe=69A59C34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoG5zIJoYCQQ7kNvwF_i1eh&_nc_oc=AdnTP_L9tWhmgRGq2P7p63lrxJYwCQT3ph9mJdH7FAbH20BWlc1-GosFMRwyE2p1raQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftNZLwPnxwNnsh3DZTtaoFmkLIKV4gVlufhekJ-bRIbWg&oe=69A59D1F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscri
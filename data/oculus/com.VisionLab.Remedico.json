}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Q5Zjrl2NkQ7kNvwG0zB_K&_nc_oc=Adll1Q__ZO4Mcutj6rlK42ARKIvuUsDoK87bFyf63P3Xy82Wp8mvNjvALEnwjWTWA44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyVSbziLxQxWnFT850MogAc_UOPXXD4aa7ZQjT16xTNg&oe=69AEBEB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28agdOj5JcQ7kNvwFVm2hY&_nc_oc=AdkzE9PGT1M09G-zvpzgjTSXXGaPiainKe-Wn_o4lxuvve-4bLW4UnF7DcMIkmnLkPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfztWzdRU2LMhzkDo3mkndW_qhMeGGP_X4VS0Jk70du8UQ&oe=69AEA9F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTBntZf5DuwQ7kNvwFghpBJ&_nc_oc=AdlWI5q5tqnMEtnBlHPGIMLsZAVkF7CgJXnX02FKMEBwQG8fylRvEYNuQD5Pc05TJW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFaAPmM_crNpYq1HCKzaEc-zK27TUFyJokCbELnMS9_w&oe=69AED1C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z0MC_kdMI8Q7kNvwGbuFX1&_nc_oc=AdmVw2HEFF-TzS8Lvaa64JEEAd7QTsuQnq7JE5ARSeoh6AVZmqNJiqp5aeCFloGc-UE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6WFk5PomWgPxqKr7bhBpzl4AMZMzPW8jkQvFKnHPJjw&oe=69AED6B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npksgKzY7ZEQ7kNvwEpLG7K&_nc_oc=AdlXGBio1hvw4FVozFgXmv90WRVgxYsHvGyHofXQd97PQAhScQHA5adYiFKAtQ9rHvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA4reLNxesigrw-fUwA-sdZ6J0o_iHcuYcu-SzOk5idA&oe=69AED79F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
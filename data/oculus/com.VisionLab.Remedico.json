}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaWyX4tmxpYQ7kNvwHyLYK8&_nc_oc=AdmaGwOs8byle6WZiyDnCWk6SzwMXnUtaz6Dy6hHnX4XDKFH70aT6HA6f8D6Pu67q_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNsgRxTX8iDnlQvG9244QOc7LVz_OxygujK2JH_NPMPA&oe=69B55636"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3EvtWLO44cQ7kNvwEc7Icy&_nc_oc=Adk6WE-j45fcysboqIpdmJR1guvJilx5f1TitteZyiYIP1ErtdcFLDuboztr8EEkkMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuMdhH6xgDAn44yBB9twrsV7yo7xswZ2lexkbzqnYqOw&oe=69B54173"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aIb6o1v7V4Q7kNvwG4zv10&_nc_oc=Adk4gc-1607CGRDS5n5mXKgpTcqvYVrUBm50egflJypIP4Ke2iUbVZ7ET9eEGABT1wE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBRxqkuQyvDQuz1YJ8Nui0sH-ZrQkAbgViz07YMHOu5w&oe=69B56945"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zAmWovUfc0Q7kNvwERnRbv&_nc_oc=AdkBXZZ8UHLsvHwNwx-QRzsv3tmMo_SJpwGE4X4v_UqpAZ1DzDoglOfWHcOP42Oi4ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxItmEWaQLvc1HduuaMyw68GVdQq_OLen-Vmjr_SzQRKQ&oe=69B56E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOICIAkQSMYQ7kNvwEocnIU&_nc_oc=AdkEr8u2UfBZlmJoHRGlWPwZcREHsCbwGV0fX1Ojs1-rO7c9fM1NG1yfm_Xq5UWxIoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzM_CO8qs-02ThZns1CcPkcU_L6MNp91wiRXoz1Pom1Wg&oe=69B56F1F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
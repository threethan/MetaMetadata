}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6LY0yXcC04Q7kNvwE_9rE6&_nc_oc=AdlzrDq648S2pCuwciW93uTV-mJGqIXY6uwXc1-s-x4bo6G4qVd_qK1f7kw-yLuk9EI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyL6HQAEKETO8jkkGDVLKacUqj81fk-Lh4BmYUo8ZwY4w&oe=69B2B336"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peyjbyM0oDYQ7kNvwEBLw4D&_nc_oc=Adly4_Y8noep6GhoKN7qR-Lx3bg8yR6EtcrTk9WomAtO-esQ1bGkdlNHvSif8g0s0bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyv871RjLkJGuo7ia0rmcO_a96D-WToEGAOXW6vz5LyRg&oe=69B29E73"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M13uV4gFEY0Q7kNvwEb1yBC&_nc_oc=AdlJZ9G6vI6D1h3loUc7QovH_cUsyI3oDVP9O6RaygGMKl8G2IzXw9_qth_D7p7HhGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZ2Wz7oECJnZ97Dpr-rmDlRKPx8sg7uPH9NfX1zQaprg&oe=69B2C645"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QY0fb71BiQQ7kNvwFpGSg5&_nc_oc=AdmKMzbjttcCglENYZ6kpBSp2hCN-Dia_O0AZyWKA2_W2EzdunqRlZJU4_Vedx0fLoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyVIiptUKKHwIXBARo9vLGHBSHaRvEw53hflLZgD_7DvA&oe=69B2CB34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOICIAkQSMYQ7kNvwH_2Tus&_nc_oc=AdkiAMjeNFBl-A9R4nq1j_DJ7OVHrSKEmTIMwrhXoDdjhkaTVHeN2n-3T84qEgQUQ5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWwPHwIWx-1bdxx2GibSlHDsxnIULK8GPwP9AhrXanZQ&oe=69B2CC1F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQHHZ6jBO9IQ7kNvwFOorre&_nc_oc=AdmEFpWonrzBEUaeJOsC9gBLcEfg-9WjdTobD0Dw8pQwp7axCKW5Oc_qV3ns5Vwgk44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZD2Qh1tK9ljYpHjmAF8ei455xp7VDP-fXHJWwIeDhjg&oe=69AC1BB6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q28agdOj5JcQ7kNvwFyLKb2&_nc_oc=AdnVT1SkodFIrr46wD1m5a9WckBTa7HTxVoMYhTJjbDAtfa0Vd-26WZ9JJ1NzRpb8yU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwqy90-gywFA6ioYrqq2uQsRvwlfQWnn9lCwWTxiinxzA&oe=69AC06F3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTBntZf5DuwQ7kNvwGs6ISz&_nc_oc=AdktWjSRCNNLCwW3H3qJb31Y9w7Xt1-HmGRfGJVus37GDTXgYVYMgscpoj617p1TkbY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxAbL3TTxbelZNkn35iZN7YCn1SqGubUE7y0Sxi3MIRyg&oe=69AC2EC5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z0MC_kdMI8Q7kNvwGA7N54&_nc_oc=Adm0qMHuceCmiXsXP71x3qNGwLwDthcn2sYCfnvqR6osvMDWMoQc9_54lPpcbagT-6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwq2-EfxpcOZ8aJyBFWf5BhprOKMqnIyOnUrXs56tND8Q&oe=69AC33B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq5AIIrzcuMQ7kNvwF7kpIh&_nc_oc=AdmVvEQxBCwYtredjk8VpdSED3SD4tnHpr5O8Hi9RMnPH9X9mhFTkxtMF50K3WUZu-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjyVnWAOLSC0PG1pKWab3l3Q3ydqc8noY2HAkR3TKW6Q&oe=69AC349F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
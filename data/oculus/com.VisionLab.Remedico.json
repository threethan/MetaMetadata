}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6LY0yXcC04Q7kNvwERqdQY&_nc_oc=AdkpTsTGvhYrQTPDV2MzXGZ7dSvU_W2-LpTtCuK1u02JERDXOw8Bsw9CvNugvHEDiFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhaZOlEASnezwXHRlUps9mHlVdqKqvnlclodY8Jesexg&oe=69B404B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3EvtWLO44cQ7kNvwEFdKh9&_nc_oc=AdmDtLAcqRFCcEbKX9sLACKBxGfWCDJqjLrZhzH85IIWs0fFyW_NOo4vckDH7QQPMfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSooIXQ9dRXypuQPiWH5xABQk_DDxNJrH0PE9uubh7cg&oe=69B3EFF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aIb6o1v7V4Q7kNvwHpB21G&_nc_oc=Admgw0HHwOBCVrOkEI8q1QVHTWEYN4sjluEoKjcusnjaf4eqe_b3hx5FMSXgChf2Hkc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwU99DzJzhvTJ2J90DOydiU46TJRwQKuCZYnjjyfPNm2w&oe=69B417C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zAmWovUfc0Q7kNvwH5Xhto&_nc_oc=AdkfVdHp3JxH6Az0t6MXgPXCgthBlrhKWimaFMfB97Mvw-ILejkmBJP9hw1fiXX-gFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwASn24BdwB-oOWaINg9Sj2FLLhcD66aeM4nALQwe7NVw&oe=69B41CB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOICIAkQSMYQ7kNvwHoDr_e&_nc_oc=AdnlsjCr0V-igEokn6UhhxuS3BKzw6H13ENIkZFoB9CX6Sh5L6hBo0tkeyP1HjNYDHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk1dVSRbSh2jhrGTd_XYXoO2lwKtRnKbT1hmdI5bU97A&oe=69B41D9F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
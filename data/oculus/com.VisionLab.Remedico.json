}, {"file_name": "2.png", "id": "1117727666354215", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035423_1117727669687548_6336101744385952558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzh15_I_iToQ7kNvwH-MNmV&_nc_oc=Adrni0BBTBrg7H4K3oilyzxI1ze5J_z3NRe6HTcehcGxeIXhYtQTf0F-VPD5MYU6dxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq2Srzkyeg0_sVthtHfE0ZDYhnHF-SBfnjWGCyZyjEfQ&oe=69C133B6"}, {"file_name": "8.png", "id": "1140604384096718", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001673_1140604387430051_1761531362646583696_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgUpGaVA2ZkQ7kNvwG1lzGw&_nc_oc=Adosqdya74wK9JsQVG_6fQ0Gu7dhgb9Y3MDELpByr9re0Wpi0nO_OUzDobuD5ttsL3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzThGmTLvdY3BAXu_R7g3UKlq1GBxEIWhAFlpEn2GAuhw&oe=69C11EF3"}, {"file_name": "7.png", "id": "2607465396309600", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75314850_2607465399642933_8436342643835854733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxqVljYEutUQ7kNvwFqisiU&_nc_oc=AdrqeKuhjthMUCw1ikTI8MATc-4leTwm-AmlStdrGk3a-ZcsLoZvO1AOacqxYOWGRp0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1RHbI6MyLgOzSHQRoWNaMskaCSM2rAitlQNCoFMt7qQ&oe=69C146C5"}, {"file_name": "3.png", "id": "1358318868470511", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221321_1358318871803844_3771128047448443236_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAsu8htU2FIQ7kNvwELRnlm&_nc_oc=AdqnKNVOYQ2fL68YAx8X_1Mg-0Nbw-ZuaXrrzvNVaow8SHSDgmpI8h-KRpex0WGW_ck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaB-bnoi_eQ2XhgU6RxIfCJrn5PGaq3I1jNWXbD_01mA&oe=69C14BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2024-06-13-12h06m23s327.png", "id": "3765160013743225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031411_3765160017076558_252250190670567978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPfD4druYCcQ7kNvwHWdlel&_nc_oc=AdoQ2DW-aVjvE9A15YtFHQxSmIumuuu7Lo9I5kjteMAW_XC-4hWvNdlBqrR9dNNExGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfymUyKLjwkUqC1FwbFjJ1pAoK9MFMwSDPcWnz5eeVqeMw&oe=69C14C9F"}, "display_name": "Dentaverse\u00ae by Remedico\u00ae", "keywords": [], "long_description": "Dentaverse by Remedico integrates AR and VR technologies to facilitate immersive learning in dentistry. \n\nThe app is designed to assist students, dental professionals, and patients in understanding various dental conditions and treatment procedures. It provides virtual scenarios for common dental issues like cavities, tooth loss, root canals and other treatments, and methods for teeth or smile restoration.\n\nFeatures:\n- Interactive 3D model of a human jaw for exploring dental scenarios.\n- A range of standard teeth restoration scenarios is available to all users.\n- Integration with Remedico EMR software for personalized patient-specific scenarios, aiding in visualizing treatment options.\n- Dentaverse by Remedico aims to enhance dental education and patient engagement through its immersive and interactive virtual environment.", "short_description": "Dentaverse offers a cutting-edge VR experience for dental clinics, enabling dentists to preview STL and OBJ models with patients in a shared virtual environment. This powerful tool enhances patient understanding of treatments through immersive 3D visualization. Ideal for innovative clinics and practitioners, it streamlines communication and elevates the standard of patient care."}]}, "developer_name": "Remedico", "developer_privacy_policy_url": "https://remedico.app/terms-of-use/#appendix-a", "developer_terms_of_service_url": "https://remedico.app/terms-of-use/", "publisher_name": "Remedico", "support_website_url": "https://remedico.app/", "website_url": "https://remedico.app/#dentaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
e=6B01E25D"}, {"file_name": "only up screenshot.png", "id": "2113452665897437", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821682_2113452669230770_8782302043265955583_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIerz0uUZi0Q7kNvwEZ3726&_nc_oc=Adp_kER13FwpXEkDJ9C8mv6s3Uco1HLW6iGLzk9uhiywZbE7U83dd-qHNnxlyN_wdS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6w0hAr1XRah1kppSbqLaLLTSqwha9LOGjM7iXXLw_XA&oe=6B01DA4A"}, {"file_name": "forest screenshot.png", "id": "1616398789516108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821674_1616398792849441_304668373992473307_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpPn-duxYNsQ7kNvwEUvh7L&_nc_oc=AdpyDiQqHn6W2BgcnfKPvap0CgrC-OqjRzu-z_1x1tx374V_6fnoMH2GyWiW6o3ylgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK8h8Q9CsbVku0h1Gi41wDc6JoEH8KpgkQINSN1_CsMw&oe=6B01DFE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Monks", "keywords": ["gorilla", "fangame", "monkey"], "long_description": "Primal Monks is a fast-paced VR movement game built around raw, physical motion. Swing, climb, and launch yourself through arenas using only your arms, no joysticks, no shortcuts.\n\nPlay as a monkey, and master momentum-based traversal as you chase, evade, and outplay other players in chaotic multiplayer matches. Every jump, wall push, and escape is powered by your own movement, making skill and creativity the difference between winning and getting caught.\n\nJump into unique maps, experiment with movement tech, and challenge yourself to move faster and smarter. Easy to learn, and easy to master.\n\nIf you love high energy VR movement and games that reward practice and precision, Primal Monks is for you.", "short_description": "Primal Monks is a chill VR game focused on arm based movement. Swing, climb, and have fun with other players. \n\nSkill, momentum, and practice are the core of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/lucasongorillatag-netizen/Primal-Monks-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Zollex", "support_website_url": null, "website_url": "https://github.com/lucasongorillatag-netizen", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26009888698637107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818900_26224787113795897_1693613409455439181_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXSsZekaEJsQ7kNvwGpdHOb&_nc_oc=AdqC4I5_oYWfErB6Eg2lkpvgXZzJdYLwllEI59_krEEWWfQoe6_fJQrbLuQN8QgH29Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaUxuazKJt0cs9wLbB0JeXxbMliF08kH5oYhVv1X4DsA&oe=6B01C511"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primal Monks", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1770058740, "lastRevision": {"nodes": [{"id": "25987387067553937", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appl
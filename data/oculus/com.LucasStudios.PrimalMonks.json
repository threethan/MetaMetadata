4.5771-25/491823837_1213741867015687_646281920602726284_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6U5J38Gk6oQ7kNvwF5aRMc&_nc_oc=AdqRgQgpba9IEdp8Z8yUo1T8-R65hChtDKttzjvXb2vp6HecvseBQbyuuSFdPWE6UmU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0dBPy0FVM_lKf-eu9DNFximnq-L3PoF65OzJ4eOqOeA&oe=6B0B1CDD"}, {"file_name": "only up screenshot.png", "id": "2113452665897437", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821682_2113452669230770_8782302043265955583_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYEmUDGvU1oQ7kNvwESflAa&_nc_oc=Adq05MH_5qTP-HdyPsOWNgy0T41OlAu99rRfEY23IxQ3JQW9H0jb_TCMyCHuI5Bc5cM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq_URooHYvnjBudDMoe3LqeTh_dLDpqFGvemoYsvrGQQ&oe=6B0B14CA"}, {"file_name": "forest screenshot.png", "id": "1616398789516108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821674_1616398792849441_304668373992473307_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EXPSoXhiKAQ7kNvwF4dJna&_nc_oc=Adoj9_gTqRy2AD_iurgUNNCnMcspp_CiaL_MetmwuSdzbl_iBgJcWELfnilQgKtVR6Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyKwiHyU5rHwSx4_qG89TBXoQzFPbi7JNZLPXnRXUgyQ&oe=6B0B1A66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Monks", "keywords": ["gorilla", "fangame", "monkey"], "long_description": "Primal Monks is a fast-paced VR movement game built around raw, physical motion. Swing, climb, and launch yourself through arenas using only your arms, no joysticks, no shortcuts.\n\nPlay as a monkey, and master momentum-based traversal as you chase, evade, and outplay other players in chaotic multiplayer matches. Every jump, wall push, and escape is powered by your own movement, making skill and creativity the difference between winning and getting caught.\n\nJump into unique maps, experiment with movement tech, and challenge yourself to move faster and smarter. Easy to learn, and easy to master.\n\nIf you love high energy VR movement and games that reward practice and precision, Primal Monks is for you.", "short_description": "Primal Monks is a chill VR game focused on arm based movement. Swing, climb, and have fun with other players. \n\nSkill, momentum, and practice are the core of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/lucasongorillatag-netizen/Primal-Monks-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Zollex", "support_website_url": null, "website_url": "https://github.com/lucasongorillatag-netizen", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26009888698637107"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1789726778292772"}]}, "baseline_offer": {"id": "1789726778292772"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770058740, "status": "PUBLISHED", "id": "1789726778292772"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26035579389401371", "version": "1.2"}, "id": "1587232895876194", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
=1-7&_nc_sid=6e7a0a&_nc_ohc=kMTVztfyYIoQ7kNvwG7LjsA&_nc_oc=AdqKvmWytE1UJjapkRWrtQ56rx2l03c9lajZDAfTAJJiEnFHs04S760_fX90a7YZDyk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuIl03oEGzBNlhfbdzfBoDaEl8TA4_Wd9sJPSVgaRQZg&oe=6A97490A"}, {"file_name": "forest screenshot.png", "id": "1616398789516108", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821674_1616398792849441_304668373992473307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MniqatJ6RmYQ7kNvwEkscRP&_nc_oc=AdoErmHAIVLJM6sNuk_kEr51nupIDX_dq89NEk6f4tFgWBY80-KJbkrApB_uYfOEE-M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_g9gdKtsK8M9Viw43CnBYYR1hjXNXkgQeQuSQpXAt1w&oe=6A974EA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Monks", "keywords": ["gorilla", "fangame", "monkey"], "long_description": "Primal Monks is a fast-paced VR movement game built around raw, physical motion. Swing, climb, and launch yourself through arenas using only your arms, no joysticks, no shortcuts.\n\nPlay as a monkey, and master momentum-based traversal as you chase, evade, and outplay other players in chaotic multiplayer matches. Every jump, wall push, and escape is powered by your own movement, making skill and creativity the difference between winning and getting caught.\n\nJump into unique maps, experiment with movement tech, and challenge yourself to move faster and smarter. Easy to learn, and easy to master.\n\nIf you love high energy VR movement and games that reward practice and precision, Primal Monks is for you.", "short_description": "Primal Monks is a chill VR game focused on arm based movement. Swing, climb, and have fun with other players. \n\nSkill, momentum, and practice are the core of the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/lucasongorillatag-netizen/Primal-Monks-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Zollex", "support_website_url": null, "
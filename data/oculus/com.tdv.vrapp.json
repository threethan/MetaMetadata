nt-iad3-1.oculuscdn.com/v/t64.5771-25/38974817_4312610112191189_6344047720214484346_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XtB24Xsf2EQ7kNvwHMNjbm&_nc_oc=AdqZVXBEXUf1iM1woBJW9WwUOUG6itvdeAsUpKezaH_RePo-p7u4Y70KzT3uQiejDgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV78AGLE0ohHDZBC0LeMA6eQlQa5hcOrRWdLleedyfWpg&oe=6B103D56"}, "display_name": "3DVista VR", "keywords": [], "long_description": "Portfolio App and VR player to enjoy the tours created with 3DVista VT PRO.\nConnect your Oculus headset to your computer and import your VR tours created with 3DVista VT PRO. When running the app on your Oculus headset, simply select from the list of available tours to run the experience in VR from anywhere and without an internet connection.\nSome parts of the app are based on open source software covered by MPL 2.0:\nhttps://www.3dvista.com/vrapp-ffr (repository)", "short_description": "Step into the virtual world you created. Whether it's a digital twin of your own home, virtual staging or a whole gaming experience: Run your 3DVista tours in VR anytime and anywhere.\nTake your 3DVista virtual tours with you and run your VR experiences anytime and anywhere, without the need for an internet connection. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dvista.com/en/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "3DVista", "support_website_url": null, "website_url": "https://www.3dvista.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
-1.oculuscdn.com/v/t64.5771-25/75658018_247847573732846_3661353534805258071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSbXqsJQiTYQ7kNvwFABorO&_nc_oc=Adn0BwhVbTlEFVzbzuujCC7GWxT6S4QJCe-rjyiUqLebHMZp6sSVMAPRo2KigzymdWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfviJCZnB7G0OgWZQe1B1YtUxa-AXyzDamR5_yMCqpYmmA&oe=69985F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-ss0.png", "id": "4312610108857856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974817_4312610112191189_6344047720214484346_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2gAv3jRr9kQ7kNvwGn-CwT&_nc_oc=AdlBqknN40QJzUUSFJmhujkMtDUE5SK0cSuc0WXYiC7p9gySBmmTYJm8BlT1NwQa_uA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsHEh3ACMBDY-0lzS8kiMnYbDGCQYKtQiL5SJ-1HL4HaQ&oe=69984996"}, "display_name": "3DVista VR", "keywords": [], "long_description": "Portfolio App and VR player to enjoy the tours created with 3DVista VT PRO.\nConnect your Oculus headset to your computer and import your VR tours created with 3DVista VT PRO. When running the app on your Oculus headset, simply select from the list of available tours to run the experience in VR from anywhere and without an internet connection.\nSome parts of the app are based on open source software covered by MPL 2.0:\nhttps://www.3dvista.com/vrapp-ffr (repository)", "short_description": "Step into the virtual world you created. Whether it's a digital twin of your own home, virtual staging or a whole gaming experience: Run your 3DVista tours in VR anytime and anywhere.\nTake your 3DVista virtual tours with you and run your VR experiences anytime and anywhere, without the need for an internet connection. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dvista.com/en/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "3DVista", "support_website_url": null, "website_url": "https://www.3dvista.com/", "category": "APPS", "comfort_rating": "NOT_RATED", 
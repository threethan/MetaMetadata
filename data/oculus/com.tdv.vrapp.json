-1.oculuscdn.com/v/t64.5771-25/75658018_247847573732846_3661353534805258071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs5m-yFym7wQ7kNvwGvOR4w&_nc_oc=AdlQwhifaeFlj47Ig6FqFhq5Lzx0BpVItiEbzJung8E3RmCwGxn3gYVEpRxMDu4lAtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbpY6aAU4BXnczDcdRhRqhvsnqc1HmSjkH4y2bg5nt-A&oe=699DA503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-ss0.png", "id": "4312610108857856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_4312610112191189_6344047720214484346_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmdzIo68068Q7kNvwEoa2DX&_nc_oc=AdnAqMxdCMCy370XeZPUQ8CjGHPLKIp-6lOHMPZFvFYohqvhtANJlQ_e4tK1cVAPLD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-vtAw32MnBnXY0IIU0rPOQmwuHhotHJe4BT9k_F38Mg&oe=699D8F96"}, "display_name": "3DVista VR", "keywords": [], "long_description": "Portfolio App and VR player to enjoy the tours created with 3DVista VT PRO.\nConnect your Oculus headset to your computer and import your VR tours created with 3DVista VT PRO. When running the app on your Oculus headset, simply select from the list of available tours to run the experience in VR from anywhere and without an internet connection.\nSome parts of the app are based on open source software covered by MPL 2.0:\nhttps://www.3dvista.com/vrapp-ffr (repository)", "short_description": "Step into the virtual world you created. Whether it's a digital twin of your own home, virtual staging or a whole gaming experience: Run your 3DVista tours in VR anytime and anywhere.\nTake your 3DVista virtual tours with you and run your VR experiences anytime and anywhere, without the need for an internet connection. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dvista.com/en/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "3DVista", "support_website_url": null, "website_url": "https://www.3dvista.com/", "category": "APPS", "comfort_rating": "NOT_RATED", 
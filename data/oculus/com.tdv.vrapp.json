lay_name": "3DVista VR", "keywords": [], "long_description": "Portfolio App and VR player to enjoy the tours created with 3DVista VT PRO.\nConnect your Oculus headset to your computer and import your VR tours created with 3DVista VT PRO. When running the app on your Oculus headset, simply select from the list of available tours to run the experience in VR from anywhere and without an internet connection.\nSome parts of the app are based on open source software covered by MPL 2.0:\nhttps://www.3dvista.com/vrapp-ffr (repository)", "short_description": "Step into the virtual world you created. Whether it's a digital twin of your own home, virtual staging or a whole gaming experience: Run your 3DVista tours in VR anytime and anywhere.\nTake your 3DVista virtual tours with you and run your VR experiences anytime and anywhere, without the need for an internet connection. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dvista.com/en/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "3DVista", "support_website_url": null, "website_url": "https://www.3dvista.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378023127463350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031322_1003218867164147_3412918752317182418_n.png?stp=dst-png_s360x360&_nc_cat=1
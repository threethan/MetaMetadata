-1.oculuscdn.com/v/t64.5771-25/75658018_247847573732846_3661353534805258071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEict25R_LwQ7kNvwGrrEpY&_nc_oc=Adns1jitWDEnfi6O_Z-ZljYJDmYuAVO_JpUTk5pmkhCCDLKlT-1Qsqbj6vcIufWo50s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftg285p328xQZ4PIDeCKcGKrj-vVjHWeG5esSB3ikNJrg&oe=69A6DF83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-ss0.png", "id": "4312610108857856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_4312610112191189_6344047720214484346_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDj11-zqVh4Q7kNvwGpAq9T&_nc_oc=Adk-RHH68pMt4GyabsXlYslO0pX5b8FjVzfYEC2pGTo8xVknzlWIFxT0WvBL7t02wEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft96Jo-2vvJ97u7RrS3XCIy_rkgJwSZgYVQNQaSWHPPwQ&oe=69A6CA16"}, "display_name": "3DVista VR", "keywords": [], "long_description": "Portfolio App and VR player to enjoy the tours created with 3DVista VT PRO.\nConnect your Oculus headset to your computer and import your VR tours created with 3DVista VT PRO. When running the app on your Oculus headset, simply select from the list of available tours to run the experience in VR from anywhere and without an internet connection.\nSome parts of the app are based on open source software covered by MPL 2.0:\nhttps://www.3dvista.com/vrapp-ffr (repository)", "short_description": "Step into the virtual world you created. Whether it's a digital twin of your own home, virtual staging or a whole gaming experience: Run your 3DVista tours in VR anytime and anywhere.\nTake your 3DVista virtual tours with you and run your VR experiences anytime and anywhere, without the need for an internet connection. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dvista.com/en/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "3DVista", "support_website_url": null, "website_url": "https://www.3dvista.com/", "category": "APPS", "comfort_rating": "NOT_RATED", 
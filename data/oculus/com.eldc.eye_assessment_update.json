"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_hnJQbqCaEQ7kNvwGNDUes&_nc_oc=AdrIBUvUYHuOizzMShjxhNWLjkI4sFDR9HMWMUUvlhcL-3w-x4Y_FCUWHkqulJpdDSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6uSk40I5zaG2BCUpfWnNR94AA2ST5m8WrJfAeyrHK3A&oe=69C907EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.educat
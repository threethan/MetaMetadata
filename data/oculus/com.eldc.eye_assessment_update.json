"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDHOoBWwnxwQ7kNvwFXipvu&_nc_oc=Adpy_9tadjgVasvwsro9kN_3JjyAbLzohnn-bWf7_awafR7wz7eW_s4Ds6KW3f18PM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mxk4Za_dRIuwG_2vRTDFcdNZLabcgQoYI2paH08EeGA&oe=69EB6C64"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msBohIT37QwQ7kNvwHd60n2&_nc_oc=AdqH7X-MumkxcBSiqK96NdSW3CD8r3ScvFnKzVq9oSxCBR_CZb3uFS2o9PMHwG5J-bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UjLu09kgjj_JL7nLygY2kOP5fGGVGtUz8Im44aZ1SYg&oe=69EB872C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9868005496641556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1725049361710151"}]}, "baseline_offer": {"id": "1725049361710151"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752049140, "status": "PUBLISHED", "id": "1725049361710151"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24163928359956031", "version": "1.1"}, "id": "597669023384473", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9817233858385387", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24163928359956031"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597669023384
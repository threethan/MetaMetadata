Z&_nc_oc=AdoCerP14qGQx_Il1KRkZ5xw6tnig4_7dfsf_sQpZH1vPKgUWbHFcdVOT3d9shb7_Do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2a44HQsgYS3MNJnHufutkWNazuC47i2596Nl7yOOcZw&oe=6AC65F35"}, {"file_name": "com.oculus.vrshell-20250704-164603.png", "id": "1175114194384431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620444_1175114197717764_6819788338628201546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiCfve0MZXQQ7kNvwGuGqMG&_nc_oc=AdpY1qWjBPtIHjrQS9AuF99KuMKNt4REdsixIRQjgG4xq8tLX3FKmlelyZJVPkAcKEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPPhLMxk-4Q6KPxMxBZG95YxJYwNkmKQ2URL1znkFOqg&oe=6AC66B37"}, {"file_name": "com.oculus.vrshell-20250704-163856.png", "id": "1399596361309151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw4VKe-RdY0Q7kNvwHvXozs&_nc_oc=Ado9w_0rQAQQ4vq9M_Hp_EhnRo9qkK6k8COqpTMNU0fiygUxiZKHkzPDLAZ2wod5l6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXgNmZhkGxHnszLFyF5-8mHI7xaP83ak9LjB_uvsY78A&oe=6AC64564"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38y9vkpnvc8Q7kNvwE28F09&_nc_oc=AdoO65_UYXg-AoGmynZEs1IJhoah9ao8O26Nb8OJAgBgoO36MpOejvzU4ZXnu50YhaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtmyevOeTjaeGgRDMDzlBNwmR0koYs_z18kY1nv4XvYw&oe=6AC6602C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9868005496641556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1725049361710151"}]}, "baseline_offer": {"id": "1725049361710151"}, "is_approved": true, "firs
r&_nc_oc=Adp92_HUqOD4cTDyg_4eIIZK7GZ3co9WOXsb3kmBp1_9sg8fvpK-6KcGfw3PYuai1vg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxLAtmlMRuCXd2euLPwFYH8r9y5a4yv6uylOB9AqQu7g&oe=6AEC9AB5"}, {"file_name": "com.oculus.vrshell-20250704-164603.png", "id": "1175114194384431", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620444_1175114197717764_6819788338628201546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skmp-9ERdYsQ7kNvwEz14Hg&_nc_oc=AdoY6kME0hfgfdG2YNQSiXrEwpJ7bldBIvjF35kCKGfQ4_b7Q0x9MfgcDIqmzovrn8Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGs1ZrWAi1yqXcU3ickSZY3A_DA54E0E2xo4-Aitgx7g&oe=6AECA6B7"}, {"file_name": "com.oculus.vrshell-20250704-163856.png", "id": "1399596361309151", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taypgu5XRpMQ7kNvwEW-KpK&_nc_oc=Adp1GDru3kS6yKaqbXlgMW9u-Kj1B5ecEU3Y-VQtfOKb8HYHhyt3gIs_6_3GqFQHo9Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaVzOmMKGAa9ogxkV0fES7oV7k_Mp-GNU5A6qEUU1vjQ&oe=6AECB924"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibrViTzlu9cQ7kNvwF8pTWu&_nc_oc=AdoTo_SeD082pYUdSXSxVRP50Qd_XvmaR9qrFxy53p5bbROyR_s6tMUEmKx3m5cklXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxFOm0X52vKBZ9qgp-sLyjjxbW92lmEj5quYa8oOOzMg&oe=6AEC9BAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9868005496641556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1725049361710151"}]}, "baseline_offer": {"id": "1725049361710151"}, "is_approved": true, "firs
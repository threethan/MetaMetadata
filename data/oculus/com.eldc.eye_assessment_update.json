7&_nc_oc=AdrYecsORrecnvd0seDX3mSW_hB0FoOSDH3Wkr5UXCbLWUOtbsb7xBdI4CDATdVxdW0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFua1EONd-S1LBIZkqfjeTuiIf03gf2DHUw_5kQd35kLA&oe=6A916AF5"}, {"file_name": "com.oculus.vrshell-20250704-164603.png", "id": "1175114194384431", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620444_1175114197717764_6819788338628201546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daxdffFRd5oQ7kNvwHg0v88&_nc_oc=AdqMtMQaUsOmCE0WZ-o-jN7cM2rDPO0qDy52dKmE8zOA2sYCSDicqVpzgg4cB21C_IQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ngdaADFSwjRjhhfplo_jRp6aCw94dft_4RI_mZ9b-Q&oe=6A9176F7"}, {"file_name": "com.oculus.vrshell-20250704-163856.png", "id": "1399596361309151", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n1vyaIpDGcQ7kNvwFj4zXu&_nc_oc=AdrnFqLW3aJxk11n0-xjeMwZuzlL75KIQKlemsiqBD83cotLiV0a1kERyJG-r0vjZ9U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkMpm9bd4mhBsgWrsuEJ3f2KR_0knPaAJOl0_O-nwnJg&oe=6A918964"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MndIrk9Z2FsQ7kNvwGzfD6g&_nc_oc=AdopxdeBl8ZgO4RXbpHx_c1AmzA98qAeCXNznGAyo5pwauA1aOpHMKYpdR-PIbVAzfc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfKzmyAUsWxoqvNtiym_Rd919jDmg4ZvfYr3ohBMsmyg&oe=6A916BEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9868005496641556"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1725049361710151"}]}, "baseline_offer": {"id": "1725049361710151"}, "is_approved": true, "firs
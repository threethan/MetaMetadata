14548298491", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308961_1230514551631824_4878651103121870636_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_5QfTsxx0Q7kNvwGiOoUJ&_nc_oc=AdmmIfCeeRZo6rDUGexWBmuSEhf_RRNH7Xtf4QCUAl7O9uCbWwRZMQYUccEUjMpSdvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftXz4rbCsg2-Rb9zqJCPi5XBhJLE_d1tzKYZJdtkAXM8g&oe=69A6D507"}, {"file_name": "com.oculus.vrshell-20250704-164027.png", "id": "1979797589241599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623548_1979797592574932_254149148975723756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2ylK8MTqpYQ7kNvwHoJ2pr&_nc_oc=AdksUpnte3zOI-6VQlSIs-0TLsIS6-IeCJlq9oFgK4xoTado-9Dmm-WbN6PHLOdvnb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft06Z_ArO4Pp5nvY4dFoph4oDWCNP3lYeLqOK4gXfTylQ&oe=69A6BFF5"}, {"file_name": "com.oculus.vrshell-20250704-164603.png", "id": "1175114194384431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_1175114197717764_6819788338628201546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFA0ZB2uLboQ7kNvwEjVOxm&_nc_oc=AdmqrsYXKcZ6BNesD65wpEpiPyb6QPd_ep9dFGTZyrm5vnN06jUimNXWL_JTZkYASIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEDB9UqCNepoDNnlNI6khlwQAQ6A8IdqKVdEuNUB9XAQ&oe=69A6CBF7"}, {"file_name": "com.oculus.vrshell-20250704-163856.png", "id": "1399596361309151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUIz9p2UBr4Q7kNvwFDED7V&_nc_oc=Adl9CpQjgp3Ke4I8gYNk2CsRmiYKqGTRYpxibl8Kj1pxHcdnuaB4hZyxCIqeuap3syc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlCzLICQDK4J62yhjdLE0rZU_vN4dSTZPVfec7MlkRwQ&oe=69A6DE64"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Zs-5HX6fjcQ7kNvwHkUImt&_nc_oc=Adk34s-Ug0XVAEkxOsLL-fBdaeRtJvZd2XAqVkeBocEZlf95THDe51kAPc3Z-xjnTzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1qpyiB6fecXaaeRCQOhkKE_sOz60-S2LsozAZ-DniBw&oe=69A6C0EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
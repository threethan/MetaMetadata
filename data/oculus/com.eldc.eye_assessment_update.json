14548298491", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308961_1230514551631824_4878651103121870636_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8_5QfTsxx0Q7kNvwFB-tjl&_nc_oc=Adm4e2N7Jv1C0ODGpkYThwAqXZLhBIcVv99poCM7avsvrObBwuVZe2GzzaDXY6v3AjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfumuyhtkgM6lHIZGeOwUcyJa3SoZYSfCucwVhZFBzS87A&oe=69A58387"}, {"file_name": "com.oculus.vrshell-20250704-164027.png", "id": "1979797589241599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623548_1979797592574932_254149148975723756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2ylK8MTqpYQ7kNvwEAnsQJ&_nc_oc=Admt4WkZyjwfOJSGXt20VMzyaUY__hIq8ZRdSwRnrL2vN2LG5ZuOmGZURBhYX0FmcPc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuo4-FIUGDQ9A7_y1XngfUv1thr01BXtOjtP_IdEfD5ow&oe=69A56E75"}, {"file_name": "com.oculus.vrshell-20250704-164603.png", "id": "1175114194384431", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620444_1175114197717764_6819788338628201546_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKMxfKnrpjUQ7kNvwEJDGpX&_nc_oc=AdlGjBaZjA0VMjNNrYdCUel7UbOmVXgzt4klaA1C6L1BhUOU2GZC04vDHB8fPKrkXhg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu1U2lr4O_a_R1iGO4Xs6l306-XqnP8vRJ7mIwA_bFFsA&oe=69A57A77"}, {"file_name": "com.oculus.vrshell-20250704-163856.png", "id": "1399596361309151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622095_1399596367975817_8118956775723971010_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JUK4W5El34Q7kNvwE1l4xT&_nc_oc=AdkB0hMByDyq-_KJpCIHGINnma1XdZjmE4PNVOSoQYrt51ZM02W1tgrR_ZOWtLzfHrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afslfj6-7NwBM5lb5fXyjK3BNVlbdG_FUXZWcg30mJag7g&oe=69A58CE4"}, {"file_name": "com.oculus.vrshell-20250704-164349.png", "id": "1850329922210674", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618103_1850329925544007_3130083872674410349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAa7MJ7wlD0Q7kNvwETvJlC&_nc_oc=Adk7AgzkbxjOrDimyIMDnYKQGFRpQ54STPnfDGvCT6LjV4ZaHQmRQ6P_bHQcM_37MrA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftbX9j51ndBJ_13Xl_xKDbgalKQue4jee4xsg-_-tJmEA&oe=69A56F6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eye Assessment", "keywords": ["Eye", "Medvr", "VR", "Assessment", "Medical"], "long_description": "\"Eye Assessment\" is an immersive VR simulation designed to train medical students and healthcare professionals in conducting thorough eye examinations. Users are guided step-by-step through core techniques including pupil light reflex testing, visual acuity checks, and extraocular muscle assessment. This hands-on virtual experience enables learners to gain confidence and competence in identifying abnormal findings and improving clinical decision-making. Whether you're preparing for real-life patient interactions or refining your existing skills, this simulation offers a risk-free, interactive environment for mastering ophthalmologic assessments. Ideal for training programs, medical institutions, and individual learners looking to elevate their clinical examination proficiency.", "short_description": "Step into a virtual clinical environment to practice comprehensive eye assessments. This immersive simulation guides you through key examination techniques such as pupil response, visual acuity, and extraocular movements\u2014helping learners improve diagnostic skills with interactive, hands-on learning.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
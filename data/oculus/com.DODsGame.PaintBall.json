 join the red or blue team, and enter a virtual paintball arena. Use NEXUS, VOLT, PRISM, or VECTOR markers, hold your marker with one or two hands, and leave colorful paint marks where shots land. Play team rounds with people on your local network or configure AI opponents. Follow health, hits, eliminations, and round wins on the scoreboard. The first team to five round wins takes the match.\n\nOptional Windows downloads for LAN matches:\n\nPaintBall Server \u2014 host matches on a Windows PC:\nhttps://drive.google.com/file/d/1PpMscxVv0bLRc7QxGjS5u5NB1p1c_cSh/view?usp=drive_link\n\nPaintBall Spectator \u2014 watch matches, switch player views, and follow the map and scores on a Windows PC:\nhttps://drive.google.com/file/d/1HkGH1TJnd7y72N8RK_gV9j1NNkRVekY8/view?usp=drive_link", "short_description": "Choose your robot and team, then bring colorful VR paintball battles to the arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dodsgame.com/gizlilik-politikasi", "developer_terms_of_service_url": null, "publisher_name": "DODs Game", "support_website_url": "https://www.dodsgame.com/contact", "website_url": "https://www.dodsgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "28437699529262342"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-
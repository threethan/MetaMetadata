ng?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkzrW59e04sQ7kNvwF_d9YK&_nc_oc=Adp90ETKCYFV1_yixt0epcQwaXOfOM-Wp_-5Gr7n7-nT_a03N5MWlTeOiW_Oq1mqzDs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS3fSr8k3Dtn5y694EEcfU1L3EG0MTQlwAiQ0FvYPVcA&oe=6AFB47BA"}, {"file_name": "PaintBall_Gameplay_05.png", "id": "1811752613365863", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830822_1811752616699196_3629261895295192026_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAVkRGURKYMQ7kNvwGtyi5A&_nc_oc=Ado1BcYKbfovCyA24cCe68W1TsApk9BMS_AFqeqt27dtwO0jL5TyakRzmC54JJK74eQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqV-qrz0rusQftII1xmHWFo2nhqpzAt_qCylbpBShF-g&oe=6AFB4CE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PaintBall", "keywords": ["paintball", "counter", "lan", "shooter", "multiplayer"], "long_description": "Pick a robot, join the red or blue team, and enter a virtual paintball arena. Use NEXUS, VOLT, PRISM, or VECTOR markers, hold your marker with one or two hands, and leave colorful paint marks where shots land. Play team rounds with people on your local network or configure AI opponents. Follow health, hits, eliminations, and round wins on the scoreboard. The first team to five round wins takes the match.\n\nOptional Windows downloads for LAN matches:\n\nPaintBall Server \u2014 host matches on a Windows PC:\nhttps://drive.google.com/file/d/1PpMscxVv0bLRc7QxGjS5u5NB1p1c_cSh/view?usp=drive_link\n\nPaintBall Spectator \u2014 watch matches, switch player views, and follow the map and scores on a Windows PC:\nhttps://drive.google.com/file/d/1HkGH1TJnd7y72N8RK_gV9j1NNkRVekY8/view?usp=drive_link", "short_description": "Choose your robot and team, then bring colorful VR paintball battles to the arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dodsgame.com/gizlilik-politikasi", "developer_terms_of_service_url"
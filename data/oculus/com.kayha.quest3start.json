{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1776264360, "lastRevision": {"nodes": [{"id": "26487178037580577", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26487177984247249", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1568259901589334"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "965357809361260", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bams Solitaire VR", "keywords": [], "long_description": "Willkommen an Ihrem pers\u00f6nlichen virtuellen Strand. Entfliehen Sie dem Alltag mit Bams Solitaire VR!\n\nBams Solitaire VR verwandelt das klassische Kartenspiel in einen entspannenden Kurzurlaub. Stellen Sie sich vor: Sie sitzen an einer ruhigen Bucht, \u00fcber Ihnen leuchtet der Sternenhimmel, sanftes Meeresrauschen umgibt Sie, und aus einem kleinen Strandradio klingt entspannte Musik. Vor Ihnen schwebt Ihr Solit\u00e4r-Spiel direkt \u00fcber den sanften Wellen.\n\n**Maritimes Design trifft auf magische Atmosph\u00e4re**\nJedes Detail wurde mit Liebe zum Meer gestaltet. Entdecken Sie unsere einzigartigen, Bildkarten \u2013 von der majest\u00e4tischen Meeresk\u00f6nigin bis hin zu Poseidon selbst.\n\n**Greifbare VR-Physik statt flacher Klicks**\nDank unserer nativen, hochperformanten Engine sp\u00fcren Sie jede Bewegung:\n* Perfektes Greifen: Greifen Sie Karten oder ganze Stapel intuitiv mit Ihren H\u00e4nden oder Controllern. Haptisches Feedback l\u00e4sst Sie das Gewicht der Karten f\u00f6rmlich sp\u00fcren.\n* Der \"Ninja Flick\": Verbringen Sie keine Zeit mit langweiligem Ablegen. Werfen Sie die Karten mit einem leichten Schwung aus dem Handgelenk quer \u00fcber den Tisch in ihre Ziel-Slots! \n* Volle Kontrolle: Ziehen Sie das gesamte Spielfeld mit den schwebenden Steuergriffen genau in die Position, die f\u00fcr Sie am bequemsten ist.\n\n**Vier Klassiker an einem Strand**\nSpielen Sie Ihre absoluten Lieblingsmodi, perfekt angepasst f\u00fcr die Virtual Reality:\n* Klondike\n* Spider\n* FreeCell\n* Pyramide", "short_description": "Entspannendes Strand-Solit\u00e4r in VR. Lausche dem sanften Meeresrauschen, greife die Karten mit deinen eigenen H\u00e4nden und genie\u00dfe die Magie."}, {"images": {"nodes": [{"file_name": "BSVR1440x1440.png", "id": "2265746220908120", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820496_2265746224241453_8663149544726326029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4pn9lERStoQ7kNvwFhx5lZ&_nc_oc=AdrAcRtHjuKNrSsF40mXVRgKNLGVu1dL9VT0Z6FjhMeOZ0jx6SyOklPwpnAiLLzDQRM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvFDxFKdjcdFVFFUxNLBbABIjZBg0GEWwq6O-kLm5uXQ&oe=6A8D9103"}, {"file_name": "bams_icon.png", "id": "1853345692009190", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821674_1853345695342523_4969261726722226581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kZ8COonT1kQ7kNvwG4Kw1e&_nc_oc=AdozCL0yYWm-cZ49tWQX214dnRJZFxY-32MVG-wJV3DwKSzMUxvwmLlgYHwdaAZtx-M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDC_G-6hAf2JQZCHB7tFLBnMDjNCdoEALMQYH7KrVR6g&oe=6A8D65E0"}, {"file_name": "BSVR1008x1440.png", "id": "1280206627403407", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823812_1280206630736740_1767039078555120883_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVBmt1ee9AsQ7kNvwG577md&_nc_oc=Adr8EHBIpVchVt9NzrWlzBGZJb1q07wrO9a5HgaSREZDvBISVMZB55ebuXt8DfYcDXw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIwh0CU9-Iol1U3wtzjhNK53e_4EKt088EQlRQcSJHfg&oe=6A8D7498"}, {"file_name": "BSVR2560x1440.png", "id": "1240424004917207", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822327_1240424008250540_5120684943954837147_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN5kUMf0Wc8Q7kNvwEk1Bzg&_nc_oc=AdrrLxTNdRkayWryGrXnZpphLAIM71oixKPIdljAd0qert-C0SqMVFXYJrGwK5ecvgI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9SB97tWNpV8Yhughf9SXhn3ox4b0C2DUhhX--zphYQw&oe=6A8D77D6"}, {"file_name": "Hero Art BSVR.png", "id": "933944619503893", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823802_933944626170559_4723201925290549549_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkvirHhanX4Q7kNvwECN5PP&_nc_oc=Adpmq-0Ji3MwnRYj056AQyC1QPfVdBEy6Ui7uXcY1bH5brjn4-uC7tMlowTeXtXbIQk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3U2FkbEAM6OlAGGGx-KxJEmEZ0HleVSqV33-rJUM10w&oe=6A8D6730"}, {"file_name": "bams_logo_meta.png", "id": "793646677155197", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821782_793646680488530_2105530370413873091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByRPKkqMwfoQ7kNvwFzhD-x&_nc_oc=AdpTxmv3fMNxyYOrrBNjM_qXa8IHdCmK3tBZW8jDMPiruW-tJa7gtWQiANGOTa5-b2g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3D6nckLsgQol_QfYiw1AHnMPGJ4h0oxu1eJ3JZ0R2wA&oe=6A8D84E9"}]}, "id": "838816315903314", "locale": "en_US", "screenshots": [{"file_name": "ScreenshotBSVR2.png", "id": "1298204515582726", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821568_1298204518916059_8869792458384025742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in14assf9LoQ7kNvwGOw2FW&_nc_oc=AdrawGD3ppUIA3MI02cIK5aahZO-h-yTMdiXt0YYxq5DWexH8AYwUgWHdPJf8O1pjSA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtN6h1QJ0Y98_RDUcUiIj_4F3bPGkmThW5hQdVUefhiw&oe=6A8D9196"}, {"file_name": "ScreenshotBSVR4.png", "id": "2985541324983450", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820855_2985541328316783_6181994284030423808_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NswNH-xkaLwQ7kNvwEX4eCh&_nc_oc=Adr5ik_IXdtBBfFMoyIZrHdZUKxzgjHZsAajKXXhQVeIGJkgogBS0kAsxCe536SGoL8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Qtyu1R0JyeWFecHBkBy82la8Eluy55PFnr01gvSENg&oe=6A8D9BFE"}, {"file_name": "ScreenshotBSVR5.png", "id": "26075450892156956", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821696_26075450915490287_155639571789113632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hzoyMDbml0Q7kNvwEHZNRQ&_nc_oc=AdolxJgwhl_MwHMPEF2ZT913C3Sg0dPChv5_fGx1L3CZbmOZ5VgEzxo3nH1LBjXlXMc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX4e8ZD8tt88P_ONSvGamW93OOBa1V-XeC4Fk8pwLRzA&oe=6A8D718F"}, {"file_name": "ScreenshotBSVR1.png", "id": "1647149749963491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820923_1647149753296824_4887864137137797585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcWTCZTnL6IQ7kNvwFVnzGs&_nc_oc=AdqKIt_5QuAFAyHA84Kk_4JpGJ1SBKa5IqhlpnSjjUXwwTAfSi6tc64fMaXlwVRvB2c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-VpE6JLXdLL05ZEdIjWJSmVbdwx2fVwKPJOx5vaZWoQ&oe=6A8D6AA1"}, {"file_name": "ScreenshotBSVR3.png", "id": "1582692552837284", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828104_1582692556170617_5582135335785372982_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPZCtjE9CXUQ7kNvwFA9Gu8&_nc_oc=AdqFaIiIz_Z3OrgivFBqtX0UbJW0MgiaSRcBNMmVP0V8VcSnnEp-PcKdjAYof4doOxg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE75KJ-u601IL_jH2ho8fp4nyJg7i6lLsholdCp3vUaxg&oe=6A8D6F70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bams Solitaire VR", "keywords": [], "long_description": "Welcome to your personal virtual beach. Escape the daily grind with Bams Solitaire VR!\n\nBams Solitaire VR transforms the classic card game into a relaxing getaway. Imagine sitting by a quiet bay, the starry sky shining above you, surrounded by the gentle sound of the ocean, while relaxing music plays from a small beach radio. Right in front of you, your solitaire game floats above the gentle waves.\n\n**Maritime Design Meets Magical Atmosphere**\nEvery detail has been crafted with a love for the sea. Discover our unique, hand-drawn face cards \u2013 from the majestic Sea Queen to Poseidon himself. Play with maritime card backs and let the environment enchant you as a message in a bottle drifts in the water.\n\n**Tangible VR Physics instead of Flat Clicks**\nThanks to our native, highly performant engine, you feel every movement:\n* Perfect Grabbing: Intuitively grab cards or entire stacks with your hands or controllers. Haptic feedback lets you literally feel the weight of the cards.\n* The \"Ninja Flick\": Throw the cards across the table into their target slots with a flick of your wrist!\n* Full Control: Drag the entire playing field into the exact position that is most comfortable for you using the floating control handles.\n\n**Four Classics on One Beach**\nPlay your absolute favorite modes, perfectly adapted for Virtual Reality:\n* Klondike\n* Spider\n* FreeCell\n* Pyramid\n\n**Exclusive VR Features:**\n* Interactive Environment: Turn on the beach radio, read mysterious messages from the bottle,", "short_description": "Relaxing beach solitaire in VR. Listen to the gentle sound of the ocean, grab the cards with your own hands, and enjoy the magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bams-design.ch/game/datenschutz.txt", "developer_terms_of_service_url": null, "publisher_name": "Bams Design", "support_website_url": null, "website_url": "https://bams-design.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26487177997580581"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1653856032422518"}, {"status": "PUBLISHED", "id": "974055541763131"}]}, "baseline_offer": {"id": "1653856032422518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778905860, "status": "PUBLISHED", "id": "1653856032422518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26584825394482507", "version": "1.0.4"}, "id": "1444631510761262", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26487177984247249", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26584825394482507"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1444631510761262"}]}, "change_log": null, "created_date": 1776259933, "id": "26584825394482507", "version": "1.0.4", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26487177984247249", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "i
15903314", "locale": "en_US", "screenshots": [{"file_name": "ScreenshotBSVR2.png", "id": "1298204515582726", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1298204518916059_8869792458384025742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMd1eH3x5ycQ7kNvwG39tfx&_nc_oc=AdovrxXmMxZBO_Oo1NSrWbtzlqA-4aaKQMUNkaQzh-TurIPeeQL9nrVAA4roFga6BZs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nwaLTe4AVc-MH8-vz-tiVCPmbN_HiXBB_dCz63db-SQ&oe=6A01D296"}, {"file_name": "ScreenshotBSVR4.png", "id": "2985541324983450", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820855_2985541328316783_6181994284030423808_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mqpg-W4wgcQ7kNvwF5klVg&_nc_oc=Adq4mZwH6w4i0_PrJvZSn5pitjUcJSJFhDkW8jAU6v-QWo9f64XOoZANTRoYYTyzCSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OR6d1-iscJYRS6S-OmdsWQPWlk1l_wHPUN5GpqCzbMw&oe=6A01DCFE"}, {"file_name": "ScreenshotBSVR5.png", "id": "26075450892156956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821696_26075450915490287_155639571789113632_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1yaL4-YO5EQ7kNvwFUtOqx&_nc_oc=AdrvfeCqCOizqu6opHsjPL4-rwf2V8BVteZZzWPFGIVbTa0WZMe2Yd3GG4xztHg1piI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dEYxZdD6mhoIx7ERyBpEJuhwR03g_ss5DXXUbIUxVsg&oe=6A01EACF"}, {"file_name": "ScreenshotBSVR1.png", "id": "1647149749963491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1647149753296824_4887864137137797585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EinI7vfOAzoQ7kNvwEVuq4e&_nc_oc=AdqLYV4nNU60EMDYg9o_AckuQlrcLef9gcscheXXqf7dzh1o8JcB1AcS3m99cvTMEHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65Z2ixOAFsemooci_Xb6GE2l4JamS9HzVyVofHerZmQQ&oe=6A01E3E1"}, {"file_name": "ScreenshotBSVR3.png", "id": "1582692552837284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828104_1582692556170617_5582135335785372982_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3o5dJzwrBgQ7kNvwEuIaMK&_nc_oc=AdqLu0cJs3N1jGoh73RnNxDhftcwtSt7OSzZlNP6nK42hq96IBvwKJCIfoIvhOZdWm8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VfxaDs2qwhb7GReGj0OYSg2sPfV14DSSKKyj9jTmj2w&oe=6A01E8B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bams Solitaire VR", "keywords": [], "long_description": "Welcome to your personal virtual beach. Escape the daily grind with Bams Solitaire VR!\n\nBams Solitaire VR transforms the classic card game into a relaxing getaway. Imagine sitting by a quiet bay, the starry sky shining above you, surrounded by the gentle sound of the ocean, while relaxing music plays from a small beach radio. Right in front of you, your solitaire game floats above the gentle waves.\n\n**Maritime Design Meets Magical Atmosphere**\nEvery detail has been crafted with a love for the sea. Discover our unique, hand-drawn face cards \u2013 from the majestic Sea Queen to Poseidon himself. Play with maritime card backs and let the environment enchant you as a message in a bottle drifts in the water.\n\n**Tangible VR Physics instead of Flat Clicks**\nThanks to our native, highly performant engine, you feel every movement:\n* Perfect Grabbing: Intuitively grab cards or entire stacks with your hands or controllers. Haptic feedback lets you literally feel the weight of the cards.\n* The \"Ninja Flick\": Throw the cards across the table into their target slots with a flick of your wrist!\n* Full Control: Drag the entire playing field into the exact position that is most comfortable for you using the floating control handles.\n\n**Four Classics on One Beach**\nPlay your absolute favorite modes, perfectly adapted for Virtual Reality:\n* Klondike\n* Spider\n* FreeCell\n* Pyramid\n\n**Exclusive VR Features:**\n* Interactive Environment: Turn on the beach radio, read mysterious messages from the bottle,", "short_description": "Relaxing beach solitaire in VR. Listen to the gentle sound of the ocean, grab the cards with your own hands, and enjoy the magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bams-design.ch/game/datenschutz.txt", "developer_terms_of_service_url": null, "publisher_name": "Bams Design", "support_website_url": null, "website_url": "https://bams-design.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "it", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26487177997580581"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "974055541763131"}]}, "baseline_offer": {"id": "974055541763131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776264360, "status": "PUBLISHED", "id": "974055541763131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26584825394482507", "version": "1.0.4"}, "id": "1444631510761262", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26487177984247249", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26584825394482507"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": 
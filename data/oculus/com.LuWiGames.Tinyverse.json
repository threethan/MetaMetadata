iler_thumbnail": null, "display_name": "Microverse", "keywords": ["Exploration", "Adventure", "Secrets"], "long_description": "Step into the Tinyverse, a colorful and imaginative VR world designed for curious minds and playful adventurers Tinyverse offers a rich single-player experience where you\u2019ll tackle clever challenges, uncover secrets, and solve puzzles at your own pace. When you're ready for some social fun, hop into multiplayer mode to explore, chat, and enjoy the tiny universe with friends. Tinyverse combines brainy gameplay with lighthearted multiplayer vibes, creating a unique blend of discovery and fun.", "short_description": "Tinyverse is a vibrant VR adventure, featuring single-player puzzles and a fun, casual multiplayer mode for social exploration."}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1SPZXxeGbv0tSDS-l7vtJEjp8eBvWsuQEAy1vd6QNfBE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LuWiGames", "support_website_url": null, "website_url": "https://luwigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29498266996453266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393450_1172990814371360_3806441579076240602_n.png?stp=dst-png_s
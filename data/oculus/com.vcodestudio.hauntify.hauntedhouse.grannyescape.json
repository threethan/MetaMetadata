XfDGkBXIYcQ7kNvwEWAx_B&_nc_oc=Adq3TzSDoF-v-49f7UK3ydbMiC59O5AApbhhN_vLZw0AQzXgbB7KNp_T3vdm1yIf8bY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0-GhTuEqISjSGd5EKBf2uiSCZeRGt-XLMlbi2IKeCJg&oe=6A522F1B"}, {"file_name": "Screenshot_5.png", "id": "1940206179969562", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821704_1940206186636228_6511898309258775861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7inJ61YFPtoQ7kNvwFEUysZ&_nc_oc=Adq-y7syaDtxBiGRybRQOneT5sMTuj09mAB8pg5mKXsRyeW7eE9VZo1IjV6ttqVZhlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAFc489RleXZe4O3hgFd9-sgUVJ87NOuliLgfp7xt3_w&oe=6A5231E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hauntify : Haunted House Granny Escape", "keywords": ["HauntedHouse", "HorrorVR", "EscapeGame", "GrannyHorror", "ScaryGame"], "long_description": "Step into the ultimate horror experience with Hauntify: Haunted House Granny Escape! \ud83c\udfda\ufe0f\nDare to enter a haunted house where an evil Granny lurks in every shadow. Your goal: escape before it\u2019s too late. Every creaking floorboard, every dark corner, and every sudden scare will test your courage.\nFeatures:\nTerrifying Horror Atmosphere \u2013 Explore a fully immersive haunted house filled with scares at every turn.\n\n\nEvil Granny Pursuit \u2013 Avoid the Granny who\u2019s always one step behind you.\n\n\nEscape Challenges \u2013 Solve puzzles, find hidden keys, and unlock secret rooms to survive.\n\n\nMixed Reality / VR Ready \u2013 Experience horror like never before with full VR or Mixed Reality support.\n\n\nOriginal Scary Design \u2013 Unique house, Granny character, and spine-chilling sound effects.\n\n\nDo you have what it takes to survive the night? Every second counts in this heart-pounding horror escape!\nHauntify: Haunted House Granny Escape is perfect for fans of horror, escape challenges, and immersive VR experiences. Face your fears\u2026 and try to get out alive!\n\n", "short_description": "Survive the evil Granny in a terrifying haunted house escape VR adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "es_MX", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25465409349801022"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "3577012522465635"}, {"status": "PUBLISHED", "id": "2958264304541222"}, {"status": "PUBLISHED", "id": "1446386260013351"}, {"status": "PUBLISHED", "id": "1275079030637466"}, {"status": "PUBLISHED", "id": "1423012959050939"}]}, "baseline_offer": {"id": "1423012959050939"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "3577012522465635"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25487082267633730", "version": "1.0.0"}, "id": "1143049601213091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN07plDhk0eP9Kzgo1NggSQ9cZq75WTFJ3GEIwrj_dj8w&oe=6AE5EF06"}, {"file_name": "Screenshot_4.png", "id": "2815676642101494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_2815676645434827_1388319343527833190_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAtOdy19oTQQ7kNvwE8XWAe&_nc_oc=Adr7t7Rl4iYhd3k-gqFY06HsjUDvc0v7E9cIl3UKmBJ3k0uCkM5i8D7u95LmLzJ4_eI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlZ0IodCrvANQSqOvEhLWXowylC51Y4rKbIERiptOPCw&oe=6AE6166B"}, {"file_name": "Screenshot_3.png", "id": "966934569026215", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_966934572359548_2103172006788321747_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRLoOsBtQBsQ7kNvwHeShbm&_nc_oc=AdqhNkCpmf9WMt7XHOMO4YWsoJ0UCxzj_E-QbWOInttzAWnln3Y2jLDbenwd6eE5e5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmwmM4V3ROp20hoIlIdqJZSGkXbQz3pcMm6Drw9RRRRQ&oe=6AE60F5B"}, {"file_name": "Screenshot_5.png", "id": "1940206179969562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1940206186636228_6511898309258775861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDflajFPlE0Q7kNvwG-kJ-z&_nc_oc=Ado_uRwKfOG5yRCFPZ4Qt__oeQFyflUL5Gk2ovIRlf4SWOTox55No5ljKOmPn4ud5Co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTfEFddOnw9eSZEyHPAAsD9n2nF4UQpoRn0o4_eYtISg&oe=6AE61229"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hauntify : Haunted House Granny Escape", "keywords": ["HauntedHouse", "HorrorVR", "EscapeGame", "GrannyHorror", "ScaryGame"], "long_description": "Step into the ultimate horror experience with Hauntify: Haunted House Granny Escape! \ud83c\udfda\ufe0f\nDare to enter a haunted house where an evil Granny lurks in every shadow. Your goal: escape before it\u2019s too late. Every creaking floorboard, every dark corner, and every sudden scare will test your courage.\nFeatures:\nTerrifying Horror Atmosphere \u2013 Explore a fully immersive haunted house filled with scares at every turn.\n\n\nEvil Granny Pursuit \u2013 Avoid the Granny who\u2019s always one step behind you.\n\n\nEscape Challenges \u2013 Solve puzzles, find hidden keys, and unlock secret rooms to survive.\n\n\nMixed Reality / VR Ready \u2013 Experience horror like never before with full VR or Mixed Reality support.\n\n\nOriginal Scary Design \u2013 Unique house, Granny character, and spine-chilling sound effects.\n\n\nDo you have what it takes to survive the night? Every second counts in this heart-pounding horror escape!\nHauntify: Haunted House Granny Escape is perfect for fans of horror, escape challenges, and immersive VR experiences. Face your fears\u2026 and try to get out alive!\n\n", "short_description": "Survive the evil Granny in a terrifying haunted house escape VR adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "es_MX", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25465409349801022"}}]}, "scheduled_offers": {
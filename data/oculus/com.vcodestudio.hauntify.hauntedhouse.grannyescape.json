//scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831382_957163363612861_5381869952155030945_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--jRnd2u20cQ7kNvwE0xpmG&_nc_oc=AdoYM-6hu22QHwMdkTiJc9wYPP17VIpXS7ybGmN4dMFciMkH34Wo6FQU-u3g-lCMYVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNEmdgdIBcYomxTfUCEkNxFS0Z0szLuhRJLZaetg0yig&oe=6B0EFB2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horror Escape VR: Haunted House", "keywords": ["HorrorEscapeVR", "HauntedHouse", "SurvivalHorror", "EscapeAdventure", "HorrorEscapeGame"], "long_description": "Horror Escape VR: Haunted House\n\nENTER THE HAUNTED HOUSE. SURVIVE THE HORROR. FIND YOUR ESCAPE!\n\nAre you brave enough to enter a terrifying haunted house? Step into Horror Escape VR: Haunted House, an immersive virtual reality horror adventure where danger awaits around every corner. Explore dark rooms, uncover hidden secrets, face a terrifying enemy and find a way to escape before it's too late.\n\nExperience the fear of a haunted house like never before in this thrilling VR horror escape game.\n\nEXPLORE THE HAUNTED HOUSE\n\nEnter a mysterious and terrifying house filled with dark corridors, creepy rooms and hidden secrets. Explore your surroundings and discover what awaits behind every door.\n\nESCAPE THE HORROR\n\nFind your way through the haunted house, overcome challenges and search for clues that can help you escape. Every room brings new challenges and unexpected surprises.\n\nSURVIVE THE TERRIFYING ENEMY\n\nStay alert and watch your surroundings. A dangerous enemy is waiting for you. Avoid getting caught, move carefully and do whatever it takes to survive.\n\nFEATURES\n\nImmersive VR horror and escape gameplay\n\nTerrifying haunted house environment\n\nCreepy rooms and dark corridors\n\nHorror exploration and survival challenges\n\nA frightening enemy to avoid\n\nAn intense virtual reality horror adventure\n\nPut on your VR headset, enter the haunted house and fight for your escape!", "short_description": "Explore a haunted house, survive terrifying encounters and find your escape in this immersive VR horror adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "es_MX", "fr", "it", "ko", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28406961165645811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908850585_1213485201357383_3737494471552851131_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7H6edheHmEQ7kNvwF4ZxfA&_nc_oc=AdolzOj5ID448AG2QAq0vK-Cnv70TmCvu4FUUdqL2JuHWcBJ33TC-YS5qNAOaSJCTxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCwEiuRK9ROOAhU_6Tn4mMAtHBOc9UTO0Us3NDXBNCaA&oe=6B0EFD2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horror Escape VR: Haunted House", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
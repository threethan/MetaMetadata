ap through wild maps using only your hands. Tag friends, escape hunters, and explore open worlds in fast-paced multiplayer chaos. Master your movement, outsmart your opponents, and become the ultimate gorilla. Intuitive VR controls, smooth motion, and endless fun make every match a new adventure. Jump, climb, and tag\u2014your jungle playground awaits!", "short_description": "Pop Tag is a fast-paced VR multiplayer game where players use their arms to run, climb, and tag each other in immersive maps. Chase, escape, and out-maneuver other gorillas using movement-based locomotion. No buttons, no sticks \u2014 just pure movement and skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/poptag/home", "developer_terms_of_service_url": null, "publisher_name": "Popvr", "support_website_url": null, "website_url": "https://sites.google.com/view/poptag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25849862334644317"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25025447723801171"}]}, "baseline_offer": {"id": "25025447723801171"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768429620, "status": "PUBLISHED", "id": "25025447723801171"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1e7OnwqeokQ7kNvwHAqvLf&_nc_oc=AdoN-O0RdGmrlX3J_Scy7Ba90L5We0OEVpZF49GHyuKYbXIvZt8UGlXo-SU56fMU5zc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7wTgdg8VYoYA-DJTzqY8Rva6ED670dMdrQgrdktQYEA&oe=6B0B3D75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Tag", "keywords": [], "long_description": "Pop Tag is a VR game where your arms are your legs! Swing, climb, and leap through wild maps using only your hands. Tag friends, escape hunters, and explore open worlds in fast-paced multiplayer chaos. Master your movement, outsmart your opponents, and become the ultimate gorilla. Intuitive VR controls, smooth motion, and endless fun make every match a new adventure. Jump, climb, and tag\u2014your jungle playground awaits!", "short_description": "Pop Tag is a fast-paced VR multiplayer game where players use their arms to run, climb, and tag each other in immersive maps. Chase, escape, and out-maneuver other gorillas using movement-based locomotion. No buttons, no sticks \u2014 just pure movement and skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/poptag/home", "developer_terms_of_service_url": null, "publisher_name": "Popvr", "support_website_url": null, "website_url": "https://sites.google.com/view/poptag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
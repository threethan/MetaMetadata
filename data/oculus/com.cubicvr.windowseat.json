.com/v/t64.5771-25/908835878_1755257205944065_7958195854421631243_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-DPitlNhosQ7kNvwEQsLlD&_nc_oc=Adr0rtMVH8gYJHRd3kZSW30lxIdg8PQJacjPLm01OJUzVDCUYVGLjQUp4h798VMoo7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUisUOBHHzc4-vUoCZc0beZFXZtU8yCk4dwxbIOmPYB-A&oe=6B106817"}, {"file_name": "WS Screenshot 5.png", "id": "1646167246969797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835862_1646167250303130_6569506515620595264_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCrh6kG5uFMQ7kNvwEw_jJn&_nc_oc=Adphv2bT2CDiyMHcSnuqPYsvULKeZho5cvc1QGFvUEpm9bBl03jRLHyIvCQdl9n_x6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkVR3RX9NsPvh5pbnTXt5kp-fBs_GWrs44EDLNyexmmw&oe=6B104559"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Window Seat", "keywords": ["paper", "plane", "portal", "casual", "mr"], "long_description": "Take a window seat, wherever you're sitting.\n\n**Window Seat** is a casual mixed-reality paper-plane game built for your hands, your chair and the few spare minutes in your day.\n\nA small window opens onto a golden sky filled with floating islands. Pick up a plane, line up your shot and let it sail. Thread rings, aim for island landings and see what a little practice can do for your score.\n\nDesigned for seated play, the action stays close to you. Small hand movements do the work, so you can enjoy a little escape from a chair, a couch or an airplane seat. Your real surroundings stay in view while a miniature world waits beyond the window.\n\n- **Use your hands:** pick up, aim and throw naturally. No controllers required.\n- **Make a little time for play:** short rounds and simple interactions make a few spare minutes feel rewarding.\n- **Stay comfortably seated:** compact gestures and minimal reaching keep the game within your personal space.\n- **Enjoy the view:** cozy cottages, windmills and castles sit among sunlit clouds and floating islands.\n\nDrop in for a few throws or stay to chase your personal best. Your next little adventure is within arm's reach.", "short_description": "Turn a few spare minutes into a little escape. Toss paper planes through a magical window into a golden sky of floating islands. Designed for seated play with just your hands, Window Seat brings quick, satisfying challenges to your chair, couch or airplane seat, with small gestures and minimal movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cubic.cool/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cubic", "support_website_url": null, "website_url": "https://cubic.cool/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2834620206934172"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1146433511204917"}]}, "baseline_offer": {"id": "1146433511204917"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795274760, "status": "PUBLISHED", "id": "1146433511204917"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2861830504213142", "version": "3.5.1"}, "id": "1627462802453986", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
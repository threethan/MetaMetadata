szpaDHACIJLJ1UHmyJocNTw3kPZVMr2219X_Zq4R3Q&oe=6A8ED501"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkuTNcqvbCUQ7kNvwGAKPF5&_nc_oc=AdrfCIS6uR-nmmfnHbGBMcJyTrhxgMRPF_2X0BZQHTkCK5mB4fpeQRTq_y4NsMlhiT8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdmQzFU0W7KjFO8dfBexWjlIrXpJGJKBnnUxSWbVfpew&oe=6A8EEB81"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMENwWEeMVIQ7kNvwFfo9MO&_nc_oc=AdqVHRnzI2eW0C38tUFzsOsGp4j4GeHBeAd5xCKTX4TCYnvrMysSG2Fk0WC2qg3A0Oc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk_4Hq6imOQ2szjX8el2t4ZMTrNQRgC5F2FW2w8c85Fw&oe=6A8EF439"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58pNl1nwjvQQ7kNvwE0CFsV&_nc_oc=AdrTfOZFFEJQ1vJpLsrumhFtrMalwsl5sXC4beQqo_RGewX_GRUqsVZPF6zTNePN8xo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9TwNCRMOKj1Dg1WSPy9enlKLEat1b5tq_BiXzLOu9-Q&oe=6A8EE838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOf2wmsrs4kQ7kNvwFQWKkS&_nc_oc=AdrmzNDprOOdoHy2t700rwYWByJ9_0zSmzISH9Ve9Wu7_ENZAleR_ISz8kcG-f7Y6p4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlFq8NOWl2w4XfxwfdwVnUIh15IMqirJuppN_t_g41qw&oe=6A8ECC3C"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadelegendvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LAI Games", "support_website_url": "https://arcadelegendvr.com/support/", "website_url": "https://arcadelegendvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_
48N_jVPsdrSA&oe=6AA3ED01"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8B1UiI6S14Q7kNvwFKsc6m&_nc_oc=Adqyfo9UjhLOfuG2JF-ekziEBkNEQM9J-Lk8IOolr6HHyNG8k2xn9E9RgqSImZK-lHE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK9zkFRVbbwAzrH1s7nZdIbQY-CWioC7PDtO__ngEadg&oe=6AA40381"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7q_kTKxsrUQ7kNvwGIsiIp&_nc_oc=AdryY4Y0rnq_YM2cGyhmYqEMZwtc7QULEIhJsoWXhLvuUKds1XwMK44pXRYqyBF5AkE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLadRHn77aNk9FLktF2AeSFXndp8ROycBlDmi_Fp9HXOQ&oe=6AA40C39"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZD1qK8X2nYQ7kNvwEJ5ZKy&_nc_oc=AdqGba9kdPw3-Hki1luv24iXd3zDQSjjeNH469XbwcgWkyZWojaEvtyugQKDKUnEiVY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTAmsYZECmnOZada-n6Wve4KkLoGzZgmoL7m45eB5plw&oe=6AA40038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPbOabL7iFsQ7kNvwGLGgOj&_nc_oc=Adrlb_PIFgqiEuWFEquT05f4BwQdCX0KNeZ24FzG5vXh8tfQi9pJceodY5Lo7uY0QKw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkhhNE5TENDykDZ-St73j-rqUZ0UDcJC42TrO4r3cnwQ&oe=6AA41C7C"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadelegendvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LAI Games", "support_website_url": "https://arcadelegendvr.com/support/", "website_url": "https://arcadelegendvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection
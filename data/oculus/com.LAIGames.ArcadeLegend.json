-sin6-3.oculuscdn.com/v/t64.5771-25/39001659_528228039196919_6716668141276031986_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6iwJCNYoe8Q7kNvwFurz9i&_nc_oc=AdlUVBSkZfn2dJAWrUUfNEQu3QTS8vWstSoCWI7uM1WXUrUVpU5XKXmUD0Y0_mz1oBo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPzkwKVElCABW8bB2TCEds2I8CC47KcZuqId8kMgR5nw&oe=69AAC3E4"}, {"file_name": "Arcade-Legend-ScreenShot-FullArcade.png", "id": "861482684993314", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974918_861482688326647_6615609497852037315_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atDV4xWy1kwQ7kNvwHM4_F4&_nc_oc=AdmjN6oG14oErdMYgrkTxP4tempt1ObzdM_kUmHidWGiuMC53Ig79g7OJ3gayrMiM04&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpjzEWwWgJj03qzOYF_Z6XM2K45R6tb5gQlfV-BmP5SQ&oe=69AAC181"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TSyv2mrbNsQ7kNvwEfOeRR&_nc_oc=Adkild74uK-__zBni3NRAlyMSPpztuZ7JQc1A0mpk7ESpT6Aq73dLD8ULgJQPchCP9A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1CxTyYhbSMlQBb-3Il88pX-hnIGCyTJyH_60R_pwlqw&oe=69AAD801"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frPzILAu22YQ7kNvwFkyE4g&_nc_oc=AdlK6bhroBL2A0i7cC2M4DjiALK7xC7wC1p6WKtBuiuBjTTSpv3J3LMdph6Xa0Ia-ZY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp7VLP70Opvzdk37Jy3YLtm-EptKHJGopth_eV_Vjr5g&oe=69AAE0B9"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABMVJ2LqSosQ7kNvwF1c_Nt&_nc_oc=AdlvJ-jagdNaNO8d-8jgGwtqgjt-Im17DgMFfrHu2BQlvILCuhtSjeUHtZruySpzvEU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfycEZHAcJb9eKXPiJCo4eC9PerSoIC3xEBvkGSwPOhvYQ&oe=69AAD4B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzdqgZCd9N4Q7kNvwEP2m7Y&_nc_oc=AdnlOuY9-E0C4VnfZClRIX7Drl92_SNuh-rU02SSOgZMw7lcD_I-CAaZHsWVcMTbidg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7rj07uyC2oevYNqjPCG3xz2xkHB-35gAWdkoyWShJQA&oe=69AAB8BC"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and
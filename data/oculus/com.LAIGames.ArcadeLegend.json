69F8C241"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvXafgxdhmoQ7kNvwEsdTg-&_nc_oc=Ado7dsV8srlCCbxe8Od3aZOnosAUTwYGIwmt61eaEly5ZqVUPEPzUjuBMcBrL6kzgBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03MkKw4JBSBIskMcFaOPHrMxYj10x8pCdG90JvrzVrlw&oe=69F8A081"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIcdjJdWm5IQ7kNvwGuP7-U&_nc_oc=AdqAJwqpNF5MY-B_61e_GlIKfdaVqs5DzUEB9IClF8MAMnUuScQ4e_Ijo0GQdOViwpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QFWPrRQKSEmgVdeHLej2x8plgJBObinM1wKnyRpzwfw&oe=69F8A939"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRP550bUvBQQ7kNvwEbYsRD&_nc_oc=Adq3QsrGouThYpyXRwEXZIjC8dAZC2xErj6xKBhKfu4ssuh0KuZ7X8HHeZMN2w66Q1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E9veXdjbSsrMxKmDj5EVGB4vWyU7P91Rtr9T_XiRvdw&oe=69F89D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGbgfhQnMTwQ7kNvwH2nBuD&_nc_oc=AdoblxMn0fsndACpIsdOY4JSS5t7wPGvZO3iAWkqHDVPBzl3BhfuxToGXfaJTI0iD0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eb02FvYyr6JMYB4tk4bRTs22GfJ3QSQbT4sxrr9CO6g&oe=69F8B97C"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadelegendvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LAI Games", "support_website_url": "https://arcadelegendvr.com/support/", "website_url": "https://arcadelegendvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOW
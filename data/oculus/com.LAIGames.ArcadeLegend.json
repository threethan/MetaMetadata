69C27C81"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG_onLNpfp4Q7kNvwH0_0fq&_nc_oc=AdoiuSD-YF1kzDSpbDx3gPPLdfeDLgxQ5HpiRM9nFrOlNKK11fIqZKqKeWx6Ecw4lRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJALJR9g58HoCwJyS-nh8r2uJwZ1eZrZUYYTjzAHqCLw&oe=69C29301"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XCy3WLBIB4Q7kNvwE2XTIK&_nc_oc=AdpJ_XDU5fIX5VwX3qlwnSxkfgqSWNvGFB8slwow_hk5cT6XHdWA7uOq0s0WR_q_jIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq5UY-rrgI-fydGN_r6tEhFy0miQMRWqmVfdXJRLIkpQ&oe=69C29BB9"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN0mtAZhugcQ7kNvwE5ZH6v&_nc_oc=AdoyYafm-ONUkz_GBXQU6tfCwE6bCYGRJnqaWV7vmnaiL1wtNjnCGWTJWkLH4QbtNUk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9XCAWK6Sf9Epp3OLyxmij_x4_y6buwPE1Bx_N_4D5tQ&oe=69C28FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDvcNscfGB4Q7kNvwE9bZ12&_nc_oc=AdoONMYAi8UXn340_iN2f-9yJ_ySzzZcapdra4LunO6hTuhMEv1zZYsDaLD1rd3X8tU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyuz98BC8bFoV5Y0dbEfvuaPSqRs2CVeqCJAeNP2TUh7A&oe=69C273BC"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadelegendvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LAI Games", "support_website_url": "https://arcadelegendvr.com/support/", "website_url": "https://arcadelegendvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOW
42662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXcQrlak6E0Q7kNvwFxCUBD&_nc_oc=AdoTbaTpuV54vlreassUd2rNXc14uuSWatLiOiIND0thQ9K__zOK8rISLWtzu2xt7a8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpJbkOxUEEV209s0VL4XyM6ZUWS7SndigBclxpa9RIRg&oe=6A8D91A4"}, {"file_name": "SS-03.png", "id": "597768539228166", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031624_597768542561499_4880120697118051022_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixJJNqFz-eIQ7kNvwHKZhN4&_nc_oc=Adr9WKXplq-aWIV_2duz-vr20RYP_zkGgPCIG7hn8WrPx2o3I21eXz9-1Bm6Kksr0xo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmc0H3TsjP0qw3HF1bH7PG3lFioVqyg9F6QOXzYJYUTQ&oe=6A8D6922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-bg.png", "id": "917683639858899", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75330715_917683643192232_7454662660148024389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Swx6GKquNiQQ7kNvwEjsCkE&_nc_oc=AdoZz8r_pCpGYlgWLB-l4TgQp1uK0j9lFKeDK4J3cFSi-ZeumyhkAUWobWZwCwE6RqI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFa1bk2VQZ4c99FDRlLGlYV0LTmCYD2NuVsB2JB__x9Q&oe=6A8D7B14"}, "display_name": "Arcade Legend", "keywords": ["social", "multiplayer", "competitive", "retro", "builder"], "long_description": "# THE MOST AUTHENTIC ARCADE EXPERIENCE OUTSIDE THE REAL WORLD\nBuild and customize your own arcade while playing officially licensed games with friends! Manage your business and build your reputation or explore other entertainment venues in your neighborhood. It's the ultimate night out from the comfort of your living room!\n\n{352783870772559}\n\n**OFFICIALLY LICENSED ARCADE GAMES**\n\nPlay games, win tickets and XP, and compete for high scores on global leaderboards with up to 4-person multiplayer.\n\n{417421311136805}\n\n**YOUR OWN PRIZE STORE**\n\nRedeem incredible prizes including sports equipment, novelty toys, and avatar accessories. Unlock custom bowling balls and thematic axes, snag some music for your jukebox, or prank your friends with consumable toys like fart bombs and fireworks!\n\n{670642761947377}\n\n**RETRO ARCADE GAMES**\n\nPlay 18 unique and exciting cabinets at Arcade Galactic, a neighboring retro arcade down the street from your venue, or add the games to your own arcade.\n\n{819285182972583}\n\n**AXE THROWING**\n\nExplore BATL Axe Throwing, the pioneers of the real sport, and the first official axe-throwing experience in VR. There are 9 game modes and a target so large it needs its own zip code! \n\n{967499785085211}\n\n**10-PIN BOWLING**\n\nBowl your friends over with an incredible selection of custom bowling balls across six lanes of 10-pin bowling in your own arcade.", "short_description": "THE MOST AUTHENTIC ARCADE EXPERIENCE OUTSIDE THE REAL WORLD\nBuild and customize your own arcade while playing officially licensed games with friends! Manage your business and build your reputation or explore other entertainment venues in your neighborhood. Play with up to 4 friends in multiplayer and compete for high scores on global leaderboards. It's the ultimate night out from the comfort of your living room!"}]}, "developer_name": "ArcadeXR", "developer_privacy_policy_url": "https://arcadexr.com/arcade-legend-privacy-policy/", "developer_terms_of_service_url": "https://arcadexr.com/arcade-legend-end-user-license-agreement/", "publisher_name": "ArcadeXR", "support_website_url": null, "website_url": "https://arcadexr.com/arcade-legend", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
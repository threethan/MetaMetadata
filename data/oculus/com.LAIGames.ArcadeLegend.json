69F9DB81"}, {"file_name": "Arcade-Legend-ScreenShot-Bowling.png", "id": "3526927077535086", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982592_3526927084201752_3242800157046896720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvXafgxdhmoQ7kNvwHInE5d&_nc_oc=AdoYMn7ZxUR-BjYYi8BulYabzq-rECjjvmUalgGChDKDykyaHlElWjVQ6Jb-KJeZrzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jVWOviYMOo0e8nlGgFyfG4WnBRfgEyaPAx5VYRLa7Lw&oe=69F9F201"}, {"file_name": "Arcade-Legend-ScreenShot-Multiplayer.png", "id": "522675833125749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_522675836459082_401004978519256163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIcdjJdWm5IQ7kNvwE3pkCD&_nc_oc=AdqorXKSULanVspR8U2f6AdgPcdU4VOBQlIi4nRnnv1YUCLv99pl9joFjHaqjCo0ArM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79M1sAWQ_gpRwhZRCGz1Ja3Grk0E9DsCH0JiG1imJyWQ&oe=69F9FAB9"}, {"file_name": "Arcade-Legend-ScreenShot-7.png", "id": "678364266986275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031562_678364270319608_5229569528347897268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRP550bUvBQQ7kNvwHrTTCj&_nc_oc=AdoIlvnLi1ip6V0tkvbXsD4kPHghMMD7-RZePXiMnzS2VCqtQkBIaxEUAcNzyLfgH3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43txta_CIGpClisBe-Z-QwVhfJdFygOQVeQxaCByUCnw&oe=69F9EEB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcade-Legend-Video-Thumbnail-v2.png", "id": "697083368210796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223477_697083371544129_9128614203797304007_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGbgfhQnMTwQ7kNvwER6OzN&_nc_oc=AdoKJfumHxANd_qb0TG9QN-tqZDA3sBbXzZLfr5TEp3cJ07qv6zfqK9fz-Xb6KWN6fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5en4kVHXHmYfbxsKhgQNU2eW9Y-np4kR3xqDSMHO7l7A&oe=69FA0AFC"}, "display_name": "Arcade Legend", "keywords": ["arcade", "legend", "social", "party", "bowling"], "long_description": "Congratulations! You\u2019re the unexpected owner of an abandoned arcade, and it\u2019s up to you to convert this dilapidated building into a thriving business.\n\nWith incredible tools at your disposal and a wide variety of materials, furniture and decorations, you will restore, customize and expand your venue, revealing the forgotten secrets of this mysterious old building.\n\nFill your arcade with officially licensed games, which are yours to play for free, forever! Win tickets and claim prizes from an expansive range of consumable and collectible items in your very own prize store.\n\nInvite friends to your arcade for head-to-head competition, explore other arcades, and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!", "short_description": "You\u2019re the unexpected owner of an abandoned arcade! The incredible tools at your disposal allow you to fully customize your venue as you work to discover its hidden secrets.\n\nPlay officially licensed arcade games to win tickets and claim prizes from your very own prize store.\n\nInvite friends to your arcade for head-to-head competition and compete on leaderboards against the best players around the globe.\n\nArcade Legend is the authentic arcade experience for the virtual world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcadelegendvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LAI Games", "support_website_url": "https://arcadelegendvr.com/support/", "website_url": "https://arcadelegendvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOW
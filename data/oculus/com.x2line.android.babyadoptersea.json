3_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_br61CUaZ0cQ7kNvwGn05pU&_nc_oc=AdpAOl1ZzWj4fom1-StvxV_qkE4m6zV4fYr3tconGwSWoEWu5EaT12QgbST7KmjLX88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX706d7HJRIALcRxVgw6A1pvcyfrXpqELnDyPHT4wXYw&oe=6AEC8B72"}, {"file_name": "screen6.png", "id": "1021078590698241", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312310_1021078594031574_9033650120727992981_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsZsy9d9QnQQ7kNvwEA_Xyx&_nc_oc=Adq20Zxd4KgTMCTzM97GH0Pszz3-vVPjFY5G1letsgp28QdGht-9hebPTOqZZKb3xtk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl0DGdE8LrJh47MLw-J1JFsmjZihGLg2zqIIBtf692YA&oe=6AEC84D9"}, {"file_name": "screen4.png", "id": "1889893695038702", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499296209_1889893698372035_1971515388772861038_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oscNcf4guecQ7kNvwFHygUw&_nc_oc=AdpxJpLV7c-CGSsER8zB32VBdGklUmZKoxbps7SaAolmMk_xyKzzngexXG6oiYpTXAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNM6baZ5vy-4xkjHh-q_sl13dqBKEsyj9G7ZIdzFGF4A&oe=6AEC8CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "basea2560x1440.png", "id": "1021813343683717", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299772_1021813347017050_3165376255415043794_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noAhAYhn2v4Q7kNvwHSH_t2&_nc_oc=AdoTfIjQQC4UFBUGX_gU8Wh2ROKEl-kjNuS3gIh_H3rmTMA28W4X8AdE9XrI1YkdeXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKuGHMv_QAROZ15oRgfZFd7Z-xQjsY-sbz-SIvz_Pzwg&oe=6AEC970F"}, "display_name": "Baby Adopter Sea", "keywords": ["baby", "babysitter", "babysit", "voyage", "cruize"], "long_description": "Baby Adopter Sea is a nautical edition of the Baby Adopter game where babies and their parents travel on a cruise ship. The voyage, ship amenities, rooms and beach locations add a sea-themed setting to the experience of taking care of your little baby.\n\nChoose from 4 babies and take care of your baby every day. Feed your baby when hungry, keep the baby\u2019s energy at 30, and do not let your baby get sick. Babies should grow within 20 days.\n\nBaby Adopter Sea also includes Baby Viewer 3D, where you can see your baby as a 3D character with animations. This adds a more visual and lively experience on Quest, bringing the baby character beyond the regular care screens.\n\nBuy clothes, shoes and toys, and purchase items for the Baby\u2019s Room, Bathroom, Playroom, Game Center and Beach. Karma represents your overall game progress and player experience.\n\nYou can also go on an Egg Hunt. Look for eggs in different game locations, crack them, hatch them after 3 cracks, and collect the mini trophy creatures inside. After each crack, you need to wait before cracking the egg again. An egg that was cracked once can be found again in the same location.\n\nThe baby responds with sounds when tapped on the Main screen. Sound settings can be changed on the Account screen. The game is accessible for visually impaired and blind players with TalkBack support.\n", "short_description": "Baby Adopter Sea is a babysitting, nursery and dress up game set on a cruise ship. Choose from 4 babies, feed and care for your baby, buy clothes, shoes, toys and room items, and explore sea-themed locations. Baby Viewer 3D lets you watch your baby as an animated 3D character, adding a more visual, lively Quest experience beyond the regular care screens. Hunt eggs, collect mini trophy creatures, and follow your baby\u2019s progress as the voyage continues."}]}, "developer_name": null, "developer_privacy_policy_url": "http://x2line.com/legal/privacy_policy_gplay_basea.html", "developer_terms_of_service_url": null, "publisher_name": "x2line.com LLC", "support_website_url": "https://dboards.x2line.com/cat/baby-adopter-sea-feedback-support/", "website_url": "https://basea.babyadopter.com/", "category": null, "comfort_rating": "C
JpLV7c-CGSsER8zB32VBdGklUmZKoxbps7SaAolmMk_xyKzzngexXG6oiYpTXAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNM6baZ5vy-4xkjHh-q_sl13dqBKEsyj9G7ZIdzFGF4A&oe=6AEC8CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "basea2560x1440.png", "id": "1021813343683717", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299772_1021813347017050_3165376255415043794_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noAhAYhn2v4Q7kNvwHSH_t2&_nc_oc=AdoTfIjQQC4UFBUGX_gU8Wh2ROKEl-kjNuS3gIh_H3rmTMA28W4X8AdE9XrI1YkdeXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKuGHMv_QAROZ15oRgfZFd7Z-xQjsY-sbz-SIvz_Pzwg&oe=6AEC970F"}, "display_name": "Baby Adopter Sea", "keywords": ["baby", "babysitter", "babysit", "voyage", "cruize"], "long_description": "Baby Adopter Sea is a nautical edition of the Baby Adopter game where babies and their parents travel on a cruise ship. The voyage, ship amenities, rooms and beach locations add a sea-themed setting to the experience of taking care of your little baby.\n\nChoose from 4 babies and take care of your baby every day. Feed your baby when hungry, keep the baby\u2019s energy at 30, and do not let your baby get sick. Babies should grow within 20 days.\n\nBaby Adopter Sea also includes Baby Viewer 3D, where you can see your baby as a 3D character with animations. This adds a more visual and lively experience on Quest, bringing the baby character beyond the regular care screens.\n\nBuy clothes, shoes and toys, and purchase items for the Baby\u2019s Room, Bathroom, Playroom, Game Center and Beach. Karma represents your overall game progress and player experience.\n\nYou can also go on an Egg Hunt. Look for eggs in different game locations, crack them, hatch them after 3 cracks, and collect the mini trophy creatures inside. After each crack, you need to wait before cracking the egg again. An egg that was cracked once can be found again in the same location.\n\nThe baby responds with sounds when tapped on the Main screen. Sound settings can be changed on the Account screen. The game is accessible for visually impaired and blind players with TalkBack support.\n", "short_description": "Baby Adopter Sea is a babysitting, nursery and dress up game set on a cruise ship. Choose from 4 babies, feed and care for your baby, buy clothes, shoes, toys and room items, and explore sea-themed locations. Baby Viewer 3D lets you watch your baby as an animated 3D character, adding a more visual, lively Quest experience beyond the regular care screens. Hunt eggs, collect mini trophy creatures, and follow your baby\u2019s progress as the voyage continues."}]}, "developer_name": null, "developer_privacy_policy_url": "http://x2line.com/legal/privacy_policy_gplay_basea.html", "developer_terms_of_service_url": null, "publisher_name": "x2line.com LLC", "support_website_url": "https://dboards.x2line.com/cat/baby-adopter-sea-feedback-support/", "website_url": "https://basea.babyadopter.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "fr", "fr_CA", "fr_BE", "de", "pt_BR", "pt", "ru", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "953961284335434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310720_1572295450977849_4093946272813840273_n.png?stp=dst-png_s360x3
&_nc_oc=AdquBRe_Ut8e42kQswYhjXTq7XQYtS93dVUtSXwZ7NI56SCe_hDYyXLQP397oKfDwnw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDJ8xYIqy5b1tbky8NTDbBQnXZC75fxYQbHnVj5t1V8g&oe=6AFB2126"}, {"file_name": "1.png", "id": "292630656235614", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974680_292630659568947_5765356207768386488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihaqXmUl7I4Q7kNvwFfWIad&_nc_oc=Adro7GjxZNbBiwTtcwuaSz-WNN9AChMQCKuBaXyi8UYBTIYGMxMwzyThI_HACA7SE70&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTJ_L2fz8mDG83X4BvhHD0HDKsODs2fAMIpe6kn72Tvw&oe=6AFB1A43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EVRT First Aid", "keywords": [], "long_description": "In this first aid training, the user goes through a training scenario wherein they learn how to perform cardiopulmonary resuscitation (CPR) to a person that fainted in front of them. The scenario can be carried out either alone or with other people through an online feature that allows up to three trainees and an observer to join a session.\nThe application allows for adjusting the length and difficulty of a training session. The difficulty level determines the means of guidance that the users would receive during their training, where it ranges from auditory and visual instructions on easy difficulty to no guidance on hard mode.\nAt the end of the scenario, the users are presented with a summary that evaluates their performance during the session.", "short_description": "A first aid training simulation where a person needs to have cardiopulmonary resuscitation (CPR) performed on them after falling unconscious."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evrt.dk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EVRT", "support_website_url": null, "website_url": "https://www.evrt.dk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfo
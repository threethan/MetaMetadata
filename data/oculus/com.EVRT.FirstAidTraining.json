23_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FLgopDsgB0Q7kNvwFDfg2A&_nc_oc=AdoXny5JVntg3vnTsRYkBd_Z2CQY017bwKw-pAc4RSmhCMcXzE4ZOcTAPrZ_eJkp0Ug&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLoQ0RJgRMeUn89REGY5hIzAYoMgB-8Jpc-B4o_hAp4Q&oe=6A806857"}, {"file_name": "2.png", "id": "631319098114818", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982699_631319101448151_1630281522789687818_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcLC13KsyFIQ7kNvwGbwlxh&_nc_oc=AdqdvIDM7T0EU7Z_M4NiqGuIXbvxPbpOzGXhEaKIEZK8LrBu0402BMwQiVl2PcG6WI8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKhGvuleEvjtd5lHsycJPsVOIAyP7VoGqyqniYxBV8ng&oe=6A804D66"}, {"file_name": "1.png", "id": "292630656235614", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_292630659568947_5765356207768386488_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waEmcw1EVZoQ7kNvwFl8gq-&_nc_oc=AdpXyiUcLbea7vzfiRlshINaEara7mk0KdiikbiHJ1t-nUE73iJXPknSnDACSX2qPhI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxo3RdgGwfeI5hBOGFOacg9vaHVHFA7nqSOK1ijDt2JQ&oe=6A804683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EVRT First Aid", "keywords": [], "long_description": "In this first aid training, the user goes through a training scenario wherein they learn how to perform cardiopulmonary resuscitation (CPR) to a person that fainted in front of them. The scenario can be carried out either alone or with other people through an online feature that allows up to three trainees and an observer to join a session.\nThe application allows for adjusting the length and difficulty of a training session. The difficulty level determines the means of guidance that the users would receive during their training, where it ranges from auditory and visual instructions on easy difficulty to no guidance on hard mode.\nAt the end of the scenario, the users are presented with a summary that evaluates their performance during the session.", "short_description": "A first aid training simulation where a person needs to have cardiopulmonary resuscitation (CPR) performed on them after falling unconscious."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrt.dk/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "EVRT", "support_website_url": null, "website_url": "https://www.evrt.dk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["da"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "8858121267613102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031342_235910138724523_8929245647732086858_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4jLkkd0e-cQ7kNvwGfCmkZ&_nc_oc=Adq43pU8U_hF-IUI8jgArvSyDS93Y5YCUOVpkdimOTi8rN0x0_UuvpHCMVcwPAyARGk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlKOxl2lcoUfXZSFLKQ_QKPXtoa_gIYNSD0Kyz2xunQQ&oe=6A805E52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EVRT First Aid", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1645064985, "lastRevisio
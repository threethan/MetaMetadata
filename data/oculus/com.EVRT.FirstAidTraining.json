om&_nc_ss=7f30f&oh=00_AQR9UyJJAz0rwT61NUZfZ_OgJjztRK8QaXkBx-acswMW1Q&oe=6B0B43CF"}, {"file_name": "3.png", "id": "527811991618947", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031368_527811994952280_2160200543100480323_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ligv5bUPttwQ7kNvwH4ed5j&_nc_oc=AdovphNpl8WW5VNdISkgjm2GOcBieGrue2QAzcLyPYandva52EBZ0lY5YBm9xQ3_jFc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUCYeunNt2agUcmWMgWzseRL-L1emaCF1mqACJmZ5yAw&oe=6B0B4657"}, {"file_name": "2.png", "id": "631319098114818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_631319101448151_1630281522789687818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IJlcITv7FcQ7kNvwEyVYRz&_nc_oc=AdofGQx4Hmbqj_pXEYjQb39kybI3IJ0jVr6swHg5P9u9nggqFNkHA99YpR6BKM02alY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTP_EJOLjJ1CZ6Sp7gmEjGtGFQGNjVLJ7EJlcHxGlWcmQ&oe=6B0B2B66"}, {"file_name": "1.png", "id": "292630656235614", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974680_292630659568947_5765356207768386488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ULZ7n_qWVcQ7kNvwE4H1SC&_nc_oc=AdqfQExk-OTfnO3eq3EVqehBnhWnUDFirUoOtsqxnBjXeoOMRI7VjCj7rB1gPEan1hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR11liECFWeqV71GgAfd0vgm0PwtTusImPWZMysuc7D6A&oe=6B0B2483"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EVRT First Aid", "keywords": [], "long_description": "In this first aid training, the user goes through a training scenario wherein they learn how to perform cardiopulmonary resuscitation (CPR) to a person that fainted in front of them. The scenario can be carried out either alone or with other people through an online feature that allows up to three trainees and an observer to join a session.\nThe application allows for adjusting the length and difficulty of a training session. The difficulty level determines the means of guidance that the users would receive during their training, where it ranges from auditory and visual instructions on easy difficulty to no guidance on hard mode.\nAt the end of the scenario, the users are presented with a summary that evaluates their performance during the session.", "short_description": "A first aid training simulation where a person needs to have cardiopulmonary resuscitation (CPR) performed on them after falling unconscious."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrt.dk/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "EVRT", "support_website_url": null, "website_url": "https://www.evrt.dk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["da"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "8858121267613102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031342_235910138724523_8929245647732086858_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5jxsxbJ19UQ7kNvwGaAfgI&_nc_oc=AdrJg-nez1ijq9GGANe-qUvjnBcbq8e1ULpq92-YVV3m_NA4JDHbl7j-l4xSP75c7ek&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2TV8dqQj2uYNP7w7Y-XCSHYNkDPu4jsQ88Hp0qaqdZg&oe=6B0B3C52"}, "is_concept": false, "is_test": false, "is_
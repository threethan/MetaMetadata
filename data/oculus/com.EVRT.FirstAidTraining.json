om&_nc_ss=7f20f&oh=00_AQSDO7CahAeZ7vo5eo-FPEb1EUAcWZCdiwtmj9soUhoAfA&oe=6B007F8F"}, {"file_name": "3.png", "id": "527811991618947", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031368_527811994952280_2160200543100480323_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUMW2w8bKSAQ7kNvwF-GY7k&_nc_oc=AdqEcFesZfx4LdtdvMaMOs6WC4MufznCWRLIODPSp8GHHj0I1mIvVTBwFAOK2PIbPA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT74cysx9_-mCUk8SyoPN9QlaVuDHMqZAS5p82ILX47fA&oe=6B008217"}, {"file_name": "2.png", "id": "631319098114818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_631319101448151_1630281522789687818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Djwsxdk2WfgQ7kNvwFTTCcx&_nc_oc=Adpelpi5lpXxUPTB_nbzb-AeXbhsnCpYJnlAJN68fiG6X3T_v7x5oeGNZmSqE6iLs9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTupUKAfUc_3bwbHx8Iz44YrdEXypSV1-HRilRIUbtFXw&oe=6B006726"}, {"file_name": "1.png", "id": "292630656235614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974680_292630659568947_5765356207768386488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9tP26avbAcQ7kNvwF3zqwA&_nc_oc=Adoolr5jH1VjgI34IiR4ZVhd1obQsz36JsU3_vmeZVUNBBEdag3MAr8Ahz6ROhgnfyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbmYuO1vLCwR0tOOxSm9TPOCXMJiaobiZM0xIPw3EzQQ&oe=6B006043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EVRT First Aid", "keywords": [], "long_description": "In this first aid training, the user goes through a training scenario wherein they learn how to perform cardiopulmonary resuscitation (CPR) to a person that fainted in front of them. The scenario can be carried out either alone or with other people through an online feature that allows up to three trainees and an observer to join a session.\nThe application allows for adjusting the length and difficulty of a training session. The difficulty level determines the means of guidance that the users would receive during their training, where it ranges from auditory and visual instructions on easy difficulty to no guidance on hard mode.\nAt the end of the scenario, the users are presented with a summary that evaluates their performance during the session.", "short_description": "A first aid training simulation where a person needs to have cardiopulmonary resuscitation (CPR) performed on them after falling unconscious."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrt.dk/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "EVRT", "support_website_url": null, "website_url": "https://www.evrt.dk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["da"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "8858121267613102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031342_235910138724523_8929245647732086858_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srw6yuRTpeMQ7kNvwFkfLG2&_nc_oc=Adr57zd-mgaHbAagkzqtdmWE06i6CngTdeBlOvm4m-k1Fn2QyqyvFivr67iNnxUxIK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFztYHOsXfnORqsUX0RLNEqLPiG4HJWdIKj0jsUm72yw&oe=6B007812"}, "is_concept": false, "is_test": false, "is_
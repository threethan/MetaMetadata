om&_nc_ss=7f30f&oh=00_AQQH54r-vN5J1IcTt3f_obPUcNnY1bFXOgODfqfQMEagGA&oe=6B0DAE8F"}, {"file_name": "3.png", "id": "527811991618947", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031368_527811994952280_2160200543100480323_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_ZwLXRq948Q7kNvwGbwvmf&_nc_oc=AdowyIMsWU7VgIuuk1lRqEdY8jl9x8V1N_3qaVj_u21ae24NzUNbDdPBGEP4_cf20q4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEEjtIVNmaGHnHgEqz8omzZ41WkEg3w343ZUW2X0cyCQ&oe=6B0DB117"}, {"file_name": "2.png", "id": "631319098114818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_631319101448151_1630281522789687818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IJlcITv7FcQ7kNvwEbZs3h&_nc_oc=AdodbUO8KN66zzfLcmRHSSEokRQwrBJpJ28usL9xl02cWRWQWyvFSewvBkp84Jl7NxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRX6HZgXj6pxwv1MSA2cwq5izIvLZF9dg7jYRQJyWnXMA&oe=6B0DCE66"}, {"file_name": "1.png", "id": "292630656235614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_292630659568947_5765356207768386488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKe3GyssTAwQ7kNvwEmopLf&_nc_oc=Adq9RA3Ad6lGSIcLLVMRYNlro9my7r9NYTDcsPktP9XmMCO1aakb-_hkbNBfaa01X04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRK4eaKfO7VuNd7OFGGqHdsr4zJLOoB4w7u-y8LwSOIvw&oe=6B0DC783"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EVRT First Aid", "keywords": [], "long_description": "In this first aid training, the user goes through a training scenario wherein they learn how to perform cardiopulmonary resuscitation (CPR) to a person that fainted in front of them. The scenario can be carried out either alone or with other people through an online feature that allows up to three trainees and an observer to join a session.\nThe application allows for adjusting the length and difficulty of a training session. The difficulty level determines the means of guidance that the users would receive during their training, where it ranges from auditory and visual instructions on easy difficulty to no guidance on hard mode.\nAt the end of the scenario, the users are presented with a summary that evaluates their performance during the session.", "short_description": "A first aid training simulation where a person needs to have cardiopulmonary resuscitation (CPR) performed on them after falling unconscious."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrt.dk/privatlivspolitik/", "developer_terms_of_service_url": null, "publisher_name": "EVRT", "support_website_url": null, "website_url": "https://www.evrt.dk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["da"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "8858121267613102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031342_235910138724523_8929245647732086858_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zNf-eqHbk0Q7kNvwGToXva&_nc_oc=Adp8tICJnIqQwr6FzIffM6G3sWPzhnDzPQmtbeKVI99RkrYbA87zkRDpqugd9iY6B40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQLXsh0l-D-CSBc-tXl3wIRN_ghB7vXFbdFWIKr0_eKw&oe=6B0DA712"}, "is_concept": false, "is_test": false, "is_
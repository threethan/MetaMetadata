KQI6m1A2tJxhxQ&oe=6ACD0AE0"}, {"file_name": "ScreenShot1_2560x1440.png", "id": "452427501272708", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569452_452427504606041_2252253690104545760_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT7fwkgjSCEQ7kNvwGty91K&_nc_oc=AdrpoV4fdb1FBeSjvNZnFTk1m9cmj7CDo76iezGt4ea5qz6OglZ_IcjtXABixrQJUx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKou064jRKKq9H4Pz9Ts440_Hw2z2hcZWR6WfSY761IA&oe=6ACCE3A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage2560x1440.png", "id": "1281556846425188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572947_1281556849758521_6162187998734693319_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUbDVvA-8eMQ7kNvwGWnOED&_nc_oc=Adoi0aUscSgQMFoAjegi7wUODq7juluxC7pgU0bzpo2MTFGAtcXY75our7QAfwkM7Bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ-MBm0sxVoWdFSYFGQ-v-zKvLQILSm1Cwdmkf2BFqYQ&oe=6ACCFB09"}, "display_name": "Vortex Chase", "keywords": ["Runner", "Endless", "Square", "Dodge", "Vortex"], "long_description": "Step into the thrilling world of Vortex-Chase, a VR endless runner that keeps your reflexes sharp and your mind engaged. Take control of a square as you race through an endless vortex between four walls. Your goal is to avoid striking red obstacles while maintaining precision and focus in this visually striking and immersive environment. With its challenging gameplay and dynamic VR experience, Vortex Chase will test your agility and reaction time in a high-speed pursuit like no other.", "short_description": "A VR endless runner where you control a square navigating between walls, dodging red obstacles in a fast-paced challenge."}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "c
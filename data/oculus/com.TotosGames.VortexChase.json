 Chase", "keywords": ["Runner", "Endless", "Square", "Dodge", "Game"], "long_description": "Step into the thrilling world of Vortex-Chase, a VR endless runner that keeps your reflexes sharp and your mind engaged. Take control of a square as you race through an endless vortex between four walls. Your goal is to avoid striking red obstacles while maintaining precision and focus in this visually striking and immersive environment. With its challenging gameplay and dynamic VR experience, Vortex Chase will test your agility and reaction time in a high-speed pursuit like no other.", "short_description": "A VR endless runner where you control a square navigating between walls, dodging red obstacles in a fast-paced challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9410206788999884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035307_933394181793847_7771611766133566095_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyqVoN0Wf9gQ7kNvwED8xtB&_nc_oc=AdrbNyBcr0ysuUx5
8_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5aZaKXoTZYQ7kNvwHzQcaG&_nc_oc=AdrSvsXQddcoUKZKpQZxQHg3GCYfuWEIPQsk4ObTKATQ3Mogmq55Exn1bcn9keF4SjY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf4GWueDp2g_Wp2XcfOX1LEVmGcSES-0yslJ0KITZcfg&oe=6A8D8AA0"}, {"file_name": "ScreenShot1_2560x1440.png", "id": "452427501272708", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57569452_452427504606041_2252253690104545760_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jqk77LOxn8Q7kNvwHiQaN2&_nc_oc=Ado_QtgbV2Jf2ubPpAAVUxQx3roq-ubBMYGsYJlRf8P8wHgNAz2n0UvlHFXduim5MiM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWzbAz8nC7mleeVMlW0nK71mONRShL7GTcsuCK-DtAxQ&oe=6A8D9BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImage2560x1440.png", "id": "1281556846425188", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57572947_1281556849758521_6162187998734693319_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjn_wzAbzlIQ7kNvwE3Fo3x&_nc_oc=AdouaOsTxeqpBTAw-yK2ci-KoOQ6GcT2KHjF84sK3H0w15UkKxya4XowddbXmKXsw8g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5maneTY29bZ1_t-rp36gW22KhruZ4U8lx1eRG_v3EqA&oe=6A8D7AC9"}, "display_name": "Vortex Chase", "keywords": ["Runner", "Endless", "Square", "Dodge", "Vortex"], "long_description": "Step into the thrilling world of Vortex-Chase, a VR endless runner that keeps your reflexes sharp and your mind engaged. Take control of a square as you race through an endless vortex between four walls. Your goal is to avoid striking red obstacles while maintaining precision and focus in this visually striking and immersive environment. With its challenging gameplay and dynamic VR experience, Vortex Chase will test your agility and reaction time in a high-speed pursuit like no other.", "short_description": "A VR endless runner where you control a square navigating between walls, dodging red obstacles in a fast-paced challenge."}]}, "developer_
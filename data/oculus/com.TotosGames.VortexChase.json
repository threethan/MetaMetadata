693319_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVenUHTCYwgQ7kNvwGKywAv&_nc_oc=AdpODRzXfxo-iOcRAA62e2iQdu6qqe9D91RwuvmT6S9ZAUTRnKncF1BUrSkUJuKWOKg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgHAZjkDbHgRakgPZ9DDaek8Bg0wQq3CrarX4oC0ieYQ&oe=6AFB1F89"}, "display_name": "Vortex Chase", "keywords": ["Runner", "Endless", "Square", "Dodge", "Vortex"], "long_description": "Step into the thrilling world of Vortex-Chase, a VR endless runner that keeps your reflexes sharp and your mind engaged. Take control of a square as you race through an endless vortex between four walls. Your goal is to avoid striking red obstacles while maintaining precision and focus in this visually striking and immersive environment. With its challenging gameplay and dynamic VR experience, Vortex Chase will test your agility and reaction time in a high-speed pursuit like no other.", "short_description": "A VR endless runner where you control a square navigating between walls, dodging red obstacles in a fast-paced challenge."}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes"
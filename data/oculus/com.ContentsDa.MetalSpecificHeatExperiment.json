7&_nc_sid=6e7a0a&_nc_ohc=WxSRFOSuwecQ7kNvwEwH9zW&_nc_oc=AdnWyqNOA4MMRvOBhrahWfpW3wxfy9_p-u5LoRvYaJyICy2AYpIIgJ2699HgecDd2Ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvDtd8LYbwCsmxeyKImibwaKqf4RvLBhe2mAlQTC4ujw&oe=69AD52CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "264880199426963", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_264880202760296_7664662011413049358_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tKCEORNxOUQ7kNvwFRc5Dc&_nc_oc=AdkXDoObfHnP17zcrbhtIPJAAR0mqMylDsO3np5syZzhdD59GZ4K3QAFtvZDMZyEdfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnBd4m024u0eV8CO_-mkEuaG8W_2Mf-gJ0tuxJu-R7Hg&oe=69AD5716"}, "display_name": "MetalSpecificHeatExperiment - ContentsDa Science Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "su
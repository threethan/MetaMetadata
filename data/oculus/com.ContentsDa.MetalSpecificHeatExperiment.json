_sj3kFOOBmj.png", "id": "536096925969811", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821886_536096929303144_435159482986788836_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWxs815kWAEQ7kNvwHdbp9J&_nc_oc=Adkg-6OuNpkRNepqkWujOzVUMIzV9dr4iKe6wRghZmA7l6eORhGWFyuYP24jZ5K74uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAcbTlAcCfLs1H19gr1m-nVd2sXnPaN3xamUG3mT3P1w&oe=69AD6628"}, {"file_name": "msedge_ilJFf566aP.png", "id": "651880417735417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820350_651880421068750_9112856128575958553_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxn85fOuLtIQ7kNvwF5NNfT&_nc_oc=AdmUQZuwJJHhcYPtx3bfzyIbqYL2x3wX-ZtjDKo0FGir2NaYQxHaAqCa0QGAdrtIjds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoXPEbUfdBq4kkUlTCVk1E3EUuIRLn_d23aYw38St4_A&oe=69AD7D59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "specific heat of a substance_Landscape.png", "id": "379701528088324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031366_379701531421657_3362111059304793305_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCRZuWq5uDgQ7kNvwGYLURr&_nc_oc=AdlmMA8u96FCT5JyUMSnlbn3jkPAYPuxRr57P3FTce-O9qpuPDTORKpnQ5ME8WMgqGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy39uFHaI69KL0-C29NubF9NTvMVwHlpt8h2VBOWK9BzQ&oe=69AD6FBE"}, "display_name": "Specific Heat of a Substance - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "science", "contentsda", "heat"], "long_description": "1. weigh the copper, iron, and aluminum.\n2. place the copper, iron, and aluminum on the workbench\n3. pick up the tablet with the specific heat table and controller\nRecord the weight and temperature of the samples on the specific heat table\n4. lower the vacuum tube from the ceiling and attach it to the samples.\n5. Place the samples in the steamer.\n6. Start the steamer.\n7. when the water in the steamer reaches 100\u00b0C, remove the sample from the steamer and measure its temperature\n8. Activate the calorimeter\n\n<Results\nUnderstand the specific heat of different metals (aluminum>iron>copper)", "short_description": "Explore how different materials react to heat. This experiment teaches about specific heat capacity, the amount of energy needed to change the temperature of a substance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9884687501591309"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_945721043569237_1348689369390157196_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hupbb5JOF58Q7kNvwGd7TMf&_nc_oc=AdkcTw6s98qy5zmsevreiFGyXMjkArY8rvxAWFcvrVjG9hqO9C665FqRL7B5t2-AGyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy098DVUJPvNreO0hbxTkBQCH-T0LAAENDEIxMv3qziJA&oe=69AD5444"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Specific Heat of a Substance - ContentsDa Science Experiment", "platform": "A
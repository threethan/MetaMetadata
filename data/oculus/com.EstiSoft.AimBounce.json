0f&oh=00_AQGhPaM3vYg0GFREYApD8iJuvhocItOtiVADOaScY8XCzw&oe=6A972514"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-01 033605.png", "id": "562561999900390", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_562562003233723_7057657957385877848_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxpMiUmrImsQ7kNvwEZgbRX&_nc_oc=AdpfLg8m7cWJWrD92v5YUWTSO5MDgGj_OUlrRu5ORcgR7xNHOyuEtfISMzGACqKDCSg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECCvBj_RK5nMXb_Y-ksE5iXiUDo0DzbW_87oBQBii6QA&oe=6A973BF6"}, "display_name": "Aim & Bounce", "keywords": ["comfort", "goal", "ragdoll", "satisfy", "elite"], "long_description": "Step into the world of Aim & Bounce, a high-energy VR experience that will test your precision and creativity! Equipped with a giant slingshot, your goal is to launch characters toward vibrant targets while navigating dynamic, obstacle-filled environments. Each level is a unique puzzle, demanding skillful aim, quick reflexes, and a bit of creative strategy to conquer.\n\nThe cheerful, interactive worlds of Aim & Bounce are designed to immerse you in a colorful and playful atmosphere. From spinning wheels to bouncy platforms, every element adds a layer of excitement and challenge to your journey. Unlock new levels, refine your slingshot skills, and discover hidden surprises as you aim for the highest scores.\n\nWhether you\u2019re a casual gamer or a VR enthusiast, Aim & Bounce offers an exhilarating blend of fun visuals and dynamic gameplay. Compete against yourself, tackle increasingly tricky levels, and enjoy the satisfying feeling of perfectly aimed shots. Available on Meta Quest, this action-packed game is your ticket to endless bouncing fun. Are you ready to take your aim to the next level? The adventure awaits!", "short_description": "Get ready for a thrilling VR adventure with Aim & Bounce! Use your skills to launch characters with precision, bouncing off obstacles and hitting colorful targets in vibrant, interactive worlds. Each level offers unique challenges requiring quick thinking and strategic timing. Perfect for casual gamers and VR enthusiasts, this action-packed game combines fun visuals with dynamic gameplay. Step into the action on Meta Quest and experience the excitement of aiming, launching, and bouncing your way"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/aim-bounce", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9013838652062923"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2247617726041371"}, {"status": "PUBLISHED", "id": "1492766025720358"}, {"status": "PUBLISHED", "id": "2062023574532513"}, {"status": "PUBLISHED", "id": "1837057927241874"}, {"status": "CANCELLED", "id": "1268908058061336"}, {"status": "PUBLISHED", "id": "1088431173127933"}, {"status": "PUBLISHED", "id": "969293571853160"}, {"status": "PUBLISHED", "id": "1180328853585299"}, {"status": "PUBLISHED", "id": "1526503884689856"}, {"status": "CANCELLED", "id": "29424888425961
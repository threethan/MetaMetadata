uettern.png", "id": "1133074082993170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_1133074086326503_2587291765465285153_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zgKzxiNmVsQ7kNvwETQ-i2&_nc_oc=AdqHCAixjDqqLxXI2frziaYz2TW8m-HfeeSD3wlwOabPp5MLGJ6RDE2evhYr1YHTFCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-n-rkY7UHJI8jyAeQPBgDjq6MPSCHs-E7sb1weWUqqA&oe=6B0C5813"}, {"file_name": "screenshot_2_zeitgleiter_wasserfall.png", "id": "1101960675937757", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1101960679271090_6278114092540947406_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhRGz0Odc4cQ7kNvwHl6QMi&_nc_oc=AdohpGKS1O2OMglOK_v-oT9XhY0YKA0mYReZ47K21mPxIgpnHrB3Yk1-8bUKo715LWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjOAp5EyZAwJbW5QAT9gIlPLVzL_KWVj33ARwPF1OARg&oe=6B0C6CB0"}, {"file_name": "screenshot_3_dino_kamera.png", "id": "1143818081517286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1143818084850619_468108785239851542_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmvppBKWZtwQ7kNvwHP0fvu&_nc_oc=Adr4GMOlukh3IxjLWdRMJHtxETXh3ZSgtrB117Z_z5w2reQplo5OAcpC8tiQOF-z5Fc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdvt5Pzj_ECylYH3iOvuXINjk1YSdlfNFEk-Dvq4WR-w&oe=6B0C6BF4"}, {"file_name": "screenshot_4_zeitlinse.png", "id": "1487673393256980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1487673403256979_2468880358770385986_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilqDnZvpx2QQ7kNvwEJc5ey&_nc_oc=AdoOseIsEBQlW4dsEB9IiggwF0J4dKK5LvZxF9fU2eIdnmeAzBu_3rpVW_xc4pMgo_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-_cCY0QcI27s4zzwveM05S14Ri3tBxNSO4Z6UBCpGxg&oe=6B0C55AC"}, {"file_name": "screenshot_5_narbe_canyon.png", "id": "1833831121265257", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1833831124598590_4347799943149807067_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOWmaRJCx9cQ7kNvwFpwPgS&_nc_oc=AdpBtadkUPPTOEmtw04pHpd5iQ6ga88A3g6TMFR7hovMtSL_Wg9cKM8s3fK7_nauqfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9b_SkIO1fDJXhHZCjCaE6stO2ifU3GmnTYXubRP9utA&oe=6B0C6AEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zeitriss \u2013 Reise zu den Dinos", "keywords": ["dinosaur", "adventure", "family", "prehistoric", "jurassic"], "long_description": "Note: Zeitriss is in German only (voice, subtitles, menus).\n\nA trip through time goes wrong. Your capsule crashes in the Jurassic, 150 million years ago. Ranger Ben is with you; Apatosaurus herds roam the valley below. The time core broke into seven pieces. Without it, there is no way home.\n\nBy the river you hear a cry for help: a young Apatosaurus is stuck in the mud, its herd gone. You feed it glowing ferns until it trusts you, then lever it free with Ben. It is now called Kr\u00fcmel (German for \"crumb\") and comes along. Whistle, and it helps you reach places you can't reach alone.\n\nWhat you do:\n\u2022 Photograph animals with the dino camera and fill your album. Ben knows something about every species.\n\u2022 Fly the time glider over a valley of cliffs and waterfalls.\n\u2022 Use the time lens to switch a place into another age.\n\u2022 Sneak past Narbe the Allosaurus, ride a raft through a Cretaceous swamp, find your way through a Triassic sandstorm.\n\u2022 9 chapters in 5 worlds, up to the last day of the dinosaurs.\n\nFor parents:\n\u2022 Exciting, but no blood. If a predator spots you, you continue from just before.\n\u2022 Ben speaks every line, with subtitles. Fireflies show the way, help comes on its own.\n\u2022 Comfort: teleport or smooth movement, snap or smooth turning, vignette, seated mode.\n\u2022 No ads, no chat, no account with us. Saves stay on the headset.\n\u2022 Free until Kr\u00fcmel is rescued, then continue with the full version (one-time in-app purchase, no subscription).\n\u2022 Touch controllers only.", "short_description": "A trip through time goes wrong, and you crash-land among the dinosaurs with Ranger Ben. By the river, a young Apatosaurus calls for its herd \u2013 it is stuck in the mud. You feed it glowing ferns and lever it free with a thick branch. From then on it is called Kr\u00fcmel and stays by your side. Together you search five prehistoric worlds for the seven pieces of the time core, so you can get back home. For kids 10+ and families. Voice and subtitles in German only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.pottbyte-solutions.de/wp/?page_id=67", "developer_terms_of_service_url": null, "publisher_name": "Pottbyte Solutions GbR", "support_website_url": null, "website_url": "https://www.pottbyte-solutions.de/apps/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1447633648430212"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1124804690249854"}]}, "baseline_offer": {"id": "1124804690249854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795281180, "status": "PUBLISHED", "id": "1124804690249854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, 
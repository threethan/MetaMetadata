-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP6hs9aI7MUQ7kNvwFy7I4I&_nc_oc=Adp5hmU2oturlVdRjn1Bi39GHTr5j3nJuV4AE8ZAtc0ltZQ_XFQgGLwm1OnkLYIiCfQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_00brqy5lQUhR8m4_BqNPAGin6ldHzIisOLUDstVR58A&oe=6A22EED9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRDJoCg61mUQ7kNvwHfE-Gy&_nc_oc=Adovuj0NYKW_PKVtVVmGvwXWE_PXnHmiF7Yv3vlv84fq-efycPjj9-bFIksABh1Bulg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c4bURNuz_TvabLbf-Wn80cHeFr7cfhFJOQwL-v572Nw&oe=6A22D95B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFPSEbWVPjwQ7kNvwHCnD7Q&_nc_oc=AdoggHiy1oJ4K5xfXY9H2hQ0YdmkIyxepN_hY3_BtuFJ0Wbi4MK2PEZ8Xowi8cP5lJs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g6ny5ILEOP6Y645TsGMrdVai7Ot_ae1nmo2hZxEti5Q&oe=6A22DB17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDTo5qihK_4Q7kNvwEmVcjJ&_nc_oc=Adqyf7Tiwsm-w5fCCgYAgOUS7MK5X08NyLf1FLt4GGQAPfYU6lRPdCvRfAwz9O-x9z0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gL6IzbvUQSEbZKazmrUxxnXWgNKbfnM5Fju2f2UkaVg&oe=6A22CE9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8clIyTjbtAQ7kNvwFt6820&_nc_oc=AdrggmipS0p_GdGbpumSMiAVf6Y8Foc6KzkNBmKHyzHjAIz4EHOuTzoORJvqWGBgRLc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HdT_h5vsN1SWxgfqQvNBbj9807z9C85pqNymPms39Kw&oe=6A22F328"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
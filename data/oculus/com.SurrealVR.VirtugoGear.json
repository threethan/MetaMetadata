07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S89dIj0G6JcQ7kNvwHxPn70&_nc_oc=AdrwGgA-43leBaLFx5q3tLQop1T1CgLGEJviTjda1jGozDIcSMDPRaBn8EViATNoxDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxS-HH8bU5xAovg5lPdUAouNeOU5UwX83-Ml1wHwnmw4Q&oe=69C12799"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPC41KqVr8sQ7kNvwHcOo9h&_nc_oc=AdpwzCnb-178ZAzWzdQRPZJWvvDFEeKzUb6JsRgizU9JhuLkh6hJ814ovoXdyuB5JoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywkFKfJXfrHwefmqb-AeP8_3wA5OjPEi0KVZOnOL4AkA&oe=69C14A5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmhIvE8gVBoQ7kNvwGiS4GM&_nc_oc=Ado1XlN-B2yLUuGNFdh98lUXZ-UbdsVXLpEwn-qEJqfkTrOk8UpsCHFZv_-kip6erQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQx9R3yvONypB0wZINiyPJFRuQeq5zToKhZQoIifktMw&oe=69C14C17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQZoBnCxLwQ7kNvwFYLn87&_nc_oc=AdoX1FI4ANaVoFDcGf3lrsnXj3nJbZTwvbDXc2Wi3Zc3Wf8i2TiFYIEFDnlzkVfA1BQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1l94Rga9fB_z7Q7O3RvmNcZ6WKYR58vjGgQzFbIa_PA&oe=69C13F9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXiG4eNe8vgQ7kNvwGDsq2k&_nc_oc=AdogJ4PCIh-b7v939gQfK-vt2TatFOjcuSLvF4CHr9408u_JazdeXLZ-cVrLkPXQ9cs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2OFhvbt_0-UHXz8iiAEl-Ge16Vf69gTjiEO-yRiAjtw&oe=69C12BE8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162686_1
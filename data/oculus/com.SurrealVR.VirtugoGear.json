07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6et00frDQUQ7kNvwGX89Gi&_nc_oc=Adk0mlnQwogqYF7KQe77Aqt9MauZPDIIGLbrfvLfE9W43mE3VgUfqdY1fKMYT_fIFdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-lcu0qW_tfWAuNSEvnYHhzzrwgGtFKPOSfngTBovoEg&oe=69B54A19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bWNo_6ybvAQ7kNvwEsBZut&_nc_oc=AdnqR8QJEfD8ao4Xi9wxdkCcs5IFocjxolLGVu9Ml93k1ASaoC_NvhVuYEBp2x2uhTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7CVqKTchglpszGzoDTs9p5pqsmevq37HUzWhNqhIAiA&oe=69B56CDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYkWkAvVh4MQ7kNvwGHN6yO&_nc_oc=AdnUUiEdfdI01PdE9q0YEmNBGv95V8HCfeZ7I4fZs51QXPZPYfUJE092sk7reoQJEAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiFGO2WEYGWIO5lBBbv5oec8hHuBB2cXbCtN6C5R6mTQ&oe=69B56E97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_XNYxumrWUQ7kNvwF-mTV_&_nc_oc=AdlLocYs-x-h2l6112ZeWbIVPRpvmbVmC-KiFlx7B19_PKuTlhP1rCLfRL30w4E25Cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJUUz7wnP5ZwtwatsnrSqIjQaR_Ph1YI7G1Y3CUSNHoQ&oe=69B5621C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_6FW1ArmlYQ7kNvwEDJlkT&_nc_oc=AdkzjO9EO9udGpG6UXw7BHwNUaI96WtKbLWHYS7wbKqUuPtRT5phq0YOb5Ak2Zb7dEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwpf5pMlaSWCvawbrZ3WsgFCcijenHJ0nCyeSn2NJ09_g&oe=69B54E68"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162686_1
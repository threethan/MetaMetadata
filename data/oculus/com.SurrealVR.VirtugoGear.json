uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VufWeA2JyS8Q7kNvwGn_iCC&_nc_oc=Adq3wSxxym1dv2vk00DubYsldzjKMIIdzZOLXPIXLIy0zjEvbGypDZb1AnFIUFECsiw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfitj1AWVknHnM-3rPf002UEl6dZ7bg66XSYhk6vnmZQ&oe=6AE369D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFDZZLegjZQQ7kNvwFsNUSJ&_nc_oc=AdrRys1DhrjmEFSkumtM2tpb74Rg5ouyvcCTgeyqBahHsu38MNoGaRozDsZnn6aB1NQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPoIGmxIO_hpCV2pQPC6GhIouSRTfIHxFFcFUdoJU5Fw&oe=6AE3545B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iTMsqq7hNIQ7kNvwFdNATa&_nc_oc=AdoRlUo67F7p1w_SPKCyiDZKvU5mUO4eUHinvHOY7tUNZFaQqtdEiI4b_iMAwP10M2E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6L3XOLdplnTFbm955olJw7VgqSIB78uWkd1wDbZFx0w&oe=6AE35617"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYmov7XrDzUQ7kNvwGBR6IH&_nc_oc=Adqgufjar6FHQkxZ16UhGPzcf1uO6vf5yACBbrq5Zy3fml8i6QiSAWZAQaI7v0rZcvo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXYQ52ZVwDOkMwduzoEjsA_JYdglrKlkRBY4sTqlkSIg&oe=6AE3499C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szHEasdW5LEQ7kNvwHQ0Vtg&_nc_oc=Adoc4djTSjFtnjBKY6Dx8cHX8FNmEmw4BGeDjOM2m4mBIcg6kBxPxtoNP_HJ4t7I2Uo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzmH3FKj2iCgiTNDCoLU5gq0j1Zn_mc4bYmVundH6x1w&oe=6AE335E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
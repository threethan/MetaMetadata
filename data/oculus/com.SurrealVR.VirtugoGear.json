uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYpt5s5e71QQ7kNvwHV8BYy&_nc_oc=AdpRaJb_3j-wGrVVNh__qpgbfn7FBg2a2d8bdnkmvC5o6dou1SWg8dn--VAd7Rarg8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOcEBo051M5PXxkC0h1p_4O6N9ahg0UlSgw6XM6_5mjQ&oe=6A95D999"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMK3W5f6ZsQQ7kNvwGOkM39&_nc_oc=Adomf5XpLkGb6fiL3h4wjIMcH4Gfi-BCybbjf3hWtWYWQfUH3D3SCqKoW4Ue4MGh8OI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0GThcC-Td07vFA21s6_gvinG_PAARqXumobXLfe9YaQ&oe=6A95C41B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2q7fDZqk3YQ7kNvwGiTj4m&_nc_oc=AdqHzTXCY-TxjYvFda77DOk_22me9CQY_sm6S0EZWiLoiApoDkZXgx6NoXVe8Fdw8S0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbMad3lR80iIOSw3Je2kWN2gml-pVSY4J0VEGr9bDrjA&oe=6A95C5D7"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD51RdqG8BMQ7kNvwHxiDCP&_nc_oc=AdrFlaayl5TXZpchCEIIpal2VDqdUQZyNmgtuNbJ1uIBzkhwaE5kyGqLCwRkNrjdGbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBbkrPckOLRZF2FHtVzJ5ELS4zVF5nCYZeTXzeqHDzYw&oe=6A95B95C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6SeVxAJY98Q7kNvwFDrUQQ&_nc_oc=AdoO5vdjKE7QRfPv8aNFE4vCkhyyZGtarVcx3JDSn6ms_DaYa2squKYWUhCOT3rehHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBRdhKLmSwtmLQnmCAQQLO4IB63tNOqa5nEGbE0GWn6Q&oe=6A95DDE8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
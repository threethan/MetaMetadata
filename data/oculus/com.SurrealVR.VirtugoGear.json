uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWhEFit9H48Q7kNvwHd_gJO&_nc_oc=Adr6MR0BnPiKXBtbZuKAdI16xHxXBlOMGatB9fuF524xa9VwiLH-1Q6HEw48qeIQIUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADEft4xwm54me5FAS_TXwAzoK6oGVzsIJOkEpHoLlBpQ&oe=6A537E19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJi7IX1bpj0Q7kNvwHDkxMu&_nc_oc=Adp5HyLpjkOGBq2gmt2-TJCQg3hGmlmxE59MNieZ5gbfDFd3pSuQsfL50nkJ_3VDGPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkXJAH-dIsm1iChSaO6zZufQYGAf7LbYrh1VK4afs4cA&oe=6A53A0DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcXLFk6ie6MQ7kNvwE1i6_v&_nc_oc=AdruMgtMTJYtaCFR_FGw8RbzHRMKKAzUhKPzVfEqqyh-CNIEwBFJ6DURkWhlM7g9kkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC39P3RI2CA2CcOUFeNJcpMDsxb7W7FJSs5Ff1Yc_zklQ&oe=6A53A297"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpglkU8J9cMQ7kNvwGYr4LU&_nc_oc=AdqsyAMVijWpDnbWDm2aNAcQxVk9omvxzdZOlEc1SgEGO4lkmJkEWJo1GvRjVsgIX5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD8uT54W3T4lKb3bWIWLxsMcEQAknlY5KmSVOEnZuv0g&oe=6A53961C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL8p5ugbPagQ7kNvwGP0OjE&_nc_oc=AdptZudHjfylVMhlP4ABPW0ti_im2WKl22sEhGzcSG7Chplxhf-2x0CYW13xEXP6wzw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx3takWqQ8q9dmIGfN_FekTqlIOTvc2KPwDqlCuJ25Tw&oe=6A538268"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrsFVfR7OSwQ7kNvwEJkqxq&_nc_oc=AdrYsqIhZWviApXdgoH1AwHos0b-MOWBfn4MU9TLJge-OFh2Q310KCFCdqXFHo7kOyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeqVmd8PdZDoDdCJn43xgRrHEQzAP8xmf7EVa4g5OC2g&oe=6AD0F4D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KUrajFKSxgQ7kNvwHaPQgg&_nc_oc=AdqHwKI5rDTwTMYQrjKgrlKVsSfDmjUUmN4NMNHsLsRivjp3oDQvQIdyKczdU-fqX2k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtAvAfsXfmjjdAzf4owHYgPAn-oA25f10f56PMcxg0yQ&oe=6AD0DF5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1fTmgWs2jIQ7kNvwFH12-a&_nc_oc=Ado-jeAPVK1ptTdZRs2b-WBezzBAu7keypxMQhpKZZMldjgJ17sLt4SbVg4_gcqpZlY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ2BWmGBIQsLtdZq3yZWZa_MqGCZi95vOafoz47NLn6g&oe=6AD0E117"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8ExuUzy7lAQ7kNvwHR_a5W&_nc_oc=Adop71ml-PoeQPhtyRSvu_69Cix9J1d49KPIvVvUOgsBf2leztS-i26sPlzp8HHMnj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI8VTnpd9S0xeSnE5MWhylj7s-7HZWrCim9V2fRNeV5w&oe=6AD0D49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEBNwpfJWikQ7kNvwEccbP8&_nc_oc=AdoSLAP943wBlBwTLFKInzgW7fgoTys8_ztnqzYQbKVMw7S5jYS_q55z3qGF9-FPNNE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRHMYRfxsr3LSHGNPOGsZF14Ekej7dz3P0K1f_Qz9R2g&oe=6AD0F928"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
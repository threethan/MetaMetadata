uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6_f15cyOj4Q7kNvwEQF9Wc&_nc_oc=AdqUh_TfDRqtJiXsiwZxue7_VPm10MbSItRM2wsdzcTzceAAYe1ka-ABN6EV5iPvDDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxgauyt-W5x528pgbSnQzDYCODTzOqrdiKw-5HnuJ4ExQ&oe=69CBB399"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzXIWJTob4sQ7kNvwFQBwlh&_nc_oc=AdoijdKkM-P9iHqHIWOOL3tlAertx7nbYS7Ruael9eiRSvNMrb7zSBjSYHcaa7QEGvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxI0G3t3zW5VCVtzVY3Pu2-VQehORg_0-mBMM0qt34BnA&oe=69CBD65B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoL5uPdrJ3IQ7kNvwF8NMn2&_nc_oc=AdrigduhGAXU-KLaRlGvabjZKeWvbx9JV_6bRv9fWJjkImYFqftoxi2U2KJoQPWkPAQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPT6xy2q2x3IyKEh6lKrXf4N2NnxvCH8V6aoaO-MzM-Q&oe=69CBD817"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCpm0-tkbu8Q7kNvwGZHlzM&_nc_oc=Adpiin1UTNKyCXXH9nNs0Cknugu0d2koI_M_aJ2GknImjNQVteT6sXAyuzq5HWmeTtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS3oQJET3cCGbkFDZgOREkaVkdTspYF4Z-nJ9Mgb6ZDQ&oe=69CBCB9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU5LxT9XOp4Q7kNvwGtK15F&_nc_oc=Adrbr7xbthn0lDak88I3G8b12Nma6ZE9GaNFhzdmFA7UFf6NWRWJAOmjeQc55tifA7Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuxBZF8uB8aDL3o_EKLSUYef56U6Eruat_AZzcmqoQkg&oe=69CBB7E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
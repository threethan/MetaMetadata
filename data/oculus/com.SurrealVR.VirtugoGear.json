07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQBu_TWwcEQ7kNvwGkocv6&_nc_oc=Adnws0ZX6ZFHkWcbL6RvMRnLaquoeim2wTbGe1TX3GtAVpaWdJQfn9x9Q-Vt2JI-wx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4ofo4PoTzefCLkyxh0EVUiNffAgIJsQyiBX6kMTSHTQ&oe=69BA9019"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIU4AO4kfTgQ7kNvwFmyAzJ&_nc_oc=Adm6WKw0adQvapUqwxfx7uKQ9U_b7ZUfA54DYxw1Ot4gYdQ-lGf6C-a6xLDAKhlGm7E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCUws0Vx4BaQtN0OKYlrpHVehogzlC5rzb_5J54_T9hw&oe=69BAB2DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL255Zx0vr4Q7kNvwEifBl7&_nc_oc=Adk-tmMG3ricuGOY0J8VNVo8HGbksUYJEyOy2R6syDrQkeYakk4hGETb8LuafsCsJEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRdF_2mBPp1ZyhDDMeaRHd-wE-2GPthwcDR42D6fWKrg&oe=69BAB497"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqXUSjWmzMMQ7kNvwHhE2_1&_nc_oc=AdnJh_MSqisRWbJML6ObcVZHbDZRGuq5FPnbrWIFVRXvZYRBvpPO9uwgi-lVQU3w2FM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgO8hlu-UvaGkLvjUvoqdxKenba-rP-hsk_W4EmYRlfw&oe=69BAA81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwq0C_D-2WsQ7kNvwFZ_znl&_nc_oc=AdlZLc8MleC-iVNXhdOWC9JWzJDTHc2N8u4Xss0rhl6sioHE1jz7ba0ZOu2_Lx8C2Wc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9wSO1hCUiZn_s2DQR6XBJEJ7atOB5wd_p1ZnpDhwFBw&oe=69BA9468"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162686_1
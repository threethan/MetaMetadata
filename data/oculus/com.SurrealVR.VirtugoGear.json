uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCub4LCDIWoQ7kNvwGssEkO&_nc_oc=AdpBE5Idokss467XKxKhCroteKSK1JBFa-gTeuViuuoISyLrUeXplqrECvh_wSlhKro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KU9zzsV9RqDylrdM7VDyLLiKAf74vjVJg7tmp-apZfQ&oe=69DB8599"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMp7XJs6E5cQ7kNvwHkOLxv&_nc_oc=AdoyKXYZMBXBXpexEoM-mhZFTNh0BoxCQ3Gcnp3stk6iNow8cUPeH7W-c2O3uvtqbDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dwpl0pu31W4XQEs3LQAMY5uRX7uPuwA8R_ZSVb5wJmA&oe=69DBA85B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wnzwx9NPhuoQ7kNvwERapOk&_nc_oc=AdpR_yE9SkQusudUA4gVK31yf9asroWDWic0Kl32Bsny1lmuQqjX-ZObI2H9GIb2Dvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2njYN_l7gQb2Ce6ZP-rbyeLZo86U1ujBLLwZHgM5PJiQ&oe=69DBAA17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqB0MCfqouYQ7kNvwE16hLW&_nc_oc=AdogAR7g-gG2MPzU0uQoPuM57OhcgwAkKbYm5mLixhNOGrwCtK4ZmZ3u21EWf67-fV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sXzoN0pvV356r-q7w4rQ6F-873UNYeVErwBwbSz3vgw&oe=69DB9D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sOriolp5kwQ7kNvwGuKixE&_nc_oc=AdqV39UKdbM55GrlgDMpDsFc170bZnabN-ePLhJlG2X3vBQg9_WKFwvkiPs51sui4oY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37gaEetT7Muzojts2MStsibj-EnFmtYJaZLzYjZTjQPg&oe=69DB89E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
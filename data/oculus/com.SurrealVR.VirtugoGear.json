uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80fk1Xt2_cgQ7kNvwFkZhVv&_nc_oc=AdqVinFbA5UiPhoygUvsAsQGj631_IWs7feOOSvEX8f1QI1X3i9w9_NObAR4COteJ5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbAcC4fYDYs3c8pCYvYEF804o_8QOckAACQip3Myzmcw&oe=6AF73059"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNHDE7OchG8Q7kNvwEQ0xAF&_nc_oc=AdpvZ-2s_0nlkDJSgyKGhzOmxKxwsDhDRNGjYEKh4C1SGo1_hCv5h8p0h_mLBOXZhfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJjSYdmAXhvGBTMkpHIY8BNMPw3T0XMXxQSAS_06EwAw&oe=6AF71ADB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRXOg_fk3v8Q7kNvwG5TkqT&_nc_oc=AdrCulRij5MAGckr21UP3L_0jEB18JFS-MV99WeHt97g-UgDeeHLH1EHgOszURCpe7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMP4b5B3_m7isLBKYkxEo_R9zphMTsREOH_LitgLSHZg&oe=6AF71C97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boPbBFUM_PwQ7kNvwHjYYtY&_nc_oc=Adoe4r6Gmr9qe9wy7ORvQIJnCt_LfYWjhCPKOrSy_tngEO4WxSYuGJIWLhxrajSmWZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwronmvyeGdHjyvx9j3ANyCjnlBqu7lYLorj-PdWeCTQ&oe=6AF7485C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKaep1o_rZsQ7kNvwGiA3bV&_nc_oc=AdoV83pb1CA6dlx_4jVpgtJ9UV31uLNgYKfZbTFWZGMyrTY8MFisgvDpgCqH6xih8Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsSea1BhfpVJdI5a2niawzdjFsxMKfgLtawFg6dRGOzg&oe=6AF734A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
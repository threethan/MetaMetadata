cdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DR694Qn194Q7kNvwF5Y6ie&_nc_oc=Adoo983QRAI-Y6MsCyFflHPwX9cgpLmIU3ESNMpcwyXjg6wdwV_NTDuqdrZBYlxCTps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxhqwtint7QzvNkqrJLygSGqi7ak7UJiwWkIXG6y_5Gg&oe=6B0F0E1B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jQC9nWrdqwQ7kNvwH2JbDD&_nc_oc=AdqLv3plVFr36WZcFIhoUtT0DqU_7lfKBYU3O_R_sXFTsK-ddisGs4JlwSjiniwzlTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUF9IK8VBvijrWriVPnvVtiRKpsF9pLro5rsk9SFmIT8Q&oe=6B0F0FD7"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKzAvWwaqWAQ7kNvwHrY83H&_nc_oc=AdorBzh8bvUthdlayEfXxdAth76X_RikYkFWtrFitU47cqC6s1lqJ0PJhzdcERC6ZME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcgiCs0SXCBdP48bsMfh4cPkA7IVpTMRLCrWjPVzEZZQ&oe=6B0F035C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZLWUWPdumMQ7kNvwEALVfv&_nc_oc=AdrcBwuqz3f_b10TW0Eos8Tsx28DwKP8yh_jWhSUoHwVriOOVnHvuHF8GUYyo1lYBdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkjoFK-aHYhisFr4uWTNaKDIGcWNnOCcvqiE8bbvcu2g&oe=6B0EEFA8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1576473825742161", "version": "1.72"}, "id": "1423274634387898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
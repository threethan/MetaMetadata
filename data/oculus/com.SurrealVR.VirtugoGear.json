uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzx15IsAAX0Q7kNvwFjLAGn&_nc_oc=AdpotI098WWaBh6X-D1RDHp24jbBAokKHqN_jadO9yZyF_VYp5-kaJnJ35POgBZAOOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpAR133xLdne7Ar6wchWOlo1zX3aEV2JkYsJgBbIN2xw&oe=6A9EDBD9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmgpJXP7MxcQ7kNvwEUQwtR&_nc_oc=AdpnOpElPtOn09uzb5zPme9BBCpwKrx6Vdeqa_3SNWr_Rqh34frdyDCzZNe0xZ1dX1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE0i2p_IHrtxOL9mfk0lTNaJkZQGvfStsWedElXtr65A&oe=6A9EC65B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJZ5fHyQcJ8Q7kNvwHdvXnD&_nc_oc=AdrRDYJItrk2wY9ZNoAyG7o-bHgRGgIG-Ki0YCuxcMxmIdCioiOMKC-Rt4u2r9AKIrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9WCC1Xh1eFAxHbpyRuFrd4LH-4_DX9JAkWrCPvz25dg&oe=6A9EC817"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnaimVTcW4cQ7kNvwEUA9Be&_nc_oc=AdryNR2xyVRogvlwlxKSiNnJWRWcvb7gIr8MmrYNNP4N7r1Gbj4_gSZ4BuNVwMyjgv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgd256TVTc4xiOORNYTHdQSNbgOR2yArtKSi6JS2EjVQ&oe=6A9EBB9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2iKo4z7kuMQ7kNvwGrHngp&_nc_oc=AdrsHygCbgcK9dLRoa7qa-uDxISDVju29lX9YIBa7tuxbMCLlD7erAfMQ2i2jduNWPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvW9GlJaZ2KDBZ4Lg_ZWi2VcDqC7-9Zsg0AsSno9dDsQ&oe=6A9EE028"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
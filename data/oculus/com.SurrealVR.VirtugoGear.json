uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu1pBBEpdlAQ7kNvwF5J2Nr&_nc_oc=AdrUKmO9dyZrTsZ3NDC65AREczUqqNBUq8dvLS1sjKoJNGPsDONMCoigQpTvXq8moUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxFuf5TvqFlvBKQ2eX9nHGUmxGvOmzNv8V915pe9-TqQ&oe=6AA2D059"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_ARAU9o0zIQ7kNvwF4W5Bw&_nc_oc=AdrwxHfwj7TXu6I_4miFmd83e-MTjILEMywoIABzJDMHDZXgm6ovKYGDUgXftey0OeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1XRrZkZLSValW7bs4ar-C7S4mkX6Mvle5Vys4dd3ajw&oe=6AA2BADB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTlp-wdaZksQ7kNvwFEYeZ8&_nc_oc=AdpAz4XB5bhl3qEeCKSPBmZdCxTipxNW5Y-TCpGukg6tbzUVc-dJPdJVFMPh-4CqgAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDZitznZ47AhSxBMeROBWtm5S2XS26ceqvFHPaAlwhzg&oe=6AA2BC97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd-_jzideHEQ7kNvwHKjie3&_nc_oc=AdrWK6AqTctzAiHP7r9IdJvi0OHvgVBmjkvAjUuszzCNIMhmus4_LJrEZU6W7yLBs94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK4pwpJecYC4htxaYTfF3ZmlKPb6WKVOJDKHMhCFVCLw&oe=6AA2B01C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OvRmthgobcQ7kNvwEwPa3b&_nc_oc=AdpMq1xhMDa0bZfEKt0zJOI4jVq2uD7GakwONNgHtdSncmgw1RJUnx_gIpd-WBfwmiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL21xP2b-O23e3-FeQ-UnAhBZHgNGIxazWm6RrgBtBvHA&oe=6AA29C68"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
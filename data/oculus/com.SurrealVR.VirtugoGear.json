uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmrQvLp-ubIQ7kNvwGL52YH&_nc_oc=Adq2dbFOL-4jXIgIDTtN3WvhBo-Po1ISZTpd8wbIzJPgYcT3nG1STSEnmGlGjI1vWdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G2rTcTl5-uTAWKkSZxRxwCFGVegqAQCj5gzZS5IhysQ&oe=69FA1059"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8krsu6WM5cQ7kNvwF0Xk6D&_nc_oc=AdpE-Hq2fwM3l3nlZ5h8Y7TfLnXv3MBuunacVZgs64hn8r-gHfP0_-FOoxtBZmhOt9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yWAEAxP-nOoC3Ygt98PmMmvRZAnKQqvhaL3VKqveFNA&oe=69F9FADB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEoVPuy9BqgQ7kNvwGFjehh&_nc_oc=AdoEIoLhQ5sCymfDUvibhkQ8Xzg9Mid4T8HYXcehfBWTds-PnOqiMD9InqlXhKvXYBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xisziytI59bLScsHGtIKyAs8Acmu0L5vm_X0AKhu4vg&oe=69F9FC97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1f9dRQoDWgQ7kNvwF3VPbc&_nc_oc=AdrpKTUvbWrLvA_7MHTn8J0a3uQD-h-SJsl0vdZvDaPjmYMun5K9ugJW1hgu-q8F5xA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55PQ8LjRY1WXULIB33zLR3n4mb5mSwRDYPrloJALue3Q&oe=69F9F01C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAJoMYPCwjEQ7kNvwFgo8kK&_nc_oc=AdoJsY4RMIKGCH9yOqmB_qzJ4oc0Z-DOep63Y9QL9ZJJNkpNXvE0zwqceq01BTLLtg4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mq3zAnYhZlNsQCN5ArDitGNAscti6ezOkd4c6VKWfvw&oe=69FA14A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJQBu_TWwcEQ7kNvwF8ne_o&_nc_oc=Adm2UIdlvQMrEhggpAgNJq0TrDmTUdqeiIFAmya0wFWl_3pqu-iR_QFRwswolFMQtig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSZK60P-Ki0n2t2x45hrB_iRakEm0wVzEwNN50AK1zzg&oe=69BBE199"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q42e1xYYaMQ7kNvwH5cRcO&_nc_oc=AdlDLyB-jiV5qfq0fWSpd2AG_YIi3pWnJTmcSn2udxwV_yaQzYDV9-B43eKaDrgGzSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwhxy2VF-NDQhYh22FgfGZYFR0HpXr4uaURyyHITTG1GA&oe=69BC045B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL255Zx0vr4Q7kNvwENSIT6&_nc_oc=AdkTCw5b5iNBzUoCTIiCfnSjsR4Nuw02fvpuw1hq1mvTtqMjHv_N-cEjfiK33wD1u2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyf4w85gbGIPb8RydsavkXAYK_tpGePMmDtT1PYT7narg&oe=69BC0617"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqXUSjWmzMMQ7kNvwGJSAMw&_nc_oc=AdnvnYColaHvh0zGjVwX2p1tHiIcO1CRWDMjLbUrK0hN5kGusephDKhnKLplHk8h8zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx23lw_PcEVG-e3fJAp9eFWg-B823ApbzZGEw_7T7cnQQ&oe=69BBF99C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8NAlFEtDTcQ7kNvwGzKZj6&_nc_oc=Adlss2NxmMM-MCtSCXhhA7kuGX6LAZ-V41MCnzI0hUKBFqZyKYCtn0TIRH8F5Qpopmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEi_wnyU9pL2FRv0Sx3GC9xbNPvVFVbZ4t-gNQp8B9mg&oe=69BBE5E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_1
uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HkfHS_hvGIQ7kNvwED3Fk3&_nc_oc=AdrbEufPWCXk_M4yLinBDsDSh2dhRt_tezug6QqCiQuZ38Pjaaw4mV-N8UboZrcYo38&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25-3W2xGYe_hAv4g3jFhqFnBchd1KbjBenJVFz0OB88w&oe=69F61BD9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpuZpKjbDVYQ7kNvwH7A3NG&_nc_oc=AdpIjghOTB7exUQn6fgOMCgYjhxFLlnBxCE3hsFWy24yp8QkRQwt3QXJGvnUBqj1iaI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sVJUlaj2EhJ9wm65201GHrFN6maIO-Mp0mouv4eaXEg&oe=69F6065B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__2VmWQQfkQQ7kNvwGJH-NA&_nc_oc=Adr-bmzwlukIdjVWbFPW3sdw9l3wUmODuGNB6frMxMQqi2oYkvrpRxdSs3vXLIVORQs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WB68Tx6fdICHkX70C0vpVcW0ar54BznRjfNshQSg0Sg&oe=69F60817"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvWihxxGlD0Q7kNvwG2_h_K&_nc_oc=AdpCuA9CkhNDcRQgXE3-ei86oskqwGPYuK9Ug9iEU3bN_ZkbEo9fHupxyx6cukG9khE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1k2GhYMYINli2fJc46fbpOwHylD06FhNRlflF5RLZSTA&oe=69F5FB9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgCFPRD3JoAQ7kNvwHCJDnu&_nc_oc=AdqLvb3g6KKPLWVf7tkXaFWO5kgxJ7fX5VamANPvmtnnjmFnoE8p8BSpABKtZmtPTos&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TCDXJAaZVd5kPN1ZhUe0Mjo0SSLtYZfJowvPcaiSZWA&oe=69F5E7E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
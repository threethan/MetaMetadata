uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjS9_EutrVsQ7kNvwGCz3BH&_nc_oc=AdrpbuxtWZZpHkfthKmqfk2bOzofPRt90x7S8kiphMT7q626BfWhSwxT6CUdz5pOhJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6GbJdNP_ZUvACTN9WcmpWpNy6I1l3teJ0jOpCsWL4fQ&oe=6ABBDCD9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrM9NlL_y-YQ7kNvwH1cQBY&_nc_oc=AdopjQDODFMdHRq9D10JWl01Jx-tQU0UbVYxc_YKbIYVbhly1i1L8fLwmgSSe2VjhdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3p5LtGVxN5zf0kt0v-D5cMSfZZOZOekp_8b48EqQDhQ&oe=6ABBC75B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhQxTtRSd-0Q7kNvwFPLUzI&_nc_oc=AdoflYDQPMLjR5sg56goDdRb1yCq6ObKrhtzmGVqxGBq6mjrcRI3tGPdWO_ejOoMNb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6sjc00QAPQBOMRp59lhnHdUHESdmAHvO3fzA7HvjvIQ&oe=6ABBC917"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPr6Ani5eHEQ7kNvwG5WWxu&_nc_oc=Adq0GLSisOapjnBJhqVivSNZ_mMa6_fiinzeRI19PdFExDJWD58cAF0ZAvUSH4fzF0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZVN8DYRxA1HJoaJ0JzPOBgtJKcx4klMQPClrrU1bcCQ&oe=6ABBBC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ght3u3J6T8Q7kNvwGdaOMj&_nc_oc=AdpO2SQr97cRp_yZSGsS891-HJlJpyug0tD-T6MgO4jzO8Mvpt8SAu8JQwRURIIHwhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINXMo-FWm75aKFE9XNnMGnDpcEs5acLaV0_P_nNbYnpw&oe=6ABBE128"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
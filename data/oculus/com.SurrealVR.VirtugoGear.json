07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp40locozYQQ7kNvwHiERi2&_nc_oc=AdmTk2vgqm6co0YHE6ediB_XEus-g3fSxUFoxyhR8OFG7TAmO0RWdqDjIQ0fnaAdjW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUWxONChk5jN7gaCzszfTNjp4CwLDjrSRMvWn_VgsJ4A&oe=69B3F899"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bWNo_6ybvAQ7kNvwHr4rYO&_nc_oc=Adl967x6yXhV0khweZRcWtM3SefDXYC5jXOZW-FaZJkm3oj5Bn845McK2CGTe3p0ND0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgVT2uvEysECNjhqUPTucOjnMwON2exQi7qlYDdKW-3Q&oe=69B41B5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eKXOMieGMoQ7kNvwHk7PII&_nc_oc=AdnEED2GeIdFhE1SkcPFgy57UAyNF-eOme7th_wNKjbxMN4BosceSli4gsrIxP2yieQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfycxfmW7OQCgtb1FnaoktzPYrzqziyUJ9LTObsws13Pew&oe=69B41D17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_XNYxumrWUQ7kNvwEmjE0T&_nc_oc=AdlvOHoKLAY6hFcJqrN-pxui4ES485PG788oWTCHB7Crvnfq0uqV7NOdVd6VuV2BWwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsnVXqPZwMPm-h-O7HuW72lAGjoxy4Xmqeak-6gZi4wA&oe=69B4109C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_6FW1ArmlYQ7kNvwHe-zXE&_nc_oc=AdmcEUxQrUIV3sHEx3cdGkXwI_Ny6V4Ioi8q67bDalnWYDWE6TWaRApQrf3Ew3tulz4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyS0ne9DxM5jCwGAgej_w1w05c9rUmt3PFu1yj6quLX8g&oe=69B3FCE8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162686_1
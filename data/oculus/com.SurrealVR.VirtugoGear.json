07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShWy8xWtpF4Q7kNvwHl5qHp&_nc_oc=AdmcUzqMjk3kWUPN18GbFRMfa2cP5dBe_OtpVqSNMs8_JRGh7_o-ZJQP00A4v63As-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTbSDXJVXkk1NFrdetO1j2hw7zhZ_XQ3AZnKNKiQLMTg&oe=69B00419"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1W8ZmAGE5SMQ7kNvwH4HOlU&_nc_oc=Adk5UyhTXx1AusaUFDWNFEvvJW4jKj0fb4i1JvnEz8KJivk2l9fp6LI_0X0VVVEFfTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxj7W3ImmCJIaZYqy6qLKf6zg9htCMUTOOs804sscs6PQ&oe=69B026DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHbk_6iuhnMQ7kNvwHw7qSs&_nc_oc=AdmuPi-5VR3WnnZVx4STNlTlVGbEN1puab50_GNClhAp3Z0JC-3zPRjQv18VrZ9Bb3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCRondXISN3yac50958Hl26ctJcT3oEjetfhwaLp73sg&oe=69B02897"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uj06D_oE2AQ7kNvwGvqS0a&_nc_oc=AdmGAjJ79Gx4NMOrmLfn8KBrTO8PV6mtGKgxlDb71tNE9KeahgzoD29RHYNh056MkrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBtWXXEfQOZ98deSUx8yq-qz7uBP_Ri3mQJm_mXhRYmg&oe=69B01C1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttN4Y2CRHvUQ7kNvwEZ1mN-&_nc_oc=AdkgxU4dq2NqEVubjSolLy7ixFHhqtuEu8WMHnRWa5DdzpF9RmZQKSAfOJH6tbXS19I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO1YVg2N66UxqUo4_S9pPf60fwqQRiLq8KN0jG7GAnWg&oe=69B00868"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_1
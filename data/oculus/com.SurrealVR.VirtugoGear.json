cdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABM5ZNdHEdIQ7kNvwF10Dvf&_nc_oc=AdpK7OU_yZCMEJ7ANSHQkdPBm7NVoSmzEfPFuoFt4GS8Jr-H6rsGmcv1Cs_5gzO5WpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR07oQrxKMR8eT6whG3eDN5ZxgNlLiBjvlkqaV1DjvVkQ&oe=6AFB479B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UudgC6HbOHoQ7kNvwHseza8&_nc_oc=Adoy6gMEtTaVy6HwADAQ4Lvo75nJLvf6NZPwWbzgfab1qxJCll8lgB1iQF0BhmNMGoY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUthFYxm0p6QBX8KRy64bx0vDoUxsa5OChZzhBs5K-Sg&oe=6AFB4957"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFWU4AfcoMUQ7kNvwF5glcJ&_nc_oc=Adoj9POjq33ei0KjRFM8cjFUa7Dv1bC9Ccapd_U1lloI6JVA3Gmp8tbtg3Mabmusspo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-PAE1z9pWKv63UPGn_DRfXjuvS_x2Z3yCNqqTGPClYw&oe=6AFB3CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5TfpkRyA9cQ7kNvwFAIloc&_nc_oc=AdpVZSsk_QcT3KEwZliTDoxxRaij0GktLBVvgGbL1HkAElrLKuSvTq-oU9L3QECFuxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7v9cUk8EoCZPgaaIbQTDHlEplFHmgDWk4AXsqUijZPg&oe=6AFB2928"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1576473825742161", "version": "1.72"}, "id": "1423274634387898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes"
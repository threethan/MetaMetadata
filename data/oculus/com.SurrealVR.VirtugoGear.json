-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxCqAG7VFzYQ7kNvwFXzbIB&_nc_oc=AdohricTpfCvaUFAL6HFBbjErAznFxJtIZQWnqqEnRE1ZoMS6tZZruwEY9KNeLMT9yk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdg7M2bH_BYGtrujuSBu7NiMAkL7KHRh1ebGDqcn6H8w&oe=6A7DAE19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7oazroiD9MQ7kNvwFGsuDw&_nc_oc=AdowrFziG5wAYKmO_cyB6c6a0fZAYVnKG0mGcDF6br1537vSUtMS3a9NNG1UdRG0Bz0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkwh9ze_GSF3BBRWwv9Z3got7W0BH9VvUmWbGCc0SCsg&oe=6A7D989B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtrCZ4R9nZsQ7kNvwEabKmH&_nc_oc=AdqMUgldJX5fDRVIq4BDA81p3NoSWUqOqp-nB0YkqZ3eDyXTbJS19-5mzRD7450kRsY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQdxT442SwD_zZY6fXKN9Td-mhvtWUuhhilTqO0arETg&oe=6A7D9A57"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l42uBuyfnfwQ7kNvwESZD8K&_nc_oc=Adrk6K6-e3UShst8Q6o1GvfQ9XhJaZcttJXPQr1ZNupTHzEBFUsLibdeAb4m0r2CN9U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFILELg1lorwM0NJonNSQ7FVt5Jb77OTtv2w7LLplsYpQ&oe=6A7DC61C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfXEGM_wPZsQ7kNvwHBDkIN&_nc_oc=Adrfvb6nTWOQAhW_hvZ7FOVQSqxY0yqykrkNMvmZpduYD5yky5wLCJuhr4RfpWRrYEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzzy4gA99nvAAYraKPsw98UUv6gIKHFcMB8FoKIR9wyA&oe=6A7DB268"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
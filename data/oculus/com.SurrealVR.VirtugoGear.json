uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US7HA6ikfOAQ7kNvwE_bal4&_nc_oc=AdrzIvhjnKQQBLP5Ys8PAbtTrYaDSLsSGhwz96sjwjSHiVFZaH3XfEmgA9EzXr1_0fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u4JXbsyvZpkNU2labm7N_F_vRzBwmxzX6DkAAvK5-NQ&oe=6A00A7D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVqU5KZoZakQ7kNvwETyjTI&_nc_oc=Adq7V9XJMUEaPJWTMlapKL13RsmWua3y0amrLBZoiQui2tpWdkebn9AitUqdGEIAGA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EWLeKaL0RzUK5l6H-yF74TVF6Zw6syciiUVehro-Yhw&oe=6A00925B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzkXz9BhL88Q7kNvwEYsemm&_nc_oc=Adp1IqPuFZLTdIQkHlLc3dSdYR7Y9MbmWn-sN3mG1RmkZ1QyfANPRzPfMkiVy3-GpOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gQSNzbORLfPrkv27qJovvkAFB3LPZs3sfI5h7adabmw&oe=6A009417"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT4BIkAcH0wQ7kNvwG7miOz&_nc_oc=AdrOXhjh_Z_exD6op4jfwms8hD2URVPlqI0ASoczv-u-5B2abAeTaRUfarcNEZIsJac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gf_3EsnaKtWnrK342PzLNHjh5IsNT3llbu09CSny73w&oe=6A00879C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IL4sEF1PzgQ7kNvwGehGNu&_nc_oc=AdpHGHRFw-DplMrFNJNLkJ--ieN5oyjDOk7_3zp2IRfxDW36sDbzAVXVwx6hOZHR04A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z39CCNpf7-sOn9yMHAajbaus5j5eIxkbCjmQlDtx8GQ&oe=6A0073E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
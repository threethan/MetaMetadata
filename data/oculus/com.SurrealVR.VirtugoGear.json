uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvSlXMVUuMMQ7kNvwEDvrx7&_nc_oc=Ado-ra42xYGVkdY6ShuoF_0WQjTpM8EYTcKLEgpm4XMevUfjPO0RXjZK79erfDnXiJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRESgogtijds4XAG_LhWsJMjzmAraVcDYoOVglvQk8ydw&oe=6AF48D59"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNHDE7OchG8Q7kNvwHWI5Z8&_nc_oc=Ado0eAByBfwBSj58gdLqiLKd2C6GKgbs5wfepHfmq2W_Xdjmp9W2_p0BM-1gLLRd8Wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO9Cj7n6hiUbJ-xe5v32jU6fGf1wda3M54SRv4Pzo6sg&oe=6AF477DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0CZ3EDdunoQ7kNvwGXsclx&_nc_oc=AdpMbo_sfYpVv_UsP4Bwzg0IpkXaNMhL3OegO2ebDoyRSt4tLJ8pyirSCCSZFpmOcCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEDlSDrPjkTJ1GjhkcRKNHPhdhuTFbSFVNRqpMh8BZZw&oe=6AF47997"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P-asdGa1_kQ7kNvwHcQuFD&_nc_oc=AdpCSnmX0_BBRbOmABmSREozO_jIqg2JSKHk5dIVAKDLFOYDkm5y7Xo2Vu9oitqb16g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHxWP5UbXSYj0cP30gI-r-qVAtnjbby03-fY6MEnwPTg&oe=6AF4A55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKaep1o_rZsQ7kNvwHzdCM8&_nc_oc=AdrzNkOJWW1JEMo87p86uzRDyt66gmPGlpy6Ad-0oXzzKFRYkyVxx6WmNH_hV434RN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVImYgQd6Y5g9wzxDcS0ce0pw-bYmD54AmPrHgBH6IPw&oe=6AF491A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
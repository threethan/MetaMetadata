-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqPBMzfV-JIQ7kNvwGeI_lf&_nc_oc=AdqekaP-bbqMqK8bTkY5-Iezua3Emgjz-G3I8sY_Zw7lXnLdW-sXGrHucz6ht649GvI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxhddScmuzP-g-hfLvLjO2vivvDwD4x3-gXPZJmjS7fQ&oe=6AAEADD9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTaxFy8k6J4Q7kNvwHtl7zs&_nc_oc=Ado6N-8g40eyZEcsKmF18cbIV8rrgQJT6mt2ouJNo73dn5ISOILoYuoXJrlxW6GPX7Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2q95G86vedLEMvJqNraW20hzlEIJoRa8g-NA0oDp-Jg&oe=6AAE985B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Abx6ztuNs7EQ7kNvwFkkQMY&_nc_oc=Adr5Ozl5y3g2A7_eMO2ihANNurDMW2NHq32pddkbAuli4WvlKhpU8krTu-bvnXMUfis&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYUHdxAOc0QQ2ps2v6tSmyT8sMTczz_x4nYmKSH6Kl_A&oe=6AAE9A17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t43OXz2FchIQ7kNvwE4XD6R&_nc_oc=AdqghBVduldeiU-52kIrXFvYOl6rZCdr3IoDet1ENtVXZ6AnIgXBgLpBQH5Vu2b-3GI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBT6LweBJH8RKqAWgAns2WCNiHZUV0CnigTQsLoLZ1Vg&oe=6AAE8D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkVrvDcVyDgQ7kNvwEkCI1V&_nc_oc=AdpbieMCGS3ofUQrz8824TTB2YGBg-dq-Pr_2t2v6jSdbbN-HzQBBJ9oA55D6RGQba8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICQC_x-2X2ZF4TaGxeepiR09OKS0gVLSoDud1zIqA3fA&oe=6AAEB228"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
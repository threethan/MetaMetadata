uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpd2H3GdpfEQ7kNvwEGwrom&_nc_oc=AdoJJs3SHH08QPDcUEogo5NjPCA7FUuWpqyIMk0LQn5UvCJxhmUFsFhjiwtA_y3kgi4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yg_EEcXfLdG1hwYIqjzuF4v5ImgSbOLMs6RjI1u539Q&oe=69DE2899"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMp7XJs6E5cQ7kNvwE7UVrM&_nc_oc=AdoeCLW9IXx6vVhW1SHVNRf2no80fpPD-h8el4ysEkxq4TcV3cqvbc3gWaHllouik3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GK2KTi-OuFfSzTWO8xY9jX5h1a2grd-Da77ak5r5mng&oe=69DE4B5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7LgIP477MYQ7kNvwF2WYmo&_nc_oc=AdoeFwPqNBfnF-2y9MyAPLqoLnJS_eyqjqrjQGmQGz602f3iI8yiZzYwPYcy4fc2uA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T9KPRLeq9orN6XE-F9w3r2UkWkjscNg9et9VvyYQJPw&oe=69DE4D17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPortfpQOAQ7kNvwGz2TsX&_nc_oc=AdoLGvD2mhHFrOV6bBvbU8PW32VpepU4MW0mqy6yUQP2wpQSfupNydPyIXW7HAD2C_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yXFdPgC8lU_5BrTgyMlmxC1bLqGxCRt-87CM-bFZ2jw&oe=69DE409C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sOriolp5kwQ7kNvwGzooWt&_nc_oc=AdoHcFw1uVBHYs0tKuRLvpymCx568SqZk2l07W-A1tzb9pVFli1Ca_CLdRZ_W77IxEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NmdBbGOYLp4l9JiKRNAngtqLk27h2zWg-P5W5e3jw2Q&oe=69DE2CE8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
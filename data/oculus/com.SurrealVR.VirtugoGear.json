07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShWy8xWtpF4Q7kNvwFH3-Q1&_nc_oc=AdmAOMD3WR_VqqEqIr0JyLfBEWfpbi2WtTo2MANqfJlfEiGPPmAMqowhO2BEEtBBS0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUcg2T9rA5xUmEnvJy9zmBj2aHEuBZslqyGI_h-vpe1A&oe=69AEB299"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjbnX8ZMOO8Q7kNvwEXnePl&_nc_oc=Adm5B5OmQvibVmUz3jppfsE0cNY9fHMUcy8lysuG8tqEV8-K2iDeChb31HM1Ez9eQbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2xNsFCDSVhpFfwxlrFt1FW3ZMMsY9uBL3E2pVCMuqCw&oe=69AED55B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHbk_6iuhnMQ7kNvwHPIWE8&_nc_oc=Adk2EIzE5NCSPfYT8bKacmQtchw_HpYrqNxoYVHZt4qL_0yltTaKSPO0siotBLzogPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx3xv5M2acmjrdR1qZZs4MSchY5PaxMp0hH75Bltx9Ag&oe=69AED717"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uj06D_oE2AQ7kNvwG-OLza&_nc_oc=Adk9H_PvJWx-DwlW2DvgTGAAAsvSX6QdaeU7qwZqc8wLIjDgcZ_Wgsh386CwOvjQGCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6nCimtfIH7DwNT3RUMkKb1fEQzdUOK0HGyxBA0Z_rtw&oe=69AECA9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ3ExUExOicQ7kNvwE-dTjv&_nc_oc=AdntTMhhE0AYFDtVgio6_jPuWUFY21WhqLyWggAXPhBAaM2-QM0DPqLSpbE7hh28xHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx28niI_p-UMP97hKdqXYBlZXzOUBjhde39qElubn9f3g&oe=69AEB6E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_1
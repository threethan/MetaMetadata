uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWBrR5a8pHkQ7kNvwGV1gBF&_nc_oc=AdrARvMZwl37gDK3h2gIreNYZ5jM-CPIZYNzyirUyhwCKs_bwFvpesrY5LatBp0nmbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83HnJC4Ep9_j7I4FW4tT-NUIKbQZbSYj_vRSEB4VTluA&oe=6A316F59"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o1XcCbMO3UQ7kNvwE5Op4r&_nc_oc=AdrANkGClxiRzVhspsfjPsGLZuRymNO8Zxcyh_33oWDHKOO4rXnYnPesfXzK5FFu72I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I6to19Mw6Ftkdlza23WQVd9PU8jCcogA8kEg3iX3Czg&oe=6A3159DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ziA1SlRkMQ7kNvwEGCW8r&_nc_oc=Adq6pLacebbN3kvJyX00LMl5Pg9w6QcT9pWv27rxRsIMFXgbOHqfNDwzz5ZiNBMdPoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-avwtZ9wl5h6btLNPsVkHrS8gOVq_QswB1a6-6fkOs3w&oe=6A315B97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDN5xmXSyIMQ7kNvwELP05Q&_nc_oc=AdrfiguCy93PRfzmc5YU9r6hFEGGgKtVAND3UrxSSGtP42sTYgqDPwIDoPstPmpiJDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CtDcmnDxqaZktbNJZyXd80o7VwG4666oVBTBMI4rPiQ&oe=6A314F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbqTh261J5AQ7kNvwFj7LqC&_nc_oc=Ado6fdTM2-Gw3rUbo_cLMnQ9VwdgvSuGFxQayv55VSHQPViT7iJzMIdlulN1rpDGhus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OJkBx7FKpZTv8HG7Dc4qb38tQuqsJvO0jJXCcH0dIcA&oe=6A3173A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaeOM5Gv740Q7kNvwHUK36E&_nc_oc=Adrrlhy9GFrkc8ktqD0pTZMGyclXBYFuCTriarPsI6Uao6gIfojHEeLYY4LxWbDr6eU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aYEYzFL3F01Jw6WYNKQgq39wry94m_yxqAH0OJ1cdnA&oe=6A36B559"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF4K3Hx_R5QQ7kNvwEBn-eg&_nc_oc=AdqHr6hRAEieCu312eApUFHfZVwHwws450UKxZrSWFVgzSt3cewZdxh8k-9Rpc8iI9g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oPy5aUGC-R-fb7drgNhVXBNEfj5Xd5O6-vKOVxHKe0Q&oe=6A369FDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzzZAwRTluUQ7kNvwH3NRBj&_nc_oc=Adq49OlLfq_UJ8S3StN8ilx0FygODqmhInthy_P2v5nSZtyLgTYSegsWbEVc_GZoG0Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GDTkaqPgxypMwn7icDv6HLZslaRQDIX9UPB7LdWdanw&oe=6A36A197"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IwmrAXSxM0Q7kNvwHCvUg9&_nc_oc=AdrNkAXvUJFKbr3vEyXrALcEZTEm-BFl8JfjHyqf7HHfbQmx25waaMIs4rdBW8HUU_o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DEyrabd-ouE9oBNVXybqQ1343J0mFwLHtlh_hYVseZA&oe=6A36951C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7fXT7Bn2ksQ7kNvwFIadNN&_nc_oc=Adr5XnAAt0_N-dG_ChFaMRHanMcUCBrb-JQeWqAu9ztZ8CeIrKogrHbNWNl2b6n_S8M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81ujhzkZjcAC9qSPlKh5ixm4TCdoJh4aX2XvXX_zlJfg&oe=6A36B9A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
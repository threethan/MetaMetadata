uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IREahG7FylAQ7kNvwFX1ceW&_nc_oc=AdqG5txQTq4VhDGPCYwGi4ZnwdQ2ok5yB7-a6aNPjRmU0m7myiL-2iCetiEO6CTpPGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBmi9zWxgtwrneXNVbX6e5GsHh7ujyAU-VVWo9zFfhcQ&oe=6ACBAED9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLZSdIMxxekQ7kNvwE5Mf9U&_nc_oc=AdobGuvKYw_mgg7Lde9Rdt8ju-EhP8E8sAoDHnxC7nFqSdC37pkHVzvKK33G7OnN6D8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8wirWtFNyGpwM0_uX5EXph6mZTwHp0xtUQXy6GuLGew&oe=6ACB995B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6pGf3ThuFkQ7kNvwH-cb2i&_nc_oc=AdpB0-Z4RKCx8bnRlXrZ5HGs3jpT4C7IxyUCpAN0d90lkaHHRWQhu3hCy5lp9Qjx5hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwujmGftG51Z89Ly7ZDP7QM7LXt6Tkr9FOM04uLnB3dw&oe=6ACB9B17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bjt6EMUp_YQ7kNvwEJHGrj&_nc_oc=AdqVbQr6eP8zXcQz9oBfSpbITgKIjQGPmlC3ws0653p0015ti1_54BaLY5ZaK8eNyM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtcazLIy_Ar_qxSgTzO0a3XfX2bPsVD2pGygxxei3PTg&oe=6ACB8E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U6ALjAhlwcQ7kNvwGbBDRs&_nc_oc=AdpnJHuhAMmhg3Qs0lDflDIfS4LuwWitnczztGxp5EvYuCFPCabGp1TX4m7ieJkn_KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHEDzmgKFgzcQDWoDBO-n7tbuasEuCzpu28QddofdaEA&oe=6ACBB328"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
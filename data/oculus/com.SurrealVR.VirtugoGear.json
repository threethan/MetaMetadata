cdn.com&_nc_ss=8&oh=00_Afzr7dlEGTAL0FR65WX8CmXdsiOvgLt8Q7Q588az0O2y6Q&oe=69BEA917"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQZoBnCxLwQ7kNvwG74eC-&_nc_oc=Admd5cixa55csbzeym7nnAI0Jvqqp5xVdyfp30CEdxhlSZ46tLkgVbNAgZjrlEzZ_C4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3t9AGXsWLPDq6dhbs64XFH-tZ-Sg8rpLvP7UHkXpZpQ&oe=69BE9C9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8NAlFEtDTcQ7kNvwHZT6IP&_nc_oc=Admi9Jb41XHF7_Gsxp8iRDcsTq0qcnkndTUtlCmooKrvdmBkIFne9KtvoWGTIokshfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOPQlzB81vmeoHqNwF84aFGTpI6aOG2P-Aa0gs17X0-w&oe=69BE88E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1734607339947046"}, {"status": "PUBLISHED", "id": "513821779012431"}, {"status": "PUBLISHED", "id": "2049077005312079"}, {"status": "CANCELLED", "id": "520191075008451"}]}, "baseline_offer": {"id": "1734607339947046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1508950800, "status": "PUBLISHED", "id": "1734607339947046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1576473825742161", "version": "1.72"}, "id": "1423274634387898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1569646243091586", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1576473825742161"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1423274634387898"}]}, "change_log": "We addressed the Back Button functionality by using the default Oculus provided handler.\r\n\r\nWe've also rebuilt the app
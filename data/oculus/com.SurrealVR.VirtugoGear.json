uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDhZN1E1yvsQ7kNvwE5TcFR&_nc_oc=AdrW0YdHiKSbZaMlsw4zp4px0bh5qice2msNCSy1dJEE4ijLnXgGE5XozFG18V3mnrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LOUrxpWtthf2DZEsuTXQu4iJqGShctXPlSbS-otSyxQ&oe=6A43E459"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGITecSV1wcQ7kNvwEA0JqU&_nc_oc=Adp6c8GBRha_5D8wObeVFK1Gx-KKCZxsDQmwSD8-dLz_avzc9aUUza7eExAJ-ZBsuRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q1XGF3AS0W1YGx_UaGO6anVwgsABj4LysQ7Pu4okEHw&oe=6A43CEDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGhFiYNs0hcQ7kNvwEvc9P1&_nc_oc=AdoY-M6nsGj4vMEBY9b1A0lvoLG4tF0aPFmwStyWAhHX_XSucJW7uzXSDl6ENPSgR-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w8KPMzDJcpXO7jLBtUIsuNuPcbL_MWRuZpaZwQ9GMmA&oe=6A43D097"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTfPH93Dk70Q7kNvwGGNGIv&_nc_oc=AdrZ_temf7Ojx0kljCaIXjWYEOVGJLE5PeAVGqltZsEOL30gZefCy59R5qnn6Vs4_x0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Ycd5gRUrmdcTRl5HzuUWreHm1kGfhjGKHdcbxL9G9w&oe=6A43C41C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhRmqANCm8IQ7kNvwERukhb&_nc_oc=AdqPyzZrUcmK0s7YmtOLC2tOjTINsjpiGKKtjQiP5qJHdchj8N3x_mki9gQnTmOUMEo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3eFQ7DugKuOmnf2hslkChPs7njEBGQmyxrrvR1LcrfA&oe=6A43E8A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
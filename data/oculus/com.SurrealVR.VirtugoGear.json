uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaeOM5Gv740Q7kNvwETZPOo&_nc_oc=AdpsyQ97Ccwhlma0xesWtiZFQyT18KojOSKB-TEc2CtKTawKuDK6_OEosB0Xqp3a_5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O1qdPtJWflf5lJXBKbSuobP8BwsUUISY8oSYZAYyVvg&oe=6A3563D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Elik6vmMCekQ7kNvwG6qdlP&_nc_oc=AdoT_v2Qeiuw7ukGUdjVpOddupqxfMYdl-NvlOo2j3ncM3Nlf69ylxunGPLRPpyno9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wTHJzEYs91HQLTgs1WkBiTD_ycQxbXT9mGjq-qwk5rA&oe=6A354E5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzzZAwRTluUQ7kNvwGAvT_l&_nc_oc=Ado4GNCQ_9NIG6GEclRSasXYALmekBiYM8bHr4HI9kEEffpiRsRpWH79h4NUJDEUFCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OI9ndAFJ8iTbUvSWrEGG2tfLsImEvn9-n_ZRXtlPcYA&oe=6A355017"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IwmrAXSxM0Q7kNvwGvcQQM&_nc_oc=AdqFPN3p0MXPFjipyV9ar-PGrL9Q0l5zvVrIhDVVh2LUpJiTDyShuq4SIaFPPwu_WMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DrxkQRPpRsyE3tKxFYg_Zv7Jh1mC8CdZfdl7h56v9ug&oe=6A35439C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXwW-b4hkAcQ7kNvwHjUjcY&_nc_oc=AdoWgDA2Taoy8vg_v1ihm32dX07F7omE9suoJFfGsiGY-FiJPk0_zsWI6YqNflT9ylk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cEvCEx8ajzfmtV_1pUgBVMvaOITMCFj2mHcK-eAyZbw&oe=6A356828"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
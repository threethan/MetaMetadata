07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv_jyHLGSTgQ7kNvwGundFA&_nc_oc=AdlKpkNLg2cxrlsgqslg7AdGp-ks1gdoYHHclKvgc0CY1clEneACs_ChChwX7HhjpNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqi7An6dvVPu63uyRw8EwUU91-hp9Nb53jHbifhfTOoQ&oe=69BE8499"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q42e1xYYaMQ7kNvwGInIid&_nc_oc=AdnP_lQxnfrHLK4x8itFfOeyQapkTRbtiirgxYK9bAkVDOgoc-v400wzmZdKNMrvY0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQjCmCHW05xLzB_M1C0WWCmVzRY9f27GcB3cFc5VSUvQ&oe=69BEA75B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk27ZSfzFcQQ7kNvwElijgD&_nc_oc=AdlkiwjkNNVWgOdV42WapFzFjpXcZCzMGIX_gc4EsGO2OqrPYap3FziYbEvlEoR1UxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzr7dlEGTAL0FR65WX8CmXdsiOvgLt8Q7Q588az0O2y6Q&oe=69BEA917"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XQZoBnCxLwQ7kNvwG74eC-&_nc_oc=Admd5cixa55csbzeym7nnAI0Jvqqp5xVdyfp30CEdxhlSZ46tLkgVbNAgZjrlEzZ_C4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3t9AGXsWLPDq6dhbs64XFH-tZ-Sg8rpLvP7UHkXpZpQ&oe=69BE9C9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8NAlFEtDTcQ7kNvwHZT6IP&_nc_oc=Admi9Jb41XHF7_Gsxp8iRDcsTq0qcnkndTUtlCmooKrvdmBkIFne9KtvoWGTIokshfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOPQlzB81vmeoHqNwF84aFGTpI6aOG2P-Aa0gs17X0-w&oe=69BE88E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_1
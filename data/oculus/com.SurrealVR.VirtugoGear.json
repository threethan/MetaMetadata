-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf2pDAv7C5EQ7kNvwGBnAFb&_nc_oc=AdoRAtjAf8EEqhBH_zZ8OoeMRLcff184ABNaGehyIkSqga8K4g7PHVPK_j4XkJmbask&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaAx3I0dne0RXJI7bIoJjT1mdka_S98ECZlxDOiebViA&oe=6AA967D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D45v4zcBer0Q7kNvwG8xhE4&_nc_oc=Adrapd9YKQYx9U6-bmv2mrwbl-49IoUI-QEoxifdBRSq8q8tEhXp2r93qHa4SUSVBAY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeOmlWShw7jPM2aSdUcd82EggbzrqO-QIjKUp1wvn8EA&oe=6AA9525B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyR3gK32sdMQ7kNvwG4rCx0&_nc_oc=Ado50bzDm4a7K5RNM8y7y_1jNXYK8K1ZQz-tX1dQepbc37J9Jl-ry2YPYYClQmJdyBw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK56hgph2_pNc8Sfd5eEms6bbXyCt5mwQhrJbpaLvP6FA&oe=6AA95417"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5bH7PHvGmMQ7kNvwGoT0ad&_nc_oc=AdomtWW6BMD-hc1ZwaHpJb0hvVYUWtRPiqA2AlfSsY31_3opdxZ_2rrsTXZ9v6O-KKU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0XewsjKG-qElfXjPiiE9b0paEHXQY1S5Xak9uHcjggw&oe=6AA9479C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW23uKzpW14Q7kNvwFhFLah&_nc_oc=Adr3ABwA0eugipEB-0PdH2vgAa9jFCZtL7zOmtYxAk_gNb5yosksiRB9ItNHEzugg9g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLhVaB2loD6C1rhxHdCQu985u89lUQa_d7Qgg1D2bGxg&oe=6AA933E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrsFVfR7OSwQ7kNvwGg5ese&_nc_oc=AdqgiiHRCk93uyDYleZt6_wCG_j9XpW6rQNuMU50mXY0WtlR6EwyyiFyPe-43qTH-hQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxu9yrrcipuiBcvqGKnUIUGCIedxrlsa1o6A0xj_jG2g&oe=6ACE51D9"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjdK9a8mftcQ7kNvwG5fvE9&_nc_oc=AdoTOAign7hmmIqqxEOkcoN_6g1CmLtJVo3i7D9R73mpjRft-3WfYO-p9Eb-PN1p5h8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBDiQImkfIYLosBAU1jHaZ2WNPagvvVMueso2gCHHziQ&oe=6ACE3C5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1fTmgWs2jIQ7kNvwEWTEUk&_nc_oc=Adr4TJg-PDry9r6yCFudx9W7OEA1Nl79ejQY4E0-hxmqEXXPhzotYQe-L5F9CnTC8Qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1P4oLNsPIGIgkayfmzDyIePp37SUlN2yi7FRJjRMafg&oe=6ACE3E17"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bjt6EMUp_YQ7kNvwEVnazu&_nc_oc=AdpeDLjl0Dw64PRzg_jmiJhFAy3dheFCEqlxiZRTKKq6H95fEvCIZCUNLDB79rLINVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqkmYJX_5rujW_TgC7qlyCaMaFIUBEN_25xHAvdqAtIA&oe=6ACE69DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIwOAnY6Vt8Q7kNvwHvvWDj&_nc_oc=Adq-EXC7ACXP41z3djE-hVmPwGfLpcU_kNe1It11tpSmhOXT28eJOaXrcs_tgW_x9y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVIHRJXqWsirQXyNalUmgJN92mOJPhmcUjskP9t4SpIQ&oe=6ACE5628"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
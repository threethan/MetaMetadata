uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xc36NwVR4wQ7kNvwGkO06L&_nc_oc=AdoLFf58s7-EQ61FjkY9SzQ7_rDlxINdXJDE871rNQNLq899IPlLuwyPatBTqnP-PJY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCYXu54IHYlSONgSOtXAZUBmhW0dlV-pMGmeLchdg4UQ&oe=6ADCD259"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wkYHM-noAYQ7kNvwHaHoQE&_nc_oc=AdpOtG03L8JUz_Oo76bNRs2uF3gn01WBNTWHD6O7UqDSZQeRUGtT_ITppXQa3ETtAt0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1T8KYRnaYJSrGwGTvcmcScHrRAOQqabAZQiuMNwc2fw&oe=6ADCBCDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY-0bbdoV8IQ7kNvwH54ZeO&_nc_oc=AdqZLzTGTZvDr4kqbBfrf1NtM2sZdiFGxdxlcLfsyRmhk7i8YKB_eoYy1y-YE3qhFrY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRX0AC2hJVFXjYbzgEEjmizTMGef7hLyTR-AoBUvvf4Q&oe=6ADCBE97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TSXWjLjFmYQ7kNvwF5u0ax&_nc_oc=Adpgj-ttIjhQ4Lwjm7m_dEoKGbf2teOjDnF28fORCwqIi3kK-pBpull1WC58F7kclBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOy2r2KpPLll3th3Z24qYvv9i4rwZT5pX7Tfr000rnkw&oe=6ADCB21C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9_X-HsRgdoQ7kNvwF-Avlt&_nc_oc=AdpO_ZAHGzTK64hJ8R5MBZ9dSE63j-Atde4klSEyZsn1Ej6sqOH1u6JIKuadqoJbYcs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHVPPuYdbgskVmG8-TnR4ei4ikfXhZP0CRE2LGTLqSLA&oe=6ADCD6A8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
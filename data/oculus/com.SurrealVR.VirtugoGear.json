1_iO5sQ7kNvwHZ7YjE&_nc_oc=AdoPbDiv7jMhbYPKd3Sb0D13DlvRYakRWb-ILcM7ulyx_2omM2RPlczNdvW6FN40BGo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCs8l52kJSwUwc7U9GTwhXgynTAVYzE1LHQA5nBn5UGA&oe=6A8EBDD7"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw8W2r25MgcQ7kNvwGMcI0q&_nc_oc=AdpWww7urFSve1nhuswAbdlKX30YtgNVmuPdEI57YgDMpt3sk7LIPgtt8xJLRDEmU64&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjyPLeAcBrknfeMTWjZN-NwcCdrXH_vbLzo9Dw88mM6w&oe=6A8EE99C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxJbul2ScmkQ7kNvwGDC-KD&_nc_oc=AdoI9s7Rz1hfAvvZbdWtdqlveIlgEzWDwtTes8JBTn3GycS3oZYSN-lArPZtsz3zyKU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt2ArnYAD33OIMX2_YgBBVuPqZ9KlRw-BEYcyaBPRITw&oe=6A8ED5E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1576473825742161", "version": "1.72"}, "id": "1423274634387898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1569646243091586", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1576473825742161"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1423274634387898"}]}, "change_log": "We addressed the Back Button functionality by using the default Oculus provided handler.\r\n\r\nWe've also rebuilt the app with KitKat level of functionality, so Lollipop tests should succeed at this point.\r\n\r\nLastly we've added the entitlement check per documentation,
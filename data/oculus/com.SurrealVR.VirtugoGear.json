uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sVLz_lS6IAQ7kNvwEDGBDD&_nc_oc=AdqR8M-Qs4jO2gV58YeZa19W25CLFHz7RpL6Gs8T7xYaHAReHYf46vALB8xFRYxCGCs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI4GtoGPeHQSR-VKXUA9jsuvD-jXa_B1Q10wfFod0j0A&oe=6A883A19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF5hIevazHkQ7kNvwGYJGu6&_nc_oc=AdpNVZEtQ7HSu1JFylV_oar4OD425gMba9kpeFx5TvnnyAJPWIXB3qVZPSKwP0BZxbE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV8H8iO9elxCyfNxv0g5smtzeHOxqWxbhssrrny6ht-w&oe=6A88249B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ6bFlYSmCAQ7kNvwH_EbNz&_nc_oc=AdrU1qCUzDWAC2tO_U8pba5GJHwjaVqdnzW177EYJAckf-AeC2EDjIetsgFh2GSleYk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJMuSSmmMN2M4vk8cej0wUjnqwHpY5Gv-SxHdBxnWuSg&oe=6A882657"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGM4_VvtfGAQ7kNvwFxP01F&_nc_oc=Adoh3iUGpjtA4H6DCHn3pBtP6NtVXqKIiBic5g4qe7l5jSBSowX4oUSngYD5fZvpaI4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQFQX7D6fo_kDul2qqQS-v6-m9qNSof1qdxcaYDibYkw&oe=6A88521C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRuiPNIea_gQ7kNvwEM12mp&_nc_oc=AdqgNnudED_XGrq2QhjWbam3aFYWDv6UG-5b9bhPuswNXt60qT1nkG31391D-EeNRxM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAHuS73uvSj50yzskvcS70M6ZyCjF7m6hZHcaoSSGPoA&oe=6A883E68"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
-2.oculuscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3jPnP2PWtQQ7kNvwHVa-WK&_nc_oc=Adp0xxTPypWOZ2UBYyX4RJykghgV5NEnh9zj2zLF6RZ_gOd2negcJ6CXAxTz19EkTjY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ld3WXX8OwLwFY5s0pFbQF2-tYeoYVd7OwVWclCZLLhw&oe=6A11CB59"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfAHh-0ZqYEQ7kNvwEwHNbw&_nc_oc=AdrYmIYLBY-qGiyXy8t0RplMTlRRiDmLXwARf3Scx0vUMCo_Z53VOhGV_08gzJrG-E4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75xeqBaUA-14XykYKZehSso8gvinm0L8OkfRbdh4j82g&oe=6A11B5DB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25GpDIPgTHAQ7kNvwGqhuz4&_nc_oc=AdqRlp543tzpWeQP0dqm0DVEUxo22LpbrqmuN_7kH8vvVZTqiIhISITChWJ1j2BzOPU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a7pXi-xNG__Y99GuL0xtp_ngAD1bo_JrQfK7766V7pw&oe=6A11B797"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YgYH2WEJfsQ7kNvwGIcKv9&_nc_oc=AdqWnsIiBO_9VofZgH6PCmEJlTqv_lD7D6KFHwySPYVYE5Do3DjEqVqwsZRvswoTi0M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P3oYYQKmZqzc5WCqVtSNBVR7V-gt6hH2vL47oRKb7YQ&oe=6A11AB1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwnN9cFm5QcQ7kNvwEJI3Zy&_nc_oc=AdrDD42AcsLs3Duf9EPolyQ8J8nafYQNv02fX8uz8NIqOKN-UTwL9JDisVWZGFN3krQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t2RQDcB7rjhNfcbI1NLZpkqkldcrOUiMbpxiNqgLG9Q&oe=6A11CFA8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri":
uluscdn.com/v/t64.5771-25/11162707_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8kwf6Kg538Q7kNvwGA1feg&_nc_oc=Adpmf7wN1R9kT6vADVU6kcMCV-BJu4c_RqMILOvmLDpec_xl5cuZ9xJPLVhClijbkwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_pqXKLmRFh0xvTxPpePgk3b0r2NdbniRnl4YyzUzVJQ&oe=6A60AD19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-soQSPf0GIQ7kNvwErahDQ&_nc_oc=Adoxkfcx_nhQHTU-zctRl8S_kFO_QeWGaHa6m6Dyq-dxAgJ5WmK6mmTLe3TW1f-NHmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc-TcZBak1T3fjKCujLJCBG0My7nbpuHPYVfGWyXiGxA&oe=6A60CFDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJbDi6aRhw8Q7kNvwEFrm9U&_nc_oc=Adrc4yx5w_BnJ3PqYq7OI5HyDOqZ_iB1nIC829DyTIPbyrf3OfIIrmOPa6bNM6ECQtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcEP_6NRU1_f6KXA4HvCw0Fxcl4IqjqdnDcTAgLT5QXQ&oe=6A60D197"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mixtl24IgIQ7kNvwHegXqQ&_nc_oc=AdpT7P1E7_2ZsSZ00oVwa5eIJ0XVEiqUQbIcMA95444NgRwQR4RpW7O4sT5oz-1_m7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBggijjCmsi3hGs_H-m8glafjhxyzFx9STKlrdM3bySQg&oe=6A60C51C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZHD9eYBLeYQ7kNvwEpdOGX&_nc_oc=AdpLIRHstgLTdOEPl5rZlV_odfKd7F72_1T-F90lJHUN0GgnG_s4vGzCpwzEmOP4jVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXpN_tnBTMylzCpf10MGCahJqBCcmDx_NnA8XD_lWLeA&oe=6A60B168"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D09MDFgGjOMQ7kNvwG78jXV&_nc_oc=Adnu7keAjEMwEQ8ghuPPGUeBYmo2GpdIBrO58fiMUwQoknTFNeZi0PjBBXf1cXnayQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuTXK8yux9IzqFs6lLwRimvwu36hXUZK39trARQwCjCWQ&oe=69A81B19"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZwAjFM65wMQ7kNvwEYoyCI&_nc_oc=Adm-Vx_pls7JLuD7EUxLFzoAOClqzdWRK0Uk_lzyaAPALtyflBzsiQXD57m7psSnwHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftIpOSP1yAMoGhdBU-weydwe5wqpAQb1nkMMDcJs-3f0A&oe=69A83DDB"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLcRmaWoP58Q7kNvwHcPXDs&_nc_oc=Adlcf8GGxG-hBt0hCKhtUFHxLF-VehBQOxPInuviHTf2S3CrI5gyN93sbDBUkk-pnUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwqJN1wrX3v6BvRbNQFCYRJUN3fHaC4m-ZG4RRa0r_cQ&oe=69A83F97"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7Fz46GExlgQ7kNvwFj08aC&_nc_oc=AdkF3eycNVHA9zDg16VoYp7Ex5_8lcfpSMgnui7uX4apVSbDyAwaGnyc93q16rTQQuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_G9ZfT8goEkgXF1AjfWOiafCGvL-wA-xfnMZUiQhGjA&oe=69A8331C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8jtReq-lZ4Q7kNvwGp-Z1I&_nc_oc=AdmRiERa373tWwACBheTgCxX8MtQ8au13G128x6hUmoAZnDfbogc1pRnI88ZF92jFHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSopDZ_cOsx56m3Yjb7iFo-tDiYDw1JXsNpusXDhu9-A&oe=69A81F68"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162686_1
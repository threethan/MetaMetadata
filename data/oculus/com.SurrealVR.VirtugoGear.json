07_280374532452728_3413607141771051008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLJzjC5_ml4Q7kNvwFQugI_&_nc_oc=AdmjK2bm6QHIRV3-yA4zutY5BPh3J5IXCjfWCxtCGo4aIucJ_NH2w9p4r8zw2M9IOMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvUcwJvKfxe0OL-IGbHbJz7ufAD3BgC4w51M2jBF3Id1w&oe=69A96C99"}, {"file_name": "migrated_image.png", "id": "1539631142869654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_288257501670937_8518653979020754944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZwAjFM65wMQ7kNvwHoydJu&_nc_oc=AdliurA6QuMC4ElES8IYC92vKpsIgXVXNwfnOcWCOL9t_X3sCYiqJKh3T7Qxm2hpMc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsorAUKVoyGLe8zw78oqEqWH5ivMKMx5YIyF1s6xi1wfg&oe=69A98F5B"}, {"file_name": "migrated_image.png", "id": "557066241674635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162701_141236729820889_5650786972680060928_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTHItsw5hGMQ7kNvwGTz7NU&_nc_oc=Adn_zjY2GiKhV165cQZYhrpCafcCCe3TwD32jjmg9eOet30y5zL-GtE7G4b0qZ8Wslw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs21qRWLSj_3rsp7vZEqUz8N6QXMpUahKLYiejTp1TSUg&oe=69A99117"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7Fz46GExlgQ7kNvwH6hv22&_nc_oc=AdktXJCirftcepsjXoOKoxXcB1SGpvmEURA_AOnjcfLiHDquuOCxG5I9mYkIAQW2TPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvBs24sgvHTMW0GlKSbDvpNrjwVjzspD-QlbWkgVlzhMQ&oe=69A9849C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8jtReq-lZ4Q7kNvwFDm3DD&_nc_oc=AdlBJEHs2cCLshM5nsmgNofDESydBiX7y6XvnEHYbrfiAuVhM_h9iFj3uyiRS1U1wZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvF88pnREBCQWnVgQEtXcp3EMKbe2IPxiXw6uAWBhr29w&oe=69A970E8"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_description": "VirtuGO is a classic matching puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://surrealvr.com/privacy.html", "developer_terms_of_service_url": "http://surrealvr.com/privacy.html", "publisher_name": "SurrealVR Inc", "support_website_url": null, "website_url": "http://surrealvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "334478731914308"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162686_1
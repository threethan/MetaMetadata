KmH&_nc_oc=AdqMUgldJX5fDRVIq4BDA81p3NoSWUqOqp-nB0YkqZ3eDyXTbJS19-5mzRD7450kRsY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQdxT442SwD_zZY6fXKN9Td-mhvtWUuhhilTqO0arETg&oe=6A7D9A57"}, {"file_name": "migrated_image.png", "id": "685147152255764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162686_153619565230181_561696037719244800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l42uBuyfnfwQ7kNvwESZD8K&_nc_oc=Adrk6K6-e3UShst8Q6o1GvfQ9XhJaZcttJXPQr1ZNupTHzEBFUsLibdeAb4m0r2CN9U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFILELg1lorwM0NJonNSQ7FVt5Jb77OTtv2w7LLplsYpQ&oe=6A7DC61C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "879261972236608", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162696_879261975569941_2394592379467202560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfXEGM_wPZsQ7kNvwHBDkIN&_nc_oc=Adrfvb6nTWOQAhW_hvZ7FOVQSqxY0yqykrkNMvmZpduYD5yky5wLCJuhr4RfpWRrYEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzzy4gA99nvAAYraKPsw98UUv6gIKHFcMB8FoKIR9wyA&oe=6A7DB268"}, "display_name": "VirtuGO", "keywords": ["Klax", "Tetris", "Puzzle", "Colors", "Fast"], "long_description": "VirtuGO is a classic puzzle game. Colored tiles come at you nonstop, and you must put them on your carrying platform and arrange them as best you can on a 5x5 grid.\n\nIf you match 3,4 or 5 tiles in the same color horizontally, vertically or diagonally, the blocks get destroyed, you score points and free up space for more tiles. \n\nThere are 100 levels in VirtuGO and as you level up, you\u2019ll encounter new color tiles, and they\u2019ll come at you faster and faster. For each 10,000 points you score, you\u2019ll get a WILD tile that you can substitute for any color. Visit the games community page to see the possible combinations and scoring details. \n\nVirtuGO will get addictive as you try to better your personal best. Have fun!", "short_de
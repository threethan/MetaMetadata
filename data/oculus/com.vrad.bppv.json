c=gOu_w6W4NjEQ7kNvwE_T_Ai&_nc_oc=AdrSOaGAG4QfC6qoPfPh1iNFcqMpNwjuM9EorNnRLpAfMTfuKHRk9gNRMuEurv6xjWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdAYX2vVYh5sZ7JestDlJegKKIlQWUcnSIlsX-0TzNPg&oe=6A985174"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGny7UW0UwYQ7kNvwGBVVZB&_nc_oc=AdonPidnCvmU37f7GM5BnSse-cRd2o5GoaN7c2LHrD49UCiLgMFx6Q94jdV4Q4bOrPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5w85El3DAQMXCSirh1zHPXYvGk4S99iyQ8xjf7APkcA&oe=6A98371F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjA5bs2cMLwQ7kNvwEPSnca&_nc_oc=AdqqkN71IYLIMlRcPFfaNY5So54idqblVxXCYQbTKyOgC-aVUGyRonp-afNI1pN3BTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBwyY-r9Tj6wtuRK_RsEtFVuyeNcWlJ0zATq0IjBZNKQ&oe=6A9844E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP-ztx6xDAIQ7kNvwH61sNC&_nc_oc=AdqMQSMDa8jQz98S5j3_mC27SSHhnvPX_nFtd6raWiEyLo9im-eqILYI9Txx3hmLW-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5weTJf2oYzHpK_IrnTjdXezIS-wS3qduZDar0Jke1Cw&oe=6A983EF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JnRoe-_7oQ7kNvwGdc427&_nc_oc=AdrHJFemJMKlzEgzC3W_83XrvDSgx60eEjH5Y7K0BtpMn0ugamiBZZrXx9qP5DqTFD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKZGaOL5KebnNfxawxyuxHJfVskF1T_DR73a_7p63C7A&oe=6A984E9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPC8AHaUG10Q7kNvwF_umFj&_nc_oc=Adr-KKhCi3aPNS734nqZa7WNLRMZhN6a9vLYsZr8Yfv1O9pJzyh9XxZGz1X8t84cOMg&_nc_z
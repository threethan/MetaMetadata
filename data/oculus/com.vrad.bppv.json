c=LkrrI7oyUwkQ7kNvwGueGww&_nc_oc=Adoissint_lsIDGDQ444ipdtgO39cPnRc5MZmaAlnUX8szFpiSrbSne9RdMOzv9XWPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-b_jnTasdJDC8QQD7BPiaRgiLABd0vHT-70-jlGGhfg&oe=6A0DABB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdFENcqMAD8Q7kNvwFLmFou&_nc_oc=Adq3SqSBTCKuBy5bverfP77R5z_O-pmlOtgD2wJ7Nm7mbWBnxrJOYTNoJrRWGJl32Pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47czfcbjXDpmS5qRWj9up6dohQKy5Gb5HmnX6Lr7H7Qw&oe=6A0DC99F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVIRbwaZWiAQ7kNvwF6RKfu&_nc_oc=AdqZZKrQxJr5qr2D-7YOJxzR7jsdsgXJQC95T0foAlZGHgmY5skV7UlFFKWkdlCeUEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wIcFNFXauXbp_zsv_EjkgV51Fe1S_wmnYL1zh6h9ymA&oe=6A0DD764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkVrXdYHmY4Q7kNvwEog_tn&_nc_oc=AdoDuWFa5wzq8yBuFHdwTmjzBAV7SHr2poefhA_PYyW6BvdbzCtNSYu85IAftZLpMBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YHk2ds46NOUoLoNWJ8x_Msh2E3LJbIQboZ_IDLfncUQ&oe=6A0DD177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dN75L_t3m8Q7kNvwFn-VTE&_nc_oc=AdoeT_0U1dPSXPApvnTPzyD3OIYYGcmwsumnedsOrAlZrwwAlL7v2Hycp4Ul-Bev_uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lsihKNv4uB6MpyBjsl1HjFrqpx17HzGw4Fzh5sP_44A&oe=6A0DA8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZvjakI2Z38Q7kNvwEBU8uU&_nc_oc=AdpO97oyZu0LE1m68ZzUL4XgLDlzsmNK0XxHPPZ1_MnUxXdEjfMpKr3DoQmCKctZ2Vg&_nc_z
_oc=Adp0pjiPb6ybBE6noypNjrI_p5QO-iBozBMVleX2mDARZX5tFVZypmvoLkh9Xl5mUiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-n8GqQ_s7ZebxwbpkpPyiPhTJF-EzIZzvgM_H_CMphg&oe=6A707FA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klkOlfenu2MQ7kNvwEx8aKk&_nc_oc=AdpFa7kbx5REwcrUwzLpKPQ4SC1sGQpmBsl1Z8-dJxa5O7IN4Xdp9-C7JVj02aOOjMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi8bnTos68DhuCCouMSMfzg0kH5aIGPn2-Q3-YrwJOvw&oe=6A7079B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7jN9mggyk0Q7kNvwEifp6N&_nc_oc=Ado1EkHAaj4S9DHNM8Ctno6PyVHEJvFstTU4xEwQvbY0LVwEPX4so-kcaZuao_pItAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG5Q02fQUQqP3ytN-vlwQcOptvhtg7dai8Q-ELDJ092w&oe=6A70895C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6eiBTTPz2MQ7kNvwFqV2OS&_nc_oc=AdrRIcrN4oT8w0IsSZPzh4DTC6ftCfl2dKM2I58JIqPvjM6WFzwSi-QjxVRWFWn9PjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu3e1TmnzJ9C6pN5pw8op4d9bVbqo8Qqk9ycSDEhjtCQ&oe=6A70858A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYNzZRXDRbwQ7kNvwERu8g_&_nc_oc=AdrXokME2c6TslZM2SM9I8hg_96BmsLT52xk8xOC4jUBw0ZnNtCxpjxyG2ugowkQu3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTaJU6Rfjje89zQkLzIgoi4BqS6FRV1M5MyJibvSLmLw&oe=6A707959"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAoimhzu1ygQ7kNvwEEQrwI&_nc_oc=Adph12ZOLsC86_8ofam5ubTIe4B2P8RL
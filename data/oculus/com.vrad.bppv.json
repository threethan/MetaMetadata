c_ohc=OCKafu8ZPZ8Q7kNvwGLFQhL&_nc_oc=Adp7K3xoifCYDh7Cr31ePxC-Sujw1gN7wJV1PeuoOOvBTDNU8Q_e3q0h0gikru9XD2o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V2CDKOiEFFzo3lfWGe1IiGtBmNgDb2av3TmzRKgjJHw&oe=6A11A034"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXVMthvaZ7MQ7kNvwGYuQvL&_nc_oc=Adpn1XoeUhaT9GIJyTz7rMIBnrxGWE7WAGeoBg3oOKLWVrbK2hQHzVC_opOErBUtUMg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yIxNjad2WKtvkCYWT5_4O9tkB4sopPvNz2ZFktD4zBg&oe=6A11BE1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Xrijw96JIQ7kNvwFg9PIk&_nc_oc=Adqy3ENo15o4yliGm4PUP8c5hHM4Bnlgpd70WiJqzvZH48azzMhDnaXNUC9strDKPTY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Kf_JPlKPFHZmBGmhzJLDFcKcmmZ7724G0lZrLqAHGQ&oe=6A11CBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2IHjLLRluAQ7kNvwFZqwD1&_nc_oc=Adrdqfetams0aGQvKPIsEttK0JqF9HO2g2lkEIXAO4nC3b9Gs1Y1oHhPBNlKXENzIGs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af645BvEf_3Yiob8pzwYZG72wgiawYeu5bLySNQB3-TguA&oe=6A11C5F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYEA1s7bacoQ7kNvwGrRQZj&_nc_oc=Adq1hGwk45V_aRMMwOgrHaVnw8ckwSanif9HPxqI8jsmJyCxGobf_iBhVqVcHuJxeP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-WlCADmN0sRGNrxFmWGW3OqO797k_LIheX1cGnRv2Cw&oe=6A119D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMAMRUdp6GAQ7kNvwFTeUjV&_nc_oc=AdrQZPz2crYYo4O8ICEqlGlNV9wBmiK1iubH5PwyTLshWJP3Nny1QJKqo70DNX5oI
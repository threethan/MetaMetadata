&_nc_ohc=ANyekSAG36QQ7kNvwHmNFEJ&_nc_oc=AdryBiBvadJ6H9yahAu1ExzD2BhylaeBJxTaj0YlVAG7yjFRsAnBOyv9AnDfGSen8tA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzsniK6STP9Ww6oq2UlYOaEP6aMbYGbWHX1YlooCXyJw&oe=6A8EDEB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ST8VPfz3RsQ7kNvwGv05gn&_nc_oc=AdrbPxq2qdR3xsVzYeMK1n1oHbwfnItcLoloKnn3LdMRxow-gM3JG0VGKs7Mc-CpNQI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWa-NVQaL4kxj30xT8CVly38ZMtbKIJcJOV0S6vjh8vg&oe=6A8EC45F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIPWC-UlcrsQ7kNvwGCfhXY&_nc_oc=AdqkffbcFTsXTwRFRDZFiliqygZ9yHOdUWbnU65LwpLozPssmDH6eJq1Y2NmjMeaxb0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ4f5jt5X_zGFMCq67D9clnyp2A9S7pfAU28phLuXGwg&oe=6A8ED224"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwEhMwPt&_nc_oc=AdoI3ap6HByUicjbE2dA4lLQ-y84HrG222CcAa0O_KK-nyT4iNq948zjKHS1Dm314vQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKX86nZs_lcK_suln4UgM7vLSRKFkbD0T1d_cuIEK0RA&oe=6A8ECC37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9cTJRHPcEkQ7kNvwGOq_ck&_nc_oc=AdqjQ1I5ucjrsjjlETkKcWXpv8z_P4vTHMNrW_Ca5fOEIOa0N7I4QKW0IsSRt2uV37I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaDvQkudzNSycXdY-rf10oxj2HHXbxfKphjZncSobT9w&oe=6A8EDBDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwE-_QUh&_nc_oc=Adp6Aroh_Fd6HTZnTA2ybdRmAUlijLHog52DWltP0isclC06KfYp9UHnghrwU
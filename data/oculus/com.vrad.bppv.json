c_ohc=N3JPYCrnSe8Q7kNvwEobgfs&_nc_oc=AdrIl1oc7os5qTjn8vPkI1lYU3aUIs-hL6Y0YcNzbgrbvq3OEfjLeO7qS-bKSWsB3-s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ce7WoRS33_7aYOhJNhgvPeEoXCl2w6fqjUiP41KaS_A&oe=6A465C34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLMp30uBYScQ7kNvwHLJXXm&_nc_oc=AdqMuKL3qMPCAysY6rIDep0gd_iTPaAZEEP5IsSUf6FXcV0FlR_t2vXgC58bzifOmG0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c_nhCEnitLfdQqy5_-6b7Qmi0Tpl_HbvDg9QrM1wxfg&oe=6A467A1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AShThlWBdK4Q7kNvwGrxKDS&_nc_oc=AdqCkVHz6OKf4JaBam25OOVyPY07BRWFc1e9JPrwFc3MCVkdX2VCePMbega6yf-8Fj4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KqJOPTp6-HcS7Tc0UHtFK9b1ugXTFFoHP8fMAgBF2Ng&oe=6A4687E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WSp5Gbb098Q7kNvwER7w4l&_nc_oc=Adq8Y0khnejgd71Fg_pYi4JECjku063q8zNeoval1QIYn0muI_W_6lOjMNjOCXsDMXs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QaDCXypQKvAskvkhdkMzWSPFd0T2J-1QPP5PUwT3J8w&oe=6A4681F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsM3GtNG0jYQ7kNvwER_ujR&_nc_oc=AdqLhOI78ZqE6HOz_RMtawkqMbZK4JuGbZ3ykLi5yC20XOmxfeFIfhZyoWyJP5j_FRs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nJDbPYr8phII9xpDXrrDM7KSp1hQwBbbVpOqZxJkFLw&oe=6A46595C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo8PChMcUyMQ7kNvwFH8OBO&_nc_oc=AdoyMSne0q7WLBNxKwm7PyqeXEQyh77mBZZK6T6qmXwzjIvuRZadajl8H5z8jDJNr
_oc=Adq0RkJHgEzb3U6dlhJidmOZVNIM-dik9Q2JSyxm-iJ58emIjCNF22SSTIfgtBAVcuQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qq3TJluShhciuJTntuu67Ig-xbisaKXakEV2HMgneeQ&oe=6A2440E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwHroW4f&_nc_oc=Adr9890qalnCzTaXz74j0LnnvMCVMKTRPDw8KUxJnbK-EcRcY18B6QUbZNsk0M2G8Lw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EtpXHYrqH8Oci8_zbiWtK5vFPpT6ROpAJaxV3P7eDMQ&oe=6A243AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwGCDyT9&_nc_oc=Adq8YjvI985jU5D4PkWMsNGVHV5IkFIYCJpm1unaT3-ZiRz1L9qS-5Lmg823wid1k4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d8vCqmRN1aKkiYM4q0Um-dLaYOIE2ovt6KoVuIuYT0Q&oe=6A244A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwHqhkzz&_nc_oc=Ados9sh-GeIdeg6ltfC7t-9PozbrI5xfgaqzhbtTGMHEe26qS_nYfRHAywsKH_ro5b8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82qNrJsBO07ICgTSBYBdvYfzVEq8WlR5ARvx9FRrJRhA&oe=6A2446CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gySJ2hEjNzkQ7kNvwFbYPsA&_nc_oc=AdqmSqoS0YDefV2bxztqsn2S_8MzI7mULsWcxkHb0EnnPzUN5Qc19Ky5pBjQYsCQo4Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iXkvsL39kXxRobMgmGYNi68vwXTB9X3owh4xEP4g9Qw&oe=6A243A99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVQ3ei1Ybh4Q7kNvwEX8tfH&_nc_oc=AdptFCoBCmS67a2ajNujV6WVwgXgiEQy
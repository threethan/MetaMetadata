_oc=Adpc8fqEO-QGpHpH0mJGj_PvW2oqZgZqJfG-MXQHTBeor4I4mrrHQSzrlxOm4ie096c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0bH5Ar5CkeZ6_YiOxbxqsDuKEbtbk6UxXYtJ995BWOA&oe=6ACE5264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpz3B0EsCPIQ7kNvwGf2I42&_nc_oc=AdqvAkiUv-jw59KrlArup1ysF_vcWuDqDJn6UImn6aWw5PPOG9rwHm1ZPSS9Z4eSSCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUiNA3_S3_L-Jpzdm93SjUaTtQnldWWoR3zIL6vnsOvw&oe=6ACE4C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0akeJLmcmUQ7kNvwHFdXCy&_nc_oc=AdrSRSLzGPL9GWQdBqrXH9mzduPGl9n04qisSo9BhMagTz86cU8vBlNLyKPYC0OXesE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDtN4vKgFhDIc5GkORDSZCoit6Mkj8Oi4r-vjI65DyaQ&oe=6ACE5C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j_z7qXttUYQ7kNvwH4dMo4&_nc_oc=AdotOzvUFmCMJfh4cJguG2Mcnzej0oIIQ7_-pxN97fOQUg_ZZGrY943g5pRty65skGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_o4S2fV_psr21g6IRaH4-SKU5mlxmaJ1wNbYlCtOrHg&oe=6ACE584A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyURXxFzat8Q7kNvwHWE3Qk&_nc_oc=AdrfKX_oWbHgK-sEoQdethQrE2c7J6ggh_Yusx34UtUlyQuTnL47FN0Mv4n1Dlhus_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdK0kP5V0Q9KCu5qPOfUBDgBiecWRCFcA-jEH6X_JXNQ&oe=6ACE4C19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqaWDeY8DSkQ7kNvwFh6O6C&_nc_oc=AdrDXheudozKivkzlSoIHAEOY5lq3HbG
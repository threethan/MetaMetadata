j&_nc_oc=AdmbXC4xwxigJ9p93lROjWEce1HhiRIc55AYKxdKG7cTF9Le4jjOpS-WziOQMX0P9uI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrePJoE2lmahGYFFcaJYiwqSziSlEXZ0pyZcop_2RO6Q&oe=69BD4034"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bUst5WrCYIQ7kNvwEZI-DO&_nc_oc=AdmBBVrmpYPQ9ygi9WOTsrM3J55Y1y6ka4CrXvCEFcGMy1FjrmQK2FLXW-ND8r4cL9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzglHOITljaBgKfu1c2J_bzfk74m-lK82kP3oyY1utKog&oe=69BD5E1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7ZN2KsejSQQ7kNvwHMoymX&_nc_oc=AdmudZr9RABkO1K3TrmZWqMlbEATZH2TQFeEVIRKdTMSpxjyhGbbLBSfe43E5rypgRg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI0saAbZvKjjGyXiiB8OSPWY1ReXvEZ_5sdnQrFuoR9g&oe=69BD33A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXSQZCID6qIQ7kNvwFv9ufy&_nc_oc=Adn6VZ2uvVsqu3oXBIwT4Pm5vVQeY417Lzq5aPmHv_R4ks34My4goKaaIgmMgH8zN3Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUOtshiKfPPFoekLH5kYHzzgpBe5lLry5PPnnXApciSA&oe=69BD2DB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8qmnCp4RxMQ7kNvwFDL_ZP&_nc_oc=AdkOulIDbpQXecP8k6jO1cGy6AIffse89SNLRfxyfXTaQSisraMZ80HftF_NJARpKLQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXolPCxaD-pYZJhPifeFCXoCG74YGDgSkrkWOztBvoRA&oe=69BD3D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW1OZZARHGYQ7kNvwE67CaQ&_nc_oc=AdnL3rGZ05AtaQv3eIpnBZnFqs2W3WI7hUdLKrN3kYA2MjovqBj_yUGrAhS4BnU6TsE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc
c=g67msdxxeA8Q7kNvwFGj8s9&_nc_oc=AdpC42ie2TvNK5l1mxT25EHssy3i48w0s_V_OiJiTYXb1NHE9MJ_yJdnJeHeSqjnYB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vtKK--GZFhtIDbKcKiiMoKXhJawmr_JaJhQRpgXowbw&oe=6A2AACB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKVz45Ry0x8Q7kNvwEOG5o4&_nc_oc=Adq9bSKJN1Ny0F20BxwDowTINwqGSmcjH1wGN0noy9fv-Xi0zEcDaO1gRsD3UOGh_G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aOmtM3GD1hugltD8-x4ml9u_mY5g_Xbxxry4IJ68rHw&oe=6A2ACA9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaSojlWXH6YQ7kNvwF_Xdvj&_nc_oc=AdpyEA8dw9vm0WXRyWermskciYnKZKLtI6nnyR9p1FRh9wv9wlqWiMM7aJOyHhdLIqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VO6TYUjuR4WM0TalYgIDSnZOmR27nBjQ6rTSUzm_khg&oe=6A2AD864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IqOvBRHNywQ7kNvwEfm8qK&_nc_oc=Adp1mt_6yyQ5Bgrm8fnCeGROCsTrMKjZFWu48dFui6pyfI-bUoaMDq4aoitsh2DyicA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MzVp__cKA0IT0EGmyYtMUuWBGXTx-SSIJ9NBFn0z6fQ&oe=6A2AD277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwGRZpCY&_nc_oc=AdppV4Xj9KceScFbAAPQD8Aon5kSArN1nKX-PEbl3YoUNV2nBA5_Ua3e4Y88AMRyaEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ng8iCzHwTWWY7oe88vmBoQJLwu6UWw2xXbf1w25oP3A&oe=6A2AE21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5OhPQyHOhAQ7kNvwElOOw_&_nc_oc=AdokFCngF7gHRu1EmENOdimPVj5R85YT34LwUYub3_vs1Pf8WugOJ0vu97OKYimjW-0&_nc_z
c=HSjIlAdddG0Q7kNvwGFMYgB&_nc_oc=AdpaiwAOYK2fw2Y_tNSP-ij8WzpprrS_AkoqQbFADvOCkA5wMW86z1fQ4E4hMf0mQ-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2YnKr2R8eQt0g6wfiGqeWtRwpjOcci3-Y71O02Krk4Q&oe=6A7B1834"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qp8udhy0O4Q7kNvwHm-EZ8&_nc_oc=AdoxeuVNZGzFAM_iMi6tV6sW9L_nnxle5TOeWSrL8nkAv6zcUfUQqq6dfpPV_PJffVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZBJ0JAkI1Mc43z-JWppUVSFHHx2BggvVsG-khtasf0Q&oe=6A7B361F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2seiPH3V64Q7kNvwHTwntw&_nc_oc=AdpDQtIh4-YKcGobcectsicOtgidoAG_4ZEA9_VXSsOG-kn_gXd17AuOf76WmWmopT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6xuLugT01r2hWqTCEBsPod5Imx22bLbmurSJdE_HuNw&oe=6A7B0BA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpR-Z-CuPTgQ7kNvwFJASbj&_nc_oc=Adphc7mkkpo08an882-0UvCwyggfPlvQYeZKE6P9YcWGIzj-pJYjMVHI0OeRwouEEBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjUPBQzd3RZkGYxgflEjNbbhnSqPcH9D4vQP0GPmZmag&oe=6A7B05B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVArtsPuNQEQ7kNvwEaomlP&_nc_oc=AdpUFSuYgcd_6YU2Dq3It-w8iOpREYrJiGx09h3gJtgLb1EOpCwogVLWghT2oM5lqH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9ztqwkxBGMU4-lvEgmD5sTdP4MqotiBJPJEjuBG-OgA&oe=6A7B155C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C08x0YTKASMQ7kNvwH41lWt&_nc_oc=AdoBKMoG1gNRJhL7n8Xbp5FEt-ntlWtQ8XM1XSbi5EXQt-kVovcsFL2Rv6GNMIbpnSY&_nc_z
&_nc_ohc=a4PDBLmNaF8Q7kNvwEm21Bv&_nc_oc=Adqj1l4C1sLB3xFAjRI7sYievk7aqbAod4dRuXwk_xbDEhN44IC4vmM0cLUO6zCm5Ac&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeNdj4eGV3pvhFEU0CWAKGRSFXD_jlrLYNyfjtc6zUKw&oe=6A85A434"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WHpSNH-buEQ7kNvwFDuJeb&_nc_oc=AdoK2wr9-eJWvd_Ym9AXhUKLgOPvcgCMuZIrzLe-XVC5MNhASh9SxjNPQOKP6F7aKyQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETBvm3VKVcQ4RwG1cwDKgRTIzA7sd5H7P1UaqBRN3Rkw&oe=6A8589DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJo2-f7E2AIQ7kNvwHcddlT&_nc_oc=AdrAGuZYwd3brnqF06o-LgdQ945LT_BbaE6bWwljI8nvpH5UJD8KLsWFKp2Nb58gIb0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdMcrmO1rhbz42lEYSKPnMh7pJSVC09hv3uRESXMQaeA&oe=6A8597A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNruwh7jyuYQ7kNvwHt_oQn&_nc_oc=AdoVmGcRIz3aYfraW7WV5L9DuYWGHUnQFzKTUkewWfxuz-BvZQ9CmnENBniCz-0WkJQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSQk9nkvvJbM-X3WhCHUqWxtivQ-833Bx-R9iHAX461w&oe=6A8591B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzei1cKHQpUQ7kNvwF7wMDd&_nc_oc=AdrazmOiiTLbFkq2Lk9M-5x9fjhyJIsG64qD2Gqp52TDLYbkOsL-oS7PwDv0B_Uwu2A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCddvItu_toFEtnVV5xCPzjtWOrun0oVbBXnSklLgiJA&oe=6A85A15C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIgwoYgJeFQQ7kNvwFQ5lmV&_nc_oc=AdrcxJ8nwghm60vQOPY-9azMNM-CnraohpMKSjx87CtWZe3GJzhp22arPC1We
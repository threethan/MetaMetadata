=8&oh=00_Afw1z3An_f0FTPuLe7JCN9SA4kRLdi-UuPRLjFPda8kH-g&oe=69BE8524"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCUD7Za9QBYQ7kNvwHz9qj6&_nc_oc=AdlhIshkATxBF1VB5lvZxcTfRcRPftR1LTPBt8DR2sfkEX0yHs7kvJy0tgWMfiG9JGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5QdrezsuKQgMMKC9GdI9JZDwDPVBnTUm5Cr1zWbTTQQ&oe=69BE7F37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8qmnCp4RxMQ7kNvwECzFeo&_nc_oc=AdnGsYRg_iwh6HMAMirU9eTgvecb_PVg8LMjIJVFMuYSS76LWNay9x4SgmLXGN4qfe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypURGjJVCufX2MLJ2136snZG0AEvjTeXRXHk5UXZrNTg&oe=69BE8EDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__dyip4zrnoQ7kNvwHB5Du9&_nc_oc=Adk04DXdN9_wORwPA-VGfGENezc9aIDeEWxwCb-pWDxAAZulPNSX--dj-va_fZL2Yts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5GuXuh-7Sk8pJMnDuWUszs0zOkfePmcUDioTnfBF95A&oe=69BE8B0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS8terNdH9EQ7kNvwGnExZh&_nc_oc=AdmHXbQ0ErChPjhp7xiXggNXt_hWKjITX_kp82XRrh7ttwc0w5LNcSdgCxj1qGF-qUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6IaQl_hzI4NmjAqPK-ryaVYR0NM6kHO4dSL54i-j34A&oe=69BE7ED9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Liz2NyolYucQ7kNvwG_-qyf&_nc_oc=AdlUkyNkl2QOUDJ4tEc-ikZk4Ux4Pl9U1IXWX4wA3vgC0Cksovu9LKotOaOywMiG_iQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsYEu1SR_K1a80h7yClkbdcg3raPOLsAgoQ06aWEWk3w&
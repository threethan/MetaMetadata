c=ikGrbqtsK0kQ7kNvwE1tASh&_nc_oc=Ado0WeJ4c6whjzIM9AjJNm-V3miWhgky3F-yr-EXzr07mP0_-b1wqSajrCVubPHV93I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsiELWf9c80LfMKj_ZcIpaOs6nGQcyo14G4WRkGcHJ5Q&oe=6AC12FF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JB71gZCOzO4Q7kNvwFlakft&_nc_oc=Adp_18ISRPeJQMbYFvNCXxOc2r_x0CeTuuh1fze_srUJL2Wl2UEul2oDBvC56CuMsBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA9IYlpuBbALuJqUCxJt6-gxcvDD8ZvnZSblCR3ccOiQ&oe=6AC1159F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MR7-hsFZvkQ7kNvwE7xdnv&_nc_oc=Adol3Nl71ftgpsF6cd_umspsOHvA-E2sT6GaEX2HTaQ2fejJiG7s3b3gcKTDYq__wr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXIABuHxLwfi-kv4YOorPRpJoOQr7SOExBHrI4gFaUOw&oe=6AC12364"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNtYe5n_XZMQ7kNvwF32ps8&_nc_oc=AdqtQFM573Wstf72lZFtSo9MhbnHk0SBFKbyr1LuK-JvVdNfuSqA4nZ-FPcc1zL00rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Hfxm3dD2v5_9hr0zPVFvo7i3QzHnXU3Obz13FI-uTA&oe=6AC11D77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aB4rZvTOt0Q7kNvwHsmBZT&_nc_oc=AdqaQAwX0GSdmBK-8vGwO2ZD9jQgx-hEAdkfGhD2bVfh6c-HmIL_qyNIPK8dRn3lvYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBhgo_wJw6geINQ2FgwYdiMWse_s7WWt9pRG4bKoggdg&oe=6AC12D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmiCJW2gFtsQ7kNvwEVbwIT&_nc_oc=Adq5GDJXABZX0puAuS_uHYprRGq7Wv870ynyFlfPnyt7B4_LJzq-ak5P6ngKltvsBjA&_nc_z
_oc=Ado3oQG9R70gu8GdlQAlHPGbU7_rLe6G2zODRtAZ-cCX46QHd41PCimV2L1DW-Ofu-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QbXdihxOH3XUuf8YkdRxIsAcoXyu20dNbnGpZri9o_A&oe=69D64024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJa5yOdHdYgQ7kNvwGoYNGA&_nc_oc=AdpaUwafVKIx5iSPw-YA0Ps9q7zd2rtVbE7RJcOjJIU8Pq1jw7oIKgoIozAZBEITpD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2unBy2aOureYkuOriytZWGl1rVKVs_q99USjRrVnw6ow&oe=69D63A37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxN07OcCSZUQ7kNvwEbZHXZ&_nc_oc=AdqldUpSzLG_wPfhSFSwAhPVl9bHctumE0h3SSNPe9Hb0xl51XVUCnol34BArCmg5O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cAJdPYXQ-9s48upT5Taq07mPzxkMiw7lH_CPQIukhVg&oe=69D649DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opsUnyiVrcQ7kNvwEsgpwl&_nc_oc=Adrr2y8Oo2GXNg_8XytOP3rSFsZNdYD-tplQV5cVVVxvs3LsplE4ziBJXgCkFIwVLPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VLTKWsVqzkxIRMLA8HQPcQGVoLjbuGZwaOYJZhYnK6Q&oe=69D6460A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cbi9XRIbUsQ7kNvwGl4XR4&_nc_oc=AdoA-QQvDbZjDuk8WGhlkhwXNFXe4mFYFc97ogFcMSwPhgReZ1bSq4hXcqsA9OSfTUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_jR2zXFIU6tBWNfBun0QGoVDAJIT_PncCTCUB0I4TnA&oe=69D639D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2wZDjiAmioQ7kNvwHqAmJQ&_nc_oc=AdqJaWr-i83WIOWmzBCB93pYi5y9qTRf
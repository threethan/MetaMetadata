_oc=AdorPsSHuHiJgA0Hk7ZsIY4t2KyvZr6A-Z4LSYubfNsvtb1aCxD0yx6_qNfBBoAv7yI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QNL_i-bJWzOvhiEfJF29qLgxLx2NSFnEBD7NQ9tuKGg&oe=6A283564"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RqwDtCg6WgQ7kNvwFqMTkl&_nc_oc=Adq5PLFNBWPTv0kvvpiv3x2dNHV7sZeYHOQ6gELPgoiep0yoEy3_N5yieLW9LOhcDUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ozw5pOhNVecjYnWJ6xh-2j50wIHUNSPHXDRrqqmvYmA&oe=6A282F77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ8pvLL5MeIQ7kNvwGpGQvs&_nc_oc=Adp8rQBWD4g4YF9BQqigEkdDaTVfXF2CNhD-knZxojV_L6FAYielw8CwowcYjn51nBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pDQ9QtKTqd5MrkdmRxhVo0V_hs-IpejxBJOhYoEunKA&oe=6A2806DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3ZDzAO57MQ7kNvwHV-RKi&_nc_oc=AdrA2vGzScjaPV0W4pjc1tCdaRPLwdl3cKj9jTtR_A5tzDX8i2GptAuPw4wEWWIg2SA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kDZgRA6P8YhufbE8HK554b3kCpA3Q9ZfQY8qubE1cKQ&oe=6A283B4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoJo4VZBIJcQ7kNvwG976up&_nc_oc=AdrBVpc9C-2ssmVgkhssLGYrCprNTh9saflKOMLVJZR59_hbfJDgQe0dh5b1tdSemt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HC9YS_lSJi6DrJGJTZGn3V-aj5GEBMs1LJYFeM9-fAg&oe=6A282F19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb0yKzdrw8sQ7kNvwH1lWcg&_nc_oc=Ado4O9t6UBF8IQtuRkchXAjB2r0-Wi4J
c=D-7DlFG4LeoQ7kNvwHBVo6_&_nc_oc=AdqfahdKJzqHb2pHNaZVCOVJX1sLKff5BbjZUNPAv9af68yVfTc_Y-mViIOQbEb8mG4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Od32wbFl2qK5ACe42Rtul3GN5gI_qOvKj-mE65-RRJw&oe=69E61EB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK96DkQKDaAQ7kNvwHcq7b-&_nc_oc=AdpGd-QtwjFWy-3XZChBsgxvnuQdIGqpGYKVXHa9weVCjeoW1qz2vcK3ynn70KFUsUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zWWVpqSRZW4WhHoaK0pu8HtvYnuuik_V6_ePxWESHTg&oe=69E63C9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVbUOdv54EMQ7kNvwEtSk_z&_nc_oc=AdpSmaCSsDEJ1ojO9sO8NxdlUewnfY19ldRMqQ7V4rjMcc5JGGUO75CaJB_Xurb3q3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Kd_-4xjEG_8jx-dQ-PTN0FHJoZYbTWd8p5fhgfguudg&oe=69E61224"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8IovrZP1F0Q7kNvwG-0LTH&_nc_oc=AdrrWhDyWWsM3Tb-p80tYRI7j5caKjYRsBzT8Eto7eLp1WffwoYw54hxn9-CxM3A--I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af239lmwsd1bw4y8cN0TcmKTkhAkC-j1_qDy9JeqRjhTRQ&oe=69E64477"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gtHMNDsIOkQ7kNvwE8cbhV&_nc_oc=AdoKv5B-Sv90SOfgzAMRIe3Z8m2LfYWkOkmCeWHYeOqVQGSVwzXOZamRVbPY-bKMvuI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ElmSBWompzCbY2LUZwjfzOCRnOV493P-Xm0NYm7cBQ&oe=69E61BDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6N5p72j_agQ7kNvwFfKM-a&_nc_oc=AdqsX2DVpv8KXCjgz6b6dsvn4LGNF-xc2rVM1vvCT_3am-yp1xgc5rgWlCbRQ_dzM9w&_nc_z
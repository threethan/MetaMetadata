c=INdQ9Haz-7MQ7kNvwEzpdtS&_nc_oc=AdrrtIZBw5z3hz6tuHW5laCT2Ge1Mxe3JkUg3KGCrezIFSxglwNwh2hYijMZ6uUFgTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAxWB894oxJRibmjlsLWLUEANsnTWuuAkeCfx6CXlWzQ&oe=6ADDF8B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE92P83LNNAQ7kNvwG9KPDI&_nc_oc=AdolDdh00hoBjfnTWR0YzzjpRr7di3pR66z8PYW0I9M2NViBSTtTFQe0-hz6hc4WPyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyCPsJMmue5x2yZp6B9kp3BMf5L-J7lwpLBFPgJMJvBA&oe=6ADE169F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cy_0fIwAUIQ7kNvwENRNAi&_nc_oc=AdrZhV1iZ-husCtwZCBEkExxH0Wtfp8WfmEPV-VrJwra9o-2d-pFKnT8yxakfP5PakI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMztGrB0qEqVPcmFZeZIe0-1rX17L6p-sN6bbcoZ5K-CA&oe=6ADE2464"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKw5kVfxiUcQ7kNvwFXAb1y&_nc_oc=AdqrF-Bs50zp7hu-w7JlL0JJHuiV5letWbfrlGu3QyM-HAavZ-oLKft9mYxO-yf5LUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_sSkMewxUlMEc6tFDeQoaQAj_lSk-7vOJVbO1M0pMOQ&oe=6ADE1E77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnPVbNqoL9wQ7kNvwH78X-L&_nc_oc=AdoGAO5Az-vXddK-9oi48W-mK4RFtlZtCukwDMq09dtFs87wIHY8v-5vAPgCO21NAIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Ze9lK3U8QuvNlC_HHF-1YLpqF8rSDVoOUA6vwX7WoQ&oe=6ADDF5DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6htGFPeHM68Q7kNvwFjxgAp&_nc_oc=AdpASRqX3j7pmD98MCW7kso9RaYUc9I0HdLG95cEGkhxGfFkfqQUaUcGZuOeqa7ge7U&_nc_z
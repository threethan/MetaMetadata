c=HSjIlAdddG0Q7kNvwGwCd-5&_nc_oc=AdpEo_n0k2HmUzmaYh7x3zuiFJ3ZWP-wOGD14CgNN8A-7drCAXwonfY74_4RqpocEwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbdC4wFfvaezz6P1akBrYNcnfxuUk4zir2s6o38-tF5Q&oe=6A787534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icPy4IO1BKkQ7kNvwG2BJeK&_nc_oc=AdpAG0ba5TLM7l5qtHYqBsHbzvJlkk4uRaYEnCQIx4G-p3AV6iTouQP41ZSW2dse-tk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-iRHUmPGnFVFNETx75EzCF2FjqmKtyITPpxbAUjW_5w&oe=6A78931F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL3-oxZ1ag0Q7kNvwGK4ge4&_nc_oc=AdoQLSQARymYVFW6nU6pS1gjReIoruKGf2XrwcPiWDCn5FxCj3Ty_5kHBNahhvF3WRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGEZDNYZoLMWzE1xwgSFp1k2Xrm6tSbGUiXqBG11glKA&oe=6A7868A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpR-Z-CuPTgQ7kNvwHOd5bh&_nc_oc=Adrwe2XmN3162bpA_MiiSpG5Ahm29lypQctJD5eQCFY4AFEt5i3jFUl4OtxqGwY8ozs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQcGB6egUSXF0C5JK6z9h7bt180yrEONpQ0VVoXfDxUQ&oe=6A789AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y5pV83MQUUQ7kNvwFC2Nvw&_nc_oc=AdoXQsyb689EiYs93vtfxGx_SS7OMdlkrNn3lEv9ZuSMdHNGCF7q0iyI6vYp-BzuZ0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgha0HUv7MN92428mNivU-O82qQWXVOB8xPrvC27ewvA&oe=6A78725C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C08x0YTKASMQ7kNvwFmP5tY&_nc_oc=AdqGQk9opU9_OgoI5uCejdibXym4CEjzjtuk-AXqU6BiEWksa4oFy2wmA9-FimAqbdk&_nc_z
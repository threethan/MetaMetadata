c=BgREpst6jkAQ7kNvwEH9UWH&_nc_oc=Adp7RrCzQ5ItgUYQ9G7HP8K-zwvlMX9IHD4VT2Z9uM9aukzJRsk-tzkuM9usWo45VZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgMwhZ5uLV9zNab4Ag32IYnRtrJzKczAwG2YhIfm5GQw&oe=69C91DB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2Y8X5htL7sQ7kNvwGPasBp&_nc_oc=Ado7Pbg3TGTPnQiOSj2knXm2qKUidfrFjY8NAuVAPB-wMqiXrWZ2YVOwg0ruyGcPBm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtdkXqbTEBrjvZxEx0OM3PECBpXdpD7YEMgr9tZHcmRQ&oe=69C9035F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeqsrPEU6FUQ7kNvwGxwZSh&_nc_oc=AdqiF3flYN2TlTU1CXeLVgcTF_2hUFsZY3Vg7LOrFpyetHMFn9_9QxZP3Jf3986k2zk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afye21Q6F-dAdfBmu9BB7GAYIdAUYzyI-5IyYQrq_Ui5CA&oe=69C91124"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z-QO5fEDs8Q7kNvwGC5ei9&_nc_oc=Ado3jMq1-7vqGi9UATuOekAgD2vTePaAXNERH2SZabf6pEnSFKxXHsPlQF0KQl7g3so&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybOEkrQ3eE38KwZqrN67RF84jo7kKCC0lOxb2XxEh78g&oe=69C90B37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4svPFkM3kkQ7kNvwEL-PZf&_nc_oc=Adqvk7WCdaZZkMPlQEGmG2tYgjNrdIT8sM3cJp2lEgfn1tGaqPL5vX5jLxDSpr6YP7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyopCYZjOuca23MvdGIloUEbsArT4Cd5aLjumgE9QOtDQ&oe=69C91ADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dnT6V-0zBkQ7kNvwHNjV55&_nc_oc=AdpPSSLiQ7iv-W54n-XI4-J2hENTUeaZYEylQo2-B3RbnH7nwDrVFqPwbps3NlXyO0g&_nc_z
_oc=AdrAaLggRHZ4ZYSH5kOPqhSyK1pcAEqhGIonFlVUxenKXy7czb20HeAj0ga4YB9_0go&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6JJjWd8EQ812QlCLfSC59qiCcscusXuvGspGQoIAlZw&oe=69C7BFA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z-QO5fEDs8Q7kNvwGLo1NR&_nc_oc=AdrCcraV9vpMJTv0DP-UG7Cc9NZiigptE1MJwaQAfgZ_1gfEPMnCeelsCA_sfF__IoI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxWacYQAjJ4dm91GsWxyWlL0_f6H9o287rUKoqz_LOUQ&oe=69C7B9B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4svPFkM3kkQ7kNvwHbiwci&_nc_oc=AdpTrTQCqwwWiVoLk-Nou0LRA9RfQEnSQeuRs_MAQP1SA79TZ5zMj3qAXR8a6a2R7Bc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygAk_iL1yyDe9w8TG4zPzJueGFsNZxLt38nNdsMXiGAg&oe=69C7C95C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dnT6V-0zBkQ7kNvwFltT0D&_nc_oc=Adr7MnuvUmaMwYDOF05Y87LILC6AcSuQJQnQr1DF9_UtZSoVsaFH14Ff1TQ_UXAFBbo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwa5XiwYDcsS6b3tUcl5-erUXMV42FUyxKCqqRKPj-jHQ&oe=69C7C58A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv0E9KiFk0YQ7kNvwGXxEkC&_nc_oc=AdrWy4om_XAjilAXKP7FTH7zkUbiR1k5zEneedxeAcT68yAJ8_Eyj92zd8Iesim-xo8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2u90YxbHrtW44ueqcf4TsM7SHroRl5sh19W6H6N5Gcw&oe=69C7B959"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmFNvBurAJYQ7kNvwH-X_8E&_nc_oc=AdqRbfWUfIMk94tSmRalGwHx-n9FscAq
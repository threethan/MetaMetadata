c=8EbMpDIHRS0Q7kNvwHtffxB&_nc_oc=AdpHZyHovAldPsuJjPFY6Ihp9d5-1ecMMPQaJ8P0AnLVIVKTcQpvYQIpuWzNSAOSiuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMqDUgkuD8KoOK1lYcjuAts5w2P9MFaQuOdwPX0GmW4g&oe=6A4A50B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbLWVjobBRMQ7kNvwGbiC3K&_nc_oc=Adr5MgpZnCXMtZz-F1nPwpwlqiGUXHj25WBhNeRX4PKm-XGjbMm7PR3ImPSmgJ1m4G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4aNSfIz7RA0LIYsaJznqGKUFYy0O3BiFeeeISOUHjig&oe=6A4A6E9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCm9sOT3QXMQ7kNvwFYFOwp&_nc_oc=AdrK_D8Ee7hKwc-i0jCv2Q0FlGT0OxJnoohvthSWgVazcLF37T6E-9hhn3mFxWjhgso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5040S0uTjraaUNbTo6O13k2TGFT2bluNvlGyg4VOd4Q&oe=6A4A7C64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFdHuyGQpvMQ7kNvwF0mrlf&_nc_oc=AdpJCq1kaIScnS24pLoQY8sYbg0OmseRXAg7IvZZVB6f-0hXh2G7tH5KGW9w5rwzkRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1v-KDf56i7nkbYKfzc1NNShGqateSekTyId6tqLcD3w&oe=6A4A7677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih5KjP3fQBYQ7kNvwHFSSrX&_nc_oc=AdqpNo08YmL7alqQnRUhv1O8YfmCuSTomyfSeodsTgl6unZ6-cFRM0WjGCt9pfygR44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8AR0yvIuEFnzKGEkAxPIdRp2JjnUq6VMbcf3wrt2jAA&oe=6A4A4DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq6hUrJYv6kQ7kNvwEi20kD&_nc_oc=AdpfCG0Dad3v8gYY4uZmj2VOX4WsvsW2c4MaZAuo0jw6tOjfr8efMsKHBEsaLxqzcgQ&_nc_z
_nc_ohc=CGKNqX7RnkwQ7kNvwE-hzXe&_nc_oc=AdnONM90UkftkYKABQecTwG5fg26vQcqgeDOM_tKVm5n-DZqHQIzIsT3HV0UDg-l58I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZXiHcFlxlhFggWLyaeD-iiz6ljCtJzOcIutlJZx7uJQ&oe=699D89B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwsT65fKpmMQ7kNvwEywOoO&_nc_oc=AdnmGzPw1Z5255KDpQh9ISqG1uHIO66iTd0lOyliCRTcka1b6_mNun2mpCi5P-wdZ-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-L92E0_Ih3r-cA3fRLVSgFZms0sF7kKUcF8FM40aPbA&oe=699D995C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt6OI6EWZPMQ7kNvwG2-_IC&_nc_oc=AdnqwDSEUS5DwDIPAGs9hDNy1gPpobLfFMlKSYk0HGSllTpjJaqme7CyTJcRw-EUXj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxQpD0IJCSiBXCMtJsJ-IcDA8LSz-9GyzvNiMQvntYTw&oe=699D958A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1GZ6GjixH8Q7kNvwFm6O6d&_nc_oc=Adn0prrZz7Qt0k8iubBQu8hU7doXnefXHkz93w2DMvyuIpn6QmgWDK6XPPz-fJqSvOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOt_LV9kLQfaTuFsIbANs37L7l54GikW1umnLHxVSVGw&oe=699D8959"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHxf4208ysQ7kNvwEhwsPZ&_nc_oc=Adn6kMhW1tD1q4GkvCvQwQlhSNDqUL3YwlbxjMOP_uSyJpwvmucjKS5Ch8N6Pk8EWJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftT0TNhcMZbXwdM4h63_gkDOleDClVegeTxT02AyuDpZQ&oe=699DA753"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhOzGwn5lf4Q7kNvwGSn_89&_nc_oc=Adm7cAh1RDVzXA7NTfA_hKwHowUMFRegJlcDCcJq8
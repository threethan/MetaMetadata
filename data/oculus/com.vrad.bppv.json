ccynrR2AWOfnc5wNMsnqls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuSHTJw6fJwyJLMME6h6w1d4Mq1aXnnkxXpJRZrEH8ehg&oe=69985634"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcfz2ky14tIQ7kNvwGEHamz&_nc_oc=AdmPWiL7fhlqB18qIFeS_8i0P4EK0_Fit9DtiHmYH_CZz53bCw4hsdA-190pvZfOzKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftGnf2fGejbWnhHxWTvhl9NQyGZdz9IXkx5oZCn7sYALA&oe=69983BDF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A2VVCL5JfcQ7kNvwGTVgUT&_nc_oc=AdklpYx1ZbuEOKn2O4FdanmI4TRkW1joD2VdHDW3Zf44f0GrT7AuP4Ln2HP-jfm-af4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftTieR1LsT08Mr_I-yi9bFFubONaBJOyud1ei3Sf4E0lw&oe=699849A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gng09yKbjbkQ7kNvwHuzCxX&_nc_oc=AdlppPPFS4WVZMFQ3mWyXPhk_UDGSh3RmUHwfoVSG5M2nHOaHq8jU2irNSZGbz52bTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsAbXSEU2DTr85ldZJ46-b_vbrBwPho6RWvACTb0vmvNw&oe=699843B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VVurO6lcoYQ7kNvwHf4-Ru&_nc_oc=Adl9B8jDv6C-0SsbifSfHHNpuw26p5d6_eCRNEwnSJn4lmDT_Eb4PTRKrcz8Lr5SyHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvkn2MEyDQKtKq09MXuZXeMIQ4UY6j1Vp5l3GzX_yB9Xg&oe=6998535C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjtqCxxDVB8Q7kNvwEZDK6v&_nc_oc=Adm2q31tdGbNWsJm0JSwnJRefmBFjAXOX7-Zuai_vf_5yZ_Op_0e6FJWeCBXva3gCQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvRCrm9DEBC1UwnG-LUZdjtBsD20fAgcu-31x8ZVwvNUw&oe=69984F8A"}, {"file_name": "015.BPPV_Back \ubcf
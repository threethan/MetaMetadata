c_ss=7f30f&oh=00_AQRmWJB4fvx6BUHioOf4Fs98zMFElRE-czJUDxXkUX_keA&oe=6B0DA6F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfaDSpbqdKQQ7kNvwH_1qtd&_nc_oc=AdqRX-exzeEBh3ParZ1WxtKdBPC8fIC73qB1TNo0lQ5H7DcLpXdCGvHAOWAAbS6OeAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYX_trqbckHPLslU046lwavHed3QswzoBEl2CmdbnG5w&oe=6B0DC4DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBoLqlwLKrQQ7kNvwHF1IvJ&_nc_oc=Adq-sM5dXrESoHX4T46QDOwG4hYWm-FnVtu_WC96u1OnTDkbFOPEjndcsNz2Pdtn0eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5kq-XOPVUOKzPAYrm0wVlU3rVO8EHwLUm9mfMbULD6A&oe=6B0DD2A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_i8ofY-yvoQ7kNvwH0Gj9d&_nc_oc=AdrwutU-BQdaMYsx-Uzsyoo9kvQ2kWx3S1PklHSlOjyIbcUb7rNEJZrvD03GarP3QS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlvMEyybJaq-bqLdlyZ1XSNQrzag5WISGzatTvMV4E-g&oe=6B0DCCB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqVn_9KSLIYQ7kNvwF1BNSu&_nc_oc=AdpVfqkL7THeh-PMtn6Neo4mvynOn1d4QvP9_ScTYviYGGlJte3r08Mu3cUmVaZhptU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSe_3cYD_AUT9H26yCsrbUUdihHW1UUCEzhkcduNVDneQ&oe=6B0DA41C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97uXDN9cPgEQ7kNvwFUIFE2&_nc_oc=AdohfwHoW8Pr0Z4CN4_5tbrDVllieRi8FVh9FkEkdEjBp1McqMQKr1F7y0a7BrmzC-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShia1xdN3NUIy6g5Q72G2F-OBrrO6gc8uy2iVPwA6rjA&oe=6B0DA04A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU7SQYUw1osQ7kNvwFo1AMh&_nc_oc=AdrnsAz1BCePIttE2Wq6QWNJiku4MEx15cpIsE5rvVRtlabuaTxrSg8ohSpHLN8t7v0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSv9Jm5KbKGPirWAooP5MWR4xaOrndDgdPqual1Z2htCw&oe=6B0DCC59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVGG4spCGQQ7kNvwGM6LMN&_nc_oc=AdqLgGLwTX5h05DFXSgdv-_82RmcIXJi_dmF9l0rbMuxSuaAjNgHHtVAhdOi1CsNAeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFuP59uwO43RgB8-N2Bpxm9qu_V3PUAXc9DD26PuPCPw&oe=6B0DB213"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwKQBvEySNwQ7kNvwH8A_lV&_nc_oc=Adq6FoC85dFWwC0pXWJsurWzgFsw0yodrP4VdR5gm1Ovk_X4CfzJElB_OnzAVnjYrdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAlCvZfHv2IZLhMxFFmK-iAcz7cNFWcCbRII5KVremew&oe=6B0D9FD1"}, {"file_name": "005.BPPV_Square.png", "id": "1269871715156621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620346_1269871718489954_4811280509119093641_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKJYzqey1T8Q7kNvwH8TzkF&_nc_oc=Ado-lN0FnoQiqJg23EBZNI2_spOLRfVT-cbUWTKT4c-ZXQgNdxfaDpw4ajwY3Gz
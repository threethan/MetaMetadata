c=OqJ5JClt8FcQ7kNvwGTfxFI&_nc_oc=Adp6FYA5Ul7qHFtZaWLn88K8lJNIRrVzlI-QQnfv3HaIebMluDyFArIEXomjMYP7tTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GL9gBCsPqT9qVZN1Hn_3_Iijmn83zp8NjWAL81oqPdA&oe=69E37BB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK96DkQKDaAQ7kNvwEBedKW&_nc_oc=Adq0HCbEbJwh_xpAISuHCrBUPwj52rlLglcZhzygACNjBAYrCFKPRtw6MSmO_L05fB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vFD_faOfN-SGd7rqZY_ZPSA87v5Coqq21lfMMECxsKg&oe=69E3999F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVbUOdv54EMQ7kNvwHyYTJ6&_nc_oc=Adp78ZB0Pez6U8TUHRS3G50uV8JGP26RyOd4T4qSPLCCxTlTWHYLqpCfOLYhVu8xEYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q9f4U1OlViCfJ0JtXktU4Z9qxdwdKQXPYJkFsbtQDkg&oe=69E36F24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWE6uIlLUqwQ7kNvwG9Vj6o&_nc_oc=Adquw9Q-UBx5gzKS-7vW8B-0_RlKuBzFj2LQ2Ukzq7FQF5G2Hxx8swDJ789kL7tjx3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t7z1UkVf6TM4ezbDrTtQiNR2lwiLRG-qSjJRy0w9sWg&oe=69E36937"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gtHMNDsIOkQ7kNvwEsrmEx&_nc_oc=AdpazyQHYIOJm-NsXAl7K7cekhFt_1TzxBmdo41KxYwM3E1B2oHkbfoa8uYfztD3khE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06gEfw8VrgPgUG1rC6FCDksBwSjelByuqOjR2lsTjNng&oe=69E378DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq0WCJTnVJEQ7kNvwHRk6tt&_nc_oc=AdrnBoo_EQqiTmKgB7Ov7z-ZMVvH9l5X6WlFVenNdF91XpydSZJs-7VRhNY2Qhr5JTU&_nc_z
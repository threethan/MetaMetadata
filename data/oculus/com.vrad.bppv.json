c=e68GCHL0LKkQ7kNvwHQch1r&_nc_oc=AdqXkrC7uY-HYdYFpsaLYziN9D0PdrUy0bHvF8Ja1cUyf554hgPPQrVE9tH3qGLiyWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZLPKE9eFaBOplcBc9OyHUYNnHn6f_XKTIO_9KSBoz0A&oe=6AB66BB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLDVYI8J0q4Q7kNvwFZaboe&_nc_oc=AdpOrDtpjLpsAGyHo3YWRzxykBsnqfP55j95FiZT49Kdgu2OlCNuia7PI10bDJQ6x_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_QsX9X-_QW4hN-wZgu8L28Bosa3NkP3LqfyOT2HFhPg&oe=6AB6899F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIyQr_gwXocQ7kNvwFgObzt&_nc_oc=AdpAIv_cXLVt0-4qESAsS4q7lT5NtYEDCbHOcRYKYsOV869yoX7Sz_MxJ87h8sGmzPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaQc6vz5eP3IebY2K1r7Vl4pcF9Aphkl_nCzzHcKd-wA&oe=6AB69764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnXrJgNu5VQQ7kNvwE345Kc&_nc_oc=AdpxOwk6CwcpPLbb9tuppnvkjZSaO4ulWedVYnfC19ywxaVboNPoxDNz2CiCITbzbQA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbXycPj06sxNthgXP1VU2oMcuKbYU_XvwnHVsfNxswHA&oe=6AB69177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FMSIt0ex-AQ7kNvwFDkRxh&_nc_oc=AdpfMXkzIHnV4NtB2XaxK9SHgKtOQng7Eq4_kr2DE8Mb-OrpchJjMKCnFzILbAIClfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0l3xHbZfV21KmYpUSgTk6m2wbNlu4pQH9hf-IM8fcaQ&oe=6AB668DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnUnfh4qga8Q7kNvwH_amkH&_nc_oc=Adqhmop72pxQMZ_qlYhlNiI8gcZ9EsRL7XWzt7I4WZqxWrDr_0K4rQfhr8ZLfhWEnSs&_nc_z
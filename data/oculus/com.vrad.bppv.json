_oc=AdqgTZfb7jjj8Oe9vT5xjRUS9G2DrDNecroMoyDvEWft2GPiH2yZYpnexmjyw9ca3As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aLwjpu1AbbV8xnQDybWLalCukKcK-He-0vWYAE3_mmw&oe=69FB2A24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMNiu6uaC6AQ7kNvwH6sP8_&_nc_oc=AdrZs93UWqO8cn6hPekBceXH2xkw6X7t0aSUlfdlp0ZczgpKEYmUN5nYgQ8KKSqtjcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QteMmN8oVCSzBn4i1kOM4BEAX6LU021g9GKLo0N9wlg&oe=69FB5C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzr9IeYmv0Q7kNvwFTQ6yf&_nc_oc=AdqvreVgZGh-_CsP82eCrntKwQs3ifx2uUuW0TTeqHE67juXC0y91d765B8m1NB_CHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gsFAfsyujgsUljeIGb07PgFMfPrDRKqh0qQO2adr_yw&oe=69FB33DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53tuiIUPNQYQ7kNvwFyhIhu&_nc_oc=AdrjXFp7_rBHF8wQlZDAXfSh-JDS8pgNku1hINN02vtWiR5Sdzu42Zk3uM_GSs0q4GI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64hc1NgkQCWfHxiuQxizpYFBH71FWRyH6UcQsdlQHs4g&oe=69FB300A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4veBTwty_cQ7kNvwFP-s6K&_nc_oc=AdrMn5u6Obqklj9Si8mzD9hHXWNagYBnQWWvVUDZxY9H6F-QzQduUG6JqOWfAR4MPf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LmXtOiOps4wox0pQLl2L-pZVIGyAb10uFBoV-Voiy9g&oe=69FB5C19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF-z_z0RWSUQ7kNvwG2H8Zk&_nc_oc=AdpZIAqgUBmyKiTyvha54otFLou3AloO
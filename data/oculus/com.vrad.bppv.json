c=mM7_T70w0V0Q7kNvwFc4Ayx&_nc_oc=Adp4Q_OHu4slESKOYZT-oc5AKjvIZ8EpAxzvSOwqL-F8oxaerewC_pYK3LvvkUQeQeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8_csLmPKmsSxi7nZMLHPKTuclCUWlOBAb1HepXB6jIQ&oe=6A9C0DB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5PdFl6hq9YQ7kNvwFgM_Hy&_nc_oc=Adq4A5AFsHLJyEJ16SXs1pHZnLm0mGmj3N3W7K35AKFHOD4bIKvtVRxnavD51Bc8HCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFg7ZBGywOZTYJlDxYKf3R7lQIZiS5CjIww7udetocvQ&oe=6A9C2B9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_dG-Tn0wnsQ7kNvwEExm0z&_nc_oc=AdoK2jiCjsfJXWKyvhxzDER7aRv-ohFqUSIaIDMZ1t0o34CTi_h_oc33doIelXQ2koM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOc_nZiC4vjbFaBsuQBsqn7mcHZgopqZhdKU85OQW4lA&oe=6A9C3964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzCYc1i0moQ7kNvwFdAElX&_nc_oc=AdoC8ri_F-wzk8l5nAJaYsrW4UqNrlAYMEm1jpTOiLEwqOzxT601e-U-4f0dT8Gj3To&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5TwQZjp4VPm0EevqNO7r5oXZLiw3h5ISiLMneAojneQ&oe=6A9C3377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfyZKyUxtjIQ7kNvwFZaaRy&_nc_oc=AdplOs7dg4h0bidH70diLPIw86Yl6963rl6jWiiseksTWBDkIqwxMfXZ742wm1XSbIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF2Pldvca-N3pcTZANHESjPypqD--519RWWUxccI8ssg&oe=6A9C431C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KJ3FtoO1wwQ7kNvwHtgh6x&_nc_oc=AdobJgPApRCcFlRoR8fzWDABNbIvrB_REFNsVexq0SRZeSPXusoO7XlKiaQC1whv6gI&_nc_z
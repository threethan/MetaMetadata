c=G0c5-Y4-EQEQ7kNvwF_Uyfe&_nc_oc=AdpNflkQVwCp2Twb-AJXRUVG-BatMDvPIHgyLVUKNuZ4r3EXmU8HKvJkZwYkxt_ulXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUJxwY-6afb6kzDnCL9iuUKovSgk12_OTJSjBXyja4_g&oe=6ADF4A34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE92P83LNNAQ7kNvwF6yLD-&_nc_oc=AdpnkrajGjRcrnnaG-SQcUnusaTnwK1RnMwUxlJw97l0-7hdRwszwCpeYn-9M_BGheg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp3iNKi9p8OLQqUoJSVOoc2JcaG7SqFaozdl97rCk19Q&oe=6ADF681F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cy_0fIwAUIQ7kNvwGnHqX4&_nc_oc=Ado5o0WFcMjpJTZRTZ1EtumnIWhYn_XOWwHyhtLf8qfKv2soVE5yy0xXS5i8pKP91zE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5nAx6m2_d8KiOXVtKRnvq8achORgbKtYxT7h1i-TO1Q&oe=6ADF75E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G0zzFU7VvsQ7kNvwF5yQrY&_nc_oc=Adqh8IXoVnzNgw67yoHBpFpUeEMGvWXO9IQKeIhziMFuTf9em0vca7XpdJ8q6p5-NfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSLCGi4mghpG8Zhcd737wAswvJzYyMOdXsc57btXPkwg&oe=6ADF6FF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnPVbNqoL9wQ7kNvwEqlJoP&_nc_oc=AdrtYs9IlDfRDfwKmC0MCICQvsfGKyoyp04ioyYBy_LB-cw2GZMId8nOEi_Fuj1v3cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJLEbdDVC4ENGuNNajvJgtW9oXrAH7e5wil-xTGc_NVw&oe=6ADF475C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnFvBEAVZnwQ7kNvwGupQvL&_nc_oc=AdptMcCevqOW5NeG90r127COaRRSXCD-BUovHls4cYitgLhsgSperjAmC4xx0O62WOk&_nc_z
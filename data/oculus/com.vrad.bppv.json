c=1hz-7mkHalYQ7kNvwHlJFXx&_nc_oc=AdreRlF1eoh1YRPKkkwp8EZMQInnqwSz-eXmWBOXdP2bckUgtE1mB6ddY4qvHPXCqHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9VsRNrSwZUEbcjnGdcbfbojKAc7di7jhPfzz3-ihDtA&oe=6AF88EF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlJVXcAzFA0Q7kNvwHg-ieb&_nc_oc=AdpYFvvQv4wwo-BQXtrhyM93bHXd1PYrhmy_ENyrljzG5splEoOkisD_oD2GANKya0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY2SqlGYrZ-Kb3sPGWR9uaMo1tIyIO3tiCPXM6c0b-Zw&oe=6AF8ACDF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79fwdeZyYsEQ7kNvwFB5E8s&_nc_oc=AdrdedjnZ5Pa5u6gzIOR9-SSon2HZJwU6aUkd6Thi0X_pDD5pGhUrQFCk4XUToyfWUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXzV2yNaUJ4j1rDDtDP0yfie_CnNuhTTnYoZZMsXFmCQ&oe=6AF88264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwEKRNRv&_nc_oc=AdqRPilq1wxBcu839omGcPVUKq8aeTfIoSwIwx0ATtwVVxg04JxM4gQeeIODEt68pc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOn-F-GXNeYzfKWDxx2iTJlU5Ta4AMt65rARYyttrY4Q&oe=6AF87C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjnRGCVSO6gQ7kNvwFeLfZl&_nc_oc=AdqX7L1e48mqx0c2kWV3UiusrHnFXJm6vG2SmaWHbecvXG_scrz4HErLdViTMU4r3t0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT29kw4exkKQYS9dvZvy7bc_SWqMsehEdNHEBd1Q0JbZg&oe=6AF88C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFvFNQq&_nc_oc=AdqANzD7oVoMw7YjolXumrHoFAJPh6VwXHyyY4rVeCfHvqTn_0ZH6pl0sh4_OhwBZxg&_nc_z
_nc_ohc=h8n3YdzjcLQQ7kNvwHDLJ4E&_nc_oc=AdoletJydD97TOJfzp77Fk5sbEpD9ESmSbIapfbBJHe4Imj4sIiQzB2R0u7p_s1ewvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3XJfV2-Wk_Q5MWVcizNshX3_skZdofOOKFYYd0T8U0Uw&oe=69F0D077"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6EmkTYiDIUQ7kNvwHw2Y4t&_nc_oc=AdptVMZvY7vMEzddLvU-vEaKUXDtYfMAH7xX24OQTjvpc8CA1jnel4K-Q7_M98sQ9UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QejJI6fg-TzFN6taKDOBwdJPAxLhddmLvmoNDSOsuVQ&oe=69F0A7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpJl2ji47WMQ7kNvwG4_VRv&_nc_oc=AdpYJfIMuNAzTE_tMiw0Z7Qv31jCUf9vCotX-6wtiE_Vao5MInXjPQ0vMyp-2QOORRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0GvrreC6nmoi-l6RYCQz9o7J3_EqOGUjAvkqm8_u7Ktw&oe=69F0A40A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zru0dsDmg0Q7kNvwGb1Sju&_nc_oc=AdrXjp30XDsxFTzoO7usjqI3SmUw3XpiHZtJTEBJlF2rKCLMOCjrGmYUx4p-zXP6Pn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YKKk_FIecZx2dCMfHWgscvRpST7Tc9NsUK8o9Rp64Ew&oe=69F0D019"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFxqU8a2nzYQ7kNvwGtZ23H&_nc_oc=Adr2uhIksPwOkrZGoEhfgiJqe-oOlxlsF59kQWq9pQQHByzMKUHryPvVJ8JQz2GQ2Ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2r97Oo6JU1ZTVGgTaNzV3rjox6e-cm-SxQrFgy5w9jQQ&oe=69F0B5D3"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efKWekVq7kMQ7kNvwHO5Kmd&_nc_oc=Adp7GR-MefcidVjtmyvjjVFGpqiQcy_pDbHPDtVRR
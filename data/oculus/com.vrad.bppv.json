c=QpAd-q7f_EsQ7kNvwEjfHgJ&_nc_oc=AdpZ1d4DXh0j_2tvD2soEtKwNME0zmLaDU5WuxDhK4bTKvpdySd8O7pf_FMcs7Vahyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsmBR-x3LcXbKnpOWXw6U3-k1-vNwW_ikdf3zpYRHRuA&oe=6AF348F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkhDipRip6gQ7kNvwGnw_Nj&_nc_oc=AdoPQCgg938qZTe1aPr8llZgVNUzxLRSCNmSflo3THj7CKLiFYak5P-LXQ13Eip12F0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_gfnoJEIi0d_jsPWfoZLSZPXbSrfxz3pO9s4BRtJBSg&oe=6AF32E9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4etiXGTtBj4Q7kNvwHb3BiY&_nc_oc=Adod7kfaZEb9kJ0idHxlZIlYZmcxf-66tuGIhY6eyoMFBNoWlywJzo2CJFjJkpgZLj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd-Y4X6JURWmYONRL34CA_bvLemEmvd8U5IRmGz0FZRQ&oe=6AF33C64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJF3qbG6ZZwQ7kNvwFQi0d0&_nc_oc=AdqOhHAlR0JEZIAJt8JgHL0-1gqWq5eVln-LeuSplc6_r2QQEOSUImng6t3D9_zDPmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu0FvbELtjqE0MM3ZSvjMgQpnMuEKQ7zl21yZjr1gAjQ&oe=6AF33677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9B3yzLAojEQ7kNvwFlIhm7&_nc_oc=AdqgdT8YwmOtK01VwJup-y73l7TQih9Iff8iI0wBkXewM8p1sLztlFopX0FCIW0oi1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRJ5Z3TzhK0NEQNrYTwZsfE1MJyxN4ckRTlnA6QmT5Ag&oe=6AF3461C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSK3TIaLdF8Q7kNvwGflSYN&_nc_oc=AdqLI1kZEaMtQ0SsVUNSto4WeRPBELAN-NnB81-ZkXAFkyC4Whbl5Ifr7gJBTIcMhm8&_nc_z
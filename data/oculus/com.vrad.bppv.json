_oc=AdqwO8XHxYY4X_l8-9dg-AttbgWzm1_sF7g6Bjr21kPGPP66_j43VFE2SDLb1Q_TAbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMi3PVCpIQ440lHmkFuA6Xvg0Gx837agDwBmdIJrtiIw&oe=6ABA8BE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFvqIRkLVr4Q7kNvwE4RlH9&_nc_oc=AdrBQElegzpGp4nms8AT8QhGPP53hERpB6c9GzyNaYhWBxkSJIXwrahZzr9olR_JdQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJgPP1roQrSkOhgnmvSpLndS10OaNM6Yfn6hzurxtPAQ&oe=6ABA85F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEKPN6bfqkUQ7kNvwGk-lh8&_nc_oc=AdqaRCWp6KOY2dXeGbFNQjnJ90XTuzoK-N-Qwe2a1kBamBIevekrvtiL13_66XxCo7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv43EcfwJ5S9JSYXjyV48v-uwsy5OhT58ydV0o1F5o3w&oe=6ABA5D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYpIq11Nfy4Q7kNvwG9XB4p&_nc_oc=Adqz4OBFvlM1_-d9rNAhF4M5laO3uEjCtlndBUx9jCiIgd2UvsxKN8znlb9vT7t1S6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpfipRxexFJnDKM0A8qF9r8qp_FXJuVWm1xiiTVr3oYg&oe=6ABA598A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmgK-guMBhYQ7kNvwHwMUUT&_nc_oc=AdqRHOIm4iVLgN_XSaadpDntokFYeyy49_pEdmLxNNziCxv9xUa9ySi1i4RU1pTleAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQeG804IVdQYUm-ZjQJdUYNCaiF0mQhuJeq-d0EVOrYg&oe=6ABA8599"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGQsG-liHwYQ7kNvwF5_72s&_nc_oc=AdpSG1odKYU-IOikL-Iwtr0nl5zfFc65
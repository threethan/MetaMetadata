c=wIAGCMOzxPQQ7kNvwGMvWhi&_nc_oc=AdoIPlzNFTTFPJrr6fcg_9vqjxB67fz5TlI5P0Fb0MjbEIbHzEwvvLdoxCiWuRuq5Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeH5jV2PezSAnp47H3UvrIJGpak7BY-bRkLN0_JLv5cQ&oe=6A7723B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icPy4IO1BKkQ7kNvwFjX0CT&_nc_oc=AdorkLUFsFpizf5DhbToModqVQgvgAqQdbOzbGf5pVB_JLS57tsEgRVW-_oziHyZXrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqnrXmRQnXN5j6_Y1GSy0SWlzMjPBvLcU5cXZGDuuaaw&oe=6A77419F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL3-oxZ1ag0Q7kNvwFcD3g9&_nc_oc=AdrYA6aRHWrCuQ3l00gqw9lktifFFgrDyUn_8VdVEvhQVsBvctzh0Mrr4JPKQsRUufk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjg7xGDLuuw4_l2KWBCCWtmPJ1Gm7Xx23Es5KcMcB63g&oe=6A771724"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS-2PSVYrXsQ7kNvwHoTeZg&_nc_oc=AdoRnLbn60IhZ4SRKOQ1b3cLZescpA0JDE2oFMgiNOMSNXzIOzbMHe6c_aoRxvogKj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpwRul0yoTi0XmZTCGJsxK9xTRlU6eXe0EAOlnAO5gyA&oe=6A771137"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y5pV83MQUUQ7kNvwGJ4G39&_nc_oc=Ado9E55tUvIpW7sulDv8HDGNE9M9Eyth6SIVHgylCu_81qDDUe1jx57aUEvIwOMXXP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwbhNT6vZTZ4RSqksF0jtsBEpp70M-YPBwvDP5Ho8hdA&oe=6A7720DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZXs6L2VFCcQ7kNvwGXJD5r&_nc_oc=Adrt_F5spgYNrr2edPo2F4dfHOTk7KzrznflUaq0a5wNB2o7-dfWAdtQBdp40dDRhR0&_nc_z
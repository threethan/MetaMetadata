_oc=AdqR2RGnWdTVCtKfBTSy0wNKDpMvC0MtXDUlJuWW7-FqW9xqu4VQlzSfEwT6a1yP5WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Tp-NPL2Vdkvy8-uMbemfbw0IdNfqtCND5QrIKGfGFQ&oe=6A537EA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74YOJw19sH4Q7kNvwGHZOuz&_nc_oc=AdqWXaUeK1XSbJp1san3haCYu5dWSVRWPPH_ld0eMBR7iybBD2oey-yIK5oWTSUCMZ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUygS1mJ1rz94d-E2JrxaNdGTri9jv3ZBb9YEUrBCXIg&oe=6A53B0F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx5zas5hiuIQ7kNvwEcSq2N&_nc_oc=AdqOAdpZhektbXBv5mgHrovL3AwEr07PnzYfOGNzbTsfI0_1HJDWjpYGllt1IPSXCwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj_AJx7SUDRRIG8-KzuTfHuOWKHNRmUlVdChbde4v4nw&oe=6A53885C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB2WbUxZOCQQ7kNvwGFFQYP&_nc_oc=AdrBCwehGEZeEnEcgDfqiMEboZJ7Y8DuPXo0yIe8s21qMgqDi19mXsPahXjRJiMy-4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Tt7gGP839bKalql0hi5t2N4YrMXS4XIJRZBlv3nyIw&oe=6A53848A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDRJpm2xAS4Q7kNvwECJyy4&_nc_oc=AdpzcUBaUGFJpHf1CxyUzLsxElKqHKsw3qkqUZcoZmdhXJrAYyInf2xUXGh_EXFHjAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPgIU496-6EyGekPAVqDoC_yFSY8sxmbKrBAq5nc52VQ&oe=6A53B099"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxc7KWbSa-UQ7kNvwGw_CyM&_nc_oc=AdofGMP9AdbZV7Imf5Bz3gctZzV-LRUy
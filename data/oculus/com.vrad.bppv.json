ew71oo-Ap_c_27gZmClf10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK_XEhqOXL0Jo2CjH8nM_vw8DGs_elaprwDLZOfB-D3w&oe=699D9C34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jdeOaxQ3XIQ7kNvwETh2cH&_nc_oc=AdmN-F7d9_GUaYlKwS5oR-t2vsqTDVqdUP1l7NQCo4X25yvYFLnoq47HAcgI0EyKz-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsWtfjvlMDfyfFskDKvWDYQOZnEYoF3get3uvKgwfHngQ&oe=699D81DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hlpjoUYy88Q7kNvwFzwHEd&_nc_oc=AdnmFOtfKLqzk7VlkVL4_fDD8JzybYSFlVQ3OfJekkVrzTZQt17twrTJa0gPHjggXD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6eLXDbHv5ybPodtY8qOLDZg3kmDmM9hj4fkS05LwSMw&oe=699D8FA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGKNqX7RnkwQ7kNvwE-hzXe&_nc_oc=AdnONM90UkftkYKABQecTwG5fg26vQcqgeDOM_tKVm5n-DZqHQIzIsT3HV0UDg-l58I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZXiHcFlxlhFggWLyaeD-iiz6ljCtJzOcIutlJZx7uJQ&oe=699D89B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwsT65fKpmMQ7kNvwEywOoO&_nc_oc=AdnmGzPw1Z5255KDpQh9ISqG1uHIO66iTd0lOyliCRTcka1b6_mNun2mpCi5P-wdZ-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-L92E0_Ih3r-cA3fRLVSgFZms0sF7kKUcF8FM40aPbA&oe=699D995C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt6OI6EWZPMQ7kNvwG2-_IC&_nc_oc=AdnqwDSEUS5DwDIPAGs9hDNy1gPpobLfFMlKSYk0HGSllTpjJaqme7CyTJcRw-EUXj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxQpD0IJCSiBXCMtJsJ-IcDA8LSz-9GyzvNiMQvntYTw&oe=699D958A"}, {"file_name": "015.BPPV_Back \ubcf
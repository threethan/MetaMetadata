c=FlWlyRFSh04Q7kNvwFSWASA&_nc_oc=Adqllbh1jlaYHXZ6kSQ4d5MLoL4lZitL6MV_4szJC0og7xpZVHZ-2WVcOXXfBFg2xCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcp9_Xc6HjgnI2_o7Z7OH5hpx7QYcmyg61cR1A4GenQQ&oe=6A69F4B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdMWqKY9FzEQ7kNvwGeltHP&_nc_oc=Adp7Il2riCIolQshkGNTBgZy7_5bC0BsJrfyRZ-z4hwaISyxIYls6CYedCQsgs6M9kQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBodx6j8Ige-2GusnebsHS0RFxlUx-BIlHr0ddXvv92zg&oe=6A6A129F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yYp-3iRbuoQ7kNvwHm9AU1&_nc_oc=Ado0ldMrC8733Lwzoplc9Q4_1zTfCUk0gqxrH1DeU7G3AihAdgVzFdvVM1Yxkf4VgJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjfdPW8nUnRZxCK-Rr0tI8GxcCILHizrxfud_LtMWn5A&oe=6A69E824"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwrbkeG1gzgQ7kNvwFJKn7J&_nc_oc=AdqbNOyIiMqj3Bn5LC0HcomU4RhCxCnfWwFx6YTt7pZOLl6bkEOWJVFmhwFiNHTeV8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS_3JmtUmYVGQDUclFbwPmc9XAm9LGH737QYgvONyYSA&oe=6A69E237"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5cnmwrrnQQ7kNvwFhhKhn&_nc_oc=AdqPStVHx1JwmbI75qEmVbzEQjT7n_T8xvT7xqLINqiVxIbCpDm_BbmYXYyhPRDf_yA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApBZ6XqoERbxQQ875vOWs9vOLIcQQwzUMiM5RzO1a6lg&oe=6A69F1DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP9jAs9Ep4Q7kNvwG_r0kg&_nc_oc=AdqS1zSfdmCdyur9mmZ1tOoFPdgKLH5FkhhPtllE6ojvJfzGBLLi60HuNwqLDF4dTuc&_nc_z
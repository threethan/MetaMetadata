c=3kgeSCbXYWwQ7kNvwHjRNXk&_nc_oc=AdrfnEJ43aWtXrWbKbgsCHpbQyWSB2Lh9dlHhwaj_63_2sSkAAmWV4jp2KEAo_23Jfg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR_7UJGhe_ak0_1RMe_3BgiT8GJ60bIL0LK5iqqdM0kw&oe=69CFB534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTAzYCABUToQ7kNvwFSWS3E&_nc_oc=Ado1xXIREr0ya2zUhVDOPiF7lSJ6hGj2xRVlnB7-2D99KuIdJjTDBtrBci2VMrDR4sM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaHh9sRlwvDt12B56caqpzSYJcL1f7pb_-15flDvBz-Q&oe=69CFD31F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q95poj2YycQ7kNvwHDOj8L&_nc_oc=Adr8JwPMYI6BhnMw5NVp-y6VzxzY3kZDb-KCtyTo7_6HJ66h_ryQ4TB56LaQbRIyBJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM4405fqQO0qtlPqKUgMPhgcdr8pnGZezLzn9vrM_qaw&oe=69CFA8A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgRLydnFnqMQ7kNvwFVoxBS&_nc_oc=AdrdKjXfOeZwy-OIFhwiZhz6yf4vU70ZpDX5_hJe0U7yxPWFFX3Vq2_pfDciBUKEx3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6buzu836i71NxJdkpQpZ8eTaEDiAfI1G2IFDXw25_Jg&oe=69CFA2B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZC_VVAsTwgQ7kNvwFgnsAv&_nc_oc=AdqpkcYvIZUy0favPCLea1-f8dbivPLvF4tH1z593hxUuakYouRORhmqfHShuhiMRSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTKI3hEKl5n3cdQjWmqk_cLhFNEXQjjIYIMsr1-ZHLhw&oe=69CFB25C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnAxbSjfQwQ7kNvwFRJ1Bx&_nc_oc=AdrzxWbH61TLVP5ha5tIUjfjk1zbpmpuipcfLM-K0XJArf74XCkUQZ78gWFtj3j-WB0&_nc_z
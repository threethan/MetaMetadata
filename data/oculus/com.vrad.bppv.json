_oc=AdoNBbMBIju6v6KmFiACvKSaEn_-RSFXZxolxVkgAdZ-7DE8P1YO0LM4YYxZDpeP69Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSsmsaLXm9TPkgayr5Z2RXVV9s2bFx9WZhdLr29ohSPw&oe=6A4BCDE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFdHuyGQpvMQ7kNvwEiH8zc&_nc_oc=AdrWM6yY9b0IWO2r-d2Mhno8cKgT9YzJD4tii3PB39021T3lo2JOo5lDCYzIlUL1X3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6J6aDary8H6QVu-2_IDjibt86QgAN9iNn1Smmlbei1w&oe=6A4BC7F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih5KjP3fQBYQ7kNvwFecum2&_nc_oc=AdpFPFDQZUI3WGRJtymnucL3HSH4KYZgJdGydADcS3dHMj_jrwAvhqzYaoV-_wUs8cI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVXcWnKDBA_8iiYXNeUtv_zUWh5OpB4DjFBAjcz6Uzaw&oe=6A4B9F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq6hUrJYv6kQ7kNvwEwuGX3&_nc_oc=Ado8e--TIM-WeZOiQwBerJRbIQ9rnKTC30Hb3oV14eD2SlHrmFctDjz7LCIxX-PFti4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmyIzWlgL5WZvanjliTfvk-w8s6B89bODXevLbaOZfbw&oe=6A4B9B8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2nAI8OAAgMQ7kNvwFC_2kh&_nc_oc=Adphfr5PoiZ8r9WP-fC3sLz6Vd2KlN16rsips4SebG7RI3YCl2SEcay98MUXawvAkMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOmBjM9u6Qe_f3zeptDM7pMOQcUzzi0iEWfAzTpA6k0A&oe=6A4BC799"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOvZ87B91i4Q7kNvwFfwLme&_nc_oc=AdrymihoXJ3DKDj9yd0L7O9OkVbbJRU-
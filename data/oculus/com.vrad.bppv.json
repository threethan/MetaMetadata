_oc=AdoqYWWjdgSb1zZ1F7BJHerajhfvpYd4jI8UIGxHedJ_dpsPgaNrwmDDpKlKoID1dGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dnipFRCS87lfDHTyOEqgVnpJ9gNWhZDupkiDSqKwxVg&oe=6A2986E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IqOvBRHNywQ7kNvwGZniXP&_nc_oc=AdrMWtD_ds33lqk4lqeScgI7isWtzx4BW8UTyBEcnZjY6ZcIo2_SMbJ9dNpFGtz6ImA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MuO6rIogZ6WokqK_xi0G9sjB2Z5q7N5vJtxWVEnArfg&oe=6A2980F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ8pvLL5MeIQ7kNvwHW4Q7D&_nc_oc=AdrcyDoWOSR6RLz3fsDcc0hERs8gCJsaD79ma2sCJA451KyT1C_BTWji_jy068rXwhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ORsSN6GcfiSlSoGdg0gdho8ZdAaT9H89U1RiFsjD6Fg&oe=6A29585C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5OhPQyHOhAQ7kNvwGMVz4R&_nc_oc=AdpotubQ_KG4Vgkn9NOzNIWLa5GUO31mJLdwtMLoMo1pv-GSAPTsxFg5GrDPsJZRKYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ehhXP9wS3a8yrxAUvAda4HWMW1RSxF5dEi1oTmbx-yA&oe=6A29548A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS1Cp0PZld0Q7kNvwFyLenh&_nc_oc=AdpzcSqFF7BDN98JPD1SkRNi6g8qjFgIcU25uhhm1vVaIpJQX4rc4CU6DN28Y2T268o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sYEVaE_PIpKoculNywWCIt2enY_v73YI1_7Q5JszB9g&oe=6A298099"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb0yKzdrw8sQ7kNvwHwrzbg&_nc_oc=AdqRDnEtVLaxftjByuld5IDia3zLLSom
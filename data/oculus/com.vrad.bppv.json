c=7eIvAlBIoLkQ7kNvwGBeMMR&_nc_oc=Adqx2Sx3vet-yGhkPQVLxWGJ8s3r4UP_tcp4Htd1g4saYRRP4-EH6U5q1ojDqe839B4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30YHkN1QwI-rlket7NHCzSgRiy3aarwqF3hNSOclW_8A&oe=69DF8734"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq0Zud6hTaIQ7kNvwHIc8eJ&_nc_oc=AdpmZWDZPL70yyeh-ph7APm4MmN2kZz9E-wQOGTOrU95xPbXBlycO4YrY5TkDBOM1ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01I3aZnfs0sXhoE5hojH-v_69yckDANmJjgasbGGymwQ&oe=69DFA51F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovfi51q-jEQQ7kNvwGzflnn&_nc_oc=AdpAAwx2AiByt5YcGi7cNn93BOUZxpzZaBHS_rSJR4LMXVGIRjEoIUBGlDhI8rR9ngM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00AX6Rmdey8cO7JlCG0Zq1Muf7v8PjbUBjjYfjQRAfMw&oe=69DF7AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOttb8NuR80Q7kNvwEeoGtG&_nc_oc=Adp_hYGMSaj0NPog-B4YtDRHuCpiKWDZ_3Y92vzjC2KoRRApH0v8vRhqpSzOdYZ6LxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00xQaUEOksewnxSBXsWISl7S_0X2WyzA31Xus3zoEhBw&oe=69DF74B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAEbX6Har6MQ7kNvwE9N6Hb&_nc_oc=AdrWSt9T3IqWzG9r5_R-yBaAbg1TwtLzVLG-upF9xMU8qTlgVeCIvkjxWgxkZd5vmuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FaLbBJTBEF_TLtud8wiTATGzDgXG2Ql7zVF8rVLZxrg&oe=69DF845C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFW2IGwRz_gQ7kNvwEBEB1X&_nc_oc=AdqgGPXl5ViYznsR7sd98NmdjvUtUDgChoVCA1eUo0aVzJi87Wxca8xS0phdYaxNApk&_nc_z
_oc=Adre56dVYjrjJPi75AyAjvPsi3Qm6R5S0WhaSfMaXxa1vYGP3V5aCXcvYrtD9oOKmSU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C7G0AP3QC0izadqNhTafOlSnJnxM-njatLcSMcxn1Gw&oe=6A32C164"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcqXGiThfHEQ7kNvwG21ApX&_nc_oc=AdoTCQY9gPz9awvI546Dv9dIAKWZS3Azk2CaUDCapi0w5_x2OW0U6VeGY1X4t0zRqEA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0pWHTEEX3JIjZ_6jP5fXsQOMAniWMTku23aPhCwaJow&oe=6A32BB77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfUVr_k0R6oQ7kNvwFGqbLR&_nc_oc=AdrTnS0LuHBedmMUesjLJ5SYh9lrrBWWugb0XHppy8aWAMmrLdRzVC41xBCvPzjnXxU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xjFQ9qOPklMSOMEz0ujZPvDfWe6ykA2q3mSN4xA8UTg&oe=6A3292DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vigi0H6vOyAQ7kNvwGN5fqu&_nc_oc=AdrzwQcMqOvlhRsbdwySxLlgYJVYoThZM-6oojt5BBbKzJ_1e-WDJriRnpPUxBx-jJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96NQsyM6tUcHTmnsV2PONTtCDiPriQup2CqAoNfVo4Qg&oe=6A32C74A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdIJZATCwk4Q7kNvwGDM36i&_nc_oc=Adp4CGrYN8N8dPw8TETonFoK1D6Ga4iKg_6wqRu8kjT27JfaHyKX2Pt0PKBY47C7ECI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GeiRwC5qIc3SlIiCXI_WnyqahOKUk6ohRsjfvI5BVmw&oe=6A32BB19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOvx0mKYPHIQ7kNvwG0cNk5&_nc_oc=AdqXwgNGCZb24EJGZDD6sfshxlAFnl45
_oc=Ado-K_on7aFHCTYLyn5K-EKCxR3bav3PZpRHBZqj6oj1xaG1DPHAV5-hfrAeKYU3H4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m1h_d9CsZ3bfuAOtrYfY1pl_3tqNQ0ChAqJpCn3IR_A&oe=6A00A864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abS7jdm-MUsQ7kNvwFCsdsm&_nc_oc=AdqyDd2TKcFHVnrLMVpkSLqwOx1poe__L_0tp8lml_gUSjaVrv9MVS2JJ_2aljdIOVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S6KCBp1tiGFDfniSoXeauyKnbTEm-HXKyS_T0GHUrDA&oe=6A00A277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rygB2GntLo4Q7kNvwGIalT8&_nc_oc=AdqB0ra7W1y-1iDduweg5KO1P-KALApyqQz8catOA-xfJGYaA1b8YJHzedc7YCqRb-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6isdV_E_qlm6538r-6yAYrA9eoSMN-yEn0zJplo2K8aQ&oe=6A0079DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PTF7ccjfmAQ7kNvwE3_LNa&_nc_oc=AdpU0XV77PHt7kg3zJR8Yxk9ns61d56VEMtvTvQRGyuiTm6XzOiE-lxQuRv-Cr0SAVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SCp2EM0h8RbonM1bquJZYBhsoYaGLpKNthUCamropjg&oe=6A00760A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft0PSpW500QQ7kNvwFOJcmC&_nc_oc=Ado6GR0gvCDufjcOkp8AwLUKRhivBQUsc9ARz4TE1PYbQ9moKDB_UB9Ya6wFHcVr8xI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hSh8h1R62HZ_BlnSjLIrMY_CChfvN3AXf5ykNxF9xtw&oe=6A00A219"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3SFI6TGIpEQ7kNvwFBraXj&_nc_oc=Adot2tKdR9AsKr3D4_snvJk1EbuPZQNM
_oc=AdqYbRUQZMjSmVvoAfS07C5HWQvikDwcIfAVkoUBetMjBjm280dJskDPFMclQcn_iIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dt1vRdXjmdWW5nOE_3a9s9RvOdcHIyIrzhTTaCsjnig&oe=69DE2924"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOttb8NuR80Q7kNvwFPpG5E&_nc_oc=Ado-4x6KFCeHegpYLb8bxPd9WOPrxpSF-tukBqW5aRVmBzpAcgkBo91DUyaz0oR2RSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DxUp5rFpJBjPc3TY9VTP8Y0DTh9QL8XPNrHNSweYDBg&oe=69DE2337"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEDJzKjFdTQQ7kNvwHA00ya&_nc_oc=Adr0fHBx5jhH8-pq6Xzq_FRtscUdY7pPA1-LZ9vDhZ7PYFwSNDLpS4AmM1zKIMBOM2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18a9vRG76klr7XtzYhKv08IWm0KwGnHr90WF-FBWiwYg&oe=69DE32DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFW2IGwRz_gQ7kNvwGYypVn&_nc_oc=AdoK9NLQBSdXbOM9FYm64sLwLufixnZcYcke7Aig36AXOUINdG7vDo29RjF6VLa9tS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Je7V2wbHmGAW18VLP6uZtFv6kVdHTKiQtbvjpqBygag&oe=69DE2F0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjyrBDdt4_YQ7kNvwF7oZYP&_nc_oc=AdpjHBz7e0t4qxponTPw01AyPmHcuhJSDJu1z-_hRp2q_HWfaFYQ5Kze_igLt-rS7Iw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fTP8EeMdNGXHIcdkZsyb80pqj8b51BGhfEMsIKDt94w&oe=69DE22D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnWeJ7Eb-4wQ7kNvwGA9wOh&_nc_oc=Adp9WyJcOhx1uPso5mBJ_2KO7SWBcIXt
c=5POe8kRFTFMQ7kNvwFE6JwM&_nc_oc=Adozt_oM0KS4fJKlREhyC7p7tIyc8fXvkL0GEXm400xEVDZjbxEXYU_4HPacy23Unm4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkQlVnbSovK9WPy5Nq8--Hk0PoTDYn5Nn8AxnFHx1iFw&oe=6A9424B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQI1_esumz8Q7kNvwGYEagz&_nc_oc=AdrZlWhE07bJy3JrwLQWid8Do-61MNzVrCmISLWZ4nc_sSYlan7AT-bOlpWJiPQijmk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEro3gVapwYqrEKicFUnyxJO1w1435DviUNxt1j-jAcgA&oe=6A940A5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oQdAgGiS7UQ7kNvwFlNf3k&_nc_oc=AdoCwhalBcm1RTXMlPgCUAWEW5spPDZQaZG3CLzJ0T19D_lscV_eeHTV2YOGe8zuOXU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQy_M2yvF8t42k4QaHEuWFOJ06bt_QrNmMh7ixvRrMA&oe=6A941824"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_QD3-sCxc4Q7kNvwF1og24&_nc_oc=AdqZGvirfzklAii8yluEqxLIov5Sqkgjf4vb1yOFO0oIVuCwBtIt_-A-q4ZmX-V-iiY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXxGBX0GEJif1kuzzSugnjSPJDyqlYmeTN_RjTRH9Uhg&oe=6A941237"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcIcw1QVYaEQ7kNvwH0eT1U&_nc_oc=AdoeDcCuGmLA906AHhBuBWsu5EYEaWL6T3pUaJRvzBmJcVDvwGiIORGzKS-87cRzAAg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDQgSkqlyBxi0DBTCJPG0CCjCRSox_moHwF38cPPLACg&oe=6A9421DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg3cBxuhWgQ7kNvwF5IJ4_&_nc_oc=AdrdQ86x4ByOj2Mvg1ZcTPKfnALu2YwzOpynSmTyES3rXZK1wQJmbZAnyLDQKPo5zQ0&_nc_z
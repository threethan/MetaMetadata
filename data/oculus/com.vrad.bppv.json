c=owjLH-s2-doQ7kNvwGcXE4I&_nc_oc=AdpAwL63tstiuI8HtnCaTBGv4FBKNd69Fp0UKzuwxUY5u5zzv0Kw4i-tYe9n-cxQGbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hZYgoLqIWhYh1lMK3Gk6FG0he7QlTwSxCu0WuBUJz6A&oe=69FC8834"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuwtGjR8KHEQ7kNvwHwcsYB&_nc_oc=AdqEuT-D761nzCgCrbRqM3-_VRsbU4fshm5_Z8_s45YsrehmuPQ4_mAGSGXq4RO6XIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Et8C4tWhiFw0CrOD0N7lwLK6lm2w4g_cmIeDNsoBgbw&oe=69FCA61F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t6zNsg6zZwQ7kNvwG7-MIt&_nc_oc=AdrkAPmqx9-lYS3tO988_qoLjEpPC3PZ-IAYWNlrwDo1YS4UKRTJ0eyO7q4YyWEM6SI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o7WywPNSDWXyJ4JdFyBAFMA1cogwJAjC9unhiiZvDyw&oe=69FCB3E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMNiu6uaC6AQ7kNvwFEuN9T&_nc_oc=Adrhjhi6iqzZ4q1-ZKBH6zgBiL2u6V1oSvfWPZgZ7labJBlPnJvcn_hJohHNaRYanp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X93kEpwn7zbm2HgjvUt3Q-55HRv6WVKpY-gEbwjz1Iw&oe=69FCADF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzr9IeYmv0Q7kNvwGc1Y82&_nc_oc=AdqJ0mv_QXtxgDMvbsDTt9QgGJCt8F4zMvddRDnunjX8MCSs2Z85Qvnw_lliIdSFeqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epuci5o7l-ipV-pV0mwDceCpOTqU3ji8MuXviXaiWZA&oe=69FC855C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53tuiIUPNQYQ7kNvwFSfQ6Z&_nc_oc=AdqpSkCiYGLs3zBi9XhW0rIYaJhIRESf_LHYZt6xI2TFu4m-9wVPB25g9JZmJaqjBZM&_nc_z
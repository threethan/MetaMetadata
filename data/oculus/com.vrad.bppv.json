_oc=Adofbq67xPaLaHEAvYr8JEZpeIaJNlyWHUhbDoAMXRObn2bN0L1-yyC20X_oqExK8eE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WcjleL_4qAFr9ecI6_R0_tMDnMtY6ZmcW7pUlICWyAQ&oe=69F492A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpWFl8KnMFoQ7kNvwH9DzRG&_nc_oc=AdqCjoFzodnvOPdp1Y0L15oXx4smFgKQRQoGx1El3ovEh42STWiGxK8KkeT1vhryaRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GIdzPDXl7Usu1Do8q1hIJs_V3TZV1m1mlL_nfUWIYTQ&oe=69F4C4F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47BbRuQCcqYQ7kNvwFUXNIa&_nc_oc=AdpuxZ15wwOhCeYQwPyHMPdmfPB3yXWAbOXuudVD6Asa_R2Ge8P-lA6I5KRgTggjrUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bvWnFg6dlowFQ6aboxA3bgVnOMRps1L1urtvcVGGBWw&oe=69F49C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmqKuoOtpS0Q7kNvwH-DVx1&_nc_oc=AdplgRPzfwLkOhjpBZmY7a5HtYE_1y_iFPHMA13-Q_7uV5Ph1x8x5NG5HxX6KabJTFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PTNLd8FHyreMo8CkSZn5wGmAeW--_kRGYCQsufyHWSw&oe=69F4988A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAMXDACK-w8Q7kNvwFe7L4C&_nc_oc=AdqmKa6YDAVGflvTJfHckqqolpQWw4rQAkJybeW0VOtnszKVPguhOPvJR7_D5RZXrgk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19pyLANG3oWXGS3af17PomBoInm8uovYQsgVhuK0Vc6A&oe=69F4C499"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MTQogKgtyUQ7kNvwFK2XbC&_nc_oc=AdrJoxrQqibuoFmktOzjxt5VDCSv-cOM
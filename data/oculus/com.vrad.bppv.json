_oc=Adqt7nRnws98I13sg5V2fpnwtANR0VA2oaif0k-Lah3MmUeqqd2qUhLKXil00RxkoUQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OJ3xy3KZ58hdKHK674EpDmThjopriYFMxjqUuqedXOQ&oe=6A3D4D64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc9KwC46SdYQ7kNvwG6nzmU&_nc_oc=AdqqvdWqQHrSDTTk7dK1D8mtKwEWV7d70nwcSJya7z-AECwl5lQnpAIJo4lfAASDlI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-aFYq_1yCk559yRW5bvtY4bxhyEB3U3MUC0UdCHS3Ag&oe=6A3D4777"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZriON_SVfcQQ7kNvwFlMZiQ&_nc_oc=AdpREne5YmDW2DUsS8cfHqq-9yS_cYzoZbN43_ueflTErTkZJ3BE7ymZ0a37qBLaczQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GFz2hfl2-GP6fLDxxXAkSyytDlG9l2P9qTWRcgsYFeg&oe=6A3D571C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgoY_DJJooUQ7kNvwGTu2br&_nc_oc=Ado9yPj93kSsjwJdjkP93bXnQYMj5Rm1TTlLJiLGXM8ct6fYuAf0YdAwWc6WXJInxzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Rl2yUqKmgH6igvMx_fIl6RFqg_7wLDrUPW0-SwyCSQ&oe=6A3D534A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSt8I4D-5kcQ7kNvwESg4vD&_nc_oc=AdpMwBRj7HRyINxJGw9WSGfvlx86l33hfSTaNtrCLjARXY8Bf4nBl5FYFgewkhyOx1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bVjtA0giXymHEQilAJQeHk9DFlQTaiWXKLy9h5bgnzA&oe=6A3D4719"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OehubIb8ukYQ7kNvwHjIV7w&_nc_oc=Ado5mihzXHVlUoQ5fsA8YBwtv8re-Gi9
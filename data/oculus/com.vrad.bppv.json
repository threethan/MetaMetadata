jw96JIQ7kNvwFg9PIk&_nc_oc=Adqy3ENo15o4yliGm4PUP8c5hHM4Bnlgpd70WiJqzvZH48azzMhDnaXNUC9strDKPTY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Kf_JPlKPFHZmBGmhzJLDFcKcmmZ7724G0lZrLqAHGQ&oe=6A11CBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2IHjLLRluAQ7kNvwFZqwD1&_nc_oc=Adrdqfetams0aGQvKPIsEttK0JqF9HO2g2lkEIXAO4nC3b9Gs1Y1oHhPBNlKXENzIGs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af645BvEf_3Yiob8pzwYZG72wgiawYeu5bLySNQB3-TguA&oe=6A11C5F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYEA1s7bacoQ7kNvwGrRQZj&_nc_oc=Adq1hGwk45V_aRMMwOgrHaVnw8ckwSanif9HPxqI8jsmJyCxGobf_iBhVqVcHuJxeP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-WlCADmN0sRGNrxFmWGW3OqO797k_LIheX1cGnRv2Cw&oe=6A119D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMAMRUdp6GAQ7kNvwFTeUjV&_nc_oc=AdrQZPz2crYYo4O8ICEqlGlNV9wBmiK1iubH5PwyTLshWJP3Nny1QJKqo70DNX5oI5U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HSN9tbm-QF9wHmA2EB90TKqAhrGQ4SrYmNK7r14ETCA&oe=6A11998A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Addly4aw-TEQ7kNvwF5fpcp&_nc_oc=Adqq3WslbPd4n-MM6Z1KHSRzwZeCC7PoHZiNv8RcjPhVuvEzaGyHbepH9XT5-2babPo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tColzzZVCRfPRGiL1JA1VmYRC1AFvaU86ZUlkj3nAfg&oe=6A11C599"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXxVVA3wKqIQ7kNvwGt8NVi&_nc_oc=Adq
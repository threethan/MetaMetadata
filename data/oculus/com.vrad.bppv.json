_oc=Adp4KVcgBb-BBEHQ1zbXCrbXo58zs8VR8hbhCMWqO_-ZWLTzQYba-3Yg_xf5THSGj8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTKFEPV7bAC94Sx-670cLhUZEHVxJ29tRrJ3k0gL2oFg&oe=6A9EDC64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzCYc1i0moQ7kNvwFbX9QB&_nc_oc=AdqmQgEQyWP78mPAru4Hc0Dev3B2I-TC0CTmNZeclEJCT1fI9KUa6gkppE9SggbDa5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGBaZOyst66jJuPDoOAN5qoxhgRPYZf06675zbvnZ2pg&oe=6A9ED677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGDfRDJgh5gQ7kNvwGJakUc&_nc_oc=Adp5dQS0X_4IsZsu0dtv4parnJdd8_dHekds7Qp48M4EtQVLZfrO6lBQAqRG9Vif9_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqHrsWxA8bwGWxfBwiSEFbXIArVs_502DLDjJu_NgnqQ&oe=6A9EADDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KJ3FtoO1wwQ7kNvwEQRAUR&_nc_oc=AdrWSBEgLacRpYK1I_x_5HoMQEhtwUxHRPd1qsafDoyHvVwDhdDUPCp45oilgH5tX7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXnc5AJIA0dd1EwmAn9le7aksYEB5QRmqw1FkiTml2fw&oe=6A9EE24A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_6So6DFP_QQ7kNvwH8ylJX&_nc_oc=AdomZgB_02lF232AYLDg8xoDc4wtuOtT9zh-l8dJtXG1HFIwL7wLTDsbqbNQuV_TSpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_GLxqpdClD0TBXhOBqY687aV0QXIjY2QCZASCt2pFRg&oe=6A9ED619"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2UG4H8HrvEQ7kNvwGukNfN&_nc_oc=AdrKrtj6a4fJXO3K_yZKM10qJIyRgOhM
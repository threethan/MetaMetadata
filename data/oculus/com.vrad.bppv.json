_oc=Adol3Nl71ftgpsF6cd_umspsOHvA-E2sT6GaEX2HTaQ2fejJiG7s3b3gcKTDYq__wr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXIABuHxLwfi-kv4YOorPRpJoOQr7SOExBHrI4gFaUOw&oe=6AC12364"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNtYe5n_XZMQ7kNvwF32ps8&_nc_oc=AdqtQFM573Wstf72lZFtSo9MhbnHk0SBFKbyr1LuK-JvVdNfuSqA4nZ-FPcc1zL00rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Hfxm3dD2v5_9hr0zPVFvo7i3QzHnXU3Obz13FI-uTA&oe=6AC11D77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aB4rZvTOt0Q7kNvwHsmBZT&_nc_oc=AdqaQAwX0GSdmBK-8vGwO2ZD9jQgx-hEAdkfGhD2bVfh6c-HmIL_qyNIPK8dRn3lvYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBhgo_wJw6geINQ2FgwYdiMWse_s7WWt9pRG4bKoggdg&oe=6AC12D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmiCJW2gFtsQ7kNvwEVbwIT&_nc_oc=Adq5GDJXABZX0puAuS_uHYprRGq7Wv870ynyFlfPnyt7B4_LJzq-ak5P6ngKltvsBjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkYptU0g41CvTm4RkmCYf9AM9qNJ3ssweyYrNKtODr3A&oe=6AC1294A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBGh01sLG3IQ7kNvwEd2fPQ&_nc_oc=AdqDoUhWqVdZNzuYIMfwDQvsph-tye2rXnjMBnJRnzIanOvG7dzjePOnu3zdvjpeo9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMilCBQ6v1grFJHRuwd90NEEqvZCKc9xpXxUEHL6F8rHw&oe=6AC11D19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI6WRSvF3H4Q7kNvwHEbp8D&_nc_oc=AdpoPNF9MstT8O5SVThjvPqJ35WYMb2s
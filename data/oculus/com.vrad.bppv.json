_oc=AdqBYfIAPoyjVBLmPcHjUA_A0Zy-M5CxO5PSPWgSjjwzw-ijwd-exjQyRH-msa26JBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ueTRqirCcmixkZCJ5nhjfEMmiIoBuEXwHTvwfFkoFw&oe=69E763A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8IovrZP1F0Q7kNvwEWM4Xs&_nc_oc=AdoefOV1nrKcpC4S8dE-CuBQl02MTw_cLV1pZ1OTfmv-bu_a4MapJKxPXgOFqnZSygk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hpePBJVUZjpJ_1Xc1bjRKraBGzpwayon_6OOxk-vSIg&oe=69E75DB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbfSgBkCLUMQ7kNvwENKZ3n&_nc_oc=AdqNipy0kUyNphxNhfPZonod8q86w6tOeojFbipf_bWSSapUiQ1FA8gnmlbpefxNBzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d_fns48G4V0Qg2BtnUIUdURyyVxX0IGCoX44Y6QUgEQ&oe=69E76D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6N5p72j_agQ7kNvwHVyGZb&_nc_oc=AdpciZAIjxwsWLhsXa1Bi6rIVWuFmLg2Ut1RJkUueB2dxxxX4eRSWFk04Hsxol6LnT8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sMUhATiperqcgJ2HUNPfdHiGkdBou2L8lChCXT79PYw&oe=69E7698A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGAOxo_RrSsQ7kNvwED3UU4&_nc_oc=AdpJuTiX0YsmgKtjIdap1ZmUm_IetPNNB4ETbcUPn18rULzZMxDj2WXJcQKey7W3eF4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rX9ckZT2YdQq_1U5GI1zA9Q5cTZRfWfUkxA_yKmz_tQ&oe=69E75D59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWXYjgE1ciUQ7kNvwHiHxXa&_nc_oc=AdqSGaRTpwm9e_diijdP9fWhjHLP1UqB
_oc=AdoZL3YbNBC0g1PAJh_ry1dXtAo9iMPxSTu4mFUg3WhG-e1U6rzFb0LF225tyNH8ESg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LksqJNp9_EudvfralkbnUl4g3OJI64jLK40zVf3Q_2g&oe=6A15C064"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o24Zk3r7JJkQ7kNvwHz3K02&_nc_oc=Adpj0XRl-mAW4DAx5y1QwndnYnyBAdqQ0jCCYJKb3kLZTWtnrl2cSGOR-RccUUWXV9A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73AkR5ShcZDI763Uuzypwmt_I9QTENhT6qkl5UR54kGQ&oe=6A15BA77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWoRFsKQcMcQ7kNvwHgqFm9&_nc_oc=AdqaZKSyuF68mBvPkr7nxqblLZS7H_1hkUFKll1sI_HBtFrDVOpHTVl47uPNV8UgKlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t6nel034fOysMXIdU-guVEXXIY1WMXUubJrFr3NenJg&oe=6A1591DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whqpxj3Cf0EQ7kNvwFsH5W7&_nc_oc=AdqJ45a7k94q49XyBBXjI5QJOsHzOBURX-7ft5-Ek5tdit4wc2D1a4uDUZUnz8Dlbgs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49hfAPfaIwmPGVNgp_C_ZwL8OfFD5qgB-iXb-yKraj-w&oe=6A15C64A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ym24fxtUMQ7kNvwEuatXj&_nc_oc=AdoFRdukjsTfWQ4I1y1HpdLQ6IMyv-IPlG1bRz1Bf2u1k2NQSYFKUtGvRkWezZilmQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jzOtU5L2SZ36quXmbZ8jsRtLinSfGdsARAcc3MV9y6g&oe=6A15BA19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klbyT9sMa7oQ7kNvwH-B-LC&_nc_oc=Ado_cldODjWT-qci0sd1Wufos4gC9kNO
c=G0c5-Y4-EQEQ7kNvwHYliND&_nc_oc=AdonZnTVQUxFcFMiu0UtBuVv0_ZxtJt9PDRs_vzVgBQFWbkBMh1yt2hlMREnynsIW2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrhSCD64sf2SKCxttrC3xc9FyrehsQ4LgU5fgB1zuZWA&oe=6AE1ED34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv4lf5QXVf4Q7kNvwGfrvCB&_nc_oc=AdrE3p1V-mSpyLg4YLMmdV9vHz7OEUKOUiUzfg0uRMtoCbf_TARsVbosyYB7tVmUK4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc46CpJwLwgtat9AFNsT8nzG1MLp30kne0NrPCpwBI0Q&oe=6AE20B1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmgG5ydS6FkQ7kNvwHxzXtM&_nc_oc=AdqGzRD9Pbhz6q0NJnnL98lHA7wCkXw0R-ra-RBNoDD03mU9hG0I37WzpN4ppDvm51o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOYdxXU7cuJI_S27XBSCfk0TZSVuCFoFgvUSASfhcAHA&oe=6AE218E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G0zzFU7VvsQ7kNvwEpFNoI&_nc_oc=AdqqLfE6W-7kmbGXz_uYUnVw1j8ocutve5A5r8j1jzLchVDaeCBtZnOX9lWEc7rH5HA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsjucnbS__eBSSM8ZXoFLTLgoegLeNadAGwam9-AFbuQ&oe=6AE212F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqLYIzwiQZwQ7kNvwF6-ppm&_nc_oc=AdqFrjNq_X1r4FVmogcVxfPqBkDq5eKHjB1dGDn14vBClBE5G11-bT2kEx5Tv_W0igU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNodv7xNn7WGfDksDz369fhspc02VksumKrYx2Cq5pWSg&oe=6AE1EA5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnFvBEAVZnwQ7kNvwGhnH-F&_nc_oc=Adp8Cs3lC7_rMRtlx7In4ORj4uBtX6r8R2788uVGq88L4HWCL-fD8fi0-k2aiuh7qtI&_nc_z
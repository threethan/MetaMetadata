c_ohc=n7k9tBYAtSEQ7kNvwEis6Sy&_nc_oc=Adoh3JC7HyTkUnpxCZLec82pHPwrqQcA042BbIUvknG44LlJz83aENfEx6kPHtPmVcA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jloJGglCmYCh2sgszjXlUJxpUwfVXY_o8Bk-8BslXTQ&oe=6A22FBF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkryEZzp1cwQ7kNvwFx1cP7&_nc_oc=Ado-6K9TuChUBfE1xtPmj75Oao3T70Y4VuRKbYo6PN0kUSuXrF7tEar9QiCYxQig-BM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xq_N8lAZ3x_LbG1oQIlNjUEY7Vr8LvBppILvj4T40xw&oe=6A22E19F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8YHDBcoye4Q7kNvwGBdBOd&_nc_oc=AdrNAjNindBBfSWlniXzDmwR8jXf_HKpoVaTO8oxFMmw8UUvJKgCSnAKti-5SictjUE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QvPtix7TA5pqup5svooLrna6uw2eagrRqNndPqzERJg&oe=6A22EF64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwEwY1uq&_nc_oc=AdrfXH2UryPG7dAkHpH1b9W5EAKu8pljBkGsEN7GIcjnGpwxCK7wr1uCwoUya3hKMaQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QdEsLi6UecVWk7tgeZqYdrHmK_dv69D0ZE6OHMTwEMw&oe=6A22E977"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwE4xv9b&_nc_oc=AdpUZmvz-K2b9DB8G6JDzplpjzQw2peB9dwo4oMx_svEOSxGvwZk4qGUx5OO-90MGeU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XOVq1Xs0OsyKY-XispI8yz07Xd2uVAQM6DtbZpsTsow&oe=6A22F91C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwGeMAp4&_nc_oc=AdqjXyniWlp49J42sUeyCaBfjUR6WQ_BDuVWZ59W704PMtUievhMz40Kc23MXbrDB
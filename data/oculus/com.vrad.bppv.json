c=Z9SVPRwZq5QQ7kNvwHbjmHn&_nc_oc=AdpUiDAvVnIP7o-Bcc5llCfXBmXXTZ5xv6_9XmQ3ClPVJUylQn2tmyYdmTDXiTZhZNc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7WW6QmLJd0lyRJjwY8tfariEiun7nNztCt5Yk5LBCVQ&oe=6A6751B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQQVm1U4MoQQ7kNvwF9Bsl8&_nc_oc=AdrCMeHJ3cETxnIsHeK2eFE3yCXzbKJWYMryCDRUdpXA0sruRmDXr2jYLxh-GheqKmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaMB137eicLutcW7bzK9sdhhaCChWweR9SnqtRWL7sOA&oe=6A676F9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWjB-iteK20Q7kNvwHVpCCp&_nc_oc=Adq958hzNQAI-9WO4KbDoSTLpFAL_ypqT8pP1B__Eu1ew8v_QvFlT2ydjfRR_9e21uU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdc8KcFFwPUi8YiVUqnQFT3JFXypCD5JSdy6-qmIlGbA&oe=6A674524"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfsDmi3nxQkQ7kNvwE0SBNL&_nc_oc=AdoZPbnWjr1xiZJ2vcVmRW7ueltD0TqMV5fW4PmJhiO2vqTPLZeeVZDIUZF4xhRYrWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV7yzFFvLsXAP5cknvudxuLaaqbCgOhHtJ_qMikYrNmA&oe=6A677777"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x35NzKiPBAQ7kNvwHLMvD-&_nc_oc=AdqQWKAm-GQo8Kvj7sH3SUGPaqjscf8Cjwxcy15xDo7rVw-KyfqFNTpXOxfSokExHEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgSGS7YJgGvtvhql48mZFJTEWKV805NQvgyPnVi_4jRw&oe=6A674EDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcMhX6uVJ2MQ7kNvwGvZmWT&_nc_oc=AdpqhyhTsxq7xM0PPRqpP17kNEds-bPTxRqXlWq__OhLpeV64AljKjoaAEmBuh_3Fzc&_nc_z
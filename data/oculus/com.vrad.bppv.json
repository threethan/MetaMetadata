c=8EbMpDIHRS0Q7kNvwHpJkLW&_nc_oc=AdosdQDgpn11CtrFflxfLzs1l2PsR6uTFClAlbG0RgePA9_CDdoaFubtyzLeW71Egd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_fe7Bfhb5Cv1GMhTPRakiJryA0O7EFVCaU0hVOJ_IRQ&oe=6A48FF34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLMp30uBYScQ7kNvwELor4M&_nc_oc=AdpnAmCvI7gKV7Dv4PruV2-LuvuzMmudYMIHBrCQhxpMOx4TCU9NsTUeJO0WsRXmSEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2OUI8CPUjAJq0Japea-x73XZ8y6nqwKKNVB_BZP0siA&oe=6A491D1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AShThlWBdK4Q7kNvwH6MC1u&_nc_oc=AdrSEemZmDDfP5brDKhyT-n2bwfyV_n4bROG5S59C9yeuGr0bRmsI3Dztk3kT-IUDlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChmEsEui8FqevlXcrsOU2uQ0BZnNWceW4v7O8kWhqWPQ&oe=6A492AE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFdHuyGQpvMQ7kNvwGF0Lyq&_nc_oc=Adrvo2sc0X5Q-Vcs9Dg_vGDoUFnGNuE36jSiqrwmQ5sue0y5V7z_Ums87ZqJfi6qA_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBOPwjEqchPfgHRX_T5_ZIULcaxLq61Y61w7jJvBE6Lg&oe=6A4924F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsM3GtNG0jYQ7kNvwE5Qapw&_nc_oc=AdqrWLjfoUoCxCDSf1ddHsp8sslQztnNdPkKl9vvYf14Avl-0T5k8cfO4wmVsY6JK7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOO5F2S04j4ILjAKzMAxegHL5cAq-6YWTOx3rKFvWe7Q&oe=6A49349C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq6hUrJYv6kQ7kNvwEH6sJa&_nc_oc=AdoHMVJ-iEhUFoG_6CooarkSfnR-WpinGCR4hDJp98ugAkxcGOLu9aEAiMrvaE-LffY&_nc_z
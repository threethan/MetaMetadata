_oc=AdpqwNrw7QyT77Bt5tRsz6IoQw3bL1r3D8e7QRWo_5X8eLZiLnVxxTRb8oFEnDifAUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIrAdpydomQSK_VYjVBHfpsIqFz5J-vALk2EymFd8ntQ&oe=6ABFD1E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNtYe5n_XZMQ7kNvwES3Hkm&_nc_oc=AdoEKLdmmGyb83qfWTyQ9c8Wx2hfrZ2iFFjcddGeYh6r1ySHXR8q6M0XvU2IQvVIkjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPooNyLo6vA45b3YgMLeXRK2ykwCQZIJSq3UV365Et0Sw&oe=6ABFCBF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS8Mp-iUJIkQ7kNvwES2-2a&_nc_oc=AdplIYvd9XfyKzdWrRUxRNkuGS33_AHHV7Xob2PDSjOYjWbsuGjUYkEdk-ZOVJtGfCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOfry0xZ4GFS8iwKdoZZhcPI8tT51hMx2XS3Cri4ihOA&oe=6ABFDB9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmiCJW2gFtsQ7kNvwFJgPvi&_nc_oc=Adq6W0z9zBy0ZFd44EbwGA1kW6cSjQUZncRQKWTwGiMDUGGRoX1ZSevIYHyjUrIQmnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgLHn2dhtU7xw5bappeXeeC_ioWMhZhO3svxiWF7_GTw&oe=6ABFD7CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBGh01sLG3IQ7kNvwFFwWRi&_nc_oc=AdoW41AogGssK6fWUGR0MVfVv_e1u184LXq_zPPpdtQ9g6jHQB_j27ufCObLobcI67g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO79dQe75Y2bmQ5RVaTu9vqyOvhyHi3d-J1SkMStReZg&oe=6ABFCB99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV4J5kMBK7sQ7kNvwEF7RzU&_nc_oc=AdpjvD9zjabXDhjRey-5XNHmP5pUPrgj
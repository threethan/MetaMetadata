_oc=AdrOpGl8xIBmCR7td3ZQiI3liEz3QNVs3M7ObvmledlPafiZ_p4uk9WOY7dJOB5-Zf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMobJltG51n7edocP23rgpP8DEUk1JN3pR-yJbFUg83OA&oe=6AD39864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ts8cQDE5GUQ7kNvwF0FQAk&_nc_oc=AdofnNhUT0FvYDig6wHKtsA6qS_zMRbjuumfglrbBH-fTQ82eu2x0eSPBbfiXRf3PUs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDz4GSeHxu0mZjVYC0RxI2bUNNdoSEIaJb9CcwTVKUPg&oe=6AD39277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esbwTKFSymEQ7kNvwGqUhC-&_nc_oc=Adq5YNPpmbgIL0T_lFyu5tO2xnRcE2KMnzeHVhusKnDnlQlt4dOhlc8FDR9ACxB-_-w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe2us9IDFd7ZJe2mDZUm6YL_zO0-IX1ZBG4HFwdMOodg&oe=6AD3A21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwJ_0ky6BZUQ7kNvwFH03Kx&_nc_oc=AdrLWadQ0XY7Hc41r9dUPXk0BEGHLslwhyVNuP8UrC1PisFr40V98qutCEPNJsTnRk8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuEq8xe9t0ob69hNzTH6fUPWfOJFvDyfmkiICEqdrRUg&oe=6AD39E4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slWbIPMRkBcQ7kNvwEit15L&_nc_oc=AdqA1S8yPvFTl01A7xM86dmTtT7-L0nl-J7qGex97K424BScWY29uxI6RGTr_yMyDTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWP5G6K2nFuO6mHbhjnkC2N5k4E9Q8SGfV9XphfWQoew&oe=6AD39219"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv4ajn4D6hcQ7kNvwFIAP6U&_nc_oc=AdrVrdDBTUvtn-6SrO_LrLeoUhS0Am9l
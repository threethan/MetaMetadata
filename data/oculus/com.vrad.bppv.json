c_ss=7f30f&oh=00_AQUIRGxiz8eGlA2XgXkAba3iyYx3GVHfkT8HeGsMhhsB4g&oe=6B0EF874"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfaDSpbqdKQQ7kNvwEZVBOB&_nc_oc=AdqfnE2pL-g8FKLM8nll3ESyyS8MAOwzeL_ub6VHQZtSTleU8ZHyD2P5ucD1CHrEczg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUXAoBiMt0NEzQMvw4rtR-0Rqsb_mOD_TIn6X5eFfTpg&oe=6B0F165F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBoLqlwLKrQQ7kNvwH8R_RB&_nc_oc=Adp1ToRYanZ4LryiPiw4UaqqxW2yN1sQX9IKAqBYkQtGcVjPZFsmQ8wUV16Db8rR4d4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCFDIxOscl3FYuoQbVYzb6JOXifR0NnXN1A22dFUR1DA&oe=6B0EEBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFffjvH6N4QQ7kNvwHY_Bge&_nc_oc=AdopM_6cWoG9Z-IoBihQSPKaD5KWP3_MfgvfuX5rksuxC3njCLJRjdkZhdZHPDtPjSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjTtmesNUdtGK672GhY7_3FxMTo_otc5QVTWmvgZrpiw&oe=6B0F1E37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqVn_9KSLIYQ7kNvwEdYZwi&_nc_oc=AdqdvpIZ8Bc4eerYF6VgYf-ivZDXy7r8ogjSsGsPq-EqS7JOUw-pcdM99dfFpWV5mI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVk0jTIj6XZiB5ri5aWt0nx810Xd42oJjtfbZVbS2ub9w&oe=6B0EF59C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lndOMEqG7wcQ7kNvwEewAOe&_nc_oc=AdoZlo-5zmKBZVNl98zTFdjEJgKsZ--tPs7ZxRZB3Z3ArEmoMZVPoU8gSsfkPzg42yE&_nc_zt=3&_nc_ht=scontent
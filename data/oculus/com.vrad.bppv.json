_oc=Adp5QmBgbFXLin9svqt8szJxpYnEeuUXKXWYZWOMU0EMJOgIj_pF8yoyaSOqsID9P0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRJa6Bt8ruoUHuc4uxKXzC2gDXhKVsgmDj11Rh7C9QPQ&oe=6AEF47E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7zBCRf2YwsQ7kNvwFhTtHi&_nc_oc=AdpE7zoR_8JGNdWY41adKPiBav17dtHPSam8czzuN5GkR0vgGwVDY7stwAQARD9NEhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTqQy9xpYjoWkQD83AFVn6M0H8JwHreiYgNcqj3pANtw&oe=6AEF41F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KgTzrjpNEYQ7kNvwFYAlVT&_nc_oc=AdpOegqd6EOcwRV7LQ5t-lwhPZDYic-RcGY-rT86Q4rnZ4cHe1THr2HvncNgqB3Wxic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv_zHbZwCYL0df7RPM6U_LmtcSOf4XzK1BidZuaKXGLw&oe=6AEF519C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTmRz7j6T7kQ7kNvwF2VqK2&_nc_oc=AdrF2NnG5LtQmi7FpmVc1Z0X5qSaX9HvB7GBoqgsn5oJNuCKPgEZ-gKafM3uIw2x8hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPUhz55J_vB0GrMs0ZgL3mbJLVJhvi9glUPt0-jeUZ6Q&oe=6AEF4DCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf74QUrshAEQ7kNvwH_Fc0v&_nc_oc=AdrR6XQIUdWsiaR3pKaT1lUC1eRd40lKfoibhkmbQsG0F_wF4QAdeNUmi4Dc-cGtzpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ0cJDqTfUTuRDX6LXO1IEPI7qcorGewdH9Oxjqfb8DA&oe=6AEF4199"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5wSGQctsM0Q7kNvwHkG9Ta&_nc_oc=AdriiF-JBxILGQyFczGvJHw-iXcRco1L
_oc=Adr48VQ2eM7wER2sD0oQn30Q6SCZbCTbySv05WOWhO_3e7AA2AHjgjg2dlDdnr1AMjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-erRk680lcIlOOz59zemHZTqEp09h4tQjSnvkCEsmlWA&oe=6A259264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RqwDtCg6WgQ7kNvwHrZFyY&_nc_oc=AdoEhuNzdy_REyp0emdt1Jg-Bp2AAWfjXxEqq2stYL_4PJfMg9puKhcqXwt222JiVQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YQUBGGfBEhIpQkUvKlgMp93dTTukmJ-6RPQeWToAFQQ&oe=6A258C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwENePdg&_nc_oc=Adpj2KWBq8X58KzgpjO2ECwrtkiOJ4yy1byKSmFFMWkSzaNQYZ874wsBbboq12j0uz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N_mL57dn8DcfYVLI22tUffrNvhQ8vMJ1b5yvdCr8Ugg&oe=6A259C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3ZDzAO57MQ7kNvwEp3CgI&_nc_oc=AdpJFnv7GAdugSRoQ9T9rcbWKaz4SeSeyEYLonitfaAFuQdnhkFrB5FISELGDuZQ8SE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af848pladVaWcG-4a1axnsjsfuZSiDcWSIMAjGJ2u5QB5w&oe=6A25984A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoJo4VZBIJcQ7kNvwHx8qC3&_nc_oc=AdprsdF2IhCOvVfmgJwyQmirHWtKinG3MRr0VAc9S6X6JgF_hF9H7xaT6bShXofDKfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gtJDvUdWLTYH4qeMawXKrn0TN0b2S4AaACnrDZ1KChQ&oe=6A258C19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVQ3ei1Ybh4Q7kNvwGaBdkN&_nc_oc=AdoKry5qKYhWV_QzQz2I7QAYURkmpQDZ
_oc=AdrtLrqAUu6sG7PfcRJGeQaIc2hxSOweHdi1H5A7IQD9XUPealsvJtrFx692tcFE3QQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OgAVpZ_cd0RCRN84hleJhYd_TxG1CDzT2CmAgunmOVA&oe=69EA06A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtKC0Ua7mWEQ7kNvwGUw-Z9&_nc_oc=Adqb3CAqgCBhWhGALOGyHxzwktNlxyvFROhPBkaH9-zorUycR_aXoBuXGAZTfSg7LIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XV7zrYili6p5qXqu2JNf-c_4PRfq5uoI1nGh3oRF1dQ&oe=69EA38F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbfSgBkCLUMQ7kNvwFcaQeo&_nc_oc=AdpREzs1skIDhd67XVAYCX_uDu4cqXq2gxzAZwCBBO8jovJvZnofzggHO6yZte2lDVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14vFhZAZRgluUWjgPrrGh6UTjS4S2BO7sfaSzYBROBbA&oe=69EA105C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfubxBl5wEYQ7kNvwGnWbp2&_nc_oc=AdptWbpLi6eUFD2b7vSaH53P9E1j5cmT1q48r2cEQffkZIjonp-HvWfm0moxOm9ZqUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M0nEXvcAqWXShfYg0fHA4FM2ETdyKMd0CDKV7RlFnBg&oe=69EA0C8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASKSWYUOqOcQ7kNvwHH2c0_&_nc_oc=AdrYVZxAv2hCjiQ2FZ7FJDnbRguzsNC6ELeHUBLXhR_eBAGcFb_UzZ3VxirW_x1hOYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w-ZNxxCt0gXI-Ni6q5__oiNQQjeW_q8BKWrzeJUYACQ&oe=69EA3899"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixzpqm5wX1UQ7kNvwEdkP5h&_nc_oc=Adqfsjs_e0opX_EnpB5fkiP3PUpS9k-6
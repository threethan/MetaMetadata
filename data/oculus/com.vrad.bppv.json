_oc=Adq9NCRw-JKaK7fOirArUiWUYWFqp5H5CsWt0novsgemDURU-0h85eTqdE9XLFhOtAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SjTorEONZFJYOX6yHksjrQKeKiaTbTAmollp-KShuuw&oe=6A3FF064"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc9KwC46SdYQ7kNvwEl9HFx&_nc_oc=AdocIyNOSca3V-95acAIMQtwl10PUu5MGkMgmgFPQZXET_qXgqLya-IeyQoYY2-NTEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EfWJUrRfOiMPKOmLMDPC6U6ffoEHzRMV7XJYrwlWuig&oe=6A3FEA77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXpdnZdg-kkQ7kNvwFHH2oE&_nc_oc=Adq2cVc-qi01tCH8QJd6Qlgnn_1Xftvqp1fPy9VMyTdXk9CtXAbVurZkk1BfyFabNq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92NsdvfoVpCjqkEELCG1rtiPdj0HLbJqr2H_6DLdvPbA&oe=6A3FC1DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgoY_DJJooUQ7kNvwFQ2DvE&_nc_oc=AdqGCiEP8MKuzJiribbsZWOMyyhwon3gc11XSVdkmC3w7Y1HAC6Ai_RczSQhzgHo0BM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-GcaFk3jhyts3jfITcfoKeR5rqRj5iINQDXR7JoBl6w&oe=6A3FBE0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSt8I4D-5kcQ7kNvwEHASrA&_nc_oc=AdpBfpPxQB48IecWHqYbCk6FbkXAzTsYoVmss-mYk3MCuWP2Ko7zWGoMVWPh7B3V32c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sidFBXSXYb6tuR3Wjtl2QNKymm0zOmKG5E25g0rZhcQ&oe=6A3FEA19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjk-tgVSH3AQ7kNvwGVSMqP&_nc_oc=Ado0XtdWoBgLKAG7gx8JI-P8ERDNsW0Y
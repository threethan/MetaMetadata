c=euSYPcvqoSkQ7kNvwFfhg9y&_nc_oc=AdpDQ3LtYKW1O5nCL0RlQUxlp7kmHZRmz08tpEQxEtnduWfuCj4KOfmcWB12OccUNm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqbdOhkKtvzkmeJ3e_Zcy6gf-IPjUBjaooKFJHCkJbIA&oe=6AAD3134"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy_4MwS6FNEQ7kNvwF5Ltvw&_nc_oc=Adot0moN8JgMGRHo_kJIxIq9rjgZ52dcMKyFdrTvF8c9eurNPR8Uf04EgIRwUOhu6gg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4UncX5T6BIi30imtcnCfjJdQL1w--BA7DLbIDQJ47TA&oe=6AAD4F1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ0-V--LS2AQ7kNvwGAwQhL&_nc_oc=AdrSWQdV7j2uFI_rDmFMbKl5HCGE87ZkCeny0qFohWUZm55ex4kgDLZMleveqaKjwiw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_D3-nGPVu1rBf-m_TzsNvlMZtY7mkpct48k3Y33Blsw&oe=6AAD5CE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cFaAFcnBzUQ7kNvwH9hlNI&_nc_oc=AdpXgCYfCgkeVpwvd2FGT93Kn2lA7WzqM6CyyNMjZpIret19eTTuTHpgH7myfOMC1TA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rLn-ugPsxVQ5LCxEylXpD-_Uy054o24rzSCrOP16iw&oe=6AAD56F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC1-Mb_xBT4Q7kNvwFKTdhv&_nc_oc=Adp_Tn3vrDtzWcgCrPqCf59yl5WVUUwYwA509L8bds-08foOqIbCOINxV510hoBbqRk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfJw8R0g7T8YsrCGArGbcPmX95iYiGhKPlwArfVUZOZg&oe=6AAD2E5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YF73D_1q-MQ7kNvwGG6rUF&_nc_oc=AdoK7Bdh9n-ggoiv5liObXewXGzH-ZJmLMu9fC4vzPI8qn3i9NB3ku3uBvOHwgLlCcM&_nc_z
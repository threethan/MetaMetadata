_oc=Adqyw890PEqxBMFfLeNq64RA0692bnjNZMqdCB4i6YuuiSK7BluLv9lWnctJZ5Kb6CY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPemhvHiMCvHgBrorRjRkbOjnvJpwVDZvEnxfnNGgC4SA&oe=6AE0C764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G0zzFU7VvsQ7kNvwGLtT3H&_nc_oc=Adqr6ocUG9FkrredQAtoONoj4WchcHA7J2HlH5rJktDs4975y9vW79tsQd5WNKPYyt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2CNLHJtnn3endtBtb3Lrgx32OFVJOjuEp6SpaS03k_w&oe=6AE0C177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqLYIzwiQZwQ7kNvwG0oxQo&_nc_oc=Adp06BjzVT2m38EJRmMpAmCWb-mpgPlCH5ttEfHvGGJO2LacV_x3nLlMrM1ENGVNFTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtaxcsNzDyNW6vpLNPn_vbUqaFlFKQcyGqh1pow0NsAQ&oe=6AE098DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnFvBEAVZnwQ7kNvwGe0F6g&_nc_oc=AdrBZ9wj5lmUDRS9fExivesvtUM-7uqJ8SNxXhpoY8Z8Vx5KtetpS8Xr8HO2wZCl5IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZeQ-cN2T-ffgO93xDl6P9Vioo1ZlpNXA0gE6bKcr8hQ&oe=6AE0CD4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOPVfr-ny_4Q7kNvwEtG0pq&_nc_oc=Adp7lfJA0dgNwbCEx1rF_YoyFW10qvD9DPTqr9LpkdM5t547nuiKqhUP2wOqtnbY5Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg8TmdmVGOBdI3WZrvbKFGwV3TKOD-UJkVQsD1k1mWug&oe=6AE0C119"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vRlRTY-eyMQ7kNvwHrdTrw&_nc_oc=AdoiOAR-FyGUxc8_opPCYKFgK7QUsJA7
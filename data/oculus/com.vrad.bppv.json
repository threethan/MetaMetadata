&_nc_ohc=yIPWC-UlcrsQ7kNvwFaR4tG&_nc_oc=AdpzYN-IUK6dE-EG000hq5PPGGjsRU4kcVJqx7prBfNgXetH2iNXWCSPp73usAvxZ_U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNNjqRNdqO0eHE3w525Dtt5SGStyIWlKawxFYb8TgyIA&oe=6A8D80A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwEmmc2w&_nc_oc=Adri2YqVbiyGMkAXCvYkQENOUUt7TrFR7_M7kttuyasdgBMESCBVom16tk2hZzQYyHA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW7gWzaElIerNGUh6Uc1ZEt1m_Am3nuX72q3cxiV0awA&oe=6A8D7AB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9cTJRHPcEkQ7kNvwHZB7xY&_nc_oc=AdrqjUau9uE3HdKlF84KXaMA75w-UmqmwasHQ3d7zppVCuNVHvXb0qjnb9Z1sATlrEw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7d1ecKqEh8Z_izJjyC3LoglFDDxwylTB8mmwbbcnt0A&oe=6A8D8A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwFURJpF&_nc_oc=Ado4q4UiP8JMZT3Gnk8hQ6fWztTRQvjSKQHaIFQ_AWm_xn3qeRKAuLaQ_aW9a1VdNbs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGboRxTBHgaXRCc1ZJ9s7G6QBI1KD-Gmfo9wywOgwneA&oe=6A8D868A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P49NtEy3c-QQ7kNvwFyMoEk&_nc_oc=AdpDkoPBnEmUl4KrqqlPgBQ7M1dTVcGam3pC1aVCR5MDkK8U1t3oA2jctC05zfDvAUc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY_3GbbVw7Q0PGqSsvizJH_pPy2Jm-TgmnaoG0I--n8A&oe=6A8D7A59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQA5B1aGLXgQ7kNvwHy6e2s&
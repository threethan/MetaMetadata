_nc_ohc=Gng09yKbjbkQ7kNvwHuzCxX&_nc_oc=AdlppPPFS4WVZMFQ3mWyXPhk_UDGSh3RmUHwfoVSG5M2nHOaHq8jU2irNSZGbz52bTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsAbXSEU2DTr85ldZJ46-b_vbrBwPho6RWvACTb0vmvNw&oe=699843B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VVurO6lcoYQ7kNvwHf4-Ru&_nc_oc=Adl9B8jDv6C-0SsbifSfHHNpuw26p5d6_eCRNEwnSJn4lmDT_Eb4PTRKrcz8Lr5SyHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvkn2MEyDQKtKq09MXuZXeMIQ4UY6j1Vp5l3GzX_yB9Xg&oe=6998535C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjtqCxxDVB8Q7kNvwEZDK6v&_nc_oc=Adm2q31tdGbNWsJm0JSwnJRefmBFjAXOX7-Zuai_vf_5yZ_Op_0e6FJWeCBXva3gCQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvRCrm9DEBC1UwnG-LUZdjtBsD20fAgcu-31x8ZVwvNUw&oe=69984F8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95lhNEOi9hIQ7kNvwFL4mq4&_nc_oc=AdnRsQkpvHE1tPydS2DfiyjobvQoIJK7hZ1M1wkv1nWzzLfguj5GwRwKk0Zv3pbS5OQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvibVW4He2Hp56VdJkSPwe6T7slG3rJ7SKvUkW-1VySFQ&oe=69984359"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jngJfs2HA90Q7kNvwHEoVU4&_nc_oc=AdnAXrvudrU99bV_VXGGqJjCP2FZVHygiPjiOhvWBy3_UnF0-TfGybrSbCMSt0FoaEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftf59miD1zN_nOlFFlAK360tJv6sGjhHqeECmiI7UmpAw&oe=69986153"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Animx3FbI_sQ7kNvwFEEIzy&_nc_oc=AdmnjtA3GwPWk1uI2ZacUsDZ0zq_S6jP66vyt4WGX
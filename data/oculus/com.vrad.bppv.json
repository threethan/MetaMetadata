c=RQQ-GdVHT5sQ7kNvwFQOuN4&_nc_oc=Adr7-JoJl0ykrVlFcUwE3JA8-745OriExlsv96R9xMXV5xD93Vl98WCAJIcox57iOic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH9JITG6rE7rs22_2h1h46bynf9_JYF8KsGt9N7uTUzg&oe=6A8AEA34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=060o9c8azosQ7kNvwFMlh-0&_nc_oc=Adrc0KM0kOGEN15ertvxo1FpeHvs3uoe8zImI4GhZAAyE840WYdiKo2ryHtWnxYeUFY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzywU3LRFhTC20xl6xc9QpzMTk8v5y2XnKlBT_w0gjCg&oe=6A8ACFDF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5N_86ZhLfUQ7kNvwH4EmEd&_nc_oc=AdohvkSmcqtoM3ArnZonsYWJDXGaaPEkfOh3AU9dgqLZTpz0TdIxvL261kvTYoAFXQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7fzNU3ablBOp3GzPs1KBTXJB-Desw_XOFHSEIJH7bLg&oe=6A8ADDA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ErQaL-cL6kQ7kNvwHA76ja&_nc_oc=AdpDRVxB7SSJqq7TsQQpT20dLqQCH39Hk3clgkqsOzYZkA8cPwGOgt7uadt8Vd6zBvs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1w7XYWbEfBHvj3THbIZahTe5RWhuml39RqT4KiDKz5Q&oe=6A8AD7B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81MVu456kncQ7kNvwFaeTir&_nc_oc=AdpQezpWpt6uj8hwgYn1llq5KNUVVyfzH6jCSGQHFduofmBLfnRCeKKxIG5iZJi76T8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9i55ND_R4md41rrNHntOX3bhEoQy4ZoWY-gAx3Goh7A&oe=6A8AE75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDDOmkfyg2kQ7kNvwEyoXsD&_nc_oc=AdoyYfikIR3MtVoGlAdEH_-Ycy2mN6lGQl1wm44I0g9Sli3upBz-j1AcZhLo8WEEtz0&_nc_z
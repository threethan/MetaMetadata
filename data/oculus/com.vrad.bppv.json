_oc=AdqgPSMD0d8CqzPspt6TA3aAMSwEx7aCm2O4eTQI3KnDCc271UtX44equXV0NEAuU5o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eKyxP0NkXfzjaUdIowMnCMZybIpQOYgnrcvHbsdOnKQ&oe=69FDCD24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abS7jdm-MUsQ7kNvwG6uuMh&_nc_oc=AdrSExtTJIHFbgRUv3Tu2dFCPy1lLOfP1LTNahnMpxH9SndxW6m2vLQvq82eosr2AV0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-ewOchbiZbbSREAp-nrRB8G4u1wHAo_t5F4Rm5ojxCw&oe=69FDFF77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzr9IeYmv0Q7kNvwFYv6lC&_nc_oc=Adph7NXNo9ebpTbL0XOw1qvvyZ7f0mFSiQ3TaS9HrCnRz7F5FpGauTzA0uFq-6rpamo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cPlHuxDUbAj7OykHnf1BWkbZ6aUEqnkuaGgcntQCORQ&oe=69FDD6DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PTF7ccjfmAQ7kNvwGMHG0W&_nc_oc=AdqZ9w_L1dKERFzIDiLA10eWSloxIooSisHxiOE4IXyrCKPPW8PNqdAUSuVAV0n2uuE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p1xYtXKRzc8cTuRhKc3ORozFOKqlJCVpOAo8nOQ_V2g&oe=69FDD30A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft0PSpW500QQ7kNvwHclXJW&_nc_oc=AdprBZe0BZplboQHhxhAqk2fC84wf_dTsGpjiSgl_KjVR4Jq7wtclunMmQfKdhN9NuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ca4_IB_dftngNNp8QTs18d07gUZkewNyOTzC1gMzwag&oe=69FDFF19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puTzcyUW4dkQ7kNvwEIRBC8&_nc_oc=Adqy0w3T1_QLoKolC7xBPqmReIOsdguE
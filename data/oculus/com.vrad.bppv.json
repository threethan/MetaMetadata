Y&_nc_oc=AdkdVSmJCyVOebBgr373Nob8nQUc9b3H1qc-VswqcETrq6IwlHsRhw3Q_lfArrtRu8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTwwiPpZj3U1Fi8RajvmA9vZev0SX2hX-nH4KVnAPQRg&oe=69B162B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F707-LcVkdsQ7kNvwFj1eV5&_nc_oc=AdmnG-Lw9xwsr6Lp6oVshT-E2N66KbqPUb2OdqlNXX6stNOofYb1SUzspEUBoHDsJVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPl4yvEQsmEf-zkJFFiEceNyrbC657D53GKVfAXQj6iw&oe=69B1485F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwY3uvyFNooQ7kNvwE3uecy&_nc_oc=AdmU3eU81c6EN-NPzc0e1WwR6nIdydrXWA_l_MDbsGvjJFyfcycGty8JqA3YZCK6W_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz98nAAGKUuyDB7TXkPbIUlslQcuKWwhblEJkJaimb4oA&oe=69B15624"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD1xwnWDKpgQ7kNvwGRajCr&_nc_oc=AdmUaEmBfyn5x0AStjRqGPHpq5yqLIPIRUbPHaxqVnsx3DMTPtALjxo1Muz-DW9rLXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMWJ1jGr7LL2t4NxHiLxQzzEUri7-mttPriXdURfZCAw&oe=69B15037"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe48OaUYe_sQ7kNvwEGJAE5&_nc_oc=Adn-Xx1trG9oK2_TDbzeepZ8lPy58dTCNU6WmzMlKZ2x2XwD8k2fUlqGEvbOFM7f43U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBNoQPFteiBO5MRK3Df4WApZCqUxE0MlvGP1uXHSuSng&oe=69B15FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFJWO-8DWSgQ7kNvwFez4Tv&_nc_oc=Adl-L9mHCzf6YKNMMaol_HCI-VV3VYHTmgOGO1C0q32ojmBTUY09Mtdcqf1FWsafcDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc
_oc=Adpg7SvvBrp6U8tLBraRfmotgfS1igADTw6V-z3L5hoOShcoJcvQP49QeKcvRqSEmGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD06QgKlkjNErhfk7831BpWEg8asj_kTbqtNhywy9_8A&oe=6AB15164"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AvuXAxKWAYQ7kNvwHJ3J_C&_nc_oc=Adr0XpWbBFrRhc7LN5n9cWiDyEWh2XmOQojRDx8krG2OSfLdNCUxc5160xp9Idx8wIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDmfwBixLM--P8z6b7Do7ZLD8_MRHVIJoH9qIgLd_YkA&oe=6AB14B77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWnAlf2mntoQ7kNvwGGbh_F&_nc_oc=Adp1BlKalcUGz3wN3UOW0IPfcmeCrIp1Lv2_HDv3g52vRdImu2S74imgjM3COQN8_K4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbX1zxqjYfySs5mCsGtR_1MZZ-iC1FiTBQzkTVcd832Q&oe=6AB15B1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_FSOZt0-P8Q7kNvwGRsy2W&_nc_oc=AdrxMGaLH1qn8Bgp-D8PcuiRBgui2UMrmZBuiz1lLEohOXlWrXM8WlBFK-2s3Psh_5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLshd4MIol4-XBkVGFBAEOKSSMDu5U0n-SZYBGiWhy_zw&oe=6AB1574A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65Yaaoc-wyIQ7kNvwEZbP20&_nc_oc=Adq8kAy5s_k5uLixOwJnhgtJnSvYtCW9L899WF69vt5lQK6Zw__2yOBsJaqClCL1e5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhZybFphfJ2vSbLB8K0oXnS6qQkhIi77zw0LXwOzCa9A&oe=6AB14B19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99woBB7kQ00Q7kNvwGQuVto&_nc_oc=AdrSp0ylZQ_w-QnBqGa8_ZHVRz44CS48
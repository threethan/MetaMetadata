c=BgREpst6jkAQ7kNvwFmEGgC&_nc_oc=AdqIf9eT5Ir9dSwfPJRz5tqh51z0s4pLu68N-4KcSVXzhKA7Nhf53-K6WMlPAAH0tak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcdWjAfi5g81iygQCQGpvNhq84kr8Qxili8_fYnqSUiA&oe=69C67AB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odkghjaPoiQQ7kNvwFTZDNC&_nc_oc=Adqqhrd6mFD89cUnl6wgMoaRct9pptD9KNhPlOMBgJ64CXcdVMbYcSlF6xnFy3P2Lmk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm610LXTk3yO-naKmrGTGBrT6lwXWTBYa3AOW7Tg3B4w&oe=69C6605F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8w_OtOnNrMQ7kNvwFx8ArQ&_nc_oc=AdqBTBGy-oDqWhNYHGxWT6HJBipFmUEJvGNgaKvp6OoatIHSuY_ZAg8ixGZBGluffWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0buAvUysIP90J12BKAYsWf0zddDsdtodwAq1DLNPfTQ&oe=69C66E24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z-QO5fEDs8Q7kNvwHKHeKS&_nc_oc=AdqnAjOlTXcAejMcTFsHFrgQ-kqJMz3q2b3mvRjbHiREIXyngRPtsUJyeAPsWwJBe40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4V0i07H7XsgmUx37Q0FTIpqp8bE9gXHyqHT7zMzaj4g&oe=69C66837"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_sPY4tLPOgQ7kNvwFZchco&_nc_oc=AdofXlBzREYj0Ks-pD50vE4kSZ8uQ6t1nlDF2yaDiqZvF0ueAYlqtpL1p75ipUlcAAo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxMIu1yAw2IpszKN-c-DokeTQXapMG4fcHazAxQ1UG_g&oe=69C677DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dnT6V-0zBkQ7kNvwFXbY-x&_nc_oc=AdrqXSbtkqPBxmvaDhWcQstYi067SJvXCjonWaeBQh2xHcSl0CLC57ACIQGxUqJ2omI&_nc_z
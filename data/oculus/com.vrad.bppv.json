c=pMJcY7D7ZB0Q7kNvwGgQtID&_nc_oc=AdoyO4dDOjXU24scZI4T2NlXymZ1F2m5yDHu7gXAwjAu3alNxe3pOFAsF0Kr2N5FZFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqJLgfANTjlqx9de1ybWqEU8RLaECSZvX2v0rS2-FLJg&oe=6A830134"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5475bZH_5gQ7kNvwGt6PGe&_nc_oc=AdoxSjM4sYXA1SWZyshLu_MjDJ5brHGPpVrU9d3zzAhOVnLgF0KZCayay_gPP-oZ3vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3V5evx37a9BeQ2TnjEsl_RC9FXyUaCYIhyCUIKT2a9g&oe=6A82E6DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pljzsw0uIVAQ7kNvwFY5and&_nc_oc=Adp5vOYOEEr0OiirWAS6O0iCINO8xDZCTAx_iu-znRGDwPShu7YWVwNAEqOgRwozmb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERRSkmgECw_Vj1nriX4MQsFgzyo7X1efQNL6OO0iR_Ng&oe=6A82F4A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUvQIhiPBZQQ7kNvwFhFcWQ&_nc_oc=AdoET7jY1ull1Ep4ivvDGx5iXk_Q9a4-pzCA2Kwyc4t9WLSMx3N_gegjjsSAKKXkvaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8MhQpaRXIUCST29SHexS4w8vuj0gisSh8WodULujm0g&oe=6A82EEB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7g8uuGxDcYQ7kNvwHmMPm-&_nc_oc=AdrUqY9qk9INTiYQMOOqBsmLTIoCuugCR6uMsckJqDA01RTsiblDY1D_gqEFbPGeRcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMw-jG3EcAbFibv74PfVEVKbmpV4bSufYUfWsYI1eM7Q&oe=6A82FE5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVc26BwGKIoQ7kNvwErHtte&_nc_oc=Ado20-5kj5gFvsid0AWzgFk0P4f6hg-ZvJGm_ZOwQV1qzwqS3kHwzuI6h4mfUbjU1E8&_nc_z
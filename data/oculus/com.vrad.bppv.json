_oc=AdraeWzqw9CxTI7eA5wQSR4sxbaQBJMVrRPb3fCHC5PHJoop2ffuR1DWQHw9vjBaxUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH-JXkbhWdPTMCPh6NLhvd0N717zJDgTItdprNzH8baA&oe=6A6DDCA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NlR6emWkckQ7kNvwGuoSEx&_nc_oc=Ado0XeKvHICOS2x1-XS6Vdf_a0DXVDoL_SDCSVypeRLoW0CTDkxy8Us9KY9OO0S-3o0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbmeHLuyNcnk3eizP_T1s2xMRfpVgDdsgUdSs7sx56QA&oe=6A6DD6B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7jN9mggyk0Q7kNvwGt6p3T&_nc_oc=AdqpKf7ktCGNwvfM6fcsTqRl8A9fQJhXCxc8GEDJqkcXfmTJkfbxzw3gfsrQrv8vovE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT50LXZeIDV7XG16IUmeCJZG-asIZ3jqRQ3sdDiYLI3g&oe=6A6DE65C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ8RwSkM_P0Q7kNvwGMOslm&_nc_oc=AdqOwdHSVAw-VgZVXH5eRXIZwhs6FsqoVW_wUftBpOhs2Cv-J0jqPMnvjch7uGy9rV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI5Dl5zD-4hW7Sl0W6CQ875RBci1sXb-m2YpWws_YrhQ&oe=6A6DE28A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReDE2E8dpd8Q7kNvwGMN7YO&_nc_oc=AdoXo2N3g7dJK61m0BPkkR2P3fWZOMf4GnTAOEKMpG5F48mjDep9MStwbh0s1QIJrNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrc_z2gqr_WfOzkQAhufO843XoI2zlBIu2sugHxR0lEg&oe=6A6DD659"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEt6eLhKKmoQ7kNvwEAC_oC&_nc_oc=AdqVrwrbVX91p7tjE2sbP6VACUQxp11g
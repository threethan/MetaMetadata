_oc=AdpAIv_cXLVt0-4qESAsS4q7lT5NtYEDCbHOcRYKYsOV869yoX7Sz_MxJ87h8sGmzPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaQc6vz5eP3IebY2K1r7Vl4pcF9Aphkl_nCzzHcKd-wA&oe=6AB69764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnXrJgNu5VQQ7kNvwE345Kc&_nc_oc=AdpxOwk6CwcpPLbb9tuppnvkjZSaO4ulWedVYnfC19ywxaVboNPoxDNz2CiCITbzbQA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbXycPj06sxNthgXP1VU2oMcuKbYU_XvwnHVsfNxswHA&oe=6AB69177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FMSIt0ex-AQ7kNvwFDkRxh&_nc_oc=AdpfMXkzIHnV4NtB2XaxK9SHgKtOQng7Eq4_kr2DE8Mb-OrpchJjMKCnFzILbAIClfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0l3xHbZfV21KmYpUSgTk6m2wbNlu4pQH9hf-IM8fcaQ&oe=6AB668DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnUnfh4qga8Q7kNvwH_amkH&_nc_oc=Adqhmop72pxQMZ_qlYhlNiI8gcZ9EsRL7XWzt7I4WZqxWrDr_0K4rQfhr8ZLfhWEnSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxfEDWaMvrlgSQOhKlMYGSmdHdm7KUq5TwF3s_euB9yQ&oe=6AB69D4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCfqgLgztZIQ7kNvwFcf0R4&_nc_oc=AdqKwIiXro9mRKeH4sJXv17QHo1C_TicLnA9qLvX-38GEeCImaEUuyLvY4bifvddYFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILw0nmb_Ptu-ykmnhTQNLJVMutUXzSZ-Ccyb_-Z4Jq_g&oe=6AB69119"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHcXEKizPeYQ7kNvwHXFGzx&_nc_oc=AdqElNcBalkeONTgV9C4DB4hEanO0dvU
c=Bam9Vhc4fU4Q7kNvwE2oNsA&_nc_oc=Adokay7-3vDpkIP_oCIwdJZxhurrHARejsiMmr9rPOIsL5S7_zSph53STtpiz-3cODs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhiT2iONDkLoXE8-wkKEMvh7rqmOsTGPGpy9VOaNpcqA&oe=6A620BB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiFj6Fl-6goQ7kNvwGZeEj3&_nc_oc=AdqUgS4755Y2w9KtwJiumxCuXPtPwA3vFD2zkYe7vN_VKd7li-c5bPTWQfZKgEJVhLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChw-_Yam-9xDi84QShYcXn2uv-cXfIG50Kdt30sX3wdA&oe=6A62299F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p534xcyAdxEQ7kNvwHmizY4&_nc_oc=AdqY46oS_9cOFi3HQrCcKJ2Jf2hiR_C1iB_GyKoaqU92-IVYyBZ46qjJL5dhRuIsh9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcPWdmPNtaDbcIEhC6zXjM5KewPIQwZPkAD9TuOfH3UQ&oe=6A61FF24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrAkRHXx_yUQ7kNvwFYbdYh&_nc_oc=AdoJaOFUbhu3f1kn_paCrzLeodzP0obnX0mSA2-CRgZI04Xf6JvOyslBtr6cfIxftbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCVopTQe9CqHqkcw2N_hSUmU3iQ4_LZ-A1NH9d8X44qQ&oe=6A623177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZjavaNoccsQ7kNvwGkmvEQ&_nc_oc=AdpJAhKg1qlxKc9FG8Z3eyTIexx7a47zJpF9OwLklaWsHpyrMQUpzzqtYM6rSmSunHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsmorOkYqt_GOQVvKxoIwaI6LoVc9QyuyOlpMBFNylYw&oe=6A6208DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxUsZCT9NAIQ7kNvwF3oxZ5&_nc_oc=AdqfLKETMAkp6CI_engBmlO2-udc5S9xxf3d4ZmNetC1muzRyFQPrBN3PUpgiswJ8qs&_nc_z
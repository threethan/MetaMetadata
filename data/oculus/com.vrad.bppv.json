_oc=AdqyJi83bSK-MMTDSs822m1QY2hqCTFU-cZdkkvBl16Uxk_7E-ztquEd3jxDPGP1DIo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t99GDyFjYVuOfrzusyLqSj2Ys2cnTBSoYaLQP6WA67A&oe=6A131D64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2IHjLLRluAQ7kNvwHLCB9y&_nc_oc=AdoCpteZ3L7h9BYO9f54zIVodFPi0gP5af0Vf1HEtL8VffANTPlPDITZwQFt0PBOsYI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mja_77qpxmHuRW1qTF4SI72w17iUA5Jk_Z-9T-Cf0bw&oe=6A131777"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWoRFsKQcMcQ7kNvwFVIVdx&_nc_oc=AdpxpOy_sozge-3wf5Nizaqsyot5TGPpgV4ptPMr2-FF3T0VopcanL058QWJmPuGhHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5meBq0xis4B4MwJlEbMQtb61v48H5P9Qjjg1YqrhgcqA&oe=6A12EEDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMAMRUdp6GAQ7kNvwG9s5CC&_nc_oc=AdpxDNKsGPRMf_D2UurNT58yK-Q2jAOo5fwuzqqFrTYGJaQiG3q4FNC_z8aIARk1nY8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72Sfqqwwlkub1gX6s9psJdEOXCP1uTEwvfJLUCtwJOOw&oe=6A13234A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Addly4aw-TEQ7kNvwG22BHs&_nc_oc=AdrouM0Rf3vUzhl_oV4D025kcnbcPUi0StC0sD5QKmPr-gJBZ8rTmQzo4ky187oO0Kw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dTZlbREGCbbo2dDaCMjhG4uQ6YX_LZXishM2_zCBgCQ&oe=6A131719"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klbyT9sMa7oQ7kNvwHAadP9&_nc_oc=Adpgql36Q4UWHJdKKKVgK7R_C60V4cSf
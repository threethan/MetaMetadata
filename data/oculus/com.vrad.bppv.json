=8&oh=00_AfzmwJtYLZDnpImPfkepj973rOSMQPxx9wLPF2UAzy8D1g&oe=69B54AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvPqOv7k9kQ7kNvwGefnHn&_nc_oc=AdkEAZ4BPuQOKWfpsIiKLAt-nm0kETsDVdqXzad9iddUhUZOcKoN8theE9CXZgjVlCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz71xmOFObDsvfhwbeFyC7QA98l14LIny5ERSAZ7yvR5g&oe=69B544B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwE53AIb&_nc_oc=AdlgNNDR5H3ypEOm2YMIzaNau4N2g00Id_0awckFIOiwQKGs0rKxBE0qN8FfQ6Ia_Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzplIaJrIB2Rvatg20kZuE4dz0L8ggEPHHgewadQXh2xA&oe=69B5545C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3jQkRW3jSoQ7kNvwGTkCNd&_nc_oc=Adk1MpjEMyyDreAYMLkyWsHZHF-aC3zbGYtdoOxIggvF3R_dBCWuA5a16vc1yfFRAp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwldGxaGmlbL5D2xTnPnH4vzdX_iJ3vkj8Xo6dyOmngmg&oe=69B5508A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cptA8SMlnjoQ7kNvwF51QaK&_nc_oc=AdnXiDan2emy-nGjggmYB5UvFM0hpvw9FjYsltAx_BKgEGfe0g6xG3PlmMr52no_hcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbK8GtlHpTyoKeqeLk7CxdNvJ9jBzXyp0B2hN8T5P1TQ&oe=69B54459"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA1V6BobtvUQ7kNvwHRGAEH&_nc_oc=Adl5UCtzo4hKyl8qv4jV1x3PV4RD3srElm7MOPkzmGutUgq2hKRnvo4IIu22pomxrUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpQvJ6UbQgTtu5DvxwDtw4T5d0HyVfGlXyYNdZOmwX6A&
_nc_ohc=Mai3p15caO8Q7kNvwHLL5wM&_nc_oc=Admu7Fj3ABh5e3OEkb-YgIY-ZvxUyfcJA2O3vNocuC1EChuL36u5yrqjfOK65Tw2TvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDPpvJZn20i83xWlhHZkGx1SnkZ7W0MyZ9yesLQM7_2w&oe=69A02CB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plR9ZSpyzlcQ7kNvwHZZ6mp&_nc_oc=AdlBAg2dZVC5egIHPilp1_3xohwYl-0dGRRXYxV8b6oNhrhA_0ftp4vNWh6ezJjMYbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftu5vXT5ov6gs6C5q9HY75t71s_pZMvIGkYPnV4brd3tQ&oe=69A03C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z9s7dbrzx0Q7kNvwGhtU7S&_nc_oc=AdlE-fGX91enbxDIaH4LbcXdQhhd6yAyCtilqaw_NDRcxyttNEhjDOJdmm6d8EdjGn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP_4Yi4VFCfqKWOsDI7jcd2DE6lcs3g-R9ZvWP0JfdpA&oe=69A0388A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI1zmIgLzpYQ7kNvwFx3_9Z&_nc_oc=AdmBw273JdlShN-gCvPwVFllrbYypTms6r2w3oHU9poa-Er6YXtaQYIZ2zJ5rvcmJF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsB7rRSZrgKUvnL8To3POa5qYZdFrorcSvVmh0KQ7fmsQ&oe=69A02C59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKHxf4208ysQ7kNvwFjbpIv&_nc_oc=Adl1pI7FjswEYMYfyshv_us00IXGpL-IkpLsVJuNnnTZ2mmfTPaK-b1tseYFjj_0d_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9mG2mCOCOBwZRsGhDZ7ZcMGQzHaToRN4wJA18Ni9P7Q&oe=69A04A53"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhOzGwn5lf4Q7kNvwGiHwmQ&_nc_oc=AdlDh6VPjpCHPOClu0w0YZFNkJ-GjipXGSlKxCEP8
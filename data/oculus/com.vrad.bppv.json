c_ss=7f20f&oh=00_AQTAwFSCZnH1saERPEE8HIsqlEQbOntvH2fs7sdhKjDvBQ&oe=6B0077F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slb6F2Mfm8wQ7kNvwF6IqsT&_nc_oc=AdpTSvRR1OzpyNG58-nJZ9AkBkhJgr-CPMFGykA3n-5ygOz3h9kyWBNK6kQ7IMa4bZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgaI2z84EqqpWjdOSBX9K9OQ3yru6TUspwZ26_0uWONQ&oe=6B005D9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69BpZzx8z8kQ7kNvwHapW9g&_nc_oc=AdrHkH6X6h7zqNpEAIOz2nMwoY591DODGYUXluulJDGSL0njDynanGUhEPkoZxXF-kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHEvfzo1hCZLj3jVWxd-RzhrOMvUWNMry7wy5B-f2OYw&oe=6B006B64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iHxgZWuyx8Q7kNvwHXOkaS&_nc_oc=Adrq5kXni80v6LW4iKJyW-GgMzP8D01XarOL3mhqu-OmI9KKfIVUuwdQuaEJ9fKhgbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlBx9wGguh2k5xYCA1M2J3kcGOCjcMo6Ou-9Tr4y-BVw&oe=6B006577"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKpHnCYsG6QQ7kNvwHyC3pj&_nc_oc=AdpHVgXuFOKfuGJwKrNxCE5ylKo2B8RtQd_kKhO8nS_NAZ_alW5vW1V3PDWBDWf-geQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRbFsVrsm9n2-XTdfJYzSeGnYcaEWH4S5BnUDE9catVg&oe=6B00751C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srG9O9pNt-wQ7kNvwF0a0M8&_nc_oc=AdoV_9NEKthKagV6bCbhY5fPJR-c_EM0rjH4mEQT0h4EtMhQuRoD8cD2uUXOcb_2gPM&_nc_zt=3&_nc_ht=scontent
c=RSPhcXuViHgQ7kNvwGtVBIk&_nc_oc=AdqOtlp67BbyxDsINsPoIDCp0fGM0tWiPQBT4NehVgxS1O7LPCb3617E2Dm2YC3dBxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6HtSs_xhx1esQoMFcCMIJEvTdYmD7WOlkTJTAowe-pA&oe=6ABBB1B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMQ8yyTueNwQ7kNvwGeTJVb&_nc_oc=AdrHZvcHRqLRat9QfvdnbOiyZovRfHl5Zk4zed72b6IX-Et6UdJgPADTN2tTJz2ipos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNnC9w_VTeB8fLJixfpesNtrbd-4VQbrXBOAoPmjCUNw&oe=6ABBCF9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmFKskBSZz4Q7kNvwH5ISvz&_nc_oc=AdrcvGUJbuXn9Bgs_xjchG4A_z9sq2C44SUVlkOcrC_H5AeJxJNdlz-06QXE8EgGkms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvDioiuChfWY7c_eCiBaal5mVnNYB5ZrtkC8qolhtkNw&oe=6ABBDD64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU6Lj2LplVUQ7kNvwFahws3&_nc_oc=AdrgR-qOsMy8YXHdWy5thebb_yoInIzZUCwDpuaf2U-Wp4OzjGX2VPq_7UlhE07Hx74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUH9qsmzmdZB1IqSp1_Wns8Dke_IU4m0D0uY-J1aiXpg&oe=6ABBD777"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEKPN6bfqkUQ7kNvwH2WRN6&_nc_oc=Adrrd_kZAH1u0s6Bta0wD7WC8PRs1CRZgTJAeJP20uUmrMyUWcG37QnrJ0mnx5AhdDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIadQwaOgmCCVEjzQZP54KUIm2XgMLZg-P8pFAzU_NNDA&oe=6ABBAEDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEHp9WJJwFgQ7kNvwG3wLKr&_nc_oc=AdpmzcA5fPV5OdBbOslgOJXH_StoJKfnatUJZf6ElEjGQQVg7A-BFXz84y4wR7bUpVk&_nc_z
_oc=AdrJ3xE_4NdpL1FXIRv3kWc6pl-Ry1jTed5FU2h-F2m4IdwOgxFIkySqZ-o1AnVg-Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SJekqBYozhznmDUr4jOiLkHzgwQQu497rV1YODdj_5g&oe=6A2D7B64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGDcdq8jzvoQ7kNvwFHtxlY&_nc_oc=Adrag7F50hFI3I9GB7zFLT1iFWrNgDde_udm265yt_RSuCwncPXhCj6JaTk18HYVgeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kpvJSaHlLOd9-eAWVtkw3V48A3QHIakB8RBBFl4-BQg&oe=6A2D7577"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwHYkj20&_nc_oc=Adrwx94vlJ-uNgHQTTgljYJ3c_nLIyOMLSDRzeOdrhXY04NCm6EY2WbX6XK_2t_YH74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUwcRrx0q9vuDpZi9UXHV2jEyb1GiwOFaiw1Dt1kw2A&oe=6A2D4CDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGonfHIFfVYQ7kNvwF0lMUQ&_nc_oc=AdqDlfDTks9BFfBkgoPGa2ZXnehNOVcF0y6IKCcncQXZPNPzjQgGQ9quWuaIOPjZiTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dnvBhFpcHYT1RjUNxu37fJFRYtnovxjsleaUA2Wc0PQ&oe=6A2D490A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RokRdmybO4MQ7kNvwEIj0uX&_nc_oc=AdoWL7eHmQejINeh49aUtAqz585_iSAEwXNYcVf2GmWGWQ7PWjwn_0eG1KcEJF1yuM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-phhFEMo5HBV6fw8qKSBTRXqo8Xc9WkXHPM0wPPDpW7Q&oe=6A2D7519"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_HsceiHzwoQ7kNvwHm_bc1&_nc_oc=Adp-HPscgBIkFI528bo_wf9z8QXIHb__
c=j83Q9GkuvzgQ7kNvwG1uYl4&_nc_oc=AdpiNpQStGX1hIvG0HxVIrhFZVLg5ft0z8uNcYYAIJZBVuLfz7vGhHJLypxCkZL2xHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BQLiSRHx8fiyqyQa7vomrEnoM8Z8dlRgYTupp7DSCNA&oe=6A0865B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWB6Ek0lQawQ7kNvwF_6vyr&_nc_oc=AdplvhJpFS8HEx_kMju3Wky53WVZvKI9kpup8hHyz-6izS78i5BAsUAABpJuLol2LEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jicYQasihB_SDTV1pfY3hf9ZCa1JBVHDTEJNvDmG6Mw&oe=6A08839F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqMuB_nn9WgQ7kNvwE7_432&_nc_oc=Adqnd5yI-0_8QXfIEsO9EEirGqYu3iUuy-Olg_m0oh_90idMBBB2bJk07cpXQude9rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CVNU33MvOrQ0QsIOtUdCq9aqftVWGSVDo9tWXEYl28Q&oe=6A089164"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z3AJ0OBU78Q7kNvwHTBZ5E&_nc_oc=AdqcxV4spt0evtVpFNtfg1ykb2uaG6-vHpiQWeMhIvEHg6_Ej8GNC9Uy2Gfd5HNJdh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7644la0n0p58VvLgLd2k-A9xUxX1o5xAYiJ-CvAOm7SA&oe=6A088B77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if1i0XJREjMQ7kNvwETOfjb&_nc_oc=AdoO2zNN9NAGbuxUr1djqG0wgH4v6JedafRiqFQE4XwQj_Vkbr7oNTNdxqR1bONyOWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57v873HTBtM1zJ532NGFzhU2E6xVwVILUO-S2EipkJxw&oe=6A0862DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0X4rtvRevIQ7kNvwFYt3t0&_nc_oc=AdrhBCOaMMpnMYwP-m-hAEQ4wNK7VBz6norZcfX9NVnLkpOqDJPWAIGPcRqeCYnWjKc&_nc_z
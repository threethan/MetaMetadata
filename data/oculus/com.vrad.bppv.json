_oc=AdooIYher-d5rsN6-Vl0jjBP2tUezqh3dR923ECgsZ7AClk78X6_NMl_RDgKJZ4Ah0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnQnDW_ttfS0iYacTfWwTp6epu_YnzmQNRP0_m36_WvQ&oe=6ABE8064"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU6Lj2LplVUQ7kNvwFGZFTg&_nc_oc=Adook-SqDxt33crwR0Y1jnBZPJuUFayUob2-u_UTGI91OlbQFG-en10v-lJTAF7UQYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ49XYFprQy5WPlhtCpx9kj6BVDBpIxps2QLmdZBmIIhg&oe=6ABE7A77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS8Mp-iUJIkQ7kNvwEhpSa1&_nc_oc=AdrfrvPXWCt-NEuI_LtnVXtzX7NfqUxzydxc7N_928bP6ObjJIxH4vBcoFl-Akz6Rqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMW2wANokWiWw3FB0J0UERsc-lqrZYVmjT458HQS35Pw&oe=6ABE8A1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEHp9WJJwFgQ7kNvwHfiNEq&_nc_oc=Adp3SA7eQ6vG8K9zzvVTjl8Bg5QssATO6HjCuH8mBWG5n8s0XbFw8M47BEUtMlEcyTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJChmHviWvU4mBwEomJmL0VEoXJAHh1wX7KQGbbLpnEZA&oe=6ABE864A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWlV9v0s2BEQ7kNvwH5PXlH&_nc_oc=Ado69UXuqZh5C26UV8YnoWbHtymor1LepSwMwvkme1dwxSh_t29q68Miv5Xw6l847h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7xocRfstEMJ5rmCzsaGv6iUu2rqHvI2GAl-jVG2zukQ&oe=6ABE7A19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV4J5kMBK7sQ7kNvwFmqXG_&_nc_oc=AdqXfocPczfm76uq1xU4SBaHzGTB55I8
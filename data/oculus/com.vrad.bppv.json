c=q3yTh89LiScQ7kNvwHeQim0&_nc_oc=AdrSRHf9ufSYvIcfMDzGzzPU-k3tyDEPqu_ds34-0zwuNsGYHhYH25lp7OzheNTkY5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLj3ZHGMYOfAVpSlQmJOpphf1CrA-FAXqEg8CIxdWmjQ&oe=6AD3A4F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp-4P6l3F-IQ7kNvwHmKPp8&_nc_oc=Adqux2Fl2HpvhPorS0nxkjR1KNYXQCS5FgCluQFDARP74tS3127YOji5SF-3kDfq0VE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwEDRLN4RJ6I3MMN8iX92b-ne5OadXZ52bNaJAHZg9Rg&oe=6AD38A9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyeAw5FBjEgQ7kNvwFvF3bS&_nc_oc=AdrOpGl8xIBmCR7td3ZQiI3liEz3QNVs3M7ObvmledlPafiZ_p4uk9WOY7dJOB5-Zf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMobJltG51n7edocP23rgpP8DEUk1JN3pR-yJbFUg83OA&oe=6AD39864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ts8cQDE5GUQ7kNvwF0FQAk&_nc_oc=AdofnNhUT0FvYDig6wHKtsA6qS_zMRbjuumfglrbBH-fTQ82eu2x0eSPBbfiXRf3PUs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDz4GSeHxu0mZjVYC0RxI2bUNNdoSEIaJb9CcwTVKUPg&oe=6AD39277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esbwTKFSymEQ7kNvwGqUhC-&_nc_oc=Adq5YNPpmbgIL0T_lFyu5tO2xnRcE2KMnzeHVhusKnDnlQlt4dOhlc8FDR9ACxB-_-w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe2us9IDFd7ZJe2mDZUm6YL_zO0-IX1ZBG4HFwdMOodg&oe=6AD3A21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwJ_0ky6BZUQ7kNvwFH03Kx&_nc_oc=AdrLWadQ0XY7Hc41r9dUPXk0BEGHLslwhyVNuP8UrC1PisFr40V98qutCEPNJsTnRk8&_nc_z
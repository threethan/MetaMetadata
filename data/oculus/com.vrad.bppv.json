c=5POe8kRFTFMQ7kNvwEhO9hi&_nc_oc=AdrRSFpbBZhNcD0mxN8ZN42t5tFTHEPzMcBhE9fGi62BvwcGbcfzKzL7tu-vhx1wKy4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5VawGXHKsgwy1D-FLXl3ylDfvOy28bUX6wxhPfVtGyg&oe=6A973834"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGny7UW0UwYQ7kNvwHEs6i_&_nc_oc=AdrtZZeT7b50YT0YCOO9MduT4mpWDLpsv1b1JefFSjAJ1zZ7ZD-KHaVKusl8qZWAdPo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDF0QIpgEgJvG_7FsJ1RzsHaW606ZfgVOg0O1EUSxVyQ&oe=6A971DDF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjA5bs2cMLwQ7kNvwGDgzSx&_nc_oc=Adr456hKFscM36iUEwiGXREOtZ4tI46X0I9dKP7vb91nTEoNgGRtivWM82CxPYZbos8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW1KUxjVBusPnewqXsnaD6dQ66COrddfqm4xcJm5JSPQ&oe=6A972BA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_QD3-sCxc4Q7kNvwEJtgT4&_nc_oc=Adog8ToewYmK5kJkVIGSgYaytq2IgpgR4Fydv_mbaHr7ef24a9QdTf5qGLoHSXzfsF4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT_KfmPhUqiyAP3cyWTXJS6IZ4J0SSg50p6k0wbz03oQ&oe=6A9725B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JnRoe-_7oQ7kNvwECXiu1&_nc_oc=AdoN8CJlsoa4sIuytf1VvDB2UKHLMG88y2mDz75oryWps3vHi470gI9p_3wjdYNy8rU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEecBUoWXqmn95tZ015Fg_yWs9T8CYQ6ybJEuGgGJ6t_A&oe=6A97355C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg3cBxuhWgQ7kNvwFFndUF&_nc_oc=AdqSvVleyqzOZG9flKbzDqQpfm-DEokSllO_1AMwN7_A2G4uwd20tJxhC_ICOriz3r0&_nc_z
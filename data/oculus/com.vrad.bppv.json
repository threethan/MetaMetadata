_oc=AdrWDnCuDsihd-N7XGyiqoysRv90DAHlJ50kXlW7BkB_qUaShU2lDkEYRMIyaG6t_II&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JAZqukacXuOOUweJDuAPY5NM3PqKnt6FRncsLOMxdNw&oe=69D24BA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUZ8w4uRVxkQ7kNvwFlLwBw&_nc_oc=Adq4NPe6f-mTZFi8RZe1wrDbNPtOaWjHmjcB1u5b__NXQ0U-fl02Ot_CeKc6ogLR2Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mU4F896e-j2ewHtWnhGOIMhuJPVtEi9xQL21XhVturg&oe=69D27DF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZC_VVAsTwgQ7kNvwGrfJ1u&_nc_oc=AdrmJoVpxSVI4FRCMzg788I_lb2ZWGNpJnTOakDJBGsx7jxnhr1IZL4F-tCQdfizi_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bRODHfO66exgNyzT5fzl--o6xOs0DrbM7lOfUX-2aRg&oe=69D2555C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxnLvSDQPO0Q7kNvwEOGdEc&_nc_oc=Adq5rujS-7zv8Tn37GeoHsGSsugckEsYpyNgfRVMUxyeBrC42NInG0QaCM-uIDwiP0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vm-rqQjCMvz8kb6s4tgkGRHRmtqwxvRltXleVyF3Nog&oe=69D2518A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CISPg5XYIjYQ7kNvwGKsL9I&_nc_oc=AdoZ596-TMgBPxb_6cYRVfrdk8uPWseuqpX6iWtz1GXHYAM7TskxbIIST4gZTpKfgn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ReLQdUCVdMzFJaGVwdv2QXdODzdgTViIdabckTt1Yow&oe=69D27D99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U60g0UWA63MQ7kNvwGG_jlY&_nc_oc=Adp7n671qdwlypWX0uNJuZ58m5BrA8UX
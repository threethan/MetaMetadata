&_nc_ohc=yIPWC-UlcrsQ7kNvwGCfhXY&_nc_oc=AdqkffbcFTsXTwRFRDZFiliqygZ9yHOdUWbnU65LwpLozPssmDH6eJq1Y2NmjMeaxb0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ4f5jt5X_zGFMCq67D9clnyp2A9S7pfAU28phLuXGwg&oe=6A8ED224"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwEhMwPt&_nc_oc=AdoI3ap6HByUicjbE2dA4lLQ-y84HrG222CcAa0O_KK-nyT4iNq948zjKHS1Dm314vQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKX86nZs_lcK_suln4UgM7vLSRKFkbD0T1d_cuIEK0RA&oe=6A8ECC37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9cTJRHPcEkQ7kNvwGOq_ck&_nc_oc=AdqjQ1I5ucjrsjjlETkKcWXpv8z_P4vTHMNrW_Ca5fOEIOa0N7I4QKW0IsSRt2uV37I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaDvQkudzNSycXdY-rf10oxj2HHXbxfKphjZncSobT9w&oe=6A8EDBDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwE-_QUh&_nc_oc=Adp6Aroh_Fd6HTZnTA2ybdRmAUlijLHog52DWltP0isclC06KfYp9UHnghrwU_a8ngs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt05WX8euEN9Y3uhvNL02Mae5lcY3bjC5cPOd2K8n3Yg&oe=6A8ED80A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P49NtEy3c-QQ7kNvwEnmF5T&_nc_oc=AdoWfrxz3Wq9WKKhZP1-sG0gzPCR7S94WF_BAn5eTmtHYs3zDzGJsP_WRGERRMFwnRA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk5RkkDJ0mOfrej5Mc4hJwemrYjjMRMoEVEHHKxcbZkA&oe=6A8ECBD9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKaTaJLwVg4Q7kNvwGsfflr&
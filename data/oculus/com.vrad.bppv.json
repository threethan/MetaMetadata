c=OCKafu8ZPZ8Q7kNvwHuwfY-&_nc_oc=AdpFcB7-0R2kY6y2FpN47gJuM1x8kcKsv9I_UGv0Svew_t2ZVwtfleRcbEcONBuecGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bO7UM4JuhfmhhLQJ7OUTET1WPV7wpjy2wMT_i4CiMFQ&oe=6A144334"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXu5oJg7k_EQ7kNvwHsopXc&_nc_oc=AdpDVeG6CZmOwMG5mB9791MSphi_UcK5ZVn46HNQHLG3iO1pnRfbH0VUWyuWqSDaOaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yLtOBfYskch3ATJJTrSy2r-1KMHOWcAmJ3bp_2nm90w&oe=6A14611F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0_L4ov55SkQ7kNvwEZluLZ&_nc_oc=AdrG9hmdqs2GLsj4GNimsD9G20a41364ots0ysnK49Q2xYKyZDQFdWMz-DM2pDadAYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y9a6QbWyF-F0JL2MaHzysvj0YZhmhSZE_wBaqFjGQOQ&oe=6A146EE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2IHjLLRluAQ7kNvwH1VeNx&_nc_oc=AdoDKcB98MNGxx4QCDKXwPJ-AgD-F03k3kI_tIYIQ-J--1fP1HdudAp2ReRo6kLbrWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p1NINFGU23iR4s9B4iflzQm9hVidbj0w3EJ7eoiEhkA&oe=6A1468F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWoRFsKQcMcQ7kNvwFK_Nh-&_nc_oc=AdrZIJsywfl2tjw9aTyQW18OVGbGoTQEnLQukTm8_jBVdQFPFeww4y6xm1-OxslyQwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C7jQT5U5jzXet3fqPfVw8miCCU_6y0lUMdiookH236A&oe=6A14405C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMAMRUdp6GAQ7kNvwEmOr75&_nc_oc=AdptVYK1as3tIR15om8vAVYB8TVYRoC_Gb9BvWJ0jMg_rhxjrwFM14w5uGeQAc-gI3I&_nc_z
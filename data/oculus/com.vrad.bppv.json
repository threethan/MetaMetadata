c=AoI4Fr5LWG4Q7kNvwHq00mW&_nc_oc=AdpORRpQeQvf2Dr5iLqdJtLV_HhoJgbwsYnTvWnzgnCq7rdvJbNd0lk7nnihJuPlgWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cGc9ha4-jkqg8cUaBHVIUQdeqplneLS1Vey77l7ZIHw&oe=6A2020B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNSkfztWqeUQ7kNvwHFiD_z&_nc_oc=AdoAcPgs3pnIPBKE_Kn6XdrbkB7YZGzrRKamxwpxW-49X_RUD5UEGwBB-6wCUX9AMU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57pQdxQSjWMm3b_DETAEyM2Iky_2mNOfp7Mx1l09QpmQ&oe=6A203E9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3r3vkbBmPIQ7kNvwEF02qN&_nc_oc=Adr5BgunDbWi0XtQTlLUwjDrT6pShs7ICIwojj8U0yImGIzExmh6hbKnoPyrCesFo2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TBqLt53D2Lzt6rTHLiU8VYZY5nDOWmekx57GffaoOyQ&oe=6A204C64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlHZ9ZPxOoQ7kNvwHSCOT2&_nc_oc=AdpVpy07PjCJaUy-WG6ts1Ha0HsT3-22JS7YPKLdwncwdzvOquIUnG4CR_i2Z-kpX2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4phF33wngz8meAAcus43TVXUParGNFx_s0BsIPkbg4iA&oe=6A204677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZyiV92gPHsQ7kNvwGjshJA&_nc_oc=Ado4TB_FVyhmc1siNaFm47Q2Lonk2s_O3N7ML4_AG0Q_AVX0MnM4tqO9bFerKc8I7wc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wie2PBMyuNmS8vxrWVPj6STUrpe6SHQSbIDnqj03Zqg&oe=6A201DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl_CCI3grGoQ7kNvwHcFINw&_nc_oc=AdqcLsvblHjNRwbSejihSOtfbNjPsOx6skfT0QhN381HqifsLumuroLEta52htwcf-A&_nc_z
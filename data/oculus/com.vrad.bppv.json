vU6z8cQ7kNvwHjL1Ru&_nc_oc=AdpNCWYbbe4ndhyBobsmgpRP0I8AO0RXkcl2UQ94oie16ippUq4VMPP54ugEBnVKDaA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB_1gvF6bOQxMbYv7Dx4PVJ85Uv7bOjq1GKSTPLxR_fA&oe=6AA42264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn7-b0xvKQ4Q7kNvwEUQnO2&_nc_oc=AdplN4F8i3RQlc_muJgycjsdkH3KP9gM934j56FTGFdT9a3Se2HrV7j4qvZkgJW1ELs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9CWcJKI8pTZnCMZIjkZhZLjZ-6ejbAQBogKKP7-v94Q&oe=6AA41C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1E2AGl_9vwQ7kNvwHO2I8b&_nc_oc=Adp_Plp17752kBRb2RxKf4pXmFnNTWnMrdye7WoKMcvTM5R-eaN_BM5Ja0ykdPx3wk0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS5v4Y2XQ_LDGSdsbe97SNaM_CJQdWRqd6dbQjiay6xg&oe=6AA3F3DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ4fhJCS7oUQ7kNvwGaXFij&_nc_oc=AdowuAH37faxvefC5YG5Ymt-OdawKWtJ2sEQTfEHccJoDEtxWVu5x1QeDJzwE5H8l_0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8eOB4ckXbo7o-AYNT46ETiZfpKMHXb6u-hKS1SXSHRw&oe=6AA3F00A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdQh5T7iZ0UQ7kNvwFnYKs_&_nc_oc=AdqXPN9TBFaNh1wFP9Ehharj0SW01wowECnkRQI7vY6Q3WxsoU-IhD3QA2CfrKt4CZA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMNbyeV1AJMGR-d-8_9QC2Lx7E_hNUAV9mLSizqnnN_g&oe=6AA41C19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwVwv_QQZwwQ7kNvwEwSe-2&_nc_oc=Adq
_oc=AdoKyc1zk3tl081atJ6IWODj1eOtD94NkRH5atXiDUwI9R3RoSTfFqJywB_tUuy37F0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cnS0EKrNZbop7iXXi0qFbHgxlm20hTsK5A7trsnvnmA&oe=6A1711E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o24Zk3r7JJkQ7kNvwHKmsFM&_nc_oc=Adqh6nlNf4t8G9iBXmd1ZW_FjAUA0_PMC7t8KIJ3w4W8FpQ9tKO5T4Kzoj3Z0mWOEVI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xMPxj8CKGr5MfCooW-zkEFiMAP_orWxtNi4qbrwtSZg&oe=6A170BF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxcXlr-2O-UQ7kNvwEmFcsh&_nc_oc=Adp0V2D6_AKC7tGWrRS6hs303MMQdX5r7AihIgQdwJR62CRg-bpHX4xJpxzarTLV1sM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49ZWIwDCaeoxZrIANu7CvLTRhgNzJwtO8FnnR13jtHHA&oe=6A16E35C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whqpxj3Cf0EQ7kNvwHdf7pj&_nc_oc=Ado7J_fEXdK76Bf6MyiT3B6bqIH4NA1YDEPGIBIlhSEwUWR5icsxipFeeiSO2wrWnt0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sipYSGqwBSHr6URVcLZPUGldE1FFqxKc-XEMnn-caRg&oe=6A16DF8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ym24fxtUMQ7kNvwFXs5hy&_nc_oc=AdqC7LNyk7rySUEqSzifOQV_KQPQcUuaoshk6zp5fVDo8I0LXluViNWt3zzjqOPlOhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TKmtbxmMffxi2v1Xwu_jHKhfLAORawTU9SnXALXFMyQ&oe=6A170B99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klbyT9sMa7oQ7kNvwFeU4uS&_nc_oc=Adqokpor4t5mG1d_vGh3ppUoq1IGCvfG
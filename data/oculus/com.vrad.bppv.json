c=JC_YQz7h2mYQ7kNvwGGUpDD&_nc_oc=AdpeT-p39t9iPvQqkvrBDFIi8I1mcZon1PYt9pPojQxcc42IBDAaUOyomt32w-0bmbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMidY72IrSvsO4BZowwavYXY0qAxo4xg_eHSkD7Io3oHQ&oe=6AC675F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uVoY67JuCoQ7kNvwHZU0cg&_nc_oc=Adr8MlyofFv0YeESX4SXjsKu_10S_jgrxmGHsGhxajhcLDfwfTTZTXeJGjRZxLCWyEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP01rO7LObgJCpInupKzmE7N8POGrfHTRZ0E_AJl90gLQ&oe=6AC65B9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4jksbcklEMQ7kNvwFYKQms&_nc_oc=AdrFYz94t7uc3EXRrS4_wBCCqt7rbUobnSyiRiyaIRq2EOSRa-ETcgmBgyxqh-YPblk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDe64dQA8PSHD8HYTSvQsLytb-XiWQMt3dx0DL2WmqTA&oe=6AC66964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOvaHD6pYYQ7kNvwGJG48c&_nc_oc=Adp_b7EPy-Bpviz-ruGE4K7gLM5z1gmpa7dfip7aaqV0eHmnQ70DcWBj4lb_snBnPh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv98TOHQfBrry3AutIYktLRw0-yh2enzKbtBtndLoGVA&oe=6AC66377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqb3mNUgRQIQ7kNvwFaB5k5&_nc_oc=AdpUDLaZrwx21nVNsakQS7tbkzXTWHZR5BEH-yXJtzHFSjtzA1uFAjaHDJTJL1ltXjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIUl1aHe79fpWlp0eUKp8wbkq3YXzpIcknSurVkFmEKA&oe=6AC6731C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfS8UCit1sQ7kNvwEkAFtu&_nc_oc=Adqh9E2_Elq5YfCYMAXXPJWTzoTDj8GQuUg3lgYQRJzBMS-7rgU04c8CnsagsUTEFJM&_nc_z
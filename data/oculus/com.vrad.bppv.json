c=VnQOm7zm8XEQ7kNvwGErbBQ&_nc_oc=AdpU196dEpf8K55zIUIHFElqDYqC4mB8C8ctYSX6k68upEZwSnkWbMjxt2qEiMwUjfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VLpC14MshG7-p2g1Wxsr0EHQbmJc_F3y-3Yirf5jVUQ&oe=6A01CE34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXxfB0G41zkQ7kNvwFXnS9W&_nc_oc=AdoXT0NkXYHcYAxMLCQmTcIfHMNQNVT5Dk_95oI9JaI_OHySf95tfeK6pB_hfx0zATI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DEaj4aFGXoNVP1DSn50nJHksq8gPzqFbdMVISWIwKtw&oe=6A01EC1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZrUiB-2EKIQ7kNvwHHlGPe&_nc_oc=Adom_mjn_1fwvNhhMxnaxC8TIkZSox5Ef5LQpk0xSwgqIl0EJ-wCm1rxklzeqk1aWEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SVVza4hN2eDwfFRuHA8t1B89yLoLGQJXFz8vy06Mz4Q&oe=6A01C1A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhI9F5_mcuAQ7kNvwGW1l35&_nc_oc=AdqnvlK8i9bSt2SNxemegamrgZZ70iOdc3XjlLl5hf5DMEt6vKbLnw98vwNzYxf07eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k7eXHzBd_Low8E88Zoqjl0vqJvMWI50i4yCkZaUZxgA&oe=6A01F3F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rygB2GntLo4Q7kNvwHwtt_F&_nc_oc=AdoN-w0pRIzoCLLFWQnbu88SQUdG4P0susUF3uKjRij03owiGKpcKPFZ6m8NaN2WdCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-q40yPrEYn4AXwRLQXs7ujfx_jrmol0pOTlTLlzKRcw&oe=6A01CB5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IniaMyQfd-gQ7kNvwEW9jMi&_nc_oc=AdrDV1bqZHQAysjdavNKjTr0oV8bfbOldxNYGhXu4lmfi-WOa_RxEcM2ynInVfJ5HrM&_nc_z
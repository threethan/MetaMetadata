c_ohc=TuJPrYK7PfkQ7kNvwG9DDcx&_nc_oc=AdoiOObobBLs2iBIirYkFIZT4-mw0u_eB20zZopcv_UbFidYsFKhpAhEjK9ezn-hiOM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vK9S1RwVesJOAipvwhTIZ4mhriy7CRtRX4hTlbdrntA&oe=6A392D34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyR84BwyNqwQ7kNvwE3IMxi&_nc_oc=AdqfIe-EUBiznqLkOHxR-9TTwZflGkrYZ3Le0IPLRmvlYGRsRKdnUKtoCuTvu4bUXsM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Up4iLXZvA2ixUSycIsCZJzjssKSjHetxq9Dk-xAPk4g&oe=6A394B1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkfy8wXMlFsQ7kNvwH_QcM2&_nc_oc=AdoP83nOnEFdU-t7m-aWTuG-K0ZFBjhef4Oet0lh_clDM4HQr3k0Y7k7b-XIuz38JPI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CWldBPeVVjPiYhMbY8ioGJ1gL9cpwmVsZLYB4O674Ww&oe=6A3958E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7ds0b729IQ7kNvwFnmj8Y&_nc_oc=AdrEMYXVNDUoELnGoUFysNcc_d-X5uUc0iDyjTYXUEsd5ehXN0cs7qnN0eAXEwwIFws&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SuOTntz3oelGsnoofFhx9aqhmUnTNtYnX7YQLWQKuLQ&oe=6A3952F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxBF5BBbWyIQ7kNvwHFiSdN&_nc_oc=AdrbxOr396l2PIm-sY6SrVqW1_otoi8c5ygCe0Ms6tr1Y1BuebSWfJ64XwrQb2Hdv6s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BP9N6qGpEW6TYqzf2BVmrt65CUFZjP6oCWLH7kIWxqw&oe=6A392A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kR5t1P0mOAQ7kNvwHKe_on&_nc_oc=Adq3JzGE6eLhi-Oth-t5LRl_Va6aZubhw14Xnwb6lB6-03qySsq8GiNCvMpXsPi5n
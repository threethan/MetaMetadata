nxJIQ8Q7kNvwE3bWEr&_nc_oc=AdrMX2u0LKZbUvj-K11-ghdjTF3AgCta86YM5D16Fqk2Mkg6f0whUdCodH2PNyR9foA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoSpn75Fzy9Nab0hMb17FclxK4PEmdcDvT_oX4YbcU9A&oe=6A7DAEA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwHOSfc0&_nc_oc=AdoWNPSL-lEaCu1wJfGyetRm7PmJR09oqrwAil5VhUBnLCmk_7Wz_dmxaf4moQJyzPI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgtjU8fZrlBjzXwCa8H3Nsy6R0akXr8lS1CHMq_D3INg&oe=6A7DA8B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIR3UyBl8AQ7kNvwF0aBGY&_nc_oc=AdoR9KtQf-Gx8eaL2nKOc4vrjXZ-qjTCvnmbvFYfOZ1NgB0snVyOMN6QfuLuiST-Dtc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Cs0Z3MAtUghKumvQ9Jd1ChNQWeXUyZoH-Q6T3Mr2aA&oe=6A7DB85C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwEr8gE8&_nc_oc=AdqTB08lDo9813a2k60ij11zrv8570d2190iCZs6iRFGWPR6opoXb7xkSP5d0jq0Yoo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsdNrzQGmBH9vazZ25PMUZ1cXiwU2nK_93UC9i2W8tNA&oe=6A7DB48A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXDsV1qgAGQQ7kNvwHXi_LM&_nc_oc=AdpkZ96d7JRS6h2rJo-eAZXKr9TKORxb-5wAkEZSzwAbBHjMWZR5wHUU0bVLaPDtFao&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdfD2siH5xy571EbYKfwkNh7-FdqYTnp6FRA3khoocBA&oe=6A7DA859"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKHc9LfMB8QQ7kNvwEWb3Ha&_nc_oc=Adp
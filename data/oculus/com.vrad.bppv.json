50Vfhd-AqsY1O6FVXyt6Hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0DwWjkG-Xtlxzdox0aNaZg0SXfopkOFNCivX2coWiF6Q&oe=69F0AAB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygyZURc03KQQ7kNvwE89TUZ&_nc_oc=AdrISYK-2z8tSTCpNM4FuGMht_Vx3-QSIz836tX6hqmc3Om6E_jURQ5upPBOBYimq_k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1mld-y7L_TFYaeHhNVdFkL-BAefU7Ceq7pRchOjRlZJA&oe=69F0C89F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rwtCQm6ab8Q7kNvwHx0hhG&_nc_oc=Adrq2dAj7Xg5jSEikp9JikxB3xtiyCVY_iceN9R2C8tfeKh7dmJfKLWKR9hR5558c5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0SEqXKuMcL2omcZiM_FKQHVdl8it6xwKkd4RKYr-lQGw&oe=69F09E24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8n3YdzjcLQQ7kNvwHDLJ4E&_nc_oc=AdoletJydD97TOJfzp77Fk5sbEpD9ESmSbIapfbBJHe4Imj4sIiQzB2R0u7p_s1ewvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3XJfV2-Wk_Q5MWVcizNshX3_skZdofOOKFYYd0T8U0Uw&oe=69F0D077"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6EmkTYiDIUQ7kNvwHw2Y4t&_nc_oc=AdptVMZvY7vMEzddLvU-vEaKUXDtYfMAH7xX24OQTjvpc8CA1jnel4K-Q7_M98sQ9UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QejJI6fg-TzFN6taKDOBwdJPAxLhddmLvmoNDSOsuVQ&oe=69F0A7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpJl2ji47WMQ7kNvwG4_VRv&_nc_oc=AdpYJfIMuNAzTE_tMiw0Z7Qv31jCUf9vCotX-6wtiE_Vao5MInXjPQ0vMyp-2QOORRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0GvrreC6nmoi-l6RYCQz9o7J3_EqOGUjAvkqm8_u7Ktw&oe=69F0A40A"}, {"file_name": "015.BPPV_Back \ubcf
c=pm_32OK5FtQQ7kNvwFquO9A&_nc_oc=AdqfOppd9Vjv2zw0j967GIKrLq2JE6sNHLA-ZJ1ad1aRTalKKhPoTaowWr92q5p5HaQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rW6HSJ2rVGdQl7gLHrbByMG1ChPJksh2CHj2Vhd84sg&oe=69F49F34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emIl2hv23a8Q7kNvwFBR4Jq&_nc_oc=AdqTOKasFs5_XISKDrE54kGxcQnVg7BmmZErop7CHAJSbK6GhjtGtqZYgZU3bxpmcyE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zUFiJls8DLeJIM-owWp9GngUrG0rWJXtS3eAJItMdUQ&oe=69F4BD1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ram-Hp8ub0wQ7kNvwHunqGB&_nc_oc=Adofbq67xPaLaHEAvYr8JEZpeIaJNlyWHUhbDoAMXRObn2bN0L1-yyC20X_oqExK8eE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WcjleL_4qAFr9ecI6_R0_tMDnMtY6ZmcW7pUlICWyAQ&oe=69F492A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpWFl8KnMFoQ7kNvwH9DzRG&_nc_oc=AdqCjoFzodnvOPdp1Y0L15oXx4smFgKQRQoGx1El3ovEh42STWiGxK8KkeT1vhryaRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GIdzPDXl7Usu1Do8q1hIJs_V3TZV1m1mlL_nfUWIYTQ&oe=69F4C4F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47BbRuQCcqYQ7kNvwFUXNIa&_nc_oc=AdpuxZ15wwOhCeYQwPyHMPdmfPB3yXWAbOXuudVD6Asa_R2Ge8P-lA6I5KRgTggjrUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bvWnFg6dlowFQ6aboxA3bgVnOMRps1L1urtvcVGGBWw&oe=69F49C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmqKuoOtpS0Q7kNvwH-DVx1&_nc_oc=AdplgRPzfwLkOhjpBZmY7a5HtYE_1y_iFPHMA13-Q_7uV5Ph1x8x5NG5HxX6KabJTFQ&_nc_z
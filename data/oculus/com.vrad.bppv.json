c=b0HW8OFg6bcQ7kNvwGD_6vY&_nc_oc=Adox4PK1B8YO0h6TM8zCfDH2Aa6gBiPlOocovgrneLfbpwbURKPrkDjxJkD3W6Vv_lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V_YVIUKaXw9_HKuxgrZsd9eEY__fyvpj7p-yWpITh2Q&oe=69EA1334"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmienrRDPIAQ7kNvwHcRhkd&_nc_oc=Adry2OwuM8V70jXHimObm8jIpGVga1hqu-gOE3UUfoL3j2YRvU-3XgOqxSa0C90gJ6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i-KV3oVlO85sIcdrj3WvTCxyRJAT_-EQPuGI9ckgL0g&oe=69EA311F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVBAPxE4hMgQ7kNvwHaQrs5&_nc_oc=AdrtLrqAUu6sG7PfcRJGeQaIc2hxSOweHdi1H5A7IQD9XUPealsvJtrFx692tcFE3QQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OgAVpZ_cd0RCRN84hleJhYd_TxG1CDzT2CmAgunmOVA&oe=69EA06A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtKC0Ua7mWEQ7kNvwGUw-Z9&_nc_oc=Adqb3CAqgCBhWhGALOGyHxzwktNlxyvFROhPBkaH9-zorUycR_aXoBuXGAZTfSg7LIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XV7zrYili6p5qXqu2JNf-c_4PRfq5uoI1nGh3oRF1dQ&oe=69EA38F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbfSgBkCLUMQ7kNvwFcaQeo&_nc_oc=AdpREzs1skIDhd67XVAYCX_uDu4cqXq2gxzAZwCBBO8jovJvZnofzggHO6yZte2lDVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14vFhZAZRgluUWjgPrrGh6UTjS4S2BO7sfaSzYBROBbA&oe=69EA105C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfubxBl5wEYQ7kNvwGnWbp2&_nc_oc=AdptWbpLi6eUFD2b7vSaH53P9E1j5cmT1q48r2cEQffkZIjonp-HvWfm0moxOm9ZqUU&_nc_z
c=AufGiL-iLp4Q7kNvwG6S7Ud&_nc_oc=AdpZB6paCQMeesbU-RLrB47Q13zODrI_ffeYSjlNVhvcY_jiUW3VkpT5Dt0g_m5pFR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pyqZKzkudE7zpnoRrhhuxkV4BZX3BJtXt779_X8EnQQ&oe=6A3EAB74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Dg55uCEzPUQ7kNvwFTyFnY&_nc_oc=Adp4_noJwc7NVi1vlUoYbF3L5mVhCsClbqgs-2fBP0OzDNenowfRRtNOlA_RzNQ35ug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s4OgEmSW389j3C0CR4bZ-A7fA-7HyXUV984OuE1YWyA&oe=6A3E911F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA--AaYiSlcQ7kNvwGM74Gd&_nc_oc=AdrgqM3_lhbTlS82orFi2sjZpVaiW0PnzKnLbqvadbKwpMSpy_NTk-JO0sj7GTSUZyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsVg2M6X0jDibSFjsIC4Hha9zNaeZI7T9irLlszwxAw&oe=6A3E9EE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc9KwC46SdYQ7kNvwE-fXnv&_nc_oc=AdrMQ4N5tzVIyWAYgs8BavNsMagYGQ7IV-DLxSaM2dPMJ6LNeiwjd3aPGxLMBGCQMPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQdPGf8kCbGYwbgpUGsMPzj-Gk6e-bEcHywwYBerV9w&oe=6A3E98F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXpdnZdg-kkQ7kNvwF3fh4T&_nc_oc=Adpjle1VtTlcSdUA8S18kKB4sH-MLgAsUWE-DwPkGGblecW4PdDXsiOt1KTbcpO9ga0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RtLoDg4ebXK6yASc4vdz_01EHs5tJfSCVa7rM6jOUCA&oe=6A3EA89C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgoY_DJJooUQ7kNvwFh-4Zw&_nc_oc=AdoazyN-7yq03gB-KUc5NYhMI-LdTIW9SRRl6taB1_xC-rC9RlskCG36qKH_1f8NcqU&_nc_z
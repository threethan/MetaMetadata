c=1hz-7mkHalYQ7kNvwFrDEDr&_nc_oc=Adpai2EYyv5n-sJaZfXYFxqlI5hCQHmaZCBYNH4F7oeOEEOEY43f7EwANRLTpaQ18dg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxzKODxM_hdqcAh9wKCke7-JaDQI2ZkiRzKC6dN0EYoA&oe=6AF9E074"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlJVXcAzFA0Q7kNvwEK_QLg&_nc_oc=AdoFQWrjq_Q9UMNsCMoQhdsYKupY1VZC0n2jKvj2pIoSObhRd4MzESpCqtDcR2zGVQ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUP_XdPMSR5FeQGcIf9pjdfQnLOOfIVQGIKr4CuVyAoA&oe=6AF9C61F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79fwdeZyYsEQ7kNvwHKj8nf&_nc_oc=AdpoRvlHvA0YiIswhapk0xVnnEnzn3E6kF5BnjnWjpjRgMTwUDRcfU6YW0MdOv27Gao&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6jx-uPbVJi9SFXpP_sKxNofFbjKUKJR3xGxb3c8hRxQ&oe=6AF9D3E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwGeiyNL&_nc_oc=AdoMx_zBcDfS5RHFPxlT-2vxDiqGfUhpa3IUt_67vuJZREOycpZb6d0ZwDRJttItRBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaGH9FdrgBmgBourjg-NEcUerxktRxZCeSvGyPadJ-rQ&oe=6AF9CDF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjnRGCVSO6gQ7kNvwHwdgJ3&_nc_oc=AdrM2nBgA9DjoXnUg8zKZBGJjfaGSG2N1tFvrhDftylsXc518gGJ4rcuYMn1GbrfbJE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoeHuiCjnSZD61Lsk37Fcek1wCVQTQSI1GDMqoEuDi8g&oe=6AF9DD9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFuIJ0E&_nc_oc=AdrT440U3XG2zoohSY2zD0w2poTHEbhRk-3b6MfVJweev0Z6gpFqxX-DKVMR0S701pw&_nc_z
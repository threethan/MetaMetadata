_oc=AdpSmaCSsDEJ1ojO9sO8NxdlUewnfY19ldRMqQ7V4rjMcc5JGGUO75CaJB_Xurb3q3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Kd_-4xjEG_8jx-dQ-PTN0FHJoZYbTWd8p5fhgfguudg&oe=69E61224"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8IovrZP1F0Q7kNvwG-0LTH&_nc_oc=AdrrWhDyWWsM3Tb-p80tYRI7j5caKjYRsBzT8Eto7eLp1WffwoYw54hxn9-CxM3A--I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af239lmwsd1bw4y8cN0TcmKTkhAkC-j1_qDy9JeqRjhTRQ&oe=69E64477"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gtHMNDsIOkQ7kNvwE8cbhV&_nc_oc=AdoKv5B-Sv90SOfgzAMRIe3Z8m2LfYWkOkmCeWHYeOqVQGSVwzXOZamRVbPY-bKMvuI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ElmSBWompzCbY2LUZwjfzOCRnOV493P-Xm0NYm7cBQ&oe=69E61BDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6N5p72j_agQ7kNvwFfKM-a&_nc_oc=AdqsX2DVpv8KXCjgz6b6dsvn4LGNF-xc2rVM1vvCT_3am-yp1xgc5rgWlCbRQ_dzM9w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_IPnnNUkuniRxqWJQ_Wezz4NQGYlaxygbHTQDJoQMyA&oe=69E6180A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGAOxo_RrSsQ7kNvwHXk2o5&_nc_oc=Adql_zhJzStdlLwQY3cACEHkr7KPIK86AMnRtRy1kb7yhE1_80H2_1SbR-GFfgTqSx4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rCv4FU2jhLedt2_zyYppprKuP4Ig9ag_64hp-yW1IKg&oe=69E64419"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWXYjgE1ciUQ7kNvwGlRYc5&_nc_oc=Adqq41tlkVLnrdPy_6wy0-ubWS2qgl1g
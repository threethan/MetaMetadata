_oc=AdpoRvlHvA0YiIswhapk0xVnnEnzn3E6kF5BnjnWjpjRgMTwUDRcfU6YW0MdOv27Gao&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6jx-uPbVJi9SFXpP_sKxNofFbjKUKJR3xGxb3c8hRxQ&oe=6AF9D3E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwGeiyNL&_nc_oc=AdoMx_zBcDfS5RHFPxlT-2vxDiqGfUhpa3IUt_67vuJZREOycpZb6d0ZwDRJttItRBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaGH9FdrgBmgBourjg-NEcUerxktRxZCeSvGyPadJ-rQ&oe=6AF9CDF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjnRGCVSO6gQ7kNvwHwdgJ3&_nc_oc=AdrM2nBgA9DjoXnUg8zKZBGJjfaGSG2N1tFvrhDftylsXc518gGJ4rcuYMn1GbrfbJE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoeHuiCjnSZD61Lsk37Fcek1wCVQTQSI1GDMqoEuDi8g&oe=6AF9DD9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFuIJ0E&_nc_oc=AdrT440U3XG2zoohSY2zD0w2poTHEbhRk-3b6MfVJweev0Z6gpFqxX-DKVMR0S701pw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_9KmBCZH4ByT8syR_g8am7fkuHWAKd8xRMsiUxu7XtQ&oe=6AF9D9CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdY4jSMumbcQ7kNvwFunVEd&_nc_oc=AdqhJzVelqUGXI54GXTSYhsr3dwCrzZivwOvmzumy7QA6Hjr2hFVS8_vGxZO-HbiwGM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRykpTeDe0g8KY3L8BsNzKB4ikXTayVh3aXcgSFDDwz4A&oe=6AF9CD99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlooS7QVZs4Q7kNvwFi0ayj&_nc_oc=AdqlSdcfDxu78SiZTvXzqk-t_YtOEY6w
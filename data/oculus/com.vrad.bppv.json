_oc=AdrjCQsYIVleIgQ1T9pYFgv-vzyTBJyl4tZxa8p30rI8Vq5-xRKw1H2Yk4CXX-qeV9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QpaHTVMZe6pXkb-X8G_Y1P1NAwpCCuqLQxgEX2sm47A&oe=6A429364"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzz4wDHwU0UQ7kNvwFfLjmI&_nc_oc=AdoKkROpT-Yd5uM0yjoemH9xcqX2W8Ne9d6mDmSV77GsYXNE1BZBc3ZVVdFkKmWSpaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7QUNA4ByWkMZVM7cho_H6qGsy1pdZoFqBo6OExe_xWw&oe=6A428D77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjXhdYUBsL8Q7kNvwHOgQ-1&_nc_oc=AdrVDgLSLTzGmqgUaXZr3maFSMZETrpJg_VUiLu7-f_P3lTttWZpnAIGjzTIax6CDns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BviRC10yvZPCG1BuO2m-Owinz7_k3z6TpBMRvzduGTg&oe=6A4264DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nMe3l9TJMEQ7kNvwFfSdSQ&_nc_oc=AdohnQ-hZe4PcIF8w8i_VUhl_RBKorGy867sR37V2K2HnJ6h0nOrUAw5QeVqAyYiZWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D_9s1F2jSfzRnPYsH2NpjOO0jxfZHHMZK-oXVD2YoZw&oe=6A42610A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvGOevbkNhYQ7kNvwHU_Ka0&_nc_oc=Adph7i3wgyvGeDLB780MSAagjG_KsrexefPa5dZ8BBEYJTVQ_blbY2aO2HC-SDwx5X0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e5S_1QaiwLRZUkOwG3gEtE3BqbN0A8MFfWz0wVeE-KA&oe=6A428D19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7srB2qjzncYQ7kNvwHixt2w&_nc_oc=AdpjZ-9siJ_F1htSGnZsUuO22tO9EbGk
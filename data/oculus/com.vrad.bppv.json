_oc=Adr456hKFscM36iUEwiGXREOtZ4tI46X0I9dKP7vb91nTEoNgGRtivWM82CxPYZbos8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW1KUxjVBusPnewqXsnaD6dQ66COrddfqm4xcJm5JSPQ&oe=6A972BA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_QD3-sCxc4Q7kNvwEJtgT4&_nc_oc=Adog8ToewYmK5kJkVIGSgYaytq2IgpgR4Fydv_mbaHr7ef24a9QdTf5qGLoHSXzfsF4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT_KfmPhUqiyAP3cyWTXJS6IZ4J0SSg50p6k0wbz03oQ&oe=6A9725B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JnRoe-_7oQ7kNvwECXiu1&_nc_oc=AdoN8CJlsoa4sIuytf1VvDB2UKHLMG88y2mDz75oryWps3vHi470gI9p_3wjdYNy8rU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEecBUoWXqmn95tZ015Fg_yWs9T8CYQ6ybJEuGgGJ6t_A&oe=6A97355C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg3cBxuhWgQ7kNvwFFndUF&_nc_oc=AdqSvVleyqzOZG9flKbzDqQpfm-DEokSllO_1AMwN7_A2G4uwd20tJxhC_ICOriz3r0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUFlQAVYJ6WW8vjDVQ2QtW6vGlUQ2YJsVWcVADqHNmPw&oe=6A97318A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o6RToOyge4Q7kNvwGNnvK3&_nc_oc=AdrdzlUOGTWp4z4AY1IUWBgII6XjUFDaaqKFpxXHdU7mW5AMo4BFucqj-4sjDqbEb-0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzn_28v_VP6SsckOQyJYU22lPTyZA6L36fQFAR543cHQ&oe=6A972559"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0CGPLMA1YIQ7kNvwHMMe94&_nc_oc=AdqF0APd7GEYkVecWzZqEKAyUfai1yG-
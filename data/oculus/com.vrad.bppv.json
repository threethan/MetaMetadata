c=AoI4Fr5LWG4Q7kNvwG1rOb3&_nc_oc=AdodHMn2sZ1P9D1K9ct0QnP5zbRHtRMxMcpW2CwRTI6UyvqatUrgG1HQAP5XlaQe3k0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tzr8s4DqXjBR0rV2vua6ZF1BGZK_l77wZeqoYHV56lw&oe=6A1ECF34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNSkfztWqeUQ7kNvwHIPdIA&_nc_oc=Adqh3pt6-afzJhQVLtYhjEcWlIFmjMu_WhCs_ihNkdBhcTau4ErELV_-V1SkVp-3jTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cWthiufuxsHA98QeOekdQIxiKo4FkWoOG1X2ICKUuog&oe=6A1EED1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3r3vkbBmPIQ7kNvwFiGiRB&_nc_oc=AdpGvjm5b_Ge5kBmEygKsXKvtPNwoHmzRZAc89AgbefObcZIN27XJ3H5O9pRRo42EIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RI_nep6f6bKCVAh0xV6US5hO0-oHvt29sBT6DomCqug&oe=6A1EFAE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlHZ9ZPxOoQ7kNvwHEXzJC&_nc_oc=AdolRllWYY9uTsLyuwR8Q1myIPWdTRMFXc3tkgs8AydGvJRZkLjUVJiki_YBniJkQJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IIEkFiQdejmvxHbg0WSYGqSAiFx20Y-LDyc3mGXwL3A&oe=6A1EF4F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZyiV92gPHsQ7kNvwE-CwqX&_nc_oc=AdqQu_hZlFzT05J1ckPnkKIyVWA3mYSnI80PfEKR3mbCqSARkq__syI0kap39wy4Hes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GFmq2NR_fb4iGiCi8X01WhAWd1F0nrLECi11nmQIcdw&oe=6A1ECC5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl_CCI3grGoQ7kNvwGRbDo7&_nc_oc=AdqSIeXPBYpQGCkdvdVZxE1wNAYstMqRXRoNQ37kK2EFvQAd3zxOOl6R9NgfszxDW1A&_nc_z
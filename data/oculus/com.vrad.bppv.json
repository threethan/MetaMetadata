wXMlFsQ7kNvwHVia80&_nc_oc=Adp0zBGGDwl0bP0TW7Lq2u7DGZbHKC4PbL_4wy9IHxugNwUt-6Vq55BAHAFyuHs0b3M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jORwNfMENlPcHTXZWA04WtW6JeYYIHvcUldVGZ_13nQ&oe=6A36B5E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x82ivM7-5rYQ7kNvwHsvYPQ&_nc_oc=AdoONgZK2bn1JF0CSzmTpr5O2uXRioAXD2YFzFpqdCu42REP7HbRVlo_A-joYpXESGM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eu0-qmt4w5glAzRSfpHZiPyITW3HI0kMgwr-vMDVlfw&oe=6A36AFF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxBF5BBbWyIQ7kNvwGEK31R&_nc_oc=AdrYJr1itrqlZf4tnaa44Q4254FUHl_ZDCWEe9onn5UktT7nmbkbMQhgrbX3X88KuBA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8suwxsVyRmhU-u9URpexpRtwS40Q_UeHr7fwtqM-z2CQ&oe=6A36BF9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq_xijuuGYQ7kNvwEqPxB_&_nc_oc=Ado2SClnYaoF7lehGhOQxNL1x6ud6vAFXAnpZl1KP0nOLKmjNtw4XT8JnM4lMxTBVOg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LTUff1RM9aOJK5y7HNXIW3KJ0szqS_V-iaE7epe8wWQ&oe=6A36BBCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dpgtTV-nAMQ7kNvwE5wYr5&_nc_oc=Adr9WYbMynahzTEmMPBCO3aeElTcfMz8p9D654AEWK49wfIT-B1nkwzToZXlFST4jsQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g_1BAC-KiidmwixukFETZaStS3EyQfpDOJ7woeQlrmQ&oe=6A36AF99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM8oCK2Gu2wQ7kNvwEBw_R-&_nc_oc=Adr
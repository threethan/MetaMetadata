_oc=AdrdedjnZ5Pa5u6gzIOR9-SSon2HZJwU6aUkd6Thi0X_pDD5pGhUrQFCk4XUToyfWUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXzV2yNaUJ4j1rDDtDP0yfie_CnNuhTTnYoZZMsXFmCQ&oe=6AF88264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwEKRNRv&_nc_oc=AdqRPilq1wxBcu839omGcPVUKq8aeTfIoSwIwx0ATtwVVxg04JxM4gQeeIODEt68pc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOn-F-GXNeYzfKWDxx2iTJlU5Ta4AMt65rARYyttrY4Q&oe=6AF87C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjnRGCVSO6gQ7kNvwFeLfZl&_nc_oc=AdqX7L1e48mqx0c2kWV3UiusrHnFXJm6vG2SmaWHbecvXG_scrz4HErLdViTMU4r3t0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT29kw4exkKQYS9dvZvy7bc_SWqMsehEdNHEBd1Q0JbZg&oe=6AF88C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFvFNQq&_nc_oc=AdqANzD7oVoMw7YjolXumrHoFAJPh6VwXHyyY4rVeCfHvqTn_0ZH6pl0sh4_OhwBZxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcJ3GN83sCqdMwrysa5ec06H7flH46HzVUpdvhY4gtaQ&oe=6AF8884A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdY4jSMumbcQ7kNvwFQz2Eg&_nc_oc=Adp_7-BnMPGpa_FCS82muZqwOiABPRrs1jnKf_Ouyoxk0RpMQrp2T7kaSdv0891Po1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAxp-jxRSg-QhI_GGjfofaqyNyO2cSLz7mYrO7H_85Yg&oe=6AF87C19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlooS7QVZs4Q7kNvwGXsNoi&_nc_oc=AdrBE5obQtFlO0L3-7xLHzr3tdETx-o9
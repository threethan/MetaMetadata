_oc=Ado0ldMrC8733Lwzoplc9Q4_1zTfCUk0gqxrH1DeU7G3AihAdgVzFdvVM1Yxkf4VgJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjfdPW8nUnRZxCK-Rr0tI8GxcCILHizrxfud_LtMWn5A&oe=6A69E824"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwrbkeG1gzgQ7kNvwFJKn7J&_nc_oc=AdqbNOyIiMqj3Bn5LC0HcomU4RhCxCnfWwFx6YTt7pZOLl6bkEOWJVFmhwFiNHTeV8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS_3JmtUmYVGQDUclFbwPmc9XAm9LGH737QYgvONyYSA&oe=6A69E237"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5cnmwrrnQQ7kNvwFhhKhn&_nc_oc=AdqPStVHx1JwmbI75qEmVbzEQjT7n_T8xvT7xqLINqiVxIbCpDm_BbmYXYyhPRDf_yA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApBZ6XqoERbxQQ875vOWs9vOLIcQQwzUMiM5RzO1a6lg&oe=6A69F1DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP9jAs9Ep4Q7kNvwG_r0kg&_nc_oc=AdqS1zSfdmCdyur9mmZ1tOoFPdgKLH5FkhhPtllE6ojvJfzGBLLi60HuNwqLDF4dTuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5JkGVqLSJi4oBw03x2fJXfvTJPkBsG_n0JUhnnyDkGQ&oe=6A69EE0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFyDIPlwC8AQ7kNvwGcLyb_&_nc_oc=AdpwcSNAAEX3lu-r0DP79YHIWFD7ClsJ9PgMuPfen4uUV08B91JpxvwWdIFEarxvZnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTh0-HMfLcXss87-UAIEa0gTXvr1Fwbg5c_U8KzY9U8g&oe=6A69E1D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msO2zbyGVU8Q7kNvwHic5wf&_nc_oc=Adost8nKVlsVxXC7Bkq2ybGzPtdTuFR2
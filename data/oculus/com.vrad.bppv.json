_oc=AdoZ9VzjO5ra2RyXVo_utBkOxyE3VCG67jdWEyRUsvFGJMjp3SceV6Nw9G4AN3U-pnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kOUb72Uxv5bmzfmk8-cotjQE9jZkY0AsbYKGwB35SJw&oe=6A1DA964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlHZ9ZPxOoQ7kNvwF_tNyK&_nc_oc=AdpLfkRJJORygJquXWbDwI6n-HsbaeBfwvHj6smAY3oATLQBIM4xcQnvJH4vNGeDAG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gCZyXeAO29lWbhaaLkydsvVOEkJB_yIlv9TD6CwyIfA&oe=6A1DA377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7iLYoi3a28Q7kNvwHVLrwH&_nc_oc=AdprqWBbqhtdtcAvv7DLQafxaVGJYU88AnIfswToPFH3oNIHsop74I8YhwEQNZW_D28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eolDZRKF3MAldDd2sX2Ol3t_i26z6UNPuMhFQ_a1MqA&oe=6A1D7ADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl_CCI3grGoQ7kNvwEJWT7v&_nc_oc=AdqFgSgj_vxAnaBsjby6E4K-IlQPrwMOkOCPDxkg6v1Cxus0y3-5Bu-Ls277AncHApk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_N-z_JluYt3ZravBIDYxqDUVl8igCeT3aMx1vjPb81Q&oe=6A1DAF4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqtiX6vZGSMQ7kNvwGdkcOJ&_nc_oc=Adqss4pkZrf-3NfwsrYnwt-p04Wz8z9azvtGsLfLBb3YMvnhiM_3bcPIT1-XyBIMUr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EI_0aBqeG3wn7OOBBVSmPQ56hTWpXUNVpr6NgtngZKQ&oe=6A1DA319"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_Pd7Debg7wQ7kNvwE92UDQ&_nc_oc=AdpqTc0DY35Hv3XZG4NDsnpI2bE3TaXD
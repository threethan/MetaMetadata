c=8InHxSzdWVQQ7kNvwFqqrU-&_nc_oc=AdregiM9ZWte7tnjiC7e0ZW-Bd_TFnnl5Jj90maSlQ_oHfS41JWLm4Xw1-lcGVG6TLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIGmhcYLxQi_75g2wVx_VGRk_7qr1m0HGDKYXFwgfHGQ&oe=6ACA6A74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGyVm5mI0o8Q7kNvwG_hX-V&_nc_oc=AdrkPxDTXDWbGKaIwVefTFM150ZtzKBO8f4F-141Eg65lFcgc56hkhW89qSlRuRPB_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoyQlUkcl2yGTCiS5AV8GvrxQNvPxMIuYha1YKD0UOvQ&oe=6ACA501F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz633tpkL0wQ7kNvwGm-kyk&_nc_oc=Adrahg4hl1VzdT9IAN1N6BfLDe-QSVz2dTO9lKaDkEdAYvd09Pe-E2rR4sZSFJKrtjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdPIgi6uCF48x61Z2vW0RZsFyOF8UGP8YOpwbeKp8dCA&oe=6ACA5DE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEUn9PnFixcQ7kNvwFjXgRx&_nc_oc=AdpDZ1ceSfG9UQ2BD7_bh0PNSqqgQ_dHkIF0FMNBpPefY0LtpFj3S3JSxcFIKAbJXV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYBx6GrTDVhTSAiXYXydlRXXtUR1FnObfd9vGgx8IpIg&oe=6ACA57F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jUczLU9CZYQ7kNvwEx2H-2&_nc_oc=AdrGCOxIiqiG79iBThtP8RtAL0D3YUCHujdqPkV7CMdI8_8pSq4K0CawFAj_WTblyb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6OB3mfi78UuiqBaKn00r9KO-Ymb570HLyRAtloHq85g&oe=6ACA679C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhVC5ExHzHMQ7kNvwFDKvWR&_nc_oc=AdqW22qgSox8CO4xQ-d-y0CwYCIC9BU7-xhnYITFmm5vLuHZ_nNadxVrUjSar6jSShk&_nc_z
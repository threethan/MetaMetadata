_nc_ohc=Mai3p15caO8Q7kNvwHrrWGJ&_nc_oc=Adm9jOOeK-95PliMh31ehJufC-VgX7Ia_yTOLVs6MEfybitWWpJH03iCMbRxyDXe8VI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvmT3Pz7NH1vqWXbWPVNL6hzhJbFiJTKQPvZmsHJ-nM8A&oe=69A17E37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plR9ZSpyzlcQ7kNvwG6gIES&_nc_oc=AdmdyFN6chyotnveQup51X0vIvNyqRmC_FBD1cufHl-QzpzkkAxAirfSz3QklMsnH2w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftj5wrtl4LwmnIGDFejZeni1X5j4EvT7Y1Cnk2YIjeKjg&oe=69A18DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z9s7dbrzx0Q7kNvwE9LbLH&_nc_oc=AdlkKsniWu0_f6itM6MjvhLhR-G3UXIMpDFbeO5r6Ime2uoRtoEtT7Om5WnUd7NoOC8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu6wDaudBrnHK4GKUTRZyJQowiOlWDZPXdyw-sC8dbKag&oe=69A18A0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI1zmIgLzpYQ7kNvwFd6zEq&_nc_oc=AdkrUC4FEf8WeCmoE0Zy_ZWliZ4Ztpq5VqCYlei1n0IQ2A9eZGjs-CkDcFGXx7Uu2_U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftvZGtERRxsOtGeCjtRY5zRpSGFwECGbGEoCWhaZL-MXA&oe=69A17DD9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRQeedulVp8Q7kNvwH-eqzu&_nc_oc=AdnFDwcR1jyMLmLk4QAg5_TxpDKm59Q8K437wQxTJQ4jn2uMKFQWihgYOxIP6HjFjJ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvC2nFfAjw3r_KFY6I1jy_W3bhdAvqqs_D2KMgYefY4wA&oe=69A19BD3"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi99U_Z5zzsQ7kNvwHpLHHA&_nc_oc=Adk4tpz0d1W2gdxMBszUkaqZtbfHnir-qzMcdpPis
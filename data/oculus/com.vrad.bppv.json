_oc=AdoK2jiCjsfJXWKyvhxzDER7aRv-ohFqUSIaIDMZ1t0o34CTi_h_oc33doIelXQ2koM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOc_nZiC4vjbFaBsuQBsqn7mcHZgopqZhdKU85OQW4lA&oe=6A9C3964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzCYc1i0moQ7kNvwFdAElX&_nc_oc=AdoC8ri_F-wzk8l5nAJaYsrW4UqNrlAYMEm1jpTOiLEwqOzxT601e-U-4f0dT8Gj3To&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5TwQZjp4VPm0EevqNO7r5oXZLiw3h5ISiLMneAojneQ&oe=6A9C3377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfyZKyUxtjIQ7kNvwFZaaRy&_nc_oc=AdplOs7dg4h0bidH70diLPIw86Yl6963rl6jWiiseksTWBDkIqwxMfXZ742wm1XSbIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF2Pldvca-N3pcTZANHESjPypqD--519RWWUxccI8ssg&oe=6A9C431C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KJ3FtoO1wwQ7kNvwHtgh6x&_nc_oc=AdobJgPApRCcFlRoR8fzWDABNbIvrB_REFNsVexq0SRZeSPXusoO7XlKiaQC1whv6gI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFLDcFwrXDnQi7aX5jflsWcDtYoWPyMiEltpj7zqlVtQ&oe=6A9C3F4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_6So6DFP_QQ7kNvwG40O1D&_nc_oc=Adou4KuFeAHukIOXjI-yRl1tGoNEeif5Bu7bv_Ljd-25Wd9ap6FMfxsIB7P3eoQomxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx_jUjLEBSVjcdg2ok3Cwug4fv62299ijBDGoQ5BpBlA&oe=6A9C3319"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv7A8M77C9AQ7kNvwHGm6ft&_nc_oc=AdrY89UhzVS0z9svxDp2nZBfVtR1BWAp
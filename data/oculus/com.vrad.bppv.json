Bcoye4Q7kNvwGBdBOd&_nc_oc=AdrNAjNindBBfSWlniXzDmwR8jXf_HKpoVaTO8oxFMmw8UUvJKgCSnAKti-5SictjUE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QvPtix7TA5pqup5svooLrna6uw2eagrRqNndPqzERJg&oe=6A22EF64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwEwY1uq&_nc_oc=AdrfXH2UryPG7dAkHpH1b9W5EAKu8pljBkGsEN7GIcjnGpwxCK7wr1uCwoUya3hKMaQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QdEsLi6UecVWk7tgeZqYdrHmK_dv69D0ZE6OHMTwEMw&oe=6A22E977"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwE4xv9b&_nc_oc=AdpUZmvz-K2b9DB8G6JDzplpjzQw2peB9dwo4oMx_svEOSxGvwZk4qGUx5OO-90MGeU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XOVq1Xs0OsyKY-XispI8yz07Xd2uVAQM6DtbZpsTsow&oe=6A22F91C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwGeMAp4&_nc_oc=AdqjXyniWlp49J42sUeyCaBfjUR6WQ_BDuVWZ59W704PMtUievhMz40Kc23MXbrDBd8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ix8HfM6uPNYsLT1JjjrPFrP9xcpWoXqujAaqpv7tiDg&oe=6A22F54A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gySJ2hEjNzkQ7kNvwHGBbyy&_nc_oc=Ado9GOt0ivWk1A6rrWm3ni41zwArtg6Lnx8hniIxXCTfQgNt_Fe8XZ__rs0PdVzeNoo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dinAlTvnrGaV1djhotDv6N2q8Pj2YgdUjRHX-9fjRSA&oe=6A22E919"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVQ3ei1Ybh4Q7kNvwGTJkIX&_nc_oc=Adp
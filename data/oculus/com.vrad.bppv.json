_oc=AdpyEA8dw9vm0WXRyWermskciYnKZKLtI6nnyR9p1FRh9wv9wlqWiMM7aJOyHhdLIqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VO6TYUjuR4WM0TalYgIDSnZOmR27nBjQ6rTSUzm_khg&oe=6A2AD864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IqOvBRHNywQ7kNvwEfm8qK&_nc_oc=Adp1mt_6yyQ5Bgrm8fnCeGROCsTrMKjZFWu48dFui6pyfI-bUoaMDq4aoitsh2DyicA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MzVp__cKA0IT0EGmyYtMUuWBGXTx-SSIJ9NBFn0z6fQ&oe=6A2AD277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwGRZpCY&_nc_oc=AdppV4Xj9KceScFbAAPQD8Aon5kSArN1nKX-PEbl3YoUNV2nBA5_Ua3e4Y88AMRyaEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ng8iCzHwTWWY7oe88vmBoQJLwu6UWw2xXbf1w25oP3A&oe=6A2AE21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5OhPQyHOhAQ7kNvwElOOw_&_nc_oc=AdokFCngF7gHRu1EmENOdimPVj5R85YT34LwUYub3_vs1Pf8WugOJ0vu97OKYimjW-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqRkYDuzbR5fFpFTrysgU7UCfOdGZ94YMOoFHwAjDJA&oe=6A2ADE4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS1Cp0PZld0Q7kNvwEyWodV&_nc_oc=AdqPonP4oqE_6k7tJ9MgzyWrlmgSE9aR7FqkWZhUwWTshh-A4f_KXjff3rJwk6RZP4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tpOlCEtAhzA8B_EEbxMufxKqO03vZbHdrWzJHM_WF3Q&oe=6A2AD219"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_HsceiHzwoQ7kNvwFdnRA7&_nc_oc=Adqck6dFygzvXjMugNyX1W4DhF8fJdhM
_oc=Adr9PsxDT4vNrsF8clm9br4NjULGYWn7XCf0g2MM41SNM31wsuTuWynlzRQ4v7PbHms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vPeyP06vC8k7mVj5w0z8sutXyPkqSUxzQ4L-b1NMYoQ&oe=69EDFB24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8n3YdzjcLQQ7kNvwHubtdH&_nc_oc=AdqDeebuD_9CzrWw3xyULRBVHd8xVVU__riWKHujVCr0DvC1rkM8GHlbaSw3Bza_j3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L9FasHyExQ9rMIAi4qDJJGiBN5i7lrpolXslCS850ow&oe=69EDF537"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfcJHV-aOpgQ7kNvwHLze2Q&_nc_oc=AdpzWtl0EvEwQ6whFGCuM1Bu7Xfq-2yum8UFhZPZq8HyMLaMSgPdYiCRy7Rgvz_ZAHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BB8OoESmw2QNgI0xLQMw7tt_Xv8_2dYJTr0ns7xaRVw&oe=69EE04DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpJl2ji47WMQ7kNvwHw9dTz&_nc_oc=Ados7Naq2-1vFr24pRFLpHjOghBx6CWFUbE4P-QdiqRqkUT_NUY0NUuRwlEX2gsLrHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s2FmVJPtRtnYP3kfdhxGJpPwxBkoTsqr3TIOoowIdRA&oe=69EE010A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zru0dsDmg0Q7kNvwFZBmXP&_nc_oc=Adpm2sDUVThm-lb7bxe-aowiPhOfSyv35OM-XpKKBErpx1viPXLHAPam1TI0XUTuKUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qIk3xCTKm6z5ZfZP_C_MBB_YXPO80ozRu4otjEOl1eg&oe=69EDF4D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6T6wVDI1WUQ7kNvwH-Wxic&_nc_oc=AdrlFtoRz86tpDFxtVq5ZG5h-7n0K7Gs
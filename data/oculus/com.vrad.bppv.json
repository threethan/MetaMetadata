=8&oh=00_AfxIolI_6NP06gocoYQIDqclr9XheTuCg9pZ4tfBZz2UZA&oe=69AD61A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDQfJn8xocQ7kNvwEm9t6O&_nc_oc=Adknwxya8IeGZyzN_JVUe9Hm_41UY0o1UjA4dsffJ1P9y1Sq8WAUqNi-WTOC6ugyzXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRq7HCEzpkV9ycTS84nnDzWSC6k4EKOdaX4EW9Vdda4w&oe=69AD5BB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf641z6pGRIQ7kNvwE97-UV&_nc_oc=Adnx9Uz3lhfmUote6QiJnW5p5CzHg1zTrySLT_q0a5V5HQS6hUknmO9jOwqgc7bYx7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOqiJ-zumFXU6NNSS7XMquIRDIELEQ4WYrg7rF6Mek2w&oe=69AD6B5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziSxhl-N5lQQ7kNvwEZzdy0&_nc_oc=Admsjtdj7kPXt4g2oPjZZdKOH47n7Y2Gq-69AUEXRCOoFBYvSJy335VCtVDxnkeEUP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLDN6uXsnAwstGVM5a_y1P11pjst5x9uoQ6rea80oWFA&oe=69AD678A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZCq2LiDWn8Q7kNvwGSH7Ba&_nc_oc=Adm12MHn1I6EGTsGxuUea3dnUdjtQKp29M0hcEJX2MGlk96XWOrbyAtAUrogDUEifbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywyzJ9chaqFtY7mmpuQXrdjDvTiGeiPXQmnw2ZJGpjgA&oe=69AD5B59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX7qtiz_EvMQ7kNvwElov0u&_nc_oc=Adns9FzK5WQlXbi2dXAFd7doRscCTa_wjYxuKNRu-UzTnhY6q_aX1gS5aWolSWDDhQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCq_fnY-ytxVdUnZ8mPJ_5nwuIt10TbjNRCT6mdZ24XA&
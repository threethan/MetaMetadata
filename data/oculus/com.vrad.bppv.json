_oc=AdpGvjm5b_Ge5kBmEygKsXKvtPNwoHmzRZAc89AgbefObcZIN27XJ3H5O9pRRo42EIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RI_nep6f6bKCVAh0xV6US5hO0-oHvt29sBT6DomCqug&oe=6A1EFAE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlHZ9ZPxOoQ7kNvwHEXzJC&_nc_oc=AdolRllWYY9uTsLyuwR8Q1myIPWdTRMFXc3tkgs8AydGvJRZkLjUVJiki_YBniJkQJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IIEkFiQdejmvxHbg0WSYGqSAiFx20Y-LDyc3mGXwL3A&oe=6A1EF4F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZyiV92gPHsQ7kNvwE-CwqX&_nc_oc=AdqQu_hZlFzT05J1ckPnkKIyVWA3mYSnI80PfEKR3mbCqSARkq__syI0kap39wy4Hes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GFmq2NR_fb4iGiCi8X01WhAWd1F0nrLECi11nmQIcdw&oe=6A1ECC5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl_CCI3grGoQ7kNvwGRbDo7&_nc_oc=AdqSIeXPBYpQGCkdvdVZxE1wNAYstMqRXRoNQ37kK2EFvQAd3zxOOl6R9NgfszxDW1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hFkzxpsVB4qqo1QxTckNvYcC75ZOJlz_aPCokpmVhoQ&oe=6A1F00CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqtiX6vZGSMQ7kNvwG4gTyL&_nc_oc=AdpZSPQuOeIpQwPHHkrJGtQ8BYWQoUiR1oJR3HF7av4kO5Z74vxddEeux_iYU7sZmWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50zLlG_cVMHz4UeOlTAzHkEa84VyFxIyElXs083gkobg&oe=6A1EF499"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vetj0r--DUQ7kNvwEIvTVG&_nc_oc=AdpKch50KcOWGKwelMDt6hbRzdUQRfyS
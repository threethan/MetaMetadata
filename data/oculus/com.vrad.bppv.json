c=spi4Qt4Tf2YQ7kNvwGPJ69g&_nc_oc=AdrnfUGn0w7WfBEwYYvlg6YQjRuT3Otq4UKpY6sJlWiEFhtVQ57_VZ_el6vaa2CyqSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCiJ9QCwAD_MAVzO1fyFW5VJo2PIy_ZqV6xGSa_3QMng&oe=6A5E1734"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSFEKnORdwAQ7kNvwG76ctA&_nc_oc=AdqnyceuCdXUerUNc96AqRFSRc1nG0-36r8s2D64-2vO5V3GYg0KRuvb1nwnJfhXb38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCteh4iQtrEb-Ypn7G1R5EFvrN32Q-UTp1TpQ4lgylm5A&oe=6A5E351F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZFuDOkSFfoQ7kNvwHwSb7V&_nc_oc=Adrc3bIe9-uqTzbaTt3thE3C0VDaYv-NlKXZaMKO4M1ywNoXIvRGMStqN1UxOwTZ79c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAytRSbqidjLEmPy9mDH3ZMVcAw7npchjs9ee8Uyez37g&oe=6A5E0AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5Gtu6W_fmAQ7kNvwEYm4yN&_nc_oc=AdoEk-QPN4zRp6-3NqnxCvGg6QzUU7bvVpqqICVFmpVb1gifNqa2y6aQkwfF0LXCvVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClLJQD15KKczkX55mruvhXEltiWQGzo3d7ntwIY26RYg&oe=6A5E04B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTrCkSnTIi8Q7kNvwGMWDlI&_nc_oc=Adr4Wvshkmv7jrCeoi3jxSQ0T5_PRYHFhO5RAwXVh-ki552-qqrbF1q7xrZq-ByqSgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCLaPlMPA3T5NItnzEtkKAD1YlNB4AwEkieiDsrLXnFg&oe=6A5E145C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YCWQhqvPksQ7kNvwEhQt7e&_nc_oc=AdqW36Fkeohu_oaaBFebczGmo7mt94YNk2UKrRxXQVUcM-sLlu16aWO_G7VMI4HjFoY&_nc_z
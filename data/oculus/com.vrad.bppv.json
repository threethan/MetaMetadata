c=4r4jdriy5ecQ7kNvwFGs4el&_nc_oc=AdpesUOxKeIUDABF3pJZsKanNE4cT0Gn-r7A9Q1QNdlVFqBPHZVyPsXfw4NKUdMv2s8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk4JngfNt-3n9sD7fmFNr-l0VyI9mabf8TNgjTJYBF3Q&oe=6A4E4534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0xL9-erVJUQ7kNvwHmEJgy&_nc_oc=AdphmcyL_-M1ZsIRNSfUOodipj_Q29jHsPrXI4Ng_87UK7ufSnlHMinO1i6fVdHy7Sw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_0aXI2SnnvzzqC04cbVH8udgMSec0aPwWVM85Ifk9uw&oe=6A4E631F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WaBKtgXk4oQ7kNvwEGwlKv&_nc_oc=Adorz08o-5YjE8vhjXiksgKxXDiIt2avQKPKA4LYQTj58ppj-1xa1XlL6XqDClrUA10&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk2AVoyDz-YfWh_E_D3vGbgHnxvRYpParTMalyvz2kNw&oe=6A4E38A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EBzRwwZ7QwQ7kNvwEYDD1z&_nc_oc=AdqaIg2P_7dYCwvVPgbVOhsAEoHH4pwaG7mTEmqELmhwqkdXCtSvFYW35pVhI7pmPLI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHz_jw-x2XwynR_M0FKU2FyOoSLrehR9xHLp2DbVjIRQ&oe=6A4E6AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHgHtulux9EQ7kNvwGuIqGR&_nc_oc=Adqck2LVQK6eZAW-12Sw3z1h4sWaREWkuadE1MnxgJ7WhQ2nYGlIwRiy4z6Hn3gZNlc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXDfi-8leI6s78vzx6elQULjzWib-qYQLKu3M6iFUyaA&oe=6A4E425C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDW0GlYOB3QQ7kNvwG8RKT0&_nc_oc=Adrg3jKN2GV2Xc9yshRerspjFWyoo0-YiAt84ika-p9kLu7q8sfC7CgigBSHTGS04LE&_nc_z
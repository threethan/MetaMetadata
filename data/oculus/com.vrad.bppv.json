=8&oh=00_AfySJeHf99hJRj1JxJk87xLIl7gNEyVCk8ZF-WBhJQzrtQ&oe=69AC1024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDQfJn8xocQ7kNvwH15ydC&_nc_oc=AdkCiHZFfUwfWHPfKdvQbWmJ42o62Tj7rJ-Wl5THCA6oNexuQ17WriYq3pUbv-y9504&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ9Xkkqq6WlzsmD6maz0j5677qEvJd-DYwGH2mn7_Qaw&oe=69AC0A37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf641z6pGRIQ7kNvwGuCWcO&_nc_oc=AdnXOFwexS_X_CvDHSvSaURePb51IOpy3uypWYlyq3_VnYXGs-x2ZwWrS6jj3yChVT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnHFWNsN2NMaLXUHOTIM3RJklivcp0EUNhO-SUBvjAAg&oe=69AC19DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziSxhl-N5lQQ7kNvwG84V7X&_nc_oc=AdlQfj_Rnq2rYQZKuLDMgBhyA2Y-IVsab6FwyRaxtGnKcC2mTh4islwXaFpgpj8r2Uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxe3xE4e0AKNCN8tNpA0MyoT_meRfJ6aSF8fL5qfQIVJQ&oe=69AC160A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZCq2LiDWn8Q7kNvwEf_YhD&_nc_oc=Adn1HcPAx9ps-uYQfpz61Zay3Y9YdX6gHgRNveslA8cR6uYwIoUpasqMWjgigLOSuLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNdjZ973NUGb8DD_yzvj_BbxnUla603-R5IN5kN6YSxA&oe=69AC09D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSZvQK4lNZUQ7kNvwF3dPgv&_nc_oc=Adk9JPbxP9xayKzAusjZjb7L8VgKV6BlJaJBKf3Atc5ow_4AVxITI1RQ64HrXkZFY74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZv8yZCYC9laSQ0MuQRKuyF2JyxdZF3jVMP9hH9RcnvQ&
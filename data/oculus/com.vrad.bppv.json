_oc=AdqZZKrQxJr5qr2D-7YOJxzR7jsdsgXJQC95T0foAlZGHgmY5skV7UlFFKWkdlCeUEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wIcFNFXauXbp_zsv_EjkgV51Fe1S_wmnYL1zh6h9ymA&oe=6A0DD764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkVrXdYHmY4Q7kNvwEog_tn&_nc_oc=AdoDuWFa5wzq8yBuFHdwTmjzBAV7SHr2poefhA_PYyW6BvdbzCtNSYu85IAftZLpMBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YHk2ds46NOUoLoNWJ8x_Msh2E3LJbIQboZ_IDLfncUQ&oe=6A0DD177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dN75L_t3m8Q7kNvwFn-VTE&_nc_oc=AdoeT_0U1dPSXPApvnTPzyD3OIYYGcmwsumnedsOrAlZrwwAlL7v2Hycp4Ul-Bev_uw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lsihKNv4uB6MpyBjsl1HjFrqpx17HzGw4Fzh5sP_44A&oe=6A0DA8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZvjakI2Z38Q7kNvwEBU8uU&_nc_oc=AdpO97oyZu0LE1m68ZzUL4XgLDlzsmNK0XxHPPZ1_MnUxXdEjfMpKr3DoQmCKctZ2Vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56nS092IZffkjG2ntzv8-_arrTti4EtyaFT4-0t2Xpjw&oe=6A0DA50A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MM2exNc4noQ7kNvwHQjRJG&_nc_oc=Adoi8tj1xFE7f4mvf_0wlla-oE90o0qEH9ylRobyGEpBI8-Y7Mmw_gibSVqUAGRZDuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oXYTy6U59qRhSmq9r0gspGYp0O-JtEltqLlr-ttBBzQ&oe=6A0DD119"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR4_JV5J9R0Q7kNvwHr1-7R&_nc_oc=Adroy9U6_gUq9KcaKlbQ-uQhAgWeeCIV
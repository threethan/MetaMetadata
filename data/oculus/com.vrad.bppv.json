c=7yOKT2xN1EkQ7kNvwGWpt2T&_nc_oc=AdrPoeT4MhUcv4Q37unCid62EVsbK_UPJtyY8aJUIkXKFOp-BOcDm7NEUs0hbFJrpO4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af427lx_bLco_kXM0p-gCnNObT_beG5_SUkLJgtgamqs2w&oe=6A1ADAB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OekLgNiFnlgQ7kNvwFoAjUH&_nc_oc=Adr4IaCb7vKE6C2WYWAQMPRgMMZsQpbFKDoa7TkNAHwYufDnfnV8C7kl5uYdf-XCNGU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YRwze7ei3Cn99YUC1beythmGJb5yOKOMclADg8zEliQ&oe=6A1AF89F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YTqfTjwv6cQ7kNvwEXvxWj&_nc_oc=AdrG9LkV1UFLY6MG2Xty5ias9YM-Is9MKOtbVQK-jMel_b8qrfASliMNV_L-bDEXLXo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qhO4_kKR1CjJxhvhlq5tnvcfCa1pDubnCBziQDpU3yQ&oe=6A1B0664"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THo61uTjiF4Q7kNvwHPU8ss&_nc_oc=Adpu_oCepj3tgadp9rNtPz0CZ6Oh246hG4rg3KJudDqlkQgqH3xobEZiiox2D-nAOws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IUDuJzZ5pytwP8LQXg3dla73hml5aMgoaJQQx42em_Q&oe=6A1B0077"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7iLYoi3a28Q7kNvwHlSYIG&_nc_oc=AdqgllfYjaCLwU-WFBJexCcNX7VpF5FENBlWmHLTg94BxghRzWBKfPQc4zUZ3kHhG3k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fFWqYDg1LdvOxhzmYFazHPd2D1mpnWqTDOccYmTGa0A&oe=6A1AD7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ67skjljt8Q7kNvwFfKHi5&_nc_oc=Adq5SqebGvW1MvZ8C--jugf8ROgpDWqOdjU_5WCerWDNpYub1v90Uw96Xh7d9L1FGH4&_nc_z
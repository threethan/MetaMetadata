c=vYlWqo7v7Y8Q7kNvwG0CnZw&_nc_oc=AdqNT7bRjKAXT91dRDnovYeAwbyYnmbRibJIrFcdlkR-apB13Lyl_RXh6_RV7etCh38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVB_uxf2LsECpbLJHNzmIXsHf0prNbPC3SouLGcSqDwQ&oe=6AA153B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HbEOYlFg5cQ7kNvwGsC0l5&_nc_oc=AdrvmAmmn6ME_HC656v8arrUrs3MjTEqGySLVmSy0OGVrphs4CRZ8g1qxY0VqrS6g9c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2yhd4BbFHZ8MR-ISYSIRhdsSIJF4HporRYEIbsw8dlw&oe=6AA1719F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoaHQvU6z8cQ7kNvwGvy_Te&_nc_oc=Adryo3bLz1DUgVyWbnw5funShUmhp-JSwkjzVwQfkFcbyt0Uyf6D-kH34B9ZHFSJ1Ns&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmcF3ih1XLJcQ4EKwFMV4oHwc4lb2MXGHQU71uZukk-A&oe=6AA17F64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiYjbaBmMTUQ7kNvwE5wDM6&_nc_oc=AdocH-IAkwz7zH1IDA8Ax7gyv-zeiIYCEhkAnQ3PjANA1LEuY6R-thvgGadW2h3E9IQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2sHTYWTeRDYbAPfGtLDu9AkLGKxQZmdtspMBF98Udgg&oe=6AA17977"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1E2AGl_9vwQ7kNvwEO4-uT&_nc_oc=AdpwgCdf7S4URH0BJoauaVsrTzFa7LGlKt_EpNNQlu0bgnZ6o4ssVsT-KBJh5mem0Qs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZqsS0Rxgf_d7PmXkFIFBI33jEkyl8zlzNvL0ZvQNWYA&oe=6AA150DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuhp9gLrj_8Q7kNvwFDdS_p&_nc_oc=AdpVCC8XSlV5gLw_libmQkJDPR9TYL0BURDdifAJ8CndxRK-qxa3ij0rpZwQ-Zm9-JM&_nc_z
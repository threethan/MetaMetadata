c=JC_YQz7h2mYQ7kNvwHK1deM&_nc_oc=Adoi7CaYqk-9dD7mSaDh52gqzctk9ELECzKJpoVl1SdsjXn8BEihZqSf39WnWeWx06Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxNp2smriVp6VD7wzZ_cmjSD9Ov_Moz7CqX9vqE6LGtQ&oe=6AC52474"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uVoY67JuCoQ7kNvwF6KwpJ&_nc_oc=AdqZCASNExCMbWIr4L5UJ8lEGz06uQx6iwuzcRu8fG3iJbDL6kczzMnq4ov-IBAuhzE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwdA1STV18t1hu_1iyhQxQdUNeXURqMza0Pzdj2JkxcQ&oe=6AC50A1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4jksbcklEMQ7kNvwEdky2a&_nc_oc=AdqikANAp_ltmlpyI6O8DhjLzKLZyZikNwv57KCbkkyGp6lMiNRHEq_iiGjjajANv9Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfLYI97LFlbw3EdtYQ1-yT5AKrZJCq-AAAn3FpfdJ3-g&oe=6AC517E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOvaHD6pYYQ7kNvwG7dp60&_nc_oc=Adoux9lFjXOuUdOR9p08Ls1OMQHA6eOoVdMuqUidVs1TLXddDwkwXN9I8f6cnS_uQhk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQkzg0BRpIyFpXzBnve9tbFCO5lLYs1X5ylPoXQZ1AFw&oe=6AC511F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqb3mNUgRQIQ7kNvwEh3co9&_nc_oc=AdoCaCziEjuVlrC9GAU4AVK4uPoDBz7qoZrUHwgfNxvhDXcAp00vIdfttNyvD5andR8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvT2WpeU9KizevXXuUNMeNeomSbsZNJvSibcwnigGPqQ&oe=6AC5219C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfS8UCit1sQ7kNvwEcWeyw&_nc_oc=AdrcRH7u3u9jHmAyW-zgjj6uAOgDM-Upm41P0ayhz86YskgS_c4gn73qbB9m6PJJguA&_nc_z
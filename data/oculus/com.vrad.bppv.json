_oc=Adod7kfaZEb9kJ0idHxlZIlYZmcxf-66tuGIhY6eyoMFBNoWlywJzo2CJFjJkpgZLj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd-Y4X6JURWmYONRL34CA_bvLemEmvd8U5IRmGz0FZRQ&oe=6AF33C64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJF3qbG6ZZwQ7kNvwFQi0d0&_nc_oc=AdqOhHAlR0JEZIAJt8JgHL0-1gqWq5eVln-LeuSplc6_r2QQEOSUImng6t3D9_zDPmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu0FvbELtjqE0MM3ZSvjMgQpnMuEKQ7zl21yZjr1gAjQ&oe=6AF33677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9B3yzLAojEQ7kNvwFlIhm7&_nc_oc=AdqgdT8YwmOtK01VwJup-y73l7TQih9Iff8iI0wBkXewM8p1sLztlFopX0FCIW0oi1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRJ5Z3TzhK0NEQNrYTwZsfE1MJyxN4ckRTlnA6QmT5Ag&oe=6AF3461C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSK3TIaLdF8Q7kNvwGflSYN&_nc_oc=AdqLI1kZEaMtQ0SsVUNSto4WeRPBELAN-NnB81-ZkXAFkyC4Whbl5Ifr7gJBTIcMhm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYWVhEJnZYRQ9iC2vhpx-LQohSzCrP8-DLNbQbXV3A3A&oe=6AF3424A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2nnRotlDjkQ7kNvwFaOakv&_nc_oc=AdqevnGfiTdTeARh3qlYQMrJrdUUAwPm523Oop9bnsr55GcZukNxriC2Z8385sIKP9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlznybhhJjBw7NUx2rapN4CIfvEv-q4Eb_NDqeU5Mn5A&oe=6AF33619"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJAykPffguEQ7kNvwHslDA3&_nc_oc=AdoTmsHK9UCWPy7fKohkKBjh78FdeqLw
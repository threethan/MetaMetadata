_oc=AdpYK1EFQWBtqAHOF6gano21R7MuMA2Nev23yeClIiUOXkzEbw_hbRAxfFGp3M9zluQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCaLenmzgeUD52V94iDXfEba-7nDfSIk5fhxIcEuYDWg&oe=6AA573E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn7-b0xvKQ4Q7kNvwFTAmgk&_nc_oc=AdpwuDJ6JTduhT6MDxgWh0XPvWacFydBacE5kotjf3o6B94kjm3J_wEaddgZSlrZisU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI06hfS2AN463wkoIZ4E4J-zBsaiseW_ISk5u11_KleQA&oe=6AA56DF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkZE1yB8TDwQ7kNvwHBlip5&_nc_oc=AdrreIFSak59yEZxNi7DOTpKYQp9m-zmb3qBIzMvV6S6BYkMwJfAOjEl82nRMK4hmOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6BadND1fHdS7ed5mQT-k4wEpB5cgNlpx93rtgqBhixQ&oe=6AA5455C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ4fhJCS7oUQ7kNvwFFTZgw&_nc_oc=Adpmsn1OLOlnzsqyP12dCegM-spfnpLdRLRvDdJwz6JDs7bQ3PDm7tJNN9jJ6LHQNhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiZTnKL3IcXFg_jRoT6XeHEXVhN7eZ565w5BQ6vnxxKw&oe=6AA5418A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdQh5T7iZ0UQ7kNvwFapgcN&_nc_oc=AdolGbAGcSS77uxv4UbqmHm1VmBpADbmd2Us_hSXIX4sldNpk2D_azcoq3Khiu71qmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmi-xlyYE7D79cSnmw9MDCvCm0LTvz4k9dp_Gdkk_0iA&oe=6AA56D99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwVwv_QQZwwQ7kNvwEgoIkO&_nc_oc=AdqMnqwha5qQiRYpdqk6Dnbm_5TKstqk
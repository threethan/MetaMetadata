c_ss=7f20f&oh=00_AQSZid39BCoOf-m92Mcsyrv9wYMREMKfXlwTqds2O3YpAQ&oe=6AFDD4F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1HcZH1BZakQ7kNvwFv0FW4&_nc_oc=Ado2jpLy59yaUJl03268KtryYJfEyWJAcQwO5urPksoVzA9DyhAZpDQRB-dL0Eh-dKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgU0KgWWxvnMjtILspWeLDzhbsNfUfaasE6OptmmysHQ&oe=6AFDBA9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvkmk3kCCE4Q7kNvwFsPBJ7&_nc_oc=Adowehb7jlKV4tAU3XBX23F38BhSkbQwGktpBEun651OGIONkmvID9R5ZbnRF7ST2Gs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtCNvJrcfoWi3sZ1RzxU3_WQNvtuHgvxyF2zDai3QL6Q&oe=6AFDC864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt4Xm-8wqQIQ7kNvwF25VGf&_nc_oc=AdrHzCZheO6hfaNDgYQd5XVfa_yB6YzMT6Mahy99RKpgZ1v1x6tMPCbVbfvmi9q-Ed0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8yyjorraSacCAVVrGY9KkTbK57-NRbKbL1Pyp5q2vA&oe=6AFDC277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VsBPlrtEqAQ7kNvwHXIGfC&_nc_oc=AdrRAFuRqhDhXpy8tE_1mtBNMsjNpe5VTcZiKarhio6AP7zzFk6OZ2PKE8XpNe4guhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0AztCVhP_L-TVtGU010hxyqEXPILqF8lVEl4DzOnRHg&oe=6AFDD21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCrEVitTcpQQ7kNvwFX7psT&_nc_oc=AdrOuxABCXhanlymVWzajK2FKnNXWMnBeQRPgduwA71xWGtxiGcPAleIN3Ebh2pjBco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXiu9myWW8Y2lAF8hv9a_CGlanxGrti_-R4DYPKIlbHA&oe=6AFDCE4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k3qpD3oGOYQ7kNvwFIBIFj&_nc_oc=AdqkmVlm-vI0ZqPTQSJ-bQ11VhHLJHStxyb-Fej9gJh1ABTBdAy-iY-J485j0y5fdIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn91nfHLPFzCiECo5kTW5spCZK2SXquYEZ_BtaLHY1tQ&oe=6AFDC219"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrQ4olrOpzEQ7kNvwFkpQS1&_nc_oc=Ado3yJqY1r-frjsess8lK1Hc8s2ODKOe40PVOi1fKogbJscmzI_c69zizx2Jqr6_BVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAcqMWuFVP3B23pc1GdLomEpNBBTbBxjXHYsx2-Y1q-g&oe=6AFDE013"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxIIC9YFMy0Q7kNvwEMVpes&_nc_oc=AdoKS0ot28XZQdXyHfXeWBtcyBpVrBhYl7EWXvaJS7mwqzs-koriIk1V0hAC-hXyJ-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3eD-D8_SMeeahpFK1mSiW9MhOxKZgVzsBgZlPxzLWnQ&oe=6AFDCDD1"}, {"file_name": "005.BPPV_Square.png", "id": "1269871715156621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620346_1269871718489954_4811280509119093641_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQioXaG5sksQ7kNvwE28apa&_nc_oc=Adp-Lx8y8Gb8061rc3rg7khXa7tjVvkLBUH4sixyowO6W2N9E8EqCsyzq-0WfFz
D&_nc_oc=AdlbchD9pFCokonkf6zDKTkZ2NeExHakKx-MxiGo2d5kx0VOIHd5rPLoWohJA4qPstw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVTAfunugTSTTAvjK6EQoclFSl_5OJzHHSggoNe6MWTA&oe=69AD6E34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIjMkGksh9cQ7kNvwHCC6NS&_nc_oc=Adk9blKD-H8l5UuiD2zQfsUaibSe43ldRnd7GbZ-tZqErjC2aCiKQeycV60nm8ljV_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSh-kILASJMUyuEHYduLoEgIhYFsHed9yE4iGnKH7yaw&oe=69AD53DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o9SCnzb1LYQ7kNvwH7O6Qg&_nc_oc=Adl284BkWoy3YKdwtL62H7wo0haIEt8l9zsMd7tAZNDeYgsmtjVpkiKGcgaZTMQ71c4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIolI_6NP06gocoYQIDqclr9XheTuCg9pZ4tfBZz2UZA&oe=69AD61A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDQfJn8xocQ7kNvwEm9t6O&_nc_oc=Adknwxya8IeGZyzN_JVUe9Hm_41UY0o1UjA4dsffJ1P9y1Sq8WAUqNi-WTOC6ugyzXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRq7HCEzpkV9ycTS84nnDzWSC6k4EKOdaX4EW9Vdda4w&oe=69AD5BB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf641z6pGRIQ7kNvwE97-UV&_nc_oc=Adnx9Uz3lhfmUote6QiJnW5p5CzHg1zTrySLT_q0a5V5HQS6hUknmO9jOwqgc7bYx7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOqiJ-zumFXU6NNSS7XMquIRDIELEQ4WYrg7rF6Mek2w&oe=69AD6B5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziSxhl-N5lQQ7kNvwEZzdy0&_nc_oc=Admsjtdj7kPXt4g2oPjZZdKOH47n7Y2Gq-69AUEXRCOoFBYvSJy335VCtVDxnkeEUP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc
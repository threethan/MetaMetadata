_oc=AdoKAjgRDvVx2ymaAuABADGcPOz9nnD4wateCuC3D78v34EtCXGutjzWLuREdPRrhRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv9zd1ah3FiGA-C3y_JKcpRvsWJbitieLmY7TdcnLdiA&oe=69C51CA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdX9wUqLQ80Q7kNvwF2l3QS&_nc_oc=AdoVtbFejifqsqrRUZfjfagwSJ6aXe5op0ZY7E0hRa4wXaokqyiYnVNMDxBS6bG-kfc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvQbzU4ocTMR6a9W-SE11efTfRZVWrKmb2NUgwVRB1ig&oe=69C516B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_sPY4tLPOgQ7kNvwF9Hz17&_nc_oc=AdoUwfKzBWTNqOYO9bHObx6jMH60Iiu_bpAFkNJbD3d01eM4-tt2W3p-HFtH4tr50pg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLAHT2UswjN-vTMOfCpcB5cCvlhzIi3R5ydNljE9ohyA&oe=69C5265C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdYR1UdmTd8Q7kNvwFFwo4L&_nc_oc=AdrBgKsd7rif9N1PE3DNydczRAagua6Ikv7ONjiiBlPfVQD0g2q3i6YXDD3Eh6P1hWk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4cEsCH513FyM11lW4mPiJMX0xqAksD2gdULZNIWURXQ&oe=69C5228A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFonuSyAS9YQ7kNvwEs6Scs&_nc_oc=AdrPTXX_pYdjF0cL_BUmtr8YBBbFcbIlAthWXEKGGDsL0ESR1d_KXhOKTvfyD2e5UII&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZrUe3xG2y6tYDnZlNgHy5OP19nuwN33V2Ogo2-CHuXA&oe=69C51659"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmFNvBurAJYQ7kNvwF_25uo&_nc_oc=AdpKx74fR04I41kOgX20vohHaZtxgb-K
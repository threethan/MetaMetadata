c=jwPI7MjHXZYQ7kNvwHgxjT2&_nc_oc=Adp6P2-PVsnmkn7s8ne0yoeNFeW2LKeQiOvdAzmx-8_Db26phNjb86it86HpzB1VHkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fDGwuJwgI1Jt9ZBBdFXfO3xMAT4KJlTmkXcpPR9GbmA&oe=69F74234"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQLR6Sysa2gQ7kNvwE3Uis8&_nc_oc=AdrR21-GIsBgix3As_TcBpl_tQWulLNIQ4rDUoD1SQRH3cTv0z-uDA1bxv3aN00h8_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rhbi4XGzdPffHRlcoqiPjsPdm82hOVI82PW7NfA7z_A&oe=69F7601F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTUmUz7dBhMQ7kNvwFP5Xa-&_nc_oc=AdrjgVf6bCLXKktAufS-lENZH9e506DyzcTeyGG4JPA3mmavil9JtNQv5NVZKjn0OGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nWIl_hSALb5Io2J7-fkfq5ozCYkSAJnpV-HRAJrmMNg&oe=69F735A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfEJyTFAOzQQ7kNvwGTAjXd&_nc_oc=Adrb9gEvko82bmHCcPEvlmfRNQWU8EM2_Rk-eer9_BSTCUEvk9_owo7k5tl1d8GUhSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-sFF1ciKXEv2dOpEFyps0RsZu6pf7lhoR1NmgOEN8xA&oe=69F767F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd_-DUStZhEQ7kNvwFuRoUy&_nc_oc=AdqNBwnLscexToRC-5VVG1iVGYt6QD35IwykdFFlVKzPafwuB0mho0HZ6vKSDuVy-MM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Pc7t5qnfHxCk9WgtsFTIt7WKbYDXXcdyfHYyY0qCGuQ&oe=69F73F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_odjtUABSEQ7kNvwFEFh13&_nc_oc=AdoXBMLhnWX8wXTIKfPhXBfKvQhI3tJMnEe7iMsGa_ilQWJG2s8J2xLafCK0g82ES5Q&_nc_z
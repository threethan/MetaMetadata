_oc=Adqhbn1QIB0KwRaxKNk_lWQaK9_3ReJ-qNuf9Szyu3TfJar0aB7WjztHJCegFC6Obmo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09363YHNLE0cKWGc8qfS5DcHJNBMFW82_JjFpHmiZ7Yw&oe=69EF4CA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8n3YdzjcLQQ7kNvwEy2EOA&_nc_oc=AdoqotasaQkXFLoCiIWB1llDluZf08rICiKwxbjVAHYugVfeZnkkPVLyzpw8MilbTNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18rxOeCK1NhOE224Fwe2AjJoJqBDrmLBms-62JVpYC6A&oe=69EF7EF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6EmkTYiDIUQ7kNvwEqot5W&_nc_oc=Ado6L6WLWk7-H3g-HLmU-iLs59Z7LTAy-8s4Pbv99Gm_A33rr1lG3VW3ZJ5SMOROI0o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1skJEEXtHv1fSd0Wfo31k3D7X0Ozx8xweGFzuOYq84hA&oe=69EF565C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpJl2ji47WMQ7kNvwEZqvUZ&_nc_oc=AdoSfs6wpC2kFsnvlPSbGjJpHQPNEbXPxJQe4NYQSDMfIt38j6vwn-ca9zQMq3Q4Ybo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zPveK8kGIO1GBcRnFYFGVHjan-y4K_63g5NRshX8Gmw&oe=69EF528A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zru0dsDmg0Q7kNvwG1ffYh&_nc_oc=Adoaeycsh23clI5j3tgaQRsCgoq9547eZ25yJPWJAiBW7aPchPf6BhJSAnQn9jvlehw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Jxw4M_vrSHWsmJkJevtZgzS1XcEK22cp9IORXC6RDKw&oe=69EF7E99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6T6wVDI1WUQ7kNvwEJbQib&_nc_oc=AdrGMI-uVCgI8_TpfymABoBJUMQclcLQ
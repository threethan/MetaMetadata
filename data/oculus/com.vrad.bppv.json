_oc=AdohvkSmcqtoM3ArnZonsYWJDXGaaPEkfOh3AU9dgqLZTpz0TdIxvL261kvTYoAFXQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7fzNU3ablBOp3GzPs1KBTXJB-Desw_XOFHSEIJH7bLg&oe=6A8ADDA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ErQaL-cL6kQ7kNvwHA76ja&_nc_oc=AdpDRVxB7SSJqq7TsQQpT20dLqQCH39Hk3clgkqsOzYZkA8cPwGOgt7uadt8Vd6zBvs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1w7XYWbEfBHvj3THbIZahTe5RWhuml39RqT4KiDKz5Q&oe=6A8AD7B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81MVu456kncQ7kNvwFaeTir&_nc_oc=AdpQezpWpt6uj8hwgYn1llq5KNUVVyfzH6jCSGQHFduofmBLfnRCeKKxIG5iZJi76T8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9i55ND_R4md41rrNHntOX3bhEoQy4ZoWY-gAx3Goh7A&oe=6A8AE75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDDOmkfyg2kQ7kNvwEyoXsD&_nc_oc=AdoyYfikIR3MtVoGlAdEH_-Ycy2mN6lGQl1wm44I0g9Sli3upBz-j1AcZhLo8WEEtz0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcxyUbPwvas7AFKuZhzowj7RAnbLcj5Sf19yFao8uMLw&oe=6A8AE38A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr2ohSBSUngQ7kNvwFt92yp&_nc_oc=AdqL3UxXAafqf-W3hZxJgOhpjGnkRV6OUefYPXHauCeqbvAFMOyOyv0qLS6dju9xLNo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE651MxfDvp_yoa2Fa6E5wlQH2NF_BJU6llghwqkcTfFg&oe=6A8AD759"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQA5B1aGLXgQ7kNvwEKkNGj&_nc_oc=AdoStmquG2PUy2jYsF1u2Sqdz5qu5wMx
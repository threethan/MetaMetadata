c=INdQ9Haz-7MQ7kNvwE6Ictm&_nc_oc=Ado24razWQrCbQDAAYfNzc122qu1SKfpT4LJ7Cnue0mOya-ulVXAZo9Fy7UA9p9NLa8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIynB0xxLLSPs8uYySxM4CFkiW7e2mI2Mzoln3c9fZfA&oe=6ADCA734"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE92P83LNNAQ7kNvwF14_l1&_nc_oc=AdpxslOEkQKNsuxFH73IF-vMgT80yWXOvhUVYmccAIULo-hr9c7LzFMY-L-yhMkiG6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMzPGjObC1m94xMmEddmMfifGdNc0y4WRZXI2yKASA1A&oe=6ADCC51F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cy_0fIwAUIQ7kNvwF7hXAk&_nc_oc=AdoZY0LEykHWYR_PB6ZCb1NkwEuq30xNNT0QXmhTVrnjZwv5KoiQnODQT0LwTk9lPbo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt1_m2WO89sEaCBJBsf2DiW5M-IcyREvJwGwh9DJ53jA&oe=6ADCD2E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKw5kVfxiUcQ7kNvwGSe4ac&_nc_oc=AdpsDFPu4gPFEQMgr8o32JYP6z9ftLafr4A-axsyFrGGg-SWAjlRZCq7p4irLY2k5pE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7Ot5G8k7Ejny1qXdxO7Iyh0pQP5WXcaBZybV-mdopiA&oe=6ADCCCF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnPVbNqoL9wQ7kNvwFX17xd&_nc_oc=AdpcX4xDi_NjxCy2F3mhTA9l4kNkWNKdp2bdoz5E-b8B3DkFGGrdf65vn-zRx0Mohjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvnUOvcnYthHHN6BmXjSAEd4Rz7DSOfXB8U1vpVOAklw&oe=6ADCA45C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6htGFPeHM68Q7kNvwGbr7l7&_nc_oc=Adqt4FxXjWUnFv7sykK-zIXz7o9r560cKvTrs9dxGc7cOC0wTl_HCwnrIZikaj9upwE&_nc_z
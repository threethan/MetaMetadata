c=gOu_w6W4NjEQ7kNvwEkhmH8&_nc_oc=AdpSVjyDXZ_v3Qbx6_sQzqanoVkv1y1kwdj_gDsqpKIb_AgWG5_gT90A_Xcu-dv6Nl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB5jWUg62ckCendvqZZwHHebmXpqZiD3OGXiYvAlfv5Q&oe=6A99A2F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5PdFl6hq9YQ7kNvwFg-4Fv&_nc_oc=AdpdFItLxAN-PuttNJuNUslIUguRGyJiFhqeL3iJCT1toh1FLVo5Y0nljA7WAl2gPyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcBZDbL1uo1Pcfk99zeOPV8TWKDVBjfEtvazstQfKfoA&oe=6A99889F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_dG-Tn0wnsQ7kNvwERe3fk&_nc_oc=AdpsuClb4qDt0YL2_01vWBNSBPMVmTzV-Y-HLn-Dg4kf_o6YDH__znWLQr7HXQjWwF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICpsL22FmS2hLQriFKXFY9zOg-_0jUD0zoNxTIyeoWOw&oe=6A999664"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP-ztx6xDAIQ7kNvwHkeRNQ&_nc_oc=AdrSYUy7wzvCOR0dPPTmXxYi1M3vbqoXofw5qjPXz0OM5fRva1sgi38XMs612m8EqV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzhIuQ1FBziGpipBX9JEdzy2G-pvD5h7VsDBZKF0U6mg&oe=6A999077"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfyZKyUxtjIQ7kNvwGrCMH-&_nc_oc=AdpGJSFlh-zfOUdcoo2Q9eIVhlcEm4iWGC73H28ZCb_KXZ3Rf63Z0PGimpPmWKyu9RE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmwnEm7rd_7MHaEMI1kahn4M4RzxlCAbMH3Y_kj47q-w&oe=6A99A01C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPC8AHaUG10Q7kNvwEkBpmH&_nc_oc=AdrB5tNq7DbNsEJ0-FztmRl1THaucKKgUgyB1j3HCRYw7Vk1rMy0rI2BMm-5KNF0e_Y&_nc_z
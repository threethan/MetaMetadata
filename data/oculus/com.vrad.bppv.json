c=IT_YZwSA4g0Q7kNvwG9vL2N&_nc_oc=AdrUZo5k3B56cmgUqi7SeZfW4EWInB5Vqti3gGbeMt3z0UD94JKmU3Lh6MLCRiCD79s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQqHbRA5Mdk-StIg1mlvcm47szHU9XrObYeXWn2jYBbw&oe=6AA54834"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJcMCUxefPQQ7kNvwE3Hcio&_nc_oc=Adqe3BSR7QpVUVfPpG9U4t6edR0bLY0XYmhjF14DAB2vEMUryb43B1OfRtmNLqeAj9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFCEwIkZeAWlu_HNBf64ztluaV37f0bp-rlF1R-zsiBA&oe=6AA5661F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f3Goa1iMNAQ7kNvwFNSEOI&_nc_oc=AdpYK1EFQWBtqAHOF6gano21R7MuMA2Nev23yeClIiUOXkzEbw_hbRAxfFGp3M9zluQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCaLenmzgeUD52V94iDXfEba-7nDfSIk5fhxIcEuYDWg&oe=6AA573E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn7-b0xvKQ4Q7kNvwFTAmgk&_nc_oc=AdpwuDJ6JTduhT6MDxgWh0XPvWacFydBacE5kotjf3o6B94kjm3J_wEaddgZSlrZisU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI06hfS2AN463wkoIZ4E4J-zBsaiseW_ISk5u11_KleQA&oe=6AA56DF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkZE1yB8TDwQ7kNvwHBlip5&_nc_oc=AdrreIFSak59yEZxNi7DOTpKYQp9m-zmb3qBIzMvV6S6BYkMwJfAOjEl82nRMK4hmOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6BadND1fHdS7ed5mQT-k4wEpB5cgNlpx93rtgqBhixQ&oe=6AA5455C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ4fhJCS7oUQ7kNvwFFTZgw&_nc_oc=Adpmsn1OLOlnzsqyP12dCegM-spfnpLdRLRvDdJwz6JDs7bQ3PDm7tJNN9jJ6LHQNhY&_nc_z
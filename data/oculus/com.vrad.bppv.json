_oc=AdpAAwx2AiByt5YcGi7cNn93BOUZxpzZaBHS_rSJR4LMXVGIRjEoIUBGlDhI8rR9ngM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00AX6Rmdey8cO7JlCG0Zq1Muf7v8PjbUBjjYfjQRAfMw&oe=69DF7AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOttb8NuR80Q7kNvwEeoGtG&_nc_oc=Adp_hYGMSaj0NPog-B4YtDRHuCpiKWDZ_3Y92vzjC2KoRRApH0v8vRhqpSzOdYZ6LxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00xQaUEOksewnxSBXsWISl7S_0X2WyzA31Xus3zoEhBw&oe=69DF74B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAEbX6Har6MQ7kNvwE9N6Hb&_nc_oc=AdrWSt9T3IqWzG9r5_R-yBaAbg1TwtLzVLG-upF9xMU8qTlgVeCIvkjxWgxkZd5vmuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FaLbBJTBEF_TLtud8wiTATGzDgXG2Ql7zVF8rVLZxrg&oe=69DF845C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFW2IGwRz_gQ7kNvwEBEB1X&_nc_oc=AdqgGPXl5ViYznsR7sd98NmdjvUtUDgChoVCA1eUo0aVzJi87Wxca8xS0phdYaxNApk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V-vj0D-orlUvAI3fP_L_TsaVSEZOOFgseSzCOoXaqbg&oe=69DF808A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjyrBDdt4_YQ7kNvwGiK50q&_nc_oc=AdqLTFCb4sfKiCK3gISxJ92u-gaZp5XA0p_ptHb6cwpMavoMPVTSsBAPl-qpOJA-Xy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2q9UFVsGEpwHm_IKk4Mq8nsEXxDN4RQHwPXUGYqM4_HQ&oe=69DF7459"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnWeJ7Eb-4wQ7kNvwH4W7TL&_nc_oc=Ado6gY6_bkhRal90JhCKltvnoyc9N1l8
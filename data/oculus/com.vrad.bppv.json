_oc=AdpqpP83NEUHS8t9ZiV_aeUt-ChGxgF1nl_ZaARZApw3fHR9yoA79-rJDRPhNes59tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8hELcp2KtAqYiOdHupY4ugnEO5GwWaAztWR9oeDW5WQ&oe=6AAFFFE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AvuXAxKWAYQ7kNvwGHEBMi&_nc_oc=AdohOid_YrkJtm7jDe22Dm75Glz0JnL8aUoAIEYgccgXJtqzw03yoy2Bv3-TzUkJBpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSddeSsALQDwUjKzx0ctac2Od1S1QfK54n32bBmsWPHg&oe=6AAFF9F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC1-Mb_xBT4Q7kNvwFgav6B&_nc_oc=AdoQ6DsycFQJ2z8QvubyYLzmYzZVjhPeVzjdRUFBGlgTZBYzb-vRFq83VWTnf2OKNnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Kno_D6H-KI7SIiwWeOliyIermwOBuUz2DocBNIg4fQ&oe=6AAFD15C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_FSOZt0-P8Q7kNvwEsjxxf&_nc_oc=Adps6eiEgdLNAeP3td-T-Rq1k93-59V9ZQg_Q0jGZEEdNOTLtpuxBz8HwBovJuifleI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl04ha1P1FX9TK2UNccsA15T5GwkPPIA8_gcy2ZspqrA&oe=6AB005CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65Yaaoc-wyIQ7kNvwGks0Px&_nc_oc=AdrSjqSktdrfYhr_7u0ZmjJQEH6wj-5pduQxuRyZ9zM4PwXCpgc4Oic5GdxBwqFGp8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhkP-t5FgQOsAYxP5vkvD8OyjmLSik-8NdQx5KqJmIsA&oe=6AAFF999"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeNr7v3LvsIQ7kNvwH9oDZb&_nc_oc=Adr1Q02rp9fnCzrgUuy319-J9W3gZJ-u
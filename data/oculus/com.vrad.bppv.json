_oc=Adp2Z-NWPh4rkSlJE7Hglq7SPYm4tsevLEM5wRugFtUb5Vu3DVNvW3p0pea_jC0YNDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNGYW_DZvUbIyEuOe5d29pspzj8DKpic42aitB_Svslg&oe=6AC3C664"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOvaHD6pYYQ7kNvwHcZBSU&_nc_oc=AdroaN5hHBcs6iAtW4wr_ee8fn0WL4ax7ih2TZXOPgv8NmTU9c7CExfKWuKVe3EiZzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLBIddfiyXAOxVB_Yf9JqSBzpEi-Ya7qhUgTJUrkVSYQ&oe=6AC3C077"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aB4rZvTOt0Q7kNvwFO0cS2&_nc_oc=AdrS8qTFxD6SjK9lwd4_OL1Grqk044eHegv0QtxJqFATRHq2Z_HotCeX3D31L3Wv18I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMblsmGX-gDa3uj3pu8MFPS_zSUhKMFv3Cci4H9Aqa6qw&oe=6AC3D01C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfS8UCit1sQ7kNvwEXF4Km&_nc_oc=AdqpyTLH-QwM0WAxRPiVezWwg65CNXdRLHoqsNV7iHXaTKwCMH7ggsZtKqvdfE4-HZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjEClVQtWBB5skcdh0QAiH0mrlj6s8vtLooD6MgnMJHw&oe=6AC3CC4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0dUKVIaSdsQ7kNvwF1mFO5&_nc_oc=Adrvjj2HxsnZu-hLYJwtzflfAt8YLZgYw0cORldu9BDq59GJW6G-CEowyAhT124Abxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQUKr6bnUYgbLXDqA8gr-fAPIxeZKCaTmHmX-kMpnREw&oe=6AC3C019"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI6WRSvF3H4Q7kNvwEUloKm&_nc_oc=AdqFhBiuZZcHcsP-Unf7UUQoCgLbz14L
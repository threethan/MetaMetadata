c=FlWlyRFSh04Q7kNvwFTC3lU&_nc_oc=AdrN1WkE0naQkw4V6JaJX_Bq8X7GO1a3wDK4haH3JaRjdSsB4Kq4I6XJoTiZNfJ7_X0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX4az_HDQ_OXQdiXaBJZYNwohVt2miBuN_zF1mHu8fBw&oe=6A6B4634"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdMWqKY9FzEQ7kNvwEecQ9x&_nc_oc=AdrT6P5TlNYMQyDRHydVDHpsJzKTKywQLgLgvSW42U814kyRwzt6HLf2UCyVbN-KqBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnjS-q4oQ6_70bNRpN4SRZF8FmH328w0eyXF1Gs2Fl9w&oe=6A6B641F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yYp-3iRbuoQ7kNvwE_LKge&_nc_oc=Adp4yh4ykzynpR6mc2TCa1z9XHTdDs6NhybMdMCqzPckdR4MTFCef2yVadHKWY7WjLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCunjlXB0NMhL6Eg5x5XlIZTNtw9TVIbRHqiHTYbV5pCA&oe=6A6B39A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwrbkeG1gzgQ7kNvwF3reta&_nc_oc=Adod-QzphBJA9aYyrTDcpQy918C13HRW5xqcz6s2U9cMpC95JPUG_bw67L2cuUGRAj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT6c4-AtCJCtu3CuI2_H7d97HmEVSfKJEXZj1GGrHjtA&oe=6A6B6BF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5cnmwrrnQQ7kNvwH1lP86&_nc_oc=AdoglXZhRJmLFdOLNTvTjH26sVZVQIhGo6ddrgbWdUE_GEkYJ2qMpLncqfwNpASblOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEIz-Iu9iAplyfzQQgCnJqAAmtn-u23ZFAohJ6tSNqEA&oe=6A6B435C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP9jAs9Ep4Q7kNvwEzXbsX&_nc_oc=AdqMwpnpGIV3BjDX0g3j7QrxWeMoBoaFGp0Rz-8eJqOFP8LaE3lPFAEpjI_u82fMUxw&_nc_z
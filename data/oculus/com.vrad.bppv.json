c=yjTZQqm581MQ7kNvwHb9JnW&_nc_oc=Ado6ljrH33COIc4y901nxvofot64jr0DoXxHkz555UNvZI8xCLXelWgIGZVJClXuB7k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiU_t1UBkJYTaDYLeE58dUNn0U_xxsbsytHTf3aiVLMA&oe=69C3D7B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odkghjaPoiQQ7kNvwHTY0Bc&_nc_oc=AdoS-USj9WTJbkDC7pYDOyjjzRoWevD59ajzu3NExowN0Wf5uvJlQe5svVqeXLzEBzk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU4zLdDEE4D3mCQb4opnr05g7sDQk_KS0UKuLtktqakQ&oe=69C3BD5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8w_OtOnNrMQ7kNvwHh6HW3&_nc_oc=Adptp_jMiMGmress0i9dkSdt0vVwHpvOv20pFC-FzIoLDf-lKKZKiZ1uY3L95XzvYyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFeUecQym_Davddm82yCgEOrzJL5lp7W7GGu7IC4s2YA&oe=69C3CB24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdX9wUqLQ80Q7kNvwGNNCvW&_nc_oc=AdpWVn6CmfWzX85WC_UwrDRxdfPdpCxMISGRVPgdd-lkupo2H4F9MUP0Wxeu1IqyZNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy84hZDr6G2HpqTlDRpuvYl9DDIDf25MfKcyN2t02L_VQ&oe=69C3C537"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_sPY4tLPOgQ7kNvwGldHo6&_nc_oc=AdqW3LeyplOX6P3af0o3bXxomkH-QrVhDTibY89GCzzfJqI1Nev_RcxJtaXWPkrTa_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7yIvI3lTOB7Z9Q6ZLD_awFXiP1oaSworwGq-yFxjQnQ&oe=69C3D4DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdYR1UdmTd8Q7kNvwHS-HIc&_nc_oc=AdoDoueL5Q28sTZS_v_Ji9FFprJGIyMYQcMf1VBIKUhYGC9xtlfbQg1eVyIviq9Yqsc&_nc_z
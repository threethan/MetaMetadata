c=g67msdxxeA8Q7kNvwGiEr09&_nc_oc=Adr-ZId5i4ceVvBvQFDCSyk45UoZJeR1q2vacSeMsT4zztGbG-5G-EQZrW6YlGkB89E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rLL1jDVxCUSHgOyZEwucO_SIOb-NxJfWexoabJkmHEw&oe=6A2BFE34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKVz45Ry0x8Q7kNvwE60WCc&_nc_oc=AdpIv0V6gk4mlcU7rDniJJMMXCEjJ9WZBI1nc3sS49sf7Ifs5ynxyb9bIhmK841dcDQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3N5ZBQqgx37hM9ENtt_2FbUH1iIDMBdrM76GWI8jNag&oe=6A2C1C1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaSojlWXH6YQ7kNvwHT6g6G&_nc_oc=AdpZnwtp5Kq4u7xNW3E1PF81Ogx1Y92y6VUYxG1v-MgImeF8FonvazI6ykfsasS0lSw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CJ8RE9qZT8XKWfz3TgxlQqyj9Cg0-prQnUj-8WJQ_fg&oe=6A2C29E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IqOvBRHNywQ7kNvwGGX2C5&_nc_oc=AdqRRoxPon4WLTpB-Q0N40acrfIZqhGsFI-Luz804RB4dz815Hm7ikZWKGWoBBcVgIo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aYrbWYO0x63zYWV4CPyldgSMv70GkHEV8abYRPkrStg&oe=6A2C23F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwHsikHD&_nc_oc=AdqT1mA0rj7FhTeF6NZkXYf7Zyss3Ua_zrXkcnMK0HOLZsq_ajjBo9IiIQ68rGLq2Vg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Do5dekriCx7KcpnnxmHOAnbdB_7A8ZufZTqsi75zGaw&oe=6A2C339C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5OhPQyHOhAQ7kNvwGVS9hS&_nc_oc=AdrLU122AhkF-Si5hsJzn-zGGGNI9ZI7NDA_MTSd61G4jRbQmse_a_LnkMY1mHKle1o&_nc_z
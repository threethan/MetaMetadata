c=w7Fa9MS_IKcQ7kNvwGVPjCf&_nc_oc=AdoUwQZeWaLmJjdZjYbelKKoNOvUvbajEVeLhVovdroZwFXRAjevacfZh1sOmv34gCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O9NX77q2tysrg2Sx9zO8-TYSgm4W7MWrxwCld_oeecw&oe=69FDD9B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuwtGjR8KHEQ7kNvwHy1XMi&_nc_oc=AdqRZVpTFPR5fIWQIHO2Blgr0Rz0HsrZ-44fn6k7YSfC0iP7bT0t9ar-yennh8_ybNg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J-U71NAT746llCfL-KIlnWuaR9LtESgNtBVyHOgrzGA&oe=69FDF79F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t6zNsg6zZwQ7kNvwGxcLDN&_nc_oc=AdqgPSMD0d8CqzPspt6TA3aAMSwEx7aCm2O4eTQI3KnDCc271UtX44equXV0NEAuU5o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eKyxP0NkXfzjaUdIowMnCMZybIpQOYgnrcvHbsdOnKQ&oe=69FDCD24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abS7jdm-MUsQ7kNvwG6uuMh&_nc_oc=AdrSExtTJIHFbgRUv3Tu2dFCPy1lLOfP1LTNahnMpxH9SndxW6m2vLQvq82eosr2AV0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-ewOchbiZbbSREAp-nrRB8G4u1wHAo_t5F4Rm5ojxCw&oe=69FDFF77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzr9IeYmv0Q7kNvwFYv6lC&_nc_oc=Adph7NXNo9ebpTbL0XOw1qvvyZ7f0mFSiQ3TaS9HrCnRz7F5FpGauTzA0uFq-6rpamo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cPlHuxDUbAj7OykHnf1BWkbZ6aUEqnkuaGgcntQCORQ&oe=69FDD6DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PTF7ccjfmAQ7kNvwGMHG0W&_nc_oc=AdqZ9w_L1dKERFzIDiLA10eWSloxIooSisHxiOE4IXyrCKPPW8PNqdAUSuVAV0n2uuE&_nc_z
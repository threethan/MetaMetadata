_oc=AdoCwhalBcm1RTXMlPgCUAWEW5spPDZQaZG3CLzJ0T19D_lscV_eeHTV2YOGe8zuOXU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQy_M2yvF8t42k4QaHEuWFOJ06bt_QrNmMh7ixvRrMA&oe=6A941824"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_QD3-sCxc4Q7kNvwF1og24&_nc_oc=AdqZGvirfzklAii8yluEqxLIov5Sqkgjf4vb1yOFO0oIVuCwBtIt_-A-q4ZmX-V-iiY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXxGBX0GEJif1kuzzSugnjSPJDyqlYmeTN_RjTRH9Uhg&oe=6A941237"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcIcw1QVYaEQ7kNvwH0eT1U&_nc_oc=AdoeDcCuGmLA906AHhBuBWsu5EYEaWL6T3pUaJRvzBmJcVDvwGiIORGzKS-87cRzAAg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDQgSkqlyBxi0DBTCJPG0CCjCRSox_moHwF38cPPLACg&oe=6A9421DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg3cBxuhWgQ7kNvwF5IJ4_&_nc_oc=AdrdQ86x4ByOj2Mvg1ZcTPKfnALu2YwzOpynSmTyES3rXZK1wQJmbZAnyLDQKPo5zQ0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnONeay4DzU-8FRjHeSlcug41wjGhAz9iNw9lA8M_Oig&oe=6A941E0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o6RToOyge4Q7kNvwGs-woR&_nc_oc=AdrKifAaCZt2tYQRpAluSCcPbQfs_NYAS1ro111KrcT7AApH_lpBNqCKOQTa3mOqj1w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9XBbdM6EPXBH4Y2g2VEBR4v4Pcdv9-4e_APy0txM7Xg&oe=6A9411D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOKyJ2iXaVEQ7kNvwHNBMhy&_nc_oc=AdpIAUxBriy_1XGvMb7CQ4NR5-9UDFgW
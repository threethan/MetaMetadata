c=7yOKT2xN1EkQ7kNvwGjTNKk&_nc_oc=Adq_KlrfE92UgkW5audkExhwDOj26bH9xqj86fieZVCGyinYsBrPY15zlEQ0Q_uvesw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f6wX4TJguRHq8iiDdGHHtGuAbNeoDYif5HGDCaTCHyw&oe=6A198934"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUt_fOpWZpkQ7kNvwEZZcBY&_nc_oc=Adrm8kioZit16oPz7fP6J8jfjDqVRo3GzDrZSo37lJvqADbcI5vFtnBaEIHLhw6uT2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i7Z4A8mcvmfTXEJQZqL79jl59rhqUhKsiUfJYGhZ5sA&oe=6A19A71F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llNFombOjzYQ7kNvwGjxf9d&_nc_oc=AdrxLVxToiM5gzZwlMqRKtwkqTfExQf1gfCgnxrsnFAvECsTOSDY_A3Tvx0J0FQP6m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jZaguAHzDnybIC-koLzWvENXHahHMX8ESQxF6YXV10g&oe=6A19B4E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THo61uTjiF4Q7kNvwHFRGRb&_nc_oc=AdoxuaEG6z2fomrY2GFcFH5asLzEtHTryrc-67rOPfIbLOii6ihoFob26q1GqZ7nSBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucBE84VHJbxGF5DtTrZAfFlqKozsAAFmqyFX1uQpKhw&oe=6A19AEF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxcXlr-2O-UQ7kNvwG2agyl&_nc_oc=AdqcUDpWowAyQ1CmreG91I7cLVM4_WL4WwuV5eZpvbteJHNq_NkXfOJse1FPEBTwKww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7olI3jlab6s8Fhzz9Vw7zSqQjMY7UJljhWwQ1M-BoO1w&oe=6A19865C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ67skjljt8Q7kNvwGTfF7k&_nc_oc=Adq2R8cyZSQenVn5EQtY0R0lX6MaXzMOEdf10pgyJrwAEgn_aLAAKMNdJJ3NiznDvuY&_nc_z
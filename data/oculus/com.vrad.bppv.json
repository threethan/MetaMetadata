c_ss=7f20f&oh=00_AQTdAyg8Zi7np0Dlu5c_x3pNDAE6gD7FmOBAESS10fsh4w&oe=6B05BDF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWoZcese38Q7kNvwGkLPht&_nc_oc=AdoCMzwvZmLZqrHu_K0fZuXx_TvZPFQwRhfZ4Xa795aBMaJUH0a1h_as5WH-FmfR91A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRkpV7KVQlJw_BFy9V46QS3V2mXrBilpXr2T7AYlJ9Tg&oe=6B05A39F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OvJZVT_po8Q7kNvwEylkde&_nc_oc=AdoAnCBBYzqD5Ab-t59JcuMOFx59xcS2bP0Jt_fpaF63-V5JrNdvh0sGQYkhMpfmKoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5wn4pcfaas6UQOy8YOwMMdeU7cAoWfcW3Bgvf29QA1Q&oe=6B05B164"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuYptKLtdY4Q7kNvwG8CFgI&_nc_oc=Adobr0bqojIu6Y1q6EflaFPX7xO4_TU_j06ZWV8CpPZWKy2664CfaBXyfys5MZ1gU1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTplxWZLpFmMLfjkKixJ7KYXl_Mdaj7DtP4WlHgBRjCjw&oe=6B05AB77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI02N44iyvkQ7kNvwH76eJ9&_nc_oc=AdorfuHYGFZ1uqOpW2QOMnrqZMJRtpa9dbm3OIj6CoMTLKo0ilU8oYdBn4Tzqe9U5wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhH4iOvvnb91GO_RiAzwogZwQacxOdz7mBV0N-82mgTA&oe=6B05BB1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCyrgUyDcRwQ7kNvwEYnL5w&_nc_oc=AdrtgaH-8XreN46ijh5ptTHJL5hsYmpwm16HXGKrMLfY45MZ1Xf4ylIQCzKIjm1w0hI&_nc_zt=3&_nc_ht=scontent
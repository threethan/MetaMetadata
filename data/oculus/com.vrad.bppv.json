iNRmViTh297yuLsDkWkGww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsnurFbrsJ3Vz953qx5ckUN3Jdoxpadu4eypoEiFRj85Q&oe=69A433B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoTWpkf9MMMQ7kNvwFY1Jd3&_nc_oc=Adnem-9_81zGV166OXgx32I7KlGJiNVXlVNi0htiipfqmd6B0zkMPMKG0MxNTwo5zn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftNdcn4hrrdTy0M3izI1RQubJsQz4nwdHjDffqhQsFs4Q&oe=69A4519F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Oul8Ke88lkQ7kNvwHXY-st&_nc_oc=AdmQNKNcGEmODP4ijBaW02_FT08OtyQfZoslqpB4K2669c-YuEhiNhnjztRte4bjbC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-wNejUkT1VMV_dfoSd6MwEGcEsDXTYUq6BkbbyQ2HEA&oe=69A42724"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAwZXNtH-QcQ7kNvwHGp58S&_nc_oc=AdkND1wvapi1nAmAs1sffBjsNvobGXF484LeaEGKcjA2bjAbyeKLxHZxn7b9WY8KrUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsLpC3Of56aIY3LZH9oNxJw2cD0OvXJOOshBEDfPmsxjw&oe=69A42137"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGv4voqnulQQ7kNvwE4-XQk&_nc_oc=Adnbo4jt7t-WXqgmSzB7b0oCtWduQVdIYtoYW0l372m0l-PR0A-irdBqmIs5F-_SIBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfunCzw5I6J8ReOAUlO4otXLOXfTUk9JGb4UOTi_gTltTQ&oe=69A430DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw6EvoNO99cQ7kNvwGxL5tI&_nc_oc=Adme9b9xQpKzEMlyL86JQsu0vb5ECilWjUNEQNt6CzIpL4ccP4fxVWke9UmZpeZZTkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4k2q9zy_GuaLdIAu_8zGr3ncAgePZn-Y9XuPqhL55fA&oe=69A42D0A"}, {"file_name": "015.BPPV_Back \ubcf
_oc=Adptp_jMiMGmress0i9dkSdt0vVwHpvOv20pFC-FzIoLDf-lKKZKiZ1uY3L95XzvYyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFeUecQym_Davddm82yCgEOrzJL5lp7W7GGu7IC4s2YA&oe=69C3CB24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdX9wUqLQ80Q7kNvwGNNCvW&_nc_oc=AdpWVn6CmfWzX85WC_UwrDRxdfPdpCxMISGRVPgdd-lkupo2H4F9MUP0Wxeu1IqyZNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy84hZDr6G2HpqTlDRpuvYl9DDIDf25MfKcyN2t02L_VQ&oe=69C3C537"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_sPY4tLPOgQ7kNvwGldHo6&_nc_oc=AdqW3LeyplOX6P3af0o3bXxomkH-QrVhDTibY89GCzzfJqI1Nev_RcxJtaXWPkrTa_E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7yIvI3lTOB7Z9Q6ZLD_awFXiP1oaSworwGq-yFxjQnQ&oe=69C3D4DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdYR1UdmTd8Q7kNvwHS-HIc&_nc_oc=AdoDoueL5Q28sTZS_v_Ji9FFprJGIyMYQcMf1VBIKUhYGC9xtlfbQg1eVyIviq9Yqsc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHtL257VcsviLNkSPAz5sswdJ1H50TGRdKVNvWASlibQ&oe=69C3D10A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFonuSyAS9YQ7kNvwEZhqQ8&_nc_oc=Adro__yYH-P_G-mV_bT6pRfS4t8_jh8BhGDDs7DmcB6r8zomruFLYMtpHwR4Jmt_Um0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHV1sprGKbBPFMgqGQlW3SZSUgvF8iuBJRgvbr8xuMtg&oe=69C3C4D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJi_8O9Bc_8Q7kNvwFBvAfC&_nc_oc=AdpY-x8ke2bpNDOO_xm00kL-TNG17Y7j
=8&oh=00_Afx8JB3u6SJDGH_3lK7bUY_wbKv3pIeeBq7a9WELefHcHQ&oe=69B3F924"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvPqOv7k9kQ7kNvwE_hxuw&_nc_oc=Adl_qKqJdQ4JD6clr6EwRAfD45dI7iqLd33CUjBRBN3N71CbSMl7IB-ROpIoeSJrZBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzYdJ3ur0Oj7iP0gGzoaWqW5S5GYUhrnYZN91ApR2Jxg&oe=69B3F337"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwEFgUnB&_nc_oc=AdnPRiFS3uWZAy3REaUUePXHr_EZioVH5tfNSV_ccDspNqUK883NsWDpOP5MWRxWT_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmSozm5KE2imItUKtZZpOFlF2OlOAWlfFJlgT3Db01Fw&oe=69B402DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3jQkRW3jSoQ7kNvwFa5--2&_nc_oc=AdnCSA4YjpxZ9Gm7ICFGDaQ7Qy_EQq9KdW5dguA5zzw2ijxBfSzq4Ou4LoL9yyuX4Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwdQCR6q7fT-QroPgUHjvp2n-wpfF_qzgmlymrnLxt3yg&oe=69B3FF0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cptA8SMlnjoQ7kNvwHl18L_&_nc_oc=Adk8fvl28Qg0tSw-6yeK4FTUJKs1Q-XbJQ_Il9yj4croYNjEsUwe0CsEOIsJjOrmCQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydQS_p0EwEOO-u_YkJpsz3EBo90darPS11p-fgUG4Msw&oe=69B3F2D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDGgx-USz24Q7kNvwHbFX96&_nc_oc=AdnR6H36HOMzQLoISmuFvK03y2hVJCBlnIiensTeS2op3Uv_ih8rf4HadOrdAU2Eox0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYpUN7kTAo7alvaKAMYU2XJAka-UBx5aU4PgMrodwsQQ&
=8&oh=00_AfxLUY_7JP28k_wQ_dEQFLLVRzwyqBq6BYeSAqtkFbnH8g&oe=69B93F24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVWAXCC04RIQ7kNvwH664gS&_nc_oc=AdmD-LH_x3RqEfVnht3Oxb_2AqxoiYXKx358LglPddVbVaSCmrwxvy59ujSGxBtkuyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afymtd_3IojF2_1kotrrE3TGmpb7KyRjmW2JklT1As5Nvw&oe=69B93937"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21pi5BrlLJ8Q7kNvwG7aFp8&_nc_oc=Adl0OfOaNzdN5rG5gyDzYvP8ESJDk8Nqzs5Gln6kO0b7B_2Sa8-Skgk2WEF8gYd_U3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaMs34X1aczyvwdJved0qeU-K2nUr7213zZic0gNxmNQ&oe=69B948DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6WS7rWJmDIQ7kNvwGeqh12&_nc_oc=AdlN5_q4pXSusebx32oKgXXsgKnjNGUzf4Ynry1V5XrutdHfEsgcyYoaKGmiMoKoerw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJAXliDOvvsX0DmbiRQeKiJSzrlijamo3RHQ0eHPIJvA&oe=69B9450A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uMnymzW_UIQ7kNvwHYkCK4&_nc_oc=AdnojDFe2Lm7fRhK-SviDkmQG0mudzJldPa3qT75vCKJQaQ89yECSryJvY0WZCo_Sd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZqsUNIYgbLbkMvXTROEfV6cnHPTEoEa4SOqwBSU0Q0A&oe=69B938D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfO0dVl1RsEQ7kNvwHIua8I&_nc_oc=AdmnFXysUfISk8IOJEqhyNgxy-hTkWmdbV2Wv3xAnJQiGdH0_H-ATr6X-vP4lgz-VZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwwkZaRbB9Ze8mkUpSk5DryOM-Mek7QlurKOSgQ-xasA&
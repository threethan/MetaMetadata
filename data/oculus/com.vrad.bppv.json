c=5POe8kRFTFMQ7kNvwGq5mz7&_nc_oc=AdqmH_OymlMFX-Cm5JriSo24dpbA8Sv4M7_QQF1yaWgKCp6z-3uU45FVemD9a9UButY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVvXMuSjs4g-0uZ8jQ61GlP_Ftn6w0B0Q8sFNYHoBelw&oe=6A95AE74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGny7UW0UwYQ7kNvwHH1A2t&_nc_oc=AdoIoTYSYyxj-4NqqH5O7m44pDiIUYEaM0Y3TiD2Mjt7A0WCxJSEKWhA34HLR71swbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG11GCYSqBkMg0qZzwHIT6HUHE2JzcBGSLOd1n4hZ9tlQ&oe=6A95CC5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjA5bs2cMLwQ7kNvwEYS2py&_nc_oc=Adqds11Sb3nKzJRbDfSAUsmXseQ4NnyoLx5vSNSQX049Po5jmci89MKtuNJZ3MYDryY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcWeFT3S1uLFTw8CoKGggnjCMJOxF58Jsfd52a_-JODQ&oe=6A95DA24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_QD3-sCxc4Q7kNvwGe9EKO&_nc_oc=Adpnh92A-PTec956lJUMUgCEH50kaPDTYkQ6oVu4bsNTSSrbV6TnQ5kzfuaI9pY7lwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESIIG10exbZ1I6_EZ7Ji3zSdTDw3Q9b9R2aCi5T13VYQ&oe=6A95D437"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JnRoe-_7oQ7kNvwH5ju2c&_nc_oc=AdppwCpNFpUnuV5NU4-rbYE7iT1V82IHZJKPdhkh-unVcVHuqexHTCWV7k5Qi-hvhXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Y34Wj6KFEPXR4wvVsqh4TakLlMAkFG0hUa1v6v_8-A&oe=6A95E3DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg3cBxuhWgQ7kNvwELGbWV&_nc_oc=AdqrfxeVZJt7A5C7yDeaIlxokfqjkvbE4MoMPi1ReNag5sq4miiQfqyunSAFyw64Tc4&_nc_z
c=OqJ5JClt8FcQ7kNvwGWU1bq&_nc_oc=Adrv4_T7_-sXAIt62qZzgYzfv6FWaDBIhn1kEjQa6e1dVSaRUVH9KjTKZv54PmXKLXU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dnnk-7GwLT7MafAIn8q5Kw5fsB1HVB_NYIXTWNYA1bw&oe=69E22A34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq0Zud6hTaIQ7kNvwG-FEru&_nc_oc=Adq4Nmbl7pY6mGqKZ47wGtIObNFtDEZoPd77X1MnP0Uo7m_x1kksuMKWtomUA2y-hlo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mZxBDbCxk1bQjsM4DVSwx4K4LYmlssHv38hI2SfkIQw&oe=69E2481F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovfi51q-jEQQ7kNvwHuE548&_nc_oc=AdrZIJq0zCm0Ha3AqE6fqHEWVO0ukC_ElCRsW1C2wmfzNZz7gfNpbdqAH_Q9HexzQMY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ga35mKowb-mR6xEqxPSElpTvIR9-VUl5Za0cdgzpHBg&oe=69E21DA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWE6uIlLUqwQ7kNvwGU18c1&_nc_oc=AdoUul7Zaoavz9cz2HSvqeLqsk5zFze_fIcvq1uugqck2owxvDA3qC3PWE2FfC5nRdk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YduM-b7WcgNC60leYMFzVmSQzamCb9GLY-H0WmQUd6Q&oe=69E24FF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAEbX6Har6MQ7kNvwFdq16b&_nc_oc=AdpCHxaL1_wAD6zc1kstnePkIvRYPXERvXlc8Yw5uIAqK3FxDopHTXoLReTqd1UXOeY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jPXxfDd0o4A3CZiBLj2TeqMEMh2JBmzcJqPM8uXpurQ&oe=69E2275C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gq0WCJTnVJEQ7kNvwFwGe1j&_nc_oc=AdosOK-mUTmaBgkgSOCPZ3D3DXKKSGCv8gR7OiV9l5nYF466KMSSp-uuQSXG7CD7z7o&_nc_z
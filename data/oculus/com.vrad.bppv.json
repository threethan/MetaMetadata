_oc=AdqqkN71IYLIMlRcPFfaNY5So54idqblVxXCYQbTKyOgC-aVUGyRonp-afNI1pN3BTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBwyY-r9Tj6wtuRK_RsEtFVuyeNcWlJ0zATq0IjBZNKQ&oe=6A9844E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP-ztx6xDAIQ7kNvwH61sNC&_nc_oc=AdqMQSMDa8jQz98S5j3_mC27SSHhnvPX_nFtd6raWiEyLo9im-eqILYI9Txx3hmLW-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5weTJf2oYzHpK_IrnTjdXezIS-wS3qduZDar0Jke1Cw&oe=6A983EF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JnRoe-_7oQ7kNvwGdc427&_nc_oc=AdrHJFemJMKlzEgzC3W_83XrvDSgx60eEjH5Y7K0BtpMn0ugamiBZZrXx9qP5DqTFD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKZGaOL5KebnNfxawxyuxHJfVskF1T_DR73a_7p63C7A&oe=6A984E9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPC8AHaUG10Q7kNvwF_umFj&_nc_oc=Adr-KKhCi3aPNS734nqZa7WNLRMZhN6a9vLYsZr8Yfv1O9pJzyh9XxZGz1X8t84cOMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9HANydP7D-AvjwDPvK-5AXz3OInC8ydx0pCFeO3AR0g&oe=6A984ACA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfwsUCcwe8QQ7kNvwE7Lhux&_nc_oc=AdqFFJvBCAbHXcPZ_pIR6LhIjNgtYXttZni2jRJHdJcO-eLuUT3Bf311R5Uode2ppXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx2tL6XgrfY3yud2gtG5rY-FZ_x48fw5AbrlC9Zvp2Lg&oe=6A983E99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0CGPLMA1YIQ7kNvwH7SVQZ&_nc_oc=AdpgSmy9r4UShNsD2msc5YwobkBl7s4w
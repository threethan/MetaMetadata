c=U9Cau_h3bjYQ7kNvwH3NmMS&_nc_oc=AdrNe-z5Pn0SjvtIlr5OJL59jSP41lmLZp1DDql1CUbpU9KKrWvI75jd_ZC78aHnc7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDch4X9-CXviMyWekxYJX-FFttr1OW_XMeUlSt9ijCCYA&oe=6A5B7434"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chdEmKXLYusQ7kNvwGaPI8r&_nc_oc=AdpO9MDplY3DXjczYAWl_d2_DCjrEbAdFK5bwkH2M9SA4a-0Fo6gtmH42VTpOLxHB54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ4qYEwHStr-MzDFfAcDdLxkUVcB5nb8MnWN-1jK2ABw&oe=6A5B921F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSTakcj8FNAQ7kNvwGYiuYf&_nc_oc=Adroq4m3F8mBO3b1XqTVrh7I-VH4ULVpJBZElPZ6n5gSYX8cuXM-82UHKLJxOkBboPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFx4mqPA9d-XKy2PbYVM1wjat4tKiw_c1pj3011IkYhQ&oe=6A5B67A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGYc8D2XC2oQ7kNvwEp4A4T&_nc_oc=Adqh84nnTYFH0zGGIlgBmaGuhI7kKLEXXqTb2ujDJ9pyem8HdqKL4OVWdHSgSn-3o-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4P3V55euAznMNUAItPgsdQFx2IvGO_pO5j6UrJEj7Qg&oe=6A5B61B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klsU8-E-arQQ7kNvwENnAgn&_nc_oc=AdqV4nis01x6RLavwNx8ysAqJnx6QKXv0dBXyBKvMEA43_SFTsPQqCMDlxqseZBuAq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1ZoOTWgcUDE4pn5nNzd9opTjxV3_eADSqB-8-MehfFA&oe=6A5B715C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PM0bX9_e64Q7kNvwGo-oOf&_nc_oc=AdoTm-3oNa_MJP4j9quib-A35gmHku1Hokzwc-G1jCMRpB1aZxWh9BYVnNaoD8SH0HY&_nc_z
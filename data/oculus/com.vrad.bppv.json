_oc=AdqoCxewQfnre_sF7JhUF81QtQP5fOiNrcZLL-LKC8XoHXNJE1m3kCeEn16RC9WMHQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AT3K-beYRd_NIiAEstSVxy3y_paxKk1f_N8k3A_U0tg&oe=6A0C85E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfR3wQhNkXMQ7kNvwE4amUD&_nc_oc=AdpXiAeo12439Cxo4jpaJ1xaObpaiot9qUdZZw_5pGJ3u_ftFzohWFjaLGBHZfsRjeI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dt7mAn3n1BnS9IAgPBTwdu_RqOp8pLDCH2JQM3vvwcA&oe=6A0C7FF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dN75L_t3m8Q7kNvwGDdPDa&_nc_oc=Adri4gZ9seYCWtOVw2hPAB-X8q2eqDKu6PZzMPLA4rwrB7jznGlcKDNF68zQECv33W4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5THZh_ksqFq002e5xc006cv1E7cyD5z6xe5GSZ16McHw&oe=6A0C575C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PoF1YO17hoQ7kNvwGSunHH&_nc_oc=AdpOKQCF-o9XAd6DFk6btJA4EG1YKCYKSThlNhTdb1gql35nc5FgBMsMPVN8G7BR0-c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YM5Pv_BFY6aGBEiK9qeMKEmxzVnXP3EmlETNmNcyvOg&oe=6A0C8BCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sszcqzDcK7EQ7kNvwGuqLcB&_nc_oc=Adr4iNEsktq1d1RRkFyE8cx2Apr_3nk6mhekR8m0D5fc5c4K3UkoBblLUghwjCrz6pc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U8HJ4aio7DPZjBCz7wl6WCNvrzvOo6ugWysJyDJdlUQ&oe=6A0C7F99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR4_JV5J9R0Q7kNvwHSi0wB&_nc_oc=AdpchmaYbCxpV1kCfYuf4HdpUEmZ2-aV
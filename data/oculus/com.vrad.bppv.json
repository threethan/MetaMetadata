c=RSPhcXuViHgQ7kNvwE9yaTq&_nc_oc=AdoAS-dQ_CTsUwwxBSyLqiP_MJt2Oe4xu5EbT46lTM76VOeOvDjQKANHlYCIgHQsUF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8xcP663T1Rfq-Gkg6AoJxmAsNDReLBc4fpWjv607CIQ&oe=6ABD0334"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um2bRTEw-ZUQ7kNvwG4JEhS&_nc_oc=AdofcovDGRg296LmxEeYOIgANbPsOJ8wAntuUzqFPdpmrkRgsd8lfl1qbd35uqoFchs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdBchpns9KNJz51oC_-Sa5DsqHKvcCGa4de3XfPt6uKw&oe=6ABD211F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hcBI_VX9twQ7kNvwG9Sl5b&_nc_oc=Adq5nKU3jKSreU5rnwJK_4OBBvaOz1lthdkXwQ5ngL9_rRcPQyaAp_TqwovY08_jBJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIemDT6SdGbFTGcV0tlCEf8r4J2KBWnCKJKgbUiEUDnBA&oe=6ABD2EE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kU6Lj2LplVUQ7kNvwHiIpnB&_nc_oc=AdofmlhQBHqOybzVuFSdcNtcy5KsWINW0JMgWiMFDUVo3mNkCZR3ODpb10NTVTuYkHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOCHgGY-C38HsUZS8Gjxhr2aQnBWbyNNXE03MIYEUpEA&oe=6ABD28F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS8Mp-iUJIkQ7kNvwEGiAU_&_nc_oc=AdpTZnC0N5kQ8eUfXEkmWFoFNPLMkGdg5F_223Fim3Ek4msRa8_7qc5IFYilCWHrC0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaETtCrwoeq7VmGc5PN9cHpfKKgL62mAdKM8pr-DOlDg&oe=6ABD389C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEHp9WJJwFgQ7kNvwE89FjK&_nc_oc=AdoQR_9ah9Mr8XzIuozMoOCa8Gz_FjGNVyWnk3EC6o5VkYXJWXlLWRKF1R6gCmDf9XA&_nc_z
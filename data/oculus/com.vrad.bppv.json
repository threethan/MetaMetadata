c=DQOw-_wfFgQQ7kNvwFFaWBQ&_nc_oc=AdrYyEqWv0zIMkK26EC2UdsIR0GKleb-45YZffznjI1FMl6eUmNTs0GkKmHTtx25oq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J0T1ws872gxbKFHhtBjtcm_Ju7nxNgeNbr-CknPWSNQ&oe=6A3813F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyR84BwyNqwQ7kNvwGGS3an&_nc_oc=AdrTAnAunBS7X6dajL__VTG9QmwRJJ1ZKapzWwym524ZPSJDeQ30hp5bLb08b1GYgNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L60FxW31-eglifjZMURmpdaCKJHOgCi5ILkIi93DOiA&oe=6A37F99F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkfy8wXMlFsQ7kNvwHucEEl&_nc_oc=AdobDARi58L27siBsJIv_llY70skxJdiv0kGgfVas9Ke28kgkDqb5fwawRvg1AQUZ98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QXMzJAQPP7BmijoJt28HtRaHizp7P78YKM-kxJZuuTg&oe=6A380764"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x82ivM7-5rYQ7kNvwEa7vVq&_nc_oc=Adrw5a9twxYe5YQ0kuFYW8vH4ELkGdCGGZbc_RDi1kQ6VZoV26YdS8OsefmMLQ-cMZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZvVQGVUpNT0yUqpn-LqGfeUxzhbZVw_fZMbkW-SpHZg&oe=6A380177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxBF5BBbWyIQ7kNvwEYFudt&_nc_oc=AdqLVXpEbu-15p50hJMkcOW3JR5k1ZbQz9RpeXdlBPmLVehJiGfFJnEzWdY-Qr_EPCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sssNqmDzl_bjP4A1JV3LXFSiplmUtA44Jp0ARmino_g&oe=6A38111C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq_xijuuGYQ7kNvwH4DEfe&_nc_oc=AdqDG8YM5T_2xL39FQh-PR6XzLHReOCm4W6vwMQTzBMzmTAs6PhbVMkQdNazgc9HDeM&_nc_z
_oc=AdoN6tWmEU6W12rVrVSO8JbpL-MvuKeYsfVUpJw_p1JMEUISSO5VCDFT9sGGL3Nu_tM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1usIby_KDgJyDQlKn8SD-fP8F6AF4vB9UpZPYtSU9Jw&oe=69C279A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdX9wUqLQ80Q7kNvwGeExef&_nc_oc=Adpe_S04mBChdB8sSq6bKWJ2eqqSg13lRYFA5yH-f_KXge7HckLS_Ox0OMKmycKQIhU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8grf6OzomOLt1lZ2Z2K0V4lV0Bzz7DIJmi5ivCu58ig&oe=69C273B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8VSuqzbcFAQ7kNvwF6kory&_nc_oc=AdpdnMc2LkasK-V6Gj8cskSV_5dcPVMo0l_gD-woAPpXjydWqKtK-QSgacZzBUii_9s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyloz_jemf-7HQF7z8lWbqbZYFsUNvVfkNo9yaXTq4XBg&oe=69C2835C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdYR1UdmTd8Q7kNvwHmGaVR&_nc_oc=AdqFzLZ4PNYB_NirV0CozoOS-gzZYU9ZjnXvjzp2vCcT21e31XsZCG9wrootW2Y4_Xw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzceHgz4YSk4np3g7fMrZZ7Uqy4xPWWm-KqFTOU-z234A&oe=69C27F8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFonuSyAS9YQ7kNvwFL0Yk6&_nc_oc=AdqpLRh-I-yHkOeojoJrtNj5FztY_pLhJtPbdxhNtK5PgNSpP9HXd8e1Hpa8UXiZnow&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWELnRKiFQV01guLZdmnAuY1a9SPTvvajPiMgoWhVj_A&oe=69C27359"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJi_8O9Bc_8Q7kNvwGOoqxG&_nc_oc=AdocYVeYkL62s1qZgfOuf0aW5QQ1MBxh
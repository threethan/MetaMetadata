c=TNKwWI46NmcQ7kNvwFRtU6u&_nc_oc=AdqSvgZYBr5rypsOosB69BZQZ1eOBfcl3UmCAoOWqQENSttr-6qcLe6Ibawl0X78924&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUCemGb0t5774AK62JML6qjQb8Olh_ViJHWLIB3BVXDQ&oe=6AB27734"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilIhdlBExQwQ7kNvwE3I8VD&_nc_oc=Adr7VuJNmaksXzTNUZppRtyY-QpxBfk7-D_pFdBEtoeonSrMkPQbxPZMyp9cjWWuL8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_OSytcl_mDnvEZU62yTkodZ5MYyx9zTJdwgEHO85ryg&oe=6AB2951F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU7PL7Hna4oQ7kNvwFaHY3Q&_nc_oc=Adp7cm2tP0pVQKxbIgATxBMMoLFvhPvOGKxOH26lja_KEE7ok0jk_bTjZJm-0QGae-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCcdPu54gJchY4LGVyFL_HcTD4Wp5qDdiBOKN9mm8htA&oe=6AB2A2E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AvuXAxKWAYQ7kNvwFTVGGB&_nc_oc=AdooFfs_Uescd5wChjy8kAEGQTAqiY5kwAeeqAXKotDQ3jdGyGE-8bIC98mUKQH3nvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG9AqAMjiklVMLlV1ggHDgNbCpC4717bTiJkaIVdmNmQ&oe=6AB29CF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWnAlf2mntoQ7kNvwEdW05j&_nc_oc=AdrCOvqVTTJOWg4rmc9rh5PRnzTJbM74-ywNdpEB9ze30dNh0uoYVmguQuy6O0v_RaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV0_mqXNSYH4qCQGGIuj47ItBqDMpIK5ATGuBE8yvFzA&oe=6AB2745C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_FSOZt0-P8Q7kNvwGodnlM&_nc_oc=AdoimYrf_MwfX0mub4bCpYjeV1qT_2EMMxX8yDqHFTJoAocy8T5lGBY09xlX8f8UrbQ&_nc_z
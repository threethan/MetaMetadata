c=Jl9ZAHwF00EQ7kNvwGUanSj&_nc_oc=AdrJtHgxLM0CU9mNo9OEru_n-EZe8lyDBXduhs1kEQUD-9F619lyCXXcKa1X4HxvOTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPywux2TfQxZIjTJ3Loa2eCSumhogvm5eH8ssmk8LAzw&oe=69CD1234"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNnIsNjsZ24Q7kNvwHEMqiX&_nc_oc=Adr4UaYrxkRxncJjGnGCdCgTFOFs3e9_eL1J574ELE5qtLyuhtWDalFtL2tSwmsZk3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpE_HvfUGpV7zr9uV4-rqjAKeuvK2GXtp8vUu-ZNHvlA&oe=69CD301F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20by2Q_Vc_wQ7kNvwF7BNCG&_nc_oc=AdrbhzbqzjCLU8O2dE4KeWJzq435wzUkRS6BgJOHZjOOBdjRlCtN_wxBMBfzDqFaQd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2PhswjzgEKBbGD_8y-sTaGLATCtZ3DdBsYO3x_D_Wfg&oe=69CD05A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-D0QaSD6ogQ7kNvwE5N9Hh&_nc_oc=Ado00zPrv0Dp1VOvNhk-kavK2KVaKle_4s5rzvbjHKPDBxY9hfS9VTdM4qJKCiQsLtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIvGXclnIz-V9UeJB7u1_QHjirHDcgMGJjDEbc1sqPUA&oe=69CCFFB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Rka1E2rF8Q7kNvwFYbTpZ&_nc_oc=Adran7I0sgpePNlyopx-JiB2sv7QDVtodLy8CPjK_fnnEX4xqMXdQNJVHRPt7-4e0vo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afweun4ETb05FgDC-POfBULZ96Cdf6ZKzKfsm5h4YNXLlA&oe=69CD0F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvlKis1AtpwQ7kNvwEdAlNU&_nc_oc=AdpD8WQCULTshZLp9yvvNjWcSIfglQjOwUZ2c4N06XMBdz4vVhGIhuG96hF84N1tElI&_nc_z
c=owjLH-s2-doQ7kNvwGI-UBl&_nc_oc=Adpk_KPFYucVWNa_XwIHDjDX700dTBbOhHK7nxLNycyALWH2Jfc7GUegP4Ls9Y3eZNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q4QfI9dveG4NYLhLIxEePOB6N3tzhsCl_4K9l5h6_aA&oe=69F9E534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQLR6Sysa2gQ7kNvwF72t0t&_nc_oc=Adqqgf6BMiu657nSo3jkjkpOT5L_OcG7q51qMbTitk_35o_2JEDbHXZ5zJQlcnEe8Es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MLf_Zx-D4vLTmdrso7mCkkAklrH8ieSyDi39z0gmdHQ&oe=69FA031F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTUmUz7dBhMQ7kNvwHh-lFQ&_nc_oc=AdqkXtCcdiaPdyaHPv9kx0ygvnNxDtlqpF7h_MC8LfEIqtLNdmHNTqTbIEazbe-Ka3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yiHQBxiQu7wrE_fPnGpRnwzU4OQtA_FjhQuN7r3z86g&oe=69FA10E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMNiu6uaC6AQ7kNvwHkLFAL&_nc_oc=AdrsoUfnN2E3tm_KaTFCQYq50XhU_elIwKF6W_LbJT5c1NYmzNFel3lxxauelalgSP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-bFIBSevPBxdteyiGw0AImEvDf2a40x4g1eS1KRgaDA&oe=69FA0AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd_-DUStZhEQ7kNvwFJ3mUF&_nc_oc=AdrgEhUh1cowYxidsRtXJyQu_TfF_jyEvKZK6m1Ht3LliLzX2mqal9qOXz9zxVR_hrA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58-YCP6QEjTaTfN9y-xuthnGsMI6ys1RvIFptHe60UEA&oe=69F9E25C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53tuiIUPNQYQ7kNvwEC2sOp&_nc_oc=Adob25ZJ5tMEkdS0v9IYL_iMDHdP-bC8TYfDbh36FinxUgwA1CokvGzYlnmsEY-8ZnA&_nc_z
_oc=AdoZY0LEykHWYR_PB6ZCb1NkwEuq30xNNT0QXmhTVrnjZwv5KoiQnODQT0LwTk9lPbo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt1_m2WO89sEaCBJBsf2DiW5M-IcyREvJwGwh9DJ53jA&oe=6ADCD2E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKw5kVfxiUcQ7kNvwGSe4ac&_nc_oc=AdpsDFPu4gPFEQMgr8o32JYP6z9ftLafr4A-axsyFrGGg-SWAjlRZCq7p4irLY2k5pE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7Ot5G8k7Ejny1qXdxO7Iyh0pQP5WXcaBZybV-mdopiA&oe=6ADCCCF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnPVbNqoL9wQ7kNvwFX17xd&_nc_oc=AdpcX4xDi_NjxCy2F3mhTA9l4kNkWNKdp2bdoz5E-b8B3DkFGGrdf65vn-zRx0Mohjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvnUOvcnYthHHN6BmXjSAEd4Rz7DSOfXB8U1vpVOAklw&oe=6ADCA45C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6htGFPeHM68Q7kNvwGbr7l7&_nc_oc=Adqt4FxXjWUnFv7sykK-zIXz7o9r560cKvTrs9dxGc7cOC0wTl_HCwnrIZikaj9upwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDDWMYkcL-OKSQFzuSPs08qztcvObA4tn-0Yy4UGpjhA&oe=6ADCD8CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E1REBD30CMQ7kNvwG0MBqm&_nc_oc=AdqEGxtNbWev44M_GSlzMxmTw4iyZX5yg2NAcwJAem5jug8PW1b8EKXl6DX0UGG5IEM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZodMZyEUQrBCtEs2Q18M7Zkt7qDmpc7_Or-8eKjDycA&oe=6ADCCC99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE0GTlzSQWMQ7kNvwF7xMZl&_nc_oc=AdrsiEkSpnBujp8b3OYjUIwDt7SagDPu
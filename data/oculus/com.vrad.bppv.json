m1q54gGusg4fVrsbesn2wM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu0JuFfLYFA7ipXjzbfXSKeq5WI9Ee-xyd-phRlGQXJUA&oe=69A190B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb_mYWpllqMQ7kNvwHVY9UB&_nc_oc=Adkc_rTnXwiJQ5ijs4n6bDgOmLF6xvFj-YMZnGDqZhBO9SfDMj-y-hvZnp7e1RpRIO8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuMHLtKx9ww3ZFSp4KoXYuZcFJs5bUd_TTm9q0Q68Y5IA&oe=69A1765F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEJvCAwvB8gQ7kNvwEQJFIJ&_nc_oc=Adkcxpe_NrOQ925e0v-AgxBt_BGde9kZ0CCMXAWhscvbE-68HkxFuB86onN-e2sHNik&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftrtFeieUl_UCu-SYuAIvmvRyJhZ3WcQvGiQ0c245nNUQ&oe=69A18424"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mai3p15caO8Q7kNvwHrrWGJ&_nc_oc=Adm9jOOeK-95PliMh31ehJufC-VgX7Ia_yTOLVs6MEfybitWWpJH03iCMbRxyDXe8VI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvmT3Pz7NH1vqWXbWPVNL6hzhJbFiJTKQPvZmsHJ-nM8A&oe=69A17E37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plR9ZSpyzlcQ7kNvwG6gIES&_nc_oc=AdmdyFN6chyotnveQup51X0vIvNyqRmC_FBD1cufHl-QzpzkkAxAirfSz3QklMsnH2w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftj5wrtl4LwmnIGDFejZeni1X5j4EvT7Y1Cnk2YIjeKjg&oe=69A18DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z9s7dbrzx0Q7kNvwE9LbLH&_nc_oc=AdlkKsniWu0_f6itM6MjvhLhR-G3UXIMpDFbeO5r6Ime2uoRtoEtT7Om5WnUd7NoOC8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu6wDaudBrnHK4GKUTRZyJQowiOlWDZPXdyw-sC8dbKag&oe=69A18A0A"}, {"file_name": "015.BPPV_Back \ubcf
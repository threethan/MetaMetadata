_oc=AdoR-3H4s537PrvYbuPtOrpbwHlu_wdChjO1iI3TGsqgv3M76-BlbmC4L9qZ1AYy6co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDIyrDgprM8Ui2e5eLoDFWa-ZdIptEXqcErlp0z8nL-g&oe=6AE4BBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpvDJzDRuEEQ7kNvwHbkYru&_nc_oc=AdqolJWJhVzFN7LXUPnkBRWb0UGZx_68UmRjCq6W5jQ5vZJ_302K6dzixaa0obvIrjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCK75EuoNcjbOwYCGNAOT4aKd7vInmdTruKOM25T_eIw&oe=6AE4B5F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn_4LbCLPBoQ7kNvwH60Ci3&_nc_oc=AdoiLGrbF0dOz0o7msjTgEDyQ9qss5DMNyNstysKtlZdSOVZnIK130JnEcwVG3jFIGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvB3SFGvzrIUm1zalgqoDmwwOiWspuaKFe88H5YCJqnw&oe=6AE48D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwblNNVH1ukQ7kNvwHaoIYm&_nc_oc=Adq3z4yLl_4KmMjyYCNWdCx9pn1M1TMoA_wYpHR6N07cVCbF_YVxvnvJXxCdFQyBeJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi7Qhfe2iBW2N-auTH65S7IBiozxksvKvxHQjYR7vhrg&oe=6AE4C1CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt3QCckvO2kQ7kNvwFfmPUA&_nc_oc=Ado0eaoIzIMw5_9m8xcctmAofbxbuf_iVy3mvzySBFkiaRSg_bdyyotZgKIgVjkWDW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGD8quBa3tYoDWgLV900WdQcXOwZ8yB3jjrYRFTBlfiQ&oe=6AE4B599"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCPCKidFdiQQ7kNvwFBxaFd&_nc_oc=AdoAKBDII7ohwDg01ehEsY8rlLeYpeob
c=7yOKT2xN1EkQ7kNvwGa3697&_nc_oc=Adr-CNQydCZDCTkEGK-vSZx-zEAcYVfGg2l7LrhpzbjFZmYQ92jWxvv7BwXGlm0bjok&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NNG4l2sgK9B5sSv2NRz1_jMEwsITQf3RbucgYjAShaQ&oe=6A1C2C34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OekLgNiFnlgQ7kNvwGfVE6l&_nc_oc=Adr3FUiYacHJYaXsqU7zRjysZ5IjMF0arxsfM9YQm_KpDTqtVZH7QJr8FyB4gY2icyQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DiN3QnLyrXF0Qf6qhxkjGngITJIMZP3Jtee5XbE14iQ&oe=6A1C4A1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YTqfTjwv6cQ7kNvwElfLFB&_nc_oc=AdrBNpnpDtwANSoJmOzRTiEEypnRvJOWgZokgy8mOUsifRvwyqHsFhaGcTmqUL0EFIk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7raSxCey-ojqr_FKeLzZ4pMP9pOLTcYufa9K0T6EoZGw&oe=6A1C57E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THo61uTjiF4Q7kNvwHBW9qj&_nc_oc=Adq5tMFkcTckRt92KcIsqwRD7hxfQtAXX8Y545CHipkUbTIjFm2Q9n9e6ersHxVlo50&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uiDRC12kxZRPstyXMKbVsTgPCFa1Lnxny37XC_ahoSw&oe=6A1C51F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7iLYoi3a28Q7kNvwHFKChA&_nc_oc=AdojZUyM2f--_xy8VT7Ochsl0J_Jyusc9tGqTnD-uoBPeb5h8UleFG7myayV41yb2yw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61PjXpPdFQ8VDSCyHK379R48ZVjolPBOv-apHBHIXCGQ&oe=6A1C619C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ67skjljt8Q7kNvwEAiNmO&_nc_oc=AdqYnz03MUx49Vt0QzLh-hfAiCREETBFL6clT7tdkLX79Xluwqx2Re2OlCnw6I1KAK8&_nc_z
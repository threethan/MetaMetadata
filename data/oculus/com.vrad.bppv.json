lWBdK4Q7kNvwGrxKDS&_nc_oc=AdqCkVHz6OKf4JaBam25OOVyPY07BRWFc1e9JPrwFc3MCVkdX2VCePMbega6yf-8Fj4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KqJOPTp6-HcS7Tc0UHtFK9b1ugXTFFoHP8fMAgBF2Ng&oe=6A4687E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WSp5Gbb098Q7kNvwER7w4l&_nc_oc=Adq8Y0khnejgd71Fg_pYi4JECjku063q8zNeoval1QIYn0muI_W_6lOjMNjOCXsDMXs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QaDCXypQKvAskvkhdkMzWSPFd0T2J-1QPP5PUwT3J8w&oe=6A4681F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsM3GtNG0jYQ7kNvwER_ujR&_nc_oc=AdqLhOI78ZqE6HOz_RMtawkqMbZK4JuGbZ3ykLi5yC20XOmxfeFIfhZyoWyJP5j_FRs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nJDbPYr8phII9xpDXrrDM7KSp1hQwBbbVpOqZxJkFLw&oe=6A46595C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo8PChMcUyMQ7kNvwFH8OBO&_nc_oc=AdoyMSne0q7WLBNxKwm7PyqeXEQyh77mBZZK6T6qmXwzjIvuRZadajl8H5z8jDJNrLI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F9kjKRCsHM8glZ5QNTlxgSaxRcFJBMZh2_KPDym3Q4Q&oe=6A468DCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycn1b1DlFNoQ7kNvwEXdjPK&_nc_oc=AdqRVXCIyI0JC_voZZYLMIeiHXFPU3vR3YtpJcdDxUxsdgQowu0DCl7VXGsRCnnI1vU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ufZzqL3U_eJC0MxNFJ_j1ohw0cPTEKFEA0lGGsERaEQ&oe=6A468199"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZb9avMiagkQ7kNvwEP1_Tk&_nc_oc=Ado
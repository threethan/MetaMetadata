c=LkrrI7oyUwkQ7kNvwFEI2xF&_nc_oc=Adoj9tKXZIqAV2QVx7PKTgelvgKSanqcsqpnH7aesqxTT3U8hibLf7SaypQa-SoYZmw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kfSVhVCPXCgro_WYoSv0NgNHGOK5iVCXFeYIE611VAA&oe=6A0EFD34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXVMthvaZ7MQ7kNvwFbO5I9&_nc_oc=Adok5MOMNrFvr6FQlCmcLsRId0zMHUl85cwIpjg6fdW9Eee_19kCP8YubktZ2u9pBEs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ffAZrATdgIJDfYbCH5ZIe4gqAMTPSTg299W9KeGlcKg&oe=6A0F1B1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Xrijw96JIQ7kNvwHnYf6e&_nc_oc=Adrfaf--_RHuzQgxItetcMUTiaeE1D0YnMDgg2qgfnhxU2kRMsyMRumoG_acnbfjYzg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o7o-551SXg3iuIZ47YdX4Io4_k915mDt4J-H4ROBI1g&oe=6A0F28E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkVrXdYHmY4Q7kNvwH_dy0f&_nc_oc=Adq6xIBfht-ELmuZMGUaohuEespiPJiJCjHmv2LDaNZHxNcR4CMA6kOrUPWpGOu0t1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EXsV9uoaUIAQiTVnQbZ6UlYcGcpfwhnu8GGHMIeSWTQ&oe=6A0F22F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYEA1s7bacoQ7kNvwGnyQrP&_nc_oc=AdriOFPQz6quusKl3kEGX_M1cmjTrO8qgiaLdUxzZMo7m-8dH9aioTGiX65PHUIIcZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af760AIGCu-tuFRur8fLmTgQqJaT3B-VUMUlaO2pJt3YbA&oe=6A0EFA5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZvjakI2Z38Q7kNvwEyF9rV&_nc_oc=Adr4rZ1ICpCQFVK6b8Vk1t5gwf6evdxlUwizZSR_prDlHP6Vs5E1H8sb947JzJnRBGQ&_nc_z
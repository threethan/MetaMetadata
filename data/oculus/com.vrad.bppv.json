c=AoI4Fr5LWG4Q7kNvwHDUO2d&_nc_oc=AdpxttxtpByOSOB3pqfH3cDTDTfsS-uD9WBlUSdBLP88T48z2_wZc_RPEWAo6miuY6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_8k0VKvUuTNFvT2IFaUk3Rzv4qA70Az_bUxdf3e9CvA&oe=6A1D7DB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OekLgNiFnlgQ7kNvwFjhWUO&_nc_oc=AdpSKobk45q8Cc7HTJurDcH9F6U5zhk0dSIzvFFfIwO9XInHYpkATCzVQd7Uoe5KF7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41qgf_zXrAKc2ri00MUtZq5ZajB9h53Jql8zumtpyn5w&oe=6A1D9B9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YTqfTjwv6cQ7kNvwGfqlND&_nc_oc=AdoZ9VzjO5ra2RyXVo_utBkOxyE3VCG67jdWEyRUsvFGJMjp3SceV6Nw9G4AN3U-pnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kOUb72Uxv5bmzfmk8-cotjQE9jZkY0AsbYKGwB35SJw&oe=6A1DA964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYlHZ9ZPxOoQ7kNvwF_tNyK&_nc_oc=AdpLfkRJJORygJquXWbDwI6n-HsbaeBfwvHj6smAY3oATLQBIM4xcQnvJH4vNGeDAG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gCZyXeAO29lWbhaaLkydsvVOEkJB_yIlv9TD6CwyIfA&oe=6A1DA377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7iLYoi3a28Q7kNvwHVLrwH&_nc_oc=AdprqWBbqhtdtcAvv7DLQafxaVGJYU88AnIfswToPFH3oNIHsop74I8YhwEQNZW_D28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eolDZRKF3MAldDd2sX2Ol3t_i26z6UNPuMhFQ_a1MqA&oe=6A1D7ADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl_CCI3grGoQ7kNvwEJWT7v&_nc_oc=AdqFgSgj_vxAnaBsjby6E4K-IlQPrwMOkOCPDxkg6v1Cxus0y3-5Bu-Ls277AncHApk&_nc_z
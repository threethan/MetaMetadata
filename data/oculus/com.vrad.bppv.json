_oc=AdpXx_hbzv1YqXfzvke-qxj477f6Y1aeda_YTke-RM23UdSicaipXfyz-JVjp9b34OU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UapM8KQ95z4Mpeq9Dxo60b9xl7ifhTcW4iSdPUzRbHw&oe=6A219DE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwGxoi-p&_nc_oc=AdpxLJt1fl-3qu7KSjK0iMk0R07_JIhK0oCj_07zJmZOK0T2AspC2bu7MUp3vzQuALI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wtz_7tYnRaJAtjCD5lLQeg205MF5YuQpBIgi0UsCmPA&oe=6A2197F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZyiV92gPHsQ7kNvwEm05az&_nc_oc=Adr4TN5PFhSR37ezLOuBytwWRiwVk7LQW-8coaZQmKJBYD17sGk2gJBCB7bXgkzwHvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cISTvmSZZhN9Y3l49EogNFrOmjeDEN7CuYGhT7SiR7Q&oe=6A216F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwECczax&_nc_oc=Adr8uaImyvwPUN7zii8UdAU1cHk-PbEZev7IWWcoXu2SXGzalSvu9gCEN2iSn4VWiGg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e3JqGwn6rxzLEM2psnnW0G5BLDJoA02d0Cvd8p3SU6g&oe=6A21A3CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gySJ2hEjNzkQ7kNvwHYpOKk&_nc_oc=AdoWaPDRNNl_FW0hXwAmbYSgYdNUF6Wi6I03rnvb_e_ret9cqQzlkXLjPIzQSvXXL8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jl_x1a70c5cutIYHdc17zhPVD-yBdAP-ZITfhGotsBA&oe=6A219799"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vetj0r--DUQ7kNvwFx8rum&_nc_oc=AdoYaKheogdg_-QD9LL_V8QMzqUqBeuS
c=KIUdj7W_SMoQ7kNvwHbBeIV&_nc_oc=AdoX7FwcFrJjUzIMi8k5XCEc5w5uxsaANBuxh1OVuAx6C8e15QjlATmj5pjupv6KwrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz-rFVSkyG2KMUch-yVbYvd5qJlV_Ddux6KglU5rqS9g&oe=6A7C69B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qp8udhy0O4Q7kNvwHTxV6u&_nc_oc=Adrd-jSOzFs7OaEGioCq0rY-fjXiTUM-DfUqBVByLjSid1QpkpDNwcSA3TJwSRpj_Co&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKCOMZjau0XgoKGabT6gEqwb2KXFxKssX4LHdDxkIlDA&oe=6A7C4F5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2seiPH3V64Q7kNvwERCPEk&_nc_oc=AdrBtBTzaRLtFzb4QXSqwXYpQ0WOWwT7avYjsn8RbFFPVHra-rxDQYNwY3MastijPSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG88vEcV48tDAK7Hi1K2IqUIoM6VRmiLvv_CdnQlf7TsA&oe=6A7C5D24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwFkP0GR&_nc_oc=AdoxVqgsQf0CdX2cFrFrwAfjCiG7c51oa1-pv8Bew5fi1ubf7OzfhcMzz9uyJRw6v7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2AVbr2vBVsaJrtUw8Ei0xlsbHYnYHX0VN-5-xnglNOA&oe=6A7C5737"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVArtsPuNQEQ7kNvwHtmfPQ&_nc_oc=AdpyXcUkxst8schN9lIysygnqRz7tF2_S8Lb4gji1jvLgkRrqBbaVcQ2536xuLADq84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO9q7XJRXDK-TsSYthS5aXnKF2oOTiO66VVKa4w5FJ0Q&oe=6A7C66DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwG1kSKQ&_nc_oc=AdohsKnJHY18ohMXjByqzoyHRMZRwAOFtAVPDJ3dA_RKbm__Wix9t5QIAqoZjfwjAQA&_nc_z
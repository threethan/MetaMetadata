O&_nc_oc=AdnqEwAjs0k0lQUvKGJp4rJnup2G24DNaAAqhfLYORXWlITZ5bYMKaaFd85nPKOBeKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwmFFpblocBTN84XEyhdgfOINmbqwtjFWlsDCaAI85Bw&oe=69B55734"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWK5zCSVdoMQ7kNvwEM20xP&_nc_oc=AdlIUT1uqShe8uHCkF1DRMZA3uH8EIQ4C6DxaISqtv8Z78BOSvIgenZ2wzIUssWvsVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWVlr5jPefF14u87qKwFBofj6__gKg4AXDpbCSy_hDRg&oe=69B53CDF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_V8YwlBNjwQ7kNvwFXMJRl&_nc_oc=AdlELTg7nOiweyh5LtsTEP9-muCYwadxkI_c7ZLsLu6kgc5kdxHIj_lbEuswyKRHS68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmwJtYLZDnpImPfkepj973rOSMQPxx9wLPF2UAzy8D1g&oe=69B54AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvPqOv7k9kQ7kNvwGefnHn&_nc_oc=AdkEAZ4BPuQOKWfpsIiKLAt-nm0kETsDVdqXzad9iddUhUZOcKoN8theE9CXZgjVlCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz71xmOFObDsvfhwbeFyC7QA98l14LIny5ERSAZ7yvR5g&oe=69B544B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwE53AIb&_nc_oc=AdlgNNDR5H3ypEOm2YMIzaNau4N2g00Id_0awckFIOiwQKGs0rKxBE0qN8FfQ6Ia_Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzplIaJrIB2Rvatg20kZuE4dz0L8ggEPHHgewadQXh2xA&oe=69B5545C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3jQkRW3jSoQ7kNvwGTkCNd&_nc_oc=Adk1MpjEMyyDreAYMLkyWsHZHF-aC3zbGYtdoOxIggvF3R_dBCWuA5a16vc1yfFRAp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc
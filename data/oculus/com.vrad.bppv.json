c_ohc=KIUdj7W_SMoQ7kNvwHhEYxX&_nc_oc=AdqJvVP2j4rg-2dI81q5m0v-JEi9LmRmBAzFhp3cRsLz-gvQFjsc-K8PLCIxDimQjsE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ2djn4wMR-DOGxZ66yqGqAJaYLQToOk0rZUlyoBGo6A&oe=6A7DBB34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8990oVCTDK8Q7kNvwHaxWiu&_nc_oc=Adr3gFZ99DQTAYhNfiRjv92LDHR4oDQwunRi4pB36U6Jtr6CJTUcLiRmvHxvhmS6GsE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUFTFFEt9KTyiA9xtMTT1Bm3Qteli1yG8dbg9ZX5JB3A&oe=6A7DA0DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKNTnxJIQ8Q7kNvwE3bWEr&_nc_oc=AdrMX2u0LKZbUvj-K11-ghdjTF3AgCta86YM5D16Fqk2Mkg6f0whUdCodH2PNyR9foA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoSpn75Fzy9Nab0hMb17FclxK4PEmdcDvT_oX4YbcU9A&oe=6A7DAEA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwHOSfc0&_nc_oc=AdoWNPSL-lEaCu1wJfGyetRm7PmJR09oqrwAil5VhUBnLCmk_7Wz_dmxaf4moQJyzPI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgtjU8fZrlBjzXwCa8H3Nsy6R0akXr8lS1CHMq_D3INg&oe=6A7DA8B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIR3UyBl8AQ7kNvwF0aBGY&_nc_oc=AdoR9KtQf-Gx8eaL2nKOc4vrjXZ-qjTCvnmbvFYfOZ1NgB0snVyOMN6QfuLuiST-Dtc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Cs0Z3MAtUghKumvQ9Jd1ChNQWeXUyZoH-Q6T3Mr2aA&oe=6A7DB85C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwEr8gE8&_nc_oc=AdqTB08lDo9813a2k60ij11zrv8570d2190iCZs6iRFGWPR6opoXb7xkSP5d0jq0Y
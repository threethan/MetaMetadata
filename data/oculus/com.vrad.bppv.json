c=EdZQLOHzKhwQ7kNvwFXjfCL&_nc_oc=AdpgoJqfIsg21N9hYeCOuwD4x-jvrU5y374CAFOOr2WEmaX3mD9taR6yfxcSYpSeFFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HbwopkGKDlsxZRofpzMVmAGtg9ub4M893umFnnmEg9Q&oe=6A43B934"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GirLgcwqtJEQ7kNvwG9JmcM&_nc_oc=AdpLZ1u0kzfg8kTfM7GWcIZr7mU2fblNaccQzO01EwPNyPgOTAU0upU8Fyekm5o4Moc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ShmP-8Y-PAND5ZTTySKDRFA4SEwx7nNgiefUNdR-YTA&oe=6A43D71F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFtIUfPiCjgQ7kNvwEOOeE_&_nc_oc=Adrk7BpFgdav6t4IWFQKAYVT88mtKk9eVHPLXQ4WcciB-2BMdIr2OuuR1FlYVZrCTTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sHfT_K4fgTsK5E-gYqxsr8Vlb5pwp0mC4VbZtx2STqw&oe=6A43E4E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzz4wDHwU0UQ7kNvwHZNSRj&_nc_oc=AdoHZfHu2ZCaLoVb0W7got_Ijq5EW7wPK1sL1u7WMZtsmgHQukFvJLLJQ5xSjgzBekg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c-Gze8apsOs3o8lQQZPY8MBL1PwgN31Ga82nBlKPKGg&oe=6A43DEF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjXhdYUBsL8Q7kNvwES-ePh&_nc_oc=AdpoLgU-dPcUq5nhIoG7CVT-JblfqA6MF5IgULvy8DtAj8lKL-0zGxhPunhmO_D0Fzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J1K-5Fr7f9trW9w2rfEO0M0dAncCbUSWSmhnzEVX2zA&oe=6A43B65C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nMe3l9TJMEQ7kNvwHBo5K5&_nc_oc=AdoZyRPTFkGJ0ybLrp1D8yJybaqmJsOtZMG4np3SrooM3gf8UHKMb4EBgArc8vhle_o&_nc_z
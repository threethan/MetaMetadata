c=wIAGCMOzxPQQ7kNvwF-SEwV&_nc_oc=AdrxVMY_Nb0Wk7fEFBLuX2M_J71WRcgKe7FPegwxY5UKdhgB4gD6VdL0NMhF1DF45DY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8bI07c0GPDhSbjLP7fmu0V0R-pGDaZv0qw6J37EFj1w&oe=6A7480B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmwia3VntsMQ7kNvwFP--dp&_nc_oc=AdoTlnOfsua0bySvy8QSXNhhiyrMKgacnx4XRomKawxSjvhlZjNJApFbefNgS0YIQ8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRqqk7mkqKL2UM5ujA2tyB0-sCtXGZI3-BAp53pwKndA&oe=6A749E9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bmTLgf-Vd8Q7kNvwEWvAba&_nc_oc=AdqVVsf5IFZ0PpKID_Jud4wlUuvFbYlwr9TWu0nTIRmXjBxpEAimC4cN0pLVyq5wqEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkPzuFKlJMO-vvS7HhDK5FJUoSmKuDGYL-sJG3uTJXoA&oe=6A747424"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS-2PSVYrXsQ7kNvwFpGYKm&_nc_oc=AdonnU7vl_ZrcRoRRf43Zxqt5EpeHoQxZo9b7nVEW-r5Vd5ZL7DYc3y6UaRGB4GC6Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBQs-djtdWBq96X6J-yQR9o7xcd6s3rjjV5QTi8nvvhA&oe=6A74A677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbQkE-ePE9QQ7kNvwFn6C-x&_nc_oc=AdpZ-8H0-9Iwm5nZE8zLGLKPGOraVV5CCYCXrLwnU79Y2CqmSIV54we82o9ap4x-mGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSJXJQ28w-R__0-BTJIbil4Spit_24R4CDRDsFa8iWig&oe=6A747DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZXs6L2VFCcQ7kNvwHTWBM6&_nc_oc=AdoM1Fj8xu6OfZq47rAt_icRKkXilmq3IL29o_IbXXGLAM_KPv3_qyBzNBo5xxz5pCA&_nc_z
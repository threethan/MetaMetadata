_oc=Adp5vOYOEEr0OiirWAS6O0iCINO8xDZCTAx_iu-znRGDwPShu7YWVwNAEqOgRwozmb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERRSkmgECw_Vj1nriX4MQsFgzyo7X1efQNL6OO0iR_Ng&oe=6A82F4A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUvQIhiPBZQQ7kNvwFhFcWQ&_nc_oc=AdoET7jY1ull1Ep4ivvDGx5iXk_Q9a4-pzCA2Kwyc4t9WLSMx3N_gegjjsSAKKXkvaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8MhQpaRXIUCST29SHexS4w8vuj0gisSh8WodULujm0g&oe=6A82EEB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7g8uuGxDcYQ7kNvwHmMPm-&_nc_oc=AdrUqY9qk9INTiYQMOOqBsmLTIoCuugCR6uMsckJqDA01RTsiblDY1D_gqEFbPGeRcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMw-jG3EcAbFibv74PfVEVKbmpV4bSufYUfWsYI1eM7Q&oe=6A82FE5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVc26BwGKIoQ7kNvwErHtte&_nc_oc=Ado20-5kj5gFvsid0AWzgFk0P4f6hg-ZvJGm_ZOwQV1qzwqS3kHwzuI6h4mfUbjU1E8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEja0dJdsadSi6Bu28MO5V2JmQLF6rVP6h3mfcFWCa4rw&oe=6A82FA8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGe2g1avYtsQ7kNvwH1YSg_&_nc_oc=Ado-62XAHkuz5IpNbpMOR1aP5sbuOXNwshd5YDzuHiXYzPfDmJ86dkOpT6BMknbF1gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoDDnw4LLhJ2-X8I7R91U6AEp9UyipyCWk2KkcTxzFqw&oe=6A82EE59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmzruGQv4IwQ7kNvwFyh-ro&_nc_oc=AdqHdaYJ6dTNtCZ6vQ3ji75pZIpx7X53
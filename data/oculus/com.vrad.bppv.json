c=DQOw-_wfFgQQ7kNvwGyEAVO&_nc_oc=AdrWeOpCEWonWHk9qK5GQT1l1ir77MMbJSUaVyJJ00EQuTjhh3DLBt8WhjYk9ExxoRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e_0y9qJPHor6BUlueMk-61vaVzaR7mhQZ7rbOVJJAkQ&oe=6A3570F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNDGut1RnW8Q7kNvwHY0m4K&_nc_oc=Adp5Ug5cK02EUoCEzn2qdh_FHkKQ9Q75lREZEdQkeQ0uBIr9l6qD4may5zVXo5xhm4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86E3CvsGz_SUVBF-kqAu9pLidUqFbJb8t8tNp0YWe8yA&oe=6A35569F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7aHPSht8CUQ7kNvwFQDZ9D&_nc_oc=AdoAIFhlTJNFNFS8003DMsSgYYI3Kfk5oXGIc64lbothd7HAFPpZ15SXu7SeAWWl8XU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eA7pFZRFbBwSZsEn5K76MErpc32QTz-zhM3LStIMevw&oe=6A356464"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x82ivM7-5rYQ7kNvwFmM4vC&_nc_oc=Adqtsxj0AEtrC9AG9Thotm00mnanCkaUtlFVi0BziYslVsJ69xKApCcLuQTWK691ogA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H4FwhOGRpoy7qUCSIfUxs2djOnpkZ3lzoLTdu23iFWQ&oe=6A355E77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfUVr_k0R6oQ7kNvwFRb03l&_nc_oc=AdpuyTvu_gaqgAzqa1gcjnZcYNOmb4VMfA2DG4t9t5Hl4nKOcpW4VyZwmsoFPXbOVhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N91mhXDntj6KLkdpGhK7GmshgkdWdTCENrTyR5_TEiQ&oe=6A356E1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq_xijuuGYQ7kNvwGn_xzg&_nc_oc=Adp5g4OMHpU2fgmzsbsbbQSfAWeiTcbtfBaQMMTeaecGNVeW3n80cQILs1dS3Oppb0I&_nc_z
_oc=Adou7kE4RZx81vG64KDa7O5FFqIwsUJMDfKWaQP2HQV0jgVP2TS4flaZjMVtHV7gqoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuGi0y-wZCUvqQm6PVppijfO-SHkxyWw2Q-87XC7aavQ&oe=6A844624"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNruwh7jyuYQ7kNvwEQO9nB&_nc_oc=Adpb8_lDgqEZsRFWol8btvQ11oVMOima4gfLaBUrK2JyWkH7_g7fX8G_7E2gUVfv-1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK1sMNX0YDuXD2Rvf-ptG8UzU8s_fpRxSJBR2YBDAQRw&oe=6A844037"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7g8uuGxDcYQ7kNvwHAdXYp&_nc_oc=AdqqGK6pJiG_DI43icsiPsoc2kp5xsu9djP3GuNSJxpdvm4g563WeNw5guysP9SL0U4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWlhUnN6bvwh0OdYs4Djh2ABxqQ3funDSKb4ddHelcHw&oe=6A844FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIgwoYgJeFQQ7kNvwEUs3-9&_nc_oc=AdrumMuNv3jTJj7Tp6RG6QxcB1BEIBB3RcnSNiq9Fkox9-GieNVHbLxNXoLuz-nSAwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmUYvAZ-4jokT10xxvSw4WSF9Ya-_vmfn7LNkwiId2mg&oe=6A844C0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cMFIKd_f9MQ7kNvwG7YTFL&_nc_oc=AdoULhRbUbjFBOXsdZv1S2Pfx_adOrQiDTo9ntmxHRHubVMgsVkD6LakI0xCX1-3XLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjwW52Tg4kNCKHk1C6cEqFxoGmRUJtae5wXR_GNweWOA&oe=6A843FD9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmzruGQv4IwQ7kNvwF2oVBb&_nc_oc=AdpBrIzmhRr1vTxXekv_Ug2aXioDTJ0g
c=CjKUjq5at_UQ7kNvwEnXsmJ&_nc_oc=AdoaF5rZKGm9lMFz_SXPSvhsPsqBKOgd1APKuKRFdpc0h0jhxK9lBSJtjvNIJ17HZQI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyKcmAIHqGVqmPVX-R4gTeAd7aXHc1lmUp3mNM557Zzg&oe=6AD101F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp-4P6l3F-IQ7kNvwG-VDZf&_nc_oc=AdqtFWVQ6Uy_J_a01bI2nKbFmhod-29qDtJEmeDJx2y_T_jrLCJ9Ho71B_q5ytrF8kc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVkDxG4AjXyn_6rZ2VjPnucWGjKXcIcK0d__HEpOKEWg&oe=6AD0E79F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyeAw5FBjEgQ7kNvwGfhnuD&_nc_oc=AdqeIhtKTGDAvEbZ5iPTlE1-dad0cGeyQnD_IAsypqHzSiFGy00ktb3GZfSJmKzeYyM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQd2eNvDjUp5u4vgsWsGDeZOE-3S1NrAtvwPeutX48jA&oe=6AD0F564"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gyS8d2VdnwQ7kNvwFfyDIS&_nc_oc=AdrpuksyIY94Bk8WYR08QfnTkgW_lW9l-B2z4o52YUQkr42MbDQKOIN6XKdbEq8U8iU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeHnVXxK0VYlyz06P1-NNeElGITw5KP02EnMuD0m_HiA&oe=6AD0EF77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esbwTKFSymEQ7kNvwF8V1F8&_nc_oc=AdomjjVDTqQdGD8xbD2dCQbsNiQ7GY3gTynYUlTu1rl44zalFrk9610j2e6nCTmv5t4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv3Ln1FaOsAN2nInmBx_l-CRsl15cgSyfD0sjhp29Q0g&oe=6AD0FF1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwCUFbFqWIQQ7kNvwFQ9Fjx&_nc_oc=Adqu3qB9UAUODHi4iCAxmg0ID_vQB8jUACc458f0XdmIKpeUS30FbjrIsY_iSMksCJ8&_nc_z
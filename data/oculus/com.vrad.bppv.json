_nc_ohc=iAwZXNtH-QcQ7kNvwFfv_gh&_nc_oc=AdkEZGVHWf98tpLjVKfbcjx5ya13Ihoj6icuzBrkbkba_XKll3wkDXZEQBMt6ywiER8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftASKakh9c_dWSlEuOOeVWQGfIlBNiFKdWGG6gMWtjEqg&oe=69A572B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGv4voqnulQQ7kNvwFzOaNA&_nc_oc=AdnQuR58dNSDmtqQxQqi6YoSFBgWMdwu9MDYNiy_f5p8xTE_7K-lD4z9fbWEALJ_ahk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb0e7qjjkt301AEigqnweVaZJiQCh3dWAZj5gQ8vCF5Q&oe=69A5825C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw6EvoNO99cQ7kNvwEizyO3&_nc_oc=AdkklMfNl0J8B3McJCF9VsYvuXShQzOGH2WBsPaBCWcM_mP4XcoDeZ0XP5TJ7QKwCjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvFKOtf2dTTNuSvm4oJddWlbD-DxfsNIFiTFYLg-RPoxw&oe=69A57E8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QL1a5PIyEcQ7kNvwFFc5dd&_nc_oc=AdlrPxjDa1PFOjmpOZ9bZ0NXjsK2oCRfhv-a18HUiLGKfoQvYAzpJTfqqyfDkfDopXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvB2X9eY0RBCEpCWbfCZLxUnsl4WlrwaQqCR6ziSpExJw&oe=69A57259"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aPVjBDmBUEQ7kNvwGuqcW9&_nc_oc=AdnTCSOV4bMiFM_QplndqodjcR_kQhp0m-XTYgmFo1qy5xiXIdNzM-t_RhmiucoyV9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftz1CC6KVrw5ebP_EIWzXjCpfygpqMHFMuAPoC72aGqoQ&oe=69A59053"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN-zVd6KL6AQ7kNvwEC2xBp&_nc_oc=AdmIQAZEHv9Om7QADWzg8ZjJCK9XhliHG0ZWLr5FJ
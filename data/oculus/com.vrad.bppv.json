c=vYlWqo7v7Y8Q7kNvwEuCzR-&_nc_oc=AdrMyQwJeBa2IOUFCLkRyqbbobxYIJLljGBsKflJkDqN73DWTi1A87P2fsPWVUSzmPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrAFb8erSKMl3oiJFu_sCVYu_QWFAwiEF1-4fjG-aJfw&oe=6AA2A534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HbEOYlFg5cQ7kNvwGPmtHR&_nc_oc=AdrN9xIxJh6cRPd8ELu4AeHHjpZXogsYLR5Qo6JaNRlze9uWQI3wL7ew4gGKm-X3SA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4peSq9DB-L_5xbOabncq9pZlVPh1N6HOypuZtrnRjdA&oe=6AA2C31F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoaHQvU6z8cQ7kNvwHb4Fjq&_nc_oc=AdpVNAUaMjRI2BN2_qzP_5BjfLXQyoMZiZJwFSxByrjqewzQFSTwzM6BzHhPBlpAuWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn4eOKJ8QCX4W1slk1pnNPDeqDhOkEquwQrRh4X87lLg&oe=6AA2D0E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiYjbaBmMTUQ7kNvwEvNtUB&_nc_oc=AdrmDJy-ieolCyNmmFYOn-aIRnbTgxwfsVXE2RZWglAMcdXKZPtturtuNsKCJ-4aDL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKubD7yUaRraBF9m4Y1qFaP0zdwAemSjsn0Z4qF23s5Iw&oe=6AA2CAF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1E2AGl_9vwQ7kNvwET2Vga&_nc_oc=AdrK9uzUxefrLT1HTHFfzlGSda1O9ChXIH_13SmbtA3NmNp4rT-MAUVo0qAqc-0WpGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaiXCuArY_qwT6viNMmeKoDHss1ESIIsrJBOkOaB2tcA&oe=6AA2A25C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuhp9gLrj_8Q7kNvwEQ0v8A&_nc_oc=Adp-VlgSQB6lP5gs4tfHg-4Q9OU5vjCs8pg3TuporwbcGYX8xX_NTWPUOe01JvYlyqc&_nc_z
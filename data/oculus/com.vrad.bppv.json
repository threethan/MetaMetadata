c_ss=7f20f&oh=00_AQQMsSWY9fuswYXdiZeQLiZH-bew4T9FTVi_RPLqymfGLQ&oe=6B070F74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwWoZcese38Q7kNvwGKt89n&_nc_oc=Adq_NFxetfNeBGK8fnX1CvlurLIe1XpwQVRrjJ4vG17KYwJCINsBnQMrtZ1RlNs2gsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN1xmKGZMuNbjjhUtVkWgjaaGFsW75l0MLM6YIiuOFvA&oe=6B06F51F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OvJZVT_po8Q7kNvwHy9gmN&_nc_oc=Adp2CGSCUgT-Sry_LDr-eyonwWyn-JM-o4UcuDFdjw5unI5ohH69FqDE6vPfcW5QydI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNrjIy4i9lxw4ojL9cp3JNeflFe8mySA_qehF0wjdxew&oe=6B0702E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFeGXtP8gG4Q7kNvwEYw0F2&_nc_oc=Adq-GTWo66oH0bCk_rkAq9l-ffowlT5feenFgJ6bSE2lXGbY79dzbebYVZ4cUAqw4tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx8VNiCa4gEAOJvKQItwOEdCN9MJKMjIKRAlaFPvvp-w&oe=6B06FCF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI02N44iyvkQ7kNvwFsF0Ji&_nc_oc=AdpfhEiaVAWFlN1lsZ9L7bWukSil3z5N5V8Ko4FaUGT2_hUMU60GczX6_kkWunAv4qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsMvrxRDnPLJOdmzIbrwoHbTo1w6B152xrSHJH7HnOcQ&oe=6B070C9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzaHJF43P58Q7kNvwHzpA3z&_nc_oc=AdryX7KNghs0qC8c6fL4qJzPHNMAKI8Zfd59FtvBTCdJSCIjGh1yESn-qGp7ISlTROc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5DdgWrG6yk9UA0xty7AS03F8Lp1w6Z6-7PPpc5FuB3g&oe=6B0708CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40zoAQ2CxfAQ7kNvwGzO3G_&_nc_oc=Adop1rX9GxooNAB41plZtIAqxsN3UUIf3H-HvTM78qPGoBUmNSUOir62dA40BxyB5iM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuWb1s8QcyW9dVfeODPIqfQgCMvDsAyyTsNkF-lw89Pw&oe=6B06FC99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq8XyuOIWQUQ7kNvwF7amOY&_nc_oc=Ador5IZsab0YAW47UPSeu0s5u217cqxYVd-Ub1X_Z3LZsGhJLCPAyut-FVx75Ks0Dao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBNOoIqDCmi6lNeJoAhDf30Mu_L0xrP5xBj7vZiC1gKA&oe=6B071A93"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OshdwF7PopAQ7kNvwHX8gdI&_nc_oc=AdqhfhFb5jGowJW6-ZsHXMmXp1A9N3Ve36ov2dzLMBX3UKBxWIDHMkS2Hk006W6vxzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-90nLlpFYx9EAHsTuA7I7LovN53QAACHDpcn0Z-Py1A&oe=6B070851"}, {"file_name": "005.BPPV_Square.png", "id": "1269871715156621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620346_1269871718489954_4811280509119093641_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAEm1eSM8J8Q7kNvwFO_8AQ&_nc_oc=AdqGE7J3V6EPG1xBXHAUMXvvyfXdZguhfKeYaWyTqwcTolkzw89Eh0hMJ4xdthJ
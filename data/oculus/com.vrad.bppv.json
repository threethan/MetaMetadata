c=n7k9tBYAtSEQ7kNvwFNg6Z2&_nc_oc=AdrusKRmLmIV_yfXWWt93vEItaECf392eO2b66p6o7UsZWRISvm26cQrJpHlgvUqX_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PvxkHrkRQz469OY2-VuLSyxV5-mJEFkubXaPncbjIow&oe=6A244D74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkryEZzp1cwQ7kNvwF2Rykb&_nc_oc=Adruao7F_jzc0ijBspwHlEVchd8hnakjS8HTi315Yn-OutGgUHtFRgZ8YafJvtCtggE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jkAiC72qA0K91KgIi4XASWal2hN6w_vEJRJbLi2pyxg&oe=6A24331F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8YHDBcoye4Q7kNvwFcnxRs&_nc_oc=Adq0RkJHgEzb3U6dlhJidmOZVNIM-dik9Q2JSyxm-iJ58emIjCNF22SSTIfgtBAVcuQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qq3TJluShhciuJTntuu67Ig-xbisaKXakEV2HMgneeQ&oe=6A2440E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwHroW4f&_nc_oc=Adr9890qalnCzTaXz74j0LnnvMCVMKTRPDw8KUxJnbK-EcRcY18B6QUbZNsk0M2G8Lw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EtpXHYrqH8Oci8_zbiWtK5vFPpT6ROpAJaxV3P7eDMQ&oe=6A243AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwGCDyT9&_nc_oc=Adq8YjvI985jU5D4PkWMsNGVHV5IkFIYCJpm1unaT3-ZiRz1L9qS-5Lmg823wid1k4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d8vCqmRN1aKkiYM4q0Um-dLaYOIE2ovt6KoVuIuYT0Q&oe=6A244A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwHqhkzz&_nc_oc=Ados9sh-GeIdeg6ltfC7t-9PozbrI5xfgaqzhbtTGMHEe26qS_nYfRHAywsKH_ro5b8&_nc_z
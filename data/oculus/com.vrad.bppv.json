c=1TwoLN7i-7AQ7kNvwE010ei&_nc_oc=AdpuOAJjqgmJdXH2W80VGCVe76gDjVW_2Jihu6BfCnNOl6LkEkiLDkgSgP75r4K9ePY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx4xiOkOPeOqAEk5xnOraYwGqz-T702YYcybeQQFiqIQ&oe=6AEB5FF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-8qcHGHDIYQ7kNvwGdaPfE&_nc_oc=Ado2Kl0RFe_Pch6fOLF4sQ0LppVI098D59n-fAei-Unw7QEmA3SDg6-ZTsOAd9OlvMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShD5z06KCM-OGEuq326OaKSqI2Da_zardEZG337izYlg&oe=6AEB459F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGcorXrAK5kQ7kNvwFX-gHg&_nc_oc=AdouxIclYJILwcr4ov_nhzpBhFoJu3UaDo3CwrQ8phgmBW7PuK5l5nZeDe1X5CBGGAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSntx8McWrr-ViIOTRoE91uoF4PVmaiedobA7QeqHqKJg&oe=6AEB5364"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OloIiVfk3hAQ7kNvwGtZ7lT&_nc_oc=Adoba4c_azag2OReBptJRZgk_tFfPQ611thFBSreR5VCYvp6rKzJ23OfyRjEwHpF-Qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnTIhATM7LamKtHy24IlPCfZqjDBmtAWR_CqaWPv5aZw&oe=6AEB4D77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2vySUSapu0Q7kNvwEQwjlc&_nc_oc=Ado-zP0M-TKPg_yqJ6Gg6T60asBeBahBvbo1XtHy4lqZUs0cjlWuiTj3undxoS9QROM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmj8Hl-x0KTu1_bvxDg6grUtWFnPyo1EzlZFc8jzmcJA&oe=6AEB5D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDT1HuE6Q4Q7kNvwEBEZ8b&_nc_oc=Adp4kRXzZyxHX9eU1nXRopqIk32n-OE2oGWoRqxMLiXD3vgu1KV97WXUWOUle73vNsw&_nc_z
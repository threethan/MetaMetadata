c=7eIvAlBIoLkQ7kNvwFRv1Dl&_nc_oc=Adq4hLla-s3mEA9kQJPqQFeDM3QJG-5BUMDMPbBZhWsAW2qN-p2XMsKLdlMBK3CtXUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bt0PWjUB1BHOc7kSRnu5uSVb3osUsNVEFFBeLgczlag&oe=69DE35B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2umPadEfdf8Q7kNvwEANSew&_nc_oc=AdpfJJuWYqFBoUL7M0fuwOQP7szovTRiTGdPXqgqAtOz0pkOrn4agVPGABJEeLkTDpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0imsS-i4OJywsS3yEzMXtHS6sLZqCsHJtqLxg18dtNFw&oe=69DE539F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1IkyZd5U5QQ7kNvwFi8brR&_nc_oc=AdqYbRUQZMjSmVvoAfS07C5HWQvikDwcIfAVkoUBetMjBjm280dJskDPFMclQcn_iIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dt1vRdXjmdWW5nOE_3a9s9RvOdcHIyIrzhTTaCsjnig&oe=69DE2924"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOttb8NuR80Q7kNvwFPpG5E&_nc_oc=Ado-4x6KFCeHegpYLb8bxPd9WOPrxpSF-tukBqW5aRVmBzpAcgkBo91DUyaz0oR2RSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DxUp5rFpJBjPc3TY9VTP8Y0DTh9QL8XPNrHNSweYDBg&oe=69DE2337"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEDJzKjFdTQQ7kNvwHA00ya&_nc_oc=Adr0fHBx5jhH8-pq6Xzq_FRtscUdY7pPA1-LZ9vDhZ7PYFwSNDLpS4AmM1zKIMBOM2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18a9vRG76klr7XtzYhKv08IWm0KwGnHr90WF-FBWiwYg&oe=69DE32DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFW2IGwRz_gQ7kNvwGYypVn&_nc_oc=AdoK9NLQBSdXbOM9FYm64sLwLufixnZcYcke7Aig36AXOUINdG7vDo29RjF6VLa9tS0&_nc_z
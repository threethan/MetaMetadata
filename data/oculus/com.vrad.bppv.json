_oc=AdouxIclYJILwcr4ov_nhzpBhFoJu3UaDo3CwrQ8phgmBW7PuK5l5nZeDe1X5CBGGAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSntx8McWrr-ViIOTRoE91uoF4PVmaiedobA7QeqHqKJg&oe=6AEB5364"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OloIiVfk3hAQ7kNvwGtZ7lT&_nc_oc=Adoba4c_azag2OReBptJRZgk_tFfPQ611thFBSreR5VCYvp6rKzJ23OfyRjEwHpF-Qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnTIhATM7LamKtHy24IlPCfZqjDBmtAWR_CqaWPv5aZw&oe=6AEB4D77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2vySUSapu0Q7kNvwEQwjlc&_nc_oc=Ado-zP0M-TKPg_yqJ6Gg6T60asBeBahBvbo1XtHy4lqZUs0cjlWuiTj3undxoS9QROM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmj8Hl-x0KTu1_bvxDg6grUtWFnPyo1EzlZFc8jzmcJA&oe=6AEB5D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDT1HuE6Q4Q7kNvwEBEZ8b&_nc_oc=Adp4kRXzZyxHX9eU1nXRopqIk32n-OE2oGWoRqxMLiXD3vgu1KV97WXUWOUle73vNsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwCG_w5B585bCI7_EGTMiui9Zno9opgZ_5q1gKxzOIfA&oe=6AEB594A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VezsFodKt7AQ7kNvwFhS2VU&_nc_oc=AdpWqE7CUnraed80JA8umFjQklJKQlx-zSqH6A7OwZfM01gyJSfXaRmmJ-rHT8ZqQ8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdBEKrEuPMoUw6ma5wQBMYW9x4XQ0SLijYwftxMZRiRg&oe=6AEB4D19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqBc5pnjhhMQ7kNvwG4N5R4&_nc_oc=AdrMhEdvciG1T-A3HQ4_5N89-n9Q8xXJ
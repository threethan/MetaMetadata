ko3stH9lIu4wJl1NPGGwqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFieFYnWm6Y3ARQ3gMiOpoeKiQ2iDbPr-62xn6ED7q0A&oe=69A03F34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb_mYWpllqMQ7kNvwEuCy8R&_nc_oc=Admw8lX2KwzHHKaoVPESOCyL_lY-JDq771EDgQ6iU9dG3cxrvKI5oMWsEcwyzphIAc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfusYEqhByKBP38RjwxAZ2mVBcAtVnmBAFMly0xpGt0x8g&oe=69A024DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEJvCAwvB8gQ7kNvwFgsm6_&_nc_oc=AdlT_c_Aqd2AshUsUPnbXq31D4STOSpv_eKS-1aYzQt3Gs73moMRDFjGPyGEQsLj6Ng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvcS9nHJq-sHEzrzFnVjstlcEUQ5N6y-_ktS69AGEhYHQ&oe=69A032A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mai3p15caO8Q7kNvwHLL5wM&_nc_oc=Admu7Fj3ABh5e3OEkb-YgIY-ZvxUyfcJA2O3vNocuC1EChuL36u5yrqjfOK65Tw2TvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDPpvJZn20i83xWlhHZkGx1SnkZ7W0MyZ9yesLQM7_2w&oe=69A02CB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plR9ZSpyzlcQ7kNvwHZZ6mp&_nc_oc=AdlBAg2dZVC5egIHPilp1_3xohwYl-0dGRRXYxV8b6oNhrhA_0ftp4vNWh6ezJjMYbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftu5vXT5ov6gs6C5q9HY75t71s_pZMvIGkYPnV4brd3tQ&oe=69A03C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z9s7dbrzx0Q7kNvwGhtU7S&_nc_oc=AdlE-fGX91enbxDIaH4LbcXdQhhd6yAyCtilqaw_NDRcxyttNEhjDOJdmm6d8EdjGn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP_4Yi4VFCfqKWOsDI7jcd2DE6lcs3g-R9ZvWP0JfdpA&oe=69A0388A"}, {"file_name": "015.BPPV_Back \ubcf
c=n7k9tBYAtSEQ7kNvwH2PWMj&_nc_oc=Adof1h_Fe4Pepj64RsCFJLun2sIDYxGt2CpzRK3CLH-XjweNZ-4nHLY5JRCf5EVg4p4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X3zWxUYeG_90FEKd1-gGnL-lRP3WlUb55kFJ8DmIRBg&oe=6A217234"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNSkfztWqeUQ7kNvwE7bay_&_nc_oc=Adpe4lhji_WkDoXnnh2YI-krsi8UwaHsRuEx7b66bjG6Wx7WVCjdpK9-9UI81gMoabU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZvaAJFwjKtl0peBY__-0NjaWbP9lZqZrEDUx-tpT3ew&oe=6A21901F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3r3vkbBmPIQ7kNvwGmShhs&_nc_oc=AdpXx_hbzv1YqXfzvke-qxj477f6Y1aeda_YTke-RM23UdSicaipXfyz-JVjp9b34OU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UapM8KQ95z4Mpeq9Dxo60b9xl7ifhTcW4iSdPUzRbHw&oe=6A219DE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nBcPZ6kIqUQ7kNvwGxoi-p&_nc_oc=AdpxLJt1fl-3qu7KSjK0iMk0R07_JIhK0oCj_07zJmZOK0T2AspC2bu7MUp3vzQuALI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wtz_7tYnRaJAtjCD5lLQeg205MF5YuQpBIgi0UsCmPA&oe=6A2197F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZyiV92gPHsQ7kNvwEm05az&_nc_oc=Adr4TN5PFhSR37ezLOuBytwWRiwVk7LQW-8coaZQmKJBYD17sGk2gJBCB7bXgkzwHvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cISTvmSZZhN9Y3l49EogNFrOmjeDEN7CuYGhT7SiR7Q&oe=6A216F5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X70YstkkgbwQ7kNvwECczax&_nc_oc=Adr8uaImyvwPUN7zii8UdAU1cHk-PbEZev7IWWcoXu2SXGzalSvu9gCEN2iSn4VWiGg&_nc_z
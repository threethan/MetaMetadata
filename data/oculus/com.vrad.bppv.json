c_ohc=DQOw-_wfFgQQ7kNvwE3MTeN&_nc_oc=Adqs_kJ9VhmI8-faK4zDwVAxmMTU_YQ6Fqy-L4yImwJby9_8t-Qv5YUKSAtlDIqCXJc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KNDYhpBcH-ngePU0MpJJFDoQXktGmVn9IRXHLaM73_g&oe=6A36C274"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyR84BwyNqwQ7kNvwGmHswU&_nc_oc=AdqbBTO0kDTBsZN8iU4sAK7qaslNZpjr9HXKRy9TYMFik7lLec2P-5IsAcelYluOYAI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7F393FZlGTTYPDCUFOlSVSin5u2ZP95irlpX-8oP9ng&oe=6A36A81F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkfy8wXMlFsQ7kNvwHVia80&_nc_oc=Adp0zBGGDwl0bP0TW7Lq2u7DGZbHKC4PbL_4wy9IHxugNwUt-6Vq55BAHAFyuHs0b3M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jORwNfMENlPcHTXZWA04WtW6JeYYIHvcUldVGZ_13nQ&oe=6A36B5E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x82ivM7-5rYQ7kNvwHsvYPQ&_nc_oc=AdoONgZK2bn1JF0CSzmTpr5O2uXRioAXD2YFzFpqdCu42REP7HbRVlo_A-joYpXESGM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eu0-qmt4w5glAzRSfpHZiPyITW3HI0kMgwr-vMDVlfw&oe=6A36AFF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxBF5BBbWyIQ7kNvwGEK31R&_nc_oc=AdrYJr1itrqlZf4tnaa44Q4254FUHl_ZDCWEe9onn5UktT7nmbkbMQhgrbX3X88KuBA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8suwxsVyRmhU-u9URpexpRtwS40Q_UeHr7fwtqM-z2CQ&oe=6A36BF9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq_xijuuGYQ7kNvwEqPxB_&_nc_oc=Ado2SClnYaoF7lehGhOQxNL1x6ud6vAFXAnpZl1KP0nOLKmjNtw4XT8JnM4lMxTBV
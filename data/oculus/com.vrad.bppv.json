_oc=AdrMMNAo4Ib3-u8Cml2EzHvjW-mt7jvAHPmG4RKv2Retv6I4EUbp_r5LX5uJRQ-eE28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzF7jwoLxsaecCzrqPc-Fy3fgurUOvyCmvhqJNOya8prw&oe=69D0FA24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgRLydnFnqMQ7kNvwHq_ez2&_nc_oc=AdraU9KJQ1TiMf7SJBAr-2KnbWU4JTMFTTb_Jh4CJWgjqj1QS0aS6ekD_YL6tjOos54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr3x3-TwOamR8u-wKr7SAy5URAqzBFrjx_IjYXLumzDQ&oe=69D0F437"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZC_VVAsTwgQ7kNvwHZBeZ6&_nc_oc=AdrWAOBn6h3rNGnVJt3ajhjS3QJdfGCBXRP6xD_Toq9b0rXfOvx148Zf2cFL4nYMw3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2sVOFQLceLJmVcYQpT-wLYYya6hWcA_jFQLT2H24AGA&oe=69D103DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnAxbSjfQwQ7kNvwFerlrZ&_nc_oc=Ado3XVi-euC_ApLd1y9ywXxJpJzhVAh5pTDHWAjQiagyHuo12YSvWzwciDq-26k3gUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ3FP8kbYL31FKmzwkSqdhtK53w7vu2kIdNXBnuiKdEA&oe=69D1000A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztj-NtAaexoQ7kNvwGsR-ad&_nc_oc=Adr6XdClVxGlh_Y9z3_9WmQxadgUJvHQt1DYtRVaexSqX9os1zrt2D4Xu9usX_PoMZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvMq8DQnUUObx14SPk7WccNLV6AwhC2xrv23pfsPgVMw&oe=69D0F3D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U60g0UWA63MQ7kNvwGBb_2A&_nc_oc=AdoTTqhcJI441Ltt7jarWpt5LMtjYnGF
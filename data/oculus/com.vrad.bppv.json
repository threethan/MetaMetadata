8e4oCiEuEPHBFChAcRzBbA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv5WeLgkW4F48icsVheZ6_SmiDEgowWHVWUIG_Mxuz3cg&oe=69A58534"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoTWpkf9MMMQ7kNvwG-xup2&_nc_oc=AdlK8NhF8X3V8oXbJQww5d-ulfz61gb8hPDqwpxNvyrKb4jaVpy-aaBODMB5YFKys3o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftYl50zv4D4Mt_eaJvwrm17OkHvRgd8rQrYVfhlb3okPw&oe=69A56ADF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Oul8Ke88lkQ7kNvwHexs94&_nc_oc=AdnHwUp3XnHD92l_GUipJj5oNUbfPKXVAQdf5Nq2ZRTvXuT2kEA-61DZiDkkbV3KiMA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs1x0Wiy4kTqaHJeC_XS_P9ltp3AQnk6IUWtv2afYezDw&oe=69A578A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAwZXNtH-QcQ7kNvwFfv_gh&_nc_oc=AdkEZGVHWf98tpLjVKfbcjx5ya13Ihoj6icuzBrkbkba_XKll3wkDXZEQBMt6ywiER8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftASKakh9c_dWSlEuOOeVWQGfIlBNiFKdWGG6gMWtjEqg&oe=69A572B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGv4voqnulQQ7kNvwFzOaNA&_nc_oc=AdnQuR58dNSDmtqQxQqi6YoSFBgWMdwu9MDYNiy_f5p8xTE_7K-lD4z9fbWEALJ_ahk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftb0e7qjjkt301AEigqnweVaZJiQCh3dWAZj5gQ8vCF5Q&oe=69A5825C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw6EvoNO99cQ7kNvwEizyO3&_nc_oc=AdkklMfNl0J8B3McJCF9VsYvuXShQzOGH2WBsPaBCWcM_mP4XcoDeZ0XP5TJ7QKwCjg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvFKOtf2dTTNuSvm4oJddWlbD-DxfsNIFiTFYLg-RPoxw&oe=69A57E8A"}, {"file_name": "015.BPPV_Back \ubcf
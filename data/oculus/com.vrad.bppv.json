c=U9Cau_h3bjYQ7kNvwEH_af4&_nc_oc=Adpd5UIlVye5slugzAJ-k9WdoIGK-3SvsspS79rg8JjlEpN9eAaUjYTSsy4qwXolUQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8OZHMgUiDlrUbY8tfNQtB9NFH5MI3ksNmtcivZ-AE2A&oe=6A58D134"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO2dKBT-occQ7kNvwHXJ4Xm&_nc_oc=AdqDz6jLb9O0hldcn0N_UBIOVVNJ0whwSWz08nvYhmjA2AlIpI6_kjhLoFV6Nw6pdcE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIsnRm-ii3n0xIUVrqqXijSwWOfeYG71R8HozZfK_CVg&oe=6A58EF1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExWO8QRe4toQ7kNvwGxK180&_nc_oc=Ado66rQJa5bSAIVP2Z84CghfsAMmasxKjYs_fAD_-neaaPhQvOFzAPqYncFeeeIBv2I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaNFHNxTl5Tq65foJV1HOewzDhoQYY27hRhkvVIyJejQ&oe=6A58C4A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGYc8D2XC2oQ7kNvwFcEdB5&_nc_oc=AdqAoMrRAb4CeFNCC0Tpn79JIpvIKWtAKscmDhbkS8Wb8OA9ucecoiE_BwMfLAnbTp4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW4ik_aJOytVKozNnYcxH37dgacLJURZPH2IxvHZKQ4A&oe=6A58F6F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NglIzQWXIzcQ7kNvwHqWcx3&_nc_oc=AdpnHbK3Tml4HptdBXFKNLP2jXOubwBtr2z1PGzrEfkP-iDQzpUHRSMPGoHDePFlL0w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjkd2h6zaIsplwW76ucyMl7YZQldlDfbuZjCSOdz3mfg&oe=6A58CE5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PM0bX9_e64Q7kNvwG94GHk&_nc_oc=AdrB8QLmFIuK4qCU2oXdXiIcLRH2ghDlzjlfl0s0HedKhInSZMN6hVJEptGA1GSPQD4&_nc_z
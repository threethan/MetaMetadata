c=t7c_5EPtaPcQ7kNvwGQDlsl&_nc_oc=AdqO4pqyCzB3kKIgvWxUxdvk0Sy5DJS7JaWfGtlYwYT4Zq5lGuHvz9emUy-TZ04dnOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EM0MehlhUZOxKLc1_bN8VCNQkbzgKEfA_UH_B8YDovA&oe=6A1594B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXu5oJg7k_EQ7kNvwEN5ywK&_nc_oc=AdoJ2gZrqYEKHbXDlQ56Xvh088l0e38rJayZMozpvKt7otBX60a_IFAtJLtz0xsXUhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KpoT-sHfvyjG22kn6kijTx4vV2Nbch8oeIw-9Xq1Vwg&oe=6A15B29F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0_L4ov55SkQ7kNvwHaBGWe&_nc_oc=AdoZL3YbNBC0g1PAJh_ry1dXtAo9iMPxSTu4mFUg3WhG-e1U6rzFb0LF225tyNH8ESg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LksqJNp9_EudvfralkbnUl4g3OJI64jLK40zVf3Q_2g&oe=6A15C064"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o24Zk3r7JJkQ7kNvwHz3K02&_nc_oc=Adpj0XRl-mAW4DAx5y1QwndnYnyBAdqQ0jCCYJKb3kLZTWtnrl2cSGOR-RccUUWXV9A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73AkR5ShcZDI763Uuzypwmt_I9QTENhT6qkl5UR54kGQ&oe=6A15BA77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWoRFsKQcMcQ7kNvwHgqFm9&_nc_oc=AdqaZKSyuF68mBvPkr7nxqblLZS7H_1hkUFKll1sI_HBtFrDVOpHTVl47uPNV8UgKlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t6nel034fOysMXIdU-guVEXXIY1WMXUubJrFr3NenJg&oe=6A1591DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whqpxj3Cf0EQ7kNvwFsH5W7&_nc_oc=AdqJ45a7k94q49XyBBXjI5QJOsHzOBURX-7ft5-Ek5tdit4wc2D1a4uDUZUnz8Dlbgs&_nc_z
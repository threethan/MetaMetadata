c=qbUyBeS-H1kQ7kNvwFKx2tt&_nc_oc=AdpPsALBI8w4GU4iErt-gDmAjhVOIXtXoL4XBhTn1mkUyuJTOBzqdGfKdNgcmsWakqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DiMQjAEHkzaB6odWpCyisq4BV09M_-KPRz81QuNXuqQ&oe=6A2809B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvdF6nQsy5gQ7kNvwGtotf7&_nc_oc=Ado6mQKnNyyARITMG0GEtYKz3mWMlm4xWNubRuhMEdNbtqrsBJ_IdSbh-W0d9ASfU6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TmxzR_ijw-bnnkD3tAFKuh27yAO5DFdAn2bhwM4yfcg&oe=6A28279F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLeqb8a2zbsQ7kNvwFeApMX&_nc_oc=AdorPsSHuHiJgA0Hk7ZsIY4t2KyvZr6A-Z4LSYubfNsvtb1aCxD0yx6_qNfBBoAv7yI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QNL_i-bJWzOvhiEfJF29qLgxLx2NSFnEBD7NQ9tuKGg&oe=6A283564"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RqwDtCg6WgQ7kNvwFqMTkl&_nc_oc=Adq5PLFNBWPTv0kvvpiv3x2dNHV7sZeYHOQ6gELPgoiep0yoEy3_N5yieLW9LOhcDUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ozw5pOhNVecjYnWJ6xh-2j50wIHUNSPHXDRrqqmvYmA&oe=6A282F77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZ8pvLL5MeIQ7kNvwGpGQvs&_nc_oc=Adp8rQBWD4g4YF9BQqigEkdDaTVfXF2CNhD-knZxojV_L6FAYielw8CwowcYjn51nBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pDQ9QtKTqd5MrkdmRxhVo0V_hs-IpejxBJOhYoEunKA&oe=6A2806DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3ZDzAO57MQ7kNvwHV-RKi&_nc_oc=AdrA2vGzScjaPV0W4pjc1tCdaRPLwdl3cKj9jTtR_A5tzDX8i2GptAuPw4wEWWIg2SA&_nc_z
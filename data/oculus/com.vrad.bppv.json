_oc=Adrc3bIe9-uqTzbaTt3thE3C0VDaYv-NlKXZaMKO4M1ywNoXIvRGMStqN1UxOwTZ79c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAytRSbqidjLEmPy9mDH3ZMVcAw7npchjs9ee8Uyez37g&oe=6A5E0AA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5Gtu6W_fmAQ7kNvwEYm4yN&_nc_oc=AdoEk-QPN4zRp6-3NqnxCvGg6QzUU7bvVpqqICVFmpVb1gifNqa2y6aQkwfF0LXCvVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClLJQD15KKczkX55mruvhXEltiWQGzo3d7ntwIY26RYg&oe=6A5E04B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTrCkSnTIi8Q7kNvwGMWDlI&_nc_oc=Adr4Wvshkmv7jrCeoi3jxSQ0T5_PRYHFhO5RAwXVh-ki552-qqrbF1q7xrZq-ByqSgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCLaPlMPA3T5NItnzEtkKAD1YlNB4AwEkieiDsrLXnFg&oe=6A5E145C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YCWQhqvPksQ7kNvwEhQt7e&_nc_oc=AdqW36Fkeohu_oaaBFebczGmo7mt94YNk2UKrRxXQVUcM-sLlu16aWO_G7VMI4HjFoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-L4vFnFRI8tld-cIDT2GYjNSdDx15LDDwo4QJcr2FaA&oe=6A5E108A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cCFWcZhoEAQ7kNvwGrIb9Y&_nc_oc=AdpGCTxUggipxKfpaSc0NbEpg3kojEHBoiu6OWAGzKCWyj8DRLZNiyzajmQDTZttSiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqPbAlRN1kpeAF7r3ij8dawzvA6gtSRwc3G8rPVThUYg&oe=6A5E0459"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmb7u-aCnooQ7kNvwGLIBd9&_nc_oc=AdpE3JZzZG5CpbNwkGAPQsblX0KiCjHg
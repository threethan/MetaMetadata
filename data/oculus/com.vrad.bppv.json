c=Bam9Vhc4fU4Q7kNvwHSs_fT&_nc_oc=Ado-d4n0Mobl3Djh1BqPXZJpAN752791MWEi-vtSYwNUIgKFfOcu-l3FYtceERZScUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnF8KrZEpHmUkK6JmPnZEyAtVzoVcFZ1e2HZW9RIjywQ&oe=6A60BA34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSFEKnORdwAQ7kNvwHatdyp&_nc_oc=AdpMIBh4KaLrUmljo_mAHT_4DItcSxeCdvDemlXVfKC-eB8ydpoKIpIXfzG4Fs0a6MA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9kBjbUTpkCnnzl8WdmMd1NpImquzKL-beD8sR6T0CPg&oe=6A60D81F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZFuDOkSFfoQ7kNvwGResO0&_nc_oc=AdrIqZcdAor_0pcS3hy3dwMQgY3QDzqP684gSam89EUv_UJd2WEHwVTvx_ikdY2_rjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsihxweeGHz8zl77Zlt4oU28fs0VI4MSUzt3s9IiLGnw&oe=6A60ADA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrAkRHXx_yUQ7kNvwEZHarz&_nc_oc=AdqCPh2kEsmt6LCDclF91YaGHfp1s_AbJSARP2TN5GLiWyAdFLpq_9vMdg3Zm67kBgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzFQAEIUTT87bY2Qdd9d5iquGrt5V2VRbt6UpdTMqwfg&oe=6A60A7B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTrCkSnTIi8Q7kNvwFmWo5-&_nc_oc=AdoqXITtTf3X1Fyq2Lm12LyziV8oqnOMv71b1s-SBI3OJZmM5LO65Y6yauLC2EAiCfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC62sWaTNhHP6GkXFZVs3Mf6oxzPHGAKxo73aN2LuXPcg&oe=6A60B75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxUsZCT9NAIQ7kNvwGmHbjk&_nc_oc=AdqFy1ua0TQJICKvfHwPdMsV4F_1y0x4CKsN1imy4Q1HAmqofBsyxgKhpjWtyVOFanA&_nc_z
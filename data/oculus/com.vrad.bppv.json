c_ss=7f30f&oh=00_AQR2Y_sWWW_YT90OfwOOfuNijv9i74ZU87KVNuCes9xZBQ&oe=6B0C5574"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfaDSpbqdKQQ7kNvwGdTzpO&_nc_oc=AdpTuA82jJJKsRr2XaufflZuLcX3UXGtZjWXLhLxVe9MWzbzHWf5GTRgnIw1dRFnF60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtz9r28Ho8Tng1lpwHwlmiOr41JIvfh_SGfbyx0Rglwg&oe=6B0C735F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBoLqlwLKrQQ7kNvwHTP7cY&_nc_oc=AdrIdCPqmhtO7f4qbbYd8ne7CTehgygV2gvPy1jSOsc3pX28bALyEZXUe8aOQSb2GbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmIQ8rBr4iA7wsMFPoIKaF60CeQozw8-PZiSw4UHLxoA&oe=6B0C8124"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_i8ofY-yvoQ7kNvwGywQMz&_nc_oc=AdrnlfG6se-o3inqMdT4cU77UxGYP981bciQcH6dOwLgdNZNaJqfYYSy56isEVXieyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStUIcmgQcH4Y9Fkkqu1iSd-Lxjm9bnFcGAuhLMSP6ADg&oe=6B0C7B37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqVn_9KSLIYQ7kNvwFAUwkf&_nc_oc=AdpUCK0JEENPIIJdeqkIeH7x5J-a2f2u7HhuV76JffJ7xfHxaCMWhnoG-tp8Ff2Vr0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJu7u9eVDi0gcADM19BBiQMXyH2ZZ-qH-xeB3BA5sj5w&oe=6B0C529C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97uXDN9cPgEQ7kNvwH6U4xU&_nc_oc=AdofajhwhfC4wePvak_UGY6CTFKL_ITYx-2yqwDdiKrOBOETt5nAvMnWG23QTqtG1FQ&_nc_zt=3&_nc_ht=scontent
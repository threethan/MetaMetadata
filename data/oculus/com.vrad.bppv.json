_oc=Adq-6OH7tWLplXDaCvifwHqlrEVnHRybIc0B7nndBh7akp5tMoAxRw8nuyuBzLcMKpM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOgdBvcm08uEVt4LA9Y-DZwyjF2eU94sKUGPKTTlyGwg&oe=6A8051A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUvQIhiPBZQQ7kNvwG5H7xj&_nc_oc=Ado_L08dZBwHSZRsr84e2aoRYWy1g2LPzlQp14tApygTPOrdNXYArdW8QINxgTJaWzU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7Kmfdz28NNYSAi2Puou-9QV-uZPv1Tt7tpPYOB2cvzQ&oe=6A804BB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIR3UyBl8AQ7kNvwF2mThe&_nc_oc=AdpVUwsK0a_o7rcjK9wf3H-ZUVP6lIhJzTMSR1MJ7U15Lyj_vNkpdeJzfr5eDCLUCRE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtZhRbEJMZkPSs4C50a3qaprLf1gZfAmrg2-Iu1xh9Iw&oe=6A805B5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVc26BwGKIoQ7kNvwGKipV6&_nc_oc=Adpe4-M8BvflcNWeotAhmSeUrEP96PD6vlnrfFHGbI8DKyY1oGmTIuq3QgDzKKdc-sY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM62dUUwfv-3PWhCI5gCsUyokU5SRaWACiusAPU_6pYQ&oe=6A80578A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGe2g1avYtsQ7kNvwHkdIxT&_nc_oc=AdqxmROWF_dInmANDEfxKRBcxLstbcD4nqmJUflq_GRrv3k5NsPoBbf5A8iWVIKWoDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBrSTazdWzNO6gNlKKxIK138WbhYJ2jCJJTDcjqf8Chg&oe=6A804B59"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjdYGY3SOg0Q7kNvwHjlhWg&_nc_oc=Adrtdc1I-L1vUN3UitKPHCGcqLus-rMZ
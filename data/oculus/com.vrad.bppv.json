_oc=Adorz08o-5YjE8vhjXiksgKxXDiIt2avQKPKA4LYQTj58ppj-1xa1XlL6XqDClrUA10&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk2AVoyDz-YfWh_E_D3vGbgHnxvRYpParTMalyvz2kNw&oe=6A4E38A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EBzRwwZ7QwQ7kNvwEYDD1z&_nc_oc=AdqaIg2P_7dYCwvVPgbVOhsAEoHH4pwaG7mTEmqELmhwqkdXCtSvFYW35pVhI7pmPLI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHz_jw-x2XwynR_M0FKU2FyOoSLrehR9xHLp2DbVjIRQ&oe=6A4E6AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHgHtulux9EQ7kNvwGuIqGR&_nc_oc=Adqck2LVQK6eZAW-12Sw3z1h4sWaREWkuadE1MnxgJ7WhQ2nYGlIwRiy4z6Hn3gZNlc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXDfi-8leI6s78vzx6elQULjzWib-qYQLKu3M6iFUyaA&oe=6A4E425C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDW0GlYOB3QQ7kNvwG8RKT0&_nc_oc=Adrg3jKN2GV2Xc9yshRerspjFWyoo0-YiAt84ika-p9kLu7q8sfC7CgigBSHTGS04LE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlCF7sVdX6stEwGZBmLn7-ZUjP1BJVC06n_6VuOFUCPg&oe=6A4E3E8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5j0CVl5bQsQ7kNvwH4tqWS&_nc_oc=AdrzeW--_fTrkRgeAhyJdXezUtBxHkMa-0OM13WdzRslvyL_uR5CoIVEayRMUMc9H8g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzpi7Gj-QNug0GbbCAmsiCXp4F-CJ_Z9f1NvBF9yl2ZQ&oe=6A4E6A99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOvZ87B91i4Q7kNvwH4jZxy&_nc_oc=AdpXZZuyHjbKIRa_NT8Dxwxio1Upx5ot
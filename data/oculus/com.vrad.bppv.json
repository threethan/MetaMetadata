c=owjLH-s2-doQ7kNvwHMRn-i&_nc_oc=AdoGtZAl59_AVox5JP6NESnBf70zybe5jYTZFiP0Acp5VuZX3nR9CVhDTBpA1BWbNAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zlEWWPLqcF1478O2x6sAh6ZzNvJ7s4ns1Jyx2Ktb4pA&oe=69FB36B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuwtGjR8KHEQ7kNvwGrWqAw&_nc_oc=AdrZgZVFh9M8eBUcM80zb8-EiH_FFoHpbIRO5bM1tUL-jOsZS6tLKY07q2hEpgq5hsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h7LzNYPso0EDF0NYCfzUcAZtdN4cGAF0CN8VKYKiecw&oe=69FB549F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t6zNsg6zZwQ7kNvwGSN4XY&_nc_oc=AdqgTZfb7jjj8Oe9vT5xjRUS9G2DrDNecroMoyDvEWft2GPiH2yZYpnexmjyw9ca3As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aLwjpu1AbbV8xnQDybWLalCukKcK-He-0vWYAE3_mmw&oe=69FB2A24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMNiu6uaC6AQ7kNvwH6sP8_&_nc_oc=AdrZs93UWqO8cn6hPekBceXH2xkw6X7t0aSUlfdlp0ZczgpKEYmUN5nYgQ8KKSqtjcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QteMmN8oVCSzBn4i1kOM4BEAX6LU021g9GKLo0N9wlg&oe=69FB5C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etzr9IeYmv0Q7kNvwFTQ6yf&_nc_oc=AdqvreVgZGh-_CsP82eCrntKwQs3ifx2uUuW0TTeqHE67juXC0y91d765B8m1NB_CHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gsFAfsyujgsUljeIGb07PgFMfPrDRKqh0qQO2adr_yw&oe=69FB33DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53tuiIUPNQYQ7kNvwFyhIhu&_nc_oc=AdrjXFp7_rBHF8wQlZDAXfSh-JDS8pgNku1hINN02vtWiR5Sdzu42Zk3uM_GSs0q4GI&_nc_z
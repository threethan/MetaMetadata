c=D-7DlFG4LeoQ7kNvwF6TDsw&_nc_oc=AdogWecAYgp7D8XiRRL9aiE4A9uQWE_Vz12TYw08bdRoCfNLQzy4Nfp-A55wWjcNk70&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yyE7vGxMPivlqM5VYwAkMjNunXpMJT-oOkiVuBlkZ0g&oe=69E77034"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmienrRDPIAQ7kNvwE_1BQ2&_nc_oc=Adpymnejx0c3VIF8D0g13lNoGJM8NfhIX_bBF_oRdFN_YtCeSjHiwGJlcxDD_1UiaJQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OPgb3lbKgmYGRtEPTc9ZVibZ68dND7sU9uPK8S_FRZg&oe=69E78E1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVBAPxE4hMgQ7kNvwFBYPKh&_nc_oc=AdqBYfIAPoyjVBLmPcHjUA_A0Zy-M5CxO5PSPWgSjjwzw-ijwd-exjQyRH-msa26JBc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ueTRqirCcmixkZCJ5nhjfEMmiIoBuEXwHTvwfFkoFw&oe=69E763A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8IovrZP1F0Q7kNvwEWM4Xs&_nc_oc=AdoefOV1nrKcpC4S8dE-CuBQl02MTw_cLV1pZ1OTfmv-bu_a4MapJKxPXgOFqnZSygk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hpePBJVUZjpJ_1Xc1bjRKraBGzpwayon_6OOxk-vSIg&oe=69E75DB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbfSgBkCLUMQ7kNvwENKZ3n&_nc_oc=AdqNipy0kUyNphxNhfPZonod8q86w6tOeojFbipf_bWSSapUiQ1FA8gnmlbpefxNBzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d_fns48G4V0Qg2BtnUIUdURyyVxX0IGCoX44Y6QUgEQ&oe=69E76D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6N5p72j_agQ7kNvwHVyGZb&_nc_oc=AdpciZAIjxwsWLhsXa1Bi6rIVWuFmLg2Ut1RJkUueB2dxxxX4eRSWFk04Hsxol6LnT8&_nc_z
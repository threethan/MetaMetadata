c_ss=7f20f&oh=00_AQRLEy8fQLbMuhjyfG1aObxP4CGPIhptun5R8xw8EzvMXg&oe=6B0860F4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tfFGqV99JIQ7kNvwGyJWV1&_nc_oc=AdqfQ0nB_qpWNjMCFIcdYzshEISt82EwqNscXP88eqHkvY1QBmeAPOLLna8F8Lnoa6E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJJWTDDdK-ZzCHzi7CxlhxVWwUgbF9MNr7iPZyIFWrSg&oe=6B08469F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggZcn3oxg6sQ7kNvwFen615&_nc_oc=AdoPBMJ30uwE4tJOU1NTjQ1KuecXF5ifd3GPeCnTD9hXCcmKLb2WkGsZiGbuFTKHZ34&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSdfi1fm0poF6UFZBAbqSKgrQe-92893mqErImaEYWGQ&oe=6B085464"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFeGXtP8gG4Q7kNvwGoUeHm&_nc_oc=Adpo4CD1GtSQ_n7QYyoTHmjFJObApLqTH7SGNi33-Hvp0nEVd2qxPd9EzefQfsj-EaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbO8EHDYxjZEL47k8Gj6_hbIVvXAJq7NEL-vysawldKw&oe=6B084E77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqtjfGKJorYQ7kNvwEodsW6&_nc_oc=AdrB_fAYjkQBaxxkrHQI0x0FphOgg__AydPsSYi3RNRKso6t5zlcqsSpmkwmNLnlzqQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIuksxoYUaEXzIFfDb12-Urpd9W3ANxyZvuD3m_DV3yQ&oe=6B085E1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzaHJF43P58Q7kNvwF4RHzz&_nc_oc=AdpXvUQflcnTweq8lg4v4SZ-gWFIoFeHPwKsMkBSKU5gf8PF86rajJ296tDfLFjx-cg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1KR-0yNy23CJWGwgFtTiCwYAcjnEHS7iWnaJaYZUoow&oe=6B085A4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40zoAQ2CxfAQ7kNvwEpE6jk&_nc_oc=AdoCWwjHaN2m_ngTNpE8PIDSdMw25VtHa0Nlse1w5xiSQO-170pnSRrdWT3ZEeT7Ufs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEzNkM4FHRLVxsekZeh8ZLTNsTGpsZ_JRcBvewORD-gw&oe=6B084E19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npbMoyqYXNAQ7kNvwGyzWNw&_nc_oc=AdrD3w47xLV-bpktm67aOMCNJuzUt1WVtoSmG8CQ_gTGrDn41dChxAra9aSbM73DMMI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScG7ZJQf8PFKjxJMsG2Eqakx8JRRgIh0iKo3B-GUqqGw&oe=6B086C13"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OshdwF7PopAQ7kNvwEoWnnT&_nc_oc=Adol6_KWikAg0n6oHgOHACNZ6yzeXBpbXLOqqZZxDiZqdGF4KCpdWRuveKCFKqI4o5k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgSg_ZhtZJgMOwBDHGgaMAkAFdVPAwwZWjrpFl92feDQ&oe=6B0859D1"}, {"file_name": "005.BPPV_Square.png", "id": "1269871715156621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620346_1269871718489954_4811280509119093641_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvp-Ulb4w4kQ7kNvwHhYhTH&_nc_oc=AdqhXExAVBPCLExCfEiWFxRgGx63LWkoPPjgEJJBNUu-0izYLn6D0H0ikVw2ECC
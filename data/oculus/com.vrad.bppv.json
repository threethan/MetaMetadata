_oc=AdpZnwtp5Kq4u7xNW3E1PF81Ogx1Y92y6VUYxG1v-MgImeF8FonvazI6ykfsasS0lSw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CJ8RE9qZT8XKWfz3TgxlQqyj9Cg0-prQnUj-8WJQ_fg&oe=6A2C29E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IqOvBRHNywQ7kNvwGGX2C5&_nc_oc=AdqRRoxPon4WLTpB-Q0N40acrfIZqhGsFI-Luz804RB4dz815Hm7ikZWKGWoBBcVgIo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aYrbWYO0x63zYWV4CPyldgSMv70GkHEV8abYRPkrStg&oe=6A2C23F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwHsikHD&_nc_oc=AdqT1mA0rj7FhTeF6NZkXYf7Zyss3Ua_zrXkcnMK0HOLZsq_ajjBo9IiIQ68rGLq2Vg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Do5dekriCx7KcpnnxmHOAnbdB_7A8ZufZTqsi75zGaw&oe=6A2C339C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5OhPQyHOhAQ7kNvwGVS9hS&_nc_oc=AdrLU122AhkF-Si5hsJzn-zGGGNI9ZI7NDA_MTSd61G4jRbQmse_a_LnkMY1mHKle1o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oOxwi9VlP2WcxaKbGT_gGH7yYAH7unHWdw2PRr3js2A&oe=6A2C2FCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS1Cp0PZld0Q7kNvwGNPpLu&_nc_oc=AdpudcpwXzijRLYEeq8OpbxM8-IyRY3gULweeG0CEom915tsryePn8ZsCTKfy8GkBE8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uQrRyeU0SYtLlA9L18X-UVo1c1yWZIDD1iPjX-QdrAA&oe=6A2C2399"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_HsceiHzwoQ7kNvwH7eZRd&_nc_oc=AdrdHaCCc5EWzm2Kg1NbCtWNZBkbzMwQ
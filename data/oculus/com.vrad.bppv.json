_oc=Adqp67aEJ8_154-aiNiKQAhX6KQayVlG4pVE6ykfo4a2cm5Uue7P4DBHdDLV0FPaREQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6swc-A9tbKnnm6fIIvn21sEMsAXv-WYX65r1_jEt43sA&oe=6A0464A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhI9F5_mcuAQ7kNvwH9vTYF&_nc_oc=AdqoH-7_hJvgQ5InCkKTtt5xsHVHDGK8S6jZr8UdxNAdNqOUOBpmIsVIm05SM2I19ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xyFhzFNTGI__zWWs_uAEHduJ0DYQyV6q4tWsf8DH5hg&oe=6A0496F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWXgsWE6CY0Q7kNvwFuw-Z5&_nc_oc=AdrV8BBE00O4ItLw917JqfOKCanUHcM3Vo3PoeGddhakuGMGDxZPB_Zj1ljYPsiEKTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-6bHA38ZixEEb3X-f7mUM3-Tzb3fvnl_qzIJ3YycOkA&oe=6A046E5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IniaMyQfd-gQ7kNvwF9oyxD&_nc_oc=AdokIYK5fFjBW-z0Pt3Pb-0El_xcCdqmp7B5NWyy8126qcp2n-VkdPJZbiJOiB1uxmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lHuRTZ3fJgPkFiF_vC_bZKp9d_BxGBt7XWcaKmvVcBA&oe=6A046A8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJoqNnJueXQQ7kNvwFePEz6&_nc_oc=Adqy6NzF0-6Zo0S1pZkNrQrKQb4An8Q5R24UkMQu9SPGUgqn14bT2b9dFR5Ciqemjuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T8dPtT0ERlt741X7UX7NaP7StGqasJbzfLFaVQJG9Jw&oe=6A049699"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcaKxeC_EVgQ7kNvwESkof2&_nc_oc=Adr32wvfvdY2cBpMJn-FRzd-6dsNW3SL
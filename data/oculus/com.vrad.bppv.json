_oc=AdpqFeSIkSHAuCGODY9A0NabnjJfD32-i9X8oBbzhn6UqhZXiPICR6p8w9ncREtIHmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ze6Rmz3hZby9mzpXzFn0hj0wt4-9x1A8RijOxJ7zQLw&oe=69E0CC24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOttb8NuR80Q7kNvwG0SzA1&_nc_oc=AdohBR4HqDlcFxKjX9n4sESLDU7Q6Ak-p2NrsOjSbmG2t0uTNHgYtwKADOR64YhSHF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kOsH24epcAAL65TMsjahru_4aYhjeCGdST2W5pise-A&oe=69E0FE77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAEbX6Har6MQ7kNvwFXp0mJ&_nc_oc=Adr6jRCgSIcYTjjDWbCE4aYiAYyUdupiaIvTweKbM8232eQCkb-Mfr4-gd3euh_aV7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lGCnxU9DDeHJZSiCGrfRHZ1IQgZhvnPUwolP5U0ZQKQ&oe=69E0D5DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFW2IGwRz_gQ7kNvwGc-nD-&_nc_oc=AdqkkfyeJRg9RV1fPsWxPOLXnLcYs7phF5KXC1eju7UUNWI3xJFUwoAbstJ3T6rejec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DB-JNXfwa8dsbBIZA3rnXKkLDdiuX_yibGqYR-9refQ&oe=69E0D20A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjyrBDdt4_YQ7kNvwEwtLMH&_nc_oc=AdpsSi4A3SVUHDSTs3LhFWsCGbJTKWsedHI8_t1__7A_UkwSsG3LNKrKGFx7P1Lb4_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_w27cLq9LDt9Jk_iLWZhWDFecnTRJwOHh7axB7nnD1Q&oe=69E0FE19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f8IjxsDuWoQ7kNvwGRU9Jw&_nc_oc=AdoLi38p1MG43x6RsVFLmh7FW5bqfF04
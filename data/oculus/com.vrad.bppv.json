c=ANyekSAG36QQ7kNvwHTdFl8&_nc_oc=Adpo-LTpxGTc-kFuyosYrQ36pliqW7u-xQl5SsQY_VwSjDWUB9g689q97KvP8KgMS4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKTWMZcjsFG6ld9-SMKGFa-TAIlJGkcrgO1w1BIdNGOQ&oe=6A8C3BB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=060o9c8azosQ7kNvwHkw4oO&_nc_oc=AdqgS8EzJZXnaZi1ixi4SHr6V518J_HGXFjR2FH6bjRx-i1zMXhcPkl8iklsapAf5Ok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUmT8ZKgbNxsxcs1eRuzwqZz24EmsRXJ1rFWTVXKkNlA&oe=6A8C215F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5N_86ZhLfUQ7kNvwF_1_np&_nc_oc=AdoFwo-E-I511ougsuSciYTbUlXiTH8eBi5cFJFxcORoiR_sDNqczaQnEXGY8kfBlDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEuJTsBiAOCKM4bU3bdoyGj8Q5sw_BfLozdiMckHJcpw&oe=6A8C2F24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwE8Ix0H&_nc_oc=Ado0_9WxRG0GJiyRLRTccucnOp_zolCWjsSOVYASTplr7GTceojPtSsPBOfg_mv4Wy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM4_COmr2GEQCnjWZ_Guk72080xcI8gwrWDvweC4-r9A&oe=6A8C2937"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81MVu456kncQ7kNvwGp3c2i&_nc_oc=AdqcxTOpALysBULXQx_gpvf-NeQ45OPWjCKzR3vN68spgX6t7JZbsr6uCimuFfTd1ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv3KyGBfW_h-d1JMh4UW9eJUWoketJuaTVsr_1-euQTA&oe=6A8C38DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwEGVaxh&_nc_oc=Adp-P19nKgbJAvTLl9VTCe6GYndNT6M5G5-a-7j8Pop1jEj5U6lyMgbnl8pPSzoMxIM&_nc_z
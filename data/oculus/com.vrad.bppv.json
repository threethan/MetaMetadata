c=OCKafu8ZPZ8Q7kNvwFGr1fa&_nc_oc=AdooDUJoXXau882g3YixuZFtRGnkZ2PYbBaroTfKgVTSh7bbtpfasbw7X09sP-N66gk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QVi-88cbC8Wg0RR48lXMKRVURwNWG4CfAlIO3OZSR0w&oe=6A12F1B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXu5oJg7k_EQ7kNvwF_ajg3&_nc_oc=Adr0AMVoHNmgziw2HqRy4K7wV13jsIC-xPSUX9Va6bq45Lg2OuE_1ss9Si1y_x-o350&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63GO-1eWqpaJOXN06kMwTL5zKUxYZCKKaoL5Q-Ylb-fA&oe=6A130F9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0_L4ov55SkQ7kNvwFV64n9&_nc_oc=AdqyJi83bSK-MMTDSs822m1QY2hqCTFU-cZdkkvBl16Uxk_7E-ztquEd3jxDPGP1DIo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t99GDyFjYVuOfrzusyLqSj2Ys2cnTBSoYaLQP6WA67A&oe=6A131D64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2IHjLLRluAQ7kNvwHLCB9y&_nc_oc=AdoCpteZ3L7h9BYO9f54zIVodFPi0gP5af0Vf1HEtL8VffANTPlPDITZwQFt0PBOsYI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mja_77qpxmHuRW1qTF4SI72w17iUA5Jk_Z-9T-Cf0bw&oe=6A131777"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWoRFsKQcMcQ7kNvwFVIVdx&_nc_oc=AdpxpOy_sozge-3wf5Nizaqsyot5TGPpgV4ptPMr2-FF3T0VopcanL058QWJmPuGhHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5meBq0xis4B4MwJlEbMQtb61v48H5P9Qjjg1YqrhgcqA&oe=6A12EEDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMAMRUdp6GAQ7kNvwG9s5CC&_nc_oc=AdpxDNKsGPRMf_D2UurNT58yK-Q2jAOo5fwuzqqFrTYGJaQiG3q4FNC_z8aIARk1nY8&_nc_z
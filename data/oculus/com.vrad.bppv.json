_oc=AdrgqM3_lhbTlS82orFi2sjZpVaiW0PnzKnLbqvadbKwpMSpy_NTk-JO0sj7GTSUZyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsVg2M6X0jDibSFjsIC4Hha9zNaeZI7T9irLlszwxAw&oe=6A3E9EE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc9KwC46SdYQ7kNvwE-fXnv&_nc_oc=AdrMQ4N5tzVIyWAYgs8BavNsMagYGQ7IV-DLxSaM2dPMJ6LNeiwjd3aPGxLMBGCQMPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQdPGf8kCbGYwbgpUGsMPzj-Gk6e-bEcHywwYBerV9w&oe=6A3E98F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXpdnZdg-kkQ7kNvwF3fh4T&_nc_oc=Adpjle1VtTlcSdUA8S18kKB4sH-MLgAsUWE-DwPkGGblecW4PdDXsiOt1KTbcpO9ga0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RtLoDg4ebXK6yASc4vdz_01EHs5tJfSCVa7rM6jOUCA&oe=6A3EA89C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgoY_DJJooUQ7kNvwFh-4Zw&_nc_oc=AdoazyN-7yq03gB-KUc5NYhMI-LdTIW9SRRl6taB1_xC-rC9RlskCG36qKH_1f8NcqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GLN8bOEHttWptdm1jrKYxQjGVrle2wFMulVrYl5ZtHQ&oe=6A3EA4CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSt8I4D-5kcQ7kNvwHyeUcT&_nc_oc=AdpKiZqVxpvCHtHEWAg31GMPXIQsR9DiKCUXbG9Qfgpk-x4o13qx0QGvgy7mVhbNwUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9awssLqmVKaPcPXUj9g9B1uwKP81UEsoZs25XM41_GDg&oe=6A3E9899"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjk-tgVSH3AQ7kNvwFnHJJR&_nc_oc=Adq2VeIvb3S1esn3dVGJmeV_hVhTg5wA
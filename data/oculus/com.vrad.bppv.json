c_ohc=IT_YZwSA4g0Q7kNvwHX_tQp&_nc_oc=Adqm0siHtTnq0jDrCrm-Q_wgaXkxTdXTBZzXF6u1_E_0eWOadXrIyzvEtrlyq2NyGCs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHICj9KVj5S62jg8vjGjXip8UmMqvMy0mhSw-D43XRQw&oe=6AA3F6B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HbEOYlFg5cQ7kNvwGfdEN3&_nc_oc=Adpy-EUh90_r4X7Z2UIjaXHlHtktNRvvhvZd_y4vUlhqXQI6Turc4fv2hcPKGDI5FLs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPPGeDKI2VngO1xWvUPFlQ0JYw9XpkZhXhqOQiz5JW7Q&oe=6AA4149F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoaHQvU6z8cQ7kNvwHjL1Ru&_nc_oc=AdpNCWYbbe4ndhyBobsmgpRP0I8AO0RXkcl2UQ94oie16ippUq4VMPP54ugEBnVKDaA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB_1gvF6bOQxMbYv7Dx4PVJ85Uv7bOjq1GKSTPLxR_fA&oe=6AA42264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn7-b0xvKQ4Q7kNvwEUQnO2&_nc_oc=AdplN4F8i3RQlc_muJgycjsdkH3KP9gM934j56FTGFdT9a3Se2HrV7j4qvZkgJW1ELs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9CWcJKI8pTZnCMZIjkZhZLjZ-6ejbAQBogKKP7-v94Q&oe=6AA41C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1E2AGl_9vwQ7kNvwHO2I8b&_nc_oc=Adp_Plp17752kBRb2RxKf4pXmFnNTWnMrdye7WoKMcvTM5R-eaN_BM5Ja0ykdPx3wk0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS5v4Y2XQ_LDGSdsbe97SNaM_CJQdWRqd6dbQjiay6xg&oe=6AA3F3DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ4fhJCS7oUQ7kNvwGaXFij&_nc_oc=AdowuAH37faxvefC5YG5Ymt-OdawKWtJ2sEQTfEHccJoDEtxWVu5x1QeDJzwE5H8l
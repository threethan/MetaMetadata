Z&_nc_oc=AdlLy58Fij4PYc2DXqU6yJ-siD80CWq44snH46K3yl69igaJcvBxqGP9DZbKUhWuHDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4Ltb10I_pM7CYPYDYr0qyCUI5YkiAndD11PRO1jZTUw&oe=69BE91B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bUst5WrCYIQ7kNvwFL02jX&_nc_oc=AdkR8LTfIRuSgZzgwXl6SfgAN8lufZ3oFbj4O1THwBopSKDDyPDOYyrDrsMzvFlbM6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4kiHf1YHn972K8N3iVDA_VGKHtbl29VDjtUowC9UN5Q&oe=69BE775F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7ZN2KsejSQQ7kNvwFTZclR&_nc_oc=AdkFwoA4S2SEJ-ts-5uYNTZPiM8iCSz591FiAPueeUtM5aSSY1p-LGVO61MheveLwrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1z3An_f0FTPuLe7JCN9SA4kRLdi-UuPRLjFPda8kH-g&oe=69BE8524"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCUD7Za9QBYQ7kNvwHz9qj6&_nc_oc=AdlhIshkATxBF1VB5lvZxcTfRcRPftR1LTPBt8DR2sfkEX0yHs7kvJy0tgWMfiG9JGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5QdrezsuKQgMMKC9GdI9JZDwDPVBnTUm5Cr1zWbTTQQ&oe=69BE7F37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8qmnCp4RxMQ7kNvwECzFeo&_nc_oc=AdnGsYRg_iwh6HMAMirU9eTgvecb_PVg8LMjIJVFMuYSS76LWNay9x4SgmLXGN4qfe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfypURGjJVCufX2MLJ2136snZG0AEvjTeXRXHk5UXZrNTg&oe=69BE8EDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__dyip4zrnoQ7kNvwHB5Du9&_nc_oc=Adk04DXdN9_wORwPA-VGfGENezc9aIDeEWxwCb-pWDxAAZulPNSX--dj-va_fZL2Yts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc
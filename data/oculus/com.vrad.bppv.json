c=KIUdj7W_SMoQ7kNvwEfT0jS&_nc_oc=Ado7q06G40IxV7ibMoBqpdADMjrRZ1iLZkdGikr5sJTIy6niMU3o6_04RrycPN7X9co&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEYNEj1s8nySgwbOa7oJaYrataxvd9QjZWCgxTrXUg7A&oe=6A7F0CB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8990oVCTDK8Q7kNvwHMsD5G&_nc_oc=Adoq_goF1xrhrS6O9QgUgd1PW1ZjI3Z_4TeQ1OVHF8NeLd43QPJOlcXOJ4OroN_d9Iw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ1_mQu-6WDFBBwSCm98z9yRp21NKBs9lwKhbxLmmOaw&oe=6A7EF25F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKNTnxJIQ8Q7kNvwE_bd2b&_nc_oc=AdqmiK2eeYdTueBIGpMcRCsTslb3HkAByi7z78avDR--jtPbd8HH6aWUBrRz7pFKdwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDC2ROTJh-vP3ApQPAxVmE8J7JpsChUdGUOvIjNBa5Q&oe=6A7F0024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwEjA1S_&_nc_oc=AdponxzAAqNFDL5D1tLW_HLCS4tn4-ayj1cbZgJTFUmPMB0WOb1qbBOijv91qy4PG3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBr-rytYFcoksFcZ-AwaUBMdJg_u3ebMFbyaM6mwJfpg&oe=6A7EFA37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIR3UyBl8AQ7kNvwGNtVmJ&_nc_oc=Adqwk7S1EwQsWhUZxG2-EGxuS_aTyKKMnMQWNWWLhXSOQQaSFyV7fKbALeANydoW_qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIgmZOmXDBhiAaCwp7Uqz0rLoKsrANs_RKknk29jrY6w&oe=6A7F09DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwFG-NwM&_nc_oc=AdoDfwVdy-UbRERXA4EHyMhCupsJjNjEg4f7UCsvwiXigr7TCfdKyBpElyCE589d6eg&_nc_z
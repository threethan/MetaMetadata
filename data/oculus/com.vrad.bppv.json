&_nc_ohc=ANyekSAG36QQ7kNvwHYtfRz&_nc_oc=AdrkFUsMmoHnYn8d_jcF3HHV9q568ItOoZyD-jicYXul1LfcXL9aRSIgtrRpmCknf9M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOxoTEqlu-ogkT7IKmGpEjlV0hN2TGlQBiz49mpMleQg&oe=6A8D8D34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ST8VPfz3RsQ7kNvwENFOPF&_nc_oc=AdpW64WzgJ5bhd55JCaFM8dfIJND2U4Lmkymc8Ec4XPkYEIKMUooNhikubrIOPKLyrE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_r2Fzvo4VWyYvhiyUZgnsEB1QlmsEYgoutc9GxcO2yQ&oe=6A8D72DF"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIPWC-UlcrsQ7kNvwFaR4tG&_nc_oc=AdpzYN-IUK6dE-EG000hq5PPGGjsRU4kcVJqx7prBfNgXetH2iNXWCSPp73usAvxZ_U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNNjqRNdqO0eHE3w525Dtt5SGStyIWlKawxFYb8TgyIA&oe=6A8D80A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwEmmc2w&_nc_oc=Adri2YqVbiyGMkAXCvYkQENOUUt7TrFR7_M7kttuyasdgBMESCBVom16tk2hZzQYyHA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW7gWzaElIerNGUh6Uc1ZEt1m_Am3nuX72q3cxiV0awA&oe=6A8D7AB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9cTJRHPcEkQ7kNvwHZB7xY&_nc_oc=AdrqjUau9uE3HdKlF84KXaMA75w-UmqmwasHQ3d7zppVCuNVHvXb0qjnb9Z1sATlrEw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7d1ecKqEh8Z_izJjyC3LoglFDDxwylTB8mmwbbcnt0A&oe=6A8D8A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwFURJpF&_nc_oc=Ado4q4UiP8JMZT3Gnk8hQ6fWztTRQvjSKQHaIFQ_AWm_xn3qeRKAuLaQ_aW9a
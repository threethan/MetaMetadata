c=byQpb4pY3wwQ7kNvwEUw4Pg&_nc_oc=AdoFwPb85mFHBUB2ZDIKcJwZ2ZgtSkj1RvNLABZbWSnGFyYwedUj75aRAooRdxSV2X0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V9vAS0FDxrOpS8G0S_Ce-99o4daVIwQBAmG-M1pay9Q&oe=69D64CB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pCmHXyyMt0Q7kNvwGD8evq&_nc_oc=Adocx8aimsAg2vr-tx8jqI-hIUCXgpgEMeSJZMImlRd3ct0FxjAogO6RHrEt_Qj2icc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xegcxE08a3Sl7Ij10axySOnN88DreEhC8YiLvESdDHw&oe=69D6325F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oea_UxTvTMYQ7kNvwGTQjXi&_nc_oc=Ado3oQG9R70gu8GdlQAlHPGbU7_rLe6G2zODRtAZ-cCX46QHd41PCimV2L1DW-Ofu-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QbXdihxOH3XUuf8YkdRxIsAcoXyu20dNbnGpZri9o_A&oe=69D64024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJa5yOdHdYgQ7kNvwGoYNGA&_nc_oc=AdpaUwafVKIx5iSPw-YA0Ps9q7zd2rtVbE7RJcOjJIU8Pq1jw7oIKgoIozAZBEITpD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2unBy2aOureYkuOriytZWGl1rVKVs_q99USjRrVnw6ow&oe=69D63A37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxN07OcCSZUQ7kNvwEbZHXZ&_nc_oc=AdqldUpSzLG_wPfhSFSwAhPVl9bHctumE0h3SSNPe9Hb0xl51XVUCnol34BArCmg5O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cAJdPYXQ-9s48upT5Taq07mPzxkMiw7lH_CPQIukhVg&oe=69D649DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opsUnyiVrcQ7kNvwEsgpwl&_nc_oc=Adrr2y8Oo2GXNg_8XytOP3rSFsZNdYD-tplQV5cVVVxvs3LsplE4ziBJXgCkFIwVLPg&_nc_z
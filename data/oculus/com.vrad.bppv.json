_oc=Adohfjo6cKe5pXjS42GSIqjLUgFWrBgKsgjg67BlzWBH7bTYNVnW8cs3Jv97SJFg4JA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3eCgyaBsMBx6M-oOv7dMIRweHYU5Hq202xWqBSXwnUw&oe=6A526564"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74YOJw19sH4Q7kNvwFLkTK6&_nc_oc=AdrVaDIBv1GdS0P2Tie7YhwAqGmfgoFoE8nmwTNkuSpj5ifZxhDAo1vKRQ_xZa2xw_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP-BZRoRsXyufCzMj4tHl1hKNcahXmznnoZklr5aT_SA&oe=6A525F77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx5zas5hiuIQ7kNvwFnBdoY&_nc_oc=AdqqJqa03xNR7Sgg8N0fW9J3gOO7yJs3a8gG1YtIiac_bm-n7v_pJirtbUAzVNRfe-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW5PWxsyMJWPnf8oa2fvpck8WJNQ_ZpFzZezGNuItSww&oe=6A5236DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB2WbUxZOCQQ7kNvwHvdLPV&_nc_oc=AdqvP1kdlHgLibq6r2ds2T6RgRQ4gPn2x0m_AZVeqWuVz7XpIPf2cfZAmxyd7P2C398&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVuzzYiGDsNJbcsJqid_eas_EgT9L0ltw796VwpHDl3Q&oe=6A52330A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDRJpm2xAS4Q7kNvwHmfHVT&_nc_oc=Adp2cF9nMeGpZM2Qo9woiISsRWqpFTGuwGVtWQZdOnCIjIAhFvsI2NOB7sAm9PIrojk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvRmlfEkdbRxz5jjmZmPkLRhmk8SLcXESClC65hi0WJw&oe=6A525F19"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ_ojHV_RkwQ7kNvwG7Cxs_&_nc_oc=Adp2rfbZkqlz0Y6ntOtYlTfNyHh5DFId
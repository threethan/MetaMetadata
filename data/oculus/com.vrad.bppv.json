3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VqB469Zfyw1ZKAmCxKgF2w5PyskL-1eac1qWhcu0DPQ&oe=6A0F031D"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1840508583495177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618472_1840508586828510_872439580698956530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV6UAo-uQ40Q7kNvwHH5RFT&_nc_oc=AdrVjp0OkrSv7bnBZC15rSv165zbZtHMO4guKbVzJjZRKyaDbU2-g7CGzrRleyfqUyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z6XTqdhQwl5lMXwWN3-DSIm9CuewiF5aNkEBmXIaN6A&oe=6A0F1CD9"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1740274659974648", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619805_1740274663307981_5923496579526209083_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RE5xXlGvkSgQ7kNvwEzVbfX&_nc_oc=AdrmvRF4PSqr7szPbgbgcCa6SK1ihJRLWpDLiz1z3TSd2wTR4NfagOhPb0Fzlg2Fq8g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gUgs-sAnR6f41WosmQRYK3Uv78XpaeKAS7UumGD2juA&oe=6A0EF6E1"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1597651274566161", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618264_1597651277899494_42633863191051194_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeOg3qXyvtwQ7kNvwFuQwgR&_nc_oc=AdpfVEcak8fJqOyK6BkjYfOkNJTAIJfwgx_PqXQsBOVML75dD3jn5-iyTdsdRl0MtyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cvBtoR5bh9mE71hVyP-MIj38EevcyBbWvmd0rxifoSg&oe=6A0F0F0E"}, {"file_name": "010.BPPV_Screenshot_B.png", "id": "840442151810750", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620856_840442155144083_7266284938802113276_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq2YU_MA7R8Q7kNvwHTgPlU&_nc_oc=Adqd55XAyHXOz8d0Y5CUxH9csf9x4NVV8DctbNeINl8TmPcr15dpVM0lL2n6lIBV9mA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76RR56hQzKeXKzxITfUlbox6H1sSuHKsVkkRtfASlTUw&oe=6A0F0D68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV\ub294 VR \uae30\ubc18\uc758 \uc774\uc11d\uc99d(BPPV: Benign Paroxysmal Positional Vertigo) \uc9c4\ub2e8 \ubc0f \uce58\ub8cc \ud6c8\ub828 \uc2dc\ubbac\ub808\uc774\ud130\ub85c, \ud559\uc0dd\uacfc \uc758\ub8cc\uc778\uc774 \uc2e4\uc81c \ud658\uc790\uc5d0\uac8c \uc5b4\uc9c0\ub7fc\uc744 \uc720\ubc1c\ud558\uc9c0 \uc54a\uace0\ub3c4 \ub2e4\uc591\ud55c \uc774\uc11d\uc99d \ubcc0\ud615\uc5d0 \ub300\ud55c \uac80\uc0ac \ubc0f \uc774\uc11d \uce58\ud658\uc220\uc744 \uccb4\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\uc0ac\uc6a9\uc790\ub294 Dix-Hallpike \uac80\uc0ac, Roll \uac80\uc0ac \ub4f1 \uc8fc\uc694 \uc774\ud559\uc801 \uac80\uc0ac\ub97c \uc2dc\ubbac\ub808\uc774\uc158\ud558\uba70, \ud658\uc790\uc758 \uba38\ub9ac \uc6c0\uc9c1\uc784\uacfc \uc790\uc138 \ubcc0\ud654\uc5d0 \ub530\ub77c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc0dd\uc131\ub418\ub294 \uc548\uc9c4(nystagmus) \ubc18\uc751\uc744 \uad00\ucc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n \ub610\ud55c Epley maneuver, Barbecue rotation maneuver \ub4f1 \ub2e4\uc591\ud55c \uc774\uc11d \uce58\ud658\uc220\uc744 \ub2e8\uacc4\ubcc4\ub85c \uc218\ud589\ud558\uba70 \uac01 \ubcc0\ud615(\ud6c4\ubc18\uace0\ub9ac\uad00, \uc218\ud3c9\ubc18\uace0\ub9ac\uad00, \uc804\ubc18\uace0\ub9ac\uad00)\uc5d0 \ub530\ub978 \uc801\uc808\ud55c \uce58\ub8cc \ud504\ub85c\ud1a0\ucf5c\uc744 \uc775\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ube0c\uc774\uc54c\uc560\ub4dc\uc758 \uc758\ub8cc \uad50\uc721 \uc2dc\ubbac\ub808\uc774\uc158 \uc54c\uace0\ub9ac\uc998\uc740 \uc0ac\uc6a9\uc790\uac00 \uc124\uc815\ud55c \uba38\ub9ac \ud68c\uc804 \uac01\ub3c4, \uc911\ub825 \ubc29\ud5a5 \ubcc0\ud654, \uc774\uc11d\uc758 \uc704\uce58 \ubc0f \uc774\ub3d9 \uacbd\ub85c \ub4f1\uc744 \uae30\ubc18\uc73c\ub85c \uac01 \uc2dc\uc810\uc5d0\uc11c \ub098\ud0c0\ub098\ub294 \uc548\uc9c4\uc758 \ubc29\ud5a5 \ubc0f \uac15\ub3c4\ub97c \ub2a5\ub3d9\uc801\uc73c\ub85c \uc0dd\uc131\ud558\uc5ec \uc2e4\uc81c \ud658\uc790\uc640 \uc720\uc0ac\ud55c \uc784\uc0c1 \ubc18\uc751\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.", "short_description": "VR-BPPV\ub294 VR \uae30\ubc18\uc758 \uc774\uc11d\uc99d(BPPV: Benign Paroxysmal Positional Vertigo) \uc9c4\ub2e8 \ubc0f \uce58\ub8cc \ud6c8\ub828 \uc2dc\ubbac\ub808\uc774\ud130\ub85c, \ud559\uc0dd\uacfc \uc758\ub8cc\uc778\uc774 \uc2e4\uc81c \ud658\uc790\uc5d0\uac8c \uc5b4\uc9c0\ub7fc\uc744 \uc720\ubc1c\ud558\uc9c0 \uc54a\uace0\ub3c4 \ub2e4\uc591\ud55c \uc774\uc11d\uc99d \ubcc0\ud615\uc5d0 \ub300\ud55c \uac80\uc0ac \ubc0f \uc774\uc11d \uce58\ud658\uc220\uc744 \uccb4\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrad.one/bbs/content.php?co_id=privacy", "developer_terms_of_service_url": "https://vrad.one/bbs/content.php?co_id=provision", "publisher_name": "VRAD", "support_website_url": null, "website_url": "https://vrad.one/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25158149793836186"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1351777529933299"}]}, "baseline_offer": {"id": "1351777529933299"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763353800, "status": "PUBLISHED", "id": "1351777529933299"}]}, "liveChan
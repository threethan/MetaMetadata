m&_nc_oc=AdlWLU9rI_DYEQDLJ5Tk-EiwErhz4GWpTpkZLXLA0iKgJaYSXfb1Soh4xh90UyErSLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRIm1hX0X0FKM0kd_7UyLXpHrDGkeOiHv_je_I9VZUYA&oe=69B6A8B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWK5zCSVdoMQ7kNvwEG0mfU&_nc_oc=Adn8QGNmX3GfazfNaeEW1OoqeXA4jL8PWs8I8ye0cqLF8ypsGlPnb_1r4qR70FCFRD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVVN5tBnEXM0AnV02kvCca5_xTbaUrFs1elB6GQsEQPg&oe=69B68E5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_V8YwlBNjwQ7kNvwE0aqf9&_nc_oc=AdmAh0MqjLoOVw8y5UZfi1UHr6KfqLcdm-XjscDLXC87eyCClTRUkj01VJm12glWs_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywvWn4kWydyNgjf24Hm6jruSj7XeUkjIh_bvEoeZ4IJA&oe=69B69C24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVWAXCC04RIQ7kNvwF9n-9G&_nc_oc=AdkysbOf1XKQFxDjYKjuBgJN-D8XoQYqMDEif9xXQ3_c9z3tnOh86ZWVRwGX8h4B154&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMPk_rhTyaVQF9zBuM76i964aQl32twX2qFkAFjkYsxw&oe=69B69637"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwEiW0o6&_nc_oc=Adnh1aEKr2M1Yp-2GDHOF3THUdzGPB9wISswoW1dL9bk5D_hGv7ums8Euob-wouz7Yg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-wWN9hRWA2_uXS9Li4KzOOQqJFBKZIgIYqDeKBEFnEg&oe=69B6A5DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6WS7rWJmDIQ7kNvwGdo2sJ&_nc_oc=AdkVrs13VkaySnmAFDkg5S1lz_WSkWiF79NJeSlGsrasC5HoKCliHgFSMSrCZqnKPBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc
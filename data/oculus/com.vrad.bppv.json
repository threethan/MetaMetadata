_oc=AdoZLeOtTnqB_b93rOxXx8MpaeXKQEBayG3u5BBrlt3SplqxjtkjEEIMRtivOOc4GbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvgyKEuKcECG63Ro3b6o4hVGneq3RcYtUlLlBQzpJOWg&oe=6AF730E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwFajYLI&_nc_oc=AdrLeQ719AofC0Cf9fHULsT_pHyQsL61VUmF7ngEEXLIOL8cqccc0Sg-MrtD1enHrKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhEF-LZ_fLW6B-1EUl_WqqRDFg-ERzrecOo_irmSbNJg&oe=6AF72AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZHz1zU-snAQ7kNvwHkwbKw&_nc_oc=AdqZfuUBHn6-bJ-6_3Xx5jR9jKt1ouOP6H4dhtx5CMGGIRH0w2bWC5i2xvR1grP8aA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHQb0aEXUN6g5ZQ5F-REF1S6xioXAiBpygwOXqqBvySw&oe=6AF73A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFdWpHd&_nc_oc=AdrS5r5e-ruRMGiXxwE5WYB434J53DJJB8AI3MTVQjkEtogBPT1xT2x7v2VbuYjJ1DE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZfoX7nVkmz_nwW7B876e80z1xQECMadxnZekUg62BMA&oe=6AF736CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdY4jSMumbcQ7kNvwFPpfAG&_nc_oc=AdrP7pkdVrbJ8f8b0y-Y-3HRf79_22eOzevzHkxSctAgu6-GpwQ-iZ5xTjdZhH7dsDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxxmPhuHakzMa5PX8eNQRDzXJHEVG_9BOL0VjrhXzyHQ&oe=6AF72A99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_DDFM9Y_IcQ7kNvwE1xcuX&_nc_oc=AdoXCBUqvU9hxKdct0Kk1Xbcpt_3kTWW
_oc=AdqmiK2eeYdTueBIGpMcRCsTslb3HkAByi7z78avDR--jtPbd8HH6aWUBrRz7pFKdwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDC2ROTJh-vP3ApQPAxVmE8J7JpsChUdGUOvIjNBa5Q&oe=6A7F0024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwEjA1S_&_nc_oc=AdponxzAAqNFDL5D1tLW_HLCS4tn4-ayj1cbZgJTFUmPMB0WOb1qbBOijv91qy4PG3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBr-rytYFcoksFcZ-AwaUBMdJg_u3ebMFbyaM6mwJfpg&oe=6A7EFA37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHIR3UyBl8AQ7kNvwGNtVmJ&_nc_oc=Adqwk7S1EwQsWhUZxG2-EGxuS_aTyKKMnMQWNWWLhXSOQQaSFyV7fKbALeANydoW_qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIgmZOmXDBhiAaCwp7Uqz0rLoKsrANs_RKknk29jrY6w&oe=6A7F09DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwFG-NwM&_nc_oc=AdoDfwVdy-UbRERXA4EHyMhCupsJjNjEg4f7UCsvwiXigr7TCfdKyBpElyCE589d6eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwvnD7imC2f5d-8nnbkdD4BjiFBplHSN5olsCBvlZkTA&oe=6A7F060A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXDsV1qgAGQQ7kNvwEcmDkj&_nc_oc=AdrgIy5UrjBgr-dX_ekuyU9-QXOAtwQAZ9gCzpeBdrXDHvkagJxO603kjPrCPIfCb-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXXw7jljJTGmyNqvKsNmvDtz9N_WrIRnOT9lWBkNc7uw&oe=6A7EF9D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjdYGY3SOg0Q7kNvwGH_xIu&_nc_oc=AdpQFEEfuJ6XhGgLuK92Nk5i7LcSC5BV
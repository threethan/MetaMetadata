c_ohc=euSYPcvqoSkQ7kNvwFi3EVs&_nc_oc=AdrSxKAH6ZG7onX3k2YD-K2WQF7aXHVaPRMeUFPUlqcdWjQ0viWCJkeSg9tA_WpC3a4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjO3v-fNwLb7RIbAn7zvs9g39_O2IfPLOaQmgIUBXuZQ&oe=6AAE82B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy_4MwS6FNEQ7kNvwFcpZWB&_nc_oc=AdomTaeZAqj7p1WmPF49mnoLf7907serKoSwnt-EJvVIkgnPlpqqgjfUDVOL0x7CTtQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIcPIu_DK0_7gXIiXojcjjo0NcEG0G7fhFJ5rZ4YVS5g&oe=6AAEA09F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ0-V--LS2AQ7kNvwEEEyZs&_nc_oc=Adrdw7wjD3XYR-XsODjlRPGRqwNZrdna5C967d59yoKAkc2F_rHl4p8dnHNMvOTNXIY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKib36K8WvY9T_2GmOL-6MivaEDcmtULi_T9NugKhD6ug&oe=6AAEAE64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cFaAFcnBzUQ7kNvwHXq7bK&_nc_oc=AdobOLWO_xst3u49_eqKi9zf6kDux6doDZQ7N5Xaj_H379DUcfVdh0PF6BKiDubojuE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIOjPXPjMJj_3AVUFQ_lPwwn8bzv6lyasewP8XcuWoag&oe=6AAEA877"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC1-Mb_xBT4Q7kNvwGesyh3&_nc_oc=AdqJq0TkoaS7-s4e-M3CK9ePjkaeRJ4ZfNqGP0HKUXzbUVkjEwn4FzMWXUrorooGqJQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIej5Ck1cBAJ-Va7IO28xLHqXJLfiW6uPlYPg2RGL0TJw&oe=6AAE7FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YF73D_1q-MQ7kNvwEdE5H4&_nc_oc=AdpBw9yeq8B7AwMvxASq5nsePHtISJYF6Eq102pmJHUb1ax5AqEeiU9bry8_h3w0K
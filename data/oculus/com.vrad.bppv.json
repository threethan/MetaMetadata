_oc=AdpDQtIh4-YKcGobcectsicOtgidoAG_4ZEA9_VXSsOG-kn_gXd17AuOf76WmWmopT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6xuLugT01r2hWqTCEBsPod5Imx22bLbmurSJdE_HuNw&oe=6A7B0BA4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpR-Z-CuPTgQ7kNvwFJASbj&_nc_oc=Adphc7mkkpo08an882-0UvCwyggfPlvQYeZKE6P9YcWGIzj-pJYjMVHI0OeRwouEEBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjUPBQzd3RZkGYxgflEjNbbhnSqPcH9D4vQP0GPmZmag&oe=6A7B05B7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVArtsPuNQEQ7kNvwEaomlP&_nc_oc=AdpUFSuYgcd_6YU2Dq3It-w8iOpREYrJiGx09h3gJtgLb1EOpCwogVLWghT2oM5lqH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9ztqwkxBGMU4-lvEgmD5sTdP4MqotiBJPJEjuBG-OgA&oe=6A7B155C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C08x0YTKASMQ7kNvwH41lWt&_nc_oc=AdoBKMoG1gNRJhL7n8Xbp5FEt-ntlWtQ8XM1XSbi5EXQt-kVovcsFL2Rv6GNMIbpnSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF19LhYMEBnzyhavDDn6qsksueClFKfcEwCBiRF84od5A&oe=6A7B118A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv7JIYzuBG0Q7kNvwEv70o0&_nc_oc=AdptdaulXQYEKaPw82JYLovezoCYW7mokV39liRIOh1vfaPfmetV2K1VKBNiw3vd7nY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl9jLHw8I1GJ6GdXEhOtAtTTKX35xldvbdtInvpUOOzQ&oe=6A7B0559"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKHc9LfMB8QQ7kNvwHD0Cxk&_nc_oc=Adp-ek6l_6Y5VRSzDN4FoI-2YmEiH2jt
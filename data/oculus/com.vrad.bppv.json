c=byQpb4pY3wwQ7kNvwFeEgpG&_nc_oc=AdqdzW0HYMRR5xlom9xgO8RbILabCz8anlH88R823xnNnhAezp1OPoN5QMrVsUY6yJ8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Asg0AAiwB6CwAQN75MAJuoT1XHyBiUcMpjPQUL-BuQg&oe=69D79E34"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9eH8XFBos0Q7kNvwF8_a5h&_nc_oc=Adrua0Dzb141tFoSRzed6U9aSZ-JtPuoKa-PcxeS7LbujaYFZRG2wiGwR-n4Sdz2WJg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OlccTXDzQpelUXvUfAuEeC7F8psnGXgK39xUTknYQ3Q&oe=69D7BC1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpts1pGx2d4Q7kNvwESiEeY&_nc_oc=Ado2Enh2KcvipNMLEaNMQuWiPNnxx-Qmn6LibYyNBe_h_VCfWe-XfWdt6cAps42WbKg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MwC-GuZQT07fT82RySPnTVX9FQJH_B-a8qqSX8WLhNw&oe=69D791A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJa5yOdHdYgQ7kNvwERPeU8&_nc_oc=AdqzZZGSYpAfMMrv9BNJJkAgUjD5rce4wG_WnRqaG14eZWeI9wcXQgpvs67UDC7Ld-Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03quSehuq8q6M4_f6KcQEXYjOPEB2qVJDEkLark23LnA&oe=69D78BB7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0rj3aWsFYkQ7kNvwES8M__&_nc_oc=AdpQmTIbg275FtyXdjindbT_MHGuWXrwV2MWJ6ua64RVbej0G1zBSyA8H79Vv4kQleI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D5t96zhNi-LN5NISRZyuEWKdeI71lEXW3oilmir_F2A&oe=69D79B5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2opsUnyiVrcQ7kNvwHHNneQ&_nc_oc=AdqecBszo45u4MWJ7yYzk180Y0LZj1UlYiQ97sKJWHqFQaUZmk2R01JbiiTWTKQUllQ&_nc_z
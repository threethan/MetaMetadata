c=QpAd-q7f_EsQ7kNvwGvua_7&_nc_oc=AdoqYGGMtX8QYj15yCUBRblS1E_EsX_7GekhVU_p6Jh_JULkPqgiVtF-hup_ktit7wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpyai4oKqbbD9D_TzuCsxuxEAXCtzS4MEBfflCrzWeeA&oe=6AF49A74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J4Aj-NhvlkQ7kNvwEIpvip&_nc_oc=Adp8RnebJy67F_LRgsbMZWWhd_dBLj9B1229G-5fSWiUEOV-L-Y6TV8k6QY1kfjop6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQgtLZt9cYUTSBSBXMPSo73A7V_1JiD80wSrPRh-7g5g&oe=6AF4801F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCLGvzUclxYQ7kNvwFVg2mp&_nc_oc=AdrFMfr1O1UqZpnb89jv2kSZjea5gVgFdhoemhl7C92a8htnN_aAk-BtTdFubSD3-uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQodF0nS-_mkvkDtiXVCY1xVwyI5DEVN5sAVKKVSgYm8A&oe=6AF48DE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJF3qbG6ZZwQ7kNvwFaYt2o&_nc_oc=AdoZf0roSpVQhrsSKjG5g4JI7tYvuOS7xuSr3Sj9jjXvGOGtd7M_gTbLpLDMJKlYnaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3h_HouZf099iBDad4-i74HasaRr5q2jUAUZwK2rn0GA&oe=6AF487F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZHz1zU-snAQ7kNvwEAYG77&_nc_oc=AdoH1RhuQzChAqcQu2TqooaGJCT7tMNU7NJcaik8lVHvNJ72oZk8YDOxmNE-HH6AB9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyMHumdBxQ5L6aHKaX3AzZl7VVMr-QKJL9k-Ip2t7NA&oe=6AF4979C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSK3TIaLdF8Q7kNvwHaAn7c&_nc_oc=Adp9xEUnMbekOVod3K_6ySjlWcO2GUfJpXCizcIbkzqUGmGGD_i2nK5hwytYEcAwiLs&_nc_z
_nc_ohc=iAwZXNtH-QcQ7kNvwHGp58S&_nc_oc=AdkND1wvapi1nAmAs1sffBjsNvobGXF484LeaEGKcjA2bjAbyeKLxHZxn7b9WY8KrUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsLpC3Of56aIY3LZH9oNxJw2cD0OvXJOOshBEDfPmsxjw&oe=69A42137"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGv4voqnulQQ7kNvwE4-XQk&_nc_oc=Adnbo4jt7t-WXqgmSzB7b0oCtWduQVdIYtoYW0l372m0l-PR0A-irdBqmIs5F-_SIBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfunCzw5I6J8ReOAUlO4otXLOXfTUk9JGb4UOTi_gTltTQ&oe=69A430DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw6EvoNO99cQ7kNvwGxL5tI&_nc_oc=Adme9b9xQpKzEMlyL86JQsu0vb5ECilWjUNEQNt6CzIpL4ccP4fxVWke9UmZpeZZTkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu4k2q9zy_GuaLdIAu_8zGr3ncAgePZn-Y9XuPqhL55fA&oe=69A42D0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QL1a5PIyEcQ7kNvwGUiH0v&_nc_oc=AdnCDvdp2eRi0kqLbJzumFaL300kDAIrYrs3QQW8Pmweb2kmeBekNSsEJJQFro29RFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftzF7jZaatiNW8aaoOFPLEGrPcYekQVMEyc_K3XFyKtYg&oe=69A420D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRQeedulVp8Q7kNvwE8P07k&_nc_oc=AdluHQKY61AVojNgh4GWoKq1qMPVHyYRvDS1SROPUBfaAJQB1u8PE7PPhSVXNCNm06A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuEY-w_NWv3N4t4mgx3i0rhtAB8TiHXcncyIKNWpEJeiw&oe=69A43ED3"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi99U_Z5zzsQ7kNvwFwOpSy&_nc_oc=Adn_GnE7jDIkf5sttQJ_m2DUQcn6AN-S-XDXESiUK
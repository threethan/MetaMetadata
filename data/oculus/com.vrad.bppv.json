wXMlFsQ7kNvwH_QcM2&_nc_oc=AdoP83nOnEFdU-t7m-aWTuG-K0ZFBjhef4Oet0lh_clDM4HQr3k0Y7k7b-XIuz38JPI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CWldBPeVVjPiYhMbY8ioGJ1gL9cpwmVsZLYB4O674Ww&oe=6A3958E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7ds0b729IQ7kNvwFnmj8Y&_nc_oc=AdrEMYXVNDUoELnGoUFysNcc_d-X5uUc0iDyjTYXUEsd5ehXN0cs7qnN0eAXEwwIFws&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SuOTntz3oelGsnoofFhx9aqhmUnTNtYnX7YQLWQKuLQ&oe=6A3952F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxBF5BBbWyIQ7kNvwHFiSdN&_nc_oc=AdrbxOr396l2PIm-sY6SrVqW1_otoi8c5ygCe0Ms6tr1Y1BuebSWfJ64XwrQb2Hdv6s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BP9N6qGpEW6TYqzf2BVmrt65CUFZjP6oCWLH7kIWxqw&oe=6A392A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kR5t1P0mOAQ7kNvwHKe_on&_nc_oc=Adq3JzGE6eLhi-Oth-t5LRl_Va6aZubhw14Xnwb6lB6-03qySsq8GiNCvMpXsPi5nkE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CY4GC3I8pnvz9XCcLokny6aLhhb_rk8-mftFEf0y3cw&oe=6A395ECA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA3o6g0B0IYQ7kNvwHt23u_&_nc_oc=Ado_VEDsOpZ2S_rDAouoGUissahU1p-PmLd80PA5eWE7I0GdjTxhQBqKheZCwaWjOsw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__UAkeKeoMsZenImv6vAKdUCorROS8BD1lCE7BD5IvSg&oe=6A395299"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM8oCK2Gu2wQ7kNvwH98Epb&_nc_oc=Ado
_oc=AdoQLSQARymYVFW6nU6pS1gjReIoruKGf2XrwcPiWDCn5FxCj3Ty_5kHBNahhvF3WRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGEZDNYZoLMWzE1xwgSFp1k2Xrm6tSbGUiXqBG11glKA&oe=6A7868A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpR-Z-CuPTgQ7kNvwHOd5bh&_nc_oc=Adrwe2XmN3162bpA_MiiSpG5Ahm29lypQctJD5eQCFY4AFEt5i3jFUl4OtxqGwY8ozs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQcGB6egUSXF0C5JK6z9h7bt180yrEONpQ0VVoXfDxUQ&oe=6A789AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y5pV83MQUUQ7kNvwFC2Nvw&_nc_oc=AdoXQsyb689EiYs93vtfxGx_SS7OMdlkrNn3lEv9ZuSMdHNGCF7q0iyI6vYp-BzuZ0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgha0HUv7MN92428mNivU-O82qQWXVOB8xPrvC27ewvA&oe=6A78725C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C08x0YTKASMQ7kNvwFmP5tY&_nc_oc=AdqGQk9opU9_OgoI5uCejdibXym4CEjzjtuk-AXqU6BiEWksa4oFy2wmA9-FimAqbdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvXKJJGBqZFoaGv2AlzxtSBF-gs8pInCkxwpW7QUrVSg&oe=6A786E8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv7JIYzuBG0Q7kNvwFD-rsz&_nc_oc=AdoD_5f2mLBknxSuBDfXZyw_gndiVD6jHHvm1ArZLDQP0LzhtEIrJtnZSQpHaHI9AWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEsbrTT84MMl6y2CbYK_NetWlU5cqIpvs_eVfkXcxLSA&oe=6A789A99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhnHkLLLDhMQ7kNvwHQqhNy&_nc_oc=AdrTTF15oExKLvVMghc95qyR0K4Y9B5U
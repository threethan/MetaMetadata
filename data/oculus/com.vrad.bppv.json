c_ohc=XKGkZ2egXgwQ7kNvwGXieo4&_nc_oc=AdoQeNc5SA0WxqhMKDdTMo45tmcBFVT7iXUDQa9VRXb4T5u0osoRgAzw_mqmTbXzhZs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSox2FVHcftTRhHCv36TY7wGw9ePIX1z2LqBaWEfJ5sA&oe=6AA93CB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EKjFQHoJ_gQ7kNvwF30yD1&_nc_oc=AdrzYAKoSNAYdpWqshuTZ6YxBGbzgov5CETG1EaOMuwlgleB-NJxnIDNdZGJfcGwWrU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXvizkNQjxQ7x_aGuhZeU1JtIWGM14zCJyp9gSMZWFAQ&oe=6AA95A9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDxTRepwvkUQ7kNvwHiIWJU&_nc_oc=AdrjZhhCLaGLFjKanGD5oJOsh1n2HQZ20ViAdbQHA2sXBDYHDBQS1_rYQN4w5g1NSO8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzgFCROBqWf-21aIEBkKVGm5Tbw32H3xiksosGkTc4PA&oe=6AA96864"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACg-chLm3EgQ7kNvwHiNwa6&_nc_oc=Adpfx_tQQCfll2Hj9hWwi_KrGhSgSwCj3f9mV1B4ifdo7qNZT9HgQsN_1-oKnLd63zo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_9p2QMDyi6F7bACswoCXHOJFUdiDokCCFWZ5u0RFw-Q&oe=6AA96277"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy_VwNP7H7sQ7kNvwENgb3v&_nc_oc=AdrkeT3J0XQPKNT6OK8FT459m2qxz2vJIbOToq-A3-hsEMm7WIySW3b5xH7lNytgakw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLz4Fjlc7HOyLLhiERcVsB2WATrb-jsHACjMknh1_kig&oe=6AA939DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEDroFfgSgcQ7kNvwGrxe27&_nc_oc=AdowgCbRRmCOMTfDsqhAVZnGV5FSsu3dW1CxX88F2NEJqmSc2Dmr3aFSoNShmxX5V
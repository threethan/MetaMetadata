_oc=AdrFMfr1O1UqZpnb89jv2kSZjea5gVgFdhoemhl7C92a8htnN_aAk-BtTdFubSD3-uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQodF0nS-_mkvkDtiXVCY1xVwyI5DEVN5sAVKKVSgYm8A&oe=6AF48DE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJF3qbG6ZZwQ7kNvwFaYt2o&_nc_oc=AdoZf0roSpVQhrsSKjG5g4JI7tYvuOS7xuSr3Sj9jjXvGOGtd7M_gTbLpLDMJKlYnaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3h_HouZf099iBDad4-i74HasaRr5q2jUAUZwK2rn0GA&oe=6AF487F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZHz1zU-snAQ7kNvwEAYG77&_nc_oc=AdoH1RhuQzChAqcQu2TqooaGJCT7tMNU7NJcaik8lVHvNJ72oZk8YDOxmNE-HH6AB9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyMHumdBxQ5L6aHKaX3AzZl7VVMr-QKJL9k-Ip2t7NA&oe=6AF4979C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSK3TIaLdF8Q7kNvwHaAn7c&_nc_oc=Adp9xEUnMbekOVod3K_6ySjlWcO2GUfJpXCizcIbkzqUGmGGD_i2nK5hwytYEcAwiLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQflAQinidhqUOPxwykh5Yi72Y7TuG2DtsauuDbymlObw&oe=6AF493CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2nnRotlDjkQ7kNvwHz1WK_&_nc_oc=Adpgo0wDzK0NuvUgSx0UpgAgHOlhDto7WPEy_O4_6lPyGg5786UrjucwLefwtREyCoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEN6ML1d22bkJhSDAluWz-h_jbEkjEh2DVsXGI_74kvA&oe=6AF48799"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_DDFM9Y_IcQ7kNvwGeCoPF&_nc_oc=AdqknmIxyToHyvl2gmT2ipEOQekEHqXo
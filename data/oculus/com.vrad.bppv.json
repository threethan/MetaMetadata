c=3kgeSCbXYWwQ7kNvwEQAU5S&_nc_oc=AdqLNI84odpKSqTdueWcaZy68Pc049IQMbNL2mM-MbCdG0G72kJqDEPxhY9NEYZt13g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCs8dx9UlSneTpSbxKB9jFvPSAPkNq_DNMi0b0hcIV2Q&oe=69D106B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTAzYCABUToQ7kNvwEETmT3&_nc_oc=AdoOCual4uzbclPLUeAeS5zw83No8KiRwPETcc12NZFurxMqqLYJO8idhacX8scSIso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe6r6W-1XO-dEJDH-gBJ4449skuM9Smp9qFipnd8wK-w&oe=69D1249F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q95poj2YycQ7kNvwH6IyH-&_nc_oc=AdrMMNAo4Ib3-u8Cml2EzHvjW-mt7jvAHPmG4RKv2Retv6I4EUbp_r5LX5uJRQ-eE28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzF7jwoLxsaecCzrqPc-Fy3fgurUOvyCmvhqJNOya8prw&oe=69D0FA24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgRLydnFnqMQ7kNvwHq_ez2&_nc_oc=AdraU9KJQ1TiMf7SJBAr-2KnbWU4JTMFTTb_Jh4CJWgjqj1QS0aS6ekD_YL6tjOos54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr3x3-TwOamR8u-wKr7SAy5URAqzBFrjx_IjYXLumzDQ&oe=69D0F437"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZC_VVAsTwgQ7kNvwHZBeZ6&_nc_oc=AdrWAOBn6h3rNGnVJt3ajhjS3QJdfGCBXRP6xD_Toq9b0rXfOvx148Zf2cFL4nYMw3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2sVOFQLceLJmVcYQpT-wLYYya6hWcA_jFQLT2H24AGA&oe=69D103DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnAxbSjfQwQ7kNvwFerlrZ&_nc_oc=Ado3XVi-euC_ApLd1y9ywXxJpJzhVAh5pTDHWAjQiagyHuo12YSvWzwciDq-26k3gUU&_nc_z
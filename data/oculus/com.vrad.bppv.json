c=Svh74dYx3ncQ7kNvwHDODhf&_nc_oc=Adr-MzMkRlaHqr4ddXizw93JqDqcd40BSHA58MSJLGtBWaPDMkBerutZ1tzkE1YXqmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xsjtGql146tDSMVN3nn2PnFut1DhlEv1J35ZxnAW4Tw&oe=6A2D4FB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKVz45Ry0x8Q7kNvwGHZB5p&_nc_oc=Adp3w8vEG7LGSk_3s4FutSzwybGlUKAFC66W34JmkD3QzaRYwVXgPW9E_a2CAijZy5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6H62b0tH-x3VfMGW1XL4xHWjCdDHFg0Z0vv_wpFsWrw&oe=6A2D6D9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaSojlWXH6YQ7kNvwF9Rr0G&_nc_oc=AdrJ3xE_4NdpL1FXIRv3kWc6pl-Ry1jTed5FU2h-F2m4IdwOgxFIkySqZ-o1AnVg-Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SJekqBYozhznmDUr4jOiLkHzgwQQu497rV1YODdj_5g&oe=6A2D7B64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGDcdq8jzvoQ7kNvwFHtxlY&_nc_oc=Adrag7F50hFI3I9GB7zFLT1iFWrNgDde_udm265yt_RSuCwncPXhCj6JaTk18HYVgeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kpvJSaHlLOd9-eAWVtkw3V48A3QHIakB8RBBFl4-BQg&oe=6A2D7577"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xArxd4M7IQMQ7kNvwHYkj20&_nc_oc=Adrwx94vlJ-uNgHQTTgljYJ3c_nLIyOMLSDRzeOdrhXY04NCm6EY2WbX6XK_2t_YH74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUwcRrx0q9vuDpZi9UXHV2jEyb1GiwOFaiw1Dt1kw2A&oe=6A2D4CDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGonfHIFfVYQ7kNvwF0lMUQ&_nc_oc=AdqDlfDTks9BFfBkgoPGa2ZXnehNOVcF0y6IKCcncQXZPNPzjQgGQ9quWuaIOPjZiTQ&_nc_z
c=PZVSEh6KhdYQ7kNvwFDvVTP&_nc_oc=Adr2z-NpAW_8NWf08L2HvihGCPbAaHKOYlMWn9GRiqJJU9q7TkOC50Lg7mjT0iV3pEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZA_sUkRZBSku_EMTCq5nBMBf_T6GhOMQb6pvY-7UJIQ&oe=6AE76B74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUIaGhV52Y8Q7kNvwEwBGEi&_nc_oc=AdrwF0jHcL2YgaIl2_iviMpZJmT7JkrR76IldzsWYEepgYyDgjl0cQDxMwlqqI9va9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXHcbgx1v9gRCztTD9rIgJ-NsuSAKxp0Q9pdaxFG6qQw&oe=6AE7511F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1IB4VfykPcQ7kNvwEfevJG&_nc_oc=Adq0rcpLTD-HNFpPfcz0IAr8Mb2nXEvAkAuyV111oV3ZGrKAiedsyoYem30JFlrll4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhyifdioQapl1KP5muNpoNuWeVfTT9OxybOQUaKMX9HQ&oe=6AE75EE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9VKSCNYC_sQ7kNvwGS5oNu&_nc_oc=Adpz3kulESsSVM4qF6WviyFzgH0OWWvwXHdKyl-KGtyUVL4q9psWSpe6zfjqoaTmRLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgUDNXADnrfhxiyF7OEgoDXO3kupbm4Z6Kqd2I8ek9kQ&oe=6AE758F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn_4LbCLPBoQ7kNvwFc_JJE&_nc_oc=Adq0VbjKpP888BLTfDvxE0GzuV_Yv8pcNdNCWZhCzgr9ZDU2FfRMV5U1K00jKbWJLhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnpVinkG8NqykrbYse17ywOmSUEPeGvUX0fOlNfTtdZg&oe=6AE7689C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-J1PaRrFwoQ7kNvwGSmkeL&_nc_oc=AdoH9HfEmSfFhRFBIhzchzJi24h20y0Np0-46kFv8hGhoiRUVT2l4vFGtCpNS_dKMpI&_nc_z
_oc=AdqY46oS_9cOFi3HQrCcKJ2Jf2hiR_C1iB_GyKoaqU92-IVYyBZ46qjJL5dhRuIsh9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcPWdmPNtaDbcIEhC6zXjM5KewPIQwZPkAD9TuOfH3UQ&oe=6A61FF24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrAkRHXx_yUQ7kNvwFYbdYh&_nc_oc=AdoJaOFUbhu3f1kn_paCrzLeodzP0obnX0mSA2-CRgZI04Xf6JvOyslBtr6cfIxftbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCVopTQe9CqHqkcw2N_hSUmU3iQ4_LZ-A1NH9d8X44qQ&oe=6A623177"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZjavaNoccsQ7kNvwGkmvEQ&_nc_oc=AdpJAhKg1qlxKc9FG8Z3eyTIexx7a47zJpF9OwLklaWsHpyrMQUpzzqtYM6rSmSunHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsmorOkYqt_GOQVvKxoIwaI6LoVc9QyuyOlpMBFNylYw&oe=6A6208DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxUsZCT9NAIQ7kNvwF3oxZ5&_nc_oc=AdqfLKETMAkp6CI_engBmlO2-udc5S9xxf3d4ZmNetC1muzRyFQPrBN3PUpgiswJ8qs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXW-uahzZgw-BXokCkSBvW10eB7g8r0YnCrZDmyHvyVA&oe=6A62050A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4eFrRjCXcQ7kNvwGaBd66&_nc_oc=AdoyWxd5rh6W-X7vWD-bOn2BP0c8GhWRQRiOYI4uekspPFiVCdOOYLmxZDVpv7u-8TE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-AoUeD1DxhCBre7uSJKnjQ0r3XQ_ahBa1K7HQHvj7tA&oe=6A623119"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bIUyMMVw6QQ7kNvwHCjEtX&_nc_oc=Adr0NWnLhulocmMPtE93BKd8M6lXaHMj
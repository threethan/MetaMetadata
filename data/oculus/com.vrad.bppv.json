_oc=AdrSWQdV7j2uFI_rDmFMbKl5HCGE87ZkCeny0qFohWUZm55ex4kgDLZMleveqaKjwiw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_D3-nGPVu1rBf-m_TzsNvlMZtY7mkpct48k3Y33Blsw&oe=6AAD5CE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cFaAFcnBzUQ7kNvwH9hlNI&_nc_oc=AdpXgCYfCgkeVpwvd2FGT93Kn2lA7WzqM6CyyNMjZpIret19eTTuTHpgH7myfOMC1TA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rLn-ugPsxVQ5LCxEylXpD-_Uy054o24rzSCrOP16iw&oe=6AAD56F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC1-Mb_xBT4Q7kNvwFKTdhv&_nc_oc=Adp_Tn3vrDtzWcgCrPqCf59yl5WVUUwYwA509L8bds-08foOqIbCOINxV510hoBbqRk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfJw8R0g7T8YsrCGArGbcPmX95iYiGhKPlwArfVUZOZg&oe=6AAD2E5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YF73D_1q-MQ7kNvwGG6rUF&_nc_oc=AdoK7Bdh9n-ggoiv5liObXewXGzH-ZJmLMu9fC4vzPI8qn3i9NB3ku3uBvOHwgLlCcM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZOC-L9oxjCAdV6Ow_DWzU20Kx2mX0R4OCFJv19IaISQ&oe=6AAD62CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afbHsdTwdLEQ7kNvwFDmCmK&_nc_oc=AdoVr6SpP0pafBsKoy6bCDTv9VS9svHArIBH65FJHkdfH3s-UZ4v5TRZqqEgbZZ0eYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmN8zteqegeAJ_qlOkQx1HQvPSOJtBE7u9TVVpKMB4gg&oe=6AAD5699"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeNr7v3LvsIQ7kNvwE6wm_A&_nc_oc=AdrvdgkPddP75uQjEkBGneQyFwE0zuP5
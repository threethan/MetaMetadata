=8&oh=00_Afz98nAAGKUuyDB7TXkPbIUlslQcuKWwhblEJkJaimb4oA&oe=69B15624"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD1xwnWDKpgQ7kNvwGRajCr&_nc_oc=AdmUaEmBfyn5x0AStjRqGPHpq5yqLIPIRUbPHaxqVnsx3DMTPtALjxo1Muz-DW9rLXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMWJ1jGr7LL2t4NxHiLxQzzEUri7-mttPriXdURfZCAw&oe=69B15037"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe48OaUYe_sQ7kNvwEGJAE5&_nc_oc=Adn-Xx1trG9oK2_TDbzeepZ8lPy58dTCNU6WmzMlKZ2x2XwD8k2fUlqGEvbOFM7f43U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBNoQPFteiBO5MRK3Df4WApZCqUxE0MlvGP1uXHSuSng&oe=69B15FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFJWO-8DWSgQ7kNvwFez4Tv&_nc_oc=Adl-L9mHCzf6YKNMMaol_HCI-VV3VYHTmgOGO1C0q32ojmBTUY09Mtdcqf1FWsafcDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrQgFYtCruEbLcdPqdvEFaCdXZv5LtXsxrp4d0KvNN7A&oe=69B15C0A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sspax-ZWb1MQ7kNvwGUQOdr&_nc_oc=AdlZ1NW7yqMDACAuzDlqrZCEMRxQzzW9X1GFCVVm7Fl0A1fLi7Tr00VUfTSR9edKa6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf0631F2pJzZ_kpPGsvnW_-RmXXNBYSYtpjFlm54SVtA&oe=69B14FD9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDGgx-USz24Q7kNvwE_LVKi&_nc_oc=AdlDhiAN8sW7JFgupz3vE2SOUA-Gn5454A_gaYDCk4z7kG4vMfh_W25d69FPrw3ds6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCudSA9HjGlXRHjTjc_RthS_OSjNIF3iXB7v6xOnd_mQ&
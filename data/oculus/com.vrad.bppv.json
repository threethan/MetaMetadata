_oc=AdrFYz94t7uc3EXRrS4_wBCCqt7rbUobnSyiRiyaIRq2EOSRa-ETcgmBgyxqh-YPblk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDe64dQA8PSHD8HYTSvQsLytb-XiWQMt3dx0DL2WmqTA&oe=6AC66964"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOvaHD6pYYQ7kNvwGJG48c&_nc_oc=Adp_b7EPy-Bpviz-ruGE4K7gLM5z1gmpa7dfip7aaqV0eHmnQ70DcWBj4lb_snBnPh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv98TOHQfBrry3AutIYktLRw0-yh2enzKbtBtndLoGVA&oe=6AC66377"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqb3mNUgRQIQ7kNvwFaB5k5&_nc_oc=AdpUDLaZrwx21nVNsakQS7tbkzXTWHZR5BEH-yXJtzHFSjtzA1uFAjaHDJTJL1ltXjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIUl1aHe79fpWlp0eUKp8wbkq3YXzpIcknSurVkFmEKA&oe=6AC6731C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfS8UCit1sQ7kNvwEkAFtu&_nc_oc=Adqh9E2_Elq5YfCYMAXXPJWTzoTDj8GQuUg3lgYQRJzBMS-7rgU04c8CnsagsUTEFJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1m0dDKGDWs8-H8XFPIXs6fFaWndxJx7wSYMJlH00XvA&oe=6AC66F4A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0dUKVIaSdsQ7kNvwF14we4&_nc_oc=Adpn8emw4e94vCgBHj3BOk7a1cdZgvvMQktNx9KtZQ2vW9JhgG4KjASTX1ri9A8DiPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzOFgz-DDfAs2-uuPOgzaCbm5aHqc2MZcYuW4gm3ky5w&oe=6AC66319"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMbYRDIIYvYQ7kNvwF-oW5P&_nc_oc=AdqmgLtgQLrhGCXRMU0MhJYIscqt7Eno
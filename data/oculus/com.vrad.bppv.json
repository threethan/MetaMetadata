_oc=Adp4yh4ykzynpR6mc2TCa1z9XHTdDs6NhybMdMCqzPckdR4MTFCef2yVadHKWY7WjLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCunjlXB0NMhL6Eg5x5XlIZTNtw9TVIbRHqiHTYbV5pCA&oe=6A6B39A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwrbkeG1gzgQ7kNvwF3reta&_nc_oc=Adod-QzphBJA9aYyrTDcpQy918C13HRW5xqcz6s2U9cMpC95JPUG_bw67L2cuUGRAj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT6c4-AtCJCtu3CuI2_H7d97HmEVSfKJEXZj1GGrHjtA&oe=6A6B6BF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5cnmwrrnQQ7kNvwH1lP86&_nc_oc=AdoglXZhRJmLFdOLNTvTjH26sVZVQIhGo6ddrgbWdUE_GEkYJ2qMpLncqfwNpASblOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEIz-Iu9iAplyfzQQgCnJqAAmtn-u23ZFAohJ6tSNqEA&oe=6A6B435C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP9jAs9Ep4Q7kNvwEzXbsX&_nc_oc=AdqMwpnpGIV3BjDX0g3j7QrxWeMoBoaFGp0Rz-8eJqOFP8LaE3lPFAEpjI_u82fMUxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdX8h99TRvaPY_tPNfyVEbWURyT_ePdHlrlcapRYs0ng&oe=6A6B3F8A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFyDIPlwC8AQ7kNvwGal4Pb&_nc_oc=Adowi77EJNQfI7pxwg_Usmx-rSbyW5hQ7mvMLa0ZbzhswTnnwS06QFAAlE1rskQzVbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWxZ8-UmL97wqLap4mh5aqv7ca_w3q-1c0xEXCSATELQ&oe=6A6B6B99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEt6eLhKKmoQ7kNvwHaCmBc&_nc_oc=Adq0zXI_hPELAhvwS8qA5ySipdsU6eoL
_oc=AdoFwo-E-I511ougsuSciYTbUlXiTH8eBi5cFJFxcORoiR_sDNqczaQnEXGY8kfBlDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEuJTsBiAOCKM4bU3bdoyGj8Q5sw_BfLozdiMckHJcpw&oe=6A8C2F24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbdDXoHThKMQ7kNvwE8Ix0H&_nc_oc=Ado0_9WxRG0GJiyRLRTccucnOp_zolCWjsSOVYASTplr7GTceojPtSsPBOfg_mv4Wy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM4_COmr2GEQCnjWZ_Guk72080xcI8gwrWDvweC4-r9A&oe=6A8C2937"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81MVu456kncQ7kNvwGp3c2i&_nc_oc=AdqcxTOpALysBULXQx_gpvf-NeQ45OPWjCKzR3vN68spgX6t7JZbsr6uCimuFfTd1ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv3KyGBfW_h-d1JMh4UW9eJUWoketJuaTVsr_1-euQTA&oe=6A8C38DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1aQfBC-pl0Q7kNvwEGVaxh&_nc_oc=Adp-P19nKgbJAvTLl9VTCe6GYndNT6M5G5-a-7j8Pop1jEj5U6lyMgbnl8pPSzoMxIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8pZO3KhtKvSDaqOXh6DGeU-f5Yt0V2LXA-IkccB5CvQ&oe=6A8C350A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P49NtEy3c-QQ7kNvwFA-FjH&_nc_oc=AdpOFccDnW8D2eFUP_Qlcy00sdbFDrLHffZTtZWw4-yn2Ytn6mHyiYMMkt98NePcbQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkeZmnZITHCKj8ze4n_HtQN3unUJuTAhOssTUq_Y2pvQ&oe=6A8C28D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQA5B1aGLXgQ7kNvwETK1we&_nc_oc=AdrKIUofgKlsZiFgdduzl5l1jxLnvbJs
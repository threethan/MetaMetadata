c=mM7_T70w0V0Q7kNvwGduAOc&_nc_oc=AdoXli2hGwiuPZh6nhK0w8plefPN9D7UMdFhHtPJnBdpatUyQ42TOgm92q3_Cnn_BGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW__K0r9pbjjujw12-Hq8tujNNeDHszy3X3oABywzQHA&oe=6A9EB0B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wER697sKZnUQ7kNvwGvj2nv&_nc_oc=AdoOh_DCGnwm78tbP108U5FCtIcLAXgP9mgJ4YsgFFOAn6Rwfwy7WX_hUgi2hideks0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTzkxW3giwwg_k2f4Dtvlgs_xTiE5VVRjHTz9T-puaUw&oe=6A9ECE9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-zg74T8GPYQ7kNvwGIrYzb&_nc_oc=Adp4KVcgBb-BBEHQ1zbXCrbXo58zs8VR8hbhCMWqO_-ZWLTzQYba-3Yg_xf5THSGj8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTKFEPV7bAC94Sx-670cLhUZEHVxJ29tRrJ3k0gL2oFg&oe=6A9EDC64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzCYc1i0moQ7kNvwFbX9QB&_nc_oc=AdqmQgEQyWP78mPAru4Hc0Dev3B2I-TC0CTmNZeclEJCT1fI9KUa6gkppE9SggbDa5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGBaZOyst66jJuPDoOAN5qoxhgRPYZf06675zbvnZ2pg&oe=6A9ED677"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGDfRDJgh5gQ7kNvwGJakUc&_nc_oc=Adp5dQS0X_4IsZsu0dtv4parnJdd8_dHekds7Qp48M4EtQVLZfrO6lBQAqRG9Vif9_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqHrsWxA8bwGWxfBwiSEFbXIArVs_502DLDjJu_NgnqQ&oe=6A9EADDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KJ3FtoO1wwQ7kNvwEQRAUR&_nc_oc=AdrWSBEgLacRpYK1I_x_5HoMQEhtwUxHRPd1qsafDoyHvVwDhdDUPCp45oilgH5tX7o&_nc_z
c=KTNf9hjYmzQQ7kNvwG9yIFX&_nc_oc=AdoeraX7T471EcfKupAsJo7ZCxrsag2yiGcOPkC4RINCYay9PrBw4rCWOt2SclD0VmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe3IrOSX6R6ZhRwIGYA9asvRiUfHWPXSs3aD8IzfU2wg&oe=6A6C97B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdMWqKY9FzEQ7kNvwGrSXEN&_nc_oc=AdpBYRCpQmdMF_zMH153Do1v-8X78h6Zh86l_Tvh4A7lDpG_qCBtzNjlE_yHNvx27Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyB7I4mWni5l-kMf6mkkDAiQsAUJa1CiymYJr-ttMIVg&oe=6A6CB59F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yYp-3iRbuoQ7kNvwHaII8l&_nc_oc=AdrcCYaDJc1AqcJi9tbS-pKydDmTDMACCjCE6LGLXUPB-ymrqnXv5eeSFVVK6WZn75k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGUz4bsQV0ZtZWU91boITBxsmK_XBwoLPHbdavrrxo9w&oe=6A6C8B24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NlR6emWkckQ7kNvwESc8pK&_nc_oc=Adp1A8OpeZUQAW0JwT_x98U5imTVLm4nXjdjC6mcjnNCp__q1kIOwmovn3xuyrWBprE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVHyIUtH2H7HwdnQ2gA79mlqanUAQ-99_BW8UE9_W78Q&oe=6A6CBD77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5cnmwrrnQQ7kNvwGjCoh9&_nc_oc=AdpfEmyPPZ8WrlK8JYbg9nPRh-VrGWP-v3_xmlfcDpfjagmwA7MDC52d39_MzA5_jUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsWjNy4XX5LE_djOquOV-5tKU361R3JFULOh_bX-YCBQ&oe=6A6C94DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ8RwSkM_P0Q7kNvwHR1QNI&_nc_oc=AdrAkkQVtUJ36rOLanAmmii-wbokNN3ZjJxJ0Nt6nxFn_pGfh0Db3InDdoO2iIjvsmY&_nc_z
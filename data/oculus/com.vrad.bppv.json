_oc=AdqIT3JpWWB_zg_mMmvBRn3CqrawDpXUpJzZ5a31l4bHAfWnaoL0MBmNSzHana3DRxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAuwPyi7mwGEbXaZflETBZ2VlfwrQfXqfWLaQaxhGlMg&oe=6ACD00E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpz3B0EsCPIQ7kNvwEMOYgl&_nc_oc=Adr-4vlXJBvTLnL79ejcGyDyufhjrEk1YIERiY8xFpmZSb9n1cE1HHdUFi8xPqncUJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3rVbjOAMQbpuRtswGsjluZNgiRyr4WTEx-W0hOU5vBw&oe=6ACCFAF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0akeJLmcmUQ7kNvwEDrsNv&_nc_oc=Adpym5n8ra2JVD8hnj23zje5TUlPoslaNudhpOg4DR4Tap6fvWV36fOIrP0M9iEzgCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2a0MAcDiRK6sAKyqtNkiJxAsh-UTdCMetrsv5blAVaQ&oe=6ACD0A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j_z7qXttUYQ7kNvwFMHLXX&_nc_oc=AdoizNVisU-FKl9Kl8zUbBI_yGvpXPNHQ9uiS4cpFxszQbOOdSd-KjHft37847OCSfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzNkd4jgEZ7gxwPUJ6G2Ub4r-xX45SCV9sELSU9GqccA&oe=6ACD06CA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyURXxFzat8Q7kNvwEi0ks5&_nc_oc=Adp-nHjOFss7ssgUcwHc0lU4O3Lj9PfkY-OyoEZNGY7u3FO4HN4VMDgXPPpx44S_nf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU3FLn5PI7sLzxYYBjPmrKhAIUBYP3mQmDYGkDtHccSg&oe=6ACCFA99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqaWDeY8DSkQ7kNvwEYUyLR&_nc_oc=AdrfgGxV4i0CltuOIv43Ofo6w446lwBI
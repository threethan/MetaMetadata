c=TuJPrYK7PfkQ7kNvwHKSWRz&_nc_oc=AdoEJ3SyGIUzLmYSxYMhRblAt_0H-_MESbfOmkHQz2r3l_EF3ZkmkHUnC6a6NwvvZE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A3XRjnbSGI_dwRpQuB_ZH28c2BdZR6UJXEljm6FPQ4Q&oe=6A3BD034"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtkwj1d92MkQ7kNvwEDCTxQ&_nc_oc=AdrIwofvVxDUZobaMi13lV9wp7BOnb8KTHJYvqrqZz7ONWY0LVDwjU2gCrvw1jqkeHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mi0htCy2BkcMpwkDnFId3mA2WNSilyVwFaxXUavKJeQ&oe=6A3BEE1F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odht6nyjcBgQ7kNvwFNdt3S&_nc_oc=Adrme77H8G_aN7EW1mW_wAAWMFub8zp_k9IDfEp7gRclGzxNRS9ZUbnESKszux8BCkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GRN9ziDbXAlUoQagoQXbQ6an7sGZY-vzqYv6CAHmOcA&oe=6A3BFBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7ds0b729IQ7kNvwFNjCJf&_nc_oc=AdqR0AoE12Zu9m1Qih1FxGLOQdA-wyFByTbN-u9kBeUx1wP_LHJCaKDfPSfF8WSmfvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83ZcuaEWTPsCPEX1eXIpA-K3FrZv95Q-Us5uqTve2_1Q&oe=6A3BF5F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZriON_SVfcQQ7kNvwGL245p&_nc_oc=Adr6Q4Js911Kp3U0sh7_IlvUE30AbLGNsTVtHTsNkPQy8TCqoEDw5EOfKn7tcjhUVhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PRciER_BUv6jNuqPF3K6sVzzOQaNcP_pDQm3X_dpSBg&oe=6A3BCD5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kR5t1P0mOAQ7kNvwEp7s_r&_nc_oc=AdoLJABjQlq24WFxV63xV2BmS4YpeHQUhJ4opDv9151tsbFt4lAyIL09RU7BFOEiX9w&_nc_z
V&_nc_oc=Adm1FyM8pPfR_TwG1N_Up2KcsCCBRq0JUNlCxpFA-RbWvtWZrf3zQqpGO46Mktw6KpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0fERoqs-jsnQFJt8_51k9QWw_Zr020nVPeAtkkcdQrQ&oe=69AC1CB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIjMkGksh9cQ7kNvwFffvFD&_nc_oc=Adn3XTeAXOCqIJ6ATS_f7Hio_zYBkwWnE2MyS_j6kfY42cCf4J7ohHvyu7J2nyTp_DY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1S41WNSc_WTAFwVbaKrH4ORGPqtYyXJC3U8GF3luMJg&oe=69AC025F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o9SCnzb1LYQ7kNvwEDCOl7&_nc_oc=AdkXI-jMQ3Vli9LyPSPtUEFUJsIRIc0Z7RGgOmqBsJ1zSXhUlRrLMPx85QhfBN9LELY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfySJeHf99hJRj1JxJk87xLIl7gNEyVCk8ZF-WBhJQzrtQ&oe=69AC1024"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyDQfJn8xocQ7kNvwH15ydC&_nc_oc=AdkCiHZFfUwfWHPfKdvQbWmJ42o62Tj7rJ-Wl5THCA6oNexuQ17WriYq3pUbv-y9504&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ9Xkkqq6WlzsmD6maz0j5677qEvJd-DYwGH2mn7_Qaw&oe=69AC0A37"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf641z6pGRIQ7kNvwGuCWcO&_nc_oc=AdnXOFwexS_X_CvDHSvSaURePb51IOpy3uypWYlyq3_VnYXGs-x2ZwWrS6jj3yChVT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnHFWNsN2NMaLXUHOTIM3RJklivcp0EUNhO-SUBvjAAg&oe=69AC19DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziSxhl-N5lQQ7kNvwG84V7X&_nc_oc=AdlQfj_Rnq2rYQZKuLDMgBhyA2Y-IVsab6FwyRaxtGnKcC2mTh4islwXaFpgpj8r2Uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc
=8&oh=00_AfywvWn4kWydyNgjf24Hm6jruSj7XeUkjIh_bvEoeZ4IJA&oe=69B69C24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVWAXCC04RIQ7kNvwF9n-9G&_nc_oc=AdkysbOf1XKQFxDjYKjuBgJN-D8XoQYqMDEif9xXQ3_c9z3tnOh86ZWVRwGX8h4B154&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMPk_rhTyaVQF9zBuM76i964aQl32twX2qFkAFjkYsxw&oe=69B69637"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwEiW0o6&_nc_oc=Adnh1aEKr2M1Yp-2GDHOF3THUdzGPB9wISswoW1dL9bk5D_hGv7ums8Euob-wouz7Yg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-wWN9hRWA2_uXS9Li4KzOOQqJFBKZIgIYqDeKBEFnEg&oe=69B6A5DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6WS7rWJmDIQ7kNvwGdo2sJ&_nc_oc=AdkVrs13VkaySnmAFDkg5S1lz_WSkWiF79NJeSlGsrasC5HoKCliHgFSMSrCZqnKPBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiUEafemYdG52CBlME585T4ozvCB1s0l3zh6XAvh0r6g&oe=69B6A20A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uMnymzW_UIQ7kNvwGwvvpu&_nc_oc=AdlcX_eJjQXRIfK9xXL3QhFTABoF_J6_YoOXWErdUTAoO1qSDRNZdKA_iPqNdxbJHhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1V43lwEy-EUKoeht1iSlQ3Nyv0An4rfSQJ28Ur4GvbA&oe=69B695D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA1V6BobtvUQ7kNvwHErRUc&_nc_oc=AdlzayMzEu3McauuIUqjEZTaPpFOVbpFOA9w3VHRo2fErRn8ts34dQbSdkt6ts9C1rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUF4ZrQX0TNDjLoUIOAOTUsYOaES_BxMe6pvnpXRMUyg&
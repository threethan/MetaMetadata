_oc=Adrme77H8G_aN7EW1mW_wAAWMFub8zp_k9IDfEp7gRclGzxNRS9ZUbnESKszux8BCkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GRN9ziDbXAlUoQagoQXbQ6an7sGZY-vzqYv6CAHmOcA&oe=6A3BFBE4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE7ds0b729IQ7kNvwFNjCJf&_nc_oc=AdqR0AoE12Zu9m1Qih1FxGLOQdA-wyFByTbN-u9kBeUx1wP_LHJCaKDfPSfF8WSmfvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83ZcuaEWTPsCPEX1eXIpA-K3FrZv95Q-Us5uqTve2_1Q&oe=6A3BF5F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZriON_SVfcQQ7kNvwGL245p&_nc_oc=Adr6Q4Js911Kp3U0sh7_IlvUE30AbLGNsTVtHTsNkPQy8TCqoEDw5EOfKn7tcjhUVhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PRciER_BUv6jNuqPF3K6sVzzOQaNcP_pDQm3X_dpSBg&oe=6A3BCD5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kR5t1P0mOAQ7kNvwEp7s_r&_nc_oc=AdoLJABjQlq24WFxV63xV2BmS4YpeHQUhJ4opDv9151tsbFt4lAyIL09RU7BFOEiX9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nrtep9K6IkXGK3yNOMVYSB5SgvQf8R0tzdzTqWRcZ-w&oe=6A3BC98A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA3o6g0B0IYQ7kNvwHDzgQo&_nc_oc=Adqmn6IhOUXZSagDDzA0-MTZusHcOvfS5-1ev1VX3z-YslXsKqcBYheRC0dx6PqKEoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NZjT1NwCERAZ-V8F6rxHGIST_XFALyd8PfPG81STjlQ&oe=6A3BF599"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OehubIb8ukYQ7kNvwFi0T3H&_nc_oc=AdqcRMnH4vSLwgE5YkimPiIkFsTtdknK
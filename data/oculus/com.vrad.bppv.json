_oc=Adom_mjn_1fwvNhhMxnaxC8TIkZSox5Ef5LQpk0xSwgqIl0EJ-wCm1rxklzeqk1aWEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SVVza4hN2eDwfFRuHA8t1B89yLoLGQJXFz8vy06Mz4Q&oe=6A01C1A4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhI9F5_mcuAQ7kNvwGW1l35&_nc_oc=AdqnvlK8i9bSt2SNxemegamrgZZ70iOdc3XjlLl5hf5DMEt6vKbLnw98vwNzYxf07eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k7eXHzBd_Low8E88Zoqjl0vqJvMWI50i4yCkZaUZxgA&oe=6A01F3F7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rygB2GntLo4Q7kNvwHwtt_F&_nc_oc=AdoN-w0pRIzoCLLFWQnbu88SQUdG4P0susUF3uKjRij03owiGKpcKPFZ6m8NaN2WdCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-q40yPrEYn4AXwRLQXs7ujfx_jrmol0pOTlTLlzKRcw&oe=6A01CB5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IniaMyQfd-gQ7kNvwEW9jMi&_nc_oc=AdrDV1bqZHQAysjdavNKjTr0oV8bfbOldxNYGhXu4lmfi-WOa_RxEcM2ynInVfJ5HrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60lhue58-MKg0bt6N6_08UVTHwYaqkntKnPZnsKiTkVQ&oe=6A01C78A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJoqNnJueXQQ7kNvwFH4sDF&_nc_oc=AdqXSt4vs0_xOCm9j1aGyyHqiyvHOauztZ0tC6rbLd5DRFSOx6rfK5qJDUKHU8Gwyhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h8t5lEz-Wo3aHimoFIcIE6KNFq2_Q-xx1-Sect6xo-w&oe=6A01F399"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3SFI6TGIpEQ7kNvwHgG9pJ&_nc_oc=Adp7NCl0kk5Goc5C4j5mt7McOV7nryyt
y&_nc_oc=AdmhiMYWEo_gbVVccV1hn3A8aEv6y_1jBjJM-CvycZGfKmVgEwg8mEwAT0zMHpIv2P4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWrwVkcVKoKdsZnGzGKZ0cFeeMLlBAjG_ryjSjrPnA_Q&oe=69B405B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWK5zCSVdoMQ7kNvwFXbEPA&_nc_oc=Adn1_3JIo2HDdn6SQWo4-QLBMAZFyIkI8nL6OKi9cd7L3z5ik90uyL6Mq6jw8kYTC4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVFOhNdwHcyYFGB7o2ktj-OsQxaLpDjh25LTzFxLhUrw&oe=69B3EB5F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_V8YwlBNjwQ7kNvwEMcEB2&_nc_oc=AdmjVqpguC04OKbrnbm8VcDFAhpF0OM3B9Z2lcZyxOD9sz37H03YG7cKNOXY0pLq4Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8JB3u6SJDGH_3lK7bUY_wbKv3pIeeBq7a9WELefHcHQ&oe=69B3F924"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vvPqOv7k9kQ7kNvwE_hxuw&_nc_oc=Adl_qKqJdQ4JD6clr6EwRAfD45dI7iqLd33CUjBRBN3N71CbSMl7IB-ROpIoeSJrZBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzYdJ3ur0Oj7iP0gGzoaWqW5S5GYUhrnYZN91ApR2Jxg&oe=69B3F337"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IamqC4Uex2IQ7kNvwEFgUnB&_nc_oc=AdnPRiFS3uWZAy3REaUUePXHr_EZioVH5tfNSV_ccDspNqUK883NsWDpOP5MWRxWT_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmSozm5KE2imItUKtZZpOFlF2OlOAWlfFJlgT3Db01Fw&oe=69B402DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3jQkRW3jSoQ7kNvwFa5--2&_nc_oc=AdnCSA4YjpxZ9Gm7ICFGDaQ7Qy_EQq9KdW5dguA5zzw2ijxBfSzq4Ou4LoL9yyuX4Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc
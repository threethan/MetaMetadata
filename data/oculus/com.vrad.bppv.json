_oc=AdrBtBTzaRLtFzb4QXSqwXYpQ0WOWwT7avYjsn8RbFFPVHra-rxDQYNwY3MastijPSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG88vEcV48tDAK7Hi1K2IqUIoM6VRmiLvv_CdnQlf7TsA&oe=6A7C5D24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZOQ2JIQ8oQ7kNvwFkP0GR&_nc_oc=AdoxVqgsQf0CdX2cFrFrwAfjCiG7c51oa1-pv8Bew5fi1ubf7OzfhcMzz9uyJRw6v7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2AVbr2vBVsaJrtUw8Ei0xlsbHYnYHX0VN-5-xnglNOA&oe=6A7C5737"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVArtsPuNQEQ7kNvwHtmfPQ&_nc_oc=AdpyXcUkxst8schN9lIysygnqRz7tF2_S8Lb4gji1jvLgkRrqBbaVcQ2536xuLADq84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO9q7XJRXDK-TsSYthS5aXnKF2oOTiO66VVKa4w5FJ0Q&oe=6A7C66DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXwZQC8mcpAQ7kNvwG1kSKQ&_nc_oc=AdohsKnJHY18ohMXjByqzoyHRMZRwAOFtAVPDJ3dA_RKbm__Wix9t5QIAqoZjfwjAQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUPne2s9Z58JHiMxYa9zWjONdGKSoIclKJ6gRL4dQmEQ&oe=6A7C630A"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXDsV1qgAGQQ7kNvwHjqEl9&_nc_oc=AdoK9tC4S8mEwaGLq9qIWTQU_UU9oDz3Lpczpgl7-jbfM9pPlRxmw1Ypfp5qsyGNMD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPnmOBYqhO5prZxUAygOojOkcEZCCt64SxDn7f1l1KXQ&oe=6A7C56D9"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKHc9LfMB8QQ7kNvwEhPaQC&_nc_oc=AdqO7zMszcTI4KlhkRShz6rmPj5Jj-vM
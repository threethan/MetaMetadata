c=1hz-7mkHalYQ7kNvwGWmSKs&_nc_oc=AdrPJU4-NnhXo7-KTzj_m43QXacM1GrbXzroj9Sn_PpuHD4lITKV8ceMv5jmnYlcfTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRheKTIgkv0kwasu1NRAtnV5q195F2icEgi_bxWE1Z5nA&oe=6AF73D74"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J4Aj-NhvlkQ7kNvwF4mo6f&_nc_oc=AdqB-R2bui0YGesujcbitN3jZjw3tDDBh3Nz4K22akmcTp54ueBGjOyF19jynR4XqKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZvcdtNgRsWDl5J35Hs4G1FGpC2Me2C1iZd_3UDiunsw&oe=6AF7231F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCLGvzUclxYQ7kNvwEBVI8C&_nc_oc=AdoZLeOtTnqB_b93rOxXx8MpaeXKQEBayG3u5BBrlt3SplqxjtkjEEIMRtivOOc4GbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvgyKEuKcECG63Ro3b6o4hVGneq3RcYtUlLlBQzpJOWg&oe=6AF730E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgAq2O7DrTQQ7kNvwFajYLI&_nc_oc=AdrLeQ719AofC0Cf9fHULsT_pHyQsL61VUmF7ngEEXLIOL8cqccc0Sg-MrtD1enHrKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhEF-LZ_fLW6B-1EUl_WqqRDFg-ERzrecOo_irmSbNJg&oe=6AF72AF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZHz1zU-snAQ7kNvwHkwbKw&_nc_oc=AdqZfuUBHn6-bJ-6_3Xx5jR9jKt1ouOP6H4dhtx5CMGGIRH0w2bWC5i2xvR1grP8aA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHQb0aEXUN6g5ZQ5F-REF1S6xioXAiBpygwOXqqBvySw&oe=6AF73A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt0QNUAIJmwQ7kNvwFdWpHd&_nc_oc=AdrS5r5e-ruRMGiXxwE5WYB434J53DJJB8AI3MTVQjkEtogBPT1xT2x7v2VbuYjJ1DE&_nc_z
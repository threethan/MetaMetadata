c=avkpMEZoa2AQ7kNvwGPkbQ6&_nc_oc=Adq8-4R6KwoXPU0R65Frhh7k9UQ10U21O3AZ1f80VJaZ__Dv-dOc5ZP_rgtD2uZrdwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09SOhaEul3AfqR7IXcwb50zTyIlufIupdBk3DbQw_JSg&oe=69EE07B4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAQw0VUtfvgQ7kNvwEzWYLX&_nc_oc=AdoNeiTJBsFNzQ3IoVTXYqVWtAT_Tb7614AFGa5dc5lHNGGvgRduBTFbw2MJOfcBvmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DriEoGpK9ntmUZiqszP__-6pGV0lZNaUSj9qQMfqdUg&oe=69EE259F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlpIu7N-nCAQ7kNvwGSAgLM&_nc_oc=Adr9PsxDT4vNrsF8clm9br4NjULGYWn7XCf0g2MM41SNM31wsuTuWynlzRQ4v7PbHms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vPeyP06vC8k7mVj5w0z8sutXyPkqSUxzQ4L-b1NMYoQ&oe=69EDFB24"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8n3YdzjcLQQ7kNvwHubtdH&_nc_oc=AdqDeebuD_9CzrWw3xyULRBVHd8xVVU__riWKHujVCr0DvC1rkM8GHlbaSw3Bza_j3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L9FasHyExQ9rMIAi4qDJJGiBN5i7lrpolXslCS850ow&oe=69EDF537"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfcJHV-aOpgQ7kNvwHLze2Q&_nc_oc=AdpzWtl0EvEwQ6whFGCuM1Bu7Xfq-2yum8UFhZPZq8HyMLaMSgPdYiCRy7Rgvz_ZAHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BB8OoESmw2QNgI0xLQMw7tt_Xv8_2dYJTr0ns7xaRVw&oe=69EE04DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpJl2ji47WMQ7kNvwHw9dTz&_nc_oc=Ados7Naq2-1vFr24pRFLpHjOghBx6CWFUbE4P-QdiqRqkUT_NUY0NUuRwlEX2gsLrHw&_nc_z
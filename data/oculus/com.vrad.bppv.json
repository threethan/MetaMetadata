c=qbUyBeS-H1kQ7kNvwEq26tg&_nc_oc=AdoH2YHAcY8O9VBYjSX61uoU-k7bZ811zTYeVScccj-fWBsuAJggP6ZoZzsbNIFd6cM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KrXDGmwV-86iY-GY-KelvhZ3M-T4mejN1v9VO9Cegkw&oe=6A259EF4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkryEZzp1cwQ7kNvwEmGTOJ&_nc_oc=AdrxU1gs4h9iqIs6JkkKqhb-mGLjTS6UZkZ8lXcmEubqZReGCbvw1a3VEtlbTTx4bRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2UxJ6vNcp5dOlcifCcXLwbIjBZ_9WD6P82MRL9bD-Pg&oe=6A25849F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8YHDBcoye4Q7kNvwHBPCqR&_nc_oc=Adr48VQ2eM7wER2sD0oQn30Q6SCZbCTbySv05WOWhO_3e7AA2AHjgjg2dlDdnr1AMjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-erRk680lcIlOOz59zemHZTqEp09h4tQjSnvkCEsmlWA&oe=6A259264"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RqwDtCg6WgQ7kNvwHrZFyY&_nc_oc=AdoEhuNzdy_REyp0emdt1Jg-Bp2AAWfjXxEqq2stYL_4PJfMg9puKhcqXwt222JiVQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YQUBGGfBEhIpQkUvKlgMp93dTTukmJ-6RPQeWToAFQQ&oe=6A258C77"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIQ_nrFUNSwQ7kNvwENePdg&_nc_oc=Adpj2KWBq8X58KzgpjO2ECwrtkiOJ4yy1byKSmFFMWkSzaNQYZ874wsBbboq12j0uz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N_mL57dn8DcfYVLI22tUffrNvhQ8vMJ1b5yvdCr8Ugg&oe=6A259C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3ZDzAO57MQ7kNvwEp3CgI&_nc_oc=AdpJFnv7GAdugSRoQ9T9rcbWKaz4SeSeyEYLonitfaAFuQdnhkFrB5FISELGDuZQ8SE&_nc_z
_oc=AdrxLVxToiM5gzZwlMqRKtwkqTfExQf1gfCgnxrsnFAvECsTOSDY_A3Tvx0J0FQP6m8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jZaguAHzDnybIC-koLzWvENXHahHMX8ESQxF6YXV10g&oe=6A19B4E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THo61uTjiF4Q7kNvwHFRGRb&_nc_oc=AdoxuaEG6z2fomrY2GFcFH5asLzEtHTryrc-67rOPfIbLOii6ihoFob26q1GqZ7nSBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucBE84VHJbxGF5DtTrZAfFlqKozsAAFmqyFX1uQpKhw&oe=6A19AEF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxcXlr-2O-UQ7kNvwG2agyl&_nc_oc=AdqcUDpWowAyQ1CmreG91I7cLVM4_WL4WwuV5eZpvbteJHNq_NkXfOJse1FPEBTwKww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7olI3jlab6s8Fhzz9Vw7zSqQjMY7UJljhWwQ1M-BoO1w&oe=6A19865C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ67skjljt8Q7kNvwGTfF7k&_nc_oc=Adq2R8cyZSQenVn5EQtY0R0lX6MaXzMOEdf10pgyJrwAEgn_aLAAKMNdJJ3NiznDvuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ONp9WDJjbYKaYofyuq5qW6ikU6ON7c9slxcvvf9znZw&oe=6A19BACA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIJOG1n21zcQ7kNvwEQa76Y&_nc_oc=AdorU93SIHIuk5wFm9G00FlqqBEjriqYJSkfMXanF2uTYc_w69OdDVCxArbEr-uk9tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tW9KTqEVAgcGLssAlw0RbbGRF-cVex5P9y63hgsTRag&oe=6A19AE99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUDsuwdn6zoQ7kNvwE8DmJO&_nc_oc=Adp7mCKH5xwlWYycAMCAmdVweFAzOS_H
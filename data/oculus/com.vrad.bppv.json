c_ss=7f20f&oh=00_AQR3srXrmXlX8-Ec30Wvn_igr-MQFj4HZMj4d_AmImr6fA&oe=6B09B274"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tfFGqV99JIQ7kNvwGqAByk&_nc_oc=AdrkoPK-h2USkPS5CsaNApCTdgHgJFMJsp_i0RrstkhjL-PYTuiGa7Xl6CeXOpt6h1M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReNXGgi6zKMg0ocSo7NIgARd7uDU2vZURc7lR_aQc8Qw&oe=6B09D05F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggZcn3oxg6sQ7kNvwGnYkUq&_nc_oc=Adq9At91pWZhVYg-gIpG-uO8ybnBHhMg2VZ1Gv-zlop5xV-YHIPVo7Jdyvo3wzCaATc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYSywXQFHG7LerqY1EGllXdsyK1OlUDaX2NzIqu3vP7g&oe=6B09A5E4"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFeGXtP8gG4Q7kNvwE_cYbm&_nc_oc=AdoCw5jMzGhbPfZb6Uo4BObW6G4RwvRw6kWm1Nnf7h5x3GxaWYwAJNYlbbz_dGeioeE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA8DeusFFCiNSxOAHpahyU4akkgLCeu2mzmOBmvzaA-g&oe=6B099FF7"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqtjfGKJorYQ7kNvwHqXrnr&_nc_oc=Adr54qWaeYrokrzeAdpZI0oPFF3Krz5WqZdtTAbnoDLEpWVlWq4Qtb7CGaSdB4xo6wQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSVf8M6h3ZvWbaIHSYTEsVhFM1NAQ3qyXf4Nae99QbMw&oe=6B09AF9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzaHJF43P58Q7kNvwEApQ7L&_nc_oc=AdrSjfsuIr2DSKeNdqHJWTfip1xMRCJigNm_bl63rb94IQWVd1z3SsdJ_S-rUIqEVK4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNOKp8z_RHk4adAiHp8IkjTaPsSnNaJlx2I5OS4dxBeg&oe=6B09ABCA"}, {"file_name": "015.BPPV_Back \ubcf5\uc0ac.png", "id": "1817766118847513", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_1817766122180846_7650416343417810205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40zoAQ2CxfAQ7kNvwFu_kep&_nc_oc=AdrENCy-TGGdAQlEM6GKoM1DfZ1i9KGdfH_Gdh3nLV9C8auAKGBlTVdapCM4VDzsHgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXOxfgUkc1zN4AsJd4aJZk5XEBsVXXBPSExpP3Sna-hw&oe=6B099F99"}, {"file_name": "014.BPPV_logo.png", "id": "1802767730350558", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_1802767737017224_507317926787655633_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npbMoyqYXNAQ7kNvwHp76Bz&_nc_oc=AdrO6HT41f4Oex6w7B8EX8PZBYlEUJQaTk_6jgvlLZGl6BGouM4JgdhOBQR6qud61bc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6IWjBazdGaRC2YJlZWQpzpMDFbAPDvuPby8lc9yjhvQ&oe=6B09BD93"}, {"file_name": "007.BPPV_PDP.png", "id": "1362589205264314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_1362589208597647_2895065944326507885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpoaI7ii_9sQ7kNvwHF5TAK&_nc_oc=Adr5KFfdYIwpc1Ayotf6LwMlYiKhNfTJ625dGHJQhUcXpYnoy1GbbwP-mgWiw4ca6bs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpdb0f-SG7dRdoJonOhHKy_j9NzIc3MI8n8G8SeHjinw&oe=6B09AB51"}, {"file_name": "005.BPPV_Square.png", "id": "1269871715156621", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620346_1269871718489954_4811280509119093641_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvp-Ulb4w4kQ7kNvwFU8AER&_nc_oc=Adpkcxy_pPw1WpmxyoL1kQPb4wIHwBHS75YHa6SgUEozuToQybMTk0sZiVS2tNt
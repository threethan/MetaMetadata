c=LkrrI7oyUwkQ7kNvwEUAO_8&_nc_oc=Adqpcy1bbtJFg0SMmqDDgIrdi7Q788AyHx6YlODAILlOTp8gPNJEcdPVS5qAuGdfl8Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wY-OJ9itS7QVS6EFZ35zT8O5_zT5aQqPCLA1j-dOLwA&oe=6A104EB4"}, {"file_name": "009.BPPV_Screenshot_A.png", "id": "764839726611060", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618251_764839729944393_7828969977832666854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXVMthvaZ7MQ7kNvwFLLepi&_nc_oc=AdodfTw4mDPlTBFCUiasP5s92LNxczKIZx7FqgcksJ8qyOK-xe60xKh1Z07ScuzOI7I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FpDK4hvKIfBSEcATnmogC32AxlTJLj-qA2p6ca6TzEw&oe=6A106C9F"}, {"file_name": "011.BPPV_Screenshot_C.png", "id": "1536530004352010", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1536530007685343_7457744043638521549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Xrijw96JIQ7kNvwFsn8Px&_nc_oc=Adp7Vtz76FhF5DkD-b1VlgCk-9hBAcg24P8Qt3XyEPc3zuRGSgeWv8OTVhxs4RzsEZI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4etk47aLqfTOjJncOuPNnXx6XQnmU3nUYhgLqa8sQzHQ&oe=6A107A64"}, {"file_name": "012.BPPV_Screenshot_D.png", "id": "1318754999578777", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619773_1318755002912110_9075243434492896154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkVrXdYHmY4Q7kNvwEWQShm&_nc_oc=AdqnzC52retulmlQ3uQR1fordUbf1FA-QHvtfYFoYNxSNdwN5CfA6-9dQicAXVo1vLs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jn6_ehQiXOloQ6_rbYORQroYcwGe8w2KWKALhn2bnZw&oe=6A107477"}, {"file_name": "013.BPPV_Screenshot_E.png", "id": "1167818058149652", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619096_1167818061482985_8346830004618693216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYEA1s7bacoQ7kNvwEtNSzm&_nc_oc=AdqrlsJg60qK41wNneDJR0cZ56ycXmBF_nK8nJucECK6gqAEpp0aW_4cqS3KjdwOYHA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42YeQonG7TUDTVcu6yNHELiNjK3vGa0v_-orAPndBGaA&oe=6A104BDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-BPPV", "keywords": [], "long_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients.\n Users can simulate essential diagnostic procedures such as the Dix\u2013Hallpike test and Roll test, observing nystagmus responses that are generated in real time according to the patient\u2019s head movements and positional changes.\n Various repositioning maneuvers\u2014including the Epley maneuver and Barbecue rotation maneuver\u2014can be performed step by step, enabling mastery of appropriate treatment protocols for posterior, horizontal, and anterior canal variants of BPPV.\n VRAD\u2019s medical education simulation algorithm actively generates the direction and intensity of nystagmus based on factors such as head rotation angles, changes in gravitational orientation, and the location and movement pathway of otolith particles, providing clinical responses that closely mirror those seen in real patients.", "short_description": "VR-BPPV is a VR-based simulator for the diagnosis and treatment of Benign Paroxysmal Positional Vertigo (BPPV), providing students and healthcare professionals with an environment to systematically practice positional tests and canalith-repositioning maneuvers without inducing dizziness in real patients."}, {"images": {"nodes": [{"file_name": "006.BPPV_Portrait.png", "id": "1845130882753221", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499298543_1845130886086554_1529312920805962498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZvjakI2Z38Q7kNvwFilz2Q&_nc_oc=Ado6FNzas4n6K1WaHjqOZ_2FwUVHuCKhAlf_jHaJA7QAfLogivUn2XlLWU8MtEnEHIc&_nc_z
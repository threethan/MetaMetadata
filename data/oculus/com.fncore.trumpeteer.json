44131939071_6308112549847606307_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izzT7iehatgQ7kNvwFr9asj&_nc_oc=AdpbW2pZQ4OzFqXOdvNcLw15Kz45lTQdj4jASqoT23_foSACYEl7jhhZ-JnXgaaFWKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv0h4mY0q-9T95PUFcttpkZMC-Wj0D8jiJGMrr0MHWSg&oe=6B09C7EE"}, {"file_name": "screenshot-5.png", "id": "2978348712538353", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_2978348715871686_2296013656569304308_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiKIiZJePKUQ7kNvwFQCYye&_nc_oc=AdoaZC8LWFhe6aJHV4Xe0mpP6zgY0b4PT4_7yQyaeAVYlsIh8JFU01nwWxMUpQGBFo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQisGMlUWwkt-2uPS7suTfgPBsOLy-Nx3R_Ju8rO9mc-A&oe=6B09BA21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trumpet-preview.png", "id": "1623233949534341", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593776279_1623233952867674_3818257235987142968_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95b4hcrZIWkQ7kNvwFQXzg3&_nc_oc=AdrkCJLJiM7RJR5pHt38Wr5GYYQwYkwKOTnjjL9lgK9z0-sjNJBGo-1ctShf8rWEypQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ1VfN7IC1uK2-V9rktgCHR3fUONh5eiKIThyAF8oPVA&oe=6B09C7A9"}, "display_name": "Trumpet", "keywords": ["trumpet", "instrument", "music", "brass", "play"], "long_description": "A B\u266d trumpet, in mixed reality.\n\nThe valves use real trumpet fingerings, so if you already play, you already know them. Pick out any tune by ear.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 56 pieces, like Haydn's Trumpet Concerto, with the fingering for every note as you go.", "short_description": "A mixed reality B\u266d trumpet for Meta Quest. The valves use real trumpet fingerings, so if you already play, you already know them. Pick out any tune by ear. The music stand shows you how to play 56 pieces, like Haydn's Trumpet Concerto, with the fingering for every note as you go. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet or Cello."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trumpeteer/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3163873617292459"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622162_1586279263302609_2692309628271559784_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-cvF0YoVGkQ7kNvwHeATBG&_nc_oc=Adq0pJarIUW8mrI12d_juQM13Z0wqKdHooDzJSYUxsZgzqiKEbe7hTEkQPBin4wk-uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx6srmIldpoFYc4OK70zNxAbnaR-B-asSTkw3BM6-WrQ&oe=6B09B8C2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trumpet", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1792360320, "la
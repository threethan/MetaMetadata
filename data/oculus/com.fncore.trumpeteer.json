44131939071_6308112549847606307_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-heJ5CtveAQ7kNvwFUddmV&_nc_oc=AdpQI_7lzXIW5-s2X2Kj5iSfU1lsrCSm5W662jaW562nkCgngf7YqCkwWnOwqD_AJ-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSX_DIVLwZux4AfNnr_APaPGN1T-tMmDwvhPn_iAWZ5dw&oe=6B0C6AEE"}, {"file_name": "screenshot-5.png", "id": "2978348712538353", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620630_2978348715871686_2296013656569304308_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpMlr0LnLvAQ7kNvwFEJKfX&_nc_oc=AdruiENifxD_4QQPHIamnltXCw3AquDFmvUUnUMM4spzZHYs6rqITqV9TDPe71fQDqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzlghTNzDVEzKIF-aM3Ue88tSdRjAo5mfwoCnpXAfuXg&oe=6B0C5D21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trumpet-preview.png", "id": "1623233949534341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593776279_1623233952867674_3818257235987142968_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq--oLb9f5cQ7kNvwGERiUk&_nc_oc=AdogHaKgDAXgTGLTisG2YnaQWxi3Ow-I1lXLyn-oAsvJDT8M3LfcmyD-ex31Digy3I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIW7NSAWWMBO60CYmLjCnF1EsGhRCjJpxNLT1gjOKM0Q&oe=6B0C6AA9"}, "display_name": "Trumpet", "keywords": ["trumpet", "instrument", "music", "brass", "play"], "long_description": "A B\u266d trumpet, in mixed reality.\n\nThe valves use real trumpet fingerings, so if you already play, you already know them. Pick out any tune by ear.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 56 pieces, like Haydn's Trumpet Concerto, with the fingering for every note as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night.", "short_description": "A mixed reality B\u266d trumpet for Meta Quest. The valves use real trumpet fingerings, so if you already play, you already know them. Pick out any tune by ear. The music stand shows you how to play 56 pieces, like Haydn's Trumpet Concerto, with the fingering for every note as you go. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/trumpeteer/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3178273709185783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622162_1586279263302609_2692309628271559784_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-cvF0YoVGkQ7kNvwF6Pbfs&_nc_oc=AdoJtzw2OS3yMsKfHnpvkYYyOEu8ElOD-dTTtojbsANNwSegEDN1Af_k0J4pgQdWszw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXsXOSu1sy0gA_jOOXBn9az8xQ0PS4YsRbWinw5nyz1w&oe=6B0C5BC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "di
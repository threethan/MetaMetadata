file_name": "04-gym-gameplay.png", "id": "4388898747995464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_4388898751328797_8741285460189503325_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML9csSClT_wQ7kNvwG_o3k2&_nc_oc=Adofqhpt20KBTM9UjMiO_dq0DuZvH5rX_sT4-kTXtnGOvncYa5a0ZlU3-j-oo0atlIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx3XqAUrU_mrsmPv47w6Bm5ItNQlSDbnf-YQKxMzkn9g&oe=6AEB5D1A"}, {"file_name": "05-workout-selection.png", "id": "1128204306496672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1128204309830005_1574090106368446694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My1ey3UNkwgQ7kNvwEvz1xq&_nc_oc=AdoMH0ds5GSAa17ZFCx_jimpygSJoRjSfirg8esjSvDXXX5T4LDsVjf6iy38T9gb1Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHRfLTZ285ASBnMkVePzCo-B4JwS0BcbGH5DuFGKHgfA&oe=6AEB2CFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-neon-gameplay.png", "id": "2901822880218101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_2901822883551434_9159709667537386677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scqIVhtjqxQQ7kNvwEJWxvc&_nc_oc=Adpt5wBIEyBmjG9906SkitShiJdeF-ScrwHNBvCDBVrnz4vVUi0vrZzt2Pqgc8gcTdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCf7e20PIp2BrK5oPFFnQe4n3bs9awjBCzLsln2u3VLw&oe=6AEB3536"}, "display_name": "Workout Worlds", "keywords": ["fitness", "workout", "boxing"], "long_description": "Workout Worlds brings active VR workouts to a choice of places. Practice punches, duck and lean around obstacles, and keep moving to 12 original tracks.\n\nChoose your setting: a sunny beach, a green park, an indoor gym, a neon arena, or your own room using passthrough.\n\nStart with one of 10 workouts, with Light, Moderate and Intense options across the collection. A tutorial introduces the movements, and workouts include warm-up and cool-down sections. Use Touch controllers or hand tracking, adjust your height and reach, and choose a low-impact option when you prefer it.\n\nReview your workout results and history on your headset. Calorie figures are estimates, not medical measurements.\n\nWorkout Worlds is a single-player experience with no subscription required. Play standing in a clear space with enough room to punch and move safely.", "short_description": "Work out somewhere different. Punch targets, dodge obstacles and move to original music on a sunny beach, in a green park, inside a gym or in a neon arena. You can also bring the workout into your own room with passthrough. Choose from 10 workouts, use controllers or hand tracking, and follow your progress on your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unagistudios.com/workout-worlds/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unagi Studios", "support_website_url": null, "website_url": "https://unagistudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1445217251999790"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1877027829948820"}]}, "baseline_offer": {"id": "1877027829948820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791795900, "status": "PUBLISHED", "id": "1877027829948820"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_te
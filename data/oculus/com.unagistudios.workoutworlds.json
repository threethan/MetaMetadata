TuLXtjEch7umPQQ_oXQGQcXTfdxSvgQ&oe=6B0860DB"}, {"file_name": "03-park-gameplay.png", "id": "1422648722591736", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823783_1422648729258402_342508265887968948_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFNYZc4JOMYQ7kNvwFWa6W9&_nc_oc=Adq_Q8GhyIbrTxECPbsl6KtM2dd8VJqko9MpaeK7KskYbsxXVJlrLb8I3VXeQV_J348&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU8P-krKyy1d2PUy25Fzr643MjUfHpkIHp8UgdBqXjcg&oe=6B084B06"}, {"file_name": "04-gym-gameplay.png", "id": "4388898747995464", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_4388898751328797_8741285460189503325_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk-x5wATwe8Q7kNvwF9_5Qo&_nc_oc=AdrzkDwkERWIpYN9jQoExHrIuZLG2znhD4OnatHTPk9m_Awcff_P-ZO0woq_Q2kPpaI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIvm3yLqzsXFbYn73LGgXi5r8hPJXj8HoLTHfPvLpCDA&oe=6B085E1A"}, {"file_name": "05-workout-selection.png", "id": "1128204306496672", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491825481_1128204309830005_1574090106368446694_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toBZ8VKHoXoQ7kNvwEqammc&_nc_oc=AdokyB_RbQPhI1SryGRhQl3vxj1T2dhId30IMR_J9AYZilc7s1kKRe0LXXS-72VlZ7o&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT2O5yxmsY29UMnQTa7BSc4FkS7TYTT_f0sCbE7i3j7w&oe=6B08663F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-neon-gameplay.png", "id": "2901822880218101", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823296_2901822883551434_9159709667537386677_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ6P9OOhzRYQ7kNvwEJ0zt6&_nc_oc=Adranb4D_i0umlY8BWrbh3qt2rPGqZCB28a7fzHvrISjYTRZL1jqbikvBUfQ1Ji79i8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtGG1Ic-AxvBglfbi_eLLtE92W7uMtCvczNmgocZmFPg&oe=6B086E76"}, "display_name": "Workout Worlds", "keywords": ["fitness", "workout", "boxing"], "long_description": "Workout Worlds brings active VR workouts to a choice of places. Practice punches, duck and lean around obstacles, and keep moving to 12 original tracks.\n\nChoose your setting: a sunny beach, a green park, an indoor gym, a neon arena, or your own room using passthrough.\n\nStart with one of 10 workouts, with Light, Moderate and Intense options across the collection. A tutorial introduces the movements, and workouts include warm-up and cool-down sections. Use Touch controllers or hand tracking, adjust your height and reach, and choose a low-impact option when you prefer it.\n\nReview your workout results and history on your headset. Calorie figures are estimates, not medical measurements.\n\nWorkout Worlds is a single-player experience with no subscription required. Play standing in a clear space with enough room to punch and move safely.", "short_description": "Work out somewhere different. Punch targets, dodge obstacles and move to original music on a sunny beach, in a green park, inside a gym or in a neon arena. You can also bring the workout into your own room with passthrough. Choose from 10 workouts, use controllers or hand tracking, and follow your progress on your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unagistudios.com/workout-worlds/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unagi Studios", "support_website_url": null, "website_url": "https://unagistudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
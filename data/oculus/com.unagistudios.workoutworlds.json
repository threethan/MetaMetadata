3ykAMAnFmsKGiHqBTYomE1j_Q4qyVIw&oe=6B0077DB"}, {"file_name": "03-park-gameplay.png", "id": "1422648722591736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1422648729258402_342508265887968948_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8aTN7o2dAoQ7kNvwF3F3k-&_nc_oc=AdqzL0Dkyqu1Gd05EzYD6Al4CGlDfofGlOTBZhVTzBv6UMnLa2zdjFBlXJKsEY3U2Bo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIjh9EGmrjpvsKLki-fTx1CWgL2_wNFDdHMvyiTj3jwA&oe=6B006206"}, {"file_name": "04-gym-gameplay.png", "id": "4388898747995464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_4388898751328797_8741285460189503325_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3MxEB1YmZUQ7kNvwH_ZSSI&_nc_oc=Adr5Rqau8_WlwvTnHb5G5bZmIKPreMk4NxkNvH1VVnPsqabk2zvH_bneKPNwIsTSzPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIK880FrybUAwc59MeWOs1VO5APr96mOdFHNnYpymJ0A&oe=6B00751A"}, {"file_name": "05-workout-selection.png", "id": "1128204306496672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1128204309830005_1574090106368446694_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIXbG8YpvJUQ7kNvwFMUyZf&_nc_oc=AdpIYIglN-nqXck757QDDeVLXoTyjL536PgeSLyym8duCAjUNfBSmnsIg5Uu_wHVwRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNg5np445eANxl6WUsxzgfFZI8XvJA46lC3cByUXtMzQ&oe=6B007D3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-neon-gameplay.png", "id": "2901822880218101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_2901822883551434_9159709667537386677_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awFrCJHGJIEQ7kNvwH0PNb9&_nc_oc=AdpXHFqKzWC9L1ygcDYjns1k3cFM8Q9DLdg41anGQcSudmbCt_TaDBWWvzY-JIubGW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS48bp3pIoKrcQ4kuomw1eVbckIk1DAAsCInJO2ClW9w&oe=6B008576"}, "display_name": "Workout Worlds", "keywords": ["fitness", "workout", "boxing"], "long_description": "Workout Worlds brings active VR workouts to a choice of places. Practice punches, duck and lean around obstacles, and keep moving to 12 original tracks.\n\nChoose your setting: a sunny beach, a green park, an indoor gym, a neon arena, or your own room using passthrough.\n\nStart with one of 10 workouts, with Light, Moderate and Intense options across the collection. A tutorial introduces the movements, and workouts include warm-up and cool-down sections. Use Touch controllers or hand tracking, adjust your height and reach, and choose a low-impact option when you prefer it.\n\nReview your workout results and history on your headset. Calorie figures are estimates, not medical measurements.\n\nWorkout Worlds is a single-player experience with no subscription required. Play standing in a clear space with enough room to punch and move safely.", "short_description": "Work out somewhere different. Punch targets, dodge obstacles and move to original music on a sunny beach, in a green park, inside a gym or in a neon arena. You can also bring the workout into your own room with passthrough. Choose from 10 workouts, use controllers or hand tracking, and follow your progress on your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unagistudios.com/workout-worlds/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unagi Studios", "support_website_url": null, "website_url": "https://unagistudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
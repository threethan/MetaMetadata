xjVQ&oe=6B0F0784"}, {"file_name": "05-workout-selection.png", "id": "1128204306496672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1128204309830005_1574090106368446694_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_bCWBCWbIYQ7kNvwGERziu&_nc_oc=Adrlyx-RSz5jRbtIpO0qhLND7NMYt1K4INFAgSCQpkDBMnrfw33F3WbpXFebJ0mo8G4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH4hRwB2KzCSdua4edi8NNDYQmV6fxUudASPw3mZXrog&oe=6B0EFDBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-v2-2560x1440.png", "id": "2533351017175334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_2533351020508667_348217711739542624_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-cmYjEmz6kQ7kNvwG_lQNf&_nc_oc=AdrFF8AYWCRhMSmMjeJ07keleAZIzi6P4H2anve4E2slfe5hG2mNMCVfKIlmB3bTJ-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV89oRa5L1svig7uDavIXhVjtpLlzZ5XUi1T80AdkYp4w&oe=6B0EEFDD"}, "display_name": "Workout Worlds", "keywords": ["fitness", "workout", "boxing"], "long_description": "Workout Worlds brings active VR workouts to a choice of places. Practice punches, duck and lean around obstacles, and keep moving to 12 original tracks.\n\nChoose your setting: a sunny beach, a green park, an indoor gym, a neon arena, or your own room using passthrough.\n\nStart with one of 10 workouts, with Light, Moderate and Intense options across the collection. A tutorial introduces the movements, and workouts include warm-up and cool-down sections. Use Touch controllers or hand tracking, adjust your height and reach, and choose a low-impact option when you prefer it.\n\nReview your workout results and history on your headset. Calorie figures are estimates, not medical measurements.\n\nWorkout Worlds is a single-player experience with no subscription required. Play standing in a clear space with enough room to punch and move safely.", "short_description": "Work out somewhere different. Punch targets, dodge obstacles and move to original music on a sunny beach, in a green park, inside a gym or in a neon arena. You can also bring the workout into your own room with passthrough. Choose from 10 workouts, use controllers or hand tracking, and follow your progress on your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unagistudios.com/workout-worlds/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unagi Studios", "support_website_url": null, "website_url": "https://unagistudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1476425358878979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1089337790610770_7695993337072992061_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHzvmvZarCIQ7kNvwHEAcd3&_nc_oc=AdpUQQUAiJ-J3j4Go7mlQchya0Gt_sXX0i9LrVCq2nvDIRwn84X3JdsPKzdvVDh9V9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXz9XIXdZ4IRQB6C0WyvhpSNt6qsUKiOcA6xa4V9Cp1Ew&oe=6B0EF3EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Workout Worlds", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness 
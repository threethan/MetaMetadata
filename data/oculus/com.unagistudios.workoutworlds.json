file_name": "04-gym-gameplay.png", "id": "4388898747995464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_4388898751328797_8741285460189503325_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4IujY9ftMwQ7kNvwGrKUEo&_nc_oc=AdrCnT8iSeVAKuuYVwnCqDpgz6zfIU5aYX3T7rlzs-heBQbIJqVf-3f-2ebA1OqQayo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhu_Vf2SVp1xBMRvuCpqWlVhrXu-YFFRPNKfz8i88L_Q&oe=6AEE001A"}, {"file_name": "05-workout-selection.png", "id": "1128204306496672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1128204309830005_1574090106368446694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW94xDcM2d0Q7kNvwE8NbLa&_nc_oc=Adp48gTGihnSKUV5ve0Mk0pzcFSgZDV5GlEWDfUf1JHrFML0NJo4OdRZgsdmASb5OyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg0VqzuUSLhjTRTE4Hi1N8o_qpKNiDz3aBl9wF2nRQAQ&oe=6AEE083F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-neon-gameplay.png", "id": "2901822880218101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_2901822883551434_9159709667537386677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leIbrVt7x64Q7kNvwHrScrG&_nc_oc=AdryyXyHnU0nN02rEQIqMwlzXGP9oAdAnVPx4OURd3_EqjJDgC_a_CSGnxFJH9zq794&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp4OVE8csj96yB3cdox1ZLe5h1yHJLdKBHgvKwijZGIw&oe=6AEDD836"}, "display_name": "Workout Worlds", "keywords": ["fitness", "workout", "boxing"], "long_description": "Workout Worlds brings active VR workouts to a choice of places. Practice punches, duck and lean around obstacles, and keep moving to 12 original tracks.\n\nChoose your setting: a sunny beach, a green park, an indoor gym, a neon arena, or your own room using passthrough.\n\nStart with one of 10 workouts, with Light, Moderate and Intense options across the collection. A tutorial introduces the movements, and workouts include warm-up and cool-down sections. Use Touch controllers or hand tracking, adjust your height and reach, and choose a low-impact option when you prefer it.\n\nReview your workout results and history on your headset. Calorie figures are estimates, not medical measurements.\n\nWorkout Worlds is a single-player experience with no subscription required. Play standing in a clear space with enough room to punch and move safely.", "short_description": "Work out somewhere different. Punch targets, dodge obstacles and move to original music on a sunny beach, in a green park, inside a gym or in a neon arena. You can also bring the workout into your own room with passthrough. Choose from 10 workouts, use controllers or hand tracking, and follow your progress on your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://unagistudios.com/workout-worlds/privacy", "developer_terms_of_service_url": null, "publisher_name": "Unagi Studios", "support_website_url": null, "website_url": "https://unagistudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1445217251999790"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1877027829948820"}]}, "baseline_offer": {"id": "1877027829948820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791795900, "status": "PUBLISHED", "id": "1877027829948820"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_te
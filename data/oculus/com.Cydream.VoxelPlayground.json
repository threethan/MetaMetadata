OM7XJ2iCQY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FGBiBpyMq9qFYFdSQQe9DtIHEr7Ie5Uh8FuKDkFftZA&oe=6A32AC92"}, {"file_name": "20251205-090857.png", "id": "2803941753282839", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295566_2803941756616172_2416671264646936199_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEBDwhWXaXYQ7kNvwFltKoV&_nc_oc=AdoCt0wT2_dbMBBUEJ2L_-n_ifGoZMskqsLl2dyLtn6dQp19_wLdVAvYWZW_ytIoF-M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wKmSStr8VzzKCFnT8n2jrCQBU19O15aeEMt7zEZPuZg&oe=6A32A19A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "26045808588360734", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618093_26045808591694067_5347730449872699499_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Spwu_xqASR0Q7kNvwHeBiGW&_nc_oc=AdqrnTGXby_dFnV9UuhXiZHwoCdl5IfubKhp44Ur_oIWHbzj1EXZoLZ8Wt-WvkkBvBY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NSvES6S5pTeDME-eSotUyF4vkkuhoU7DM68mWrQBaYA&oe=6A3297EA"}, "display_name": "Voxel Playground", "keywords": ["voxel", "playground", "sandbox", "physics", "destruction"], "long_description": "Voxel Playground is a **micro-voxel** physics sandbox built for VR.\n \nPowered by our **state-of-the-art** micro-voxel engine, the world reacts, collapses, and explodes exactly as you\u2019d expect\u2014whether you\u2019re building, driving, fighting, or just messing around. Creatures, structures, vehicles, weapons\u2026 even you are fully physics-driven.\n\nNote: The game will be updated continuously, and its **price will go up** as its development progresses.\n\nDiscord: **https://discord.gg/VoxelPlayground**\n\n{867067502353879}\n\n\n**Survival Mode**\n \nCraft gear, build your base, and fight off relentless zombie waves with your instinct.\n\n{806278489125308}\n\n\n**Mods**\n \nEndlessly expandable sandbox\u2014download and manage mods directly from the in-game mod menu.\n\n\n\n{818555541144994}\n\n\n**Cheat Mode**\n \nGo wild with a developer-style menu packed with tweakable parameters\u2014perfect for testing, chaos, and pure fun.\n\n\n\n\n{1228360075809144}", "short_description": "In this fully destructible voxel physics world, you can build, craft and shoot against enemies with limitless possibilities. Developed by the team behind Battle Talent VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxelplayground.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": "http://discord.gg/voxelplayground", "website_url": "https://voxelplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25348504081438350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824216_1150275390347991_7705837986277051453_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVZu376ACe4Q7kNvwEW1IIq&_nc_oc=AdqzybM_LCWT78I4JayPqOxVchiIX78gviWq_apIXlV4we3w053CGLl4xxOqasfrwjI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99dZPkqHRoEfOTFclQV4xCkhPEy3JWuRA-gedJouCr9Q&oe=6A329BA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
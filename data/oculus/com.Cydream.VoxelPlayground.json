ETxQQ1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_2djUnqeQ93I0iY_RsrZHIxpCtQGyA5QbnEBbrlUhMw&oe=6AC65492"}, {"file_name": "20251205-090857.png", "id": "2803941753282839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295566_2803941756616172_2416671264646936199_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9nB5ZFQV40Q7kNvwFrMYo7&_nc_oc=Adoam6TyX9y7cHBgaTFprUiYP9uj6kZ2Wms2JNzJ68NIrbsz-aHet_pEraQS39G2r80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgZ0KxTBgzEbH-2sDRU9OJ4Z5POOgVLZNmoYBByw695g&oe=6AC6499A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1587198599460122", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_1587198602793455_3262740548659188408_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15HxHOlOyUIQ7kNvwHesaD9&_nc_oc=Adqio-dy2ATVqYZSKcZWpXktqVRD-NNDv4i0B9Rxj4kleimy1cz_XdSxbJ0mLQWKL9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL_PUiCp87_2aTyNPVzZmjStl98OIAytJBPvUC2o3rIQ&oe=6AC67444"}, "display_name": "Voxel Playground", "keywords": ["voxel", "playground", "sandbox", "physics", "destruction"], "long_description": "Voxel Playground is a **micro-voxel** physics sandbox built for VR.\n \nPowered by our **state-of-the-art** micro-voxel engine, the world reacts, collapses, and explodes exactly as you\u2019d expect\u2014whether you\u2019re building, driving, fighting, or just messing around. Creatures, structures, vehicles, weapons\u2026 even you are fully physics-driven.\n\nNote: The game will be updated continuously, and its **price will go up** as its development progresses.\n\nDiscord: **https://discord.gg/VoxelPlayground**\n\n{867067502353879}\n\n\n**Survival Mode**\n \nCraft gear, build your base, and fight off relentless zombie waves with your instinct.\n\n{806278489125308}\n\n\n**Mods**\n \nEndlessly expandable sandbox\u2014download and manage mods directly from the in-game mod menu.\n\n\n\n{818555541144994}\n\n\n**Cheat Mode**\n \nGo wild with a developer-style menu packed with tweakable parameters\u2014perfect for testing, chaos, and pure fun.\n\n\n\n\n{1228360075809144}", "short_description": "In this fully destructible voxel physics world, you can build, craft and shoot against enemies with limitless possibilities. Developed by the team behind Battle Talent VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxelplayground.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": "http://discord.gg/voxelplayground", "website_url": "https://voxelplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27775865215368879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673511715_3040527969475582_1257125500660793782_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=modex2CeGvAQ7kNvwE1DXqw&_nc_oc=AdrJWEYDXlBRMqy22P2UbKy0yTp7P0eJi7DvCkeQTOeT1CcOCHUYllx1yWAptXj4GAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu-aXOxIZUcx0SPeJ13ILOGKL7U_hvARTODwcPCXgweA&oe=6AC647A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
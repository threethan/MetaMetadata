7QG3-ss724&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ-qb_BqdJGaOcdlxzdSI9SmlH-s3QZRpQqW-EU7TaDg&oe=6AE20412"}, {"file_name": "20251205-090857.png", "id": "2803941753282839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295566_2803941756616172_2416671264646936199_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnGpaD9WklsQ7kNvwFjC2yg&_nc_oc=AdpKqK41G2JcI9NDDAcOlXO5VHJWvF8_gm0T2hEW_RP5qg613R0NcWRQgm_binXH_MI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPizaEnIClrUVCSMNRVSTXWvo84kxEWvMhDM5vnw8_Sww&oe=6AE1F91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "2084616715753164", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_2084616719086497_8279721192899843843_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pza0BGKwoWAQ7kNvwGgLP5b&_nc_oc=AdrMVfaUpI7-rY1jCjc3UMHwQq0FssHaW1NT0bl189BJQw0bIB0UFrry8NIx59n6ijQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaRaRp9Z0PsBRqUQH-xjccGbVZ4jH0vYNtWO9IhvGtjg&oe=6AE1E807"}, "display_name": "Voxel Playground", "keywords": ["voxel", "playground", "sandbox", "physics", "destruction"], "long_description": "Voxel Playground is a **micro-voxel** physics sandbox built for VR.\n \nPowered by our **state-of-the-art** micro-voxel engine, the world reacts, collapses, and explodes exactly as you\u2019d expect\u2014whether you\u2019re building, driving, fighting, or just messing around. Creatures, structures, vehicles, weapons\u2026 even you are fully physics-driven.\n\nNote: The game will be updated continuously, and its **price will go up** as its development progresses.\n\nDiscord: **https://discord.gg/VoxelPlayground**\n\n{867067502353879}\n\n\n**Survival Mode**\n \nCraft gear, build your base, and fight off relentless zombie waves with your instinct.\n\n{806278489125308}\n\n\n**Mods**\n \nEndlessly expandable sandbox\u2014download and manage mods directly from the in-game mod menu.\n\n\n\n{818555541144994}\n\n\n**Cheat Mode**\n \nGo wild with a developer-style menu packed with tweakable parameters\u2014perfect for testing, chaos, and pure fun.\n\n\n\n\n{1228360075809144}", "short_description": "In this fully destructible voxel physics world, you can build, craft and shoot against enemies with limitless possibilities. Developed by the team behind Battle Talent VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxelplayground.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Cydream", "support_website_url": "http://discord.gg/voxelplayground", "website_url": "https://voxelplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28584161417872584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_1820463015804038_5824375182444797472_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgaNI8qmUzsQ7kNvwHY8Goh&_nc_oc=Adq3sUlIIYUgIELth37S9KuTxF1tQXrThz0yXgdYNcncxJm37Ugu6K1FEz9hbACgbZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn4juP8iCpKUrj2RDxe2YBqc8frtBi-nxmY2vVq54cBg&oe=6AE1F781"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
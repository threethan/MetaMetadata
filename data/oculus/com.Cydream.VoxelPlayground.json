ssue", "created_date": 1782898844, "id": "27298739949748077", "version": "0.5.0", "version_code": 9535, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9926748747373800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27298739949748077"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "593524476670986"}]}, "change_log": "- fix blackscreen on quest2", "created_date": 1782207766, "id": "27207204702234936", "version": "0.5.0", "version_code": 9533, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9926748747373800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27298739949748077"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "593524476670986"}]}, "change_log": null, "created_date": 1781754964, "id": "27144492911839449", "version": "0.5.0", "version_code": 9531, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9926748747373800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27298739949748077"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "593524476670986"}]}, "change_log": "  - Added the new Prison map with NPC guards/prisoners, waves, climbable spaces, gates, lighting, and respawn polish.\n  - Added new weapons and sandbox toys: Glock, sniper rifle, grenades, chainsaw, stun baton, shackles/chains, guillotine, spin wheel, crusher, incinerator, and\n    hydraulic press.\n  - Improved combat and destruction with material-based penetration, sharper blade behavior, better bullet reactions, larger explosive effects, and new penetration\n    VFX.\n  - Upgraded NPC behavior with smarter targeting, retaliation, weapon stealing/pickup, head tracking, chore animations, and critical body-part damage.\n  - Improved grabbing, carrying, throwing, sitting/standing, climbing, doors/gates, and low-speed movement control.\n  - Expanded sound and visual feedback with material footsteps, weapon/electric/chain/wind sounds, decals, blood, lighting.\n  - Added food/healing items and more usable props/icons for sandbox play.\n  - Improved performance and stability for large NPC scenes, voxel destruction, occlusion/LOD rendering, scene switching, respawn, and black-screen/crash edge cases.\n", "created_date": 1781681112, "id": "27133023479653059", "version": "0.5.0", "version_code": 9510, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9926748747373800", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27298739949748077"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "593524476670986"}]}, "change_log": "Voxel Playground 0.4 is a broad gameplay update focused on making the sandbox easier to learn, better to fight in, and more stable when things get chaotic.\n\n- Expanded tutorial with guided lessons for hand UI, driving, ranged weapons, melee weapons, Gravity Gun, Linker, Thruster, climbing, building, and the full tutorial route.\n- Stronger mod support through ModTK, enabling richer custom characters, avatars, vehicles, weapons, scenes, abilities, enemies, UI, music, and scripted interactions.\n- New and refreshed mod content, including Attack On Titan, Spiderman, Invincible, Homelander, Helicopter, FlameSword, and Facial Expression.\n- Improved melee combat with clearer parries, better blade hits, cleaner stabs, and less sticky long weapons.\n- Better ranged combat with improved recoil, smarter aiming, more reliable projectile damage, and more consistent gun enemy behavior.\n- Smarter zombies and soldiers that find targets, handle obstacles, and switch tactics more reliably.\n- Updated scenes, vehicles, and sandbox tools, including Construction scene polish, better spawn controls, vehicle tuning, and improved default blueprints.\n- Better lighting, sky, fog, color tuning, and scene atmosphere across tutorial and mod scenes.\n- More responsive destruction, more stable fragments, better object throwing, and cleaner character grabbing.\n- Many crash fixes and quality-of-life improvements across menus, climbing, inventory, avatars, vehicles, spawning, destructibles, and VR interaction.", "created_date": 1778313635, "id": "26641780262110719", "version": "0.4.0", "version_code": 9030, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
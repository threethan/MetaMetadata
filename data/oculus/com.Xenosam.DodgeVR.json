\u30f3\u30b7\u30e7\u30c3\u30c8_3.png", "id": "1156543266444280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1156543269777613_8460777624833310526_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-clIWK2tmMAQ7kNvwHDwL9X&_nc_oc=AdnJOh_GZ_SB8zKUOrR-fuWlvi9N4O_pgAXXyykHszxJpkLW1CNSIrctp6XEMONgrU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7NM1Tr9kZR9gsXnANgUH-Gr5LN_tf8Q2NvYqxMwACbg&oe=69B93933"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_4.png", "id": "1894869561069837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_1894869564403170_7211501422736374015_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDqz4rsPBRYQ7kNvwG-VxRE&_nc_oc=AdmxRH2ROBRhT0wZlQW1bmofUq9BPeb8xrmlNoOrd9nRa4PeMjxo7GexYGnd6jIvLIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKTVqTX55cpjW88ONnamaHaHMOKc1yfVT8gnCa0leAtQ&oe=69B947DA"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1562351141867401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619450_1562351145200734_4496260998627128780_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWs3GwqW0yoQ7kNvwELfIUs&_nc_oc=AdmVw1K0jeJ2JdJD6d7sazcWb1FtThVUm3oC58GkefXD-QfVgN99EYYryqStC0WTWRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6M1R5EscLYtnnkdwc76u6amk0dt9dYvm1zqYKl9HnkQ&oe=69B93132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "1344271310395789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310896_1344271313729122_5607633694220372878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge47c0zcEX0Q7kNvwGmMAzG&_nc_oc=AdnaXU2YrrsLKDT5Lapy2rrVnvWkz3SaocFgmzg6xs-0B5qaA26TTJQsvxTWT5AE4Uc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzP-Qb6tly977FLYdLjP8KiErVHoIA6lAC4n8HslVTkQg&oe=69B952DC"}, "display_name": "Dodge - Face Barrage -", "keywords": [], "long_description": "[How to Play & Controls]\n1. On the title screen, tilt the analog stick left or right to change the difficulty level (choose from EASY, NORMAL, or HARD).\n2. Press the A or X button to start the game.\n3. Avoid obstacles (cubes) and aim for a high score.\n4. If your head hits a cube, your score will be displayed and you will be returned to the original title screen.\n5. On the title screen, press and hold the trigger button to exit the app.\n\n[How to operate Hand Tracking]\n\u30fbDIFFICULTY SELECT : Put Left Hand Forward\n\u30fbGAME START: Thumbs Up Right Hand (\ud83d\udc4d)\n\u30fbRESET BEST TIME: Raise Index Finger Your Right Hand (\u261c)\n\u30fbBGM[ON/OFF]: Raise Index Finger Your Left Hand (\u261e)\n\u30fbQUIT: Thumbs Up Left Hand (\ud83d\udc4d)\n\n[Game Tips & Specifications]\n- Only the head has hit detection, so obstacles hitting the limbs or torso will not count. Therefore, avoid only obstacles near your face.\n- The speed of the obstacles (cubes) is always constant and randomly generated.\n- The controller is not displayed in-game, so it is recommended that you keep it in your hand at all times or place it in an easily visible location.\n- The cube speed doubles as the difficulty level increases, but since dodging is extremely difficult on HARD, the number of cubes is set to a minimum.\n- Crouching and jumping are also effective methods of avoiding obstacles.\n\n[Summary]\nThe app is expected to improve reflexes and concentration to instantly avoid obstacles.", "short_description": "An app that trains your reflexes and concentration by avoiding obstacles approaching at high speeds"}, {"images": {"nodes": []}, "id": "844306158286417", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dodge - \u9854\u9762\u5f3e\u5e55 -", "keywords": [], "long_description": "\u3010\u904a\u3073\u65b9&\u64cd\u4f5c\u65b9\u6cd5\u3011\n\u2460\u30bf\u30a4\u30c8\u30eb\u753b\u9762\u3067\u30a2\u30ca\u30ed\u30b0\u
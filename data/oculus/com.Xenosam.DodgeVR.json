2Yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlOv1Tv_u01bZX-ynkaQYmuyWR6PBF049ji0LRrk5GMw&oe=6AD241E5"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_4.png", "id": "1394307759245585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1394307762578918_6323998952499071426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAm1CWxWr1MQ7kNvwEb0B6M&_nc_oc=AdqNl2CkDWMsGp0T5ErAELdhC6L5urwOufTGfI_3G-Qk1naczd4I1f8SG5yFdof8Pr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2NZP4kBuYhK47aRXB4ntp5ouTeBz4vHXFuKkKbcgP-g&oe=6AD22CFE"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1312555550866964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1312555554200297_1282154816971627569_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KevbOs6799EQ7kNvwEwo6PE&_nc_oc=AdqVGU0-sdzvxVrsuGm0MXxznHXYWfH6p4vdBf75P5i4FdOM0w6ouaKGl-PykrZ8rFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNrNR2g7HoaYmqQgzSsR6rypNRvh7RrdlbKWzM8i3XSw&oe=6AD23691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "1344271310395789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310896_1344271313729122_5607633694220372878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxZCr5cR68EQ7kNvwEC-6bS&_nc_oc=AdrGHQCrPncNi5CFVXNBLkdRaDsIqXTbJZlUsegc7w95TiC4P6zk_dxGQYO8oM6qavQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp-9O0_fjPOO4UCm1hSWZ_WUqfjmFSHYd25WDH0W2fFg&oe=6AD25A9C"}, "display_name": "Dodge - Face Barrage -", "keywords": [], "long_description": "\u2728 Key Features\n\u25a0Full-Body Dodge Action\nOnly your head has a hit box! Duck, jump, and weave through obstacles using intuitive full-body movements.\n\n\u25a0Full Hand Tracking Support\nNo controllers needed! Play seamlessly using intuitive hand gestures.\n\n\u25a03 Difficulty Levels (EASY / NORMAL / HARD)\nFrom beginner-friendly EASY to the mind-bending HARD mode that will push your reflexes to the limit.\n\n\u25a0VR / MR Modes\nSwitch freely between MR mode for safe play in your room and VR mode for total immersion.\n\n\ud83c\udfae Controls\n\u3010Controller Controls\u3011\n\u30fbSelect Difficulty: Tilt Analog Stick Left / Right\n\u30fbStart Game: A Button or X Button\n\u30fbToggle VR / MR: B Button or Y Button\n\u30fbToggle BGM (ON / OFF): Press Analog Stick Button\n\u30fbQuit App: Hold Trigger Button\n\n\u3010Hand Tracking Controls (Hand Signs)\u3011\n\u30fbSelect Difficulty: Extend Left Hand Forward (\u270b)\n\u30fbStart Game: Right Hand Thumbs Up (\ud83d\udc4d)\n\u30fbToggle VR / MR: Right Hand Point Up (\u261d\ufe0f)\n\u30fbToggle BGM (ON / OFF): Left Hand Point Up (\u261d\ufe0f)\n\u30fbQuit App: Left Hand Thumbs Up (\ud83d\udc4d)\n\n\ud83d\udca1 Tips & Rules\n\u25a0Pro Tip: Focus Only on Your Head!\nOnly your head can trigger a game over. Cubes passing through your hands or torso won't count, so focus solely on dodging cubes targeting your head.\n\n\u25a0Mind the Play Area Bounds!\nStepping outside the blue boundary frame results in an instant game over. Keep your steps, ducks, and dodges within the marked area.\n\n\u25a0Mastering HARD Mode\nCube speed increases significantly in HARD mode! However, fewer cubes appear at once, so rely on quick judgment to survive.\n", "short_description": "Dodge cubes at breakneck speeds in this ultimate VR agility challenge!\n\nEvade relentless, high-speed obstacles with razor-sharp reflexes and intense focus! Features an online leaderboard\u2014do you have what it takes to reach the top? Compete against players worldwide for the ultimate high score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://00m.in/MdJLn", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://twitter.com/Xenosam0827", "category": null, "c
PFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRsXUAGwJMZzDxnyG9fe3_i1ov-7r2rzMG0YBx5QzIUg&oe=6AA2CBE5"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_4.png", "id": "1394307759245585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1394307762578918_6323998952499071426_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RShzGnzXu8gQ7kNvwH5p-71&_nc_oc=Ado016xqjyVOQN17BvzewqDbzhypDKzUD5Nxi--xz82erBdrB9viIQGbOO4M9uK5tms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7GE0VU2o80q31k0Xgmx5UioHLLeLFnJPn6eIPhZOc8g&oe=6AA2B6FE"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8_5.png", "id": "1312555550866964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1312555554200297_1282154816971627569_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cNxc2pnqbMQ7kNvwEtvcGJ&_nc_oc=Adr8HcG1zk1j2PODA_-TuidV6wsPbAdvpRg7FvLKgfriCezhEf6YfzigYKiw2JtgTOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL33IbhNFsw5aod5-hgOCfses_DcgSkQvCjwi18fnLJA&oe=6AA2C091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8.png", "id": "1344271310395789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310896_1344271313729122_5607633694220372878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLWFwsCTtlMQ7kNvwFQIUSx&_nc_oc=Adq5qEhd1mHs6ggUAXVnup-eEXlfKwh2WF4u7X06w_kd4Xwo4mZVeNus6_dq2x24M2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXq4mGVq5pmINy0YZ4L_bygz5NhQFWq1G9f6c4y9Xy2Q&oe=6AA2AC5C"}, "display_name": "Dodge - Face Barrage -", "keywords": [], "long_description": "\u2728 Key Features\n\u25a0Full-Body Dodge Action\nOnly your head has a hit box! Duck, jump, and weave through obstacles using intuitive full-body movements.\n\n\u25a0Full Hand Tracking Support\nNo controllers needed! Play seamlessly using intuitive hand gestures.\n\n\u25a03 Difficulty Levels (EASY / NORMAL / HARD)\nFrom beginner-friendly EASY to the mind-bending HARD mode that will push your reflexes to the limit.\n\n\u25a0VR / MR Modes\nSwitch freely between MR mode for safe play in your room and VR mode for total immersion.\n\n\ud83c\udfae Controls\n\u3010Controller Controls\u3011\n\u30fbSelect Difficulty: Tilt Analog Stick Left / Right\n\u30fbStart Game: A Button or X Button\n\u30fbToggle VR / MR: B Button or Y Button\n\u30fbToggle BGM (ON / OFF): Press Analog Stick Button\n\u30fbQuit App: Hold Trigger Button\n\n\u3010Hand Tracking Controls (Hand Signs)\u3011\n\u30fbSelect Difficulty: Extend Left Hand Forward (\u270b)\n\u30fbStart Game: Right Hand Thumbs Up (\ud83d\udc4d)\n\u30fbToggle VR / MR: Right Hand Point Up (\u261d\ufe0f)\n\u30fbToggle BGM (ON / OFF): Left Hand Point Up (\u261d\ufe0f)\n\u30fbQuit App: Left Hand Thumbs Up (\ud83d\udc4d)\n\n\ud83d\udca1 Tips & Rules\n\u25a0Pro Tip: Focus Only on Your Head!\nOnly your head can trigger a game over. Cubes passing through your hands or torso won't count, so focus solely on dodging cubes targeting your head.\n\n\u25a0Mind the Play Area Bounds!\nStepping outside the blue boundary frame results in an instant game over. Keep your steps, ducks, and dodges within the marked area.\n\n\u25a0Mastering HARD Mode\nCube speed increases significantly in HARD mode! However, fewer cubes appear at once, so rely on quick judgment to survive.\n", "short_description": "Dodge cubes at breakneck speeds in this ultimate VR agility challenge!\n\nEvade relentless, high-speed obstacles with razor-sharp reflexes and intense focus! Features an online leaderboard\u2014do you have what it takes to reach the top? Compete against players worldwide for the ultimate high score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://00m.in/MdJLn", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://twitter.com/Xenosam0827", "category": null, "c
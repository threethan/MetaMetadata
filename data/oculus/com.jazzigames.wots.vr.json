0f&oh=00_AQTgtLdEBW42SA14sp6m-Xsf4umw4WxN-qOyofzatfN23w&oe=6AFB3E25"}, "display_name": "Wrath Of The Skulls", "keywords": [], "long_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power.\n\nYou\u2019re armed with hell-forged guns, your only defense against these skull-demons. Thy will emerge from the shadows\u2014some small and swift, others monstrous and unyielding, you must stay sharp. They\u2019ll surround you, closing in from all sides in endless waves.\n\nYour Mission? Shoot them before they reach you.\n", "short_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "support_website_url": null, "website_url": "http://www.jazzigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
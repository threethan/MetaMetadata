uscdn.com/v/t64.5771-25/473391778_1932416254231251_4459539069495169203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrKu9qESJrEQ7kNvwEWeEPH&_nc_oc=Adndv6QESs1NYgCdOKrjTmswwvQ0HwzGYZatO-SF73V-btjM8Mxi5aQTOhG7TnzRnKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzStmPhE3qu2hY5TacXiJBP3thck5vdWZulbhfbc1AVg&oe=69A6F4D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Traler_Cover.png", "id": "1316358806259164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391870_1316358809592497_9223150736835377138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXPE0EeAvmQQ7kNvwGqMhtM&_nc_oc=Adn4BjA4TASRvYyazPBzNdcDuhqS_1Kmy6cXl3XFsYRZL3zvC_Bhs6BHMA0oVKvWPW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUb2tT8kOkMyrEovxOZLDMprcN9RYFvF8BrVvTb0rKDg&oe=69A6E2E5"}, "display_name": "Wrath Of The Skulls", "keywords": [], "long_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power.\n\nYou\u2019re armed with hell-forged guns, your only defense against these skull-demons. Thy will emerge from the shadows\u2014some small and swift, others monstrous and unyielding, you must stay sharp. They\u2019ll surround you, closing in from all sides in endless waves.\n\nYour Mission? Shoot them before they reach you.\n", "short_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "sup
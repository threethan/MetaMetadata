op at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "support_website_url": null, "website_url": "http://www.jazzigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27752530101060132"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "829514972802000"}, {"status": "PUBLISHED", "id": "2157634614713500"}, {"status": "PUBLISHED", "id": "1268034587574291"}]}, "baseline_offer": {"id": "1268034587574291"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "829514972802000"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29731248359854953", "version": "0.1"}, "id": "1310988190226260", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27752530084393467", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29731248359854953"}, "release_status": "RELEASED"}, "binary_release_channels": 
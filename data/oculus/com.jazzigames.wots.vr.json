uscdn.com/v/t64.5771-25/473391778_1932416254231251_4459539069495169203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA75L0mD5AgQ7kNvwHpz8HN&_nc_oc=Adk7kdDoaDe00xH2eT4maPZRNt9MoM-xE8CbMKCq6bPn_0PO0Pl_j3jwyw7Jq2QLCyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfydmZCuDrxiIx1tC3v4q83F5gUu5TNwMrOk8GaFNZig&oe=69998D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Traler_Cover.png", "id": "1316358806259164", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391870_1316358809592497_9223150736835377138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qex39LmK_joQ7kNvwHbJ0rD&_nc_oc=AdmPMIJO3B6tVsa9ZR7Xpf3o7C9H3cABOKK3M8B_7Shqa8Oie0-LXwgoSW_fKhNjiC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIyNyE1LV36GdXZHowvEh5uzu7NHV-rQHLkUaNdU1wog&oe=6999B3E5"}, "display_name": "Wrath Of The Skulls", "keywords": [], "long_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power.\n\nYou\u2019re armed with hell-forged guns, your only defense against these skull-demons. Thy will emerge from the shadows\u2014some small and swift, others monstrous and unyielding, you must stay sharp. They\u2019ll surround you, closing in from all sides in endless waves.\n\nYour Mission? Shoot them before they reach you.\n", "short_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "sup
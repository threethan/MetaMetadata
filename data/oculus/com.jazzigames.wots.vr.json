uscdn.com/v/t64.5771-25/473391778_1932416254231251_4459539069495169203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvng4nFZjZ0Q7kNvwGLcdQK&_nc_oc=AdlSsaGO2RW02UeQsE83gCLF6FVn5yrOI4qRMmJicV2cma9hwiwTi4HmWkN4pE1XrMA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsRSsySVQquXl4DSCoOXyv69Ejw7JW3HksB5xgp67Sf1A&oe=69A17699"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Traler_Cover.png", "id": "1316358806259164", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391870_1316358809592497_9223150736835377138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7o5aWxh-yQQ7kNvwH1_t-a&_nc_oc=Adm4QF6kRoerTf4Kv8MXM-iwQBDJMt-FyxM0kALrgD1f2CwpBvA5FCOWe_GR8Rq3H8g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv_7Y-wTGiYvxLN63RBxTJPCZBh9Yelhq8G-91seWea0w&oe=69A19CE5"}, "display_name": "Wrath Of The Skulls", "keywords": [], "long_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power.\n\nYou\u2019re armed with hell-forged guns, your only defense against these skull-demons. Thy will emerge from the shadows\u2014some small and swift, others monstrous and unyielding, you must stay sharp. They\u2019ll surround you, closing in from all sides in endless waves.\n\nYour Mission? Shoot them before they reach you.\n", "short_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "sup
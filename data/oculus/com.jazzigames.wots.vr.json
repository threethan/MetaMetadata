uscdn.com/v/t64.5771-25/473391778_1932416254231251_4459539069495169203_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPVQy_RUqoIQ7kNvwF6KzsA&_nc_oc=AdkM9sladn9erOPqqNyAE7S6nTVbwWOFdWU4Iz4Rx6Qrk6f6ej_3W3YZIjAALgInooU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfszfhrcziX1J1R8zmLaslQgEYuciETC0jq9M1fnB8Pzow&oe=69983C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Traler_Cover.png", "id": "1316358806259164", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1316358809592497_9223150736835377138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6mGaMQkBMIQ7kNvwG3pNUs&_nc_oc=AdmBAEXccIxZsGVoVRJucFyHLbxXgXnqwcklBJTV65CCtZhjHBUCKjzVJNejynE62PQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvNAqzcTLVLhh2EoSEhIzfeKFetPlHhT62ZjVm8tssPPA&oe=69986265"}, "display_name": "Wrath Of The Skulls", "keywords": [], "long_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power.\n\nYou\u2019re armed with hell-forged guns, your only defense against these skull-demons. Thy will emerge from the shadows\u2014some small and swift, others monstrous and unyielding, you must stay sharp. They\u2019ll surround you, closing in from all sides in endless waves.\n\nYour Mission? Shoot them before they reach you.\n", "short_description": "You\u2019ve entered Hell, where the tortured souls of the damned take shape as relentless skulls, cursed to roam these fiery depths. They\u2019re drawn to your life crystal, their last chance to escape the eternal flames, and they\u2019ll stop at nothing to drain its power."}]}, "developer_name": "JAZZIGames India", "developer_privacy_policy_url": "https://jazzigames.com/jazzigames-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAZZIGames India", "sup
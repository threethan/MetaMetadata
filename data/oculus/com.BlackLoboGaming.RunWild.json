nc_ohc=7G-xZO_f1ZMQ7kNvwHIwbfN&_nc_oc=Adl3pwPoWOBN0NzjDhHUHFdaNrRQVf5MAJbf_J7G-appzLup3ig8j3YCDqn7jQ6pE5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxiFWxcwYuNNFq4NKfk2lwP1LOwvKdMBx--ZlMg_XW4JA&oe=69BFED1C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1VOZsW3iXIQ7kNvwEM_sPf&_nc_oc=AdmMedB8DN2ohKQq0BHGnf7fdZMaawkj8FTWRN1rZYRI8n0MF1_9Ncl4DTEiNd6rPNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0jRMRuiQ_b-curqUkM44dXFt7ZaUaGafej4qgUPgI8Q&oe=69BFE808"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GPM6LDAuGEQ7kNvwHlWrRx&_nc_oc=AdndGGbiwe8_4s3tvR6eHbjp12qvlhWgV_uqOPztK2NBqGdG6JUhwe8pVnNPoA8DFTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-0wae9qRssJQ2o3sdkpPm6WBANgbhQPsB-W05aBBk2A&oe=69BFE92C"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFrHhjVsWGYQ7kNvwFt1IdS&_nc_oc=AdkxMFVuEqMyHXLSzEDGPK-7sbfpnx-sRc_ECd_ybhsRqXtHXXEON1rz9ONHzarIPas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfSaAsPj0s4Qi2FTKIpDqPjtDyU0YeBzVj8j-jk1PHfw&oe=69BFFF7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K2mkHU6U9IQ7kNvwGrqWXu&_nc_oc=AdmWHWUt715RwUxhWSbOR_IytOON_96I1FH1oN4rBQ9tOiIbKTBvPqKCQXtrbMYyjN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXdITidN4sBVDmG8SWUvTn0w0AsJRfPopsgpUg80IQew&oe=69BFEE8B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
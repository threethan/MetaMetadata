nc_ohc=ZJoRdGJJ_OgQ7kNvwGbsP5W&_nc_oc=Adl0YsXTHKYL42hcvp0tzjZorscJIYtKPeEvHX5GhRUdlPxZbdFbdOM44Z8AdLVcGac&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGQGHSVmnM5axr0sXwGM9fS0DHTsukjVtUadLTT_C1mA&oe=69BAA71C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLJsI7E9lf0Q7kNvwHLEFYg&_nc_oc=Adlg8HMm90gWr0jD7dcGmyJC6_I359MmSEYG6YGiFsLhYVdKmYTrxOeQmE0skv9m7iM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN-9gajYCH4WKLF0JEmzOJLGLk67wSWXLK4q2UkRR2zg&oe=69BAA208"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miTn2bDAezAQ7kNvwGApUxW&_nc_oc=Adm_qSZvkj-5B5QV2TdrI4IEW8OWPtTPWk3nhI5NTK9qGewXirLWcA9nnbBpTYn2M2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzT7UUvFflFJeohaUms9-Y4jPLcrHdw9KD0KO0R_987VQ&oe=69BAA32C"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei7CCikE-akQ7kNvwG676Y4&_nc_oc=AdlYl__yVKG1iE-sl7Ist2dYjW07XI8Z_bXn_o0i2QklRgvUv1ghK2BkJVDn1aKAB4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCmX0bWyW-Iiuo4mp__tPmrEn4d4Ww9v9u83KBD6qEFg&oe=69BA813F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkE7E_o7ezEQ7kNvwE_Y2rP&_nc_oc=AdmK31CGjJbz98E2yJE_7_bdQ5GXVPCnoNg2S33W2q1dVFNziQy6S7amWd5-rppD5IQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6SY0ODqC3ombmk9eD6JZd9oM0d7eaMToRIyaMuSiCdg&oe=69BAA88B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
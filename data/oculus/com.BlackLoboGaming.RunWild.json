nc_ohc=mb6a2fpzdFkQ7kNvwF7xQKJ&_nc_oc=Adl1lWLo1mPGvsoudxnyme-d5eFD3JPi9ZGX_XsIBP5NeYihAYPbmqHz0xDvAI71Qf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTvDWzkWjDaeM1ZxF8pDLpZref_o8DnrDNkFOCk1PeQw&oe=69B01B1C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1ECvyxFwLcQ7kNvwHxl8EY&_nc_oc=AdkKHQ97mp7YIpfYgZ9m30m2-IsPEkag3T7tz_NeVIJfd8lLbXE_3OpjdK0NL9B3y3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWySkcIaqEfosgDszd4Rt3DdMAPc35QVf9cliY13HKBA&oe=69B01608"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYjFZqgJlmMQ7kNvwE0Q4fm&_nc_oc=AdmKlsJFHJ93qo6gxl3FjexpmLe0NoBq3xgRlRzQKLgdaTxI7O37iEye5ogqF5wMc1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afymsoipk3SesYsos5q9D1_QEjeWgeAdasy-p-yxBUxO3Q&oe=69B0172C"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBFdhGGIoNgQ7kNvwFHPyh5&_nc_oc=Adk3csA4CP3HtVFQHuA35JAmBYBiuMTYXuz-7cK3-cULIgUzsQUJGCRqzNU78A2QVTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvVNCegJkVP0avnTrHKZhAenXfDO_KXvp3w2gYiysImg&oe=69AFF53F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5m4pLeZAuoQ7kNvwEpHoht&_nc_oc=AdmIk7L4VVnGb8Xjmz0UZri1up7l_F5r2eRScqaS9LRhcAXe78Y04l5kDLUsvkRe1Bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqjHdMA0J-ALn5ekXJryPYS_5FdloD8kOJgFgQbIz0-g&oe=69B01C8B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
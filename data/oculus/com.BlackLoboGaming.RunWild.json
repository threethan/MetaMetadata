u2COhUZQtgqCd1mVgMTwE1CPeWEuemwaGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1o5JafHi00jPt225CUxAchHXrb2fcB0ZTJlV9h5tUVA&oe=69A43D9C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVdc1qvDKKEQ7kNvwFbEin6&_nc_oc=Adlq6gfLXFCO_3DhBiWwsu2WRGshpUVOHQEtaPEPrZLttDFhmqzyR3JbNsyGa8TiLfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft-IdtRevp4VDw9sHaGXxE0_6cOSWabSOOOrWxOmJaTHw&oe=69A43888"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnCnDZddGUUQ7kNvwHGwFbw&_nc_oc=Adml_2dym4WXeo2_Hg5AbfIAZDkvRpCGYDpO5gp6G0dNE6MOekRhHBD4f97G1p0UqO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftmHLJ_UDadZuhQtzxArRLajPp3Z7L9AQbGRXwlXzIPsg&oe=69A439AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_POcRQlAZgQ7kNvwESWSmU&_nc_oc=Adnj0-N-mhJls5bPwv70K7rT9GHZkty96iVtNmigdHu5_GhuNW9sBPUNREhrZr-pitk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftNAYGUVRLA1wnHCTbw1emVPEMDn0naEQo_Jbuq9rTBzQ&oe=69A44FFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqlzbZF3PH4Q7kNvwHuuL0J&_nc_oc=AdlnMhfuMDjv8Ac0zZuVUmxnFusxkN3YrliIpyaWkvziaGkUCKHtQNPIFMYMyExkjZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuoMQ75Tem17XXnpbPbRWfFuz8LsZP89mjeJZs91s0EFA&oe=69A43F0B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blacklobogaming.com/privacy-policy", "develope
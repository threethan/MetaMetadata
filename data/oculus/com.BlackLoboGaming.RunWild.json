cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKX4mqmo1uAQ7kNvwHLihc3&_nc_oc=AdrSbqfV4vigXUglOaLNkv1zxoi6N6S8TtL7Q9t9xYv2QJFySGQwLOTv3eJipoW0bRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR44sBE-jNrPaOdc_TzmvlWh9Zo0bSQGgiPXr7G6XD-xw&oe=6AF4A45C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-FvLO563eUQ7kNvwFPjgMf&_nc_oc=AdpU1VmJRMnnD0aAR-R_j7ElZzz30bNA0Emafixw8vfaauR-WM-5y9oxI1xwJJSaCtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMcDqezh0awQ3IUyG7ama4lJPYfF3-HIZlp9YL2SH3eQ&oe=6AF49F48"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAcS97pHUc8Q7kNvwFKqLiJ&_nc_oc=AdqxOgrtYh12yVOzNBT2xoNWBhyKNXgLuxauJc9hms6JwtGXt50MAccNPY2gCvRhHNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4HmJ13-Xi4VGQZRlMGKxi0VR8CgW4Qxbn6RzcO03TEQ&oe=6AF4A06C"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p1ezyWEqlQQ7kNvwF2NAyG&_nc_oc=AdrM36uN1H-yWhRYZcrGn-Nd3EcVhwiRowMS8RfeOV-Hwmd2ys2mQfw2fUMOMgcSWLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9XdzIp-4yJR3cPJ0C67WN1gWozH8WBU4Dovxz2Cv4Bw&oe=6AF47E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHLSLvpw1aAQ7kNvwFT3icc&_nc_oc=AdoWVvhYuc6IaidplgkKguEfJ0xnpmET2110CS5HH-16VcBsFNPOlH0LImWG1KvcKis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaKLYIOUgwRRW-OS7w0Tx-lxFaZCwlpLUjO9n4FCE2KA&oe=6AF46D8B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blacklobogaming.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BlackLoboGaming", "support_website_url": null, "website_url": "https://www.blacklobogaming.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27991918317120427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974465_1578250922793367_4246241782763603754_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0tHK4QLZ2YQ7kNvwGFEHrG&_nc_oc=AdqrYHbiid6yshnvKLuH6ZThXopqmYi_Q3ATBkfQAp_cZwlEVbadtKXddqVeT8g3PJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0wj9On1ZHSRyrBIU9jxPmRJp_ZSWpW1zsT1RRsJLXMg&oe=6AF49DBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Run Wild", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1742670000, "lastRevision": {"nodes": [{"id": "26244386065207003", "release_type": "
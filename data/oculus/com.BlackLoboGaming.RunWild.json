nc_ohc=HNMFqYntdIMQ7kNvwHWm638&_nc_oc=AdnGpJZ2o7NGPKeqS90TL1dBPt1j6_52x6b_dM90GJ5dl7cHZMMmaB4H77DUNRDkhu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs0P-AiFEMgwfKA6WLZP-eahRoJg6Ve2anCr8tC3D6h7A&oe=69A9839C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO27EID5YHoQ7kNvwGt1QV9&_nc_oc=AdkhnDhoZ_83kcJ4GLkNkF-C9rqPEfEdq-17nKrnaoBC6Q-DZqLX6dC2CMJojEpPYJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvxZ-RTHSkCrXBvBQPnpkg4kNhXD6TsTsDKeQwJI7fRsg&oe=69A97E88"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKwR8jrbMSIQ7kNvwGZ3a-Y&_nc_oc=AdkpBXhdA1VuyIhpdJKXdseIBhswqKJ3IeCdhzqiK0IwItQ1ik44GmM4L2XKg5Xullw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afut-Tmh5aogc_b3kZ8e3gUrmfbYP5WOWdM0KnvVCHQZxg&oe=69A97FAC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_SWbgQTYz4Q7kNvwGdgZek&_nc_oc=AdnWV_Q1bGZsIchqB7kVzLqtCGshJeuyzsj1eB64adcAi99wt81nZVHpYiydMm_M62k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8FIYGbq5kEeYhWucG8oeY0G8HJQSYaQQSNxSdfohREg&oe=69A995FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vrvKN_4xXkQ7kNvwHD0mmJ&_nc_oc=AdknAVG1lIlsaAD-w0Ws5Hn7bHMKLJhJMPkQxQ8l0ZIX_A7Xf_X26qMFtVXAZxewfSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYa14FKp41XMNTqJ_8aAnwk8F7Vt7Ma3WMHeGu94-1Pg&oe=69A9850B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
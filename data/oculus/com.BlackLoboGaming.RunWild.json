nc_ohc=NAES0fOk_tQQ7kNvwFTtJIr&_nc_oc=AdknAoB-5E4lzjrssfGJ0rx7rs761UA3Z9wBUCv0UaHoDtISevIwVheB22qim5N9YDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqBbwpvjnq2lkYW7Q2Rur971M-UylR8rSGP-sEosxgdw&oe=69B16C9C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1ECvyxFwLcQ7kNvwFd31RG&_nc_oc=AdletYZdlc0NwjZV7DcaixhPX080LW_uZWeAyME8ze7krx78rKaQFufe4h3Qa5FPH0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRm5JILKfH2C1KLrpctU3guIect5Xkpsq_QrQ5n1sgYQ&oe=69B16788"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYjFZqgJlmMQ7kNvwHOKp6W&_nc_oc=AdmZwiQMufdZrpofdasUM7R7oq5NmU49CWPQ76GoPVpWcM9ClCHpe1bTOm1lPOoVhV4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSYLCJagKBmeZDl54ejhhKyNb8zeZXI6Aeqq5wTcjr9g&oe=69B168AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzKMsBORo9IQ7kNvwHVEJKz&_nc_oc=AdnsyYVDfsrt0Xi1P0Lqu78x155x1MT4nfKsgqXgyoVPklMRDUzI5CyjW_cTRqDtg-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiE6x3-wa9tNNtVT3PT3OQXC_fdBirqaawWlb6hi7iGQ&oe=69B146BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruEUbx5v79EQ7kNvwHssz-E&_nc_oc=Adkjf-a7u8Wn7mzbt-BEReEhKbU_EQgMo6ySM8mNOD_vXeTDIE3XgLUe7VJz_uSAjKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBM6AyYXROip4DUPSlRTY_70TRVn-jqR9jEiLmhC9WFA&oe=69B16E0B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
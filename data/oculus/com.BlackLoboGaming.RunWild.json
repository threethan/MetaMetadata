nc_ohc=F0xhoXepjGgQ7kNvwEyZ2-5&_nc_oc=AdkvMCG0-_7SOg55YYDHBAxe_fVocIyxMnKdktRpQHLiquCFtoJo-9-uZwDUtg1FZI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUenBrydFGXKqPt16sovsliMbqwGrJC9VM74A4z5DIEw&oe=69B5611C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1BulM7bfjcQ7kNvwH6TUvE&_nc_oc=AdnBIOUGStrIGjpyLDKYWN4H0xWR1hoFKFzTsxEowfpsHipLx8kY5B8yVrhvoP5AUdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTDZefeQdj12yyjwKTWaOjUajFApxhDER1FiWq6AEcNQ&oe=69B55C08"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSCVQ1wXrsMQ7kNvwENq5rn&_nc_oc=Adnjp9R7tfeqGw2n7-2yscuVuzfmiEaubsbkPs2d7AWDCl5diESj6oFPNj_I4KVtcMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7CwGy2vZQjOOhQLDf_ncUyoRcQmW0pw2vbr5WDkb8Ug&oe=69B55D2C"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DykrYDsqBFwQ7kNvwFihT03&_nc_oc=AdncLpsKxfzrRcMb6cWLzxnChDxCy8NmgFrK1WquoLixEEUUitxYT6fAYlpS6C9Q1yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8H6fTWMPmEGfyxC63RijDuh6nTFuDyYD2eQvfnJnCpA&oe=69B53B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrFpwLsdbY8Q7kNvwGvBt_7&_nc_oc=AdlyHL55JiXWGtqScM_bkNp7kLNqUi0wkF7kEQGvwM6RIyNyVTpEmnVCqSRCBHiNZ-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSaMIUvS4zTD1q08V-n-PjlGfe1suOK3v8ysghumo83g&oe=69B5628B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
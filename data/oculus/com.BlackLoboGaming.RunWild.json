c0xd6zpNOv-FSgYG18TuN3b3Xpp0-kBOC8LOGpxNjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsiOBuLiz2F-nvA_UCtnjHpUDoO21iyiCFn3iDYnQcLQw&oe=69A6E09C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO27EID5YHoQ7kNvwE0Ox8x&_nc_oc=AdkmgCug6-tgQNTNfjrbSAsQwMHzKTgzqF2CIB4ceDgqBnjwRXS0HHBOYmsBIjC3Kxo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv126ZeAy6BMLiSyfr37wL9uklbyhJANDnmwS6B8QIcSw&oe=69A6DB88"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKwR8jrbMSIQ7kNvwFA5qdm&_nc_oc=AdmYgqpTCDPoq7y4Hhg3NWRkSitHhuvVqMGz5c6X2-javpHYoFCF2dnyLYuRmhrMQ68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1ijGoRKP2_gPTExSXE8zrTQsiaqNvzhBSEQ0Py_Q4MA&oe=69A6DCAC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBdIBUi9UgYQ7kNvwEOJen7&_nc_oc=AdntyRWp7zxtJ6wsvlxfn-cVWnHBS5XsAVLneyiie1Z2mIzgMkz6qUoMdgb7Cajlnq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft48uCxmdeVqDq5EaBG-ziN3uHEdQ0B2m6Uxt_xtJt-pg&oe=69A6F2FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtMyh99vH90Q7kNvwHYZxRn&_nc_oc=Adldcrmw4EfJLuxscitPTUa7oRy86zmj3hqWINWQvsmmLieX4pf2Z5vVlBPMqjs9xbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGKhALZnD-OTsNc2MAbDb0M7urHBKIRp2hpKddZrTqQw&oe=69A6E20B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blacklobogaming.com/privacy-policy", "
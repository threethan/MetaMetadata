nc_ohc=ZJoRdGJJ_OgQ7kNvwHKgdHR&_nc_oc=AdnZB_idLF3HSZk2lpa0I-XZUUAOVy3Xialo_l3fDLhfwPiyDXNrJIU-2GA6yHe25EM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAfANY8LzSUTS_jZd21kJt5GbTSLz1Om8oqxpUpV4cHQ&oe=69B9559C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3Ws0AKgl2gQ7kNvwFIa5qs&_nc_oc=Admkvdg_FWyfcvPnC-QPU7ERSB2wwfgRxfDn-5zxgol2GH7QblLWisNTM5HPjtgiuls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwD3-Hb9mCPaT-7SztUV76lDuLzfrHG6rfiCKTna71oqw&oe=69B95088"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Lu3UPvD2KMQ7kNvwHwnJEO&_nc_oc=Adk3WulF_SGrlKnJNJhv06MDOI-hCUqDaGCL3J72R7gRVeJuawGHD3jcPgXVFMdD7-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFbBMfM7QnA4vs2PStnncHJE74uIKP1TjVd7K7crs_nQ&oe=69B951AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei7CCikE-akQ7kNvwERLPpq&_nc_oc=AdnnRRVzfQT5KjOmc1sjZ13SQ_FvbXbeqfVR7fLEXpUsP_M9MU75AIsPPgxE36zyllQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwblOgMVzYcmAIb9rP2k3MvS9A_3JxcIcj6YJtJhXsZGA&oe=69B92FBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkE7E_o7ezEQ7kNvwEKN_Lr&_nc_oc=AdnHC_AD0vms2VgwJs4hFggg-tP3iCrk-pXQAaPsPwXocchx0DfCRqnqYFzPYaEn8fI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxs11DZYrsfPxJU1HgJl2gs6cAxaLuWI6-ek3EC1fHRiA&oe=69B9570B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
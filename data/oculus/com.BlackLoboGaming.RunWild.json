nc_ohc=HNMFqYntdIMQ7kNvwHKouQY&_nc_oc=Adl7JFxHNVu0wCsYvS1b2HW11V8VNQWP-2vwYJ3aNwt5gEYU6REO4CftXaskxs40N38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0UDkGXbIvEIO2TspN9Wp2frEwIWKRL_wfCSzBkZVCPw&oe=69AC269C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMm5WgfCgF8Q7kNvwGz9pCX&_nc_oc=AdlS1b3b6LGvibYAM6hqf4SaYebe5rDE21LayiCwGNwe1pBRuUDOqvozUo29_kzWemA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuqXL5fal3vTO9XFpxP0OikMVXiffCW681ydPgTsBPRg&oe=69AC2188"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U38RX-1Du_AQ7kNvwEXUHvd&_nc_oc=AdnhTJGdWHfWzoIJ_2gGPgqPUt-U2xcIfBn0m4m6A_stt2EkkQPD0tKf_ON0BaHihWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQjebtATkSWC0nFQDHSCP-L2lk1rP9Qg66t-uP_hwx-A&oe=69AC22AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_SWbgQTYz4Q7kNvwHcHkYq&_nc_oc=AdlLCKkMVNApSleW6vj19z7ttDyKf4w6YDVKbNRF4RXRcwTkyodB4C40FbQlTCgsH0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWI-9sffKldQPzgkwBnvTgEIJXJxS8JBeDtWbOk5qJKA&oe=69AC38FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vrvKN_4xXkQ7kNvwEW-ap-&_nc_oc=AdlGKbFcDKdQW8m_Av-jEIbME8zoNz-3WWpa92GwcxXF--bXZISsEuLI_cPH5aBBJVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQ0UB3wEXzeTYRPC0ieb7ULioL2CHHrCKmAi_u0dPXVw&oe=69AC280B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
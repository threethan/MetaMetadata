cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMtAm8HGiJgQ7kNvwHIZiOX&_nc_oc=Adqnv-Qo_JuKZDT7zUl5tTI40mnaTDT7XUYUfrGP-qQeQteBSrGhaFIafYTya8qK8rQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKOjdDwPifadKglR2gebD1Kx9Gr5V9pcNByOG93DCRtw&oe=6A918B9C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G6PFKwECAcQ7kNvwE8ULmm&_nc_oc=AdrlTZ4c81q8jsEnd834Ww98lSAdlKIT2P3cWSkFX6JKfNsC_AnGUtNq5Ulqw-JqLjA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxPlpzV4DWicbwrxhHuBWzolD1DLT76HvTBYqbBWEeHA&oe=6A918688"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBB66bIZ8fIQ7kNvwGtPwvF&_nc_oc=AdoXIYrGky5LNdwlTLf5BAIqGqvItV-Uanukq8brpj3XcLajg73j_PfC5VIP0fjmjSg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBnZ24kFtuhzxYLm8ri-RYHd8Cm0M2hyMXMy90PP6sFg&oe=6A9187AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoXGswR9I24Q7kNvwHTb6QH&_nc_oc=AdpbfjlO0wtiqKS1Vs1S-q0tSTqKHQoHWJiL1vwPfw4rG9cgtYkwiJJNs7tc1DqOQ44&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv3oa4xN9jHkGOcZAk8XCAVt9efYmyD4seBq9sNzQTVg&oe=6A9165BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7nEoBiXQ-EQ7kNvwEt6_wp&_nc_oc=AdroGIReadjbkQCK8YTdpha2G4AZPOX73XONJR_ihFEr9EprgGNtiNjt_cgC4YuCd1o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyml3ktujaLAOUqoI2ICiQqdrI6ZsNGAmMmhOZO30YSQ&oe=6A918D0B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blacklobogaming.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BlackLoboGaming", "support_website_url": null, "website_url": "https://www.blacklobogaming.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27991918317120427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974465_1578250922793367_4246241782763603754_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYDHtiArGmcQ7kNvwE9hLUh&_nc_oc=AdrtBMmY52AbwooOlrc95Az9D82rZZ_XKQ-Olp4xxNC4cLPo0-j1NIdDXQZyeMk_2j4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfdbh6HgskMoGC--4IVkAOOuj3jnd3a7uAs3votlXKcw&oe=6A9184FC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Run Wild", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1742670000, "lastRevision": {"nodes": [{"id": "26244386065207003", "release_type": "
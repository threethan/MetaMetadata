nc_ohc=NAES0fOk_tQQ7kNvwFZ1m8n&_nc_oc=Adn2VrkgBF4STEWD70ZR0j0nNiiz4r2n9qoe8nIt9BnNKt4aUHMRDLz-7q1QWDdzjC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztD44TziNsPmEgWzWx-Phvo9-dT1ePBYD9Z8iemUhUeA&oe=69B40F9C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1BulM7bfjcQ7kNvwFr9693&_nc_oc=AdlN68KgM9vRRLYdqEPhwRJeRDtxHEriTH_setYj8FxgkvILIMUbuYnZ_5us_ngrqio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYQ8iIl6zCLTcaAmqazoSceigrE6xeNRvWFR3dob0hjg&oe=69B40A88"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSCVQ1wXrsMQ7kNvwGQ4vVq&_nc_oc=AdkJGF0LvjCVv1DPCgvXP4FOm_9H3JvZfXBDiHaS9DCWXbuzDT3Rw3hoN5UtsIPb8MU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRMwV2jZaICXytEda3KMPEIvxrzI95Ooo35VM7ztb5FA&oe=69B40BAC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzKMsBORo9IQ7kNvwHpNPyf&_nc_oc=AdmjAlHI9jBIlgXi2MhEfaJHp1vuSx3VqFhHy975C1w1WXvechW1UJLLkIK_h42TJSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7nlj_AaaIUjRr-jPkAAloKjY9LksiR-a_M2uum0WMnQ&oe=69B421FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruEUbx5v79EQ7kNvwH2c3WN&_nc_oc=AdmpKScvcI_Of4OiV4P7nToRxTlBoMeQyJgxrdCWhjut3TC-ixeYSaPFMQok2BAMVAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_CTZfp-uLjGqR_34K735JaLpim-F-GUdCsn_6T6X0nA&oe=69B4110B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
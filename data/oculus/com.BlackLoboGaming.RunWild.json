nc_ohc=ZJoRdGJJ_OgQ7kNvwGTjNYP&_nc_oc=Adk6GshIRZiWKbrqHkYB5Cg7K5VCOTqBqxrSE5yEpBiJtBPhHLCZcT8a91U8wQ2ZBmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzsnjbf94c7y-GDFo8NOh00cYT-wEtKmbY9h_eF-h7yxQ&oe=69BBF89C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLJsI7E9lf0Q7kNvwGY2qKA&_nc_oc=AdlUnVHl3hFNmraCxbM_VXTQ7crK5r6FsQsd-RGxirOLH-5bEd2ogco7etn9l3tLjSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwl3-4IgCblgEUnXUt3QM375ibkEgONSNyiXBHq6mvjsA&oe=69BBF388"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miTn2bDAezAQ7kNvwEyi4QV&_nc_oc=AdlQqH2vCZAutwKCcE152nj7aGOO3CqgJXv_2mV3Ues9DGWQuh4GqGc-5UmDvItHCQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZIL00L9tCn03h1Kp1T7N9EworraP6WeqSW9qlbmNDPA&oe=69BBF4AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei7CCikE-akQ7kNvwEv54W5&_nc_oc=AdnTmSpJa2xi5k6B_Lj06zXf8VvTE3QFR_JdtMtIhDQsNZ7wpVgRAgYyfVXLpus_RPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6dh6YsS54j0yu2PksxSaBTWcuiMaR9PxfI8n_PIr4ow&oe=69BC0AFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkE7E_o7ezEQ7kNvwFqlOgD&_nc_oc=AdmNiGM00xALkjJD4jMPAxLzAjgH1E82VwI6w6b8EMxnRnLMmyf6_xlJ9UsTHFg-UYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCSTZWvtdC9TLzwf8a4qOquN9U0GIHYK84lxOQJKBhbA&oe=69BBFA0B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
nc_ohc=mb6a2fpzdFkQ7kNvwFmwifA&_nc_oc=Adm34Re-WvkZwJzuw9KSF1wdiK_XV8y2YkrwABPgZD0520PevbAbVkUzG3Sja5Knyh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afws2MaV1x3xoJ2OuIO6II99_jd21cWt5SdthG5huC7Ahg&oe=69AEC99C"}, {"file_name": "ScreenShot1.png", "id": "1298086768114402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_1298086771447735_6811794420419351966_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1ECvyxFwLcQ7kNvwHbL_Uq&_nc_oc=AdmG9g0SiwxFHXB6D0XmlQpTytm2mfeYJnBgSBysVto0DRlXjkQ8gxYGpBEWiBdYnB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfXnNS3RywGXX57B-0ywQUMPNhixSzTwc4mdzV7364pg&oe=69AEC488"}, {"file_name": "ScreenShot2.png", "id": "1565939957391123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1565939960724456_6904852946347126459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYjFZqgJlmMQ7kNvwGnywvG&_nc_oc=Adk4f0TR9a95FR4elblNVeUOfQ7ufH3LviPoUAabotIzxXSArE6eFv7sqrG09b2MQ-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBXk4QCEaPq928G2rRl3TWxvBG5d7NCAiBRGNVtQ_amA&oe=69AEC5AC"}, {"file_name": "ScreenShot14.png", "id": "600073169620844", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_600073176287510_8882676380923404175_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBFdhGGIoNgQ7kNvwF3ZYz1&_nc_oc=AdlefchOobTehbS_nmagkCnn6epstX05s34MJEJInYycqCIkYD51aHJxI9TYlnXs9kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHBioGR1bqhHtYWp4xHSDVRTd5Ymd6cciOBeI80orkjQ&oe=69AEA3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RunWildLogo2560x1440.png", "id": "9283180381765486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393916_9283180385098819_4117607583146652622_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5m4pLeZAuoQ7kNvwEqD5sG&_nc_oc=Adm5JNOO_mxvQgSMoqQO0G6iIZU9PzRIR5fyIPjnSJ8N0MIEx1ZvOcGhVWoZ0JDNvsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJA8JDigvWXjv0GEuAyahFQx2vXexThKv4oA84JMFxAA&oe=69AECB0B"}, "display_name": "Run Wild", "keywords": ["minecraft", "blacklobogaming", "muck", "terraira", "survival"], "long_description": "\ud83c\udf32 **Run Wild** is a multiplayer VR survival game inspired by games like Muck, Terraria, and Minecraft! It introduces a fresh, immersive gameplay experience where **your hands become your movement**. Forget traditional locomotion\u2014run, climb, and traverse the world using nothing but your own motions.\n\n\u26a0\ufe0f Beta Disclaimer: This game is in beta, so expect bugs and glitches!\n\n# Features That Will Keep You Coming Back for More:\n- **Multiplayer Action**: Survive, thrive, and explore with up to 4 players in co-op or PvP. Team up or compete\u2014it\u2019s your choice!\n- **World Customization**: Make the world your own with a variety of settings and options to tailor your survival experience.\n- **Fishing, Mining, and Building**: Harvest resources, build your dream base, and relax with some fishing after a hard day of survival.\n- **Cave Systems**: Venture into the depths of mysterious caves to uncover hidden treasures.\n- **Tons of Enemies and Bosses**: Face off against tons of enemies and take on epic bosses that will test your skills.\n- **Hand-Based Locomotion**: Experience an entirely new way to play survival games by moving with your hands, delivering an unmatched sense of immersion.\n\nWith endless possibilities for creativity, intense challenges, and unique movement mechanics, Run Wild is the ultimate VR survival experience for adventurers everywhere. Whether you're battling enemies, customizing your world, or chilling with friends, there's always something new to discover.\nGrab your friends and prepare to **Run Wild**\u2014the adventure awaits!", "short_description": "Run Wild is a VR multiplayer survival game where your hands are your movement! Team up with up to 4 players to fish, mine, build, and explore customizable worlds filled with caves, enemies, and epic bosses!"}]},
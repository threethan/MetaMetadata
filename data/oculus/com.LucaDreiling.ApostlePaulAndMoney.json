Adr72IhWjHdLkEkK4PhXsg4c48w51AHAxhnw0mgbxrjNcU6i7mdn14TDkSkQEuMYjbA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsBQvyouUMi6Hwp6NBiWmxDRuGvI9IhLScDycF3U3vRA&oe=6A973834"}, {"file_name": "Screenshot 4.png", "id": "812498168226074", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491828806_812498171559407_3345272315890078088_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pzhCIafAl4Q7kNvwEPMTh_&_nc_oc=AdpqSVsM1vB-MLkLe4lSG6e9bBWk7ufQDNagPpsIVWWhrQIoQm8QMfu7TTTFBqKJIb4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECf3VaVwQW1orNeIfLk8iIDtmBo7lHZDV9hy2TaPmGVQ&oe=6A9721CF"}, {"file_name": "Screenshot 2.png", "id": "613121295157584", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823271_613121301824250_5175741631686056358_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iPcP1lKdtAQ7kNvwFqYySv&_nc_oc=AdqTS5I8km_WXTGJtn76P5UZYpo8fBr7GOE0fuLx8bCq-L4ylTIohIolpjDidnhgJKU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMHfzL9i4t20bIaE29fyclp31p_-7EDgkd_1a7tnevHw&oe=6A974620"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apostle Paul and Money", "keywords": [], "long_description": "Apostle Paul was one of the most important supporters of early Christianity and played a key role in its spread. For many years, he traveled as an itinerant missionary to cities in Greece and Turkey to spread the name of Jesus Christ and establish countless communities.\nAccompany him to the most important stops on his travels to gain a deeper understanding of ancient times and how money was handled. Visit historic cities such as Corinth to earn money through craftsmanship. Manage the collection in Antioch and defend yourself against an angry mob at the foot of the Temple of Artemis, one of the wonders of the ancient world.\n\nEnjoy an exhibition filled with high-quality 3D scans of real coins used during Paul's lifetime. Learn about the ancient times with information curated by history experts of the SFB 1391 at the University of T\u00fcbingen and experience life almost 2000 years ago playing three mini-games:\n- Cloth Puzzle: Help Paul work his day job as a tentmaker to earn money while evolving new congregations in Corinth\n- Scuffle: Defend yourself from an angry mob at the Temple of Artemis in Ephesos\n- Coin Throw: Organize the collections for your congregations in Jerusalem by throwing them into bags", "short_description": "\u201cApostle Paul and Money,\u201d an interactive exhibition featuring original artifacts, mini-games, and other surprises. Visit exciting places, master fun mini-games, and beat the local high score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paulus.luca-dreiling.de/meta_privacy_en.php", "developer_terms_of_service_url": null, "publisher_name": "eisclimberStudios", "support_website_url": null, "website_url": "https://paulus.luca-dreiling.de/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25090386880624075"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1002905482420930"}]}, "baseline_offer": {"id": "1002905482420930"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785564000, "status": "PUBLISHED", "id": "1002905482420930"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test
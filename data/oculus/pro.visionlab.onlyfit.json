0a&_nc_ohc=YONZLZGr2_IQ7kNvwHKT4ch&_nc_oc=Ado89fp-0rsQkEJ13RX4NkDmra2_hlqnIyjDFEUSe1Yp7jP88-oy20KTiiPo6qpoy2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXmcGqgmT5jgZGLv175rPKvnmlz8qTqS2yxIwFPjvYXQ&oe=6B05D5AF"}, "display_name": "OnlyFit: Home Workouts", "keywords": ["coach", "boxing", "workout", "fitness", "ai"], "long_description": "**OnlyFit** brings home workouts to life. Train face-to-face in VR with an **AI coach** across **HIIT, Tabata, Interval Training, MetCon, LISS, Core Workout, Cardio Boxing**.\n\n**OnlyFit** is a fitness platform built to help you reach your goals, not an entertainment experience. Follow a **personalized training program** shaped by your goals, fitness level, and preferred workout length. Each session takes you through a warm-up, focused exercises, recovery periods, and a cool-down. Support your training with a **personalized nutrition plan** tailored to your goals and food preferences.\n\n\n{1115365514367792}\n{2256574535101326}\n", "short_description": "Train face-to-face in VR with an AI coach across HIIT, Tabata, Interval Training, MetCon, LISS, Core Workout, Cardio Boxing, and Dance Cardio. New users can select Sign up on the welcome screen to create an account in VR."}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://getonlyfit.com/privacy-policy/", "developer_terms_of_service_url": "https://getonlyfit.com/terms-of-service/", "publisher_name": "OnlyFit", "support_website_url": "https://getonlyfit.com/support/", "website_url": "https://getonlyfit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory
_description": "A puzzle-strategy tower defense game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FgbjAcwi-vZP9WgujT2doaereCfqq_Fe8wPIJlWun_I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Carson VR Studio", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1FgbjAcwi-vZP9WgujT2doaereCfqq_Fe8wPIJlWun_I/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25173600745655917"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "893783896410069"}]}, "baseline_offer": {"id": "893783896410069"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767661380, "status": "PUBLISHED", "id": "893783896410069"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25261470700202254", "version": "0.1.0"}, "id": "1215064827164881", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25173600715655920", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25261470700202254"}, "release_status": "RELEASED"}, "binary_rel
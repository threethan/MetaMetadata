ontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823398_4205001486487069_1618644476196036336_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T6dHT-o6YYQ7kNvwHiMOgP&_nc_oc=AdpjvzHQL6SJzm7jnaIE-rjrqNQYTQLL9p_ISH0UO7FOZSKJYumZEg59HI7juvUzfys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iq-maYaS0M2ZapjUa_v_kEv14Uy_NB6DhZodHHzFZQA&oe=6A4529DB"}, {"file_name": "Screenshot6-Mouette.png", "id": "739223172059033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822800_739223175392366_317344347960101093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aR8YaoycH0Q7kNvwGjWIW4&_nc_oc=AdoIWMamcpAm-1OtNhHIfU5SLpUEu1CrnN1EFK0q_nWEpelZSOmVUTaJKfJReFbLie4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c_eCEYXQiRChkX7VsFmIzbZ5AsG32y3hTilVrSree0Q&oe=6A45104A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Thumbnail.png", "id": "2112347326210378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304106_2112347329543711_1022472039446489060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYp5_rhIXFsQ7kNvwFpVUq7&_nc_oc=Ado6SLNtpv6h1ByRFZbnY5oo7BiFZwLAeBBUYVWCv17lWcvJMeiCPORLggncuTsQmCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FnjBf8XCTGGHEhQkxOYVMZE0F0tRQ_GrYQlfB8LjdUg&oe=6A450697"}, "display_name": "Crime Shop Simulator: A Prison Boss Game", "keywords": ["multiplayer", "simulator", "job", "craft", "cooking"], "long_description": "                                                                          \n\n\n**Crime Shop Simulator** brings the crafting and simulation antics of **Prison Boss VR**  out of the slammer and onto the streets!\n\nYou can become a self-made-egg, play in co-op with one of your friends\u2026 or recruit a totally reliable stranger from the internet.\n\n\n\n{1406188351090863}\n# PLAY IN CO-OP WITH A PARTNER IN CRIME\n{552076781316863}\n# CRAFT WITHOUT GETTING CAUGHT\n{2876644245848569}\n# EARN CASH AND BUILD YOUR REPUTATION\n{1780452482869691}\n# CUSTOMIZE YOUR SHOPS AND LOOKS\n{1389387445440565}\n\nRun a chain of stalls crafting legal and not-quite-legal merchandise,  all on a quest to conquer the black market and get super duper rich!\n\nBrew beer, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful, the New Yolk Police Department are intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise, and your business will be plucked!\n\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred! \n\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n\n# THE GAME INCLUDES:\n- 3 different levels\n- 20+ items to craft\n- Leaderboards  \n\u2026 And more!\n\nJoin us on Discord: https://discord.gg/prisonboss", "short_description": "Crime Shop Simulator brings the crafting and simulation antics of Prison Boss VR out of the slammer and onto the streets of New Yolk City! The Mayor has gone on a banning spree, and now the black market is thriving. Work solo, or recruit a partner in the new co-op mode! Roll cigarettes, brew booze, and stack up mountains of cash, all without getting busted by cops on patrol."}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-pbp", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": "https://discord.gg/prisonboss", "website_url": "https://trebuchet.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscri